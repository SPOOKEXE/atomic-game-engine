# Native navigation comes from the same page ownership facts as the prose indexes.
function(_mono_docs_nav_title source output)
	set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
	file(STRINGS "${source}" lines ENCODING UTF-8)
	foreach(line IN LISTS lines)
		if(line MATCHES "^#[ \t]+(.+)$")
			set(${output} "${CMAKE_MATCH_1}" PARENT_SCOPE)
			return()
		endif()
	endforeach()
	message(FATAL_ERROR "docs navigation: no page heading in ${source}")
endfunction()

function(_mono_docs_nav_register id title)
	get_property(registered GLOBAL PROPERTY "MONO_DOCS_NAV_${id}_TITLE" SET)
	if(registered)
		message(FATAL_ERROR "docs navigation: duplicate page id '${id}'")
	endif()
	set_property(GLOBAL PROPERTY "MONO_DOCS_NAV_${id}_TITLE" "${title}")
	set_property(GLOBAL APPEND PROPERTY MONO_DOCS_NAV_IDS "${id}")
endfunction()

function(_mono_docs_nav_category source output)
	_mono_docs_nav_title("${source}" title)
	file(RELATIVE_PATH relative "${CMAKE_SOURCE_DIR}" "${source}")
	string(REGEX REPLACE "\\.md$" "" id "${relative}")
	string(REPLACE "_" "__" id "${id}")
	string(REPLACE "." "_8" id "${id}")
	string(REPLACE "/" "_2" id "${id}")
	set(id "md_${id}")
	if(title MATCHES "^(.*)[ \t]+\\{#([A-Za-z0-9_-]+)\\}$")
		set(title "${CMAKE_MATCH_1}")
		set(id "${CMAKE_MATCH_2}")
	endif()
	_mono_docs_nav_register("${id}" "${title}")
	set(${output} "${id}" PARENT_SCOPE)
	file(STRINGS "${source}" lines ENCODING UTF-8)
	foreach(line IN LISTS lines)
		if(line MATCHES "^[ \t]*@page[ \t]+([A-Za-z0-9_-]+)[ \t]+(.+)$")
			set(id "${CMAKE_MATCH_1}")
			_mono_docs_nav_register("${id}" "${CMAKE_MATCH_2}")
		elseif(line MATCHES "^[ \t]*-[ \t]+@subpage[ \t]+([A-Za-z0-9_-]+)[ \t]*$")
			set_property(GLOBAL APPEND PROPERTY "MONO_DOCS_NAV_${id}_CHILDREN" "${CMAKE_MATCH_1}")
		elseif(line MATCHES "^[ \t]*-[ \t]+@subpage")
			message(FATAL_ERROR "docs navigation: malformed owned subpage in ${source}: ${line}")
		endif()
	endforeach()
endfunction()

function(_mono_docs_nav_leaf id)
	if(NOT id MATCHES "^md_(.+)$")
		message(FATAL_ERROR "docs navigation: unknown page id '${id}'")
	endif()
	# Protect literal underscores before reversing Doxygen's path escapes.
	string(REPLACE "__" "@UNDERSCORE@" relative "${CMAKE_MATCH_1}")
	string(REPLACE "_2" "/" relative "${relative}")
	string(REPLACE "_8" "." relative "${relative}")
	string(REPLACE "@UNDERSCORE@" "_" relative "${relative}")
	set(source "${CMAKE_SOURCE_DIR}/${relative}.md")
	if(NOT EXISTS "${source}")
		message(FATAL_ERROR "docs navigation: '${id}' has no source at ${source}")
	endif()
	_mono_docs_nav_title("${source}" title)
	string(REGEX REPLACE "[ \t]+\\{#[A-Za-z0-9_-]+\\}$" "" title "${title}")
	_mono_docs_nav_register("${id}" "${title}")
endfunction()

function(_mono_docs_nav_claim id parent)
	get_property(has_parent GLOBAL PROPERTY "MONO_DOCS_NAV_${id}_PARENT" SET)
	if(has_parent)
		get_property(previous GLOBAL PROPERTY "MONO_DOCS_NAV_${id}_PARENT")
		message(FATAL_ERROR "docs navigation: '${id}' has duplicate parents '${previous}' and '${parent}'")
	endif()
	set_property(GLOBAL PROPERTY "MONO_DOCS_NAV_${id}_PARENT" "${parent}")
endfunction()

function(_mono_docs_nav_emit id parent ancestors output)
	if(id IN_LIST ancestors)
		message(FATAL_ERROR "docs navigation: page cycle ${ancestors};${id}")
	endif()
	_mono_docs_nav_claim("${id}" "${parent}")
	get_property(registered GLOBAL PROPERTY "MONO_DOCS_NAV_${id}_TITLE" SET)
	if(NOT registered)
		_mono_docs_nav_leaf("${id}")
	endif()
	get_property(title GLOBAL PROPERTY "MONO_DOCS_NAV_${id}_TITLE")
	string(REPLACE "&" "&amp;" title "${title}")
	string(REPLACE "<" "&lt;" title "${title}")
	string(REPLACE ">" "&gt;" title "${title}")
	string(REPLACE "\"" "&quot;" title "${title}")
	string(REPLACE "'" "&apos;" title "${title}")
	get_property(children GLOBAL PROPERTY "MONO_DOCS_NAV_${id}_CHILDREN")
	if(children)
		set(xml "<tab type=\"usergroup\" title=\"${title}\" url=\"@ref ${id}\">\n")
		list(APPEND ancestors "${id}")
		foreach(child IN LISTS children)
			_mono_docs_nav_emit("${child}" "${id}" "${ancestors}" child_xml)
			string(APPEND xml "${child_xml}")
		endforeach()
		string(APPEND xml "</tab>\n")
	else()
		set(xml "<tab type=\"user\" title=\"${title}\" url=\"@ref ${id}\"/>\n")
	endif()
	set(${output} "${xml}" PARENT_SCOPE)
endfunction()

# Register all category and inline @page IDs before resolving their children.
foreach(category IN ITEMS Repository Guides Modules Standards Planning Api FutureWork Archive)
	if(category STREQUAL "FutureWork" OR category STREQUAL "Archive")
		set(source "${MONO_DOCS_OUTPUT}/${category}.md")
	else()
		set(source "${CMAKE_CURRENT_SOURCE_DIR}/pages/${category}.md")
	endif()
	_mono_docs_nav_category("${source}" "MONO_DOCS_NAV_${category}_ID")
endforeach()
_mono_docs_nav_register(tiers "Tiers")
_mono_docs_nav_register(threadsafe "Thread-safe API")
_mono_docs_nav_register(tickbound "Tick-bound API")
_mono_docs_nav_register(clientonly "Client-only API")
foreach(category IN ITEMS Repository Guides Modules Standards Planning)
	_mono_docs_nav_emit("${MONO_DOCS_NAV_${category}_ID}" root "" "MONO_DOCS_NAV_${category}")
endforeach()
_mono_docs_nav_claim("${MONO_DOCS_NAV_Api_ID}" root)
get_property(contracts GLOBAL PROPERTY "MONO_DOCS_NAV_${MONO_DOCS_NAV_Api_ID}_CHILDREN")
set(MONO_DOCS_NAV_CONTRACTS "")
foreach(contract IN LISTS contracts)
	_mono_docs_nav_emit("${contract}" "${MONO_DOCS_NAV_Api_ID}" "${MONO_DOCS_NAV_Api_ID}" contract_xml)
	string(APPEND MONO_DOCS_NAV_CONTRACTS "${contract_xml}")
endforeach()
# Every registered category and referenced leaf must have a navigation owner.
get_property(page_ids GLOBAL PROPERTY MONO_DOCS_NAV_IDS)
foreach(id IN LISTS page_ids)
	get_property(has_parent GLOBAL PROPERTY "MONO_DOCS_NAV_${id}_PARENT" SET)
	if(NOT has_parent)
		message(FATAL_ERROR "docs navigation: page '${id}' has no navigation parent")
	endif()
endforeach()
configure_file("${CMAKE_CURRENT_SOURCE_DIR}/Layout.xml.in" "${MONO_DOCS_OUTPUT}/Layout.xml" @ONLY)
