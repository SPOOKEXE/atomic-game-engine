# Prepare an immutable, shared copy of the pinned ImGui tree with our patch.
# The lock serializes publication, while content-addressed paths let builds using
# older copies continue while another preset configures a different revision.
function(mono_prepare_patched_imgui output)
	find_package(Git REQUIRED)
	# Git hooks may export the superproject's repository variables. Do not let
	# those redirect commands intended for the ImGui submodule.
	execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --local-env-vars
		RESULT_VARIABLE result OUTPUT_VARIABLE local_git_vars OUTPUT_STRIP_TRAILING_WHITESPACE)
	if(NOT result EQUAL 0)
		message(FATAL_ERROR "Could not query Git's repository-local environment variables.")
	endif()
	string(REPLACE "\r\n" "\n" local_git_vars "${local_git_vars}")
	string(REPLACE "\n" ";" local_git_vars "${local_git_vars}")
	set(git "${CMAKE_COMMAND}" -E env)
	foreach(variable IN LISTS local_git_vars)
		if(NOT variable STREQUAL "")
			list(APPEND git "--unset=${variable}")
		endif()
	endforeach()
	set(git_environment ${git})
	list(APPEND git "${GIT_EXECUTABLE}")
	set(source "${CMAKE_SOURCE_DIR}/mono.vendor/imgui")
	set(patch "${CMAKE_SOURCE_DIR}/mono.vendor/patches/imgui/before-input-callback.patch")
	if(EXISTS "${source}/.git")
		execute_process(COMMAND ${git} -C "${source}" rev-parse --verify "HEAD^{commit}"
			RESULT_VARIABLE result OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
		if(NOT result EQUAL 0)
			message(FATAL_ERROR "ImGui submodule is not available. Initialise the repository submodules first.")
		endif()
		execute_process(COMMAND ${git} ls-files --stage -- mono.vendor/imgui
			WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}"
			RESULT_VARIABLE result OUTPUT_VARIABLE gitlink OUTPUT_STRIP_TRAILING_WHITESPACE)
		if(NOT result EQUAL 0 OR NOT gitlink MATCHES "^160000 ${head} 0[\t ]+mono[.]vendor/imgui$")
			message(FATAL_ERROR "ImGui checkout does not match the pinned gitlink. Update the submodule first.")
		endif()
		foreach(diff_args IN ITEMS "--quiet" "--cached;--quiet")
			execute_process(COMMAND ${git} -C "${source}" diff ${diff_args}
				RESULT_VARIABLE result)
			if(NOT result EQUAL 0)
				message(FATAL_ERROR "ImGui has local tracked changes; move them to a vendor patch first.")
			endif()
		endforeach()
		# Observe the actual Git files, including a gitfile-backed submodule and
		# packed refs. Gitlink mismatches are checked whenever configure runs.
		if(NOT CMAKE_SCRIPT_MODE_FILE)
			foreach(git_path IN ITEMS HEAD packed-refs)
				execute_process(COMMAND ${git} -C "${source}" rev-parse --git-path "${git_path}"
					RESULT_VARIABLE result OUTPUT_VARIABLE observed OUTPUT_STRIP_TRAILING_WHITESPACE)
				if(result EQUAL 0)
					cmake_path(ABSOLUTE_PATH observed BASE_DIRECTORY "${source}" NORMALIZE)
					get_filename_component(parent "${observed}" DIRECTORY)
					set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${parent}")
					if(EXISTS "${observed}")
						set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${observed}")
					endif()
				endif()
			endforeach()
			execute_process(COMMAND ${git} -C "${source}" symbolic-ref -q HEAD
				RESULT_VARIABLE result OUTPUT_VARIABLE branch OUTPUT_STRIP_TRAILING_WHITESPACE)
			if(result EQUAL 0)
				execute_process(COMMAND ${git} -C "${source}" rev-parse --git-path "${branch}"
					OUTPUT_VARIABLE observed OUTPUT_STRIP_TRAILING_WHITESPACE)
				cmake_path(ABSOLUTE_PATH observed BASE_DIRECTORY "${source}" NORMALIZE)
				get_filename_component(parent "${observed}" DIRECTORY)
				if(EXISTS "${parent}")
					set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${parent}")
				endif()
				if(EXISTS "${observed}")
					set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${observed}")
				endif()
			endif()
	
		endif()
	else()
		# Source exports have no Git metadata. Hash their complete vendor tree
		# so edits receive a fresh immutable copy instead of being ignored.
		if(NOT EXISTS "${source}/imgui.h" OR NOT EXISTS "${source}/imgui_widgets.cpp")
			message(FATAL_ERROR "The exported source tree does not contain ImGui.")
		endif()
		if(CMAKE_SCRIPT_MODE_FILE)
			file(GLOB_RECURSE source_files LIST_DIRECTORIES FALSE RELATIVE "${source}" "${source}/*")
		else()
			file(GLOB_RECURSE source_files CONFIGURE_DEPENDS LIST_DIRECTORIES FALSE RELATIVE "${source}" "${source}/*")
		endif()
		list(SORT source_files)
		set(source_manifest "")
		foreach(file IN LISTS source_files)
			if(NOT CMAKE_SCRIPT_MODE_FILE)
				set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}/${file}")
			endif()
			file(SHA256 "${source}/${file}" file_hash)
			string(APPEND source_manifest "${file}:${file_hash}\n")
		endforeach()
		string(SHA256 head "${source_manifest}")
	endif()
	file(SHA256 "${patch}" patch_hash)
	string(SHA256 key "${head};${patch_hash}")
	set(relative ".cache/vendor/imgui/objects/${key}")
	set(destination "${CMAKE_SOURCE_DIR}/${relative}")
	file(MAKE_DIRECTORY "${CMAKE_SOURCE_DIR}/.cache/vendor/imgui/objects")
	file(LOCK "${CMAKE_SOURCE_DIR}/.cache/vendor/imgui/prepare.lock" GUARD FUNCTION TIMEOUT 120 RESULT_VARIABLE lock_result)
	if(NOT lock_result STREQUAL "0")
		message(FATAL_ERROR "Could not lock the ImGui vendor cache: ${lock_result}")
	endif()
	if(NOT EXISTS "${destination}/.complete")
		set(stage "${destination}.tmp")
		set(archive "${destination}.tar")
		file(REMOVE_RECURSE "${stage}")
		file(MAKE_DIRECTORY "${stage}")
		if(EXISTS "${source}/.git")
			execute_process(COMMAND ${git} -C "${source}" archive --format=tar "--output=${archive}" "${head}"
				RESULT_VARIABLE result)
			if(NOT result EQUAL 0)
				message(FATAL_ERROR "Could not archive the pinned ImGui tree.")
			endif()
			execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${archive}"
				WORKING_DIRECTORY "${stage}" RESULT_VARIABLE result)
			file(REMOVE "${archive}")
			if(NOT result EQUAL 0)
				message(FATAL_ERROR "Could not extract the pinned ImGui tree.")
			endif()
		else()
			file(COPY "${source}/" DESTINATION "${stage}")
			file(GLOB_RECURSE staged_files LIST_DIRECTORIES FALSE RELATIVE "${stage}" "${stage}/*")
			list(SORT staged_files)
			set(staged_manifest "")
			foreach(file IN LISTS staged_files)
				file(SHA256 "${stage}/${file}" file_hash)
				string(APPEND staged_manifest "${file}:${file_hash}\n")
			endforeach()
			if(NOT staged_manifest STREQUAL source_manifest)
				file(REMOVE_RECURSE "${stage}")
				message(FATAL_ERROR "Exported ImGui sources changed during preparation; retry configuration.")
			endif()
		endif()
		if(EXISTS "${source}/.git")
			set(apply_git ${git})
		else()
			# Do not let an unrelated enclosing repository change patch paths.
			set(apply_git ${git_environment} "GIT_CEILING_DIRECTORIES=${CMAKE_SOURCE_DIR}" "${GIT_EXECUTABLE}")
		endif()
		execute_process(COMMAND ${apply_git} apply "--directory=${relative}.tmp" "${patch}"
			WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" RESULT_VARIABLE result)
		if(NOT result EQUAL 0)
			file(REMOVE_RECURSE "${stage}")
			message(FATAL_ERROR "The ImGui patch no longer applies to its pinned revision.")
		endif()
		file(SHA256 "${patch}" current_patch_hash)
		if(NOT current_patch_hash STREQUAL patch_hash)
			file(REMOVE_RECURSE "${stage}")
			message(FATAL_ERROR "The ImGui patch changed during preparation; retry configuration.")
		endif()
		file(WRITE "${stage}/.complete" "${head}\n${patch_hash}\n")
		if(EXISTS "${destination}")
			message(FATAL_ERROR "The published ImGui cache entry is incomplete: ${destination}")
		endif()
		file(RENAME "${stage}" "${destination}" RESULT rename_result)
		if(NOT rename_result STREQUAL "0")
			message(FATAL_ERROR "Could not publish the patched ImGui tree: ${rename_result}")
		endif()
	endif()
	set(${output} "${destination}" PARENT_SCOPE)
endfunction()
