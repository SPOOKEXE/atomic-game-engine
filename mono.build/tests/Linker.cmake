			RESULT_VARIABLE fallbackStatus OUTPUT_VARIABLE fallbackOutput ERROR_VARIABLE fallbackError)
		if(NOT fallbackStatus STREQUAL "0")
			message(FATAL_ERROR "vendor default linker fallback failed:\n${fallbackOutput}${fallbackError}")
		endif()
		file(WRITE "${fallbackDir}/bin/ld" "#!/bin/sh\nexec '${quotedFallbackLd}' \"$@\"\n")
		file(CHMOD "${fallbackDir}/bin/ld" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
		execute_process(COMMAND "${CMAKE_COMMAND}" -S "${fallbackDir}/source" -B "${fallbackDir}/build" -G Ninja
			"-DMONO_SOURCE_ROOT=${sourceRoot}" -DCMAKE_BUILD_TYPE=Debug "-DCMAKE_CXX_FLAGS=-B\"${fallbackDir}/bin/\""
			-DEXPECT_VENDOR_COMPRESSED=ON
			RESULT_VARIABLE fallbackStatus OUTPUT_VARIABLE fallbackOutput ERROR_VARIABLE fallbackError)
		if(NOT fallbackStatus STREQUAL "0")
			message(FATAL_ERROR "vendor default linker replacement failed:\n${fallbackOutput}${fallbackError}")
		endif()
	endif()

	find_program(probeAr NAMES ar REQUIRED)
	string(REPLACE "'" "'\"'\"'" quotedAr "${probeAr}")
	set(unsupportedAr "${testRoot}/archiver without thin")
	file(WRITE "${unsupportedAr}"
		"#!/bin/sh\nif [ \"$1\" = \"--help\" ]; then echo 'No thin archives'; exit 0; fi\nexec '${quotedAr}' \"$@\"\n")
	file(CHMOD "${unsupportedAr}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
	configure_probe(archive-unsupported pass -DMONO_LINKER=system "-DCMAKE_AR=${unsupportedAr}")
	check_archive(archive-unsupported FALSE 42)

	# A separately configured ranlib may reject thin archives while accepting fat ones.
	find_program(probeRanlib NAMES ranlib REQUIRED)
	set(unsupportedRanlib "${testRoot}/ranlib without thin")
	file(WRITE "${unsupportedRanlib}"
		"#!/bin/sh\ncase \"$1\" in */mono-vendor-thin-probe.a) exit 1 ;; esac\nexec '${probeRanlib}' \"$@\"\n")
	file(CHMOD "${unsupportedRanlib}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
	configure_probe(vendor-ranlib-unsupported pass -DMONO_LINKER=system -DMONO_THIN_VENDOR_ARCHIVES=ON "-DCMAKE_RANLIB=${unsupportedRanlib}")
	check_vendor_archive(vendor-ranlib-unsupported FALSE 20)

	set(brokenLinker "${testRoot}/broken linker/ld.lld")
	file(WRITE "${brokenLinker}" "#!/bin/sh\nexit 1\n")
	file(CHMOD "${brokenLinker}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
	configure_probe(auto-broken pass -DMONO_LINKER=auto "-DMONO_LLD=${brokenLinker}")
	configure_probe(lld-broken "MONO_LINKER=lld" -DMONO_LINKER=lld "-DMONO_LLD=${brokenLinker}")
endif()

configure_probe(auto pass -DMONO_LINKER=auto)
check_debug_compression(auto TRUE)
file(READ "${testRoot}/auto/build.ninja" autoBuild)
if(autoBuild MATCHES "-fuse-ld=lld")
	check_lld_sections(auto)
	configure_probe(lld pass -DMONO_LINKER=lld)
	configure_probe(vendor-lld pass -DMONO_LINKER=lld -DMONO_THIN_VENDOR_ARCHIVES=ON)
	check_vendor_archive(vendor-lld "${thinSupported}" 20)
	check_lld_sections(lld)
	check_debug_compression(lld TRUE)
	if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
		# A working linker that rejects zstd must still configure and link.
		file(READ "${testRoot}/auto/selected-lld.txt" selectedLld)
		string(REPLACE "'" "'\"'\"'" quotedLld "${selectedLld}")
		set(noCompressionLinker "${testRoot}/linker without compression/ld.lld")
		file(WRITE "${noCompressionLinker}"
			"#!/bin/sh\nfor argument in \"$@\"; do\ncase \"$argument\" in --compress-debug-sections=*) exit 1;; esac\ndone\nexec '${quotedLld}' \"$@\"\n")
		file(CHMOD "${noCompressionLinker}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
		configure_probe(debug-unsupported pass -DMONO_LINKER=lld "-DMONO_LLD=${noCompressionLinker}")
		check_lld_sections(debug-unsupported)
		check_debug_compression(debug-unsupported FALSE)
	endif()
else()
	message(STATUS "linker-check: real LLD path skipped (not available on this host/compiler)")
endif()
message(STATUS "linker-check: linker selection, pools, compile flags, debug compression and archive rebuilds verified")
