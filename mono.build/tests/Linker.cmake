# Configure and link a real executable through each linker-selection path.
if(NOT DEFINED MONO_TEST_ROOT)
	message(FATAL_ERROR "Set MONO_TEST_ROOT to a directory under the selected build tree")
endif()
get_filename_component(sourceRoot "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
get_filename_component(testRoot "${MONO_TEST_ROOT}/linker-test" ABSOLUTE)
set(fixture "${testRoot}/source with spaces")
file(MAKE_DIRECTORY "${fixture}")
file(WRITE "${fixture}/main.cpp" "int main() { return 0; }\n")
file(WRITE "${fixture}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.24)
project(LinkerProbe LANGUAGES CXX)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
if(PROBE_CROSS)
	set(CMAKE_CROSSCOMPILING TRUE)
endif()
if(PROBE_CUSTOM_POOL)
	set_property(GLOBAL PROPERTY JOB_POOLS custom_link=1)
	set(CMAKE_JOB_POOL_LINK custom_link)
endif()
if(PROBE_VARIABLE_POOL)
	set(CMAKE_JOB_POOLS caller_compile=1)
	set(CMAKE_JOB_POOL_COMPILE caller_compile)
endif()
include("${MONO_SOURCE_ROOT}/mono.build/MonoLinker.cmake")
add_executable(probe main.cpp)
get_target_property(linkPool probe JOB_POOL_LINK)
file(WRITE "${CMAKE_BINARY_DIR}/link-pool.txt" "${linkPool}")
]=])

function(configure_probe name expectedStatus)
	set(probeBuild "${testRoot}/${name}")
	execute_process(COMMAND "${CMAKE_COMMAND}" -S "${fixture}" -B "${probeBuild}" -G Ninja
		"-DMONO_SOURCE_ROOT=${sourceRoot}" ${ARGN}
		RESULT_VARIABLE configureStatus OUTPUT_VARIABLE output ERROR_VARIABLE error)
	if(expectedStatus STREQUAL "pass")
		if(NOT configureStatus STREQUAL "0")
			message(FATAL_ERROR "${name} configure failed:\n${output}${error}")
		endif()
	else()
		if(configureStatus STREQUAL "0" OR NOT "${output}${error}" MATCHES "${expectedStatus}")
			message(FATAL_ERROR "${name}: expected ${expectedStatus}, got ${configureStatus}:\n${output}${error}")
		endif()
		return()
	endif()

	execute_process(COMMAND "${CMAKE_COMMAND}" --build "${probeBuild}"
		RESULT_VARIABLE buildStatus OUTPUT_VARIABLE output ERROR_VARIABLE error)
	if(NOT buildStatus STREQUAL "0")
		message(FATAL_ERROR "${name} link failed:\n${output}${error}")
	endif()
	if(NOT CMAKE_HOST_WIN32)
		execute_process(COMMAND "${probeBuild}/probe" RESULT_VARIABLE runStatus)
		if(NOT runStatus STREQUAL "0")
			message(FATAL_ERROR "${name} executable failed: ${runStatus}")
		endif()
	endif()
	file(READ "${probeBuild}/compile_commands.json" compileCommands)
	if(compileCommands MATCHES "-fuse-ld=|-B[^ ]*llvm|--threads=")
		message(FATAL_ERROR "Linker options leaked into compilation:\n${compileCommands}")
	endif()
endfunction()

configure_probe(system pass -DMONO_LINKER=system)
file(READ "${testRoot}/system/link-pool.txt" linkPool)
if(NOT linkPool STREQUAL "mono_link")
	message(FATAL_ERROR "First-party links did not join their bounded pool: ${linkPool}")
endif()
configure_probe(custom-pool pass -DMONO_LINKER=system -DPROBE_CUSTOM_POOL=ON)
file(READ "${testRoot}/custom-pool/link-pool.txt" linkPool)
if(NOT linkPool STREQUAL "custom_link")
	message(FATAL_ERROR "Caller-supplied link pool was replaced: ${linkPool}")
endif()
configure_probe(variable-pool pass -DMONO_LINKER=system -DPROBE_VARIABLE_POOL=ON)
configure_probe(auto-missing pass -DMONO_LINKER=auto "-DMONO_LLD=${testRoot}/missing/ld.lld")
configure_probe(invalid-mode "MONO_LINKER is" -DMONO_LINKER=invalid)
configure_probe(invalid-jobs "MONO_LINK_JOBS must" -DMONO_LINK_JOBS=0)
configure_probe(lld-missing "MONO_LINKER=lld" -DMONO_LINKER=lld "-DMONO_LLD=${testRoot}/missing/ld.lld")
configure_probe(cross-auto pass -DMONO_LINKER=auto -DPROBE_CROSS=ON)
configure_probe(cross-lld "requires a native GCC/Linux build" -DMONO_LINKER=lld -DPROBE_CROSS=ON)

if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
	set(brokenLinker "${testRoot}/broken linker/ld.lld")
	file(WRITE "${brokenLinker}" "#!/bin/sh\nexit 1\n")
	file(CHMOD "${brokenLinker}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
	configure_probe(auto-broken pass -DMONO_LINKER=auto "-DMONO_LLD=${brokenLinker}")
	configure_probe(lld-broken "MONO_LINKER=lld" -DMONO_LINKER=lld "-DMONO_LLD=${brokenLinker}")
endif()

configure_probe(auto pass -DMONO_LINKER=auto)
file(READ "${testRoot}/auto/build.ninja" autoBuild)
if(autoBuild MATCHES "-fuse-ld=lld")
	configure_probe(lld pass -DMONO_LINKER=lld)
else()
	message(STATUS "linker-check: real LLD path skipped (not available on this host/compiler)")
endif()
message(STATUS "linker-check: system, auto, explicit LLD, fallback, pools and compile flags verified")
