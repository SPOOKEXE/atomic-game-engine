function(configure_probe name expectedStatus)
	set(probeBuild "${testRoot}/${name}")
	execute_process(COMMAND "${CMAKE_COMMAND}" -S "${fixture}" -B "${probeBuild}" -G Ninja
		"-DMONO_SOURCE_ROOT=${sourceRoot}" -DCMAKE_BUILD_TYPE=Debug ${ARGN}
		RESULT_VARIABLE configureStatus OUTPUT_VARIABLE output ERROR_VARIABLE error)
	if(expectedStatus STREQUAL "pass")
		if(NOT configureStatus STREQUAL "0")
			message(FATAL_ERROR "${name} configure failed:\n${output}${error}")
		endif()
	else()
		if(configureStatus STREQUAL "0" OR NOT "${output}${error}" MATCHES "${expectedStatus}")
			message(FATAL_ERROR "${name}: expected ${expectedStatus}, got ${configureStatus}:\n${output}${error}")
		endif()
		return()
	endif()

	execute_process(COMMAND "${CMAKE_COMMAND}" --build "${probeBuild}"
		RESULT_VARIABLE buildStatus OUTPUT_VARIABLE output ERROR_VARIABLE error)
	if(NOT buildStatus STREQUAL "0")
		message(FATAL_ERROR "${name} link failed:\n${output}${error}")
	endif()
	if(NOT CMAKE_HOST_WIN32)
		execute_process(COMMAND "${probeBuild}/probe" RESULT_VARIABLE runStatus)
		if(NOT runStatus STREQUAL "0")
			message(FATAL_ERROR "${name} executable failed: ${runStatus}")
		endif()
	endif()
	file(READ "${probeBuild}/compile_commands.json" compileCommands)
	if(compileCommands MATCHES "-fuse-ld=|-B[^ ]*llvm|--threads=|keep-text-section-prefix|compress-debug-sections")
		message(FATAL_ERROR "Linker options leaked into compilation:\n${compileCommands}")
	endif()
endfunction()

function(check_vendor_archive name expectedThin expectedValue)
	set(probeBuild "${testRoot}/${name}")
	execute_process(COMMAND "${CMAKE_COMMAND}" --build "${probeBuild}"
		RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
	if(NOT status STREQUAL "0")
		message(FATAL_ERROR "${name}: vendor build failed:\n${output}${error}")
	endif()
	file(READ "${probeBuild}/vendor-path.txt" archivePath)
	file(READ "${archivePath}" magic LIMIT 8)
	if(expectedThin)
		set(expectedMagic "!<thin>\n")
	else()
		set(expectedMagic "!<arch>\n")
	endif()
	if(NOT magic STREQUAL expectedMagic)
		message(FATAL_ERROR "${name}: vendor archive has unexpected magic '${magic}'")
	endif()
	if(NOT CMAKE_HOST_WIN32)
		execute_process(COMMAND "${probeBuild}/vendor_link" RESULT_VARIABLE status OUTPUT_VARIABLE value)
		if(NOT status STREQUAL "0" OR NOT value STREQUAL expectedValue)
			message(FATAL_ERROR "${name}: vendor executable returned ${status}, value '${value}'")
		endif()
	endif()
endfunction()

function(check_object_debug_compression name allowed vendorAllowed)
	set(probeBuild "${testRoot}/${name}")
	file(READ "${probeBuild}/object-debug-options.txt" options)
	file(READ "${probeBuild}/vendor-object-debug-options.txt" vendorOptions)
	file(READ "${probeBuild}/compile_commands.json" commands)
	string(JSON commandCount LENGTH "${commands}")
	math(EXPR lastCommand "${commandCount} - 1")
	set(vendorCompressed FALSE)
	foreach(index RANGE 0 ${lastCommand})
		string(JSON command GET "${commands}" ${index} command)
		if(command MATCHES "vendor_probe\\.dir" AND command MATCHES "vendor-c\\.c" AND command MATCHES "-gz=zstd")
			message(FATAL_ERROR "${name}: C++ object compression leaked into vendor C compilation")
		endif()
		if(command MATCHES "vendor_probe\\.dir" AND command MATCHES "vendor-debug\\.cpp" AND command MATCHES "-gz=zstd")
			set(vendorCompressed TRUE)
		endif()
	endforeach()
	if(NOT vendorAllowed AND vendorOptions)
		message(FATAL_ERROR "${name}: vendor object compression should be disabled")
	endif()
	if(vendorOptions STREQUAL "-gz=zstd")
		if(NOT vendorCompressed)
			message(FATAL_ERROR "${name}: vendor object compression did not reach compilation")
		endif()
		find_program(vendorReadelf NAMES llvm-readelf readelf)
		if(vendorReadelf)
			execute_process(COMMAND "${vendorReadelf}" -SW "${probeBuild}/CMakeFiles/vendor_probe.dir/vendor-debug.cpp.o"
				RESULT_VARIABLE status OUTPUT_VARIABLE sections ERROR_VARIABLE error)
			if(NOT status STREQUAL "0" OR NOT sections MATCHES "\\.debug_info[^\n]*[ \t]C[ \t]")
				message(FATAL_ERROR "${name}: vendor object debug info is not compressed:\n${sections}${error}")
			endif()
		endif()
	endif()
	if(NOT allowed)
		if(options)
			message(FATAL_ERROR "${name}: object compression should be disabled")
		endif()
		return()
	endif()
	if(NOT options STREQUAL "-gz=zstd")
		message(STATUS "${name}: zstd object compression unavailable on this toolchain")
		return()
	endif()
	if(NOT commands MATCHES "-gz=zstd")
		message(FATAL_ERROR "${name}: object compression did not reach compilation")
	endif()
	find_program(probeReadelf NAMES llvm-readelf readelf)
	if(probeReadelf)
		execute_process(COMMAND "${probeReadelf}" -SW "${probeBuild}/CMakeFiles/probe.dir/main.cpp.o"
			RESULT_VARIABLE status OUTPUT_VARIABLE sections ERROR_VARIABLE error)
		if(NOT status STREQUAL "0" OR NOT sections MATCHES "\\.debug_info[^\n]*[ \t]C[ \t]")
			message(FATAL_ERROR "${name}: object debug info is not compressed:\n${sections}${error}")
		endif()
	endif()
endfunction()

function(check_debug_compression name allowed)
	set(probeBuild "${testRoot}/${name}")
	file(READ "${probeBuild}/build.ninja" linkCommands)
	if(NOT allowed)
		if(linkCommands MATCHES "--compress-debug-sections")
			message(FATAL_ERROR "${name}: disabled debug compression reached the link")
		endif()
		return()
	endif()
	if(NOT linkCommands MATCHES "--compress-debug-sections=zstd")
		message(STATUS "${name}: zstd debug compression unavailable on this linker")
		return()
	endif()
	find_program(probeReadelf NAMES llvm-readelf readelf)
	if(probeReadelf)
		execute_process(COMMAND "${probeReadelf}" -SW "${probeBuild}/probe"
			RESULT_VARIABLE inspectStatus OUTPUT_VARIABLE sections ERROR_VARIABLE error)
		if(NOT inspectStatus STREQUAL "0" OR NOT sections MATCHES "\\.debug_info[^\n]*[ \t]C[ \t]")
			message(FATAL_ERROR "${name}: debug info is not compressed:\n${sections}${error}")
		endif()
	endif()
endfunction()

function(check_lld_sections name)
	set(probeBuild "${testRoot}/${name}")
	file(READ "${probeBuild}/build.ninja" linkCommands)
	if(NOT linkCommands MATCHES "keep-text-section-prefix")
		message(FATAL_ERROR "${name} link command omitted keep-text-section-prefix")
	endif()

	find_program(probeReadelf NAMES llvm-readelf readelf)
	if(probeReadelf)
		execute_process(COMMAND "${probeReadelf}" -SW "${probeBuild}/probe"
			RESULT_VARIABLE inspectStatus OUTPUT_VARIABLE sections ERROR_VARIABLE error)
	elseif(CMAKE_OBJDUMP)
		execute_process(COMMAND "${CMAKE_OBJDUMP}" -h "${probeBuild}/probe"
			RESULT_VARIABLE inspectStatus OUTPUT_VARIABLE sections ERROR_VARIABLE error)
	else()
		message(FATAL_ERROR "No readelf or CMAKE_OBJDUMP is available to inspect the LLD probe")
	endif()
	if(NOT inspectStatus STREQUAL "0")
		message(FATAL_ERROR "${name} section inspection failed:\n${error}")
	endif()
	foreach(section IN ITEMS hot unlikely startup)
		if(NOT sections MATCHES "\\.text\\.${section}[ \t]")
			message(FATAL_ERROR "${name} executable lacks .text.${section}:\n${sections}")
		endif()
	endforeach()
endfunction()

function(check_archive name expectedThin expectedSum)
	set(probeBuild "${testRoot}/${name}")
	execute_process(COMMAND "${CMAKE_COMMAND}" --build "${probeBuild}"
		RESULT_VARIABLE buildStatus OUTPUT_VARIABLE output ERROR_VARIABLE error)
	if(NOT buildStatus STREQUAL "0")
		message(FATAL_ERROR "${name} archive build failed:\n${output}${error}")
	endif()
	file(READ "${probeBuild}/archive-path.txt" archivePath)
	file(READ "${archivePath}" archiveMagic LIMIT 8)
	if(expectedThin)
		set(expectedMagic "!<thin>\n")
	else()
		set(expectedMagic "!<arch>\n")
	endif()
	if(NOT archiveMagic STREQUAL expectedMagic)
		message(FATAL_ERROR "${name}: archive has unexpected magic '${archiveMagic}'")
	endif()
	file(READ "${probeBuild}/vendor-path.txt" vendorPath)
	file(READ "${vendorPath}" vendorMagic LIMIT 8)
	if(NOT vendorMagic STREQUAL "!<arch>\n")
		message(FATAL_ERROR "${name}: vendor archive rules changed")
	endif()
	if(NOT CMAKE_HOST_WIN32)
		execute_process(COMMAND "${probeBuild}/archive_probe"
			RESULT_VARIABLE runStatus OUTPUT_VARIABLE sum)
		if(NOT runStatus STREQUAL "0" OR NOT sum STREQUAL expectedSum)
			message(FATAL_ERROR "${name}: archive executable returned ${runStatus}, sum '${sum}'")
		endif()
	endif()
endfunction()

