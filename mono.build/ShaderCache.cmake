# Cache SPIR-V across build trees. Shadercross still consumes the staged result.
cmake_minimum_required(VERSION 3.24)

foreach(required IN ITEMS CACHE COMPILER SOURCE OUTPUT INCLUDE)
	if(NOT DEFINED MONO_SHADER_${required} OR MONO_SHADER_${required} STREQUAL "")
		message(FATAL_ERROR "Set MONO_SHADER_${required}")
	endif()
endforeach()
foreach(path IN ITEMS CACHE COMPILER SOURCE OUTPUT INCLUDE)
	get_filename_component(MONO_SHADER_${path} "${MONO_SHADER_${path}}" ABSOLUTE)
endforeach()
string(SHA256 sourceId "${MONO_SHADER_SOURCE}")
set(cacheDirectory "${MONO_SHADER_CACHE}/${sourceId}")
file(MAKE_DIRECTORY "${cacheDirectory}")
# One source owns both publication and eviction, including across parallel presets.
file(LOCK "${cacheDirectory}/lock" GUARD PROCESS TIMEOUT 600)
file(REMOVE "${cacheDirectory}/pending.spv" "${cacheDirectory}/pending.sha256")

set(headers)
foreach(header IN LISTS MONO_SHADER_HEADERS)
	get_filename_component(header "${header}" ABSOLUTE)
	list(APPEND headers "${header}")
endforeach()
list(REMOVE_DUPLICATES headers)
list(SORT headers)

function(shader_signature keyOutput stampOutput)
	set(signature)
	set(stamps)
	foreach(input IN ITEMS "${CMAKE_CURRENT_LIST_FILE}" "${MONO_SHADER_COMPILER}" "${MONO_SHADER_SOURCE}")
		file(SHA256 "${input}" contentHash)
		file(TIMESTAMP "${input}" modified "%s.%f" UTC)
		string(APPEND signature ":${contentHash}")
		string(APPEND stamps ":${modified}")
	endforeach()
	# Hash arguments separately so boundaries and order are part of the key.
	foreach(argument IN ITEMS "${MONO_SHADER_INCLUDE}" "${MONO_SHADER_SOURCE}")
		string(SHA256 argumentHash "${argument}")
		string(APPEND signature ":${argumentHash}")
	endforeach()
	foreach(argument IN LISTS MONO_SHADER_FLAGS)
		string(SHA256 argumentHash "${argument}")
		string(APPEND signature ":flag:${argumentHash}")
	endforeach()
	foreach(header IN LISTS headers)
		file(SHA256 "${header}" contentHash)
		file(TIMESTAMP "${header}" modified "%s.%f" UTC)
		string(SHA256 nameHash "${header}")
		string(APPEND signature ":header:${nameHash}:${contentHash}")
		string(APPEND stamps ":${modified}")
	endforeach()
	string(SHA256 key "${signature}")
	set(${keyOutput} "${key}" PARENT_SCOPE)
	set(${stampOutput} "${stamps}" PARENT_SCOPE)
endfunction()

# Content keys survive timestamp-only checkouts. Separate stamps catch edits
# reverted during compilation, whose transient bytes must never poison a key.
set(stable FALSE)
foreach(attempt RANGE 1 3)
	shader_signature(key beforeStamps)
	set(cached "${cacheDirectory}/${key}.spv")
	set(cacheHit FALSE)
	if(EXISTS "${cached}" AND EXISTS "${cached}.sha256")
		file(SHA256 "${cached}" actualHash)
		file(READ "${cached}.sha256" expectedHash)
		if(actualHash STREQUAL expectedHash)
			set(cacheHit TRUE)
		endif()
	endif()
	if(cacheHit)
		set(stable TRUE)
		break()
	endif()
	file(REMOVE "${cached}" "${cached}.sha256")
	execute_process(COMMAND "${MONO_SHADER_COMPILER}" ${MONO_SHADER_FLAGS}
		-I "${MONO_SHADER_INCLUDE}" "${MONO_SHADER_SOURCE}" -o "${cacheDirectory}/pending.spv"
		RESULT_VARIABLE compileStatus)
	if(NOT compileStatus STREQUAL "0" OR NOT EXISTS "${cacheDirectory}/pending.spv")
		file(REMOVE "${cacheDirectory}/pending.spv")
		message(FATAL_ERROR "Shader compilation failed (${compileStatus}): ${MONO_SHADER_SOURCE}")
	endif()
	shader_signature(afterKey afterStamps)
	if(NOT key STREQUAL afterKey OR NOT beforeStamps STREQUAL afterStamps)
		file(REMOVE "${cacheDirectory}/pending.spv")
		continue()
	endif()
	file(SHA256 "${cacheDirectory}/pending.spv" outputHash)
	file(WRITE "${cacheDirectory}/pending.sha256" "${outputHash}")
	file(RENAME "${cacheDirectory}/pending.spv" "${cached}")
	file(RENAME "${cacheDirectory}/pending.sha256" "${cached}.sha256")
	set(stable TRUE)
	break()
endforeach()
if(NOT stable)
	message(FATAL_ERROR "Shader inputs changed during all three compilation attempts: ${MONO_SHADER_SOURCE}")
endif()

get_filename_component(outputDirectory "${MONO_SHADER_OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${outputDirectory}")
configure_file("${cached}" "${MONO_SHADER_OUTPUT}.cache-tmp" COPYONLY)
file(RENAME "${MONO_SHADER_OUTPUT}.cache-tmp" "${MONO_SHADER_OUTPUT}")
# An identical restored file must still be newer than touched build dependencies.
file(TOUCH "${MONO_SHADER_OUTPUT}" "${cached}")

# Four variants retain recent flag/header edits without unbounded per-source growth.
file(GLOB variants "${cacheDirectory}/*.spv")
list(REMOVE_ITEM variants "${cached}")
set(recentVariants)
foreach(variant IN LISTS variants)
	file(TIMESTAMP "${variant}" lastUsed "%Y%m%d%H%M%S" UTC)
	list(APPEND recentVariants "${lastUsed}:${variant}")
endforeach()
list(SORT recentVariants ORDER DESCENDING)
list(LENGTH recentVariants variantCount)
if(variantCount GREATER 3)
	list(SUBLIST recentVariants 3 -1 expiredVariants)
	foreach(expired IN LISTS expiredVariants)
		string(SUBSTRING "${expired}" 15 -1 variant)
		file(REMOVE "${variant}" "${variant}.sha256")
	endforeach()
endif()
