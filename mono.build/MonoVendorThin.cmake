# Large build-only vendor archives can reference their objects instead of
# storing a second copy. Distribution and unsupported toolchains stay fat.
include_guard(GLOBAL)

option(MONO_THIN_VENDOR_ARCHIVES "Use thin archives for selected build-only vendor targets" OFF)
set(MONO_VENDOR_ARCHIVE_OPTIONS "")

if(MONO_THIN_VENDOR_ARCHIVES AND MONO_THIN_ARCHIVES AND CMAKE_SYSTEM_NAME STREQUAL "Linux" AND
	NOT CMAKE_CROSSCOMPILING AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
	function(_mono_probe_vendor_thin)
		include(CheckCXXSourceCompiles)
		get_directory_property(linkOptions LINK_OPTIONS)
		string(TOUPPER "${CMAKE_BUILD_TYPE}" buildConfiguration)
		set(configFlags "${CMAKE_CXX_FLAGS_${buildConfiguration}}")
		foreach(tool IN ITEMS CMAKE_CXX_COMPILER CMAKE_AR CMAKE_RANLIB CMAKE_LINKER MONO_LLD)
			if(EXISTS "${${tool}}")
				file(TIMESTAMP "${${tool}}" "${tool}Timestamp" UTC)
			endif()
		endforeach()
		string(SHA256 probeKey
			"${CMAKE_CXX_COMPILER};${CMAKE_CXX_COMPILER_VERSION};${CMAKE_CXX_COMPILERTimestamp};${CMAKE_AR};${CMAKE_ARTimestamp};${CMAKE_RANLIB};${CMAKE_RANLIBTimestamp};${CMAKE_LINKER};${CMAKE_LINKERTimestamp};${MONO_LLD};${MONO_LLDTimestamp};${CMAKE_CXX_COMPILER_ARG1};${CMAKE_CXX_FLAGS};${configFlags};${CMAKE_SYSROOT};${CMAKE_SYSROOT_COMPILE};${CMAKE_SYSROOT_LINK};${CMAKE_EXE_LINKER_FLAGS};${CMAKE_EXE_LINKER_FLAGS_${buildConfiguration}};${linkOptions}")
		set(probe "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/mono-vendor-thin-probe")
		file(REMOVE "${probe}.a" "${probe}.o")
		file(WRITE "${probe}.cpp" "int value() { return 42; }\n")
		separate_arguments(compilerArgument NATIVE_COMMAND "${CMAKE_CXX_COMPILER_ARG1}")
		separate_arguments(compilerFlags NATIVE_COMMAND "${CMAKE_CXX_FLAGS} ${configFlags}")
		set(sysrootOption "")
		if(CMAKE_SYSROOT_COMPILE)
			set(sysrootOption "--sysroot=${CMAKE_SYSROOT_COMPILE}")
		elseif(CMAKE_SYSROOT)
			set(sysrootOption "--sysroot=${CMAKE_SYSROOT}")
		endif()
		execute_process(COMMAND "${CMAKE_CXX_COMPILER}" ${compilerArgument} ${compilerFlags} ${sysrootOption}
			-c "${probe}.cpp" -o "${probe}.o" RESULT_VARIABLE compileStatus OUTPUT_QUIET ERROR_QUIET)
		if(compileStatus STREQUAL "0")
			execute_process(COMMAND "${CMAKE_AR}" qcT "${probe}.a" "${probe}.o"
				RESULT_VARIABLE archiveStatus OUTPUT_QUIET ERROR_QUIET)
			if(archiveStatus STREQUAL "0")
				execute_process(COMMAND "${CMAKE_RANLIB}" "${probe}.a"
					RESULT_VARIABLE ranlibStatus OUTPUT_QUIET ERROR_QUIET)
				file(READ "${probe}.a" archiveMagic LIMIT 8)
			endif()
		endif()
		if(ranlibStatus STREQUAL "0" AND archiveMagic STREQUAL "!<thin>\n")
			# Vendor tools use the default linker; engine programs may select another.
			set(CMAKE_TRY_COMPILE_TARGET_TYPE EXECUTABLE)
			set(CMAKE_REQUIRED_LIBRARIES "${probe}.a")
			check_cxx_source_compiles("int value(); int main() { return value() == 42 ? 0 : 1; }"
				MONO_VENDOR_THIN_DEFAULT_${probeKey})
			list(APPEND CMAKE_REQUIRED_LINK_OPTIONS ${linkOptions})
			check_cxx_source_compiles("int value(); int main() { return value() == 42 ? 0 : 1; }"
				MONO_VENDOR_THIN_SELECTED_${probeKey})
			if(MONO_VENDOR_THIN_DEFAULT_${probeKey} AND MONO_VENDOR_THIN_SELECTED_${probeKey})
				set(MONO_VENDOR_ARCHIVE_OPTIONS --thin PARENT_SCOPE)
			endif()
		endif()
		file(REMOVE "${probe}.cpp" "${probe}.o" "${probe}.a")
	endfunction()
	_mono_probe_vendor_thin()
	if(NOT MONO_VENDOR_ARCHIVE_OPTIONS)
		message(STATUS "vendor thin archives: unavailable; using standalone archives")
	endif()
endif()

function(mono_vendor_thin target)
	if(NOT MONO_VENDOR_ARCHIVE_OPTIONS OR NOT TARGET "${target}")
		return()
	endif()
	get_target_property(kind "${target}" TYPE)
	get_target_property(imported "${target}" IMPORTED)
	if(kind STREQUAL "STATIC_LIBRARY" AND NOT imported)
		set_property(TARGET "${target}" APPEND PROPERTY STATIC_LIBRARY_OPTIONS "${MONO_VENDOR_ARCHIVE_OPTIONS}")
	endif()
endfunction()
