#!/usr/bin/env bash
#
# **The one thing nobody runs, run automatically: `preset=ci`.**
#
# `docs/retired/DEFERRED.md` D00005 records this preset going uncompilable three
# times while being named as the standard - `-Wmissing-field-initializers` at
# v0.4, then twice inside v0.15, the second a `-Wdangling-reference` in
# `mono.cdn` that was live while a roadmap line said the preset exited 0. Each
# lasted for however long it took somebody to think of typing `preset=ci`.
# There is no machine other than this one and there is not going to be, so the
# only thing that can run the strict preset is the push.
#
# **It builds and does not test, and that is the whole design.** The failure
# class this exists for is a warning going fatal - the `ci` preset compiling at
# all - and that is a compile-time property. Tests are already run by
# `just check`, cost two and a half minutes, and are red in this tree whenever
# somebody else's half-finished module is. A gate that goes red for work that is
# not yours is a gate that gets `--no-verify`'d every time, which is the entry
# recurring with extra steps.
#
# Warm it costs about a second. It is expensive exactly when a lot has changed,
# which is exactly when it should run.
#
# Deliberately escapable, and only deliberately: `git push --no-verify`.
#
# Installed by `just install-hooks`, which `just setup` also runs - the hook has
# to be checked in rather than left in one clone's `.git/hooks`, or it is a rule
# that exists only in the memory of whoever set it up.

set -euo pipefail

# Git normally starts a non-bare hook at the worktree root, but GUI clients can
# launch it with a reduced PATH and no usable `git` command. The hook location
# is already inside the worktree, so derive the root without a command
# substitution that can leave `cd` with an empty argument.
hook_path="${BASH_SOURCE[0]}"
hook_directory="${hook_path%/*}"
if [ "$hook_directory" = "$hook_path" ]; then
	hook_directory="."
fi
cd -- "$hook_directory/.." || {
	echo "pre-push: unable to locate the repository from $hook_path." >&2
	exit 1
}

# A push that only deletes refs compiles nothing. Everything else, including a
# tag, is somebody publishing a tree and gets built.
only_deletions=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
	if [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
		only_deletions=0
	fi
done
if [ "$only_deletions" = "1" ]; then
	exit 0
fi

# Missing tool is a failure, not a skip - `just format-check` argues this at
# length and it is the same argument: a gate that exits 0 having run nothing is
# worse than no gate, because the push looks checked.
if ! command -v just > /dev/null; then
	echo "pre-push: no 'just' on PATH, so the ci preset was not built." >&2
	echo "  Install just, or push with --no-verify and say so." >&2
	exit 1
fi

echo "pre-push: building the ci preset - every warning fatal." >&2
if ! just preset=ci build; then
	echo "" >&2
	echo "pre-push: the ci preset does not compile, so the push is refused." >&2
	echo "  Fix the warning. Relaxing the preset is not the fix - being strict" >&2
	echo "  is the entire content of the preset." >&2
	echo "  Deliberately anyway:  git push --no-verify" >&2
	exit 1
fi
echo "pre-push: ci preset ok." >&2
