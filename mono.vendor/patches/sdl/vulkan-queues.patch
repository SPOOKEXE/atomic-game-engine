+    if (!buffer || buffer->commandPool->threadID != SDL_GetCurrentThreadID() || !buffer->atomicAcquired) {
+        SDL_SetError("Atomic GPU native handle requires its acquiring recording thread");
+        return VK_NULL_HANDLE;
