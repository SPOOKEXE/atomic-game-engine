+static bool SDLCALL VULKAN_AtomicReleaseFrozenResources(SDL_GPUDevice *device, Uint32 count, AtomicGpuResource *resources)
+{
+    VulkanRenderer *renderer;
+    if (!device || count > ATOMIC_GPU_QUEUES_MAX_RESOURCES || (count && !resources)) {
+        return SDL_SetError("Atomic GPU frozen release arguments are invalid");
+    }
+    renderer = (VulkanRenderer *)device->driverData;
+    if (SDL_GetCurrentThreadID() != renderer->atomicOwner || !renderer->atomicRecordingBatch ||
+        SDL_GetAtomicInt(&renderer->atomicFrozenResources) < (Sint32)count) {
+        return SDL_SetError("Atomic GPU frozen release requires its owner recording batch");
+    }
+    for (Uint32 i = 0; i < count; ++i) {
+        if (!resources[i].Handle || resources[i].Kind > ATOMIC_GPU_RESOURCE_COMPUTE_PIPELINE) {
+            return SDL_SetError("Atomic GPU frozen release resource kind or handle is invalid");
+        }
+        if (resources[i].Kind == ATOMIC_GPU_RESOURCE_BUFFER || resources[i].Kind == ATOMIC_GPU_RESOURCE_TEXTURE) {
+            for (Uint32 j = 0; j < i; ++j) {
+                if (resources[j].Handle == resources[i].Handle) {
+                    return SDL_SetError("Atomic GPU frozen release repeats a resource facade");
+                }
+            }
+        }
+    }
+    for (Uint32 i = 0; i < count; ++i) VULKAN_INTERNAL_ReleaseFrozenResource(&resources[i]);
+    SDL_AddAtomicInt(&renderer->atomicFrozenResources, -(Sint32)count);
+    return true;
+}
