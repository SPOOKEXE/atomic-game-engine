+static bool SDLCALL VULKAN_AtomicSetDependencies(SDL_GPUCommandBuffer *command, uint32_t waitCount,
+    const VkSemaphore *waits, const VkPipelineStageFlags *waitStages, uint32_t signalCount, const VkSemaphore *signals)
+{
+    VulkanCommandBuffer *buffer = (VulkanCommandBuffer *)command;
+    if (!buffer || buffer->commandPool->threadID != SDL_GetCurrentThreadID() || !buffer->atomicAcquired ||
+        waitCount > ATOMIC_QUEUE_MAX_SEMAPHORES || signalCount > ATOMIC_QUEUE_MAX_SEMAPHORES ||
+        (waitCount && (!waits || !waitStages)) || (signalCount && !signals)) {
+        return SDL_SetError("Atomic GPU dependency arguments or recording thread are invalid");
+    }
+    for (Uint32 i = 0; i < waitCount; ++i) {
+        if (waits[i] == VK_NULL_HANDLE || waitStages[i] != VK_PIPELINE_STAGE_ALL_COMMANDS_BIT) {
+            return SDL_SetError("Atomic GPU waits require binary semaphores and ALL_COMMANDS scope");
+        }
+        for (Uint32 j = 0; j < i; ++j) {
+            if (waits[i] == waits[j]) return SDL_SetError("Atomic GPU duplicate semaphore wait");
+        }
+    }
+    for (Uint32 i = 0; i < signalCount; ++i) {
+        if (signals[i] == VK_NULL_HANDLE) return SDL_SetError("Atomic GPU signal semaphore is null");
+        for (Uint32 j = 0; j < i; ++j) {
+            if (signals[i] == signals[j]) return SDL_SetError("Atomic GPU duplicate semaphore signal");
+        }
+        for (Uint32 j = 0; j < waitCount; ++j) {
+            if (signals[i] == waits[j]) return SDL_SetError("Atomic GPU semaphore cannot wait and signal in one submission");
+        }
+    }
+    if (waitCount) {
+        SDL_memcpy(buffer->atomicWaits, waits, waitCount * sizeof(VkSemaphore));
+        SDL_memcpy(buffer->atomicWaitStages, waitStages, waitCount * sizeof(VkPipelineStageFlags));
+    }
+    if (signalCount) SDL_memcpy(buffer->atomicSignals, signals, signalCount * sizeof(VkSemaphore));
+    buffer->atomicWaitCount = waitCount;
+    buffer->atomicSignalCount = signalCount;
+    return true;
+}
+
+static VkCommandBuffer SDLCALL VULKAN_AtomicNativeCommandBuffer(SDL_GPUCommandBuffer *command)
+{
+    VulkanCommandBuffer *buffer = (VulkanCommandBuffer *)command;
+    if (!buffer || buffer->commandPool->threadID != SDL_GetCurrentThreadID() || !buffer->atomicAcquired) {
+        SDL_SetError("Atomic GPU native handle requires its acquiring recording thread");
+        return VK_NULL_HANDLE;
+    }
+    return buffer->commandBuffer;
+}
