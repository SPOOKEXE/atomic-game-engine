+}
+
+static bool SDLCALL VULKAN_AtomicEndBatch(SDL_GPUDevice *device)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)device->driverData;
+    bool accepted;
+    SDL_LockMutex(renderer->submitLock);
+    accepted = SDL_GetCurrentThreadID() == renderer->atomicOwner && renderer->atomicRecordingBatch &&
+        SDL_GetAtomicInt(&renderer->atomicOutstandingCommands) == 0;
+    if (accepted) renderer->atomicRecordingBatch = false;
+    SDL_UnlockMutex(renderer->submitLock);
+    return accepted ? true : SDL_SetError("Atomic GPU batch still owns unsubmitted command buffers");
+}
