+static bool VULKAN_AtomicPublish(SDL_GPUDevice *device)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)device->driverData;
+    AtomicGpuQueuesV1 *api = &renderer->atomicApi;
+    if (!renderer->atomicQueuesEnabled) return true;
+    SDL_zero(*api);
+    api->StructSize = sizeof(*api);
+    api->AbiVersion = ATOMIC_GPU_QUEUES_ABI_VERSION;
+    api->Instance = renderer->instance;
+    api->PhysicalDevice = renderer->physicalDevice;
+    api->Device = renderer->logicalDevice;
+    api->GetDeviceProcAddr = renderer->vkGetDeviceProcAddr;
+    api->Properties = renderer->physicalDeviceProperties.properties;
+    for (Uint32 q = 0; q < ATOMIC_QUEUE_COUNT; ++q) {
+        api->Family[q] = renderer->atomicQueueFamilies[q];
+        api->QueueCount[q] = renderer->atomicQueueCounts[q];
+        api->QueueFlags[q] = renderer->atomicQueueFlags[q];
+        api->TimestampValidBits[q] = renderer->atomicTimestampBits[q];
+        api->Queue[q] = renderer->atomicQueues[q];
+    }
+    api->BeginRecordingBatch = VULKAN_AtomicBeginBatch;
+    api->EndRecordingBatch = VULKAN_AtomicEndBatch;
+    api->MaintainIdle = VULKAN_AtomicMaintainIdle;
+    api->Acquire = VULKAN_AtomicAcquire;
+    api->SetDependencies = VULKAN_AtomicSetDependencies;
+    api->NativeCommandBuffer = VULKAN_AtomicNativeCommandBuffer;
+    return SDL_SetPointerProperty(renderer->props, ATOMIC_GPU_QUEUES_DEVICE_PROPERTY, api);
+}
