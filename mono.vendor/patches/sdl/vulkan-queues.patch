+/* Facades pin shared backing. Ordinary SDL release would mark it for destruction. */
+static void VULKAN_INTERNAL_ReleaseFrozenResource(AtomicGpuResource *resource)
+{
+    switch (resource->Kind) {
+    case ATOMIC_GPU_RESOURCE_BUFFER: {
+        VulkanBufferContainer *container = (VulkanBufferContainer *)resource->Handle;
+        (void)SDL_AtomicDecRef(&container->activeBuffer->referenceCount);
+        SDL_free(container->buffers);
+        SDL_free(container);
+        break;
+    }
+    case ATOMIC_GPU_RESOURCE_TEXTURE: {
+        VulkanTextureContainer *container = (VulkanTextureContainer *)resource->Handle;
+        (void)SDL_AtomicDecRef(&container->activeTexture->referenceCount);
+        SDL_free(container->textures);
+        SDL_free(container);
+        break;
+    }
+    case ATOMIC_GPU_RESOURCE_SAMPLER:
+        (void)SDL_AtomicDecRef(&((VulkanSampler *)resource->Handle)->referenceCount);
+        break;
+    case ATOMIC_GPU_RESOURCE_GRAPHICS_PIPELINE:
+        (void)SDL_AtomicDecRef(&((VulkanGraphicsPipeline *)resource->Handle)->referenceCount);
+        break;
+    case ATOMIC_GPU_RESOURCE_COMPUTE_PIPELINE:
+        (void)SDL_AtomicDecRef(&((VulkanComputePipeline *)resource->Handle)->referenceCount);
+        break;
+    }
+    SDL_zero(*resource);
+}
