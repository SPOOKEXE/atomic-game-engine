+        SDL_GetAtomicInt(&renderer->atomicFrozenResources) != 0 ||
+        renderer->atomicDeviceCleanupCount >= SDL_arraysize(renderer->atomicDeviceCleanups)) {
+        SDL_UnlockMutex(renderer->submitLock);
