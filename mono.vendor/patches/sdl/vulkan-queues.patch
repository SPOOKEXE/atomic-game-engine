+static SDL_GPUCommandBuffer *SDLCALL VULKAN_AtomicAcquire(SDL_GPUDevice *device, uint32_t queueClass)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)device->driverData;
+    SDL_GPUCommandBuffer *command;
+    if (queueClass >= ATOMIC_QUEUE_COUNT) {
+        SDL_SetError("Atomic GPU queue class is invalid");
+        return NULL;
+    }
+    if ((queueClass == 1 && !(renderer->atomicQueueFlags[queueClass] & VK_QUEUE_COMPUTE_BIT)) ||
+        (queueClass == 2 && !(renderer->atomicQueueFlags[queueClass] & (VK_QUEUE_TRANSFER_BIT | VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT)))) {
+        SDL_SetError("Atomic GPU queue lacks required capability");
+        return NULL;
+    }
+    command = VULKAN_INTERNAL_AcquireQueueCommandBuffer(device->driverData, queueClass);
+    if (command) SDL_GPU_InitializeCommandBuffer(device, command);
+    return command;
