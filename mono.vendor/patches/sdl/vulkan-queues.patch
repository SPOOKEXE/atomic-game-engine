+static void VULKAN_INTERNAL_SelectAtomicQueues(VulkanRenderer *renderer)
+{
+    Uint32 count = 0;
+    VkQueueFamilyProperties *families;
+    for (Uint32 q = 0; q < ATOMIC_QUEUE_COUNT; ++q) {
+        renderer->atomicQueueFamilies[q] = renderer->queueFamilyIndex;
+    }
+    if (!renderer->atomicQueuesEnabled) return;
+    renderer->vkGetPhysicalDeviceQueueFamilyProperties(renderer->physicalDevice, &count, NULL);
+    families = SDL_stack_alloc(VkQueueFamilyProperties, count);
+    renderer->vkGetPhysicalDeviceQueueFamilyProperties(renderer->physicalDevice, &count, families);
+    for (Uint32 i = 0; i < count; ++i) {
+        VkQueueFlags flags = families[i].queueFlags;
+        if (!families[i].queueCount) continue;
+        if ((flags & VK_QUEUE_COMPUTE_BIT) && !(flags & VK_QUEUE_GRAPHICS_BIT)) {
+            renderer->atomicQueueFamilies[1] = i;
+        }
+        if ((flags & VK_QUEUE_TRANSFER_BIT) && !(flags & ~(VK_QUEUE_TRANSFER_BIT | VK_QUEUE_SPARSE_BINDING_BIT))) {
+            renderer->atomicQueueFamilies[2] = i;
+        }
+    }
+    for (Uint32 q = 0; q < ATOMIC_QUEUE_COUNT; ++q) {
+        Uint32 family = renderer->atomicQueueFamilies[q];
+        renderer->atomicQueueFlags[q] = families[family].queueFlags;
+        renderer->atomicQueueCounts[q] = families[family].queueCount;
+        renderer->atomicTimestampBits[q] = families[family].timestampValidBits;
+        bool found = false;
+        for (Uint32 j = 0; j < renderer->atomicSharingCount; ++j) {
+            found |= renderer->atomicSharingFamilies[j] == family;
+        }
+        if (!found) renderer->atomicSharingFamilies[renderer->atomicSharingCount++] = family;
+    }
+    SDL_stack_free(families);
+}
