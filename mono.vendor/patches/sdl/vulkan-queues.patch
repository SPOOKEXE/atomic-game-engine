+static bool SDLCALL VULKAN_AtomicDeferDeviceCleanup(SDL_GPUDevice *device,
+    void (SDLCALL *cleanup)(void *userdata, bool resourcesRetired), void *userdata)
+{
+    VulkanRenderer *renderer;
+    if (!device || !cleanup) return SDL_SetError("Atomic GPU device cleanup arguments are invalid");
+    renderer = (VulkanRenderer *)device->driverData;
+    SDL_LockMutex(renderer->submitLock);
+    if (SDL_GetCurrentThreadID() != renderer->atomicOwner || renderer->atomicRecordingBatch ||
+        renderer->atomicMaintenance || renderer->atomicDestroying ||
+        SDL_GetAtomicInt(&renderer->atomicOutstandingCommands) != 0 ||
+        SDL_GetAtomicInt(&renderer->atomicFrozenResources) != 0 ||
+        renderer->atomicDeviceCleanupCount >= SDL_arraysize(renderer->atomicDeviceCleanups)) {
+        SDL_UnlockMutex(renderer->submitLock);
+        return SDL_SetError("Atomic GPU device cleanup requires idle owner state and an available callback slot");
+    }
+    for (Uint32 i = 0; i < renderer->atomicDeviceCleanupCount; ++i) {
+        if (renderer->atomicDeviceCleanups[i].cleanup == cleanup &&
+            renderer->atomicDeviceCleanups[i].userdata == userdata) {
+            SDL_UnlockMutex(renderer->submitLock);
+            return SDL_SetError("Atomic GPU device cleanup is already registered");
+        }
+    }
+    renderer->atomicDeviceCleanups[renderer->atomicDeviceCleanupCount].cleanup = cleanup;
+    renderer->atomicDeviceCleanups[renderer->atomicDeviceCleanupCount].userdata = userdata;
+    ++renderer->atomicDeviceCleanupCount;
+    SDL_UnlockMutex(renderer->submitLock);
+    return true;
+}
