+static bool SDLCALL VULKAN_AtomicFreezeResources(SDL_GPUDevice *device, Uint32 count,
+    const AtomicGpuResource *sources, AtomicGpuResource *outputs)
+{
+    VulkanRenderer *renderer;
+    AtomicGpuResource inputs[ATOMIC_GPU_QUEUES_MAX_RESOURCES];
+    Uint32 completed = 0;
+    if (!device || count > ATOMIC_GPU_QUEUES_MAX_RESOURCES || (count && (!sources || !outputs))) {
+        return SDL_SetError("Atomic GPU freeze arguments are invalid");
+    }
+    renderer = (VulkanRenderer *)device->driverData;
+    if (SDL_GetCurrentThreadID() != renderer->atomicOwner || !renderer->atomicRecordingBatch ||
+        SDL_GetAtomicInt(&renderer->atomicFrozenResources) > SDL_MAX_SINT32 - (Sint32)count) {
+        return SDL_SetError("Atomic GPU freeze requires an active owner recording batch");
+    }
+    if (count) {
+        SDL_memcpy(inputs, sources, count * sizeof(*inputs));
+        SDL_memset(outputs, 0, count * sizeof(*outputs));
+    }
+    for (Uint32 i = 0; i < count; ++i) {
+        if (!inputs[i].Handle || inputs[i].Kind > ATOMIC_GPU_RESOURCE_COMPUTE_PIPELINE) {
+            return SDL_SetError("Atomic GPU freeze resource kind or handle is invalid");
+        }
+    }
+    for (; completed < count; ++completed) {
+        AtomicGpuResource *input = &inputs[completed];
+        AtomicGpuResource *output = &outputs[completed];
+        output->Kind = input->Kind;
+        switch (input->Kind) {
+        case ATOMIC_GPU_RESOURCE_BUFFER: {
+            VulkanBufferContainer *source = (VulkanBufferContainer *)input->Handle;
+            VulkanBufferContainer *container = SDL_malloc(sizeof(*container));
+            if (!container) goto allocation_failed;
+            *container = *source;
+            container->buffers = SDL_malloc(sizeof(*container->buffers));
+            if (!container->buffers) {
+                SDL_free(container);
+                goto allocation_failed;
+            }
+            container->buffers[0] = container->activeBuffer;
+            container->bufferCount = 1;
+            container->bufferCapacity = 1;
+            container->debugName = NULL;
+            SDL_AtomicIncRef(&container->activeBuffer->referenceCount);
+            output->Handle = container;
+            break;
+        }
+        case ATOMIC_GPU_RESOURCE_TEXTURE: {
+            VulkanTextureContainer *source = (VulkanTextureContainer *)input->Handle;
+            VulkanTextureContainer *container = SDL_malloc(sizeof(*container));
+            if (!container) goto allocation_failed;
+            *container = *source;
+            container->textures = SDL_malloc(sizeof(*container->textures));
+            if (!container->textures) {
+                SDL_free(container);
+                goto allocation_failed;
+            }
+            container->textures[0] = container->activeTexture;
+            container->textureCount = 1;
+            container->textureCapacity = 1;
+            container->header.info.props = 0;
+            container->debugName = NULL;
+            container->canBeCycled = false;
+            SDL_AtomicIncRef(&container->activeTexture->referenceCount);
+            output->Handle = container;
+            break;
+        }
+        case ATOMIC_GPU_RESOURCE_SAMPLER:
+            SDL_AtomicIncRef(&((VulkanSampler *)input->Handle)->referenceCount);
+            output->Handle = input->Handle;
+            break;
+        case ATOMIC_GPU_RESOURCE_GRAPHICS_PIPELINE:
+            SDL_AtomicIncRef(&((VulkanGraphicsPipeline *)input->Handle)->referenceCount);
+            output->Handle = input->Handle;
+            break;
+        case ATOMIC_GPU_RESOURCE_COMPUTE_PIPELINE:
+            SDL_AtomicIncRef(&((VulkanComputePipeline *)input->Handle)->referenceCount);
+            output->Handle = input->Handle;
+            break;
+        }
+    }
+    SDL_AddAtomicInt(&renderer->atomicFrozenResources, (Sint32)count);
+    return true;
+
+allocation_failed:
+    for (Uint32 i = 0; i < completed; ++i) VULKAN_INTERNAL_ReleaseFrozenResource(&outputs[i]);
+    SDL_memset(outputs, 0, count * sizeof(*outputs));
+    return SDL_SetError("Atomic GPU frozen resource allocation failed");
+}
