+static bool SDLCALL VULKAN_AtomicBeginBatch(SDL_GPUDevice *device)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)device->driverData;
+    bool accepted;
+    SDL_LockMutex(renderer->submitLock);
