+static bool SDLCALL VULKAN_AtomicMaintainIdle(SDL_GPUDevice *device)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)device->driverData;
+    bool accepted;
+    bool success;
+    SDL_LockMutex(renderer->submitLock);
+    accepted = !SDL_GetAtomicInt(&renderer->cancellationInitializationFault) &&
+        SDL_GetCurrentThreadID() == renderer->atomicOwner && !renderer->atomicRecordingBatch &&
+        !renderer->atomicMaintenance && SDL_GetAtomicInt(&renderer->atomicOutstandingCommands) == 0 &&
+        SDL_GetAtomicInt(&renderer->atomicFrozenResources) == 0;
+    if (accepted) {
+        SDL_LockMutex(renderer->allocatorLock);
+        if (renderer->allocationsToDefragCount == 0) {
+            SDL_UnlockMutex(renderer->allocatorLock);
+            SDL_UnlockMutex(renderer->submitLock);
+            return true;
+        }
+        SDL_UnlockMutex(renderer->allocatorLock);
+        renderer->atomicMaintenance = true;
+    }
+    SDL_UnlockMutex(renderer->submitLock);
+    if (!accepted) return SDL_SetError("Atomic GPU maintenance requires idle owner recording state");
+    success = VULKAN_Wait(device->driverData);
+    if (success && renderer->allocationsToDefragCount > 0) {
+        SDL_GPUCommandBuffer *command = VULKAN_AcquireCommandBuffer(device->driverData);
+        success = command != NULL;
+        if (command) {
+            success = VULKAN_Submit(command);
+        }
+        if (success) success = VULKAN_Wait(device->driverData);
+    }
+    SDL_LockMutex(renderer->submitLock);
+    renderer->atomicMaintenance = false;
+    SDL_UnlockMutex(renderer->submitLock);
+    return success;
+}
