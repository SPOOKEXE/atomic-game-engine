+// submitLock is held. Failed repairs never enter normal fence polling: some
+// have not reached a queue, while others may still have a pending initialization.
+static void VULKAN_INTERNAL_RetainFailedCancellation(
+    VulkanRenderer *renderer,
+    VulkanCommandBuffer *commandBuffer)
+{
+    SDL_SetAtomicInt(&renderer->cancellationInitializationFault, 1);
+    if (!commandBuffer->failedCancellation) {
+        commandBuffer->failedCancellation = true;
+        commandBuffer->nextFailedCancellation = renderer->failedCancellations;
+        renderer->failedCancellations = commandBuffer;
+#ifdef ATOMIC_GPU_QUEUE_EXTENSION
+        if (commandBuffer->atomicAcquired) {
+            commandBuffer->atomicAcquired = false;
+            SDL_AddAtomicInt(&renderer->atomicOutstandingCommands, -1);
+        }
+#endif
+    }
+}
