@@ -1167,5 +1167,9 @@ void InitKernelSymbols()
-static void InitKernelSymbols()
+void InitKernelSymbols()
 {
+    static bool initialized = false;
+    if( initialized ) return;
+    initialized = true;
+
     FILE* f = fopen( "/proc/kallsyms", "rb" );
     if( !f )
     {
@@ -1358,6 +1362,3 @@ void InitCallstack()
-#ifdef __linux
-    InitKernelSymbols();
-#endif
 #ifdef TRACY_DEBUGINFOD
