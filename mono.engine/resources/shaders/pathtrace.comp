#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D albedo;
layout(set = 0, binding = 1) uniform sampler2D normal;
layout(set = 0, binding = 2) uniform sampler2D material;
layout(set = 0, binding = 3) uniform sampler2D depth;
layout(set = 0, binding = 4) uniform sampler2D indirect;
layout(set = 0, binding = 5) uniform sampler2D history;
layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D radiance;
layout(set = 2, binding = 0, std140) uniform Pass {
	mat4 vp;
	mat4 ivp;
	vec4 target;
	vec4 view;
	uvec4 features;
} pass;
layout(set = 2, binding = 1, std140) uniform Trace { vec4 trace; } options;

float Noise(vec2 samplePoint) {
	return fract(sin(dot(samplePoint, vec2(12.9898, 78.233))) * 43758.5453);
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(pixel, ivec2(pass.target.xy)))) return;
	vec2 uv = (vec2(pixel) + 0.5) * pass.target.zw;
	vec3 surfaceNormal = texture(normal, uv).xyz * 2.0 - 1.0;
	float roughness = texture(material, uv).r;
	float distanceFade = 1.0 / (1.0 + texture(depth, uv).r);
	vec3 direct = texture(albedo, uv).rgb * max(surfaceNormal.y, 0.0);
	vec3 bounce = texture(indirect, uv).rgb * distanceFade;
	int maxBounces = clamp(int(options.trace.x), 1, 64);
	for (int bounceIndex = 1; bounceIndex < maxBounces; ++bounceIndex) {
		bounce *= 0.5 * (1.0 - roughness);
	}
	int samples = clamp(int(options.trace.w), 1, 4096);
	vec3 estimate = vec3(0.0);
	for (int sampleIndex = 0; sampleIndex < samples; ++sampleIndex) {
		vec2 sampleOffset = vec2(float(sampleIndex), float(sampleIndex) * 0.61803399);
		float randomSample = Noise(uv * pass.target.xy + pass.view.xx + sampleOffset);
		estimate += direct + bounce * mix(0.5, 1.0, randomSample) * (1.0 - roughness);
	}
	estimate /= float(samples);
	vec4 previous = texture(history, uv);
	float historySamples = clamp(previous.a, 0.0, 63.0);
	vec3 accumulated = mix(estimate, previous.rgb, historySamples / (historySamples + float(samples)));
	imageStore(radiance, pixel, vec4(accumulated, min(historySamples + float(samples), 63.0)));
}
