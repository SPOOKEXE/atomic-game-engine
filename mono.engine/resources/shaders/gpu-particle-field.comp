#version 450

// Generic device-local particles consume authored initial conditions and the
// same bounded vector-field sampling contract as ordinary particle emitters.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Samples { vec4 rows[]; } samples;
layout(set = 1, binding = 0, std430) buffer States { vec4 rows[]; } states;
layout(set = 2, binding = 0) uniform Field {
	vec4 centreDelta;
	vec4 rotation;
	vec4 bounds;
	uvec4 control;
	uvec4 sampleOptions;
	vec4 accelerations[3];
	vec4 fieldCentre;
	vec4 fieldRotation;
	vec4 fieldVector;
	vec4 fieldHalf;
	vec4 fieldAxis;
} field;

uint Mix(uint value) { value ^= value >> 16u; value *= 0x7feb352du; value ^= value >> 15u; value *= 0x846ca68bu; value ^= value >> 16u; return value; }
vec3 TurnedBy(vec4 turn, vec3 value) { return value + 2.0 * cross(turn.xyz, cross(turn.xyz, value) + turn.w * value); }
vec3 FieldUnit(vec3 value) { float squared = dot(value, value); return squared > 0.0 ? value * inversesqrt(squared) : vec3(0.0); }
float FieldAxisWeight(float coordinate, float extent, float falloff) {
	if (!(extent > 0.0)) return 1.0;
	float distance = extent - abs(coordinate);
	if (!(distance >= 0.0)) return 0.0;
	return falloff > 0.0 ? clamp(distance / falloff, 0.0, 1.0) : 1.0;
}
vec3 FieldVelocity(vec3 worldPosition) {
	uint flags = uint(field.fieldVector.w);
	if ((flags & 1u) == 0u) return vec3(0.0);
	bool localSpace = (flags & 2u) != 0u, twoDimensional = (flags & 4u) != 0u;
	vec3 offset = worldPosition - field.fieldCentre.xyz;
	vec3 point = localSpace ? TurnedBy(vec4(-field.fieldRotation.xyz, field.fieldRotation.w), offset) : offset;
	float weight = min(FieldAxisWeight(point.x, field.fieldHalf.x, field.fieldCentre.w), FieldAxisWeight(point.z, field.fieldHalf.z, field.fieldCentre.w));
	if (!twoDimensional) weight = min(weight, FieldAxisWeight(point.y, field.fieldHalf.y, field.fieldCentre.w));
	if (!(weight > 0.0)) return vec3(0.0);
	vec3 direction = point; if (twoDimensional) direction.y = 0.0;
	vec3 radial = FieldUnit(direction), axis = twoDimensional ? vec3(0.0, 1.0, 0.0) : FieldUnit(field.fieldAxis.xyz);
	vec3 velocity = field.fieldVector.xyz + radial * field.fieldHalf.w + FieldUnit(cross(axis, radial)) * field.fieldAxis.w;
	return (localSpace ? TurnedBy(field.fieldRotation, velocity) : velocity) * weight;
}

void main() {
	uint index = gl_GlobalInvocationID.x;
	if (index >= field.control.x || field.sampleOptions.x == 0u) return;
	uint sampleIndex = Mix(index + field.control.y) % field.sampleOptions.x;
	vec4 positionLifetime = samples.rows[sampleIndex * 2u];
	vec4 velocityLayer = samples.rows[sampleIndex * 2u + 1u];
	uint layer = floatBitsToUint(velocityLayer.w);
	if (layer >= 3u) return;
	bool reset = field.control.z != 0u;
	vec4 position = vec4(0.0), velocity = vec4(0.0);
	if (!reset) { position = states.rows[index * 2u]; velocity = states.rows[index * 2u + 1u]; }
	if (!reset) {
		float delta = field.centreDelta.w;
		if ((uint(field.fieldVector.w) & 1u) != 0u)
			velocity.xyz += (FieldVelocity(position.xyz) - velocity.xyz) * min(delta * field.bounds.w, 1.0);
		velocity.xyz += field.accelerations[layer].xyz * delta;
		position.xyz += velocity.xyz * delta;
		velocity.w += delta;
		vec3 local = TurnedBy(vec4(-field.rotation.xyz, field.rotation.w), position.xyz - field.centreDelta.xyz);
		reset = velocity.w >= positionLifetime.w || any(greaterThan(abs(local), field.bounds.xyz)) || any(isnan(position)) || any(isinf(position)) || any(isnan(velocity)) || any(isinf(velocity));
	}
	if (reset) {
		position = vec4(field.centreDelta.xyz + TurnedBy(field.rotation, positionLifetime.xyz), float(layer));
		float age = field.control.z != 0u ? float(Mix(index ^ field.control.y) >> 8u) * (1.0 / 16777216.0) * positionLifetime.w : 0.0;
		velocity = vec4(TurnedBy(field.rotation, velocityLayer.xyz), age);
	}
	states.rows[index * 2u] = position; states.rows[index * 2u + 1u] = velocity;
}
