#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D scene;
layout(set = 0, binding = 1) uniform sampler2D depth;
layout(set = 0, binding = 2) uniform sampler2D normal;
layout(set = 0, binding = 3) uniform sampler2D material;
layout(set = 0, binding = 4) uniform sampler2D indirect;
layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D reflection;
layout(set = 2, binding = 0, std140) uniform Pass {
	mat4 vp;
	mat4 ivp;
	vec4 target;
	vec4 view;
	uvec4 features;
} pass;

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(pixel, ivec2(pass.target.xy)))) return;
	vec2 uv = (vec2(pixel) + 0.5) * pass.target.zw;
	vec3 surfaceNormal = texture(normal, uv).xyz * 2.0 - 1.0;
	float rayLength = 0.01 + min(texture(depth, uv).r * 0.002, 0.06);
	vec2 hit = clamp(uv + surfaceNormal.xz * rayLength, 0.0, 1.0);
	float reflectivity = 1.0 - texture(material, uv).r;
	vec3 traced = texture(scene, hit).rgb;
	vec3 fallback = texture(indirect, uv).rgb;
	imageStore(reflection, pixel, vec4(mix(fallback, traced, reflectivity), 1.0));
}
