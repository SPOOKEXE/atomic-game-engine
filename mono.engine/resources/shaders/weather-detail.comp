#version 450
#extension GL_GOOGLE_include_directive : require

// Clipmap level 0: the cloud density near the camera at a quarter of a
// canonical cell, read by the march in place of the coarse bake. Each voxel
// samples the coarse bake (hardware trilinear), applies the preset's profile
// and erosion, then `ProfileDetail`, so the march reads finished density in
// one filtered fetch. Outside the coarse box a voxel holds -1, which the march
// treats as "use the coarse path".

#include "weather-common.glsl"
#include "weather-profile.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler3D coarseDensity;
layout(set = 1, binding = 0, r16f) writeonly uniform image3D detailImage;
layout(set = 2, binding = 0) uniform Detail {
	// The coarse bake: canonical cell origin and cell size, voxel counts.
	vec4 BakeOrigin;
	vec4 BakeVoxels;
	// This level: origin in its own voxels and the voxel size, voxel counts.
	vec4 DetailOrigin;
	vec4 DetailVoxels;
	// Layer base and top in metres, the profile, unused.
	vec4 Layer;
} detail;

// One thread per (x, z) column, writing every voxel of it.
void main() {
	ivec3 voxels = ivec3(detail.DetailVoxels.xyz);
	ivec2 column = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(column, voxels.xz))) return;
	uint profile = uint(detail.Layer.z);
	float cellSize = detail.BakeOrigin.w;
	vec3 coarseSize = vec3(textureSize(coarseDensity, 0));
	for (int y = 0; y < voxels.y; ++y) {
		ivec3 voxel = ivec3(column.x, y, column.y);
		vec3 world = (detail.DetailOrigin.xyz + vec3(voxel) + 0.5) * detail.DetailOrigin.w;
		vec3 coarse = world / cellSize - detail.BakeOrigin.xyz;
		float density = -1.0;
		if (all(greaterThanEqual(coarse, vec3(0.0))) && all(lessThanEqual(coarse, detail.BakeVoxels.xyz - 1.0))) {
			float raw = max(WeatherSmoothDensity(coarseDensity, coarse + 0.5, coarseSize), 0.0);
			float height = ProfileHeight(world, detail.Layer.x, detail.Layer.y);
			density = ProfileErode(profile, ProfileDensity(profile, raw, height), world, height, cellSize);
			density = ProfileDetail(profile, density, world, cellSize);
		}
		imageStore(detailImage, voxel, vec4(density));
	}
}
