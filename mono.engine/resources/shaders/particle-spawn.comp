#version 450

// Scatters this tick's newborn particles into the device's state pool.
//
// **The host still decides every birth**, and that is not laziness. Working out
// where a particle starts reads the emitter's shape, its half-extent, its
// parent's motion and a random draw seeded from the emitter's entity - a
// fifteen-hundred-byte component and two walks up the entity tree. None of that
// is going to the device, and none of it needs to: a steady scene of five
// thousand emitters births about seventeen hundred particles a tick, which is
// three orders of magnitude less than it *ages*.
//
// So the split is by how much there is of each. Ageing, shading and drawing
// half a million particles happens in `particle-step.comp`, and the hundred
// kilobytes of births that feed it cross the bus and land here.
//
// **A scatter and not a copy**, because a birth goes to whichever slot its
// block's ring is pointing at and those are as scattered as the emitters are.
// One invocation per birth, writing one state each; there is no ordering
// between them because no two births in a tick share a slot.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// ParticleState is fifteen words. A birth is the slot it goes to and then
// those, so sixteen - see `render::ParticleBirth`, which is packed to match.
const uint STATE_WORDS = 15u;
const uint BIRTH_WORDS = 16u;

layout(set = 0, binding = 0) readonly buffer Births { uint words[]; } births;

layout(set = 1, binding = 0) buffer States { uint words[]; } states;

layout(set = 2, binding = 0) uniform Spawn {
	// x: how many births there are. y: how many slots the pool holds.
	uvec4 Count;
} spawn_;

void main() {
	uint at = gl_GlobalInvocationID.x;
	if (at >= spawn_.Count.x) {
		return;
	}

	uint base = at * BIRTH_WORDS;
	uint row = births.words[base];
	if (row >= spawn_.Count.y) {
		// The host sized the pool and the host chose the row, so this cannot
		// happen - but a compute shader that walks off a storage buffer corrupts
		// whatever is next in memory rather than faulting, and the guard is one
		// compare against a value already in a register.
		return;
	}

	uint destination = row * STATE_WORDS;
	for (uint word = 0u; word < STATE_WORDS; word++) {
		states.words[destination + word] = births.words[base + 1u + word];
	}
}
