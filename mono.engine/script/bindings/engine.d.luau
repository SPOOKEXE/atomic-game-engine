-- --- what a name resolves to --------------------------------------------

type Services = {
	Workspace: Workspace,
	RunService: RunService,
	MessagingService: MessagingService,
	MemoryStoreService: MemoryStoreService,
	DataStoreService: DataStoreService,
}

type CreatableInstances = {
	Instance: Instance,
	PVInstance: PVInstance,
	BasePart: BasePart,
	Part: Part,
	Camera: Camera,
	SurfaceCamera: SurfaceCamera,
	LuaSourceContainer: LuaSourceContainer,
	Script: Script,
	LocalScript: LocalScript,
}

type DataModel = {
	Workspace: Workspace,
	GetService: <T>(self: DataModel, service: keyof<Services> & T) -> index<Services, T>,
}

declare game: DataModel

declare Instance: {
	new: <T>(className: keyof<CreatableInstances> & T, parent: Instance?) -> index<CreatableInstances, T>,
}
