--!strict
-- Generated by mono.tools/bindings. Do not edit by hand.
--
-- What a Luau script can name, typed. The class tree and the enums come out
-- of the class table; the globals come out of what the VM installs. Both
-- halves are written by one program alongside the TypeScript declarations, so
-- the two surfaces cannot drift into two APIs by accident — where they do
-- differ, they differ because the two VMs do, and the difference is written
-- down rather than smoothed over.
--
-- This is a definition file rather than a module: point a language server at
-- it, do not `require` it. For luau-lsp that is
-- `luau-lsp.types.definitionFiles`, which `.vscode/settings.json` sets --
-- and that file is gitignored because editor configuration is personal, so
-- the path is written here too. `.luaurc` beside it is checked in and is
-- what makes a new script strict by default.

-- --- the value types -------------------------------------------------------

declare extern type Vector3 with
	X: number
	Y: number
	Z: number
	Magnitude: number
	Unit: Vector3
	function __add(self, other: Vector3): Vector3
	function __sub(self, other: Vector3): Vector3
	function __mul(self, other: Vector3 | number): Vector3
	function __unm(self): Vector3
end

declare Vector3: {
	new: (x: number?, y: number?, z: number?) -> Vector3,

	-- **Lowercase, because Roblox's are.** Every other member of this vocabulary
	-- is capitalised and these two are not, which reads as a mistake until you
	-- try to run a script written elsewhere.
	zero: Vector3,
	one: Vector3,
}

declare extern type Color3 with
	R: number
	G: number
	B: number
end

declare Color3: {
	new: (r: number?, g: number?, b: number?) -> Color3,
	-- 0-255, the way an author reads a colour off a palette.
	fromRGB: (r: number?, g: number?, b: number?) -> Color3,
}

-- `CFrame * Vector3` takes a point into the frame's space and is the other half
-- of one run-time metamethod. It is not declared: `__mul` is one member here, so
-- the two argument types would have to share a return type, and a `CFrame |
-- Vector3` that every call site had to narrow is worse than the composition
-- overload alone.
declare extern type CFrame with
	Position: Vector3
	function __mul(self, other: CFrame): CFrame
end

declare CFrame: {
	new: ((x: number?, y: number?, z: number?) -> CFrame) & ((position: Vector3) -> CFrame),
	-- Radians, because Roblox's is radians — while `Orientation` is degrees.
	Angles: (pitch: number, yaw: number, roll: number) -> CFrame,
	lookAt: (from: Vector3, to: Vector3, up: Vector3?) -> CFrame,
}

