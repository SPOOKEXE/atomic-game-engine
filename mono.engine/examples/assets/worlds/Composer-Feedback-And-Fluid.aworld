<?xml version="1.0" encoding="utf-8"?>
<World format="3" name="Composer-Feedback-And-Fluid">
 <Sources>
  <Source path="scripts/server/Composer-Feedback-And-Fluid.server.luau"><![CDATA[local function panel(name, x)
 local p = Instance.new("MeshPart")
 p.Name = name
 p.Anchored = true
 p.Size = Vector3.new(4, 4, 0.2)
 p.Position = Vector3.new(x, 3, 0)
 p.Parent = workspace
 return p
end
local function bind(sink, graph, output, texture, linear)
 sink.ImageGraph = graph
 sink.ImageGraphOutput = output
 sink.ImageGraphTexture = texture
 sink.ImageGraphSeed = 7291
 sink.ImageGraphTickPolicy = "world"
 sink.ImageGraphColorSpace = if linear then "linear" else "display"
end
local floor = Instance.new("Part")
floor.Name = "Floor"
floor.Anchored = true
floor.Size = Vector3.new(30, 1, 20)
floor.Position = Vector3.new(0, -0.5, 0)
floor.Color = Color3.new(0.025, 0.025, 0.025)
floor.Parent = workspace
local reference = panel("ResetReference", -5)
reference.TextureID = "composer-feedback-reset"
bind(reference, "Composer-Feedback-And-Fluid", "accumulated", "composer-feedback-reset", false)
reference.ImageGraphTickPolicy = "fixed"
reference.ImageGraphFixedTick = 0
local stepped = panel("SteppedFeedback", 0)
stepped.TextureID = "composer-feedback-step"
bind(stepped, "Composer-Feedback-And-Fluid", "accumulated", "composer-feedback-step", false)
stepped.ImageGraphTickPolicy = "fixed"
stepped.ImageGraphFixedTick = 0
local fluid = panel("SourceFlipParticleReference", 5)
fluid.TextureID = "composer-fluid-particles"
bind(fluid, "Composer-Fluid-Particles", "fluid", "composer-fluid-particles", false)
fluid.ImageGraphSeed = 12345
fluid.ImageGraphTickPolicy = "fixed"
fluid.ImageGraphFixedTick = 0
local RunService = game:GetService("RunService")
RunService.Heartbeat:Connect(function()
 stepped.ImageGraphFixedTick = math.floor(elapsedTime() * 8) % 80
 fluid.ImageGraphFixedTick = math.floor(elapsedTime() * 8) % 32
end)
local screen = Instance.new("ScreenGui")
screen.Name = "FeedbackScope"
screen.Parent = game:GetService("StarterGui")
local label = Instance.new("TextLabel")
label.Name = "Scope"
label.Size = UDim2.new(1, 0, 0, 50)
label.Text = "Feedback reset left, stepped seek center, native FLIP particle CPU reference right. Source GPU coverage unverified; rigid scene incomplete."
label.TextColor3 = Color3.new(1, 1, 1)
label.BackgroundColor3 = Color3.new(0, 0, 0)
label.Parent = screen
]]></Source>
  <Source path="scripts/client/Composer-Feedback-And-Fluid.client.luau"><![CDATA[local camera = Instance.new("Camera")
camera.Name = "ComposerCamera"
camera.CFrame = CFrame.lookAt(Vector3.new(0, 5, 18), Vector3.new(0, 3, 0))
camera.FieldOfView = 55
camera.Parent = workspace
workspace.CurrentCamera = camera
]]></Source>
 </Sources>
 <Item class="Workspace" name="Workspace" id="1" />
 <Item class="ServerScriptService" name="ServerScriptService" id="2">
  <Item class="Script" name="ComposerScene" id="3"><Property name="Source" type="string">scripts/server/Composer-Feedback-And-Fluid.server.luau</Property></Item>
 </Item>
