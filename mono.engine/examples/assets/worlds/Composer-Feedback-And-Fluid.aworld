  <Item class="StarterPlayerScripts" name="StarterPlayerScripts" id="5">
   <Item class="LocalScript" name="ComposerCamera" id="6"><Property name="Source" type="string">scripts/client/Composer-Feedback-And-Fluid.client.luau</Property></Item>
