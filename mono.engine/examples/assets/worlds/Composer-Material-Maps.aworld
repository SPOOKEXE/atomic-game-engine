<?xml version="1.0" encoding="utf-8"?>
<World format="3" name="Composer-Material-Maps">
 <Sources>
  <Source path="scripts/server/Composer-Material-Maps.server.luau"><![CDATA[local function panel(name, x)
 local p = Instance.new("MeshPart")
 p.Name = name
 p.Anchored = true
 p.Size = Vector3.new(4, 4, 0.2)
 p.Position = Vector3.new(x, 3, 0)
 p.Parent = workspace
 return p
end
local function bind(sink, graph, output, texture, linear)
 sink.ImageGraph = graph
 sink.ImageGraphOutput = output
 sink.ImageGraphTexture = texture
 sink.ImageGraphSeed = 7291
 sink.ImageGraphTickPolicy = "world"
 sink.ImageGraphColorSpace = if linear then "linear" else "display"
end
local floor = Instance.new("Part")
floor.Name = "Floor"
floor.Anchored = true
floor.Size = Vector3.new(30, 1, 20)
floor.Position = Vector3.new(0, -0.5, 0)
floor.Color = Color3.new(0.025, 0.025, 0.025)
floor.Parent = workspace
local p = panel("MappedStone", 0)
p.TextureID = "composer-colour"
p.NormalMap = "composer-normal"
p.PackedPbrMap = "composer-pbr"
p.PackedRoughnessChannel = 0
p.PackedOcclusionChannel = 1
p.PackedMetalnessChannel = 2
bind(p, "Composer-Material-Maps", "colour", "composer-colour", false)
for _, spec in {{"normal", "composer-normal"}, {"pbr", "composer-pbr"}} do
 local owner = Instance.new("Folder")
 owner.Name = spec[1] .. "Output"
 bind(owner, "Composer-Material-Maps", spec[1], spec[2], true)
 owner.Parent = workspace
end
]]></Source>
  <Source path="scripts/client/Composer-Material-Maps.client.luau"><![CDATA[local camera = Instance.new("Camera")
camera.Name = "ComposerCamera"
camera.CFrame = CFrame.lookAt(Vector3.new(0, 5, 18), Vector3.new(0, 3, 0))
camera.FieldOfView = 55
camera.Parent = workspace
workspace.CurrentCamera = camera
]]></Source>
 </Sources>
 <Item class="Workspace" name="Workspace" id="1" />
 <Item class="ServerScriptService" name="ServerScriptService" id="2">
  <Item class="Script" name="ComposerScene" id="3"><Property name="Source" type="string">scripts/server/Composer-Material-Maps.server.luau</Property></Item>
 </Item>
 <Item class="StarterPlayer" name="StarterPlayer" id="4">
  <Item class="StarterPlayerScripts" name="StarterPlayerScripts" id="5">
   <Item class="LocalScript" name="ComposerCamera" id="6"><Property name="Source" type="string">scripts/client/Composer-Material-Maps.client.luau</Property></Item>
  </Item>
 </Item>
</World>
