<?xml version="1.0" encoding="utf-8"?>
<World format="3" name="Composer-Reference-Studies">
 <Sources>
  <Source path="scripts/server/Composer-Reference-Studies.server.luau"><![CDATA[local function panel(name, x, y)
 local p = Instance.new("MeshPart")
 p.Name = name
 p.Anchored = true
 p.Size = Vector3.new(4, 4, 0.2)
 p.Position = Vector3.new(x, y, 0)
 p.Parent = workspace
 return p
end
local function bind(sink, graph, output, texture, linear)
 sink.ImageGraph = graph
 sink.ImageGraphOutput = output
 sink.ImageGraphTexture = texture
 sink.ImageGraphSeed = 7291
 sink.ImageGraphTickPolicy = "world"
 sink.ImageGraphColorSpace = if linear then "linear" else "display"
end
local floor = Instance.new("Part")
floor.Name = "Floor"
floor.Anchored = true
floor.Size = Vector3.new(30, 1, 20)
floor.Position = Vector3.new(0, -0.5, 0)
floor.Color = Color3.new(0.025, 0.025, 0.025)
floor.Parent = workspace
local studies = {
 "Black-Hole", "Fire-Tornado", "Glass-Block-Refraction", "Ornate-Trim", "Spark-Bolt",
}
for index, study in studies do
 local p = panel(study .. "NativeUpstreamStudy", (index - 3) * 5, 3)
 local texture = "composer-study-" .. string.lower(study)
 p.TextureID = texture
 bind(p, "Composer-Study-" .. study, "study", texture, false)
end
local sourceOutputs = {
 {"Black-Hole", "gSKBQW2707447cZLPHO4qsosZuR6bD0L"},
 {"Fire-Tornado", "gSKBO82563685pOhaulkBGjkN0ZahGhW"},
 {"Glass-Block-Refraction", "gSKAiP180467pJ0YpXbwrplRMgj671sM"},
 {"Ornate-Trim", "gSKBQu2731320Bc3gLD9ntjq2djDzQT3"},
 {"Spark-Bolt", "gSKA1Q1237222AW3R5nxuMfz0TUM1wYS"},
}
for index, source in sourceOutputs do
 local name, output = source[1], source[2]
 local p = panel(name .. "OriginalOutput", (index - 3) * 5, 8)
 local texture = "composer-original-" .. string.lower(name)
 p.TextureID = texture
 bind(p, "Composer-Source-" .. name, output, texture, false)
end
local screen = Instance.new("ScreenGui")
screen.Name = "StudyScope"
screen.Parent = game:GetService("StarterGui")
local label = Instance.new("TextLabel")
label.Name = "Scope"
label.Size = UDim2.new(1, 0, 0, 50)
label.Text = "Original output requests above; supplemental native studies below. Native diagnostics identify unsupported nodes. Executable parity unverified."
label.TextColor3 = Color3.new(1, 1, 1)
label.BackgroundColor3 = Color3.new(0, 0, 0)
label.Parent = screen
]]></Source>
  <Source path="scripts/client/Composer-Reference-Studies.client.luau"><![CDATA[local camera = Instance.new("Camera")
camera.Name = "ComposerCamera"
camera.CFrame = CFrame.lookAt(Vector3.new(0, 7, 29), Vector3.new(0, 5.5, 0))
camera.FieldOfView = 55
camera.Parent = workspace
workspace.CurrentCamera = camera
]]></Source>
 </Sources>
 <Item class="Workspace" name="Workspace" id="1" />
 <Item class="ServerScriptService" name="ServerScriptService" id="2">
  <Item class="Script" name="ComposerScene" id="3"><Property name="Source" type="string">scripts/server/Composer-Reference-Studies.server.luau</Property></Item>
 </Item>
 <Item class="StarterPlayer" name="StarterPlayer" id="4">
  <Item class="StarterPlayerScripts" name="StarterPlayerScripts" id="5">
   <Item class="LocalScript" name="ComposerCamera" id="6"><Property name="Source" type="string">scripts/client/Composer-Reference-Studies.client.luau</Property></Item>
  </Item>
 </Item>
</World>
