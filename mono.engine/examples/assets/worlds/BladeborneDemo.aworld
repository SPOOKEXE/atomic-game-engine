		<Source path="scripts/server/BladeborneArena.server.luau"><![CDATA[--!strict
-- Server-owned setup reads the replicated fixture and adds one live arena marker.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Data = require(ReplicatedStorage.BladeborneDemo.DemoData)
local arena = Workspace:FindFirstChild("BladeborneArena")
assert(arena ~= nil, "BladeborneArena is missing")

if arena:FindFirstChild("ServerProfileMarker") then
	return
end

local marker = Instance.new("Part")
marker.Name = "ServerProfileMarker"
marker.Anchored = true
marker.Size = Vector3.new(4 + Data.profile.level, 0.5, 4 + Data.profile.level)
marker.Position = Vector3.new(0, 0.75, -8)
marker.Color = Data.effects[1].colour
marker:SetAttribute("BladeborneProfile", Data.profile.name)
marker:SetAttribute("BladeborneLevel", Data.profile.level)
marker.Parent = arena
]]></Source>
	</Sources>
