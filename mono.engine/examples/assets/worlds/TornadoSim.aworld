local function clamp(value: number, minimum: number, maximum: number): number
	return math.max(minimum, math.min(maximum, value))
end

local function formatValue(value: number): string
	if value % 1 == 0 then return string.format("%.0f", value) end
	return string.format("%.2f", value)
end

local parameterBoxes: { [string]: TextBox } = {}
local editingBox: TextBox? = nil
local panelClock = 0
local lastParameterEdit = -1000
local nextParameterSync = 0
local function commitParameter(parameter: any, box: TextBox)
	local requested = tonumber(box.Text)
	if requested == nil then
		box.Text = formatValue(Controls.default[parameter.Key])
		return
	end
	requested = clamp(requested, parameter.Min, parameter.Max)
	box.Text = formatValue(requested)
	lastParameterEdit = panelClock
	request({ kind = "parameters", values = { [parameter.Key] = requested } })
end

for index, parameter in ipairs(Controls.parameters) do
	local column = (index - 1) % 2
	local row = math.floor((index - 1) / 2)
	local x = 7 + column * 172
	local y = 227 + row * 27
	local label = Instance.new("TextLabel")
	label.Name = parameter.Key .. "Label"
