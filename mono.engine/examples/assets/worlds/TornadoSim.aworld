	label.Position = UDim2.new(0, x, 0, y)
	label.Text = parameter.Label
	label.TextSize = 10
	label.TextColor3 = Color3.fromRGB(178, 196, 204)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.BackgroundTransparency = 1
	label.Parent = panel

	local box = Instance.new("TextBox")
	box.Name = parameter.Key .. "Slider"
	box.Size = UDim2.new(0, 48, 0, 22)
	box.Position = UDim2.new(0, x + 76, 0, y)
	box.Text = formatValue(Controls.default[parameter.Key])
	box.TextSize = 11
	box.TextColor3 = Color3.fromRGB(227, 234, 239)
	box.BackgroundColor3 = Color3.fromRGB(12, 22, 29)
	box.BorderSizePixel = 0
	box.Parent = panel
	parameterBoxes[parameter.Key] = box
	box.Focused:Connect(function() editingBox = box end)
	box.FocusLost:Connect(function()
		editingBox = nil
		commitParameter(parameter, box)
	end)
	button("−", x + 127, y, function()
		local value = tonumber(box.Text) or Controls.default[parameter.Key]
		box.Text = formatValue(clamp(value - parameter.Step, parameter.Min, parameter.Max))
		commitParameter(parameter, box)
	end, 18)
	button("+", x + 147, y, function()
		local value = tonumber(box.Text) or Controls.default[parameter.Key]
		box.Text = formatValue(clamp(value + parameter.Step, parameter.Min, parameter.Max))
		commitParameter(parameter, box)
	end, 18)
end

