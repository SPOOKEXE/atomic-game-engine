	table.insert(vectorLabels, vector)
end

local readout = Instance.new("TextLabel")
readout.Name = "FieldReadout"
readout.Size = UDim2.new(1, -14, 0, 155)
readout.Position = UDim2.new(0, 7, 0, 567)
readout.TextColor3 = Color3.fromRGB(192, 211, 221)
readout.TextSize = 12
readout.TextWrapped = true
readout.TextXAlignment = Enum.TextXAlignment.Left
readout.TextYAlignment = Enum.TextYAlignment.Top
readout.BackgroundTransparency = 1
readout.Parent = panel

local stormMotion = Controls.default.TranslationVelocity
local counterClockwise = false
local environmentEnabled = true
local environmentControl: TextButton
local lightningControl: TextButton
local function setEnvironmentVisible(visible: boolean)
	environmentEnabled = visible
	for _, object in ipairs(Workspace:GetDescendants()) do
		if clientVisuals[object] ~= true then continue end
		if not object:IsA("Part") and not object:IsA("Volume") then continue end
		local name = object.Name
		local environmentObject = string.find(name, "Storm Prairie") or string.find(name, "Storm Chase Road")
			or string.find(name, "Road Mark") or string.find(name, "Prairie Grid") or string.find(name, "Farmhouse")
			or string.find(name, "Barn") or string.find(name, "Workshop") or string.find(name, "Hay Bale")
			or string.find(name, "Tree ") or string.find(name, "Fence ") or string.find(name, "Storm Cell")
			or string.find(name, "Cell ") or string.find(name, "Tornado Chase") or string.find(name, "StormInteraction")
			or string.find(name, "WoodenSign") or string.find(name, "SteelPanel") or string.find(name, "WindBentTree")
		if environmentObject then
			if object:IsA("Part") then object.Visible = visible else (object :: Volume).Enabled = visible end
		end
	end
	request({ kind = "environment", value = visible })
end
local function setStormMotion(change: Vector3)
	stormMotion = Vector3.new(
		math.clamp(change.X, -60, 60), math.clamp(change.Y, -60, 60), math.clamp(change.Z, -60, 60)
	)
	request({ kind = "motion", x = stormMotion.X, y = stormMotion.Y, z = stormMotion.Z })
end

button("CCW", 7, 732, function()
	counterClockwise = not counterClockwise
	request({ kind = "rotation", counterClockwise = counterClockwise })
end, 52)
button("WIND X-", 7, 758, function() setStormMotion(stormMotion - Vector3.new(5, 0, 0)) end, 52)
button("WIND X+", 61, 758, function() setStormMotion(stormMotion + Vector3.new(5, 0, 0)) end, 52)
button("WIND Y-", 115, 758, function() setStormMotion(stormMotion - Vector3.new(0, 5, 0)) end, 52)
button("WIND Y+", 169, 758, function() setStormMotion(stormMotion + Vector3.new(0, 5, 0)) end, 52)
button("WIND Z-", 223, 758, function() setStormMotion(stormMotion - Vector3.new(0, 0, 5)) end, 52)
button("WIND Z+", 277, 758, function() setStormMotion(stormMotion + Vector3.new(0, 0, 5)) end, 52)
button("RAIN OP-", 7, 784, function() rainOpacity = math.max(0, rainOpacity - 0.1); updateLayers() end, 78)
button("RAIN OP+", 87, 784, function() rainOpacity = math.min(1, rainOpacity + 0.1); updateLayers() end, 78)
button("RAIN DEN-", 167, 784, function() rainDensity = math.max(0, rainDensity - 0.1); updateLayers() end, 86)
button("RAIN DEN+", 255, 784, function() rainDensity = math.min(1, rainDensity + 0.1); updateLayers() end, 86)
environmentControl = button("ENV", 7, 810, function()
	setEnvironmentVisible(not environmentEnabled)
	environmentControl.BackgroundColor3 = if environmentEnabled then Color3.fromRGB(27, 57, 66) else Color3.fromRGB(12, 22, 29)
end, 52)
lightningControl = button("LIGHT", 61, 810, function()
	lightningEnabled = not lightningEnabled
	setLightningVisible(false, 0)
	lightningControl.BackgroundColor3 = if lightningEnabled then Color3.fromRGB(27, 57, 66) else Color3.fromRGB(12, 22, 29)
end, 52)
button("YAW -", 7, 836, function() cameraYaw -= math.rad(8) end, 52)
button("YAW +", 61, 836, function() cameraYaw += math.rad(8) end, 52)
button("PITCH -", 115, 836, function() cameraPitch = math.max(math.rad(-75), cameraPitch - math.rad(5)) end, 70)
button("PITCH +", 187, 836, function() cameraPitch = math.min(math.rad(75), cameraPitch + math.rad(5)) end, 70)
button("ZOOM -", 259, 836, function() cameraZoom = math.max(0.55, cameraZoom - 0.1) end, 78)
button("ZOOM +", 259, 862, function() cameraZoom = math.min(1.7, cameraZoom + 0.1) end, 78)

local vectorPoints = {
	Vector3.new(-70, 15, 95), Vector3.new(-28, 15, 95), Vector3.new(0, 15, 95),
	Vector3.new(28, 15, 95), Vector3.new(70, 15, 95),
}
local arrows = { "→", "↗", "↑", "↖", "←", "↙", "↓", "↘" }
local elapsed = 0
local stormOffset = Vector3.zero
RunService.Heartbeat:Connect(function(delta: number)
	elapsed += delta
	panelClock += delta
	bindStormDamageScenery()
	for index = #damageScenery, 1, -1 do
		local scenery = damageScenery[index]
		-- A replicated source can disappear between frames. Keep every access to
		-- that old handle inside pcall, then let the next bind find its replacement.
		local readable, frame = pcall(function(): CFrame?
			if scenery.Source.Parent == nil or scenery.Decoration.Parent == nil then return nil end
			return scenery.Source.CFrame * scenery.LocalFrame
		end)
		if not readable or frame == nil then
			pcall(function() scenery.Decoration:Destroy() end)
			table.remove(damageScenery, index)
		else
			local placed = pcall(function() scenery.Decoration.CFrame = frame end)
			if not placed then table.remove(damageScenery, index) end
		end
	end
	if #damageScenery == 0 then damageSceneryBound = false end
	local stateRow = stormAnchor:GetComponent("Tornado.State")
	local snapshot = if stateRow ~= nil then Field.snapshot(Field.fromComponent(stateRow)) else Field.new(Controls.default, Controls.default.Position)
	for _, visual in ipairs(stormVisuals) do
		if visual.BaseDensity ~= nil then
			local localPosition = visual.Object.Position - snapshot.Position
			visual.Object.Density = visual.BaseDensity * (0.55 + 0.45 * Field.cloudDensity(snapshot.Parameters, localPosition, snapshot.ElapsedSeconds))
		end
	end
	if snapshot.Parameters.TranslationVelocity then
		stormMotion = snapshot.Parameters.TranslationVelocity
	end
	if type(snapshot.Parameters.CounterClockwise) == "boolean" then
		counterClockwise = snapshot.Parameters.CounterClockwise
	end
	if snapshot.ElapsedSeconds > 0 and panelClock >= nextParameterSync then
		nextParameterSync = panelClock + 0.25
		if panelClock - lastParameterEdit >= 0.35 then
			for _, parameter in ipairs(Controls.parameters) do
				local box = parameterBoxes[parameter.Key]
				local value = snapshot.Parameters[parameter.Key]
				if box ~= editingBox and type(value) == "number" then
					local formatted = formatValue(value)
					if box.Text ~= formatted then box.Text = formatted end
				end
			end
		end
	end
	if snapshot.ElapsedSeconds < lastStormElapsed then
		resetLightning()
	end
	lastStormElapsed = snapshot.ElapsedSeconds
	-- Move local presentation from the same replicated state that drives gameplay.
	if snapshot.ElapsedSeconds > 0 then
		local nextOffset = snapshot.Position - stormOrigin
		if nextOffset.X ~= stormOffset.X or nextOffset.Y ~= stormOffset.Y or nextOffset.Z ~= stormOffset.Z then
			stormOffset = nextOffset
			for _, visual in ipairs(stormVisuals) do
				visual.Object.Position = visual.Origin + stormOffset
			end
	if not cameraOrbit and not cameraShake and not observerFollow then
				camera.CFrame = cameraFrame(cameraTarget + stormOffset)
			end
		end
	end
	if UserInputService:GetFocusedTextBox() == nil then
		local move = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += Vector3.new(0, 0, 1) end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then move += Vector3.new(0, 0, -1) end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then move += Vector3.new(-1, 0, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += Vector3.new(1, 0, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.Q) then move += Vector3.new(0, -1, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.E) then move += Vector3.new(0, 1, 0) end
		if move.Magnitude > 0 then
			local direction = move.Unit
			observerHumanoid.MoveDirection = direction
			observerPosition += direction * observerHumanoid.WalkSpeed * delta
			if direction.X ~= 0 or direction.Z ~= 0 then
				observerHeading = Vector3.new(direction.X, 0, direction.Z).Unit
			end
		else
			observerHumanoid.MoveDirection = Vector3.zero
		end
	end
	updateObserverVisual()
	updateStormAudio(snapshot, observerPosition)
	observerPublishElapsed += delta
	if observerPublishElapsed >= 0.5 then
		observerPublishElapsed = 0
		request({ kind = "observer", x = observerPosition.X, z = observerPosition.Z })
	end
	if cameraOrbit then
		local orbit = elapsed * 0.16
		local position = Vector3.new(math.cos(orbit) * 205, 72, 95 + math.sin(orbit) * 205) + stormOffset
		camera.CFrame = CFrame.lookAt(position, cameraTarget + stormOffset)
	elseif observerFollow then
		local eye = observerPosition - observerHeading * 15 + Vector3.new(0, 7, 0)
		camera.CFrame = CFrame.lookAt(eye, observerPosition + Vector3.new(0, 1.3, 0))
	elseif cameraShake then
		camera.CFrame = cameraFrame(cameraTarget + stormOffset)
	end
	if cameraShake then
		-- Sample at the observer's eye so the optional camera response grows with
		-- the same field and damage potential the reference program uses.
		local observerField = Field.sample(snapshot.Parameters, snapshot.Position, observerPosition + Vector3.new(0, 1, 0), snapshot.ElapsedSeconds)
		local horizontalWind = Vector3.new(observerField.Velocity.X, 0, observerField.Velocity.Z).Magnitude
		local shake = clamp(horizontalWind / 115 + observerField.DamagePotential * 0.45, 0, 1)
		local phase = elapsed * (9 + horizontalWind * 0.035)
		local offset = Vector3.new(
			math.sin(phase * 1.7) * shake * 2.4,
			math.sin(phase * 2.31 + 1.2) * shake * 1.1,
			math.cos(phase * 1.13) * shake * 1.8
		)
		local yaw = math.sin(phase * 0.73) * shake * 0.018
		local pitch = math.sin(phase * 1.37) * shake * 0.012
		local roll = math.sin(phase * 0.91) * shake * 0.026
		camera.CFrame = camera.CFrame * CFrame.Angles(pitch, yaw, roll) + offset
	end
	if snapshot.Enabled and snapshot.ElapsedSeconds > 0 then
		while snapshot.ElapsedSeconds >= lightningNextStrike do
			strikeLightning(snapshot)
		end
		local lightningAge = snapshot.ElapsedSeconds - lightningStrikeTime
		local lightningIntensity = if lightningAge >= 0 and lightningAge < lightningDuration
			then (1 - lightningAge / lightningDuration) ^ 2 else 0
		setLightningVisible(lightningIntensity > 0, lightningIntensity)
		if lightningIntensity > 0 then
			lightningHost.Position = snapshot.Position + lightningTop
		end
	else
		setLightningVisible(false, 0)
	end
	local samplePoint = Vector3.new(0, 15, 30) + stormOffset
	local sample = Field.sample(snapshot.Parameters, snapshot.Position, samplePoint, snapshot.ElapsedSeconds)
	local visibility = Field.visibility(snapshot, samplePoint, 500)
	local damage = Field.damage(snapshot, samplePoint)
	for index, point in ipairs(vectorPoints) do
		local field = Field.sample(snapshot.Parameters, snapshot.Position, point + stormOffset, snapshot.ElapsedSeconds)
		local velocity = field.Velocity
		local angle = math.atan(velocity.Z, velocity.X)
		local arrow = arrows[(math.floor((angle + math.pi / 8) / (math.pi / 4)) % 8) + 1]
		vectorLabels[index].Text = string.format("%s %.0f / %.0f", arrow, velocity.Magnitude, velocity.Y)
	end
	readout.Text = string.format(
		"MATURE MULTI-CELL TORNADO\nWind %.0f / %.0f / %.0f m/s\nVisibility %.0f m   Damage %.2f\nGPU: 262K  524K  1M  2M  5M  10M  15M  20M  50M\nLayers: condensation, rain, dust\nField band %s",
		sample.Velocity.X, sample.Velocity.Y, sample.Velocity.Z,
		visibility.EffectiveDistance, damage.Potential, damage.Band
	)
end)
]]></Source>
		<Source path="scripts/shared/TornadoSim/StormField.luau"><![CDATA[--!strict
-- The tornado field is pure data and math. The server owns its state; clients
-- sample the replicated values for presentation.
local Field = {}

export type Parameters = {
	Energy: number,
	CoreRadius: number,
	InfluenceRadius: number,
	PeakTangentialSpeed: number,
	PeakInflowSpeed: number,
	PeakUpdraftSpeed: number,
	PeakDowndraftSpeed: number,
	SurfaceOutflowSpeed: number,
	UpperWind: Vector3,
	PressureDrop: number,
	Humidity: number,
	RainRate: number,
	Turbulence: number,
	TranslationVelocity: Vector3,
	GroundFriction: number,
	DebrisDensity: number,
	VortexTightness: number,
	TopHeight: number,
	CounterClockwise: boolean,
}

export type State = {
	Parameters: Parameters,
	Position: Vector3,
	ElapsedSeconds: number,
	LifecycleEnabled: boolean,
	Enabled: boolean,
}

export type Sample = {
	Velocity: Vector3,
	PressureDeficit: number,
	TangentialSpeed: number,
	InflowSpeed: number,
	UpdraftSpeed: number,
	DowndraftSpeed: number,
	OutflowSpeed: number,
	UpperOutflowSpeed: number,
	VerticalSpeed: number,
	ShearVelocity: Vector3,
	Influence: number,
	Condensation: number,
	DamagePotential: number,
}

local function saturate(value: number): number
	return math.clamp(value, 0, 1)
end

local function noise(x: number, y: number, z: number): number
	return math.sin(x * 1.37 + math.sin(y * 0.73) + z * 0.41) * math.cos(z * 1.11 - x * 0.29 + y * 0.53)
end

local function defaultParameters(): Parameters
	return {
		Energy = 0.72,
		CoreRadius = 34,
		InfluenceRadius = 260,
		PeakTangentialSpeed = 92,
		PeakInflowSpeed = 34,
		PeakUpdraftSpeed = 58,
		PeakDowndraftSpeed = 32,
		SurfaceOutflowSpeed = 28,
		UpperWind = Vector3.new(18, 0, -6),
		PressureDrop = 72,
		Humidity = 0.82,
		RainRate = 0.68,
		Turbulence = 13,
		TranslationVelocity = Vector3.new(4, 0, 1.5),
		GroundFriction = 0.28,
		DebrisDensity = 0.65,
		VortexTightness = 2.25,
		TopHeight = 360,
		CounterClockwise = true,
	}
end

local function sanitize(parameters: Parameters): Parameters
	local result = table.clone(parameters)
	result.Energy = saturate(result.Energy)
	result.CoreRadius = math.max(result.CoreRadius, 1)
	result.InfluenceRadius = math.max(result.InfluenceRadius, result.CoreRadius * 1.25)
	result.PeakTangentialSpeed = math.max(result.PeakTangentialSpeed, 0)
	result.PeakInflowSpeed = math.max(result.PeakInflowSpeed, 0)
	result.PeakUpdraftSpeed = math.max(result.PeakUpdraftSpeed, 0)
	result.PeakDowndraftSpeed = math.max(result.PeakDowndraftSpeed, 0)
	result.SurfaceOutflowSpeed = math.max(result.SurfaceOutflowSpeed, 0)
	result.UpperWind = Vector3.new(result.UpperWind.X, 0, result.UpperWind.Z)
	result.PressureDrop = math.max(result.PressureDrop, 0)
	result.Humidity = saturate(result.Humidity)
	result.RainRate = saturate(result.RainRate)
	result.Turbulence = math.max(result.Turbulence, 0)
	result.GroundFriction = saturate(result.GroundFriction)
	result.DebrisDensity = saturate(result.DebrisDensity)
	result.VortexTightness = math.clamp(result.VortexTightness, 0.75, 18)
	result.TopHeight = math.max(result.TopHeight, 50)
	return result
end

local function prepare(parameters: Parameters)
	local p = sanitize(parameters)
	local pressure = p.PressureDrop * (0.30 + 0.70 * p.Energy)
	local upperLength = Vector3.new(p.UpperWind.X, 0, p.UpperWind.Z).Magnitude
	return {
		Parameters = p,
		EnergyScale = math.sqrt(p.Energy),
		PressureDrive = math.clamp(0.55 + 0.45 * math.sqrt(pressure / 72), 0.55, 1.45),
		RotationSign = if p.CounterClockwise then 1 else -1,
		InverseCoreRadius = 1 / p.CoreRadius,
		InverseInfluenceRadius = 1 / p.InfluenceRadius,
		InverseTopHeight = 1 / p.TopHeight,
		UpperWindLength = upperLength,
		InverseUpperWindLength = if upperLength > 1e-5 then 1 / upperLength else 0,
	}
end

local function influence(field: any, radius: number): number
	return 1 / (1 + (radius * field.InverseInfluenceRadius) ^ field.Parameters.VortexTightness)
end

local function eyeDecay(field: any, radius: number): number
	local ratio = math.max(radius, 0) * field.InverseCoreRadius / 0.34
	return math.exp(-(ratio * ratio))
end

local function tangential(field: any, radius: number, amount: number): number
	local x = math.max(radius, 0) * field.InverseCoreRadius
	return field.Parameters.PeakTangentialSpeed * field.EnergyScale * (2 * x) / (1 + x * x) * amount
end

local function inflow(field: any, radius: number, amount: number): number
	local x = math.max(radius, 0) * field.InverseCoreRadius / 2.15
	return field.Parameters.PeakInflowSpeed * field.EnergyScale * field.PressureDrive * x * math.exp(1 - x) * amount
end

local function updraft(field: any, radius: number, height: number, eyeGate: number): number
	local ratio = radius * field.InverseCoreRadius / 1.9
	local radial = math.exp(-(ratio * ratio)) * eyeGate
	local ramp = 0.22 + 0.78 * saturate(height / 18)
	local fraction = math.max(height, 0) * field.InverseTopHeight
	return field.Parameters.PeakUpdraftSpeed * field.EnergyScale * radial * ramp * saturate(1 - fraction ^ 3)
end

local function coreSubsidence(field: any, height: number, decay: number): number
	local feed = saturate((math.max(height, 0) - 12) / 45)
	local fraction = math.max(height, 0) * field.InverseTopHeight
	return field.Parameters.PeakDowndraftSpeed * field.EnergyScale * 0.18 * decay * feed * saturate(1 - fraction ^ 3)
end

local function downdraftColumn(field: any, radius: number, height: number, amount: number): number
	local center = field.Parameters.CoreRadius * 4.2
	local width = field.Parameters.CoreRadius * 1.7
	local ratio = (radius - center) / width
	local cloud = 0.35 + 0.65 * saturate((saturate(math.max(height, 0) * field.InverseTopHeight) - 0.16) / 0.56)
	return field.Parameters.PeakDowndraftSpeed * field.EnergyScale * math.exp(-(ratio * ratio)) * amount * cloud
end

local function outflow(field: any, radius: number, height: number, amount: number): number
	local center = field.Parameters.CoreRadius * 4.2
	local width = field.Parameters.CoreRadius * 1.9
	local ratio = (radius - center) / width
	local surface = 1 - saturate((math.max(height, 0) - 4) / 34)
	return field.Parameters.SurfaceOutflowSpeed * field.EnergyScale * math.exp(-(ratio * ratio)) * amount * surface
end

function Field.samplePrepared(field: any, center: Vector3, position: Vector3, timeSeconds: number): Sample
	local p = field.Parameters
	local offset = position - center
	local radius = Vector3.new(offset.X, 0, offset.Z).Magnitude
	local radial = if radius > 1e-5 then Vector3.new(offset.X / radius, 0, offset.Z / radius) else Vector3.xAxis
	local tangent = Vector3.new(-radial.Z * field.RotationSign, 0, radial.X * field.RotationSign)
	local amount = influence(field, radius)
	local pressureRatio = radius * field.InverseCoreRadius / 1.25
	local decay = eyeDecay(field, radius)
	local eyeGate = 1 - decay
	local pressureDeficit = p.PressureDrop * p.Energy * math.exp(-(pressureRatio * pressureRatio)) * amount
	local tangentialSpeed = tangential(field, radius, amount)
	local inflowSpeed = inflow(field, radius, amount)
	local updraftSpeed = updraft(field, radius, offset.Y, eyeGate)
	local flank = 1
	if field.UpperWindLength > 1e-5 then
		local alignment = (radial.X * p.UpperWind.X + radial.Z * p.UpperWind.Z) * field.InverseUpperWindLength
		local downshear = saturate(alignment * 0.5 + 0.5)
		flank = 0.08 + 0.92 * downshear * downshear
	end
	local clearance = saturate(math.max(offset.Y, 0) / 18)
	local downdraftSpeed = downdraftColumn(field, radius, offset.Y, amount) * clearance * flank
		+ coreSubsidence(field, offset.Y, decay)
	local outflowSpeed = outflow(field, radius, offset.Y, amount) * flank
	local verticalSpeed = updraftSpeed - downdraftSpeed
	local height = saturate(math.max(offset.Y, 0) * field.InverseTopHeight)
	local upper = saturate((height - 0.72) / 0.22)
	local upperSmooth = upper * upper * (3 - 2 * upper)
	local upperOutflowSpeed = p.PeakUpdraftSpeed
		* field.EnergyScale
		* 0.65
		* upperSmooth
		* amount
		* (0.35 + 0.65 * eyeGate)
	local shear = saturate((height - 0.18) / 0.64)
	local shearSmooth = shear * shear * (3 - 2 * shear)
	local shearVelocity = p.UpperWind * (field.EnergyScale * shearSmooth)
	local condensation =
		saturate(p.Humidity * (p.PressureDrop / 100) * (updraftSpeed / math.max(p.PeakUpdraftSpeed, 1)) * 1.65)
	local destructive = tangentialSpeed * tangentialSpeed + inflowSpeed * inflowSpeed
	local damagePotential = saturate((destructive / (105 * 105)) * 0.86 + (pressureDeficit / 120) * 0.14)
	local phase = timeSeconds * 1.7
	local turbulence = Vector3.new(
		noise(position.Z * 0.026, position.Y * 0.026, phase),
		noise(position.X * 0.026 + 11, position.Z * 0.026, phase * 0.71),
		noise(position.Y * 0.026, position.X * 0.026 - 7, phase * 1.13)
	)
	local nearGround = 1 - p.GroundFriction * (1 - saturate(offset.Y / 22))
	local coreTurbulence = 0.12 + 0.88 * eyeGate
	local boundary = saturate(math.max(offset.Y, 0) / 18)
	local variation = math.sin(position.X * 0.031 + timeSeconds * 1.7) * math.cos(position.Z * 0.027 - timeSeconds)
	local rollPhase = radius * 0.075 - timeSeconds * 0.9 + variation * 1.4
	local rollSpeed = (p.Turbulence * amount * 1.10 + outflowSpeed * 0.65) * (1 - boundary) * (1 - boundary)
	local radialRoll = math.sin(rollPhase) * math.cos(math.pi * boundary) * rollSpeed
	local verticalRoll = -math.cos(rollPhase) * math.sin(math.pi * boundary) * rollSpeed * 1.25
	local wallDepth = math.max(p.GroundFriction * 8, 0.05)
	local wall = saturate(math.max(offset.Y, 0) / wallDepth)
	local slip = wall * wall * (3 - 2 * wall)
	local horizontal = (tangent * tangentialSpeed - radial * inflowSpeed) * nearGround
	horizontal += radial * (outflowSpeed + radialRoll + upperOutflowSpeed)
	local velocity = horizontal * slip
		+ Vector3.new(0, verticalSpeed + verticalRoll, 0)
		+ shearVelocity
		+ turbulence * (p.Turbulence * amount * coreTurbulence)
		+ p.TranslationVelocity
	return {
		Velocity = velocity,
		PressureDeficit = pressureDeficit,
		TangentialSpeed = tangentialSpeed,
		InflowSpeed = inflowSpeed,
		UpdraftSpeed = updraftSpeed,
		DowndraftSpeed = downdraftSpeed,
		OutflowSpeed = outflowSpeed,
		UpperOutflowSpeed = upperOutflowSpeed,
		VerticalSpeed = verticalSpeed,
		ShearVelocity = shearVelocity,
		Influence = amount,
		Condensation = condensation,
		DamagePotential = damagePotential,
	}
end

function Field.sample(parameters: Parameters, center: Vector3, position: Vector3, timeSeconds: number): Sample
	return Field.samplePrepared(prepare(parameters), center, position, timeSeconds)
end

function Field.cloudDensity(parameters: Parameters, localPosition: Vector3, timeSeconds: number): number
	local p = sanitize(parameters)
	local height = localPosition.Y
	if height < 0 or height > p.TopHeight * 1.16 then
		return 0
	end
	local radius = Vector3.new(localPosition.X, 0, localPosition.Z).Magnitude
	local prepared = prepare(p)
	local sample = Field.samplePrepared(prepared, Vector3.zero, localPosition, timeSeconds)
	local pressureMoisture = saturate(p.Humidity * (0.30 + p.PressureDrop / 100) * math.sqrt(p.Energy))
	local windNormalizer = math.max(p.PeakInflowSpeed + p.PeakUpdraftSpeed * 0.75 + p.PeakTangentialSpeed * 0.18, 1)
	local windLineDensity = saturate(
		(sample.InflowSpeed + math.max(sample.VerticalSpeed, 0) * 0.75 + sample.TangentialSpeed * 0.18)
			/ windNormalizer
			* 2.2
	)
	local normalizedHeight = saturate(height / p.TopHeight)
	local lowerColumn = 1 - saturate((normalizedHeight - 0.78) / 0.24)
	local funnel = sample.Condensation * lowerColumn * (0.38 + windLineDensity * 0.78)
	local wallRadius = (radius - p.CoreRadius * 1.8) / math.max(p.CoreRadius * 1.7, 1)
	local wallCloud = pressureMoisture
		* math.exp(-(wallRadius * wallRadius))
		* math.exp(-(((normalizedHeight - 0.24) / 0.22) ^ 2))
		* (0.32 + windLineDensity * 0.78)
	local phase = math.atan2(localPosition.Z, localPosition.X) * 5 * prepared.RotationSign
		+ radius / p.CoreRadius * 1.45
		- normalizedHeight * 5.2
		- timeSeconds * (0.28 + p.Turbulence * 0.006) * prepared.RotationSign
	local streamlineBands = 0.62 + 0.38 * (0.5 + 0.5 * math.sin(phase))
	local cellularVariation = 0.82
		+ 0.18 * math.sin(localPosition.X * 0.043 + height * 0.029 - localPosition.Z * 0.037 + timeSeconds * 0.11)
	return saturate(math.max(funnel, wallCloud) * streamlineBands * cellularVariation)
end

local AIR_DENSITY = 1.225

local function finite(value: number): boolean
	return value == value and math.abs(value) < math.huge
end

function Field.rawDragForce(
	windVelocity: Vector3,
	bodyVelocity: Vector3,
	area: number,
	dragCoefficient: number,
	forceScale: number
): Vector3
	if
		not finite(area)
		or not finite(dragCoefficient)
		or not finite(forceScale)
		or area <= 0
		or dragCoefficient <= 0
		or forceScale <= 0
	then
		return Vector3.zero
	end
	local relative = windVelocity - bodyVelocity
	local speed = relative.Magnitude
	if not finite(speed) or speed <= 0 then
		return Vector3.zero
	end
	return relative * (0.5 * AIR_DENSITY * dragCoefficient * area * speed * forceScale)
end

function Field.dragForce(
	windVelocity: Vector3,
	bodyVelocity: Vector3,
	area: number,
	dragCoefficient: number,
	forceScale: number,
	delta: number,
	mass: number
): Vector3
	local force = Field.rawDragForce(windVelocity, bodyVelocity, area, dragCoefficient, forceScale)
	local relativeSpeed = (windVelocity - bodyVelocity).Magnitude
	if
		not finite(delta)
		or not finite(mass)
		or delta <= 0
		or mass <= 0
		or relativeSpeed <= 0
		or force == Vector3.zero
	then
		return Vector3.zero
	end
	local impulseSpeed = force.Magnitude * delta / mass
	if impulseSpeed <= 0 then
		return Vector3.zero
	end
	return force * math.min(1, relativeSpeed / impulseSpeed)
end

function Field.linkDamage(
	integrity: number,
	load: number,
	breakForce: number,
	materialStrength: number,
	damageRate: number,
	delta: number,
	enabled: boolean
): (number, boolean)
	if
		not enabled
		or not finite(load)
		or not finite(breakForce)
		or not finite(materialStrength)
		or not finite(integrity)
		or not finite(damageRate)
		or not finite(delta)
		or breakForce <= 0
		or materialStrength <= 0
		or damageRate < 0
		or delta < 0
	then
		return integrity, false
	end
	local capacity = breakForce * materialStrength
	local overload = math.max(load / capacity - 0.55, 0)
	local updated = math.clamp(integrity - overload * damageRate * delta, 0, 1)
	return updated, updated <= 0
end

local function wrapRadians(value: number): number
	while value > math.pi do
		value -= math.pi * 2
	end
	while value < -math.pi do
		value += math.pi * 2
	end
	return value
end

function Field.vegetationStep(
	bend: number,
	direction: number,
	windVelocity: Vector3,
	maximumBend: number,
	responsePerSecond: number,
	windSpeedForMaximumBend: number,
	delta: number
): (number, number)
	if
		not finite(maximumBend)
		or not finite(responsePerSecond)
		or not finite(windSpeedForMaximumBend)
		or not finite(delta)
		or maximumBend < 0
		or responsePerSecond <= 0
		or windSpeedForMaximumBend <= 0
		or delta <= 0
	then
		return bend, direction
	end
	local horizontal = Vector3.new(windVelocity.X, 0, windVelocity.Z)
	local speed = horizontal.Magnitude
	local targetBend = math.min(maximumBend, speed / windSpeedForMaximumBend * maximumBend)
	local follow = math.min(delta * responsePerSecond, 1)
	local nextBend = bend + (targetBend - bend) * follow
	local nextDirection = direction
	if speed > 1e-5 then
		nextDirection += wrapRadians(math.atan2(horizontal.Z, horizontal.X) - direction) * follow
	end
	return nextBend, nextDirection
end

function Field.lifecycleEnergy(elapsedSeconds: number): number
	local phase = math.fmod(math.max(elapsedSeconds, 0), 90) / 90
	if phase < 0.18 then
		local x = phase / 0.18
		return 0.12 + 0.63 * x * x * (3 - 2 * x)
	end
	if phase < 0.68 then
		local x = (phase - 0.18) / 0.50
		return 0.75 + 0.18 * math.sin(x * math.pi)
	end
	local x = (phase - 0.68) / 0.32
	return 0.75 * (1 - x) + 0.08 * x
end

function Field.advance(state: State, delta: number)
	local tick = math.max(delta, 0)
	state.Position += state.Parameters.TranslationVelocity * tick
	state.ElapsedSeconds += tick
	if state.LifecycleEnabled then
		state.Parameters.Energy = Field.lifecycleEnergy(state.ElapsedSeconds)
	end
end

function Field.visibility(state: State, position: Vector3, viewDistance: number)
	local distance = math.clamp(viewDistance, 0, 5000)
	local sample = Field.sample(state.Parameters, state.Position, position, state.ElapsedSeconds)
	local p = sanitize(state.Parameters)
	local rain = saturate(p.RainRate * p.Humidity * (0.28 + sample.Influence * 0.72))
	local condensation = saturate(sample.Condensation * (0.45 + sample.Influence * 0.55))
	local obscuration = saturate((rain * 0.42 + condensation * 0.72) * (1 - math.exp(-distance / 240)))
	local clarity = 1 - math.min(obscuration, 0.96)
	return {
		Clarity = clarity,
		EffectiveDistance = distance * clarity,
		RainObscuration = rain,
		CondensationObscuration = condensation,
	}
end

function Field.damage(state: State, position: Vector3)
	local sample = Field.sample(state.Parameters, state.Position, position, state.ElapsedSeconds)
	local pressure = 0.5 * 1.225 * sample.Velocity:Dot(sample.Velocity)
	local band = "Safe"
	if sample.DamagePotential >= 0.82 or pressure >= 6200 then
		band = "Catastrophic"
	elseif sample.DamagePotential >= 0.52 or pressure >= 3200 then
		band = "Destructive"
	elseif sample.DamagePotential >= 0.20 or pressure >= 900 then
		band = "Caution"
	end
	return { Velocity = sample.Velocity, Pressure = pressure, Potential = sample.DamagePotential, Band = band }
end

local function copyParameters(parameters: Parameters): Parameters
	return table.clone(parameters)
end

function Field.new(parameters: Parameters, position: Vector3): State
	return {
		Parameters = sanitize(copyParameters(parameters)),
		Position = position,
		ElapsedSeconds = 0,
		LifecycleEnabled = false,
		Enabled = true,
	}
end

function Field.configure(state: State, changes: { [string]: any })
	local parameters = state.Parameters :: any
	for name, value in pairs(changes) do
		if name == "Position" then
			state.Position = value
		elseif name == "ElapsedSeconds" then
			state.ElapsedSeconds = math.max(value, 0)
		elseif name == "LifecycleEnabled" then
			state.LifecycleEnabled = value
		elseif name == "Enabled" then
			state.Enabled = value
		elseif parameters[name] ~= nil then
			parameters[name] = value
		end
	end
	state.Parameters = sanitize(state.Parameters)
end

function Field.snapshot(state: State)
	return {
		Parameters = copyParameters(state.Parameters),
		Position = state.Position,
		ElapsedSeconds = state.ElapsedSeconds,
		LifecycleEnabled = state.LifecycleEnabled,
		Enabled = state.Enabled,
	}
end

function Field.fromComponent(row: { [string]: any }): State
	local parameters: Parameters = {
		Energy = row.Energy,
		CoreRadius = row.CoreRadius,
		InfluenceRadius = row.InfluenceRadius,
		PeakTangentialSpeed = row.PeakTangentialSpeed,
		PeakInflowSpeed = row.PeakInflowSpeed,
		PeakUpdraftSpeed = row.PeakUpdraftSpeed,
		PeakDowndraftSpeed = row.PeakDowndraftSpeed,
		SurfaceOutflowSpeed = row.SurfaceOutflowSpeed,
		UpperWind = row.UpperWind,
		PressureDrop = row.PressureDrop,
		Humidity = row.Humidity,
		RainRate = row.RainRate,
		Turbulence = row.Turbulence,
		TranslationVelocity = row.TranslationVelocity,
		GroundFriction = row.GroundFriction,
		DebrisDensity = row.DebrisDensity,
		VortexTightness = row.VortexTightness,
		TopHeight = row.TopHeight,
		CounterClockwise = row.CounterClockwise,
	}
	return {
		Parameters = sanitize(parameters),
		Position = row.Position,
		ElapsedSeconds = row.ElapsedSeconds,
		LifecycleEnabled = row.LifecycleEnabled,
		Enabled = row.Enabled,
	}
end

function Field.toComponent(state: State): { [string]: any }
	local p = state.Parameters
	return {
		Enabled = state.Enabled,
		Energy = p.Energy,
		CoreRadius = p.CoreRadius,
		InfluenceRadius = p.InfluenceRadius,
		PeakTangentialSpeed = p.PeakTangentialSpeed,
		PeakInflowSpeed = p.PeakInflowSpeed,
		PeakUpdraftSpeed = p.PeakUpdraftSpeed,
		PeakDowndraftSpeed = p.PeakDowndraftSpeed,
		SurfaceOutflowSpeed = p.SurfaceOutflowSpeed,
		UpperWind = p.UpperWind,
		PressureDrop = p.PressureDrop,
		Humidity = p.Humidity,
		RainRate = p.RainRate,
		Turbulence = p.Turbulence,
		TranslationVelocity = p.TranslationVelocity,
		GroundFriction = p.GroundFriction,
		DebrisDensity = p.DebrisDensity,
		VortexTightness = p.VortexTightness,
		TopHeight = p.TopHeight,
		CounterClockwise = p.CounterClockwise,
		Position = state.Position,
		ElapsedSeconds = state.ElapsedSeconds,
		LifecycleEnabled = state.LifecycleEnabled,
	}
end

-- Preset rows keep the field parameters in one fixed order for EF and Q scales.
local EF = {
	{ 0.30, 22, 170, 33.5, 12, 25, 14, 12, 10, -3, 25, 0.65, 0.35, 5, 3, 1, 0.34, 0.18, 1.45, 240 },
	{ 0.42, 26, 200, 43.8, 17, 32, 18, 15, 13, -4, 38, 0.70, 0.45, 7, 3.5, 1, 0.32, 0.28, 1.70, 280 },
	{ 0.56, 30, 230, 55, 23, 42, 23, 20, 16, -5, 54, 0.76, 0.55, 9.5, 4, 1.2, 0.30, 0.42, 1.95, 320 },
	{ 0.70, 34, 270, 67.5, 30, 55, 30, 27, 20, -7, 72, 0.82, 0.68, 13, 4.5, 1.5, 0.28, 0.60, 2.25, 370 },
	{ 0.84, 39, 320, 81.8, 39, 69, 38, 34, 25, -9, 92, 0.88, 0.78, 17, 5.5, 1.8, 0.25, 0.78, 2.65, 430 },
	{ 1.00, 45, 520, 98.3, 49, 84, 47, 42, 30, -11, 115, 0.93, 0.88, 22, 7, 2.2, 0.22, 0.95, 3.10, 500 },
}
local Q = {
	{ 1, 60, 650, 123, 65, 110, 65, 58, 40, -15, 140, 0.95, 0.90, 30, 10, 3, 0.20, 0.96, 3.60, 650 },
	{ 1, 80, 800, 156.5, 85, 145, 85, 75, 52, -20, 175, 0.96, 0.92, 42, 15, 4, 0.18, 0.97, 4.20, 800 },
	{ 1, 105, 950, 201.2, 110, 185, 110, 95, 65, -26, 215, 0.97, 0.94, 55, 20, 6, 0.16, 0.98, 5, 1000 },
	{ 1, 140, 1120, 257.1, 140, 225, 140, 120, 78, -32, 260, 0.98, 0.96, 70, 28, 8, 0.14, 0.99, 6.5, 1220 },
	{ 1, 190, 1340, 335.3, 175, 265, 175, 150, 92, -38, 310, 0.99, 0.98, 88, 40, 11, 0.12, 1, 9, 1500 },
	{ 1, 250, 1560, 447, 210, 300, 210, 180, 105, -45, 360, 1, 1, 105, 55, 15, 0.10, 1, 12, 1800 },
}

local function presetParameters(row: { number }): Parameters
	local parameters = defaultParameters()
	parameters.Energy = row[1]
	parameters.CoreRadius = row[2]
	parameters.InfluenceRadius = row[3]
	parameters.PeakTangentialSpeed = row[4]
	parameters.PeakInflowSpeed = row[5]
	parameters.PeakUpdraftSpeed = row[6]
	parameters.PeakDowndraftSpeed = row[7]
	parameters.SurfaceOutflowSpeed = row[8]
	parameters.UpperWind = Vector3.new(row[9], 0, row[10])
	parameters.PressureDrop = row[11]
	parameters.Humidity = row[12]
	parameters.RainRate = row[13]
	parameters.Turbulence = row[14]
	parameters.TranslationVelocity = Vector3.new(row[15], 0, row[16])
	parameters.GroundFriction = row[17]
	parameters.DebrisDensity = row[18]
	parameters.VortexTightness = row[19]
	parameters.TopHeight = row[20]
	return parameters
end

function Field.preset(state: State, name: string): boolean
	local isEf = string.sub(name, 1, 2) == "EF"
	local index = tonumber(string.sub(name, if isEf then 3 else 2, if isEf then 3 else 2))
	if index == nil or index < 0 or index > 5 then
		return false
	end
	if isEf then
		state.Parameters = presetParameters(EF[index + 1])
	elseif string.sub(name, 1, 1) == "Q" then
		state.Parameters = presetParameters(Q[index + 1])
	else
		return false
	end
	return true
end

-- The authority declares schemas before publishing them. Client copies of this
-- shared math module consume the replicated schema metadata sent by the server.
if game:GetService("RunService"):IsServer() then
	-- Custom script state shares the same per-world ECS store as parts and joints.
	World:DefineComponent("Tornado.State", {
		Enabled = "bool",
		Energy = "number",
		CoreRadius = "number",
		InfluenceRadius = "number",
		PeakTangentialSpeed = "number",
		PeakInflowSpeed = "number",
		PeakUpdraftSpeed = "number",
		PeakDowndraftSpeed = "number",
		SurfaceOutflowSpeed = "number",
		UpperWind = "Vector3",
		PressureDrop = "number",
		Humidity = "number",
		RainRate = "number",
		Turbulence = "number",
		TranslationVelocity = "Vector3",
		GroundFriction = "number",
		DebrisDensity = "number",
		VortexTightness = "number",
		TopHeight = "number",
		CounterClockwise = "bool",
		Position = "Vector3",
		ElapsedSeconds = "number",
		LifecycleEnabled = "bool",
	})
	World:DefineComponent("Tornado.Response", {
		Enabled = "bool",
		ExposedArea = "number",
		DragCoefficient = "number",
		ForceScale = "number",
	})
	World:DefineComponent("Tornado.Link", {
		Enabled = "bool",
		BreakForce = "number",
		MaterialStrength = "number",
		Integrity = "number",
		DamageRate = "number",
	})
	World:DefineComponent("Tornado.Vegetation", {
		Enabled = "bool",
		RestFrame = "CFrame",
		BendRadians = "number",
		BendDirectionRadians = "number",
		MaximumBendRadians = "number",
		ResponsePerSecond = "number",
		WindSpeedForMaximumBend = "number",
	})

	World:SetComponentTags("Tornado.State", { "replicated" })
end

Field.defaultParameters = defaultParameters
Field.prepare = prepare
Field.sanitize = sanitize
return Field
