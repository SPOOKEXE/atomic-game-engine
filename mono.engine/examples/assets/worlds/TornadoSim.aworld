		<Source path="scripts/shared/TornadoSim/StormControls.luau"><![CDATA[--!strict
-- One controls vocabulary for the server's storm resource and the local panel.
local Controls = {}

Controls.presets = {
	"EF0", "EF1", "EF2", "EF3", "EF4", "EF5",
	"Q0", "Q1", "Q2", "Q3", "Q4", "Q5",
}

Controls.default = {
	Energy = 0.78,
	CoreRadius = 28,
	InfluenceRadius = 310,
	PeakTangentialSpeed = 122,
	PeakInflowSpeed = 38,
	PeakUpdraftSpeed = 64,
	PeakDowndraftSpeed = 28,
	SurfaceOutflowSpeed = 24,
	PressureDrop = 96,
	Humidity = 0.88,
	RainRate = 0.82,
	Turbulence = 0.34,
	GroundFriction = 0.22,
	DebrisDensity = 0.72,
	VortexTightness = 8,
	TopHeight = 430,
	UpperWind = Vector3.new(14, 0, 7),
	TranslationVelocity = Vector3.new(5, 0, 1.5),
	Position = Vector3.new(0, 0, 95),
	LifecycleEnabled = false,
	Enabled = true,
}

-- Bounds live beside the default so both clients give immediate feedback and
-- the authority can reject values that do not describe a usable field.
Controls.parameters = {
	{ Key = "Energy", Label = "Energy", Min = 0, Max = 1, Step = 0.02 },
	{ Key = "CoreRadius", Label = "Core radius", Min = 1, Max = 300, Step = 1 },
	{ Key = "InfluenceRadius", Label = "Influence", Min = 20, Max = 1200, Step = 10 },
	{ Key = "PeakTangentialSpeed", Label = "Tangential", Min = 0, Max = 220, Step = 5 },
	{ Key = "PeakInflowSpeed", Label = "Inflow", Min = 0, Max = 160, Step = 5 },
	{ Key = "PeakUpdraftSpeed", Label = "Updraft", Min = 0, Max = 180, Step = 5 },
	{ Key = "PeakDowndraftSpeed", Label = "Downdraft", Min = 0, Max = 160, Step = 5 },
	{ Key = "SurfaceOutflowSpeed", Label = "Outflow", Min = 0, Max = 140, Step = 5 },
	{ Key = "PressureDrop", Label = "Pressure", Min = 0, Max = 220, Step = 5 },
	{ Key = "Humidity", Label = "Humidity", Min = 0, Max = 1, Step = 0.02 },
	{ Key = "RainRate", Label = "Rain", Min = 0, Max = 2, Step = 0.05 },
	{ Key = "Turbulence", Label = "Turbulence", Min = 0, Max = 1, Step = 0.02 },
	{ Key = "GroundFriction", Label = "Ground drag", Min = 0, Max = 1, Step = 0.02 },
	{ Key = "DebrisDensity", Label = "Debris", Min = 0, Max = 1, Step = 0.02 },
	{ Key = "VortexTightness", Label = "Tightness", Min = 1, Max = 20, Step = 0.5 },
	{ Key = "TopHeight", Label = "Top height", Min = 60, Max = 1200, Step = 20 },
}

return Controls
]]></Source>
		<Source path="scripts/server/TornadoServer.server.luau"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Controls = require(ReplicatedStorage.TornadoSim.StormControls)
local controlEvent = ReplicatedStorage.TornadoControl

-- The fixed-step physics resource owns lifecycle and force application.
Storm.Configure(Controls.default)
Storm.Preset("EF3")
Storm.Configure(Controls.default)

local validPreset = {}
for _, preset in ipairs(Controls.presets) do validPreset[preset] = true end
local validParticleCount = {
	[262144] = true,
	[524288] = true,
	[1048576] = true,
	[2000000] = true,
	[5000000] = true,
	[10000000] = true,
	[15000000] = true,
	[20000000] = true,
	[50000000] = true,
}
local parameterBounds: { [string]: any } = {}
for _, parameter in ipairs(Controls.parameters) do
	parameterBounds[parameter.Key] = parameter
end
local particleField = workspace:FindFirstChild("TornadoParticles", true)
local environmentResetRequested = false
local environmentObserverPosition = Controls.default.Position

-- Authority applies validated requests from the in-game controls.
controlEvent.OnServerEvent:Connect(function(payload: string)
	local decoded, request = pcall(function() return HttpService:JSONDecode(payload) end)
	if not decoded then return end
	if type(request) ~= "table" then return end
	if request.kind == "preset" and type(request.name) == "string" and validPreset[request.name] then
		Storm.Preset(request.name)
	elseif request.kind == "custom" and type(request.energy) == "number" and type(request.radius) == "number"
		and request.energy >= 0 and request.energy <= 1 and request.radius >= 1 and request.radius <= 300 then
		Storm.Configure({ Energy = request.energy, CoreRadius = request.radius })
	elseif request.kind == "particles" and particleField ~= nil and type(request.count) == "number"
		and validParticleCount[request.count] then
		particleField.RequestedCount = request.count
	elseif request.kind == "layers" and particleField ~= nil and type(request.mask) == "number"
		and request.mask >= 0 and request.mask <= 7 and request.mask % 1 == 0 then
		particleField.Layers = request.mask
	elseif request.kind == "motion" and type(request.x) == "number" and type(request.y) == "number"
		and type(request.z) == "number" and math.abs(request.x) <= 60 and math.abs(request.y) <= 60
		and math.abs(request.z) <= 60 then
		Storm.Configure({ TranslationVelocity = Vector3.new(request.x, request.y, request.z) })
	elseif request.kind == "rotation" and type(request.counterClockwise) == "boolean" then
		Storm.Configure({ CounterClockwise = request.counterClockwise })
	elseif request.kind == "parameters" and type(request.values) == "table" then
		local configuration: { [string]: number } = {}
		for name, value in pairs(request.values) do
			local bounds = parameterBounds[name]
			if bounds ~= nil and type(value) == "number" and value >= bounds.Min and value <= bounds.Max then
				configuration[name] = value
			end
		end
		if next(configuration) ~= nil then Storm.Configure(configuration) end
	elseif request.kind == "enabled" and type(request.value) == "boolean" then
		Storm.Configure({ Enabled = request.value })
	elseif request.kind == "reset" then
		Storm.Configure({ ElapsedSeconds = 0 })
		Storm.Configure(Controls.default)
		environmentResetRequested = true
	elseif request.kind == "observer" and type(request.x) == "number" and type(request.z) == "number"
		and math.abs(request.x) <= 4096 and math.abs(request.z) <= 4096 then
		environmentObserverPosition = Vector3.new(request.x, 0, request.z)
	elseif request.kind == "lifecycle" and type(request.value) == "boolean" then
		Storm.Configure({ LifecycleEnabled = request.value })
	end
end)

local interactionConnections: { RBXScriptConnection } = {}

local function interactionPart(name: string, position: Vector3, size: Vector3, colour: Color3, anchored: boolean, parent: Instance): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Position = position
	part.Size = size
	part.Color = colour
	part.Anchored = anchored
	part.Parent = parent
	return part
end

local function rebuildInteraction()
	for _, connection in ipairs(interactionConnections) do connection:Disconnect() end
	interactionConnections = {}
	local old = workspace:FindFirstChild("StormInteraction")
	if old then old:Destroy() end
	local interaction = Instance.new("Folder")
	interaction.Name = "StormInteraction"
	interaction.Parent = workspace
	local mast = interactionPart("SteelMast", Vector3.new(-28, 5, -12), Vector3.new(0.7, 10, 0.7), Color3.fromRGB(46, 51, 56), true, interaction)
	local woodenSign = interactionPart("WoodenSign", Vector3.new(-25.3, 7, -12), Vector3.new(5, 2.8, 0.25), Color3.fromRGB(82, 46, 20), false, interaction)
	local steelPanel = interactionPart("SteelPanel", Vector3.new(-25.8, 3.5, -12), Vector3.new(3.2, 2.1, 0.2), Color3.fromRGB(87, 92, 94), false, interaction)
	local tree = interactionPart("WindBentTree", Vector3.new(13.630354, 7, -15.45179), Vector3.new(1.1, 14, 1.1), Color3.fromRGB(69, 51, 31), true, interaction)

	woodenSign.StormExposedArea = 12.0
	woodenSign.StormDragCoefficient = 1.15
	woodenSign.StormForceScale = 1.0
	steelPanel.StormExposedArea = 7.0
	steelPanel.StormDragCoefficient = 1.05
	steelPanel.StormForceScale = 0.7
	tree.StormRestFrame = tree.CFrame
	tree.StormMaximumBendRadians = 0.52
	tree.StormResponsePerSecond = 5.0
	tree.StormWindSpeedForMaximumBend = 72.0

	local function stormLink(name: string, part: Part, breakForce: number, strength: number): WeldConstraint
		local link = Instance.new("WeldConstraint")
		link.Name = name
		link.Part0 = mast
		link.Part1 = part
		link.StormBreakForce = breakForce
		link.StormMaterialStrength = strength
		link.Parent = interaction
		return link
	end

	local function retireWhenBroken(link: WeldConstraint, part: Part)
		local retired = false
		table.insert(interactionConnections, RunService.Heartbeat:Connect(function()
			if retired or link.Enabled then return end
			retired = true
			local damage = Storm.Damage(part.Position)
			Debris:AddItem(part, if damage.Potential > 0.5 then 5.0 else 10.0)
			Debris:AddItem(link, 10.0)
		end))
	end

	local woodLink = stormLink("Wood Sign Wind Link", woodenSign, 360.0, 0.55)
	local steelLink = stormLink("Steel Panel Wind Link", steelPanel, 640.0, 1.65)
	retireWhenBroken(woodLink, woodenSign)
	retireWhenBroken(steelLink, steelPanel)
end

-- Every assembly has an anchored foundation row. The physics weld pass selects
-- that row as its root while support links survive, then the same connected
-- component becomes dynamic when storm fatigue opens a path through it.
local material = {
	timber = { Colour = Color3.fromRGB(133, 87, 48), Strength = 0.72, BreakForce = 18500, DamageRate = 1.45 },
	masonry = { Colour = Color3.fromRGB(128, 126, 119), Strength = 1.05, BreakForce = 32500, DamageRate = 0.72 },
	steel = { Colour = Color3.fromRGB(104, 128, 145), Strength = 1.65, BreakForce = 42000, DamageRate = 0.38 },
	glass = { Colour = Color3.fromRGB(112, 178, 192), Strength = 0.42, BreakForce = 9000, DamageRate = 2.1 },
}

local assemblies = Instance.new("Folder")
assemblies.Name = "Storm Structure Assemblies"
assemblies.Parent = workspace

local function structuralPart(name: string, frame: CFrame, size: Vector3, profile: any, anchored: boolean, parent: Instance): Part
	local part = Instance.new("Part")
	part.Name = name
	part.CFrame = frame
	part.Size = size
	part.Color = profile.Colour
	part.Anchored = anchored
	part.StormExposedArea = size.X * size.Y
	part.StormDragCoefficient = 1.08
	part.StormForceScale = 0.82
	part.Parent = parent
	return part
end

local function stormJoint(name: string, first: Part, second: Part, profile: any, parent: Instance)
	local joint = Instance.new("WeldConstraint")
	joint.Name = name
	joint.Part0 = first
	joint.Part1 = second
	joint.StormBreakForce = profile.BreakForce
	joint.StormMaterialStrength = profile.Strength
	joint.StormIntegrity = 1.0
	joint.StormDamageRate = profile.DamageRate
	joint.Parent = parent
	return joint
end

local function assembly(name: string, origin: Vector3, yaw: number, columns: number, rows: number, depths: number, profile: any)
	local model = Instance.new("Folder")
	model.Name = name
	model.Parent = assemblies
	local parts: { [string]: Part } = {}
	local frame = CFrame.new(origin) * CFrame.Angles(0, yaw, 0)
	local function key(row: number, column: number, depth: number): string
		return row .. ":" .. column .. ":" .. depth
	end
	for row = 0, rows - 1 do
		for column = 0, columns - 1 do
			for depth = 0, depths - 1 do
				local localFrame = CFrame.new((column - (columns - 1) * 0.5) * 4.4, 1.65 + row * 3.3, (depth - (depths - 1) * 0.5) * 4.4)
				local outerFace = row > 0 and (column == 0 or column == columns - 1 or depth == 0 or depth == depths - 1)
				local memberProfile = outerFace and material.glass or profile
				parts[key(row, column, depth)] = structuralPart(name .. " Member " .. key(row, column, depth), frame * localFrame, Vector3.new(3.8, 2.9, 3.8), memberProfile, row == 0, model)
			end
		end
	end
	for row = 0, rows - 1 do
		for column = 0, columns - 1 do
			for depth = 0, depths - 1 do
				local current = parts[key(row, column, depth)]
				if row + 1 < rows then stormJoint(name .. " Vertical " .. key(row, column, depth), current, parts[key(row + 1, column, depth)], profile, model) end
				if column + 1 < columns then stormJoint(name .. " Cross " .. key(row, column, depth), current, parts[key(row, column + 1, depth)], profile, model) end
				if depth + 1 < depths then stormJoint(name .. " Depth " .. key(row, column, depth), current, parts[key(row, column, depth + 1)], profile, model) end
			end
		end
	end
end

local function rebuildAssemblies()
	for _, child in ipairs(assemblies:GetChildren()) do child:Destroy() end
	assembly("Timber Farmhouse", Vector3.new(-76, 0, 119), math.rad(24), 3, 3, 2, material.timber)
	assembly("Masonry Depot", Vector3.new(46, 0, 83), math.rad(-31), 4, 2, 3, material.masonry)
	assembly("Steel Workshop", Vector3.new(96, 0, 177), math.rad(47), 2, 4, 2, material.steel)
end

-- The vehicle body and every wheel are regular rigid parts. A single weak
-- tie-down uses StormLink, so the same fatigue pass that releases roof panels
-- turns a parked chase vehicle into a storm-driven physics assembly.
local function vehiclePart(name: string, frame: CFrame, size: Vector3, colour: Color3, parent: Instance): Part
	local part = Instance.new("Part")
	part.Name = name
	part.CFrame = frame
	part.Size = size
	part.Color = colour
	part.Anchored = false
	part.CanCollide = true
	part.StormExposedArea = size.X * size.Y
	part.StormDragCoefficient = 1.04
	part.StormForceScale = 0.62
	part.Parent = parent
	return part
end

local function vehicleJoint(name: string, first: Part, second: Part, parent: Instance): WeldConstraint
	local joint = Instance.new("WeldConstraint")
	joint.Name = name
	joint.Part0 = first
	joint.Part1 = second
	joint.StormBreakForce = 24000
	joint.StormMaterialStrength = 1.45
	joint.StormDamageRate = 0.5
	joint.Parent = parent
	return joint
end

local function chaseVehicle(name: string, position: Vector3, yaw: number, parent: Instance)
	local vehicle = Instance.new("Folder")
	vehicle.Name = name
	vehicle.Parent = parent
	local frame = CFrame.new(position) * CFrame.Angles(0, yaw, 0)
	local chassis = vehiclePart(name .. " Chassis", frame * CFrame.new(0, 1.55, 0), Vector3.new(2.35, 0.65, 4.9), Color3.fromRGB(49, 62, 67), vehicle)
	chassis.StormExposedArea = 10.6
	chassis.StormForceScale = 0.72
	local cabin = vehiclePart(name .. " Cabin", frame * CFrame.new(0, 2.35, -0.28), Vector3.new(2.15, 1.12, 2.35), Color3.fromRGB(77, 92, 96), vehicle)
	cabin.StormExposedArea = 7.2
	vehicleJoint(name .. " Cabin Mount", chassis, cabin, vehicle)
	for _, wheelOffset in ipairs({
		Vector3.new(-1.32, 0.75, -1.55), Vector3.new(1.32, 0.75, -1.55),
		Vector3.new(-1.32, 0.75, 1.55), Vector3.new(1.32, 0.75, 1.55),
	}) do
		local wheel = vehiclePart(name .. " Wheel", frame * CFrame.new(wheelOffset), Vector3.new(0.5, 1.08, 1.08), Color3.fromRGB(24, 26, 25), vehicle)
		wheel.StormEnabled = false
		vehicleJoint(name .. " Wheel Mount", chassis, wheel, vehicle)
	end

	local anchor = Instance.new("Part")
	anchor.Name = name .. " Tie Down"
	anchor.CFrame = frame * CFrame.new(0, 0.35, 0)
	anchor.Size = Vector3.new(0.4, 0.4, 0.4)
	anchor.Anchored = true
	anchor.Visible = false
	anchor.Parent = vehicle
	local tieDown = vehicleJoint(name .. " Storm Tie Down", anchor, chassis, vehicle)
	tieDown.StormBreakForce = 4300
	tieDown.StormMaterialStrength = 0.88
	tieDown.StormDamageRate = 1.35
end

-- This follows the reference's 160 metre deterministic scenery cells. At most
-- nine cells are retained, so scenery stays bounded as the translating storm
-- crosses the prairie. Every cell has nine mixed objects and selected cells
-- carry a complete wind-releasable chase vehicle.
local environment = Instance.new("Folder")
environment.Name = "Tornado Environment Cells"
environment.Parent = workspace
local loadedCells: { [string]: Folder } = {}
local retainedCells: { { Cell: Folder, RetireAt: number } } = {}
local environmentCellSize = 160
local environmentRadius = 2
local retainedCellLimit = 8
local retainedCellSeconds = 45.0

local function environmentKey(cellX: number, cellZ: number): string
	return cellX .. ":" .. cellZ
end

local function environmentalPart(name: string, position: Vector3, size: Vector3, colour: Color3, parent: Instance): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Position = position
	part.Size = size
	part.Color = colour
	part.Anchored = true
	part.Parent = parent
	return part
end

local function weatherAttachedScenery(name: string, position: Vector3, size: Vector3, colour: Color3, breakForce: number, parent: Instance): Part
	local part = vehiclePart(name, CFrame.new(position), size, colour, parent)
	part.StormExposedArea = size.X * size.Y
	local anchor = environmentalPart(name .. " Anchor", position - Vector3.new(0, size.Y * 0.5, 0), Vector3.new(0.25, 0.25, 0.25), Color3.fromRGB(0, 0, 0), parent)
	anchor.Visible = false
	local link = vehicleJoint(name .. " Wind Link", anchor, part, parent)
	link.StormBreakForce = breakForce
	link.StormMaterialStrength = 0.72
	link.StormDamageRate = 1.2
	return part
end

local function appendEnvironmentCell(cellX: number, cellZ: number)
	local key = environmentKey(cellX, cellZ)
	if loadedCells[key] ~= nil then return end
	local cell = Instance.new("Folder")
	cell.Name = "Storm Cell " .. key
	cell.Parent = environment
	loadedCells[key] = cell
	local origin = Vector3.new(cellX * environmentCellSize, 0, cellZ * environmentCellSize + 95)
	for index = 0, 7 do
		local x = origin.X + ((index * 47 + cellZ * 19) % 130) - 65
		local z = origin.Z + ((index * 71 + cellX * 23) % 130) - 65
		if index % 3 == 0 then
			local tree = environmentalPart("Cell Tree " .. index, Vector3.new(x, 5.5, z), Vector3.new(1.05, 11, 1.05), Color3.fromRGB(67, 55, 36), cell)
			tree.StormRestFrame = tree.CFrame
			tree.StormMaximumBendRadians = 0.46
			tree.StormResponsePerSecond = 4.2
			tree.StormWindSpeedForMaximumBend = 78.0
		elseif index % 3 == 1 then
			weatherAttachedScenery("Cell Sign " .. index, Vector3.new(x, 2.1, z), Vector3.new(3.6, 1.8, 0.2), Color3.fromRGB(137, 87, 42), 980, cell)
		else
			weatherAttachedScenery("Cell Roof Panel " .. index, Vector3.new(x, 1.4, z), Vector3.new(4.4, 0.18, 2.8), Color3.fromRGB(85, 59, 44), 1650, cell)
		end
	end
	if math.abs(cellX * 17 + cellZ * 31) % 3 == 0 then
		chaseVehicle("Cell Chase Vehicle", origin + Vector3.new(-28, 1, 24), math.rad((cellX - cellZ) * 13), cell)
	else
		environmentalPart("Cell Windbreak", origin + Vector3.new(28, 1.2, -24), Vector3.new(7.5, 2.4, 0.3), Color3.fromRGB(91, 76, 52), cell)
	end
	local panel = vehiclePart("Cell Loose Roof Panel", CFrame.new(origin + Vector3.new(34, 2.0, -32)), Vector3.new(4.8, 0.16, 2.9), Color3.fromRGB(83, 57, 42), cell)
	panel.StormExposedArea = 13.9
	panel.StormForceScale = 0.9
	local panelAnchor = environmentalPart("Cell Roof Anchor", origin + Vector3.new(34, 0.45, -32), Vector3.new(0.25, 0.25, 0.25), Color3.fromRGB(0, 0, 0), cell)
	panelAnchor.Visible = false
	local panelLink = vehicleJoint("Cell Roof Wind Link", panelAnchor, panel, cell)
	panelLink.StormBreakForce = 1900
	panelLink.StormMaterialStrength = 0.65
	panelLink.StormDamageRate = 1.6
end

local function streamEnvironmentCells(position: Vector3)
	local centreX = math.floor(position.X / environmentCellSize)
	local centreZ = math.floor((position.Z - 95) / environmentCellSize)
	local wanted: { [string]: boolean } = {}
	for cellZ = centreZ - environmentRadius, centreZ + environmentRadius do
		for cellX = centreX - environmentRadius, centreX + environmentRadius do
			local key = environmentKey(cellX, cellZ)
			wanted[key] = true
			appendEnvironmentCell(cellX, cellZ)
		end
	end
	for key, cell in pairs(loadedCells) do
		if not wanted[key] then
			local released = false
			for _, descendant in ipairs(cell:GetDescendants()) do
				if descendant:IsA("WeldConstraint") and not descendant.Enabled then
					released = true
					break
				end
			end
			if released then
				cell.Parent = environment
				table.insert(retainedCells, { Cell = cell, RetireAt = os.clock() + retainedCellSeconds })
			else
				cell:Destroy()
			end
			loadedCells[key] = nil
		end
	end
end

local function cleanupRetainedCells(now: number)
	for index = #retainedCells, 1, -1 do
		local retained = retainedCells[index]
		if now >= retained.RetireAt or retained.Cell.Parent == nil then
			retained.Cell:Destroy()
			table.remove(retainedCells, index)
		end
	end
	while #retainedCells > retainedCellLimit do
		retainedCells[1].Cell:Destroy()
		table.remove(retainedCells, 1)
	end
end

local function resetEnvironment()
	for key, cell in pairs(loadedCells) do
		cell:Destroy()
		loadedCells[key] = nil
	end
	for _, retained in ipairs(retainedCells) do retained.Cell:Destroy() end
	retainedCells = {}
	local intercept = environment:FindFirstChild("Tornado Chase Intercept")
	if intercept then intercept:Destroy() end
	rebuildInteraction()
	rebuildAssemblies()
	chaseVehicle("Tornado Chase Intercept", Vector3.new(-84, 1, -54), math.rad(2), environment)
	streamEnvironmentCells(environmentObserverPosition)
end

resetEnvironment()
local environmentClock = 0.0
RunService.Heartbeat:Connect(function(delta: number)
	if environmentResetRequested then
		environmentResetRequested = false
		resetEnvironment()
	end
	environmentClock += delta
	if environmentClock < 0.75 then return end
	environmentClock = 0
	streamEnvironmentCells(environmentObserverPosition)
	cleanupRetainedCells(os.clock())
end)
]]></Source>
		<Source path="scripts/client/TornadoClient.client.luau"><![CDATA[--!strict
local StarterGui = game:GetService("StarterGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Controls = require(ReplicatedStorage.TornadoSim.StormControls)
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local UserInputService = game:GetService("UserInputService")
local controlEvent = ReplicatedStorage.TornadoControl

local function makePart(name: string, size: Vector3, position: Vector3, colour: Color3): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.Position = position
	part.Color = colour
	part.Parent = Workspace
	return part
end

local function makeVolume(name: string, position: Vector3, bounds: Vector3, density: number): Volume
	local volume = Instance.new("Volume")
	volume.Name = name
	volume.Position = position
	volume.Bounds = bounds
	volume.Shape = Enum.VolumeShape.Ellipsoid
	volume.Color = Color3.fromRGB(168, 178, 184)
	volume.Density = density
	volume.Extinction = 0.68
	volume.Falloff = 0.58
	volume.NoiseScale = 0.16
	volume.NoiseStrength = 0.86
	volume.Steps = 32
	volume.ShadowSteps = 12
	volume.Seed = #name * 41
	volume.Parent = Workspace
	return volume
end

-- A computed sky and a dark cloud deck keep the pale funnel visible. A black
