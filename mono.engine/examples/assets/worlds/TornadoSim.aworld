		rain.Lifetime = NumberRange.new(1.0, 1.5)
		rain.Speed = NumberRange.new(26, 37)
		rain.Acceleration = Vector3.new(8, -49, 3)
		rain.Size = NumberSequence.new(0.05, 0.025)
		rain.Squash = NumberSequence.new(-0.86, -0.95)
		rain.Transparency = NumberSequence.new(0.76, 0.98)
	end
end

camera = Instance.new("Camera")
camera.Name = "TornadoChaseCamera"
camera.FieldOfView = 57
camera.FarPlaneZ = 1500
-- Frame the mature EF3 column in the open space beside the control panel.
-- This closer eye preserves its full height at 960 by 540 while the offset
-- aim holds the funnel clear of the panel's right edge.
local cameraTarget = Vector3.new(240, 185, 95)
local cameraHome = Vector3.new(-255, 125, -285)
local cameraYaw = 0.0
local cameraPitch = 0.0
local cameraZoom = 1.0
local function cameraFrame(target: Vector3): CFrame
	local offset = cameraHome - cameraTarget
	local yawCosine, yawSine = math.cos(cameraYaw), math.sin(cameraYaw)
	local x = offset.X * yawCosine + offset.Z * yawSine
	local z = -offset.X * yawSine + offset.Z * yawCosine
	local pitchCosine, pitchSine = math.cos(cameraPitch), math.sin(cameraPitch)
	local eye = target + Vector3.new(x, offset.Y * pitchCosine - z * pitchSine,
		(offset.Y * pitchSine + z * pitchCosine)) / cameraZoom
	return CFrame.lookAt(eye, target)
end
camera.CFrame = cameraFrame(cameraTarget)
camera.Parent = Workspace
Workspace.CurrentCamera = camera

