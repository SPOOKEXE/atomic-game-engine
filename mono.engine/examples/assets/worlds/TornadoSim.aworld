local function building(name: string, x: number, z: number, width: number, depth: number, height: number, colour: Color3)
	makePart(name .. " Walls", Vector3.new(width, height, depth), Vector3.new(x, height * 0.5, z), colour)
	local roof = makePart(name .. " Roof", Vector3.new(width + 2, 1.5, depth + 2), Vector3.new(x, height + 0.75, z), Color3.fromRGB(68, 47, 39))
	makePart(name .. " Foundation", Vector3.new(width + 1, 0.8, depth + 1), Vector3.new(x, 0.4, z), Color3.fromRGB(70, 62, 50))
	makePart(name .. " Roof Ridge", Vector3.new(width * 0.72, 1.2, 1.0), Vector3.new(x, height + 1.75, z), Color3.fromRGB(55, 42, 37))
	for window = -1, 1, 2 do
		local pane = makePart(name .. " Window " .. window, Vector3.new(2.4, 2.6, 0.12), Vector3.new(x + window * width * 0.28, height * 0.57, z - depth * 0.505), Color3.fromRGB(116, 139, 146))
		pane.EmissiveStrength = 0.15
	end
end

