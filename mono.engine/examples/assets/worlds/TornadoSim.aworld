	for _, shelf in ipairs(cloudShelf) do shelf.Enabled = activeLayers ~= 1 end
	updateLayers()
	funnelOnlyControl.BackgroundColor3 = if activeLayers == 1 then Color3.fromRGB(27, 57, 66) else Color3.fromRGB(12, 22, 29)
end, 62)

