local function clamp(value: number, minimum: number, maximum: number): number
	return math.max(minimum, math.min(maximum, value))
end

local function formatValue(value: number): string
	if value % 1 == 0 then return string.format("%.0f", value) end
	return string.format("%.2f", value)
end

local parameterBoxes: { [string]: TextBox } = {}
local editingBox: TextBox? = nil
local panelClock = 0
local lastParameterEdit = -1000
local nextParameterSync = 0
local function commitParameter(parameter: any, box: TextBox)
	local requested = tonumber(box.Text)
	if requested == nil then
		box.Text = formatValue(Controls.default[parameter.Key])
		return
	end
	requested = clamp(requested, parameter.Min, parameter.Max)
	box.Text = formatValue(requested)
	lastParameterEdit = panelClock
	request({ kind = "parameters", values = { [parameter.Key] = requested } })
end

for index, parameter in ipairs(Controls.parameters) do
	local column = (index - 1) % 2
	local row = math.floor((index - 1) / 2)
	local x = 7 + column * 172
	local y = 227 + row * 27
	local label = Instance.new("TextLabel")
	label.Name = parameter.Key .. "Label"
	label.Size = UDim2.new(0, 76, 0, 22)
	label.Position = UDim2.new(0, x, 0, y)
	label.Text = parameter.Label
	label.TextSize = 10
	label.TextColor3 = Color3.fromRGB(178, 196, 204)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.BackgroundTransparency = 1
	label.Parent = panel

	local box = Instance.new("TextBox")
	box.Name = parameter.Key .. "Slider"
	box.Size = UDim2.new(0, 48, 0, 22)
	box.Position = UDim2.new(0, x + 76, 0, y)
	box.Text = formatValue(Controls.default[parameter.Key])
	box.TextSize = 11
	box.TextColor3 = Color3.fromRGB(227, 234, 239)
	box.BackgroundColor3 = Color3.fromRGB(12, 22, 29)
	box.BorderSizePixel = 0
	box.Parent = panel
	parameterBoxes[parameter.Key] = box
	box.Focused:Connect(function() editingBox = box end)
	box.FocusLost:Connect(function()
		editingBox = nil
		commitParameter(parameter, box)
	end)
	button("−", x + 127, y, function()
		local value = tonumber(box.Text) or Controls.default[parameter.Key]
		box.Text = formatValue(clamp(value - parameter.Step, parameter.Min, parameter.Max))
		commitParameter(parameter, box)
	end, 18)
	button("+", x + 147, y, function()
		local value = tonumber(box.Text) or Controls.default[parameter.Key]
		box.Text = formatValue(clamp(value + parameter.Step, parameter.Min, parameter.Max))
		commitParameter(parameter, box)
	end, 18)
end

