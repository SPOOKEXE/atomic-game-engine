local vectorPoints = {
	Vector3.new(-70, 15, 95), Vector3.new(-28, 15, 95), Vector3.new(0, 15, 95),
	Vector3.new(28, 15, 95), Vector3.new(70, 15, 95),
}
local arrows = { "→", "↗", "↑", "↖", "←", "↙", "↓", "↘" }
local elapsed = 0
local stormOffset = Vector3.zero
RunService.Heartbeat:Connect(function(delta: number)
	elapsed += delta
	panelClock += delta
	bindStormDamageScenery()
	for index = #damageScenery, 1, -1 do
		local scenery = damageScenery[index]
		-- A replicated source can disappear between frames. Keep every access to
		-- that old handle inside pcall, then let the next bind find its replacement.
		local readable, frame = pcall(function(): CFrame?
			if scenery.Source.Parent == nil or scenery.Decoration.Parent == nil then return nil end
			return scenery.Source.CFrame * scenery.LocalFrame
		end)
		if not readable or frame == nil then
			pcall(function() scenery.Decoration:Destroy() end)
			table.remove(damageScenery, index)
		else
			local placed = pcall(function() scenery.Decoration.CFrame = frame end)
			if not placed then table.remove(damageScenery, index) end
		end
	end
	if #damageScenery == 0 then damageSceneryBound = false end
	local snapshot = Storm.Snapshot()
	if snapshot.Parameters.TranslationVelocity then
		stormMotion = snapshot.Parameters.TranslationVelocity
	end
	if type(snapshot.Parameters.CounterClockwise) == "boolean" then
		counterClockwise = snapshot.Parameters.CounterClockwise
	end
	if snapshot.ElapsedSeconds > 0 and panelClock >= nextParameterSync then
		nextParameterSync = panelClock + 0.25
		if panelClock - lastParameterEdit >= 0.35 then
			for _, parameter in ipairs(Controls.parameters) do
				local box = parameterBoxes[parameter.Key]
				local value = snapshot.Parameters[parameter.Key]
				if box ~= editingBox and type(value) == "number" then
					local formatted = formatValue(value)
					if box.Text ~= formatted then box.Text = formatted end
				end
			end
		end
	end
	if snapshot.ElapsedSeconds < lastStormElapsed then
		resetLightning()
	end
	lastStormElapsed = snapshot.ElapsedSeconds
	-- A replica starts without the server resource. Keep the authored origin
	-- until its first fixed-step snapshot arrives, then move every local effect
	-- from the same value that drives gameplay and GPU cloud presentation.
	if snapshot.ElapsedSeconds > 0 then
		local nextOffset = snapshot.Position - stormOrigin
		if nextOffset.X ~= stormOffset.X or nextOffset.Y ~= stormOffset.Y or nextOffset.Z ~= stormOffset.Z then
			stormOffset = nextOffset
			for _, visual in ipairs(stormVisuals) do
				visual.Object.Position = visual.Origin + stormOffset
			end
	if not cameraOrbit and not cameraShake and not observerFollow then
				camera.CFrame = cameraFrame(cameraTarget + stormOffset)
			end
		end
	end
	if UserInputService:GetFocusedTextBox() == nil then
		local move = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += Vector3.new(0, 0, 1) end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then move += Vector3.new(0, 0, -1) end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then move += Vector3.new(-1, 0, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += Vector3.new(1, 0, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.Q) then move += Vector3.new(0, -1, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.E) then move += Vector3.new(0, 1, 0) end
		if move.Magnitude > 0 then
			local direction = move.Unit
			observerHumanoid.MoveDirection = direction
			observerPosition += direction * observerHumanoid.WalkSpeed * delta
			if direction.X ~= 0 or direction.Z ~= 0 then
				observerHeading = Vector3.new(direction.X, 0, direction.Z).Unit
			end
		else
			observerHumanoid.MoveDirection = Vector3.zero
		end
	end
	updateObserverVisual()
	updateStormAudio(snapshot, observerPosition)
	observerPublishElapsed += delta
	if observerPublishElapsed >= 0.5 then
		observerPublishElapsed = 0
		request({ kind = "observer", x = observerPosition.X, z = observerPosition.Z })
	end
	if cameraOrbit then
		local orbit = elapsed * 0.16
		local position = Vector3.new(math.cos(orbit) * 205, 72, 95 + math.sin(orbit) * 205) + stormOffset
		camera.CFrame = CFrame.lookAt(position, cameraTarget + stormOffset)
	elseif observerFollow then
		local eye = observerPosition - observerHeading * 15 + Vector3.new(0, 7, 0)
		camera.CFrame = CFrame.lookAt(eye, observerPosition + Vector3.new(0, 1.3, 0))
	elseif cameraShake then
		camera.CFrame = cameraFrame(cameraTarget + stormOffset)
	end
	if cameraShake then
		-- Sample at the observer's eye so the optional camera response grows with
		-- the same field and damage potential the reference program uses.
		local observerField = Storm.Sample(observerPosition + Vector3.new(0, 1, 0))
		local horizontalWind = Vector3.new(observerField.Velocity.X, 0, observerField.Velocity.Z).Magnitude
		local shake = clamp(horizontalWind / 115 + observerField.DamagePotential * 0.45, 0, 1)
		local phase = elapsed * (9 + horizontalWind * 0.035)
		local offset = Vector3.new(
			math.sin(phase * 1.7) * shake * 2.4,
			math.sin(phase * 2.31 + 1.2) * shake * 1.1,
			math.cos(phase * 1.13) * shake * 1.8
		)
		local yaw = math.sin(phase * 0.73) * shake * 0.018
		local pitch = math.sin(phase * 1.37) * shake * 0.012
		local roll = math.sin(phase * 0.91) * shake * 0.026
		camera.CFrame = camera.CFrame * CFrame.Angles(pitch, yaw, roll) + offset
	end
	if snapshot.Enabled and snapshot.ElapsedSeconds > 0 then
		while snapshot.ElapsedSeconds >= lightningNextStrike do
			strikeLightning(snapshot)
		end
		local lightningAge = snapshot.ElapsedSeconds - lightningStrikeTime
		local lightningIntensity = if lightningAge >= 0 and lightningAge < lightningDuration
			then (1 - lightningAge / lightningDuration) ^ 2 else 0
		setLightningVisible(lightningIntensity > 0, lightningIntensity)
		if lightningIntensity > 0 then
			lightningHost.Position = snapshot.Position + lightningTop
		end
	else
		setLightningVisible(false, 0)
	end
	local samplePoint = Vector3.new(0, 15, 30) + stormOffset
	local sample = Storm.Sample(samplePoint)
	local visibility = Storm.Visibility(samplePoint, 500)
	local damage = Storm.Damage(samplePoint)
	for index, point in ipairs(vectorPoints) do
		local field = Storm.Sample(point + stormOffset)
		local velocity = field.Velocity
		local angle = math.atan(velocity.Z, velocity.X)
		local arrow = arrows[(math.floor((angle + math.pi / 8) / (math.pi / 4)) % 8) + 1]
		vectorLabels[index].Text = string.format("%s %.0f / %.0f", arrow, velocity.Magnitude, velocity.Y)
	end
	readout.Text = string.format(
		"MATURE MULTI-CELL TORNADO\nWind %.0f / %.0f / %.0f m/s\nVisibility %.0f m   Damage %.2f\nGPU: 262K  524K  1M  2M  5M  10M  15M  20M  50M\nLayers: condensation, rain, dust\nField band %d",
		sample.Velocity.X, sample.Velocity.Y, sample.Velocity.Z,
		visibility.EffectiveDistance, damage.Potential, damage.Band
	)
end)
]]></Source>
	</Sources>
