		<Source path="scripts/shared/TornadoSim/StormControls.luau"><![CDATA[--!strict
-- Shared parameter and button definitions for the authoritative field and local panel.
local Controls = {}

Controls.presets = {
	"EF0", "EF1", "EF2", "EF3", "EF4", "EF5",
	"Q0", "Q1", "Q2", "Q3", "Q4", "Q5",
}

Controls.default = {
	Energy = 0.72,
	CoreRadius = 34,
	InfluenceRadius = 260,
	PeakTangentialSpeed = 92,
	PeakInflowSpeed = 34,
	PeakUpdraftSpeed = 58,
	PeakDowndraftSpeed = 32,
	SurfaceOutflowSpeed = 28,
	PressureDrop = 72,
	Humidity = 0.82,
	RainRate = 0.68,
	Turbulence = 13,
	GroundFriction = 0.28,
	DebrisDensity = 0.65,
	VortexTightness = 2.25,
	TopHeight = 360,
	UpperWind = Vector3.new(18, 0, -6),
	TranslationVelocity = Vector3.new(4, 0, 1.5),
	Position = Vector3.new(0, 0, 95),
	LifecycleEnabled = false,
	Enabled = true,
}

-- Bounds live beside the default so both clients give immediate feedback and
-- the authority can reject values that do not describe a usable field.
Controls.parameters = {
	{ Key = "Energy", Label = "Energy", Min = 0, Max = 1, Step = 0.02 },
	{ Key = "CoreRadius", Label = "Core radius", Min = 1, Max = 300, Step = 1 },
	{ Key = "InfluenceRadius", Label = "Influence", Min = 20, Max = 1200, Step = 10 },
	{ Key = "PeakTangentialSpeed", Label = "Tangential", Min = 0, Max = 220, Step = 5 },
	{ Key = "PeakInflowSpeed", Label = "Inflow", Min = 0, Max = 160, Step = 5 },
	{ Key = "PeakUpdraftSpeed", Label = "Updraft", Min = 0, Max = 180, Step = 5 },
	{ Key = "PeakDowndraftSpeed", Label = "Downdraft", Min = 0, Max = 160, Step = 5 },
	{ Key = "SurfaceOutflowSpeed", Label = "Outflow", Min = 0, Max = 140, Step = 5 },
	{ Key = "PressureDrop", Label = "Pressure", Min = 0, Max = 220, Step = 5 },
	{ Key = "Humidity", Label = "Humidity", Min = 0, Max = 1, Step = 0.02 },
	{ Key = "RainRate", Label = "Rain", Min = 0, Max = 2, Step = 0.05 },
	{ Key = "Turbulence", Label = "Turbulence", Min = 0, Max = 105, Step = 1 },
	{ Key = "GroundFriction", Label = "Ground drag", Min = 0, Max = 1, Step = 0.02 },
	{ Key = "DebrisDensity", Label = "Debris", Min = 0, Max = 1, Step = 0.02 },
	{ Key = "VortexTightness", Label = "Tightness", Min = 1, Max = 20, Step = 0.5 },
	{ Key = "TopHeight", Label = "Top height", Min = 60, Max = 1200, Step = 20 },
}

return Controls
]]></Source>
		<Source path="scripts/server/TornadoServer.server.luau"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Controls = require(ReplicatedStorage.TornadoSim.StormControls)
local Field = require(ReplicatedStorage.TornadoSim.StormField)
local controlEvent = ReplicatedStorage.TornadoControl
local Lighting = game:GetService("Lighting")

local stormAnchor = workspace:FindFirstChild("StormAnchor", true)
assert(stormAnchor ~= nil and stormAnchor:IsA("Part"), "TornadoSim needs its authored StormAnchor")
local state = Field.new(Controls.default, Controls.default.Position)
local particleField = workspace:FindFirstChild("TornadoParticles", true)
assert(particleField ~= nil, "TornadoSim needs its authored TornadoParticles field")
local visualField = particleField :: any

-- The original sparse world rows remain for simulation compatibility. Hide
-- their placeholder surfaces before constructing the visible scene, otherwise
-- the coplanar white terrain intermittently wins the depth test.
local authoredWorld = workspace:FindFirstChild("TornadoSimWorld")
if authoredWorld then
	local placeholderTerrain = authoredWorld:FindFirstChild("Terrain")
	if placeholderTerrain then placeholderTerrain.Visible = false end
	local placeholderTrees = authoredWorld:FindFirstChild("TreeLine")
	if placeholderTrees then placeholderTrees.Visible = false end
	local placeholderSign = authoredWorld:FindFirstChild("RoadSign")
	if placeholderSign then placeholderSign.Visible = false end
	local placeholderVehicle = authoredWorld:FindFirstChild("ChaseVehicle")
	if placeholderVehicle then placeholderVehicle.Visible = false end
	for _, name in ipairs({"Farmhouse", "Barn", "Workshop"}) do
		local structure = authoredWorld:FindFirstChild(name)
		local roof = if structure then structure:FindFirstChild("RoofPanel") else nil
		if roof then roof.Visible = false end
	end
end


local vectorField = Instance.new("VectorField3D")
vectorField.Name = "Tornado Vector Field"
vectorField.Position = state.Position
vectorField.Bounds = Vector3.new(state.Parameters.InfluenceRadius, state.Parameters.TopHeight, state.Parameters.InfluenceRadius)
vectorField.Axis = Vector3.yAxis
vectorField.LocalSpace = false
vectorField.Parent = workspace
visualField.Position = state.Position
visualField.Bounds = vectorField.Bounds
visualField.VelocityResponse = 1
visualField.Parent = vectorField

local function setVisualLayer(index: number, colour: Color3, alpha: number, size: number, acceleration: Vector3)
	assert(visualField:SetLayer(index, colour, alpha, size, acceleration), "TornadoSim particle layer was refused")
end

setVisualLayer(0, Color3.fromRGB(132, 135, 132), 0.12, 11.5, Vector3.zero)
setVisualLayer(1, Color3.fromRGB(41, 51, 56), 0.10, 0.30, Vector3.new(8, -49, 3))
setVisualLayer(2, Color3.fromRGB(56, 38, 23), 0.16, 0.8, Vector3.new(0, -4, 0))

local function particleSamples(): buffer
	local sampleCount = 8192
	local result = buffer.create(sampleCount * 32)
	local seed = math.max(math.floor(visualField.Seed), 1) % 2147483647
	local function random(): number
		seed = (seed * 16807) % 2147483647
		return (seed - 1) / 2147483646
	end
	for index = 0, sampleCount - 1 do
		local layer = if index % 8 < 5 then 0 elseif index % 8 < 7 then 1 else 2
		local angle = random() * math.pi * 2
		local radiusScale = if layer == 1 then 2.8 + random() * 2.0 else random() * 2.4
		local radius = radiusScale * state.Parameters.CoreRadius
		local height = if layer == 2 then random() * 24 else random() * state.Parameters.TopHeight
		local localPosition = Vector3.new(math.cos(angle) * radius, height, math.sin(angle) * radius)
		local worldPosition = state.Position + localPosition
		local velocity = Field.sample(state.Parameters, state.Position, worldPosition, state.ElapsedSeconds).Velocity
		local lifetime = if layer == 0 then 24 + random() * 18 elseif layer == 1 then 2 + random() * 4 else 1.8 + random() * 2.2
		local offset = index * 32
		buffer.writef32(result, offset, localPosition.X)
		buffer.writef32(result, offset + 4, localPosition.Y)
		buffer.writef32(result, offset + 8, localPosition.Z)
		buffer.writef32(result, offset + 12, lifetime)
		buffer.writef32(result, offset + 16, velocity.X)
		buffer.writef32(result, offset + 20, velocity.Y)
		buffer.writef32(result, offset + 24, velocity.Z)
		buffer.writeu32(result, offset + 28, layer)
	end
	return result
end

assert(visualField:SetSpawnSamples(particleSamples()), "TornadoSim spawn samples were refused")

local function updateVisualField()
	local p = state.Parameters
	local bounds = Vector3.new(p.InfluenceRadius, p.TopHeight, p.InfluenceRadius)
	stormAnchor.Position = state.Position
	vectorField.Position = state.Position
	if vectorField.Bounds ~= bounds then vectorField.Bounds = bounds end
	vectorField.Vector = p.TranslationVelocity + p.UpperWind
	vectorField.Radial = -p.PeakInflowSpeed
	vectorField.Tangential = (if p.CounterClockwise then 1 else -1) * p.PeakTangentialSpeed
	vectorField.Falloff = 0.18
	visualField.Position = state.Position
	if visualField.Bounds ~= bounds then visualField.Bounds = bounds end
end

local function installStormLighting()
	Lighting.ClockTime = 17.2
	Lighting.GeographicLatitude = 35
	Lighting.Brightness = 0.06
	Lighting.Ambient = Color3.fromRGB(10, 13, 15)
	Lighting.OutdoorAmbient = Color3.fromRGB(13, 15, 16)
	Lighting.BloomThreshold = 1.1
	Lighting.BloomIntensity = 0.45
	Lighting.BloomRadius = 6
	Lighting.GodRayIntensity = 0.16
	Lighting.GodRayThreshold = 1.1
	Lighting.GodRayRadius = 46
	local sky = Instance.new("SkyboxCompute")
	sky.Name = "Tornado Storm Sky"
	sky.Shader = Enum.SkyboxComputeShader.Night
	sky.SunSize = 0.01
	sky.Seed = 401
	sky.Parent = Lighting
	local atmosphere = Instance.new("AtmosphereProcedural")
	atmosphere.Name = "Tornado Storm Atmosphere"
	atmosphere.Shader = Enum.AtmosphereProceduralShader.Earth
	atmosphere.Color = Color3.fromRGB(27, 33, 38)
	atmosphere.Decay = Color3.fromRGB(7, 10, 12)
	atmosphere.Density = 0.12
	atmosphere.Haze = 1.1
	atmosphere.Glare = 0.04
	atmosphere.Samples = 16
	atmosphere.Parent = Lighting
	local clouds = Instance.new("CloudCompute")
	clouds.Name = "Tornado Anvil Cloud Deck"
	clouds.Shader = Enum.CloudComputeShader.Storm
	clouds.Color = Color3.fromRGB(27, 29, 28)
	clouds.Cover = 0.98
	clouds.Density = 0.98
	clouds.WindSpeed = 19
	clouds.WindDirection = Vector2.new(0.85, 0.34)
	clouds.CellSize = 0.19
	clouds.Detail = 0.9
	clouds.Height = 0.54
	clouds.Thickness = 0.58
	clouds.Steps = 32
	clouds.Seed = 957
	clouds.Parent = Lighting
end

installStormLighting()

local function publishState()
	stormAnchor:SetComponent("Tornado.State", Field.toComponent(state))
end

publishState()

local validPreset = {}
for _, preset in ipairs(Controls.presets) do validPreset[preset] = true end
local validParticleCount = {
	[262144] = true,
	[524288] = true,
	[1000000] = true,
	[1048576] = true,
	[2000000] = true,
	[5000000] = true,
	[10000000] = true,
	[15000000] = true,
	[20000000] = true,
	[50000000] = true,
}
local parameterBounds: { [string]: any } = {}
for _, parameter in ipairs(Controls.parameters) do
	parameterBounds[parameter.Key] = parameter
end
local particleField = workspace:FindFirstChild("TornadoParticles", true)
local environmentResetRequested = false
local environmentRefreshRequested = false
local environmentObserverPosition = Controls.default.Position

-- Authority applies validated requests from the in-game controls.
controlEvent.OnServerEvent:Connect(function(payload: string)
	local decoded, request = pcall(function() return HttpService:JSONDecode(payload) end)
	if not decoded then return end
	if type(request) ~= "table" then return end
	if request.kind == "preset" and type(request.name) == "string" and validPreset[request.name] then
		Field.preset(state, request.name)
	elseif request.kind == "custom" and type(request.energy) == "number" and type(request.radius) == "number"
		and request.energy >= 0 and request.energy <= 1 and request.radius >= 1 and request.radius <= 300 then
		Field.configure(state, { Energy = request.energy, CoreRadius = request.radius })
	elseif request.kind == "particles" and particleField ~= nil and type(request.count) == "number"
		and validParticleCount[request.count] then
		particleField.RequestedCount = request.count
	elseif request.kind == "layers" and particleField ~= nil and type(request.mask) == "number"
		and request.mask >= 0 and request.mask <= 7 and request.mask % 1 == 0 then
		visualField.Layers = request.mask
		local cloudDeck = Lighting:FindFirstChild("Tornado Anvil Cloud Deck")
		if cloudDeck then
			cloudDeck.Cover = if request.mask == 1 then 0 else 0.98
			cloudDeck.Density = if request.mask == 1 then 0 else 0.98
		end
		local rainOpacity = if type(request.rainOpacity) == "number" then math.clamp(request.rainOpacity, 0, 1) else 1
		local rainDensity = if type(request.rainDensity) == "number" then math.clamp(request.rainDensity, 0, 1) else 1
		setVisualLayer(1, Color3.fromRGB(41, 51, 56), 0.10 * rainOpacity * rainDensity, 0.30, Vector3.new(8, -49, 3))
	elseif request.kind == "environment" and type(request.value) == "boolean" then
		for _, object in ipairs(workspace:GetDescendants()) do
			if not object:IsA("Part") and not object:IsA("Volume") then continue end
			local name = object.Name
			local environmentObject = string.find(name, "Storm Prairie") or string.find(name, "Storm Chase Road")
				or string.find(name, "Road Mark") or string.find(name, "Prairie Grid") or string.find(name, "Farmhouse")
				or string.find(name, "Barn") or string.find(name, "Workshop") or string.find(name, "Hay Bale")
				or string.find(name, "Tree ") or string.find(name, "Fence ") or string.find(name, "Storm Cell")
				or string.find(name, "Cell ") or string.find(name, "Tornado Chase") or string.find(name, "StormInteraction")
				or string.find(name, "WoodenSign") or string.find(name, "SteelPanel") or string.find(name, "WindBentTree")
			if environmentObject then
				if object:IsA("Part") then object.Visible = request.value else (object :: Volume).Enabled = request.value end
			end
		end
	elseif request.kind == "motion" and type(request.x) == "number" and type(request.y) == "number"
		and type(request.z) == "number" and math.abs(request.x) <= 60 and math.abs(request.y) <= 60
		and math.abs(request.z) <= 60 then
		Field.configure(state, { TranslationVelocity = Vector3.new(request.x, request.y, request.z) })
	elseif request.kind == "rotation" and type(request.counterClockwise) == "boolean" then
		Field.configure(state, { CounterClockwise = request.counterClockwise })
	elseif request.kind == "parameters" and type(request.values) == "table" then
		local configuration: { [string]: number } = {}
		for name, value in pairs(request.values) do
			local bounds = parameterBounds[name]
			if bounds ~= nil and type(value) == "number" and value >= bounds.Min and value <= bounds.Max then
				configuration[name] = value
			end
		end
		if next(configuration) ~= nil then Field.configure(state, configuration) end
	elseif request.kind == "enabled" and type(request.value) == "boolean" then
		Field.configure(state, { Enabled = request.value })
	elseif request.kind == "reset" then
		Field.configure(state, { ElapsedSeconds = 0 })
		Field.configure(state, Controls.default)
		environmentResetRequested = true
	elseif request.kind == "observer" and type(request.x) == "number" and type(request.z) == "number"
		and math.abs(request.x) <= 4096 and math.abs(request.z) <= 4096 then
		environmentObserverPosition = Vector3.new(request.x, 0, request.z)
		environmentRefreshRequested = true
	elseif request.kind == "lifecycle" and type(request.value) == "boolean" then
		Field.configure(state, { LifecycleEnabled = request.value })
	end
	publishState()
end)

local interactionConnections: { RBXScriptConnection } = {}

local function interactionPart(name: string, position: Vector3, size: Vector3, colour: Color3, anchored: boolean, parent: Instance): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Position = position
	part.Size = size
	part.Color = colour
	part.Anchored = anchored
	part.Parent = parent
	return part
end

local function response(part: Part, area: number, drag: number, forceScale: number, enabled: boolean?)
	part:SetComponent("Tornado.Response", {
		Enabled = if enabled == nil then true else enabled,
		ExposedArea = area,
		DragCoefficient = drag,
		ForceScale = forceScale,
	})
end

local function linkDamage(joint: Instance, breakForce: number, strength: number, damageRate: number)
	joint:SetComponent("Tornado.Link", {
		Enabled = true,
		BreakForce = breakForce,
		MaterialStrength = strength,
		Integrity = 1.0,
		DamageRate = damageRate,
	})
end

local function vegetation(part: Part, maximumBend: number, responseRate: number, maximumWind: number)
	part:SetComponent("Tornado.Vegetation", {
		Enabled = true,
		RestFrame = part.CFrame,
		BendRadians = 0,
		BendDirectionRadians = 0,
		MaximumBendRadians = maximumBend,
		ResponsePerSecond = responseRate,
		WindSpeedForMaximumBend = maximumWind,
	})
end

local function rebuildInteraction()
	for _, connection in ipairs(interactionConnections) do connection:Disconnect() end
	interactionConnections = {}
	local old = workspace:FindFirstChild("StormInteraction")
	if old then old:Destroy() end
	local interaction = Instance.new("Folder")
	interaction.Name = "StormInteraction"
	interaction.Parent = workspace
	local mast = interactionPart("SteelMast", Vector3.new(-28, 5, -12), Vector3.new(0.7, 10, 0.7), Color3.fromRGB(46, 51, 56), true, interaction)
	local woodenSign = interactionPart("WoodenSign", Vector3.new(-25.3, 7, -12), Vector3.new(5, 2.8, 0.25), Color3.fromRGB(82, 46, 20), false, interaction)
	local steelPanel = interactionPart("SteelPanel", Vector3.new(-25.8, 3.5, -12), Vector3.new(3.2, 2.1, 0.2), Color3.fromRGB(87, 92, 94), false, interaction)
	local tree = interactionPart("WindBentTree", Vector3.new(13.630354, 7, -15.45179), Vector3.new(1.1, 14, 1.1), Color3.fromRGB(69, 51, 31), true, interaction)

	response(woodenSign, 12.0, 1.15, 1.0)
	response(steelPanel, 7.0, 1.05, 0.7)
	vegetation(tree, 0.52, 5.0, 72.0)

	local function stormLink(name: string, part: Part, breakForce: number, strength: number): WeldConstraint
		local link = Instance.new("WeldConstraint")
		link.Name = name
		link.Part0 = mast
		link.Part1 = part
		linkDamage(link, breakForce, strength, 1.0)
		link.Parent = interaction
		return link
	end

	local function retireWhenBroken(link: WeldConstraint, part: Part)
		local retired = false
		table.insert(interactionConnections, RunService.Heartbeat:Connect(function()
			if retired or link.Enabled then return end
			retired = true
			local damage = Field.damage(state, part.Position)
			Debris:AddItem(part, if damage.Potential > 0.5 then 5.0 else 10.0)
			Debris:AddItem(link, 10.0)
		end))
	end

	local woodLink = stormLink("Wood Sign Wind Link", woodenSign, 360.0, 0.55)
	local steelLink = stormLink("Steel Panel Wind Link", steelPanel, 640.0, 1.65)
	retireWhenBroken(woodLink, woodenSign)
	retireWhenBroken(steelLink, steelPanel)
end

-- Every assembly has an anchored foundation row. The physics weld pass selects
-- that row as its root while support links survive, then the same connected
-- component becomes dynamic when storm fatigue opens a path through it.
local material = {
	timber = { Colour = Color3.fromRGB(133, 87, 48), Strength = 0.72, BreakForce = 18500, DamageRate = 1.45 },
	masonry = { Colour = Color3.fromRGB(128, 126, 119), Strength = 1.05, BreakForce = 32500, DamageRate = 0.72 },
	steel = { Colour = Color3.fromRGB(104, 128, 145), Strength = 1.65, BreakForce = 42000, DamageRate = 0.38 },
	glass = { Colour = Color3.fromRGB(112, 178, 192), Strength = 0.42, BreakForce = 9000, DamageRate = 2.1 },
}

local assemblies = Instance.new("Folder")
assemblies.Name = "Storm Structure Assemblies"
assemblies.Parent = workspace

local function structuralPart(name: string, frame: CFrame, size: Vector3, profile: any, anchored: boolean, parent: Instance): Part
	local part = Instance.new("Part")
	part.Name = name
	part.CFrame = frame
	part.Size = size
	part.Color = profile.Colour
	part.Anchored = anchored
	response(part, size.X * size.Y, 1.08, 0.82)
	part.Parent = parent
	return part
end

local function stormJoint(name: string, first: Part, second: Part, profile: any, parent: Instance)
	local joint = Instance.new("WeldConstraint")
	joint.Name = name
	joint.Part0 = first
	joint.Part1 = second
	linkDamage(joint, profile.BreakForce, profile.Strength, profile.DamageRate)
	joint.Parent = parent
	return joint
end

local function assembly(name: string, origin: Vector3, yaw: number, columns: number, rows: number, depths: number, profile: any)
	local model = Instance.new("Folder")
	model.Name = name
	model.Parent = assemblies
	local parts: { [string]: Part } = {}
	local frame = CFrame.new(origin) * CFrame.Angles(0, yaw, 0)
	local function key(row: number, column: number, depth: number): string
		return row .. ":" .. column .. ":" .. depth
	end
	for row = 0, rows - 1 do
		for column = 0, columns - 1 do
			for depth = 0, depths - 1 do
				local localFrame = CFrame.new((column - (columns - 1) * 0.5) * 4.4, 1.65 + row * 3.3, (depth - (depths - 1) * 0.5) * 4.4)
				local outerFace = row > 0 and (column == 0 or column == columns - 1 or depth == 0 or depth == depths - 1)
				local memberProfile = outerFace and material.glass or profile
				parts[key(row, column, depth)] = structuralPart(name .. " Member " .. key(row, column, depth), frame * localFrame, Vector3.new(3.8, 2.9, 3.8), memberProfile, row == 0, model)
			end
		end
	end
	for row = 0, rows - 1 do
		for column = 0, columns - 1 do
			for depth = 0, depths - 1 do
				local current = parts[key(row, column, depth)]
				if row + 1 < rows then stormJoint(name .. " Vertical " .. key(row, column, depth), current, parts[key(row + 1, column, depth)], profile, model) end
				if column + 1 < columns then stormJoint(name .. " Cross " .. key(row, column, depth), current, parts[key(row, column + 1, depth)], profile, model) end
				if depth + 1 < depths then stormJoint(name .. " Depth " .. key(row, column, depth), current, parts[key(row, column, depth + 1)], profile, model) end
			end
		end
	end
end

local function rebuildAssemblies()
	for _, child in ipairs(assemblies:GetChildren()) do child:Destroy() end
	assembly("Timber Farmhouse", Vector3.new(-76, 0, 119), math.rad(24), 3, 3, 2, material.timber)
	assembly("Masonry Depot", Vector3.new(46, 0, 83), math.rad(-31), 4, 2, 3, material.masonry)
	assembly("Steel Workshop", Vector3.new(96, 0, 177), math.rad(47), 2, 4, 2, material.steel)
end

-- The vehicle body and every wheel are regular rigid parts. A single weak
-- tie-down uses StormLink, so the same fatigue pass that releases roof panels
-- turns a parked chase vehicle into a storm-driven physics assembly.
local function vehiclePart(name: string, frame: CFrame, size: Vector3, colour: Color3, parent: Instance): Part
	local part = Instance.new("Part")
	part.Name = name
	part.CFrame = frame
	part.Size = size
	part.Color = colour
	part.Anchored = false
	part.CanCollide = true
	response(part, size.X * size.Y, 1.04, 0.62)
	part.Parent = parent
	return part
end

local function vehicleJoint(name: string, first: Part, second: Part, parent: Instance): WeldConstraint
	local joint = Instance.new("WeldConstraint")
	joint.Name = name
	joint.Part0 = first
	joint.Part1 = second
	linkDamage(joint, 24000, 1.45, 0.5)
	joint.Parent = parent
	return joint
end

local function chaseVehicle(name: string, position: Vector3, yaw: number, parent: Instance)
	local vehicle = Instance.new("Folder")
	vehicle.Name = name
	vehicle.Parent = parent
	local frame = CFrame.new(position) * CFrame.Angles(0, yaw, 0)
	local chassis = vehiclePart(name .. " Chassis", frame * CFrame.new(0, 1.55, 0), Vector3.new(2.35, 0.65, 4.9), Color3.fromRGB(49, 62, 67), vehicle)
	response(chassis, 10.6, 1.04, 0.72)
	local cabin = vehiclePart(name .. " Cabin", frame * CFrame.new(0, 2.35, -0.28), Vector3.new(2.15, 1.12, 2.35), Color3.fromRGB(77, 92, 96), vehicle)
	response(cabin, 7.2, 1.04, 0.62)
	vehicleJoint(name .. " Cabin Mount", chassis, cabin, vehicle)
	for _, wheelOffset in ipairs({
		Vector3.new(-1.32, 0.75, -1.55), Vector3.new(1.32, 0.75, -1.55),
		Vector3.new(-1.32, 0.75, 1.55), Vector3.new(1.32, 0.75, 1.55),
	}) do
		local wheel = vehiclePart(name .. " Wheel", frame * CFrame.new(wheelOffset), Vector3.new(0.5, 1.08, 1.08), Color3.fromRGB(24, 26, 25), vehicle)
		response(wheel, 0, 1.04, 0.62, false)
		vehicleJoint(name .. " Wheel Mount", chassis, wheel, vehicle)
	end

	local anchor = Instance.new("Part")
	anchor.Name = name .. " Tie Down"
	anchor.CFrame = frame * CFrame.new(0, 0.35, 0)
	anchor.Size = Vector3.new(0.4, 0.4, 0.4)
	anchor.Anchored = true
	anchor.Visible = false
	anchor.Parent = vehicle
	local tieDown = vehicleJoint(name .. " Storm Tie Down", anchor, chassis, vehicle)
	linkDamage(tieDown, 4300, 0.88, 1.35)
end

-- This follows the reference's 160 metre deterministic scenery cells. At most
-- nine cells are retained, so scenery stays bounded as the translating storm
-- crosses the prairie. Every cell has nine mixed objects and selected cells
-- carry a complete wind-releasable chase vehicle.
local environment = Instance.new("Folder")
environment.Name = "Tornado Environment Cells"
environment.Parent = workspace
local loadedCells: { [string]: Folder } = {}
local retainedCells: { { Cell: Folder, RetireAt: number } } = {}
local environmentCellSize = 160
local environmentRadius = 2
local retainedCellLimit = 8
local retainedCellSeconds = 45.0
local environmentElapsed = 0.0

local function environmentKey(cellX: number, cellZ: number): string
	return cellX .. ":" .. cellZ
end

local function environmentalPart(name: string, position: Vector3, size: Vector3, colour: Color3, parent: Instance): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Position = position
	part.Size = size
	part.Color = colour
	part.Anchored = true
	part.Parent = parent
	return part
end

local function weatherAttachedScenery(name: string, position: Vector3, size: Vector3, colour: Color3, breakForce: number, parent: Instance): Part
	local part = vehiclePart(name, CFrame.new(position), size, colour, parent)
	response(part, size.X * size.Y, 1.04, 0.62)
	local anchor = environmentalPart(name .. " Anchor", position - Vector3.new(0, size.Y * 0.5, 0), Vector3.new(0.25, 0.25, 0.25), Color3.fromRGB(0, 0, 0), parent)
	anchor.Visible = false
	local link = vehicleJoint(name .. " Wind Link", anchor, part, parent)
	linkDamage(link, breakForce, 0.72, 1.2)
	return part
end

local function appendEnvironmentCell(cellX: number, cellZ: number)
	local key = environmentKey(cellX, cellZ)
	if loadedCells[key] ~= nil then return end
	local cell = Instance.new("Folder")
	cell.Name = "Storm Cell " .. key
	cell.Parent = environment
	loadedCells[key] = cell
	local origin = Vector3.new(cellX * environmentCellSize, 0, cellZ * environmentCellSize + 95)
	for index = 0, 7 do
		local x = origin.X + ((index * 47 + cellZ * 19) % 130) - 65
		local z = origin.Z + ((index * 71 + cellX * 23) % 130) - 65
		if index % 3 == 0 then
			local tree = environmentalPart("Cell Tree " .. index, Vector3.new(x, 5.5, z), Vector3.new(1.05, 11, 1.05), Color3.fromRGB(67, 55, 36), cell)
			vegetation(tree, 0.46, 4.2, 78.0)
		elseif index % 3 == 1 then
			weatherAttachedScenery("Cell Sign " .. index, Vector3.new(x, 2.1, z), Vector3.new(3.6, 1.8, 0.2), Color3.fromRGB(137, 87, 42), 980, cell)
		else
			weatherAttachedScenery("Cell Roof Panel " .. index, Vector3.new(x, 1.4, z), Vector3.new(4.4, 0.18, 2.8), Color3.fromRGB(85, 59, 44), 1650, cell)
		end
	end
	if math.abs(cellX * 17 + cellZ * 31) % 3 == 0 then
		chaseVehicle("Cell Chase Vehicle", origin + Vector3.new(-28, 1, 24), math.rad((cellX - cellZ) * 13), cell)
	else
		environmentalPart("Cell Windbreak", origin + Vector3.new(28, 1.2, -24), Vector3.new(7.5, 2.4, 0.3), Color3.fromRGB(91, 76, 52), cell)
	end
	local panel = vehiclePart("Cell Loose Roof Panel", CFrame.new(origin + Vector3.new(34, 2.0, -32)), Vector3.new(4.8, 0.16, 2.9), Color3.fromRGB(83, 57, 42), cell)
	response(panel, 13.9, 1.04, 0.9)
	local panelAnchor = environmentalPart("Cell Roof Anchor", origin + Vector3.new(34, 0.45, -32), Vector3.new(0.25, 0.25, 0.25), Color3.fromRGB(0, 0, 0), cell)
	panelAnchor.Visible = false
	local panelLink = vehicleJoint("Cell Roof Wind Link", panelAnchor, panel, cell)
	linkDamage(panelLink, 1900, 0.65, 1.6)
end

local function streamEnvironmentCells(position: Vector3)
	local centreX = math.floor(position.X / environmentCellSize)
	local centreZ = math.floor((position.Z - 95) / environmentCellSize)
	local wanted: { [string]: boolean } = {}
	for cellZ = centreZ - environmentRadius, centreZ + environmentRadius do
		for cellX = centreX - environmentRadius, centreX + environmentRadius do
			local key = environmentKey(cellX, cellZ)
			wanted[key] = true
			appendEnvironmentCell(cellX, cellZ)
		end
	end
	for key, cell in pairs(loadedCells) do
		if not wanted[key] then
			local released = false
			for _, descendant in ipairs(cell:GetDescendants()) do
				if descendant:IsA("WeldConstraint") and not descendant.Enabled then
					released = true
					break
				end
			end
			if released then
				cell.Parent = environment
				table.insert(retainedCells, { Cell = cell, RetireAt = environmentElapsed + retainedCellSeconds })
			else
				cell:Destroy()
			end
			loadedCells[key] = nil
		end
	end
end

local function cleanupRetainedCells(now: number)
	for index = #retainedCells, 1, -1 do
		local retained = retainedCells[index]
		if now >= retained.RetireAt or retained.Cell.Parent == nil then
			retained.Cell:Destroy()
			table.remove(retainedCells, index)
		end
	end
	while #retainedCells > retainedCellLimit do
		retainedCells[1].Cell:Destroy()
		table.remove(retainedCells, 1)
	end
end

local function resetEnvironment()
	for key, cell in pairs(loadedCells) do
		cell:Destroy()
		loadedCells[key] = nil
	end
	for _, retained in ipairs(retainedCells) do retained.Cell:Destroy() end
	retainedCells = {}
	local intercept = environment:FindFirstChild("Tornado Chase Intercept")
	if intercept then intercept:Destroy() end
	rebuildInteraction()
	rebuildAssemblies()
	chaseVehicle("Tornado Chase Intercept", Vector3.new(-84, 1, -54), math.rad(2), environment)
	streamEnvironmentCells(environmentObserverPosition)
end

resetEnvironment()
local environmentClock = 0.0
RunService.Heartbeat:Connect(function(delta: number)
	if environmentResetRequested then
		environmentResetRequested = false
		resetEnvironment()
	end
	environmentClock += delta
	environmentElapsed += delta
	if not environmentRefreshRequested and environmentClock < 0.75 then return end
	environmentRefreshRequested = false
	environmentClock = 0
	streamEnvironmentCells(environmentObserverPosition)
	cleanupRetainedCells(environmentElapsed)
end)

local function bodyArea(part: Part, response: any): number
	if response.ExposedArea > 0 then return response.ExposedArea end
	local size = part.Size
	return math.max(size.X * size.Y, size.X * size.Z, size.Y * size.Z)
end

local function quadraticDrag(sample: any, part: Part, response: any): Vector3
	if not response.Enabled or part.Anchored then return Vector3.zero end
	return Field.rawDragForce(
		sample.Velocity,
		part:GetLinearVelocity(),
		bodyArea(part, response),
		response.DragCoefficient,
		response.ForceScale
	)
end

local function dragForce(sample: any, part: Part, response: any, delta: number): Vector3
	if not response.Enabled or part.Anchored then return Vector3.zero end
	return Field.dragForce(
		sample.Velocity,
		part:GetLinearVelocity(),
		bodyArea(part, response),
		response.DragCoefficient,
		response.ForceScale,
		delta,
		part.Mass
	)
end

local function linkedLoad(part: Instance?): number
	if part == nil or not part:IsA("BasePart") then return 0 end
	local response = part:GetComponent("Tornado.Response")
	if response == nil then return 0 end
	local sample = Field.sample(state.Parameters, state.Position, part.Position, state.ElapsedSeconds)
	return quadraticDrag(sample, part, response).Magnitude
end

local function applyVegetation(delta: number)
	for _, part in ipairs(World:Query("Tornado.Vegetation")) do
		if not part:IsA("BasePart") or not part.Anchored then continue end
		local held = part:GetComponent("Tornado.Vegetation")
		if held == nil or not held.Enabled or held.MaximumBendRadians < 0 or held.ResponsePerSecond <= 0
			or held.WindSpeedForMaximumBend <= 0 then continue end
		local sample = Field.sample(state.Parameters, state.Position, part.Position, state.ElapsedSeconds)
		held.BendRadians, held.BendDirectionRadians = Field.vegetationStep(
			held.BendRadians,
			held.BendDirectionRadians,
			sample.Velocity,
			held.MaximumBendRadians,
			held.ResponsePerSecond,
			held.WindSpeedForMaximumBend,
			delta
		)
		local restUp = held.RestFrame:VectorToWorldSpace(Vector3.yAxis).Unit
		if restUp == Vector3.zero then continue end
		local direction = Vector3.new(math.cos(held.BendDirectionRadians), 0, math.sin(held.BendDirectionRadians))
		local targetUp = (restUp * math.cos(held.BendRadians) + direction * math.sin(held.BendRadians)).Unit
		local correction = CFrame.fromRotationBetweenVectors(restUp, targetUp)
		part.CFrame = CFrame.new(part.Position) * (correction * held.RestFrame.Rotation).Rotation
		part:SetComponent("Tornado.Vegetation", held)
	end
end

local function applyLinkDamage(delta: number)
	for _, joint in ipairs(World:Query("Tornado.Link")) do
		if not joint:IsA("JointInstance") and not joint:IsA("WeldConstraint") then continue end
		local link = joint:GetComponent("Tornado.Link")
		if link == nil or not link.Enabled or not joint.Enabled or link.BreakForce <= 0 or link.MaterialStrength <= 0
			or link.DamageRate < 0 then continue end
		local load = math.max(linkedLoad(joint.Part0), linkedLoad(joint.Part1))
		local broken = false
		link.Integrity, broken = Field.linkDamage(
			link.Integrity,
			load,
			link.BreakForce,
			link.MaterialStrength,
			link.DamageRate,
			delta,
			link.Enabled
		)
		if broken then
			joint.Enabled = false
			link.Enabled = false
		end
		joint:SetComponent("Tornado.Link", link)
	end
end

local function applyBodyForces(delta: number)
	for _, part in ipairs(World:Query("Tornado.Response")) do
		if not part:IsA("BasePart") then continue end
		local response = part:GetComponent("Tornado.Response")
		if response == nil or part.Anchored then continue end
		local force = Vector3.zero
		if state.Enabled then
			local sample = Field.sample(state.Parameters, state.Position, part.Position, state.ElapsedSeconds)
			force = dragForce(sample, part, response, delta)
		end
		part:SetAppliedForce(force)
	end
end

RunService.Heartbeat:Connect(function(delta: number)
	if state.Enabled then
		Field.advance(state, delta)
		applyVegetation(delta)
		applyLinkDamage(delta)
	end
	applyBodyForces(delta)
	updateVisualField()
	publishState()
end)
]]></Source>
		<Source path="scripts/client/TornadoClient.client.luau"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local STARTUP_WAIT_SECONDS = 20
local tornadoPackage = ReplicatedStorage:WaitForChild("TornadoSim", STARTUP_WAIT_SECONDS)
assert(tornadoPackage ~= nil and tornadoPackage:IsA("ModuleScript"), "TornadoSim needs its replicated modules")
local packageScript = tornadoPackage :: ModuleScript
local controlsSource = packageScript:WaitForChild("StormControls", STARTUP_WAIT_SECONDS)
assert(controlsSource ~= nil and controlsSource:IsA("ModuleScript"), "TornadoSim needs StormControls")
local fieldSource = packageScript:WaitForChild("StormField", STARTUP_WAIT_SECONDS)
assert(fieldSource ~= nil and fieldSource:IsA("ModuleScript"), "TornadoSim needs StormField")
local Controls = require(controlsSource :: ModuleScript)
local Field = require(fieldSource :: ModuleScript)
local controlEvent = ReplicatedStorage:WaitForChild("TornadoControl", STARTUP_WAIT_SECONDS)
assert(controlEvent ~= nil and controlEvent:IsA("RemoteEvent"), "TornadoSim needs its TornadoControl remote")
local tornadoWorld = Workspace:WaitForChild("TornadoSimWorld", STARTUP_WAIT_SECONDS)
assert(tornadoWorld ~= nil and tornadoWorld:IsA("Model"), "TornadoSim needs its replicated world model")
local stormAnchor = tornadoWorld:WaitForChild("StormAnchor", STARTUP_WAIT_SECONDS)
assert(stormAnchor ~= nil and stormAnchor:IsA("Part"), "TornadoSim needs its replicated StormAnchor")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local UserInputService = game:GetService("UserInputService")
local clientVisuals: { [Instance]: boolean } = {}

local function makePart(name: string, size: Vector3, position: Vector3, colour: Color3): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.Position = position
	part.Color = colour
	part.Parent = Workspace
	clientVisuals[part] = true
	return part
end

local function makeVolume(name: string, position: Vector3, bounds: Vector3, density: number): Volume
	local volume = Instance.new("Volume")
	volume.Name = name
	volume.Position = position
	volume.Bounds = bounds
	volume.Shape = Enum.VolumeShape.Ellipsoid
	volume.Color = Color3.fromRGB(168, 178, 184)
	volume.Density = density
	volume.Extinction = 0.68
	volume.Falloff = 0.58
	volume.NoiseScale = 0.16
	volume.NoiseStrength = 0.86
	volume.Steps = 32
	volume.ShadowSteps = 12
	volume.Seed = #name * 41
	volume.Parent = Workspace
	clientVisuals[volume] = true
	return volume
end

local ground = makePart("Storm Prairie", Vector3.new(1450, 3, 1450), Vector3.new(0, -2.0, 80), Color3.fromRGB(66, 59, 38))
local road = makePart("Storm Chase Road", Vector3.new(18, 0.18, 650), Vector3.new(-82, 0.1, 84), Color3.fromRGB(64, 61, 54))
for index = -14, 14 do
	makePart("Road Mark " .. index, Vector3.new(0.55, 0.04, 9), Vector3.new(-82, 0.22, 84 + index * 20), Color3.fromRGB(193, 169, 99))
end

-- A local humanoid-shaped observer gives the field a playable scale. It is a
-- camera proxy rather than an authority-owned character: moving it never
-- writes a second simulation body into the replicated storm world.
local observer = Instance.new("Model")
observer.Name = "Storm Field Observer"
observer.Parent = Workspace
local observerRoot = makePart("Observer Root", Vector3.new(0.7, 4.6, 0.7), Vector3.new(-114, 2.3, -92), Color3.fromRGB(255, 255, 255))
observerRoot.Visible = false
observerRoot.Parent = observer
local observerHumanoid = Instance.new("Humanoid")
observerHumanoid.Name = "Humanoid"
observerHumanoid.RootPart = observerRoot
observerHumanoid.WalkSpeed = 8
observerHumanoid.Parent = observer
local observerTorso = makePart("Observer Storm Jacket", Vector3.new(1.45, 2.15, 0.82), observerRoot.Position, Color3.fromRGB(39, 72, 91))
observerTorso.Parent = observer
local observerHead = makePart("Observer Head", Vector3.new(1.02, 1.02, 1.02), observerRoot.Position, Color3.fromRGB(201, 166, 122))
observerHead.Parent = observer
local observerPosition = observerRoot.Position
local observerHeading = Vector3.new(0, 0, 1)
local observerFollow = false
local observerPublishElapsed = 0.0

local function updateObserverVisual()
	observerRoot.Position = observerPosition
	observerTorso.CFrame = CFrame.lookAt(observerPosition + Vector3.new(0, 0.15, 0), observerPosition + observerHeading)
	observerHead.CFrame = CFrame.lookAt(observerPosition + Vector3.new(0, 1.65, 0), observerPosition + observerHeading)
end

UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if processed or input.KeyCode ~= Enum.KeyCode.F then return end
	observerFollow = not observerFollow
end)

-- The reference keeps a projected grid locked to the prairie. These thin
-- geometry lines give the same world scale without a per-frame projection pass.
for index = -12, 12 do
	local offset = index * 45
	local northSouth = makePart("Prairie Grid NS " .. index, Vector3.new(0.10, 0.025, 1080), Vector3.new(offset, -0.47, 95), Color3.fromRGB(94, 101, 73))
	northSouth.Transparency = 0.44
	local eastWest = makePart("Prairie Grid EW " .. index, Vector3.new(1080, 0.025, 0.10), Vector3.new(0, -0.47, 95 + offset), Color3.fromRGB(94, 101, 73))
	eastWest.Transparency = 0.44
end

local function building(name: string, x: number, z: number, width: number, depth: number, height: number, colour: Color3)
	makePart(name .. " Walls", Vector3.new(width, height, depth), Vector3.new(x, height * 0.5, z), colour)
	local roof = makePart(name .. " Roof", Vector3.new(width + 2, 1.5, depth + 2), Vector3.new(x, height + 0.75, z), Color3.fromRGB(68, 47, 39))
	makePart(name .. " Foundation", Vector3.new(width + 1, 0.8, depth + 1), Vector3.new(x, 0.4, z), Color3.fromRGB(70, 62, 50))
	makePart(name .. " Roof Ridge", Vector3.new(width * 0.72, 1.2, 1.0), Vector3.new(x, height + 1.75, z), Color3.fromRGB(55, 42, 37))
	for window = -1, 1, 2 do
		local pane = makePart(name .. " Window " .. window, Vector3.new(2.4, 2.6, 0.12), Vector3.new(x + window * width * 0.28, height * 0.57, z - depth * 0.505), Color3.fromRGB(116, 139, 146))
		pane.EmissiveStrength = 0.15
	end
end

building("Farmhouse", -80, 36, 24, 18, 12, Color3.fromRGB(111, 100, 82))
building("Barn", 52, 72, 36, 24, 17, Color3.fromRGB(117, 61, 44))
building("Workshop", 94, -12, 28, 20, 13, Color3.fromRGB(86, 88, 80))
for row = 0, 3 do
	for column = 0, 4 do
		local bale = makePart("Hay Bale " .. row .. "/" .. column, Vector3.new(3.5, 2.1, 3.5), Vector3.new(-8 + column * 7, 1.05, 10 + row * 8), Color3.fromRGB(133, 107, 51))
	end
end
for index = 0, 95 do
	-- This slot is the replicated WindBentTree. The authority owns its pose, so
	-- the local forest must leave the spot open instead of drawing a static twin.
	if index ~= 57 then
		local angle = index * 2.399
		local radius = 118 + (index % 9) * 15
		local x = math.cos(angle) * radius
		local z = 95 + math.sin(angle) * radius * 0.68
		local trunkHeight = 8 + index % 6
		makePart("Tree Trunk " .. index, Vector3.new(1.1, trunkHeight, 1.1), Vector3.new(x, trunkHeight * 0.5, z), Color3.fromRGB(70, 55, 37))
		local crownWidth = 7 + index % 5 * 2
		makePart("Tree Crown Low " .. index, Vector3.new(crownWidth, 5 + index % 3, crownWidth), Vector3.new(x, trunkHeight + 2.8, z), Color3.fromRGB(39, 66 + index % 4 * 6, 38))
		makePart("Tree Crown High " .. index, Vector3.new(crownWidth * 0.72, 4 + index % 3, crownWidth * 0.72), Vector3.new(x + (index % 3 - 1) * 0.9, trunkHeight + 6, z), Color3.fromRGB(42, 73 + index % 4 * 5, 40))
	end
end

type DamageScenery = {
	Source: Part,
	Decoration: Part,
	LocalFrame: CFrame,
}

-- The server parts are the simulation and replication source. These local
-- details deliberately follow their received CFrames instead of rebuilding a
-- second wind model on the client.
local damageScenery: { DamageScenery } = {}
local damageSceneryBound = false

local function attachDamageScenery(name: string, source: Part, size: Vector3, colour: Color3, localFrame: CFrame)
	local decoration = makePart(name, size, source.Position, colour)
	decoration.CFrame = source.CFrame * localFrame
	table.insert(damageScenery, { Source = source, Decoration = decoration, LocalFrame = localFrame })
end

local function bindStormDamageScenery()
	if damageSceneryBound then return end
	local interaction = Workspace:FindFirstChild("StormInteraction")
	if not interaction then return end
	local woodenSign = interaction:FindFirstChild("WoodenSign")
	local steelPanel = interaction:FindFirstChild("SteelPanel")
	local tree = interaction:FindFirstChild("WindBentTree")
	if not woodenSign or not woodenSign:IsA("Part") or not steelPanel or not steelPanel:IsA("Part") or not tree or
		not tree:IsA("Part") then
		return
	end

	damageSceneryBound = true
	attachDamageScenery("Wood Sign Face", woodenSign, Vector3.new(4.7, 2.45, 0.06), Color3.fromRGB(156, 97, 42), CFrame.new(0, 0, -0.16))
	attachDamageScenery("Steel Panel Stripe", steelPanel, Vector3.new(2.9, 0.26, 0.06), Color3.fromRGB(184, 159, 74), CFrame.new(0, 0, -0.14))
	attachDamageScenery("WindBentTree Crown Low", tree, Vector3.new(10, 5.8, 10), Color3.fromRGB(45, 82, 43), CFrame.new(0, 5.1, 0))
	attachDamageScenery("WindBentTree Crown High", tree, Vector3.new(7.2, 4.6, 7.2), Color3.fromRGB(49, 91, 45), CFrame.new(0.7, 8.7, 0))
end
for index = -9, 9 do
	local fenceZ = -58 + index * 12
	makePart("Fence Post " .. index, Vector3.new(0.5, 3.8, 0.5), Vector3.new(39, 1.9, fenceZ), Color3.fromRGB(85, 67, 45))
	makePart("Fence Rail " .. index, Vector3.new(0.35, 0.24, 12), Vector3.new(39, 2.4, fenceZ + 6), Color3.fromRGB(94, 72, 48))
end

-- Five local overlapping cells form a condensation funnel. The broad dirty
-- base and the upper anvil feed preserve the reference's multi-layer shape.
local stormOrigin = Vector3.new(0, 0, 95)
local stormVisuals: { { Object: any, Origin: Vector3, BaseDensity: number? } } = {}
local function followStorm(object: any, cloudDensity: boolean?)
	table.insert(stormVisuals, { Object = object, Origin = object.Position, BaseDensity = if cloudDensity then object.Density else nil })
end
local funnelVolumes = {
	makeVolume("Funnel Ground Spray", Vector3.new(0, 10, 95), Vector3.new(46, 12, 46), 0.10),
	makeVolume("Funnel Lower Condensation", Vector3.new(0, 38, 95), Vector3.new(38, 32, 38), 0.08),
	makeVolume("Funnel Mid Condensation", Vector3.new(0, 91, 95), Vector3.new(58, 50, 58), 0.065),
	makeVolume("Funnel Upper Condensation", Vector3.new(0, 166, 95), Vector3.new(84, 64, 84), 0.05),
	makeVolume("Funnel Anvil Feed", Vector3.new(0, 250, 95), Vector3.new(162, 34, 118), 0.035),
}
funnelVolumes[1].Color = Color3.fromRGB(170, 137, 92)
funnelVolumes[1].NoiseStrength = 1
funnelVolumes[2].Color = Color3.fromRGB(146, 139, 125)
funnelVolumes[3].Color = Color3.fromRGB(126, 124, 116)
funnelVolumes[4].Color = Color3.fromRGB(92, 99, 105)
funnelVolumes[5].Color = Color3.fromRGB(67, 76, 86)
funnelVolumes[5].Density = 0.055
for _, volume in ipairs(funnelVolumes) do followStorm(volume, true) end
local rainBank = makeVolume("Rain Curtain", Vector3.new(-34, 38, 44), Vector3.new(120, 46, 105), 0.035)
rainBank.Color = Color3.fromRGB(112, 129, 140)
rainBank.Falloff = 0.72
followStorm(rainBank, true)

-- A shallow stack makes the storm's wall cloud recede behind the funnel. The
-- distant layers use fewer march steps because they only establish silhouette.
local cloudShelf = {
	makeVolume("Wall Cloud Near", Vector3.new(-92, 187, 112), Vector3.new(210, 52, 135), 0.024),
	makeVolume("Wall Cloud West", Vector3.new(-205, 208, 61), Vector3.new(250, 64, 176), 0.021),
	makeVolume("Wall Cloud East", Vector3.new(182, 221, 141), Vector3.new(280, 70, 192), 0.019),
	makeVolume("Anvil Back Shelf", Vector3.new(28, 260, 246), Vector3.new(455, 54, 220), 0.017),
}
for index, shelf in ipairs(cloudShelf) do
	followStorm(shelf, true)
	shelf.Color = Color3.fromRGB(47 + index * 3, 53 + index * 3, 57 + index * 4)
	shelf.Falloff = 0.68
	shelf.NoiseScale = 0.22
	shelf.NoiseStrength = 0.94
	shelf.Steps = 20
	shelf.ShadowSteps = 6
end

local function emitter(name: string, host: Part, rate: number, colour: Color3): ParticleEmitter
	local effect = Instance.new("ParticleEmitter")
	effect.Name = name
	effect.Rate = rate
	effect.MaxParticles = 2400
	effect.Lifetime = NumberRange.new(1.8, 3.8)
	effect.Speed = NumberRange.new(3, 11)
	effect.Drag = 0.6
	effect.Shape = Enum.ParticleEmitterShape.Disc
	effect.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
	effect.ShapeInOut = Enum.ParticleEmitterShapeInOut.InAndOut
	effect.SpreadAngle = Vector2.new(35, 35)
	effect.Size = NumberSequence.new(0.35, 1.8)
	effect.Transparency = NumberSequence.new(0.18, 0.85)
	effect.Color = ColorSequence.new(colour)
	effect.NoiseStrength = 0.8
	effect.NoiseFrequency = 0.65
	effect.NoiseScrollSpeed = 1.2
	effect.SoftParticles = true
	effect.Parent = host
	return effect
end

local stormHost = makePart("Storm Cosmetic Host", Vector3.new(24, 3, 24), Vector3.new(0, 1, 95), Color3.new(1, 1, 1))
stormHost.Visible = false
followStorm(stormHost)

-- Each loop owns one perceptual layer from the reference mix. The engine
-- decodes ordinary published WAVs, which keeps the authored demo portable
-- while the future procedural audio graph receives the same control signals.
local function stormSound(name: string, soundId: string, volume: number, looped: boolean): Sound
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = soundId
	sound.Volume = volume
	sound.RollOffMinDistance = 48
	sound.RollOffMaxDistance = 740
	sound.Looped = looped
	sound.Playing = looped
	sound.Parent = stormHost
	return sound
end

local windBed = stormSound("Tornado Wind Bed", "audio/tornado-wind.wav", 0.28, true)
local circulationBed = stormSound("Tornado Low Circulation", "audio/tornado-circulation.wav", 0.23, true)
local rainBed = stormSound("Tornado Rain Sheet", "audio/tornado-rain.wav", 0.13, true)
local debrisBed = stormSound("Tornado Debris Rattle", "audio/tornado-debris.wav", 0.09, true)
local thunder = stormSound("Tornado Delayed Thunder", "audio/tornado-thunder.wav", 0.62, false)
local audioLayers = { windBed, circulationBed, rainBed, debrisBed }
local audioEnabled = true
local thunderRevision = 0

local function updateStormAudio(snapshot: any, observer: Vector3)
	local sample = Field.sample(snapshot.Parameters, snapshot.Position, observer, snapshot.ElapsedSeconds)
	local horizontalWind = Vector3.new(sample.Velocity.X, 0, sample.Velocity.Z).Magnitude
	local parameters = snapshot.Parameters
	local wind = math.clamp(horizontalWind / 105, 0, 1)
	local rain = math.clamp(parameters.RainRate * parameters.Humidity * (0.35 + sample.Influence), 0, 1)
	local debris = math.clamp(sample.DamagePotential * parameters.DebrisDensity * 0.45, 0, 1)
	local rumble = math.clamp(parameters.Energy * sample.Influence * (0.4 + horizontalWind / 140), 0, 1)
	windBed.Volume = 0.08 + wind * 0.34
	circulationBed.Volume = 0.05 + rumble * 0.31
	rainBed.Volume = 0.02 + rain * 0.22
	debrisBed.Volume = 0.01 + debris * 0.18
	local toStorm = snapshot.Position - observer
	local pan = math.clamp(toStorm.X / math.max(toStorm.Magnitude, 1), -1, 1)
	windBed.Pan = pan
	circulationBed.Pan = pan
	rainBed.Pan = pan
	debrisBed.Pan = pan
	thunder.Pan = pan
	for _, sound in ipairs(audioLayers) do sound.Playing = audioEnabled and snapshot.Enabled end
end

local function scheduleThunder(delay: number)
	local revision = thunderRevision
	task.delay(delay, function()
		if not audioEnabled or revision ~= thunderRevision then return end
		thunder.Playing = false
		thunder.Playing = true
	end)
end

-- The simulation seeds mt19937 with this value. This compact Park-Miller
-- sequence keeps the visual schedule reproducible without mutating Luau's
-- shared random generator.
local lightningSeed = 0x544F524E
local lightningNextStrike = 1.5
local lightningStrikeTime = -1000
local lightningDuration = 0.18
local lightningSerial = 0
local lightningTop = Vector3.zero
local lastStormElapsed = 0
local camera: Camera

local function lightningRandom(): number
	lightningSeed = (lightningSeed * 16807) % 2147483647
	return (lightningSeed - 1) / 2147483646
end

local function lightningRange(minimum: number, maximum: number): number
	return minimum + (maximum - minimum) * lightningRandom()
end

local lightningHost = makePart("Tornado Lightning Flash", Vector3.one, stormOrigin, Color3.new(1, 1, 1))
lightningHost.Visible = false
local lightningLight = Instance.new("PointLight")
lightningLight.Name = "Tornado Lightning Light"
lightningLight.Color = Color3.fromRGB(218, 232, 255)
lightningLight.Brightness = 0
lightningLight.Range = 0
lightningLight.Parent = lightningHost

local lightningPoints: { Attachment } = {}
for index = 0, 9 do
	local point = Instance.new("Attachment")
	point.Name = "Lightning Point " .. index
	point.Parent = lightningHost
	table.insert(lightningPoints, point)
end

local lightningBeams: { Beam } = {}
for index = 1, 9 do
	local beam = Instance.new("Beam")
	beam.Name = "Tornado Lightning Segment " .. index
	beam.Attachment0 = lightningPoints[index]
	beam.Attachment1 = lightningPoints[index + 1]
	beam.Width0 = 3.6
	beam.Width1 = 3.6
	beam.Color = ColorSequence.new(Color3.fromRGB(209, 225, 255))
	beam.Transparency = NumberSequence.new(1)
	beam.Additive = true
	beam.Enabled = false
	beam.Parent = lightningHost
	table.insert(lightningBeams, beam)
end

local lightningSparks = Instance.new("ParticleEmitter")
lightningSparks.Name = "Tornado Lightning Sparks"
lightningSparks.Rate = 120
lightningSparks.MaxParticles = 96
lightningSparks.Lifetime = NumberRange.new(0.16, 0.34)
lightningSparks.Speed = NumberRange.new(12, 26)
lightningSparks.SpreadAngle = Vector2.new(42, 42)
lightningSparks.Acceleration = Vector3.new(0, -34, 0)
lightningSparks.Size = NumberSequence.new(0.35, 0)
lightningSparks.Transparency = NumberSequence.new(0.05, 1)
lightningSparks.Color = ColorSequence.new(Color3.fromRGB(218, 232, 255))
lightningSparks.Additive = true
lightningSparks.LightEmission = 1
lightningSparks.TimeScale = 0
lightningSparks.Parent = lightningHost

local lightningEnabled = true
local function setLightningVisible(visible: boolean, intensity: number)
	visible = visible and lightningEnabled
	for _, beam in ipairs(lightningBeams) do
		beam.Enabled = visible
		beam.Transparency = NumberSequence.new(1 - intensity)
	end
	lightningLight.Brightness = if visible then 360 * intensity else 0
	lightningLight.Range = if visible then 220 * intensity else 0
	lightningSparks.TimeScale = if visible then intensity else 0
end

local function resetLightning()
	lightningSeed = 0x544F524E
	lightningNextStrike = 1.5
	lightningStrikeTime = -1000
	lightningDuration = 0.18
	lightningSerial = 0
	setLightningVisible(false, 0)
end

local function strikeLightning(snapshot: any)
	local parameters = snapshot.Parameters
	local angle = lightningRange(0, math.pi * 2)
	local radius = lightningRange(parameters.CoreRadius * 1.2, parameters.InfluenceRadius * 0.82)
	local height = parameters.TopHeight * 0.82
	lightningTop = Vector3.new(math.cos(angle) * radius, height, math.sin(angle) * radius)
	lightningHost.Position = snapshot.Position + lightningTop
	lightningDuration = lightningRange(0.12, 0.24)
	lightningStrikeTime = lightningNextStrike
	lightningSerial += 1

	for index, point in ipairs(lightningPoints) do
		local segment = index - 1
		local fraction = segment / 9
		point.CFrame = CFrame.new(Vector3.new(
			math.sin(segment * 8.73 + lightningSerial * 0.71) * 5,
			-height * fraction,
			math.cos(segment * 5.19 + lightningSerial * 0.43) * 3
		))
	end

	local moisture = math.max(0, math.min(1, parameters.Humidity * parameters.Energy))
	lightningNextStrike += lightningRange(1.2, 5.5) / math.max(0.25 + moisture, 0.25)
	scheduleThunder((lightningHost.Position - camera.CFrame.Position).Magnitude / 343)
end
local condensationEmitters: { ParticleEmitter } = {}
local rainEmitters: { ParticleEmitter } = {}
local debrisEmitters: { ParticleEmitter } = {}

local debris = emitter("Debris Skirt", stormHost, 64, Color3.fromRGB(96, 75, 54))
table.insert(debrisEmitters, debris)
debris.Shape = Enum.ParticleEmitterShape.Cylinder
debris.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
debris.Lifetime = NumberRange.new(2.8, 5.0)
debris.Size = NumberSequence.new(0.5, 1.7)
debris.Transparency = NumberSequence.new(0.76, 0.985)
debris.Acceleration = Vector3.new(0, 8, 0)

-- Dirt first slides inward across the field, then the existing field particles
-- loft it through the lower funnel. Several sparse sources read as one broad
-- skirt while keeping the cosmetic emitter count bounded.
for index = 0, 11 do
	local angle = index * math.pi * 2 / 12
	local radius = 46 + index % 3 * 9
	local x = math.cos(angle) * radius
	local z = 95 + math.sin(angle) * radius * 0.72
	local host = makePart("Ground Debris Host " .. index, Vector3.new(12, 1, 12), Vector3.new(x, 0.6, z), Color3.new(1, 1, 1))
	host.Visible = false
	followStorm(host)
	local dust = emitter("Ground Debris Inflow", host, 16, Color3.fromRGB(105, 78, 49))
	table.insert(debrisEmitters, dust)
	dust.MaxParticles = 480
	dust.Lifetime = NumberRange.new(2.2, 3.7)
	dust.Speed = NumberRange.new(3, 7)
	dust.Shape = Enum.ParticleEmitterShape.Cylinder
	dust.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	dust.Size = NumberSequence.new(0.45, 1.35)
	dust.Transparency = NumberSequence.new(0.82, 0.985)
	dust.Acceleration = Vector3.new(-x * 0.11, 5.5, -(z - 95) * 0.11)
end

-- Each source is a shallow volume rather than a point. Slow overlapping wisps
-- close the vertical seams, leaving a single taper instead of stacked puffs.
local function condensationLayer(name: string, height: number, radius: number, rate: number, colour: Color3)
	local host = makePart(name .. " Host", Vector3.new(radius * 2, radius * 1.2, radius * 2), Vector3.new(0, height, 95), Color3.new(1, 1, 1))
	host.Visible = false
	followStorm(host)
	local layer = emitter(name, host, rate, colour)
	layer.MaxParticles = 900
	layer.Shape = Enum.ParticleEmitterShape.Cylinder
	layer.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	layer.Lifetime = NumberRange.new(3.4, 5.4)
	layer.Speed = NumberRange.new(2, 6)
	layer.SpreadAngle = Vector2.new(48, 48)
	layer.Size = NumberSequence.new(radius * 0.14, radius * 0.28)
	layer.Transparency = NumberSequence.new(0.87, 0.985)
	layer.Acceleration = Vector3.new(0, 5, 0)
	return layer
end

for _, layer in ipairs({
	condensationLayer("Condensation Streamers", 7, 14, 120, Color3.fromRGB(51, 34, 21)),
	condensationLayer("Funnel Lower Wisps", 22, 20, 140, Color3.fromRGB(59, 45, 31)),
	condensationLayer("Funnel Lower Body", 43, 27, 150, Color3.fromRGB(64, 54, 41)),
	condensationLayer("Funnel Mid Wisps", 69, 35, 160, Color3.fromRGB(63, 60, 53)),
	condensationLayer("Funnel Mid Body", 101, 46, 140, Color3.fromRGB(57, 58, 55)),
	condensationLayer("Funnel Upper Wisps", 138, 60, 115, Color3.fromRGB(49, 51, 50)),
	condensationLayer("Funnel Anvil Wisps", 176, 82, 80, Color3.fromRGB(43, 45, 44)),
}) do table.insert(condensationEmitters, layer) end

for x = -2, 2 do
	for z = -2, 2 do
		local host = makePart("Rain Host " .. x .. "/" .. z, Vector3.one, Vector3.new(x * 34, 74, 55 + z * 34), Color3.new(1, 1, 1))
		host.Visible = false
		followStorm(host)
		local rain = emitter("Tornado Rain", host, 28, Color3.fromRGB(87, 112, 127))
		table.insert(rainEmitters, rain)
		rain.Lifetime = NumberRange.new(1.0, 1.5)
		rain.Speed = NumberRange.new(26, 37)
		rain.Acceleration = Vector3.new(8, -49, 3)
		rain.Size = NumberSequence.new(0.05, 0.025)
		rain.Squash = NumberSequence.new(-0.86, -0.95)
		rain.Transparency = NumberSequence.new(0.76, 0.98)
	end
end

local activeCamera = Workspace.CurrentCamera
assert(activeCamera ~= nil and activeCamera:IsA("Camera"), "TornadoSim needs the active client camera")
camera = activeCamera :: Camera
camera.CameraType = Enum.CameraType.Scriptable
camera.FieldOfView = 68
camera.FarPlaneZ = 1500
-- Frame the mature EF3 column beside the control panel. The lower aim and
-- wider lens match the reference orbit's horizon and funnel bounds at 1440 by
-- 900 while keeping the camera controls centered on the same storm target.
local cameraTarget = Vector3.new(240, 65, 95)
local cameraHome = Vector3.new(-255, 125, -285)
local cameraYaw = 0.0
local cameraPitch = 0.0
local cameraZoom = 1.0
local function cameraFrame(target: Vector3): CFrame
	local offset = cameraHome - cameraTarget
	local yawCosine, yawSine = math.cos(cameraYaw), math.sin(cameraYaw)
	local x = offset.X * yawCosine + offset.Z * yawSine
	local z = -offset.X * yawSine + offset.Z * yawCosine
	local pitchCosine, pitchSine = math.cos(cameraPitch), math.sin(cameraPitch)
	local eye = target + Vector3.new(x, offset.Y * pitchCosine - z * pitchSine,
		(offset.Y * pitchSine + z * pitchCosine)) / cameraZoom
	return CFrame.lookAt(eye, target)
end
camera.CFrame = cameraFrame(cameraTarget)

local function request(change: { [string]: any })
