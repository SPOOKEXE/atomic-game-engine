		<Source path="scripts/shared/TornadoSim/StormControls.luau"><![CDATA[--!strict
-- One controls vocabulary for the server's storm resource and the local panel.
local Controls = {}

Controls.presets = {
	"EF0", "EF1", "EF2", "EF3", "EF4", "EF5",
	"Q0", "Q1", "Q2", "Q3", "Q4", "Q5",
}

Controls.default = {
	Energy = 0.78,
	CoreRadius = 28,
	InfluenceRadius = 310,
	PeakTangentialSpeed = 122,
	PeakInflowSpeed = 38,
	PeakUpdraftSpeed = 64,
	PeakDowndraftSpeed = 28,
	SurfaceOutflowSpeed = 24,
	PressureDrop = 96,
	Humidity = 0.88,
	RainRate = 0.82,
	Turbulence = 0.34,
	GroundFriction = 0.22,
	DebrisDensity = 0.72,
	VortexTightness = 8,
	TopHeight = 430,
	UpperWind = Vector3.new(14, 0, 7),
	TranslationVelocity = Vector3.new(5, 0, 1.5),
	Position = Vector3.new(0, 0, 95),
	LifecycleEnabled = true,
	Enabled = true,
}

return Controls
]]></Source>
		<Source path="scripts/server/TornadoServer.server.luau"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Controls = require(ReplicatedStorage.TornadoSim.StormControls)

-- The fixed-step physics resource owns lifecycle and force application.
Storm.Configure(Controls.default)
Storm.Preset("EF3")
Storm.Configure(Controls.default)

local validPreset = {}
for _, preset in ipairs(Controls.presets) do validPreset[preset] = true end
local validParticleCount = {
	[262144] = true,
	[1048576] = true,
	[4194304] = true,
	[16777216] = true,
	[50000000] = true,
}
local particleField = workspace:FindFirstChild("TornadoParticles", true)

-- The cross-world bus carries a value copy, so a client can request a change
-- without ever writing the authority-owned storm resource itself.
MessagingService:SubscribeAsync("tornado.sim.control", function(message)
	local request = message :: any
	if type(request) ~= "table" then return end
	if request.kind == "preset" and type(request.name) == "string" and validPreset[request.name] then
		Storm.Preset(request.name)
	elseif request.kind == "custom" and type(request.energy) == "number" and type(request.radius) == "number"
		and request.energy >= 0 and request.energy <= 1 and request.radius >= 1 and request.radius <= 300 then
		Storm.Configure({ Energy = request.energy, CoreRadius = request.radius })
	elseif request.kind == "particles" and particleField ~= nil and type(request.count) == "number"
		and validParticleCount[request.count] then
		particleField.RequestedCount = request.count
	elseif request.kind == "enabled" and type(request.value) == "boolean" then
		Storm.Configure({ Enabled = request.value })
	elseif request.kind == "reset" then
		Storm.Configure(Controls.default)
	elseif request.kind == "lifecycle" and type(request.value) == "boolean" then
		Storm.Configure({ LifecycleEnabled = request.value })
	end
end)
]]></Source>
		<Source path="scripts/client/TornadoClient.client.luau"><![CDATA[--!strict
local StarterGui = game:GetService("StarterGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Controls = require(ReplicatedStorage.TornadoSim.StormControls)

local function request(change: { [string]: any })
	MessagingService:PublishAsync("tornado.sim.control", change)
end

local gui = Instance.new("ScreenGui")
gui.Name = "TornadoSimPanel"
gui.ResetOnSpawn = false
gui.Parent = StarterGui

local panel = Instance.new("Frame")
panel.Name = "StormControls"
panel.Size = UDim2.new(0, 340, 0, 510)
panel.Position = UDim2.new(0, 16, 0, 16)
panel.BackgroundColor3 = Color3.new(0, 0, 0)
panel.Parent = gui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -16, 0, 28)
title.Position = UDim2.new(0, 8, 0, 8)
title.Text = "TORNADOSIM  EF0-EF5  Q0-Q5  CUSTOM"
title.TextColor3 = Color3.new(1, 1, 1)
title.BackgroundTransparency = 1
title.Parent = panel

local function button(label: string, x: number, y: number, callback: () -> ())
	local control = Instance.new("TextButton")
	control.Name = label
	control.Size = UDim2.new(0, 48, 0, 26)
	control.Position = UDim2.new(0, x, 0, y)
	control.Text = label
	control.TextColor3 = Color3.new(1, 1, 1)
	control.BackgroundColor3 = Color3.new(0, 0, 0)
	control.Parent = panel
	control.MouseButton1Click:Connect(callback)
end

for index, preset in ipairs(Controls.presets) do
	local column = (index - 1) % 6
	local row = math.floor((index - 1) / 6)
	button(preset, 8 + column * 54, 48 + row * 30, function()
		request({ kind = "preset", name = preset })
	end)
end

button("PAUSE", 8, 120, function()
	request({ kind = "enabled", value = false })
end)
button("PLAY", 62, 120, function()
	request({ kind = "enabled", value = true })
end)
button("RESET", 116, 120, function()
	request({ kind = "reset" })
end)
button("LIFE", 170, 120, function()
	request({ kind = "lifecycle", value = true })
end)
button("LIFE OFF", 224, 120, function()
	request({ kind = "lifecycle", value = false })
end)

local counts = { 262144, 1048576, 4194304, 16777216, 50000000 }
for index, count in ipairs(counts) do
	button(string.format("P%.0fM", count / 1000000), 8 + (index - 1) * 64, 154, function()
		request({ kind = "particles", count = count })
	end)
end

local function input(label: string, text: string, x: number)
	local box = Instance.new("TextBox")
	box.Name = label
	box.Size = UDim2.new(0, 92, 0, 26)
	box.Position = UDim2.new(0, x, 0, 192)
	box.Text = text
	box.TextColor3 = Color3.new(1, 1, 1)
	box.BackgroundColor3 = Color3.new(0, 0, 0)
	box.Parent = panel
	return box
end

local energy = input("EnergySlider", "0.78", 8)
local radius = input("RadiusSlider", "28", 106)
button("CUSTOM", 204, 192, function()
	local requestedEnergy = tonumber(energy.Text)
	local requestedRadius = tonumber(radius.Text)
	if requestedEnergy ~= nil and requestedRadius ~= nil then
		request({ kind = "custom", energy = requestedEnergy, radius = requestedRadius })
	end
end)

local readout = Instance.new("TextLabel")
readout.Name = "FieldVectorInset"
readout.Size = UDim2.new(1, -16, 0, 180)
readout.Position = UDim2.new(0, 8, 0, 238)
readout.TextColor3 = Color3.new(1, 1, 1)
readout.BackgroundTransparency = 1
readout.Parent = panel

RunService.Heartbeat:Connect(function()
	local sample = Storm.Sample(Vector3.new(0, 15, 30))
	local visibility = Storm.Visibility(Vector3.new(0, 15, 30), 500)
	local damage = Storm.Damage(Vector3.new(0, 15, 30))
	readout.Text = string.format(
		"CUSTOM CONTROLS\nEnergy %.2f  Radius %.0f\nWind %.1f %.1f %.1f\nInfluence %.2f  Visibility %.0f\nDamage %.2f  Band %d\nGPU field: 262K 1M 4M 16M 50M\nLayers: funnel rain debris mist fog clouds atmosphere audio",
		Controls.default.Energy, Controls.default.CoreRadius,
		sample.Velocity.X, sample.Velocity.Y, sample.Velocity.Z,
		sample.Influence, visibility.EffectiveDistance, damage.Potential, damage.Band
	)
end)
]]></Source>
