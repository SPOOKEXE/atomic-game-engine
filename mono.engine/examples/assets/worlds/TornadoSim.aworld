local function button(label: string, x: number, y: number, callback: () -> (), width: number?): TextButton
	local control = Instance.new("TextButton")
	control.Name = label
	control.Size = UDim2.new(0, width or 37, 0, 22)
	control.Position = UDim2.new(0, x, 0, y)
	control.Text = label
	control.TextSize = 11
	control.TextColor3 = Color3.fromRGB(220, 229, 235)
	control.BackgroundColor3 = Color3.fromRGB(12, 22, 29)
	control.BorderSizePixel = 0
	control.Parent = panel
	control.Activated:Connect(callback)
	return control
end

