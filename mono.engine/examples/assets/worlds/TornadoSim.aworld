local function emitter(name: string, host: Part, rate: number, colour: Color3): ParticleEmitter
	local effect = Instance.new("ParticleEmitter")
	effect.Name = name
	effect.Rate = rate
	effect.MaxParticles = 2400
	effect.Lifetime = NumberRange.new(1.8, 3.8)
	effect.Speed = NumberRange.new(3, 11)
	effect.Drag = 0.6
	effect.Shape = Enum.ParticleEmitterShape.Disc
	effect.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
	effect.ShapeInOut = Enum.ParticleEmitterShapeInOut.InAndOut
	effect.SpreadAngle = Vector2.new(35, 35)
	effect.Size = NumberSequence.new(0.35, 1.8)
	effect.Transparency = NumberSequence.new(0.18, 0.85)
	effect.Color = ColorSequence.new(colour)
	effect.NoiseStrength = 0.8
	effect.NoiseFrequency = 0.65
	effect.NoiseScrollSpeed = 1.2
	effect.SoftParticles = true
	effect.Parent = host
	return effect
end

local stormHost = makePart("Storm Cosmetic Host", Vector3.new(24, 3, 24), Vector3.new(0, 1, 95), Color3.new(1, 1, 1))
stormHost.Visible = false
followStorm(stormHost)

-- Each loop owns one perceptual layer from the reference mix. The engine
-- decodes ordinary published WAVs, which keeps the authored demo portable
-- while the future procedural audio graph receives the same control signals.
local function stormSound(name: string, soundId: string, volume: number, looped: boolean): Sound
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = soundId
	sound.Volume = volume
	sound.RollOffMinDistance = 48
	sound.RollOffMaxDistance = 740
	sound.Looped = looped
	sound.Playing = looped
	sound.Parent = stormHost
	return sound
end

local windBed = stormSound("Tornado Wind Bed", "audio/tornado-wind.wav", 0.28, true)
local circulationBed = stormSound("Tornado Low Circulation", "audio/tornado-circulation.wav", 0.23, true)
local rainBed = stormSound("Tornado Rain Sheet", "audio/tornado-rain.wav", 0.13, true)
local debrisBed = stormSound("Tornado Debris Rattle", "audio/tornado-debris.wav", 0.09, true)
local thunder = stormSound("Tornado Delayed Thunder", "audio/tornado-thunder.wav", 0.62, false)
local audioLayers = { windBed, circulationBed, rainBed, debrisBed }
local audioEnabled = true
local thunderRevision = 0

local function updateStormAudio(snapshot: any, observer: Vector3)
	local sample = Storm.Sample(observer)
	local horizontalWind = Vector3.new(sample.Velocity.X, 0, sample.Velocity.Z).Magnitude
	local parameters = snapshot.Parameters
	local wind = math.clamp(horizontalWind / 105, 0, 1)
	local rain = math.clamp(parameters.RainRate * parameters.Humidity * (0.35 + sample.Influence), 0, 1)
	local debris = math.clamp(sample.DamagePotential * parameters.DebrisDensity * 0.45, 0, 1)
	local rumble = math.clamp(parameters.Energy * sample.Influence * (0.4 + horizontalWind / 140), 0, 1)
	windBed.Volume = 0.08 + wind * 0.34
	circulationBed.Volume = 0.05 + rumble * 0.31
	rainBed.Volume = 0.02 + rain * 0.22
	debrisBed.Volume = 0.01 + debris * 0.18
	local toStorm = snapshot.Position - observer
	local pan = math.clamp(toStorm.X / math.max(toStorm.Magnitude, 1), -1, 1)
	windBed.Pan = pan
	circulationBed.Pan = pan
	rainBed.Pan = pan
	debrisBed.Pan = pan
	thunder.Pan = pan
	for _, sound in ipairs(audioLayers) do sound.Playing = audioEnabled and snapshot.Enabled end
end

local function scheduleThunder(delay: number)
	local revision = thunderRevision
	task.delay(delay, function()
		if not audioEnabled or revision ~= thunderRevision then return end
		thunder.Playing = false
		thunder.Playing = true
	end)
end

-- The simulation seeds mt19937 with this value. This compact Park-Miller
-- sequence keeps the visual schedule reproducible without mutating Luau's
-- shared random generator.
local lightningSeed = 0x544F524E
local lightningNextStrike = 1.5
local lightningStrikeTime = -1000
local lightningDuration = 0.18
local lightningSerial = 0
local lightningTop = Vector3.zero
local lastStormElapsed = 0
local camera: Camera

local function lightningRandom(): number
	lightningSeed = (lightningSeed * 16807) % 2147483647
	return (lightningSeed - 1) / 2147483646
end

local function lightningRange(minimum: number, maximum: number): number
	return minimum + (maximum - minimum) * lightningRandom()
end

local lightningHost = makePart("Tornado Lightning Flash", Vector3.one, stormOrigin, Color3.new(1, 1, 1))
lightningHost.Visible = false
local lightningLight = Instance.new("PointLight")
lightningLight.Name = "Tornado Lightning Light"
lightningLight.Color = Color3.fromRGB(218, 232, 255)
lightningLight.Brightness = 0
lightningLight.Range = 0
lightningLight.Parent = lightningHost

local lightningPoints: { Attachment } = {}
for index = 0, 9 do
	local point = Instance.new("Attachment")
	point.Name = "Lightning Point " .. index
	point.Parent = lightningHost
	table.insert(lightningPoints, point)
end

local lightningBeams: { Beam } = {}
for index = 1, 9 do
	local beam = Instance.new("Beam")
	beam.Name = "Tornado Lightning Segment " .. index
	beam.Attachment0 = lightningPoints[index]
	beam.Attachment1 = lightningPoints[index + 1]
	beam.Width0 = 3.6
	beam.Width1 = 3.6
	beam.Color = ColorSequence.new(Color3.fromRGB(209, 225, 255))
	beam.Transparency = NumberSequence.new(1)
	beam.Additive = true
	beam.Enabled = false
	beam.Parent = lightningHost
	table.insert(lightningBeams, beam)
end

local lightningSparks = Instance.new("ParticleEmitter")
lightningSparks.Name = "Tornado Lightning Sparks"
lightningSparks.Rate = 120
lightningSparks.MaxParticles = 96
lightningSparks.Lifetime = NumberRange.new(0.16, 0.34)
lightningSparks.Speed = NumberRange.new(12, 26)
lightningSparks.SpreadAngle = Vector2.new(42, 42)
lightningSparks.Acceleration = Vector3.new(0, -34, 0)
lightningSparks.Size = NumberSequence.new(0.35, 0)
lightningSparks.Transparency = NumberSequence.new(0.05, 1)
lightningSparks.Color = ColorSequence.new(Color3.fromRGB(218, 232, 255))
lightningSparks.Additive = true
lightningSparks.LightEmission = 1
lightningSparks.TimeScale = 0
lightningSparks.Parent = lightningHost

local lightningEnabled = true
local function setLightningVisible(visible: boolean, intensity: number)
	visible = visible and lightningEnabled
	for _, beam in ipairs(lightningBeams) do
		beam.Enabled = visible
		beam.Transparency = NumberSequence.new(1 - intensity)
	end
	lightningLight.Brightness = if visible then 360 * intensity else 0
	lightningLight.Range = if visible then 220 * intensity else 0
	lightningSparks.TimeScale = if visible then intensity else 0
end

local function resetLightning()
	lightningSeed = 0x544F524E
	lightningNextStrike = 1.5
	lightningStrikeTime = -1000
	lightningDuration = 0.18
	lightningSerial = 0
	setLightningVisible(false, 0)
end

local function strikeLightning(snapshot: any)
	local parameters = snapshot.Parameters
	local angle = lightningRange(0, math.pi * 2)
	local radius = lightningRange(parameters.CoreRadius * 1.2, parameters.InfluenceRadius * 0.82)
	local height = parameters.TopHeight * 0.82
	lightningTop = Vector3.new(math.cos(angle) * radius, height, math.sin(angle) * radius)
	lightningHost.Position = snapshot.Position + lightningTop
	lightningDuration = lightningRange(0.12, 0.24)
	lightningStrikeTime = lightningNextStrike
	lightningSerial += 1

	for index, point in ipairs(lightningPoints) do
		local segment = index - 1
		local fraction = segment / 9
		point.CFrame = CFrame.new(Vector3.new(
			math.sin(segment * 8.73 + lightningSerial * 0.71) * 5,
			-height * fraction,
			math.cos(segment * 5.19 + lightningSerial * 0.43) * 3
		))
	end

	local moisture = math.max(0, math.min(1, parameters.Humidity * parameters.Energy))
	lightningNextStrike += lightningRange(1.2, 5.5) / math.max(0.25 + moisture, 0.25)
	scheduleThunder((lightningHost.Position - camera.CFrame.Position).Magnitude / 343)
end
local condensationEmitters: { ParticleEmitter } = {}
local rainEmitters: { ParticleEmitter } = {}
local debrisEmitters: { ParticleEmitter } = {}

local debris = emitter("Debris Skirt", stormHost, 64, Color3.fromRGB(96, 75, 54))
table.insert(debrisEmitters, debris)
debris.Shape = Enum.ParticleEmitterShape.Cylinder
debris.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
debris.Lifetime = NumberRange.new(2.8, 5.0)
debris.Size = NumberSequence.new(0.5, 1.7)
debris.Transparency = NumberSequence.new(0.76, 0.985)
debris.Acceleration = Vector3.new(0, 8, 0)

-- Dirt first slides inward across the field, then the existing field particles
-- loft it through the lower funnel. Several sparse sources read as one broad
-- skirt while keeping the cosmetic emitter count bounded.
for index = 0, 11 do
	local angle = index * math.pi * 2 / 12
	local radius = 46 + index % 3 * 9
	local x = math.cos(angle) * radius
	local z = 95 + math.sin(angle) * radius * 0.72
	local host = makePart("Ground Debris Host " .. index, Vector3.new(12, 1, 12), Vector3.new(x, 0.6, z), Color3.new(1, 1, 1))
	host.Visible = false
	followStorm(host)
	local dust = emitter("Ground Debris Inflow", host, 16, Color3.fromRGB(105, 78, 49))
	table.insert(debrisEmitters, dust)
	dust.MaxParticles = 480
	dust.Lifetime = NumberRange.new(2.2, 3.7)
	dust.Speed = NumberRange.new(3, 7)
	dust.Shape = Enum.ParticleEmitterShape.Cylinder
	dust.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	dust.Size = NumberSequence.new(0.45, 1.35)
	dust.Transparency = NumberSequence.new(0.82, 0.985)
	dust.Acceleration = Vector3.new(-x * 0.11, 5.5, -(z - 95) * 0.11)
end

-- Each source is a shallow volume rather than a point. Slow overlapping wisps
-- close the vertical seams, leaving a single taper instead of stacked puffs.
local function condensationLayer(name: string, height: number, radius: number, rate: number, colour: Color3)
	local host = makePart(name .. " Host", Vector3.new(radius * 2, radius * 1.2, radius * 2), Vector3.new(0, height, 95), Color3.new(1, 1, 1))
	host.Visible = false
	followStorm(host)
	local layer = emitter(name, host, rate, colour)
	layer.MaxParticles = 900
	layer.Shape = Enum.ParticleEmitterShape.Cylinder
	layer.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	layer.Lifetime = NumberRange.new(3.4, 5.4)
	layer.Speed = NumberRange.new(2, 6)
	layer.SpreadAngle = Vector2.new(48, 48)
	layer.Size = NumberSequence.new(radius * 0.14, radius * 0.28)
	layer.Transparency = NumberSequence.new(0.87, 0.985)
	layer.Acceleration = Vector3.new(0, 5, 0)
	return layer
end

for _, layer in ipairs({
	condensationLayer("Condensation Streamers", 7, 14, 120, Color3.fromRGB(51, 34, 21)),
	condensationLayer("Funnel Lower Wisps", 22, 20, 140, Color3.fromRGB(59, 45, 31)),
	condensationLayer("Funnel Lower Body", 43, 27, 150, Color3.fromRGB(64, 54, 41)),
	condensationLayer("Funnel Mid Wisps", 69, 35, 160, Color3.fromRGB(63, 60, 53)),
	condensationLayer("Funnel Mid Body", 101, 46, 140, Color3.fromRGB(57, 58, 55)),
	condensationLayer("Funnel Upper Wisps", 138, 60, 115, Color3.fromRGB(49, 51, 50)),
	condensationLayer("Funnel Anvil Wisps", 176, 82, 80, Color3.fromRGB(43, 45, 44)),
}) do table.insert(condensationEmitters, layer) end

-- Layers is a field mask. Preserve condensation with rain and debris: omitting
-- bit one leaves only a thin spray column, even with a million GPU particles.
