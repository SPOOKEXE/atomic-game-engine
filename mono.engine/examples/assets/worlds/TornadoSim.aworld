local activeLayers = 7
local layerButtons: { [number]: TextButton } = {}
local rainOpacity = 1.0
local rainDensity = 1.0
local emitterRates: { [ParticleEmitter]: number } = {}
local function layerActive(mask: number, bit: number): boolean
	return mask % (bit * 2) >= bit
end
local function setEmitterLayer(emitters: { ParticleEmitter }, enabled: boolean, scale: number)
	for _, effect in ipairs(emitters) do
		effect.Enabled = enabled
		effect.Rate = enabled and emitterRates[effect] * scale or 0
	end
end
local function updateLayers()
	request({ kind = "layers", mask = activeLayers })
	for bit, control in pairs(layerButtons) do
		local enabled = layerActive(activeLayers, bit)
		control.BackgroundColor3 = if enabled then Color3.fromRGB(27, 57, 66) else Color3.fromRGB(12, 22, 29)
	end
	setEmitterLayer(condensationEmitters, layerActive(activeLayers, 1), 1)
	setEmitterLayer(rainEmitters, layerActive(activeLayers, 2), rainDensity)
	setEmitterLayer(debrisEmitters, layerActive(activeLayers, 4), 1)
	visualField.RainAlpha = 0.10 * rainOpacity * rainDensity
end


for index, layer in ipairs({ { 1, "COND" }, { 2, "RAIN" }, { 4, "DUST" } }) do
	local bit = layer[1] :: number
	local label = layer[2] :: string
	layerButtons[bit] = button(label, 7 + (index - 1) * 69, 174, function()
		if activeLayers % (bit * 2) >= bit then
			activeLayers -= bit
		else
			activeLayers += bit
		end
		updateLayers()
	end, 64)
end

for _, emitters in ipairs({ condensationEmitters, rainEmitters, debrisEmitters }) do
	for _, effect in ipairs(emitters) do emitterRates[effect] = effect.Rate end
end
