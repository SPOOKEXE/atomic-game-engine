<?xml version="1.0" encoding="utf-8"?>
<World format="3" name="Composer-3D-Reference">
 <Sources>
  <Source path="scripts/server/Composer-3D-Reference.server.luau"><![CDATA[local function panel(name, x)
 local p = Instance.new("MeshPart")
 p.Name = name
 p.Anchored = true
 p.Size = Vector3.new(4, 4, 0.2)
 p.Position = Vector3.new(x, 3, 0)
 p.Parent = workspace
 return p
end
local function bind(sink, graph, output, texture, linear)
 sink.ImageGraph = graph
 sink.ImageGraphOutput = output
 sink.ImageGraphTexture = texture
 sink.ImageGraphSeed = 7291
 sink.ImageGraphTickPolicy = "world"
 sink.ImageGraphColorSpace = if linear then "linear" else "display"
end
local floor = Instance.new("Part")
floor.Name = "Floor"
floor.Anchored = true
floor.Size = Vector3.new(30, 1, 20)
floor.Position = Vector3.new(0, -0.5, 0)
floor.Color = Color3.new(0.025, 0.025, 0.025)
floor.Parent = workspace
local transformed = panel("SourceCameraColour", -7)
transformed.TextureID = "composer-camera-rendered"
bind(transformed, "Composer-3D-Reference", "rendered", "composer-camera-rendered", false)
local depth = panel("LinearDepth", -2)
depth.TextureID = "composer-camera-depth"
bind(depth, "Composer-3D-Reference", "depth", "composer-camera-depth", true)
local normal = panel("SourceCameraNormal", 8)
normal.TextureID = "composer-camera-normal"
bind(normal, "Composer-3D-Reference", "normal", "composer-camera-normal", true)
for index, output in ipairs({"diffuse", "view_normal", "shadow", "ambient_occlusion"}) do
 local diagnostic = panel("Camera-" .. output, -7 + (index - 1) * 5)
 diagnostic.Position = Vector3.new(-7 + (index - 1) * 5, 8, 0)
 diagnostic.TextureID = "composer-camera-" .. output
 bind(diagnostic, "Composer-3D-Reference", output, diagnostic.TextureID, true)
end
local transformed = panel("TransformedImagePlane", -7)
transformed.Position = Vector3.new(-7, 13, 0)
transformed.TextureID = "composer-transformed"
bind(transformed, "Composer-3D-Reference", "transform", "composer-transformed", false)
local ray = panel("SourceRaymarchComposition", 3)
ray.TextureID = "composer-raymarch"
bind(ray, "Composer-3D-Reference", "raymarch", "composer-raymarch", false)
local glass = Instance.new("MeshPart")
glass.Name = "TransmissionReference"
glass.MeshId = "Sphere"
glass.Size = Vector3.new(3, 3, 3)
glass.Position = Vector3.new(3, 3, 2)
glass.Anchored = true
glass.Color = Color3.new(0.8, 0.95, 1)
glass.TransmissionFactor = 0.9
glass.IndexOfRefraction = 1.5
glass.Thickness = 0.5
glass.Parent = workspace
]]></Source>
  <Source path="scripts/client/Composer-3D-Reference.client.luau"><![CDATA[local camera = Instance.new("Camera")
camera.Name = "ComposerCamera"
camera.CFrame = CFrame.lookAt(Vector3.new(0, 7, 28), Vector3.new(0, 7, 0))
camera.FieldOfView = 55
camera.Parent = workspace
workspace.CurrentCamera = camera
]]></Source>
 </Sources>
 <Item class="Workspace" name="Workspace" id="1" />
 <Item class="ServerScriptService" name="ServerScriptService" id="2">
  <Item class="Script" name="ComposerScene" id="3"><Property name="Source" type="string">scripts/server/Composer-3D-Reference.server.luau</Property></Item>
 </Item>
 <Item class="StarterPlayer" name="StarterPlayer" id="4">
  <Item class="StarterPlayerScripts" name="StarterPlayerScripts" id="5">
   <Item class="LocalScript" name="ComposerCamera" id="6"><Property name="Source" type="string">scripts/client/Composer-3D-Reference.client.luau</Property></Item>
  </Item>
 </Item>
</World>
