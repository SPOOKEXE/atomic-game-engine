<?xml version="1.0" encoding="utf-8"?>
<World format="3" name="Composer-Particle-Flipbook">
 <Sources>
  <Source path="scripts/server/Composer-Particle-Flipbook.server.luau"><![CDATA[local function panel(name, x)
 local p = Instance.new("MeshPart")
 p.Name = name
 p.Anchored = true
 p.Size = Vector3.new(4, 4, 0.2)
 p.Position = Vector3.new(x, 3, 0)
 p.Parent = workspace
 return p
end
local function bind(sink, graph, output, texture, linear)
 sink.ImageGraph = graph
 sink.ImageGraphOutput = output
 sink.ImageGraphTexture = texture
 sink.ImageGraphSeed = 7291
 sink.ImageGraphTickPolicy = "world"
 sink.ImageGraphColorSpace = if linear then "linear" else "display"
end
local floor = Instance.new("Part")
floor.Name = "Floor"
floor.Anchored = true
floor.Size = Vector3.new(30, 1, 20)
floor.Position = Vector3.new(0, -0.5, 0)
floor.Color = Color3.new(0.025, 0.025, 0.025)
floor.Parent = workspace
local RunService = game:GetService("RunService")
local host = panel("FireHost", -4)
local mover = panel("SparkTrailHost", 4)
local fire = Instance.new("ParticleEmitter")
fire.Name = "Fire"
fire.Texture = "composer-fire"
fire.FlipbookLayout = Enum.ParticleFlipbookLayout.Grid2x2
fire.FlipbookMode = Enum.ParticleFlipbookMode.Loop
fire.FlipbookFrames = 4
fire.FlipbookFramerate = NumberRange.new(12, 12)
fire.Rate = 18
fire.Lifetime = NumberRange.new(1, 2)
fire.Speed = NumberRange.new(1, 2)
fire.Size = NumberSequence.new(1.3)
fire.Parent = host
bind(fire, "Composer-Particle-Flipbook", "fire", "composer-fire", false)
local spark = Instance.new("ParticleEmitter")
spark.Name = "Sparks"
spark.Texture = "composer-spark"
spark.FlipbookLayout = Enum.ParticleFlipbookLayout.Grid2x2
spark.FlipbookMode = Enum.ParticleFlipbookMode.OneShot
spark.FlipbookFrames = 4
spark.FlipbookFramerate = NumberRange.new(12, 12)
spark.Rate = 30
spark.Lifetime = NumberRange.new(0.5, 1.5)
spark.Speed = NumberRange.new(2, 5)
spark.Size = NumberSequence.new(0.4)
spark.Parent = mover
bind(spark, "Composer-Particle-Flipbook", "spark", "composer-spark", false)
local from = Instance.new("Attachment")
from.Parent = host
local to = Instance.new("Attachment")
to.Parent = mover
local beam = Instance.new("Beam")
beam.Name = "LiveFireBeam"
beam.Attachment0 = from
beam.Attachment1 = to
beam.Texture = "composer-fire"
beam.Width0 = 0.5
beam.Width1 = 0.5
beam.Parent = host
local upper = Instance.new("Attachment")
upper.CFrame = CFrame.new(0, 1, 0)
upper.Parent = mover
local trail = Instance.new("Trail")
trail.Name = "LiveSparkTrail"
trail.Attachment0 = to
trail.Attachment1 = upper
trail.Texture = "composer-spark"
trail.Lifetime = 1
trail.Parent = mover
local retired = false
RunService.Heartbeat:Connect(function()
 if elapsedTime() >= 10 and not retired then
  retired = true
  beam:Destroy()
  mover:Destroy()
 end
 if retired then return end
 mover.Position = Vector3.new(4, 3 + math.sin(elapsedTime() * 2), math.cos(elapsedTime() * 2) * 2)
end)
]]></Source>
  <Source path="scripts/client/Composer-Particle-Flipbook.client.luau"><![CDATA[local camera = Instance.new("Camera")
camera.Name = "ComposerCamera"
camera.CFrame = CFrame.lookAt(Vector3.new(0, 5, 18), Vector3.new(0, 3, 0))
camera.FieldOfView = 55
camera.Parent = workspace
workspace.CurrentCamera = camera
]]></Source>
 </Sources>
 <Item class="Workspace" name="Workspace" id="1" />
 <Item class="ServerScriptService" name="ServerScriptService" id="2">
  <Item class="Script" name="ComposerScene" id="3"><Property name="Source" type="string">scripts/server/Composer-Particle-Flipbook.server.luau</Property></Item>
 </Item>
 <Item class="StarterPlayer" name="StarterPlayer" id="4">
  <Item class="StarterPlayerScripts" name="StarterPlayerScripts" id="5">
   <Item class="LocalScript" name="ComposerCamera" id="6"><Property name="Source" type="string">scripts/client/Composer-Particle-Flipbook.client.luau</Property></Item>
  </Item>
 </Item>
</World>
