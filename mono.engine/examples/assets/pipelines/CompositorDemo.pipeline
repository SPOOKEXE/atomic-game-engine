renderpipeline 3
resource "shadow" depth D32F 0 0 1 yes auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "last-frame" colour RGBA8_SRGB 0 0 1 yes auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "mirror-views" colour RGBA16F 0 0 1 yes auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "portal-image" texture RGBA16F 0 0 1 yes auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "portal-light" texture RGBA16F 0 0 1 yes auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "world-entities" entities R8 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "view-camera" camera R8 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "view-entities" entities R8 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "visible-entities" entities R8 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "ordered-entities" entities R8 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "resident-meshes" buffer R8 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "environment-sky" storage RGBA16F 1024 512 1 no auto 1 1 1 0 1 auto auto 0 history "" 0
resource "environment-clouds" storage RGBA16F 1024 512 1 no auto 1 1 1 0 1 auto auto 0 history "" 0
resource "view-instances" buffer R8 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "lod-instances" buffer R8 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "albedo" colour RGBA8_SRGB 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "normal" colour RGB10A2 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "material" colour RGBA8 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "emissive" colour RGBA16F 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "depth" depth D24S8 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "linear-depth" colour R32F 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "occlusion" colour R8 0 0 2 yes auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "lit" colour RGBA16F 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "sky-lit" colour RGBA16F 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "volume-lit" colour RGBA16F 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "lens-b" colour RGBA16F 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "lens-scratch" colour RGBA16F 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "tonemapped" colour RGBA8_SRGB 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "portaled" colour RGBA16F 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "mirrored" colour RGBA16F 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "display" colour RGBA16F 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "scene-image" colour RGBA8_SRGB 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "interface-image" colour RGBA8_SRGB 0 0 1 yes auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "composed-image" colour RGBA8_SRGB 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
node "world" "world" world no
writes "world-entities" "entities"
node "mesh-residency" "mesh-residency" world no
writes "resident-meshes" "meshes"
node "shadow" "shadow" world no
reads "world-entities" "entities"
reads "resident-meshes" "meshes"
writes "shadow" "shadow"
node "skybox-compute" "skybox-compute" world no
writes "environment-sky" "sky"
node "clouds-compute" "clouds-compute" world no
reads "environment-sky" "sky"
writes "environment-clouds" "clouds"
node "camera" "camera" view no
writes "view-camera" "camera"
node "last-frame" "last-frame" view no
writes "last-frame" "image"
node "entities" "entities" view no
writes "view-entities" "entities"
node "cull-frustum" "cull-frustum" view no
reads "view-entities" "entities"
reads "view-camera" "camera"
writes "visible-entities" "entities"
node "order-draw" "order-draw" view no
reads "visible-entities" "entities"
reads "view-camera" "camera"
writes "ordered-entities" "entities"
node "delta-upload" "delta-upload" view no
reads "resident-meshes" "meshes"
reads "ordered-entities" "entities"
writes "view-instances" "instances"
node "select-lod" "select-lod" view no
reads "view-instances" "instances"
reads "view-camera" "camera"
writes "lod-instances" "instances"
node "surface-capture" "surface-capture" view no
reads "world-entities" "world-state"
reads "shadow" "shadow"
reads "ordered-entities" "entities"
reads "lod-instances" "instances"
writes "mirror-views" "surface"
writes "portal-image" "portal"
writes "portal-light" "light"
node "gbuffer" "gbuffer" view no
reads "shadow" "shadow"
reads "ordered-entities" "entities"
reads "lod-instances" "instances"
writes "albedo" "albedo"
writes "normal" "normal"
writes "material" "material"
writes "emissive" "emissive"
writes "depth" "depth"
node "depth-linearise" "depth-linearise" view no
reads "depth" "depth"
writes "linear-depth" "linear"
node "ssao" "ssao" view no
reads "linear-depth" "depth"
reads "normal" "normal"
writes "occlusion" "occlusion"
node "deferred-lighting" "deferred-lighting" view no
reads "albedo" "albedo"
reads "normal" "normal"
reads "material" "material"
reads "emissive" "emissive"
reads "linear-depth" "depth"
reads "occlusion" "occlusion"
reads "shadow" "shadow"
reads "portal-light" "portal-light"
writes "lit" "colour"
node "sky" "sky" view no
reads "lit" "colour"
reads "depth" "depth"
reads "environment-clouds" "environment"
writes "sky-lit" "colour"
node "fog" "fog" view no
reads "sky-lit" "colour"
reads "depth" "depth"
writes "volume-lit" "colour"
node "portal-overlay" "portal-overlay" view no
reads "volume-lit" "colour"
reads "depth" "depth"
reads "portal-image" "portal"
reads "ordered-entities" "entities"
reads "lod-instances" "instances"
writes "portaled" "colour"
node "mirror-overlay" "mirror-overlay" view no
reads "portaled" "colour"
reads "depth" "depth"
reads "mirror-views" "surface"
reads "ordered-entities" "entities"
reads "lod-instances" "instances"
writes "mirrored" "colour"
node "transparent" "transparent" view no
reads "mirrored" "colour"
reads "depth" "depth"
reads "ordered-entities" "entities"
reads "lod-instances" "instances"
writes "display" "colour"
node "shader-lenses" "shader-lenses" view no
reads "display" "colour"
reads "linear-depth" "depth"
writes "lens-b" "colour"
writes "lens-scratch" "scratch"
node "tonemap" "tonemap" view no
reads "lens-b" "colour"
writes "tonemapped" "colour"
node "present" "present" frame no
reads "tonemapped" "image"
writes "scene-image" "image"
node "interface" "interface" frame no
writes "interface-image" "image"
node "overlay" "overlay" frame no
reads "scene-image" "scene"
reads "interface-image" "interface"
writes "composed-image" "image"
node "output-image" "output-image" frame no
reads "composed-image" "image"
enable "tonemap" no
enable "present" no
enable "interface" no
enable "overlay" no
enable "output-image" no
resource "grade" colour RGBA16F 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "hsv-grade" colour RGBA16F 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "mixed" colour RGBA16F 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "transformed" colour RGBA16F 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "blur-horizontal" colour RGBA16F 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "blurred" colour RGBA16F 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "compositor-display" colour RGBA8_SRGB 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "compositor-scene" colour RGBA8_SRGB 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "compositor-interface" colour RGBA8_SRGB 0 0 1 yes auto 1 1 1 0 1 auto auto 0 transient "" 0
resource "compositor-output" colour RGBA8_SRGB 0 0 1 no auto 1 1 1 0 1 auto auto 0 transient "" 0
node "grade-exposure" "exposure-grade" view no
reads "lens-b" "source"
writes "grade" "colour"
set "exposure" "0.5"
set "contrast" "1.08"
set "pivot" "0.18"
set "gamma" "1"
node "grade-hsv" "hsv" view no
reads "grade" "source"
writes "hsv-grade" "colour"
set "hue" "8"
set "saturation" "1.1"
set "value" "1"
set "factor" "0.75"
node "mix-original" "mix" view no
reads "lens-b" "a"
reads "hsv-grade" "b"
writes "mixed" "colour"
set "operation" "screen"
set "factor" "0.2"
set "clamp" "zero"
node "frame-transform" "transform-crop" view no
reads "mixed" "source"
writes "transformed" "colour"
set "scale-x" "0.96"
set "scale-y" "0.96"
set "extend" "mirror"
node "blur-x" "blur" view no
reads "transformed" "source"
writes "blur-horizontal" "colour"
set "radius" "2"
set "sigma" "1.25"
set "angle" "0"
node "blur-y" "blur" view no
reads "blur-horizontal" "source"
writes "blurred" "colour"
set "radius" "2"
set "sigma" "1.25"
set "angle" "90"
node "compositor-tonemap" "tonemap" view no
reads "blurred" "colour"
writes "compositor-display" "colour"
node "compositor-present" "present" frame no
reads "compositor-display" "image"
writes "compositor-scene" "image"
node "compositor-interface-pass" "interface" frame no
writes "compositor-interface" "image"
node "compositor-overlay" "overlay" frame no
reads "compositor-scene" "scene"
reads "compositor-interface" "interface"
writes "compositor-output" "image"
node "compositor-output-image" "output-image" frame no
reads "compositor-output" "image"
