			},
	cheer = {
				{ id = "http://www.roblox.com/asset/?id=507770677", weight = 10 } 
			},
}

-- Existance in this list signifies that it is an emote, the value indicates if it is a looping emote
local emoteNames = { wave = false, point = false, dance = true, dance2 = true, dance3 = true, laugh = false, cheer = false}

-- Variables used in tracking if the character is using a ControllerManager.
-- This implementation assumes the common case of the ControllerManager being a
-- child of the character, and that only one ControllerManager exists under a given
-- character. If a ControllerManager is not placed under its associated character, 
-- then it will not be detected by this script.
-- The basis for this decision is performance: A ChildAdded listener on the
-- character is less of a performance hit than a ChildAdded listener on the
-- Workspace. And a FindFirstChild is more performant than checking for multiple
-- controllers via GetChildren.
local groundSensorChangedListener:RBXScriptSignal? = nil
local managerRootChangedListener:RBXScriptSignal? = nil
local managerParentChangedListener:RBXScriptSignal? = nil
local charGroundSensor:ControllerPartSensor? = nil
local charControllerManager:ControllerManager? = nil

-- Clean up listeners associated with the character's ControllerManager
function resetManagerListeners()
	if groundSensorChangedListener then
		groundSensorChangedListener:Disconnect()
		groundSensorChangedListener = nil
	end
	if managerRootChangedListener then
		managerRootChangedListener:Disconnect()
		managerRootChangedListener = nil
	end
	if managerParentChangedListener then
		managerParentChangedListener:Disconnect()
		managerParentChangedListener = nil
	end
end

-- Returns true if checkManager controls the character associated with this script
-- If so, then checkManager is assigned to charControllerManager.
function processIfManagerBelongsToCharacter(checkManager:ControllerManager):boolean
	if checkManager.RootPart == Character.PrimaryPart then
		if charControllerManager ~= checkManager then
			resetManagerListeners()
			charGroundSensor = checkManager.GroundSensor
			groundSensorChangedListener = checkManager:GetPropertyChangedSignal("GroundSensor"):Connect(function()
				if processIfManagerBelongsToCharacter(checkManager) then
					groundSensorChangedListener:Disconnect()
					groundSensorChangedListener = nil
				end
			end)
			managerRootChangedListener = checkManager:GetPropertyChangedSignal("RootPart"):Connect(function()
				if processIfManagerBelongsToCharacter(checkManager) then
					managerRootChangedListener:Disconnect()
					managerRootChangedListener = nil
				end
			end)
			managerParentChangedListener = checkManager.AncestryChanged:Connect(function(_, parent)
				if parent == nil then
					resetManagerListeners()
					lookForControllerManager()
				end
			end)
			charControllerManager = checkManager
		end
		return true
	end
	return false
end

-- Looks for the first ControllerManager directly childed to the character. If such 
-- a controller does not exist or if it does not control that character, then a listener
-- is set up to check if a controller is ever added.
function lookForControllerManager()
	charGroundSensor = nil
	charControllerManager = nil

	local child:ControllerManager? = Character:FindFirstChildOfClass("ControllerManager")
	if child then
		processIfManagerBelongsToCharacter(child)
	end
	-- The call to processIfManagerBelongsToCharacter above will have
	-- assigned charControllerManager on success
	if charControllerManager == nil then
		local managerAddedListener:RBXScriptSignal
		managerAddedListener = Character.ChildAdded:Connect(function(child)
			if child:IsA("ControllerManager") then
				if processIfManagerBelongsToCharacter(child) then
					managerAddedListener:Disconnect()
					managerAddedListener = nil
				end
			end
		end)
	end
end
lookForControllerManager()

math.randomseed(tick())

function findExistingAnimationInSet(set, anim)
	if set == nil or anim == nil then
		return 0
	end
	
	for idx = 1, set.count, 1 do 
		if set[idx].anim.AnimationId == anim.AnimationId then
			return idx
		end
	end
	
	return 0
end

function configureAnimationSet(name, fileList)
	if (animTable[name] ~= nil) then
		for _, connection in pairs(animTable[name].connections) do
			connection:disconnect()
		end
	end
	animTable[name] = {}
	animTable[name].count = 0
	animTable[name].totalWeight = 0	
	animTable[name].connections = {}

	local allowCustomAnimations = true

	local success, msg = pcall(function() allowCustomAnimations = game:GetService("StarterPlayer").AllowCustomAnimations end)
	if not success then
		allowCustomAnimations = true
	end

	-- check for config values
	local config = script:FindFirstChild(name)
	if (allowCustomAnimations and config ~= nil) then
		table.insert(animTable[name].connections, config.ChildAdded:connect(function(child) configureAnimationSet(name, fileList) end))
		table.insert(animTable[name].connections, config.ChildRemoved:connect(function(child) configureAnimationSet(name, fileList) end))
		
		local idx = 0
		for _, childPart in pairs(config:GetChildren()) do
			if (childPart:IsA("Animation")) then
				local newWeight = 1
				local weightObject = childPart:FindFirstChild("Weight")
				if (weightObject ~= nil) then
					newWeight = weightObject.Value
				end
				animTable[name].count = animTable[name].count + 1
				idx = animTable[name].count
				animTable[name][idx] = {}
				animTable[name][idx].anim = childPart
				animTable[name][idx].weight = newWeight
				animTable[name].totalWeight = animTable[name].totalWeight + animTable[name][idx].weight
				table.insert(animTable[name].connections, childPart.Changed:connect(function(property) configureAnimationSet(name, fileList) end))
				table.insert(animTable[name].connections, childPart.ChildAdded:connect(function(property) configureAnimationSet(name, fileList) end))
				table.insert(animTable[name].connections, childPart.ChildRemoved:connect(function(property) configureAnimationSet(name, fileList) end))
			end
		end
	end
	
	-- fallback to defaults
	if (animTable[name].count <= 0) then
		for idx, anim in pairs(fileList) do
			animTable[name][idx] = {}
			animTable[name][idx].anim = Instance.new("Animation")
			animTable[name][idx].anim.Name = name
			animTable[name][idx].anim.AnimationId = anim.id
			animTable[name][idx].weight = anim.weight
			animTable[name].count = animTable[name].count + 1
			animTable[name].totalWeight = animTable[name].totalWeight + anim.weight
		end
	end
	
	-- preload anims
	for i, animType in pairs(animTable) do
		for idx = 1, animType.count, 1 do
			if PreloadedAnims[animType[idx].anim.AnimationId] == nil then
				Humanoid:LoadAnimation(animType[idx].anim)
				PreloadedAnims[animType[idx].anim.AnimationId] = true
			end				
		end
	end
end

------------------------------------------------------------------------------------------------------------

function configureAnimationSetOld(name, fileList)
	if (animTable[name] ~= nil) then
		for _, connection in pairs(animTable[name].connections) do
			connection:disconnect()
		end
	end
	animTable[name] = {}
	animTable[name].count = 0
	animTable[name].totalWeight = 0	
	animTable[name].connections = {}

	local allowCustomAnimations = true

	local success, msg = pcall(function() allowCustomAnimations = game:GetService("StarterPlayer").AllowCustomAnimations end)
	if not success then
		allowCustomAnimations = true
	end

	-- check for config values
	local config = script:FindFirstChild(name)
	if (allowCustomAnimations and config ~= nil) then
		table.insert(animTable[name].connections, config.ChildAdded:connect(function(child) configureAnimationSet(name, fileList) end))
		table.insert(animTable[name].connections, config.ChildRemoved:connect(function(child) configureAnimationSet(name, fileList) end))
		local idx = 1
		for _, childPart in pairs(config:GetChildren()) do
			if (childPart:IsA("Animation")) then
				table.insert(animTable[name].connections, childPart.Changed:connect(function(property) configureAnimationSet(name, fileList) end))
				animTable[name][idx] = {}
				animTable[name][idx].anim = childPart
				local weightObject = childPart:FindFirstChild("Weight")
				if (weightObject == nil) then
					animTable[name][idx].weight = 1
				else
					animTable[name][idx].weight = weightObject.Value
				end
				animTable[name].count = animTable[name].count + 1
				animTable[name].totalWeight = animTable[name].totalWeight + animTable[name][idx].weight
				idx = idx + 1
			end
		end
	end

	-- fallback to defaults
	if (animTable[name].count <= 0) then
		for idx, anim in pairs(fileList) do
			animTable[name][idx] = {}
			animTable[name][idx].anim = Instance.new("Animation")
			animTable[name][idx].anim.Name = name
			animTable[name][idx].anim.AnimationId = anim.id
			animTable[name][idx].weight = anim.weight
			animTable[name].count = animTable[name].count + 1
			animTable[name].totalWeight = animTable[name].totalWeight + anim.weight
			-- print(name .. " [" .. idx .. "] " .. anim.id .. " (" .. anim.weight .. ")")
		end
	end
	
	-- preload anims
	for i, animType in pairs(animTable) do
		for idx = 1, animType.count, 1 do 
			Humanoid:LoadAnimation(animType[idx].anim)
		end
	end
end

-- Setup animation objects
function scriptChildModified(child)
	local fileList = animNames[child.Name]
	if (fileList ~= nil) then
		configureAnimationSet(child.Name, fileList)
	end	
end

script.ChildAdded:connect(scriptChildModified)
script.ChildRemoved:connect(scriptChildModified)

-- Clear any existing animation tracks
-- Fixes issue with characters that are moved in and out of the Workspace accumulating tracks
local animator = if Humanoid then Humanoid:FindFirstChildOfClass("Animator") else nil
if animator then
	local animTracks = animator:GetPlayingAnimationTracks()
	for i,track in ipairs(animTracks) do
		track:Stop(0)
		track:Destroy()
	end
end

for name, fileList in pairs(animNames) do 
	configureAnimationSet(name, fileList)
end	

-- ANIMATION

-- declarations
local toolAnim = "None"
local toolAnimTime = 0

local jumpAnimTime = 0
local jumpAnimDuration = 0.31

local toolTransitionTime = 0.1
local fallTransitionTime = 0.2

local currentlyPlayingEmote = false

-- functions

function stopAllAnimations()
	local oldAnim = currentAnim

	-- return to idle if finishing an emote
	if (emoteNames[oldAnim] ~= nil and emoteNames[oldAnim] == false) then
		oldAnim = "idle"
	end
	
	if currentlyPlayingEmote then
		oldAnim = "idle"
		currentlyPlayingEmote = false
	end

	currentAnim = ""
	currentAnimInstance = nil
	if (currentAnimKeyframeHandler ~= nil) then
		currentAnimKeyframeHandler:disconnect()
	end

	if (currentAnimTrack ~= nil) then
		currentAnimTrack:Stop()
		currentAnimTrack:Destroy()
		currentAnimTrack = nil
	end

	-- clean up walk if there is one
	if (runAnimKeyframeHandler ~= nil) then
		runAnimKeyframeHandler:disconnect()
	end
	
	if (runAnimTrack ~= nil) then
		runAnimTrack:Stop()
		runAnimTrack:Destroy()
		runAnimTrack = nil
	end
	
	return oldAnim
end

function getHeightScale()
	if Humanoid then
		if not Humanoid.AutomaticScalingEnabled then
			-- When auto scaling is not enabled, the rig scale stands in for
			-- a computed scale.
			return getRigScale()
		end
		
		local scale = Humanoid.HipHeight / HumanoidHipHeight
		if AnimationSpeedDampeningObject == nil then
			AnimationSpeedDampeningObject = script:FindFirstChild("ScaleDampeningPercent")
		end
		if AnimationSpeedDampeningObject ~= nil then
			scale = 1 + (Humanoid.HipHeight - HumanoidHipHeight) * AnimationSpeedDampeningObject.Value / HumanoidHipHeight
		end
		return scale
	end	
	return getRigScale()
end

local function rootMotionCompensation(speed)
	local speedScaled = speed * 1.25
	local heightScale = getHeightScale()
	local runSpeed = speedScaled / heightScale
	return runSpeed
end

local smallButNotZero = 0.0001
local function setRunSpeed(speed)
	local normalizedWalkSpeed = 0.5 -- established empirically using current `913402848` walk animation
	local normalizedRunSpeed  = 1
	local runSpeed = rootMotionCompensation(speed)

	local walkAnimationWeight = smallButNotZero
	local runAnimationWeight = smallButNotZero
	local timeWarp = 1

	if runSpeed <= normalizedWalkSpeed then
		walkAnimationWeight = 1
		timeWarp = runSpeed/normalizedWalkSpeed
	elseif runSpeed < normalizedRunSpeed then
		local fadeInRun = (runSpeed - normalizedWalkSpeed)/(normalizedRunSpeed - normalizedWalkSpeed)
		walkAnimationWeight = 1 - fadeInRun
		runAnimationWeight  = fadeInRun
	else
		timeWarp = runSpeed/normalizedRunSpeed
		runAnimationWeight = 1
	end
	currentAnimTrack:AdjustWeight(walkAnimationWeight)
	runAnimTrack:AdjustWeight(runAnimationWeight)
	currentAnimTrack:AdjustSpeed(timeWarp)
	runAnimTrack:AdjustSpeed(timeWarp)
end

function setAnimationSpeed(speed)
	if currentAnim == "walk" then
			setRunSpeed(speed)
	else
		if speed ~= currentAnimSpeed then
			currentAnimSpeed = speed
			currentAnimTrack:AdjustSpeed(currentAnimSpeed)
		end
	end
end

function keyFrameReachedFunc(frameName)
	if (frameName == "End") then
		if currentAnim == "walk" then
			if runAnimTrack.Looped ~= true then
				runAnimTrack.TimePosition = 0.0
			end
			if currentAnimTrack.Looped ~= true then
				currentAnimTrack.TimePosition = 0.0
			end
		else
			local repeatAnim = currentAnim
			-- return to idle if finishing an emote
			if (emoteNames[repeatAnim] ~= nil and emoteNames[repeatAnim] == false) then
				repeatAnim = "idle"
			end
			
			if currentlyPlayingEmote then
				if currentAnimTrack.Looped then
					-- Allow the emote to loop
					return
				end
				
				repeatAnim = "idle"
				currentlyPlayingEmote = false
			end
			
			local animSpeed = currentAnimSpeed
			playAnimation(repeatAnim, 0.15, Humanoid)
			setAnimationSpeed(animSpeed)
		end
	end
end

function rollAnimation(animName)
	local roll = math.random(1, animTable[animName].totalWeight) 
	local origRoll = roll
	local idx = 1
	while (roll > animTable[animName][idx].weight) do
		roll = roll - animTable[animName][idx].weight
		idx = idx + 1
	end
	return idx
end

local function switchToAnim(anim, animName, transitionTime, humanoid)
	-- switch animation		
	if (anim ~= currentAnimInstance) then
		
		if (currentAnimTrack ~= nil) then
			currentAnimTrack:Stop(transitionTime)
			currentAnimTrack:Destroy()
		end

		if (runAnimTrack ~= nil) then
			runAnimTrack:Stop(transitionTime)
			runAnimTrack:Destroy()
			runAnimTrack = nil
		end

		currentAnimSpeed = 1.0
	
		-- load it to the humanoid; get AnimationTrack
		currentAnimTrack = humanoid:LoadAnimation(anim)
		currentAnimTrack.Priority = Enum.AnimationPriority.Core
		 
		-- play the animation
		currentAnimTrack:Play(transitionTime)
		currentAnim = animName
		currentAnimInstance = anim

		-- set up keyframe name triggers
		if (currentAnimKeyframeHandler ~= nil) then
			currentAnimKeyframeHandler:disconnect()
		end
		currentAnimKeyframeHandler = currentAnimTrack.KeyframeReached:connect(keyFrameReachedFunc)
		
		-- check to see if we need to blend a walk/run animation
		if animName == "walk" then
			local runAnimName = "run"
			local runIdx = rollAnimation(runAnimName)

			runAnimTrack = humanoid:LoadAnimation(animTable[runAnimName][runIdx].anim)
			runAnimTrack.Priority = Enum.AnimationPriority.Core
			runAnimTrack:Play(transitionTime)		
			
			if (runAnimKeyframeHandler ~= nil) then
				runAnimKeyframeHandler:disconnect()
			end
			runAnimKeyframeHandler = runAnimTrack.KeyframeReached:connect(keyFrameReachedFunc)	
		end
	end
end

function playAnimation(animName, transitionTime, humanoid) 	
	local idx = rollAnimation(animName)
	local anim = animTable[animName][idx].anim

	switchToAnim(anim, animName, transitionTime, humanoid)
	currentlyPlayingEmote = false
end

function playEmote(emoteAnim, transitionTime, humanoid)
	switchToAnim(emoteAnim, emoteAnim.Name, transitionTime, humanoid)
	currentlyPlayingEmote = true
end

-------------------------------------------------------------------------------------------
-------------------------------------------------------------------------------------------

local toolAnimName = ""
local toolAnimTrack = nil
local toolAnimInstance = nil
local currentToolAnimKeyframeHandler = nil

function toolKeyFrameReachedFunc(frameName)
	if (frameName == "End") then
		playToolAnimation(toolAnimName, 0.0, Humanoid)
	end
end


function playToolAnimation(animName, transitionTime, humanoid, priority)	 		
		local idx = rollAnimation(animName)
		local anim = animTable[animName][idx].anim

		if (toolAnimInstance ~= anim) then
			
			if (toolAnimTrack ~= nil) then
				toolAnimTrack:Stop()
				toolAnimTrack:Destroy()
				transitionTime = 0
			end
					
			-- load it to the humanoid; get AnimationTrack
			toolAnimTrack = humanoid:LoadAnimation(anim)
			if priority then
				toolAnimTrack.Priority = priority
			end
			 
			-- play the animation
			toolAnimTrack:Play(transitionTime)
			toolAnimName = animName
			toolAnimInstance = anim

			currentToolAnimKeyframeHandler = toolAnimTrack.KeyframeReached:connect(toolKeyFrameReachedFunc)
		end
end

function stopToolAnimations()
	local oldAnim = toolAnimName

	if (currentToolAnimKeyframeHandler ~= nil) then
		currentToolAnimKeyframeHandler:disconnect()
	end

	toolAnimName = ""
	toolAnimInstance = nil
	if (toolAnimTrack ~= nil) then
		toolAnimTrack:Stop()
		toolAnimTrack:Destroy()
		toolAnimTrack = nil
	end

	return oldAnim
end

-------------------------------------------------------------------------------------------
-------------------------------------------------------------------------------------------
-- STATE CHANGE HANDLERS

function onRunning(speed)
	local heightScale = getHeightScale()
	
	-- Adjust the walking speed if a ControllerManager is being used.
	-- "speed" is world speed, whereas we want local speed. 
	-- IE, do not animate a walk if the character is stationary atop
	-- a moving platform.
	if charGroundSensor ~= nil and Humanoid.EvaluateStateMachine == false then
		local hrp = Humanoid.RootPart
		local sensedPart = charGroundSensor.SensedPart
		if sensedPart then
			local pos = charGroundSensor.HitFrame.Position
			local floorVel = sensedPart:GetVelocityAtPosition(pos)
			local assemblyVel = hrp.AssemblyLinearVelocity
			-- Ignore y-velocity, so that jumping does not influence the animation speed
			local relVel = Vector3.new(assemblyVel.X - floorVel.X, 0, assemblyVel.Z - floorVel.Z)
			local relSpeed = relVel.Magnitude
			local moveMag = charControllerManager.MovingDirection.Magnitude
			if moveMag < 0.1 then
				relSpeed = 0
				moveMag = 0
			elseif moveMag > 1.0 then
				moveMag = 1.0
			end
			speed = relSpeed * moveMag
		end
	end

	local movedDuringEmote = currentlyPlayingEmote and Humanoid.MoveDirection == Vector3.new(0, 0, 0)
	local speedThreshold = movedDuringEmote and (Humanoid.WalkSpeed / heightScale) or 0.75
	if speed > speedThreshold * heightScale then
		local scale = 16.0
		playAnimation("walk", 0.2, Humanoid)
		setAnimationSpeed(speed / scale)
		pose = "Running"
	else
		if emoteNames[currentAnim] == nil and not currentlyPlayingEmote then
			playAnimation("idle", 0.2, Humanoid)
			pose = "Standing"
		end
	end
end

function onDied()
	pose = "Dead"
end

function onJumping()
	playAnimation("jump", 0.1, Humanoid)
	jumpAnimTime = jumpAnimDuration
	pose = "Jumping"
end

function onClimbing(speed)
	speed /= getHeightScale()
	local scale = 5.0
	playAnimation("climb", 0.1, Humanoid)
	setAnimationSpeed(speed / scale)
	pose = "Climbing"
end

function onGettingUp()
	pose = "GettingUp"
end

function onFreeFall()
	if (jumpAnimTime <= 0) then
		playAnimation("fall", fallTransitionTime, Humanoid)
	end
	pose = "FreeFall"
end

function onFallingDown()
	pose = "FallingDown"
end

function onSeated()
	pose = "Seated"
end

function onPlatformStanding()
	pose = "PlatformStanding"
end

-------------------------------------------------------------------------------------------
-------------------------------------------------------------------------------------------

function onSwimming(speed)
	speed /= getHeightScale()
	if speed > 1.00 then
		local scale = 10.0
		playAnimation("swim", 0.4, Humanoid)
		setAnimationSpeed(speed / scale)
		pose = "Swimming"
	else
		playAnimation("swimidle", 0.4, Humanoid)
		pose = "Standing"
	end
end

function animateTool()
	if (toolAnim == "None") then
		playToolAnimation("toolnone", toolTransitionTime, Humanoid, Enum.AnimationPriority.Idle)
		return
	end

	if (toolAnim == "Slash") then
		playToolAnimation("toolslash", 0, Humanoid, Enum.AnimationPriority.Action)
		return
	end

	if (toolAnim == "Lunge") then
		playToolAnimation("toollunge", 0, Humanoid, Enum.AnimationPriority.Action)
		return
	end
end

function getToolAnim(tool)
	for _, c in ipairs(tool:GetChildren()) do
		if c.Name == "toolanim" and c.className == "StringValue" then
			return c
		end
	end
	return nil
end

local lastTick = 0

function stepAnimate(currentTime)
	local amplitude = 1
	local frequency = 1
  	local deltaTime = currentTime - lastTick
  	lastTick = currentTime

	local climbFudge = 0
	local setAngles = false

  	if (jumpAnimTime > 0) then
  		jumpAnimTime = jumpAnimTime - deltaTime
  	end

	if (pose == "FreeFall" and jumpAnimTime <= 0) then
		playAnimation("fall", fallTransitionTime, Humanoid)
	elseif (pose == "Seated") then
		playAnimation("sit", 0.5, Humanoid)
		return
	elseif (pose == "Running") then
		playAnimation("walk", 0.2, Humanoid)
	elseif (pose == "Dead" or pose == "GettingUp" or pose == "FallingDown" or pose == "Seated" or pose == "PlatformStanding") then
		stopAllAnimations()
		amplitude = 0.1
		frequency = 1
		setAngles = true
	end

	-- Tool Animation handling
	local tool = Character:FindFirstChildOfClass("Tool")
	if tool and tool:FindFirstChild("Handle") then
		local animStringValueObject = getToolAnim(tool)

		if animStringValueObject then
			toolAnim = animStringValueObject.Value
			-- message recieved, delete StringValue
			animStringValueObject.Parent = nil
			toolAnimTime = currentTime + .3
		end

		if currentTime > toolAnimTime then
			toolAnimTime = 0
			toolAnim = "None"
		end

		animateTool()		
	else
		stopToolAnimations()
		toolAnim = "None"
		toolAnimInstance = nil
		toolAnimTime = 0
	end
end

-- connect events
Humanoid.Died:connect(onDied)
Humanoid.Running:connect(onRunning)
Humanoid.Jumping:connect(onJumping)
Humanoid.Climbing:connect(onClimbing)
Humanoid.GettingUp:connect(onGettingUp)
Humanoid.FreeFalling:connect(onFreeFall)
Humanoid.FallingDown:connect(onFallingDown)
Humanoid.Seated:connect(onSeated)
Humanoid.PlatformStanding:connect(onPlatformStanding)
Humanoid.Swimming:connect(onSwimming)

-- setup emote chat hook
game:GetService("Players").LocalPlayer.Chatted:connect(function(msg)
	local emote = ""
	if (string.sub(msg, 1, 3) == "/e ") then
		emote = string.sub(msg, 4)
	elseif (string.sub(msg, 1, 7) == "/emote ") then
		emote = string.sub(msg, 8)
	end
	
	if (pose == "Standing" and emoteNames[emote] ~= nil) then
		playAnimation(emote, EMOTE_TRANSITION_TIME, Humanoid)
	end
end)

-- emote bindable hook
script:WaitForChild("PlayEmote").OnInvoke = function(emote)
	-- Only play emotes when idling
	if pose ~= "Standing" then
		return
	end

	if emoteNames[emote] ~= nil then
		-- Default emotes
		playAnimation(emote, EMOTE_TRANSITION_TIME, Humanoid)
		
		return true, currentAnimTrack
	elseif typeof(emote) == "Instance" and emote:IsA("Animation") then
		-- Non-default emotes
		playEmote(emote, EMOTE_TRANSITION_TIME, Humanoid)

		return true, currentAnimTrack
	end
	
	-- Return false to indicate that the emote could not be played
	return false
end

if Character.Parent ~= nil then
	-- initialize to idle
	playAnimation("idle", 0.1, Humanoid)
	pose = "Standing"
end

-- loop to handle timed state transitions and tool animations
while Character.Parent ~= nil do
	local _, currentGameTime = wait(0.1)
	stepAnimate(currentGameTime)
end

]]></Source>
		<Source path="BladebornePort/Bladeborne.luau"><![CDATA[--!strict
-- Bladeborne Floor 0's Atomic runtime. World art comes from the imported place;
-- combat, bots and demo setup live in Luau.

local Players = game:GetService("Players")
local workspace = game:GetService("Workspace")
local Modules = script :: any
local BladeborneRuntime = require(Modules.BladeborneRuntime)

local demo = Instance.new("Model")
demo.Name = "BladeborneDemo"
demo.Parent = workspace

local function block(name: string, size: Vector3, at: Vector3, colour: Color3): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Position = at
	part.Color = colour
	part.Anchored = true
	part.Parent = demo
	return part
end

local spawn = workspace:FindFirstChild("SpawnLocation", true)
if spawn == nil then
	spawn = block("SpawnLocation", Vector3.new(18, 1, 18), Vector3.new(0, 0.5, 0), Color3.fromRGB(45, 48, 58))
	block("TrainingFloor", Vector3.new(70, 2, 70), Vector3.new(0, -1, 0), Color3.fromRGB(18, 20, 24))
end

local localPlayer = Players.LocalPlayer :: Player?
if localPlayer ~= nil and localPlayer.Character == nil then
	localPlayer:LoadCharacter()
end

local BOT_COUNT = 8
for index = 1, BOT_COUNT do
	local bot = Instance.new("Player")
	bot.Name = `Husk {index}`
	bot:SetAttribute("BladeborneBot", true)
	bot:SetAttribute("BladeborneFaction", if index % 2 == 0 then "warden" else "husk")
	bot.Parent = Players
	local character = bot:LoadCharacter()
	if character ~= nil then
		local angle = (index - 1) * math.pi * 2 / BOT_COUNT
		local origin = (spawn :: BasePart).Position
		character:PivotTo(CFrame.new(origin + Vector3.new(math.cos(angle) * 7, 3, math.sin(angle) * 7)))
	end
end

BladeborneRuntime.start()
print(`bladeborne demo: sword light chain live, {BOT_COUNT} husks thinking`)
]]></Source>
		<Source path="BladebornePort/BladeborneRuntime/init.luau"><![CDATA[--!strict

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local Modules = script.Parent
local CombatSolver = require(Modules.BladeborneCore.CombatSolver)
local BotMind = require(Modules.BladeborneCore.BotMind)
local CombatConfig = require(Modules.BladeborneCore.CombatConfig)
local SpatialIndex = require(Modules.BladeborneCore.SpatialIndex)
local ProfileStore = require(Modules.BladeborneRuntime.ProfileStore)
local Hud = require(Modules.BladeborneRuntime.Hud)

local BladeborneRuntime = {}

export type StartOptions = {
	MindAllPlayers: boolean?,
	ProfilesEnabled: boolean?,
	BindInput: boolean?,
	HudEnabled: boolean?,
}

type CombatState = CombatSolver.State
type Actor = CombatSolver.Actor

type RuntimeState = {
	NextActorId: number,
	Now: number,
	AttackQueued: boolean,
	States: { [number]: CombatState },
	Profiles: ProfileStore.Controller,
	MindAllPlayers: boolean,
	Connections: { RBXScriptConnection },
}

local function rootOf(character: Instance): BasePart?
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function humanoidOf(character: Instance): Humanoid?
	return character:FindFirstChild("Humanoid") :: Humanoid?
end

local function characterOf(player: Instance): Instance?
	local character = player.Character
	if character == nil then
		return nil
	end
	return character
end

local function actorId(state: RuntimeState, character: Instance): number
	local existing = character:GetAttribute("BladeborneActorId")
	if typeof(existing) == "number" then
		return existing
	end

	local id = state.NextActorId
	state.NextActorId += 1
	character:SetAttribute("BladeborneActorId", id)
	return id
end

local function combatState(state: RuntimeState, character: Instance): CombatState
	local id = actorId(state, character)
	local existing = state.States[id]
	if existing ~= nil then
		return existing
	end

	local created = CombatSolver.newState()
	state.States[id] = created
	return created
end

local function collectActors(state: RuntimeState): ({ Actor }, { [number]: Instance })
	local actors = {}
	local characters = {}
	local activeIds = {}
	for _, player in Players:GetPlayers() do
		local character = characterOf(player)
		if character == nil then
			continue
		end
		local root = rootOf(character)
		local humanoid = humanoidOf(character)
		if root == nil or humanoid == nil then
			continue
		end

		local id = actorId(state, character)
		activeIds[id] = true
		local faction = player:GetAttribute("BladeborneFaction")
		if typeof(faction) ~= "string" or faction == "" then
			if state.MindAllPlayers then
				faction = if id % 2 == 0 then "husk" else "warden"
			else
				faction = if player:GetAttribute("BladeborneBot") == true then "enemy" else "player"
			end
		end
		characters[id] = character
		table.insert(actors, {
			Id = id,
			Position = character:GetPivot().Position,
			Faction = faction,
			Alive = humanoid.Health > 0,
		})
	end
	for id in state.States do
		if activeIds[id] ~= true then
			state.States[id] = nil
		end
	end
	return actors, characters
end

local function resolveImpact(
	state: RuntimeState,
	actor: Actor,
	character: Instance,
	forward: Vector3,
	spatial: SpatialIndex.Grid,
	characters: { [number]: Instance },
	now: number
)
	local impact = CombatSolver.advance(combatState(state, character), now)
	if impact == nil then
		return
	end
	local target = SpatialIndex.nearestTarget(spatial, actor.Position, forward, actor.Faction, CombatConfig.Reach)
	if target == nil then
		return
	end
	local targetCharacter = characters[target.Id]
	if targetCharacter == nil then
		return
	end
	local humanoid = humanoidOf(targetCharacter)
	if humanoid == nil or humanoid.Health <= 0 then
		return
	end

	local previousHealth = humanoid.Health
	humanoid.Health = math.max(0, previousHealth - impact.Damage)
	targetCharacter:SetAttribute("LastBladeborneHit", now)
	character:SetAttribute("BladeborneComboStep", impact.Step)
	if previousHealth > 0 and humanoid.Health <= 0 then
		local player = Players:GetPlayerFromCharacter(character)
		if player ~= nil then
			state.Profiles.grantKill(player, 35, 12)
			local kills = player:GetAttribute("BladeborneBotKills")
			player:SetAttribute("BladeborneBotKills", if typeof(kills) == "number" then kills + 1 else 1)
		end
	end
end

local function tick(state: RuntimeState, now: number)
	local actors, characters = collectActors(state)
	local spatial = SpatialIndex.build(actors, CombatConfig.Reach * 2)
	local localPlayer = Players.LocalPlayer

	for _, actor in actors do
		local character = characters[actor.Id]
		if character == nil then
			continue
		end
		local root = rootOf(character)
		local humanoid = humanoidOf(character)
		if root == nil or humanoid == nil or not actor.Alive then
			continue
		end

		local player = Players:GetPlayerFromCharacter(character)
		local isBot = player ~= nil and (state.MindAllPlayers or player:GetAttribute("BladeborneBot") == true)
		local attack = false
		local forward = root.CFrame.LookVector

		if isBot then
			local target = SpatialIndex.nearestEnemy(spatial, actor, 72)
			local decision = BotMind.decide(actor.Id, actor.Position, if target == nil then nil else target.Position, now)
			humanoid.MoveDirection = decision.MoveDirection
			attack = decision.Attack
			if target ~= nil then
				local targetDirection = target.Position - actor.Position
				if targetDirection.Magnitude > 0 then
					forward = targetDirection.Unit
				end
			end
		elseif player ~= nil and localPlayer ~= nil and player:Equals(localPlayer) and state.AttackQueued then
			attack = true
			state.AttackQueued = false
		end

		if attack then
			CombatSolver.tryAttack(combatState(state, character), now)
		end
		resolveImpact(state, actor, character, forward, spatial, characters, now)
	end
end

function BladeborneRuntime.start(options: StartOptions?): () -> ()
	local selected = options or {}
	local localPlayer = Players.LocalPlayer
	local showHud = selected.HudEnabled ~= false
	local stopHud = if localPlayer == nil or not showHud then function() end else Hud.start(localPlayer)
	local state: RuntimeState = {
		NextActorId = 1,
		Now = 0,
		AttackQueued = false,
		States = {},
		Profiles = ProfileStore.start(selected.ProfilesEnabled),
		MindAllPlayers = selected.MindAllPlayers == true,
		Connections = {},
	}

	if selected.BindInput ~= false then
		table.insert(state.Connections, UserInputService.InputBegan:Connect(function(input, processed)
			if not processed and input.UserInputType == Enum.UserInputType.MouseButton1 then
				state.AttackQueued = true
			end
		end))
	end
	table.insert(state.Connections, RunService.Heartbeat:Connect(function(deltaTime)
		state.Now += deltaTime
		tick(state, state.Now)
	end))

	return function()
		for _, connection in state.Connections do
			connection:Disconnect()
		end
		table.clear(state.Connections)
		state.Profiles.stop()
		stopHud()
	end
end

return BladeborneRuntime
]]></Source>
		<Source path="BladebornePort/BladeborneRuntime/Hud.luau"><![CDATA[--!strict

local RunService = game:GetService("RunService")

local Hud = {}

local BLACK = Color3.fromRGB(0, 0, 0)
local WHITE = Color3.fromRGB(255, 255, 255)
local MUTED = Color3.fromRGB(170, 170, 170)

local function label(parent: Instance, name: string, y: number, height: number, colour: Color3): TextLabel
	local text = Instance.new("TextLabel")
	text.Name = name
	text.BackgroundTransparency = 1
	text.Position = UDim2.new(0, 12, 0, y)
	text.Size = UDim2.new(1, -24, 0, height)
	text.TextColor3 = colour
	text.TextSize = 15
	text.TextXAlignment = Enum.TextXAlignment.Left
	text.TextYAlignment = Enum.TextYAlignment.Center
	text.Parent = parent
	return text
end

function Hud.start(player: Instance): () -> ()
	local container = player.PlayerGui
	if container == nil then
		return function() end
	end

	local stale = container:FindFirstChild("BladeborneHud")
	if stale ~= nil then
		stale:Destroy()
	end

	local screen = Instance.new("ScreenGui")
	screen.Name = "BladeborneHud"
	screen.Parent = container

	local strip = Instance.new("Frame")
	strip.Name = "Status"
	strip.BackgroundColor3 = BLACK
	strip.BackgroundTransparency = 0.08
	strip.BorderSizePixel = 0
	strip.Position = UDim2.new(0, 18, 0, 18)
	strip.Size = UDim2.new(0, 430, 0, 58)
	strip.Parent = screen

	local vital = label(strip, "Vital", 4, 26, WHITE)
	local controls = label(strip, "Controls", 29, 20, MUTED)
	controls.Text = "MOUSE 1  LIGHT ATTACK    WASD  MOVE"

	local previous = ""
	local connection = RunService.Heartbeat:Connect(function()
		local character = player.Character
		local humanoid = if character == nil then nil else character:FindFirstChild("Humanoid") :: Humanoid?
		local health = if humanoid == nil then 0 else math.max(0, math.floor(humanoid.Health + 0.5))
		local maximum = if humanoid == nil then 100 else math.max(1, math.floor(humanoid.MaxHealth + 0.5))
		local level = player:GetAttribute("BladeborneLevel")
		local experience = player:GetAttribute("BladeborneExperience")
		local gold = player:GetAttribute("BladeborneGold")
		local nextText = `HP {health}/{maximum}    LV {if typeof(level) == "number" then level else 1}    XP {if typeof(experience) == "number" then experience else 0}    GOLD {if typeof(gold) == "number" then gold else 0}`
		if nextText ~= previous then
			previous = nextText
			vital.Text = nextText
		end
	end)

	return function()
		connection:Disconnect()
		screen:Destroy()
	end
end

return Hud
]]></Source>
		<Source path="BladebornePort/BladeborneRuntime/ProfileStore.luau"><![CDATA[--!strict

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local Progression = require(script.Parent.Parent.BladeborneCore.Progression)

local ProfileStore = {}

export type Profile = Progression.Profile

export type Controller = {
	profileOf: (player: Instance) -> Profile?,
	grantKill: (player: Instance, experience: number, gold: number) -> number,
	save: (player: Instance) -> boolean,
	stop: () -> (),
}

local function playerId(player: Instance): number
	return player.UserId
end

local function profileKey(player: Instance): string
	return `bladeborne/profile/{playerId(player)}`
end

local function isBot(player: Instance): boolean
	return player:GetAttribute("BladeborneBot") == true
end

local function publish(player: Instance, profile: Profile)
	player:SetAttribute("BladeborneLevel", profile.Level)
	player:SetAttribute("BladeborneExperience", profile.Experience)
	player:SetAttribute("BladeborneGold", profile.Gold)
	player:SetAttribute("BladeborneKills", profile.Kills)
	player:SetAttribute("BladeborneHealthFlasks", profile.HealthFlasks)
	player:SetAttribute("BladeborneWeapon", profile.EquippedWeapon)
end

function ProfileStore.start(enabled: boolean?): Controller
	if enabled == false then
		return {
			profileOf = function(_player: Instance): Profile?
				return nil
			end,
			grantKill = function(_player: Instance, _experience: number, _gold: number): number
				return 0
			end,
			save = function(_player: Instance): boolean
				return true
			end,
			stop = function() end,
		}
	end

	local profiles: { [number]: Profile } = {}
	local connections: { RBXScriptConnection } = {}
	local stopped = false

	local function load(player: Instance)
		if isBot(player) or stopped then
			return
		end
		local id = playerId(player)
		if profiles[id] ~= nil then
			publish(player, profiles[id])
			return
		end

		local stored, status = DataStoreService:GetAsync(profileKey(player))
		if stopped then
			return
		end
		local profile = if status == "Ok" then Progression.sanitize(stored) else Progression.newProfile()
		profiles[id] = profile
		publish(player, profile)
	end

	local function save(player: Instance): boolean
		if isBot(player) then
			return true
		end
		local profile = profiles[playerId(player)]
		if profile == nil then
			return false
		end
		local _, status = DataStoreService:SetAsync(profileKey(player), profile)
		return status == "Ok"
	end

	for _, player in Players:GetPlayers() do
		task.spawn(load, player)
	end
	table.insert(connections, Players.PlayerAdded:Connect(function(player)
		task.spawn(load, player)
	end))
	table.insert(connections, Players.PlayerRemoving:Connect(function(player)
		if not isBot(player) then
			save(player)
			profiles[playerId(player)] = nil
		end
	end))

	return {
		profileOf = function(player: Instance): Profile?
			return profiles[playerId(player)]
		end,
		grantKill = function(player: Instance, experience: number, gold: number): number
			local profile = profiles[playerId(player)]
			if profile == nil then
				return 0
			end
			local levels = Progression.grantKill(profile, experience, gold)
			publish(player, profile)
			return levels
		end,
		save = save,
		stop = function()
			stopped = true
			for _, connection in connections do
				connection:Disconnect()
			end
			table.clear(connections)
			for _, player in Players:GetPlayers() do
				if not isBot(player) then
					save(player)
				end
			end
		end,
	}
end

return ProfileStore
]]></Source>
		<Source path="BladebornePort/BladeborneCore/CombatConfig.luau"><![CDATA[--!strict

-- The first playable slice of Bladeborne's Sword/Ground light chain.
-- Values are copied from the source game's CombatConfig and CombatMovesets.

local Config = {
	Reach = 9,
	BaseDamage = 10,
	MinimumForwardDot = 0.35,
	InputBuffer = 0.18,
	ComboResetWindow = 1.5,
	Steps = {
		{ Name = "L", Animation = "L1", DamageMultiplier = 1.00, Windup = 0.05, Active = 0.15, Recovery = 0.20 },
		{ Name = "LL", Animation = "L2", DamageMultiplier = 1.05, Windup = 0.05, Active = 0.15, Recovery = 0.18 },
		{ Name = "LLL", Animation = "L3", DamageMultiplier = 1.10, Windup = 0.05, Active = 0.15, Recovery = 0.16 },
		{ Name = "LLLL", Animation = "L_FIN", DamageMultiplier = 1.50, Windup = 0.10, Active = 0.20, Recovery = 0.30 },
	},
}

for _, step in Config.Steps do
	table.freeze(step)
end
table.freeze(Config.Steps)

return table.freeze(Config)
]]></Source>
		<Source path="BladebornePort/BladeborneCore/CombatSolver.luau"><![CDATA[--!strict

local Config = require(script.Parent.CombatConfig)

local CombatSolver = {}

export type Actor = {
	Id: number,
	Position: Vector3,
	Faction: string,
	Alive: boolean,
}

export type State = {
	Step: number,
	ReadyAt: number,
	ActiveAt: number,
	ComboExpiresAt: number,
	ImpactPending: boolean,
	Buffered: boolean,
}

export type Impact = {
	Step: number,
	Animation: string,
	Damage: number,
}

function CombatSolver.newState(): State
	return {
		Step = 0,
		ReadyAt = 0,
		ActiveAt = 0,
		ComboExpiresAt = 0,
		ImpactPending = false,
		Buffered = false,
	}
end

local function beginAttack(state: State, now: number)
	local continues = state.Step > 0 and state.Step < #Config.Steps and now <= state.ComboExpiresAt
	state.Step = if continues then state.Step + 1 else 1

	local step = Config.Steps[state.Step]
	state.ActiveAt = now + step.Windup
	state.ReadyAt = state.ActiveAt + step.Active + step.Recovery
	state.ComboExpiresAt = now + Config.ComboResetWindow
	state.ImpactPending = true
	state.Buffered = false
end

function CombatSolver.tryAttack(state: State, now: number): (boolean, string)
	if now < state.ReadyAt then
		if state.ReadyAt - now <= Config.InputBuffer then
			state.Buffered = true
			return true, "buffered"
		end
		return false, "recovery"
	end

	beginAttack(state, now)
	return true, "started"
end

function CombatSolver.advance(state: State, now: number): Impact?
	local impact = nil
	if state.ImpactPending and now >= state.ActiveAt then
		local step = Config.Steps[state.Step]
		impact = {
			Step = state.Step,
			Animation = step.Animation,
			Damage = Config.BaseDamage * step.DamageMultiplier,
		}
		state.ImpactPending = false
	end

	if state.Buffered and now >= state.ReadyAt then
		beginAttack(state, now)
	end

	return impact
end

function CombatSolver.nearestTarget(
	origin: Vector3,
	forward: Vector3,
	faction: string,
	actors: { Actor }
): Actor?
	if forward.Magnitude <= 0 then
		return nil
	end

	local direction = forward.Unit
	local nearest = nil
	local nearestDistance = math.huge
	for _, actor in actors do
		if actor.Alive and actor.Faction ~= faction then
			local offset = actor.Position - origin
			local distance = offset.Magnitude
			local inReach = distance > 0 and distance <= Config.Reach
			local inArc = inReach and offset:Dot(direction) / distance >= Config.MinimumForwardDot
			if inArc then
				local winsTie = distance == nearestDistance and nearest ~= nil and actor.Id < nearest.Id
				if distance < nearestDistance or winsTie then
					nearest = actor
					nearestDistance = distance
				end
			end
		end
	end
	return nearest
end

return CombatSolver
]]></Source>
		<Source path="BladebornePort/BladeborneCore/BotMind.luau"><![CDATA[--!strict

local Config = require(script.Parent.CombatConfig)

local BotMind = {}

export type Decision = {
	MoveDirection: Vector3,
	Attack: boolean,
}

-- One deterministic mind. The same bot id and simulation time always produce
-- the same choice, so recordings and load runs agree without a random stream.
function BotMind.decide(botId: number, at: Vector3, target: Vector3?, now: number): Decision
	if target == nil then
		local angle = now * 0.35 + botId * 0.73
		return {
			MoveDirection = Vector3.new(math.cos(angle), 0, math.sin(angle)),
			Attack = false,
		}
	end

	local offset = target - at
	local distance = offset.Magnitude
	if distance <= 0 then
		local angle = botId * 2.399963229728653
		return { MoveDirection = Vector3.new(math.cos(angle), 0, math.sin(angle)), Attack = false }
	end

	local attackBeat = math.floor(now * 5 + botId * 3) % 5 == 0
	return {
		MoveDirection = if distance > Config.Reach * 0.7 then offset.Unit else Vector3.new(0, 0, 0),
		Attack = distance <= Config.Reach and attackBeat,
	}
end

return BotMind
]]></Source>
		<Source path="BladebornePort/BladeborneCore/Progression.luau"><![CDATA[--!strict

local Progression = {}

export type Inventory = { [string]: number }

export type Profile = {
	SchemaVersion: number,
	Level: number,
	Experience: number,
	Gold: number,
	Kills: number,
	HealthFlasks: number,
	EquippedWeapon: string,
	Inventory: Inventory,
}

local CURRENT_SCHEMA = 1
local MAX_LEVEL = 100

local function whole(value: any, fallback: number, minimum: number): number
	if typeof(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return fallback
	end
	return math.max(minimum, math.floor(value))
end

function Progression.experienceForNextLevel(level: number): number
	local bounded = math.clamp(math.floor(level), 1, MAX_LEVEL)
	return 80 + bounded * bounded * 20
end

function Progression.newProfile(): Profile
	return {
		SchemaVersion = CURRENT_SCHEMA,
		Level = 1,
		Experience = 0,
		Gold = 0,
		Kills = 0,
		HealthFlasks = 3,
		EquippedWeapon = "RustSword",
		Inventory = { RustSword = 1 },
	}
end

function Progression.sanitize(raw: any): Profile
	local profile = Progression.newProfile()
	if typeof(raw) ~= "table" then
		return profile
	end

	profile.Level = math.clamp(whole(raw.Level, 1, 1), 1, MAX_LEVEL)
	profile.Experience = whole(raw.Experience, 0, 0)
	profile.Gold = whole(raw.Gold, 0, 0)
	profile.Kills = whole(raw.Kills, 0, 0)
	profile.HealthFlasks = whole(raw.HealthFlasks, 3, 0)
	if typeof(raw.EquippedWeapon) == "string" and raw.EquippedWeapon ~= "" then
		profile.EquippedWeapon = raw.EquippedWeapon
	end
	if typeof(raw.Inventory) == "table" then
		profile.Inventory = {}
		for itemId, count in raw.Inventory do
			if typeof(itemId) == "string" and itemId ~= "" then
				local amount = whole(count, 0, 0)
				if amount > 0 then
					profile.Inventory[itemId] = amount
				end
			end
		end
	end
	if profile.Inventory[profile.EquippedWeapon] == nil then
		profile.EquippedWeapon = "RustSword"
		profile.Inventory.RustSword = math.max(1, profile.Inventory.RustSword or 0)
	end

	while profile.Level < MAX_LEVEL do
		local required = Progression.experienceForNextLevel(profile.Level)
		if profile.Experience < required then
			break
		end
		profile.Experience -= required
		profile.Level += 1
	end
	if profile.Level == MAX_LEVEL then
		profile.Experience = 0
	end
	return profile
end

function Progression.grantExperience(profile: Profile, amount: number): number
	local gained = whole(amount, 0, 0)
	if gained == 0 or profile.Level >= MAX_LEVEL then
		return 0
	end

	local levels = 0
	profile.Experience += gained
	while profile.Level < MAX_LEVEL do
		local required = Progression.experienceForNextLevel(profile.Level)
		if profile.Experience < required then
			break
		end
		profile.Experience -= required
		profile.Level += 1
		levels += 1
	end
	if profile.Level == MAX_LEVEL then
		profile.Experience = 0
	end
	return levels
end

function Progression.grantKill(profile: Profile, experience: number, gold: number): number
	profile.Kills += 1
	profile.Gold += whole(gold, 0, 0)
	return Progression.grantExperience(profile, experience)
end

function Progression.grantItem(profile: Profile, itemId: string, amount: number): number
	if itemId == "" then
		return 0
	end
	local granted = whole(amount, 0, 0)
	if granted == 0 then
		return profile.Inventory[itemId] or 0
	end
	profile.Inventory[itemId] = (profile.Inventory[itemId] or 0) + granted
	return profile.Inventory[itemId]
end

return Progression
]]></Source>
		<Source path="BladebornePort/BladeborneCore/SpatialIndex.luau"><![CDATA[--!strict

local SpatialIndex = {}

export type Actor = {
	Id: number,
	Position: Vector3,
	Faction: string,
	Alive: boolean,
}

type Cell = { Actor }
type Column = { [number]: Cell }

export type Grid = {
	CellSize: number,
	Columns: { [number]: Column },
}

local function coordinate(value: number, cellSize: number): number
	return math.floor(value / cellSize)
end

function SpatialIndex.build(actors: { Actor }, cellSize: number): Grid
	assert(cellSize > 0, "cell size must be positive")
	local columns: { [number]: Column } = {}
	for _, actor in actors do
		if actor.Alive then
			local x = coordinate(actor.Position.X, cellSize)
			local z = coordinate(actor.Position.Z, cellSize)
			local column = columns[x]
			if column == nil then
				column = {}
				columns[x] = column
			end
			local cell = column[z]
			if cell == nil then
				cell = {}
				column[z] = cell
			end
			table.insert(cell, actor)
		end
	end
	return { CellSize = cellSize, Columns = columns }
end

local function nearest(
	grid: Grid,
	origin: Vector3,
	faction: string,
	actorId: number?,
	maximumDistance: number,
	forward: Vector3?
): Actor?
	if maximumDistance <= 0 then
		return nil
	end
	local direction = nil
	if forward ~= nil then
		if forward.Magnitude <= 0 then
			return nil
		end
		direction = forward.Unit
	end

	local centreX = coordinate(origin.X, grid.CellSize)
	local centreZ = coordinate(origin.Z, grid.CellSize)
	local radius = math.ceil(maximumDistance / grid.CellSize)
	local found = nil
	local foundDistance = math.huge
	for x = centreX - radius, centreX + radius do
		local column = grid.Columns[x]
		if column == nil then
			continue
		end
		for z = centreZ - radius, centreZ + radius do
			local cell = column[z]
			if cell == nil then
				continue
			end
			for _, candidate in cell do
				if candidate.Faction == faction or candidate.Id == actorId then
					continue
				end
				local offset = candidate.Position - origin
				local distance = offset.Magnitude
				if distance <= 0 or distance > maximumDistance then
					continue
				end
				if direction ~= nil and offset:Dot(direction) / distance < 0.35 then
					continue
				end
				local winsTie = distance == foundDistance and found ~= nil and candidate.Id < found.Id
				if distance < foundDistance or winsTie then
					found = candidate
					foundDistance = distance
				end
			end
		end
	end
	return found
end

function SpatialIndex.nearestEnemy(grid: Grid, actor: Actor, maximumDistance: number): Actor?
	return nearest(grid, actor.Position, actor.Faction, actor.Id, maximumDistance, nil)
end

function SpatialIndex.nearestTarget(
	grid: Grid,
	origin: Vector3,
	forward: Vector3,
	faction: string,
	maximumDistance: number
): Actor?
	return nearest(grid, origin, faction, nil, maximumDistance, forward)
end

return SpatialIndex
]]></Source>
