	Description = "Wipe a player's feature flags (FFlags) so one-shot flows like the welcome popup re-trigger.",
	Group = 'Admin',
	Args = {
		{ Type = 'player', Name = 'target', Description = "Player whose feature flags to reset." },
	},
}
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/fflags/ResetFFlagsServer"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

return function(_context, target: Player)
	local FFlags = ServerCore.FFlagsServer
	if not FFlags or not FFlags.ResetFFlags then
		return 'FFlagsServer unavailable.'
	end

	local Saves = ServerCore.SavesManagerServer
	if Saves and Saves.GetPlayerSelectedSaveData
		and not Saves.GetPlayerSelectedSaveData(target) then
		return string.format('%s has no save selected.', target.Name)
	end

	-- Wipe every persisted feature flag for the player.
	FFlags.ResetFFlags(target)

	-- Make the reset observable without a rejoin: clear the in-session
	-- welcome de-dupe and re-run the first-join hook so any flag-gated
	-- first-time flow (e.g. the welcome popup, whose ONBOARDING_JOIN_GAME_1
	-- flag was just wiped) is offered again immediately.
	local Onboarding = ServerCore.OnboardingServer
	if Onboarding then
		if Onboarding.ResetJoinGame1 then
			Onboarding.ResetJoinGame1(target)
		end
		if Onboarding.OnFirstCharacterSpawn then
			Onboarding.OnFirstCharacterSpawn(target)
		end
	end

	return string.format('Reset feature flags for %s.', target.Name)
end
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Hooks/resethook"><![CDATA[
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CmdrConfig = require(ReplicatedStorage:WaitForChild('CmdrConfig'))

return function(registry)
	registry:RegisterHook("BeforeRun", function(context)
		local plr = context.Executor
		if not plr then
			return "No executor."
		end
		local group = context.Group
		if group == "Admin" and not CmdrConfig.IsPlayerAdmin(plr) then
			return string.format("No permission for '%s'.", tostring(context.Name or "command"))
		end
		return nil
	end)
end
]]></Source>
		<Source path="ServerScriptService/CmdrServer"><![CDATA[
local ServerScriptService = game:GetService("ServerScriptService")
local CmdrSetup = ServerScriptService:WaitForChild('CmdrSetup')

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Cmdr = require(ReplicatedStorage:WaitForChild('Cmdr'))
local CmdrConfig = require(ReplicatedStorage:WaitForChild('CmdrConfig'))

local function RegisterHook(context): string?
	print("[Cmdr BeforeRun]", "Name=", context.Name, "Group=", context.Group)
	local cmd = context.Command
	local plr = context.Executor
	-- Block unknown executor
	if not plr then
		return "No executor."
	end
	if not CmdrConfig.IsPlayerAdmin(plr) then
		-- print("NOT ADMIN")
		return string.format("No permission for '%s'.", cmd.Name)
	end
	-- Allow everything else
	return nil
end

Cmdr:RegisterDefaultCommands()
Cmdr:RegisterCommandsIn(CmdrSetup.Commands)
Cmdr:RegisterHooksIn(CmdrSetup.Hooks)
Cmdr.Registry:RegisterHook("BeforeRun", RegisterHook)
]]></Source>
		<Source path="ServerStorage/Core"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="ServerStorage/Core/EnemyServer"><![CDATA[
-- TODO: show the "attack path" with red on the ground

local CollectionService = game:GetService('CollectionService')
local PhysicsService = game:GetService('PhysicsService')
local Debris = game:GetService('Debris')

local ServerStorage = game:GetService("ServerStorage")
local ServerModules = require(ServerStorage:WaitForChild("Modules"))

local ComponentBehaviorTree = ServerModules.Libraries.ComponentBehaviorTree
local DamageServerModule = ServerModules.Modules.DamageModule

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local MobsConfigModule = ReplicatedModules.Data.Mobs
local DifficultyScaling = ReplicatedModules.Data.DifficultyScaling
local CombatFactions = ReplicatedModules.Data.CombatFactions

local AICharacterTag = 'AICharacter'

local SystemsContainer = {}

local AICharacterClasses = {}
local ActiveAIEntities = {}

-- Seconds before a dead AI respawns. Tunable per-mob via the
-- 'RespawnSeconds' attribute on the spawned Model; falls back to this
-- default. Set to 0 (or negative) on a model to disable respawn for
-- that specific spawn (e.g. boss kills, unique cinematic NPCs).
local DEFAULT_RESPAWN_SECONDS = 30
-- Seconds the corpse stays in workspace for visual feedback before
-- being despawned. Independent of RespawnSeconds — corpse linger and
-- respawn timing are separate (a 30 s respawn with a 5 s corpse linger
-- means the world is empty for 25 s before the new mob appears).
local CORPSE_LINGER_SECONDS = 5

local Module = {}

function Module.InitializeMob(Model : Instance)
	if ActiveAIEntities[Model] then
		return ActiveAIEntities[Model]
	end

	local Humanoid = Model:FindFirstChildWhichIsA('Humanoid')
	if not Humanoid then
		warn(string.format('AICharacter %s does not have a Humanoid!', Model:GetFullName()))
		return
	end

	local HumanoidRootPart = Model:FindFirstChild('HumanoidRootPart')
	if not HumanoidRootPart then
		warn(string.format('AICharacter %s does not have a HumanoidRootPart!', Model:GetFullName()))
		return
	end

	local mobId = Model:GetAttribute('AIClass')
	if not mobId then
		warn(string.format('AICharacter %s has no AIClass attribute set - setting to generic.', Model:GetFullName()))
		mobId = 'Generic'
	end

	if not AICharacterClasses[mobId] then
		warn(string.format('AICharacter %s has a invalid AIClass attribute set of %s - setting to generic.', Model:GetFullName(), mobId))
		mobId = 'Generic'
	end

	local mobConfig = MobsConfigModule.Mobs[ mobId ]
	assert( mobConfig, 'No AIClass Config found for: ' .. tostring( Model:GetFullName() ) )

	for _, basePart in Model:GetDescendants() do
		if basePart:IsA("BasePart") then
			-- disables .Touched events (HIGH)
			basePart.CanTouch = false
			-- disables shadow of invisible parts (LOW)
			basePart.CastShadow = (basePart.Transparency ~= 1)
			-- misc
			basePart.Massless = true
			basePart.CollisionGroup = 'GenericAI'
		end
	end

	if mobConfig.IsInvulnerable then
		CollectionService:AddTag(Model, 'INVULNERABILITY')
	end

	-- Combat faction defaults to a shared NPC faction. Content can opt into
	-- NPC-vs-NPC hostility with Mobs.<id>.FactionId or a Studio-authored
	-- CombatFactionId/FactionId attribute.
	if Model:GetAttribute('CombatFactionId') == nil and Model:GetAttribute('FactionId') == nil then
		Model:SetAttribute('CombatFactionId', mobConfig.FactionId or CombatFactions.Factions.NPCs)
	end

	-- Poise archetype decides how much punishment this mob absorbs
	-- before it staggers, and whether a launcher can lift it at all.
	-- Stamped as an attribute so CombatStateServer can resolve it
	-- without a config lookup on every hit, and so a Studio-authored
	-- override on an individual spawn wins over the class default.
	if Model:GetAttribute('PoiseArchetype') == nil and mobConfig.PoiseArchetype then
		Model:SetAttribute('PoiseArchetype', mobConfig.PoiseArchetype)
	end

	-- Per-floor difficulty scaling. Read the mob's resolved floor (model
	-- attribute, or any ancestor's `Floor` attribute, default 0) and
	-- pull the floor's multipliers from the registry. HealthMul scales
	-- the live Humanoid; DamageMul is stamped on the model so
	-- NPCCombatServer's swing path multiplies it into outbound damage.
	-- Mobs that opt out via `IgnoreDifficulty = true` (cinematic NPCs,
	-- dummies) skip the scale entirely so a Floor-50 dummy doesn't
	-- inherit a 14× HP multiplier.
	if not mobConfig.IgnoreDifficulty then
		local floor = DifficultyScaling.ResolveFloorForInstance(Model)
		local mul = DifficultyScaling.GetFloorMultipliers(floor)
		if mul.HealthMul ~= 1 then
			-- MaxHealth first so the Health clamp the engine applies on
			-- assignment lands on the new ceiling rather than the old
			-- (a hp_max of 100 would clamp Health=200 → 100 mid-write).
			Humanoid.MaxHealth = Humanoid.MaxHealth * mul.HealthMul
			Humanoid.Health = Humanoid.MaxHealth
		end
		if mul.DamageMul ~= 1 then
			Model:SetAttribute('DamageMul', mul.DamageMul)
		end
		-- Stamp the resolved floor too so debug overlays / Cmdr commands
		-- can print "this mob is on floor 12" without re-resolving.
		Model:SetAttribute('ResolvedFloor', floor)
	end

	if mobConfig.HasOverheadInfo then
		CollectionService:AddTag(Model, 'OVERHEAD_INFO')
	end

	if mobConfig.HasCrystalCrystal then
		CollectionService:AddTag(Model, 'OVERHEAD_CRYSTAL')
	end

	if not AICharacterClasses[mobId] then
		warn(string.format('Cannot find AI Character Class of given id: %s.', mobId))
		mobId = 'Generic'
	end

	local MobClass = AICharacterClasses[mobId].Create(Model, Humanoid, HumanoidRootPart, mobId)
	ActiveAIEntities[Model] = MobClass

	-- Boss routing: when the mob config carries a BossId, hand off
	-- to BossServer.Initialize for phase tracking + recipe-queue
	-- execution. Skip the per-class BT sequencer attachment because
	-- BossServer owns the BT for bosses (the AI class's own BT is
	-- a no-op stub in BossBoar.luau, kept to satisfy the registry
	-- shape without duplicating BT runtimes).
	local sequenceItem
	if mobConfig.BossId and SystemsContainer.BossServer
		and SystemsContainer.BossServer.Initialize then
		SystemsContainer.BossServer.Initialize(Model, Humanoid, HumanoidRootPart, mobConfig)
	else
		sequenceItem = AICharacterClasses[mobId].BehaviorTree:create_sequence_item()
		sequenceItem.cycleToRoot = true
		sequenceItem.conditionParams = {MobClass}
		sequenceItem.functionParams = {MobClass}

		AICharacterClasses[mobId].BehaviorTree:append_sequencer(sequenceItem)
	end

	-- Stash the BT + sequence item on the MobClass so CleanupMob can
	-- pop the sequencer when the AICharacter tag is removed without
	-- a death (e.g. SetupTestDummies re-flipping the tag to swap
	-- AIClass). Without this, the old sequencer keeps running with
	-- stale references and a dummy ends up with TWO BTs driving it
	-- after a re-init — duplicate swings, duplicate Attacking state.
	-- Bosses skip this path entirely (sequenceItem is nil for them);
	-- BossServer.Cleanup pops the boss BT sequencer through its own
	-- bookkeeping.
	if sequenceItem then
		MobClass.BehaviorTree = AICharacterClasses[mobId].BehaviorTree
		MobClass.SequenceItem = sequenceItem
	end
	MobClass.IsBoss = mobConfig.BossId ~= nil

	-- TODO: load animations like stunned, blocking, etc on the NPC

	-- Respawn template: snapshot the model at initialization so we can
	-- clone-and-reparent at the original CFrame on death. Archivable
	-- has to flip true while we clone; we set it back to false on the
	-- working model so a player Tool / dev manipulation later can't
	-- accidentally clone the live entity. The template itself stays
	-- under ServerStorage so it doesn't accidentally end up in
	-- workspace.
	local spawnCFrame = Model:GetPivot()
	Model.Archivable = true
	local respawnTemplate = Model:Clone()
	Model.Archivable = false
	-- CollectionService tags persist through :Clone(), so the cloned
	-- template inherits 'AICharacter'. If we left it tagged, parenting
	-- the template into ServerStorage would re-fire
	-- GetInstanceAddedSignal(AICharacterTag), which would recursively
	-- call InitializeMob on the template, clone IT, and so on — the
	-- engine eventually trips "Maximum event re-entrancy depth exceeded".
	-- Strip the tag here and re-add it on the respawn clone below so the
	-- signal only fires once per *live* spawn.
	if respawnTemplate:HasTag(AICharacterTag) then
		respawnTemplate:RemoveTag(AICharacterTag)
	end
	-- Park the template in the EnemyTemplates folder so it never
	-- renders or runs AI. Folder created lazily on first use.
	local templatesFolder = ServerStorage:FindFirstChild('EnemyTemplates')
	if not templatesFolder then
		templatesFolder = Instance.new('Folder')
		templatesFolder.Name = 'EnemyTemplates'
		templatesFolder.Parent = ServerStorage
	end
	respawnTemplate.Parent = templatesFolder

	local c; c = Humanoid.Died:Connect(function()
		c:Disconnect()
		print("Check loot table for mob: ", Model:GetFullName(), mobId)
		Module.DistributeMobLoot(Model, Humanoid, mobId)

		-- Death effect: anchor + disable collisions so the corpse stays
		-- in place while the client tweens transparency / emits the
		-- DeathShatter particles, then add the DEATH_EFFECT tag (after a
		-- 0.01 s defer so the anchor/property writes replicate to the
		-- client before the tag-added handler runs — same staging as the
		-- player path in GameControllerServer).
		for _, basePart in Model:GetDescendants() do
			if basePart:IsA('BasePart') then
				basePart.Anchored = true
				basePart.CanCollide = false
				basePart.CanTouch = false
				basePart.CanQuery = false
			end
		end
		task.delay(0.01, function()
			if Model and Model.Parent then
				CollectionService:AddTag(Model, 'DEATH_EFFECT')
			end
		end)

		-- Respawn timer. Per-mob override via attribute, else default.
		-- Negative / zero disables respawn for this particular spawn
		-- — useful for unique cinematic NPCs and bosses that should
		-- stay dead.
		local respawnSeconds = tonumber(Model:GetAttribute('RespawnSeconds')) or DEFAULT_RESPAWN_SECONDS
		-- Despawn the corpse after a short linger (visual feedback).
		Debris:AddItem(Model, CORPSE_LINGER_SECONDS)
		if respawnSeconds <= 0 then
			respawnTemplate:Destroy()
			return
		end
		-- After the full respawn delay (NOT the corpse linger), clone
		-- the template back into workspace at the spawn CFrame. The
		-- template was untagged at init (to break the InstanceAdded
		-- recursion), so we re-add 'AICharacter' on the fresh clone
		-- before parenting — that's what fires GetInstanceAddedSignal
		-- in Start() and routes back through InitializeMob.
		task.delay(respawnSeconds, function()
			-- Defensive: skip if the template was wiped (server shutting
			-- down, world tear-down, etc.).
			if not respawnTemplate or not respawnTemplate.Parent then return end
			local fresh = respawnTemplate:Clone()
			fresh:PivotTo(spawnCFrame)
			fresh:AddTag(AICharacterTag)
			fresh.Parent = workspace
		end)
	end)

	return MobClass, sequenceItem
end

function Module.DistributeMobLoot(model, humanoid, mobId)
	-- Boss-only stat: per-boss-id defeat count. Read once outside the
	-- contributor loop so we don't string-match per player. The mob
	-- config is the source of truth; falling back to nil means no
	-- BossesDefeated bump (regular mobs).
	local mobConfig = MobsConfigModule.Mobs[ mobId ]
	local bossKey = mobConfig and mobConfig.BossId

	local playerToData = DamageServerModule.GetHumanoidTags( humanoid ) :: {[Player] : {Damage : number, Expiry : number}}
	print(playerToData)
	for player, contributions in playerToData do
		if typeof(player) ~= 'Instance' or not player:IsA('Player') then
			continue
		end
		if not contributions then
			continue
		end
		if contributions.Expiry and time() > contributions.Expiry then
			continue
		end
		print(player.Name, 'has contributed a total of', contributions.Damage, 'to mob', mobId)
		local rewards = {Currency = 50, Experience = 20,} -- TODO setup reward calculator
		SystemsContainer.LootTableServer.GiveRewardTableToPlayer( player, rewards )

		-- Stat hooks: every contributor counts as a "killer." Bumps
		-- CurrentKillStreak (resets on death) + KillStreakRecord max,
		-- plus per-boss tally for bosses. Mob-type per-id tracking
		-- isn't surfaced (would explode the map cardinality with N
		-- mob types per kill) — bosses are the named, surfaced entries.
		local Stats = SystemsContainer.StatisticsServer
		if Stats then
			local IDS = require(game:GetService('ReplicatedStorage'):WaitForChild('Modules')).Data.StatisticsConfig.StatisticIds
			local current = Stats.Increment(player, IDS.CurrentKillStreak, 1)
			Stats.SetMax(player, IDS.KillStreakRecord, current)
			if bossKey then
				Stats.IncrementMap(player, IDS.BossesDefeated, bossKey, 1)
			end
		end
	end
end

function Module.CleanupMob(Model : Instance)
	-- Pop the BT sequencer if it was stashed at init. Two paths
	-- reach here:
	--   * Humanoid.Died → CheckIfModelIsAlive flips false →
	--     PopSelfFromTreeComponent already removed the sequencer
	--     before we get here. The remove call below is a no-op in
	--     that case (BT lib accepts duplicate removes).
	--   * AICharacter tag removed without death (SetupTestDummies
	--     re-flipping the tag, dev tooling) → the BT is still alive
	--     and will keep ticking with stale references unless we
	--     explicitly pop it here.
	local mobClass = ActiveAIEntities[Model]
	if mobClass and mobClass.BehaviorTree and mobClass.SequenceItem then
		pcall(function()
			mobClass.BehaviorTree:remove_sequencer(mobClass.SequenceItem)
		end)
	end
	-- Bosses get their own cleanup path through BossServer (closes the
	-- healthbar, restores stat overrides, fires DeathRecipe). Tag
	-- removal without death is rare for bosses but handled here as a
	-- safety net so a BossServer entry doesn't leak.
	if mobClass and mobClass.IsBoss and SystemsContainer.BossServer
		and SystemsContainer.BossServer.Cleanup then
		pcall(function() SystemsContainer.BossServer.Cleanup(Model :: Model, false) end)
	end
	ActiveAIEntities[Model] = nil
end

function Module.Start()
	local BehaviorTreeResolvers = ComponentBehaviorTree.BehaviorTreeResolver.new()
	BehaviorTreeResolvers:start_runtime()

	PhysicsService:RegisterCollisionGroup('GenericAI')
	PhysicsService:CollisionGroupSetCollidable('GenericAI', 'GenericAI', false)

	for _, object in CollectionService:GetTagged(AICharacterTag) do
		task.defer(Module.InitializeMob, object)
	end
	CollectionService:GetInstanceAddedSignal(AICharacterTag):Connect(Module.InitializeMob)
	CollectionService:GetInstanceRemovedSignal(AICharacterTag):Connect(Module.CleanupMob)

	for _, BaseClass in AICharacterClasses do
		BaseClass.Start()
		BehaviorTreeResolvers:append_tree(BaseClass.BehaviorTree)
	end
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems

	for _, ModuleScript in script:GetChildren() do
		if ModuleScript:IsA('ModuleScript') then
			AICharacterClasses[ModuleScript.Name] = require(ModuleScript)
		end
	end

	for _, BaseClass in AICharacterClasses do
		BaseClass.Init(otherSystems)
	end
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/EnemyServer/Boar"><![CDATA[
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")

local ServerStorage = game:GetService("ServerStorage")
local ServerModules = require(ServerStorage:WaitForChild("Modules"))

local ComponentBehaviorTree = ServerModules.Libraries.ComponentBehaviorTree
local DamageModule = ServerModules.Modules.DamageModule
local CombatModule = ServerModules.Modules.CombatModule

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local BoarMobConfigTable = ReplicatedModules.Data.Mobs.Mobs.Boar
local CombatFactions = ReplicatedModules.Data.CombatFactions

local AnimationService = ReplicatedModules.Services.AnimationService
local MoveToUtility = ReplicatedModules.Utility.MoveTo
local HitboxUtility = ReplicatedModules.Utility.Hitbox
local HitCacheUtility = ReplicatedModules.Utility.HitCache
local CombatShared = ReplicatedModules.Services.CombatShared

local GenericBehaviorTree = require(script.Parent:WaitForChild('Generic'))

local SystemsContainer = {}

local function BoarAlignForDashAttack(tree, sequencer, ai)
	local BoarPosition = ai.Model:GetPivot().Position
	local TargetPosition = ai.TargetModel:GetPivot().Position

	local DirectionXZ = CFrame.lookAt( BoarPosition, TargetPosition ).LookVector
	DirectionXZ = Vector3.new( DirectionXZ.X, 0, DirectionXZ.Z )

	local EndCFrame = CFrame.lookAt( BoarPosition, BoarPosition + DirectionXZ )

	local CFValue = Instance.new('CFrameValue')
	CFValue.Value = ai.Model:GetPivot()
	CFValue.Changed:Connect(function( value )
		ai.Model:PivotTo( value )
	end)

	local Tween = TweenService:Create( CFValue, TweenInfo.new(0.5), { Value = EndCFrame } )
	Tween:Play()
	Tween.Completed:Wait()

	CFValue:Destroy()

	-- ai.Model:PivotTo( EndCFrame )

	return true
end

local function AttemptBoarAttackHit(boar: Instance, humanoid: Humanoid)
	local targetCharacter = humanoid.Parent
	local canHit = CombatFactions.CanHit(boar, targetCharacter, {
		TargetMode = CombatFactions.TargetModes.Hostiles,
	})
	if not canHit then
		return
	end

	-- Resolve block state through the shared helper rather than bouncing
	-- off PlayerCombatServer. That module is now a remote-intake adapter
	-- with no gameplay logic, and reaching into it from an AI class was
	-- always a layering accident.
	local forceBlockBreak = false
	local BLOCKING_STATES = CombatShared.BLOCKING_STATE
	local BlockState = CombatShared.DecrementBlockCount(targetCharacter, forceBlockBreak)
	if BlockState ~= BLOCKING_STATES.NotBlocking and BlockState ~= BLOCKING_STATES.Broken then
		return
	end
	-- block was broken / not up. Per-floor difficulty scaling: the boar's
	-- model carries `DamageMul` set by EnemyServer.InitializeMob based
	-- on its resolved floor. Multiply into the dash's outbound damage so
	-- a Floor-10 boar hits harder than a Floor-1 boar with the same
	-- config-side AttackDamage value.
	local damage = BoarMobConfigTable.AttackDamage
	local damageMul = boar:GetAttribute('DamageMul')
	if typeof(damageMul) == 'number' and damageMul > 0 then
		damage = damage * damageMul
	end
	DamageModule.DamageCharacter( targetCharacter, damage, boar )
	CombatModule.KnockdownCharacter( targetCharacter, 0.3 )
end

local function collectBoarDashTargets(boar: Model): { Instance }
	local out = {}
	local tags = CombatFactions.GetCandidateTagsForTargetMode(boar, CombatFactions.TargetModes.Hostiles)
	for _, tag in tags do
		for _, target in CollectionService:GetTagged(tag) do
			if not target:IsA('Model') then
				continue
			end
			local canHit = CombatFactions.CanHit(boar, target, {
				TargetMode = CombatFactions.TargetModes.Hostiles,
			})
			if canHit then
				out[#out + 1] = target
			end
		end
	end
	return out
end

local function BoarDashAttack(tree, sequencer, ai)
	if ai.NextAttackTick and tick() < ai.NextAttackTick then
		return false
	end
	local attackInterval = (ai.Config and ai.Config.AttackInterval or 1)
	ai.NextAttackTick = tick() + attackInterval

	-- Telegraph the dash zone before committing. Players see a red
	-- rectangle covering the dash path + a progress bar filling over
	-- the windup; if they're not out of the rectangle when the bar
	-- fills, they get hit. Length is sized to the actual target
	-- distance the dash will lock onto below; orientation comes from
	-- the boar's model pivot (see comment on AlignForDashAttack —
	-- alignment runs before this, so the pivot's facing already
	-- points at the target).
	local Telegraph = SystemsContainer.EnemyTelegraphServer
	local boarPivot = ai.Model:GetPivot()
	local toTarget = ai.TargetModel:GetPivot().Position - boarPivot.Position
	-- Y clamp: the dash + telegraph live on the horizontal plane.
	-- Using the planar distance avoids over-stretching the rectangle
	-- on terrain where the target is below/above the boar.
	local dashLength = math.clamp(Vector3.new(toTarget.X, 0, toTarget.Z).Magnitude + 4, 6, 32)
	local windup = (ai.Config and ai.Config.AttackWindup) or 0.45
	local telegraphId
	if Telegraph and Telegraph.Show then
		local _, bound = ai.Model:GetBoundingBox()
		local width = math.max(4, bound.X * 1.2)
		telegraphId = Telegraph.Show({
			Kind = 'Rect',
			Origin = boarPivot,  -- client flattens to horizontal plane
			Size = Vector3.new(width, 0, dashLength),
			Duration = windup,
		})
	end

	-- Windup pause so the player can see the telegraph and react. The
	-- existing alignment tween (BoarAlignForDashAttack) was 0.5s; we
	-- now overlap the windup with that and add any remaining time so
	-- the visible bar fills smoothly to 100% before the dash commits.
	task.wait(windup)

	if telegraphId and Telegraph and Telegraph.Hide then
		Telegraph.Hide(telegraphId)
	end

	print('Dash Attack!')

	-- attack mechanic
	--[[
	if ai.LoadedAnimations.ChargeRun then
		ai.LoadedAnimations.ChargeRun.Looped = true
		ai.LoadedAnimations.ChargeRun:Play()
	end
	]]

	-- move to
	local raycastParam = RaycastParams.new()
	raycastParam.FilterDescendantsInstances = { workspace.Terrain }
	raycastParam.FilterType = Enum.RaycastFilterType.Include
	local overlapParam = OverlapParams.new()
	overlapParam.FilterType = Enum.RaycastFilterType.Include

	local TargetPosition = ai.TargetModel:GetPivot().Position

	local DirectionXZ = CFrame.lookAt( ai.Model:GetPivot().Position, TargetPosition ).LookVector
	DirectionXZ = Vector3.new( DirectionXZ.X, 0, DirectionXZ.Z )

	TargetPosition += (DirectionXZ * 4)

	local _, BoundSize = ai.Model:GetBoundingBox()
	BoundSize = BoundSize * Vector3.new(0.85, 0.9, 1.25)

	-- Per-dash hit cache. Was a local table — now uses the shared
	-- HitCache utility so the dedup contract matches the player /
	-- NPC swing paths and skills. Single-cast lifetime, no TTL: a
	-- player struck by the boar can't be re-hit by the same dash.
	local dashCache = HitCacheUtility.New()

	ai.Humanoid.WalkSpeed = BoarMobConfigTable.AttackDashSpeed

	MoveToUtility.MoveToLoop( ai.Humanoid, ai.HumanoidRootPart, TargetPosition, function(_)
		-- Honor stun mid-dash. Without this, a player swing landing
		-- after the dash committed wouldn't interrupt the charge — the
		-- BT-level stun gate only kicks in once the dash returns. The
		-- callback's `false` return terminates MoveToLoop early.
		if CombatShared.IsCharacterStunned(ai.Model) then
			return false
		end

		overlapParam.FilterDescendantsInstances = collectBoarDashTargets(ai.Model)

		local BoarPosition = ai.Model:GetPivot().Position

		local HitboxCF = CFrame.lookAt( BoarPosition, BoarPosition + DirectionXZ )
		local HitboxResult = HitboxUtility.GetHitboxResult( HitboxCF, BoundSize, overlapParam )
		HitboxResult = HitboxUtility.FindHumanoidsFromHits(HitboxResult)

		local hasHitHumanoid = false
		for _, humanoid in HitboxResult do
			if HitCacheUtility.ShouldHit(dashCache, humanoid) then
				AttemptBoarAttackHit(ai.Model, humanoid)
				hasHitHumanoid = true
			end
		end

		return (not hasHitHumanoid)
	end )

	ai.Humanoid:MoveTo( ai.HumanoidRootPart.Position )
	ai.Humanoid.WalkSpeed = BoarMobConfigTable.WalkSpeed

	--[[
	if ai.LoadedAnimations.ChargeRun then
		ai.LoadedAnimations.ChargeRun:Stop(0.1)
	end
	]]

	-- delay slightly
	task.wait(1)
end

export type BoarAICharacter = {
	ID : string,
	Config : {},
	Model : Model,
	Humanoid : Humanoid,
	HumanoidRootPart : BasePart,
	SpawnPosition : Vector3,
	LoadedAnimations : {[string] : Animation},
}

local Module = {}

function Module.Create( Model : Instance, Humanoid : Humanoid, mobId : string ) : BoarAICharacter
	local mobAnimations = BoarMobConfigTable.Animations
	assert( mobAnimations, script.Name..' requires an animations table to be defined in config.' )

	local LoadedAnimations = AnimationService.LoadAnimationsDictionary( Humanoid.Animator, mobAnimations )

	Humanoid.WalkSpeed = BoarMobConfigTable.WalkSpeed

	return {
		ID = mobId,
		Config = BoarMobConfigTable,
		Model = Model,
		HumanoidRootPart = Model:FindFirstChild('HumanoidRootPart'),
		Humanoid = Humanoid,
		SpawnPosition = Model:GetPivot().Position,
		LoadedAnimations = LoadedAnimations,
	}
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

function Module.Start()

end

Module.Functions = {
	BoarAlignForDashAttack = BoarAlignForDashAttack,
	BoarDashAttack = BoarDashAttack,
}

Module.BehaviorTree = ComponentBehaviorTree.BehaviorTreeFactory.build_from_nested(
	ComponentBehaviorTree.NodeFactory.condition_true_false(
		GenericBehaviorTree.Functions.CheckIfModelIsAlive,
		-- Stun gate (shared with the Generic BT). The 1 s stun applied
		-- by player attacks pauses the boar's full attack chain — dash
		-- align, dash run, post-dash wait — so a swing actually
		-- interrupts the charge instead of being shrugged off.
		ComponentBehaviorTree.NodeFactory.condition_true_false(
			GenericBehaviorTree.Functions.CheckIfModelIsNotStunned,
			ComponentBehaviorTree.NodeFactory.condition_true_false(
				GenericBehaviorTree.Functions.FindClosestTarget,
				ComponentBehaviorTree.NodeFactory.condition_true_false(
					GenericBehaviorTree.Functions.CanAttackTarget,
					ComponentBehaviorTree.NodeFactory.condition_true_false(
						BoarAlignForDashAttack,
						BoarDashAttack,
						ComponentBehaviorTree.NodeFactory.delay(0)
					),
					GenericBehaviorTree.Functions.TraverseToTarget
				),
				ComponentBehaviorTree.NodeFactory.condition_true_false(
					GenericBehaviorTree.Functions.CanWanderAgain,
					GenericBehaviorTree.Functions.DoWander,
					GenericBehaviorTree.Functions.DelayRandom1to2
				)
			),
			GenericBehaviorTree.Functions.StunPauseTick
		),
		GenericBehaviorTree.Functions.PopSelfFromTreeComponent
	)
)

return Module
]]></Source>
		<Source path="ServerStorage/Core/EnemyServer/Generic"><![CDATA[
local CollectionService = game:GetService('CollectionService')

local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

local ComponentBehaviorTree = ServerModules.Libraries.ComponentBehaviorTree

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local GenericMobConfigTable = ReplicatedModules.Data.Mobs.Mobs.Generic
local CombatFactions = ReplicatedModules.Data.CombatFactions
local CombatShared = ReplicatedModules.Services.CombatShared
-- CharacterStates is required so AttackNearbyTarget can set the
-- 'Attacking' temp state for perfect-dodge detection to read.
local CharacterStates = ReplicatedModules.Services.CharacterStates
local CombatConfig = ReplicatedModules.Data.CombatConfig

local SystemsContainer = {}

local function CheckIfModelIsAlive(tree, sequencer, ai)
	return ai.Humanoid and ai.Humanoid.Health > 0
end

-- Stun gate: returns TRUE while the AI is *not* stunned (so the
-- positive branch is the normal-acting path; the negative branch is the
-- short pause). Player attacks call CombatServerModule.StunCharacter
-- with a 1 s duration; this gate is what actually pauses the AI for
-- that window. Without it, the Stunned state was being set but every
-- BT function would barrel through it.
local function CheckIfModelIsNotStunned(tree, sequencer, ai)
	if not ai.Model then return true end
	return not CombatShared.IsCharacterStunned(ai.Model)
end

-- Short tick used as the "stunned" branch — keeps the BT cycling
-- without burning CPU on a tight loop while the stun timer drains.
-- 0.1 s lines up roughly with the smallest perceptible delay so the
-- stun feels like a real pause (1 s stun → ~10 ticks here before the
-- AI resumes).
local function StunPauseTick()
	task.wait(0.1)
end

local function FindClosestTarget(tree, sequencer, ai)
	local targetTags = CombatFactions.GetCandidateTagsForTargetMode(ai.Model, CombatFactions.TargetModes.Hostiles)

	local LastTarget = ai.TargetModel

	ai.TargetModel = nil
	ai.TargetHumanoid = nil
	ai.TargetDistance = nil

	local maxTrackDistance = (ai.Config and ai.Config.MaxTrackRange or 50)
	local currentPosition = ai.Model:GetPivot().Position

	for _, tag in targetTags do
		for _, target in CollectionService:GetTagged(tag) do
			if target == ai.Model or not target:IsDescendantOf(workspace) then
				continue
			end

			local canHit = CombatFactions.CanHit(ai.Model, target, {
				TargetMode = CombatFactions.TargetModes.Hostiles,
			})
			if not canHit then
				continue
			end

			local Humanoid = target:FindFirstChildWhichIsA('Humanoid')
			if (not Humanoid) or (Humanoid.Health <= 0) then
				continue
			end

			-- see if they are closer or if they are within the maximum track distance
			local Dist = (currentPosition - target:GetPivot().Position).Magnitude
			if ai.TargetModel then
				if Dist < ai.TargetDistance then
					ai.TargetModel = target
					ai.TargetHumanoid = Humanoid
					ai.TargetDistance = Dist
				end
			elseif Dist < maxTrackDistance then
				ai.TargetModel = target
				ai.TargetHumanoid = Humanoid
				ai.TargetDistance = Dist
			end
		end
	end

	if ai.TargetModel ~= LastTarget and ai.LastAttackTick then
		ai.LastAttackTick = nil
	end

	return (ai.TargetModel ~= nil)
end

local function CanAttackTarget(tree, sequencer, ai)
	if not ai.TargetModel then
		return false
	end
	local maxAttackDistance = (ai.Config and ai.Config.MaxAttackRange or 7)
	local withinRange = ai.TargetDistance < maxAttackDistance
	if withinRange then
		-- Stop where we are, then TURN TO FACE the target. The previous
		-- code only issued MoveTo(own position) to halt, so a mob that
		-- arrived off-axis would swing at empty air: the hitbox is built
		-- from the attacker's LookVector, and nothing was aligning it.
		ai.Humanoid:MoveTo(ai.Model:GetPivot().Position)

		local selfPivot = ai.Model:GetPivot()
		local targetPosition = ai.TargetModel:GetPivot().Position
		local facing = Vector3.new(
			targetPosition.X - selfPivot.Position.X,
			0,
			targetPosition.Z - selfPivot.Position.Z)
		if facing.Magnitude > 0.1 then
			ai.Model:PivotTo(CFrame.lookAt(selfPivot.Position, selfPivot.Position + facing.Unit))
		end
	end
	return withinRange
end

-- Combat pursuit. Two behaviours the previous straight MoveTo-at-target
-- did not have:
--
--   * It aims for a point at the mob's PREFERRED engagement range
--     rather than the target's exact position, so a mob stops at
--     swinging distance instead of walking into the player and pushing
--     them around.
--   * Each mob approaches along its own stable flank angle, so a pack
--     surrounds its target rather than forming a single-file queue
--     behind whichever one got there first.
local function TraverseToTarget(tree, sequencer, ai)
	local targetPosition = ai.TargetModel:GetPivot().Position
	local selfPosition = ai.Model:GetPivot().Position

	local maxAttackDistance = (ai.Config and ai.Config.MaxAttackRange or 7)
	local preferred = (ai.Config and ai.Config.PreferredRange) or (maxAttackDistance * 0.7)

	local fromTarget = Vector3.new(
		selfPosition.X - targetPosition.X,
		0,
		selfPosition.Z - targetPosition.Z)
	if fromTarget.Magnitude < 0.1 then
		ai.Humanoid:MoveTo(targetPosition)
		return
	end

	-- Rotate the approach vector by this mob's own flank angle, assigned
	-- once at spawn so the choice is stable frame to frame (a per-tick
	-- random would make the mob jitter in place).
	local angle = ai.EngageAngle or 0
	local direction = (CFrame.Angles(0, angle, 0) * fromTarget.Unit)
	ai.Humanoid:MoveTo(targetPosition + (direction * preferred))
end

-- Reactive evade. If a hostile hitbox is LIVE and this mob is standing
-- in it, roll the dice on getting out. Uses the same active-window
-- registry the player's perfect-evade check reads, so an NPC dodge is a
-- response to a real threat rather than a timer.
local function TryEvadeIncoming(ai): boolean
	local chance = (ai.Config and ai.Config.DodgeChance) or 0
	if chance <= 0 then return false end

	local HitboxServer = SystemsContainer.CombatHitboxServer
	local CombatServer = SystemsContainer.CombatServer
	if not HitboxServer or not CombatServer or not ai.Model then return false end

	if not HitboxServer.FindThreateningWindow(ai.Model, 0) then return false end
	if math.random() > chance then return false end

	-- Evade perpendicular to the incoming attacker rather than straight
	-- back: sidestepping leaves the mob in range to punish, which is the
	-- behaviour that makes an enemy feel like it is fighting you.
	local selfPosition = ai.Model:GetPivot().Position
	local direction = nil
	if ai.TargetModel then
		local toTarget = ai.TargetModel:GetPivot().Position - selfPosition
		toTarget = Vector3.new(toTarget.X, 0, toTarget.Z)
		if toTarget.Magnitude > 0.1 then
			local right = Vector3.new(-toTarget.Unit.Z, 0, toTarget.Unit.X)
			direction = (math.random() < 0.5) and right or -right
		end
	end
	return CombatServer.AttemptDodge(ai.Model, direction, nil)
end

local function AttackNearbyTarget(tree, sequencer, ai)
	if ai.NextAttackTick and tick() < ai.NextAttackTick then
		return false
	end

	-- Defence first: a mob that is about to be hit should evade rather
	-- than trade, and evading consumes this tick.
	if TryEvadeIncoming(ai) then
		return true
	end

	local attackInterval = (ai.Config and ai.Config.AttackInterval or 1)
	ai.NextAttackTick = tick() + attackInterval

	-- Telegraphed set-piece attacks stay on the skill runtime: a boss
	-- wind-up wants its big readable ground marker. Only mobs that
	-- explicitly declare an AttackRecipe take that path.
	local recipeId = ai.Config and ai.Config.AttackRecipe
	if recipeId then
		local Runtime = SystemsContainer.SkillRuntimeServer
		if Runtime and Runtime.RunRecipe and ai.Model then
			local activeWindow = (ai.Config and ai.Config.AttackActiveWindow) or 0.25
			CharacterStates.SetStateTemporary(ai.Model, 'Attacking', activeWindow, true)
			local caster = Runtime.CasterFromModel(ai.Model, nil)
			if caster then
				Runtime.RunRecipe(caster, recipeId)
			end
		end
		return true
	end

	-- Standard melee goes through the SAME runtime players use, so an
	-- NPC gets combo chains, poise damage, cancel windows and launchers
	-- for free. Note that closing distance is NOT part of that: attacks
	-- never move the attacker, so an NPC reaches its target with the
	-- pursuit above (PreferredRange) and swings once it is there. Previously this called a telegraphed skill
	-- recipe for every ordinary sword swing, which is why basic mobs
	-- announced each attack with a full ground marker.
	local CombatServer = SystemsContainer.CombatServer
	if not CombatServer or not ai.Model then return false end

	-- Simple chain grammar: light, light, heavy. The heavy beat resolves
	-- to the weapon class's LLH entry, which is its launcher — so a mob
	-- that lands a full chain pops the player up exactly as a player
	-- would pop the mob.
	ai.SwingStep = ((ai.SwingStep or 0) % 3) + 1
	local inputKind = (ai.SwingStep == 3) and 'H' or 'L'

	-- A guarding target is worth breaking rather than chipping.
	if ai.TargetModel and CombatShared.IsCharacterBlocking(ai.TargetModel) then
		inputKind = 'H'
	end

	CombatServer.AttemptStartNpcAction(ai.Model, {
		InputKind = inputKind,
		TargetHint = ai.TargetModel,
	})
	return true
end

local function PopSelfFromTreeComponent(tree, sequencer, ai)
	tree:remove_sequencer(sequencer)
end

local function CanWanderAgain(tree, sequencer, ai)
	if ai.NextWanderTick and tick() < ai.NextWanderTick then
		return false
	end
	ai.NextWanderTick = tick() + 2
	-- print('wander')
	return true
end

local function DoWander(tree, sequencer, ai)
	local offset = Vector3.new( math.random(-20, 20), 0, math.random(-20, 20) )
	ReplicatedModules.Utility.MoveTo.MoveToLoop( ai.Humanoid, ai.HumanoidRootPart, ai.SpawnPosition + offset, nil )
	-- ai.Humanoid:MoveTo( ai.SpawnPosition + offset )
end

local function DelayRandom1to2()
	task.wait( math.random(10, 20)/10 )
end

export type GenericAICharacter = {
	ID : string,
	Config : {},
	Model : Model,
	Humanoid : Humanoid,
	HumanoidRootPart : BasePart,
	SpawnPosition : Vector3,
	EngageAngle : number,
	SwingStep : number,
}

local Module = {}

-- Widest flank offset a mob will approach along, in radians. Beyond
-- about a quarter turn the approach stops reading as "closing in" and
-- starts reading as "walking past you".
local MAX_ENGAGE_ANGLE = math.rad(50)

function Module.Create(Model : Model, Humanoid : Humanoid, HumanoidRootPart : BasePart, mobId : string) : GenericAICharacter
	return {
		ID = mobId,
		Config = GenericMobConfigTable,
		Model = Model,
		Humanoid = Humanoid,
		HumanoidRootPart = HumanoidRootPart,
		SpawnPosition = Model:GetPivot().Position,
		-- Assigned once per spawn: see TraverseToTarget. Randomising per
		-- tick instead would make the mob oscillate rather than commit
		-- to a side.
		EngageAngle = (math.random() * 2 - 1) * MAX_ENGAGE_ANGLE,
		SwingStep = 0,
	}
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

function Module.Start()

end

Module.Functions = {
	CheckIfModelIsAlive = CheckIfModelIsAlive,
	CheckIfModelIsNotStunned = CheckIfModelIsNotStunned,
	StunPauseTick = StunPauseTick,
	FindClosestTarget = FindClosestTarget,
	CanAttackTarget = CanAttackTarget,
	AttackNearbyTarget = AttackNearbyTarget,
	TraverseToTarget = TraverseToTarget,
	CanWanderAgain = CanWanderAgain,
	DoWander = DoWander,
	PopSelfFromTreeComponent = PopSelfFromTreeComponent,
	DelayRandom1to2 = DelayRandom1to2,
}

Module.BehaviorTree = ComponentBehaviorTree.BehaviorTreeFactory.build_from_nested(
	ComponentBehaviorTree.NodeFactory.condition_true_false(
		CheckIfModelIsAlive,
		-- Stun gate wraps the active behavior so the 1 s player-attack
		-- stun actually freezes the AI. False branch = StunPauseTick
		-- (a short task.wait that keeps the BT cycling without acting).
		ComponentBehaviorTree.NodeFactory.condition_true_false(
			CheckIfModelIsNotStunned,
			ComponentBehaviorTree.NodeFactory.condition_true_false(
				FindClosestTarget,
				ComponentBehaviorTree.NodeFactory.condition_true_false(
					CanAttackTarget,
					AttackNearbyTarget,
					TraverseToTarget
				),
				ComponentBehaviorTree.NodeFactory.condition_true_false(
					CanWanderAgain,
					DoWander,
					DelayRandom1to2
				)
			),
			StunPauseTick
		),
		PopSelfFromTreeComponent
	),
	false
)

return Module
]]></Source>
		<Source path="ServerStorage/Core/EnemyServer/AttackDummy"><![CDATA[-- // EnemyServer/AttackDummy.luau //
-- Stationary swing-on-tick AI. Used by NPCCombatServer.SetupTestDummies
-- for the workspace.Attacking / AttackingBlockBreak / LeftAttacker /
-- RightAttacker / DualAttacker rigs. The Generic BT requires a player
-- target to be in range or the AI just wanders — fine for combat
-- mobs but pointless for hand-mode test rigs that should ALWAYS be
-- swinging so designers can verify per-hand presentation in real time.
--
-- The tree:
--   alive
--   ├── not-stunned
--   │   └── SwingOnTick (gated on NextSwingTick)
--   └── StunPauseTick (idle wait while stunned)
--   PopSelfFromTree (when dead)
--
-- All swing logic lives in the shared combat runtime, reached through
-- NPCCombatServer.AttemptNPCWeaponAttack — this module just calls it on
-- a timer. `ForceBlockBreak` is read from the model attribute by the
-- runtime itself, so nothing needs plumbing through here.
--
-- The rig walks an L, L, H pattern rather than repeating a single
-- light. That exercises the full chain the shared grammar provides —
-- including the LLH launcher — so a designer watching a dummy sees the
-- same combo structure a player would produce.

local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

local ComponentBehaviorTree = ServerModules.Libraries.ComponentBehaviorTree

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local AttackDummyMobConfig = ReplicatedModules.Data.Mobs.Mobs.AttackDummy
local CombatShared         = ReplicatedModules.Services.CombatShared
local CombatActions        = ReplicatedModules.Data.CombatActions

-- Pull the shared BT helpers from Generic so we don't re-implement
-- alive / stun / pop-self-from-tree (they're identical for any
-- single-action AI and Generic is the canonical source).
local GenericBehaviorTree = require(script.Parent:WaitForChild('Generic'))
local CheckIfModelIsAlive       = GenericBehaviorTree.Functions.CheckIfModelIsAlive
local CheckIfModelIsNotStunned  = GenericBehaviorTree.Functions.CheckIfModelIsNotStunned
local StunPauseTick             = GenericBehaviorTree.Functions.StunPauseTick
local PopSelfFromTreeComponent  = GenericBehaviorTree.Functions.PopSelfFromTreeComponent

local SystemsContainer = {}

----------------------------------------------------------------------
-- Swing-on-tick. Gated on `NextSwingTick` so the swing fires at the
-- configured cadence rather than every BT tick. Reads `ForceBlockBreak`
-- from the model attribute so the AttackingBlockBreak rig can opt in
-- per-instance without a separate config fork.
----------------------------------------------------------------------
local function SwingOnTick(tree, sequencer, ai)
	if ai.NextSwingTick and tick() < ai.NextSwingTick then
		-- Yield a beat so the BT cycle keeps moving — without this,
		-- the BT spins this node thousands of times per second when
		-- it's still on cooldown, eating CPU.
		task.wait(0.05)
		return false
	end
	local interval = (ai.Config and ai.Config.SwingInterval) or 1.0
	ai.NextSwingTick = tick() + interval

	-- Defensive: skip if the rig isn't actually combat-ready. The shared
	-- runtime re-checks this anyway; bailing early just avoids the
	-- denial bookkeeping for a case we can see coming.
	if not CombatShared.IsCharacterAlive(ai.Model) then
		return false
	end

	-- Walk L, L, H so the rig demonstrates a real chain instead of the
	-- same opener forever. The third beat resolves to the class's LLH
	-- entry, which is the launcher.
	ai.SwingStep = ((ai.SwingStep or 0) % 3) + 1
	local inputKind = ai.SwingStep == 3
		and CombatActions.InputKinds.Heavy
		or CombatActions.InputKinds.Light

	-- Hot-path import: NPCCombatServer is a sibling module loaded by
	-- the framework. SystemsContainer is filled via Module.Init.
	local NPCCombatServer = SystemsContainer.NPCCombatServer
	if not NPCCombatServer then return false end
	NPCCombatServer.AttemptNPCWeaponAttack(ai.Model, inputKind)
	return true
end

----------------------------------------------------------------------
-- Module. Same shape as Generic.luau / Boar.luau so EnemyServer's
-- AICharacterClasses[mobId] dispatch finds AttackDummy.Create + .BehaviorTree.
----------------------------------------------------------------------
local Module = {}

function Module.Create(Model: Model, Humanoid: Humanoid, HumanoidRootPart: BasePart, mobId: string)
	return {
		ID = mobId,
		Config = AttackDummyMobConfig,
		Model = Model,
		Humanoid = Humanoid,
		HumanoidRootPart = HumanoidRootPart,
		SpawnPosition = Model:GetPivot().Position,
	}
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

function Module.Start() end

Module.Functions = {
	SwingOnTick = SwingOnTick,
}

Module.BehaviorTree = ComponentBehaviorTree.BehaviorTreeFactory.build_from_nested(
	ComponentBehaviorTree.NodeFactory.condition_true_false(
		CheckIfModelIsAlive,
		ComponentBehaviorTree.NodeFactory.condition_true_false(
			CheckIfModelIsNotStunned,
			SwingOnTick,
			StunPauseTick
		),
		PopSelfFromTreeComponent
	),
	false
)

return Module
]]></Source>
		<Source path="ServerStorage/Core/EnemyServer/BossBoar"><![CDATA[-- BossBoar — phased boss-flavored boar. Reuses the Boar's animation
-- rig + model, but the BT is owned by BossServer (which drives every
-- BossId-tagged mob's pattern execution from data). This module is
-- intentionally thin: just animation loading + a placeholder
-- BehaviorTree so EnemyServer.InitializeMob's per-class wiring is
-- a no-op for bosses (BossServer.Initialize is what actually starts
-- the BT loop).
--
-- "Boar-like" behavior comes from the recipe pool authored in
-- Data/Bosses.luau under boss_boar.Phases — each entry has range
-- gates (MinRange / MaxRange) so BossServer's selector picks the
-- attack that fits the situation:
--   * Player at range  → CHARGE      (long forward rectangle)
--   * Player mid-range → STAMPEDE    (heavy circular ground-smash)
--   * Player in close  → GORE / DOUBLE-TAP / STOMP (short tells)
-- Stampede in particular fires the `stampede_smash` particle cue —
-- a brown dust ring + ground flash — at the impact instant.

local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

local ComponentBehaviorTree = ServerModules.Libraries.ComponentBehaviorTree

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local BossBoarMobConfig = ReplicatedModules.Data.Mobs.Mobs.BossBoar
local AnimationService  = ReplicatedModules.Services.AnimationService

local SystemsContainer = {}

local Module = {}

function Module.Create(Model: Model, Humanoid: Humanoid, _HumanoidRootPart: BasePart, mobId: string)
	local LoadedAnimations = {}
	if BossBoarMobConfig.Animations then
		LoadedAnimations = AnimationService.LoadAnimationsDictionary(Humanoid.Animator, BossBoarMobConfig.Animations)
	end

	-- BossBoar gets a baseline HP bump so phases feel meaningful.
	-- Per-floor difficulty scaling already runs in EnemyServer.InitializeMob;
	-- this multiplier compounds on top of that.
	local BOSS_HP_BUMP = 12
	Humanoid.MaxHealth = Humanoid.MaxHealth * BOSS_HP_BUMP
	Humanoid.Health = Humanoid.MaxHealth

	-- Slightly larger model. Visually distinguishes the boss without
	-- needing a separate art asset.
	for _, descendant in Model:GetDescendants() do
		if descendant:IsA('BasePart') then
			descendant.Size = descendant.Size * 1.4
		end
	end

	Humanoid.WalkSpeed = BossBoarMobConfig.WalkSpeed

	return {
		ID = mobId,
		Config = BossBoarMobConfig,
		Model = Model,
		Humanoid = Humanoid,
		HumanoidRootPart = Model:FindFirstChild('HumanoidRootPart'),
		Animations = LoadedAnimations,
	}
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

function Module.Start() end

-- Empty placeholder BT. BossServer attaches its own per-boss sequence
-- to its own BehaviorTree on Initialize; this stub exists only so
-- EnemyServer.InitializeMob's AICharacterClasses[mobId].BehaviorTree
-- access doesn't error. The empty BT does nothing each tick — all
-- behavior comes from BossServer.
Module.BehaviorTree = ComponentBehaviorTree.BehaviorTreeFactory.build_from_nested(
	ComponentBehaviorTree.NodeFactory.delay(60)
)

return Module
]]></Source>
		<Source path="ServerStorage/Core/DataEditServer"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local LevelingConfigModule = ReplicatedModules.Data.Leveling
local DifficultyConfig = ReplicatedModules.Data.Difficulty
local BoostersConfig = ReplicatedModules.Data.Boosters
local AchievementsConfig = ReplicatedModules.Data.Achievements
local StatisticsConfig = ReplicatedModules.Data.StatisticsConfig
local TableUtility = ReplicatedModules.Utility.Table

local SystemsContainer = {}

-- // Module // --
local Module = {}

-- give experience to the player
function Module.GiveExperienceToPlayer( LocalPlayer, amount )
	local SaveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData( LocalPlayer )
	if not SaveData then
		return
	end

	-- Insight bonus: each level grants +5% XP. Looked up via AttributeServer
	-- so the formula stays in the config (Attributes.luau) — this site just
	-- multiplies the incoming amount by (1 + bonus).
	if SystemsContainer.AttributeServer
		and SystemsContainer.AttributeServer.GetPlayerBonus then
		local insight = SystemsContainer.AttributeServer.GetPlayerBonus(LocalPlayer, 'Insight')
		amount = math.floor(amount * (1 + insight) + 0.5)
	end

	-- Difficulty XP scale. HARD = +10%, DEATH = +25%. Applied AFTER
	-- Insight so the difficulty multiplier compounds with the level
	-- bonus (a level-10 player on DEATH gets 1.25 × Insight). Routed
	-- through the shared registry so adding a tier is a one-file edit.
	if SaveData.Difficulty then
		local xpMul = DifficultyConfig.GetMultipliers(SaveData.Difficulty).ExperienceMul
		if xpMul ~= 1 then
			amount = math.floor(amount * xpMul + 0.5)
		end
	end

	-- Booster XP multiplier. Applied LAST so booster stacks compound
	-- on top of Insight × Difficulty. BoostersServer.GetMultiplier
	-- returns 1 when no booster of this kind is active, so the
	-- short-circuit guard isn't strictly needed — kept for symmetry
	-- with the Difficulty branch above.
	if SystemsContainer.BoostersServer
		and SystemsContainer.BoostersServer.GetMultiplier then
		local boosterMul = SystemsContainer.BoostersServer.GetMultiplier(LocalPlayer, BoostersConfig.Kinds.ExperienceMul)
		if boosterMul ~= 1 then
			amount = math.floor(amount * boosterMul + 0.5)
		end
	end

	-- Achievement progress: total currency-earned style triggers care
	-- about XP too in some games; we keep XP triggerless here. Keep
	-- this comment as a reminder if a 'total_xp_earned' achievement
	-- shows up later — wire it on the same line as the increment below.


	-- Stat hook: total XP earned across the player's career. Tracks
	-- the post-multiplier (post-Insight, post-Difficulty, post-booster)
	-- amount because that's what actually moved the player's level —
	-- raw XP-pre-multipliers would understate progression on hard
	-- difficulty / with active boosters.
	if SystemsContainer.StatisticsServer and amount > 0 then
		SystemsContainer.StatisticsServer.Increment(LocalPlayer,
			StatisticsConfig.StatisticIds.LevelExperienceTotal, amount)
	end

	-- Defensive nil-coalesce: pre-skill-system saves carry no SkillPoints
	-- field, and ReconcileSaves only patches saves with a stale Version
	-- number. A live save at the current Version with a missing field
	-- still hits this path. Same for Experience / Level — cheap guard.
	SaveData.Experience = (SaveData.Experience or 0) + amount
	SaveData.Level = SaveData.Level or 1
	SaveData.SkillPoints = SaveData.SkillPoints or 0

	if SaveData.Level == LevelingConfigModule.MaxLevel then
		return
	end

	local levelsGained = 0
	local requiredExperience = LevelingConfigModule.GetExperienceToLevel( SaveData.Level)
	while SaveData.Experience > requiredExperience and SaveData.Level < LevelingConfigModule.MaxLevel do
		SaveData.Level += 1
		SaveData.Experience -= requiredExperience
		levelsGained += 1

		-- Skill points are the only level-up reward now. Attributes grow
		-- purely from XP earned in-world via AttributeServer, so there's
		-- no parallel point pool to grant here.
		SaveData.SkillPoints += 1

		requiredExperience = LevelingConfigModule.GetExperienceToLevel( SaveData.Level)
	end

	-- Level-up notifications. Toast + level-up VFX cue both rendered
	-- client-side; the server side just emits the cue per level-up.
	if levelsGained > 0 then
		-- Achievement fan-out: counter trigger for level_up, and a full
		-- predicate sweep so level-gated achievements (level_10 / 25 /
		-- max) light up immediately rather than on next join.
		if SystemsContainer.AchievementsServer then
			if SystemsContainer.AchievementsServer.IncrementProgress then
				SystemsContainer.AchievementsServer.IncrementProgress(LocalPlayer, AchievementsConfig.Triggers.LevelUp, levelsGained)
			end
			if SystemsContainer.AchievementsServer.RunUnlockPass then
				SystemsContainer.AchievementsServer.RunUnlockPass(LocalPlayer)
			end
		end

		-- Companion XP feed: equipped companion gets a fraction of the
		-- player's XP gain. Hooks into CompanionsServer if loaded.
		if SystemsContainer.CompanionsServer
			and SystemsContainer.CompanionsServer.OnPlayerEarnedXP then
			SystemsContainer.CompanionsServer.OnPlayerEarnedXP(LocalPlayer, amount)
		end
		-- Toast.
		if SystemsContainer.ToastServer
			and SystemsContainer.ToastServer.NotifyLevelUp then
			SystemsContainer.ToastServer.NotifyLevelUp(LocalPlayer, SaveData.Level)
		end
		-- VFX cue. The client LevelUpClient subscribes via the
		-- canonical LevelUpEvent remote and renders the placeholder
		-- effect (print stub for now per design).
		if SystemsContainer.LevelUpServer
			and SystemsContainer.LevelUpServer.NotifyLevelUp then
			SystemsContainer.LevelUpServer.NotifyLevelUp(LocalPlayer, SaveData.Level, levelsGained)
		end
	end
end

function Module.GiveCurrencyToPlayer( LocalPlayer, currency )
	local SaveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData( LocalPlayer )
	if not SaveData then
		return
	end

	-- Booster currency multiplier. Applied to incoming currency before
	-- adding to the wallet so a booster grant from any source (loot,
	-- quest reward, achievement claim) all benefit equally. Multiplier
	-- is 1 when no booster is active.
	if SystemsContainer.BoostersServer
		and SystemsContainer.BoostersServer.GetMultiplier then
		local boosterMul = SystemsContainer.BoostersServer.GetMultiplier(LocalPlayer, BoostersConfig.Kinds.CurrencyMul)
		if boosterMul ~= 1 then
			currency = math.floor(currency * boosterMul + 0.5)
		end
	end

	SaveData.Currency += currency

	-- Stat hook: gold earned vs spent. Positive currency events count
	-- as earned; negative ones (vendor purchases, repair costs) count
	-- toward GoldSpent. Magnitude is recorded — both stats grow over
	-- the player's career.
	if SystemsContainer.StatisticsServer then
		local IDS = StatisticsConfig.StatisticIds
		if currency > 0 then
			SystemsContainer.StatisticsServer.Increment(LocalPlayer, IDS.GoldEarned, currency)
		elseif currency < 0 then
			SystemsContainer.StatisticsServer.Increment(LocalPlayer, IDS.GoldSpent, -currency)
		end
	end

	-- Counter achievements care about lifetime currency earned. Routed
	-- through AchievementsServer's trigger fan-out so the registry
	-- decides which achievements (rich_i, rich_ii, …) bump.
	if SystemsContainer.AchievementsServer
		and SystemsContainer.AchievementsServer.IncrementProgress then
		SystemsContainer.AchievementsServer.IncrementProgress(LocalPlayer, AchievementsConfig.Triggers.CurrencyEarned, currency)
	end
end

-- Reputation grant. Save field exists in the template (Reputation = 0)
-- but no caller wires here yet — this helper is the canonical entry
-- point so the booster multiplier is automatically honored when the
-- reputation system lands.
function Module.GiveReputationToPlayer(LocalPlayer: Player, amount: number)
	local SaveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(LocalPlayer)
	if not SaveData or amount == 0 then return end
	if SystemsContainer.BoostersServer
		and SystemsContainer.BoostersServer.GetMultiplier then
		local mul = SystemsContainer.BoostersServer.GetMultiplier(LocalPlayer, BoostersConfig.Kinds.ReputationMul)
		if mul ~= 1 then
			amount = math.floor(amount * mul + 0.5)
		end
	end
	SaveData.Reputation = (SaveData.Reputation or 0) + amount
end

-- Bounty grant + decay. Bounty boosters reduce decay rate (a "lay low"
-- effect): `decayPerSecond = base * bounty_decay_mul`, so a 1.5×
-- multiplier means bounty fades 50% faster. The decay loop itself is
-- not yet implemented — this helper is the canonical entry point and
-- exposes a `GetBountyDecayMultiplier` accessor for the future system.
function Module.GiveBountyToPlayer(LocalPlayer: Player, amount: number)
	local SaveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(LocalPlayer)
	if not SaveData or amount == 0 then return end
	SaveData.Bounty = math.max(0, (SaveData.Bounty or 0) + amount)
end

function Module.GetBountyDecayMultiplier(LocalPlayer: Player): number
	if SystemsContainer.BoostersServer
		and SystemsContainer.BoostersServer.GetMultiplier then
		return SystemsContainer.BoostersServer.GetMultiplier(LocalPlayer, BoostersConfig.Kinds.BountyDecayMul)
	end
	return 1
end

-- Wipe a player's data back to the template defaults. Works on both
-- currently-loaded profiles AND offline UserIds — for offline ids we load
-- the profile, mutate it, then release so the lock doesn't leak.
function Module.WipeUserId(UserId: number)
	local DataManager = SystemsContainer.DataManagerServer
	-- Was the profile already loaded by an active session? If so we must
	-- NOT release after the wipe — the player session still owns the lock,
	-- and releasing it would kick them. The cache is module-private, so we
	-- proxy by checking active Players for the UserId.
	local wasAlreadyLoaded = false
	for _, player in game:GetService('Players'):GetPlayers() do
		if player.UserId == UserId then
			wasAlreadyLoaded = true
			break
		end
	end

	local ok, profile = DataManager.LoadUserIdProfile(UserId)
	if not ok or not profile then
		return false, profile -- profile slot carries the error string here
	end

	-- Wipe every existing key, then deep-copy the template back in. We
	-- mutate `profile.Data` in place (don't reassign) because ProfileService
	-- only saves mutations to the existing table reference.
	for key, _ in profile.Data do
		profile.Data[key] = nil
	end
	for propName, propValue in TableUtility.DeepCopy(DataManager.TemplateData) do
		profile.Data[propName] = propValue
	end

	if not wasAlreadyLoaded then
		profile:Release()
	end
	return true
end

function Module.Start()

end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/LootTableServer"><![CDATA[
local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))
local LootTablesData = ServerModules.Data.LootTables

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local DifficultyConfig = require(ReplicatedStorage:WaitForChild('Modules')).Data.Difficulty
local ItemsConfig = ServerModules.Data.Items  -- migrated to per-player config replication; server reads canonical.
local BoostersConfig = require(ReplicatedStorage:WaitForChild('Modules')).Data.Boosters

local SystemsContainer = {}

-- // Module // --
local Module = {}

----------------------------------------------------------------------
-- Roll a multi-drop loot table by id. Awards every successful drop:
--   * 'aura:<id>'  → AurasServer.AttemptUnlockAura (no inventory)
--   * '<itemId>'   → PlayerInventoryServer.GiveQuantityOfItemIdToPlayer
-- Currency / Experience are also applied if the table sets them.
-- Returns the raw award list for callers that want to render a toast.
----------------------------------------------------------------------
function Module.RollLootTable( player, lootTable )
	if typeof(lootTable) == 'string' then
		lootTable = LootTablesData.MobLootTables[lootTable]
			or LootTablesData.BossLootTables[lootTable]
	end
	if not lootTable then return {} end
	local saveData = SystemsContainer.SavesManagerServer
		and SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData then return {} end

	-- Currency + experience first.
	local RNG = Random.new()
	if lootTable.Currency then
		local amount = typeof(lootTable.Currency) == 'table'
			and RNG:NextInteger(unpack(lootTable.Currency))
			or lootTable.Currency
		SystemsContainer.DataEditServer.GiveCurrencyToPlayer(player, amount)
	end
	if lootTable.Experience then
		local amount = typeof(lootTable.Experience) == 'table'
			and RNG:NextInteger(unpack(lootTable.Experience))
			or lootTable.Experience
		SystemsContainer.DataEditServer.GiveExperienceToPlayer(player, amount)
	end

	-- Multi-drop rolls: resolve via LootTables helper, then route each
	-- award by prefix. Difficulty.LuckMul is forwarded so every chance
	-- roll inside ResolveDropRoll gets boosted (HARD = +10%, DEATH =
	-- +25%). Currency / Experience scaling is handled separately by
	-- their own difficulty hooks (XP via DataEditServer); only the
	-- per-drop probability rolls flow through luck here.
	local luckMul = DifficultyConfig.GetMultipliers(saveData.Difficulty).LuckMul

	-- Booster: rarity bias re-weights the pool toward higher-rarity
	-- entries. ItemsConfig.Items[id].Rarity is the rank (1..N) — passed
	-- in as a lookup closure so the data module stays Items-agnostic.
	local rarityBias = SystemsContainer.BoostersServer
		and SystemsContainer.BoostersServer.GetMultiplier
		and SystemsContainer.BoostersServer.GetMultiplier(player, BoostersConfig.Kinds.LootRarityBias)
		or 1
	local rarityLookup = function(itemId)
		local cfg = ItemsConfig.Items[itemId]
		return cfg and cfg.Rarity or 1
	end

	local awards = LootTablesData.ResolveMultiDrops(lootTable, luckMul, rarityBias, rarityLookup)

	-- Booster: loot quantity multiplier scales every non-aura award's
	-- count post-roll. Aura awards are unique unlocks (no quantity), so
	-- we skip them in the multiply branch below.
	local quantityMul = SystemsContainer.BoostersServer
		and SystemsContainer.BoostersServer.GetMultiplier
		and SystemsContainer.BoostersServer.GetMultiplier(player, BoostersConfig.Kinds.LootQuantityMul)
		or 1

	for _, award in awards do
		if quantityMul ~= 1 and not string.match(award.ItemId, '^aura:') then
			award.Quantity = math.max(1, math.floor(award.Quantity * quantityMul + 0.5))
		end
	end
	for _, award in awards do
		local prefix = string.match(award.ItemId, '^([^:]+):')
		if prefix == 'aura' then
			local auraId = string.sub(award.ItemId, #'aura:' + 1)
			if SystemsContainer.AurasServer
				and SystemsContainer.AurasServer.AttemptUnlockAura then
				SystemsContainer.AurasServer.AttemptUnlockAura(player, auraId)
				-- Toast surface: server-side ToastServer fans the unlock
				-- to the client. AurasServer doesn't auto-toast since
				-- not every unlock path is loot-table-driven.
				if SystemsContainer.ToastServer
					and SystemsContainer.ToastServer.NotifyAuraUnlocked then
					SystemsContainer.ToastServer.NotifyAuraUnlocked(player, auraId)
				end
			end
		else
			SystemsContainer.PlayerInventoryServer.GiveQuantityOfItemIdToPlayer(
				player, award.ItemId, award.Quantity)
			if SystemsContainer.ToastServer
				and SystemsContainer.ToastServer.NotifyItemReceived then
				SystemsContainer.ToastServer.NotifyItemReceived(
					player, award.ItemId, award.Quantity)
			end
		end
	end

	return awards
end

function Module.GiveRewardTableToPlayer( LocalPlayer, RewardsTable )
	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData( LocalPlayer )
	if not saveData then
		return
	end

	if RewardsTable.Currency then
		SystemsContainer.DataEditServer.GiveCurrencyToPlayer( LocalPlayer, RewardsTable.Currency )
	end

	if RewardsTable.Experience then
		SystemsContainer.DataEditServer.GiveExperienceToPlayer( LocalPlayer, RewardsTable.Experience )
	end

	if RewardsTable.Items then
		for itemId, quantity in RewardsTable.Items do
			SystemsContainer.PlayerInventoryServer.GiveQuantityOfItemIdToPlayer( LocalPlayer, itemId, quantity )
		end
	end

	if RewardsTable.Attributes then
		for _, attributeId in RewardsTable.Attributes do
			SystemsContainer.AttributeServer.GiveAttributeToPlayer( LocalPlayer, attributeId )
		end
	end

	--[[
		if RewardsTable.Skills then

		end
	]]

	--[[
		if RewardsTable.Quests then
			for _, questId in RewardsTable.Quests do
				SystemsContainer.QuestsService.GiveQuestOfId( LocalPlayer, questId )
			end
		end
	]]

	--[[
		if RewardsTable.Dialogue then

		end
	]]

	--[[
		if RewardsTable.Callbacks then

		end
	]]
end

function Module.Start()

end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/QuestServer"><![CDATA[
export type BaseQuestData = {
	SubQuestIndex: number,
	Contributions: {[string]: number},
	is_tracked: boolean,
}

export type DataQuestContainer = {
	-- [questId]
	[string]: {
		-- [uuid]: QuestData
		[string]: BaseQuestData
	}
}

export type PlayerDataBase = {
	Quests: DataQuestContainer,
	ActiveQuests: {[string] : {string}}
}

local HttpService = game:GetService('HttpService')
local Players = game:GetService('Players')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local QuestsConfigModule = ReplicatedModules.Data.Quests
local StatisticsConfig = ReplicatedModules.Data.StatisticsConfig
local ZoneService = ReplicatedModules.Services.ZoneService
local TableUtility = ReplicatedModules.Utility.Table

local RemoteService = ReplicatedModules.Services.RemoteService
local QuestEvent = RemoteService.GetRemote('QuestEvent', 'RemoteEvent', false)

-- Job dispatcher for the single QuestEvent remote (mirrors the pattern in
-- EquipmentRendererServer / EquipmentRendererClient — one RemoteEvent,
-- integer-enum first argument). Mirror this table on any client that
-- fires the remote so the two sides stay in sync.
local RemoteJobs = { ToggleTracked = 1 }

local SystemsContainer = {}

-- // Module // --
local Module = {}

-- Re-export so client modules can require the server module's enum table
-- in shared environments (and so refactors of the integer values only
-- need to touch one place).
Module.RemoteJobs = RemoteJobs

function Module.CreateBaseQuest(): BaseQuestData
	return {
		SubQuestIndex = 1,
		Contributions = {},
		is_tracked = false,
	}
end

function Module.GiveQuestOfId(player: Player, questId: string): string?
	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData then
		return nil
	end

	local questConfig = QuestsConfigModule.GetConfigFromId(questId)
	if not questConfig then
		warn('Could not find quest of id: '..tostring(questId))
		return nil
	end

	local canAcquire, response = QuestsConfigModule.CanAcquireQuestOfId(questId, saveData)
	if not canAcquire then
		return response
	end

	-- create the questId cache if it doesnt exist
	if not saveData.ActiveQuests[questId] then
		saveData.ActiveQuests[questId] = {}
	end

	-- create the quest in the questId dictionary
	local uuid = HttpService:GenerateGUID(false)
	saveData.ActiveQuests[questId][uuid] = Module.CreateBaseQuest()
	return uuid
end

function Module.RemoveQuestOfUUID(player: Player, uuid: string)
	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData then
		return
	end
	local removed = false
	for _, uuidDict in saveData.ActiveQuests do
		if uuidDict[uuid] then
			uuidDict[uuid] = nil
			removed = true
			break
		end
	end
	-- Stat hook: only count REAL abandons (a uuid that existed and got
	-- cleared). A no-op call on an already-removed uuid (race / dup
	-- client request) doesn't bump the counter.
	if removed and SystemsContainer.StatisticsServer then
		SystemsContainer.StatisticsServer.Increment(player,
			StatisticsConfig.StatisticIds.QuestsAbandoned, 1)
	end
end

-- Flips the `is_tracked` boolean on the quest entry identified by `uuid`.
-- Returns the new value (or nil if the uuid wasn't found / save missing).
-- Idempotent on repeated invocation: each call toggles the bit, so the
-- client's optimistic "flip locally and fire remote" pattern naturally
-- converges as long as fires aren't dropped.
function Module.ToggleQuestTrackedFromUUID(player: Player, uuid: string): boolean?
	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData then
		return nil
	end
	for _, uuidDict in saveData.ActiveQuests do
		local questData = uuidDict[uuid]
		if questData then
			questData.is_tracked = not (questData.is_tracked == true)
			return questData.is_tracked
		end
	end
	return nil
end

function Module.RewardQuestOfId(player: Player, questId: string)
	local questConfig = QuestsConfigModule.GetConfigFromId(questId)
	if not questConfig then
		warn(string.format('Could not find quest of id %s', tostring(questId)))
		return
	end

	SystemsContainer.LootTableServer.GiveRewardTableToPlayer(
		player, questConfig.Rewards
	)
end

function Module.IncrementSubQuestFromQuestUUID(player: Player, uuid: string, ignoreUpdate: boolean?)
	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData then
		return
	end

	for _, uuidDict in saveData.ActiveQuests do
		local questData = uuidDict[uuid]
		if not questData then
			continue
		end
		questData.Contributions = {}
		questData.SubQuestIndex += 1
		break
	end

	if not ignoreUpdate then
		Module.CheckPlayerQuestStates(player)
	end
end

function Module.CheckPlayerQuestStates(player: Player)
	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData then
		return
	end

	for questId, uuidDict in saveData.ActiveQuests do
		local questConfig = QuestsConfigModule.GetConfigFromId(questId)
		if not questConfig then
			warn(string.format("Could not find quest of given id %s", tostring(questId)))
			continue
		end

		-- check all quest sub-quests to see if they are completed,
		-- if so increment sub-quest indexes
		for questUUID, questData in uuidDict do
			if questData.SubQuestIndex > #questConfig.SubQuests then
				continue
			end
			if QuestsConfigModule.IsSubQuestCompletedFromUUID(questUUID, saveData) then
				Module.IncrementSubQuestFromQuestUUID(player, questUUID, true)
			end
		end

		-- check over the quests to see if they are completed
		for questUUID, _ in uuidDict do
			if QuestsConfigModule.IsQuestOfUUIDCompleted(questUUID, saveData) then
				-- keep this ordering so that if RewardQuest fails,
				-- they can repeat the quest again at the least since
				-- completed quests is not incremented
				uuidDict[questUUID] = nil

				local success, err = pcall(function()
					Module.RewardQuestOfId(player, questId)
				end)
				if not success then
					warn(string.format("Quest Reward Function error: %s", err))
					continue
				end

				if saveData.CompletedQuests[questId] then
					saveData.CompletedQuests[questId] += 1
				else
					saveData.CompletedQuests[questId] = 1
				end

				-- Stat hook: lifetime quest completions counter (one
				-- bump per completion event, including repeat completions
				-- of the same questId — matches the saveData.CompletedQuests
				-- shape).
				if SystemsContainer.StatisticsServer then
					SystemsContainer.StatisticsServer.Increment(player,
						StatisticsConfig.StatisticIds.QuestsCompleted, 1)
				end

				if not questConfig.Continuation then
					continue
				end
				for _, nextQuestId in questConfig.Continuation do
					Module.GiveQuestOfId(player, nextQuestId)
				end
			end
		end

		-- if that questid cache is empty, remove it
		local count: number = TableUtility.CountDictionary(uuidDict)
		if count == 0 then
			saveData.ActiveQuests[questId] = nil
		end
	end
end

function Module.AppendQuestContributions(player: Player, contributionType: string, contributionId: string, amount: number?)
	amount = amount or 1

	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData then
		return
	end

	for questId, uuidCache in saveData.ActiveQuests do
		local questConfig = QuestsConfigModule.GetConfigFromId(questId)
		if not questConfig then
			warn('Could not find quest of id: '..tostring(questId))
			continue
		end
		for _, questData in uuidCache do
			if not QuestsConfigModule.IsValidSubQuestContribution(questId, questData.SubQuestIndex, contributionType, contributionId) then
				continue
			end
			if not questData.Contributions[contributionType] then
				questData.Contributions[contributionType] = {}
			end
			if QuestsConfigModule.IsArrayTypeContrib(contributionType) then
				table.insert(questData.Contributions[contributionType], contributionId)
			else
				if questData.Contributions[contributionType][contributionId] then
					questData.Contributions[contributionType][contributionId] += 1
				else
					questData.Contributions[contributionType][contributionId] = 1
				end
			end
		end
	end

	Module.CheckPlayerQuestStates(player)
end

function Module.Start()

	ZoneService.ZoneEnter:Connect(function(character: Instance, regionName: string)
		local player = Players:GetPlayerFromCharacter(character)
		if not player then
			return
		end
		Module.AppendQuestContributions(player, QuestsConfigModule.ArrayContributions.Visit, regionName, 1)
	end)

	-- Dispatcher for the single QuestEvent remote. New jobs slot in here
	-- as additional `elseif jobEnum == RemoteJobs.X then` branches.
	QuestEvent.OnServerEvent:Connect(function(player: Player, jobEnum: number, ...)
		if jobEnum == RemoteJobs.ToggleTracked then
			local uuid = ...
			if typeof(uuid) ~= 'string' then
				return
			end
			Module.ToggleQuestTrackedFromUUID(player, uuid)
		end
	end)

end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module]]></Source>
		<Source path="ServerStorage/Core/GameControllerServer"><![CDATA[
local CollectionService = game:GetService('CollectionService')
local Debris = game:GetService('Debris')
local PhysicsService = game:GetService('PhysicsService')
local Players = game:GetService('Players')

local ServerStorage = game:GetService("ServerStorage")
local ServerModules = require(ServerStorage:WaitForChild("Modules"))

local FloorDataModule = ServerModules.Data.FloorData

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local DiscoveryData = ReplicatedModules.Data.Discovery
local DifficultyConfig = ReplicatedModules.Data.Difficulty
local StatisticsConfig = ReplicatedModules.Data.StatisticsConfig
local MaidClassModule = ReplicatedModules.Modules.Maid
local ZoneService = ReplicatedModules.Services.ZoneService
local ReplicatedData = ReplicatedModules.Services.ReplicatedData

local DamageServerModule = ServerModules.Modules.DamageModule

-- Per-player session bookkeeping for stat hooks. Cleared on
-- PlayerRemoving so the table doesn't accumulate stale entries.
--   _SessionStart[player]   = epoch seconds when the player joined
--   _LifeStart[player]      = epoch seconds since the last spawn
local _SessionStart: {[Player]: number} = {}
local _LifeStart: {[Player]: number}    = {}

local RemoteService = ReplicatedModules.Services.RemoteService
local DiscoveryEvent = RemoteService.GetRemote('DiscoveryEvent', 'RemoteEvent', false)

local SystemsContainer = {}

-- Partitions PlayerData into independently dirty-tracked replication scopes.
-- Listed top-level keys get their own JSON snapshot in ReplicatedData; the
-- top-level scalars (Version, Level, Experience, Currency, etc.) flow through
-- the implicit main scope. Keep in sync with EmptySaveTemplate.
local PLAYER_DATA_SUB_PATHS : { string } = {
	'Inventory',
	'Mounts',
	'Companions',
	'Crafting',
	'SocketedGems',
	'Auras',
	'Onboarding',
	'FFlags',
	'Consumables',
	'Storages',
	'Waystones',
	'Discoveries',
	'Equipped',
	'EquippedLoadouts',
	'BaseCustomizations',
	'Titles',
	'Attributes',
	'Skills',
	'Settings',
	'Hotbar',
	'Keybinds',
	'ActionKeybinds',
	'ActiveQuests',
	'CompletedQuests',
	'Achievements',
	'Progression',
	'Guild',
	'Analytics',
	'Purchases',
}

-- // Module // --
local Module = {}

function Module.OnCharacterAdded(player: Player, Character)
	local Humanoid = Character:WaitForChild('Humanoid', 5)
	if not Humanoid then
		return
	end

	-- wait for save data to load
	local Data = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData( player )
	while (not Data) and player:IsDescendantOf(Players) do
		task.wait(1)
		Data = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData( player )
	end
	if not player.Parent then
		return
	end

	-- set character information
	Character:SetAttribute("Level", Data.Level)
	CollectionService:AddTag(Character, 'PLAYER_CHARACTER')
	CollectionService:AddTag(Character, 'OVERHEAD_INFO')
	CollectionService:AddTag(Character, 'OVERHEAD_CRYSTAL')

	local Maid = MaidClassModule.New()
	Maid:Give(Humanoid.HealthChanged:Connect(function()
		Character:SetAttribute("Level", tostring(Data.Level))
	end))

	for _, object in Character:GetDescendants() do
		if object:IsA('BasePart') then
			object.CollisionGroup = 'Players'
		end
	end

	-- Stat hook: snapshot the spawn moment so death can compute
	-- LongestLife. The previous spawn's _LifeStart (if any) is
	-- overwritten — only the current life matters.
	_LifeStart[player] = os.time()

	Maid:Give(Humanoid.Died:Connect(function()
		-- Stat hooks: deaths total + PvE/PvP split, longest-life record,
		-- kill-streak reset. PvE/PvP attribution reads the recent damage
		-- tags via DamageModule.GetHumanoidTags — any Player in the
		-- contributors list classifies the kill as PvP.
		local Stats = SystemsContainer.StatisticsServer
		if Stats then
			local IDS = StatisticsConfig.StatisticIds
			Stats.Increment(player, IDS.DeathsTotal, 1)
			-- PvP detection: was a Player in the recent damage tags?
			local pvp = false
			local tags = DamageServerModule.GetHumanoidTags(Humanoid)
			for tagPlayer in tags do
				-- The tags table is keyed by the contributor (Player or
				-- Instance); only Player keys count toward PvP.
				if typeof(tagPlayer) == 'Instance' and tagPlayer:IsA('Player') and tagPlayer ~= player then
					pvp = true; break
				end
			end
			Stats.Increment(player, pvp and IDS.DeathsPvP or IDS.DeathsPvE, 1)
			-- Longest life — from spawn to now.
			local lifeStart = _LifeStart[player]
			if lifeStart then
				Stats.SetMax(player, IDS.LongestLifeSeconds, os.time() - lifeStart)
			end
			-- Kill streak resets on death.
			Stats.Reset(player, IDS.CurrentKillStreak)
		end
		_LifeStart[player] = nil

		Maid:Cleanup()
		Character.Archivable = true
		CollectionService:RemoveTag(Character, 'PLAYER_CHARACTER')
		CollectionService:RemoveTag(Character, 'OVERHEAD_INFO')
		CollectionService:RemoveTag(Character, 'OVERHEAD_CRYSTAL')

		local fakeCharacter = Character:Clone()
		fakeCharacter.Name = ''
		local fakeHumanoid = Character:FindFirstChildWhichIsA('Humanoid')
		if fakeHumanoid then
			fakeHumanoid:Destroy()
		end

		for _, BasePart in fakeCharacter:GetDescendants() do
			if BasePart:IsA("BasePart") then
				BasePart.Anchored = true
				BasePart.CanCollide = false
				BasePart.CanTouch = false
				BasePart.CanQuery = false
			end
		end

		player.Character = nil
		Character:Destroy()

		fakeCharacter.Parent = workspace
		task.delay(0.01, function()
			CollectionService:AddTag(fakeCharacter, 'DEATH_EFFECT')
		end)
		Debris:AddItem(fakeCharacter, 9)

		task.wait(3) -- respawn time
		player:LoadCharacterAsync()
	end))

	repeat
		task.wait()
	until (not player.Character) or player.Character:IsDescendantOf(workspace)

	if not player.Character then
		return
	end

	local Forcefield = Character:FindFirstChildWhichIsA('ForceField')
	if Forcefield then
		Forcefield:Destroy()
	end

	-- Re-apply saveData.Equipped to the freshly-spawned character so the
	-- two stores (persisted map + character attributes / rendered models)
	-- stay in sync. Without this, on first spawn or any respawn the data
	-- says "equipped" but the character has no weapon attached — and the
	-- equip-toggle path in PlayerInventoryServer reads saveData.Equipped
	-- as truth, so the first hotbar click "unequips" something that was
	-- never visible, requiring a second click to actually equip.
	if SystemsContainer.PlayerInventoryServer
		and SystemsContainer.PlayerInventoryServer.AttemptPlayerReEquipItems then
		SystemsContainer.PlayerInventoryServer.AttemptPlayerReEquipItems(player)
	end

	-- Vitality bonus: scale the spawned humanoid's MaxHealth by the
	-- player's Vitality bonus (+10% per level). Read once at spawn so
	-- subsequent damage / heal calls don't pay the lookup. Heal-to-full
	-- happens *after* the multiplier so the player spawns at the boosted
	-- HP cap rather than at default Humanoid.MaxHealth.
	if SystemsContainer.AttributeServer
		and SystemsContainer.AttributeServer.GetPlayerBonus then
		local vitality = SystemsContainer.AttributeServer.GetPlayerBonus(player, 'Vitality')
		if vitality > 0 then
			Humanoid.MaxHealth = Humanoid.MaxHealth * (1 + vitality)
			Humanoid.Health = Humanoid.MaxHealth
		end
	end

	-- Difficulty HP scale. HARD shaves 10% off the cap, DEATH shaves 25%.
	-- Resolves through the shared registry so adding a tier doesn't
	-- require an edit here. Applied AFTER vitality so the difficulty
	-- multiplier compounds correctly (vitality scales the base, then
	-- difficulty re-scales the boosted cap). Heal-to-full again so the
	-- player spawns at the new ceiling rather than carrying the pre-
	-- difficulty Health value.
	local saveData = SystemsContainer.SavesManagerServer
		and SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if saveData and saveData.Difficulty then
		local mul = DifficultyConfig.GetMultipliers(saveData.Difficulty).HealthMul
		if mul ~= 1 then
			Humanoid.MaxHealth = Humanoid.MaxHealth * mul
			Humanoid.Health = Humanoid.MaxHealth
		end
	end
end

local PLAYER_COSMETIC_CACHE = {}

function Module.OnPlayerAdded(player: Player)
	print(player.Name, 'has joined the game.')

	-- Stat hook: snapshot session start so OnPlayerRemoving can compute
	-- the session length. Stamped before profile load so an early
	-- kick (failed load below) doesn't silently miss the marker — even
	-- a 5-second zombie-kicked session still counts as one session
	-- played from the player's perspective.
	_SessionStart[player] = os.time()

	local success, _ = SystemsContainer.DataManagerServer.LoadPlayerProfile(player, false)
	if not success then
		player:Kick(string.format("Failed to load player %s profile.", player.Name))
		return
	end

	local saveIndex = SystemsContainer.TeleportServer.GetSaveIndexFromTeleportData( player )
	if not saveIndex then
		player:Kick("TeleportData was invalid - rejoin.")
		return
	end

	SystemsContainer.SavesManagerServer.ReconcileSaves( player )
	-- precompute uuid -> itemId cache for the player

	SystemsContainer.SavesManagerServer.SelectSaveIndex( player, saveIndex )

	local Data = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData( player )
	if not Data then
		print('Could not get the save data for the player; ', player.Name)
		ReplicatedData.RemoveDataForPlayer( "PlayerData", player )
		player:Kick('Failed to load your data!')
		return
	end

	print('Started replicating player data for player; ', player.Name)
	-- print( HttpService:JSONEncode(Data) )
	local floorName = SystemsContainer.TeleportServer.GetActiveFloorName()
	Data.CurrentFloor = SystemsContainer.TeleportServer.GetActiveFloorNumber()
	player:SetAttribute('CurrentFloor', floorName)
	ReplicatedData.SetData("PlayerData", Data, {player}, PLAYER_DATA_SUB_PATHS)
	PLAYER_COSMETIC_CACHE[player.Name] = Data.BaseCustomizations

	-- TEST WEAPONS — give the player two wooden swords on first join.
	-- Intentionally NOT auto-equipped: the prior test path called
	-- AttemptPlayerEquipItemOfUUID here, which populated
	-- saveData.Equipped before the player ever clicked the hotbar.
	-- Result: the first hotbar click "unequipped" something the user
	-- had never visibly equipped (toggle path read saveData as truth),
	-- requiring a second click to re-equip. Leaving Equipped empty on
	-- first join makes the first click the equip click, matching player
	-- expectation. Persistence handles subsequent sessions — anything
	-- the player equipped before logging out comes back via
	-- PlayerInventoryServer.AttemptPlayerReEquipItems on CharacterAdded.
	if #SystemsContainer.PlayerInventoryServer.GetItemUUIDsOfItemId(player, 'WoodenSword') == 0 then
		SystemsContainer.PlayerInventoryServer.GenerateUUIDToItemId(player)
		SystemsContainer.PlayerInventoryServer.GiveQuantityOfItemIdToPlayer(player, 'WoodenSword', 2)
	end

	-- TEST QUESTS
	-- Seed the gameplay-blank menu fixtures (defined in Quests.luau) into
	-- the player's saveData on first join. Real ActiveQuests entries with
	-- real uuids — so QuestEvent dispatches like RemoteJobs.ToggleTracked
	-- can find and mutate them, and ReplicatedData replicates the result
	-- back to the client through the normal path.
	local TEST_QUESTS = {
		{ id = 'MenuTestQuest_A', subQuestIndex = 2, isTracked = true  },
		{ id = 'MenuTestQuest_B', subQuestIndex = 1, isTracked = false },
	}
	for _, seed in TEST_QUESTS do
		local existing = Data.ActiveQuests and Data.ActiveQuests[seed.id]
		if existing and next(existing) ~= nil then continue end
		-- GiveQuestOfId returns the new uuid on success, OR a CanAcquire
		-- failure string. We re-look up the questId in saveData so we
		-- handle both cases without inspecting the return shape.
		SystemsContainer.QuestServer.GiveQuestOfId(player, seed.id)
		local uuidDict = Data.ActiveQuests and Data.ActiveQuests[seed.id]
		if typeof(uuidDict) ~= 'table' then continue end
		for _, questData in uuidDict do
			questData.SubQuestIndex = seed.subQuestIndex
			questData.is_tracked    = seed.isTracked
		end
	end

	-- give waystones
	SystemsContainer.WaystonesServer.UnlockDefaultWaystones(player)

	-- Stat hooks: session counter + first/last join timestamps.
	-- SessionsPlayed bumps once per OnPlayerAdded; FirstJoinDate is
	-- write-once (SetIfEmpty) so the first-ever join is preserved
	-- across rejoins; LastJoinDate is overwritten every join.
	local Stats = SystemsContainer.StatisticsServer
	if Stats then
		local IDS = StatisticsConfig.StatisticIds
		Stats.Increment(player, IDS.SessionsPlayed, 1)
		Stats.SetIfEmpty(player, IDS.FirstJoinDate, os.time())
		Stats.Set(player, IDS.LastJoinDate, os.time())
	end

	-- temporary respawning
	player.CharacterAdded:Connect(function(Character)
		Module.OnCharacterAdded( player, Character )
	end)

	if player.Character then
		task.defer(Module.OnCharacterAdded, player, player.Character)
	else
		player:LoadCharacterAsync()
	end
end

function Module.OnPlayerRemoving( player )
	print(player.Name, 'has left the game.')

	-- Stat hooks: session-end. Compute session length, accumulate
	-- into PlayTimeTotal, update LongestSession record. Done BEFORE
	-- ReleasePlayerProfile so the writes land on the live save before
	-- it flushes / releases.
	local Stats = SystemsContainer.StatisticsServer
	local sessionStart = _SessionStart[player]
	if Stats and sessionStart then
		local IDS = StatisticsConfig.StatisticIds
		local sessionLen = math.max(0, os.time() - sessionStart)
		Stats.Increment(player, IDS.PlayTimeTotal, sessionLen)
		Stats.SetMax(player, IDS.LongestSession, sessionLen)
	end
	_SessionStart[player] = nil
	_LifeStart[player] = nil

	PLAYER_COSMETIC_CACHE[player.Name] = nil
	SystemsContainer.DataManagerServer.ReleasePlayerProfile(player)
end

-- Background heartbeat: every TICK seconds, increment Analytics.TimePlayed
-- for each player with a loaded save and re-replicate so the character tab's
-- "Hours logged" reflects the current session without waiting for a full
-- save flush. ReplicatedData.SetData is per-player, so each player only
-- receives their own timer update.
local TIME_PLAYED_TICK = 30
-- Tracks last sampled HRP position per player so we can grant Agility XP
-- proportional to distance walked between ticks. Reset on character
-- removal so a respawn doesn't grant XP for the teleport delta.
local LAST_WALK_POS: { [Player]: Vector3 } = {}
-- Studs walked per Agility XP. ~50 means walking ~1500 studs across the
-- map yields ~30 XP — first-level Agility threshold reached in roughly
-- one map traversal. Tune by playtesting.
local AGILITY_STUDS_PER_XP = 50

local function spawnTimePlayedHeartbeat()
	task.spawn(function()
		while true do
			task.wait(TIME_PLAYED_TICK)
			for _, player in Players:GetPlayers() do
				local data = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player, false)
				if not data then continue end
				if typeof(data.Analytics) ~= 'table' then
					data.Analytics = { TimePlayed = 0 }
				end
				data.Analytics.TimePlayed = (data.Analytics.TimePlayed or 0) + TIME_PLAYED_TICK

				-- Walking-distance Agility XP. "Very slowly" per the
				-- design intent — divide travelled studs by AGILITY_STUDS_PER_XP.
				-- Out-of-combat only (in combat = dodge XP path covers it).
				local character = player.Character
				local hrp = character and character:FindFirstChild('HumanoidRootPart') :: BasePart?
				if hrp then
					local pos = hrp.Position
					local prev = LAST_WALK_POS[player]
					if prev then
						local distance = (pos - prev).Magnitude
						-- Filter out teleport jumps (rare-but-real respawn / waystone /
						-- fast-travel events). 200 studs in 30 sec = 6.6 studs/sec,
						-- well above max walk speed; cap to prevent abuse.
						if distance < 200 then
							local xp = math.floor(distance / AGILITY_STUDS_PER_XP)
							if xp > 0 and SystemsContainer.AttributeServer
								and SystemsContainer.AttributeServer.IncrementAttributeExperience then
								local inCombat = SystemsContainer.CombatLogServer
									and SystemsContainer.CombatLogServer.IsInCombat
									and SystemsContainer.CombatLogServer.IsInCombat(player)
								if not inCombat then
									SystemsContainer.AttributeServer.IncrementAttributeExperience(
										player, 'Agility', xp)
								end
							end
						end
					end
					LAST_WALK_POS[player] = pos
				end

			end
		end
	end)
end

-- Tear down per-player walking state on disconnect so the table doesn't
-- accumulate stale handles.
Players.PlayerRemoving:Connect(function(player)
	LAST_WALK_POS[player] = nil
end)

-- Vitality out-of-combat regen. Each Vitality level grants +1 HP/sec
-- when not in combat (CombatLogServer.IsInCombat == false). Caps at the
-- character's MaxHealth so we never overflow.
local OOC_REGEN_TICK = 1
local function spawnOOCRegenHeartbeat()
	task.spawn(function()
		while true do
			task.wait(OOC_REGEN_TICK)
			if not SystemsContainer.AttributeServer
				or not SystemsContainer.AttributeServer.GetPlayerAttributeLevel then
				continue
			end
			for _, player in Players:GetPlayers() do
				local character = player.Character
				local humanoid = character and character:FindFirstChildWhichIsA('Humanoid')
				if not humanoid or humanoid.Health <= 0 then continue end
				if humanoid.Health >= humanoid.MaxHealth then continue end
				local inCombat = SystemsContainer.CombatLogServer
					and SystemsContainer.CombatLogServer.IsInCombat
					and SystemsContainer.CombatLogServer.IsInCombat(player)
				if inCombat then continue end
				local vitalityLvl = SystemsContainer.AttributeServer
					.GetPlayerAttributeLevel(player, 'Vitality')
				if vitalityLvl <= 0 then continue end
				humanoid.Health = math.min(
					humanoid.MaxHealth,
					humanoid.Health + vitalityLvl * OOC_REGEN_TICK
				)
			end
		end
	end)
end

function Module.Start()
	PhysicsService:RegisterCollisionGroup('Players')
	PhysicsService:CollisionGroupSetCollidable('Players', 'Players', false)
	spawnTimePlayedHeartbeat()
	spawnOOCRegenHeartbeat()

	local VegetationFolder = workspace:FindFirstChild('Vegetation')
	if VegetationFolder then
		VegetationFolder.Parent = ReplicatedStorage
	end

	for _, player in Players:GetPlayers() do
		task.defer(Module.OnPlayerAdded, player)
	end
	Players.PlayerAdded:Connect(Module.OnPlayerAdded)
	Players.PlayerRemoving:Connect(Module.OnPlayerRemoving)

	ReplicatedData.SetData('PlayerCosmetics', PLAYER_COSMETIC_CACHE)

	ZoneService.ZoneEnter:Connect(function(character : Model, zoneName : string)
		local player = Players:GetPlayerFromCharacter(character)
		if (not player) or (not table.find(DiscoveryData.DiscoverableRegions, zoneName)) then
			return
		end
		local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player, false)
		if not saveData then
			return
		end
		if table.find(saveData.Discoveries, zoneName) then
			return
		end
		table.insert(saveData.Discoveries, zoneName)
		if DiscoveryData.DiscoveryDisplayInfo[zoneName] then
			DiscoveryEvent:FireClient(player, zoneName)
		end
	end)

	-- Stat hook: zone visits + per-zone time spent. ZoneEnter fires
	-- regardless of discovery — the visited counter tracks the
	-- visit-anywhere case (with a 60s cooldown so a player jittering
	-- across the boundary doesn't inflate the count); ZoneLeave
	-- closes the time accumulator.
	local _ZoneEnterTime: {[Player]: {[string]: number}} = {}
	local _ZoneVisitCooldown: {[Player]: {[string]: number}} = {}
	local ZONE_VISIT_COOLDOWN_SEC = 60

	ZoneService.ZoneEnter:Connect(function(character: Model, zoneName: string)
		local player = Players:GetPlayerFromCharacter(character)
		if not player then return end
		local Stats = SystemsContainer.StatisticsServer
		if not Stats then return end
		local IDS = StatisticsConfig.StatisticIds

		_ZoneEnterTime[player] = _ZoneEnterTime[player] or {}
		_ZoneEnterTime[player][zoneName] = os.time()

		-- 1-minute per-zone visit cooldown — entering / leaving rapidly
		-- (e.g. on a zone boundary) shouldn't inflate the visit counter.
		_ZoneVisitCooldown[player] = _ZoneVisitCooldown[player] or {}
		local lastVisit = _ZoneVisitCooldown[player][zoneName] or 0
		if os.time() - lastVisit >= ZONE_VISIT_COOLDOWN_SEC then
			_ZoneVisitCooldown[player][zoneName] = os.time()
			Stats.IncrementMap(player, IDS.ZonesVisitedCount, zoneName, 1)
		end
	end)

	ZoneService.ZoneLeave:Connect(function(character: Model, zoneName: string)
		local player = Players:GetPlayerFromCharacter(character)
		if not player then return end
		local Stats = SystemsContainer.StatisticsServer
		if not Stats then return end
		local enters = _ZoneEnterTime[player]
		if not enters then return end
		local enterT = enters[zoneName]
		if not enterT then return end
		local secs = math.max(0, os.time() - enterT)
		enters[zoneName] = nil
		if secs > 0 then
			Stats.IncrementMap(player,
				StatisticsConfig.StatisticIds.ZoneTimeSeconds, zoneName, secs)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		_ZoneEnterTime[player] = nil
		_ZoneVisitCooldown[player] = nil
	end)

	-- Chat messages — bumps the counter on every Chatted event. Hook
	-- per-player on PlayerAdded so we don't miss the in-progress
	-- session's first message.
	local function bindChatStat(player: Player)
		player.Chatted:Connect(function(_msg)
			local Stats = SystemsContainer.StatisticsServer
			if Stats then
				Stats.Increment(player,
					StatisticsConfig.StatisticIds.ChatMessagesSent, 1)
			end
		end)
	end
	for _, player in Players:GetPlayers() do bindChatStat(player) end
	Players.PlayerAdded:Connect(bindChatStat)

end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module]]></Source>
		<Source path="ServerStorage/Core/BanServer"><![CDATA[
export type BanData = {
	Moderator: string,
	Reason: string,
	Timestamp: number,
	Duration: number,
}

export type BanDataProperties = {
	Moderator: string?,
	Reason: string?,
	Duration: number?,
}

-- local MessagingService = game:GetService("MessagingService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")

local DEFAULT_BAN_DURATION = 24 * 60 * 60
local MESSAGING_SERVICE_AVAILABLE = false

local SystemsContainer = {}

local function GetUTCTimestamp(): number
	return DateTime.fromUnixTimestamp(workspace:GetServerTimeNow()).UnixTimestamp
end

-- // Module // --
local Module = {}

function Module.CheckIfProfileBanned(profile: any): boolean
	if (not profile.Data.Banned) or (not profile.Data.Banned.Active) then
		return false
	end
	local Data: BanData = profile.Data.Banned.Active
	local currentTime = GetUTCTimestamp()
	if currentTime < Data.Timestamp + Data.Duration then
		return true -- still banned
	end
	-- not banned anymore, expired
	profile.Data.Banned.Active = nil
	return false
end

function Module.CompileBannedMessage(ban_data: BanData): string
	if typeof(ban_data.Duration) == 'string' then
		return ban_data.Duration
	end
	local currentTime = GetUTCTimestamp()
	local expiryTime = (ban_data.Timestamp + ban_data.Duration)
	local remaining = (expiryTime - currentTime)
	local days = math.floor(remaining/86400)
	local hours = math.floor((remaining%86400)/3600)
	local minutes = math.floor((remaining%3600)/60)
	local seconds = math.floor(remaining%60)
	return string.format("Banned for '%s'\nModerator: %s\n Time Remaining: %dd %02dh %02dm %02ds",ban_data.Reason,ban_data.Moderator,days,hours,minutes,seconds)
end

function Module.ConcileBanProperties(properties: BanDataProperties): BanData
	return {
		Moderator = properties and properties.Moderator or 'Server',
		Reason = properties and properties.Reason or 'Unknown',
		Duration = properties and properties.Duration or DEFAULT_BAN_DURATION,
		Timestamp = GetUTCTimestamp(),
	}
end

-- Ban the given userid
function Module.BanUserId(userId: number, properties: BanDataProperties)
	local profile = SystemsContainer.DataManagerServer.LoadUserIdProfile(userId)
	if not profile then
		return
	end

	properties = Module.ConcileBanProperties(properties)

	profile.Data.Banned.Active = properties
	table.insert(profile.Data.Banned.History, properties)

	local message = Module.CompileBannedMessage(properties)
	local player = Players:GetPlayerByUserId(userId)
	if player then
		player:Kick(message)
	end

	SystemsContainer.DataManagerServer.ReleaseUserIdProfile(userId)

	if MESSAGING_SERVICE_AVAILABLE then
		task.defer(function()
			MessagingService:PublishAsync('BanMessage', {userId, message})
		end)
	end
end

-- ban the given player
function Module.BanPlayer(player: Player, properties: BanDataProperties)
	return Module.BanUserId(player.UserId, properties)
end

function Module.ConnectMessagingService()
	local success, err = pcall(function()
		MessagingService:SubscribeAsync('BanMessage', function(data)
			local userId, message = table.unpack(data)
			local LocalPlayer = Players:GetPlayerByUserId( userId )
			if LocalPlayer then
				LocalPlayer:Kick(message)
			end
		end)
	end)

	if success then
		MESSAGING_SERVICE_AVAILABLE = true
	else
		local msg = "MessagingService subscription to 'BanMessage' failed. %s"
		warn(string.format(msg, err))
	end
end

function Module.Start()
	task.defer(Module.ConnectMessagingService)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/AdminServer"><![CDATA[
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))
local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

local ItemsConfigModule = ServerModules.Data.Items

local SystemsContainer = {}

local function FindUserByNamePartial(partial_name: string): Player?
	for _, player in Players:GetPlayers() do
		if string.find(player.Name, partial_name) then
			return player
		end
	end
	return nil
end

-- // Module // --
local Module = {}

Module.WhitelistedUserIds = {1041213550}
Module.CommandPrefix = "!"

Module.CommandDict = {
	help = function()
		print("Available commands;")
		for cmd, _ in Module.CommandDict do
			print(cmd)
		end
		print("---")
	end,
	unlock_waystone = function(player: Player, args: {string})
		for _, id in args do
			SystemsContainer.WaystonesServer.UnlockWaystoneForPlayer(player, id)
		end
	end,
	unlock_all_waystones = function(player: Player, args: {string})
		SystemsContainer.WaystonesServer._UnlockAllWaystones(player)
	end,
	equip_weapon_uuid_slot = function(player: Player, args: {string})
		local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
		if not saveData then
			return
		end

		if not player.Character then
			return
		end

		for i = 1, #args, 2 do
			local uuid: string = args[i]
			local slot: number? = tonumber(args[i+1])
			local slotId = tostring(slot).."_Weapon"
			local itemId: string? = SystemsContainer.PlayerInventoryServer.FindItemIdGivenUUID(player, uuid)
			player.Character:SetAttribute(slotId, uuid)
			saveData.Equipped[slotId] = {uuid = uuid, itemId = itemId, customSlot = nil}
			SystemsContainer.EquipmentRendererServer.SetEquipmentValues(player.Character, slotId, uuid, itemId)
		end
	end,
	fill_weapon_slots = function(player: Player, args: {string})
		local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
		if not saveData then
			return
		end

		if not player.Character then
			return
		end

		local itemId = args[1]
		if not saveData.Inventory[itemId] then
			return
		end

		local right = false
		for uuid, stack in saveData.Inventory[itemId] do
			local slotId = tostring(right and 2 or 1).."_Weapon"
			player.Character:SetAttribute(slotId, uuid)
			saveData.Equipped[slotId] = {uuid = uuid, itemId = itemId, customSlot = nil}
			SystemsContainer.EquipmentRendererServer.SetEquipmentValues(player.Character, slotId, uuid, itemId)
			if right then
				break
			end
			right = true
		end
	end,
	teleport_to_floor = function(player: Player, args: {string})
		local floor_number = tonumber(table.remove(args, 1))
		local name = table.remove(args, 2)
		local target = FindUserByNamePartial(name)
		if target then
			player = target
		end
		SystemsContainer.TeleportServer.TeleportToFloor(player, 1, floor_number)
	end,
	teleport_all_to_floor = function(player: Player, args: {string})
		local floor_number = tonumber(table.remove(args, 1))
		for _, name in args do
			local plr = FindUserByNamePartial(name)
			if plr then
				SystemsContainer.TeleportServer.TeleportToFloor(plr, 1, floor_number)
			end
		end
	end,
	add_to_whitelist = function(player: Player, args: {string})
		for _, name in args do
			local plr = FindUserByNamePartial(name)
			if plr and not table.find(Module.WhitelistedUserIds, plr.UserId) then
				table.insert(Module.WhitelistedUserIds, plr.UserId)
			end
		end
	end,
	rm_from_whitelist = function(player: Player, args: {string})
		for _, name in args do
			local plr = FindUserByNamePartial(name)
			local index = plr and table.find(Module.WhitelistedUserIds, plr.UserId)
			if plr and index then
				table.remove(Module.WhitelistedUserIds, index)
			end
		end
	end,
	give_exp = function(player: Player, args: {string})
		local amount, name = unpack(args)
		local plr = name and FindUserByNamePartial(name) or player
		if not tonumber(amount) then
			return
		end
		amount = tonumber(amount)
		if not plr then
			return
		end
		SystemsContainer.DataEditServer.GiveExperienceToPlayer(player, amount)
	end,
	give_col = function(player: Player, args: {string})
		local amount, name = unpack(args)
		local plr = name and FindUserByNamePartial(name) or player
		if not tonumber(amount) then
			return
		end
		amount = tonumber(amount)
		if not plr then
			return
		end
		SystemsContainer.DataEditServer.GiveCurrencyToPlayer(player, amount)
	end,
	give_item = function(player: Player, args: {string})
		local itemId, amount, target_plr_name = unpack(args)
		local plr = target_plr_name and FindUserByNamePartial(target_plr_name) or player
		if not tonumber(amount) then
			return
		end
		amount = tonumber(amount)
		if not plr then
			return
		end
		local itemConfig = ItemsConfigModule.GetConfigFromId(itemId)
		if not itemConfig then
			warn(string.format('No item found with id %s', itemId))
			return
		end
		SystemsContainer.PlayerInventoryServer.GiveQuantityOfItemIdToPlayer(player, itemId, amount)
	end,
	dump_data = function(player: Player, args: {string})
		local data = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
		if not data then
			return
		end
		print(HttpService:JSONEncode(data))
	end,
	dump_inventory = function(player: Player, args: {string})
		local data = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
		if not data then
			return
		end
		print(HttpService:JSONEncode(data.Inventory))
	end,
	equip_item = function(player: Player, args: {string})
		local uuid, slot = unpack(args)
		slot = tonumber(slot)
		if not slot then
			return
		end
		SystemsContainer.PlayerInventoryServer.AttemptPlayerEquipItemOfUUID(player, uuid, slot)
	end,
}

function Module.RunCommand(player: Player, cmd: string, args: {string})
	local func = Module.CommandDict[cmd]
	if not func then
		warn(string.format("Cannot find command; %s", tostring(cmd)))
		return
	end

	local s, e = pcall(func, player, args)
	if not s then
		warn(e)
	end
end

function Module.ParsePlayerChatMessage(player: Player, a0: string, a1:Player?)
	if not table.find(Module.WhitelistedUserIds, player.UserId) then
		return
	end
	if a1 then
		return
	end
	if string.sub(a0, 1, #Module.CommandPrefix) ~= Module.CommandPrefix then
		return
	end
	local items = string.split(string.sub(a0, #Module.CommandPrefix+1, #a0), " ")
	local cmd = table.remove(items, 1)
	Module.RunCommand(player, cmd, items)
end

function Module.OnPlayerAdded(player: Player)
	player.Chatted:Connect(function(a0: string, a1: Player?)
		Module.ParsePlayerChatMessage(player, a0, a1)
	end)
end

function Module.Start()
	for _, player in Players:GetPlayers() do
		task.defer(Module.OnPlayerAdded, player)
	end
	Players.PlayerAdded:Connect(Module.OnPlayerAdded)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/AttributeServer"><![CDATA[
export type AttributeData = {
	Level: number,
	Experience: number,
}

local Players = game:GetService('Players')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local AttributeConfig = ReplicatedModules.Data.Attributes
local BoostersConfig  = ReplicatedModules.Data.Boosters
local StatisticsConfig = ReplicatedModules.Data.StatisticsConfig
local ReplicatedData  = ReplicatedModules.Services.ReplicatedData
local RemoteService   = ReplicatedModules.Services.RemoteService

-- Fired at the leveling-up player when an attribute level increases.
-- Args: (attributeId: string, newLevel: number, levelsGained: number).
-- AttributeLevelUpClient renders a subtle world-VFX + light SFX; the
-- toast push is handled separately via ToastServer.NotifyAttributeLevelUp
-- so the two surfaces can be tuned (or muted) independently.
local AttributeLevelUpEvent = RemoteService.GetRemote('AttributeLevelUpEvent', 'RemoteEvent', false)

local SystemsContainer = {}

----------------------------------------------------------------------
-- Replication throttle for IncrementAttributeExperience.
--
-- Every damage tick triggers an XP grant which used to call
-- ReplicatedData.SetData('PlayerData', saveData, ...) immediately —
-- a full DeepCopy + JSON-encode of the save struct per hit. Sustained
-- combat (boar attacks, AoE skills, fast combo chains) compounded
-- into a visible frame hitch on damage.
--
-- Replace per-hit replication with a coalesced flush: an XP grant
-- marks the player "dirty" and schedules a single SetData via a
-- task.delay if one isn't already pending. The flush runs at most
-- once per REPLICATE_DEBOUNCE_SECONDS per player; intermediate XP
-- grants land in the in-memory save immediately, and the player's
-- HUD picks up the latest values on the next flush. Level-up bumps
-- (rare events) still get a flush within the debounce window so the
-- toast / VFX cue path isn't delayed past one frame.
----------------------------------------------------------------------
local REPLICATE_DEBOUNCE_SECONDS = 0.25
-- Pending flush timestamps + scheduled flag, per player.
local PendingFlushAt: { [Player]: number } = {}
local ReplicateScheduled: { [Player]: boolean } = {}

local function scheduleReplicate(player: Player)
	if not player or not player.Parent then return end
	if ReplicateScheduled[player] then return end  -- already in flight
	ReplicateScheduled[player] = true
	task.delay(REPLICATE_DEBOUNCE_SECONDS, function()
		ReplicateScheduled[player] = nil
		PendingFlushAt[player] = nil
		if not player or not player.Parent then return end
		local saves = SystemsContainer.SavesManagerServer
		if not saves then return end
		local saveData = saves.GetPlayerSelectedSaveData(player)
		if not saveData then return end
	end)
end

-- Cleanup on leave so the dispatch maps don't leak entries keyed by
-- stale Player table identities (Player removed → table eligible for
-- GC, but our reference would keep it pinned).
Players.PlayerRemoving:Connect(function(player)
	PendingFlushAt[player] = nil
	ReplicateScheduled[player] = nil
end)

-- // Module // --
local Module = {}

-- Create empty attribute data
function Module.CreateBaseAttributeData(): AttributeData
	return {
		Level = 1,
		Experience = 0,
	}
end

-- Give the attribute to the target player.
function Module.GiveAttributeToPlayer(player: Player, attributeId: string): AttributeData?
	local attributeConfig = AttributeConfig.GetConfigFromId(attributeId)
	if not attributeConfig then
		warn('No Attribute with id ' .. tostring(attributeId))
		return
	end

	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData then
		return
	end

	if not saveData.Attributes[attributeId] then
		local attributeData = Module.CreateAttributeData(attributeId)
		-- TODO: notifications (unlocked attribute)
		print(string.format('Player %s has unlocked attribute %s', player.Name, attributeId))
		saveData.Attributes[attributeId] = attributeData
	end

	return saveData.Attributes[attributeId]
end

-- Get the given attribute's level for the player. Tolerates both the
-- legacy `{Level, Experience}` table shape and the new integer shape;
-- returns 0 (NOT -1) when missing so callers can multiply / add safely
-- without special-casing the absent attribute.
function Module.GetPlayerAttributeLevel(player: Player, attributeId: string): number
	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData or typeof(saveData.Attributes) ~= 'table' then return 0 end
	local entry = saveData.Attributes[attributeId]
	if typeof(entry) == 'number' then return entry end
	if typeof(entry) == 'table' and tonumber(entry.Level) then return entry.Level end
	return 0
end

-- Compute the live bonus value for a (player, attribute) pair via the
-- AttributeConfig.GetBonus formula. Returns 0 if the player doesn't
-- have the attribute or the config doesn't define a bonus formula —
-- so callers can `damage * (1 + GetPlayerBonus(player, 'Vitality'))`
-- without nil-guarding.
function Module.GetPlayerBonus(player: Player, attributeId: string): number
	if not player then return 0 end
	local cfg = AttributeConfig.Attributes and AttributeConfig.Attributes[attributeId]
	if not cfg or typeof(cfg.GetBonus) ~= 'function' then return 0 end
	local level = Module.GetPlayerAttributeLevel(player, attributeId)
	if level <= 0 then return 0 end
	local ok, bonus = pcall(cfg.GetBonus, level)
	return (ok and tonumber(bonus)) or 0
end

-- Convenience: resolve a character → its player → bonus. Used by combat
-- modules where the only handle is a character Model.
function Module.GetCharacterBonus(character: Instance, attributeId: string): number
	local Players = game:GetService('Players')
	local player = character and Players:GetPlayerFromCharacter(character)
	if not player then return 0 end
	return Module.GetPlayerBonus(player, attributeId)
end

-- Get the attribute's resultant values from the current level
function Module.GetPlayerAttributeLevelBonuses(player: Player, attributeId: string): number
	local attributeConfig = AttributeConfig.GetConfigFromId(attributeId)
	if not attributeConfig then
		warn("cannot get attribute bonuses as id does not exist - " .. tostring(attributeId))
		return 0
	end
	local currentLevel = Module.GetPlayerAttributeLevel(player, attributeId)
	return attributeConfig.GetBonus(currentLevel)
end

-- Check if an attribute can level up
function Module.CheckAttributeLeveling(player: Player, attributeId: string)
	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData then
		return
	end

	local attributeData = saveData.Attributes[attributeId]
	if not attributeData then
		return
	end

	local attributeConfig = AttributeConfig.GetConfigFromId(attributeId)
	if not attributeConfig then
		return
	end

	local initialLevel = attributeData.Level
	local requiredExperience = attributeConfig.GetExpForLevel(attributeData.Level)
	-- `Level + 1 <= MaxLevel` so the XP path can reach MaxLevel exactly.
	-- The previous strict-less form capped at MaxLevel - 1 — fine for the
	-- point-spend cap-at-MaxLevel branch but wrong for XP grants.
	while attributeData.Experience >= requiredExperience and attributeData.Level + 1 <= attributeConfig.MaxLevel do
		attributeData.Experience -= requiredExperience
		attributeData.Level += 1
		requiredExperience = attributeConfig.GetExpForLevel(attributeData.Level)
	end

	if attributeData.Level > initialLevel then
		local levelsGained = attributeData.Level - initialLevel
		local msg = "Player %s attribute %s leveled up %d times."
		print(string.format(msg, player.Name, attributeId, levelsGained))
		-- World-side effect cue (subtle particle puff + quiet sound).
		-- Fired only at the leveling player — attribute level-ups
		-- aren't crowd-broadcast events, unlike full character level-ups.
		AttributeLevelUpEvent:FireClient(player, attributeId, attributeData.Level, levelsGained)
		-- Toast cue (bottom-right HUD line). Routed via ToastServer so
		-- the toast palette + kind enum stays a single source of truth.
		local ToastServer = SystemsContainer.ToastServer
		if ToastServer and ToastServer.NotifyAttributeLevelUp then
			ToastServer.NotifyAttributeLevelUp(player, attributeId, attributeData.Level, levelsGained)
		end
	end
end

-- Increment an attribute's experience. The save schema accepts both
-- `number` (terse level) and `{Level, Experience}` (legacy XP-based)
-- shapes. To support per-source XP grants, this function migrates a
-- bare number to the table shape on first use, then increments the
-- Experience field. CheckAttributeLeveling promotes Level when Experience
-- crosses the GetExpForLevel threshold.
--
-- Best-effort: silently no-ops if the attribute id isn't in the config
-- so a stale call site (renamed attribute, etc.) doesn't crash.
function Module.IncrementAttributeExperience(player: Player, attributeId: string, experienceAmount: number)
	if not player or typeof(attributeId) ~= 'string' or experienceAmount <= 0 then return end
	local cfg = AttributeConfig.Attributes and AttributeConfig.Attributes[attributeId]
	if not cfg then return end
	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData then return end

	-- Booster: attribute_xp_mul. Applied to the incoming amount before
	-- the per-attribute entry write, so all attribute paths (Strength,
	-- Vitality, Insight, Toughness, Focus, …) share the same multiplier.
	if SystemsContainer.BoostersServer and SystemsContainer.BoostersServer.GetMultiplier then
		local mul = SystemsContainer.BoostersServer.GetMultiplier(player, BoostersConfig.Kinds.AttributeXpMul)
		if mul ~= 1 then
			experienceAmount = math.floor(experienceAmount * mul + 0.5)
			if experienceAmount <= 0 then return end
		end
	end
	if typeof(saveData.Attributes) ~= 'table' then saveData.Attributes = {} end
	local entry = saveData.Attributes[attributeId]
	-- Coerce to {Level, Experience} so we can store XP. The bare-number
	-- shape is used by the point-spend path; both render correctly in
	-- the AttributesTab card thanks to the dual-read in GetPlayerAttributeLevel.
	if typeof(entry) ~= 'table' then
		local level = (typeof(entry) == 'number') and entry or 0
		entry = { Level = level, Experience = 0 }
		saveData.Attributes[attributeId] = entry
	end
	entry.Experience = (entry.Experience or 0) + experienceAmount
	-- Stat hook: per-attribute lifetime XP, keyed by attributeId.
	-- Uses the post-multiplier amount (matches the actual XP that
	-- landed in the entry, so the menu shows what the player
	-- experienced).
	if SystemsContainer.StatisticsServer then
		SystemsContainer.StatisticsServer.IncrementMap(player,
			StatisticsConfig.StatisticIds.AttributeExperience, attributeId, experienceAmount)
	end
	Module.CheckAttributeLeveling(player, attributeId)
	-- Coalesced replicate. Per-hit calls used to immediately fire
	-- ReplicatedData.SetData (full save DeepCopy + JSON encode),
	-- visibly hitching frames in sustained combat. Now we mark the
	-- player dirty + schedule one flush within REPLICATE_DEBOUNCE_SECONDS;
	-- the AttributesTab card lags by at most that window, but combat
	-- frame time stays clean.
	scheduleReplicate(player)
end

-- Remove attribute from player
function Module.RemoveAttributeFromPlayer(player: Player, attributeId: string)
	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData then
		return
	end
	saveData.Data.Attributes[attributeId] = nil
end

function Module.Start()
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module

]]></Source>
		<Source path="ServerStorage/Core/WaystonesServer"><![CDATA[
local CollectionService = game:GetService('CollectionService')
local Players = game:GetService('Players')
local RunService = game:GetService('RunService')

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local RemoteService = ReplicatedModules.Services.RemoteService
local WaystonesEvent = RemoteService.GetRemote('WaystonesEvent', 'RemoteEvent', false)

local WaystonesData = ReplicatedModules.Data.Waystones
local ZoneService = ReplicatedModules.Services.ZoneService

local SystemsContainer = {}

local REGISTERED_WAYSTONES = {}

-- Padding studs added to the model's natural bounding box on each axis
-- so the activation zone reaches the player from further away. The
-- previous bounds matched the model's own footprint exactly — the
-- player had to physically stand inside the waystone mesh to trigger
-- it. Per-waystone overrides via the model's `InteractRangeBonus`
-- attribute add to this default; designers can shrink/grow specific
-- waystones without touching code.
local WAYSTONE_INTERACT_PADDING = 12

local baseBoundsPart = Instance.new('Part')
baseBoundsPart.Name = 'Bounds'
baseBoundsPart.Transparency = 1
baseBoundsPart.Color = Color3.new(1, 0 ,0)
baseBoundsPart.Anchored = true
baseBoundsPart.CanCollide = false
baseBoundsPart.CanTouch = false

-- // Module // --
local Module = {}

function Module.GetWaystoneModelOfID(waystoneId : string) : Model?
	for _, object in CollectionService:GetTagged(WaystonesData.WaystonesTag) do
		if object.Name == waystoneId then
			return object
		end
	end
	return nil
end

function Module.SetupWaystone(model: Model)
	local waystoneId = model.Name
	if not waystoneId then
		warn(string.format('Waystone %s does not have a WaystoneId set!', model:GetFullName()))
		CollectionService:RemoveTag(model, WaystonesData.WaystonesTag)
		return
	end

	print(waystoneId, model:GetFullName())

	if not table.find(REGISTERED_WAYSTONES, waystoneId) then
		table.insert(REGISTERED_WAYSTONES, waystoneId)
		local BoundCF, BoundSize = model:GetBoundingBox()
		-- Per-waystone interact-range tweak. Small waystones with cramped
		-- placement (corners, ledges) can shrink the bonus; major lobby
		-- waystones can grow it. Defaults to WAYSTONE_INTERACT_PADDING.
		local extra = tonumber(model:GetAttribute('InteractRangeBonus')) or 0
		local pad = WAYSTONE_INTERACT_PADDING + extra
		local Base = baseBoundsPart:Clone()
		Base.CFrame = BoundCF
		-- Inflate XYZ by 2× pad (pad on each side). Y is included so a
		-- waystone with vertical clearance issues (basement / overhang)
		-- still registers when the player approaches from above/below.
		Base.Size = BoundSize + Vector3.new(pad * 2, pad * 2, pad * 2)
		Base.Parent = model
		ZoneService.RegisterZone(waystoneId, {Base})
	end
end

function Module.DoesPlayerHaveWaystoneUnlocked(player: Player, waystoneId: string): boolean
	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData then
		return false
	end
	local waystoneConfig = WaystonesData.WaystoneDisplays[waystoneId]
	if not waystoneConfig then
		return false
	end
	local isUnlocked = table.find(saveData.Waystones, waystoneId) ~= nil
	if waystoneConfig.AutoUnlock then
		if not isUnlocked then
			table.insert(saveData.Waystones, waystoneId)
		end
		return true
	end
	return isUnlocked
end

-- Inventory consume helper (pattern shared with CompanionsServer /
-- CraftingServer). PlayerInventoryServer.AttemptPlayerDeleteItemOfUUID
-- nukes whole UUID slots, so consuming N from a stack means decrement
-- then delete-if-zero.
local function consumeFromInventory(player: Player, itemId: string, quantity: number): number
	local Inventory = SystemsContainer.PlayerInventoryServer
	local Saves = SystemsContainer.SavesManagerServer
	if not Inventory or not Inventory.GetItemUUIDsOfItemId
		or not Inventory.AttemptPlayerDeleteItemOfUUID or not Saves then
		return 0
	end
	local data = Saves.GetPlayerSelectedSaveData(player); if not data then return 0 end
	local bucket = data.Inventory and data.Inventory[itemId]
	if typeof(bucket) ~= 'table' then return 0 end
	local consumed = 0
	for _, uuid in Inventory.GetItemUUIDsOfItemId(player, itemId) or {} do
		if consumed >= quantity then break end
		local slot = bucket[uuid]
		if typeof(slot) == 'table' then
			local have = slot.Quantity or 1
			local take = math.min(have, quantity - consumed)
			slot.Quantity = have - take
			consumed += take
			if slot.Quantity <= 0 then
				Inventory.AttemptPlayerDeleteItemOfUUID(player, uuid)
			end
		end
	end
	return consumed
end

local function getInventoryQuantity(player: Player, itemId: string): number
	local Saves = SystemsContainer.SavesManagerServer
	local data = Saves and Saves.GetPlayerSelectedSaveData(player); if not data then return 0 end
	local bucket = data.Inventory and data.Inventory[itemId]
	if typeof(bucket) ~= 'table' then return 0 end
	local total = 0
	for _, slot in bucket do
		total += (typeof(slot) == 'table' and (slot.Quantity or 1)) or 1
	end
	return total
end

-- Predicate: does the player satisfy a waystone's unlock requirements?
-- Used by both client UI (greyed lock state) and the actual unlock flow.
-- Studio bypass: testers always pass requirements so iteration doesn't
-- require grinding the requirement gates.
function Module.CanUnlockWaystone(player: Player, waystoneId: string): (boolean, string)
	local cfg = WaystonesData.WaystoneDisplays[waystoneId]
	if not cfg then return false, 'Unknown waystone.' end
	if cfg.AutoUnlock then return true, '' end
	if RunService:IsStudio() then return true, '' end
	local req = cfg.Requirements
	if not req then return true, '' end
	if req.MinLevel then
		local Saves = SystemsContainer.SavesManagerServer
		local data = Saves and Saves.GetPlayerSelectedSaveData(player)
		if (data and data.Level or 0) < req.MinLevel then
			return false, string.format('Requires level %d.', req.MinLevel)
		end
	end
	-- Difficulty / floor gate: a waystone may require the player to be
	-- on a floor at or above MinFloor (`difficulty` proxy — higher floors
	-- = harder). Read once from save / character attribute.
	if req.MinFloor then
		local floorAttr = tonumber(player:GetAttribute('CurrentFloor')) or 0
		if floorAttr < req.MinFloor then
			return false, string.format('Requires floor %d+.', req.MinFloor)
		end
	end
	-- Quest gate: requires a specific quest in CompletedQuests.
	if req.RequiredQuest then
		local Saves = SystemsContainer.SavesManagerServer
		local data = Saves and Saves.GetPlayerSelectedSaveData(player)
		local completed = data and data.CompletedQuests
		if typeof(completed) ~= 'table' or not completed[req.RequiredQuest] then
			return false, string.format('Requires quest: %s.', tostring(req.RequiredQuest))
		end
	end
	if req.RequiredItems then
		for _, item in req.RequiredItems do
			if getInventoryQuantity(player, item.ItemId) < item.Quantity then
				return false, string.format('Requires %d × %s.', item.Quantity, item.ItemId)
			end
		end
	end
	return true, ''
end

function Module.UnlockWaystoneForPlayer(player: Player, waystoneId: string)
	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData then
		return
	end

	if table.find(saveData.Waystones, waystoneId) then
		return
	end

	-- Auth: requirements must be met. Items are consumed here on success.
	local ok, _reason = Module.CanUnlockWaystone(player, waystoneId)
	if not ok then return end
	local cfg = WaystonesData.WaystoneDisplays[waystoneId]
	if cfg and cfg.Requirements and cfg.Requirements.RequiredItems then
		for _, item in cfg.Requirements.RequiredItems do
			consumeFromInventory(player, item.ItemId, item.Quantity)
		end
	end

	table.insert(saveData.Waystones, waystoneId)
	print(string.format('Player %s has unlocked waystone of id %s!', player.Name, waystoneId))
	WaystonesEvent:FireClient(player, waystoneId)
end

function Module.OnWaystoneEnter(character: Model, waystoneId: string)
	local player = Players:GetPlayerFromCharacter(character)
	if not player then
		return
	end
	Module.UnlockWaystoneForPlayer(player, waystoneId)
end

function Module.CleanupWaystone(model: Model)

end

function Module.UnlockDefaultWaystones(player: Player)
	for waystoneId, waystoneConfig in WaystonesData.WaystoneDisplays do
		if waystoneConfig.AutoUnlock then
			Module.UnlockWaystoneForPlayer(player, waystoneId)
		end
	end
end

function Module._UnlockAllWaystones(player: Player)
	for waystoneId, waystoneConfig in WaystonesData.WaystoneDisplays do
		Module.UnlockWaystoneForPlayer(player, waystoneId)
	end
end

local WAYSTONE_TYPE_ENUMS = {None = 0, Small = 1, Large = 2,}
function Module.GetPlayerCurrentWaystoneType(player: Player): number
	local activeZones: {string} = ZoneService.GetZonesPlayerIsWithin(player)

	local inWaystone = false
	local waystoneId = nil
	for _, zoneId in activeZones do
		if table.find(REGISTERED_WAYSTONES, zoneId) then
			inWaystone = true
			waystoneId = zoneId
			break
		end
	end

	if not inWaystone or not waystoneId then
		return WAYSTONE_TYPE_ENUMS.None
	end

	local waystoneConfig = WaystonesData.WaystoneDisplays[waystoneId]
	if not waystoneConfig then
		return WAYSTONE_TYPE_ENUMS.None
	end

	if waystoneConfig.LargeWaystone then
		return WAYSTONE_TYPE_ENUMS.Large
	end
	return WAYSTONE_TYPE_ENUMS.Small
end

function Module.TeleportPlayerToWaystone(player: Player, waystoneId: string, sourceWaystoneType: number?): (boolean, string)
	local character = player.Character
	if not character then
		return false, "No character!"
	end

	local waystoneConfig = WaystonesData.WaystoneDisplays[waystoneId]
	if not waystoneConfig then
		return false, "Waystone has no config!"
	end

	-- Cross-floor gate: the SOURCE waystone (the one the player is
	-- currently standing in) must be a Large/major waystone. The
	-- destination's tier doesn't matter — minor → major and major →
	-- minor are both allowed for cross-floor when the SOURCE is major.
	-- Same-floor teleport is open between any combination of tiers.
	-- The caller (AttemptPlayerTeleportToWaystone) resolves the source
	-- type from the player's current zone and passes it in;
	-- direct callers (cmdr, dev tools) can pass nil to bypass the gate.
	local currentFloor = SystemsContainer.TeleportServer.GetActiveFloorNumber()
	local targetFloor = waystoneConfig.Floor
	if currentFloor ~= targetFloor then
		if sourceWaystoneType ~= nil and sourceWaystoneType ~= WAYSTONE_TYPE_ENUMS.Large then
			print("not at major waystone, cannot teleport between floors!")
			-- TODO tell player
			return false, "Cross-floor travel requires a major waystone."
		end
		-- teleport to target floor
		print(string.format("teleporting %s to target waystone floor.", player.Name))
		local save_index: number = SystemsContainer.SavesManagerServer.GetSelectedSaveIndex(player)
		SystemsContainer.TeleportServer.TeleportToFloor(player, save_index, targetFloor)
		return true, "Teleporting..."
	end

	local waystoneModel = Module.GetWaystoneModelOfID(waystoneId)
	print("Waystone Model:", waystoneModel)
	if not waystoneModel then
		return false, "No waystone model found!"
	end

	player:RequestStreamAroundAsync(waystoneModel.Center.Position, 5)

	local cf = CFrame.new(waystoneModel.Center.Position)
	character:PivotTo(cf)
	return true, "Teleporting..."
end

local WaystoneDebounces = {}
function Module.AttemptPlayerTeleportToWaystone(player: Player, waystoneId: string)
	-- player is trying to teleport to waystone / floor
	if WaystoneDebounces[player] then
		return
	end
	WaystoneDebounces[player] = true

	task.delay(3, function()
		WaystoneDebounces[player] = nil
	end)

	-- Combat-log gate (server-authoritative). The client also predicts
	-- this in WaystonesWidget.teleportTo, but the server is the source
	-- of truth so a tampered client can't fast-travel out mid-fight.
	if SystemsContainer.CombatLogServer
		and SystemsContainer.CombatLogServer.IsInCombat(player) then
		return
	end

	local waystoneType = Module.GetPlayerCurrentWaystoneType(player)
	if waystoneType == WAYSTONE_TYPE_ENUMS.None then
		return
	end

	if not Module.DoesPlayerHaveWaystoneUnlocked(player, waystoneId) then
		return
	end

	-- Forward the player's CURRENT waystone tier so TeleportPlayerToWaystone
	-- can gate cross-floor travel on it. Same-floor combos pass freely.
	local success, err = Module.TeleportPlayerToWaystone(player, waystoneId, waystoneType)
end

function Module.Start()
	for _, waystone in CollectionService:GetTagged(WaystonesData.WaystonesTag) do
		Module.SetupWaystone(waystone)
	end
	CollectionService:GetInstanceAddedSignal(WaystonesData.WaystonesTag):Connect(Module.SetupWaystone)
	CollectionService:GetInstanceRemovedSignal(WaystonesData.WaystonesTag):Connect(Module.CleanupWaystone)

	ZoneService.ZoneEnter:Connect(function(character: Model, zoneId: string)
		if table.find(REGISTERED_WAYSTONES, zoneId) then
			Module.OnWaystoneEnter(character, zoneId)
		end
	end)

	WaystonesEvent.OnServerEvent:Connect(Module.AttemptPlayerTeleportToWaystone)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/TeleportServer"><![CDATA[
local Players = game:GetService("Players")
local TeleportService = game:GetService('TeleportService')
local RunService = game:GetService('RunService')

local ServerStorage = game:GetService("ServerStorage")
local ServerModules = require(ServerStorage:WaitForChild("Modules"))

local FloorDataModule = ServerModules.Data.FloorData

local SystemsContainer = {}

-- // Module // --
local Module = {}

function Module.GetActiveFloorName(): string
	for name, id in FloorDataModule.FloorUniverseIds do
		if game.PlaceId == id then
			return name
		end
	end
	return "unknown"
end

function Module.GetActiveFloorNumber(): number
	return FloorDataModule.UniverseIdsToNumber[tostring(game.PlaceId)]
end

function Module.SetIsPlayerTeleporting(player: Player, isTeleporting: boolean?)
	player:SetAttribute("IsTeleporting", isTeleporting)
end

function Module.GetIsPlayerTeleporting(player: Player)
	return player:GetAttribute("IsTeleporting")
end

function Module.CreateBlankSaveIfMissing(player: Player)
	local profile = SystemsContainer.DataManagerServer.GetProfileFromPlayer(player)
	if not profile then
		return
	end

	if #profile.Data.Saves == 0 then
		local _ = SystemsContainer.SavesManagerServer.AppendNewSave(player)
	end
end

function Module.IsSourcePlaceIdAllowed(sourcePlaceId : number)
	for _, id in FloorDataModule.FloorUniverseIds do
		if id == sourcePlaceId then
			return true
		end
	end
	return false
end

function Module.GetSaveIndexFromTeleportData(player: Player): number?
	local profile = SystemsContainer.DataManagerServer.GetProfileFromPlayer(player)
	if not profile then
		player:Kick("Profile could not be loaded")
		return nil
	end

	if RunService:IsStudio() then
		Module.CreateBlankSaveIfMissing(player)
		return 1
	end

	local join_data = player:GetJoinData()
	local teleport_data = join_data and join_data.TeleportData
	if (not join_data) or (not teleport_data) then
		player:Kick("No teleport data - rejoin.")
		return nil
	end

	if not Module.IsSourcePlaceIdAllowed(join_data.SourcePlaceId) and not RunService:IsStudio() then
		player:Kick("Error: Invalid SourcePlaceId.")
		return nil
	end

	if not teleport_data.SaveIndex then
		teleport_data.SaveIndex = 1
		local msg = 'Player joined server with no SaveIndex from placeId %d. Setting to 1.'
		warn(string.format(msg, join_data.SourcePlaceId or -1))
	end

	return teleport_data.SaveIndex
end

function Module.DoTeleportProfileLogic(player: Player)
	Module.SetIsPlayerTeleporting(player, true)
	task.delay(10, function()
		if player:IsDescendantOf(Players) then
			Module.SetIsPlayerTeleporting(player, nil)
		end
	end)
	SystemsContainer.DataManagerServer.ReleasePlayerProfile(player)
end

function Module.TeleportToFloor(player: Player, saveIndex: number, floorNumber: number?): boolean
	floorNumber = floorNumber or 0

	local msg = "Teleporting %s to floor %s"
	print(string.format(msg, player.Name, tostring(floorNumber)))

	local UniverseId = FloorDataModule.FloorUniverseIds["Floor"..tostring(floorNumber)] or FloorDataModule.FloorUniverseIds.Floor0
	TeleportService:SetTeleportSetting('TargetUniverseId', UniverseId)
	TeleportService:Teleport(UniverseId, player, { SaveIndex = saveIndex })
	Module.DoTeleportProfileLogic(player)
	return true
end

function Module.TeleportPartyToFloor(players: {Player}, saveIndex: number, floorNumber: number)
	floorNumber = floorNumber or 1

	local msg = "Teleporting %s players to floor %s"
	print(string.format(msg, tostring(#players), tostring(floorNumber)))

	local UniverseId: number = FloorDataModule.FloorUniverseIds["Floor"..tostring(floorNumber)] or FloorDataModule.FloorUniverseIds.Floor0
	TeleportService:SetTeleportSetting('TargetUniverseId', UniverseId)
	TeleportService:TeleportPartyAsync(UniverseId, players, { SaveIndex = saveIndex })
	for _, player in players do
		task.defer(Module.DoTeleportProfileLogic, player)
	end
end

function Module.TeleportToSaveFloor(player: Player, saveIndex: number): boolean
	local profile = SystemsContainer.DataManagerServer.GetProfileFromPlayer(player)
	if not profile then
		return false
	end
	local floor_number = profile.Data.Saves[saveIndex].CurrentFloor or 0
	Module.TeleportToFloor(player, saveIndex, floor_number)
	return true
end

function Module.Start()

end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/LightingTracker"><![CDATA[
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local SystemsContainer = {}

local DEFAULT_THUNDERSTORM_CHANCE = 300

-- // Module // --
local Module = {}

function Module.Start()

	ReplicatedStorage:SetAttribute('Thunderstorm', false)
	ReplicatedStorage:SetAttribute('SyncingTimeValue', 0)
	-- WeatherLocked: when true (set by the SetWeather Cmdr command),
	-- the random thunderstorm flipper below is suppressed so a manual
	-- override sticks. SetWeather flips this on; clearing it via
	-- `/SetWeather auto` (or setting WeatherLocked=false directly)
	-- restores the random ambient weather.
	ReplicatedStorage:SetAttribute('WeatherLocked', false)

	task.spawn(function()
		local RNG = Random.new()
		while true do
			task.wait(1)
			ReplicatedStorage:SetAttribute('SyncingTimeValue', time())
			-- Skip the random flip when an admin has locked the weather.
			-- The check is per-tick so unlocking takes effect on the next
			-- second without restart.
			if ReplicatedStorage:GetAttribute('WeatherLocked') == true then
				continue
			end
			if RNG:NextInteger(1, DEFAULT_THUNDERSTORM_CHANCE) == 1 then
				local State = not ReplicatedStorage:GetAttribute('Thunderstorm')
				ReplicatedStorage:SetAttribute('Thunderstorm', State)
			end
		end
	end)

end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/DialogueServer"><![CDATA[-- DialogueServer — receives DialogueAction events from the dialogue
-- widget and routes named actions to the right handler. Action ids
-- live in dialogue trees (`DialogueBuilder.SingleAction(actionId)`)
-- and are dispatched here so each subsystem can subscribe without the
-- dialogue config knowing the system topology.
--
-- Adding an action:
--   1. Author the dialogue tree with `SingleAction('your_action_id')`.
--   2. Register a handler via Module.RegisterAction('your_action_id', fn).
--      The fn receives (player, dialogueId).
-- The Tutor's intro flow registers below as a built-in.

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local RemoteService = ReplicatedModules.Services.RemoteService
local DialogueActionRemote = RemoteService.GetRemote('DialogueAction', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Action registry. Handlers are (player, dialogueId) → void.
-- Multiple handlers per action allowed (analytics + game effect both
-- listen to the same action without forking the tree).
----------------------------------------------------------------------
type ActionHandler = (player: Player, dialogueId: any) -> ()
local Handlers: { [string]: { ActionHandler } } = {}

function Module.RegisterAction(actionId: string, handler: ActionHandler)
	Handlers[actionId] = Handlers[actionId] or {}
	table.insert(Handlers[actionId], handler)
end

local function dispatch(player: Player, dialogueId: any, actionId: string)
	local list = Handlers[actionId]
	if not list then return end
	for _, fn in list do
		local ok, err = pcall(fn, player, dialogueId)
		if not ok then
			warn(string.format('[DialogueServer] action %q handler error: %s',
				actionId, tostring(err)))
		end
	end
end

----------------------------------------------------------------------
-- Built-in handlers.
----------------------------------------------------------------------
local function registerBuiltins()
	-- Tutor onboarding completion. Advances the player past the
	-- 'meet_tutor' onboarding step. Other handlers (analytics, quest
	-- starts) can register against the same action without conflict.
	Module.RegisterAction('tutor_intro_complete', function(player)
		local Onboarding = SystemsContainer.OnboardingServer
		if Onboarding and Onboarding.AdvanceIfStep then
			Onboarding.AdvanceIfStep(player, 'meet_tutor')
		end
	end)
end

function Module.Start()
	registerBuiltins()
	DialogueActionRemote.OnServerEvent:Connect(function(player, dialogueId, action)
		if typeof(action) ~= 'string' then return end
		dispatch(player, dialogueId, action)
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/RenderSystemServer"><![CDATA[
local CollectionService = game:GetService('CollectionService')

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local LODSettings = ReplicatedModules.Data.LODSettings

local TEMPORARY_LOD_CONTAINER = ReplicatedStorage:FindFirstChild('RenderLODCache')
if not TEMPORARY_LOD_CONTAINER then
	TEMPORARY_LOD_CONTAINER = Instance.new('Folder')
	TEMPORARY_LOD_CONTAINER.Name = 'RenderLODCache'
	TEMPORARY_LOD_CONTAINER.Parent = ReplicatedStorage
end

local TEMPORARY_INTERIORS_CONTAINER = ReplicatedStorage:FindFirstChild('RenderInteriorCache')
if not TEMPORARY_INTERIORS_CONTAINER then
	TEMPORARY_INTERIORS_CONTAINER = Instance.new('Folder')
	TEMPORARY_INTERIORS_CONTAINER.Name = 'RenderInteriorCache'
	TEMPORARY_INTERIORS_CONTAINER.Parent = ReplicatedStorage
end

local ORIGINAL_PARENTS_CACHE = {}

-- Module --
local Module = {}

function Module.SetupLOD()
	-- function to handle object setup
	local function SetupObject(object)
		ORIGINAL_PARENTS_CACHE[object] = object.Parent
		local success, err = pcall(function()
			object.Parent = TEMPORARY_LOD_CONTAINER
		end)
		if not success then
			warn(object:GetFullName())
			warn(err) -- bones, attachments will appear in the error
		end
	end

	-- function to reset the object
	local function ResetObject(object)
		local success, err = pcall(function()
			object.Parent = ORIGINAL_PARENTS_CACHE[object]
		end)
		if not success then
			warn(object:GetFullName())
			warn(err) -- bones, attachments will appear in the error
		end
	end

	for _, LODTag in LODSettings.LODTags do
		-- skip those that are server-side enabled
		if table.find(LODSettings.ServerEnabled, LODTag) then
			continue
		end
		-- print('Hiding LODTag:', LODTag)
		-- un-render the rest on the server
		for _, object in CollectionService:GetTagged(LODTag) do
			task.defer(SetupObject, object)
		end
		-- unrender any newly tagged instances
		CollectionService:GetInstanceAddedSignal(LODTag):Connect(SetupObject)
		-- reset untagged instances
		CollectionService:GetInstanceRemovedSignal(LODTag):Connect(ResetObject)
	end
end

function Module.SetupInteriors()
	-- function to handle object setup
	local function SetupObject(object)
		-- objects container
		local ObjectsContainer = object:FindFirstChild('Objects')
		if not ObjectsContainer then
			warn('Could not find "Objects" item in Interior: '..tostring(object:GetFullName()))
			return
		end
		-- zones container
		local ZonesContainer = object:FindFirstChild('Zones')
		if not ZonesContainer then
			warn('Could not find "Zones" item in Interior: '..object:GetFullName())
			return
		end
		-- change the properties to the adjusted ones
		for _, zoneObject in ZonesContainer:GetChildren() do
			if zoneObject:IsA('BasePart') then
				zoneObject.CanCollide = false
				zoneObject.CanQuery = true
				zoneObject.CanTouch = false
				zoneObject.CastShadow = false
				zoneObject.Transparency = 1
				zoneObject.Massless = true
			else
				warn('Unsupported Zone object in Zones container: '..object:GetFullName())
			end
		end
		-- iterate each ObjectValue or Instance under the Objects container.
		for _, objectReference in ObjectsContainer:GetChildren() do
			local objectr = objectReference
			if objectReference:IsA('ObjectValue') then
				objectr = objectReference.Value
			end
			if not objectr then
				warn('ObjectValue has no reference: '..objectReference:GetFullName())
				continue
			end
			ORIGINAL_PARENTS_CACHE[object] = objectr.Parent
			local success, err = pcall(function()
				objectr.Parent = TEMPORARY_INTERIORS_CONTAINER
			end)
			if not success then
				warn(objectr:GetFullName())
				warn(err) -- bones, attachments will appear in the error
			end
		end
	end

	-- function to reset the object
	local function ResetObject(object)
		local success, err = pcall(function()
			object.Parent = ORIGINAL_PARENTS_CACHE[object]
		end)
		if not success then
			warn(object:GetFullName())
			warn(err) -- bones, attachments will appear in the error
		end
	end

	for _, InteriorTag in LODSettings.InteriorTags do
		-- skip those that are server-side enabled
		if table.find(LODSettings.ServerEnabled, InteriorTag) then
			continue
		end
		-- print('Hiding InteriorTag:', InteriorTag)
		-- un-render the interior objects
		for _, object in CollectionService:GetTagged(InteriorTag) do
			task.defer(SetupObject, object)
		end
		-- unrender any newly tagged instances
		CollectionService:GetInstanceAddedSignal(InteriorTag):Connect(SetupObject)
		-- reset untagged instances
		CollectionService:GetInstanceRemovedSignal(InteriorTag):Connect(ResetObject)
	end
end

function Module.Init()

end

function Module.Start()

	Module.SetupLOD()
	Module.SetupInteriors()

end

return Module

]]></Source>
		<Source path="ServerStorage/Core/SavesManagerServer"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local CharacterData = ReplicatedModules.Data.Character
local SaveSlotConfig = ReplicatedModules.Data.SaveSlotConfig
local UTCUtility = ReplicatedModules.Utility.UTC

-- 1 → 2: add Boosters = { Active = {}, History = {} }. Existing
-- Achievements field was reserved earlier; both reconcile via the
-- "fill missing template fields" pass below.
-- 2 → 3: reserve the per-player "seen" / "encountered" maps used by
-- the config-replication migration (ROADMAP.md). Fields are added
-- now as empty tables — they're not populated until the relevant
-- phase wires its trigger source. Adding all of them in one bump
-- avoids per-phase save-version churn.
local CURRENT_SAVE_VERSION = 3

local SystemsContainer = {}

local DefaultBaseCustomization = {} do
	-- get the first of each
	for key, value in CharacterData.Customizations do
		if key == "Hair2" then
			continue
		end
		DefaultBaseCustomization[key] = value:GetChildren()[1].Name
	end
end

local EmptySaveTemplate = {
	-- data
	Version = CURRENT_SAVE_VERSION,
	Timestamp = false,
	CurrentFloor = 0,

	-- stats
	Race = 1, -- 1 = human
	Level = 1,
	Experience = 0,
	Currency = 0,
	Reputation = 0,
	Bounty = 0,

	-- Per-save difficulty. Lowercase id matching ReplicatedStorage's
	-- Data.Difficulty registry — 'normal' | 'hard' | 'death'. Drives:
	--   * HUD difficulty badge (OnscreenWidget, gold HARD / red DEATH)
	--   * HP cap multiplier (GameControllerServer.OnCharacterAdded)
	--   * Incoming-damage multiplier (DamageModule.DamageHumanoid)
	--   * XP gain multiplier (DataEditServer.GiveExperienceToPlayer)
	-- The field is persisted so the difficulty survives rejoin. Permadeath
	-- + auction / trading / party gates listed in the registry are NOT
	-- wired yet (those features aren't implemented).
	Difficulty = 'normal',

	-- Skill points awarded on level-up; spent in the SkillsTab tree to
	-- unlock skills. Attributes used to consume a parallel point pool but
	-- now level purely from XP earned in-world, so no AttributePoints
	-- field is persisted.
	SkillPoints = 0,

	Inventory = {},
	-- Mounts persistent state.
	--   OwnedMounts   — { [mountId] = { UnlockedAt } }
	--   EquippedMount — currently-summoned live mount; cleared each respawn
	--                   (the rider has to re-summon after death).
	--   PreferredMount — last mount the player intentionally equipped via
	--                   the Mounts tab. Survives respawns and lets the G
	--                   keybind re-summon "your mount" without opening the
	--                   menu. nil until the player picks one.
	Mounts = { OwnedMounts = {}, EquippedMount = nil, PreferredMount = nil },
	-- Companions: { Owned = { [id] = { Level, XP, Bond, UnlockedAt }},
	--               Equipped = { id, id, ... } }
	-- Equipped is now an array of slot ids; the legacy single-string
	-- shape is auto-migrated by CompanionsShared.MigrateEquippedShape on
	-- first read. Slot cap is gamepass-gated via PremiumServer
	-- .GetMaxCompanionSlots; the persistent `MaxEquipped` field is
	-- retained as a Cmdr-driven hard override (set by the cmdr
	-- SetMaxEquippedCompanions command for testing).
	Companions = { Owned = {}, Equipped = {} },
	-- Crafting: { ArtisanLevels[school] = { Level, XP }, UnlockedRecipes, InProgressCrafts }
	-- UnlockedBlueprints is the artisan-system blueprint roster (forge);
	-- mapping blueprintId → { UnlockedAt }. Loot drops + cmdr can grant.
	-- See ARTISAN.md §9.
	--
	-- UnlockedForgeTemplates — set of forge weapon templates the player
	-- is permitted to craft. Distinct from UnlockedBlueprints: a player
	-- may KNOW a blueprint exists (UnlockedBlueprints, controlled by
	-- discovery / loot drops) but not yet meet the artisan-level gate
	-- to actually USE it (UnlockedForgeTemplates, granted by the forge
	-- server when the player's Smithing level reaches the template's
	-- RequiredArtisanLevel). Mapping templateId → { UnlockedAt }. The
	-- forge widget grays out templates whose ids aren't in this set.
	Crafting = {
		ArtisanLevels = {}, UnlockedRecipes = {}, InProgressCrafts = {},
		UnlockedBlueprints = {},
		UnlockedForgeTemplates = {},
	},
	-- SocketedGems is an inverse index — gem-uuid → item-uuid the gem is
	-- currently slotted into. Lets the inventory tab grey/hide already-
	-- socketed gems with O(1) lookup. GemSocketServer maintains it
	-- alongside per-item Composition.Socketing.Slots.
	SocketedGems = {},
	-- Auras: { Owned = { [auraId] = { UnlockedAt }}, Equipped = { auraId, auraId, ... }}
	-- Equipped is a slot array; AurasShared.MigrateEquippedShape converts
	-- legacy dict-shaped saves on first read. Mutations through
	-- AurasServer push/pop the saveData.Auras.Equipped table directly,
	-- so persistence flows through SavesManagerServer's standard save
	-- pipeline — no separate sync hook needed.
	Auras = { Owned = {}, Equipped = {} },
	-- Onboarding: tracks tutorial step completion + intro state. Lazily
	-- ensured by OnboardingServer; gameplay code reads via the helper.
	Onboarding = { CompletedSteps = {}, CurrentStep = nil, IntroPlayed = false },
	-- FFlags: one-shot feature flags (e.g. ONBOARDING_JOIN_GAME_1). Owned
	-- by FFlagsServer; ids defined in Data.FFlags. Lazily ensured.
	FFlags = {},
	Consumables = {},
	Storages = {},

	Waystones = {},
	Discoveries = {},

	Equipped = {},
	EquippedLoadouts = {},
	BaseCustomizations = DefaultBaseCustomization,

	Titles = {},
	Attributes = {},
	Skills = {},

	-- Client UI / audio preferences. Mirrors the keys in
	-- StarterPlayerScripts/Modules/Modules/SettingsRegistry.luau; values
	-- here are the persisted source of truth, loaded into the registry
	-- on join and written back via ClientPersistenceServer when the
	-- player toggles something. Volumes are 0..1 fractions. Defaults
	-- match the registry defaults.
	-- (UIScale removed — feature parked while implementation is
	-- redesigned. Old saves with a stray UIScale field replicate
	-- harmlessly; nothing reads it now.)
	Settings = {
		MasterVolume = 0.72,
		MusicVolume = 0.48,
		SFXVolume = 0.80,
		UITheme = 'Crystal dark',
		MusicWidgetEnabled = true,
		MinimapEnabled = true,
		OnscreenButtonsEnabled = true,
		-- Nier-style combat toggles. Defaults match SettingsRegistry.
		--   PvPLockOnConsent: opt-in (false) — see NIER_COMBAT.md.
		--   CompanionAutoAttack: on by default; players can disable
		--   if they want non-combat companions.
		PvPLockOnConsent = false,
		-- Server-authoritative "allow PvP damage to me" toggle. Mirrors
		-- the SettingsRegistry field; persists across rejoin so a player
		-- who opts in stays opted in. DamageModule.DamageHumanoid reads
		-- saveData.Settings.AllowPvP as the gate.
		AllowPvP = false,
		CompanionAutoAttack = true,
		-- Waypoint category toggles. Default on so first-time players
		-- see the world markers; either can be flipped off in Settings.
		WaypointsWorkstationsEnabled = true,
		WaypointsWaystonesEnabled    = true,
		WaypointsSubstationsEnabled  = true,
		-- Compass HUD toggle — top-of-screen waypoint strip. Default on
		-- so the affordance is discoverable; clean-HUD players can flip
		-- in Settings.
		CompassEnabled               = true,
		-- Overhead-nameplate hide toggles, all default-true. See
		-- SettingsRegistry header for the split (own / other player /
		-- enemy). Reconciler fills these onto older saves.
		OverheadOwnEnabled      = true,
		OverheadOthersEnabled   = true,
		OverheadEnemiesEnabled  = true,
		Generic = {},
	},

	-- Hotbar bindings. Map of slotId ('r1_1'..'r1_12', 'r2_1'..'r2_12') →
	--   { type = 'item' | 'skill', uuid? = string, id? = string }
	-- Server validates each write through ClientPersistenceServer; the
	-- HotbarWidget reads this map directly off PlayerData on every tick.
	-- Keyed by stable slotId (NOT keybind) so rebinding a slot's hotkey
	-- doesn't orphan its item/skill assignment.
	Hotbar = {},

	-- Hotbar keybinds. Map of slotId → single lowercase character that
	-- activates that slot. Empty means "use default" (defaults are baked
	-- into HotbarWidget.DEFAULT_KEYBINDS — 1..0,-,= for row 1; uiophjklvbnm
	-- for row 2). Single-character strings only.
	Keybinds = {},

	-- Combat action keybinds. Map of actionId → Roblox KeyCode.Name
	-- string ('F', 'Q', 'LeftControl', etc.). Distinct from `Keybinds`
	-- above because action keybinds support non-printable keys (modifiers,
	-- function keys) — single-char storage isn't enough. Defaults are
	-- baked into CombatInputClient.DEFAULT_ACTION_KEYBINDS:
	--   Block='F', SheatheToggle='Q', Mount='G', Heal='D', Dash='LeftControl'.
	-- Empty entry → use default.
	ActionKeybinds = {},

	ActiveQuests = {},
	CompletedQuests = {},

	Achievements = {},
	Progression = {},

	-- Active and historical boosters — populated by BoostersServer.
	-- Active[uuid] = { Id, EndsAt (epoch sec; 0 = permanent), Source }.
	-- History[boosterId] = { TotalSeconds, LastEndedAt }.
	Boosters = { Active = {}, History = {} },

	-- Per-player admin / dev flags. Sub-table so future flags don't
	-- pollute the top level. Cmdr writes here (e.g. SetLevelGateBypass),
	-- the value persists across rejoins.
	Flags = {
		-- Per-system level-gate bypass. `all=true` bypasses every gate;
		-- per-system keys (skills/crafting/forge/gems/enchant) bypass
		-- only that one system. Cmdr `SetLevelGateBypass <player> <system>
		-- <bool>` writes the requested key. Distinct from the server-wide
		-- global map in LevelGatesServer.GlobalBypass.
		--
		-- Legacy boolean shape (data.Flags.LevelGateBypass = bool) is
		-- still recognised by LevelGates.IsBypassed — old saves get
		-- treated as "all = bool" until the next admin write upgrades
		-- the shape.
		LevelGateBypass = {
			all      = false,
			skills   = false,
			crafting = false,
			forge    = false,
			gems     = false,
			enchant  = false,
		},
	},

	Guild = {Id = nil},

	-- Per-player game statistics. Sparse map keyed by stringified
	-- StatisticIds (so JSON serialization is deterministic). Each
	-- value is either a number (Counter / Record / Timestamp) or a
	-- nested map (Map kind, e.g. per-boss kills). Read / written
	-- exclusively through StatisticsServer; see
	-- ReplicatedStorage/Modules/Data/StatisticsConfig.luau for the
	-- id → kind / label / group registry.
	Statistics = {},

	-- // Config-replication "seen" / "encountered" maps //
	-- Populated by the per-system trigger sources documented in
	-- ROADMAP.md (Phases 2-3). Each is a sparse map keyed by config
	-- id → { FirstSeenAt | FirstEncounteredAt = unix-ts }. They're
	-- reserved here at v3 so future phases don't each need their
	-- own save-version bump; adding the empty maps now is zero-bloat.
	-- A field is unread until the phase that populates it ships;
	-- callers must tolerate the empty map shape.
	SeenMaterials     = {},  -- [matId]    = { FirstSeenAt }
	SeenEnchants      = {},  -- [enchId]   = { FirstSeenAt }
	SeenGems          = {},  -- [gemId]    = { FirstSeenAt }
	SeenStatusEffects = {},  -- [effectId] = { FirstSeenAt }
	SeenModifiers     = {},  -- [modId]    = { FirstSeenAt }
	EncounteredBosses = {},  -- [bossId]   = { FirstEncounteredAt }

	-- misc
	Analytics = {
		TimePlayed = 0,
		PvEKills = {},
		PvEDeaths = {},
		PvPKills = {},
		PvPDeaths = {},
		Events = {},
	},
	Purchases = {
		TotalSpent = 0,
		Purchases = {},
	},
}

local function DeepCopy(original)
	local copy = {}
	for k, v in original do
		if typeof(v) == "table" then
			v = DeepCopy(v)
		end
		copy[k] = v
	end
	return copy
end

-- // Module // --
local Module = {}

Module.SelectedIndexes = {} :: {[Player]: number}

function Module.CreateEmptySave()
	return DeepCopy(EmptySaveTemplate)
end

function Module.ReconcileSaves(player: Player)
	local profile = SystemsContainer.DataManagerServer.GetProfileFromPlayer(player)
	if not profile then
		return
	end

	local template = Module.CreateEmptySave()
	for _, save_data in profile.Data.Saves do
		if save_data.Version == CURRENT_SAVE_VERSION then
			continue
		end
		if not save_data.Timestamp then
			save_data.Timestamp = UTCUtility.GetUTCTimestamp()
		end
		for key, value in template do
			if not save_data[key] then
				save_data[key] = DeepCopy(value)
			end
		end
		save_data.Version = CURRENT_SAVE_VERSION
	end
end

function Module.GetPlayerSelectedSaveDataFromIndex(player: Player, index: number): any?
	local profile = SystemsContainer.DataManagerServer.GetProfileFromPlayer(player)
	if not profile then
		return nil
	end
	return profile.Data.Saves[index]
end

function Module.GetSelectedSaveIndex(player: Player): number?
	return Module.SelectedIndexes[player]
end

function Module.YieldUntilSaveIndexSelected(player: Player): number?
	local index: number? = Module.GetSelectedSaveIndex(player)
	while player:IsDescendantOf(Players) and not index do
		index = Module.GetSelectedSaveIndex(player)
		RunService.Heartbeat:Wait()
	end
	return index
end

function Module.GetPlayerSelectedSaveData(player: Player): any?
	local profile = SystemsContainer.DataManagerServer.GetProfileFromPlayer(player)
	if not profile then
		return nil
	end

	local index: number? = Module.GetSelectedSaveIndex(player)
	if not index then
		return nil
	end

	return profile.Data.Saves[index]
end

function Module.SelectSaveIndex(player: Player, index: number)
	Module.SelectedIndexes[player] = index
end

function Module.RemovePlayerSave(player: Player, index: number)
	local profile = SystemsContainer.DataManagerServer.GetProfileFromPlayer(player)
	if not profile then
		return
	end
	if not profile.Data.Saves[index] then
		return
	end
	local data = table.remove(profile.Data.Saves, index)
	if data.Level < 3 then
		return -- only save level 3+ saves
	end
	table.insert(profile.Data.DeletedSaves, data)
end

function Module.CanCreateNewSave(player: Player): number?
	local profile = SystemsContainer.DataManagerServer.GetProfileFromPlayer(player)
	if not profile then
		return nil
	end
	return #profile.Data.Saves + 1 <= SaveSlotConfig.MaxSaveSlots
end

function Module.AppendNewSave(player: Player): number?
	local profile = SystemsContainer.DataManagerServer.GetProfileFromPlayer(player)
	if not profile then
		return nil
	end
	print(player)
	print(profile.Data)

	local blank = Module.CreateEmptySave()
	blank.Timestamp = UTCUtility.GetUTCTimestamp()
	table.insert(profile.Data.Saves, blank)
	return #profile.Data.Saves
end

function Module.Start()

end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/PlayerInventoryServer"><![CDATA[-- Services
local Players = game:GetService('Players')
local HttpService = game:GetService('HttpService')

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))
local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

local RemoteService = ReplicatedModules.Services.RemoteService
local InventoryEvent = RemoteService.GetRemote('InventoryEvent', 'RemoteEvent', false)

local ItemsConfigModule = ServerModules.Data.Items
local CombatSharedModule = ReplicatedModules.Services.CombatShared

local Slots = ItemsConfigModule.EquipmentSlotEnums

-- Map an EquipmentSlotEnums value to the attribute-key suffix used by
-- the rest of the system (CombatShared reads `1_Weapon` / `2_Weapon`,
-- the renderer client gates the Weapon-visual branch on the substring
-- "Weapon" — see EquipmentRendererClient.UpdateCharacterVisuals).
-- This mirrors the NPC pathway in NPCInventoryServer so player and
-- mob equips end up in the same attribute namespace.
local SLOT_KEY_TOKEN = {
	[Slots.Hand]     = 'Weapon',
	[Slots.Head]     = 'Head',
	[Slots.Chest]    = 'Chest',
	[Slots.Legs]     = 'Legs',
	[Slots.Boots]    = 'Boots',
	[Slots.Bracelet] = 'Bracelet',
	[Slots.Neck]     = 'Neck',
	[Slots.Ear]      = 'Ear',
	[Slots.Finger]   = 'Finger',
	[Slots.Curio]    = 'Curio',
}

-- The new Items.luau schema dropped the flat `EquipData.IsDualWield`
-- flag in favor of per-slot `AllowMultiEquip` + `MaxMultiEquip`. We
-- treat an item as dual-wield when its primary slot allows >1 equips.
local function IsItemDualWield(itemConfig): boolean
	if not itemConfig or not itemConfig.EquipmentData then
		return false
	end
	local first = itemConfig.EquipmentData.EquipSlots[1]
	return first ~= nil
		and first.AllowMultiEquip == true
		and (first.MaxMultiEquip or 0) > 1
end

local SystemsContainer = {}
local UUIDToItemIdCache = {}

-- // Module --
local Module = {}

function Module.GetCustomSlotIndex(itemType, customSlot)
	return tostring(customSlot).."_"..itemType
end

function Module.CreateGenericItemStackData(quantity)
	return {Quantity = quantity or 1}
end

function Module.FindItemIdGivenUUID(player, uuid)
	return UUIDToItemIdCache[player] and UUIDToItemIdCache[player][uuid]
end

function Module.GetItemUUIDsOfItemId(player, itemId)
	local uuids = {}
	local save_data = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not save_data then
		return uuids
	end

	if not save_data.Inventory[itemId] then
		return uuids
	end

	for uuid, _ in save_data.Inventory[itemId] do
		table.insert(uuids, uuid)
	end

	if #uuids == 0 then
		save_data.Inventory[itemId] = nil
	end
	Module.GenerateUUIDToItemId(player)

	return uuids
end

function Module.GenerateUUIDToItemId(player)
	local save_data = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not save_data then
		return
	end

	UUIDToItemIdCache[player] = {}
	for itemId, uuidCache in save_data.Inventory do
		for uuid, _ in uuidCache do
			UUIDToItemIdCache[player][uuid] = itemId
		end
	end
end

function Module.GiveQuantityOfItemIdToPlayer(player, itemId, quantity)
	quantity = quantity or 1
	-- Cache the original quantity before the deduction loop mutates it
	-- — used by the toast call at the end so the player sees the
	-- correct received-amount.
	local originalQuantity = quantity

	print(player.Name, itemId, quantity)

	local itemConfig = ItemsConfigModule.GetConfigFromId(itemId)
	if not itemConfig then
		warn(string.format('No item config is available for item: %s', tostring(itemId)))
		return {}
	end

	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData then
		warn(string.format('Player %s has no save selected.', player.Name))
		return {}
	end

	local inventory = saveData.Inventory

	-- Detect first-time acquisition of this itemId for THIS player.
	-- The replicator's Add push only matters when the player didn't
	-- already have the config row in their client shell; subsequent
	-- adds are no-ops on the client (table assignment to same value).
	-- We still push defensively for self-healing — see Mounts pattern.
	local wasNewToInventory = (inventory[itemId] == nil) or (next(inventory[itemId]) == nil)

	if not inventory[itemId] then
		inventory[itemId] = {}
	end

	local uuids = {}
	for uuid, stack in inventory[itemId] do
		local availableRoom = (itemConfig.MaxQuantity - stack.Quantity)
		if availableRoom > 0 then
			table.insert(uuids, uuid)

			local amount = math.min(quantity, availableRoom)
			stack.Quantity = stack.Quantity + amount

			quantity = quantity - amount
			if quantity == 0 then
				break
			end
		end
	end

	while quantity > 0 do
		local amount = math.min(quantity, itemConfig.MaxQuantity)
		local newUUID = HttpService:GenerateGUID(false)
		table.insert(uuids, newUUID)
		UUIDToItemIdCache[player][newUUID] = itemId
		saveData.Inventory[itemId][newUUID] = Module.CreateGenericItemStackData(amount)
		quantity = quantity - amount
	end

	Module.GenerateUUIDToItemId(player)

	-- Toast surface. Opt-out by passing 0 quantity (early-return above
	-- caught no-op cases). Suppressing per-call is a future addition if
	-- some grants should be silent; for now every grant toasts.
	local Toast = SystemsContainer.ToastServer
	if Toast and Toast.NotifyItemReceived and originalQuantity > 0 then
		Toast.NotifyItemReceived(player, itemId, originalQuantity)
	end

	-- Push the item config to the client shell so widgets / hotbar /
	-- inventory tab can render the new row without waiting for a
	-- bootstrap pass. Defensive: idempotent on subsequent adds of the
	-- same id (self-healing if any earlier push was missed).
	local Repl = SystemsContainer.ItemsConfigReplicationServer
	if Repl and Repl.OnItemAdded and wasNewToInventory then
		Repl.OnItemAdded(player, itemId)
	end

	return uuids
end

function Module.GetItemStackFromUUID(player, uuid)
	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData then
		return nil, nil
	end

	for itemId, itemDicts in saveData.Inventory do
		if itemDicts[uuid] then
			return itemDicts[uuid], itemId
		end
	end
	return nil, nil
end

----------------------------------------------------------------------
-- // Artisan input helpers — see ARTISAN.md §10 //
-- Forge materials, gems, and enchant scrolls are first-class inventory
-- items with metadata pointers (ItemConfig.ForgeMaterialId / GemId /
-- EnchantInputData) into the artisan catalogs. These helpers walk
-- inventory with that metadata so the artisan servers don't repeat
-- the inventory traversal logic in three places.
----------------------------------------------------------------------

-- Sum total UnitsPerStack for every owned stack whose ForgeMaterialId
-- == materialId. Used by ForgeServer.CanForgeWeapon as the "do you
-- have enough iron" predicate. Returns 0 when missing.
function Module.GetForgeMaterialUnits(player: Player, materialId: string): number
	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData or typeof(saveData.Inventory) ~= 'table' then return 0 end
	local total = 0
	for itemId, uuidcache in saveData.Inventory do
		local cfg = ItemsConfigModule.Items[itemId]
		local fm = cfg and ItemsConfigModule.GetForgeMaterial(cfg)
		if fm and fm.Id == materialId then
			local units = fm.UnitsPerStack or 1
			for _, stack in uuidcache do
				if typeof(stack) == 'table' then
					total += (stack.Quantity or 1) * units
				end
			end
		end
	end
	return total
end

-- Consume `units` worth of `materialId` from the player's inventory.
-- Walks matching stacks until the budget is met, decrementing
-- Quantity and deleting empty stacks. Returns true on success;
-- returns false WITHOUT mutating anything when the player doesn't
-- have enough.
function Module.ConsumeForgeMaterialUnits(player: Player, materialId: string, units: number): boolean
	if typeof(units) ~= 'number' or units <= 0 then return true end
	if Module.GetForgeMaterialUnits(player, materialId) < units then return false end
	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData or typeof(saveData.Inventory) ~= 'table' then return false end
	local remaining = units
	for itemId, uuidcache in saveData.Inventory do
		if remaining <= 0 then break end
		local cfg = ItemsConfigModule.Items[itemId]
		local fm = cfg and ItemsConfigModule.GetForgeMaterial(cfg)
		if not fm or fm.Id ~= materialId then continue end
		local perStackUnits = fm.UnitsPerStack or 1
		for uuid, stack in uuidcache do
			if remaining <= 0 then break end
			if typeof(stack) ~= 'table' then continue end
			local stackUnits = (stack.Quantity or 1) * perStackUnits
			if stackUnits <= remaining then
				-- Whole stack consumed.
				remaining -= stackUnits
				Module.AttemptPlayerDeleteItemOfUUID(player, uuid)
			else
				-- Partial: decrement Quantity. integer-rounded.
				local consumeQty = math.ceil(remaining / perStackUnits)
				stack.Quantity = (stack.Quantity or 1) - consumeQty
				remaining -= consumeQty * perStackUnits
				if stack.Quantity <= 0 then
					Module.AttemptPlayerDeleteItemOfUUID(player, uuid)
				end
			end
		end
	end
	return true
end

-- Inverse-index check for gem socketing: is this gemUuid currently
-- slotted into another item? Reads saveData.SocketedGems which the
-- GemSocketServer maintains as gemUuid → itemUuid.
function Module.IsGemSocketedSomewhere(player: Player, gemUuid: string): (boolean, string?)
	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData or typeof(saveData.SocketedGems) ~= 'table' then return false, nil end
	local where = saveData.SocketedGems[gemUuid]
	return where ~= nil, where
end

-- Sum the Quantity of every stack of a given itemId across the
-- player's inventory. Used by EnchantServer / GemSocketServer to
-- precondition essence costs without rifling the save struct.
function Module.GetItemQuantity(player: Player, itemId: string): number
	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData or typeof(saveData.Inventory) ~= 'table' then return 0 end
	local bucket = saveData.Inventory[itemId]
	if typeof(bucket) ~= 'table' then return 0 end
	local total = 0
	for _, stack in bucket do
		if typeof(stack) == 'table' then total += (stack.Quantity or 1) end
	end
	return total
end

-- Decrement the player's stack of `itemId` by `quantity`. Walks every
-- bucket entry, drains in order, and fully removes empty stacks. Returns
-- true on full success; false if the inventory underflowed (no partial
-- consumption — the inverse of GiveQuantityOfItemIdToPlayer's model).
-- Used by essence-cost paths in EnchantServer + GemSocketServer.
function Module.ConsumeItemQuantity(player: Player, itemId: string, quantity: number): boolean
	if typeof(quantity) ~= 'number' or quantity <= 0 then return true end
	if Module.GetItemQuantity(player, itemId) < quantity then return false end
	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData or typeof(saveData.Inventory) ~= 'table' then return false end
	local bucket = saveData.Inventory[itemId]
	if typeof(bucket) ~= 'table' then return false end
	local remaining = quantity
	for uuid, stack in bucket do
		if remaining <= 0 then break end
		local stackQty = stack.Quantity or 1
		if stackQty <= remaining then
			remaining -= stackQty
			Module.AttemptPlayerDeleteItemOfUUID(player, uuid)
		else
			stack.Quantity = stackQty - remaining
			remaining = 0
		end
	end
	return remaining == 0
end

-- Consume a single charge from an enchant scroll. Decrements the
-- scroll's `Charges` (defaulted from ItemConfig.EnchantInputData.Charges
-- on first use); deletes the scroll stack when charges hit 0. Returns
-- true if a charge was consumed.
function Module.ConsumeEnchantScroll(player: Player, scrollUuid: string): boolean
	local stack, itemId = Module.GetItemStackFromUUID(player, scrollUuid)
	if not stack or not itemId then return false end
	local cfg = ItemsConfigModule.Items[itemId]
	local meta = cfg and ItemsConfigModule.GetEnchantInput(cfg)
	if not meta then return false end
	-- First use: seed Charges on the stack from the config default.
	stack.Charges = stack.Charges or meta.Charges or 1
	if stack.Charges <= 0 then return false end
	stack.Charges -= 1
	if stack.Charges <= 0 then
		Module.AttemptPlayerDeleteItemOfUUID(player, scrollUuid)
	end
	return true
end

function Module.DoesPlayerHaveWeaponEquipped(player)
	local character = player.Character
	if not character then
		return false
	end
	local LH, RH = CombatSharedModule.GetCharacterEquippedWeaponsLR(character)
	return (LH or RH) ~= nil
end

function Module.UpdatePlayerEquippedWeaponsAttributes(player)
	local character = player.Character
	if not character then
		player:SetAttribute('HasWeaponEquipped', false)
		return false
	end
	local hasWeaponEquipped = Module.DoesPlayerHaveWeaponEquipped(player)
	character:SetAttribute('HasWeaponEquipped', hasWeaponEquipped)
	player:SetAttribute('HasWeaponEquipped', hasWeaponEquipped)
	return hasWeaponEquipped
end

function Module.IsPlayerItemEquipped(player, uuid)
	local save_data = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not save_data then
		warn(string.format('Player %s has no save selected.', player.Name))
		return false, nil
	end

	for slotId, slotData in save_data.Equipped do
		if slotData.uuid == uuid then
			return true, slotId
		end
	end
	return false, nil
end

function Module.CanEquipItemInSlot(itemId: string, slot: number): boolean
	local itemConfig = ItemsConfigModule.GetConfigFromId(itemId)
	if not itemConfig then
		warn(string.format('Unknown item of id: %s', itemId))
		return false
	end

	if not itemConfig.EquipmentData then
		return false
	end

	for _, slotData in itemConfig.EquipmentData.EquipSlots do
		if slotData.Slot == slot then
			return true
		end
	end

	return false
end

-- // Player Character Functions --

function Module.AttemptPlayerCharacterUnequipItemOfUUID(character, uuid)
	for key, value in character:GetAttributes() do
		if value == uuid then
			character:SetAttribute(key, nil)
		end
	end
	SystemsContainer.EquipmentRendererServer.RemoveEquipmentUUIDs(character, {uuid})
end

function Module.AttemptPlayerCharacterUnequipItemInItemSlot(character, itemSlot)
	character:SetAttribute(itemSlot, nil)
end

function Module.UnequipAllPlayerCharacterWeapons(character)
	local slotIds = {}
	for slot = 1, 2 do
		local itemSlot = Module.GetCustomSlotIndex("Weapon", slot)
		character:SetAttribute(itemSlot, nil)
		table.insert(slotIds, itemSlot)
	end
	SystemsContainer.EquipmentRendererServer.RemoveEquipmentSlotIds(character, slotIds)
end

function Module.ScanPlayerCharacterEquippedWeaponsForDualWield(character)
	local LeftHand, RightHand = CombatSharedModule.GetCharacterEquippedWeaponsLR(character)
	if LeftHand and LeftHand.ItemId then
		Module.AttemptPlayerCharacterUnequipItemInItemSlot(character, LeftHand.ItemId)
	end
	if RightHand and RightHand.ItemId then
		Module.AttemptPlayerCharacterUnequipItemInItemSlot(character, RightHand.ItemId)
	end
end

function Module.AttemptPlayerCharacterEquipItemOfUUID(character, uuid, itemId, customSlot)
	if not character then
		return false
	end

	-- `tostring(itemId)` so a nil arg surfaces as the literal string
	-- "nil" in the warn rather than crashing string.format on the
	-- type mismatch. Caller is supposed to pass a valid itemId, but
	-- guarding here keeps a malformed save from killing the equip path.
	local itemConfig = ItemsConfigModule.GetConfigFromId(itemId)
	if not itemConfig then
		warn(string.format('Unknown item of id: %s', tostring(itemId)))
		return false
	end

	if not itemConfig.EquipmentData then
		warn(string.format('Item of id %s is not equippable!', tostring(itemId)))
		return false
	end

	-- `customSlot` is the *sub-index* (left=1, right=2 for hands; 1 for
	-- single-instance slots like Head). The slot *enum* we validate
	-- against — and that picks the attribute-key token — comes from the
	-- item's primary EquipSlot config.
	local slot = customSlot or 1
	local primarySlotCfg = itemConfig.EquipmentData.EquipSlots[1]
	if not primarySlotCfg then
		warn(string.format('Item of id %s declares no EquipSlots!', itemId))
		return false
	end
	if slot < 1 or slot > (primarySlotCfg.IndexMax or 1) then
		warn(string.format('Sub-slot %d out of range (1..%d) for %s', slot, primarySlotCfg.IndexMax or 1, itemId))
		return false
	end

	local slotToken = SLOT_KEY_TOKEN[primarySlotCfg.Slot] or tostring(primarySlotCfg.Slot)
	local itemSlot = Module.GetCustomSlotIndex(slotToken, slot)

	-- For single-wield items, clear the whole hand pair before equipping.
	-- For dual-wield items (hand slots with AllowMultiEquip), leave the
	-- other hand alone so the player can hold one in each hand.
	if not IsItemDualWield(itemConfig) then
		Module.UnequipAllPlayerCharacterWeapons(character)
	end

	Module.AttemptPlayerCharacterUnequipItemInItemSlot(character, itemSlot)
	Module.AttemptPlayerCharacterUnequipItemOfUUID(character, uuid)

	character:SetAttribute(itemSlot, uuid)

	SystemsContainer.EquipmentRendererServer.SetEquipmentValues(character, itemSlot, uuid, itemId)
	return true
end

-- // Player API --

function Module.AttemptPlayerEquipItemOfUUID(player, uuid, customSlot)
	if not player.Character then
		return false
	end

	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData then
		return false
	end

	local itemStack, itemId = Module.GetItemStackFromUUID(player, uuid)
	if not itemStack then
		return false
	end

	local itemConfig = ItemsConfigModule.GetConfigFromId(itemId)
	if not itemConfig then
		return false
	end

	local slot = customSlot or 1
	local primarySlotCfg = itemConfig.EquipmentData and itemConfig.EquipmentData.EquipSlots[1]
	if not primarySlotCfg then
		return false
	end
	if slot < 1 or slot > (primarySlotCfg.IndexMax or 1) then
		return false
	end

	local slotToken = SLOT_KEY_TOKEN[primarySlotCfg.Slot] or tostring(primarySlotCfg.Slot)
	local slotId = Module.GetCustomSlotIndex(slotToken, slot)
	local indexMax = primarySlotCfg.IndexMax or 1

	-- Eviction rules for hand-slot weapons:
	--   1. The TARGET slot's existing weapon is always evicted, even
	--      on dual-into-dual swaps — without this the renderer cache
	--      keeps a stale entry until SetEquipmentValues happens to
	--      overwrite, and the prior weapon's attribute can leak into
	--      `UpdatePlayerEquippedWeaponsAttributes`.
	--   2. New item is NOT dual-wield → also evict every other hand
	--      slot (a 2H weapon can't share hands with anything).
	--   3. New item IS dual-wield BUT another hand currently holds a
	--      non-dual weapon → also evict all (the existing 2H must come
	--      off before we can hold a 1H in either hand).
	-- A single eviction set is built up first, then applied in one
	-- pass — keeps the saveData / renderer / character attribute
	-- update flow visibly atomic.
	local newIsDual = IsItemDualWield(itemConfig)
	local hasNonDualElsewhere = false
	for otherSlotIdx = 1, indexMax do
		local other = Module.GetCustomSlotIndex(slotToken, otherSlotIdx)
		if other == slotId then continue end
		local entry = saveData.Equipped[other]
		if entry and entry.itemId then
			local otherCfg = ItemsConfigModule.GetConfigFromId(entry.itemId)
			if otherCfg and not IsItemDualWield(otherCfg) then
				hasNonDualElsewhere = true; break
			end
		end
	end

	-- Compute the slot ids we need to evict. Target slot is always in
	-- the set; full hand-clear adds the rest when rules 2 or 3 apply.
	local evictAllHands = (not newIsDual) or hasNonDualElsewhere
	local evictSet: { string } = { slotId }
	if evictAllHands then
		for otherSlotIdx = 1, indexMax do
			local other = Module.GetCustomSlotIndex(slotToken, otherSlotIdx)
			if other ~= slotId then
				table.insert(evictSet, other)
			end
		end
	end

	-- Apply eviction. saveData (1) + character attribute (2) + renderer
	-- cache (3) — all three layers must match or attribute / visual /
	-- save can desync. RemoveEquipmentSlotIds clears (3) in one batched
	-- broadcast for the whole eviction set.
	for _, evictSlotId in evictSet do
		saveData.Equipped[evictSlotId] = nil
	end
	if player.Character then
		for _, evictSlotId in evictSet do
			player.Character:SetAttribute(evictSlotId, nil)
		end
		local renderer = SystemsContainer.EquipmentRendererServer
		if renderer and renderer.RemoveEquipmentSlotIds then
			renderer.RemoveEquipmentSlotIds(player.Character, evictSet)
		end
	end

	-- Write new entry + character-side equip. The character-side fn
	-- still runs its own dual-wield safety check (defensive — direct
	-- callers like the cmdr admin command bypass this function).
	saveData.Equipped[slotId] = {uuid = uuid, itemId = itemId, slot = slot}
	if player.Character then
		Module.AttemptPlayerCharacterEquipItemOfUUID(player.Character, uuid, itemId, slot)
	end
	Module.UpdatePlayerEquippedWeaponsAttributes(player)
	return true
end

function Module.AttemptPlayerUnequipItemOfUUID(player, uuid)
	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData then
		return
	end

	local itemId = UUIDToItemIdCache[player][uuid]
	if not itemId then
		print("no such item in player inventory; ", uuid)
		return
	end

	local itemConfig = ItemsConfigModule.GetConfigFromId(itemId)
	if not itemConfig then
		print("Could not find config for item of id: ", tostring(itemId))
		return
	end

	local itemEquipData = itemConfig.EquipmentData
	if not itemEquipData then
		print("could not find item equip data; ", itemId)
		return
	end

	for slotId, data in saveData.Equipped do
		if data.uuid == uuid then
			saveData.Equipped[slotId] = nil
		end
	end

	if not player.Character then
		return
	end

	Module.AttemptPlayerCharacterUnequipItemOfUUID(player.Character, uuid)
	Module.UpdatePlayerEquippedWeaponsAttributes(player)
end

-- Re-attach the persisted Equipped map onto the live character. Used on
-- respawn / CharacterAdded so character attributes + rendered models
-- come back in sync with saveData. Iterates a SNAPSHOT of saveData
-- entries because `AttemptPlayerCharacterEquipItemOfUUID` calls
-- `UnequipAllPlayerCharacterWeapons` for non-dual-wield items, which
-- clears OTHER pending hand attributes mid-loop — taking a snapshot
-- first makes the iteration order independent of those side-effects.
--
-- This function MUST NOT clear saveData.Equipped — the saved state is
-- the source of truth and other systems (the equip-toggle path,
-- persistence, ReplicatedData) read it directly. The previous version
-- of this function nil'd entries during iteration, leaving the saved
-- map empty after a respawn while the character had attributes set:
-- IsPlayerItemEquipped read the empty map and the next equip click
-- mistakenly entered the equip branch instead of the unequip branch.
function Module.AttemptPlayerReEquipItems(player)
	if not player.Character then
		return false
	end
	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData then
		return false
	end
	-- Snapshot the entries first so the side-effects of the inner equip
	-- call (which may clear other slots via UnequipAllWeapons) don't
	-- truncate our iteration. Defensive shape filter: skip entries
	-- with a missing uuid (malformed save), and try to recover itemId
	-- from the UUID cache when the entry omits it (legacy saves wrote
	-- only `{uuid = uuid}` before the itemId field was added). Entries
	-- that can't be recovered are dropped from saveData.Equipped so the
	-- malformed state doesn't persist.
	local entries = {}
	for slotId, data in saveData.Equipped do
		if typeof(data) ~= 'table' or typeof(data.uuid) ~= 'string' then
			saveData.Equipped[slotId] = nil
			continue
		end
		local itemId = data.itemId
		if typeof(itemId) ~= 'string' then
			itemId = Module.FindItemIdGivenUUID(player, data.uuid)
			if typeof(itemId) ~= 'string' then
				warn(string.format(
					'AttemptPlayerReEquipItems: dropping unresolvable equip entry for %s @ %s (uuid=%s)',
					tostring(player.Name), tostring(slotId), tostring(data.uuid)))
				saveData.Equipped[slotId] = nil
				continue
			end
			-- Backfill the recovered itemId so future re-equips skip
			-- the cache lookup.
			data.itemId = itemId
		end
		table.insert(entries, { slotId = slotId, data = data })
	end
	for _, entry in entries do
		Module.AttemptPlayerCharacterUnequipItemInItemSlot(player.Character, entry.slotId)
	end
	for _, entry in entries do
		Module.AttemptPlayerCharacterEquipItemOfUUID(
			player.Character,
			entry.data.uuid,
			entry.data.itemId,
			entry.data.slot
		)
	end
	Module.UpdatePlayerEquippedWeaponsAttributes(player)
	return true
end

function Module.AttemptPlayerDeleteItemOfUUID(player, uuid)
	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not saveData then
		return
	end
	local itemId = Module.FindItemIdGivenUUID(player, uuid)
	if not itemId then
		return
	end
	Module.AttemptPlayerUnequipItemOfUUID(player, uuid)
	UUIDToItemIdCache[player][uuid] = nil
	saveData.Inventory[itemId][uuid] = nil
end

function Module.OnPlayerAdded(player)
	UUIDToItemIdCache[player] = {}
	local save_data = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player, true)
	if not save_data then
		return
	end
	Module.GenerateUUIDToItemId(player)
	Module.UpdatePlayerEquippedWeaponsAttributes(player)
end

function Module.OnPlayerRemoving(player)
	UUIDToItemIdCache[player] = nil
end

function Module.Start()
	for _, player in Players:GetPlayers() do
		task.defer(Module.OnPlayerAdded, player)
	end

	InventoryEvent.OnServerEvent:Connect(function(player, uuid, customIndex)
		local isEquipped, slotId = Module.IsPlayerItemEquipped(player, uuid)
		if isEquipped then
			print("Unequip Weapon for player: ", player.Name, uuid, slotId)
			Module.AttemptPlayerUnequipItemOfUUID(player, uuid)
		else
			print("Equip Weapon for player: ", player.Name, uuid, customIndex)
			Module.AttemptPlayerEquipItemOfUUID(player, uuid, customIndex)
		end
	end)

	Players.PlayerAdded:Connect(Module.OnPlayerAdded)
	Players.PlayerRemoving:Connect(Module.OnPlayerRemoving)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module]]></Source>
		<Source path="ServerStorage/Core/DataManagerServer"><![CDATA[
local Players = game:GetService('Players')
local RunService = game:GetService('RunService')

local ServerStorage = game:GetService("ServerStorage")
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

local ProfileService = ServerModules.Libraries.ProfileService

local SystemsContainer = {}

local Loading = {}
local ProfileCache = {}
local GameProfileStore = false

local TemplateData = {
	Banned = {Active = nil, History = {}},

	Saves = {},
	DeletedSaves = {}, -- only saves with >10 levels.

	Analytics = {TimePlayed = 0},
	Purchases = {TotalSpent = 0, Purchases = {}},
}

-- // Module // --
local Module = {}
Module.TemplateData = TemplateData

function Module.GetProfileFromPlayer(player: Player): any?
	return ProfileCache[player.UserId]
end

function Module.YieldUntilProfileAvailable(player: Player): any?
	local profile = Module.GetProfileFromPlayer(player)
	while player:IsDescendantOf(Players) and (not profile) do
		RunService.Heartbeat:Wait()
		profile = Module.GetProfileFromPlayer(player)
	end
	return profile
end

function Module.YieldUntilNotLoading(key: any)
	while Loading[key] do
		RunService.Heartbeat:Wait()
	end
end

function Module.LoadUserIdProfile(userId : number) : (boolean, any?)
	Module.YieldUntilNotLoading(userId)
	if ProfileCache[userId] then
		-- Return shape stays consistent with the (success, profile) tuple
		-- used by every other branch; the original early-return forgot the
		-- success boolean and shifted the profile into the first slot,
		-- which broke every caller that destructured `local ok, profile = ...`.
		return true, ProfileCache[userId]
	end

	local IsLoading = Loading[userId]
	Module.YieldUntilNotLoading(userId)
	if ProfileCache[userId] then
		return true, ProfileCache[userId]
	end
	if IsLoading then
		return false, "Profile could not be loaded."
	end

	Loading[userId] = true

	local profile = GameProfileStore:LoadProfileAsync(tostring(userId))
	if not profile then
		ProfileCache[userId] = nil
		Loading[userId] = nil
		return false, "Call LoadProfileAsync failed."
	end

	profile:AddUserId(userId) -- GDPR compliance
	profile:Reconcile()
	profile:ListenToRelease(function()
		ProfileCache[userId] = nil
		Loading[userId] = nil
	end)

	ProfileCache[userId] = profile
	return true, profile
end

function Module.LoadPlayerProfile(player : Player, skip_ban_check: boolean?) : (boolean, any?)
	if ProfileCache[player.UserId] then
		return true, ProfileCache[player.UserId]
	end

	local IsLoading = Loading[player.UserId]
	Module.YieldUntilNotLoading(player.UserId)

	if ProfileCache[player.UserId] then
		return true, ProfileCache[player.UserId]
	end

	if IsLoading then
		return false, "Profile could not be loaded."
	end
	Loading[player.UserId] = true

	local profile = GameProfileStore:LoadProfileAsync(tostring(player.UserId))
	if not profile then
		player:Kick("Failed to load your profile.")
		ProfileCache[player.UserId] = nil
		Loading[player.UserId] = nil
		return false, "Call LoadProfileAsync failed."
	end

	profile:AddUserId(player.UserId) -- GDPR compliance
	profile:Reconcile()
	profile:ListenToRelease(function()
		ProfileCache[player.UserId] = nil
		Loading[player.UserId] = nil
		local isTeleporting = SystemsContainer.TeleportServer.GetIsPlayerTeleporting(player)
		if not isTeleporting then
			player:Kick("Your profile was loaded on another server.")
		end
	end)

	if not player:IsDescendantOf(Players) then
		profile:Release()
		ProfileCache[player.UserId] = nil
		Loading[player.UserId] = nil
		return false, "Player left during loading"
	end

	local is_banned = (not skip_ban_check) and SystemsContainer.BanServer.CheckIfProfileBanned(profile)
	if not is_banned then
		ProfileCache[player.UserId] = profile
		Loading[player.UserId] = nil
		return true, profile
	end

	profile:Release()
	Loading[player.UserId] = nil
	if player:IsDescendantOf(Players) then
		local BanMessage = SystemsContainer.BanServer.CompileBannedMessage(profile.Data.Banned.Active)
		player:Kick(BanMessage)
	end
	return false, "Player is banned."
end

function Module.ReleaseUserIdProfile(userId : number)
	if ProfileCache[userId] then
		ProfileCache[userId]:Release()
	end
	ProfileCache[userId] = nil
	Loading[userId] = nil
end

function Module.ReleasePlayerProfile(player: Player)
	Module.ReleaseUserIdProfile(player.UserId)
end

function Module.DeleteUserIdProfile(userId : number)
	if GameProfileStore then
		GameProfileStore:RemoveAsync(tostring(userId))
	end
end

function Module.DeletePlayerProfile(player: Player)
	Module.DeleteUserIdProfile(player.UserId)
end

function Module.Start()

end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems

	-- NOTE: .Mock means data DOES NOT save.
	GameProfileStore = ProfileService.GetProfileStore('PlayerTest1', TemplateData)--.Mock
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/SubstationServer"><![CDATA[-- SubstationServer — proximity-gated secondary crafting nodes.
--
-- Every CollectionService 'Substation' tagged Model registers a
-- Structure zone with ZoneService keyed by its 'SubstationKind'
-- attribute. The Structure zone system fires StructureEnter / Leave
-- per (character, kind), which we mirror into a per-player "active
-- substation kinds" set.
--
-- CraftingShared.CanCraft consults this set via the
-- `options.NearSubstations` field threaded through by
-- CraftingServer.AttemptCraft, so a recipe with
-- `RequiredSubstation = 'Kiln'` only fires when the player is
-- standing inside a Kiln zone.
--
-- Why the Structure zone system rather than a per-tick proximity
-- sweep (the WorkstationServer pattern): substations are AMBIENT
-- (no prompt — the player just stands near one), so we want
-- enter/leave semantics rather than nearest-of-many. Reusing
-- ZoneService also unifies the "you are inside a region" mental
-- model — quests, music, and substations all pull from the same
-- bbox-overlap loop.

local CollectionService = game:GetService('CollectionService')
local Players           = game:GetService('Players')
local Workspace         = game:GetService('Workspace')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local SubstationsConfig = ReplicatedModules.Data.Substations
local ZoneService       = ReplicatedModules.Services.ZoneService

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Per-substation registration. We also create a tagged anchor
-- BasePart inside the Substation model that registers as the zone
-- shape with ZoneService.RegisterStructure(kind, { part }). The
-- anchor is sized by the model's `ProximityRadius` attribute so
-- designers can dial each substation's radius without writing code.
----------------------------------------------------------------------
local Cleanups: { [Instance]: { Cleanup: () -> () } } = {}

local function newMaid()
	local items: { any } = {}
	return {
		Give = function(item) items[#items + 1] = item end,
		Cleanup = function()
			for _, item in items do
				if typeof(item) == 'RBXScriptConnection' then
					item:Disconnect()
				elseif typeof(item) == 'Instance' then
					item:Destroy()
				elseif typeof(item) == 'function' then
					item()
				end
			end
			table.clear(items)
		end,
	}
end

local function findHostPart(model: Instance): BasePart?
	if model:IsA('BasePart') then return model :: BasePart end
	if not model:IsA('Model') then return nil end
	if model.PrimaryPart then return model.PrimaryPart end
	for _, d in model:GetDescendants() do
		if d:IsA('BasePart') then return d end
	end
	return nil
end

local function setupSubstation(model: Instance)
	if Cleanups[model] then return end
	local kind = model:GetAttribute(SubstationsConfig.AttributeKind)
	if typeof(kind) ~= 'string' or kind == '' then
		warn(string.format(
			'[SubstationServer] %s tagged %q but missing string Attribute %s',
			model:GetFullName(), SubstationsConfig.Tag, SubstationsConfig.AttributeKind))
		return
	end
	local host = findHostPart(model)
	if not host then
		warn(string.format(
			'[SubstationServer] %s has no BasePart to host the proximity zone',
			model:GetFullName()))
		return
	end

	local maid = newMaid()
	Cleanups[model] = maid

	-- Build the proximity zone. A separate, invisible BasePart sized
	-- to the configured radius — parented to the model — keeps the
	-- substation's zone shape independent of the host part's size
	-- (the host might be a small visible centerpiece, but the zone
	-- needs to be the gameplay-friendly N-stud bubble around it).
	local radius = (model:GetAttribute(SubstationsConfig.AttributeRadius) :: number?)
		or SubstationsConfig.DefaultRadius
	local zonePart = Instance.new('Part')
	zonePart.Name = kind                 -- ZoneService keys structures by part Name
	zonePart.Anchored = true
	zonePart.CanCollide = false
	zonePart.CanQuery = false           -- not in raycasts
	zonePart.CanTouch = false           -- not in legacy touch events
	zonePart.Massless = true
	zonePart.Transparency = 1
	zonePart.Size = Vector3.new(radius * 2, radius * 2, radius * 2)
	-- Pivot center so the zone wraps the model rather than the
	-- host part's offset center (matching the waypoint anchor logic).
	zonePart.CFrame = CFrame.new((model :: any):GetPivot().Position)
	zonePart.Parent = model
	maid.Give(zonePart)

	-- Register with ZoneService's Structure system. Parts whose Name
	-- matches an existing structure zone get appended; the public
	-- RegisterStructure helper handles bucketing.
	ZoneService.RegisterStructure(kind, { zonePart })
	maid.Give(function()
		ZoneService.UnRegisterStructureParts({ zonePart })
	end)

	-- Auto-cleanup on despawn / untag.
	maid.Give(model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(Workspace) then
			Module.Teardown(model)
		end
	end))
end

function Module.Teardown(model: Instance)
	local maid = Cleanups[model]
	if not maid then return end
	maid.Cleanup()
	Cleanups[model] = nil
end

----------------------------------------------------------------------
-- Per-player active substation kinds. Populated by the Structure
-- zone enter/leave signals. Stored as a string-keyed set (cheap
-- contains check + cheap snapshot for CraftingShared).
----------------------------------------------------------------------
local ActiveByPlayer: { [Player]: { [string]: true } } = {}

local function getOrInit(player: Player): { [string]: true }
	local set = ActiveByPlayer[player]
	if not set then
		set = {}
		ActiveByPlayer[player] = set
	end
	return set
end

local function characterToPlayer(character: Instance): Player?
	for _, p in Players:GetPlayers() do
		if p.Character == character then return p end
	end
	return nil
end

----------------------------------------------------------------------
-- Public API. CraftingShared / CraftingServer call IsPlayerNearSubstation
-- by kind. Future UI (e.g. crafting tab) may consume the snapshot
-- table for "active substations" indicator chips.
----------------------------------------------------------------------
function Module.IsPlayerNearSubstation(player: Player, kind: string): boolean
	if typeof(kind) ~= 'string' or kind == '' then return false end
	local set = ActiveByPlayer[player]
	return set and set[kind] == true or false
end

-- Snapshot copy so a downstream call can't mutate our internal map.
function Module.GetActiveSubstationKinds(player: Player): { [string]: true }
	local out: { [string]: true } = {}
	local set = ActiveByPlayer[player]
	if set then
		for k in set do out[k] = true end
	end
	return out
end

function Module.Start()
	-- Initial pass for already-tagged substations.
	for _, inst in CollectionService:GetTagged(SubstationsConfig.Tag) do
		setupSubstation(inst)
	end
	CollectionService:GetInstanceAddedSignal(SubstationsConfig.Tag):Connect(setupSubstation)
	CollectionService:GetInstanceRemovedSignal(SubstationsConfig.Tag):Connect(Module.Teardown)

	-- Mirror the Structure zone events into ActiveByPlayer. We only
	-- care about zones whose name is a registered substation kind —
	-- generic structure zones (e.g. dungeon rooms) shouldn't bleed
	-- into the substation set.
	ZoneService.StructureEnter:Connect(function(character: Instance, zoneName: string)
		if not SubstationsConfig.Kinds[zoneName] then return end
		local player = characterToPlayer(character)
		if not player then return end
		getOrInit(player)[zoneName] = true
	end)
	ZoneService.StructureLeave:Connect(function(character: Instance, zoneName: string)
		if not SubstationsConfig.Kinds[zoneName] then return end
		local player = characterToPlayer(character)
		if not player then return end
		local set = ActiveByPlayer[player]
		if set then set[zoneName] = nil end
	end)

	Players.PlayerRemoving:Connect(function(player)
		ActiveByPlayer[player] = nil
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/NPCInventoryServer"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))
local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

local ItemsConfigModule = ServerModules.Data.Items
local CombatSharedModule = ReplicatedModules.Services.CombatShared

local Slots = ItemsConfigModule.EquipmentSlotEnums

-- Map an EquipmentSlotEnums value to the attribute-key suffix used by
-- the rest of the system (CombatShared reads `1_Weapon` / `2_Weapon`).
-- Hands use `Weapon` for backwards compatibility with NPCCombatServer's
-- existing `EquipNPCWeaponOfId` path; other slots fall back to a name
-- derived from the enum.
local SLOT_KEY_TOKEN = {
	[Slots.Hand]     = 'Weapon',
	[Slots.Head]     = 'Head',
	[Slots.Chest]    = 'Chest',
	[Slots.Legs]     = 'Legs',
	[Slots.Boots]    = 'Boots',
	[Slots.Bracelet] = 'Bracelet',
	[Slots.Neck]     = 'Neck',
	[Slots.Ear]      = 'Ear',
	[Slots.Finger]   = 'Finger',
	[Slots.Curio]    = 'Curio',
}

local SystemsContainer = {}

-- // Module --
local Module = {}

function Module.GetCustomSlotIndex(itemType, customSlot)
	return tostring(customSlot).."_"..itemType
end

-- The new Items.luau schema defines slots as a list of EquipmentSlotConfig
-- entries; each entry has a `.Slot` enum and dual-wield is expressed via
-- `AllowMultiEquip` + `MaxMultiEquip`. There is no longer a flat `.Slots`
-- list nor an `IsDualWield` flag, so we derive both from `EquipSlots`.
local function FindEquipSlotConfig(itemConfig, slotEnum)
	if not itemConfig or not itemConfig.EquipmentData then
		return nil
	end
	for _, slotCfg in itemConfig.EquipmentData.EquipSlots do
		if slotCfg.Slot == slotEnum then
			return slotCfg
		end
	end
	return nil
end

local function IsItemDualWield(itemConfig)
	if not itemConfig or not itemConfig.EquipmentData then
		return false
	end
	local first = itemConfig.EquipmentData.EquipSlots[1]
	return first ~= nil
		and first.AllowMultiEquip == true
		and (first.MaxMultiEquip or 0) > 1
end

function Module.CanEquipItemInSlot(itemId, slotEnum)
	local itemConfig = ItemsConfigModule.GetConfigFromId(itemId)
	if not itemConfig then
		warn(string.format('Unknown item of id: %s', itemId))
		return false
	end
	return FindEquipSlotConfig(itemConfig, slotEnum) ~= nil
end

function Module.AttemptNPCUnequipItemOfUUID(character, uuid)
	for key, value in character:GetAttributes() do
		if value == uuid then
			character:SetAttribute(key, nil)
		end
	end
	SystemsContainer.EquipmentRendererServer.RemoveEquipmentUUIDs(character, {uuid})
end

function Module.AttemptNPCUnequipItemInItemSlot(character, itemSlot)
	character:SetAttribute(itemSlot, nil)
end

function Module.UnequipAllNPCWeapons(character)
	local slotIds = {}
	for slot = 1, 2 do
		local itemSlot = Module.GetCustomSlotIndex("Weapon", slot)
		character:SetAttribute(itemSlot, nil)
		table.insert(slotIds, itemSlot)
	end
	SystemsContainer.EquipmentRendererServer.RemoveEquipmentSlotIds(character, slotIds)
end

function Module.ScanNPCEquippedWeaponsForDualWield(character)
	local LeftHand, RightHand = CombatSharedModule.GetCharacterEquippedWeaponsLR(character)
	if LeftHand and LeftHand.ItemId then
		Module.AttemptNPCUnequipItemInItemSlot(character, LeftHand.ItemId)
	end
	if RightHand and RightHand.ItemId then
		Module.AttemptNPCUnequipItemInItemSlot(character, RightHand.ItemId)
	end
end

function Module.AttemptNPCEquipItemOfUUID(character, itemId, customSlot)
	if not character then
		return false
	end

	local itemConfig = ItemsConfigModule.GetConfigFromId(itemId)
	if not itemConfig then
		warn(string.format('Unknown item of id: %s', itemId))
		return false
	end

	if not itemConfig.EquipmentData then
		warn(string.format('Item of id %s is not equippable!', itemId))
		return false
	end

	-- For NPC equip, `customSlot` is the slot index (1 = left, 2 = right
	-- for hands; 1 for any other slot). The slot enum we validate
	-- against is the first declared EquipSlot's `.Slot`.
	local slot = customSlot or 1
	local primarySlotCfg = itemConfig.EquipmentData.EquipSlots[1]
	if not primarySlotCfg then
		warn(string.format('Item of id %s declares no EquipSlots!', itemId))
		return false
	end
	if not Module.CanEquipItemInSlot(itemId, primarySlotCfg.Slot) then
		warn(string.format('Item of id %s is not equippable in slot %d!', itemId, primarySlotCfg.Slot))
		return false
	end

	-- Slot key derives a string token from the slot enum so attributes
	-- stay readable (`1_Weapon`, `2_Bracelet`, ...) and match the rest
	-- of the system (CombatShared / EquipmentRendererServer).
	local slotToken = SLOT_KEY_TOKEN[primarySlotCfg.Slot] or tostring(primarySlotCfg.Slot)
	local itemSlot = Module.GetCustomSlotIndex(slotToken, slot)
	if not IsItemDualWield(itemConfig) then
		Module.UnequipAllNPCWeapons(character)
	else
		Module.ScanNPCEquippedWeaponsForDualWield(character)
	end

	Module.AttemptNPCUnequipItemInItemSlot(character, itemSlot)
	Module.AttemptNPCUnequipItemOfUUID(character, itemId)

	print('Equip item at slot;', itemSlot, itemId)
	character:SetAttribute(itemSlot, itemId)

	SystemsContainer.EquipmentRendererServer.SetEquipmentValues(character, itemSlot, false, itemId)
	return true
end

function Module.Start()
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module]]></Source>
		<Source path="ServerStorage/Core/NPCCombatServer"><![CDATA[-- // NPCCombatServer.luau //
-- NPC-side adapter over the shared combat runtime, plus NPC equipment
-- and test-rig bring-up.
--
-- See NIER_COMBAT.md for the design.
--
-- This module used to carry its own copy of the swing path: its own
-- hitbox query, its own hit loop, its own damage call, its own block
-- handling. That duplication is why NPCs had no combo chains, no
-- poise, no launchers and no cancel windows — every feature
-- added to player combat had to be re-implemented here to reach them,
-- and none ever was.
--
-- Attacks now go through CombatServer.AttemptStartNpcAction, which is
-- the same function player attacks reach. An NPC swinging a sword and a
-- player swinging the same sword run identical code; only the damage
-- resolver and the absence of a remote differ.

local CollectionService = game:GetService('CollectionService')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CombatConfigModule = ReplicatedModules.Data.CombatConfig
local CombatActions = ReplicatedModules.Data.CombatActions
local MaidClassModule = ReplicatedModules.Modules.Maid
local AnimationService = ReplicatedModules.Services.AnimationService
local CombatShared = ReplicatedModules.Services.CombatShared
local CharacterStates = ReplicatedModules.Services.CharacterStates
local CombatUtility = ReplicatedModules.Utility.CombatUtility

local SystemsContainer = {}

local Module = {}
Module.BLOCKING_STATE = CombatShared.BLOCKING_STATE

----------------------------------------------------------------------
-- Equipment. NPCs store item ids directly in the `N_Weapon` attributes
-- where players store inventory UUIDs; CombatUtility disambiguates.
----------------------------------------------------------------------
function Module.DoesNPCHaveWeaponEquipped(character: Model): boolean
	return #CombatShared.GetCharacterEquippedWeaponsByAttribute(character) > 0
end

function Module.UpdateNPCEquippedWeaponAttributes(character: Model)
	character:SetAttribute('HasWeaponEquipped', Module.DoesNPCHaveWeaponEquipped(character))
end

function Module.UnequipNPCWeapons(character: Model)
	for attributeName, _ in character:GetAttributes() do
		if string.find(attributeName, 'Weapon') then
			character:SetAttribute(attributeName, nil)
		end
	end
end

function Module.UnequipNPCWeaponOfId(character: Model, id: string)
	for attributeName, attributeValue in character:GetAttributes() do
		if string.find(attributeName, 'Weapon') and attributeValue == id then
			character:SetAttribute(attributeName, nil)
		end
	end
end

function Module.EquipNPCWeaponOfId(character: Model, id: string, slotIndex: number)
	character:SetAttribute(tostring(slotIndex) .. '_Weapon', id)
end

----------------------------------------------------------------------
-- Weapon draw. NPCs are drawn by default in practice, but the state
-- still has to exist because the shared attack gate reads it.
----------------------------------------------------------------------
function Module.SetNPCWeaponDrawn(character: Model, drawn: boolean)
	CharacterStates.SetState(character, 'SwordDrawing', true)
	task.spawn(function()
		if drawn then
			CharacterStates.SetState(character, 'SwordDrawn', true)
			task.wait(0.4)
		else
			task.wait(0.4)
			CharacterStates.SetState(character, 'SwordDrawn', false)
		end
		CharacterStates.SetState(character, 'SwordDrawing', false)
	end)
end

function Module.AttemptNPCWeaponDraw(character: Model): boolean
	local light, heavy = CombatShared.GetCharacterEquippedWeaponsLR(character)
	if not light and not heavy then return false end
	Module.SetNPCWeaponDrawn(character, not CombatShared.IsWeaponDrawn(character))
	return true
end

----------------------------------------------------------------------
-- Combat actions. Every one of these is a one-line delegation, which is
-- the point: there is no NPC-specific combat logic left to diverge.
----------------------------------------------------------------------

-- `inputKind` lets a behaviour tree pick light or heavy, so NPCs can
-- use the same combo grammar players do — an NPC that opens with L, L
-- and finishes with H performs a real launcher.
function Module.AttemptNPCWeaponAttack(character: Model, inputKind: string?): boolean
	if not character or not character.Parent then return false end
	local accepted = SystemsContainer.CombatServer.AttemptStartNpcAction(character, {
		InputKind = inputKind or CombatActions.InputKinds.Light,
	})
	return accepted
end

function Module.AttemptNPCDodge(character: Model, direction: Vector3?): boolean
	if not character or not character.Parent then return false end
	-- NPCs default to evading backwards relative to their own facing,
	-- which is the useful behaviour when a brain says "get out" without
	-- having computed a direction.
	if not direction then
		local root = character:FindFirstChild('HumanoidRootPart') :: BasePart?
		direction = root and -root.CFrame.LookVector or nil
	end
	local accepted = SystemsContainer.CombatServer.AttemptDodge(character, direction, nil)
	return accepted
end

function Module.AttemptNPCBlockStart(character: Model): boolean
	local accepted = SystemsContainer.CombatServer.AttemptGuardStart(character, nil)
	return accepted
end

function Module.AttemptNPCBlockEnd(character: Model): boolean
	local accepted = SystemsContainer.CombatServer.AttemptGuardEnd(character)
	return accepted
end

function Module.DecrementNPCBlockCount(character: Model, forceBlockBreak: boolean?): number
	return CombatShared.DecrementBlockCount(character, forceBlockBreak == true)
end

----------------------------------------------------------------------
-- Presentation. Purely cosmetic and entirely optional: every animation
-- lookup below is guarded, so an NPC whose mocaps are missing still
-- fights correctly, it just fights without visible flourish.
----------------------------------------------------------------------
function Module.SetupNPCAnimations(character: Model)
	local humanoid = character:FindFirstChildWhichIsA('Humanoid')
	if not humanoid then return end

	local animator = humanoid:FindFirstChildWhichIsA('Animator')
	if not animator then
		animator = Instance.new('Animator')
		animator.Parent = humanoid
	end

	local attackAnimations = AnimationService.LoadAnimationsArray(animator, CombatConfigModule.AttackSets.Default)
	local characterAnimations = AnimationService.LoadAnimationsDictionary(animator, CombatConfigModule.AnimationSets.Default)

	local maid = MaidClassModule.New()

	local function playIfPresent(track: AnimationTrack?, fadeTime: number?)
		if track then track:Play(fadeTime or 0.1) end
	end
	local function stopIfPresent(track: AnimationTrack?)
		if track then track:Stop(0.1) end
	end

	maid:Give(character:GetAttributeChangedSignal('Blocking'):Connect(function()
		if character:GetAttribute('Blocking') then
			playIfPresent(characterAnimations.Blocking)
			CombatShared.SetupBlockingEffect(character)
		else
			stopIfPresent(characterAnimations.Blocking)
			CombatShared.ClearBlockingEffect(character)
		end
	end))

	maid:Give(character:GetAttributeChangedSignal('KnockedDown'):Connect(function()
		if CombatShared.IsCharacterKnocked(character) then
			playIfPresent(characterAnimations.KnockedDown, 0)
		else
			stopIfPresent(characterAnimations.KnockedDown)
		end
	end))

	maid:Give(character:GetAttributeChangedSignal('Attacking'):Connect(function()
		if not character:GetAttribute('Attacking') then return end
		-- AttackSets.Default has empty hand arrays until designers author
		-- NPC mocaps, so this list is legitimately empty in a working
		-- game. Guarding the count keeps math.random from erroring on an
		-- empty interval on every NPC swing.
		local count = #attackAnimations
		if count <= 0 then return end
		attackAnimations[math.random(count)]:Play()
	end))

	humanoid.Died:Once(function()
		maid:Cleanup()
	end)
end

----------------------------------------------------------------------
-- Studio test rigs.
----------------------------------------------------------------------
function Module.SetupTestDummies()
	local function setupAttackDummy(dummy: Model, forceBlockBreak: boolean?)
		if not dummy:FindFirstChildWhichIsA('Humanoid') then
			warn(string.format(
				'[NPCCombatServer.SetupTestDummies] %s has no Humanoid; skipping setup.',
				dummy:GetFullName()))
			return
		end
		Module.SetupNPCAnimations(dummy)

		dummy:SetAttribute('AIClass', 'AttackDummy')
		dummy:SetAttribute('ForceBlockBreak', forceBlockBreak == true)
		-- Dummies exist to demonstrate states, so give them a poise pool
		-- that visibly breaks rather than the default fodder value.
		dummy:SetAttribute('PoiseArchetype', 'Fodder')
		-- A drawn weapon is a precondition of the shared attack gate.
		CharacterStates.SetState(dummy, 'SwordDrawn', true)

		-- Tag flip so EnemyServer re-initialises the rig with the AIClass
		-- we just set; a rig placed in Studio is already tagged and would
		-- otherwise keep its cached 'Generic' behaviour tree.
		if CollectionService:HasTag(dummy, 'AICharacter') then
			CollectionService:RemoveTag(dummy, 'AICharacter')
			task.defer(function()
				if dummy.Parent then
					CollectionService:AddTag(dummy, 'AICharacter')
				end
			end)
		else
			CollectionService:AddTag(dummy, 'AICharacter')
		end
	end

	local attackingDummy = workspace:FindFirstChild('Attacking')
	if attackingDummy then
		Module.EquipNPCWeaponOfId(attackingDummy, 'WoodenSword', 1)
		setupAttackDummy(attackingDummy, false)
	end

	local blockingDummy = workspace:FindFirstChild('Blocking')
	if blockingDummy and blockingDummy:FindFirstChildWhichIsA('Humanoid') then
		Module.SetupNPCAnimations(blockingDummy)
		Module.EquipNPCWeaponOfId(blockingDummy, 'WoodenSword', 1)
		CharacterStates.SetState(blockingDummy, 'SwordDrawn', true)
		if not CollectionService:HasTag(blockingDummy, 'AICharacter') then
			CollectionService:AddTag(blockingDummy, 'AICharacter')
		end
		task.spawn(function()
			while blockingDummy.Parent do
				task.wait(1)
				Module.AttemptNPCBlockStart(blockingDummy)
			end
		end)
	end

	local blockBreakDummy = workspace:FindFirstChild('AttackingBlockBreak')
	if blockBreakDummy then
		Module.EquipNPCWeaponOfId(blockBreakDummy, 'WoodenSword', 1)
		setupAttackDummy(blockBreakDummy, true)
	end

	-- Hand-mode rigs. Slot 1 is the light slot and slot 2 the heavy
	-- slot, so LeftAttacker exercises light-only and RightAttacker
	-- heavy-only resolution through the shared weapon helpers.
	local leftAttacker = workspace:FindFirstChild('LeftAttacker')
	if leftAttacker then
		Module.EquipNPCWeaponOfId(leftAttacker, 'WoodenSword', 1)
		setupAttackDummy(leftAttacker, false)
	end

	local rightAttacker = workspace:FindFirstChild('RightAttacker')
	if rightAttacker then
		Module.EquipNPCWeaponOfId(rightAttacker, 'WoodenSword', 2)
		setupAttackDummy(rightAttacker, false)
	end

	local dualAttacker = workspace:FindFirstChild('DualAttacker')
	if dualAttacker then
		-- WoodenSword resolves to WeaponClass 'Sword', and there is no
		-- DualSword registry entry, so this rig exercises the same-class
		-- fallback. Swap both slots to a Dagger to reach DualDagger.
		Module.EquipNPCWeaponOfId(dualAttacker, 'WoodenSword', 1)
		Module.EquipNPCWeaponOfId(dualAttacker, 'WoodenSword', 2)
		setupAttackDummy(dualAttacker, false)
	end
end

function Module.Start()
	task.delay(3, Module.SetupTestDummies)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
	if SystemsContainer.PlayerInventoryServer then
		CombatUtility.RegisterPlayerInventoryServer(SystemsContainer.PlayerInventoryServer)
	end
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/EquipmentRendererServer"><![CDATA[
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local RemoteService = ReplicatedModules.Services.RemoteService
local EquipmentRenderEvent = RemoteService.GetRemote('EquipmentRenderEvent', 'RemoteEvent', false)

local RemoteJobs = { BulkSet = 1, BulkRemove = 3, Cleanup = 4 }

local SystemsContainer = {}

-- // Module // --
local Module = {}

Module.ActiveDataCache = {}

function Module.GetEquipmentUUIDSlot(character : Model, uuid : string) : string?
	if not Module.ActiveDataCache[character] then
		return
	end
	for slotId, slotData in Module.ActiveDataCache[character] do
		if slotData and slotData.uuid == uuid then
			return slotId
		end
	end
	return nil
end

function Module.CleanupCharacter(character : Model)
	if not Module.ActiveDataCache[character] then
		return
	end
	Module.ActiveDataCache[character] = nil
	EquipmentRenderEvent:FireAllClients(RemoteJobs.Cleanup, character)
end

function Module.RemoveEquipmentUUIDs(character : Model, uuids : {string}) : {string}
	if not Module.ActiveDataCache[character] then
		return {}
	end
	local slotIds = {} :: {string}
	for slotId, slotData in Module.ActiveDataCache[character] do
		if table.find(uuids, slotData.uuid) then
			table.insert(slotIds, slotId)
		end
	end
	EquipmentRenderEvent:FireAllClients(RemoteJobs.BulkRemove, character, slotIds)
	return slotIds
end

function Module.RemoveEquipmentSlotIds(character : Model, slotIds : {string})
	if not Module.ActiveDataCache[character] then
		return
	end
	for _, slotId in slotIds do
		Module.ActiveDataCache[character][slotId] = nil
	end
	EquipmentRenderEvent:FireAllClients(RemoteJobs.BulkRemove, character, slotIds)
end

function Module.SetEquipmentValues(character : Model, slotId : string, uuid : string, itemId : string)
	if not Module.ActiveDataCache[character] then
		Module.ActiveDataCache[character] = {}
	end
	local data = {uuid = uuid, itemId = itemId}
	Module.ActiveDataCache[character][slotId] = data
	-- Broadcast the item's config to ALL clients BEFORE the render
	-- event. Post-Phase-2 migration the per-player Items shell only
	-- carries the player's OWN owned items; without this push, every
	-- other client would receive the BulkSet event with `itemId` but
	-- no config to look up, and the renderer would silently fail
	-- (defensive guards return empty Folders, but the weapon visual
	-- never appears for spectators). Equipped gear is publicly visible,
	-- so leaking the config to all clients matches the visibility model.
	if SystemsContainer.ItemsConfigReplicationServer then
		SystemsContainer.ItemsConfigReplicationServer.BroadcastVisibleItems({ itemId })
	end
	EquipmentRenderEvent:FireAllClients(RemoteJobs.BulkSet, character, {{slotId=slotId, data=data}})
end

function Module.SetPlayerEquipped(player : Player, resetEquipped : boolean?)
	if not player.Character then
		return
	end

	local saveData = SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player, false)
	if not saveData then
		return
	end

	if resetEquipped then
		Module.CleanupCharacter(player.Character)
	end

	local items = {}
	local itemIdsForBroadcast: { string } = {}
	for slotId, slotData in saveData.Equipped do
		-- Wire shape matches SetEquipmentValues (line 69) — named keys
		-- so the client's BulkSetCharacterVisuals can read `data.slotId`
		-- / `data.data` from each array entry. The previous positional
		-- form `{slotId, data}` produced `data.slotId == nil` on the
		-- client, crashing the renderer at the table-index-nil line.
		local data = {uuid = slotData.uuid, itemId = slotData.itemId}
		table.insert(items, { slotId = slotId, data = data })
		itemIdsForBroadcast[#itemIdsForBroadcast + 1] = slotData.itemId
	end
	-- Broadcast all equipped item configs to every client BEFORE the
	-- render event so spectators can render the player's gear. See
	-- SetEquipmentValues for the same-day rationale.
	if SystemsContainer.ItemsConfigReplicationServer then
		SystemsContainer.ItemsConfigReplicationServer.BroadcastVisibleItems(itemIdsForBroadcast)
	end
	EquipmentRenderEvent:FireAllClients(RemoteJobs.BulkSet, player.Character, items)
end

function Module.Start()

end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems

	EquipmentRenderEvent.OnServerEvent:Connect(function( LocalPlayer )
		-- Late-join sync: when a client fires this event, replay the full
		-- ActiveDataCache to that client. The cache is `{[slotId] = data}`
		-- but the client expects `{ {slotId, data}, ... }` array form, so
		-- convert each entry per character.
		--
		-- Pre-replay, gather every itemId across every active character's
		-- equipped slots and broadcast their configs to ALL clients (a
		-- conservative superset — broadcasting just-to-LocalPlayer would
		-- be enough but FireAllClients is idempotent and saves a per-
		-- player branch). Without this, the late-joining client renders
		-- empty placeholders for every existing player's gear.
		local visibleItemIds: { string } = {}
		for _character, slotMap in Module.ActiveDataCache do
			for _slotId, data in slotMap do
				if typeof(data) == 'table' and typeof(data.itemId) == 'string' then
					visibleItemIds[#visibleItemIds + 1] = data.itemId
				end
			end
		end
		if SystemsContainer.ItemsConfigReplicationServer and #visibleItemIds > 0 then
			SystemsContainer.ItemsConfigReplicationServer.BroadcastVisibleItems(visibleItemIds)
		end

		for character, slotMap in Module.ActiveDataCache do
			local items = {}
			for slotId, data in slotMap do
				table.insert(items, { slotId = slotId, data = data })
			end
			EquipmentRenderEvent:FireClient(LocalPlayer, RemoteJobs.BulkSet, character, items)
		end
	end)

	Players.PlayerRemoving:Connect(function( LocalPlayer )
		Module.ActiveDataCache[ LocalPlayer.Name ] = nil
	end)
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/CombatLogServer"><![CDATA[-- Server-side combat-log tracker. Mirrors the client CombatLog module but
-- keyed by Player on the server so the Bump source is authoritative —
-- malicious clients can't pretend they aren't in combat to bypass the
-- waystone-teleport gate.
--
-- Bump points (all in CombatServer, which is the single entry point
-- every player and NPC combat action passes through):
--   * CombatServer.AttemptStartAttack   -- attacker, on an accepted swing
--   * CombatServer.AttemptDodge         -- evading counts as engaging
--   * CombatServer.AttemptGuardStart    -- defender raising guard
-- Plus an internal Humanoid.HealthChanged listener so any damage source
-- (skill, projectile, environment) bumps without each emitter having to
-- remember to call Bump. The HealthChanged path is the safety net; the
-- explicit Bumps above arm the timer at action-start so the indicator
-- shows even when the swing misses.

local Players = game:GetService('Players')

local Module = {}
Module.COMBAT_LOG_DURATION = 8 -- seconds; matches the client default

-- LastCombatAt[player] = os.clock() timestamp of last bump.
local LastCombatAt: {[Player]: number} = {}

local function now(): number
	return os.clock()
end

function Module.Bump(player: Player)
	if not player then return end
	LastCombatAt[player] = now()
end

function Module.IsInCombat(player: Player): boolean
	local at = LastCombatAt[player]
	if not at then return false end
	return (now() - at) < Module.COMBAT_LOG_DURATION
end

function Module.SecondsRemaining(player: Player): number
	local at = LastCombatAt[player]
	if not at then return 0 end
	return math.max(0, Module.COMBAT_LOG_DURATION - (now() - at))
end

-- Wire Humanoid.HealthChanged on every player character so any damage
-- source (not just the explicit Bump call sites) re-arms the timer.
-- Mirrors the client CombatLog.trackHumanoid pattern verbatim.
local function trackHumanoid(player: Player, character: Model)
	local humanoid = character:FindFirstChildOfClass('Humanoid')
		or character:WaitForChild('Humanoid', 5)
	if not humanoid then return end
	local last = humanoid.Health
	humanoid.HealthChanged:Connect(function(newHealth)
		if newHealth < last then
			Module.Bump(player)
		end
		last = newHealth
	end)
end

local function onPlayerAdded(player: Player)
	if player.Character then
		task.spawn(trackHumanoid, player, player.Character)
	end
	player.CharacterAdded:Connect(function(character)
		trackHumanoid(player, character)
	end)
end

function Module.Start()
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(function(player)
		LastCombatAt[player] = nil
	end)
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/CinematicServer"><![CDATA[-- Cinematic scheduler. Server-side schedule walker that fires per-cue remotes
-- to specific clients. Server NEVER renders camera moves, particles, or sound
-- — those are client-only by design (camera is per-client, particles are
-- ephemeral). The server's job is auth: which cinematic is allowed to play,
-- when, for whom; the client's job is rendering.
--
-- Public API:
--   Module.PlayForPlayer(player, cinematicId)
--   Module.PlayForAll(cinematicId)
--   Module.AbortFor(player, cinematicId?)
--   Module.IsPlaying(player) → boolean

local Players = game:GetService('Players')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CinematicShared  = ReplicatedModules.Services.CinematicShared
local CinematicConfigs = ReplicatedModules.Data.Cinematics
local RemoteService    = ReplicatedModules.Services.RemoteService

local CinematicEvent = RemoteService.GetRemote('CinematicEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

-- Active cinematic per player. We don't allow stacking (a new cinematic
-- aborts the previous one); the value is { cinematicId, generation }
-- where `generation` increments per-player so async cue firings can
-- bail if the player's active cinematic has changed underneath them.
local Active: { [Player]: { cinematicId: string, generation: number } } = {}

function Module.IsPlaying(player: Player): boolean
	return Active[player] ~= nil
end

function Module.AbortFor(player: Player, cinematicId: string?)
	local entry = Active[player]
	if not entry then return end
	if cinematicId and entry.cinematicId ~= cinematicId then return end
	Active[player] = nil
	CinematicEvent:FireClient(player, CinematicShared.CinematicActions.End, entry.cinematicId)
end

-- Walk a cinematic's cue list, firing each at its `At` offset. Each cue
-- check generations under task.delay so a mid-cinematic abort/replace
-- silently cancels remaining cues for the previous run.
local function runCinematicForPlayer(player: Player, cfg: CinematicShared.CinematicConfig)
	local generation = (Active[player] and Active[player].generation or 0) + 1
	Active[player] = { cinematicId = cfg.Id, generation = generation }

	CinematicEvent:FireClient(player, CinematicShared.CinematicActions.Begin, cfg.Id, {
		LockMovement = cfg.LockMovement,
		LockHUD      = cfg.LockHUD,
		Duration     = cfg.Duration,
		SkipKeyCode  = cfg.SkipKeyCode,
	})

	local sortedCues = CinematicShared.SortCues(cfg.Cues)
	for cueIdx, cue in sortedCues do
		task.delay(math.max(0, cue.At), function()
			-- Bail if the player's active cinematic was replaced or aborted.
			local cur = Active[player]
			if not cur or cur.generation ~= generation then return end
			-- Bail if the player left.
			if not player.Parent then return end
			CinematicEvent:FireClient(player, CinematicShared.CinematicActions.Cue, cueIdx, cue.Kind, cue.Args or {})
		end)
	end

	-- End-of-cinematic cleanup.
	task.delay(cfg.Duration, function()
		local cur = Active[player]
		if not cur or cur.generation ~= generation then return end
		Active[player] = nil
		if not player.Parent then return end
		CinematicEvent:FireClient(player, CinematicShared.CinematicActions.End, cfg.Id)
	end)
end

function Module.PlayForPlayer(player: Player, cinematicId: string): boolean
	local cfg = CinematicConfigs.Cinematics[cinematicId]
	if not cfg then
		warn(string.format('CinematicServer: unknown cinematic id %q', tostring(cinematicId)))
		return false
	end
	-- A new cinematic replaces any in-flight one for that player.
	if Active[player] then
		Module.AbortFor(player)
	end
	runCinematicForPlayer(player, cfg)
	return true
end

function Module.PlayForAll(cinematicId: string)
	for _, player in Players:GetPlayers() do
		Module.PlayForPlayer(player, cinematicId)
	end
end

----------------------------------------------------------------------
-- Single-cue blast. Fires one cue at a single player without the
-- Begin/End envelope or movement/HUD locks. Use for one-shot events
-- that don't warrant authoring a full cinematic — opening dialogue
-- from a ProximityPrompt, screen-flash on a specific moment, etc.
--
-- Same wire format as a regular cue inside a cinematic; the client
-- dispatcher (CinematicClient) doesn't gate cue handlers on an
-- active cinematic, so naked cues are valid.
----------------------------------------------------------------------
function Module.FireCueForPlayer(player: Player, kind: string, args: { [string]: any }?)
	if not player or not player.Parent then return end
	CinematicEvent:FireClient(player, CinematicShared.CinematicActions.Cue, 0, kind, args or {})
end

function Module.FireCueForAll(kind: string, args: { [string]: any }?)
	for _, player in Players:GetPlayers() do
		Module.FireCueForPlayer(player, kind, args)
	end
end

function Module.Start()
	-- Skip handling: client requests a skip; server cancels and emits End.
	CinematicEvent.OnServerEvent:Connect(function(player, action, ...)
		if action == CinematicShared.CinematicActions.Skip then
			Module.AbortFor(player)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		Active[player] = nil
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/MountsServer"><![CDATA[-- Mounts server. Owns the per-player save struct (OwnedMounts +
-- EquippedMount) and the dismount-on-damage hook. Visual model spawning
-- is client-only; this module just authorizes equip/dismount and fires
-- cues the client renders against.
--
-- Save struct shape:
--   data.Mounts = {
--     OwnedMounts = { [mountId] = { UnlockedAt = number } },
--     EquippedMount = mountId | nil,
--   }

local Players = game:GetService('Players')

local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local MountsShared    = ReplicatedModules.Services.MountsShared
-- Server reads the canonical (full) registry from ServerStorage.
-- The ReplicatedStorage Mounts shell is empty at boot and only
-- populated on each player by MountsConfigReplicationClient.
local MountsConfig    = ServerModules.Data.Mounts
local CharacterStates = ReplicatedModules.Services.CharacterStates
local RemoteService   = ReplicatedModules.Services.RemoteService

local MountEvent = RemoteService.GetRemote('MountEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Save struct accessor — pulls through SavesManagerServer so the
-- canonical struct is always the source of truth.
----------------------------------------------------------------------
local function getSave(player: Player): any?
	local Saves = SystemsContainer.SavesManagerServer
	if not Saves then return nil end
	return Saves.GetPlayerSelectedSaveData(player)
end

local function ensureMountsTable(saveData: any)
	if typeof(saveData.Mounts) ~= 'table' then saveData.Mounts = {} end
	if typeof(saveData.Mounts.OwnedMounts) ~= 'table' then saveData.Mounts.OwnedMounts = {} end
	-- EquippedMount may legitimately be nil; don't overwrite it.
end

----------------------------------------------------------------------
-- Pure accessors.
----------------------------------------------------------------------
function Module.GetOwnedMounts(player: Player): { [string]: any }
	local data = getSave(player); if not data then return {} end
	ensureMountsTable(data)
	return data.Mounts.OwnedMounts
end

function Module.GetEquippedMountId(player: Player): string?
	local data = getSave(player); if not data then return nil end
	if typeof(data.Mounts) ~= 'table' then return nil end
	return data.Mounts.EquippedMount
end

----------------------------------------------------------------------
-- Mutations.
----------------------------------------------------------------------
function Module.AttemptUnlockMount(player: Player, mountId: string): boolean
	local cfg = MountsConfig.Mounts[mountId]
	if not cfg then return false end
	local data = getSave(player); if not data then return false end
	ensureMountsTable(data)
	-- Already owned: still push the config row to the client (defensive
	-- against a save that had the mount but the client shell is empty
	-- because of an earlier replication miss). Cheap, idempotent.
	local alreadyOwned = data.Mounts.OwnedMounts[mountId] ~= nil
	if not alreadyOwned then
		data.Mounts.OwnedMounts[mountId] = { UnlockedAt = os.time() }
	end
	-- Push the config to the client shell so widgets / gameplay code
	-- have the mount visible without waiting for the next respawn-time
	-- bootstrap pass.
	local Repl = SystemsContainer.MountsConfigReplicationServer
	if Repl and Repl.OnMountUnlocked then Repl.OnMountUnlocked(player, mountId) end
	return true
end

-- Owner-side revoke. Auto-dismounts if the revoked mount is active,
-- then removes it from OwnedMounts. Used by the Cmdr DeleteMount
-- command so admins can take a mount away cleanly without leaving a
-- ghost rider on a now-unowned mount.
function Module.AttemptRevokeMount(player: Player, mountId: string): boolean
	local data = getSave(player); if not data then return false end
	ensureMountsTable(data)
	if not data.Mounts.OwnedMounts[mountId] then return false end
	-- Unequip if this is the active slot — both stops the rider and
	-- clears EquippedMount/PreferredMount in one call (post-split,
	-- AttemptDismount no longer touches the slot).
	if data.Mounts.EquippedMount == mountId then
		Module.AttemptUnequipMount(player)
	end
	data.Mounts.OwnedMounts[mountId] = nil
	-- Drop the config row from the client shell so widgets re-render
	-- with the mount missing.
	local Repl = SystemsContainer.MountsConfigReplicationServer
	if Repl and Repl.OnMountRevoked then Repl.OnMountRevoked(player, mountId) end
	return true
end

-- Helper: am I currently riding? Truthy when the character carries the
-- 'Mounted' state — we don't store an extra IsRiding field on the save
-- struct because the state should always reset on respawn.
local function isRiding(player: Player): boolean
	local character = player.Character
	if not character then return false end
	return CharacterStates.GetState(character, 'Mounted') ~= nil
end

-- Equip: set the *active mount slot*. Doesn't necessarily start a ride.
-- If the player is currently riding, hot-swap the visual: despawn the
-- old mount and spawn the new one without breaking the riding flag.
function Module.AttemptEquipMount(player: Player, mountId: string): boolean
	local character = player.Character
	if not character then return false end
	local data = getSave(player); if not data then return false end
	local ok, _reason = MountsShared.CanEquipMount(character, data, mountId)
	if not ok then return false end

	ensureMountsTable(data)
	local wasRiding = isRiding(player)
	local prevId = data.Mounts.EquippedMount

	data.Mounts.EquippedMount = mountId
	data.Mounts.PreferredMount = mountId  -- G-key re-summon target

	-- Riding hot-swap: tear down the old visual + bring up the new one
	-- without flipping CharacterStates.Mounted off (which would drop the
	-- player back to the ground for a frame).
	if wasRiding and prevId ~= mountId then
		MountEvent:FireAllClients(MountsShared.MountActions.Despawn, player, 'replace')
		CharacterStates.SetState(character, 'Mounted', mountId)
		-- Broadcast the mount config to all clients before the Spawn
		-- event so spectator clients (whose Mounts shell doesn't have
		-- this id) can render the model. Idempotent on already-replicated.
		local Repl = SystemsContainer.MountsConfigReplicationServer
		if Repl and Repl.BroadcastVisibleMount then Repl.BroadcastVisibleMount(mountId) end
		MountEvent:FireAllClients(MountsShared.MountActions.Spawn, player, mountId)
		MountEvent:FireClient(player, MountsShared.MountActions.Mounted, mountId)
	end
	return true
end

-- Unequip: clear the active mount slot. Auto-dismounts if currently
-- riding so the player isn't left "riding nothing".
function Module.AttemptUnequipMount(player: Player): boolean
	local data = getSave(player); if not data then return false end
	ensureMountsTable(data)
	if not data.Mounts.EquippedMount then return false end
	if isRiding(player) then Module.AttemptDismount(player, 'manual') end
	data.Mounts.EquippedMount = nil
	data.Mounts.PreferredMount = nil
	return true
end

-- Mount: start riding the equipped mount. No-op if no mount is equipped
-- or already riding.
function Module.AttemptMount(player: Player): boolean
	local character = player.Character; if not character then return false end
	local data = getSave(player); if not data then return false end
	ensureMountsTable(data)
	local mountId = data.Mounts.EquippedMount
	if not mountId then return false end
	if isRiding(player) then return false end
	local ok, _reason = MountsShared.CanEquipMount(character, data, mountId)
	if not ok then return false end

	CharacterStates.SetState(character, 'Mounted', mountId)
	-- Broadcast the mount config so spectator clients can render. See
	-- AttemptEquipMount comment for rationale.
	local Repl = SystemsContainer.MountsConfigReplicationServer
	if Repl and Repl.BroadcastVisibleMount then Repl.BroadcastVisibleMount(mountId) end
	MountEvent:FireAllClients(MountsShared.MountActions.Spawn, player, mountId)
	MountEvent:FireClient(player, MountsShared.MountActions.Mounted, mountId)
	return true
end

-- Dismount: stop riding. Preserves the active mount slot so the next
-- mount/G-press re-summons the same beast.
function Module.AttemptDismount(player: Player, reason: string?): boolean
	local character = player.Character
	if not character then return false end
	if not isRiding(player) then return false end
	CharacterStates.SetState(character, 'Mounted', nil)
	MountEvent:FireAllClients(MountsShared.MountActions.Despawn, player, reason or 'manual')
	MountEvent:FireClient(player, MountsShared.MountActions.Unmounted)
	return true
end

----------------------------------------------------------------------
-- Damage hook — called from PlayerCombatServer / damage flows. Mounts
-- with DismountOnDamage = true force-dismount the rider.
----------------------------------------------------------------------
function Module.OnPlayerDamaged(player: Player)
	local equipped = Module.GetEquippedMountId(player)
	if not equipped then return end
	local cfg = MountsConfig.Mounts[equipped]
	if cfg and cfg.Stats and cfg.Stats.DismountOnDamage then
		Module.AttemptDismount(player, 'damage')
	end
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	-- Receive client intents.
	MountEvent.OnServerEvent:Connect(function(player, action, ...)
		if action == MountsShared.MountActions.TryEquip then
			local mountId = ...
			Module.AttemptEquipMount(player, mountId)
		elseif action == MountsShared.MountActions.TryUnequip then
			Module.AttemptUnequipMount(player)
		elseif action == MountsShared.MountActions.TryMount then
			Module.AttemptMount(player)
		elseif action == MountsShared.MountActions.TryDismount then
			Module.AttemptDismount(player, 'manual')
		end
	end)

	-- On player join, if their save has a starter/auto-unlock mount, grant it.
	-- And ensure no stale EquippedMount survives a session boundary (rider
	-- needs to remount each session so model + camera state line up).
	-- Also wire the Humanoid.HealthChanged listener so DismountOnDamage
	-- mounts force-dismount when the rider takes a hit — same pattern
	-- the CombatLogServer uses to bump in-combat without each emitter
	-- having to call MountsServer.OnPlayerDamaged manually.
	local function onCharacterAdded(player: Player, character: Model)
		local data = getSave(player); if not data then return end
		ensureMountsTable(data)
		-- EquippedMount persists across respawns now (slot semantics).
		-- Riding state lives on CharacterStates.Mounted, which a fresh
		-- character starts without — so the player respawns dismounted
		-- but their selected mount is preserved for the next G/Mount press.
		-- Auto-unlock every starter mount.
		for mountId, cfg in MountsConfig.Mounts do
			if cfg.UnlockSource == 'starter' and not data.Mounts.OwnedMounts[mountId] then
				data.Mounts.OwnedMounts[mountId] = { UnlockedAt = os.time() }
			end
		end
		-- Bootstrap the config-replication shell on the client. Sends
		-- one bundle covering every owned mount (or the full registry
		-- for whitelisted admins). Runs on every CharacterAdded — the
		-- payload is idempotent (Bundle replaces the client shell with
		-- the current authoritative view), so re-spawn-time pushes are
		-- cheap and self-healing if any mid-session Add was missed.
		local Repl = SystemsContainer.MountsConfigReplicationServer
		if Repl and Repl.BootstrapPlayer then Repl.BootstrapPlayer(player) end
		-- HealthChanged → force-dismount on damage.
		local humanoid = character:FindFirstChildOfClass('Humanoid')
			or character:WaitForChild('Humanoid', 5)
		if humanoid then
			local last = humanoid.Health
			humanoid.HealthChanged:Connect(function(newHealth)
				if newHealth < last then
					Module.OnPlayerDamaged(player)
				end
				last = newHealth
			end)
		end
	end

	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function(character)
			onCharacterAdded(player, character)
		end)
		-- CharacterRemoving: nothing to clear. EquippedMount stays as the
		-- persistent slot; CharacterStates.Mounted dies with the old
		-- character automatically.
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/CompanionsServer"><![CDATA[-- Companions server. Owns:
--   * data.Companions struct (Owned[companionId] = {Level, XP, Bond}, Equipped)
--   * AddCompanionXP / level-up flow + LevelUp cue
--   * UseCompanionCandy resolution (consumes inventory item, adds XP)
--   * GetActiveBonuses query for sibling servers (XP gain multiplier, etc.)
--
-- Visual rendering (model spawn, hover bob) is client-only.

local Players = game:GetService('Players')

local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CompanionsShared = ReplicatedModules.Services.CompanionsShared
-- Server reads the canonical (full) registry from ServerStorage. The
-- ReplicatedStorage Companions shell is empty at boot and only
-- populated on each player by ConfigReplicationClient.
local CompanionsConfig = ServerModules.Data.Companions
local ItemsConfig      = ServerModules.Data.Items
local BoostersConfig   = ReplicatedModules.Data.Boosters
local RemoteService    = ReplicatedModules.Services.RemoteService
-- Pod auto-attack dependencies. Reads CombatShared.IsWeaponDrawn for
-- the gate, CombatConfig for tuning, and pulls AICharacter targets via
-- CollectionService.
local CombatSharedModule = ReplicatedModules.Services.CombatShared
local CombatConfigModule = ReplicatedModules.Data.CombatConfig
local DamageModule       = require(game:GetService('ServerStorage'):WaitForChild('Modules'):WaitForChild('Modules'):WaitForChild('DamageModule'))
local CollectionService  = game:GetService('CollectionService')

local CompanionEvent = RemoteService.GetRemote('CompanionEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Save struct accessor — pulls from SavesManagerServer.
----------------------------------------------------------------------
local function getSave(player: Player): any?
	local Saves = SystemsContainer.SavesManagerServer
	if not Saves then return nil end
	return Saves.GetPlayerSelectedSaveData(player)
end

local function ensureCompanionsTable(saveData: any)
	-- Centralized through the shared migration so legacy saves with a
	-- single-string Equipped field get converted to the array form.
	-- Idempotent — safe to call on every getSave path.
	CompanionsShared.MigrateEquippedShape(saveData)
	if typeof(saveData.Companions) ~= 'table' then saveData.Companions = {} end
	if typeof(saveData.Companions.Owned) ~= 'table' then saveData.Companions.Owned = {} end
	if typeof(saveData.Companions.Equipped) ~= 'table' then saveData.Companions.Equipped = {} end
end

local function getMaxSlots(player: Player): number
	-- Route through the shared resolver so all override paths are honored:
	--   * Cmdr `SetMaxEquippedCompanions` → saveData.Companions.MaxEquipped
	--     (absolute override; wins over everything).
	--   * Cmdr `SetExtraMaxCompanionEquips` → saveData.Companions.BonusEquipped
	--     (additive on top of gamepass cap).
	--   * Gamepass — PremiumConfig.GetMaxCompanionSlots(hasPass).
	--
	-- Bug history: the previous implementation only consulted PremiumServer,
	-- so admin commands that bumped MaxEquipped past the gamepass cap
	-- were silently ignored at equip-attempt time — players couldn't
	-- equip past the gamepass cap regardless of the override.
	local saveData = getSave(player)
	if saveData then
		return CompanionsShared.GetMaxSlotsFromSave(saveData)
	end
	-- No save (very early boot / disconnect race) → conservative default.
	return 1
end

local function findSlotIndex(equipped: { string }, companionId: string): number?
	for i, id in equipped do if id == companionId then return i end end
	return nil
end

local function ensureOwnedEntry(saveData: any, companionId: string)
	ensureCompanionsTable(saveData)
	if not saveData.Companions.Owned[companionId] then
		saveData.Companions.Owned[companionId] = {
			Level = 1, XP = 0, Bond = 0, UnlockedAt = os.time(),
		}
	end
end

----------------------------------------------------------------------
-- Pure accessors.
----------------------------------------------------------------------
function Module.GetEquippedId(player: Player): string?
	local data = getSave(player); if not data then return nil end
	return CompanionsShared.GetEquippedId(data)
end

function Module.GetActiveBonuses(player: Player): { [string]: number | string }
	local data = getSave(player); if not data then return {} end
	return CompanionsShared.GetActiveBonuses(data)
end

----------------------------------------------------------------------
-- Mutations.
----------------------------------------------------------------------
-- Set the player's max-equipped companion count. Clamped to a safe
-- range so a typo can't make the cap negative or unbounded. Cmdr
-- exposes this via SetMaxEquippedCompanions; future shop/gamepass
-- flows can call into this same path.
local MAX_COMPANION_CAP = 8
function Module.SetMaxEquipped(player: Player, count: number): boolean
	if typeof(count) ~= 'number' then return false end
	count = math.clamp(math.floor(count), 0, MAX_COMPANION_CAP)
	local data = getSave(player); if not data then return false end
	ensureCompanionsTable(data)
	data.Companions.MaxEquipped = count
	return true
end

-- Set the player's BONUS companion-slot count — additive on top of the
-- gamepass-derived base cap (vs SetMaxEquipped, which is an absolute
-- override). Useful for "+1 free slot" event rewards or gradual
-- increases without flipping the gamepass benefit. 0 clears the bonus.
-- Clamped to MAX_COMPANION_CAP so the resulting total can't go above
-- the design ceiling.
function Module.SetBonusEquipped(player: Player, count: number): boolean
	if typeof(count) ~= 'number' then return false end
	count = math.clamp(math.floor(count), 0, MAX_COMPANION_CAP)
	local data = getSave(player); if not data then return false end
	ensureCompanionsTable(data)
	data.Companions.BonusEquipped = count
	return true
end

function Module.AttemptUnlockCompanion(player: Player, companionId: string): boolean
	local cfg = CompanionsConfig.Companions[companionId]
	if not cfg then return false end
	local data = getSave(player); if not data then return false end
	ensureOwnedEntry(data, companionId)
	-- Push the config to the client shell so widgets / gameplay code
	-- have the companion visible without waiting for the next bootstrap.
	-- Defensive: idempotent if the player already had it.
	local Repl = SystemsContainer.CompanionsConfigReplicationServer
	if Repl and Repl.OnCompanionUnlocked then Repl.OnCompanionUnlocked(player, companionId) end
	return true
end

function Module.AttemptEquipCompanion(player: Player, companionId: string): boolean
	local cfg = CompanionsConfig.Companions[companionId]
	if not cfg then return false end
	local data = getSave(player); if not data then return false end
	ensureCompanionsTable(data)
	if not data.Companions.Owned[companionId] then return false end

	-- Idempotent success when already equipped (don't double-fire Spawn).
	if CompanionsShared.IsCompanionEquipped(data, companionId) then return true end

	local equipped = data.Companions.Equipped
	local maxSlots = getMaxSlots(player)
	-- Strict-fail when full: forces an explicit unequip to free a slot.
	-- A "replace oldest" model would surprise players who curated their
	-- loadout. Mirrors AurasServer's strict-fail behavior.
	if #equipped >= maxSlots then
		return false
	end

	equipped[#equipped + 1] = companionId
	-- Spawn cue carries the companionId so other clients render this
	-- specific companion without a separate slot-list lookup.
	-- Broadcast the companion config to all clients before the Spawn
	-- event so spectator clients can render the model. Their Companions
	-- shell may not have this id (only the owner's bootstrap brings it).
	local Repl = SystemsContainer.CompanionsConfigReplicationServer
	if Repl and Repl.BroadcastVisibleCompanion then Repl.BroadcastVisibleCompanion(companionId) end
	CompanionEvent:FireAllClients(CompanionsShared.CompanionActions.Spawn, player, companionId)
	return true
end

function Module.AttemptUnequipCompanion(player: Player, companionId: string?): boolean
	local data = getSave(player); if not data then return false end
	ensureCompanionsTable(data)
	local equipped = data.Companions.Equipped
	if #equipped == 0 then return false end
	-- Back-compat: nil id means "unequip all" — preserves the legacy
	-- single-slot remote contract (TryUnequip with no args).
	if not companionId then
		local removed = {}
		for _, id in equipped do removed[#removed + 1] = id end
		table.clear(equipped)
		for _, id in removed do
			CompanionEvent:FireAllClients(CompanionsShared.CompanionActions.Despawn, player, id)
		end
		return true
	end
	local idx = findSlotIndex(equipped, companionId)
	if not idx then return false end
	table.remove(equipped, idx)
	CompanionEvent:FireAllClients(CompanionsShared.CompanionActions.Despawn, player, companionId)
	return true
end

----------------------------------------------------------------------
-- Movement mode toggle. Refuses unless the companion's cfg has
-- AllowWalkAndFloatBypass = true (so non-debug companions can't
-- be flipped via a forged remote). Persists the choice on the save
-- so the player's preference survives respawn / disconnect.
----------------------------------------------------------------------
function Module.AttemptSetMovementMode(player: Player, companionId: string, mode: string): boolean
	if mode ~= 'float' and mode ~= 'walk' then return false end
	local cfg = CompanionsConfig.Companions[companionId]
	if not cfg or cfg.AllowWalkAndFloatBypass ~= true then
		return false
	end
	local data = getSave(player); if not data then return false end
	ensureCompanionsTable(data)
	if typeof(data.Companions.MovementModes) ~= 'table' then
		data.Companions.MovementModes = {}
	end
	-- No-op when value matches; saves a replicate flush.
	if data.Companions.MovementModes[companionId] == mode then return true end
	data.Companions.MovementModes[companionId] = mode
	-- Broadcast the cue so every client (the rider + observers)
	-- swaps its render. The Spawn cue alone wouldn't help — render
	-- already exists; we just toggle modes.
	CompanionEvent:FireAllClients(
		CompanionsShared.CompanionActions.MovementChanged,
		player, companionId, mode)
	return true
end

function Module.AddCompanionXP(player: Player, companionId: string, amount: number)
	if amount <= 0 then return end
	local cfg = CompanionsConfig.Companions[companionId]
	if not cfg then return end
	local data = getSave(player); if not data then return end
	ensureOwnedEntry(data, companionId)
	local entry = data.Companions.Owned[companionId]
	entry.XP = (entry.XP or 0) + amount
	-- Roll up levels while XP exceeds threshold.
	local levelsGained = 0
	while entry.Level < cfg.MaxLevel and entry.XP >= cfg.XPCurve(entry.Level) do
		entry.XP = entry.XP - cfg.XPCurve(entry.Level)
		entry.Level = entry.Level + 1
		levelsGained = levelsGained + 1
	end
	if entry.Level >= cfg.MaxLevel then entry.XP = 0 end
	if levelsGained > 0 then
		CompanionEvent:FireClient(player, CompanionsShared.CompanionActions.LevelUp,
			companionId, entry.Level)
	end
end

----------------------------------------------------------------------
-- Consume `quantity` of an itemId from a player's inventory in place.
-- Walks UUIDs, decrements .Quantity, deletes the slot via the canonical
-- AttemptPlayerDeleteItemOfUUID call when quantity hits 0. Returns the
-- amount actually consumed (may be < requested if inventory ran out).
----------------------------------------------------------------------
local function consumeFromInventory(player: Player, itemId: string, quantity: number): number
	local Inventory = SystemsContainer.PlayerInventoryServer
	if not Inventory or not Inventory.GetItemUUIDsOfItemId
		or not Inventory.AttemptPlayerDeleteItemOfUUID then
		return 0
	end
	local data = getSave(player); if not data then return 0 end
	local bucket = data.Inventory and data.Inventory[itemId]
	if typeof(bucket) ~= 'table' then return 0 end
	local consumed = 0
	local uuids = Inventory.GetItemUUIDsOfItemId(player, itemId) or {}
	for _, uuid in uuids do
		if consumed >= quantity then break end
		local slot = bucket[uuid]
		if typeof(slot) == 'table' then
			local have = slot.Quantity or 1
			local take = math.min(have, quantity - consumed)
			slot.Quantity = have - take
			consumed += take
			if slot.Quantity <= 0 then
				Inventory.AttemptPlayerDeleteItemOfUUID(player, uuid)
			end
		end
	end
	return consumed
end

----------------------------------------------------------------------
-- Companion candy: consumes one of the candy item from inventory and
-- adds the candy's XPAmount to the equipped companion. Used by the
-- inventory tooltip "Use" button and the CompanionsTab feed-candy modal.
----------------------------------------------------------------------
function Module.UseCompanionCandy(player: Player, candyItemId: string): boolean
	local cfg = ItemsConfig.Items[candyItemId]
	if not cfg or cfg.Type ~= 'CompanionCandy' or not cfg.CandyData then
		return false
	end
	local data = getSave(player); if not data then return false end
	-- Multi-equip: candy applies to the first equipped companion. Future
	-- per-companion targeting can route through a separate
	-- UseCompanionCandyOnId(player, candyItemId, companionId) entrypoint
	-- without changing this fallback.
	local equipped = CompanionsShared.GetEquippedId(data)
	if not equipped then return false end

	if consumeFromInventory(player, candyItemId, 1) <= 0 then return false end
	Module.AddCompanionXP(player, equipped, cfg.CandyData.XPAmount or 0)
	return true
end

----------------------------------------------------------------------
-- Hook for sibling XP system: feed a fraction of player XP to the
-- equipped companion. Other modules call this directly.
----------------------------------------------------------------------
function Module.OnPlayerEarnedXP(player: Player, amount: number)
	local data = getSave(player); if not data then return end
	-- Multi-equip: every equipped companion shares the per-XP drip at
	-- the same rate (no per-slot dilution — running 3 companions simply
	-- triples your collective XP-per-kill rate). Tunable here.
	local share = math.floor(amount * 0.25)
	if share <= 0 then return end
	-- Booster: companion_xp_mul. Multiplies the per-companion share, not
	-- the player's incoming XP — so the booster only juices companion
	-- progression and doesn't double-count against the XP booster.
	if SystemsContainer.BoostersServer and SystemsContainer.BoostersServer.GetMultiplier then
		local mul = SystemsContainer.BoostersServer.GetMultiplier(player, BoostersConfig.Kinds.CompanionXpMul)
		if mul ~= 1 then
			share = math.max(1, math.floor(share * mul + 0.5))
		end
	end
	for _, equipped in CompanionsShared.GetEquippedSlots(data) do
		Module.AddCompanionXP(player, equipped, share)
	end
end

----------------------------------------------------------------------
-- Pod-style companion auto-attack (see NIER_COMBAT.md).
--
-- While a player has a companion equipped AND their weapon drawn AND
-- there is an enemy within POD_ATTACK_RANGE AND Settings.CompanionAutoAttack
-- is true, the companion fires a damage pulse every POD_ATTACK_INTERVAL.
-- Per-shot damage = companion.Level * POD_DAMAGE_PER_LEVEL — cheap per
-- shot, meaningful DPS over a long fight.
--
-- Implementation: one task per player kicked off on CharacterAdded.
-- Loop self-terminates when the character changes (the captured
-- variable goes out of scope on respawn, so the next iteration sees a
-- fresh character). Errors swallowed via pcall so a missing humanoid
-- mid-tick doesn't kill the loop.
----------------------------------------------------------------------

-- Find the nearest AI within `radius` studs of `position`. Skips dead
-- humanoids and AICharacter models without HRPs. O(n) over tagged
-- characters per tick — n is small (a handful of mobs near a player).
local function findNearestEnemy(position: Vector3, radius: number): Model?
	local best: Model? = nil
	local bestDistSq = radius * radius
	for _, npc in CollectionService:GetTagged('AICharacter') do
		if not npc:IsA('Model') then continue end
		local h = npc:FindFirstChildOfClass('Humanoid')
		if not h or h.Health <= 0 then continue end
		local hrp = npc:FindFirstChild('HumanoidRootPart') :: BasePart?
		if not hrp then continue end
		local d = hrp.Position - position
		local distSq = d.X * d.X + d.Y * d.Y + d.Z * d.Z
		if distSq < bestDistSq then
			bestDistSq = distSq
			best = npc
		end
	end
	return best
end

-- Read the player's CompanionAutoAttack setting, defaulting to true
-- when the save shape is missing the toggle. (Older saves predating
-- the SettingsTab toggle won't have the field; default ON matches
-- SettingsRegistry's default.)
local function isAutoAttackEnabled(saveData: any): boolean
	if typeof(saveData) ~= 'table' then return true end
	local settings = saveData.Settings
	if typeof(settings) ~= 'table' then return true end
	if settings.CompanionAutoAttack == false then return false end
	return true  -- nil or true → on
end

local function startPodAutoAttackForPlayer(player: Player)
	task.spawn(function()
		while player.Parent do
			local cfg = CombatConfigModule.CombatConfig
			task.wait(cfg.POD_ATTACK_INTERVAL or 0.3)

			local character = player.Character
			if not character then continue end
			local hrp = character:FindFirstChild('HumanoidRootPart') :: BasePart?
			if not hrp then continue end

			-- Only attack while the player has their weapon drawn —
			-- pods are a combat-only system, not an idle aura.
			if not CombatSharedModule.IsWeaponDrawn(character) then continue end

			local saveData = getSave(player)
			if not saveData then continue end
			if not isAutoAttackEnabled(saveData) then continue end

			local equippedSlots = CompanionsShared.GetEquippedSlots(saveData)
			if #equippedSlots == 0 then continue end
			local owned = saveData.Companions and saveData.Companions.Owned or {}

			-- Find a target. Hitscan; one shared target across all equipped
			-- companions per tick — multiple pods shooting the same enemy
			-- reads better than scattering across nearby mobs (and avoids
			-- N findNearestEnemy scans per tick).
			local target = findNearestEnemy(hrp.Position, cfg.POD_ATTACK_RANGE or 40)
			if not target then continue end
			local targetHumanoid = target:FindFirstChildOfClass('Humanoid')
			if not targetHumanoid or targetHumanoid.Health <= 0 then continue end

			-- One pulse per equipped companion. Damage scales with that
			-- companion's level, so a level-3 + level-1 loadout deals
			-- (3 + 1) × scalar per tick.
			for _, equippedId in equippedSlots do
				local entry = owned[equippedId]
				if not entry then continue end
				local damage = (entry.Level or 1) * (cfg.POD_DAMAGE_PER_LEVEL or 2)
				-- Companions don't draw aggro (per spec); skip the agro
				-- table and just deal the damage. nil source keeps the
				-- pet from pulling threat.
				pcall(function()
					DamageModule.DamageHumanoid(targetHumanoid, damage, nil)
				end)

				-- Cue clients to render the pod shot. Reuses the existing
				-- CompanionEvent remote — clients ignore unknown actions
				-- silently if the registry hasn't been extended.
				CompanionEvent:FireAllClients(
					CompanionsShared.CompanionActions.PodShot or 'PodShot',
					player, target, damage)
			end
		end
	end)
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	CompanionEvent.OnServerEvent:Connect(function(player, action, ...)
		if action == CompanionsShared.CompanionActions.TryEquip then
			local companionId = ...
			Module.AttemptEquipCompanion(player, companionId)
		elseif action == CompanionsShared.CompanionActions.TryUnequip then
			-- Multi-equip: client sends the specific id to unequip. Old
			-- clients sending no arg (which becomes nil) trigger the
			-- "unequip all" back-compat path inside AttemptUnequipCompanion.
			local companionId = ...
			Module.AttemptUnequipCompanion(player, companionId)
		elseif action == CompanionsShared.CompanionActions.UseCandy then
			local candyItemId = ...
			Module.UseCompanionCandy(player, candyItemId)
		elseif action == CompanionsShared.CompanionActions.SetMovementMode then
			local companionId, mode = ...
			Module.AttemptSetMovementMode(player, companionId, mode)
		end
	end)

	-- On respawn, re-broadcast the equipped companion so other clients
	-- redraw the hovering model (their CharacterAdded won't help —
	-- CompanionsClient is keyed by the rider Player, not Character).
	-- Also kick off a Pod auto-attack tick per player here so the loop
	-- self-cleans when the player leaves (its `while player.Parent`
	-- guard exits when PlayerRemoving has run).
	-- Default-equipped companion + the broader set we auto-unlock so the
	-- Companions tab shows the whole wisp roster (instead of just the
	-- one the player currently has). Other companions stay locked until
	-- their unlock source is implemented.
	local STARTER_COMPANION_ID = 'wisp_green'
	local AUTO_UNLOCK_COMPANIONS = {
		'wisp_green', 'wisp_red', 'wisp_blue', 'wisp_orange',
	}

	local function onPlayerJoined(player: Player)
		startPodAutoAttackForPlayer(player)
		player.CharacterAdded:Connect(function()
			local data = getSave(player); if not data then return end
			ensureCompanionsTable(data)
			-- Seed: auto-unlock every companion in AUTO_UNLOCK_COMPANIONS
			-- so the player sees them all in the list. Auto-equip the
			-- starter when nothing is currently equipped (post-migration,
			-- Equipped is always an array — empty if first spawn).
			for _, companionId in AUTO_UNLOCK_COMPANIONS do
				if CompanionsConfig.Companions[companionId] then
					ensureOwnedEntry(data, companionId)
				end
			end
			if #data.Companions.Equipped == 0
				and CompanionsConfig.Companions[STARTER_COMPANION_ID] then
				table.insert(data.Companions.Equipped, STARTER_COMPANION_ID)
			end
			-- Re-broadcast every equipped companion so other clients
			-- redraw the visuals on the new character instance. Push
			-- each config to all clients first so spectator shells can
			-- render — see AttemptEquipCompanion for the same rationale.
			local Repl = SystemsContainer.CompanionsConfigReplicationServer
			for _, equipped in data.Companions.Equipped do
				if Repl and Repl.BroadcastVisibleCompanion then
					Repl.BroadcastVisibleCompanion(equipped)
				end
				CompanionEvent:FireAllClients(
					CompanionsShared.CompanionActions.Spawn, player, equipped)
			end
			-- Bootstrap the config-replication shell on the client. Runs
			-- AFTER the auto-unlock pass above so the bundle includes
			-- the wisp roster + any starter companions that were just
			-- ensured. Idempotent on respawn (Bundle replaces the shell
			-- with the current authoritative view).
			local Repl = SystemsContainer.CompanionsConfigReplicationServer
			if Repl and Repl.BootstrapPlayer then Repl.BootstrapPlayer(player) end
		end)
	end
	-- Cover players already in-game (e.g. studio-test reload).
	for _, p in Players:GetPlayers() do task.spawn(onPlayerJoined, p) end
	Players.PlayerAdded:Connect(onPlayerJoined)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/CraftingServer"><![CDATA[-- Crafting server. Owns:
--   * data.Crafting struct (ArtisanLevels, UnlockedRecipes, InProgressCrafts)
--   * AttemptCraft (validates via CraftingShared.CanCraft, deducts reagents,
--     queues or grants output, awards XP).
--   * AddArtisanXP / level-up flow (+ optional CraftingEvent.LevelUp cue).
--
-- Inventory mutations are routed through PlayerInventoryServer so the
-- UUID/derivation caches stay correct.

local Players = game:GetService('Players')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CraftingShared = ReplicatedModules.Services.CraftingShared
local CraftingConfig = ReplicatedModules.Data.Crafting
local LevelGates     = ReplicatedModules.Data.LevelGates
local StatisticsConfig = ReplicatedModules.Data.StatisticsConfig
local RemoteService  = ReplicatedModules.Services.RemoteService

local CraftingEvent = RemoteService.GetRemote('CraftingEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Save struct accessor.
----------------------------------------------------------------------
local function getSave(player: Player): any?
	local Saves = SystemsContainer.SavesManagerServer
	if not Saves then return nil end
	return Saves.GetPlayerSelectedSaveData(player)
end

local function ensureCrafting(saveData: any)
	if typeof(saveData.Crafting) ~= 'table' then saveData.Crafting = {} end
	local c = saveData.Crafting
	if typeof(c.ArtisanLevels) ~= 'table' then c.ArtisanLevels = {} end
	if typeof(c.UnlockedRecipes) ~= 'table' then c.UnlockedRecipes = {} end
	if typeof(c.InProgressCrafts) ~= 'table' then c.InProgressCrafts = {} end
	-- Per-recipe cooldown ledger. Keyed by recipeId → next-allowed
	-- timestamp (workspace:GetServerTimeNow). CraftingShared reads
	-- through here for the cooldown predicate; AttemptCraft stamps
	-- the ledger after a successful commit.
	if typeof(c.RecipeCooldowns) ~= 'table' then c.RecipeCooldowns = {} end
end

local function ensureSchoolEntry(saveData: any, schoolId: string)
	ensureCrafting(saveData)
	local levels = saveData.Crafting.ArtisanLevels
	if not levels[schoolId] then
		levels[schoolId] = { Level = 1, XP = 0 }
	end
end

----------------------------------------------------------------------
-- Mutations.
----------------------------------------------------------------------
-- Mark a recipe as unlocked on the player's save. Idempotent — calling
-- twice is a no-op. Returns false when the recipe id is unknown so
-- callers (cmdr / quest hooks) can surface "no such recipe" instead of
-- silently writing a junk entry.
function Module.UnlockRecipe(player: Player, recipeId: string): boolean
	if not CraftingConfig.Recipes[recipeId] then return false end
	local data = getSave(player); if not data then return false end
	ensureCrafting(data)
	data.Crafting.UnlockedRecipes[recipeId] = true
	return true
end

-- Bulk variant: unlock every recipe in the registry. Used by the
-- /unlockallrecipes cmdr command for testing the full crafting matrix
-- without manually unlocking each one.
function Module.UnlockAllRecipes(player: Player): number
	local data = getSave(player); if not data then return 0 end
	ensureCrafting(data)
	local n = 0
	for recipeId in CraftingConfig.Recipes do
		if not data.Crafting.UnlockedRecipes[recipeId] then
			data.Crafting.UnlockedRecipes[recipeId] = true
			n += 1
		end
	end
	return n
end

-- Seed every recipe with AutoUnlock = true onto the player's save.
-- Called on first character spawn so brand-new saves have a starting
-- crafting kit. Already-unlocked entries are kept (idempotent).
local function seedAutoUnlockRecipes(saveData: any)
	ensureCrafting(saveData)
	for recipeId, recipe in CraftingConfig.Recipes do
		if recipe.AutoUnlock and not saveData.Crafting.UnlockedRecipes[recipeId] then
			saveData.Crafting.UnlockedRecipes[recipeId] = true
		end
	end
end

function Module.AddArtisanXP(player: Player, schoolId: string, amount: number)
	if amount <= 0 then return end
	local school = CraftingConfig.Schools[schoolId]; if not school then return end
	local data = getSave(player); if not data then return end
	ensureSchoolEntry(data, schoolId)
	local entry = data.Crafting.ArtisanLevels[schoolId]
	entry.XP = (entry.XP or 0) + amount
	local levelsGained = 0
	while entry.Level < school.MaxLevel and entry.XP >= school.XPCurve(entry.Level) do
		entry.XP = entry.XP - school.XPCurve(entry.Level)
		entry.Level = entry.Level + 1
		levelsGained = levelsGained + 1
	end
	if entry.Level >= school.MaxLevel then entry.XP = 0 end
	if levelsGained > 0 then
		CraftingEvent:FireClient(player, 'LevelUp', schoolId, entry.Level)
		-- Smithing level-up may newly satisfy a forge template's
		-- RequiredArtisanLevel — recompute the player's unlocked
		-- templates set so the forge widget surfaces them on the
		-- next data update.
		if schoolId == 'Smithing' then
			local Forge = SystemsContainer.ForgeServer
			if Forge and Forge.RecomputeUnlockedTemplates then
				Forge.RecomputeUnlockedTemplates(player)
			end
		end
	end
end

-- Same shape as CompanionsServer.consumeFromInventory; duplicating here
-- to avoid a cross-module dependency on a private helper. If a third
-- consumer appears, lift this into PlayerInventoryServer as a public
-- AttemptDecrementUUID-by-quantity API.
local function consumeFromInventory(player: Player, itemId: string, quantity: number): number
	local Inventory = SystemsContainer.PlayerInventoryServer
	if not Inventory or not Inventory.GetItemUUIDsOfItemId
		or not Inventory.AttemptPlayerDeleteItemOfUUID then
		return 0
	end
	local Saves = SystemsContainer.SavesManagerServer
	local data = Saves and Saves.GetPlayerSelectedSaveData(player); if not data then return 0 end
	local bucket = data.Inventory and data.Inventory[itemId]
	if typeof(bucket) ~= 'table' then return 0 end
	local consumed = 0
	local uuids = Inventory.GetItemUUIDsOfItemId(player, itemId) or {}
	for _, uuid in uuids do
		if consumed >= quantity then break end
		local slot = bucket[uuid]
		if typeof(slot) == 'table' then
			local have = slot.Quantity or 1
			local take = math.min(have, quantity - consumed)
			slot.Quantity = have - take
			consumed += take
			if slot.Quantity <= 0 then
				Inventory.AttemptPlayerDeleteItemOfUUID(player, uuid)
			end
		end
	end
	return consumed
end

function Module.AttemptCraft(player: Player, recipeId: string, quantity: number?, options: any?): (boolean, string)
	local q = math.max(1, math.floor(quantity or 1))
	local data = getSave(player); if not data then return false, 'No save.' end
	-- Crafting level gate (default L7). Bypass paths: per-player flag
	-- (saveData.Flags.LevelGateBypass) OR server-wide global
	-- (LevelGatesServer.IsGloballyBypassed). Toast surfaced so the
	-- player knows why the craft refused — silent failures look buggy.
	local globalBypass = SystemsContainer.LevelGatesServer
		and SystemsContainer.LevelGatesServer.GetGlobalBypass()
	local gateOk = LevelGates.CanUseSystem(data, LevelGates.Systems.Crafting, globalBypass)
	if not gateOk then
		if SystemsContainer.ToastServer and SystemsContainer.ToastServer.NotifyGeneric then
			SystemsContainer.ToastServer.NotifyGeneric(player,
				LevelGates.FormatGateMessage(LevelGates.Systems.Crafting))
		end
		return false, 'level_locked'
	end
	-- Server-side resolution of NearWorkstation: WorkstationServer
	-- maintains an authoritative per-player nearest-tag map so the
	-- client can't fake a workstation by passing a string. Client's
	-- request still threads a Workstation hint through `options` for
	-- UX (so the right tab opens), but this resolution overrides it
	-- before validation.
	--
	-- options.BypassWorkstationGate skips the override entirely —
	-- intended for admin / cmdr testing paths where the player wants
	-- to fire a recipe regardless of where they're standing. The
	-- corresponding hint passes through unmodified.
	if not (options and options.BypassWorkstationGate) then
		local Workstations = SystemsContainer.WorkstationServer
		if Workstations and Workstations.GetNearestKind then
			options = options or {}
			options.NearWorkstation = Workstations.GetNearestKind(player)
		end
		-- Substations are AMBIENT (no prompt), so we always read from
		-- the server's authoritative active-set rather than trusting a
		-- client hint. Same BypassWorkstationGate flag covers admin
		-- overrides — a cmdr-issued craft skips both gates together.
		local Substations = SystemsContainer.SubstationServer
		if Substations and Substations.GetActiveSubstationKinds then
			options = options or {}
			options.NearSubstations = Substations.GetActiveSubstationKinds(player)
		end
	end
	local ok, reason = CraftingShared.CanCraft(data, recipeId, q, options)
	if not ok then return false, reason end

	local recipe = CraftingConfig.Recipes[recipeId]
	if not recipe then return false, 'Unknown recipe.' end

	local Inventory = SystemsContainer.PlayerInventoryServer
	if not Inventory or not Inventory.GiveQuantityOfItemIdToPlayer
		or not Inventory.GetItemUUIDsOfItemId then
		return false, 'Inventory unavailable.'
	end

	-- Deduct reagents.
	for _, reagent in recipe.Reagents do
		local need = reagent.Quantity * q
		local got = consumeFromInventory(player, reagent.ItemId, need)
		if got < need then
			-- Should be caught by CanCraft, but guard against TOCTOU.
			return false, string.format('Reagent %s consumed mid-craft.', reagent.ItemId)
		end
	end

	-- Grant output. Instant if CraftTime <= 0, otherwise queued.
	if (recipe.CraftTime or 0) <= 0 then
		if Inventory.GiveQuantityOfItemIdToPlayer then
			Inventory.GiveQuantityOfItemIdToPlayer(player, recipe.Output.ItemId,
				recipe.Output.Quantity * q)
		end
	else
		ensureCrafting(data)
		local craftUUID = string.format('craft_%d_%s', os.time(), recipeId)
		local now = workspace:GetServerTimeNow()
		data.Crafting.InProgressCrafts[craftUUID] = {
			recipeId = recipeId,
			startedAt = now,
			finishesAt = now + recipe.CraftTime,
			quantity = q,
		}
		task.delay(recipe.CraftTime, function()
			local cur = getSave(player); if not cur then return end
			local list = cur.Crafting and cur.Crafting.InProgressCrafts
			if not list or not list[craftUUID] then return end
			list[craftUUID] = nil
			if Inventory.GiveQuantityOfItemIdToPlayer then
				Inventory.GiveQuantityOfItemIdToPlayer(player, recipe.Output.ItemId,
					recipe.Output.Quantity * q)
			end
		end)
	end

	-- Stat hook: per-output-item crafted count + per-recipe count
	-- via the same map (different keys). Recipe.Output.ItemId is the
	-- visible output the player sees; recipeId is the internal handle.
	-- We track the OUTPUT item (player-facing) — UI wants
	-- "you crafted 12 IronSwords," not "you used 12 iron_sword_recipe".
	if SystemsContainer.StatisticsServer and recipe.Output and recipe.Output.ItemId then
		SystemsContainer.StatisticsServer.IncrementMap(player,
			StatisticsConfig.StatisticIds.ItemsCrafted, recipe.Output.ItemId, q)
	end

	-- Award XP.
	Module.AddArtisanXP(player, recipe.School, recipe.XPGain * q)

	-- Cooldown stamp. Recorded BEFORE the deferred grant fires so a
	-- spam-clicker can't fire two crafts within the same tick by
	-- exploiting the task.delay window. CraftingShared reads from
	-- here for the next CanCraft check; the entry is overwritten on
	-- each successful commit (last-craft wins).
	if recipe.Cooldown and recipe.Cooldown > 0 then
		ensureCrafting(data)
		data.Crafting.RecipeCooldowns[recipeId] =
			workspace:GetServerTimeNow() + recipe.Cooldown
	end
	return true, ''
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	CraftingEvent.OnServerEvent:Connect(function(player, action, ...)
		if action == CraftingShared.CraftingActions.Craft then
			local recipeId, quantity, hintWorkstation = ...
			-- The hint is UX-only — server overrides via WorkstationServer.
			Module.AttemptCraft(player, recipeId, quantity,
				{ NearWorkstation = hintWorkstation })
		end
	end)

	-- Seed each new player's per-school entries so the UI never sees a
	-- nil ArtisanLevels[Smithing] etc. Also seeds AutoUnlock-tagged
	-- recipes on the same tick so a brand-new save starts with the
	-- starter crafting kit visible.
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			local data = getSave(player); if not data then return end
			ensureCrafting(data)
			for schoolId in CraftingConfig.Schools do
				ensureSchoolEntry(data, schoolId)
			end
			seedAutoUnlockRecipes(data)
		end)
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/AurasServer"><![CDATA[-- Auras server. Owns ownership + equipped slot array. Visual rendering
-- is client-only (AurasClient subscribes to spawn cues).
--
-- Save struct shape (post-migration):
--   data.Auras = {
--     Owned    = { [auraId] = { UnlockedAt } },
--     Equipped = { auraId, auraId, ... },          -- ARRAY of slots
--   }
--
-- Slot cap: PremiumServer.GetMaxAuraSlots(player) — 1 default, 3 with
-- the AuraSlots gamepass. Equip refuses when full; players unequip
-- explicitly to free a slot. Each aura still has an Anchor field on
-- the config side, but Equipped is no longer keyed by anchor — the
-- player can stack 3 character auras, 1 of each anchor, etc.

local Players = game:GetService('Players')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local AurasShared    = ReplicatedModules.Services.AurasShared
local AurasConfig    = ReplicatedModules.Data.Auras
local RemoteService  = ReplicatedModules.Services.RemoteService

local AuraEvent = RemoteService.GetRemote('AuraEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

local function getSave(player: Player): any?
	local Saves = SystemsContainer.SavesManagerServer
	if not Saves then return nil end
	return Saves.GetPlayerSelectedSaveData(player)
end

local function ensureAurasTable(saveData: any)
	-- Centralized through the shared migration so legacy saves get
	-- their dict-shaped Equipped converted in-place. Idempotent —
	-- safe to call on every getSave path.
	AurasShared.MigrateEquippedShape(saveData)
	if typeof(saveData.Auras) ~= 'table' then saveData.Auras = {} end
	if typeof(saveData.Auras.Owned) ~= 'table' then saveData.Auras.Owned = {} end
	if typeof(saveData.Auras.Equipped) ~= 'table' then saveData.Auras.Equipped = {} end
end

local function getMaxSlots(player: Player): number
	local Premium = SystemsContainer.PremiumServer
	if Premium and Premium.GetMaxAuraSlots then
		return Premium.GetMaxAuraSlots(player)
	end
	-- PremiumServer not loaded (early-boot edge case) → assume default.
	-- The first equip after Premium loads gets the proper cap.
	return 1
end

----------------------------------------------------------------------
-- Slot helpers (private).
----------------------------------------------------------------------
local function findSlotIndex(equipped: { string }, auraId: string): number?
	for i, id in equipped do if id == auraId then return i end end
	return nil
end

local function broadcastSlotState(player: Player, equipped: { string }, max: number)
	-- SlotsChanged carries (currentCount, maxCount). Client widgets
	-- read both off this single cue rather than re-reading PlayerData
	-- per render — eliminates a Computed flicker between count + max.
	AuraEvent:FireClient(player, AurasShared.AuraActions.SlotsChanged, #equipped, max)
end

----------------------------------------------------------------------
-- Mutations.
----------------------------------------------------------------------
function Module.AttemptUnlockAura(player: Player, auraId: string): boolean
	local cfg = AurasConfig.Auras[auraId]
	if not cfg then return false end
	local data = getSave(player); if not data then return false end
	ensureAurasTable(data)
	if data.Auras.Owned[auraId] then return true end
	data.Auras.Owned[auraId] = { UnlockedAt = os.time() }
	return true
end

-- Owner-side delete. Removes from Owned + Equipped (and broadcasts a
-- Despawn cue if it was equipped). Used by the Cmdr DeleteAura
-- command so admins can revoke a granted aura cleanly.
function Module.AttemptRevokeAura(player: Player, auraId: string): boolean
	local data = getSave(player); if not data then return false end
	ensureAurasTable(data)
	-- Auto-unequip if the revoked aura was active.
	if AurasShared.IsAuraEquipped(data, auraId) then
		Module.AttemptUnequipAura(player, auraId)
	end
	if not data.Auras.Owned[auraId] then return false end
	data.Auras.Owned[auraId] = nil
	return true
end

function Module.AttemptEquipAura(player: Player, auraId: string): boolean
	local cfg = AurasConfig.Auras[auraId]
	if not cfg then return false end
	local data = getSave(player); if not data then return false end
	ensureAurasTable(data)
	if not data.Auras.Owned[auraId] then return false end

	-- Already equipped — idempotent success (don't double-fire Spawn).
	if AurasShared.IsAuraEquipped(data, auraId) then return true end

	local equipped = data.Auras.Equipped
	local maxSlots = getMaxSlots(player)
	-- Strict-fail when full: forces an explicit unequip to free a
	-- slot. A "replace oldest" model would surprise players who
	-- intentionally curated their loadout.
	if #equipped >= maxSlots then
		broadcastSlotState(player, equipped, maxSlots)
		return false
	end

	equipped[#equipped + 1] = auraId
	-- Broadcast the spawn so every client renders the visual on the
	-- player's anchor. Anchor is derived client-side from the cfg.
	AuraEvent:FireAllClients(AurasShared.AuraActions.Spawn, player, auraId)
	broadcastSlotState(player, equipped, maxSlots)
	return true
end

function Module.AttemptUnequipAura(player: Player, auraId: string): boolean
	local data = getSave(player); if not data then return false end
	ensureAurasTable(data)
	local equipped = data.Auras.Equipped
	local idx = findSlotIndex(equipped, auraId)
	if not idx then return false end
	table.remove(equipped, idx)
	AuraEvent:FireAllClients(AurasShared.AuraActions.Despawn, player, auraId)
	broadcastSlotState(player, equipped, getMaxSlots(player))
	return true
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	AuraEvent.OnServerEvent:Connect(function(player, action, ...)
		if action == AurasShared.AuraActions.TryEquip then
			Module.AttemptEquipAura(player, ...)
		elseif action == AurasShared.AuraActions.TryUnequip then
			Module.AttemptUnequipAura(player, ...)
		end
	end)

	-- Starter auras — auto-unlock + auto-equip one per anchor so a fresh
	-- player can immediately see the cross-anchor (character + weapon +
	-- mount) aura render. Bypasses the slot cap because these are "free
	-- starter pack" gifts, not slot-consuming purchased auras. Players
	-- can still unequip them in the Auras tab.
	local STARTER_AURAS = {
		'character_glow_amber',  -- amber halo on the character
		'sword_flame',           -- flame edge on the equipped weapon
		'mount_glow_storm',      -- storm mantle on the active mount
	}
	local function seedStarterAuras(player: Player, data: any)
		ensureAurasTable(data)
		for _, auraId in STARTER_AURAS do
			if not AurasConfig.Auras[auraId] then continue end
			-- Auto-unlock.
			if not data.Auras.Owned[auraId] then
				data.Auras.Owned[auraId] = { UnlockedAt = os.time() }
			end
			-- Auto-equip if not already in the slot list.
			if not AurasShared.IsAuraEquipped(data, auraId) then
				table.insert(data.Auras.Equipped, auraId)
			end
		end
	end

	-- On respawn, re-broadcast every equipped aura so other clients
	-- re-spawn the visuals on the new character/mount/sword instances.
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			local data = getSave(player); if not data then return end
			seedStarterAuras(player, data)
			for _, auraId in data.Auras.Equipped do
				AuraEvent:FireAllClients(AurasShared.AuraActions.Spawn, player, auraId)
			end
			-- Slot count cue for the local UI on respawn.
			broadcastSlotState(player, data.Auras.Equipped, getMaxSlots(player))
		end)
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/TitlesServer"><![CDATA[-- Titles server. Walks every TitleConfig.UnlockCheck on player join (and
-- after relevant gameplay events fire) and grants any titles the player
-- now qualifies for. Save struct shape is the existing data.Titles
-- table from EmptySaveTemplate; entries are keyed by titleId.

local Players = game:GetService('Players')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local TitlesConfig = ReplicatedModules.Data.Titles
local RemoteService = ReplicatedModules.Services.RemoteService

local TitleEvent = RemoteService.GetRemote('TitleEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

local function getSave(player: Player): any?
	local Saves = SystemsContainer.SavesManagerServer
	if not Saves then return nil end
	return Saves.GetPlayerSelectedSaveData(player)
end

local function ensureTitlesTable(saveData: any)
	if typeof(saveData.Titles) ~= 'table' then saveData.Titles = {} end
end

----------------------------------------------------------------------
-- Mutations.
----------------------------------------------------------------------
function Module.AttemptUnlockTitle(player: Player, titleId: string): boolean
	local cfg = TitlesConfig.Titles[titleId]
	if not cfg then return false end
	local data = getSave(player); if not data then return false end
	ensureTitlesTable(data)
	if data.Titles[titleId] then return true end
	-- Auth: re-run UnlockCheck server-side even when granted explicitly
	-- (e.g. via Cmdr) so we can't accidentally grant Owner to a
	-- non-owner from a stale call site.
	if cfg.UnlockCheck and not cfg.UnlockCheck(player, data) then
		return false
	end
	data.Titles[titleId] = {
		Name = cfg.Display.Name,
		Active = false,
		UnlockedAt = os.time(),
	}
	-- Toast notification (handled by ToastServer if present, else no-op).
	local Toast = SystemsContainer.ToastServer
	if Toast and Toast.NotifyTitleUnlocked then
		Toast.NotifyTitleUnlocked(player, titleId)
	end
	TitleEvent:FireClient(player, TitlesConfig.TitleActions.Unlocked, titleId)
	return true
end

-- Replicate the active title to every client by writing it as a character
-- attribute. Roblox replicates attribute changes automatically, so any
-- client (including future joiners) reads it via character:GetAttribute.
-- Empty string = no active title (Roblox attribute API doesn't accept
-- nil string values cleanly; OverheadInfo treats '' as "no title").
local function applyActiveTitleAttribute(player: Player, titleId: string?)
	local character = player.Character
	if not character then return end
	character:SetAttribute('ActiveTitle', titleId or '')
end

function Module.SetActiveTitle(player: Player, titleId: string?): boolean
	local data = getSave(player); if not data then return false end
	ensureTitlesTable(data)
	-- Defense-in-depth: title must be unlocked AND still pass UnlockCheck.
	-- The latter catches the case where developer/owner allowlist was
	-- updated and a previously-granted title shouldn't be re-equippable.
	if titleId ~= nil then
		local cfg = TitlesConfig.Titles[titleId]
		if not cfg then return false end
		if not data.Titles[titleId] then return false end
		if cfg.UnlockCheck and not cfg.UnlockCheck(player, data) then
			return false
		end
	end
	-- Clear all active flags; only one title can be active at a time.
	for _, entry in data.Titles do
		if typeof(entry) == 'table' then entry.Active = false end
	end
	if titleId ~= nil then
		data.Titles[titleId].Active = true
	end
	applyActiveTitleAttribute(player, titleId)
	return true
end

-- Read the currently-active title id from the save struct, or nil.
local function getActiveTitleId(data: any): string?
	if typeof(data) ~= 'table' or typeof(data.Titles) ~= 'table' then return nil end
	for titleId, entry in data.Titles do
		if typeof(entry) == 'table' and entry.Active == true then
			return tostring(titleId)
		end
	end
	return nil
end

----------------------------------------------------------------------
-- Auto-unlock pass: walks every title and runs UnlockCheck. Runs on
-- player join and can be re-run after gameplay events that may have
-- changed eligibility (level up, quest complete, etc.) by calling
-- Module.RunUnlockPass(player).
----------------------------------------------------------------------
function Module.RunUnlockPass(player: Player)
	local data = getSave(player); if not data then return end
	ensureTitlesTable(data)
	for titleId, cfg in TitlesConfig.Titles do
		if not data.Titles[titleId] and cfg.UnlockCheck and cfg.UnlockCheck(player, data) then
			Module.AttemptUnlockTitle(player, titleId)
		end
	end
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	TitleEvent.OnServerEvent:Connect(function(player, action, ...)
		if action == TitlesConfig.TitleActions.SetActive then
			-- First arg from the client is the titleId (or nil to clear).
			-- Sanitize: only accept string or nil; reject other types.
			local arg = (...)
			if arg ~= nil and typeof(arg) ~= 'string' then return end
			Module.SetActiveTitle(player, arg)
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			-- Re-run unlock pass first (in case spawn-state changed
			-- eligibility), then re-apply the active title attribute so
			-- the overhead nameplate picks it up after respawn.
			task.defer(function()
				Module.RunUnlockPass(player)
				local data = getSave(player); if not data then return end
				applyActiveTitleAttribute(player, getActiveTitleId(data))
			end)
		end)
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/ToastServer"><![CDATA[-- Toast server. Thin emitter — fires ToastEvent at a player when
-- something noteworthy happens (item received, title unlocked, aura
-- unlocked, level up, craft complete). Client-side ToastWidget owns
-- visual stacking + auto-dismiss.
--
-- Other server modules call into this via SystemsContainer.ToastServer
-- so the toast surface is opt-in: a system can grant items without a
-- toast (e.g. start-of-session reconciliation) by skipping the call.

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

local ItemsConfig      = ServerModules.Data.Items
local TitlesConfig     = ReplicatedModules.Data.Titles
local AurasConfig      = ReplicatedModules.Data.Auras
local AttributeConfig  = ReplicatedModules.Data.Attributes
local RemoteService    = ReplicatedModules.Services.RemoteService

local ToastEvent         = RemoteService.GetRemote('ToastEvent', 'RemoteEvent', false)
-- Inbound: client clicks a toast button, server routes by toastId
-- to the registered handler. Fields: (toastId: number, action: string).
local ToastResponseEvent = RemoteService.GetRemote('ToastResponseEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Toast kinds — string enum keyed off the client widget's renderer.
----------------------------------------------------------------------
Module.ToastKinds = {
	Item      = 'item',
	Title     = 'title',
	Aura      = 'aura',
	Level     = 'level',
	Attribute = 'attribute',  -- subtler than Level; fired by AttributeServer
	Request   = 'request',    -- friend / party / trade asks; usually has Buttons
	Generic   = 'generic',
}

----------------------------------------------------------------------
-- Per-toast button-action registry. Maps toastId → handler that the
-- client's button click eventually routes through.
--
-- Lifecycle: NotifyWithButtons inserts; client click fires
-- ToastResponseEvent which calls the matching handler and removes
-- the entry. Auto-cleanup on player removal. Stale entries (no click
-- before player leaves) are GC'd at PlayerRemoving.
----------------------------------------------------------------------
local _nextToastId = 0
type ButtonHandler = (player: Player, action: string) -> ()
local Handlers: { [number]: { player: Player, fn: ButtonHandler } } = {}

local function nextToastId(): number
	_nextToastId += 1
	return _nextToastId
end

----------------------------------------------------------------------
-- Public API.
----------------------------------------------------------------------
function Module.NotifyItemReceived(player: Player, itemId: string, quantity: number?)
	local cfg = ItemsConfig.Items[itemId]
	local name = (cfg and cfg.Display and cfg.Display.Title and cfg.Display.Title.Text) or itemId
	ToastEvent:FireClient(player, Module.ToastKinds.Item, {
		Title = string.format('×%d %s', quantity or 1, name),
		Subtitle = 'Item received',
		ItemId = itemId,
		Rarity = cfg and cfg.Rarity or 1,
	})
end

function Module.NotifyTitleUnlocked(player: Player, titleId: string)
	local cfg = TitlesConfig.Titles[titleId]
	local name = (cfg and cfg.Display and cfg.Display.Name) or titleId
	ToastEvent:FireClient(player, Module.ToastKinds.Title, {
		Title = name,
		Subtitle = 'Title unlocked',
		Color = cfg and cfg.Display and cfg.Display.Color,
	})
end

function Module.NotifyAuraUnlocked(player: Player, auraId: string)
	local cfg = AurasConfig.Auras[auraId]
	local name = (cfg and cfg.Display and cfg.Display.Name) or auraId
	ToastEvent:FireClient(player, Module.ToastKinds.Aura, {
		Title = name,
		Subtitle = 'Aura unlocked',
	})
end

function Module.NotifyLevelUp(player: Player, newLevel: number)
	ToastEvent:FireClient(player, Module.ToastKinds.Level, {
		Title = string.format('Level %d', newLevel),
		Subtitle = 'Level up',
	})
end

function Module.NotifyGeneric(player: Player, title: string, subtitle: string?)
	ToastEvent:FireClient(player, Module.ToastKinds.Generic, {
		Title = title,
		Subtitle = subtitle,
	})
end

-- Subtler than NotifyLevelUp — fired when an attribute (Strength,
-- Vitality, etc.) levels up. Subtitle reads "Strength → 5" so the
-- player sees the new tier without scanning the full attributes tab.
function Module.NotifyAttributeLevelUp(player: Player, attributeId: string, newLevel: number, _levelsGained: number?)
	local cfg = AttributeConfig.Attributes and AttributeConfig.Attributes[attributeId]
	local displayName = (cfg and cfg.Display and cfg.Display.Name) or attributeId
	ToastEvent:FireClient(player, Module.ToastKinds.Attribute, {
		Title = string.format('%s → %d', displayName, newLevel),
		Subtitle = 'Attribute leveled',
		AttributeId = attributeId,
	})
end

----------------------------------------------------------------------
-- Buttoned toast — payload + array of {Label, Action, Color?} buttons
-- and a server-side handler. The handler is called with
-- (player, action) when the player clicks a button on the matching
-- toast.
--
-- Use case: "Friend request from <name>" with Accept / Decline; the
-- handler takes the action string and dispatches to the friend system.
----------------------------------------------------------------------
function Module.NotifyWithButtons(
	player: Player,
	kind: string,
	payload: { [string]: any },
	buttons: { { Label: string, Action: string, Color: Color3? } },
	handler: ButtonHandler
)
	if not player or not player.Parent then return end
	local toastId = nextToastId()
	-- Stash the handler so the inbound ToastResponseEvent can route to it.
	Handlers[toastId] = { player = player, fn = handler }
	-- Echo back the toastId in the payload so the widget can include
	-- it in any response. Buttons are sent as a flat array; client
	-- renders one button per entry.
	local outPayload = {}
	for k, v in payload do outPayload[k] = v end
	outPayload.ToastId  = toastId
	outPayload.Buttons  = buttons
	ToastEvent:FireClient(player, kind, outPayload)
end

-- Manually clear a buttoned toast's handler — useful when an external
-- event (player accepted via a different UI) invalidates the toast.
function Module.ClearToastHandler(toastId: number)
	Handlers[toastId] = nil
end

function Module.Start()
	-- Route inbound button clicks. Validates that the toastId came
	-- from THIS player (so a malicious client can't trigger another
	-- player's pending Accept / Decline by guessing toast ids).
	ToastResponseEvent.OnServerEvent:Connect(function(player, toastId, action)
		if typeof(toastId) ~= 'number' or typeof(action) ~= 'string' then return end
		local entry = Handlers[toastId]
		if not entry then return end
		if entry.player ~= player then
			warn(string.format('ToastServer: %s tried to fire toast %d not belonging to them',
				player.Name, toastId))
			return
		end
		Handlers[toastId] = nil
		local ok, err = pcall(entry.fn, player, action)
		if not ok then
			warn(string.format('ToastServer: handler for toast %d errored: %s', toastId, tostring(err)))
		end
	end)

	-- GC pending handlers when a player leaves so stale entries don't
	-- accumulate across long uptime sessions.
	game:GetService('Players').PlayerRemoving:Connect(function(player)
		for id, entry in Handlers do
			if entry.player == player then Handlers[id] = nil end
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/LevelUpServer"><![CDATA[-- Level-up server. Thin emitter that fires LevelUpEvent at the client
-- when DataEditServer.GiveExperienceToPlayer crosses a level boundary.
-- Visual rendering (VFX, scale-pulse, sound) is client-only.

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local RemoteService = ReplicatedModules.Services.RemoteService
local LevelUpEvent = RemoteService.GetRemote('LevelUpEvent', 'RemoteEvent', false)

local Module = {}

function Module.NotifyLevelUp(player: Player, newLevel: number, levelsGained: number?)
	-- FireAllClients so other players see your level-up VFX too.
	LevelUpEvent:FireAllClients(player, newLevel, levelsGained or 1)
end

function Module.Init(_otherSystems) end

return Module
]]></Source>
		<Source path="ServerStorage/Core/OnboardingServer"><![CDATA[-- Onboarding server. Owns the per-player tutorial step flow + intro-
-- cinematic trigger, plus the first-join welcome-popup orchestration.
-- Steps are defined in Data.Onboarding; the client renders the active
-- step's tooltip via OnboardingClient and the welcome modal via
-- JoinGameWelcomeWidget.
--
-- One-shot flags (e.g. the welcome-popup gate ONBOARDING_JOIN_GAME_1) are
-- NOT stored here — they live in FFlagsServer (data.FFlags). This module
-- only orchestrates the welcome flow and delegates flag reads/writes.
--
-- Save struct shape (set by SavesManagerServer):
--   data.Onboarding = {
--     CompletedSteps = { [stepId] = true },
--     CurrentStep = stepId | nil,
--     IntroPlayed = boolean,
--   }

local Players = game:GetService('Players')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local OnboardingData = ReplicatedModules.Data.Onboarding
local Actions = OnboardingData.Actions
local FFlagsData = ReplicatedModules.Data.FFlags
local RemoteService = ReplicatedModules.Services.RemoteService

local OnboardingEvent = RemoteService.GetRemote('OnboardingEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

-- Players who have already been offered the JoinGame1 welcome popup this
-- session. Prevents the modal re-popping on every respawn while the
-- player hasn't yet clicked FINISH (the flag is the persistent gate; this
-- is just the in-session de-dupe). Cleared on PlayerRemoving.
local _welcomeOfferedThisSession: { [Player]: boolean } = {}

local function getSave(player: Player): any?
	local Saves = SystemsContainer.SavesManagerServer
	if not Saves then return nil end
	return Saves.GetPlayerSelectedSaveData(player)
end

local function ensureOnboarding(saveData: any)
	if typeof(saveData.Onboarding) ~= 'table' then saveData.Onboarding = {} end
	local o = saveData.Onboarding
	if typeof(o.CompletedSteps) ~= 'table' then o.CompletedSteps = {} end
	if o.IntroPlayed == nil then o.IntroPlayed = false end
end

----------------------------------------------------------------------
-- Step navigation helpers.
----------------------------------------------------------------------
local function findFirstIncompleteStepId(saveData: any): string?
	for _, stepId in OnboardingData.StepOrder do
		if not saveData.Onboarding.CompletedSteps[stepId] then
			return stepId
		end
	end
	return nil
end

function Module.HasCompletedStep(player: Player, stepId: string): boolean
	local data = getSave(player); if not data then return false end
	ensureOnboarding(data)
	return data.Onboarding.CompletedSteps[stepId] == true
end

function Module.GetCurrentStep(player: Player): string?
	local data = getSave(player); if not data then return nil end
	ensureOnboarding(data)
	return data.Onboarding.CurrentStep
end

function Module.SetCurrentStep(player: Player, stepId: string?)
	local data = getSave(player); if not data then return end
	ensureOnboarding(data)
	data.Onboarding.CurrentStep = stepId
	OnboardingEvent:FireClient(player, Actions.StepChanged, stepId)
end

function Module.MarkStepComplete(player: Player, stepId: string)
	local data = getSave(player); if not data then return end
	ensureOnboarding(data)
	if data.Onboarding.CompletedSteps[stepId] then return end
	data.Onboarding.CompletedSteps[stepId] = true
	-- Advance to the next incomplete step if the completed one was current.
	if data.Onboarding.CurrentStep == stepId then
		Module.SetCurrentStep(player, findFirstIncompleteStepId(data))
	end
	-- Lift the spawn-town area lock once the player finishes the
	-- final onboarding step. The lock is established on first spawn
	-- (OnFirstCharacterSpawn) and stays on until then.
	if stepId == 'finished' then
		local AreaLock = SystemsContainer.AreaLockServer
		if AreaLock and AreaLock.DisableLock then
			AreaLock.DisableLock(player, 'onboarding_spawn')
		end
	end
end

-- Conditional advance: marks the step complete only if it's currently
-- the active step. Used by gameplay code (e.g. inventory tab open hook
-- → AdvanceIfStep(player, 'open_inventory')).
function Module.AdvanceIfStep(player: Player, stepId: string)
	if Module.GetCurrentStep(player) == stepId then
		Module.MarkStepComplete(player, stepId)
	end
end

----------------------------------------------------------------------
-- First-join welcome popup (flag: ONBOARDING_JOIN_GAME_1).
-- Grants the starter quest (idempotently) and tells the client to open
-- the JoinGameWelcomeWidget. The client's FINISH button fires back the
-- 'FinishWelcome' action, which sets the flag below. While the flag is
-- unset the popup is re-offered on each fresh join; the session de-dupe
-- keeps it from re-popping on respawn.
----------------------------------------------------------------------
function Module.TryStartJoinGame1(player: Player)
	local FFlags = SystemsContainer.FFlagsServer
	-- Already completed on a prior session, or already offered this one.
	if FFlags and FFlags.HasFFlag(player, FFlagsData.Flags.JoinGame1) then return end
	if _welcomeOfferedThisSession[player] then return end
	_welcomeOfferedThisSession[player] = true

	-- Auto-grant the starter quest. Guarded so a re-offer (or the player
	-- already holding it from a previous incomplete session) never
	-- duplicates the entry — mirrors GameControllerServer's TEST_QUESTS seed.
	local Quests = SystemsContainer.QuestServer
	local questId = FFlagsData.JoinGame1QuestId
	if Quests and questId then
		local data = getSave(player)
		local existing = data and data.ActiveQuests and data.ActiveQuests[questId]
		if not (existing and next(existing) ~= nil) then
			Quests.GiveQuestOfId(player, questId)
		end
	end

	OnboardingEvent:FireClient(player, Actions.ShowWelcome)
end

function Module.FinishJoinGame1(player: Player)
	local FFlags = SystemsContainer.FFlagsServer
	if FFlags then
		FFlags.SetFFlag(player, FFlagsData.Flags.JoinGame1, true)
	end
end

-- Dev/reset helper: clears the JoinGame1 flag and the session de-dupe so
-- the welcome popup is offered again on the next OnFirstCharacterSpawn.
function Module.ResetJoinGame1(player: Player)
	local FFlags = SystemsContainer.FFlagsServer
	if FFlags then
		FFlags.ResetFFlag(player, FFlagsData.Flags.JoinGame1)
	end
	_welcomeOfferedThisSession[player] = nil
end

----------------------------------------------------------------------
-- First-spawn trigger: starts the intro cinematic + first step on a
-- player's first ever character spawn (IntroPlayed=false). Subsequent
-- spawns skip the intro but resume the active step.
----------------------------------------------------------------------
function Module.OnFirstCharacterSpawn(player: Player)
	local data = getSave(player); if not data then return end
	ensureOnboarding(data)

	-- First-join welcome popup + starter quest (independent of the
	-- step flow below; no-ops once ONBOARDING_JOIN_GAME_1 is set).
	Module.TryStartJoinGame1(player)

	if not data.Onboarding.IntroPlayed then
		data.Onboarding.IntroPlayed = true
		if SystemsContainer.GameIntroServer
			and SystemsContainer.GameIntroServer.PlayIntroFor then
			SystemsContainer.GameIntroServer.PlayIntroFor(player)
		end
		-- Set the first incomplete step as active.
		local firstStep = findFirstIncompleteStepId(data)
		Module.SetCurrentStep(player, firstStep)
	else
		-- Returning player: resume the active step (may be nil if done).
		local resume = data.Onboarding.CurrentStep or findFirstIncompleteStepId(data)
		Module.SetCurrentStep(player, resume)
	end

	-- Engage the spawn-town area lock when onboarding isn't complete.
	-- AreaLockServer is stub-tier today (see its TODO header); calls
	-- still register the lock so the rest of the flow is wired.
	-- Unlocked by MarkStepComplete('finished') above.
	local incomplete = findFirstIncompleteStepId(data)
	if incomplete then
		local AreaLock = SystemsContainer.AreaLockServer
		if AreaLock and AreaLock.EnableLock then
			-- Sphere region around the spawn town. Coords are placeholders
			-- until the spawn area lands; designers retune these to match
			-- the eventual town's bounds. Center=origin, radius=120 studs.
			AreaLock.EnableLock(player, 'onboarding_spawn', {
				Center = Vector3.new(0, 0, 0),
				Radius = 120,
			})
		end
	end
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	OnboardingEvent.OnServerEvent:Connect(function(player, action, ...)
		-- Client can manually mark a step complete (e.g. clicked the
		-- "got it" button on the overlay tooltip).
		if action == Actions.MarkComplete then
			local stepId = ...
			Module.MarkStepComplete(player, stepId)
		elseif action == Actions.FinishWelcome then
			-- Player clicked FINISH on the JoinGameWelcomeWidget.
			Module.FinishJoinGame1(player)
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.defer(Module.OnFirstCharacterSpawn, player)
		end)
	end)

	Players.PlayerRemoving:Connect(function(player)
		_welcomeOfferedThisSession[player] = nil
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/GameIntroServer"><![CDATA[-- Game Introduction cinematics — PLANNING STUB.
-- ----------------------------------------------------------------------
-- The user's request: plan the intro cinematic structure now, do not
-- implement the visual side yet (print placeholders are fine). When art
-- + audio land, swap the prints for `CinematicServer.PlayForPlayer(...)`
-- with the cinematic ids defined below.
--
-- Hooked from OnboardingServer.OnFirstCharacterSpawn — fires only on a
-- player's FIRST character spawn (Onboarding.IntroPlayed flag in save).
--
-- ============================================================
-- Planned cinematic ids (authored later in Data/Cinematics.luau):
-- ============================================================
--   intro_logo       — fade-in studio/game logo, ~3s, then fade out.
--                      No camera movement; ShowLabel cue + SFX cue.
--   intro_world_pan  — wide-angle camera pan over the spawn island /
--                      Floor 1 town establishing shot. ~6s. Uses
--                      CameraTo + CameraTrack cues anchored to set
--                      pieces (statues, town gate). Voiceover lines
--                      synced via PlaySFX.
--   intro_voiceover  — 2-3 short voice lines paced via WaitFor cues,
--                      with subtle CameraShake on cue beats. Ends
--                      with a CameraReset and the player taking
--                      control. ShowLabel reveals the player's
--                      starting subtitle ("ENTER ALFHEIM" or similar).
--
-- The three are PLAYED IN SEQUENCE: PlayIntroFor(player) chains them by
-- waiting on `cfg.Duration` between each FireClient. A single combined
-- cinematic (intro_full) would also work but the modular approach lets
-- skipping happen at any of the three boundary points cleanly.
--
-- ============================================================
-- API contract:
--   PlayIntroFor(player)              — fires the chained cinematic;
--                                        prints stub for now.
--   IsIntroPlaying(player)            — boolean flag for skip handling.
--   AbortIntro(player)                — short-circuits the chain.
-- ============================================================

local SystemsContainer = {}

local Module = {}

local IntroPlaying: { [Player]: boolean } = {}

----------------------------------------------------------------------
-- Sequence definition. Order matters; each cinematic's full duration
-- elapses before the next fires.
----------------------------------------------------------------------
local INTRO_SEQUENCE = {
	'intro_logo',
	'intro_world_pan',
	'intro_voiceover',
}

function Module.IsIntroPlaying(player: Player): boolean
	return IntroPlaying[player] == true
end

function Module.AbortIntro(player: Player)
	IntroPlaying[player] = nil
	local Cinematic = SystemsContainer.CinematicServer
	if Cinematic and Cinematic.AbortFor then
		Cinematic.AbortFor(player, 'intro_full')
	end
end

function Module.PlayIntroFor(player: Player)
	if IntroPlaying[player] then return end
	IntroPlaying[player] = true

	-- Real path: hand off to CinematicServer with the combined
	-- 'intro_full' cinematic (Data/Cinematics.luau). Combined-cinematic
	-- approach replaces the three-step chain — skip handling lives
	-- inside the cinematic config (one Esc cancels the whole intro).
	-- The legacy chain (intro_logo / intro_world_pan / intro_voiceover)
	-- is preserved as INTRO_SEQUENCE for designers who want to swap
	-- back to the modular shape later.
	local Cinematic = SystemsContainer.CinematicServer
	if Cinematic and Cinematic.PlayForPlayer then
		task.spawn(function()
			Cinematic.PlayForPlayer(player, 'intro_full')
			-- We don't need to wait on duration here — CinematicServer
			-- fires its End cue and the client unlocks input on its own.
			-- We just clear the running flag after a generous timeout.
			task.wait(13)
			IntroPlaying[player] = nil
		end)
	else
		-- Legacy stub path — kept for environments where CinematicServer
		-- isn't wired (cmdr-only test, dry-run boot). Iterates the
		-- planned sequence with a minimal yield so logs reveal order.
		task.spawn(function()
			for _, cinematicId in INTRO_SEQUENCE do
				if not IntroPlaying[player] then break end
				print(string.format('[GameIntroServer] (stub) Would play %s for %s',
					cinematicId, player.Name))
				task.wait(0.1)
			end
			IntroPlaying[player] = nil
		end)
	end
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/SkillsServer"><![CDATA[-- Skills server. Receives TryUseSkill from the client, validates via
-- SkillsShared.CanUseSkill, then walks the windup → active (with N
-- hit pulses) → recovery timeline. Damage is server-authoritative;
-- VFX cues go to all clients via FireAllClients.
--
-- Save struct shape:
--   data.Skills = {
--     UnlockedSkills = { [skillId] = { UnlockedAt } },
--   }
--
-- Per-skill cooldowns live on character attributes (SkillsShared) so
-- they replicate to the local client for UI display.

local Players = game:GetService('Players')
local RunService = game:GetService('RunService')

local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))
local DamageServerModule = ServerModules.Modules.DamageModule
local CombatServerModule = ServerModules.Modules.CombatModule

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))


local SkillsShared    = ReplicatedModules.Services.SkillsShared
local SkillsConfig    = ReplicatedModules.Data.Skills
local CharacterStates = ReplicatedModules.Services.CharacterStates
local CombatShared    = ReplicatedModules.Services.CombatShared
local BoostersConfig  = ReplicatedModules.Data.Boosters
local LevelGates      = ReplicatedModules.Data.LevelGates
local CombatUtility   = ReplicatedModules.Utility.CombatUtility
local HitboxUtility   = ReplicatedModules.Utility.Hitbox
local HitCacheUtility = ReplicatedModules.Utility.HitCache
local RemoteService   = ReplicatedModules.Services.RemoteService

local SkillEvent = RemoteService.GetRemote('SkillEvent', 'RemoteEvent', false)

-- Combat profiling instrumentation. Pairs `debug.profilebegin`/
-- `profileend` MicroProfiler scopes with an outer-side `os.clock()`
-- benchmark print so timings line up with the profile region exactly.
-- _profileCall handles early-return functions safely via a closure.
local function _profileCall(label: string, fn: () -> ...any): ...any
	local t0 = os.clock()
	debug.profilebegin(label)
	local results = table.pack(fn())
	-- Defensive: if `fn` yielded (task.wait, etc.), the engine has already
	-- popped our profile scope, so calling profileend would error with
	-- "No active profile annotation". pcall swallows that — the os.clock
	-- benchmark below survives yields and is the canonical timing here.
	pcall(debug.profileend)
	print(string.format('[Profile][%s] %.3fms', label, (os.clock() - t0) * 1000))
	return table.unpack(results, 1, results.n)
end

local SystemsContainer = {}

-- Hot-path allocation hoisted at module load. applyHitbox runs once per
-- skill pulse (a single Quad-Cross cast does 4). Recreating OverlapParams
-- per pulse adds GC pressure that scales with active casters. The Vector3
-- size differs per skill (cfg.Hitbox.Size), so the size stays per-call;
-- only the params object is shared.
local _skillOverlap = OverlapParams.new()
_skillOverlap.FilterType = Enum.RaycastFilterType.Exclude

local Module = {}

local function getSave(player: Player): any?
	local Saves = SystemsContainer.SavesManagerServer
	if not Saves then return nil end
	return Saves.GetPlayerSelectedSaveData(player)
end

local function ensureSkillsTable(saveData: any)
	if typeof(saveData.Skills) ~= 'table' then saveData.Skills = {} end
	if typeof(saveData.Skills.UnlockedSkills) ~= 'table' then
		saveData.Skills.UnlockedSkills = {}
	end
end

----------------------------------------------------------------------
-- Mutations.
----------------------------------------------------------------------
-- Cost in SkillPoints to unlock a skill via the tree. Cheap by default
-- (1 point per skill) so the existing 1-point-per-level award gives the
-- player roughly one new skill per level. Studio bypasses the cost so
-- testers can iterate without grinding.
local SKILL_UNLOCK_COST = 1

-- Returns (ok, reason). `reason` is an empty string on success,
-- otherwise a short machine-readable code:
--   'unknown_skill'    skillId not in SkillsConfig
--   'no_save'          no selected save (rare; pre-load race)
--   'maxed'            passive already at MaxLevel — no-op success rolls
--                      to ok=true with reason='maxed' as a hint to the UI
--   'already_unlocked' active skill already unlocked — same hint pattern
--   'missing_prereq:<id>'  one of cfg.Prereqs is not yet unlocked
--   'level_locked'     player's character level < cfg.RequiredLevel
--   'attribute_locked:<id>'  a RequiredAttributes entry is below its level
--   'no_points'        SkillPoints < cost
--   'invalid_cost'     cost <= 0 (config error; refuse to do free unlocks)
--
-- Studio no longer bypasses the SP cost. Earlier this function had an
-- `if not RunService:IsStudio()` skip that quietly let testers unlock
-- without spending — which masked the "cost not actually being charged"
-- bug in live behavior. Cost is always charged now; iterate via Cmdr's
-- SetSkillPoints command if you need a free-roam test.
function Module.AttemptUnlockSkill(player: Player, skillId: string): (boolean, string)
	local cfg = SkillsConfig.Skills[skillId]
	if not cfg then return false, 'unknown_skill' end
	local data = getSave(player); if not data then return false, 'no_save' end
	ensureSkillsTable(data)

	-- Coerce defensively: a corrupted save with non-number SkillPoints
	-- would otherwise bypass `< cost` because `nil < 1` errors before
	-- the comparison; the `or 0` fallback turns it into 0 which fails
	-- the cost check correctly.
	local availablePoints = tonumber(data.SkillPoints) or 0
	local cost = tonumber(cfg.UnlockCost) or SKILL_UNLOCK_COST
	if cost <= 0 then return false, 'invalid_cost' end

	local existing = data.Skills.UnlockedSkills[skillId]
	-- Passive level-up branch: when an already-unlocked passive is below
	-- its MaxLevel, charge another SP and bump Level. Maxed passives
	-- early-return success (idempotent, no double-charge).
	if existing then
		if cfg.Passive and cfg.MaxLevel then
			local currentLevel = (typeof(existing) == 'table' and typeof(existing.Level) == 'number')
				and existing.Level or 1
			if currentLevel >= cfg.MaxLevel then
				return true, 'maxed'  -- treated as no-op success
			end
			if availablePoints < cost then return false, 'no_points' end
			data.SkillPoints = availablePoints - cost
			-- Coerce legacy boolean-shape entry (very old saves) to the
			-- canonical table shape so Level is writable below.
			if typeof(existing) ~= 'table' then
				existing = { UnlockedAt = os.time() }
				data.Skills.UnlockedSkills[skillId] = existing
			end
			existing.Level = currentLevel + 1
			return true, ''
		end
		-- Active skill already unlocked — idempotent success.
		return true, 'already_unlocked'
	end

	-- First-time unlock branch (active OR passive).
	-- Auth: prereqs must be unlocked + level requirement met.
	for _, prereqId in cfg.Prereqs do
		if not data.Skills.UnlockedSkills[prereqId] then
			return false, 'missing_prereq:' .. tostring(prereqId)
		end
	end
	if (tonumber(data.Level) or 1) < cfg.RequiredLevel then
		return false, 'level_locked'
	end
	-- Attribute gate (e.g. ULTs require invested attributes). Mirrors
	-- SkillsShared.GetUnlockRequirements so the tree's listed reqs match
	-- what is enforced here. Reason carries the attribute id so the toast
	-- can name it.
	if typeof(cfg.RequiredAttributes) == 'table' then
		for attrName, minLevel in cfg.RequiredAttributes do
			local entry = (typeof(data.Attributes) == 'table') and data.Attributes[attrName] or nil
			local haveLevel = (typeof(entry) == 'table' and tonumber(entry.Level)) or 0
			if haveLevel < (tonumber(minLevel) or 0) then
				return false, 'attribute_locked:' .. tostring(attrName)
			end
		end
	end
	if availablePoints < cost then return false, 'no_points' end
	data.SkillPoints = availablePoints - cost
	data.Skills.UnlockedSkills[skillId] = {
		UnlockedAt = os.time(),
		-- Passives start at Level 1; active skills also carry Level=1
		-- harmlessly (the field is ignored for them) so the save shape
		-- stays uniform.
		Level = 1,
	}
	return true, ''
end

----------------------------------------------------------------------
-- Hitbox application — runs each pulse in the active window.
-- damageOwner is the Player when the caster is a player, nil for NPCs;
-- DamageModule supports either (nil owner means no kill-credit tag).
----------------------------------------------------------------------
local function applyHitbox(damageOwner: Player?, character: Model, skillCfg: any, hitIndex: number, hitCache: HitCacheUtility.HitCache?)
	return _profileCall('SkillsServer.applyHitbox', function()
	local hrp = character:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not hrp then return {} end

	local _t_hb = os.clock()
	debug.profilebegin('SkillsServer.applyHitbox.HitboxQuery')
	local cf = hrp.CFrame + (hrp.CFrame.LookVector * skillCfg.Hitbox.ForwardOffset)
	-- Reuse the module-level _skillOverlap; only the filter list changes per pulse.
	_skillOverlap.FilterDescendantsInstances = { character }

	local results = HitboxUtility.GetHitboxResult(cf, skillCfg.Hitbox.Size, _skillOverlap)
	debug.profileend()
	print(string.format('[Profile][%s] %.3fms', 'SkillsServer.applyHitbox.HitboxQuery', (os.clock() - _t_hb) * 1000))
	if #results == 0 then return {} end

	local primaryWeapon = CombatUtility.ResolvePrimaryWeapon(character)
	local primaryWeaponCfg = primaryWeapon.Config

	-- Per-pulse cache when the caller didn't supply a cross-pulse one.
	-- Keeps the within-pulse dedup contract identical to player + NPC
	-- swing paths so a humanoid can never be damaged twice by a single
	-- pulse even if FindHumanoidsFromHits ever stops de-duping.
	local pulseCache = hitCache or HitCacheUtility.New()

	local hitPositions: { Vector3 } = {}
	-- Per-pulse indicator batch. Quad-Cross does 4 pulses and each pulse can
	-- hit multiple humanoids — collapsing per-pulse N-fires to 1 saves
	-- broadcast burst at the same instant the pulse VFX broadcast also fires.
	local indicatorBuffer = {}
	local _t_loop = os.clock()
	debug.profilebegin('SkillsServer.applyHitbox.HitLoop')
	for _, humanoid in HitboxUtility.FindHumanoidsFromHits(results) do
		if not HitCacheUtility.ShouldHit(pulseCache, humanoid) then continue end
		-- Block decrement: skills hit through blocks identically to
		-- normal swings. The four-hit Quad slash naturally breaks
		-- BLOCK_MAX_HITS = 5 in two casts.
		local blockState = CombatShared.DecrementBlockCount(humanoid.Parent, false)
		if blockState ~= CombatShared.BLOCKING_STATE.NotBlocking
			and blockState ~= CombatShared.BLOCKING_STATE.Broken then
			continue
		end
		CombatServerModule.StunCharacter(humanoid.Parent, 0.4)
		local damage = CombatUtility.CalculateAttackDamage(
			character, primaryWeaponCfg,
			skillCfg.Damage.Base * (skillCfg.Damage.WeaponScale or 1)
		)
		DamageServerModule.DamageHumanoid(humanoid, damage, damageOwner, indicatorBuffer)
		table.insert(hitPositions, humanoid.RootPart and humanoid.RootPart.Position or hrp.Position)
	end
	debug.profileend()
	print(string.format('[Profile][%s] %.3fms', 'SkillsServer.applyHitbox.HitLoop', (os.clock() - _t_loop) * 1000))
	-- Flush per-pulse batch.
	DamageServerModule.FireBatchedDamageIndicators(indicatorBuffer)
	-- Notify clients of this pulse so they can spawn impact VFX at the
	-- positions where damage actually landed. Cue carries the casting
	-- character (not player) so the renderer doesn't need to know if
	-- the caster is a player or an NPC.
	if #hitPositions > 0 then
		local _t_bcast = os.clock()
		debug.profilebegin('SkillsServer.applyHitbox.CastHitBroadcast')
		SkillEvent:FireAllClients(SkillsShared.SkillActions.CastHit,
			character, skillCfg.Id, hitIndex, hitPositions)
		debug.profileend()
		print(string.format('[Profile][%s] %.3fms', 'SkillsServer.applyHitbox.CastHitBroadcast', (os.clock() - _t_bcast) * 1000))
	end
	return hitPositions
	end)
end

----------------------------------------------------------------------
-- runCastTimeline — internal. Runs the canonical windup → active
-- (N pulses) → recovery sequence on a character. Used by both the
-- player path and the NPC path; the only differences between them are
-- the auth check (handled by the caller) and the damageOwner passed to
-- the hitbox so kill-credit tags route correctly for player kills.
----------------------------------------------------------------------
local function runCastTimeline(character: Model, skillId: string, damageOwner: Player?)
	return _profileCall('SkillsServer.runCastTimeline', function()
	local cfg = SkillsConfig.Skills[skillId]
	if not cfg then return end

	-- Lock state for the entire skill window. UsingSkill is a
	-- temporary state with the full duration so other systems
	-- (combat, blocks, mount equip) auto-clear after recovery.
	local total = cfg.WindupTime + cfg.ActiveTime + cfg.RecoveryTime
	CharacterStates.SetStateTemporary(character, 'UsingSkill', total, skillId)

	-- Cooldown starts NOW so re-presses during the cast are also
	-- blocked, matching the client UI's drain-from-now bar.
	SkillsShared.StartSkillCooldown(character, skillId)
	-- Focus bonus: each level reduces cooldown by 3% (multiplicative).
	-- Override the cooldown attribute that StartSkillCooldown just set
	-- so the standard read path (GetSkillCooldownRemaining) picks up
	-- the reduced value. Player-only — NPCs don't get Focus / boosters.
	if damageOwner and cfg.Cooldown > 0 and SystemsContainer.AttributeServer
		and SystemsContainer.AttributeServer.GetPlayerBonus then
		local effectiveCD = cfg.Cooldown
		local focus = SystemsContainer.AttributeServer.GetPlayerBonus(damageOwner, 'Focus')
		if focus > 0 then
			effectiveCD = effectiveCD * (1 - focus)
		end
		-- Booster: skill_cdr_mul. Stored as a multiplier (e.g. 0.85 =
		-- 15% CDR). Compounds on top of Focus.
		if SystemsContainer.BoostersServer and SystemsContainer.BoostersServer.GetMultiplier then
			local cdrMul = SystemsContainer.BoostersServer.GetMultiplier(damageOwner, BoostersConfig.Kinds.SkillCdrMul)
			if cdrMul ~= 1 then
				effectiveCD = effectiveCD * cdrMul
			end
		end
		if effectiveCD ~= cfg.Cooldown then
			character:SetAttribute('SkillCD_' .. skillId, workspace:GetServerTimeNow() + effectiveCD)
		end
	end

	local _t_castbegin = os.clock()
	debug.profilebegin('SkillsServer.runCastTimeline.CastBeginBroadcast')
	SkillEvent:FireAllClients(SkillsShared.SkillActions.CastBegin, character, skillId, total)
	debug.profileend()
	print(string.format('[Profile][%s] %.3fms', 'SkillsServer.runCastTimeline.CastBeginBroadcast', (os.clock() - _t_castbegin) * 1000))

	task.spawn(function()
		task.wait(cfg.WindupTime)
		if not character.Parent then
			CharacterStates.SetState(character, 'UsingSkill', nil)
			return
		end
		local intervals = math.max(1, cfg.Hitbox.Hits)
		-- MultiHit defaults to true (existing N-hit slashes intentionally
		-- re-damage). When a designer opts out (MultiHit = false), we
		-- share a single HitCache across every pulse so each humanoid
		-- is damaged at most once across the cast — collapses the
		-- DamageIndicatorEvent + SkillEvent CastHit broadcast burst that
		-- shows up as on-hit lag with crowded encounters.
		local castCache: HitCacheUtility.HitCache? = nil
		if cfg.Hitbox.MultiHit == false then
			castCache = HitCacheUtility.New()
		end
		for i = 1, intervals do
			if not character.Parent then break end
			local _t_pulse = os.clock()
			debug.profilebegin('SkillsServer.runCastTimeline.HitPulse')
			applyHitbox(damageOwner, character, cfg, i, castCache)
			debug.profileend()
			print(string.format('[Profile][%s][i=%d] %.3fms', 'SkillsServer.runCastTimeline.HitPulse', i, (os.clock() - _t_pulse) * 1000))
			if i < intervals then
				task.wait(cfg.Hitbox.HitInterval)
			end
		end
		local activeUsed = (intervals - 1) * cfg.Hitbox.HitInterval
		task.wait(math.max(0, cfg.ActiveTime - activeUsed) + cfg.RecoveryTime)
		if character.Parent then
			local _t_end = os.clock()
			debug.profilebegin('SkillsServer.runCastTimeline.CastEndBroadcast')
			SkillEvent:FireAllClients(SkillsShared.SkillActions.CastEnd, character, skillId)
			debug.profileend()
			print(string.format('[Profile][%s] %.3fms', 'SkillsServer.runCastTimeline.CastEndBroadcast', (os.clock() - _t_end) * 1000))
		end
	end)
	end)
end

----------------------------------------------------------------------
-- AttemptPlayerUseSkill — player path. Validates against save struct
-- (unlock + level), then delegates to runCastTimeline.
----------------------------------------------------------------------
function Module.AttemptPlayerUseSkill(player: Player, skillId: string): boolean
	return _profileCall('SkillsServer.AttemptPlayerUseSkill', function()
		local character = player.Character
		if not character then return false end
		local data = getSave(player); if not data then return false end

		-- Level gate (Skills system, default L5). Two bypass paths:
		--   * per-player flag (saveData.Flags.LevelGateBypass) — Cmdr
		--     SetLevelGateBypass <player>.
		--   * server-wide global — Cmdr SetGlobalLevelGateBypass; lives
		--     in LevelGatesServer.GlobalBypass for the current session.
		-- Both are ORed inside LevelGates.CanUseSystem.
		-- Pass the full global-bypass MAP (not a single bool) so the
		-- per-system Skills key is consulted alongside the `all` master.
		local globalBypass = SystemsContainer.LevelGatesServer
			and SystemsContainer.LevelGatesServer.GetGlobalBypass()
		local gateOk = LevelGates.CanUseSystem(data, LevelGates.Systems.Skills, globalBypass)
		if not gateOk then
			if SystemsContainer.ToastServer and SystemsContainer.ToastServer.NotifyGeneric then
				SystemsContainer.ToastServer.NotifyGeneric(player,
					LevelGates.FormatGateMessage(LevelGates.Systems.Skills))
			end
			return false
		end

		local ok, _reason = SkillsShared.CanUseSkill(character, data, skillId)
		if not ok then return false end

		runCastTimeline(character, skillId, player)
		return true
	end)
end

----------------------------------------------------------------------
-- AttemptNPCUseSkill — NPC path. Skips the unlock/save check (NPCs
-- can cast whatever the AI commands), but still respects the same
-- character-state gates via CanCharacterCastSkill.
--
-- Damage is unowned (no Player tag) so NPC kills aren't credited as
-- player kills in the existing kill-tag system.
----------------------------------------------------------------------
function Module.AttemptNPCUseSkill(character: Model, skillId: string): boolean
	return _profileCall('SkillsServer.AttemptNPCUseSkill', function()
		if not character or not character.Parent then return false end
		local ok, _reason = SkillsShared.CanCharacterCastSkill(character, skillId)
		if not ok then return false end
		runCastTimeline(character, skillId, nil)
		return true
	end)
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	SkillEvent.OnServerEvent:Connect(function(player, action, ...)
		local _t_evt = os.clock()
		debug.profilebegin('SkillsServer.OnServerEvent')
		if action == SkillsShared.SkillActions.TryUseSkill then
			local skillId = ...
			Module.AttemptPlayerUseSkill(player, skillId)
		elseif action == SkillsShared.SkillActions.TryUnlockSkill then
			local skillId = ...
			local ok, reason = Module.AttemptUnlockSkill(player, skillId)
			-- Surface failures to the player as a toast so silent
			-- "click does nothing" doesn't trick them into thinking
			-- the button is broken when really they're out of points
			-- or below the level gate.
			if (not ok) and SystemsContainer.ToastServer
				and SystemsContainer.ToastServer.NotifyGeneric then
				local attrLock = reason and string.match(reason, '^attribute_locked:(.+)$')
				local label =
					reason == 'no_points'      and "Not enough skill points." or
					reason == 'level_locked'   and "Character level too low for this skill." or
					reason == 'invalid_cost'   and "Skill misconfigured (zero cost)." or
					attrLock and string.format("Raise %s further to unlock this skill.", attrLock) or
					(reason and string.match(reason, '^missing_prereq:'))
						and "Unlock prerequisite skills first." or
					"Could not unlock skill."
				SystemsContainer.ToastServer.NotifyGeneric(player, label)
			end
		end
		debug.profileend()
		print(string.format('[Profile][%s] %.3fms', 'SkillsServer.OnServerEvent', (os.clock() - _t_evt) * 1000))
	end)

	-- Auto-unlock starter skill `great_slash` for every new character.
	-- Subsequent skills are unlocked via the Skill Tree progression
	-- (handled in SkillsTab → AttemptUnlockSkill).
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			local data = getSave(player); if not data then return end
			ensureSkillsTable(data)
			if not data.Skills.UnlockedSkills.great_slash then
				data.Skills.UnlockedSkills.great_slash = { UnlockedAt = os.time() }
			end
		end)
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/ClientPersistenceServer"><![CDATA[-- Client-pushed persistence: settings + hotbar bindings.
--
-- Both surfaces follow the same pattern: client fires a remote with the
-- payload, server validates the shape + value range, writes to PlayerData,
-- re-replicates via ReplicatedData. No client value is trusted blindly —
-- a malformed remote gets dropped, not stored.
--
-- Save shape (declared in SavesManagerServer.luau EmptySaveTemplate):
--   data.Settings = { MasterVolume = 0..1, MusicVolume = 0..1, SFXVolume = 0..1,
--                     UITheme = string,
--                     MusicWidgetEnabled = bool, MinimapEnabled = bool,
--                     OnscreenButtonsEnabled = bool, Generic = {[k] = any} }
-- (UIScale removed — see SettingsRegistry / SavesManagerServer.)
--   data.Hotbar   = { [keybind] = { type = 'item'|'skill', uuid?, id? } }

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

local RemoteService = ReplicatedModules.Services.RemoteService
local SkillsShared = ReplicatedModules.Services.SkillsShared
local ItemsConfig = ServerModules.Data.Items

local SettingsEvent      = RemoteService.GetRemote('SettingsEvent',      'RemoteEvent', false)
local HotbarEvent        = RemoteService.GetRemote('HotbarEvent',        'RemoteEvent', false)
local KeybindEvent       = RemoteService.GetRemote('KeybindEvent',       'RemoteEvent', false)
local ActionKeybindEvent = RemoteService.GetRemote('ActionKeybindEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Settings — known keys + per-key validators.
----------------------------------------------------------------------

-- Returns true if `value` is acceptable for this `key`. Range checks
-- mirror what the SettingsTab UI exposes; out-of-range writes are
-- silently dropped (a misbehaving client can't push e.g. volume = 99).
local DASH_MODE_VALUES: { [string]: true } = {
	CameraDirection         = true,
	CharacterDirection      = true,
	CharacterDirectionalKey = true,
	CameraDirectionalKey    = true,
}

local SETTING_VALIDATORS: { [string]: (any) -> boolean } = {
	MasterVolume = function(v) return typeof(v) == 'number' and v >= 0 and v <= 1 end,
	MusicVolume  = function(v) return typeof(v) == 'number' and v >= 0 and v <= 1 end,
	SFXVolume    = function(v) return typeof(v) == 'number' and v >= 0 and v <= 1 end,
	UITheme      = function(v) return typeof(v) == 'string' and #v <= 64 end,
	MusicWidgetEnabled    = function(v) return typeof(v) == 'boolean' end,
	MinimapEnabled        = function(v) return typeof(v) == 'boolean' end,
	OnscreenButtonsEnabled = function(v) return typeof(v) == 'boolean' end,
	-- DashMode is one of four enum strings; reject anything else so a
	-- malformed client can't put the combat code into an unknown mode.
	DashMode = function(v) return typeof(v) == 'string' and DASH_MODE_VALUES[v] == true end,
	-- Nier-style combat toggles. Booleans only.
	PvPLockOnConsent    = function(v) return typeof(v) == 'boolean' end,
	CompanionAutoAttack = function(v) return typeof(v) == 'boolean' end,
	-- World-waypoint category toggles. Each gates a class of 3D markers
	-- spawned by WaypointsClient: workstations (Forge/Enchanting/etc.)
	-- and unlocked waystones. Booleans only.
	WaypointsWorkstationsEnabled = function(v) return typeof(v) == 'boolean' end,
	WaypointsWaystonesEnabled    = function(v) return typeof(v) == 'boolean' end,
	WaypointsSubstationsEnabled  = function(v) return typeof(v) == 'boolean' end,
	-- Compass strip visibility (top-of-screen waypoint projection).
	CompassEnabled               = function(v) return typeof(v) == 'boolean' end,
}

local function getSave(player: Player): any?
	local Saves = SystemsContainer.SavesManagerServer
	if not Saves then return nil end
	return Saves.GetPlayerSelectedSaveData(player)
end

local function ensureSettingsTable(data: any)
	if typeof(data.Settings) ~= 'table' then data.Settings = {} end
	if typeof(data.Settings.Generic) ~= 'table' then data.Settings.Generic = {} end
end

local function ensureHotbarTable(data: any)
	if typeof(data.Hotbar) ~= 'table' then data.Hotbar = {} end
end

----------------------------------------------------------------------
-- Settings.
----------------------------------------------------------------------

function Module.SetSetting(player: Player, key: string, value: any): boolean
	if typeof(key) ~= 'string' then return false end
	local validator = SETTING_VALIDATORS[key]
	if not validator then return false end
	if not validator(value) then return false end
	local data = getSave(player); if not data then return false end
	ensureSettingsTable(data)
	if data.Settings[key] == value then return true end  -- no-op write
	data.Settings[key] = value
	-- Mirror PvPLockOnConsent to a public character attribute so other
	-- players' TargetLockClient (which can't read this player's
	-- private save) can gate lock-on against the live setting. The
	-- `PvPLockOnConsentPublic` attribute is the read surface; only
	-- this code path writes it.
	if key == 'PvPLockOnConsent' then
		local character = player.Character
		if character then
			character:SetAttribute('PvPLockOnConsentPublic', value == true)
		end
	end
	return true
end

function Module.SetGenericSetting(player: Player, key: string, value: any): boolean
	-- Generic settings are open-shape (any future toggle that doesn't
	-- warrant a dedicated key). Restrict to scalar types so a malicious
	-- client can't push huge tables into the save struct.
	if typeof(key) ~= 'string' or #key > 64 then return false end
	local t = typeof(value)
	if t ~= 'number' and t ~= 'string' and t ~= 'boolean' then return false end
	local data = getSave(player); if not data then return false end
	ensureSettingsTable(data)
	if data.Settings.Generic[key] == value then return true end
	data.Settings.Generic[key] = value
	return true
end

----------------------------------------------------------------------
-- Hotbar bindings.
----------------------------------------------------------------------

-- Set of valid hotbar slotIds. Mirrors HotbarWidget's slot enumeration
-- (12 row-1 + 12 row-2 = 24 slots). Hardcoded here so the server
-- doesn't require the client widget.
local VALID_SLOT_IDS: { [string]: true } = {}
for i = 1, 12 do
	VALID_SLOT_IDS['r1_' .. i] = true
	VALID_SLOT_IDS['r2_' .. i] = true
end

-- Validate that an `item` binding refers to a UUID the player actually
-- owns. Loose validation — we walk PlayerData.Inventory looking for any
-- stack keyed by this UUID. Returns true if found.
local function playerOwnsUUID(data: any, uuid: string): boolean
	if typeof(data) ~= 'table' or typeof(data.Inventory) ~= 'table' then return false end
	for _itemId, uuidcache in data.Inventory do
		if typeof(uuidcache) == 'table' and uuidcache[uuid] ~= nil then
			return true
		end
	end
	return false
end

function Module.SetHotbarSlot(player: Player, slotId: string, binding: any?): boolean
	if not VALID_SLOT_IDS[slotId] then return false end
	local data = getSave(player); if not data then return false end
	ensureHotbarTable(data)
	-- Clear-binding case.
	if binding == nil then
		if data.Hotbar[slotId] == nil then return true end
		data.Hotbar[slotId] = nil
		return true
	end
	-- Bind case — strict shape validation.
	if typeof(binding) ~= 'table' then return false end
	local kind = binding.type
	if kind == 'item' then
		local uuid = binding.uuid
		if typeof(uuid) ~= 'string' or #uuid == 0 then return false end
		if not playerOwnsUUID(data, uuid) then return false end
		-- Hotbar accepts only Food / Potion items per design. The
		-- client filter already excludes other kinds, but the server
		-- gate ensures a forged remote can't sneak a sword/material
		-- into a slot.
		local itemId = nil
		for ownedItemId, uuidcache in (data.Inventory or {}) do
			if typeof(uuidcache) == 'table' and uuidcache[uuid] then
				itemId = ownedItemId; break
			end
		end
		local cfg = itemId and ItemsConfig.Items[itemId]
		if not cfg then return false end
		local isFood   = ItemsConfig.HasTag(cfg, ItemsConfig.ItemTags.Food)
		local isPotion = ItemsConfig.HasTag(cfg, ItemsConfig.ItemTags.Potion)
		if not (isFood or isPotion) then return false end
		data.Hotbar[slotId] = { type = 'item', uuid = uuid }
	elseif kind == 'skill' then
		local id = binding.id
		if typeof(id) ~= 'string' or #id == 0 then return false end
		-- Skill must be unlocked AND active (passives can't be cast,
		-- so binding one to a hotbar slot is a no-op at best).
		if not SkillsShared.IsSkillUnlocked(data, id) then return false end
		if SkillsShared.IsPassiveSkill(id) then return false end
		data.Hotbar[slotId] = { type = 'skill', id = id }
	else
		return false
	end
	return true
end

----------------------------------------------------------------------
-- Keybinds.
----------------------------------------------------------------------

local function ensureKeybindsTable(data: any)
	if typeof(data.Keybinds) ~= 'table' then data.Keybinds = {} end
end

-- Set / clear a keybind for a slot. `keychar` is a single lowercase
-- printable character (a-z, 0-9, '-', '='); pass nil to revert to the
-- slot's default keybind. We intentionally accept ASCII only — Roblox
-- KeyCode resolution via GetStringForKeyCode returns ASCII for all
-- supported physical keys, and rejecting non-ASCII closes a potential
-- payload-injection vector.
function Module.SetKeybind(player: Player, slotId: string, keychar: any?): boolean
	if not VALID_SLOT_IDS[slotId] then return false end
	local data = getSave(player); if not data then return false end
	ensureKeybindsTable(data)
	if keychar == nil then
		if data.Keybinds[slotId] == nil then return true end
		data.Keybinds[slotId] = nil
		return true
	end
	if typeof(keychar) ~= 'string' or #keychar ~= 1 then return false end
	-- ASCII printable check. byte values 0x20..0x7E. Lowercase only
	-- (uppercase a..z is 0x41..0x5A — reject so client-side lowercasing
	-- is a true single source of truth).
	local b = string.byte(keychar)
	if b < 0x20 or b > 0x7E then return false end
	if b >= 0x41 and b <= 0x5A then return false end
	data.Keybinds[slotId] = keychar
	return true
end

----------------------------------------------------------------------
-- Combat action keybinds. Distinct from Hotbar keybinds because action
-- keybinds use Roblox KeyCode names (e.g. 'LeftControl', 'F', 'Q')
-- rather than single printable characters — modifier keys + function
-- keys + mouse buttons are all expressible. Validates that the name
-- resolves to an actual Enum.KeyCode entry; rejects anything else.
----------------------------------------------------------------------

local VALID_ACTION_IDS: { [string]: true } = {
	Block = true, SheatheToggle = true, Mount = true, Heal = true, Dash = true,
	HeavyAttack = true,
}

local function ensureActionKeybindsTable(data: any)
	if typeof(data.ActionKeybinds) ~= 'table' then data.ActionKeybinds = {} end
end

function Module.SetActionKeybind(player: Player, actionId: string, keyCodeName: any?): boolean
	if not VALID_ACTION_IDS[actionId] then return false end
	local data = getSave(player); if not data then return false end
	ensureActionKeybindsTable(data)
	-- Clear → revert to default.
	if keyCodeName == nil then
		if data.ActionKeybinds[actionId] == nil then return true end
		data.ActionKeybinds[actionId] = nil
		return true
	end
	if typeof(keyCodeName) ~= 'string' or #keyCodeName == 0 or #keyCodeName > 32 then
		return false
	end
	-- Validate the string resolves to an Enum.KeyCode entry. Roblox
	-- raises on unknown names, so wrap in pcall and reject on failure.
	local ok, kc = pcall(function() return (Enum.KeyCode :: any)[keyCodeName] end)
	if not ok or kc == nil then return false end
	data.ActionKeybinds[actionId] = keyCodeName
	return true
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------

function Module.Start()
	-- Settings: client fires (key, value) — both 'known-key' and 'generic'
	-- writes flow through this dispatcher. Generic writes are scalars only.
	SettingsEvent.OnServerEvent:Connect(function(player, action, key, value)
		if typeof(action) ~= 'string' then return end
		if action == 'Set' then
			Module.SetSetting(player, key, value)
		elseif action == 'SetGeneric' then
			Module.SetGenericSetting(player, key, value)
		end
	end)

	-- Hotbar: client fires (slotId, binding | nil).
	HotbarEvent.OnServerEvent:Connect(function(player, slotId, binding)
		if typeof(slotId) ~= 'string' then return end
		Module.SetHotbarSlot(player, slotId, binding)
	end)

	-- Keybinds: client fires (slotId, keychar | nil).
	KeybindEvent.OnServerEvent:Connect(function(player, slotId, keychar)
		if typeof(slotId) ~= 'string' then return end
		Module.SetKeybind(player, slotId, keychar)
	end)

	-- Combat action keybinds: client fires (actionId, keyCodeName | nil).
	ActionKeybindEvent.OnServerEvent:Connect(function(player, actionId, keyCodeName)
		if typeof(actionId) ~= 'string' then return end
		Module.SetActionKeybind(player, actionId, keyCodeName)
	end)

	-- Mirror PvPLockOnConsent → character attribute on every spawn so
	-- other players' TargetLockClient can read it without seeing this
	-- player's private save. ClientPersistenceServer is the only writer.
	local function syncConsentToCharacter(player: Player)
		local character = player.Character
		if not character then return end
		local data = getSave(player)
		local consent = data and data.Settings and data.Settings.PvPLockOnConsent == true
		character:SetAttribute('PvPLockOnConsentPublic', consent)
	end
	local Players = game:GetService('Players')
	local function bindPlayer(player: Player)
		player.CharacterAdded:Connect(function() syncConsentToCharacter(player) end)
		if player.Character then syncConsentToCharacter(player) end
	end
	for _, p in Players:GetPlayers() do task.spawn(bindPlayer, p) end
	Players.PlayerAdded:Connect(bindPlayer)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/ForgeServer"><![CDATA[-- ForgeServer — server authority for the forge workstation.
-- See ARTISAN.md §8.
--
-- Validates every commit against ForgeShared (which both client UI and
-- this server require — single source of truth). On success, mutates
-- the player's inventory to either:
--   (a) re-forge an existing UUID's Composition.Forged in place, OR
--   (b) mint a new weapon stack via PlayerInventoryServer.GenerateUUIDToItemId.
-- Both paths mutate the linked save struct in place; ReplicatedData
-- auto-replicates on its next tick.

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

local ForgeShared = ReplicatedModules.Services.ForgeShared
local CompositionalConfig = ReplicatedModules.Data.Compositional
local ItemsConfig = ServerModules.Data.Items
-- Server reads canonical Blueprints (full registry) to walk every
-- template's RequiredArtisanLevel during the auto-unlock recompute.
local BlueprintsConfig = ServerModules.Data.Blueprints
local LevelGates = ReplicatedModules.Data.LevelGates
local StatisticsConfig = ReplicatedModules.Data.StatisticsConfig
local RemoteService = ReplicatedModules.Services.RemoteService

local ForgeEvent = RemoteService.GetRemote('ForgeEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

local function getSave(player: Player): any?
	local Saves = SystemsContainer.SavesManagerServer
	return Saves and Saves.GetPlayerSelectedSaveData(player)
end

local function ensureCraftingTable(saveData: any)
	if typeof(saveData.Crafting) ~= 'table' then saveData.Crafting = {} end
	if typeof(saveData.Crafting.UnlockedBlueprints) ~= 'table' then
		saveData.Crafting.UnlockedBlueprints = {}
	end
	-- Lazy-init for legacy saves predating the UnlockedForgeTemplates
	-- split. UnlockedBlueprints is "blueprints I know exist"
	-- (discovery); UnlockedForgeTemplates is "templates I'm permitted
	-- to actually craft" (artisan-level gate). Granted by
	-- AttemptUnlockForgeTemplate when smithing level reaches the
	-- template's RequiredArtisanLevel.
	if typeof(saveData.Crafting.UnlockedForgeTemplates) ~= 'table' then
		saveData.Crafting.UnlockedForgeTemplates = {}
	end
end

----------------------------------------------------------------------
-- Blueprint unlocks. Loot tables / cmdr can grant via this path.
----------------------------------------------------------------------
function Module.AttemptUnlockBlueprint(player: Player, blueprintId: string): boolean
	if typeof(blueprintId) ~= 'string' then return false end
	if not ForgeShared.GetBlueprintConfig(blueprintId) then return false end
	local data = getSave(player); if not data then return false end
	ensureCraftingTable(data)
	local alreadyUnlocked = data.Crafting.UnlockedBlueprints[blueprintId] ~= nil
	if not alreadyUnlocked then
		data.Crafting.UnlockedBlueprints[blueprintId] = { UnlockedAt = os.time() }
	end
	-- Push the config to the client shell so the Forge widget can
	-- render the new entry without waiting for a rejoin / rebootstrap.
	-- Defensive: idempotent on already-unlocked.
	local Repl = SystemsContainer.BlueprintsConfigReplicationServer
	if Repl and Repl.OnBlueprintUnlocked then Repl.OnBlueprintUnlocked(player, blueprintId) end
	-- A blueprint becoming known may also (and usually does) immediately
	-- satisfy its RequiredArtisanLevel for the current player → auto-add
	-- to UnlockedForgeTemplates so the forge widget surfaces it as
	-- craftable without waiting for the next level-up tick.
	Module.RecomputeUnlockedTemplates(player)
	return true
end

----------------------------------------------------------------------
-- Forge templates (the "can craft" set, distinct from UnlockedBlueprints
-- which is the "have discovered" set). A template lands in the
-- per-player UnlockedForgeTemplates map when both:
--   (a) the blueprint is in UnlockedBlueprints (player has discovered it),
--   (b) the player's Smithing level meets the blueprint's
--       RequiredArtisanLevel.
-- The map is auto-recomputed on every smithing level-up
-- (CraftingServer.AddArtisanXP hooks RecomputeUnlockedTemplates) and on
-- every blueprint unlock (above). Quest / event / cmdr paths can
-- additionally call AttemptUnlockForgeTemplate to grant a template
-- directly bypassing the level gate (e.g. a quest reward shortcut).
----------------------------------------------------------------------

-- IsTemplateUnlocked — pure read. Returns true if the player can
-- currently craft this template id.
function Module.IsTemplateUnlocked(player: Player, templateId: string): boolean
	if typeof(templateId) ~= 'string' then return false end
	local data = getSave(player); if not data then return false end
	ensureCraftingTable(data)
	return data.Crafting.UnlockedForgeTemplates[templateId] ~= nil
end

-- AttemptUnlockForgeTemplate — direct grant path (quest reward, cmdr,
-- event reward). Bypasses the discovery-blueprint + smithing-level
-- checks that RecomputeUnlockedTemplates uses; useful when the design
-- wants a template available before the player has hit the smithing
-- threshold (think "guild master gifts you the recipe early").
-- Idempotent on already-unlocked.
function Module.AttemptUnlockForgeTemplate(player: Player, templateId: string): boolean
	if typeof(templateId) ~= 'string' then return false end
	if not BlueprintsConfig.Blueprints[templateId] then return false end
	local data = getSave(player); if not data then return false end
	ensureCraftingTable(data)
	if data.Crafting.UnlockedForgeTemplates[templateId] then return true end
	data.Crafting.UnlockedForgeTemplates[templateId] = { UnlockedAt = os.time() }
	return true
end

-- RecomputeUnlockedTemplates — walk every authored blueprint and
-- promote it into UnlockedForgeTemplates if the player meets both
-- gates. Idempotent + monotonic — never removes an entry, since
-- direct grants (AttemptUnlockForgeTemplate) wouldn't be recoverable
-- otherwise. Called by the smithing-level-up flow + blueprint-unlock
-- flow above; also safe to call from Cmdr or one-off recovery.
function Module.RecomputeUnlockedTemplates(player: Player)
	local data = getSave(player); if not data then return end
	ensureCraftingTable(data)
	local smithingLevel = ForgeShared.GetSmithingLevel(data)
	for templateId, bp in BlueprintsConfig.Blueprints do
		-- Already granted? Skip the gate evaluation.
		if data.Crafting.UnlockedForgeTemplates[templateId] then continue end
		-- Discovery gate.
		if not data.Crafting.UnlockedBlueprints[templateId] then continue end
		-- Smithing-level gate. nil RequiredArtisanLevel → 1 (always passes).
		local req = bp.RequiredArtisanLevel or 1
		if smithingLevel < req then continue end
		data.Crafting.UnlockedForgeTemplates[templateId] = { UnlockedAt = os.time() }
	end
end

----------------------------------------------------------------------
-- AttemptForgeWeapon — main commit path.
-- request: {
--     BlueprintId = string,
--     Parts = { [slotKey] = materialId },
--     Modifiers = { { id, level } }?,
--     TargetItemId = string?,   -- nil = mint new; else re-forge existing UUID
--     TargetUUID   = string?,   -- non-nil paired with TargetItemId on re-forge
-- }
----------------------------------------------------------------------
function Module.AttemptForgeWeapon(player: Player, request: any): boolean
	if typeof(request) ~= 'table' then return false end
	local data = getSave(player); if not data then return false end
	ensureCraftingTable(data)
	-- Forge level gate (default L10). Per-player flag OR server-wide
	-- global. Both paths ORed inside LevelGates.CanUseSystem.
	local globalBypass = SystemsContainer.LevelGatesServer
		and SystemsContainer.LevelGatesServer.GetGlobalBypass()
	if not LevelGates.CanUseSystem(data, LevelGates.Systems.Forge, globalBypass) then
		if SystemsContainer.ToastServer and SystemsContainer.ToastServer.NotifyGeneric then
			SystemsContainer.ToastServer.NotifyGeneric(player,
				LevelGates.FormatGateMessage(LevelGates.Systems.Forge))
		end
		return false
	end

	-- Blueprint must be unlocked (Studio bypass mirrors SkillsServer pattern).
	local RunService = game:GetService('RunService')
	if not RunService:IsStudio() then
		if not data.Crafting.UnlockedBlueprints[request.BlueprintId] then
			return false
		end
	end

	-- Validate via shared predicate. Material-units lookup delegates to
	-- PlayerInventoryServer so ForgeShared stays free of server deps.
	local Inventory = SystemsContainer.PlayerInventoryServer
	local function unitsLookup(materialId)
		return Inventory and Inventory.GetForgeMaterialUnits(player, materialId) or 0
	end
	local ok, reason = ForgeShared.CanForgeWeapon(data, request, unitsLookup)
	if not ok then
		warn(string.format('[ForgeServer] forge rejected: %s', reason))
		return false
	end

	-- Compute cost + consume materials + currency.
	local cost = ForgeShared.ComputeForgeCost(request.BlueprintId, request.Parts, request.Modifiers)
	for matId, units in cost.Materials do
		if not Inventory.ConsumeForgeMaterialUnits(player, matId, units) then
			-- Defensive: should never happen post-validation, but bail to
			-- avoid partial-consumption.
			warn('[ForgeServer] consume failed mid-commit; aborting')
			return false
		end
	end
	data.Currency = (data.Currency or 0) - cost.Currency

	-- Build the Composition.Forged struct.
	local forged = CompositionalConfig.MakeEmptyForge(request.BlueprintId)
	for slotKey, matId in request.Parts do forged.Parts[slotKey] = matId end
	if request.Modifiers then
		for _, mod in request.Modifiers do
			table.insert(forged.Modifiers, { id = mod.id, level = mod.level or 1 })
		end
	end
	forged.StatSnapshot = ForgeShared.ComputeStats(
		request.BlueprintId, request.Parts, request.Modifiers)
	forged.ForgedAt = os.time()
	-- Dynamic rarity. Smithing level + best material's tier together
	-- decide the final rarity band — same player can mint Common
	-- iron-iron-iron at Lv 1 and Legendary moonsteel-emberite at Lv 50.
	-- Computed BEFORE the inventory mutation so the override travels
	-- on the freshly-baked Composition.Forged struct without a
	-- second round-trip.
	forged.RarityOverride = ForgeShared.ComputeForgedRarity(data, request.Parts)
	-- Blacksmith Identity stamp — records the player who minted (or
	-- re-forged) this weapon. Captured at commit time so re-forges
	-- preserve the latest creator. Re-forge by a different player
	-- overwrites the identity (intentional: the smith who last shaped
	-- the blade owns it). UserId is permanent across name changes;
	-- Name is the display name at this moment.
	forged.BlacksmithIdentity = {
		UserId = player.UserId,
		Name = player.DisplayName or player.Name,
	}

	-- Apply to either an existing stack (re-forge) or a freshly minted
	-- stack (new weapon). Re-forge preserves bindings (hotbar / equipped)
	-- because UUIDs don't change. New-mint goes through the inventory
	-- helper that allocates a fresh UUID.
	if request.TargetItemId and request.TargetUUID then
		local stack, itemId = Inventory.GetItemStackFromUUID(player, request.TargetUUID)
		if not stack or itemId ~= request.TargetItemId then
			warn('[ForgeServer] target uuid not found or itemId mismatch')
			return false
		end
		stack.Composition = stack.Composition or {}
		stack.Composition.Forged = forged
	elseif request.TargetItemId then
		local cfg = ItemsConfig.Items[request.TargetItemId]
		if not cfg then return false end
		local uuids = Inventory.GiveQuantityOfItemIdToPlayer(player, request.TargetItemId, 1)
		local newUuid = uuids and uuids[1]
		if not newUuid then return false end
		local stack = Inventory.GetItemStackFromUUID(player, newUuid)
		if stack then
			stack.Composition = stack.Composition or {}
			stack.Composition.Forged = forged
		end
	else
		warn('[ForgeServer] request missing TargetItemId')
		return false
	end

	-- Smithing XP grant. Computed from the same composition that drove
	-- rarity; CraftingServer.AddArtisanXP handles the level-up curve +
	-- save mutation.
	local xpAmount = ForgeShared.ComputeForgeXP(
		request.BlueprintId, request.Parts, request.Modifiers)
	if xpAmount > 0 then
		local Crafting = SystemsContainer.CraftingServer
		if Crafting and Crafting.AddArtisanXP then
			Crafting.AddArtisanXP(player, 'Smithing', xpAmount)
		end
	end

	-- Stat hook: every successful forge commit counts as one upgrade.
	-- Re-forge of an existing weapon and minting a fresh weapon both
	-- represent "the player engaged the forge once" from a statistics
	-- perspective — the menu surfaces a single combined counter.
	if SystemsContainer.StatisticsServer then
		SystemsContainer.StatisticsServer.Increment(player,
			StatisticsConfig.StatisticIds.UpgradesApplied, 1)
	end

	if SystemsContainer.ToastServer and SystemsContainer.ToastServer.NotifyForgeCommit then
		SystemsContainer.ToastServer.NotifyForgeCommit(player, request.BlueprintId)
	end

	-- Push the freshly-applied modifier configs to the client shell so
	-- the inventory tooltip / forge widget can render the new chip
	-- labels without waiting for re-bootstrap. Piggy-backs on Items'
	-- replicator (modifiers don't have their own replication module —
	-- they replicate as Items' cross-ref deps). Idempotent on
	-- already-replicated ids.
	if request.Modifiers and SystemsContainer.ItemsConfigReplicationServer then
		local pushIds: { string } = {}
		for _, mod in request.Modifiers do
			if typeof(mod) == 'table' and typeof(mod.id) == 'string' then
				pushIds[#pushIds + 1] = mod.id
			end
		end
		SystemsContainer.ItemsConfigReplicationServer.PushModifiersForPlayer(player, pushIds)
	end
	return true
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	ForgeEvent.OnServerEvent:Connect(function(player, action, ...)
		if typeof(action) ~= 'string' then return end
		if action == ForgeShared.ForgeActions.TryForge then
			Module.AttemptForgeWeapon(player, ...)
		elseif action == ForgeShared.ForgeActions.TryUnlockBlueprint then
			Module.AttemptUnlockBlueprint(player, ...)
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/EnchantServer"><![CDATA[-- EnchantServer — server authority for the enchanting workstation.
-- See ARTISAN.md §8.
--
-- v2 changes (this commit):
--   * Currency cost replaced by EnchantEssence + RarityEssence
--     consumption. Scrolls still bypass the essence cost (they are
--     a single-use shortcut).
--   * Already-enchanted weapons are rejected (single-enchant rule);
--     player must Salvage first.
--   * AttemptSalvageEnchant — strips every enchant entry from a stack
--     and returns rolled essences (full EnchantEssence + chance for
--     the matching RarityEssence).
--   * Successful applies grant Enchanting school XP.

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

local EnchantShared = ReplicatedModules.Services.EnchantShared
local CompositionalConfig = ReplicatedModules.Data.Compositional
local ItemsConfig = ServerModules.Data.Items
local EnchantsConfig = ReplicatedModules.Data.Enchants
local LevelGates = ReplicatedModules.Data.LevelGates
local StatisticsConfig = ReplicatedModules.Data.StatisticsConfig
local RemoteService = ReplicatedModules.Services.RemoteService

local EnchantEvent = RemoteService.GetRemote('EnchantEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

local function getSave(player: Player): any?
	local Saves = SystemsContainer.SavesManagerServer
	return Saves and Saves.GetPlayerSelectedSaveData(player)
end

----------------------------------------------------------------------
-- AttemptApplyEnchant — main commit.
-- scrollUuid: optional. When non-nil, validates the scroll matches the
-- (enchantId, level) request and consumes it (free apply — bypasses
-- the essence cost). When nil, consumes EnchantEssence + the rarity
-- essence keyed by the target weapon's effective rarity.
----------------------------------------------------------------------
function Module.AttemptApplyEnchant(player: Player, uuid: string, enchantId: string, level: number, scrollUuid: string?): boolean
	local data = getSave(player); if not data then return false end
	local Inventory = SystemsContainer.PlayerInventoryServer
	if not Inventory then return false end

	-- Resolve target stack early so the cost predicate can read its
	-- effective rarity (drives the rarity-essence cost).
	local stack, itemId = Inventory.GetItemStackFromUUID(player, uuid)
	if not stack or not itemId then return false end
	local itemConfig = ItemsConfig.Items[itemId]
	if not itemConfig then return false end
	local effRarity = ItemsConfig.GetEffectiveRarity(itemConfig, stack)
	local essenceCost = EnchantShared.GetEssenceCost(effRarity)

	-- Cost predicate: closes over scrollUuid + the resolved essence cost
	-- so EnchantShared.CanApplyEnchant can verify either the scroll
	-- path OR the essence path matches. Inspects only — consumption
	-- happens after validation passes.
	local function canPay(cfg, lvl)
		if scrollUuid then
			local _stack, scrollItemId = Inventory.GetItemStackFromUUID(player, scrollUuid)
			local scrollCfg = scrollItemId and ItemsConfig.Items[scrollItemId]
			local meta = ItemsConfig.GetEnchantInput(scrollCfg)
			if not meta or meta.Id ~= enchantId then
				return false, 'Scroll does not match enchant.'
			end
			if meta.Level and meta.Level ~= lvl then
				return false, string.format('Scroll grants level %d, not %d.', meta.Level, lvl)
			end
			return true, ''
		end
		-- Essence path: confirm the player has both essence types in
		-- the required quantities.
		local haveEnchant = Inventory.GetItemQuantity(player, 'EnchantEssence')
		if haveEnchant < essenceCost.EnchantEssenceQty then
			return false, string.format(
				'Need %d Enchant Essence (have %d).',
				essenceCost.EnchantEssenceQty, haveEnchant)
		end
		local haveRar = Inventory.GetItemQuantity(player, essenceCost.RarityEssenceItemId)
		if haveRar < essenceCost.RarityEssenceQty then
			local rarItemCfg = ItemsConfig.Items[essenceCost.RarityEssenceItemId]
			local rarName = (rarItemCfg and rarItemCfg.Display and rarItemCfg.Display.Title
				and rarItemCfg.Display.Title.Text) or essenceCost.RarityEssenceItemId
			return false, string.format(
				'Need %d × %s (have %d).',
				essenceCost.RarityEssenceQty, rarName, haveRar)
		end
		return true, ''
	end

	local ok, reason = EnchantShared.CanApplyEnchant(data, uuid, enchantId, level, canPay)
	if not ok then
		warn(string.format('[EnchantServer] apply rejected: %s', reason))
		return false
	end

	-- Build / refresh the enchant entry on the stack.
	stack.Composition = stack.Composition or {}
	if not stack.Composition.Enchants then
		stack.Composition.Enchants = CompositionalConfig.MakeEmptyEnchants()
	end
	-- Already-enchanted block in EnchantShared means this list is
	-- empty when we reach here; append unconditionally.
	table.insert(stack.Composition.Enchants.Entries,
		{ Id = enchantId, Level = level, AppliedAt = os.time() })

	-- Cost consumption. Scroll path consumes a charge; essence path
	-- decrements the two essence stacks.
	if scrollUuid then
		Inventory.ConsumeEnchantScroll(player, scrollUuid)
	else
		Inventory.ConsumeItemQuantity(player, 'EnchantEssence', essenceCost.EnchantEssenceQty)
		Inventory.ConsumeItemQuantity(player,
			essenceCost.RarityEssenceItemId, essenceCost.RarityEssenceQty)
	end

	-- Enchanting school XP. Tier-scaled so a mythic apply rewards
	-- significantly more than a common one — same shape as Smithing's
	-- per-commit XP grant.
	local xp = (EnchantsConfig.TierEnum[EnchantsConfig.Enchants[enchantId].Tier] or 1) * 12
	local Crafting = SystemsContainer.CraftingServer
	if Crafting and Crafting.AddArtisanXP then
		Crafting.AddArtisanXP(player, 'Enchanting', xp)
	end

	-- Stat hook: every successful enchant apply counts as one. Tracks
	-- the apply event, not the cumulative tier — UI shows "234 enchants
	-- applied" rather than per-id breakdown (per-id would explode the
	-- map cardinality with no meaningful display payoff).
	if SystemsContainer.StatisticsServer then
		SystemsContainer.StatisticsServer.Increment(player,
			StatisticsConfig.StatisticIds.EnchantmentsApplied, 1)
	end

	if SystemsContainer.ToastServer and SystemsContainer.ToastServer.NotifyEnchantApplied then
		SystemsContainer.ToastServer.NotifyEnchantApplied(player, enchantId, level)
	end
	return true
end

----------------------------------------------------------------------
-- AttemptSalvageEnchant — strips every enchant from an item and rolls
-- a refund of essences. Always returns 1 EnchantEssence per stripped
-- enchant; rarity-essence drop chance scales with tier (Common 25%,
-- Uncommon 35%, Rare 50%, Epic 65%, Mythic 80%).
----------------------------------------------------------------------
local SALVAGE_RARITY_CHANCE = {
	common = 0.25, uncommon = 0.35, rare = 0.50, epic = 0.65, mythic = 0.80,
}

function Module.AttemptSalvageEnchant(player: Player, uuid: string): boolean
	local data = getSave(player); if not data then return false end
	local Inventory = SystemsContainer.PlayerInventoryServer
	if not Inventory then return false end
	local stack = Inventory.GetItemStackFromUUID(player, uuid)
	if not stack then return false end
	local entries = EnchantShared.GetEnchantsOnItem(stack)
	if #entries == 0 then return false end

	-- Salvage walks every enchant entry and refunds per-tier. The target
	-- weapon's effective rarity drives the *rarity essence* refund pool,
	-- but the chance roll is per-tier of the stripped enchant — a mythic
	-- enchant on a common weapon still has high salvage value.
	local _stack, itemId = Inventory.GetItemStackFromUUID(player, uuid)
	local itemConfig = itemId and ItemsConfig.Items[itemId]
	local effRarity = ItemsConfig.GetEffectiveRarity(itemConfig, stack)
	local rarityEssenceItem = EnchantShared.GetEssenceCost(effRarity).RarityEssenceItemId

	local enchantEssenceRefund = 0
	local rarityEssenceRefund  = 0
	for _, entry in entries do
		enchantEssenceRefund += 1
		local cfg = EnchantsConfig.Enchants[entry.Id]
		local chance = (cfg and SALVAGE_RARITY_CHANCE[cfg.Tier]) or 0.25
		if math.random() < chance then
			rarityEssenceRefund += 1
		end
	end

	-- Strip the enchant composition from the stack.
	if stack.Composition then
		stack.Composition.Enchants = nil
	end

	-- Hand back the refunds via the standard inventory grant (which
	-- already toasts items received).
	if enchantEssenceRefund > 0 then
		Inventory.GiveQuantityOfItemIdToPlayer(player, 'EnchantEssence', enchantEssenceRefund)
	end
	if rarityEssenceRefund > 0 then
		Inventory.GiveQuantityOfItemIdToPlayer(player, rarityEssenceItem, rarityEssenceRefund)
	end

	if SystemsContainer.ToastServer and SystemsContainer.ToastServer.NotifyGeneric then
		SystemsContainer.ToastServer.NotifyGeneric(player,
			'Salvage', string.format('+%d Enchant Essence, +%d rarity essence',
				enchantEssenceRefund, rarityEssenceRefund))
	end
	return true
end

----------------------------------------------------------------------
-- AttemptRemoveEnchant — strips an enchant entry. v1: no refund.
-- Kept for cmdr / admin flows; gameplay path is AttemptSalvageEnchant.
----------------------------------------------------------------------
function Module.AttemptRemoveEnchant(player: Player, uuid: string, enchantId: string): boolean
	local data = getSave(player); if not data then return false end
	local Inventory = SystemsContainer.PlayerInventoryServer
	local stack = Inventory and Inventory.GetItemStackFromUUID(player, uuid)
	if not stack then return false end
	local _, idx = EnchantShared.FindEntryOnItem(stack, enchantId)
	if not idx then return false end
	table.remove(stack.Composition.Enchants.Entries, idx)
	return true
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
-- Single gate point — every enchant action goes through this remote
-- dispatcher, so checking once here covers the player surface area.
local function checkGate(player: Player): boolean
	local data = SystemsContainer.SavesManagerServer
		and SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not data then return false end
	local globalBypass = SystemsContainer.LevelGatesServer
		and SystemsContainer.LevelGatesServer.GetGlobalBypass()
	if LevelGates.CanUseSystem(data, LevelGates.Systems.Enchant, globalBypass) then return true end
	if SystemsContainer.ToastServer and SystemsContainer.ToastServer.NotifyGeneric then
		SystemsContainer.ToastServer.NotifyGeneric(player,
			LevelGates.FormatGateMessage(LevelGates.Systems.Enchant))
	end
	return false
end

function Module.Start()
	EnchantEvent.OnServerEvent:Connect(function(player, action, ...)
		if typeof(action) ~= 'string' then return end
		if not checkGate(player) then return end
		if action == EnchantShared.EnchantActions.TryApply then
			local uuid, enchantId, level, scrollUuid = ...
			Module.AttemptApplyEnchant(player, uuid, enchantId, level, scrollUuid)
		elseif action == EnchantShared.EnchantActions.TrySalvage then
			local uuid = ...
			Module.AttemptSalvageEnchant(player, uuid)
		elseif action == EnchantShared.EnchantActions.TryRemove then
			local uuid, enchantId = ...
			Module.AttemptRemoveEnchant(player, uuid, enchantId)
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/GemSocketServer"><![CDATA[-- GemSocketServer — server authority for the gem-socketing workstation.
-- See ARTISAN.md §8.

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

local GemSocketShared = ReplicatedModules.Services.GemSocketShared
local CompositionalConfig = ReplicatedModules.Data.Compositional
local ItemsConfig = ServerModules.Data.Items
local LevelGates = ReplicatedModules.Data.LevelGates
local GemsConfig = ReplicatedModules.Data.Gems
local RemoteService = ReplicatedModules.Services.RemoteService

local GemSocketEvent = RemoteService.GetRemote('GemSocketEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

local function getSave(player: Player): any?
	local Saves = SystemsContainer.SavesManagerServer
	return Saves and Saves.GetPlayerSelectedSaveData(player)
end

local function ensureSocketedTable(saveData: any)
	if typeof(saveData.SocketedGems) ~= 'table' then saveData.SocketedGems = {} end
end

----------------------------------------------------------------------
-- Build a gem-config lookup closure for a player. Used by
-- GemSocketShared.RefreshResonance which needs uuid → Gem catalog
-- entry. Closes over the live save data.
----------------------------------------------------------------------
local function makeGemLookup(saveData)
	return function(gemUuid: string)
		local stack, gemItemId = ItemsConfig.FindInventoryItemOfUUID(saveData.Inventory or {}, gemUuid)
		if not stack or not gemItemId then return nil end
		local cfg = ItemsConfig.Items[gemItemId]
		local meta = ItemsConfig.GetGem(cfg)
		if not meta then return nil end
		return GemsConfig.Gems[meta.Id]
	end
end

----------------------------------------------------------------------
-- Lazy initializer: socketing struct on the target stack. Created on
-- first set-attempt against a socketable item; uses the item's
-- EquipmentData.Sockets list to seed slot colors.
----------------------------------------------------------------------
local function ensureSocketingOnStack(stack, itemConfig)
	if stack.Composition and stack.Composition.Socketing then return end
	stack.Composition = stack.Composition or {}
	local colors = GemSocketShared.GetSocketColors(itemConfig)
	if #colors == 0 then return end
	stack.Composition.Socketing = CompositionalConfig.MakeEmptySocketing(colors)
end

----------------------------------------------------------------------
-- AttemptSetGem — slot a gem into a socket index.
----------------------------------------------------------------------
function Module.AttemptSetGem(player: Player, itemUuid: string, slotIndex: number, gemUuid: string): boolean
	local data = getSave(player); if not data then return false end
	ensureSocketedTable(data)
	local Inventory = SystemsContainer.PlayerInventoryServer

	local function isSocketed(uuid)
		return Inventory and Inventory.IsGemSocketedSomewhere(player, uuid) or false, nil
	end
	local ok, reason = GemSocketShared.CanSetGem(data, itemUuid, slotIndex, gemUuid, isSocketed)
	if not ok then
		warn(string.format('[GemSocketServer] set rejected: %s', reason))
		return false
	end

	local stack, itemId = Inventory.GetItemStackFromUUID(player, itemUuid)
	if not stack or not itemId then return false end
	local itemConfig = ItemsConfig.Items[itemId]
	ensureSocketingOnStack(stack, itemConfig)
	if not stack.Composition or not stack.Composition.Socketing then return false end

	-- If the slot was already filled, free the previous gem.
	local prev = stack.Composition.Socketing.Slots[slotIndex].GemUuid
	if prev then
		data.SocketedGems[prev] = nil
	end
	stack.Composition.Socketing.Slots[slotIndex].GemUuid = gemUuid
	data.SocketedGems[gemUuid] = itemUuid

	-- Refresh resonance via the shared helper. Closure captures saveData.
	GemSocketShared.RefreshResonance(stack, makeGemLookup(data))

	-- Gemcutting school XP. Tier-scaled by the gem's rarity so socketing
	-- a mythic gem rewards more than a common one.
	local gemMeta = ItemsConfig.GetGem(ItemsConfig.Items[
		select(2, Inventory.GetItemStackFromUUID(player, gemUuid))
	])
	local gemCfg = gemMeta and GemsConfig.Gems[gemMeta.Id]
	local rarityScalar = ({
		common=1, uncommon=2, rare=4, epic=8, mythic=14,
	})[gemCfg and gemCfg.Rarity or 'common'] or 1
	local Crafting = SystemsContainer.CraftingServer
	if Crafting and Crafting.AddArtisanXP then
		Crafting.AddArtisanXP(player, 'Gemcutting', rarityScalar * 4)
	end

	return true
end

----------------------------------------------------------------------
-- Internal — clear a slot. Both Smash and Unsocket flows route through
-- this after they've decided what to do with the freed gem (destroy
-- vs keep). `restoreGem = true` leaves the gem in inventory; false
-- additionally deletes the gem item via the inventory helper.
----------------------------------------------------------------------
local function clearSlot(player: Player, data: any, stack: any, slotIndex: number, restoreGem: boolean): (boolean, string?)
	if not stack or not stack.Composition or not stack.Composition.Socketing then
		return false, 'Item has no socket composition.'
	end
	local slot = stack.Composition.Socketing.Slots[slotIndex]
	if not slot or not slot.GemUuid then return false, 'Slot is empty.' end
	local gemUuid = slot.GemUuid
	data.SocketedGems[gemUuid] = nil
	slot.GemUuid = nil
	GemSocketShared.RefreshResonance(stack, makeGemLookup(data))
	if not restoreGem then
		-- Smash: destroy the gem stack. The gem item is one-uuid-per-stack
		-- (MaxQuantity = 99 on the Items.luau side, but each socketed gem
		-- carries its own uuid), so the helper deletes the entire stack.
		local Inventory = SystemsContainer.PlayerInventoryServer
		if Inventory and Inventory.AttemptPlayerDeleteItemOfUUID then
			Inventory.AttemptPlayerDeleteItemOfUUID(player, gemUuid)
		end
	end
	return true, nil
end

----------------------------------------------------------------------
-- AttemptUnsocketGem — pulls a gem out of a socket and refunds it to
-- the player's inventory. Costs 1 GemEssence; refuses when the player
-- doesn't have one.
----------------------------------------------------------------------
function Module.AttemptUnsocketGem(player: Player, itemUuid: string, slotIndex: number): boolean
	local data = getSave(player); if not data then return false end
	ensureSocketedTable(data)
	local Inventory = SystemsContainer.PlayerInventoryServer
	if not Inventory then return false end
	local stack = Inventory.GetItemStackFromUUID(player, itemUuid)
	if not stack then return false end
	-- Essence pre-check.
	if Inventory.GetItemQuantity(player, 'GemEssence') < 1 then
		warn('[GemSocketServer] unsocket rejected: need 1 Gem Essence')
		return false
	end
	local ok, reason = clearSlot(player, data, stack, slotIndex, true)
	if not ok then warn(string.format('[GemSocketServer] unsocket: %s', reason)); return false end
	-- Burn the essence after the slot clear succeeds.
	Inventory.ConsumeItemQuantity(player, 'GemEssence', 1)
	return true
end

----------------------------------------------------------------------
-- AttemptSmashGem — destructively clears the socket. The gem is gone
-- (no inventory refund). No essence cost.
----------------------------------------------------------------------
function Module.AttemptSmashGem(player: Player, itemUuid: string, slotIndex: number): boolean
	local data = getSave(player); if not data then return false end
	ensureSocketedTable(data)
	local Inventory = SystemsContainer.PlayerInventoryServer
	local stack = Inventory and Inventory.GetItemStackFromUUID(player, itemUuid)
	if not stack then return false end
	local ok, reason = clearSlot(player, data, stack, slotIndex, false)
	if not ok then warn(string.format('[GemSocketServer] smash: %s', reason)); return false end
	return true
end

----------------------------------------------------------------------
-- AttemptRemoveGem — back-compat. Defaults to the Smash flow (the
-- original v1 behaviour: remove + drop the gem reference). Cmdr or
-- legacy UI keeps working; new UI should call AttemptUnsocketGem
-- (essence) or AttemptSmashGem (free, destroys gem) explicitly.
----------------------------------------------------------------------
function Module.AttemptRemoveGem(player: Player, itemUuid: string, slotIndex: number): boolean
	return Module.AttemptSmashGem(player, itemUuid, slotIndex)
end

----------------------------------------------------------------------
-- AttemptUnsocketAll — clear every slot on an item (respec / disenchant).
----------------------------------------------------------------------
function Module.AttemptUnsocketAll(player: Player, itemUuid: string): boolean
	local data = getSave(player); if not data then return false end
	ensureSocketedTable(data)
	local Inventory = SystemsContainer.PlayerInventoryServer
	local stack = Inventory and Inventory.GetItemStackFromUUID(player, itemUuid)
	if not stack or not stack.Composition or not stack.Composition.Socketing then return false end
	for _, slot in stack.Composition.Socketing.Slots do
		if slot.GemUuid then
			data.SocketedGems[slot.GemUuid] = nil
			slot.GemUuid = nil
		end
	end
	GemSocketShared.RefreshResonance(stack, makeGemLookup(data))
	return true
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
-- Single gate point for every gem-socket action. The remote dispatcher
-- below short-circuits when it returns false; AttemptSetGem etc. could
-- be called directly by future internal callers, but every player-
-- initiated path must come through this remote, so gating here covers
-- the player surface area without sprinkling the same check across
-- five Attempt functions.
local function checkGate(player: Player): boolean
	local data = SystemsContainer.SavesManagerServer
		and SystemsContainer.SavesManagerServer.GetPlayerSelectedSaveData(player)
	if not data then return false end
	local globalBypass = SystemsContainer.LevelGatesServer
		and SystemsContainer.LevelGatesServer.GetGlobalBypass()
	if LevelGates.CanUseSystem(data, LevelGates.Systems.Gems, globalBypass) then return true end
	if SystemsContainer.ToastServer and SystemsContainer.ToastServer.NotifyGeneric then
		SystemsContainer.ToastServer.NotifyGeneric(player,
			LevelGates.FormatGateMessage(LevelGates.Systems.Gems))
	end
	return false
end

function Module.Start()
	GemSocketEvent.OnServerEvent:Connect(function(player, action, ...)
		if typeof(action) ~= 'string' then return end
		if not checkGate(player) then return end
		if action == GemSocketShared.GemSocketActions.TrySet then
			local itemUuid, slotIndex, gemUuid = ...
			Module.AttemptSetGem(player, itemUuid, slotIndex, gemUuid)
		elseif action == GemSocketShared.GemSocketActions.TrySmash then
			-- Free; destroys the gem.
			local itemUuid, slotIndex = ...
			Module.AttemptSmashGem(player, itemUuid, slotIndex)
		elseif action == GemSocketShared.GemSocketActions.TryUnsocket then
			-- 1 Gem Essence; refunds the gem.
			local itemUuid, slotIndex = ...
			Module.AttemptUnsocketGem(player, itemUuid, slotIndex)
		elseif action == GemSocketShared.GemSocketActions.TryRemove then
			-- Back-compat alias of TrySmash.
			local itemUuid, slotIndex = ...
			Module.AttemptRemoveGem(player, itemUuid, slotIndex)
		elseif action == GemSocketShared.GemSocketActions.TryUnsocketAll then
			local itemUuid = ...
			Module.AttemptUnsocketAll(player, itemUuid)
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/DialogueNPCServer"><![CDATA[-- DialogueNPCServer — tag-driven dialogue NPCs.
--
-- Setup workflow (Studio):
--   1. Place a humanoid character / dummy model under workspace.
--   2. Tag it 'DialogueNPC' via CollectionService.
--   3. Set Attribute 'DialogueId' to a key from Data/Dialogue.luau
--      (e.g. 'TestNPC_Greeting').
--   4. (Optional) Set 'PromptText' to override the default 'Talk'.
--
-- This module discovers every tagged model on Start and re-discovers
-- them as new tags are added at runtime. Per NPC it attaches a
-- ProximityPrompt to the HumanoidRootPart; on Triggered it fires the
-- StartDialogue cue to the triggering player via CinematicServer.
--
-- The model owns its own dialogue id — no central registry. Authors
-- add NPCs by dropping models in Studio, no code change needed.

local CollectionService = game:GetService('CollectionService')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CinematicShared = ReplicatedModules.Services.CinematicShared
local DialogueData    = ReplicatedModules.Data.Dialogue

local NPC_TAG = 'DialogueNPC'

-- Per-instance cleanup. Keyed by the tagged model so a tag-removed
-- (or model destroyed) NPC has its prompt + listener disposed cleanly.
local NPCMaids: { [Instance]: { Cleanup: () -> () } } = {}

-- SystemsContainer is wired via Init; CinematicServer is the single
-- dependency we need at runtime.
local SystemsContainer = {}

local Module = {}

-- Build a thin "maid" without pulling in the Maid library — these
-- NPCs only need to disconnect one connection and destroy one prompt
-- at teardown, so an ad-hoc cleanup table is enough.
local function newMaid()
	local items: { any } = {}
	return {
		Give = function(item)
			items[#items + 1] = item
		end,
		Cleanup = function()
			for _, item in items do
				if typeof(item) == 'RBXScriptConnection' then
					item:Disconnect()
				elseif typeof(item) == 'Instance' then
					item:Destroy()
				elseif typeof(item) == 'function' then
					item()
				end
			end
			table.clear(items)
		end,
	}
end

-- Resolve the model's HumanoidRootPart, waiting briefly so a model
-- that streams in slightly after the tag attaches still finds it.
local function findHRP(model: Model): BasePart?
	local hrp = model:FindFirstChild('HumanoidRootPart')
	if hrp and hrp:IsA('BasePart') then return hrp end
	-- Best-effort wait: most rigs replicate within a tick or two.
	-- A 5s timeout keeps a misconfigured model from hanging the
	-- per-NPC bringup forever.
	hrp = model:WaitForChild('HumanoidRootPart', 5) :: any
	return hrp and hrp:IsA('BasePart') and hrp or nil
end

-- Compute a stable instance path for the StartDialogue cue. The
-- cinematic resolves paths via CinematicShared.ResolveInstancePath
-- which expects 'workspace.<...>.HumanoidRootPart' — model:GetFullName()
-- returns the same shape (workspace prefix + dotted ancestry).
local function instancePathForHRP(hrp: BasePart): string
	return hrp:GetFullName()
end

local function setupNPC(model: Instance)
	if not model:IsA('Model') then return end
	if NPCMaids[model] then return end  -- already set up

	local dialogueId = model:GetAttribute('DialogueId')
	if typeof(dialogueId) ~= 'string' or dialogueId == '' then
		warn(string.format(
			'DialogueNPCServer: %s tagged %q but missing string Attribute DialogueId',
			model:GetFullName(), NPC_TAG))
		return
	end

	-- Validate the dialogue id at setup so a typo is loud-failed
	-- *before* the player walks up. The dialogue widget warns again
	-- on open (which is a defensive backstop), but failing here keeps
	-- the studio iteration loop tight.
	if not DialogueData.GetDialogueFromId(dialogueId) then
		warn(string.format(
			'DialogueNPCServer: %s references unknown DialogueId %q',
			model:GetFullName(), tostring(dialogueId)))
		-- Still attach the prompt — designers may add the dialogue
		-- entry next; the widget's runtime warn handles the runtime
		-- case if the entry stays missing.
	end

	local hrp = findHRP(model)
	if not hrp then
		warn(string.format('DialogueNPCServer: %s has no HumanoidRootPart', model:GetFullName()))
		return
	end

	local maid = newMaid()
	NPCMaids[model] = maid

	-- ProximityPrompt setup. Hold-style is intentional — taps don't
	-- accidentally trigger during combat. Range tuned to roughly two
	-- character-widths so the player sees the prompt from across a
	-- room but doesn't open dialogue mid-walk-by.
	local prompt = Instance.new('ProximityPrompt')
	prompt.ActionText  = (model:GetAttribute('PromptText') :: string?) or 'Talk'
	prompt.ObjectText  = (model:GetAttribute('PromptObjectText') :: string?) or model.Name
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = (model:GetAttribute('PromptDistance') :: number?) or 8
	prompt.RequiresLineOfSight = false  -- avoid corner-edge prompt flicker
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.Parent = hrp
	maid.Give(prompt)

	maid.Give(prompt.Triggered:Connect(function(player: Player)
		local CinematicServer = SystemsContainer.CinematicServer
		if not CinematicServer or not CinematicServer.FireCueForPlayer then
			warn('DialogueNPCServer: CinematicServer missing — cannot open dialogue')
			return
		end
		-- Fire a single StartDialogue cue. The client dispatcher
		-- (CinematicClient.DispatchTable.StartDialogue) routes this
		-- to DialogueWidget.RequestStart with the live id.
		CinematicServer.FireCueForPlayer(player,
			CinematicShared.CueKind.StartDialogue, {
				DialogueId      = dialogueId,
				NPCInstancePath = instancePathForHRP(hrp),
			})
	end))

	-- Despawn cleanup — model removed from the data model invalidates
	-- everything attached to it. Fires before the model gets GC'd so
	-- our prompt + connection are torn down cleanly.
	maid.Give(model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(workspace) then
			Module.TeardownNPC(model)
		end
	end))
end

function Module.TeardownNPC(model: Instance)
	local maid = NPCMaids[model]
	if not maid then return end
	maid.Cleanup()
	NPCMaids[model] = nil
end

-- Convenience for tests: explicitly fire the StartDialogue cue against
-- a player + dialogue id without needing a tagged NPC. Used by Cmdr
-- /dialogue and the test widget when there's no tagged NPC in scene.
function Module.OpenDialogueForPlayer(player: Player, dialogueId: string, npcInstancePath: string?)
	local CinematicServer = SystemsContainer.CinematicServer
	if not CinematicServer or not CinematicServer.FireCueForPlayer then
		warn('DialogueNPCServer: CinematicServer missing — cannot open dialogue')
		return
	end
	CinematicServer.FireCueForPlayer(player,
		CinematicShared.CueKind.StartDialogue, {
			DialogueId      = dialogueId,
			NPCInstancePath = npcInstancePath,
		})
end

function Module.Start()
	-- Initial sweep — pick up models that were tagged before the
	-- server reached this Start call (the standard case for static
	-- studio-placed NPCs).
	for _, inst in CollectionService:GetTagged(NPC_TAG) do
		setupNPC(inst)
	end

	-- Live-tag changes. Adding the tag at runtime spins up the
	-- prompt; removing it tears it back down. Lets designers iterate
	-- in studio without restarting the server.
	CollectionService:GetInstanceAddedSignal(NPC_TAG):Connect(setupNPC)
	CollectionService:GetInstanceRemovedSignal(NPC_TAG):Connect(Module.TeardownNPC)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/CinematicTestServer"><![CDATA[-- CinematicTestServer — admin/studio-only entry points for the
-- CinematicTestWidget (and the /cin /dialogue Cmdr commands). Lives
-- in ServerStorage/Core so the framework's Init/Start cycle picks it
-- up; clients never see it directly.
--
-- The remote it exposes (`CinematicTestEvent`) is gated:
--   * Studio always allowed (so the F4 widget works in playtest).
--   * Live: only players whose UserId is in ADMIN_USER_IDS pass.
--
-- Responsibilities:
--   * Run a chosen cinematic id on the calling player.
--   * Open a chosen dialogue id on the calling player.
-- Single-cue camera/shake/vfx tests don't need a remote — the client
-- widget dispatches those directly via CinematicClient.PlayCue.

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local RemoteService = ReplicatedModules.Services.RemoteService
local CinematicTestShared = ReplicatedModules.Services.CinematicTestShared

local CinematicTestEvent = RemoteService.GetRemote('CinematicTestEvent', 'RemoteEvent', false)

-- Auth allowlist. Empty by default — studio is always permitted, so
-- the widget is testable in playtest without configuration. Add live-
-- environment user ids here as project ownership solidifies.
local ADMIN_USER_IDS: { [number]: boolean } = {
	-- [123456789] = true,
}

-- Action enum for the remote — single source of truth in
-- Services.CinematicTestShared (the F4 widget references the same dict).
local Actions = CinematicTestShared.Actions

local SystemsContainer = {}

local Module = {}
Module.Actions = Actions

-- Auth: Studio always passes, the place creator (User-owned games)
-- always passes, hardcoded admin UserIds always pass. The previous
-- gate failed silently in published live tests because ADMIN_USER_IDS
-- was empty — the widget rendered (client-side, no gate) but clicks
-- died at FireServer with a server warn. Adding the place-creator
-- check covers the common solo-dev case without requiring the dev
-- to look up + paste their own UserId.
local function isAuthorized(player: Player): boolean
	if RunService:IsStudio() then return true end
	if game.CreatorType == Enum.CreatorType.User
		and player.UserId == game.CreatorId then
		return true
	end
	return ADMIN_USER_IDS[player.UserId] == true
end

function Module.Start()
	CinematicTestEvent.OnServerEvent:Connect(function(player: Player, action: number, id: string)
		if not isAuthorized(player) then
			-- Loud refuse on the server; client gets nothing back so a
			-- non-admin player can't probe the action surface.
			warn(string.format(
				'CinematicTestServer: refused %s(%d) action=%s id=%q (not authorized; ' ..
				'set ADMIN_USER_IDS or run in Studio)',
				player.Name, player.UserId, tostring(action), tostring(id)))
			return
		end

		if typeof(id) ~= 'string' or id == '' then
			warn(string.format(
				'CinematicTestServer: invalid id=%q from %s', tostring(id), player.Name))
			return
		end

		if action == Actions.PlayCinematic then
			local CinematicServer = SystemsContainer.CinematicServer
			if not CinematicServer then
				warn('CinematicTestServer: CinematicServer missing from SystemsContainer')
				return
			end
			if not CinematicServer.PlayForPlayer then
				warn('CinematicTestServer: CinematicServer.PlayForPlayer missing')
				return
			end
			-- PlayForPlayer warns internally on unknown cinematic id; we
			-- still log here so the dev can correlate the click with the
			-- attempt without grepping two log lines.
			print(string.format('CinematicTestServer: play cinematic id=%q for %s',
				id, player.Name))
			CinematicServer.PlayForPlayer(player, id)
		elseif action == Actions.OpenDialogue then
			local DialogueNPCServer = SystemsContainer.DialogueNPCServer
			if not DialogueNPCServer then
				warn('CinematicTestServer: DialogueNPCServer missing from SystemsContainer')
				return
			end
			if not DialogueNPCServer.OpenDialogueForPlayer then
				warn('CinematicTestServer: DialogueNPCServer.OpenDialogueForPlayer missing')
				return
			end
			print(string.format('CinematicTestServer: open dialogue id=%q for %s',
				id, player.Name))
			DialogueNPCServer.OpenDialogueForPlayer(player, id)
		elseif action == Actions.RunRecipe then
			local Runtime = SystemsContainer.SkillRuntimeServer
			local character = player.Character
			if not Runtime or not Runtime.RunRecipe or not character then
				warn('CinematicTestServer: SkillRuntimeServer / character missing for RunRecipe')
				return
			end
			local caster = Runtime.CasterFromModel(character, player)
			if not caster then return end
			task.spawn(function() Runtime.RunRecipe(caster, id) end)
			print(string.format("CinematicTestServer: run recipe %q for %s", id, player.Name))

		elseif action == Actions.TestTelegraph then
			local Telegraph = SystemsContainer.EnemyTelegraphServer
			local character = player.Character
			if not Telegraph or not Telegraph.Show or not character then
				warn('CinematicTestServer: EnemyTelegraphServer / character missing for TestTelegraph')
				return
			end
			local kind = string.lower(id)
			local payload: any
			local duration = 1.0
			if kind == 'circle' then
				payload = { Kind='Circle', Origin=character:GetPivot(), Radius=8, Duration=duration }
			elseif kind == 'rect' then
				payload = { Kind='Rect',   Origin=character:GetPivot(),
				            Size=Vector3.new(6, 0, 18), Duration=duration }
			elseif kind == 'cone' then
				payload = { Kind='Cone',   Origin=character:GetPivot(),
				            Radius=12, Angle=math.pi*0.4, Duration=duration }
			else
				return
			end
			local tid = Telegraph.Show(payload)
			task.delay(duration + 0.05, function() Telegraph.Hide(tid) end)
			print(string.format("CinematicTestServer: telegraph %s for %s", kind, player.Name))

		elseif action == Actions.SpawnMob then
			-- Reuse the SpawnMob cmdr server's logic by building a
			-- minimal context. Fall through to a local impl rather
			-- than requiring the cmdr handler (avoids a cross-tree
			-- require with cmdr internals).
			local CollectionService = game:GetService('CollectionService')
			-- ServerStorage was referenced here without ever being
			-- resolved, so this branch raised "attempt to index nil" the
			-- first time the SpawnMob test action ran.
			local ServerStorage = game:GetService('ServerStorage')
			local templates = ServerStorage:FindFirstChild('EnemyTemplates')
			local template: Model? = nil
			if templates then
				for _, child in templates:GetChildren() do
					if child:IsA('Model') and (child.Name == id or child:GetAttribute('AIClass') == id) then
						template = child
						break
					end
				end
			end
			if not template then
				for _, model in CollectionService:GetTagged('AICharacter') do
					if model:IsA('Model') and model:GetAttribute('AIClass') == id then
						template = model
						break
					end
				end
			end
			if not template then
				warn(string.format("CinematicTestServer: no template for mob '%s'", id))
				return
			end
			local character = player.Character
			local hrp = character and character:FindFirstChild('HumanoidRootPart')
			if not hrp then return end
			template.Archivable = true
			local clone = template:Clone()
			template.Archivable = false
			clone:PivotTo(hrp.CFrame * CFrame.new(0, 0, -10))
			if not clone:HasTag('AICharacter') then clone:AddTag('AICharacter') end
			clone.Parent = workspace
			print(string.format("CinematicTestServer: spawned %s for %s", id, player.Name))

		elseif action == Actions.SetBossPhase then
			local BossServer = SystemsContainer.BossServer
			if not BossServer or not BossServer.ForceSetPhase then
				warn('CinematicTestServer: BossServer missing for SetBossPhase')
				return
			end
			local idx = math.floor(tonumber(id) or 1)
			for _, model in BossServer.GetActiveBossModels() do
				BossServer.ForceSetPhase(model, idx)
			end
			print(string.format("CinematicTestServer: forced phase %d on all bosses", idx))

		else
			warn(string.format(
				'CinematicTestServer: unknown action=%s from %s', tostring(action), player.Name))
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/PremiumServer"><![CDATA[-- PremiumServer — gamepass ownership cache + per-benefit accessors.
-- Wraps MarketplaceService:UserOwnsGamePassAsync (network call → can
-- yield, can fail) so callers get a synchronous-shaped API backed by
-- a cache populated on player join.
--
-- The cache is keyed by (player, gamepassId). On PlayerAdded we
-- resolve every gamepass id from PremiumConfig.GAMEPASSES and stash
-- the result. Subsequent gameplay reads (equip, UI render) hit the
-- cache; misses fall back to a synchronous re-query so a late join /
-- gamepass purchased mid-session still works.
--
-- Runtime gamepass purchase:
--   MarketplaceService.PromptGamePassPurchaseFinished fires when a
--   player completes a purchase. We re-prime the cache + fire a
--   replicated entry so the client UI updates without a respawn.

local MarketplaceService = game:GetService('MarketplaceService')
local Players            = game:GetService('Players')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local PremiumConfig  = ReplicatedModules.Data.PremiumConfig

local SystemsContainer = {}

local Module = {}

-- (player, gamepassId) → boolean. nil = "not yet resolved" so callers
-- can distinguish "definitely don't own" from "haven't asked".
local Cache: { [Player]: { [number]: boolean } } = {}

----------------------------------------------------------------------
-- Internal: query the network ONCE per (player, gamepassId), with a
-- pcall so an outage doesn't crash the bind point. Default false on
-- error — fail-safe (don't grant gamepass benefits when we can't
-- confirm ownership).
----------------------------------------------------------------------
local function queryOwnership(player: Player, gamepassId: number): boolean
	if gamepassId == 0 then return false end  -- placeholder id
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, gamepassId)
	end)
	if not ok then
		warn(string.format('PremiumServer: UserOwnsGamePassAsync failed for %s/%d: %s',
			player.Name, gamepassId, tostring(owns)))
		return false
	end
	return owns == true
end

----------------------------------------------------------------------
-- Public — synchronous read against the cache, with a one-time
-- network fallback for cache misses.
----------------------------------------------------------------------
function Module.HasGamepass(player: Player, gamepassId: number): boolean
	if not player or not player.Parent then return false end
	local byPass = Cache[player]
	if byPass and byPass[gamepassId] ~= nil then
		return byPass[gamepassId]
	end
	-- Cache miss — resolve now + stash. Callers that don't want the
	-- (potentially yielding) network call should run RefreshFor on
	-- PlayerAdded; the production path always hits the cache.
	local owns = queryOwnership(player, gamepassId)
	Cache[player] = Cache[player] or {}
	Cache[player][gamepassId] = owns
	return owns
end

function Module.GetMaxAuraSlots(player: Player): number
	local owns = Module.HasGamepass(player, PremiumConfig.GAMEPASSES.AuraSlots)
	return PremiumConfig.GetMaxAuraSlots(owns)
end

function Module.GetMaxCompanionSlots(player: Player): number
	local owns = Module.HasGamepass(player, PremiumConfig.GAMEPASSES.CompanionSlots)
	return PremiumConfig.GetMaxCompanionSlots(owns)
end

----------------------------------------------------------------------
-- Replication. We surface the booleans the client needs through
-- PlayerData.Premium = { AuraSlotsPass = bool, ... } so widgets can
-- render the gamepass badge without a separate remote round-trip.
----------------------------------------------------------------------
local function refreshPremiumOnSave(player: Player)
	-- Save struct mutation — the gamepass entries live alongside the
	-- regular save fields so the existing ReplicatedData flush picks
	-- them up. Per-key writes only when the resolved value differs
	-- so a slow MarketplaceService doesn't bump the save's diff
	-- timestamp every poll.
	local Saves = SystemsContainer.SavesManagerServer
	if not Saves then return end
	local save = Saves.GetPlayerSelectedSaveData(player)
	if not save then return end
	if typeof(save.Premium) ~= 'table' then save.Premium = {} end
	local prev = save.Premium.AuraSlotsPass
	local current = Module.HasGamepass(player, PremiumConfig.GAMEPASSES.AuraSlots)
	if prev ~= current then
		save.Premium.AuraSlotsPass = current
	end
	-- Same per-key pattern for the CompanionSlots pass so client widgets
	-- can render its badge without a separate round-trip.
	local prevCompanion = save.Premium.CompanionSlotsPass
	local currentCompanion = Module.HasGamepass(player, PremiumConfig.GAMEPASSES.CompanionSlots)
	if prevCompanion ~= currentCompanion then
		save.Premium.CompanionSlotsPass = currentCompanion
	end
end

function Module.RefreshFor(player: Player)
	-- Force-refresh the cache by re-querying every known gamepass.
	Cache[player] = {}
	for _, id in PremiumConfig.GAMEPASSES do
		Cache[player][id] = queryOwnership(player, id)
	end
	refreshPremiumOnSave(player)
end

function Module.Start()
	Players.PlayerAdded:Connect(function(player)
		-- Populate the cache asynchronously so the join handshake
		-- isn't blocked by MarketplaceService latency. The first
		-- aura-equip attempt before the cache lands hits HasGamepass'
		-- on-miss query path — slower for that one call, correct
		-- afterwards.
		task.spawn(Module.RefreshFor, player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		Cache[player] = nil
	end)

	-- Mid-session gamepass purchase. Refresh + replicate so the UI
	-- can update without prompting the player to rejoin.
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, _gamepassId, wasPurchased)
		if wasPurchased then
			Module.RefreshFor(player)
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/ConsumptionServer"><![CDATA[-- ConsumptionServer — server-side "use this item" dispatcher.
--
-- Listens on ItemUseEvent (uuid → consume one). Resolves the item
-- config, picks a handler from the registry by item Type / payload
-- presence, runs the handler, decrements inventory by ConsumeQuantity.
--
-- Handler registry:
--   AttributeScroll  → grants AttributeXPData.Amount XP toward
--                      AttributeXPData.AttributeId via AttributeServer
--   CompanionCandy   → forwards to CompanionsServer.UseCompanionCandy
--                      (kept for API parity even though companions has
--                      its own direct UI button — surfaces consumption
--                      through the same Use flow as everything else)
--   Consumable       → generic ConsumptionData.Effects / Inflicts run;
--                      future hook for HP / MP / buff potions when the
--                      Effects + status systems land. Currently no-ops
--                      the effect table and just decrements inventory.
--
-- New handler? Define a function (player, cfg, uuid) → boolean and
-- register it via Module.RegisterHandler('TypeKey', fn). The Start
-- loop seeds the built-ins.

local Players = game:GetService('Players')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

local ItemsConfig    = ServerModules.Data.Items
local StatisticsConfig = ReplicatedModules.Data.StatisticsConfig
local RemoteService  = ReplicatedModules.Services.RemoteService
local CombatShared   = ReplicatedModules.Services.CombatShared

local ItemUseEvent = RemoteService.GetRemote('ItemUseEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Per-(player, itemId) cooldown ledger. ConsumptionData.Cooldown
-- enforces a minimum delay between same-item uses; without this a
-- spam-clicker bypasses the gameplay rate limit.
----------------------------------------------------------------------
local LastUseAt: { [Player]: { [string]: number } } = {}

local function isOnCooldown(player: Player, itemId: string, cooldown: number): boolean
	if cooldown <= 0 then return false end
	local byItem = LastUseAt[player]
	if not byItem then return false end
	local last = byItem[itemId] or 0
	return (os.clock() - last) < cooldown
end

local function markUsed(player: Player, itemId: string)
	LastUseAt[player] = LastUseAt[player] or {}
	LastUseAt[player][itemId] = os.clock()
end

----------------------------------------------------------------------
-- Inventory mutation helper. Calls into PlayerInventoryServer to
-- decrement the stack by ConsumeQuantity. Returns true on full
-- decrement, false if the inventory didn't carry enough (consumption
-- aborts cleanly without partial state).
----------------------------------------------------------------------
local function consumeFromInventory(player: Player, itemId: string, quantity: number): boolean
	local Inventory = SystemsContainer.PlayerInventoryServer
	if not Inventory then return false end
	-- Reuse the existing helper if present; otherwise walk save struct.
	if typeof(Inventory.AttemptDeleteItemQuantity) == 'function' then
		return Inventory.AttemptDeleteItemQuantity(player, itemId, quantity) == true
	end
	-- Fallback: direct save struct mutation. PlayerInventoryServer
	-- uses Inventory[itemId][uuid] = { Quantity }, so we walk uuids
	-- and burn down the requested amount.
	local Saves = SystemsContainer.SavesManagerServer
	if not Saves then return false end
	local save = Saves.GetPlayerSelectedSaveData(player)
	if not save or typeof(save.Inventory) ~= 'table' then return false end
	local bucket = save.Inventory[itemId]
	if typeof(bucket) ~= 'table' then return false end
	-- Two passes: count first, mutate second so a partial-remove can be
	-- aborted before we touch the struct.
	local total = 0
	for _, stack in bucket do total += (stack.Quantity or 0) end
	if total < quantity then return false end
	local remaining = quantity
	for uuid, stack in bucket do
		if remaining <= 0 then break end
		local take = math.min(remaining, stack.Quantity or 0)
		stack.Quantity -= take
		remaining -= take
		if stack.Quantity <= 0 then bucket[uuid] = nil end
	end
	return true
end

----------------------------------------------------------------------
-- Handler registry.
----------------------------------------------------------------------
type Handler = (player: Player, cfg: any, uuid: string) -> boolean
local Handlers: { [string]: Handler } = {}

function Module.RegisterHandler(typeKey: string, fn: Handler)
	Handlers[typeKey] = fn
end

----------------------------------------------------------------------
-- Built-in handlers. Each runs AFTER the consume gate succeeds (so
-- the inventory decrement happens BEFORE the effect to make a partial
-- drop impossible if the effect itself yields).
----------------------------------------------------------------------
local function handleAttributeScroll(player: Player, cfg: any, _uuid: string): boolean
	local payload = cfg.AttributeXPData
	if not payload or typeof(payload.AttributeId) ~= 'string' or typeof(payload.Amount) ~= 'number' then
		warn('ConsumptionServer.AttributeScroll: malformed AttributeXPData')
		return false
	end
	local AttributeServer = SystemsContainer.AttributeServer
	if not AttributeServer or not AttributeServer.IncrementAttributeExperience then
		warn('ConsumptionServer.AttributeScroll: AttributeServer not available')
		return false
	end
	AttributeServer.IncrementAttributeExperience(player, payload.AttributeId, payload.Amount)
	return true
end

-- Multi-target experience scroll. Walks cfg.ExperienceScrollData.Grants
-- and grants each entry's XP via AttributeServer. Each grant is
-- applied independently so a malformed entry doesn't block the others
-- (defensive: scroll content is author-supplied; one typo shouldn't
-- silently nuke the whole consume).
local function handleExperienceScroll(player: Player, cfg: any, _uuid: string): boolean
	local payload = cfg.ExperienceScrollData
	if typeof(payload) ~= 'table' or typeof(payload.Grants) ~= 'table' then
		warn('ConsumptionServer.ExperienceScroll: malformed ExperienceScrollData')
		return false
	end
	local AttributeServer = SystemsContainer.AttributeServer
	if not AttributeServer or not AttributeServer.IncrementAttributeExperience then
		warn('ConsumptionServer.ExperienceScroll: AttributeServer not available')
		return false
	end
	local granted = 0
	for _, grant in payload.Grants do
		if typeof(grant) == 'table'
			and typeof(grant.AttributeId) == 'string'
			and typeof(grant.Amount) == 'number'
			and grant.Amount > 0
		then
			AttributeServer.IncrementAttributeExperience(player, grant.AttributeId, grant.Amount)
			granted += 1
		end
	end
	-- Treat an empty grants list as failed-consume: refund the inventory
	-- decrement instead of consuming a scroll that did nothing. Authors
	-- should populate Grants; this guard catches misconfigured items.
	return granted > 0
end

local function handleCompanionCandy(player: Player, cfg: any, _uuid: string): boolean
	local Companions = SystemsContainer.CompanionsServer
	if not Companions or not Companions.UseCompanionCandy then return false end
	-- UseCompanionCandy itself decrements the inventory + grants XP, so
	-- we *don't* run the ConsumptionServer's own consume step for this
	-- type. We return false so the outer Use flow skips the decrement
	-- (the candy server already handled it).
	Companions.UseCompanionCandy(player, cfg.Id or _uuid and 'unknown' or 'unknown')
	return false  -- already consumed inside UseCompanionCandy
end

local function handleGenericConsumable(_player: Player, _cfg: any, _uuid: string): boolean
	-- Generic potions / food. Once Effects + status systems land here:
	--   * Walk cfg.ConsumptionData.Effects → apply each (HP, MP, buff)
	--   * Walk cfg.ConsumptionData.Inflicts → roll + apply status
	-- For now, a no-op handler — inventory still decrements via the
	-- outer Use flow so Cooked Meat / Herbal Stew etc. visibly consume.
	return true
end

local function dispatchHandler(player: Player, cfg: any, uuid: string): (boolean, boolean)
	-- Returns (handled, alreadyConsumed). alreadyConsumed=true means
	-- the handler internally decremented the inventory (CompanionCandy
	-- path) and the caller should skip its own decrement.
	-- Multi-attribute scrolls take priority — a hybrid item carrying
	-- both legacy AttributeXPData AND ExperienceScrollData should fire
	-- the multi-grant handler so all listed attributes get XP.
	if cfg.ExperienceScrollData then
		return handleExperienceScroll(player, cfg, uuid), false
	end
	if cfg.AttributeXPData then
		return handleAttributeScroll(player, cfg, uuid), false
	end
	if cfg.CandyData then
		handleCompanionCandy(player, cfg, uuid)
		return true, true  -- companion path consumed internally
	end
	if cfg.Type and Handlers[cfg.Type] then
		return Handlers[cfg.Type](player, cfg, uuid), false
	end
	if cfg.ConsumptionData then
		return handleGenericConsumable(player, cfg, uuid), false
	end
	return false, false
end

----------------------------------------------------------------------
-- Public entry. Wired to the ItemUseEvent remote in Start; also
-- callable by other server modules (e.g. an InventoryTab "use" button
-- that wants to skip the network round-trip and just trigger by uuid).
----------------------------------------------------------------------
function Module.UseItem(player: Player, uuid: string): boolean
	local Inventory = SystemsContainer.PlayerInventoryServer
	if not Inventory then return false end
	local itemId = Inventory.FindItemIdGivenUUID and Inventory.FindItemIdGivenUUID(player, uuid)
	if not itemId then return false end
	local cfg = ItemsConfig.GetConfigFromId(itemId)
	if not cfg then return false end

	-- Stunned / dead / mid-skill characters can't consume — match the
	-- combat predicate so a dodge mid-cast doesn't refill HP for free.
	local character = player.Character
	if character and not CombatShared.IsCharacterAvailable(character) then
		return false
	end

	-- Cooldown gate.
	local cooldown = (cfg.ConsumptionData and cfg.ConsumptionData.Cooldown) or 0
	if isOnCooldown(player, itemId, cooldown) then return false end

	-- Resolve handler + run.
	local cfgWithId = setmetatable({ Id = itemId }, { __index = cfg }) :: any
	local ok, alreadyConsumed = dispatchHandler(player, cfgWithId, uuid)
	if not ok then return false end

	-- Outer consume gate: skip when a handler already decremented
	-- (e.g. CompanionCandy), otherwise pull the requested ConsumeQuantity
	-- from inventory.
	if not alreadyConsumed then
		local qty = (cfg.ConsumptionData and cfg.ConsumptionData.ConsumeQuantity) or 1
		if cfg.ConsumptionData and cfg.ConsumptionData.Consumes == false then
			-- Item explicitly opts out of consumption (e.g. a reusable
			-- charm). Mark cooldown but don't drain the stack.
			markUsed(player, itemId)
			return true
		end
		if not consumeFromInventory(player, itemId, qty) then
			return false  -- inventory underflow; bail without crediting
		end
	end

	markUsed(player, itemId)

	-- Stat hook: per-item-id consumed counter. Counts ONE use event,
	-- regardless of whether the item consumed a stack quantity > 1
	-- (e.g. a 3-charge potion that consumes all 3 on use is still
	-- one "consumed" event from the player's perspective).
	if SystemsContainer.StatisticsServer then
		SystemsContainer.StatisticsServer.IncrementMap(player,
			StatisticsConfig.StatisticIds.ItemsConsumed, itemId, 1)
	end
	return true
end

function Module.Start()
	-- Seed any externally-registered handlers. (Currently the built-ins
	-- are inline in dispatchHandler; the registry exists for future
	-- per-item-type custom handlers.)

	ItemUseEvent.OnServerEvent:Connect(function(player: Player, uuid: any)
		if typeof(uuid) ~= 'string' then return end
		Module.UseItem(player, uuid)
	end)

	Players.PlayerRemoving:Connect(function(player)
		LastUseAt[player] = nil
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/ToolServer"><![CDATA[-- ToolServer — server-side tool-use dispatch. Currently scoped to
-- the pickaxe → harvest-node interaction; the ToolUsage cfg + tag
-- pattern generalizes to other tools (axe → tree, etc.) as needed.
--
-- Workflow:
--   1. Player presses the tool-use input (LMB while holding a Tool
--      with EquipmentData.ToolUsage). Client raycasts forward and
--      fires (uuid, hitInstance) to ToolUseEvent.
--   2. Server validates: equipped tool, hit is a HarvestNode tag, the
--      tool's Damage.Max ≥ the node's MinPower.
--   3. On success, reduces node Health (per-node attribute); when
--      depleted, drops loot via PlayerInventoryServer + tags the node
--      with a respawn timer.
--
-- Authoring a harvest node (Studio):
--   * Place a BasePart or Model in workspace.
--   * Tag it 'HarvestNode' via CollectionService.
--   * Set Attribute('NodeKind', 'wood' | 'stone' | 'iron' | …)
--   * (Optional) Attribute('MaxHealth', number) — default 3.
--   * (Optional) Attribute('MinPower', number) — default 1.
--   * (Optional) Attribute('RespawnSeconds', number) — default 30.
-- Loot per NodeKind comes from NODE_LOOT below; designers extend
-- that table as new node kinds ship.

local CollectionService = game:GetService('CollectionService')
local Players           = game:GetService('Players')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

local ItemsConfig    = ServerModules.Data.Items
local CombatShared   = ReplicatedModules.Services.CombatShared
local RemoteService  = ReplicatedModules.Services.RemoteService

local ToolUseEvent = RemoteService.GetRemote('ToolUseEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

local NODE_TAG = 'HarvestNode'

----------------------------------------------------------------------
-- Per-node-kind loot tables. Each entry is { itemId, min, max } —
-- a roll picks the quantity uniformly. Designers extend this table
-- when new node kinds (silver, mithril, fire-stone, etc.) drop in.
----------------------------------------------------------------------
local NODE_LOOT: { [string]: { { itemId: string, min: number, max: number } } } = {
	wood  = { { itemId = 'WoodLog',     min = 1, max = 3 } },
	stone = { { itemId = 'StoneChunk',  min = 1, max = 2 } },
	iron  = { { itemId = 'IronBar',     min = 1, max = 1 } },
	herb  = { { itemId = 'WildHerb',    min = 1, max = 2 } },
}

-- MinPower per node kind. The pickaxe's ToolUsage.Damage.Max must be
-- >= this value to break the node. Wooden Pickaxe Damage.Max=2 (wood,
-- stone). Iron Pickaxe Damage.Max=4 (everything except future tiers).
local NODE_MIN_POWER: { [string]: number } = {
	wood  = 1,
	stone = 1,
	herb  = 1,
	iron  = 3,
}

local DEFAULT_MAX_HEALTH = 3
local DEFAULT_RESPAWN    = 30

----------------------------------------------------------------------
-- Helpers.
----------------------------------------------------------------------
local function getEquippedTool(player: Player): (string?, any?)
	local Inventory = SystemsContainer.PlayerInventoryServer
	if not Inventory or not Inventory.GetEquippedItems then return nil, nil end
	local equipped = Inventory.GetEquippedItems(player)
	if typeof(equipped) ~= 'table' then
		-- Fallback shape — rummage through save data directly.
		local Saves = SystemsContainer.SavesManagerServer
		if not Saves then return nil, nil end
		local save = Saves.GetPlayerSelectedSaveData(player)
		if not save or typeof(save.Equipped) ~= 'table' then return nil, nil end
		equipped = save.Equipped
	end
	for _, slotData in equipped do
		if typeof(slotData) == 'table' and slotData.uuid and slotData.itemId then
			local cfg = ItemsConfig.GetConfigFromId(slotData.itemId)
			if cfg and cfg.EquipmentData and cfg.EquipmentData.ToolUsage then
				return slotData.itemId, cfg
			end
		end
	end
	return nil, nil
end

local function rollLoot(nodeKind: string): (string?, number)
	local entries = NODE_LOOT[nodeKind]
	if not entries or #entries == 0 then return nil, 0 end
	local pick = entries[math.random(1, #entries)]
	local qty = math.random(pick.min, pick.max)
	return pick.itemId, qty
end

local function dropLoot(player: Player, nodeKind: string)
	local Inventory = SystemsContainer.PlayerInventoryServer
	if not Inventory or not Inventory.GiveQuantityOfItemIdToPlayer then return end
	local itemId, qty = rollLoot(nodeKind)
	if not itemId or qty <= 0 then return end
	Inventory.GiveQuantityOfItemIdToPlayer(player, itemId, qty)
end

----------------------------------------------------------------------
-- Node lifecycle. Each node tracks its own health via attributes so
-- the state replicates without a server-side dictionary. Server-side
-- generation counter on the node prevents a stale respawn from
-- resurrecting a node that's been retagged / destroyed.
----------------------------------------------------------------------
local function ensureNodeAttributes(node: Instance)
	if node:GetAttribute('MaxHealth') == nil then
		node:SetAttribute('MaxHealth', DEFAULT_MAX_HEALTH)
	end
	if node:GetAttribute('Health') == nil then
		node:SetAttribute('Health', node:GetAttribute('MaxHealth') or DEFAULT_MAX_HEALTH)
	end
	if node:GetAttribute('MinPower') == nil then
		local kind = node:GetAttribute('NodeKind')
		if typeof(kind) == 'string' and NODE_MIN_POWER[kind] then
			node:SetAttribute('MinPower', NODE_MIN_POWER[kind])
		else
			node:SetAttribute('MinPower', 1)
		end
	end
end

local function depleteNode(node: Instance)
	-- Visual hint while respawn is pending — mark the node disabled so
	-- the client tooltip can render "depleted." Restored by the timer.
	node:SetAttribute('Depleted', true)
	if node:IsA('BasePart') then
		(node :: BasePart).Transparency = 0.6
	end
	local respawn = node:GetAttribute('RespawnSeconds') or DEFAULT_RESPAWN
	task.delay(respawn, function()
		if not node.Parent then return end
		node:SetAttribute('Depleted', nil)
		node:SetAttribute('Health', node:GetAttribute('MaxHealth') or DEFAULT_MAX_HEALTH)
		if node:IsA('BasePart') then
			(node :: BasePart).Transparency = 0
		end
	end)
end

----------------------------------------------------------------------
-- Public — handle a single tool-use against a hit instance.
----------------------------------------------------------------------
function Module.HandleToolUse(player: Player, hit: Instance?)
	if not hit then return end
	-- Walk up parents until we find the tagged node — the hit may be a
	-- mesh decoration parented under the node Model.
	local node: Instance? = hit
	while node and not CollectionService:HasTag(node, NODE_TAG) do
		node = node.Parent
		if node == workspace or node == game then node = nil; break end
	end
	if not node then return end

	if node:GetAttribute('Depleted') == true then return end

	local character = player.Character
	if character and not CombatShared.IsCharacterAvailable(character) then
		return
	end

	local _itemId, cfg = getEquippedTool(player)
	if not cfg then return end
	local toolPower = (cfg.EquipmentData and cfg.EquipmentData.ToolUsage
		and cfg.EquipmentData.ToolUsage.Damage and cfg.EquipmentData.ToolUsage.Damage.Value
		and cfg.EquipmentData.ToolUsage.Damage.Value.Max) or 0
	local minPower = node:GetAttribute('MinPower') or 1
	if toolPower < minPower then return end

	ensureNodeAttributes(node)
	local hp = (node:GetAttribute('Health') or DEFAULT_MAX_HEALTH) - 1
	node:SetAttribute('Health', math.max(0, hp))

	-- Per-strike loot drop — small chance for partial yield while the
	-- node is still up; full drop on depletion. Designers can tune
	-- frequency later by gating on a percentile roll here.
	local kind = node:GetAttribute('NodeKind')
	if typeof(kind) == 'string' then
		dropLoot(player, kind)
	end

	if hp <= 0 then
		depleteNode(node)
	end
end

function Module.Start()
	ToolUseEvent.OnServerEvent:Connect(function(player: Player, hitInstance: any)
		if typeof(hitInstance) ~= 'Instance' then return end
		Module.HandleToolUse(player, hitInstance)
	end)

	-- Seed attributes on every existing tagged node + every newly
	-- tagged one so designers can drop a node in Studio without
	-- pre-setting Health/MinPower.
	for _, node in CollectionService:GetTagged(NODE_TAG) do
		ensureNodeAttributes(node)
	end
	CollectionService:GetInstanceAddedSignal(NODE_TAG):Connect(ensureNodeAttributes)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/DefinitionWarnings"><![CDATA[-- DefinitionWarnings — boot-time audit. Walks every config registry
-- and warn()s about authored-but-unbacked entries:
--
--   * EquipmentData.Model references AssetsShared.<bucket>.<Model>;
--     warns when the named asset is missing.
--   * Items with a Type that has no consumption / use handler.
--   * Mounts whose Model is missing under AssetsShared.Mounts.
--   * Auras whose template is missing AND no procedural visual is set.
--   * Companions / mounts with cfg fields referenced by runtime code
--     that aren't wired (e.g. mount-specific runtime hooks).
--
-- The audit is opt-in — runs once at Start. Output is stdout warn() so
-- the studio output panel groups them under one timestamp; nothing is
-- fatal. Designers iterate by reading the warns and either adding the
-- asset or removing the reference.

local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local ItemsConfig     = ServerModules.Data.Items
-- Mounts + Companions live server-side post config-replication
-- migration. Audit walks the full registries — server-only context;
-- the ReplicatedStorage shells are empty at boot.
local MountsConfig    = ServerModules.Data.Mounts
local AurasConfig     = ReplicatedModules.Data.Auras
local CompanionsConf  = ServerModules.Data.Companions

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Helpers — asset-tree probes. Every probe is best-effort: a missing
-- AssetsShared root just means everything reports as missing, which
-- is the right behaviour for a fresh project.
----------------------------------------------------------------------
local function getAssetsBucket(bucketName: string): Instance?
	local assets = ReplicatedStorage:FindFirstChild('AssetsShared')
	return assets and assets:FindFirstChild(bucketName)
end

local function bucketHas(bucket: Instance?, name: string): boolean
	if not bucket or typeof(name) ~= 'string' or name == '' then return false end
	return bucket:FindFirstChild(name, true) ~= nil
end

----------------------------------------------------------------------
-- Per-registry audits. Each returns the count of warnings emitted so
-- the master Audit() can summarize.
----------------------------------------------------------------------
local function auditItems(): number
	local count = 0
	-- Heuristic mapping: weapon / tool models live under the same
	-- catch-all 'Equipment' / 'Weapons' / 'Tools' buckets depending on
	-- how the project organizes art. We try a couple of common
	-- conventions before giving up.
	local equipmentBucket = getAssetsBucket('Equipment')
		or getAssetsBucket('Weapons')
		or getAssetsBucket('Items')

	-- Known item Types that DO have a runtime handler. Keep in sync
	-- with ConsumptionServer's dispatch table + CompanionsServer's
	-- candy path so a typo in a Type field gets caught at boot.
	local KNOWN_TYPES = {
		CompanionCandy   = true,
		AttributeScroll  = true,
		Material         = true,
		Gem              = true,
		EnchantScroll    = true,
		Consumable       = true,
	}

	for itemId, cfg in ItemsConfig.Items do
		-- 1. Model presence.
		if cfg.EquipmentData and typeof(cfg.EquipmentData.Model) == 'string'
			and cfg.EquipmentData.Model ~= '' then
			if not bucketHas(equipmentBucket, cfg.EquipmentData.Model) then
				warn(string.format(
					'[DefinitionWarnings] Item %q references missing model %q under AssetsShared.Equipment/Weapons/Items.',
					itemId, cfg.EquipmentData.Model))
				count += 1
			end
		end

		-- 2. Unknown Type — usually a typo. Skip nil.
		if typeof(cfg.Type) == 'string' and cfg.Type ~= '' and not KNOWN_TYPES[cfg.Type] then
			warn(string.format(
				'[DefinitionWarnings] Item %q has Type=%q with no runtime handler. Add to ConsumptionServer or remove the Type field.',
				itemId, cfg.Type))
			count += 1
		end

		-- 3. AttributeScroll without AttributeXPData payload.
		if cfg.Type == 'AttributeScroll' and not cfg.AttributeXPData then
			warn(string.format(
				'[DefinitionWarnings] Item %q is AttributeScroll but has no AttributeXPData payload.',
				itemId))
			count += 1
		end

		-- 4. CompanionCandy without CandyData.
		if cfg.Type == 'CompanionCandy' and not cfg.CandyData then
			warn(string.format(
				'[DefinitionWarnings] Item %q is CompanionCandy but has no CandyData payload.',
				itemId))
			count += 1
		end
	end
	return count
end

local function auditMounts(): number
	local count = 0
	local bucket = getAssetsBucket('Mounts')
	for mountId, cfg in MountsConfig.Mounts do
		if typeof(cfg.Model) == 'string' and not bucketHas(bucket, cfg.Model) then
			warn(string.format(
				'[DefinitionWarnings] Mount %q references missing model %q under AssetsShared.Mounts. (Procedural placeholder will render at runtime.)',
				mountId, cfg.Model))
			count += 1
		end
		-- Mount-specific runtimes — flight mounts need FlightCeiling /
		-- FlightAscentRate / FlightDescentRate; missing values aren't
		-- fatal (defaults kick in) but warn so they're authored
		-- intentionally.
		if cfg.Kind == 'flight' then
			local stats = cfg.Stats or {}
			if not stats.FlightCeiling then
				warn(string.format('[DefinitionWarnings] Flight mount %q missing Stats.FlightCeiling — defaulting.', mountId))
				count += 1
			end
			if not stats.FlightAscentRate then
				warn(string.format('[DefinitionWarnings] Flight mount %q missing Stats.FlightAscentRate — defaulting.', mountId))
				count += 1
			end
		end
	end
	return count
end

local function auraHasProceduralVisual(cfg: any): boolean
	local p = cfg.Procedural
	if not p then return false end
	return (p.Particle ~= nil) or (p.Beam ~= nil) or (p.Light ~= nil)
end

local function auditAuras(): number
	local count = 0
	local bucket = getAssetsBucket('VFX')
	bucket = bucket and bucket:FindFirstChild('Auras')
	for auraId, cfg in AurasConfig.Auras do
		local templateName = (cfg.Procedural and cfg.Procedural.TemplateName)
			or (cfg.VFX and cfg.VFX.Particle)
		local templateExists = templateName and bucketHas(bucket, templateName)
		if not templateExists and not auraHasProceduralVisual(cfg) then
			warn(string.format(
				'[DefinitionWarnings] Aura %q has no template under AssetsShared.VFX.Auras AND no Procedural visual — it will render as a single PointLight only.',
				auraId))
			count += 1
		end
	end
	return count
end

local function auditCompanions(): number
	local count = 0
	-- Companions table may not exist on every project — guard.
	if not CompanionsConf or typeof(CompanionsConf.Companions) ~= 'table' then return 0 end
	local bucket = getAssetsBucket('Companions')
	for compId, cfg in CompanionsConf.Companions do
		local model = cfg.Model
		if typeof(model) == 'string' and model ~= '' and not bucketHas(bucket, model) then
			warn(string.format(
				'[DefinitionWarnings] Companion %q references missing model %q under AssetsShared.Companions.',
				compId, model))
			count += 1
		end
	end
	return count
end

----------------------------------------------------------------------
-- Public — Audit() can be called from Start AND on demand (cmdr,
-- dev tooling). Returns the total warn count so callers can surface
-- a single one-line summary.
----------------------------------------------------------------------
function Module.Audit(): number
	local total = 0
	total += auditItems()
	total += auditMounts()
	total += auditAuras()
	total += auditCompanions()
	if total > 0 then
		warn(string.format('[DefinitionWarnings] %d definition warning(s) — see above.', total))
	end
	return total
end

function Module.Start()
	-- One-shot at boot. Other systems' Start hooks already deferred so
	-- this lands after every registry has loaded.
	task.defer(Module.Audit)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/AreaLockServer"><![CDATA[-- AreaLockServer — STUB. Prevents a player from leaving a designated
-- region. Used by OnboardingServer to keep new players inside the
-- spawn town until tutorial complete; reusable for boss-arena lockouts,
-- escort quest bounds, etc.
--
-- API:
--   Module.EnableLock(player, regionId, regionConfig)
--       regionConfig := { Center: Vector3, Radius: number } |
--                       { Min: Vector3, Max: Vector3 } |
--                       { InstancePath: string }       -- bounds from a Model's bounding box
--   Module.DisableLock(player, regionId?)              -- nil regionId = clear all
--   Module.IsLocked(player) → boolean
--   Module.GetActiveLocks(player) → { regionId }
--
-- ════════════════════════════════════════════════════════════════════
-- TODO — implementation choices for the real lock behaviour. None of
-- these is wired today; the stub stores the lock state + signals it
-- via warn() so the gameplay flow is testable end-to-end.
-- ════════════════════════════════════════════════════════════════════
--
--   1. INVISIBLE WALL — spawn an invisible CanCollide block at the
--      region boundary. Cheap; works for spheres + box regions; ugly
--      collision feel against fast-moving / dashing players.
--
--   2. TELEPORT-BACK — Heartbeat sweep checks every locked player's
--      HRP position vs. the region; on exit, snap their HRP back to
--      the nearest in-region point. Snappy, no asset deps. Risk:
--      teleport-fight if the player is in a flowing dash; mitigate by
--      cancelling the dash + applying a small inward velocity nudge.
--
--   3. ZONE-BLOCK — pair with the existing ZoneService so leaving the
--      region triggers a script-side "blocked!" toast + a soft
--      pull-back BodyVelocity for ~0.4s. Reads as "you bounce off an
--      invisible barrier" rather than "you teleport." Best UX choice.
--
-- Default plan: ship #2 (teleport-back) for the onboarding lock, then
-- evolve to #3 once the boss-arena variant ships and a "you can't
-- leave during a fight" UX needs more polish.

local Players = game:GetService('Players')

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Per-player lock state. A player can carry MULTIPLE locks (e.g.
-- onboarding + boss arena overlap during a tutorial fight); leaving
-- ANY active region is blocked. EnableLock with the same regionId
-- updates the existing entry rather than stacking.
----------------------------------------------------------------------
export type RegionConfig = {
	-- Sphere region.
	Center: Vector3?,
	Radius: number?,
	-- Box region (axis-aligned).
	Min: Vector3?,
	Max: Vector3?,
	-- Bounded model — resolved via InstancePath at lock time.
	InstancePath: string?,
}

local Locks: { [Player]: { [string]: RegionConfig } } = {}

function Module.IsLocked(player: Player): boolean
	local entry = Locks[player]
	if not entry then return false end
	return next(entry) ~= nil
end

function Module.GetActiveLocks(player: Player): { string }
	local entry = Locks[player]
	if not entry then return {} end
	local out: { string } = {}
	for id in entry do out[#out + 1] = id end
	table.sort(out)
	return out
end

----------------------------------------------------------------------
-- Public — enable / disable.
----------------------------------------------------------------------
function Module.EnableLock(player: Player, regionId: string, regionConfig: RegionConfig)
	if typeof(regionId) ~= 'string' or regionId == '' then return end
	if typeof(regionConfig) ~= 'table' then return end
	Locks[player] = Locks[player] or {}
	Locks[player][regionId] = regionConfig
	-- TODO: spawn the invisible-wall / start the teleport-back loop /
	-- register with ZoneService here. Stub-tier: log so gameplay can
	-- verify the wiring path works.
	warn(string.format('[AreaLockServer] (stub) lock %s enabled for %s',
		regionId, player.Name))
end

function Module.DisableLock(player: Player, regionId: string?)
	local entry = Locks[player]
	if not entry then return end
	if regionId then
		entry[regionId] = nil
		warn(string.format('[AreaLockServer] (stub) lock %s cleared for %s',
			regionId, player.Name))
		if next(entry) == nil then Locks[player] = nil end
	else
		Locks[player] = nil
		warn(string.format('[AreaLockServer] (stub) all locks cleared for %s',
			player.Name))
	end
end

----------------------------------------------------------------------
-- Boundary check (for the future enforcement loop). Returns:
--   true        — player is inside ALL active regions
--   false, id   — player is outside region `id`
-- Stub-tier: implements sphere + AABB checks since both shapes are
-- trivially testable. The InstancePath form is left as a TODO so the
-- actual model-bounded path lands when the spawn-town model exists.
----------------------------------------------------------------------
function Module.IsInsideAllRegions(player: Player): (boolean, string?)
	local entry = Locks[player]
	if not entry or next(entry) == nil then return true, nil end
	local char = player.Character
	local hrp = char and char:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not hrp then return true, nil end
	local pos = hrp.Position
	for id, cfg in entry do
		if cfg.Center and cfg.Radius then
			if (pos - cfg.Center).Magnitude > cfg.Radius then
				return false, id
			end
		elseif cfg.Min and cfg.Max then
			if pos.X < cfg.Min.X or pos.X > cfg.Max.X
				or pos.Y < cfg.Min.Y or pos.Y > cfg.Max.Y
				or pos.Z < cfg.Min.Z or pos.Z > cfg.Max.Z then
				return false, id
			end
		end
		-- TODO: cfg.InstancePath → resolve model bounding box, test.
	end
	return true, nil
end

----------------------------------------------------------------------
-- Lifecycle. Per-player cleanup; the enforcement loop is intentionally
-- unwired (see TODO header) so the stub doesn't yet move players
-- around. Wire the loop here when the implementation choice is locked.
----------------------------------------------------------------------
function Module.Start()
	Players.PlayerRemoving:Connect(function(player)
		Locks[player] = nil
	end)
	-- TODO: start the per-player enforcement loop here when ready:
	--   task.spawn(function()
	--     while true do
	--       task.wait(0.1)
	--       for player in Locks do
	--         local inside, _ = Module.IsInsideAllRegions(player)
	--         if not inside then teleportBackToRegionEdge(player) end
	--       end
	--     end
	--   end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/WorkstationServer"><![CDATA[-- WorkstationServer — tag-driven crafting workstations.
--
-- Setup workflow (Studio):
--   1. Place a model in workspace (cooking pot, forge, alchemy bench).
--   2. Tag it 'Workstation' via CollectionService.
--   3. Set Attribute('WorkstationKind', 'CookingPot' | 'Forge' | 'AlchemyBench' | …)
--   4. (Optional) Attribute('PromptText') — defaults to 'Use'.
--   5. (Optional) Attribute('PromptDistance', number) — default 8.
--
-- The kind string must match the Crafting recipe's `Workstation` field
-- (e.g. 'CookingPot' on the prompt + on the recipe). On Triggered, the
-- server fires WorkstationEvent at the player so the client opens its
-- crafting widget filtered to the workstation's kind.
--
-- The server also maintains a nearest-tag map: per-player → kind they
-- are currently within range of. CraftingServer.AttemptCraft reads
-- this via Module.GetNearestKind so the server's authoritative gate
-- doesn't trust the client's hint string.
--
-- Mirrors the DialogueNPCServer / HarvestNode pattern (tag + per-
-- instance ProximityPrompt) so designer workflows stay consistent.

local CollectionService = game:GetService('CollectionService')
local Players           = game:GetService('Players')
local RunService        = game:GetService('RunService')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local RemoteService = ReplicatedModules.Services.RemoteService

local WorkstationEvent = RemoteService.GetRemote('WorkstationEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

local TAG = 'Workstation'

-- Per-instance cleanup tables (mirrors DialogueNPCServer's pattern).
local Cleanups: { [Instance]: { Cleanup: () -> () } } = {}

-- Per-player → currently-nearest workstation kind. Driven by the
-- proximity tracker below. Read by CraftingServer.AttemptCraft.
-- Lifetime: cleared on PlayerRemoving + on character respawn (since a
-- respawn implies the player teleported away from the workstation).
local NearestKind: { [Player]: string? } = {}

-- Tunable: how often the proximity sweep runs. 0.5s keeps the
-- nearest-tag map fresh without burning a Heartbeat per frame.
-- Recipe gating reads at AttemptCraft time, not per-render, so the
-- sweep cadence drives "did the player just walk away" latency.
local PROX_SWEEP_INTERVAL = 0.5

----------------------------------------------------------------------
-- Tiny ad-hoc maid (same shape DialogueNPCServer uses).
----------------------------------------------------------------------
local function newMaid()
	local items: { any } = {}
	return {
		Give = function(item) items[#items + 1] = item end,
		Cleanup = function()
			for _, item in items do
				if typeof(item) == 'RBXScriptConnection' then
					item:Disconnect()
				elseif typeof(item) == 'Instance' then
					item:Destroy()
				elseif typeof(item) == 'function' then
					item()
				end
			end
			table.clear(items)
		end,
	}
end

local function findHostPart(model: Instance): BasePart?
	if model:IsA('BasePart') then return model :: BasePart end
	if not model:IsA('Model') then return nil end
	if model.PrimaryPart then return model.PrimaryPart end
	for _, d in model:GetDescendants() do
		if d:IsA('BasePart') then return d end
	end
	return nil
end

----------------------------------------------------------------------
-- Per-workstation setup. Attaches a ProximityPrompt; on Triggered,
-- fires the WorkstationEvent at the player so the client can open
-- its crafting widget to the matching kind.
----------------------------------------------------------------------
local function setupWorkstation(model: Instance)
	if Cleanups[model] then return end
	local kind = model:GetAttribute('WorkstationKind')
	if typeof(kind) ~= 'string' or kind == '' then
		warn(string.format(
			'[WorkstationServer] %s tagged %q but missing string Attribute WorkstationKind',
			model:GetFullName(), TAG))
		return
	end
	local host = findHostPart(model)
	if not host then
		warn(string.format('[WorkstationServer] %s has no BasePart to host the prompt', model:GetFullName()))
		return
	end

	local maid = newMaid()
	Cleanups[model] = maid

	local prompt = Instance.new('ProximityPrompt')
	prompt.ActionText = (model:GetAttribute('PromptText') :: string?) or 'Use'
	prompt.ObjectText = (model:GetAttribute('PromptObjectText') :: string?) or kind
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = (model:GetAttribute('PromptDistance') :: number?) or 8
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.Parent = host
	maid.Give(prompt)

	maid.Give(prompt.Triggered:Connect(function(player: Player)
		WorkstationEvent:FireClient(player, 'Open', kind)
	end))

	-- Auto-cleanup on despawn / untag.
	maid.Give(model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(workspace) then
			Module.Teardown(model)
		end
	end))
end

function Module.Teardown(model: Instance)
	local maid = Cleanups[model]
	if not maid then return end
	maid.Cleanup()
	Cleanups[model] = nil
end

----------------------------------------------------------------------
-- Proximity tracker. Sweeps every PROX_SWEEP_INTERVAL seconds and
-- updates NearestKind[player]. The sweep cost is O(players ×
-- workstations) which is small for an alpha; for >100 stations a
-- spatial bucket grid would be the next step.
----------------------------------------------------------------------
local function squaredHorizontalDistance(a: Vector3, b: Vector3): number
	local dx = a.X - b.X
	local dz = a.Z - b.Z
	return dx * dx + dz * dz
end

local function sweep()
	for _, player in Players:GetPlayers() do
		local char = player.Character
		local hrp = char and char:FindFirstChild('HumanoidRootPart') :: BasePart?
		if not hrp then NearestKind[player] = nil; continue end
		local pos = hrp.Position
		local bestKind: string? = nil
		local bestDist = math.huge
		for _, model in CollectionService:GetTagged(TAG) do
			local kind = model:GetAttribute('WorkstationKind')
			if typeof(kind) ~= 'string' or kind == '' then continue end
			local host = findHostPart(model)
			if not host then continue end
			local maxDist = (model:GetAttribute('PromptDistance') :: number?) or 8
			local d = squaredHorizontalDistance(pos, host.Position)
			if d <= maxDist * maxDist and d < bestDist then
				bestDist = d
				bestKind = kind
			end
		end
		NearestKind[player] = bestKind
	end
end

----------------------------------------------------------------------
-- Public — read the per-player nearest workstation kind. Returns nil
-- when the player isn't near any tagged workstation.
----------------------------------------------------------------------
function Module.GetNearestKind(player: Player): string?
	return NearestKind[player]
end

function Module.Start()
	-- Initial sweep pass for already-tagged workstations.
	for _, inst in CollectionService:GetTagged(TAG) do
		setupWorkstation(inst)
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(setupWorkstation)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(Module.Teardown)

	-- Proximity sweep — task.spawn keeps it off Heartbeat so a heavy
	-- frame doesn't compound the sweep cost. Interval-driven (0.5s)
	-- not Heartbeat-driven on purpose.
	task.spawn(function()
		while true do
			task.wait(PROX_SWEEP_INTERVAL)
			pcall(sweep)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		NearestKind[player] = nil
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/StatusEffectsRuntime"><![CDATA[-- StatusEffectsRuntime — server-side application of named effects from
-- Data/StatusEffects.luau. The DoT loop, armor mutation, walk-speed
-- slow, and CC stun all live here. Combat code stays one call away
-- (`StatusEffectsRuntime.Apply(target, effectId, opts)`) — it doesn't
-- see timers, ticks, or restore logic.
--
-- Stacking semantics live in the cfg (Stacking = 'replace' | 'refresh'
-- | 'stack'); this module enforces them via per-(target, effectId) rows.
--
-- State residency: per-character state lives in a module-level table
-- keyed by character. We DON'T persist effects across respawn — death
-- clears every active effect (via the AncestryChanged listener Apply
-- installs once per character).
--
-- Damage application: routes through DamageModule.DamageHumanoid so
-- the existing kill-credit / damage-indicator / IFrame pipeline works
-- without effects becoming a parallel damage path.

local Players = game:GetService('Players')
local CollectionService = game:GetService('CollectionService')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local StatusEffectsConfig = ReplicatedModules.Data.StatusEffects

local SystemsContainer = {}

local Module = {}

-- Active effect rows. `Stacks[character][effectId] = {
--   expiresAt: number,
--   potency: number,         -- accumulated when Stacking='stack'
--   stackCount: number,
--   lastTickAt: number,      -- DoT bookkeeping
--   sourcePlayer: Player?,   -- kill-credit owner (nullable for NPC sources)
--   appliedRestore: () -> ()? -- closure that undoes attribute / WS mutations
-- }`.
type Stack = {
	expiresAt: number,
	potency: number,
	stackCount: number,
	lastTickAt: number?,
	sourcePlayer: Player?,
	appliedRestore: (() -> ())?,
}
local Stacks: { [Instance]: { [string]: Stack } } = {}

-- One Heartbeat-driver per character — created on first Apply,
-- disconnected when the last effect on that character expires. Avoids
-- a single global tick walking every character every frame.
type Driver = { conn: RBXScriptConnection?, character: Instance }
local Drivers: { [Instance]: Driver } = {}

----------------------------------------------------------------------
-- Helpers.
----------------------------------------------------------------------
local function now(): number return os.clock() end

local function ensureStacksFor(character: Instance)
	if not Stacks[character] then Stacks[character] = {} end
end

local function clearAllOn(character: Instance)
	local byId = Stacks[character]; if not byId then return end
	for _, stack in byId do
		if stack.appliedRestore then pcall(stack.appliedRestore) end
	end
	Stacks[character] = nil
	local driver = Drivers[character]
	if driver and driver.conn then driver.conn:Disconnect() end
	Drivers[character] = nil
end

local function getHumanoid(character: Instance): Humanoid?
	if not character or not (character :: any).FindFirstChildOfClass then return nil end
	return (character :: Instance):FindFirstChildOfClass('Humanoid')
end

local function getDamageModule()
	-- Server-only require with framework-style sibling lookup so this
	-- module stays loadable on the client (where it'll just no-op
	-- damage-side effects).
	local Server = SystemsContainer
	if Server.DamageModule then return Server.DamageModule end
	-- Fall back to a direct require path; the DamageModule lives under
	-- ServerStorage.Modules.Modules.
	local ok, mod = pcall(function()
		local SS = game:GetService('ServerStorage')
		return require(SS:WaitForChild('Modules')).Modules.DamageModule
	end)
	if ok and mod then return mod end
	return nil
end

----------------------------------------------------------------------
-- Per-category appliers. Each takes (character, cfg, stack) and
-- returns an optional restore closure called when the effect expires.
----------------------------------------------------------------------
local Appliers: { [string]: (Instance, any, Stack) -> (() -> ())? } = {}

-- DoT — installs a per-row tick driven by the per-character Heartbeat
-- (see startDriver below). The applier itself just seeds lastTickAt
-- and returns nil — no permanent attribute mutation to undo.
Appliers.dot = function(_character: Instance, _cfg: any, stack: Stack)
	stack.lastTickAt = now()
	return nil
end

-- Flat armor reduction. Stored as a character attribute so other
-- combat math (DamageModule.Toughness already reads attribute-server
-- bonuses) can layer with it. Restore subtracts the same amount.
Appliers.armor_flat = function(character: Instance, _cfg: any, stack: Stack)
	local cur = character:GetAttribute('Effect_ArmorFlat') or 0
	local applied = stack.potency
	character:SetAttribute('Effect_ArmorFlat', cur + applied)
	return function()
		local now_cur = character:GetAttribute('Effect_ArmorFlat') or 0
		character:SetAttribute('Effect_ArmorFlat', math.max(0, now_cur - applied))
	end
end

-- Percent armor reduction. Stored as a fractional multiplier — total
-- multiplier = 1 - sum(stacks). Capped at 0.95 so the target keeps a
-- baseline 5% armor regardless of stacks.
Appliers.armor_pct = function(character: Instance, _cfg: any, stack: Stack)
	local cur = character:GetAttribute('Effect_ArmorPctSum') or 0
	local applied = math.min(stack.potency, 0.95)
	character:SetAttribute('Effect_ArmorPctSum', math.min(0.95, cur + applied))
	return function()
		local now_cur = character:GetAttribute('Effect_ArmorPctSum') or 0
		character:SetAttribute('Effect_ArmorPctSum', math.max(0, now_cur - applied))
	end
end

-- CC — paralysis / stun. Drives the existing CharacterStates 'Stunned'
-- attribute so combat / movement code that already gates on it doesn't
-- need a new switch.
--
-- Uses SetStateTemporary and returns NO restore closure, and that is the
-- whole point of this applier.
--
-- The previous version set the attribute outright and restored by
-- clearing it unconditionally. That made a status expiry able to cancel
-- a completely unrelated, newer, longer stun: get paralysed for 1.5 s,
-- eat a 3 s poise-break stagger half a second later, and the paralysis
-- expiring at 1.5 s wiped the stagger with 2 s still to run.
--
-- SetStateTemporary stamps a monotonic id and refuses to clear a state
-- that someone else has since re-set (see CharacterStates), so expiry is
-- automatically ownership-checked. Both cc effects use `replace`
-- stacking, which tears down and re-runs this applier on re-application,
-- so the duration still refreshes correctly.
--
-- Tradeoff: an EXPLICIT Module.Clear of a cc effect now leaves the stun
-- to lapse on its own rather than cutting it short. That is the better
-- failure — a stun overstaying by under a second is invisible, whereas
-- silently cancelling another system's crowd control is a real bug.
Appliers.cc = function(character: Instance, _cfg: any, stack: Stack)
	local CharacterStates = ReplicatedModules.Services.CharacterStates
	if not CharacterStates or not CharacterStates.SetStateTemporary then return nil end
	local duration = stack.expiresAt - now()
	if duration <= 0 then return nil end
	CharacterStates.SetStateTemporary(character, 'Stunned', duration, true)
	return nil
end

-- Movement debuff. Multiplies humanoid.WalkSpeed by (1 - potency).
-- Restore stashes the speed at apply time and returns it on expire —
-- consistent with the guard walk-speed cache pattern in CombatMotionClient.
Appliers.movement = function(character: Instance, _cfg: any, stack: Stack)
	local humanoid = getHumanoid(character)
	if not humanoid then return nil end
	local prev = humanoid.WalkSpeed
	local mul = math.clamp(1 - stack.potency, 0.05, 1)
	humanoid.WalkSpeed = prev * mul
	return function()
		if humanoid.Parent then
			humanoid.WalkSpeed = prev
		end
	end
end

-- Damage amplification. Stored as an attribute summed across stacks;
-- DamageModule reads it pre-damage to scale incoming damage.
Appliers.damage_amp = function(character: Instance, _cfg: any, stack: Stack)
	local cur = character:GetAttribute('Effect_DamageAmpSum') or 0
	local applied = stack.potency
	character:SetAttribute('Effect_DamageAmpSum', cur + applied)
	return function()
		local now_cur = character:GetAttribute('Effect_DamageAmpSum') or 0
		character:SetAttribute('Effect_DamageAmpSum', math.max(0, now_cur - applied))
	end
end

Appliers.buff = function(_character: Instance, _cfg: any, _stack: Stack) return nil end
Appliers.misc = function(_character: Instance, _cfg: any, _stack: Stack) return nil end

----------------------------------------------------------------------
-- DoT tick — runs from the per-character driver. Inflicts damage
-- (negative potency = heal) on every cfg.TickInterval seconds.
----------------------------------------------------------------------
local function tickDoT(character: Instance, effectId: string, cfg: any, stack: Stack, t: number)
	local interval = cfg.TickInterval or 1.0
	if (t - (stack.lastTickAt or t)) < interval then return end
	stack.lastTickAt = t
	local humanoid = getHumanoid(character)
	if not humanoid or humanoid.Health <= 0 then return end
	local DM = getDamageModule()
	-- Damage = potency × stackCount. For 'stack' semantics the potency
	-- already accumulates so we don't multiply twice; for 'refresh' /
	-- 'replace' stackCount is 1.
	local effective = stack.potency
	if cfg.Stacking ~= 'stack' then
		effective = effective * stack.stackCount
	end
	if effective > 0 then
		if DM and DM.DamageHumanoid then
			DM.DamageHumanoid(humanoid, effective, stack.sourcePlayer)
		else
			humanoid:TakeDamage(effective)
		end
	elseif effective < 0 then
		-- Heal — clamp to MaxHealth so a regen tick doesn't overflow.
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health - effective)
	end
end

----------------------------------------------------------------------
-- Driver. One Heartbeat-bound function per character; ticks every
-- DoT effect, expires effects whose deadline has passed, and shuts
-- itself down when the character has no active effects.
----------------------------------------------------------------------
local function ensureDriver(character: Instance)
	if Drivers[character] then return end
	local driver: Driver = { conn = nil, character = character }
	driver.conn = game:GetService('RunService').Heartbeat:Connect(function()
		local byId = Stacks[character]
		if not byId then
			if driver.conn then driver.conn:Disconnect() end
			Drivers[character] = nil
			return
		end
		local t = now()
		local toExpire: { string }? = nil
		for effectId, stack in byId do
			if t >= stack.expiresAt then
				toExpire = toExpire or {}
				toExpire[#toExpire + 1] = effectId
			else
				local cfg = StatusEffectsConfig.GetEffectFromId(effectId)
				if cfg and cfg.Category == 'dot' then
					tickDoT(character, effectId, cfg, stack, t)
				end
			end
		end
		if toExpire then
			for _, effectId in toExpire do
				local stack = byId[effectId]
				if stack and stack.appliedRestore then pcall(stack.appliedRestore) end
				byId[effectId] = nil
			end
			-- Empty? tear down the driver.
			if next(byId) == nil then
				Stacks[character] = nil
				if driver.conn then driver.conn:Disconnect() end
				Drivers[character] = nil
			end
		end
	end)
	Drivers[character] = driver

	-- Death / despawn → clear all effects on the character. AncestryChanged
	-- + Humanoid.Died both fire on death; we listen to AncestryChanged
	-- (cheaper, single source) since it covers respawn too.
	character.AncestryChanged:Once(function()
		if not character:IsDescendantOf(workspace) then
			clearAllOn(character)
		end
	end)
end

----------------------------------------------------------------------
-- Public — apply / clear / query.
----------------------------------------------------------------------
export type ApplyOptions = {
	Duration: number?,
	Potency: number?,
	Source: Player?,
}

function Module.Apply(targetCharacter: Instance, effectId: string, opts: ApplyOptions?): boolean
	if not targetCharacter or not targetCharacter:IsDescendantOf(workspace) then return false end
	-- Canonicalise the id at the door so legacy aliases resolve AND end
	-- up stored under the canonical key. Storing the alias verbatim
	-- would let 'Burn' and 'burn' occupy two independent stacks on the
	-- same character, each ticking its own damage.
	effectId = StatusEffectsConfig.ResolveEffectId(effectId)
	local cfg = StatusEffectsConfig.GetEffectFromId(effectId)
	if not cfg then
		warn(string.format('StatusEffectsRuntime.Apply: unknown effect id %q', tostring(effectId)))
		return false
	end
	opts = opts or {}
	local duration = opts.Duration or cfg.DefaultDuration
	local potency  = opts.Potency or cfg.DefaultPotency
	local applier = Appliers[cfg.Category]
	if not applier then return false end

	ensureStacksFor(targetCharacter)
	local byId = Stacks[targetCharacter]
	local existing = byId[effectId]

	if existing then
		-- Stacking semantics.
		if cfg.Stacking == 'replace' then
			if existing.appliedRestore then pcall(existing.appliedRestore) end
			byId[effectId] = nil
		elseif cfg.Stacking == 'refresh' then
			-- Keep the strongest potency, refresh deadline. No new applier
			-- run because the attribute / state was already mutated.
			existing.expiresAt = now() + duration
			existing.potency   = math.max(existing.potency, potency)
			existing.sourcePlayer = opts.Source or existing.sourcePlayer
			ensureDriver(targetCharacter)
			return true
		elseif cfg.Stacking == 'stack' then
			if existing.stackCount >= cfg.MaxStack then
				-- At cap — refresh deadline only.
				existing.expiresAt = now() + duration
				ensureDriver(targetCharacter)
				return true
			end
			-- Sum potency across stacks (DoT damage / armor mod).
			-- Run the applier again for the ADDITIONAL stack so attribute
			-- mutations (armor_flat, armor_pct) layer correctly. The new
			-- applier-restore is composed with the existing one: when the
			-- effect fully expires, BOTH restores run.
			local addStack: Stack = {
				expiresAt = now() + duration,
				potency = potency,
				stackCount = 1,
				sourcePlayer = opts.Source,
			}
			local extraRestore = applier(targetCharacter, cfg, addStack)
			existing.stackCount += 1
			existing.potency += potency
			existing.expiresAt = math.max(existing.expiresAt, now() + duration)
			if extraRestore then
				local prev = existing.appliedRestore
				existing.appliedRestore = function()
					if prev then pcall(prev) end
					pcall(extraRestore)
				end
			end
			ensureDriver(targetCharacter)
			return true
		end
	end

	-- Fresh apply.
	local stack: Stack = {
		expiresAt = now() + duration,
		potency = potency,
		stackCount = 1,
		sourcePlayer = opts.Source,
	}
	stack.appliedRestore = applier(targetCharacter, cfg, stack)
	byId[effectId] = stack
	ensureDriver(targetCharacter)
	return true
end

-- Apply by Effect reference (the same shape used in WeaponUsage.Inflicts).
function Module.ApplyEffect(targetCharacter: Instance, effectRef: any, sourcePlayer: Player?): boolean
	if not effectRef or typeof(effectRef.Id) ~= 'string' then return false end
	return Module.Apply(targetCharacter, effectRef.Id, {
		Duration = effectRef.Duration,
		Potency = effectRef.Potency,
		Source = sourcePlayer,
	})
end

function Module.Clear(targetCharacter: Instance, effectId: string)
	local byId = Stacks[targetCharacter]; if not byId then return end
	local stack = byId[effectId]; if not stack then return end
	if stack.appliedRestore then pcall(stack.appliedRestore) end
	byId[effectId] = nil
	if next(byId) == nil then
		Stacks[targetCharacter] = nil
		local driver = Drivers[targetCharacter]
		if driver and driver.conn then driver.conn:Disconnect() end
		Drivers[targetCharacter] = nil
	end
end

function Module.ClearAll(targetCharacter: Instance)
	clearAllOn(targetCharacter)
end

-- Query — used by debuff-aware UIs (status icons over heads, etc.) and
-- by combat read paths that want to factor `pierced` into armor math.
function Module.GetActive(targetCharacter: Instance): { [string]: { potency: number, expiresAt: number, stackCount: number } }
	local byId = Stacks[targetCharacter]; if not byId then return {} end
	local out: any = {}
	for id, s in byId do
		out[id] = { potency = s.potency, expiresAt = s.expiresAt, stackCount = s.stackCount }
	end
	return out
end

function Module.IsActive(targetCharacter: Instance, effectId: string): boolean
	local byId = Stacks[targetCharacter]; if not byId then return false end
	return byId[effectId] ~= nil
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	-- Player respawn — wipe effects on the OLD character (the new
	-- character is a different instance, so its Stacks bucket starts
	-- empty automatically).
	Players.PlayerAdded:Connect(function(player)
		player.CharacterRemoving:Connect(function(character)
			clearAllOn(character)
		end)
	end)
	-- Already-joined players (script load order safety).
	for _, player in Players:GetPlayers() do
		player.CharacterRemoving:Connect(function(character)
			clearAllOn(character)
		end)
	end
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
	-- Wire CombatUtility's inflict pipeline to us. CombatUtility
	-- can't require this module directly (lives in ReplicatedStorage,
	-- we live in ServerStorage), so it exposes a registration setter.
	-- Once registered, every weapon hit / skill cue that walks
	-- WeaponUsage.Inflicts ends up running through Module.ApplyEffect.
	local CombatUtility = ReplicatedModules.Utility.CombatUtility
	if CombatUtility and CombatUtility.RegisterStatusEffectsRuntime then
		CombatUtility.RegisterStatusEffectsRuntime(Module)
	end
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/PlayerCombatServer"><![CDATA[-- // PlayerCombatServer.luau //
-- Remote intake for player combat. Nothing more.
--
-- See NIER_COMBAT.md for the design.
--
-- This module used to be 1040 lines and owned combo bookkeeping, swing
-- timing, hitbox queries, the hit loop, damage, air juggles,
-- perfect-dodge detection and finisher VFX — none of which NPCs could
-- reach, which is why NPC combat was a separate and much poorer
-- implementation. All of that now lives in CombatServer and the modules
-- beneath it, shared by every combatant.
--
-- What is left is the part that is genuinely player-specific: a hostile
-- network boundary. This file validates payload shape, enforces rate
-- limits, rejects replayed commands, and hands a clean intent to
-- CombatServer. It contains no gameplay rules, so there is no longer
-- anywhere for player and NPC behaviour to drift apart.

local Players = game:GetService('Players')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CombatConfigModule = ReplicatedModules.Data.CombatConfig
local CombatActions = ReplicatedModules.Data.CombatActions
local CombatShared = ReplicatedModules.Services.CombatShared
local CombatValidation = ReplicatedModules.Utility.CombatValidation
local CharacterStates = ReplicatedModules.Services.CharacterStates
local CombatUtility = ReplicatedModules.Utility.CombatUtility

local RemoteService = ReplicatedModules.Services.RemoteService
local CombatEvent = RemoteService.GetRemote('CombatEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

-- Re-exported for the handful of AI modules that still resolve block
-- state through this module.
Module.BLOCKING_STATE = CombatShared.BLOCKING_STATE

----------------------------------------------------------------------
-- Per-player remote budget.
--
-- Three independent guards, because they fail differently:
--   * LastCommandId rejects REPLAYS (the same command sent twice).
--   * Per-action intervals reject FLOODS (valid commands, too fast).
--   * The malformed counter tracks payloads that were never plausible,
--     which is the signal worth escalating on — an honest client never
--     produces one.
----------------------------------------------------------------------
type Budget = {
	LastCommandId: number,
	LastAttackAt: number,
	LastDodgeAt: number,
	LastGuardAt: number,
	MalformedCount: number,
	MalformedWindowStart: number,
}

local Budgets: { [Player]: Budget } = {}

local function getBudget(player: Player): Budget
	local budget = Budgets[player]
	if not budget then
		budget = {
			LastCommandId = 0,
			LastAttackAt = 0,
			LastDodgeAt = 0,
			LastGuardAt = 0,
			MalformedCount = 0,
			MalformedWindowStart = 0,
		}
		Budgets[player] = budget
	end
	return budget
end

-- TEMPORARY combat diagnostic. Set false once the "swings connect but
-- nothing takes damage" investigation is closed. The wire reply is
-- deliberately non-specific (see below), which also means a denial is
-- invisible to whoever is debugging — the client animates the swing
-- either way, so a rejected action and an accepted-but-whiffed one look
-- identical in game.
local DEBUG_DENIALS = true

local function reject(player: Player, commandId: any, reason: string)
	if DEBUG_DENIALS then
		warn(string.format('[PlayerCombatServer] %s DENIED (cmd %s): %s',
			player.Name, tostring(commandId), reason))
	end
	-- Deliberately terse and non-specific on the wire. The client uses
	-- this only to roll back its prediction; surfacing the real denial
	-- reason to a normal player is noise, and to an exploiter it is a
	-- free oracle for probing the validator.
	CombatEvent:FireClient(player, CombatActions.Actions.ActionRejected, {
		CommandId = typeof(commandId) == 'number' and commandId or -1,
		Reason = reason,
	})
end

-- Records a payload that could not have come from an honest client.
local function noteMalformed(player: Player)
	local budget = getBudget(player)
	local cfg = CombatConfigModule.CombatConfig
	local currentTime = os.clock()
	local window = cfg.RATE_MALFORMED_WINDOW or 10

	if (currentTime - budget.MalformedWindowStart) > window then
		budget.MalformedWindowStart = currentTime
		budget.MalformedCount = 0
	end
	budget.MalformedCount += 1

	if budget.MalformedCount == (cfg.RATE_MALFORMED_BUDGET or 12) then
		-- One warning per window, not one per payload. The previous
		-- build printed on every combat action; a log flood is itself a
		-- performance problem and it buries the signal.
		warn(string.format(
			'[PlayerCombatServer] %s (%d) sent %d malformed combat payloads in %ds.',
			player.Name, player.UserId, budget.MalformedCount, window))
	end
end

-- Returns false when this action is arriving faster than its budget.
local function passesRateLimit(budget: Budget, field: string, minInterval: number): boolean
	local currentTime = os.clock()
	if (currentTime - (budget[field] :: number)) < minInterval then
		return false
	end
	budget[field] = currentTime
	return true
end

----------------------------------------------------------------------
-- Weapon draw. Kept here because it is bound to the player's own
-- animation-and-input loop rather than to combat resolution.
----------------------------------------------------------------------
function Module.DoesPlayerHaveWeaponEquipped(player: Player): boolean
	local character = player.Character
	if not character then return false end
	local light, heavy = CombatShared.GetCharacterEquippedWeaponsLR(character)
	return (light or heavy) ~= nil
end

function Module.UpdatePlayerEquippedWeaponAttributes(player: Player): boolean
	local character = player.Character
	if not character then
		player:SetAttribute('HasWeaponEquipped', false)
		return false
	end
	local hasWeapon = Module.DoesPlayerHaveWeaponEquipped(player)
	character:SetAttribute('HasWeaponEquipped', hasWeapon)
	player:SetAttribute('HasWeaponEquipped', hasWeapon)
	return hasWeapon
end

function Module.AttemptPlayerWeaponDraw(player: Player): boolean
	local character = player.Character
	if not character then return false end
	if not Module.DoesPlayerHaveWeaponEquipped(player) then return false end

	-- The draw/sheathe transition is a real state, not a cosmetic one:
	-- CombatShared.CanCharacterAttack refuses to swing during it, so the
	-- durations here are gameplay-visible and must not depend on whether
	-- the client's sheathe animation loaded.
	local wasDrawn = CombatShared.IsWeaponDrawn(character)
	CharacterStates.SetState(character, 'SwordDrawing', true)

	task.spawn(function()
		if wasDrawn then
			task.wait(0.4)
			CharacterStates.SetState(character, 'SwordDrawn', false)
		else
			CharacterStates.SetState(character, 'SwordDrawn', true)
			task.wait(0.8)
		end
		CharacterStates.SetState(character, 'SwordDrawing', false)
	end)

	CombatEvent:FireAllClients(CombatActions.Actions.WeaponToggled, {
		Caster = character,
		Drawn = not wasDrawn,
	})
	return true
end

----------------------------------------------------------------------
-- Intent handlers.
----------------------------------------------------------------------
local function handleAttack(player: Player, intent: any, inputKind: string)
	local budget = getBudget(player)

	local ok, reason = CombatValidation.ValidateAttackIntent({
		CommandId = intent.CommandId,
		InputKind = inputKind,
		ComboKey = intent.ComboKey,
		Origin = intent.Origin,
		Look = intent.Look,
	})
	if not ok then
		noteMalformed(player)
		reject(player, intent.CommandId, reason)
		return
	end

	-- Replay protection. Command ids are monotonic per client session,
	-- so anything at or below the high-water mark is a resend.
	if intent.CommandId <= budget.LastCommandId then
		reject(player, intent.CommandId, 'ReplayedCommand')
		return
	end
	budget.LastCommandId = intent.CommandId

	local cfg = CombatConfigModule.CombatConfig
	if not passesRateLimit(budget, 'LastAttackAt', cfg.RATE_MIN_ATTACK_INTERVAL or 0.04) then
		reject(player, intent.CommandId, 'RateLimited')
		return
	end

	-- Target hints are advisory. A bad one is discarded rather than
	-- rejected, so a stale lock-on never costs an honest player a swing.
	local targetHint = CombatValidation.IsPlausibleTargetHint(intent.TargetInstance)
		and intent.TargetInstance
		or nil

	local accepted, denialReason = SystemsContainer.CombatServer.AttemptStartPlayerAction(player, {
		InputKind = inputKind,
		ClaimedComboKey = intent.ComboKey,
		TargetHint = targetHint,
		CommandId = intent.CommandId,
	})
	if not accepted then
		reject(player, intent.CommandId, denialReason)
	end
end

local function handleDodge(player: Player, intent: any)
	local budget = getBudget(player)

	local ok, reason = CombatValidation.ValidateDodgeIntent(intent)
	if not ok then
		noteMalformed(player)
		reject(player, intent.CommandId, reason)
		return
	end
	if intent.CommandId <= budget.LastCommandId then
		reject(player, intent.CommandId, 'ReplayedCommand')
		return
	end
	budget.LastCommandId = intent.CommandId

	local cfg = CombatConfigModule.CombatConfig
	if not passesRateLimit(budget, 'LastDodgeAt', cfg.RATE_MIN_DODGE_INTERVAL or 0.12) then
		reject(player, intent.CommandId, 'RateLimited')
		return
	end

	local character = player.Character
	if not character then
		reject(player, intent.CommandId, 'NoCharacter')
		return
	end

	-- The direction is the one field a client legitimately owns: it
	-- reflects camera-relative input we cannot reconstruct server-side.
	-- It is flattened and normalised here so a crafted vector cannot
	-- turn a dodge into a launch.
	local direction = intent.Direction
	if typeof(direction) == 'Vector3' then
		direction = Vector3.new(direction.X, 0, direction.Z)
		direction = direction.Magnitude > 0.01 and direction.Unit or nil
	else
		direction = nil
	end

	local accepted, denialReason = SystemsContainer.CombatServer.AttemptDodge(character, direction, player)
	if not accepted then
		reject(player, intent.CommandId, denialReason)
	end
end

local function handleGuard(player: Player, intent: any, starting: boolean)
	local budget = getBudget(player)
	local cfg = CombatConfigModule.CombatConfig
	if not passesRateLimit(budget, 'LastGuardAt', cfg.RATE_MIN_GUARD_INTERVAL or 0.10) then
		return
	end

	local character = player.Character
	if not character then return end

	if starting then
		SystemsContainer.CombatServer.AttemptGuardStart(character, player)
	else
		SystemsContainer.CombatServer.AttemptGuardEnd(character)
	end
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	CombatEvent.OnServerEvent:Connect(function(player, action, payload)
		-- Every message is (actionString, payloadTable). Anything else
		-- is not something our client sends.
		if typeof(action) ~= 'string' then
			noteMalformed(player)
			return
		end
		local intent = typeof(payload) == 'table' and payload or {}

		local Actions = CombatActions.Actions
		if action == Actions.RequestLightAttack then
			handleAttack(player, intent, CombatActions.InputKinds.Light)
		elseif action == Actions.RequestHeavyAttack then
			handleAttack(player, intent, CombatActions.InputKinds.Heavy)
		elseif action == Actions.RequestDodge then
			handleDodge(player, intent)
		elseif action == Actions.RequestGuardStart then
			handleGuard(player, intent, true)
		elseif action == Actions.RequestGuardEnd then
			handleGuard(player, intent, false)
		elseif action == Actions.RequestWeaponToggle then
			Module.AttemptPlayerWeaponDraw(player)
		else
			noteMalformed(player)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		Budgets[player] = nil
	end)

	CombatUtility.RegisterPlayerInventoryServer(SystemsContainer.PlayerInventoryServer)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/BoostersServer"><![CDATA[-- BoostersServer. Authoritative owner of the player's active booster
-- list. Other systems query the layered multipliers/addends here:
--
--   BoostersServer.GetMultiplier(player, kind)  -- '*_mul' kinds
--   BoostersServer.GetAddend(player, kind)      -- '*_add' kinds
--
-- Stacking math (per design call):
--   * 0 active stacks of `kind`        → 1 (mul) / 0 (addend)
--   * Buff stacks (Value >= 1)         → SUM (additive power curve).
--                                        One 2× = 2. Two 2× = 4. 2×+3× = 5.
--   * Nerf stacks (Value <  1)         → PRODUCT (correct reduction stacking).
--                                        One 0.8 = 0.8. Two 0.8 = 0.64.
--   * Final mul = (buffSum or 1) * (nerfProduct or 1).
-- Add-kinds (walk_speed_add, crit_chance_add) always sum.
--
-- Active boosters live in saveData.Boosters.Active[uuid] = { Id, EndsAt,
-- Source }. EndsAt is a UTC epoch second; 0 means "permanent". The
-- expiry tick walks all active entries every BOOSTER_TICK_S seconds and
-- moves expired entries to Boosters.History (cumulative TotalSeconds
-- + LastEndedAt timestamp).

local Players = game:GetService('Players')
local HttpService = game:GetService('HttpService')
local RunService = game:GetService('RunService')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local BoostersConfig = ReplicatedModules.Data.Boosters
local RemoteService   = ReplicatedModules.Services.RemoteService

-- Client widgets subscribe via this remote — fire on Apply / Expire so
-- the BoostersTab can refresh without polling. Saves the round-trip
-- through ReplicatedData (which only ticks every 0.25s).
local BoosterEvent = RemoteService.GetRemote('BoosterEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

-- Expire pass cadence. 1s is precise enough for minute-scale boosters
-- and well below ReplicatedData's replication rate.
local BOOSTER_TICK_S = 1

----------------------------------------------------------------------
-- Save-struct helpers.
----------------------------------------------------------------------
local function getSave(player: Player): any?
	local Saves = SystemsContainer.SavesManagerServer
	if not Saves then return nil end
	return Saves.GetPlayerSelectedSaveData(player)
end

-- Defensive bootstrap: Boosters / Active / History may be absent on
-- saves loaded before this system existed (the SavesManager reconciler
-- adds them on version bump, but a save can be touched in the same
-- session before reconcile runs).
local function ensureBoostersTable(saveData: any)
	if typeof(saveData.Boosters) ~= 'table' then
		saveData.Boosters = { Active = {}, History = {} }
	end
	if typeof(saveData.Boosters.Active) ~= 'table' then
		saveData.Boosters.Active = {}
	end
	if typeof(saveData.Boosters.History) ~= 'table' then
		saveData.Boosters.History = {}
	end
end

----------------------------------------------------------------------
-- Active iterator. Yields (uuid, entry, cfg) for every CURRENTLY-active
-- booster on the player at the time of the call. Skips entries whose
-- config has been deleted (config drift) and treats EndsAt == 0 as
-- permanent (never expired).
----------------------------------------------------------------------
local function iterateActive(player: Player)
	local saveData = getSave(player)
	if not saveData then return function() return nil end end
	ensureBoostersTable(saveData)
	local now = os.time()
	local list = {}
	for uuid, entry in saveData.Boosters.Active do
		local cfg = BoostersConfig.GetBoosterConfig(entry.Id)
		if not cfg then continue end
		if entry.EndsAt ~= 0 and entry.EndsAt <= now then continue end
		table.insert(list, { uuid = uuid, entry = entry, cfg = cfg })
	end
	local i = 0
	return function()
		i += 1
		local n = list[i]
		if not n then return nil end
		return n.uuid, n.entry, n.cfg
	end
end

----------------------------------------------------------------------
-- Public query API. Other systems (DataEditServer, DamageModule,
-- LootTableServer, …) call these to read the current effective
-- multiplier / addend for a kind on a given player.
----------------------------------------------------------------------
function Module.GetMultiplier(player: Player, kind: string): number
	-- Stacking math:
	--   * Buff effects (Value >= 1, e.g. 2× XP)        → SUM the values.
	--                  One 2× = 2. Two 2× = 4. 2× + 3× = 5.
	--   * Nerf/reduction effects (Value < 1, e.g. 0.8× incoming dmg)
	--                                                   → PRODUCT the values.
	--                  One 0.8 = 0.8. Two 0.8 = 0.64. 0.8 × 0.5 = 0.4.
	--   * Final multiplier = (buffSum or 1) × (nerfProduct or 1).
	-- The split avoids the reduction-becomes-amplifier bug (sum of two
	-- 0.8 stacks would otherwise round-trip to 1.6× damage taken).
	-- Pure sum for buffs is the user-intent semantic (additive stacking
	-- as a power curve), product for nerfs is the only correct math.
	local buffSum = 0
	local buffCount = 0
	local nerfProd = 1
	local nerfCount = 0
	for _, _, cfg in iterateActive(player) do
		for _, eff in cfg.Effects do
			if eff.Kind ~= kind then continue end
			if eff.Value >= 1 then
				buffSum += eff.Value
				buffCount += 1
			else
				nerfProd *= eff.Value
				nerfCount += 1
			end
		end
	end
	if buffCount == 0 and nerfCount == 0 then return 1 end
	local b = (buffCount > 0) and buffSum or 1
	local n = (nerfCount > 0) and nerfProd or 1
	return b * n
end

function Module.GetAddend(player: Player, kind: string): number
	local total = 0
	for _, _, cfg in iterateActive(player) do
		for _, eff in cfg.Effects do
			if eff.Kind == kind then
				total += eff.Value
			end
		end
	end
	return total
end

----------------------------------------------------------------------
-- Walk-speed application.
--
-- WalkSpeed is mutated by several systems (block, mount, status
-- effects). Each of those caches and restores. To stay compatible we
-- track only our DELTA (what we've contributed), not the absolute
-- speed. On booster apply/expire we write
--   humanoid.WalkSpeed += (newAddend - prevAddend)
-- — so the player gets the booster effect while in normal movement,
-- and a transient mutator (block) that caches-and-restores will inherit
-- whatever speed was active at cache time. Edge case: a block that
-- starts BEFORE booster apply and ends AFTER will swallow the delta;
-- the booster simply re-applies on next CharacterAdded.
----------------------------------------------------------------------
local AppliedWalkDelta: {[Player]: number} = {}

local function applyWalkSpeed(player: Player)
	local character = player.Character
	if not character then return end
	local humanoid = character:FindFirstChildOfClass('Humanoid')
	if not humanoid then return end
	local newAddend = Module.GetAddend(player, 'walk_speed_add')
	local prev = AppliedWalkDelta[player] or 0
	local delta = newAddend - prev
	if delta ~= 0 then
		humanoid.WalkSpeed = math.max(0, humanoid.WalkSpeed + delta)
		AppliedWalkDelta[player] = newAddend
	end
end

-- Public hook so any system that re-spawns / re-applies walk speed can
-- reset our tracking and reapply (e.g. after a difficulty respec).
function Module.ResyncWalkSpeed(player: Player)
	AppliedWalkDelta[player] = 0
	applyWalkSpeed(player)
end

-- Convenience: active list for UI replication. Returns a flat array
-- so the client doesn't have to know about the uuid keying. Stable
-- shape so JSON-diff replication works cleanly.
function Module.GetActiveList(player: Player): {{Id: string, EndsAt: number, Source: string?}}
	local out = {}
	for _, entry in iterateActive(player) do
		table.insert(out, {
			Id     = entry.Id,
			EndsAt = entry.EndsAt,
			Source = entry.Source,
		})
	end
	return out
end

----------------------------------------------------------------------
-- Mutations.
----------------------------------------------------------------------
-- Returns (true, uuid) on success, (false, reason) on failure. Reasons:
--   'no_save'       — player has no selected save
--   'unknown_id'    — boosterId not in the registry
--   'unique_active' — Stacking == 'unique' and one is already active
--   'max_stacks'    — MaxStacks already met for this id
function Module.ApplyBooster(
	player: Player, boosterId: string,
	durationOverride: number?, source: string?
): (boolean, string)
	local saveData = getSave(player); if not saveData then return false, 'no_save' end
	ensureBoostersTable(saveData)
	local cfg = BoostersConfig.GetBoosterConfig(boosterId)
	if not cfg then return false, 'unknown_id' end

	-- Count active stacks of this id (live, not expired) for stacking
	-- enforcement. Replace branch picks the strongest existing stack
	-- and short-circuits if it's already the strongest.
	local now = os.time()
	local activeOfId = {}
	for uuid, entry in saveData.Boosters.Active do
		if entry.Id == boosterId then
			if entry.EndsAt == 0 or entry.EndsAt > now then
				table.insert(activeOfId, { uuid = uuid, entry = entry })
			end
		end
	end

	local stacking = cfg.Stacking or 'add'
	if stacking == 'unique' and #activeOfId > 0 then
		return false, 'unique_active'
	end
	if stacking == 'replace' and #activeOfId > 0 then
		-- Drop existing stacks; the new one replaces them.
		for _, hit in activeOfId do
			saveData.Boosters.Active[hit.uuid] = nil
		end
	end
	local cap = cfg.MaxStacks or 5
	if stacking == 'add' and #activeOfId >= cap then
		return false, 'max_stacks'
	end

	local duration = durationOverride or cfg.Duration
	local endsAt = (duration > 0) and (now + duration) or 0
	local uuid = HttpService:GenerateGUID(false)
	saveData.Boosters.Active[uuid] = {
		Id     = boosterId,
		EndsAt = endsAt,
		Source = source or cfg.Source or 'Reward',
	}

	BoosterEvent:FireClient(player, 'Applied', {
		Id = boosterId, EndsAt = endsAt, Source = source or cfg.Source or 'Reward',
	})

	-- If this booster carries a walk_speed_add effect, push the delta
	-- onto the live humanoid right away rather than waiting for the
	-- next CharacterAdded.
	for _, eff in cfg.Effects do
		if eff.Kind == 'walk_speed_add' then
			applyWalkSpeed(player)
			break
		end
	end

	return true, uuid
end

-- Manually remove a single active stack (admin / refund flow). Returns
-- true if removed.
function Module.RemoveBooster(player: Player, uuid: string): boolean
	local saveData = getSave(player); if not saveData then return false end
	ensureBoostersTable(saveData)
	if not saveData.Boosters.Active[uuid] then return false end
	saveData.Boosters.Active[uuid] = nil
	BoosterEvent:FireClient(player, 'Removed', { Uuid = uuid })
	return true
end

----------------------------------------------------------------------
-- Expiry pass. Walks every player's active list and migrates expired
-- entries to History. Cheap O(n_players × n_active) — boosters are
-- short-lived and per-player counts stay small.
----------------------------------------------------------------------
local function appendHistory(saveData: any, boosterId: string, durationSeconds: number, endedAt: number)
	saveData.Boosters.History[boosterId] = saveData.Boosters.History[boosterId] or {
		TotalSeconds = 0, LastEndedAt = 0,
	}
	local h = saveData.Boosters.History[boosterId]
	h.TotalSeconds += math.max(0, durationSeconds)
	h.LastEndedAt = endedAt
end

local function tickExpiries()
	local now = os.time()
	for _, player in Players:GetPlayers() do
		local saveData = getSave(player); if not saveData then continue end
		ensureBoostersTable(saveData)
		local hadWalkExpire = false
		for uuid, entry in saveData.Boosters.Active do
			if entry.EndsAt ~= 0 and entry.EndsAt <= now then
				local cfg = BoostersConfig.GetBoosterConfig(entry.Id)
				local duration = cfg and cfg.Duration or 0
				appendHistory(saveData, entry.Id, duration, entry.EndsAt)
				saveData.Boosters.Active[uuid] = nil
				BoosterEvent:FireClient(player, 'Expired', { Uuid = uuid, Id = entry.Id })
				if cfg then
					for _, eff in cfg.Effects do
						if eff.Kind == 'walk_speed_add' then hadWalkExpire = true; break end
					end
				end
			end
		end
		-- One reapply per player per tick — cheaper than per-entry.
		if hadWalkExpire then applyWalkSpeed(player) end
	end
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	-- Single shared accumulator — RunService.Heartbeat fires every
	-- frame, but we only need second-resolution.
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < BOOSTER_TICK_S then return end
		accumulator = 0
		tickExpiries()
	end)

	-- Warn loudly on join if a booster id stored in the save points at
	-- a config that has since been deleted. Catches config drift early
	-- in dev — production saves will continue to work (the iterator
	-- skips unknown configs), but the player loses the booster
	-- effects silently otherwise.
	Players.PlayerAdded:Connect(function(player)
		local saveData = getSave(player); if not saveData then return end
		ensureBoostersTable(saveData)
		for uuid, entry in saveData.Boosters.Active do
			if not BoostersConfig.GetBoosterConfig(entry.Id) then
				warn(string.format(
					'[BoostersServer] active booster id %q on %s has no config; skipping.',
					tostring(entry.Id), player.Name))
			end
		end
		-- Apply walk-speed addend on every respawn. Reset our tracked
		-- delta first so we don't double-add against a fresh humanoid
		-- that starts at the default base speed.
		player.CharacterAdded:Connect(function()
			AppliedWalkDelta[player] = 0
			-- Wait one frame so other systems' CharacterAdded hooks
			-- (mount, equipment) settle on a value before we add our
			-- delta on top.
			task.defer(function() applyWalkSpeed(player) end)
		end)
	end)

	Players.PlayerRemoving:Connect(function(player)
		AppliedWalkDelta[player] = nil
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/AchievementsServer"><![CDATA[-- AchievementsServer. Owner of saveData.Achievements. Two-shape progress:
--
--   * Counter   — IncrementProgress(player, trigger, amount): walks the
--                 registry for any achievements with matching `Trigger`,
--                 bumps `Progress`, marks `Completed = true` when
--                 Progress >= Goal.
--
--   * Predicate — RunUnlockPass(player): walks every achievement with
--                 a `UnlockCheck` and marks Completed for any returning
--                 true. Run on join and after gameplay events that may
--                 have changed eligibility.
--
-- Rewards are NOT auto-granted on completion (per design call). Player
-- must press Claim in the Achievements tab; ClaimRewards mutates the
-- save struct, calls economy / inventory siblings, and (if a BadgeId
-- is set) awards the linked Roblox badge via BadgeService.
--
-- BadgeService notes:
--   * Awards are RATE-LIMITED — calling AwardBadgeAsync without first
--     checking UserHasBadgeAsync will eat your quota and may temporarily
--     ban the place from awarding badges.
--   * Both calls can throw; wrap in pcall.
--   * Persist a BadgeAwarded flag in the save so re-attempts on rejoin
--     never re-fire the API.

local Players = game:GetService('Players')
local BadgeService = game:GetService('BadgeService')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local AchievementsConfig = ReplicatedModules.Data.Achievements
local RemoteService       = ReplicatedModules.Services.RemoteService

local AchievementEvent = RemoteService.GetRemote('AchievementEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Save-struct helpers.
----------------------------------------------------------------------
local function getSave(player: Player): any?
	local Saves = SystemsContainer.SavesManagerServer
	if not Saves then return nil end
	return Saves.GetPlayerSelectedSaveData(player)
end

local function ensureAchievementsTable(saveData: any)
	if typeof(saveData.Achievements) ~= 'table' then
		saveData.Achievements = {}
	end
end

local function ensureEntry(saveData: any, id: string)
	ensureAchievementsTable(saveData)
	if not saveData.Achievements[id] then
		saveData.Achievements[id] = {
			Progress = 0,
			Completed = false,
			CompletedAt = nil,
			Claimed = false,
			BadgeAwarded = false,
		}
	end
end

----------------------------------------------------------------------
-- Prerequisite gate. Returns true if every Prerequisites id in cfg has
-- been completed by the player.
----------------------------------------------------------------------
local function prereqsMet(saveData: any, cfg): boolean
	if not cfg.Prerequisites then return true end
	for _, prereqId in cfg.Prerequisites do
		local entry = saveData.Achievements[prereqId]
		if not entry or not entry.Completed then return false end
	end
	return true
end

----------------------------------------------------------------------
-- Marks an achievement Completed (if not already). Fires a remote so
-- the Achievements tab can show the completion toast immediately.
----------------------------------------------------------------------
local function markCompleted(player: Player, saveData: any, id: string)
	ensureEntry(saveData, id)
	local entry = saveData.Achievements[id]
	if entry.Completed then return end
	entry.Completed = true
	entry.CompletedAt = os.time()
	AchievementEvent:FireClient(player, AchievementsConfig.Actions.Completed, { Id = id })

	-- Optional toast.
	local Toast = SystemsContainer.ToastServer
	if Toast and Toast.NotifyAchievementUnlocked then
		Toast.NotifyAchievementUnlocked(player, id)
	end
end

----------------------------------------------------------------------
-- Counter-form progress. Called from gameplay event sites:
--   AchievementsServer.IncrementProgress(player, Triggers.PvEKill, 1)
-- Amount may be > 1 (e.g. CurrencyEarned).
----------------------------------------------------------------------
function Module.IncrementProgress(player: Player, trigger: string, amount: number)
	if amount == nil or amount == 0 then return end
	local saveData = getSave(player); if not saveData then return end
	ensureAchievementsTable(saveData)

	for id, cfg in AchievementsConfig.Achievements do
		if cfg.Trigger ~= trigger then continue end
		if not cfg.Goal then continue end
		ensureEntry(saveData, id)
		local entry = saveData.Achievements[id]
		if entry.Completed then continue end
		if not prereqsMet(saveData, cfg) then continue end
		entry.Progress = (entry.Progress or 0) + amount
		AchievementEvent:FireClient(player, AchievementsConfig.Actions.Progress, {
			Id = id, Progress = entry.Progress, Goal = cfg.Goal,
		})
		if entry.Progress >= cfg.Goal then
			markCompleted(player, saveData, id)
		end
	end
end

----------------------------------------------------------------------
-- Predicate-form sweep. Run on join + after relevant gameplay events
-- (level-up, quest complete, …) so non-counter achievements catch up
-- without having to manually wire each one to a trigger.
----------------------------------------------------------------------
function Module.RunUnlockPass(player: Player)
	local saveData = getSave(player); if not saveData then return end
	ensureAchievementsTable(saveData)
	for id, cfg in AchievementsConfig.Achievements do
		if not cfg.UnlockCheck then continue end
		ensureEntry(saveData, id)
		local entry = saveData.Achievements[id]
		if entry.Completed then continue end
		if not prereqsMet(saveData, cfg) then continue end
		if cfg.UnlockCheck(player, saveData) then
			markCompleted(player, saveData, id)
		end
	end
end

----------------------------------------------------------------------
-- BadgeService award. Idempotent: persisted BadgeAwarded flag short-
-- circuits the API. UserHasBadgeAsync gate prevents re-awarding badges
-- the player earned in another save / before this system existed.
----------------------------------------------------------------------
local function awardBadge(player: Player, saveData: any, id: string, badgeId: number): boolean
	local entry = saveData.Achievements[id]
	if entry.BadgeAwarded then return true end

	-- Both BadgeService calls can throw on network errors / rate limits.
	local hasOk, hasBadge = pcall(function()
		return BadgeService:UserHasBadgeAsync(player.UserId, badgeId)
	end)
	if hasOk and hasBadge then
		entry.BadgeAwarded = true
		return true
	end

	local awardOk, awarded = pcall(function()
		return BadgeService:AwardBadgeAsync(player.UserId, badgeId)
	end)
	if awardOk and awarded then
		entry.BadgeAwarded = true
		return true
	end
	-- Soft fail: badge wasn't awarded, but the achievement claim still
	-- succeeded. Logged for ops; player can re-claim later (BadgeAwarded
	-- stays false so the next attempt retries the API).
	warn(string.format(
		'[AchievementsServer] BadgeService award failed for %s on %s (badge %d).',
		id, player.Name, badgeId))
	return false
end

----------------------------------------------------------------------
-- Reward dispatch. Called from ClaimRewards once the achievement is
-- known-Completed and the player has not yet Claimed. Each branch
-- calls the canonical sibling mutation rather than poking save fields
-- directly, so XP triggers level-ups, items go through inventory
-- validation, etc.
----------------------------------------------------------------------
local function grantRewards(player: Player, rewards)
	if not rewards then return end
	local DataEdit = SystemsContainer.DataEditServer
	if rewards.Currency and rewards.Currency > 0 and DataEdit and DataEdit.GiveCurrencyToPlayer then
		DataEdit.GiveCurrencyToPlayer(player, rewards.Currency)
	end
	if rewards.Experience and rewards.Experience > 0 and DataEdit and DataEdit.GiveExperienceToPlayer then
		DataEdit.GiveExperienceToPlayer(player, rewards.Experience)
	end
	if rewards.Items then
		local Inv = SystemsContainer.PlayerInventoryServer
		if Inv and Inv.GiveQuantityOfItemIdToPlayer then
			for itemId, qty in rewards.Items do
				Inv.GiveQuantityOfItemIdToPlayer(player, itemId, qty)
			end
		end
	end
	if rewards.Titles then
		local Titles = SystemsContainer.TitlesServer
		if Titles and Titles.AttemptUnlockTitle then
			for _, titleId in rewards.Titles do
				Titles.AttemptUnlockTitle(player, titleId)
			end
		end
	end
	if rewards.Boosters then
		local Boosters = SystemsContainer.BoostersServer
		if Boosters and Boosters.ApplyBooster then
			for _, b in rewards.Boosters do
				Boosters.ApplyBooster(player, b.Id, b.Duration, 'Achievement')
			end
		end
	end
end

----------------------------------------------------------------------
-- Claim. Player-initiated mutation. Idempotent — returns false if the
-- achievement is not Completed yet, already Claimed, or doesn't exist.
----------------------------------------------------------------------
function Module.ClaimRewards(player: Player, id: string): (boolean, string)
	local saveData = getSave(player); if not saveData then return false, 'no_save' end
	local cfg = AchievementsConfig.GetAchievementConfig(id)
	if not cfg then return false, 'unknown_id' end
	ensureEntry(saveData, id)
	local entry = saveData.Achievements[id]
	if not entry.Completed then return false, 'not_completed' end
	if entry.Claimed then return false, 'already_claimed' end

	-- Mark Claimed BEFORE granting so a partial failure (e.g. inventory
	-- full) doesn't allow the player to re-spam Claim and dupe rewards.
	-- Reward grants are best-effort; inventory full → item is dropped
	-- on the floor, not held in a queue.
	entry.Claimed = true
	grantRewards(player, cfg.Rewards)

	if cfg.BadgeId then
		awardBadge(player, saveData, id, cfg.BadgeId)
	end

	AchievementEvent:FireClient(player, AchievementsConfig.Actions.Claimed, { Id = id })
	return true, ''
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	local clientRequest = RemoteService.GetRemote('AchievementClaimEvent', 'RemoteEvent', false)
	clientRequest.OnServerEvent:Connect(function(player, action, payload)
		if action == AchievementsConfig.Actions.Claim and typeof(payload) == 'table' and typeof(payload.Id) == 'string' then
			Module.ClaimRewards(player, payload.Id)
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		-- Re-run unlock pass on join: catches predicate-form achievements
		-- whose conditions became true while offline (e.g. data was
		-- edited admin-side, or a save migration crossed a threshold).
		task.defer(function()
			Module.RunUnlockPass(player)
		end)
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/LevelGatesServer"><![CDATA[-- LevelGatesServer — owner of the SERVER-WIDE level-gate bypass map.
--
-- Two distinct bypass mechanisms in the codebase:
--   * Per-player flag (saveData.Flags.LevelGateBypass) — persists on
--     the save; toggled via Cmdr `SetLevelGateBypass <player> <system> <bool>`.
--   * Global map (this module's GlobalBypass) — IN-MEMORY only, lives
--     for the current server instance. Set via Cmdr
--     `SetGlobalLevelGateBypass <system> <bool>`. Useful for "everyone
--     in this test server has Forge gates off until restart" without
--     touching saves.
--
-- Both shapes are identical: a table of booleans with an `all` master
-- and per-system keys (skills/crafting/forge/gems/enchant). `all=true`
-- bypasses every system; per-system keys bypass only that one. This
-- lets ops scope a bypass to exactly the system they're testing
-- without dropping every gate.
--
-- The global map is replicated to clients via ReplicatedData using a
-- public 'ServerFlags' category — same wire that PlayerData uses, so
-- there's no extra remote channel and the flip arrives at the client
-- on the next replication tick (≤ 0.25 s).

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local ReplicatedData = ReplicatedModules.Services.ReplicatedData
local LevelGatesConfig = ReplicatedModules.Data.LevelGates

local SERVER_FLAGS_CATEGORY = 'ServerFlags'

local SystemsContainer = {}

local Module = {}

-- In-memory map. Resets on every server start. `all` is the master;
-- per-system keys default to false. Layout matches saveData.Flags.LevelGateBypass
-- so LevelGates.IsGlobalBypassed can read either shape uniformly.
local GlobalBypass = {
	all      = false,
	skills   = false,
	crafting = false,
	forge    = false,
	gems     = false,
	enchant  = false,
}

----------------------------------------------------------------------
-- Validation helper. The cmdr command surfaces this error verbatim
-- so operators see a clear message when they typo a system name.
----------------------------------------------------------------------
local VALID_KEYS: {[string]: true} = { all = true }
for _, sys in LevelGatesConfig.Systems do VALID_KEYS[sys] = true end

function Module.IsValidSystemKey(key: string): boolean
	return VALID_KEYS[key] == true
end

function Module.GetValidKeysList(): string
	-- Stable order for cmdr help text. `all` first, rest in registry order.
	local keys = { 'all' }
	for _, sys in LevelGatesConfig.Systems do
		table.insert(keys, sys)
	end
	return table.concat(keys, ' | ')
end

----------------------------------------------------------------------
-- Replication: copy the full map into the public 'ServerFlags'
-- category. Cheap diff-only send is handled by ReplicatedData.
----------------------------------------------------------------------
local function publishFlags()
	-- Shallow copy so future mutations don't write through the
	-- replicated snapshot.
	local snapshot = {}
	for k, v in GlobalBypass do snapshot[k] = v end
	ReplicatedData.SetData(SERVER_FLAGS_CATEGORY, {
		LevelGateBypass = snapshot,
	})
end

----------------------------------------------------------------------
-- Public API.
----------------------------------------------------------------------
-- Returns the entire map (caller treats as read-only). Server gates
-- pass this directly to LevelGates.CanUseSystem.
function Module.GetGlobalBypass(): { [string]: boolean }
	return GlobalBypass
end

-- Legacy single-bool accessor. Returns true if either the `all` master
-- is set OR (when systemId is provided) the system-specific key is set.
function Module.IsGloballyBypassed(systemId: string?): boolean
	if GlobalBypass.all == true then return true end
	if systemId ~= nil and GlobalBypass[systemId] == true then return true end
	return false
end

-- Toggle one key in the map. `systemKey` must be one of the valid keys
-- (returns false on bad input). Returns true on actual change, false
-- on no-op.
function Module.SetGlobalBypass(systemKey: string, enabled: boolean): boolean
	if not Module.IsValidSystemKey(systemKey) then return false end
	local v = enabled == true
	if GlobalBypass[systemKey] == v then return false end
	GlobalBypass[systemKey] = v
	publishFlags()
	return true
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	-- Initial publish so any client joining sees the current state.
	-- (ReplicatedData replays Public entries to new joiners.)
	publishFlags()
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/EnemyTelegraphServer"><![CDATA[-- EnemyTelegraphServer — server-side authoritative dispatcher for the
-- attack-telegraph system. See ReplicatedStorage/.../EnemyTelegraph
-- for the shared types + action enum.
--
-- Server doesn't render the visual — it just publishes the telegraph
-- parameters to every client via FireAllClients on the
-- EnemyTelegraphEvent remote. Clients build the actual translucent
-- ground plane + progress bar locally (EnemyTelegraphClient).
--
-- Every Show returns a string token; the same token can be passed to
-- Hide() to stop the telegraph early (e.g. the boar gets stunned mid-
-- windup). If Hide isn't called, the client auto-removes the visual
-- when its local timer reaches Duration.
--
-- Thin module on purpose — no game logic, just a remote relay. Boar
-- and Generic AI call directly through SystemsContainer.

local HttpService = game:GetService('HttpService')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local RemoteService = ReplicatedModules.Services.RemoteService
local EnemyTelegraph = ReplicatedModules.Services.EnemyTelegraph

local TelegraphEvent = RemoteService.GetRemote('EnemyTelegraphEvent', 'RemoteEvent', false)

local Module = {}

----------------------------------------------------------------------
-- Show a telegraph to all clients. Params:
--   * Kind     : 'Circle' | 'Rect' | 'Cone'  (required)
--   * Origin   : CFrame                       (required; world position +
--                facing for directional shapes)
--   * Size     : Vector3                      (Rect / Cone — see header)
--   * Radius   : number?                      (Circle / Cone)
--   * Angle    : number?                      (Cone — full cone angle in radians)
--   * Duration : number                       (windup length in seconds; the
--                progress bar fills over this and the visual auto-hides)
--   * Color    : Color3?                      (override default red-orange)
--
-- Returns the unique id token. Use Hide(id) to stop the telegraph
-- early; otherwise it auto-clears at Duration.
----------------------------------------------------------------------
function Module.Show(params: {
	Kind: string,
	Origin: CFrame,
	Size: Vector3?,
	Radius: number?,
	Angle: number?,
	Duration: number,
	Color: Color3?,
}): string
	local id = HttpService:GenerateGUID(false)
	-- FireAllClients: telegraphs are spectator-visible (a player should
	-- see "the boar is about to charge that other guy" so nearby
	-- combatants can react too). No interest culling — the client-side
	-- renderer culls by distance if it ever becomes a perf issue.
	TelegraphEvent:FireAllClients(EnemyTelegraph.Actions.Show, {
		Id = id,
		Kind = params.Kind,
		Origin = params.Origin,
		Size = params.Size,
		Radius = params.Radius,
		Angle = params.Angle,
		Duration = params.Duration,
		Color = params.Color,
	})
	return id
end

-- Stop a telegraph early. Idempotent: a stale id (already auto-hidden)
-- is silently ignored client-side. Always safe to call from any
-- post-windup branch (damage applied / target invalidated / stun
-- interruption / etc.).
function Module.Hide(id: string)
	if typeof(id) ~= 'string' or id == '' then return end
	TelegraphEvent:FireAllClients(EnemyTelegraph.Actions.Hide, { Id = id })
end

function Module.Start() end
function Module.Init() end

return Module
]]></Source>
		<Source path="ServerStorage/Core/SkillRuntimeServer"><![CDATA[-- SkillRuntimeServer — executor for the unified skill runtime.
-- Consumes recipes from Data/CombatSkills (or any caller-provided
-- table), dispatches each Step kind, and applies damage / status /
-- VFX / telegraph effects via the existing systems.
--
-- One server-side entry point: `RunRecipe(caster, recipeId)`. Used by:
--   * Mob AI (Generic.AttackNearbyTarget, etc.) — pass the AI's model
--     wrapped in CasterContext.FromModel.
--   * Boss AI (BossServer pattern execution) — same path.
--   * Player skills (SkillsServer.AttemptPlayerUseSkill) — pass the
--     player's character wrapped in CasterContext.FromCharacter.
--     The existing skill-tree gate (cooldown, unlock, level) runs
--     BEFORE the runtime — this module is purely "execute the recipe
--     once cleared to fire."
--
-- Each step yields where appropriate (windup waits, recovery delays).
-- Callers should run the recipe in its own task.spawn / coroutine if
-- they don't want to block the rest of their AI loop.

local CollectionService = game:GetService('CollectionService')

local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

local DamageModule = ServerModules.Modules.DamageModule

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CombatSkills    = ReplicatedModules.Data.CombatSkills
local CombatFactions  = ReplicatedModules.Data.CombatFactions
local SkillRuntime    = ReplicatedModules.Services.SkillRuntime
local CharacterStates = ReplicatedModules.Services.CharacterStates
local EnemyTelegraph  = ReplicatedModules.Services.EnemyTelegraph
local RemoteService   = ReplicatedModules.Services.RemoteService

-- Visual-only cue channel: server fires, every client renders a
-- short-lived particle / screen flash / etc. No damage, no logic.
local SkillVfxEvent = RemoteService.GetRemote('SkillVfxEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- CasterContext — uniform wrapper around "who's casting this" so the
-- executor doesn't branch on player-vs-mob. Two factory helpers:
----------------------------------------------------------------------
export type CasterContext = {
	Model: Model,
	Humanoid: Humanoid,
	HumanoidRootPart: BasePart?,
	OwnerPlayer: Player?,         -- nil for NPC casters
	Hostile: 'mob' | 'player',    -- targeting mode resolution
}

function Module.CasterFromModel(model: Model, ownerPlayer: Player?): CasterContext?
	if not model then return nil end
	local humanoid = model:FindFirstChildOfClass('Humanoid')
	if not humanoid then return nil end
	local hrp = model:FindFirstChild('HumanoidRootPart')
	-- 'mob' if no owning player; 'player' otherwise. Used to pick the
	-- target tag (mob hits PLAYER_CHARACTER; player hits AICharacter).
	local hostile = ownerPlayer and 'player' or 'mob'
	return {
		Model = model,
		Humanoid = humanoid,
		HumanoidRootPart = hrp :: BasePart?,
		OwnerPlayer = ownerPlayer,
		Hostile = hostile :: any,
	}
end

----------------------------------------------------------------------
-- Target resolution for hit queries. Faction checks live in CombatFactions
-- so NPCs can hit players and hostile NPCs without a second runtime.
----------------------------------------------------------------------
local function resolveTargetTags(caster: CasterContext, targetMode: string): {string}
	if targetMode == SkillRuntime.TargetModes.Self then
		return {}
	end
	return CombatFactions.GetCandidateTagsForTargetMode(caster.Model, targetMode :: any)
end

local function getTargetCharacters(caster: CasterContext, targetMode: string): {Model}
	if targetMode == SkillRuntime.TargetModes.Self then
		return { caster.Model }
	end

	local out: {Model} = {}
	local tags = resolveTargetTags(caster, targetMode)
	for _, tag in tags do
		for _, instance in CollectionService:GetTagged(tag) do
			if not instance:IsA('Model') then
				continue
			end
			local ok = CombatFactions.CanHit(caster.Model, instance, {
				TargetMode = targetMode :: any,
				AllowSelf = targetMode == SkillRuntime.TargetModes.Self,
			})
			if ok then
				table.insert(out, instance)
			end
		end
	end
	return out
end

----------------------------------------------------------------------
-- Telegraph hit-zone math. Mirrors the EnemyTelegraphClient
-- renderer's shape conventions exactly so the visible zone IS the
-- hit zone (player contract).
--
-- Hit detection iterates each tagged target (PLAYER_CHARACTER /
-- AICharacter) and runs `isInTelegraphZone` per-candidate; no
-- OverlapParams pre-pass — at typical N (single-digit candidates per
-- swing), the per-target predicate is cheaper than building +
-- filtering an OverlapBox result.
--
-- Resolve the *effective* origin used by the predicate. Rect / Cone
-- telegraphs are visually pushed forward by HALF the part's depth
-- (see EnemyTelegraphClient renderer); the hit math pushes by the
-- same amount so visible-edge == hit-edge.
local function effectiveOrigin(originCF: CFrame, telegraph: any): CFrame
	local kind = telegraph.Kind
	if kind == 'Rect' then
		local size = telegraph.Size or Vector3.new(4, 0, 8)
		return EnemyTelegraph.ForwardOffset(originCF, size.Z * 0.5)
	elseif kind == 'Cone' then
		local r = telegraph.Radius or 6
		return EnemyTelegraph.ForwardOffset(originCF, r * 0.5)
	end
	-- Circle: no forward push (centered on attacker).
	return originCF
end

local function isInTelegraphZone(originCF: CFrame, telegraph: any, targetPos: Vector3): boolean
	-- Evaluate target position in OBJECT space of the *effective*
	-- origin (the same one the visual is rendered at) so the predicate
	-- and the visual stay aligned. Circle pivots on the attacker;
	-- Rect / Cone pivot on the forward-offset center.
	local effective = effectiveOrigin(originCF, telegraph)
	local local_ = effective:PointToObjectSpace(targetPos)
	local kind = telegraph.Kind
	if kind == 'Circle' then
		local r = telegraph.Radius or 4
		-- Distance check on the XZ plane (ignore Y so prone targets
		-- still land in the disc).
		local dx, dz = local_.X, local_.Z
		return (dx * dx + dz * dz) <= (r * r)
	elseif kind == 'Rect' then
		local size = telegraph.Size or Vector3.new(4, 0, 8)
		-- Centered on the pushed origin: object-space spans
		-- [-size/2, +size/2] on both X and Z.
		return math.abs(local_.X) <= size.X * 0.5
		   and math.abs(local_.Z) <= size.Z * 0.5
	elseif kind == 'Cone' then
		local r = telegraph.Radius or 6
		-- Cone is rendered as a wide rect (1.6r × r) pushed forward;
		-- match the same box for hit-testing. The visual approximates
		-- a fan, but the player contract is "what you see is what
		-- hits" — keep the predicate aligned with the visual.
		return math.abs(local_.X) <= r * 0.8
		   and math.abs(local_.Z) <= r * 0.5
	end
	return false
end

----------------------------------------------------------------------
-- Origin resolution — convert a step's optional OriginMode to an
-- actual CFrame.
----------------------------------------------------------------------
local function resolveOriginCFrame(caster: CasterContext, telegraph: any?, fallback: CFrame): CFrame
	if not telegraph then return fallback end
	local mode = telegraph.Origin
	if mode == nil or mode == SkillRuntime.OriginModes.Caster then
		return caster.Model:GetPivot()
	elseif mode == SkillRuntime.OriginModes.Fixed and typeof(telegraph.OriginCFrame) == 'CFrame' then
		return telegraph.OriginCFrame
	end
	return fallback
end

----------------------------------------------------------------------
-- Damage + status application to characters inside a zone. Skips the
-- caster's own model (a mob shouldn't hit itself with its own AOE).
----------------------------------------------------------------------
local function applyHitsInZone(
	caster: CasterContext, originCF: CFrame, telegraph: any,
	damage: number, status: any?, targetMode: string)
	targetMode = targetMode or SkillRuntime.TargetModes.Hostiles
	for _, candidate in getTargetCharacters(caster, targetMode) do
		if candidate == caster.Model and targetMode ~= SkillRuntime.TargetModes.Self then continue end
		local hrp = candidate:FindFirstChild('HumanoidRootPart')
		local pos = (hrp and hrp.Position) or candidate:GetPivot().Position
		if not isInTelegraphZone(originCF, telegraph, pos) then continue end
		local humanoid = candidate:FindFirstChildOfClass('Humanoid')
		if not humanoid or humanoid.Health <= 0 then continue end

		-- IFrame respect (same as the existing Generic AttackNearbyTarget path).
		local hasIFrames = CharacterStates.GetStateTemporary(candidate, 'IFrames') ~= nil
		if hasIFrames then continue end

		if damage and damage > 0 then
			DamageModule.DamageHumanoid(humanoid, damage, caster.OwnerPlayer or caster.Model)
		end
		if status and SystemsContainer.StatusEffectsRuntime
			and SystemsContainer.StatusEffectsRuntime.Apply then
			SystemsContainer.StatusEffectsRuntime.Apply(candidate, status.Id, {
				Duration = status.Duration,
				Potency  = status.Potency,
				Source = caster.OwnerPlayer,
			})
		end
	end
end

----------------------------------------------------------------------
-- Step-kind dispatch.
----------------------------------------------------------------------
local function runTelegraphHit(caster: CasterContext, step: any, targetMode: string)
	local Telegraph = SystemsContainer.EnemyTelegraphServer
	local windup = math.max(0.05, tonumber(step.Windup) or 0.3)
	local originCF = resolveOriginCFrame(caster, step.Telegraph, caster.Model:GetPivot())
	local telegraphId
	if Telegraph and Telegraph.Show then
		telegraphId = Telegraph.Show({
			Kind     = step.Telegraph.Kind,
			Origin   = originCF,
			Size     = step.Telegraph.Size,
			Radius   = step.Telegraph.Radius,
			Angle    = step.Telegraph.Angle,
			Duration = windup,
		})
	end
	task.wait(windup)
	if telegraphId and Telegraph and Telegraph.Hide then Telegraph.Hide(telegraphId) end
	-- Re-resolve origin AFTER windup so a moving caster's hit lands
	-- where they ARE, not where they were when the telegraph showed.
	-- The telegraph visual is locked to the windup-start pose; the
	-- damage zone matches the visual to keep the player contract
	-- ("clear the red zone before the bar fills").
	applyHitsInZone(caster, originCF, step.Telegraph, step.Damage or 0, step.Status, targetMode)
	if step.Recovery and step.Recovery > 0 then task.wait(step.Recovery) end
end

local function runPositionalHits(caster: CasterContext, step: any, targetMode: string)
	local Telegraph = SystemsContainer.EnemyTelegraphServer
	local windup = math.max(0.05, tonumber(step.Windup) or 0.5)
	local casterCF = caster.Model:GetPivot()
	-- Show every telegraph at once; collect ids for synchronized hide.
	local ids = {}
	local zones = {}
	for _, offset in (step.Offsets or {}) do
		local zoneCF = casterCF * CFrame.new(offset)
		zones[#zones + 1] = zoneCF
		if Telegraph and Telegraph.Show then
			ids[#ids + 1] = Telegraph.Show({
				Kind     = step.Telegraph.Kind,
				Origin   = zoneCF,
				Size     = step.Telegraph.Size,
				Radius   = step.Telegraph.Radius,
				Angle    = step.Telegraph.Angle,
				Duration = windup,
			})
		end
	end
	task.wait(windup)
	for _, id in ids do if Telegraph and Telegraph.Hide then Telegraph.Hide(id) end end
	for _, zoneCF in zones do
		applyHitsInZone(caster, zoneCF, step.Telegraph, step.Damage or 0, step.Status, targetMode)
	end
	if step.Recovery and step.Recovery > 0 then task.wait(step.Recovery) end
end

local function runWave(caster: CasterContext, step: any, targetMode: string)
	-- Sample N sub-hits along the travel path. Each sub-hit shows a
	-- small segment of the wave's full rect; the visible illusion of
	-- "the wave swept through" comes from chained telegraphs. Each
	-- sub-hit deals the full damage value — players caught in the
	-- wave's path take 1 hit, regardless of how many segments overlap
	-- their position, because we de-dup hits per-character.
	local Telegraph = SystemsContainer.EnemyTelegraphServer
	local segmentLength = step.Length or 4
	local width = step.Width or 6
	local travel = step.TravelDistance or 24
	local travelTime = math.max(0.1, step.TravelTime or 0.6)
	local segments = math.max(2, math.ceil(travel / segmentLength))
	local segmentTime = travelTime / segments
	local casterCF = caster.Model:GetPivot()
	-- De-dup so a player isn't hit twice by two adjacent segments.
	local hitOnce: {[Model]: true} = {}
	for i = 0, segments - 1 do
		local segOffset = i * segmentLength
		local segCF = casterCF * CFrame.new(0, 0, -(segOffset + segmentLength * 0.5))
		local id
		if Telegraph and Telegraph.Show then
			id = Telegraph.Show({
				Kind = 'Rect',
				Origin = segCF,
				Size = Vector3.new(width, 0, segmentLength),
				Duration = segmentTime,
			})
		end
		task.wait(segmentTime)
		if id and Telegraph and Telegraph.Hide then Telegraph.Hide(id) end
		-- Resolve hits in this segment, skipping characters already hit.
		for _, candidate in getTargetCharacters(caster, targetMode) do
			if (candidate == caster.Model and targetMode ~= SkillRuntime.TargetModes.Self) or hitOnce[candidate] then continue end
			local hrp = candidate:FindFirstChild('HumanoidRootPart')
			local pos = (hrp and hrp.Position) or candidate:GetPivot().Position
			if not isInTelegraphZone(segCF, { Kind = 'Rect', Size = Vector3.new(width, 0, segmentLength) }, pos) then
				continue
			end
			local humanoid = candidate:FindFirstChildOfClass('Humanoid')
			if not humanoid or humanoid.Health <= 0 then continue end
			if CharacterStates.GetStateTemporary(candidate, 'IFrames') ~= nil then continue end
			if step.Damage and step.Damage > 0 then
				DamageModule.DamageHumanoid(humanoid, step.Damage, caster.OwnerPlayer or caster.Model)
			end
			if step.Status and SystemsContainer.StatusEffectsRuntime then
				SystemsContainer.StatusEffectsRuntime.Apply(candidate, step.Status.Id, {
					Duration = step.Status.Duration,
					Potency  = step.Status.Potency,
					Source = caster.OwnerPlayer,
				})
			end
			hitOnce[candidate] = true
		end
	end
	if step.Recovery and step.Recovery > 0 then task.wait(step.Recovery) end
end

local function runStatusZone(caster: CasterContext, step: any, targetMode: string)
	-- Same telegraph + windup as TelegraphHit, but no damage. The
	-- visual cue matches the hit zone; damage path is intentionally
	-- skipped so zero-damage "field" effects don't paint a misleading
	-- damage indicator.
	local Telegraph = SystemsContainer.EnemyTelegraphServer
	local windup = math.max(0.05, tonumber(step.Windup) or 0.3)
	local originCF = resolveOriginCFrame(caster, step.Telegraph, caster.Model:GetPivot())
	local telegraphId
	if Telegraph and Telegraph.Show then
		telegraphId = Telegraph.Show({
			Kind     = step.Telegraph.Kind,
			Origin   = originCF,
			Size     = step.Telegraph.Size,
			Radius   = step.Telegraph.Radius,
			Angle    = step.Telegraph.Angle,
			Duration = windup,
		})
	end
	task.wait(windup)
	if telegraphId and Telegraph and Telegraph.Hide then Telegraph.Hide(telegraphId) end
	-- Status-only application (damage = 0).
	applyHitsInZone(caster, originCF, step.Telegraph, 0, step.Status, targetMode)
	if step.Recovery and step.Recovery > 0 then task.wait(step.Recovery) end
end

local function runVfx(caster: CasterContext, step: any)
	-- Visual-only — fire to all clients. SkillVfxClient handles the
	-- render side.
	if not step.Cue then return end
	local originCF = resolveOriginCFrame(caster, step, caster.Model:GetPivot())
	SkillVfxEvent:FireAllClients({
		Cue = step.Cue,
		OriginCFrame = originCF,
		Duration = step.Duration,
		Args = step.Args,
	})
end

local function runWait(_caster: CasterContext, step: any)
	local s = tonumber(step.Seconds) or 0
	if s > 0 then task.wait(s) end
end

local function runAnimation(caster: CasterContext, step: any)
	-- Animation lookup convention: the AI module loads animations into
	-- a dictionary on init; callers stash the dictionary on the caster
	-- via SetAnimationDictionary. Player path can register the same
	-- way once player skills migrate.
	local dict = (caster :: any).Animations
	if not dict or not step.AnimationId then return end
	local track = dict[step.AnimationId]
	if not track then return end
	track:Play(step.FadeTime or 0.1, 1, step.Speed or 1)
	if step.WaitForFinish then track.Stopped:Wait() end
end

local function runCinematicCue(_caster: CasterContext, step: any)
	-- Forward into the existing CinematicEvent dispatch.
	if not step.CueKind then return end
	local CinematicEvent = RemoteService.GetRemote('CinematicEvent', 'RemoteEvent', false)
	if not CinematicEvent then return end
	CinematicEvent:FireAllClients(step.CueKind, step.Args or {})
end

local function runMove(caster: CasterContext, step: any)
	if not caster.Humanoid or not caster.HumanoidRootPart then return end
	local startCF = caster.Model:GetPivot()
	local target = startCF * CFrame.new(step.Offset or Vector3.new(0, 0, -8))
	local prevSpeed = caster.Humanoid.WalkSpeed
	caster.Humanoid.WalkSpeed = step.Speed or prevSpeed
	caster.Humanoid:MoveTo(target.Position)
	-- Block until move finishes (or 2s safety cap).
	local mc = caster.Humanoid.MoveToFinished
	if mc then mc:Wait() end
	caster.Humanoid.WalkSpeed = prevSpeed
end

local KIND_DISPATCH: { [string]: (CasterContext, any, string) -> () } = {
	[SkillRuntime.StepKinds.TelegraphHit]   = runTelegraphHit,
	[SkillRuntime.StepKinds.PositionalHits] = runPositionalHits,
	[SkillRuntime.StepKinds.Wave]           = runWave,
	[SkillRuntime.StepKinds.StatusZone]     = runStatusZone,
	[SkillRuntime.StepKinds.Vfx]            = function(c, s) runVfx(c, s) end,
	[SkillRuntime.StepKinds.Wait]           = function(c, s) runWait(c, s) end,
	[SkillRuntime.StepKinds.Animation]      = function(c, s) runAnimation(c, s) end,
	[SkillRuntime.StepKinds.CinematicCue]   = function(c, s) runCinematicCue(c, s) end,
	[SkillRuntime.StepKinds.Move]           = function(c, s) runMove(c, s) end,
}

----------------------------------------------------------------------
-- Public entry: RunRecipe(caster, recipeId).
-- Yields until the recipe completes. Caller decides whether to
-- task.spawn() or block on it.
----------------------------------------------------------------------
function Module.RunRecipe(caster: CasterContext, recipeId: string): boolean
	local recipe = CombatSkills.GetRecipe(recipeId)
	if not recipe then
		warn(string.format('[SkillRuntimeServer] unknown recipe %q', recipeId))
		return false
	end
	if not caster or not caster.Model or not caster.Model.Parent then return false end
	if caster.Humanoid and caster.Humanoid.Health <= 0 then return false end

	-- Top-of-recipe animation (optional). Plays alongside whatever
	-- per-step animations the steps emit.
	if recipe.Animation then
		runAnimation(caster, { AnimationId = recipe.Animation })
	end

	local targetMode = recipe.TargetMode or SkillRuntime.TargetModes.Hostiles
	for _, step in recipe.Steps do
		-- Halt mid-recipe if the caster dies / despawns / is stunned.
		if not caster.Model or not caster.Model.Parent then return false end
		if caster.Humanoid.Health <= 0 then return false end
		if CharacterStates.GetState(caster.Model, 'Stunned') then
			return false
		end
		local fn = KIND_DISPATCH[step.Kind]
		if fn then
			fn(caster, step, targetMode)
		else
			warn(string.format('[SkillRuntimeServer] unknown step kind %q in recipe %q',
				tostring(step.Kind), recipeId))
		end
	end
	return true
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start() end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/BossServer"><![CDATA[-- BossServer — phase tracker + recipe-queue executor for every boss
-- in the world. One module instance handles every active boss; per-
-- boss state is stashed in `Active` keyed by Model. Bosses are
-- declared in Data/Bosses.luau and authored as recipe-id rotations
-- (recipes themselves live in Data/CombatSkills.luau).
--
-- Flow:
--   * EnemyServer.InitializeMob detects mobConfig.BossId and calls
--     BossServer.Initialize(model). We snapshot MaxHealth, open the
--     BossHealthbarWidget via BossHealthbarEvent, run the boss's
--     IntroRecipe (if any), and start the BT loop.
--   * The BT root is a single sequence that walks
--     ExecuteNextRecipe → wait → repeat. ExecuteNextRecipe asks the
--     range-aware selector for the next recipe id (range-gated +
--     weighted random, with no-immediate-repeat guard) and yields
--     on SkillRuntimeServer.RunRecipe. See selectNextRecipeId.
--   * Humanoid.HealthChanged fires phase transitions: when HP
--     fraction crosses below the next phase's BelowHpFraction, we
--     bump PhaseIndex, fire EnterRecipe, apply StatOverrides, and
--     reset selector state so the new phase's pool kicks in.
--   * Humanoid.Died fires the DeathRecipe and closes the healthbar.

local CollectionService = game:GetService('CollectionService')

local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

local ComponentBehaviorTree = ServerModules.Libraries.ComponentBehaviorTree

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

-- Bosses moved to ServerStorage in the Phase 1 mirror — boss recipe
-- pools / phase HP gates / stat overrides are server-only data and
-- the public copy was deleted. See ROADMAP.md §"Phase 1."
local BossesConfig    = ServerModules.Data.Bosses
local CombatShared    = ReplicatedModules.Services.CombatShared
local RemoteService   = ReplicatedModules.Services.RemoteService
local BossHealthbarShared = ReplicatedModules.Services.BossHealthbarShared

local BossHealthbarEvent = RemoteService.GetRemote('BossHealthbarEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

-- Per-boss state. Keyed by the boss Model so multiple bosses can run
-- independently. Each entry:
--   { Config, MaxHealth, PhaseIndex, BarIds={}, BTSeq?, StatSnapshot={},
--     TargetModel?, LastRecipeId?, SequentialIndex? }
local Active: { [Model]: any } = {}

-- BT shared across all bosses; per-boss sequences attached as we go,
-- mirroring the EnemyServer pattern.
local BossBT

----------------------------------------------------------------------
-- Helpers.
----------------------------------------------------------------------
local function broadcastHealthbar(action: string, payload)
	BossHealthbarEvent:FireAllClients(action, payload)
end

-- Build the per-bar config list for the BossHealthbarWidget. One bar
-- per phase; each phase's MaxHP is the boss's MaxHealth so each bar
-- visually drains in sequence as phases progress.
local function buildBarConfigs(state)
	local bars = {}
	for i, phase in state.Config.Phases do
		table.insert(bars, {
			Id        = state.Config.Id .. '_p' .. tostring(i),
			Label     = phase.Label,
			MaxHP     = state.MaxHealth,
			-- Phases AFTER the current one are visually full; phases
			-- BEFORE the current are drained to 0; the active phase
			-- shows the live HP. Initial state always has phase 1
			-- active so phase 1 = MaxHealth, phase 2..N = MaxHealth.
			CurrentHP = state.MaxHealth,
		})
	end
	return bars
end

-- Return phase index that matches the current HP fraction. Phases
-- declared in descending BelowHpFraction order; we pick the FIRST
-- whose threshold is still >= current. (E.g. {1.0, 0.66, 0.33}: at
-- HP=0.5 → phase 2 because 0.5 < 1.0 but >= 0.66 we'd be phase 1; at
-- 0.33 we'd be phase 2; at 0.20 → phase 3.)
local function resolvePhaseIndex(state, hpFraction: number): number
	local idx = 1
	for i, phase in state.Config.Phases do
		if hpFraction <= phase.BelowHpFraction then
			idx = i
		end
	end
	return idx
end

-- Drain bars BEFORE the active phase to 0; bars AFTER pre-fill to
-- MaxHealth; ACTIVE bar shows live HP. Driven by the
-- HealthChanged listener AFTER any phase transition has applied.
local function syncHealthbar(state, currentHP: number)
	local active = state.PhaseIndex
	for i, _phase in state.Config.Phases do
		local barId = state.Config.Id .. '_p' .. tostring(i)
		local hp
		if i < active then
			hp = 0
		elseif i == active then
			hp = currentHP
		else
			hp = state.MaxHealth
		end
		broadcastHealthbar(BossHealthbarShared.Actions.UpdateBar, { Id = barId, CurrentHP = hp })
	end
end

----------------------------------------------------------------------
-- Stat-override apply / restore. Snapshot per-phase so exiting a
-- phase reverts cleanly. Currently hooks WalkSpeed + DamageMul; the
-- AttackInterval override is informational (bosses don't have a fixed
-- attack interval — the cadence is the time between recipes, which
-- the BT loop already governs).
----------------------------------------------------------------------
local function applyStatOverrides(state, overrides)
	if typeof(overrides) ~= 'table' then return end
	local model = state.Model
	if not model then return end
	-- Snapshot before mutating so we can restore on phase exit.
	local snap = {}
	if overrides.WalkSpeed and state.Humanoid then
		snap.WalkSpeed = state.Humanoid.WalkSpeed
		state.Humanoid.WalkSpeed = overrides.WalkSpeed
	end
	if overrides.DamageMul then
		snap.DamageMul = model:GetAttribute('DamageMul')
		model:SetAttribute('DamageMul', overrides.DamageMul)
	end
	state.StatSnapshot = snap
end

local function restoreStatOverrides(state)
	local snap = state.StatSnapshot
	if typeof(snap) ~= 'table' then return end
	local model = state.Model
	if not model then return end
	if snap.WalkSpeed and state.Humanoid then
		state.Humanoid.WalkSpeed = snap.WalkSpeed
	end
	if snap.DamageMul ~= nil then
		model:SetAttribute('DamageMul', snap.DamageMul)
	end
	state.StatSnapshot = {}
end

----------------------------------------------------------------------
-- Phase transition.
----------------------------------------------------------------------
local function enterPhase(state, idx: number)
	if idx == state.PhaseIndex then return end
	local prev = state.PhaseIndex
	state.PhaseIndex = idx
	-- Restore the previous phase's stat overrides before applying the new.
	restoreStatOverrides(state)
	local phase = state.Config.Phases[idx]
	if phase.StatOverrides then
		applyStatOverrides(state, phase.StatOverrides)
	end
	-- Reset the per-phase selector state so the new phase's pool kicks
	-- in immediately. LastRecipeId is cleared so the no-repeat guard
	-- doesn't bleed across the phase boundary (some recipes appear in
	-- multiple phases and a phase entrance shouldn't veto them).
	state.LastRecipeId = nil
	state.SequentialIndex = 0

	-- EnterRecipe (cinematic / VFX burst) runs in its own task so the
	-- BT loop isn't blocked while the cinematic plays.
	if phase.EnterRecipe and SystemsContainer.SkillRuntimeServer then
		local Runtime = SystemsContainer.SkillRuntimeServer
		task.spawn(function()
			local caster = Runtime.CasterFromModel(state.Model)
			if caster then Runtime.RunRecipe(caster, phase.EnterRecipe) end
		end)
	end
end

----------------------------------------------------------------------
-- Pattern selection. The phase's `Recipes` pool is a list of entries
-- — each entry is either a bare string id (legacy) or a meta table
-- with optional MinRange / MaxRange / Weight. The selector here is
-- range-aware: at decision time, we measure the boss → target stud
-- distance, filter the pool to entries whose [MinRange, MaxRange]
-- gate contains that distance, then sample weighted-random from the
-- filtered set. If filtering rejects everything (e.g. the player is
-- in a weird position and no entry's range gate fits) we fall back
-- to the unfiltered pool so the boss never stalls.
--
-- This is what gives BossBoar its "real boar" feel: at range it
-- picks CHARGE; in close it picks GORE / DOUBLE-TAP / STOMP; mid
-- range it picks STAMPEDE. Without the gate, a "random" pool would
-- routinely pick CHARGE while the player is hugging the boar's hip,
-- which whiffs the entire telegraph and reads as the boss being
-- broken.
--
-- A short "no immediate repeat" guard (state.LastRecipeId) prevents
-- the same skill from firing back-to-back — boars are aggressive but
-- not stupid; chaining two stampedes in a row reads as a stuck loop.
----------------------------------------------------------------------
local function normalizeEntry(entry)
	-- Accept both the bare-string and table-form entries authored in
	-- Bosses.luau. Returns a uniform table the selector can read.
	if typeof(entry) == 'string' then
		return { Id = entry, MinRange = nil, MaxRange = nil, Weight = 1 }
	end
	return {
		Id       = entry.Id,
		MinRange = entry.MinRange,
		MaxRange = entry.MaxRange,
		Weight   = entry.Weight or 1,
	}
end

local function distanceToTarget(state): number?
	if not state.TargetModel or not state.Model then return nil end
	local hrp = state.TargetModel:FindFirstChild('HumanoidRootPart')
	local targetPos = (hrp and hrp.Position) or state.TargetModel:GetPivot().Position
	return (state.Model:GetPivot().Position - targetPos).Magnitude
end

-- Filter a phase's pool by current range to target. If the result is
-- empty, return the unfiltered pool so the selector always has a
-- candidate. The blockedRecipeId argument lets the caller veto a
-- specific recipe (used for the "no immediate repeat" guard).
local function buildCandidateSet(state, blockedRecipeId: string?): { any }
	local phase = state.Config.Phases[state.PhaseIndex]
	if not phase or not phase.Recipes or #phase.Recipes == 0 then return {} end
	local distance = distanceToTarget(state)
	local ranged: { any } = {}
	local fallback: { any } = {}
	for _, raw in phase.Recipes do
		local entry = normalizeEntry(raw)
		if entry.Id == blockedRecipeId then continue end
		fallback[#fallback + 1] = entry
		if distance ~= nil then
			if entry.MinRange and distance < entry.MinRange then continue end
			if entry.MaxRange and distance > entry.MaxRange then continue end
		end
		ranged[#ranged + 1] = entry
	end
	-- Prefer the range-filtered set; fall back to the un-blocked pool
	-- if nothing fits. Worst case (blocking + range filter both
	-- empty), drop the block and accept anything in the phase.
	if #ranged > 0 then return ranged end
	if #fallback > 0 then return fallback end
	-- Phase has only one recipe and it's the blocked one — let it through.
	local out = {}
	for _, raw in phase.Recipes do out[#out + 1] = normalizeEntry(raw) end
	return out
end

local function pickWeighted(candidates: { any }): string?
	if #candidates == 0 then return nil end
	if #candidates == 1 then return candidates[1].Id end
	local total = 0
	for _, c in candidates do total = total + math.max(0, c.Weight or 1) end
	if total <= 0 then return candidates[math.random(1, #candidates)].Id end
	local roll = math.random() * total
	local acc = 0
	for _, c in candidates do
		acc = acc + math.max(0, c.Weight or 1)
		if roll <= acc then return c.Id end
	end
	return candidates[#candidates].Id
end

-- Sequential mode (legacy) — still supported for bosses that author
-- a fixed pattern rotation. Range gates are ignored in sequential
-- mode (an authored fixed rotation is the author's call).
local function nextRecipeIdSequential(state): string?
	local phase = state.Config.Phases[state.PhaseIndex]
	if not phase or not phase.Recipes or #phase.Recipes == 0 then return nil end
	state.SequentialIndex = ((state.SequentialIndex or 0) % #phase.Recipes) + 1
	return normalizeEntry(phase.Recipes[state.SequentialIndex]).Id
end

-- Top-level "what's the next recipe?" — branches on SelectionMode.
local function selectNextRecipeId(state): string?
	local mode = state.Config.SelectionMode or 'random'
	if mode == 'sequential' then return nextRecipeIdSequential(state) end
	-- 'random' / 'weighted' — both go through the range-aware selector.
	local candidates = buildCandidateSet(state, state.LastRecipeId)
	return pickWeighted(candidates)
end

----------------------------------------------------------------------
-- BT functions.
----------------------------------------------------------------------
local function CheckIfBossIsAlive(_tree, _seq, state)
	return state.Humanoid and state.Humanoid.Health > 0 and state.Model and state.Model.Parent
end

local function CheckIfBossNotStunned(_tree, _seq, state)
	return state.Model and not CombatShared.IsCharacterStunned(state.Model)
end

-- Find the closest player; lifted from Generic.FindClosestTarget but
-- simplified — no aggro decay, no track-distance filter. Bosses just
-- target the nearest live player.
local function FindClosestPlayer(_tree, _seq, state)
	state.TargetModel = nil
	local closest, bestDist = nil, math.huge
	local hereCF = state.Model:GetPivot()
	for _, char in CollectionService:GetTagged('PLAYER_CHARACTER') do
		if not char:IsA('Model') then continue end
		local hum = char:FindFirstChildOfClass('Humanoid')
		if not hum or hum.Health <= 0 then continue end
		local hrp = char:FindFirstChild('HumanoidRootPart')
		if not hrp then continue end
		local d = (hrp.Position - hereCF.Position).Magnitude
		if d < bestDist then closest, bestDist = char, d end
	end
	state.TargetModel = closest
	return closest ~= nil
end

local function ExecuteNextRecipe(_tree, _seq, state)
	-- Range-aware pick: at decision time, we look at the boss → target
	-- distance and choose a recipe whose authored gate matches. This
	-- replaces the prior "shuffle a queue" approach so each pick uses
	-- live context (player ran out of melee → boar opens up the
	-- charge; player closed the gap → boar swaps to gore).
	local recipeId = selectNextRecipeId(state)
	if not recipeId then return false end
	local Runtime = SystemsContainer.SkillRuntimeServer
	if not Runtime or not Runtime.RunRecipe then return false end
	local caster = Runtime.CasterFromModel(state.Model)
	if not caster then return false end
	-- Track the last-fired id so the selector can skip immediate
	-- repeats on the next pick (boars don't double-stampede).
	state.LastRecipeId = recipeId
	-- Yields until the recipe completes; the BT effectively pauses
	-- between recipes, which is the correct cadence — players see
	-- discrete attack patterns rather than a constant stream.
	Runtime.RunRecipe(caster, recipeId)
	return true
end

local function PostRecipeCooldown(_tree, _seq, _state)
	-- Brief breath between recipes so the boss feels human-paced
	-- rather than chained windups.
	task.wait(0.5)
	return true
end

local function PopBossFromTree(tree, seq, _state)
	tree:remove_sequencer(seq)
end

----------------------------------------------------------------------
-- Build the BT shape once.
----------------------------------------------------------------------
local function buildBossBT()
	return ComponentBehaviorTree.BehaviorTreeFactory.build_from_nested(
		ComponentBehaviorTree.NodeFactory.condition_true_false(
			CheckIfBossIsAlive,
			ComponentBehaviorTree.NodeFactory.condition_true_false(
				CheckIfBossNotStunned,
				ComponentBehaviorTree.NodeFactory.condition_true_false(
					FindClosestPlayer,
					ComponentBehaviorTree.NodeFactory.condition_true_false(
						ExecuteNextRecipe,
						PostRecipeCooldown,
						ComponentBehaviorTree.NodeFactory.delay(0.5)
					),
					ComponentBehaviorTree.NodeFactory.delay(0.5)
				),
				ComponentBehaviorTree.NodeFactory.delay(0.2)
			),
			PopBossFromTree
		)
	)
end

----------------------------------------------------------------------
-- Public entry — called by EnemyServer when a mob with a BossId
-- initializes. Returns the state struct so EnemyServer can stash it
-- on its own MobClass for cleanup.
----------------------------------------------------------------------
function Module.Initialize(model: Model, humanoid: Humanoid, hrp: BasePart, mobConfig)
	if Active[model] then return Active[model] end
	local bossId = mobConfig.BossId
	local config = BossesConfig.GetBossConfig(bossId)
	if not config then
		warn(string.format('[BossServer] unknown boss id %q on %s', tostring(bossId), model:GetFullName()))
		return nil
	end

	local state = {
		Model            = model,
		Humanoid         = humanoid,
		HumanoidRootPart = hrp,
		Config           = config,
		MaxHealth        = humanoid.MaxHealth,
		PhaseIndex       = 1,
		StatSnapshot     = {},
		TargetModel      = nil,
		-- Selector state. LastRecipeId vetoes immediate repeats;
		-- SequentialIndex tracks the cursor for sequential SelectionMode.
		LastRecipeId     = nil,
		SequentialIndex  = 0,
	}
	Active[model] = state

	-- Open the multi-bar healthbar. One bar per phase, label = phase
	-- label, MaxHP = boss MaxHealth (so each phase visually drains
	-- the full bar before the next pre-fills).
	broadcastHealthbar(BossHealthbarShared.Actions.SetBoss, {
		Name = config.Display.Name,
		Bars = buildBarConfigs(state),
	})

	-- Apply the phase-1 stat overrides (if any).
	if config.Phases[1] and config.Phases[1].StatOverrides then
		applyStatOverrides(state, config.Phases[1].StatOverrides)
	end

	-- Run the intro recipe in its own task so init returns quickly.
	if config.IntroRecipe and SystemsContainer.SkillRuntimeServer then
		local Runtime = SystemsContainer.SkillRuntimeServer
		task.spawn(function()
			local caster = Runtime.CasterFromModel(model)
			if caster then Runtime.RunRecipe(caster, config.IntroRecipe) end
		end)
	end

	-- Wire HP changes → phase transitions + healthbar sync.
	local hpConn
	hpConn = humanoid.HealthChanged:Connect(function(currentHP)
		if not Active[model] then
			if hpConn then hpConn:Disconnect() end
			return
		end
		local frac = currentHP / state.MaxHealth
		local desiredPhase = resolvePhaseIndex(state, frac)
		if desiredPhase > state.PhaseIndex then
			enterPhase(state, desiredPhase)
		end
		syncHealthbar(state, currentHP)
	end)
	state.HpConn = hpConn

	-- Wire death → DeathRecipe + healthbar close.
	local diedConn; diedConn = humanoid.Died:Connect(function()
		if diedConn then diedConn:Disconnect() end
		Module.Cleanup(model, true)
	end)

	-- Attach the BT sequence.
	local sequenceItem = BossBT:create_sequence_item()
	sequenceItem.cycleToRoot = true
	sequenceItem.conditionParams = { state }
	sequenceItem.functionParams = { state }
	BossBT:append_sequencer(sequenceItem)
	state.BTSequence = sequenceItem

	return state
end

function Module.Cleanup(model: Model, didDie: boolean?)
	local state = Active[model]
	if not state then return end
	if state.HpConn then state.HpConn:Disconnect(); state.HpConn = nil end
	-- Restore stats so a respawn (if RespawnSeconds > 0) starts clean.
	restoreStatOverrides(state)
	-- Pop BT.
	if state.BTSequence and BossBT then
		pcall(function() BossBT:remove_sequencer(state.BTSequence) end)
	end
	-- Death recipe before closing the healthbar.
	if didDie and state.Config.DeathRecipe and SystemsContainer.SkillRuntimeServer then
		local Runtime = SystemsContainer.SkillRuntimeServer
		task.spawn(function()
			local caster = Runtime.CasterFromModel(state.Model)
			if caster then Runtime.RunRecipe(caster, state.Config.DeathRecipe) end
			task.wait(0.5)
			broadcastHealthbar(BossHealthbarShared.Actions.Close, nil)
		end)
	else
		broadcastHealthbar(BossHealthbarShared.Actions.Close, nil)
	end
	Active[model] = nil
end

-- Forced phase transition — debug / cinematic helper. Bumps the boss
-- to a target phase index regardless of HP. Cmdr SetBossPhase plumbs
-- through here.
function Module.ForceSetPhase(model: Model, phaseIdx: number): boolean
	local state = Active[model]
	if not state then return false end
	if phaseIdx < 1 or phaseIdx > #state.Config.Phases then return false end
	enterPhase(state, phaseIdx)
	-- Resync the healthbar so the new phase visually reflects state.
	syncHealthbar(state, state.Humanoid.Health)
	return true
end

function Module.GetActiveBossModels(): {Model}
	local out = {}
	for model in Active do table.insert(out, model) end
	return out
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	BossBT = buildBossBT()
	-- Attach to the existing BT resolver. EnemyServer creates one in
	-- its Start; we hook in by registering through the same library.
	local resolver = ComponentBehaviorTree.BehaviorTreeResolver.new()
	resolver:start_runtime()
	resolver:append_tree(BossBT)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/StatisticsServer"><![CDATA[-- StatisticsServer — single-source-of-truth for per-player stat
-- mutations. Every other server module that wants to bump a stat goes
-- through here; nothing writes saveData.Statistics directly.
--
-- API:
--   * Increment(player, statId, amount?)        — Counter (+= amount, default 1).
--   * IncrementMap(player, statId, key, amount?) — Map (map[key] += amount, default 1).
--   * SetMax(player, statId, value)              — Record (replaces if value > current).
--   * Set(player, statId, value)                 — Timestamp / overwrite.
--   * SetIfEmpty(player, statId, value)          — first-write only (e.g. FirstJoinDate).
--   * Get(player, statId)                        — read (number or table; nil if unset).
--
-- Storage shape is sparse — stats with no observations stay absent in
-- saveData.Statistics. Map keys are strings (config ids, boss ids,
-- item ids) so JSON serialization is stable.
--
-- Replication: writes mutate saveData.Statistics in-place; the existing
-- ReplicatedData PlayerData fanout (every 0.25s) carries them to the
-- client. Stats are NOT individually rate-limited — each Increment is
-- O(1) and the next replication tick coalesces multiple bumps into
-- one delta. If a per-tick storm becomes a perf issue (e.g. distance-
-- traveled writing every Heartbeat frame), the call site should
-- accumulate locally and flush periodically — not every API consumer
-- needs to know about that.

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local StatisticsConfig = ReplicatedModules.Data.StatisticsConfig

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Save-struct helpers.
----------------------------------------------------------------------
local function getSave(player: Player): any?
	local Saves = SystemsContainer.SavesManagerServer
	if not Saves then return nil end
	return Saves.GetPlayerSelectedSaveData(player)
end

local function ensureStatsTable(saveData: any)
	if typeof(saveData.Statistics) ~= 'table' then
		saveData.Statistics = {}
	end
end

-- Stringify the id once. Save lookups use string keys throughout for
-- JSON serialization stability — the in-memory table can mix number
-- and string keys without warning, but DataStore round-trips will
-- normalize them in inconsistent ways. Best to commit upfront.
local function k(statId: number): string
	return tostring(statId)
end

----------------------------------------------------------------------
-- Public API.
----------------------------------------------------------------------

-- Counter — bump by `amount` (default 1). Negative amounts are
-- accepted but clamped at 0 floor (a stat going negative is almost
-- always a bug somewhere upstream, not a feature).
function Module.Increment(player: Player, statId: number, amount: number?): number
	local saveData = getSave(player); if not saveData then return 0 end
	ensureStatsTable(saveData)
	local key = k(statId)
	local current = tonumber(saveData.Statistics[key]) or 0
	local delta = tonumber(amount) or 1
	local next_ = math.max(0, current + delta)
	saveData.Statistics[key] = next_
	return next_
end

-- Map — bump map[key] by `amount`. Initializes the inner table on
-- first write so callers don't have to.
function Module.IncrementMap(player: Player, statId: number, mapKey: string, amount: number?): number
	if typeof(mapKey) ~= 'string' or mapKey == '' then return 0 end
	local saveData = getSave(player); if not saveData then return 0 end
	ensureStatsTable(saveData)
	local key = k(statId)
	local entry = saveData.Statistics[key]
	if typeof(entry) ~= 'table' then
		entry = {}
		saveData.Statistics[key] = entry
	end
	local current = tonumber(entry[mapKey]) or 0
	local delta = tonumber(amount) or 1
	local next_ = math.max(0, current + delta)
	entry[mapKey] = next_
	return next_
end

-- Record — keep-the-greater. Ignores values that don't beat the
-- current record. Returns the (possibly unchanged) stored value.
function Module.SetMax(player: Player, statId: number, value: number): number
	local saveData = getSave(player); if not saveData then return 0 end
	ensureStatsTable(saveData)
	local key = k(statId)
	local current = tonumber(saveData.Statistics[key]) or 0
	local incoming = tonumber(value) or 0
	if incoming > current then
		saveData.Statistics[key] = incoming
		return incoming
	end
	return current
end

-- Timestamp / overwrite. No bounds enforcement — caller picks the
-- semantic (epoch seconds, raw counter override, etc.).
function Module.Set(player: Player, statId: number, value: any)
	local saveData = getSave(player); if not saveData then return end
	ensureStatsTable(saveData)
	saveData.Statistics[k(statId)] = value
end

-- First-write-only. Used for FirstJoinDate; subsequent calls no-op.
-- Returns true if this call performed the write.
function Module.SetIfEmpty(player: Player, statId: number, value: any): boolean
	local saveData = getSave(player); if not saveData then return false end
	ensureStatsTable(saveData)
	local key = k(statId)
	if saveData.Statistics[key] ~= nil then return false end
	saveData.Statistics[key] = value
	return true
end

-- Reset — clear a single stat. Used for CurrentKillStreak on death.
-- Maps are cleared by setting to {} rather than nil so the field
-- still exists in the save (cheaper diff for ReplicatedData).
function Module.Reset(player: Player, statId: number)
	local saveData = getSave(player); if not saveData then return end
	ensureStatsTable(saveData)
	local kind = StatisticsConfig.GetKind(statId)
	if kind == StatisticsConfig.Kinds.Map then
		saveData.Statistics[k(statId)] = {}
	else
		saveData.Statistics[k(statId)] = 0
	end
end

-- Read. Returns the stored value or nil. Callers branch on shape
-- per the stat's Kind (numbers for Counter / Record / Timestamp;
-- table for Map).
function Module.Get(player: Player, statId: number): any
	local saveData = getSave(player); if not saveData then return nil end
	if typeof(saveData.Statistics) ~= 'table' then return nil end
	return saveData.Statistics[k(statId)]
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start() end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/LeaderboardServer"><![CDATA[-- LeaderboardServer — cross-server leaderboards backed by
-- OrderedDataStore. One store per category in LeaderboardConfig;
-- a single sequential lifecycle (commit window → pull → sleep
-- remainder of CycleSec) keeps the boards on a tempo independent of
-- player counts.
--
-- Lifecycle:
--   while true do
--     1. Commit window (CommitWindowSec): walk every on-server player
--        and SetAsync their current value into each category store.
--        Writes spread evenly over the window so we stay inside
--        per-minute SetAsync budgets on busy servers.
--     2. Pull: GetSortedAsync(top MaxEntries) per category and publish
--        the merged result via ReplicatedData.SetData('Leaderboard',
--        snapshot). All clients read from the same public snapshot.
--     3. Sleep the remainder of CycleSec.
--   end
--
-- Studio segmentation: every store key gets a `_Studio` / `_Live`
-- suffix so test data stays out of the prod boards. Initial pull is
-- delayed in Studio (INITIAL_LOAD_DELAY_SEC = 20s) to absorb rapid
-- play-test cycles that would otherwise burn read budget verifying
-- unrelated changes.
--
-- Failure mode: GetOrderedDataStore is wrapped in pcall + retried
-- every STORE_ACQUIRE_RETRY_SEC. The lifecycle stays parked until
-- every category's store handle is acquired (all-or-nothing — we
-- don't run a half-working board that ranks 9 of 10 categories).

local DataStoreService = game:GetService('DataStoreService')
local Players = game:GetService('Players')
local RunService = game:GetService('RunService')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local LeaderboardConfig = ReplicatedModules.Data.LeaderboardConfig
local ReplicatedData    = ReplicatedModules.Services.ReplicatedData

-- Studio vs Live store-key suffix. Production servers and test
-- servers must NEVER share an OrderedDataStore — a 9999-second
-- play-test SetAsync would shove the dev to the top of the live
-- board.
local STORE_SUFFIX = RunService:IsStudio() and '_Studio' or '_Live'

-- Acquisition retry cadence. GetOrderedDataStore itself is rarely
-- the failure point — DataStoreService not yet ready / temporarily
-- unavailable is what we're guarding against. 5 min is short enough
-- to self-heal once the service recovers, long enough not to spam
-- logs in a sustained outage.
local STORE_ACQUIRE_RETRY_SEC = 300

-- Without an initial pull, the first board contents land only after
-- the first commit window completes (~CommitWindowSec) — joiners
-- stare at an empty leaderboard for two-plus minutes. A single
-- GetSortedAsync per category shortly after boot fills the board
-- with the last cycle's persisted values.
--
-- Live: 0s — each Live server boots once and stays up for hours, so
-- the boot pull amortizes over a long session.
-- Studio: 20s — every Play / Stop is a fresh server; without the
-- delay every quick verification burns a full round of reads.
local INITIAL_LOAD_DELAY_SEC = RunService:IsStudio() and 20 or 0

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- State.
----------------------------------------------------------------------
type CategoryState = {
	Def:    any,           -- LeaderboardConfig category entry
	Store:  OrderedDataStore,
	Entries: { { userId: number, value: number, name: string? } },
}

local States: { [string]: CategoryState }? = nil
local NameCache: { [number]: string } = {}

-- Held reference to the public 'Leaderboard' replicated table. We call
-- ReplicatedData.SetData ONCE on Start and then mutate this table in
-- place — the replication observer detects external mutations via
-- JSON-diff polling and propagates only the changed sub-tables. Calling
-- SetData every cycle would swap the underlying reference and force a
-- full snapshot diff each time.
local Snapshot: any = nil

----------------------------------------------------------------------
-- Try to grab one OrderedDataStore per category. All-or-nothing:
-- partial success doesn't unlock the lifecycle.
----------------------------------------------------------------------
local function tryAcquireStores(): ({ [string]: CategoryState }?, string?)
	local out: { [string]: CategoryState } = {}
	for _, def in LeaderboardConfig.Categories do
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore(def.StoreKey .. STORE_SUFFIX)
		end)
		if not ok or not store then return nil, tostring(store) end
		out[def.Id] = { Def = def, Store = store, Entries = {} }
	end
	return out, nil
end

----------------------------------------------------------------------
-- Username resolution. Player instance > in-server cache >
-- GetNameFromUserIdAsync. Cache lives for the server's lifetime;
-- usernames change rarely enough that a stale name on the board for
-- one server session is acceptable.
----------------------------------------------------------------------
local function resolveName(userId: number): string?
	local cached = NameCache[userId]
	if cached then return cached end
	local plr = Players:GetPlayerByUserId(userId)
	if plr then
		NameCache[userId] = plr.Name
		return plr.Name
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok and typeof(name) == 'string' then
		NameCache[userId] = name
		return name
	end
	return nil
end

----------------------------------------------------------------------
-- Publish the current Entries snapshot. Mutates the held Snapshot
-- table IN PLACE — the ReplicatedData observer detects the per-key
-- changes via JSON-diff polling on the next tick. Each category's
-- entry is REPLACED with a fresh sub-table (`Snapshot[id] = {Entries=...}`)
-- rather than mutating its inner array, because the inner sub-table
-- IS the diff unit; replacing the sub-table is what makes the
-- observer see the change at all (a same-reference array mutation
-- would hash-collide on JSON encode and skip the dispatch).
----------------------------------------------------------------------
local function publishSnapshot()
	if not States or not Snapshot then return end
	for id, st in States do
		Snapshot[id] = { Entries = st.Entries }
	end
	Snapshot.Updated = os.time()
end

----------------------------------------------------------------------
-- Pull (GetSortedAsync) the top MaxEntries from each category store
-- and update the in-memory Entries lists. Each category reads
-- independently so a single slow / failing read doesn't poison the
-- others. Resolves usernames inline so the published snapshot has
-- everything the client needs to render.
----------------------------------------------------------------------
local function pullAndPublish()
	if not States then return end
	for _, st in States do
		local ok, pages = pcall(function()
			return st.Store:GetSortedAsync(false, LeaderboardConfig.MaxEntries)
		end)
		if not ok or not pages then
			warn(string.format('[LeaderboardServer] GetSortedAsync failed: %s :: %s',
				st.Def.Id, tostring(pages)))
			continue
		end
		local rows = {}
		for _, entry in pages:GetCurrentPage() do
			local userId = tonumber(entry.key)
			local value = tonumber(entry.value) or 0
			if not userId then continue end
			table.insert(rows, {
				userId = userId,
				value  = value,
				name   = resolveName(userId),
			})
			if #rows >= LeaderboardConfig.MaxEntries then break end
		end
		st.Entries = rows
	end
	publishSnapshot()
end

----------------------------------------------------------------------
-- Commit window. Walks each on-server player + each category and
-- spreads the SetAsync writes evenly over CommitWindowSec to stay
-- well inside Roblox's per-minute write budget. If the server is
-- empty we still wait the full window so the cycle stays on tempo.
--
-- Skips zero-value entries: a 0 on a top-N board can't outrank
-- anyone real, and SetAsync still costs write quota.
----------------------------------------------------------------------
local function runCommitWindow()
	if not States then
		task.wait(LeaderboardConfig.CommitWindowSec)
		return
	end
	local Saves = SystemsContainer.SavesManagerServer
	if not Saves then
		task.wait(LeaderboardConfig.CommitWindowSec)
		return
	end

	local players = Players:GetPlayers()
	-- Build the work list: (player, save, category) units. Skip
	-- players with no loaded save (still in profile-load).
	local workUnits: { { player: Player, save: any, def: any } } = {}
	for _, plr in players do
		local save = Saves.GetPlayerSelectedSaveData(plr)
		if not save then continue end
		for _, def in LeaderboardConfig.Categories do
			table.insert(workUnits, { player = plr, save = save, def = def })
		end
	end

	if #workUnits == 0 then
		task.wait(LeaderboardConfig.CommitWindowSec)
		return
	end

	-- Spread writes across the window. perWriteDelay is the budget
	-- per SetAsync; in practice some writes finish faster, leaving a
	-- small pad at the end (closed below).
	local perDelay = LeaderboardConfig.CommitWindowSec / #workUnits
	local windowStart = os.clock()
	for _, unit in workUnits do
		-- Player may have left mid-window; re-check the save reference.
		if unit.player.Parent ~= Players then continue end
		local value = 0
		local ok, val = pcall(unit.def.Extract, unit.save)
		if ok and typeof(val) == 'number' then value = math.floor(val) end
		if value > 0 then
			local state = States[unit.def.Id]
			if state then
				local writeOk, err = pcall(function()
					state.Store:SetAsync(tostring(unit.player.UserId), value)
				end)
				if not writeOk then
					warn(string.format('[LeaderboardServer] SetAsync failed: %s userId=%d :: %s',
						unit.def.Id, unit.player.UserId, tostring(err)))
				end
			end
		end
		task.wait(perDelay)
	end

	-- Pad to full window if we finished early (mostly-zero players
	-- skipped fast) so the cycle's tempo doesn't drift.
	local elapsed = os.clock() - windowStart
	local pad = LeaderboardConfig.CommitWindowSec - elapsed
	if pad > 0 then task.wait(pad) end
end

----------------------------------------------------------------------
-- Public API.
----------------------------------------------------------------------
-- Force an immediate pull. Useful for cmdr / debug paths; not used by
-- the regular cycle (which calls pullAndPublish on its own schedule).
function Module.ForcePull()
	pullAndPublish()
end

function Module.GetSnapshot(): any
	return ReplicatedData.GetData(LeaderboardConfig.PublicCategory)
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	-- Register the replicated snapshot ONCE. After this, every cycle's
	-- pullAndPublish mutates the held `Snapshot` table in place — no
	-- subsequent SetData calls. Clients see per-key diffs via the
	-- ReplicatedData observer's JSON-diff polling.
	Snapshot = { Updated = 0 }
	for _, def in LeaderboardConfig.Categories do
		Snapshot[def.Id] = { Entries = {} }
	end
	ReplicatedData.SetData(LeaderboardConfig.PublicCategory, Snapshot)

	task.spawn(function()
		-- Acquire-or-retry phase. Stays here until DataStoreService is
		-- ready and every category's store handle came back without
		-- error. Logs once per failed attempt (not per category) so
		-- the warn doesn't spam.
		while not States do
			local s, reason = tryAcquireStores()
			if s then States = s; break end
			warn(string.format(
				'[LeaderboardServer] GetOrderedDataStore failed; retrying in %ds :: %s',
				STORE_ACQUIRE_RETRY_SEC, tostring(reason)))
			task.wait(STORE_ACQUIRE_RETRY_SEC)
		end

		if INITIAL_LOAD_DELAY_SEC > 0 then
			task.wait(INITIAL_LOAD_DELAY_SEC)
		end
		pullAndPublish()

		while true do
			local cycleStart = os.clock()
			runCommitWindow()
			pullAndPublish()
			local elapsed = os.clock() - cycleStart
			local remaining = LeaderboardConfig.CycleSec - elapsed
			if remaining > 0 then task.wait(remaining) end
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/MountsConfigReplicationServer"><![CDATA[-- MountsConfigReplicationServer — pushes mount config rows to the
-- player's client shell as they earn / are granted mounts.
--
-- Wire protocol (shared ConfigReplicationEvent RemoteEvent, server →
-- client; payload is `(category, action, ...)` per the consolidated
-- ConfigReplicationClient on the receiving end):
--   FireClient(player, 'Mounts', Jobs.Bundle, { [mountId] = config, ... })
--     — initial bootstrap on join (owned mounts + transitive deps),
--       OR full registry if the player is whitelisted as admin.
--   FireClient(player, 'Mounts', Jobs.Add, mountId, config)
--     — single new mount unlocked mid-session.
--   FireClient(player, 'Mounts', Jobs.Remove, mountId)
--     — admin-revoke path; rare, but the client shell should drop the
--       row so subsequent `Module.Mounts[id]` reads return nil.
--
-- The client-side ConfigReplicationClient routes 'Mounts' category
-- writes straight into ReplicatedModules.Data.Mounts.Mounts so
-- existing widget code continues to work unchanged.
--
-- Bootstrapping: hooked from MountsServer's CharacterAdded handler
-- (which already runs after the profile loads + auto-unlocks starter
-- mounts). That guarantees the bundle goes out AFTER any starter
-- mounts have been written to OwnedMounts on this session.
--
-- Admin bypass: AdminWhitelistServer.IsAdmin(player) → if true, we
-- skip the "filter to owned ids" step and ship the full registry.
-- Per-event Add pushes still fire normally for admins; their client
-- shell already has the row, so the duplicate write is a no-op.

local Players = game:GetService('Players')

local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local MountsConfig  = ServerModules.Data.Mounts
local RemoteService = ReplicatedModules.Services.RemoteService
local Jobs           = ReplicatedModules.Services.ConfigReplicationShared.Jobs

-- Shared remote — every system's *ConfigReplicationServer fires through
-- this same event. Category prefix ('Mounts') routes the payload to
-- the right entry in ConfigReplicationClient's registry.
local CONFIG_CATEGORY = 'Mounts'
local ConfigReplicationEvent = RemoteService.GetRemote('ConfigReplicationEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Helpers.
----------------------------------------------------------------------
local function isAdmin(player: Player): boolean
	local whitelist = SystemsContainer.AdminWhitelistServer
	if not whitelist or not whitelist.IsAdmin then return false end
	return whitelist.IsAdmin(player)
end

local function getOwnedMountIds(player: Player): { [string]: true }
	-- Source of truth is the save struct's OwnedMounts. Going through
	-- MountsServer.GetOwnedMounts keeps us behind the same accessor
	-- the rest of the system uses (rather than re-reading the save
	-- shape directly here).
	local owned: { [string]: true } = {}
	local MountsServer = SystemsContainer.MountsServer
	if not MountsServer then return owned end
	for mountId in MountsServer.GetOwnedMounts(player) do
		owned[mountId] = true
	end
	return owned
end

----------------------------------------------------------------------
-- Public API.
----------------------------------------------------------------------

-- BootstrapPlayer — call once per player after their profile / save
-- load completes. Sends every mount config the client should see in
-- a single 'Bundle' event so the shell is fully populated before the
-- first widget opens.
function Module.BootstrapPlayer(player: Player)
	local bundle: { [string]: any } = {}
	if isAdmin(player) then
		-- Admin gets the full registry — Cmdr / debug pickers / QA
		-- flows expect completeness.
		for mountId, cfg in MountsConfig.Mounts do
			bundle[mountId] = cfg
		end
	else
		local owned = getOwnedMountIds(player)
		for mountId in owned do
			local cfg = MountsConfig.Mounts[mountId]
			-- Defensive: a save might reference a mount id that's been
			-- removed from the registry. Skip silently rather than
			-- pushing a nil row.
			if cfg then bundle[mountId] = cfg end
		end
	end
	ConfigReplicationEvent:FireClient(player, CONFIG_CATEGORY, Jobs.Bundle, bundle)
end

-- OnMountUnlocked — call AFTER MountsServer.AttemptUnlockMount has
-- written to the save. Pushes the single config row so the client
-- can render the new entry without waiting for the next bundle.
function Module.OnMountUnlocked(player: Player, mountId: string)
	local cfg = MountsConfig.Mounts[mountId]
	if not cfg then return end
	ConfigReplicationEvent:FireClient(player, CONFIG_CATEGORY, Jobs.Add, mountId, cfg)
end

-- OnMountRevoked — admin path (DeleteMount cmdr). The client shell
-- drops the row; any UI surfaces re-render with the row missing.
-- Admins receive Remove events too — their shell is just live state,
-- it's allowed to be mutated by server pushes regardless of access tier.
function Module.OnMountRevoked(player: Player, mountId: string)
	ConfigReplicationEvent:FireClient(player, CONFIG_CATEGORY, Jobs.Remove, mountId)
end

-- BroadcastVisibleMount — push a mount config to ALL clients (not
-- just the owner). Used when a player mounts so spectator clients
-- can render the mount model. Equipped mounts are publicly visible —
-- the model is on screen — so leaking the config to every client is
-- consistent with the visibility model. Idempotent on already-
-- replicated ids.
function Module.BroadcastVisibleMount(mountId: string)
	if typeof(mountId) ~= 'string' then return end
	local cfg = MountsConfig.Mounts[mountId]
	if not cfg then return end
	ConfigReplicationEvent:FireAllClients(CONFIG_CATEGORY, Jobs.Add, mountId, cfg)
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	-- PlayerRemoving: nothing to clean up — the client tears down its
	-- own state when the player leaves. The remote subscription is per
	-- client so there's no server-side queue to drain.
	Players.PlayerRemoving:Connect(function(_player) end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/ItemsConfigReplicationServer"><![CDATA[-- ItemsConfigReplicationServer — pushes item config rows to the
-- player's client shell as they gain items.
--
-- Wire protocol (shared ConfigReplicationEvent, category 'Items'):
--   FireClient(player, 'Items', Jobs.Bundle, { [itemId] = config, ... })
--   FireClient(player, 'Items', Jobs.Add, itemId, config)
--   FireClient(player, 'Items', Jobs.Remove, itemId)
--
-- The client-side ConfigReplicationClient routes 'Items' writes into
-- ReplicatedModules.Data.Items.Items so existing widget code (inventory
-- tab, hotbar, equipment renderer, tooltips) continues to read
-- `Module.Items[id]` / `Module.GetConfigFromId(id)` unchanged.
--
-- // Bootstrap timing //
-- PlayerInventoryServer doesn't have a CharacterAdded handler we can
-- hook into, so this module owns its own PlayerAdded subscription.
-- Bootstrap yields on profile-load + save-index pick before walking
-- the inventory. Per-give pushes then fire from
-- PlayerInventoryServer.GiveQuantityOfItemIdToPlayer for new item ids.
--
-- // Modifiers (cross-ref piggy-back) //
-- Items reference Modifier ids dynamically via per-instance
-- Composition.Forged.Modifiers (NOT a static config-side cross-ref).
-- Replicating modifier configs cleanly therefore requires walking
-- the player's inventory at bootstrap time to collect every modifier
-- id currently in use, then pushing those rows in a companion
-- 'Modifiers' bundle. Per-forge commits also push the freshly-applied
-- modifier configs via PushModifiersForPlayer (called by ForgeServer
-- after attaching Composition.Forged).
--
-- The 'Modifiers' category is registered alongside 'Items' on the
-- client; same dispatch path, same generic Bundle/Add semantics.

local Players = game:GetService('Players')

local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local ItemsConfig     = ServerModules.Data.Items
local ModifiersConfig = ServerModules.Data.Modifiers
local RemoteService   = ReplicatedModules.Services.RemoteService
local Jobs            = ReplicatedModules.Services.ConfigReplicationShared.Jobs

local CATEGORY_ITEMS     = 'Items'
local CATEGORY_MODIFIERS = 'Modifiers'
local ConfigReplicationEvent = RemoteService.GetRemote('ConfigReplicationEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Helpers.
----------------------------------------------------------------------
local function isAdmin(player: Player): boolean
	local whitelist = SystemsContainer.AdminWhitelistServer
	if not whitelist or not whitelist.IsAdmin then return false end
	return whitelist.IsAdmin(player)
end

-- Returns a set of itemIds the player owns at least one stack of.
-- Source of truth: save_data.Inventory keys. Empty if save not loaded.
local function getOwnedItemIds(player: Player): { [string]: true }
	local owned: { [string]: true } = {}
	local Saves = SystemsContainer.SavesManagerServer
	if not Saves then return owned end
	local data = Saves.GetPlayerSelectedSaveData(player)
	if not data or typeof(data.Inventory) ~= 'table' then return owned end
	for itemId, uuidBucket in data.Inventory do
		-- Skip empty buckets so a residual `Inventory[itemId] = {}` from
		-- a prior consume doesn't leak the config row to the client.
		if typeof(uuidBucket) == 'table' and next(uuidBucket) ~= nil then
			owned[itemId] = true
		end
	end
	return owned
end

-- Walk every forged stack in the player's inventory and collect the
-- set of modifier ids currently bound to those stacks. Used to size
-- the companion 'Modifiers' bundle on bootstrap. The Modifier shape
-- on the save side is `{ id = string, level = number }` — see
-- ForgeServer.AttemptForgeWeapon's `forged.Modifiers` build.
local function getOwnedModifierIds(player: Player): { [string]: true }
	local owned: { [string]: true } = {}
	local Saves = SystemsContainer.SavesManagerServer
	if not Saves then return owned end
	local data = Saves.GetPlayerSelectedSaveData(player)
	if not data or typeof(data.Inventory) ~= 'table' then return owned end
	for _itemId, uuidBucket in data.Inventory do
		if typeof(uuidBucket) ~= 'table' then continue end
		for _uuid, stack in uuidBucket do
			local comp = typeof(stack) == 'table' and stack.Composition
			local forged = typeof(comp) == 'table' and comp.Forged
			local mods = typeof(forged) == 'table' and forged.Modifiers
			if typeof(mods) ~= 'table' then continue end
			for _, entry in mods do
				-- Defensive: tolerate both the structured form
				-- `{ id = 'sharp', level = n }` and a legacy bare-string
				-- form if any old saves linger.
				local id = (typeof(entry) == 'table' and entry.id)
					or (typeof(entry) == 'string' and entry)
					or nil
				if typeof(id) == 'string' then owned[id] = true end
			end
		end
	end
	return owned
end

----------------------------------------------------------------------
-- Public API.
----------------------------------------------------------------------

function Module.BootstrapPlayer(player: Player)
	local itemBundle: { [string]: any } = {}
	local modifierBundle: { [string]: any } = {}
	if isAdmin(player) then
		for id, cfg in ItemsConfig.Items do
			itemBundle[id] = cfg
		end
		for id, cfg in ModifiersConfig.Modifiers do
			modifierBundle[id] = cfg
		end
	else
		for id in getOwnedItemIds(player) do
			local cfg = ItemsConfig.Items[id]
			if cfg then itemBundle[id] = cfg end
		end
		-- Piggy-back: walk forged stacks to collect modifier deps.
		for id in getOwnedModifierIds(player) do
			local cfg = ModifiersConfig.Modifiers[id]
			if cfg then modifierBundle[id] = cfg end
		end
	end
	-- Send Items first then Modifiers — order isn't load-bearing
	-- (each category writes into its own client shell independently)
	-- but keeping the cross-ref bundle second matches the dependency
	-- direction (modifier rows are referenced from item-instance
	-- composition data).
	ConfigReplicationEvent:FireClient(player, CATEGORY_ITEMS, Jobs.Bundle, itemBundle)
	ConfigReplicationEvent:FireClient(player, CATEGORY_MODIFIERS, Jobs.Bundle, modifierBundle)
end

-- OnItemAdded — call when the player's inventory gains an item id
-- (first stack of that id; subsequent stacks of the same id are
-- no-ops on the client). Defensive: idempotent if the row was
-- already replicated, since ConfigReplicationClient.applyAdd just
-- writes into the shared table.
function Module.OnItemAdded(player: Player, itemId: string)
	local cfg = ItemsConfig.Items[itemId]
	if not cfg then return end
	ConfigReplicationEvent:FireClient(player, CATEGORY_ITEMS, Jobs.Add, itemId, cfg)
end

-- OnItemRemoved — fire when a player's last stack of an itemId is
-- consumed/dropped. Optional; the security model doesn't require
-- aggressive cleanup since the player legitimately had the item, so
-- the residual config row staying client-side isn't a leak. Wired
-- here for completeness; not currently called by any consume path.
function Module.OnItemRemoved(player: Player, itemId: string)
	ConfigReplicationEvent:FireClient(player, CATEGORY_ITEMS, Jobs.Remove, itemId)
end

-- PushModifiersForPlayer — call after a forge commit attaches new
-- modifier ids to a stack so the client gets the configs without
-- waiting for re-bootstrap. ForgeServer.AttemptForgeWeapon calls
-- this with the freshly-baked modifier ids list. Idempotent on
-- already-replicated ids (Add just rewrites the same row).
function Module.PushModifiersForPlayer(player: Player, modifierIds: { string })
	if typeof(modifierIds) ~= 'table' then return end
	for _, id in modifierIds do
		if typeof(id) ~= 'string' then continue end
		local cfg = ModifiersConfig.Modifiers[id]
		if cfg then
			ConfigReplicationEvent:FireClient(player, CATEGORY_MODIFIERS, Jobs.Add, id, cfg)
		end
	end
end

-- BroadcastVisibleItems — push these item configs to ALL clients (not
-- just the owner). Used when an item becomes visible-to-others —
-- equipped weapon, displayed mount, equipped companion. Equipped
-- gear is already player-visible (every nearby client renders the
-- model), so the config isn't spoiler content for THIS player.
-- Without this, EquipmentRendererClient on player B would attempt
-- to render player A's equipped sword and find no config in B's
-- shell (because B doesn't own A's sword).
--
-- Wire convention: server fires 'Items' Add events to all clients.
-- ConfigReplicationClient on each receiver writes the row into the
-- local Module.Items[id] — same code path as bootstrap. Idempotent
-- (a client that already had the config just rewrites the same row).
function Module.BroadcastVisibleItems(itemIds: { string })
	if typeof(itemIds) ~= 'table' then return end
	for _, itemId in itemIds do
		if typeof(itemId) ~= 'string' then continue end
		local cfg = ItemsConfig.Items[itemId]
		if cfg then
			ConfigReplicationEvent:FireAllClients(CATEGORY_ITEMS, Jobs.Add, itemId, cfg)
		end
	end
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
local function bootstrapWhenReady(player: Player)
	-- Yield until profile + save index are both available so the bundle
	-- includes whatever inventory was loaded from disk. Without the
	-- yield, we'd push an empty bundle on PlayerAdded (before
	-- DataManagerServer.LoadPlayerProfile completes) and leave the
	-- player's items invisible until their next respawn.
	local DM = SystemsContainer.DataManagerServer
	local Saves = SystemsContainer.SavesManagerServer
	if not DM or not Saves then return end
	if DM.YieldUntilProfileAvailable then DM.YieldUntilProfileAvailable(player) end
	if Saves.YieldUntilSaveIndexSelected then Saves.YieldUntilSaveIndexSelected(player) end
	if not player:IsDescendantOf(Players) then return end
	Module.BootstrapPlayer(player)
end

function Module.Start()
	for _, p in Players:GetPlayers() do
		task.spawn(bootstrapWhenReady, p)
	end
	Players.PlayerAdded:Connect(function(p)
		task.spawn(bootstrapWhenReady, p)
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/CompanionsConfigReplicationServer"><![CDATA[-- CompanionsConfigReplicationServer — pushes companion config rows to
-- the player's client shell as they unlock companions.
--
-- Wire protocol (shared ConfigReplicationEvent, category 'Companions'):
--   FireClient(player, 'Companions', Jobs.Bundle, { [id] = config, ... })
--   FireClient(player, 'Companions', Jobs.Add, companionId, config)
--   FireClient(player, 'Companions', Jobs.Remove, companionId)
--
-- Client-side ConfigReplicationClient routes 'Companions' writes into
-- ReplicatedModules.Data.Companions.Companions so existing widget code
-- (CompanionsTab, CompanionsClient, InventoryTab, etc.) reads them
-- without any migration.
--
-- Bootstrap timing: hooks into CompanionsServer's CharacterAdded
-- handler AFTER the auto-unlock pass so the bundle covers any starter
-- / wisp roster that gets ensured on first spawn.

local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CompanionsConfig = ServerModules.Data.Companions
local CompanionsShared = ReplicatedModules.Services.CompanionsShared
local RemoteService    = ReplicatedModules.Services.RemoteService
local Jobs           = ReplicatedModules.Services.ConfigReplicationShared.Jobs

local CONFIG_CATEGORY = 'Companions'
local ConfigReplicationEvent = RemoteService.GetRemote('ConfigReplicationEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Helpers.
----------------------------------------------------------------------
local function isAdmin(player: Player): boolean
	local whitelist = SystemsContainer.AdminWhitelistServer
	if not whitelist or not whitelist.IsAdmin then return false end
	return whitelist.IsAdmin(player)
end

local function getOwnedCompanionIds(player: Player): { [string]: true }
	local owned: { [string]: true } = {}
	local Saves = SystemsContainer.SavesManagerServer
	if not Saves then return owned end
	local data = Saves.GetPlayerSelectedSaveData(player)
	if not data then return owned end
	for id in CompanionsShared.GetOwned(data) do
		owned[id] = true
	end
	return owned
end

----------------------------------------------------------------------
-- Public API.
----------------------------------------------------------------------

function Module.BootstrapPlayer(player: Player)
	local bundle: { [string]: any } = {}
	if isAdmin(player) then
		for id, cfg in CompanionsConfig.Companions do
			bundle[id] = cfg
		end
	else
		for id in getOwnedCompanionIds(player) do
			local cfg = CompanionsConfig.Companions[id]
			if cfg then bundle[id] = cfg end
		end
	end
	ConfigReplicationEvent:FireClient(player, CONFIG_CATEGORY, Jobs.Bundle, bundle)
end

function Module.OnCompanionUnlocked(player: Player, companionId: string)
	local cfg = CompanionsConfig.Companions[companionId]
	if not cfg then return end
	ConfigReplicationEvent:FireClient(player, CONFIG_CATEGORY, Jobs.Add, companionId, cfg)
end

function Module.OnCompanionRevoked(player: Player, companionId: string)
	ConfigReplicationEvent:FireClient(player, CONFIG_CATEGORY, Jobs.Remove, companionId)
end

-- BroadcastVisibleCompanion — push a companion config to ALL clients
-- so spectators can render the floating wisp/fairy model. Equipped
-- companions are publicly visible (other players see your companion
-- hovering near you), so leaking the config is consistent with the
-- visibility model. Idempotent on already-replicated ids.
function Module.BroadcastVisibleCompanion(companionId: string)
	if typeof(companionId) ~= 'string' then return end
	local cfg = CompanionsConfig.Companions[companionId]
	if not cfg then return end
	ConfigReplicationEvent:FireAllClients(CONFIG_CATEGORY, Jobs.Add, companionId, cfg)
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start() end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/BlueprintsConfigReplicationServer"><![CDATA[-- BlueprintsConfigReplicationServer — pushes blueprint config rows to
-- the player's client shell as they unlock blueprints.
--
-- Wire protocol (shared ConfigReplicationEvent, category 'Blueprints'):
--   FireClient(player, 'Blueprints', Jobs.Bundle, { [id] = config, ... })
--   FireClient(player, 'Blueprints', Jobs.Add, blueprintId, config)
--   FireClient(player, 'Blueprints', Jobs.Remove, blueprintId)
--
-- // Bootstrap timing //
-- ForgeServer doesn't have a CharacterAdded handler we can hook into,
-- so this module owns its own PlayerAdded subscription. The bootstrap
-- runs after the player's profile is available — yields on
-- DataManagerServer.YieldUntilProfileAvailable + the save-index pick.
-- Until then `GetPlayerSelectedSaveData` returns nil and we'd send an
-- empty bundle, which is incorrect.

local Players = game:GetService('Players')

local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local BlueprintsConfig = ServerModules.Data.Blueprints
local RemoteService    = ReplicatedModules.Services.RemoteService
local Jobs           = ReplicatedModules.Services.ConfigReplicationShared.Jobs

local CONFIG_CATEGORY = 'Blueprints'
local ConfigReplicationEvent = RemoteService.GetRemote('ConfigReplicationEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Helpers.
----------------------------------------------------------------------
local function isAdmin(player: Player): boolean
	local whitelist = SystemsContainer.AdminWhitelistServer
	if not whitelist or not whitelist.IsAdmin then return false end
	return whitelist.IsAdmin(player)
end

local function getUnlockedBlueprintIds(player: Player): { [string]: true }
	local out: { [string]: true } = {}
	local Saves = SystemsContainer.SavesManagerServer
	if not Saves then return out end
	local data = Saves.GetPlayerSelectedSaveData(player)
	if not data or typeof(data.Crafting) ~= 'table' then return out end
	local unlocked = data.Crafting.UnlockedBlueprints
	if typeof(unlocked) ~= 'table' then return out end
	for id in unlocked do
		out[id] = true
	end
	return out
end

----------------------------------------------------------------------
-- Public API.
----------------------------------------------------------------------

function Module.BootstrapPlayer(player: Player)
	local bundle: { [string]: any } = {}
	if isAdmin(player) then
		for id, cfg in BlueprintsConfig.Blueprints do
			bundle[id] = cfg
		end
	else
		for id in getUnlockedBlueprintIds(player) do
			local cfg = BlueprintsConfig.Blueprints[id]
			if cfg then bundle[id] = cfg end
		end
	end
	ConfigReplicationEvent:FireClient(player, CONFIG_CATEGORY, Jobs.Bundle, bundle)
end

function Module.OnBlueprintUnlocked(player: Player, blueprintId: string)
	local cfg = BlueprintsConfig.Blueprints[blueprintId]
	if not cfg then return end
	ConfigReplicationEvent:FireClient(player, CONFIG_CATEGORY, Jobs.Add, blueprintId, cfg)
end

function Module.OnBlueprintRevoked(player: Player, blueprintId: string)
	ConfigReplicationEvent:FireClient(player, CONFIG_CATEGORY, Jobs.Remove, blueprintId)
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
local function bootstrapWhenReady(player: Player)
	-- Yield until profile + save index are both available so the bundle
	-- includes any blueprints already in the player's save. This runs
	-- in its own task per player so PlayerAdded never blocks.
	local DM = SystemsContainer.DataManagerServer
	local Saves = SystemsContainer.SavesManagerServer
	if not DM or not Saves then return end
	if DM.YieldUntilProfileAvailable then DM.YieldUntilProfileAvailable(player) end
	if Saves.YieldUntilSaveIndexSelected then Saves.YieldUntilSaveIndexSelected(player) end
	-- Player may have left mid-yield — guard before the push.
	if not player:IsDescendantOf(Players) then return end
	Module.BootstrapPlayer(player)
end

function Module.Start()
	for _, p in Players:GetPlayers() do
		task.spawn(bootstrapWhenReady, p)
	end
	Players.PlayerAdded:Connect(function(p)
		task.spawn(bootstrapWhenReady, p)
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/AdminWhitelistServer"><![CDATA[-- AdminWhitelistServer — single source of truth for "is this player a
-- developer / QA / dev-tool admin?"
--
-- Used by every config-replication module to decide whether a joining
-- player gets the FULL registry projected onto their client (admin
-- bypass) or only the owned/seen subset (regular player). Also a
-- general-purpose gate any server module can consult for "should I
-- show admin-only output / accept admin-only commands."
--
-- Authoring: paste the player's UserId into the ADMIN_USER_IDS list
-- below. UserIds are stable across name changes; never key by Name.
-- The list is server-only — the module file lives under ServerStorage
-- so a decompiled client can't enumerate it.
--
-- This module has no Init / Start; it's a pure-query module that other
-- modules require by name through the Framework SystemsContainer
-- (or directly via require) at boot.

local ADMIN_USER_IDS: { [number]: true } = {
	-- // Add admin / dev / QA UserIds here. Empty by default. //
	-- Example: [12345678] = true,
}

local Module = {}

-- IsAdmin(player) → boolean.
-- Defensive against nil / disconnected players: returns false rather
-- than erroring so callers can `if IsAdmin(p) then ...` without a
-- nil-guard.
function Module.IsAdmin(player: Player?): boolean
	if not player then return false end
	if not player:IsDescendantOf(game:GetService('Players')) then return false end
	return ADMIN_USER_IDS[player.UserId] == true
end

-- IsAdminUserId(userId) → boolean. For paths where the live Player
-- instance isn't available (e.g. analytics dispatch on a queued event).
function Module.IsAdminUserId(userId: number): boolean
	if typeof(userId) ~= 'number' then return false end
	return ADMIN_USER_IDS[userId] == true
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/FFlagsServer"><![CDATA[-- Feature-flag (FFlag) server. Generic, per-save store of one-shot named
-- switches — "this milestone happened once" state that any system can set
-- and gate on. Flag ids are defined in Data.FFlags; the values live on the
-- authoritative save struct under `data.FFlags`:
--
--   data.FFlags = { [flagId] = value }   -- value is usually `true`
--
-- This module is the only writer of that subtree. Consumers read via
-- HasFFlag / GetFFlag and mutate via SetFFlag; admin/dev tooling clears via
-- ResetFFlag / ResetFFlags. Persistence flows through the standard
-- SavesManagerServer pipeline — no separate sync hook needed.

local SystemsContainer = {}

local Module = {}

local function getSave(player: Player): any?
	local Saves = SystemsContainer.SavesManagerServer
	if not Saves then return nil end
	return Saves.GetPlayerSelectedSaveData(player)
end

-- Lazily ensure the FFlags subtree exists, returning it (or nil if the
-- player has no selected save yet).
local function ensureFFlags(saveData: any): { [string]: any }?
	if not saveData then return nil end
	if typeof(saveData.FFlags) ~= 'table' then saveData.FFlags = {} end
	return saveData.FFlags
end

----------------------------------------------------------------------
-- Getters (pure lookup).
----------------------------------------------------------------------

-- Returns the player's whole flag table (the live struct reference, not a
-- copy — do not mutate it directly; use SetFFlag). Empty table if unset.
function Module.GetFFlags(player: Player): { [string]: any }
	local flags = ensureFFlags(getSave(player))
	return flags or {}
end

-- Raw value of a single flag (nil if never set).
function Module.GetFFlag(player: Player, flagId: string): any
	local flags = ensureFFlags(getSave(player))
	return flags and flags[flagId]
end

-- Truthiness convenience: true only when the flag is explicitly set true.
function Module.HasFFlag(player: Player, flagId: string): boolean
	return Module.GetFFlag(player, flagId) == true
end

----------------------------------------------------------------------
-- Mutations (verb-named, in-place).
----------------------------------------------------------------------

-- Set a flag. `value` defaults to true; pass an explicit value for
-- non-boolean flags. Setting nil clears the flag (prefer ResetFFlag).
function Module.SetFFlag(player: Player, flagId: string, value: any?)
	local flags = ensureFFlags(getSave(player))
	if not flags then return end
	if value == nil then value = true end
	flags[flagId] = value
end

-- Clear a single flag.
function Module.ResetFFlag(player: Player, flagId: string)
	local flags = ensureFFlags(getSave(player))
	if not flags then return end
	flags[flagId] = nil
end

-- Clear every flag for the player. Used by the ResetFFlags admin command.
function Module.ResetFFlags(player: Player)
	local data = getSave(player)
	if not data then return end
	data.FFlags = {}
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/CombatHitboxServer"><![CDATA[-- // CombatHitboxServer.luau //
-- The single hit-detection seam for every attacker in the game.
--
-- See NIER_COMBAT.md for the design.
--
-- What changed: hit detection used to be a ONE-SHOT query fired at the
-- instant the active window opened, duplicated in the player server and
-- the NPC server. Two consequences fell out of that:
--
--   * A target that stepped into the swing 50 ms after the window
--     opened was never hit, because nothing looked again. Swings felt
--     like they passed through people.
--   * The client's reported timing was the only thing describing "how
--     long is this active for", which is exactly the value a hostile
--     client wants to inflate.
--
-- Hitboxes are now SCHEDULED windows owned by the server clock. A
-- window pulses at a fixed tick across its authored duration, de-duped
-- through HitCache, and is capped at the move's MaxTargets. The client
-- has no say in when a window opens, how long it lasts, or what it hit.

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local HitboxUtility = ReplicatedModules.Utility.Hitbox
local HitCacheUtility = ReplicatedModules.Utility.HitCache
local CombatFactions = ReplicatedModules.Data.CombatFactions

local Module = {}

-- Pulse rate for an active window. 20 Hz is fine-grained enough that a
-- character running at full speed cannot cross a 5-stud box between
-- pulses, and coarse enough that a long window costs a handful of
-- queries rather than one per frame.
local PULSE_INTERVAL = 0.05

-- Diagnostic: log victims the faction gate drops. A rejection is
-- otherwise completely silent — the swing runs, the window pulses, and
-- CanHit discards every candidate with a reason nobody reads, which is
-- indistinguishable from a whiff. Only fires on an actual rejection, so
-- it costs nothing while combat is healthy. Deduped per window per
-- victim so a 20 Hz pulse cannot flood.
local DEBUG_HIT_DENIALS = true

-- Separate flag: this one fires on EVERY missed swing, so it is noisy by
-- nature. Turn it on only when hits are vanishing and the faction log
-- above is silent — that combination means the box found nobody, which
-- points at hitbox geometry or active-window timing rather than factions.
local DEBUG_EMPTY_WINDOWS = false

-- One reusable OverlapParams for the hot path. Rewriting the filter
-- list per query is far cheaper than allocating a new params object,
-- and matches the existing performance practice in this codebase.
local meleeOverlap = OverlapParams.new()
meleeOverlap.FilterType = Enum.RaycastFilterType.Exclude

export type MeleeHumanoidQuery = {
	Attacker: Model,
	CFrame: CFrame,
	Size: Vector3,
}

export type MeleeHumanoidQueryResult = {
	PartCount: number,
	Humanoids: { Humanoid },
}

----------------------------------------------------------------------
-- Raw one-shot query. Kept as the primitive every scheduled window is
-- built from, and still directly useful for instantaneous effects
-- (skill recipes, ground slams) that are not swing-shaped.
----------------------------------------------------------------------
function Module.QueryMeleeHumanoids(query: MeleeHumanoidQuery): MeleeHumanoidQueryResult
	local attacker = query.Attacker
	if not attacker or not attacker.Parent then
		return { PartCount = 0, Humanoids = {} }
	end

	meleeOverlap.FilterDescendantsInstances = { attacker }
	local hitParts = HitboxUtility.GetHitboxResult(query.CFrame, query.Size, meleeOverlap)
	if #hitParts == 0 then
		return { PartCount = 0, Humanoids = {} }
	end

	return {
		PartCount = #hitParts,
		Humanoids = HitboxUtility.FindHumanoidsFromHits(hitParts),
	}
end

----------------------------------------------------------------------
-- Scheduled active windows.
--
-- `RunHitboxWindow` owns the whole lifetime of one hitbox: it waits out
-- the window's lead-in, pulses until the duration expires, and calls
-- OnHit exactly once per distinct victim (subject to HitOnce).
--
-- The origin is resolved through a CALLBACK rather than captured as a
-- CFrame. Attacks no longer move the attacker horizontally, but the
-- attacker is still free to be moved BY something else while its own
-- window is open — a hover holding it up, a launch it is riding, an
-- incoming drag — and a player is still turning under their own
-- control. Capturing the CFrame up front would leave the hitbox behind
-- in every one of those cases.
----------------------------------------------------------------------
export type HitboxSpec = {
	Id: string?,
	Offset: number,        -- forward studs from the caster's root
	Size: Vector3,
	ActiveAt: number?,     -- delay from the call, seconds
	Duration: number,
	MaxTargets: number?,
	HitOnce: boolean?,
}

export type HitboxWindowRequest = {
	Attacker: Model,
	Spec: HitboxSpec,
	TargetMode: string?,
	AllowFriendlyFire: boolean?,
	-- Returns the world CFrame the box should be built around, or nil to
	-- abort the window (character gone, action cancelled).
	ResolveOrigin: () -> CFrame?,
	-- Return false to stop pulsing early — the runtime uses this to drop
	-- a window the moment its action loses ownership of the caster.
	ShouldContinue: (() -> boolean)?,
	-- Called once per accepted victim.
	OnHit: (victim: Model, humanoid: Humanoid) -> (),
	-- Called once after the window closes, with the victim list.
	OnComplete: ((victims: { Model }) -> ())?,
	-- Optional shared cache so a multi-box move hits each victim once
	-- across ALL of its boxes rather than once per box.
	Cache: any?,
}

-- Runs one window. Returns a cancel function.
function Module.RunHitboxWindow(request: HitboxWindowRequest): () -> ()
	local cancelled = false
	local function cancel()
		cancelled = true
	end

	local spec = request.Spec
	local attacker = request.Attacker
	local targetMode = request.TargetMode or CombatFactions.TargetModes.Hostiles
	local maxTargets = spec.MaxTargets or 8
	local cache = request.Cache or HitCacheUtility.New()
	local victims: { Model } = {}
	local reported: { [Model]: boolean } = {}
	local sawHumanoids = 0

	task.spawn(function()
		if (spec.ActiveAt or 0) > 0 then
			task.wait(spec.ActiveAt)
		end
		if cancelled then return end

		local deadline = os.clock() + math.max(spec.Duration, 0.01)
		repeat
			if cancelled then break end
			if request.ShouldContinue and not request.ShouldContinue() then break end
			if not attacker.Parent then break end

			local origin = request.ResolveOrigin()
			if not origin then break end

			local result = Module.QueryMeleeHumanoids({
				Attacker = attacker,
				CFrame = origin * CFrame.new(0, 0, -(spec.Offset or 0)),
				Size = spec.Size,
			})

			sawHumanoids += #result.Humanoids
			for _, humanoid in result.Humanoids do
				if #victims >= maxTargets then break end
				if not HitCacheUtility.ShouldHit(cache, humanoid) then continue end

				local victim = humanoid.Parent
				if not victim or not victim:IsA('Model') then continue end

				-- Faction gate runs for EVERY attacker now. Previously
				-- only the NPC path consulted it, so a player swing could
				-- damage a friendly NPC that an NPC swing could not.
				local canHit, denialReason = CombatFactions.CanHit(attacker, victim, {
					TargetMode = targetMode,
					AllowFriendlyFire = request.AllowFriendlyFire,
				})
				if not canHit then
					if DEBUG_HIT_DENIALS and not reported[victim] then
						reported[victim] = true
						warn(string.format(
							'[CombatHitbox] %s -> %s REJECTED: %s (attackerTagged=%s targetTagged=%s attackerFaction=%s targetFaction=%s)',
							attacker.Name, victim.Name, denialReason,
							tostring(CombatFactions.IsCombatant(attacker)),
							tostring(CombatFactions.IsCombatant(victim)),
							CombatFactions.GetFactionId(attacker),
							CombatFactions.GetFactionId(victim)))
					end
					continue
				end

				victims[#victims + 1] = victim
				request.OnHit(victim, humanoid)
			end

			if #victims >= maxTargets then break end
			task.wait(PULSE_INTERVAL)
		until os.clock() >= deadline

		-- Distinguishes "the box was empty" from "the box found people and
		-- the faction gate dropped them all" — the two failure modes look
		-- identical from the player's side.
		if DEBUG_EMPTY_WINDOWS and #victims == 0 and sawHumanoids == 0 then
			warn(string.format(
				'[CombatHitbox] %s window closed with an EMPTY box (offset=%.2f size=%s)',
				attacker.Name, spec.Offset or 0, tostring(spec.Size)))
		end

		if request.OnComplete and not cancelled then
			request.OnComplete(victims)
		end
	end)

	return cancel
end

----------------------------------------------------------------------
-- Active-window registry.
--
-- Perfect evade needs to answer "was an enemy hitbox actually live and
-- pointed at me when I dodged?". The old implementation approximated
-- that with "is any nearby model's Attacking attribute set", which is
-- true for the entire swing including windup and recovery — so dodging
-- at any point during a telegraph counted as a perfect read.
--
-- Attackers register their live windows here for the exact duration the
-- box is dangerous, and the dodge path queries the registry instead.
----------------------------------------------------------------------
type ActiveWindow = {
	Attacker: Model,
	ExpiresAt: number,
	Origin: () -> CFrame?,
	Size: Vector3,
	Offset: number,
}

local ActiveWindows: { [string]: ActiveWindow } = {}

function Module.RegisterActiveWindow(actionId: string, window: ActiveWindow)
	ActiveWindows[actionId] = window
end

function Module.UnregisterActiveWindow(actionId: string)
	ActiveWindows[actionId] = nil
end

-- Is `model` currently inside (or within `grace` of) any live enemy
-- hitbox? Returns the attacker whose window covers it, if any.
function Module.FindThreateningWindow(model: Model, grace: number?): Model?
	local root = model and model:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not root then return nil end
	local currentTime = workspace:GetServerTimeNow()
	local padding = grace or 0

	for actionId, window in ActiveWindows do
		if currentTime > window.ExpiresAt then
			ActiveWindows[actionId] = nil
			continue
		end
		local attacker = window.Attacker
		if not attacker or not attacker.Parent or attacker == model then continue end

		local canHit = CombatFactions.CanHit(attacker, model, {
			TargetMode = CombatFactions.TargetModes.Hostiles,
		})
		if not canHit then continue end

		local origin = window.Origin()
		if not origin then continue end

		-- Cheap containment test against the box's half-extents, padded
		-- by `grace` so a dodge that beats the window by a hair still
		-- reads as a perfect evade rather than a near miss.
		local boxCFrame = origin * CFrame.new(0, 0, -window.Offset)
		local local_ = boxCFrame:PointToObjectSpace(root.Position)
		local half = (window.Size * 0.5)
		local reach = padding * 16 -- grace expressed as seconds of travel
		if math.abs(local_.X) <= half.X + reach
			and math.abs(local_.Y) <= half.Y + reach
			and math.abs(local_.Z) <= half.Z + reach then
			return attacker
		end
	end
	return nil
end

function Module.Start()
	-- Sweep expired windows so a caster that died mid-swing cannot leave
	-- a permanently "threatening" entry behind.
	task.spawn(function()
		while true do
			task.wait(1)
			local currentTime = workspace:GetServerTimeNow()
			for actionId, window in ActiveWindows do
				if currentTime > window.ExpiresAt or not window.Attacker.Parent then
					ActiveWindows[actionId] = nil
				end
			end
		end
	end)
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/CombatServer"><![CDATA[-- // CombatServer.luau //
-- The single door into combat. Players and NPCs both arrive here.
--
-- See NIER_COMBAT.md for the design.
--
-- The rule this module exists to enforce: THE CALLER DIFFERS, THE RULES
-- DO NOT. A player attack arrives from a remote and an NPC attack
-- arrives from a behaviour tree, but from `AttemptStartAttack` onward
-- they share combo grammar, context resolution, cancel windows, target
-- acquisition, the action runtime, hit detection, damage, poise, motion
-- and faction filtering. Previously there were three attack paths with
-- three different feature sets, which is why launchers, juggles and
-- combo chains existed for players only.
--
-- Also here: the combatant registry (per-model runtime rows), the input
-- buffer that makes chains forgiving, and perfect-evade resolution.

local Players = game:GetService('Players')
local CollectionService = game:GetService('CollectionService')

local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))
local AgroModule = ServerModules.Modules.AgroModule

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CombatConfigModule = ReplicatedModules.Data.CombatConfig
local CombatActions = ReplicatedModules.Data.CombatActions
local CombatFactions = ReplicatedModules.Data.CombatFactions
local MobsConfig = ReplicatedModules.Data.Mobs
local CombatShared = ReplicatedModules.Services.CombatShared
local CombosShared = ReplicatedModules.Services.CombosShared
local CharacterStates = ReplicatedModules.Services.CharacterStates
local CombatUtility = ReplicatedModules.Utility.CombatUtility

local RemoteService = ReplicatedModules.Services.RemoteService
local CombatEvent = RemoteService.GetRemote('CombatEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function getRoot(model: Model?): BasePart?
	if not model or not model.Parent then return nil end
	return model:FindFirstChild('HumanoidRootPart') :: BasePart?
end

local function flatten(vector: Vector3): Vector3
	return Vector3.new(vector.X, 0, vector.Z)
end

----------------------------------------------------------------------
-- Combatant registry.
--
-- Rows are created lazily on first combat action and weak-keyed, so
-- there is no registration ceremony for NPCs that spawn and despawn
-- constantly, and no leak when a character is destroyed.
----------------------------------------------------------------------
export type CombatantRow = {
	Model: Model,
	OwnerPlayer: Player?,
	ComboString: { string },
	LastInputAt: number,
	LastAttackAt: number,
	LastDodgeAt: number,
	LastCommandId: number,
	CurrentMove: any?,
	CurrentActionId: string?,
	BufferedInput: any?,
	Denials: { [string]: number },
	MalformedCount: number,
	MalformedWindowStart: number,
}

local Rows: { [Model]: CombatantRow } = setmetatable({}, { __mode = 'k' })

local function getRow(model: Model): CombatantRow
	local row = Rows[model]
	if not row then
		row = {
			Model = model,
			OwnerPlayer = Players:GetPlayerFromCharacter(model),
			ComboString = {},
			LastInputAt = 0,
			LastAttackAt = 0,
			LastDodgeAt = 0,
			LastCommandId = 0,
			Denials = {},
			MalformedCount = 0,
			MalformedWindowStart = 0,
		}
		Rows[model] = row
	end
	return row
end

function Module.GetRow(model: Model?): CombatantRow?
	return model and Rows[model] or nil
end

function Module.ResetCombatant(model: Model?)
	if not model then return end
	Rows[model] = nil
	SystemsContainer.CombatStateServer.Reset(model)
	SystemsContainer.CombatMotionServer.ClearMotion(model)
end

local function resetCombo(row: CombatantRow)
	row.ComboString = {}
	row.LastInputAt = 0
	row.BufferedInput = nil
	-- Also drop the tracked move. A queued replay checks BufferedInput
	-- identity so it will not fire, but leaving a stale CurrentMove
	-- behind means the next input runs a cancel-window check against a
	-- move that is no longer running.
	row.CurrentMove = nil
	row.CurrentActionId = nil
end

----------------------------------------------------------------------
-- Denial logging. Cheap counters rather than a print per rejection —
-- NIER_COMBAT.md is explicit that combat must not log every event in
-- production, and the previous build printed on every action.
----------------------------------------------------------------------
local function denied(row: CombatantRow, reason: string): (boolean, string)
	row.Denials[reason] = (row.Denials[reason] or 0) + 1
	return false, reason
end

function Module.GetDenialCounts(model: Model?): { [string]: number }
	local row = model and Rows[model]
	return row and row.Denials or {}
end

----------------------------------------------------------------------
-- Target acquisition.
--
-- Used to decide which way a swing faces and which victim a launch or
-- slam is aimed along. This was previously player-only and scanned every
-- tagged AI plus every player on each swing; it now serves NPCs too and
-- filters candidates through CombatFactions first, so an NPC never turns
-- to swing at an ally.
--
-- A client-supplied lock-on target is a HINT: it skips the search when
-- it validates, and is silently ignored when it does not.
----------------------------------------------------------------------
local function isValidTrackTarget(caster: Model, target: Model?, allowBehind: boolean): (boolean, number)
	if not target or target == caster then return false, 0 end
	if target:GetAttribute('NoCombatApproach') == true then return false, 0 end

	local casterRoot = getRoot(caster)
	local targetRoot = getRoot(target)
	if not casterRoot or not targetRoot then return false, 0 end

	local humanoid = target:FindFirstChildOfClass('Humanoid')
	if not humanoid or humanoid.Health <= 0 then return false, 0 end

	local canHit = CombatFactions.CanHit(caster, target, {
		TargetMode = CombatFactions.TargetModes.Hostiles,
	})
	if not canHit then return false, 0 end

	local cfg = CombatConfigModule.CombatConfig
	local offset = flatten(targetRoot.Position - casterRoot.Position)
	local distance = offset.Magnitude
	if distance > (cfg.ATTACK_TRACK_RADIUS or 16) then return false, 0 end

	-- Very close targets and explicitly locked targets bypass the cone,
	-- so turning slightly away mid-chain does not drop the follow.
	if allowBehind or distance <= (cfg.ATTACK_TRACK_CLOSE_RANGE or 5) then
		return true, distance
	end

	local facing = flatten(casterRoot.CFrame.LookVector)
	if facing.Magnitude <= 0.01 or offset.Magnitude <= 0.01 then
		return true, distance
	end
	if facing.Unit:Dot(offset.Unit) < (cfg.ATTACK_TRACK_CONE_DOT or 0.15) then
		return false, 0
	end
	return true, distance
end

-- One reusable params object for the per-swing proximity sweep below.
local trackOverlap = OverlapParams.new()
trackOverlap.FilterType = Enum.RaycastFilterType.Exclude

-- Candidates that are not registered combatants never appear in the tag
-- scan: a Studio rig, an NPC clone that has not reached
-- EnemyServer.InitializeMob yet, anything authored ahead of code. Since
-- CanHit lets a swing DAMAGE those, leaving them out of acquisition made
-- the swing silently refuse to face the very thing it was hitting, and
-- aimed any launch along a stale heading.
--
-- One bounded broadphase sweep per swing closes the gap, and it is not
-- obviously more expensive than the tag scan it complements (that one
-- walks every tagged AI in the world; this one is capped at the track
-- radius). Legality is still decided by isValidTrackTarget -> CanHit.
local function considerNearbyHumanoids(caster: Model, consider: (Model?) -> ())
	local root = getRoot(caster)
	if not root then return end

	local radius = CombatConfigModule.CombatConfig.ATTACK_TRACK_RADIUS or 16
	trackOverlap.FilterDescendantsInstances = { caster }

	local seen: { [Model]: boolean } = {}
	for _, part in workspace:GetPartBoundsInRadius(root.Position, radius, trackOverlap) do
		-- Same part -> character mapping HitboxUtility.FindHumanoidsFromHits
		-- uses, so acquisition and hit detection agree on what counts as a
		-- character.
		local model = part.Parent
		if model and model:IsA('Model') and not seen[model]
			and model:FindFirstChildWhichIsA('Humanoid') then
			seen[model] = true
			consider(model)
		end
	end
end

function Module.AcquireTarget(caster: Model, hint: Model?): Model?
	if hint then
		local ok = isValidTrackTarget(caster, hint, true)
		if ok then return hint end
	end

	local best: Model? = nil
	local bestDistance = math.huge
	local function consider(candidate: Model?)
		local ok, distance = isValidTrackTarget(caster, candidate, false)
		if ok and distance < bestDistance then
			bestDistance = distance
			best = candidate
		end
	end

	-- Candidate tags come from the faction rules rather than a hardcoded
	-- 'AICharacter' scan, so NPC-vs-NPC targeting works without a second
	-- code path.
	local tags = CombatFactions.GetCandidateTagsForTargetMode(caster, CombatFactions.TargetModes.Hostiles)
	for _, tag in tags do
		for _, candidate in CollectionService:GetTagged(tag) do
			if candidate:IsA('Model') then
				consider(candidate)
			end
		end
	end
	-- Players may not carry the faction tag in every rig; include them
	-- explicitly so PvP target tracking still works.
	for _, player in Players:GetPlayers() do
		if player.Character and player.Character ~= caster then
			consider(player.Character)
		end
	end

	-- Unregistered humanoids in melee range. Runs alongside the tag scan
	-- rather than only as a fallback: a rig two studs in front should win
	-- over a tagged enemy fifteen studs away, and `consider` already
	-- resolves that by distance.
	considerNearbyHumanoids(caster, consider)

	return best
end

----------------------------------------------------------------------
-- Damage resolvers. The only place where player and NPC differ.
----------------------------------------------------------------------
local function makePlayerDamageResolver(caster: Model, inputKind: string, move: any, perfectCounter: boolean)
	local handIndex = inputKind == CombatActions.InputKinds.Heavy and 2 or 1
	local weaponConfig = CombatUtility.ResolveWeaponConfig(caster, handIndex)
	local stack = CombatUtility.ResolveWeaponStack(caster, handIndex)
	local cfg = CombatConfigModule.CombatConfig

	-- PvP degrades the effective move: capped chain length and, by
	-- default, no finishers. Resolved once rather than per victim.
	local pvpMove = move
	if move.IsFinisher and cfg.PvP_FINISHER_ENABLED ~= true then
		pvpMove = CombosShared.GetMove(move.WeaponClass, move.Context, 'L')
	end

	return weaponConfig, stack, function(_victim: Model, _humanoid: Humanoid, isPvP: boolean): number
		return CombatUtility.CalculateAttackDamage(caster, weaponConfig, 10, stack, {
			ComboEntry = isPvP and pvpMove or move,
			PerfectCounter = perfectCounter,
			IsPvP = isPvP,
		})
	end
end

local function makeNpcDamageResolver(caster: Model, move: any)
	local primary = CombatUtility.ResolvePrimaryWeapon(caster)
	local weaponConfig = primary and primary.Config

	-- Unarmed mobs are normal, not an error: most enemies fight with
	-- claws and hooves rather than an equipped item. Their damage comes
	-- from the mob config's AttackDamage, which becomes the fallback
	-- CalculateAttackDamage uses when there is no WeaponUsage to roll.
	local fallbackDamage = 10
	local mobId = caster:GetAttribute('AIClass')
	if typeof(mobId) == 'string' then
		local mobConfig = MobsConfig.Mobs[mobId]
		if mobConfig and typeof(mobConfig.AttackDamage) == 'number' then
			fallbackDamage = mobConfig.AttackDamage
		end
	end

	return weaponConfig, function(_victim: Model, _humanoid: Humanoid, isPvP: boolean): number
		local damage = CombatUtility.CalculateAttackDamage(caster, weaponConfig, fallbackDamage, nil, {
			ComboEntry = move,
			IsPvP = isPvP,
		})
		-- Per-floor difficulty scaling stamped by EnemyServer.InitializeMob.
		-- Applied before the defender's mitigation, which still runs
		-- inside DamageHumanoid.
		local multiplier = caster:GetAttribute('DamageMul')
		if typeof(multiplier) == 'number' and multiplier > 0 then
			damage *= multiplier
		end
		return damage
	end
end

----------------------------------------------------------------------
-- The unified attack path.
----------------------------------------------------------------------
export type AttackOptions = {
	InputKind: string,
	ClaimedComboKey: string?,
	TargetHint: Model?,
	CommandId: number?,
	OwnerPlayer: Player?,
	IsNpc: boolean?,
}

function Module.AttemptStartAttack(caster: Model, options: AttackOptions): (boolean, string)
	local CombatStateServer = SystemsContainer.CombatStateServer
	local CombatActionRuntimeServer = SystemsContainer.CombatActionRuntimeServer

	if not caster or not caster.Parent then return false, 'CasterUnavailable' end
	local row = getRow(caster)

	local inputKind = options.InputKind
	if not CombosShared.IsValidInput(inputKind) then
		return denied(row, 'BadInputKind')
	end

	local canStart, reason = CombatStateServer.CanStartAction(caster)
	if not canStart then
		return denied(row, reason)
	end

	----------------------------------------------------------------
	-- Cancel window / input buffer.
	--
	-- If a move is already running, the new input is only allowed once
	-- the running move reaches its authored cancel point. Inputs that
	-- arrive slightly early are BUFFERED and replayed at the cancel
	-- point instead of being dropped — this is what turns mashing into
	-- a fluid chain rather than a lottery.
	----------------------------------------------------------------
	local cfg = CombatConfigModule.CombatConfig
	local buffer = cfg.COMBO_BUFFER or 0.18

	if row.CurrentMove and CombatStateServer.IsActionCurrent(caster, row.CurrentActionId or '') then
		local elapsed = CombatStateServer.GetActionElapsed(caster)
		local allowed, remaining = CombosShared.CanCancelInto(row.CurrentMove, elapsed, inputKind, buffer)
		if not allowed then
			if remaining <= buffer * 2 then
				-- Queue it. Only one input is ever held: a player mashing
				-- five times during a slow hammer swing gets one follow-up,
				-- not five queued swings.
				row.BufferedInput = {
					InputKind = inputKind,
					ClaimedComboKey = options.ClaimedComboKey,
					TargetHint = options.TargetHint,
					CommandId = options.CommandId,
					OwnerPlayer = options.OwnerPlayer,
					IsNpc = options.IsNpc,
				}
				local queued = row.BufferedInput
				task.delay(remaining, function()
					if row.BufferedInput ~= queued then return end
					row.BufferedInput = nil
					Module.AttemptStartAttack(caster, queued)
				end)
				return true, 'Buffered'
			end
			return denied(row, 'CancelWindowClosed')
		end
		-- The cancel is legal: tear down the outgoing move so its
		-- remaining timeline cannot fire hitboxes over the new one.
		CombatActionRuntimeServer.CancelAction(caster, 'ChainCancel')
	end

	----------------------------------------------------------------
	-- Weapon + class + context resolution. All server-side: a client's
	-- claimed class is never consulted.
	----------------------------------------------------------------
	local lightWeapon, heavyWeapon = CombatShared.GetCharacterEquippedWeaponsLR(caster)
	local requestedWeapon = inputKind == CombatActions.InputKinds.Heavy and heavyWeapon or lightWeapon
	if not requestedWeapon then
		-- Fall back to the other slot rather than refusing: a one-handed
		-- loadout should still be able to throw a heavy.
		requestedWeapon = lightWeapon or heavyWeapon
	end

	if not options.IsNpc then
		-- Players must actually be holding something, and have it drawn.
		if not requestedWeapon then
			return denied(row, 'NoWeaponEquipped')
		end
		if not CombatShared.IsWeaponDrawn(caster) then
			return denied(row, 'WeaponNotDrawn')
		end
	end
	-- NPCs are deliberately exempt from both checks. Most enemies are
	-- unarmed (claws, hooves, bites) and none of them sheathe, so
	-- requiring an equipped-and-drawn weapon would silently disarm the
	-- majority of the bestiary. They resolve to the default class's
	-- moveset and take their damage from mob config.

	local lightClass, heavyClass = CombatShared.GetActiveWeaponClasses(caster)
	local activeClass = CombosShared.ResolveActiveClass(lightClass, heavyClass)

	local perfectCounter = CombatShared.IsPerfectCounterActive(caster)
	local context = CombosShared.ResolveContext(
		CombatStateServer.IsAirborne(caster),
		perfectCounter)

	----------------------------------------------------------------
	-- Chain bookkeeping. The server owns the real combo string; the
	-- client's key is only compared against it.
	----------------------------------------------------------------
	local currentTime = now()
	if (currentTime - row.LastInputAt) > (cfg.COMBO_RESET_WINDOW or 1.5) then
		row.ComboString = {}
	end
	row.LastInputAt = currentTime

	row.ComboString = CombosShared.AppendInput(
		row.ComboString, inputKind, cfg.COMBO_MAX_LENGTH or 4, activeClass, context)

	local comboKey = table.concat(row.ComboString)
	local move, authoritative = CombosShared.ValidateClaim(
		row.ComboString, options.ClaimedComboKey or comboKey, activeClass, context)

	----------------------------------------------------------------
	-- Target acquisition. Decides which way the swing faces and which
	-- way its on-hit displacement points.
	----------------------------------------------------------------
	local target = Module.AcquireTarget(caster, options.TargetHint)

	----------------------------------------------------------------
	-- Damage resolution + side effects.
	----------------------------------------------------------------
	local weaponConfig, stack, resolveDamage
	if options.IsNpc then
		weaponConfig, resolveDamage = makeNpcDamageResolver(caster, move)
	else
		weaponConfig, stack, resolveDamage = makePlayerDamageResolver(caster, inputKind, move, perfectCounter)
	end

	local weaponInflicts = weaponConfig
		and weaponConfig.EquipmentData
		and weaponConfig.EquipmentData.WeaponUsage
		and weaponConfig.EquipmentData.WeaponUsage.Inflicts
		or nil

	local ownerPlayer = options.OwnerPlayer
	local moveId = string.format('%s:%s:%s', activeClass, context, comboKey)

	-- Drop guard, implicitly, so block-cancel-into-attack needs no second
	-- input. Done HERE rather than at the top of the function: every
	-- rejection path above this point must leave the guard standing, or
	-- an input that gets refused would silently disarm the player.
	if CombatShared.IsCharacterBlocking(caster) then
		CombatShared.EndCharacterBlock(caster)
	end

	local result = CombatActionRuntimeServer.StartAction({
		Caster = caster,
		OwnerPlayer = ownerPlayer,
		Move = move,
		MoveId = moveId,
		ComboKey = comboKey,
		Context = context,
		Target = target,
		Authoritative = authoritative,
		CommandId = options.CommandId,
		ResolveDamage = resolveDamage,
		OnActionStarted = function(actionId)
			row.CurrentMove = move
			row.CurrentActionId = actionId
		end,
		OnVictimHit = function(victim, _humanoid, _isPvP, _applied)
			-- Aggro + weapon/forge on-hit effects. Kept out of the
			-- runtime so the runtime stays free of player/NPC branching.
			if ownerPlayer then
				local mobId = victim:GetAttribute('AIClass')
				if mobId then
					AgroModule.IncrementPlayerAgro(mobId, ownerPlayer, 1)
				end
			end
			if weaponInflicts then
				CombatUtility.TryInflictEffects(victim, weaponInflicts, caster)
			end
			if stack then
				CombatUtility.TryInflictModifierEffects(victim, stack, caster)
			end
		end,
	})

	if not result.Accepted then
		return denied(row, result.Reason)
	end

	-- The perfect-evade reward is one-shot: consumed by the swing that
	-- follows the read, landed or not.
	if perfectCounter then
		CombatShared.ConsumePerfectCounterState(caster)
	end

	-- A finisher terminates the chain, so the next press starts fresh.
	if move.IsFinisher then
		row.ComboString = {}
	end

	if ownerPlayer and SystemsContainer.CombatLogServer then
		SystemsContainer.CombatLogServer.Bump(ownerPlayer)
	end
	return true, ''
end

----------------------------------------------------------------------
-- Public entry points. These are the two functions the rest of the game
-- calls; everything above is shared machinery.
----------------------------------------------------------------------
function Module.AttemptStartPlayerAction(player: Player, options: AttackOptions): (boolean, string)
	local character = player.Character
	if not character then return false, 'NoCharacter' end
	options.OwnerPlayer = player
	options.IsNpc = false
	return Module.AttemptStartAttack(character, options)
end

function Module.AttemptStartNpcAction(model: Model, options: AttackOptions): (boolean, string)
	options.OwnerPlayer = nil
	options.IsNpc = true
	return Module.AttemptStartAttack(model, options)
end

----------------------------------------------------------------------
-- Dodge.
--
-- Shared by players and NPCs so both evade with identical i-frames,
-- cooldown and cancel semantics. Dodge is the universal cancel: it
-- interrupts attacks, guards and skills, and is refused only by hard CC
-- and cooldown.
----------------------------------------------------------------------
function Module.AttemptDodge(caster: Model, direction: Vector3?, ownerPlayer: Player?): (boolean, string)
	local CombatStateServer = SystemsContainer.CombatStateServer
	local CombatMotionServer = SystemsContainer.CombatMotionServer

	if not caster or not caster.Parent then return false, 'CasterUnavailable' end
	local row = getRow(caster)

	local canDodge, reason = CombatStateServer.CanDodge(caster)
	if not canDodge then
		return denied(row, reason)
	end

	-- Cancel whatever was running first, so the dodge owns the character
	-- cleanly rather than racing the outgoing move's timeline.
	SystemsContainer.CombatActionRuntimeServer.CancelAction(caster, 'DodgeCancel')
	CharacterStates.SetState(caster, CombatStateServer.Attributes.UsingSkill, nil)
	if CombatShared.IsCharacterBlocking(caster) then
		CombatShared.EndCharacterBlock(caster)
	end
	resetCombo(row)

	-- Perfect evade is resolved BEFORE the dodge state is written, so
	-- the check is not confused by our own i-frames.
	local threat = Module.ResolvePerfectEvade(caster)

	local cfg = CombatConfigModule.CombatConfig
	CombatStateServer.TrySetState(caster, CombatStateServer.States.Dodge, cfg.DODGE_DURATION)
	CharacterStates.SetStateTemporary(caster, CombatStateServer.Attributes.Dodging, cfg.DODGE_DURATION, true)
	if (cfg.DODGE_IFRAME_WINDOW or 0) > 0 then
		CharacterStates.SetStateTemporary(caster, CombatStateServer.Attributes.IFrames,
			cfg.DODGE_IFRAME_WINDOW, true)
	end
	CombatShared.StartDodgeCooldown(caster)

	local heading = direction
	if not heading or heading.Magnitude < 0.1 then
		local root = getRoot(caster)
		heading = root and root.CFrame.LookVector or Vector3.new(0, 0, 1)
	end
	CombatMotionServer.ApplyDodge(caster, heading)

	if threat then
		CombatShared.SetPerfectCounterState(caster, cfg.COUNTER_WINDOW or 1.5)
		if ownerPlayer then
			CombatEvent:FireClient(ownerPlayer, CombatActions.Actions.PerfectDodge, {
				Caster = caster,
				Threat = threat,
			})
		end
	end

	CombatEvent:FireAllClients(CombatActions.Actions.ActionStarted, {
		Caster = caster,
		ActionId = 'dodge',
		MoveId = 'Dodge',
		Context = 'Dodge',
		Direction = heading,
		ServerTime = now(),
		IsDodge = true,
	})

	if ownerPlayer then
		if SystemsContainer.CombatLogServer then
			SystemsContainer.CombatLogServer.Bump(ownerPlayer)
		end
		Module.GrantDodgeExperience(caster, ownerPlayer)
	end
	return true, ''
end

----------------------------------------------------------------------
-- Perfect evade.
--
-- The old detector asked "is any nearby model's Attacking attribute
-- set", which is true for a swing's entire windup and recovery — so
-- dodging at any point during a slow telegraph counted as a perfect
-- read, and dodging a fast one you actually had to time counted the
-- same. It also fired when the enemy was swinging in a completely
-- different direction.
--
-- It now asks the hitbox registry whether an enemy window is LIVE and
-- whether this character is inside it, which is the real question.
----------------------------------------------------------------------
function Module.ResolvePerfectEvade(caster: Model): Model?
	local grace = CombatConfigModule.CombatConfig.PERFECT_DODGE_OVERLAP_GRACE or 0.12
	return SystemsContainer.CombatHitboxServer.FindThreateningWindow(caster, grace)
end

-- Agility experience for dodging with an enemy actually nearby, so
-- spamming dodge in empty terrain does not pump the stat.
function Module.GrantDodgeExperience(caster: Model, player: Player)
	local AttributeServer = SystemsContainer.AttributeServer
	if not AttributeServer then return end
	local root = getRoot(caster)
	if not root then return end
	for _, npc in CollectionService:GetTagged(CombatFactions.Tags.AICharacter) do
		local npcRoot = npc:FindFirstChild('HumanoidRootPart') :: BasePart?
		if npcRoot and (npcRoot.Position - root.Position).Magnitude < 30 then
			AttributeServer.IncrementAttributeExperience(player, 'Agility', 3)
			return
		end
	end
end

----------------------------------------------------------------------
-- Guard.
----------------------------------------------------------------------
function Module.AttemptGuardStart(caster: Model, ownerPlayer: Player?): (boolean, string)
	local CombatStateServer = SystemsContainer.CombatStateServer
	if not caster or not caster.Parent then return false, 'CasterUnavailable' end
	local row = getRow(caster)

	if not CombatShared.CanCharacterStartBlock(caster) then
		return denied(row, 'GuardUnavailable')
	end
	resetCombo(row)

	local maxHits = CombatConfigModule.CombatConfig.BLOCK_MAX_HITS
	if ownerPlayer and SystemsContainer.AttributeServer then
		maxHits += SystemsContainer.AttributeServer.GetPlayerBonus(ownerPlayer, 'Resolve')
	end
	CharacterStates.SetState(caster, CombatStateServer.Attributes.Blocking, true)
	CharacterStates.SetState(caster, CombatStateServer.Attributes.BlockingCount, maxHits)
	CombatStateServer.TrySetState(caster, CombatStateServer.States.Guard, nil)

	if ownerPlayer and SystemsContainer.CombatLogServer then
		SystemsContainer.CombatLogServer.Bump(ownerPlayer)
	end
	return true, ''
end

function Module.AttemptGuardEnd(caster: Model): (boolean, string)
	if not caster or not caster.Parent then return false, 'CasterUnavailable' end
	CombatShared.EndCharacterBlock(caster)
	local CombatStateServer = SystemsContainer.CombatStateServer
	if CombatStateServer.GetState(caster) == CombatStateServer.States.Guard then
		CombatStateServer.ClearToIdle(caster)
	end
	return true, ''
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	local function bindCharacter(character: Model)
		local humanoid = character:WaitForChild('Humanoid', 10)
		if not humanoid or not humanoid:IsA('Humanoid') then return end
		humanoid.Died:Connect(function()
			SystemsContainer.CombatActionRuntimeServer.CancelAction(character, 'Died')
			Module.ResetCombatant(character)
		end)
	end

	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(bindCharacter)
		if player.Character then bindCharacter(player.Character) end
	end)
	for _, player in Players:GetPlayers() do
		player.CharacterAdded:Connect(bindCharacter)
		if player.Character then bindCharacter(player.Character) end
	end

	Players.PlayerRemoving:Connect(function(player)
		if player.Character then
			Module.ResetCombatant(player.Character)
		end
	end)

	-- NPCs clean up on despawn rather than on death, because a corpse
	-- lingers in workspace for a few seconds after dying.
	CollectionService:GetInstanceRemovedSignal(CombatFactions.Tags.AICharacter):Connect(function(model)
		if model:IsA('Model') then
			Module.ResetCombatant(model)
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/CombatStateServer"><![CDATA[-- // CombatStateServer.luau //
-- Authoritative combat state machine, poise pool, and crowd-control
-- application for every combatant — players and NPCs alike.
--
-- See NIER_COMBAT.md for the design.
--
-- Why this module exists: state used to be a scatter of
-- `CharacterStates.SetStateTemporary` calls spread across the player
-- server, the NPC server and CombatShared, each with its own idea of
-- what could override what. A later, weaker stun could silently clear a
-- stronger one simply by finishing last. Everything that changes combat
-- state now funnels through here so precedence is decided in one place.
--
-- Two representations, on purpose:
--   * The private runtime row is authoritative and holds values that
--     must not be client-visible (poise pool, CC priority, expiries).
--   * Character ATTRIBUTES mirror the coarse state outward so existing
--     gates (CombatShared predicates), client VFX and UI keep working
--     without a new replication channel.

local Players = game:GetService('Players')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CombatConfigModule = ReplicatedModules.Data.CombatConfig
local CombatStatesData = ReplicatedModules.Data.CombatStates
local CharacterStates = ReplicatedModules.Services.CharacterStates
local CombatUtility = ReplicatedModules.Utility.CombatUtility

local STATES = CombatStatesData.States
local ATTR = CombatStatesData.Attributes

----------------------------------------------------------------------
-- State precedence. A higher number wins: a state may only be replaced
-- by one of equal or greater priority, or by the natural expiry of the
-- current one.
--
-- This is what stops a fast light attack from writing `Windup` over a
-- knockdown that is still running.
----------------------------------------------------------------------
local STATE_PRIORITY: { [string]: number } = {
	[STATES.Dead] = 100,
	[STATES.Knockdown] = 90,
	[STATES.Lifted] = 80,
	[STATES.Dragged] = 80,
	[STATES.Stunned] = 70,
	[STATES.Dodge] = 60,
	[STATES.Guard] = 50,
	[STATES.ParryCounter] = 45,
	[STATES.Active] = 40,
	[STATES.Windup] = 35,
	[STATES.Recovery] = 30,
	-- Airborne is POSITIONAL, not a control state, so it deliberately
	-- sits below the action phases.
	--
	-- It used to be 55 — above Windup — which made the whole Air context
	-- unreachable. A launcher puts its own CASTER airborne (so the
	-- follow-up air hit is in range), and an air chain is exactly the
	-- thing you are supposed to do next; but at 55 the follow-up's
	-- TrySetState(Windup) was refused and StartAction returned
	-- 'StateRefused' for the whole 0.83s rise+hover. Being airborne is
	-- the PRECONDITION for the air moveset, so it must never be the
	-- thing that blocks starting it.
	--
	-- Nothing reads the coarse Airborne state: IsAirborne and the client
	-- both read the Airborne/Lifted ATTRIBUTES, which SetAirborne still
	-- writes unconditionally. Lowering this therefore changes only who
	-- may claim the display slot.
	--
	-- Lifted (80) is a separate state on purpose and stays hard CC: the
	-- juggled VICTIM should be helpless, the attacker following them up
	-- should not.
	[STATES.Airborne] = 10,
	[STATES.Idle] = 0,
}

-- States during which a combatant is not accepting new actions at all.
local HARD_CC_STATES: { [string]: boolean } = {
	[STATES.Dead] = true,
	[STATES.Knockdown] = true,
	[STATES.Lifted] = true,
	[STATES.Dragged] = true,
	[STATES.Stunned] = true,
}

local Module = {}

Module.States = STATES
Module.Attributes = ATTR

----------------------------------------------------------------------
-- Runtime rows. Weak-keyed so a destroyed character does not pin its
-- combat state in memory; there is no explicit teardown to forget.
----------------------------------------------------------------------
type PoiseRow = {
	Current: number,
	Max: number,
	LastHitAt: number,
	Archetype: string,
}

type StateRow = {
	Poise: PoiseRow?,
	CurrentActionId: string?,
	ActionStartedAt: number?,
	StatePriority: number,
	StateExpiresAt: number,
	GetupIFramesUntil: number,
	JuggleCount: number,
	LastLaunchAt: number,
}

local Rows: { [Model]: StateRow } = setmetatable({}, { __mode = 'k' })

local function now(): number
	return workspace:GetServerTimeNow()
end

local function getRow(model: Model): StateRow
	local row = Rows[model]
	if not row then
		row = {
			StatePriority = 0,
			StateExpiresAt = 0,
			GetupIFramesUntil = 0,
			JuggleCount = 0,
			LastLaunchAt = 0,
		}
		Rows[model] = row
	end
	return row
end

local function getHumanoid(model: Model?): Humanoid?
	if not model or not model.Parent then return nil end
	return model:FindFirstChildWhichIsA('Humanoid')
end

function Module.IsAlive(model: Model?): boolean
	local humanoid = getHumanoid(model)
	return humanoid ~= nil and humanoid.Health > 0
end

function Module.IsPlayerCharacter(model: Model?): boolean
	if not model then return false end
	return Players:GetPlayerFromCharacter(model) ~= nil
end

----------------------------------------------------------------------
-- Poise.
--
-- Regeneration is computed lazily on read rather than driven by a
-- heartbeat. With dozens of NPCs alive this is the difference between
-- one arithmetic expression per hit and a per-frame loop over every
-- combatant in the world, and the observable behaviour is identical.
----------------------------------------------------------------------
function Module.GetArchetype(model: Model?): (string, any)
	local cfg = CombatConfigModule.CombatConfig
	local archetypes = cfg.POISE_ARCHETYPES or {}
	local name = model and model:GetAttribute('PoiseArchetype')
	if typeof(name) ~= 'string' or not archetypes[name] then
		if Module.IsPlayerCharacter(model) then
			name = 'Player'
		else
			name = cfg.POISE_DEFAULT_ARCHETYPE or 'Fodder'
		end
	end
	return name, archetypes[name] or { MaxPoise = 25, StaggerDuration = 0.5, Launchable = true, MaxJuggle = 3 }
end

local function getPoiseRow(model: Model): PoiseRow
	local row = getRow(model)
	if not row.Poise then
		local archetypeName, archetype = Module.GetArchetype(model)
		-- An explicit MaxPoise attribute lets a single mob be tuned
		-- without inventing a whole archetype for it.
		local override = model:GetAttribute('MaxPoise')
		local max = (typeof(override) == 'number' and override > 0) and override or archetype.MaxPoise
		row.Poise = {
			Current = max,
			Max = max,
			LastHitAt = 0,
			Archetype = archetypeName,
		}
	end
	return row.Poise :: PoiseRow
end

-- Current poise after applying elapsed regeneration. Does not mutate.
function Module.GetPoise(model: Model?): (number, number)
	if not model then return 0, 0 end
	local poise = getPoiseRow(model)
	local cfg = CombatConfigModule.CombatConfig
	local idle = now() - poise.LastHitAt - (cfg.POISE_REGEN_DELAY or 2)
	if idle <= 0 then
		return poise.Current, poise.Max
	end
	local regenerated = math.min(poise.Max, poise.Current + idle * (cfg.POISE_REGEN_RATE or 30))
	return regenerated, poise.Max
end

-- Drain the pool. Returns (didBreak, staggerDuration). A break resets
-- the pool to full so the next stagger costs the attacker the same
-- investment again, rather than every subsequent hit staggering.
function Module.ApplyPoiseDamage(model: Model?, amount: number, isPvP: boolean?): (boolean, number)
	if not model or not Module.IsAlive(model) then return false, 0 end
	if typeof(amount) ~= 'number' or amount <= 0 then return false, 0 end

	-- Bosses and hyper-armoured mobs opt out entirely.
	if model:GetAttribute('PoiseArmor') == true then
		return false, 0
	end

	local poise = getPoiseRow(model)
	local current = Module.GetPoise(model)
	poise.Current = current - amount
	poise.LastHitAt = now()

	-- Mirror outward for debug overlays and future UI. Rounded on the way
	-- out only: the pool regenerates as `current + elapsed * rate`, so the
	-- internal value is meaningfully fractional and must keep its
	-- precision — it is just never worth showing all of it.
	model:SetAttribute(ATTR.Poise, CombatUtility.RoundCombatNumber(math.max(0, poise.Current)))

	if poise.Current > 0 then
		return false, 0
	end

	poise.Current = poise.Max
	model:SetAttribute(ATTR.Poise, poise.Max)

	local _name, archetype = Module.GetArchetype(model)
	local duration = archetype.StaggerDuration or 0.45
	if isPvP then
		duration *= (CombatConfigModule.CombatConfig.STAGGER_PVP_SCALE or 0.45)
	end
	return true, duration
end

function Module.ResetPoise(model: Model?)
	if not model then return end
	local row = Rows[model]
	if row then row.Poise = nil end
	model:SetAttribute(ATTR.Poise, nil)
end

----------------------------------------------------------------------
-- Coarse state writes.
--
-- `TrySetState` is the single door. It refuses to downgrade an
-- unexpired higher-priority state, which is what keeps a swing from
-- stomping a knockdown.
----------------------------------------------------------------------
function Module.GetState(model: Model?): string
	if not model then return STATES.Idle end
	local value = model:GetAttribute(ATTR.CombatState)
	return typeof(value) == 'string' and value or STATES.Idle
end

function Module.TrySetState(model: Model?, state: string, duration: number?): boolean
	if not model or not model.Parent then return false end
	local row = getRow(model)
	local priority = STATE_PRIORITY[state] or 0
	local currentTime = now()

	-- An expired state no longer defends its slot.
	if row.StateExpiresAt > currentTime and priority < row.StatePriority then
		return false
	end

	row.StatePriority = priority
	row.StateExpiresAt = duration and (currentTime + duration) or currentTime

	model:SetAttribute(ATTR.CombatState, state)
	model:SetAttribute(ATTR.CombatStateUntil, duration and (currentTime + duration) or nil)
	return true
end

function Module.ClearToIdle(model: Model?)
	if not model or not model.Parent then return end
	local row = getRow(model)
	row.StatePriority = 0
	row.StateExpiresAt = 0
	model:SetAttribute(ATTR.CombatState, STATES.Idle)
	model:SetAttribute(ATTR.CombatStateUntil, nil)
	model:SetAttribute(ATTR.CurrentMoveId, nil)
	model:SetAttribute(ATTR.CurrentActionId, nil)
end

----------------------------------------------------------------------
-- Action lifecycle. The runtime calls these; nothing else should.
----------------------------------------------------------------------
function Module.BeginAction(model: Model, actionId: string, moveId: string, windup: number): boolean
	if not Module.TrySetState(model, STATES.Windup, windup) then
		return false
	end
	local row = getRow(model)
	row.CurrentActionId = actionId
	row.ActionStartedAt = now()
	model:SetAttribute(ATTR.CurrentActionId, actionId)
	model:SetAttribute(ATTR.CurrentMoveId, moveId)
	return true
end

function Module.IsActionCurrent(model: Model?, actionId: string): boolean
	if not model or not model.Parent then return false end
	return model:GetAttribute(ATTR.CurrentActionId) == actionId
end

function Module.GetActionElapsed(model: Model?): number
	if not model then return math.huge end
	local row = Rows[model]
	if not row or not row.ActionStartedAt then return math.huge end
	return now() - row.ActionStartedAt
end

-- Advance an in-flight action to its next phase, but only if it is
-- still the action that owns the character. Returns false when a dodge,
-- stun or death took ownership in the meantime.
function Module.AdvanceAction(model: Model?, actionId: string, state: string, duration: number): boolean
	if not model or not Module.IsActionCurrent(model, actionId) then return false end
	return Module.TrySetState(model, state, duration)
end

function Module.EndAction(model: Model?, actionId: string): boolean
	if not model or not Module.IsActionCurrent(model, actionId) then return false end
	local row = getRow(model)
	row.CurrentActionId = nil
	row.ActionStartedAt = nil
	CharacterStates.SetState(model, ATTR.Attacking, nil)
	-- Only fall back to Idle if nothing more important took over. A
	-- launcher that ended while its victim knocked us down must not
	-- clear that knockdown.
	local state = Module.GetState(model)
	if state == STATES.Windup or state == STATES.Active or state == STATES.Recovery then
		Module.ClearToIdle(model)
	else
		model:SetAttribute(ATTR.CurrentActionId, nil)
		model:SetAttribute(ATTR.CurrentMoveId, nil)
	end
	return true
end

----------------------------------------------------------------------
-- Crowd control.
--
-- Every CC path lands here so PvP scaling, getup protection and
-- precedence are applied uniformly whether the source was a player
-- swing, an NPC swing, a skill recipe or a status effect.
----------------------------------------------------------------------
export type CCSpec = {
	Duration: number,
	PvPDuration: number?,
	Source: string?,
	MovementLock: boolean?,
}

-- Getup i-frames make hard CC self-limiting: you cannot be re-knocked
-- the instant you stand up, which is what prevents launcher loops.
function Module.HasGetupIFrames(model: Model?): boolean
	if not model then return false end
	local row = Rows[model]
	return row ~= nil and row.GetupIFramesUntil > now()
end

function Module.GrantGetupIFrames(model: Model?, isPvP: boolean?)
	if not model then return end
	local cfg = CombatConfigModule.CombatConfig
	local duration = isPvP and (cfg.GETUP_IFRAMES_PVP or 1.1) or (cfg.GETUP_IFRAMES or 0.9)
	getRow(model).GetupIFramesUntil = now() + duration
	CharacterStates.SetStateTemporary(model, ATTR.IFrames, duration, true)
end

function Module.ApplyStun(model: Model?, duration: number, isPvP: boolean?): boolean
	if not model or not Module.IsAlive(model) then return false end
	if duration <= 0 then return false end
	if isPvP then
		duration *= (CombatConfigModule.CombatConfig.STAGGER_PVP_SCALE or 0.45)
	end
	if not Module.TrySetState(model, STATES.Stunned, duration) then
		return false
	end
	CharacterStates.SetStateTemporary(model, ATTR.Stunned, duration, true)
	-- A stun ends any guard: eating a stagger through a raised guard and
	-- keeping the guard would make block strictly dominant.
	CharacterStates.SetState(model, ATTR.Blocking, nil)
	CharacterStates.SetState(model, ATTR.BlockingCount, nil)
	-- Return the coarse state to Idle once the stun runs out. Without
	-- this the CombatState attribute reads 'Stunned' until some later
	-- action happens to overwrite it, which is harmless for gating (the
	-- expiry is checked) but actively misleading to anything reading the
	-- attribute for display or debugging.
	task.delay(duration, function()
		if model.Parent and Module.GetState(model) == STATES.Stunned then
			Module.ClearToIdle(model)
		end
	end)
	return true
end

function Module.ApplyKnockdown(model: Model?, duration: number?, isPvP: boolean?): boolean
	if not model or not Module.IsAlive(model) then return false end
	local cfg = CombatConfigModule.CombatConfig
	duration = duration
		or (isPvP and (cfg.KNOCKDOWN_PVP_DURATION or 0.5) or (cfg.KNOCKDOWN_DURATION or 0.9))
	if not Module.TrySetState(model, STATES.Knockdown, duration) then
		return false
	end
	CharacterStates.SetStateTemporary(model, ATTR.KnockedDown, duration, true)
	CharacterStates.SetStateTemporary(model, ATTR.Stunned, duration, true)
	-- The knockdown clears airborne bookkeeping: you have landed.
	Module.ClearAirborne(model)
	task.delay(duration, function()
		if not model.Parent then return end
		if Module.GetState(model) == STATES.Knockdown then
			Module.ClearToIdle(model)
		end
		if Module.IsAlive(model) then
			Module.GrantGetupIFrames(model, isPvP)
		end
	end)
	return true
end

----------------------------------------------------------------------
-- Airborne / juggle bookkeeping.
--
-- JuggleCount is the counter that makes juggles terminate. Every launch
-- and every sustaining air hit increments it; the archetype's MaxJuggle
-- decides when further lift degrades into a forced slam.
----------------------------------------------------------------------
function Module.SetAirborne(model: Model?, duration: number)
	if not model then return end
	CharacterStates.SetStateTemporary(model, ATTR.Airborne, duration, true)
	Module.TrySetState(model, STATES.Airborne, duration)
end

function Module.SetLifted(model: Model?, duration: number)
	if not model then return end
	CharacterStates.SetStateTemporary(model, ATTR.Lifted, duration, true)
	CharacterStates.SetStateTemporary(model, ATTR.Airborne, duration, true)
	Module.TrySetState(model, STATES.Lifted, duration)
end

function Module.ClearAirborne(model: Model?)
	if not model then return end
	CharacterStates.SetState(model, ATTR.Airborne, nil)
	CharacterStates.SetState(model, ATTR.Lifted, nil)
	model:SetAttribute(ATTR.JuggleCount, nil)
	local row = Rows[model]
	if row then row.JuggleCount = 0 end
end

function Module.IsAirborne(model: Model?): boolean
	if not model then return false end
	return CharacterStates.GetStateTemporary(model, ATTR.Airborne) == true
		or CharacterStates.GetStateTemporary(model, ATTR.Lifted) == true
end

function Module.GetJuggleCount(model: Model?): number
	if not model then return 0 end
	local row = Rows[model]
	return row and row.JuggleCount or 0
end

function Module.IncrementJuggle(model: Model?): number
	if not model then return 0 end
	local row = getRow(model)
	row.JuggleCount += 1
	model:SetAttribute(ATTR.JuggleCount, row.JuggleCount)
	return row.JuggleCount
end

-- Whether this victim may be lifted at all, and how many more air hits
-- it will tolerate. Elites and bosses return false so a launcher
-- degrades into a stagger rather than doing nothing at all.
function Module.CanReceiveLaunch(model: Model?, isPvP: boolean?): (boolean, string)
	if not model or not Module.IsAlive(model) then return false, 'TargetUnavailable' end
	if model:GetAttribute('LaunchImmune') == true then return false, 'LaunchImmune' end
	if Module.HasGetupIFrames(model) then return false, 'GetupProtected' end

	local _name, archetype = Module.GetArchetype(model)
	if not archetype.Launchable then return false, 'ArchetypeNotLaunchable' end

	local maxJuggle = archetype.MaxJuggle or 3
	if isPvP then
		maxJuggle = math.min(maxJuggle,
			CombatConfigModule.CombatConfig.PvP_MAX_JUGGLE or 1)
	end
	if Module.GetJuggleCount(model) >= maxJuggle then
		return false, 'JuggleCapped'
	end
	return true, ''
end

----------------------------------------------------------------------
-- Action gates.
--
-- These are the authoritative counterparts to the client's optimistic
-- predicates. The client runs the same shape of check for feel; this
-- one decides.
----------------------------------------------------------------------
function Module.IsHardCrowdControlled(model: Model?): boolean
	if not model then return true end
	if HARD_CC_STATES[Module.GetState(model)] then
		-- Trust the expiry rather than the attribute alone: a state whose
		-- timer has run out should not keep gating actions if the clearing
		-- task was delayed.
		--
		-- The row is the preferred source, but `Rows` is WEAK-KEYED, so it
		-- can vanish while the CombatState attribute still reads a hard-CC
		-- value. This used to `return true` whenever the row was missing,
		-- which fails CLOSED: once that happened the combatant was
		-- permanently 'CrowdControlled' and could never act again, with no
		-- timer left anywhere to clear it.
		--
		-- CombatStateUntil is written by TrySetState alongside the state
		-- itself and survives the row, so it is the correct fallback. If
		-- neither source shows a live expiry we have no evidence of an
		-- active CC and must not invent one.
		local row = Rows[model]
		local expiresAt = row and row.StateExpiresAt
		if expiresAt == nil then
			local mirrored = model:GetAttribute(ATTR.CombatStateUntil)
			expiresAt = typeof(mirrored) == 'number' and mirrored or 0
		end
		if expiresAt > now() then
			return true
		end
	end
	-- Compatibility attributes may be set by systems that have not moved
	-- onto this module yet (status effects, skills, legacy callers).
	for _, attribute in CombatStatesData.HardCrowdControlAttributes do
		if CharacterStates.GetStateTemporary(model, attribute) == true then
			return true
		end
	end
	return false
end

function Module.CanStartAction(model: Model?): (boolean, string)
	if not Module.IsAlive(model) then return false, 'NotAlive' end
	if Module.IsHardCrowdControlled(model) then return false, 'CrowdControlled' end
	if CharacterStates.GetStateTemporary(model, ATTR.SwordDrawing) == true then
		return false, 'DrawingWeapon'
	end
	return true, ''
end

-- Dodge is deliberately permissive — it is the escape verb, and NieR's
-- feel depends on being able to bail out of nearly anything. The only
-- refusals are hard CC, death and cooldown.
function Module.CanDodge(model: Model?): (boolean, string)
	if not Module.IsAlive(model) then return false, 'NotAlive' end
	if Module.IsHardCrowdControlled(model) then return false, 'CrowdControlled' end
	if CharacterStates.GetStateTemporary(model, ATTR.Dodging) == true then
		return false, 'AlreadyDodging'
	end
	local untilTime = model and model:GetAttribute(ATTR.DodgeCooldownUntil)
	if typeof(untilTime) == 'number' and untilTime > now() then
		return false, 'DodgeCooldown'
	end
	return true, ''
end

function Module.HasIFrames(model: Model?): boolean
	if not model then return false end
	return CharacterStates.GetStateTemporary(model, ATTR.IFrames) == true
		or Module.HasGetupIFrames(model)
end

----------------------------------------------------------------------
-- Cleanup. Called on death and despawn so a respawned character does
-- not inherit the previous body's poise pool or juggle count.
----------------------------------------------------------------------
function Module.Reset(model: Model?)
	if not model then return end
	Rows[model] = nil
	if not model.Parent then return end
	for _, attribute in {
		ATTR.CombatState, ATTR.CombatStateUntil, ATTR.CurrentActionId, ATTR.CurrentMoveId,
		ATTR.Attacking, ATTR.Stunned, ATTR.KnockedDown, ATTR.Lifted, ATTR.Dragged,
		ATTR.Airborne, ATTR.JuggleCount, ATTR.Poise,
	} do
		model:SetAttribute(attribute, nil)
	end
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/CombatActionRuntimeServer"><![CDATA[-- // CombatActionRuntimeServer.luau //
-- Executes one standard-attack move timeline, for players and NPCs
-- alike. This is the module that makes combat animation-independent.
--
-- See NIER_COMBAT.md for the design.
--
-- The timeline is driven entirely by the server clock against numbers
-- authored in CombatMovesets:
--
--     t = 0                     Windup   state set, ActionStarted sent
--     t = Windup                Active   motion applied, hitboxes armed
--     t = Windup+Active         Recovery motion released, windows closed
--     t = Windup+Active+Recovery         action ends, state returns to Idle
--
-- Nothing here reads an AnimationTrack, waits on an animation event, or
-- accepts a duration from the client. Delete every asset id in
-- CombatConfig.AttackSets and this file behaves identically — swings
-- still land, launchers still launch, slams still knock down. That is
-- the whole point: the visual layer is allowed to fail.
--
-- Cancellation is by token. Every scheduled continuation re-checks that
-- the action still owns the caster before doing anything, so a dodge, a
-- stun, a death or a respawn drops the remainder of the timeline
-- without needing to hunt down individual task handles.


local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))
local DamageModule = ServerModules.Modules.DamageModule

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CombatConfigModule = ReplicatedModules.Data.CombatConfig
local CombatActions = ReplicatedModules.Data.CombatActions
local CombatMovesets = ReplicatedModules.Data.CombatMovesets
local CombatShared = ReplicatedModules.Services.CombatShared
local CharacterStates = ReplicatedModules.Services.CharacterStates
local HitCacheUtility = ReplicatedModules.Utility.HitCache

local RemoteService = ReplicatedModules.Services.RemoteService
local CombatEvent = RemoteService.GetRemote('CombatEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

local ActionSequence = 0

-- Diagnostic: fires only when a LAUNCHER move connects, so it is silent
-- during ordinary combat. Reports which of the four independent gates
-- (claim authority, launch eligibility, juggle cap, slam lock) dropped
-- the lift, since a degraded launcher looks exactly like a normal hit.
local DEBUG_LAUNCH = true

local function now(): number
	return workspace:GetServerTimeNow()
end

local function getRoot(model: Model?): BasePart?
	if not model or not model.Parent then return nil end
	return model:FindFirstChild('HumanoidRootPart') :: BasePart?
end

----------------------------------------------------------------------
-- Request contract.
--
-- The runtime is deliberately ignorant of WHERE damage numbers come
-- from. Players resolve damage through equipped weapon stacks and stat
-- bonuses; NPCs resolve it through mob config and floor scaling. Both
-- pass a `ResolveDamage` closure so this file never grows a branch on
-- "is this a player".
----------------------------------------------------------------------
export type ActionRequest = {
	Caster: Model,
	OwnerPlayer: Player?,
	Move: any,
	MoveId: string,
	ComboKey: string,
	Context: string,
	Target: Model?,
	-- False when the client's combo claim did not match the server's
	-- chain. The swing still resolves, but finisher-only and
	-- launcher-only payloads are suppressed.
	Authoritative: boolean?,
	CommandId: number?,
	ResolveDamage: (victim: Model, humanoid: Humanoid, isPvP: boolean) -> number,
	OnVictimHit: ((victim: Model, humanoid: Humanoid, isPvP: boolean, appliedDamage: number) -> ())?,
	OnActionStarted: ((actionId: string) -> ())?,
}

export type ActionResult = {
	Accepted: boolean,
	Reason: string,
	ActionId: string?,
	MoveId: string?,
	ServerTime: number,
	Total: number?,
}

----------------------------------------------------------------------
-- Hit resolution for one victim.
----------------------------------------------------------------------
local function resolveHit(request: ActionRequest, victim: Model, humanoid: Humanoid, indicatorBuffer: { any })
	local CombatStateServer = SystemsContainer.CombatStateServer
	local CombatMotionServer = SystemsContainer.CombatMotionServer

	local caster = request.Caster
	local move = request.Move
	local cfg = CombatConfigModule.CombatConfig
	local isPvP = CombatShared.IsPvPHit(victim, caster)

	-- I-frames and getup protection short-circuit before anything else,
	-- so a dodging or standing-up target eats nothing at all — not
	-- reduced damage, not poise, not motion.
	if CombatStateServer.HasIFrames(victim) then
		return
	end

	-- Guard. A blocked hit consumes a block charge and stops here; a
	-- broken guard falls through to full damage plus the break stun.
	--
	-- `ForceBlockBreak` on the attacker breaks a guard on the first
	-- contact. It is set per-rig by the Studio test dummies, and is the
	-- mechanism a future guard-breaker enemy archetype would use.
	local forceBreak = caster:GetAttribute('ForceBlockBreak') == true
	local blockState = CombatShared.DecrementBlockCount(victim, forceBreak)
	if blockState == CombatShared.BLOCKING_STATE.Decrement then
		return
	end
	if blockState == CombatShared.BLOCKING_STATE.Broken then
		CombatShared.EndCharacterBlock(victim)
		CombatStateServer.ApplyStun(victim,
			(CombatConfigModule.StunDurations and CombatConfigModule.StunDurations.BlockBreak) or 1.4,
			isPvP)
	end

	local damage = request.ResolveDamage(victim, humanoid, isPvP)
	if typeof(damage) ~= 'number' or damage <= 0 then
		return
	end

	local applied = DamageModule.DamageHumanoid(humanoid, damage, request.OwnerPlayer, indicatorBuffer)
	if typeof(applied) ~= 'number' or applied <= 0 then
		return
	end

	if request.OnVictimHit then
		request.OnVictimHit(victim, humanoid, isPvP, applied)
	end

	----------------------------------------------------------------
	-- Poise. Separate from damage: a hit always hurts, but only a hit
	-- that empties the pool staggers. This is what stopped every
	-- connect from hard-stunning and turning fights into lock-loops.
	----------------------------------------------------------------
	local broke, staggerDuration = CombatStateServer.ApplyPoiseDamage(victim, move.PoiseDamage, isPvP)
	if broke and staggerDuration > 0 then
		CombatStateServer.ApplyStun(victim, staggerDuration, isPvP)
	end

	----------------------------------------------------------------
	-- Motion payload. Order matters: slam beats launch beats sustain, so
	-- a move never applies two conflicting vertical impulses to the same
	-- victim.
	--
	-- Every option here is VERTICAL. A landed hit does not push its
	-- victim backwards, and there is no horizontal case below to fall
	-- through to: a hit that is not a slam, a launch or an air sustain
	-- moves the victim not at all. Impact is carried by the hit
	-- animation, the damage and the poise pressure.
	--
	-- Removing the shove is what lets a stationary attacker actually
	-- combo. Nothing closes distance any more, so anything that pushed
	-- the victim away was pushing them out of the reach of the next hit
	-- in the chain.
	----------------------------------------------------------------
	local victimAirborne = CombatStateServer.IsAirborne(victim)

	if move.IsSlam and victimAirborne then
		CombatMotionServer.ApplySlam(victim, caster, {
			Velocity = CombatMovesets.DefaultSlam.Velocity,
			Duration = CombatMovesets.DefaultSlam.Duration,
			Lockout = CombatMovesets.DefaultSlam.Lockout,
			KnockdownDuration = isPvP
				and CombatMovesets.DefaultSlam.PvPKnockdownDuration
				or CombatMovesets.DefaultSlam.KnockdownDuration,
		}, isPvP)
		return
	end

	-- Diagnostic: a launcher that degrades is indistinguishable in game
	-- from a normal hit, and there are four independent reasons it can.
	if DEBUG_LAUNCH and move.IsLauncher then
		local canLaunch, launchReason = CombatStateServer.CanReceiveLaunch(victim, isPvP)
		warn(string.format(
			'[CombatLaunch] %s -> %s move=%s authoritative=%s canLaunch=%s (%s) slamLocked=%s',
			caster.Name, victim.Name, tostring(move.Id), tostring(request.Authoritative ~= false),
			tostring(canLaunch), launchReason == '' and 'ok' or launchReason,
			tostring(CombatMotionServer.IsSlamLocked(victim))))
	end

	if move.IsLauncher and request.Authoritative ~= false then
		local canLaunch, _reason = CombatStateServer.CanReceiveLaunch(victim, isPvP)
		if canLaunch and not CombatMotionServer.IsSlamLocked(victim) then
			local base = CombatMovesets.DefaultLaunch
			local count = CombatStateServer.IncrementJuggle(victim)
			-- Diminishing lift: each successive pop is smaller, so a
			-- juggle ends on its own even before the count cap.
			local decay = (cfg.AIR_JUGGLE_DECAY or 0.7) ^ math.max(0, count - 1)
			local lift = base.Lift * (move.LaunchScale or 1) * decay
			local hoverDuration = base.HoverDuration

			-- No drift: a juggle goes straight up and comes straight down,
			-- so an attacker standing underneath it stays in range for
			-- the whole air chain.
			CombatMotionServer.ApplyLaunch(victim, {
				Lift = lift,
				Duration = base.Duration,
				HoverDuration = hoverDuration,
			}, isPvP)
			CombatStateServer.SetLifted(victim, base.Duration + hoverDuration + 0.1)

			-- The attacker rises with the victim so the follow-up air
			-- hit is actually reachable. This is the other half of
			-- "make them follow".
			local followLift = lift * (cfg.AIR_JUGGLE_ATTACKER_FOLLOW or 0.45)
			CombatMotionServer.ApplyAirFollow(caster, followLift, base.Duration)
			CombatStateServer.SetAirborne(caster, base.Duration + hoverDuration + 0.1)
			return
		end
		-- Launch-immune / capped targets degrade into a stagger rather
		-- than silently doing nothing, so a launcher always reads as
		-- having connected.
		local _name, archetype = CombatStateServer.GetArchetype(victim)
		CombatStateServer.ApplyStun(victim, archetype.StaggerDuration or 0.4, isPvP)
		return
	end

	if move.AirSustain and victimAirborne then
		CombatStateServer.IncrementJuggle(victim)
		local hoverDuration = cfg.AIR_JUGGLE_AIR_HIT_HOVER_DURATION or 0.65
		CombatMotionServer.RefreshHover(victim, hoverDuration, true)
		CombatStateServer.SetLifted(victim, hoverDuration + 0.1)
		CombatMotionServer.RefreshHover(caster, hoverDuration, false)
		CombatStateServer.SetAirborne(caster, hoverDuration + 0.1)
		return
	end

	-- Grounded hit: nothing further. The victim keeps its footing and
	-- its position, and the swing's weight is expressed through damage,
	-- poise and the hit reaction.
end

----------------------------------------------------------------------
-- Timeline execution.
----------------------------------------------------------------------
function Module.StartAction(request: ActionRequest): ActionResult
	local CombatStateServer = SystemsContainer.CombatStateServer
	local CombatMotionServer = SystemsContainer.CombatMotionServer
	local CombatHitboxServer = SystemsContainer.CombatHitboxServer

	local caster = request.Caster
	local move = request.Move
	local serverTime = now()

	if not caster or not caster.Parent then
		return { Accepted = false, Reason = 'CasterUnavailable', ServerTime = serverTime }
	end

	ActionSequence += 1
	local actionId = string.format('%s:%d', caster.Name, ActionSequence)

	if not CombatStateServer.BeginAction(caster, actionId, request.MoveId, move.Windup) then
		return { Accepted = false, Reason = 'StateRefused', ServerTime = serverTime }
	end

	-- Deliberately NO blanket attack cooldown here. The old code armed
	-- `AttackCooldown` for windup+active+recovery, which meant a chain
	-- could not continue until the entire previous swing had played out
	-- — the single biggest reason combos felt stiff. Pacing now comes
	-- from the state machine plus the move's authored cancel windows,
	-- which CombatServer enforces before it ever reaches this function.

	if request.OnActionStarted then
		request.OnActionStarted(actionId)
	end

	-- Tell everyone the swing began. Clients use this purely to drive
	-- cosmetics and to reconcile their predicted combo string.
	CombatEvent:FireAllClients(CombatActions.Actions.ActionStarted, {
		Caster = caster,
		ActionId = actionId,
		MoveId = request.MoveId,
		ComboKey = request.ComboKey,
		Context = request.Context,
		-- The server's acquired target, so the caster's own client can
		-- turn toward the thing the hitbox is actually going to test
		-- against. The server cannot rotate a player itself: their root
		-- is client-owned and a server CFrame write there replicates a
		-- stale transform back, which the player sees as being yanked
		-- backwards mid-swing.
		Target = request.Target,
		AnimationSlot = move.AnimationSlot,
		Windup = move.Windup,
		Active = move.Active,
		Recovery = move.Recovery,
		ServerTime = serverTime,
		CommandId = request.CommandId,
		IsFinisher = move.IsFinisher == true,
	})

	-- Caster motion starts NOW, not at the Windup->Active boundary, and
	-- spans windup+active.
	--
	-- For a ground attack this is just the turn-to-face, and doing it at
	-- the start of the wind-up is the point: the character pivots as the
	-- swing begins rather than snapping around as the box arms.
	--
	-- For an air attack it is the hover that keeps the caster up for the
	-- swing. That one is released by ClearMotionForAction at
	-- Windup+Active below, so it ends exactly when the swing stops being
	-- dangerous — and drops immediately if the swing is cancelled.
	CombatMotionServer.ApplyMoveMotion(caster, request.Target, move, actionId, move.Windup + move.Active)

	local function stillOwned(): boolean
		return caster.Parent ~= nil
			and CombatStateServer.IsActionCurrent(caster, actionId)
			and CombatStateServer.IsAlive(caster)
	end

	----------------------------------------------------------------
	-- Windup -> Active.
	----------------------------------------------------------------
	task.delay(move.Windup, function()
		if not stillOwned() then return end
		if not CombatStateServer.AdvanceAction(caster, actionId, CombatStateServer.States.Active, move.Active) then
			return
		end

		-- Compatibility: several existing systems (mount auto-cancel,
		-- NPC brains) read the Attacking temp state. Keep it aligned to
		-- the real active window rather than the whole swing.
		CharacterStates.SetStateTemporary(caster, CombatStateServer.Attributes.Attacking, move.Active, true)

		local indicatorBuffer = {}
		local sharedCache = HitCacheUtility.New()
		local confirmed: { Model } = {}

		local function resolveOrigin(): CFrame?
			local root = getRoot(caster)
			return root and root.CFrame or nil
		end

		-- Publish the live window so perfect-evade can ask whether a
		-- dodge actually beat a real threat.
		local primary = move.Hitboxes[1]
		if primary then
			CombatHitboxServer.RegisterActiveWindow(actionId, {
				Attacker = caster,
				ExpiresAt = now() + move.Active,
				Origin = resolveOrigin,
				Size = primary.Size,
				Offset = primary.Offset,
			})
		end

		for _, spec in move.Hitboxes do
			CombatHitboxServer.RunHitboxWindow({
				Attacker = caster,
				Spec = spec,
				Cache = spec.HitOnce ~= false and sharedCache or nil,
				ResolveOrigin = resolveOrigin,
				ShouldContinue = stillOwned,
				OnHit = function(victim, humanoid)
					confirmed[#confirmed + 1] = victim
					resolveHit(request, victim, humanoid, indicatorBuffer)
				end,
				OnComplete = function()
					-- One batched broadcast per window instead of one per
					-- victim; the client renders impact VFX from this.
					DamageModule.FireBatchedDamageIndicators(indicatorBuffer)
					if #confirmed > 0 then
						CombatEvent:FireAllClients(CombatActions.Actions.HitConfirmed, {
							Caster = caster,
							ActionId = actionId,
							MoveId = request.MoveId,
							Victims = confirmed,
							IsFinisher = move.IsFinisher == true and request.Authoritative ~= false,
						})
					end
				end,
			})
		end
	end)

	----------------------------------------------------------------
	-- Active -> Recovery.
	----------------------------------------------------------------
	task.delay(move.Windup + move.Active, function()
		SystemsContainer.CombatHitboxServer.UnregisterActiveWindow(actionId)
		CombatMotionServer.ClearMotionForAction(caster, actionId)
		if not stillOwned() then return end
		CombatStateServer.AdvanceAction(caster, actionId, CombatStateServer.States.Recovery, move.Recovery)
	end)

	----------------------------------------------------------------
	-- Recovery -> Idle.
	----------------------------------------------------------------
	task.delay(move.Total, function()
		CombatStateServer.EndAction(caster, actionId)
	end)

	return {
		Accepted = true,
		Reason = '',
		ActionId = actionId,
		MoveId = request.MoveId,
		ServerTime = serverTime,
		Total = move.Total,
	}
end

----------------------------------------------------------------------
-- Cancellation. Used by dodge (the universal cancel), by death, and by
-- any higher-priority CC that takes ownership of the caster.
----------------------------------------------------------------------
function Module.CancelAction(caster: Model?, reason: string?): boolean
	if not caster or not caster.Parent then return false end
	local CombatStateServer = SystemsContainer.CombatStateServer
	local actionId = caster:GetAttribute(CombatStateServer.Attributes.CurrentActionId)
	if typeof(actionId) ~= 'string' then return false end

	SystemsContainer.CombatHitboxServer.UnregisterActiveWindow(actionId)
	SystemsContainer.CombatMotionServer.ClearMotionForAction(caster, actionId)
	CombatStateServer.EndAction(caster, actionId)
	CombatStateServer.ClearToIdle(caster)

	CombatEvent:FireAllClients(CombatActions.Actions.ActionCancelled, {
		Caster = caster,
		ActionId = actionId,
		Reason = reason or 'Cancelled',
	})
	return true
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Core/CombatMotionServer"><![CDATA[-- // CombatMotionServer.luau //
-- Every piece of forced movement in combat: launch, air-follow, juggle
-- hover, slam, drag and the dodge burst.
--
-- See NIER_COMBAT.md for the design.
--
-- ATTACKS DO NOT MOVE THE ATTACKER HORIZONTALLY. There is no step-in
-- and no attack lunge; a swing pivots to face its target and plays,
-- with the feet planted. Two reasons, and the second is the one that
-- matters going forward:
--
--   1. Any horizontal follow is a control loop closed over the network
--      (the attacker's root stays client-owned, because taking that
--      away makes a player's own movement feel rubber-banded on every
--      swing). Server-driven horizontal correction against a
--      client-simulated body oscillated — the attacker visibly pumped
--      forward and back through the swing.
--
--   2. The combat direction is vertical: launchers, juggles and slams.
--      Horizontal step-in and vertical lift are two forced motions
--      competing for the same body at the same time, and every air
--      combo would have to be authored around whatever the step-in
--      happened to be doing. With the horizontal axis empty, a launcher
--      only has to describe its lift.
--
-- NOR DOES A HIT PUSH ITS VICTIM BACK. Knockback is gone too, for the
-- same reason from the other side: with nothing closing distance, a
-- shove just slid the victim out of reach of the next hit in the chain
-- and the back half of every combo whiffed.
--
-- What is left is therefore VERTICAL (launch, hover, air-follow, slam),
-- a scripted pull that a skill explicitly asks for (drag), or a
-- defensive move the player asked for (dodge). Nothing in a standard
-- swing displaces anybody on the horizontal plane.
--
-- Three things changed versus the previous implementation, and they are
-- the reason this module exists at all:
--
--   1. Motion is keyed by MODEL, not by Player. The old slot map was
--      `{[Player]: Motion}`, which structurally excluded NPCs from
--      every movement feature — an NPC could never be launched or
--      juggled. Players and NPCs now share one motion system.
--
--   2. There is ONE slot per model, guarded by priority. Previously a
--      finisher shove, a drag and an air-follow could each parent
--      their own mover to the same HumanoidRootPart and fight over it,
--      producing the "character slides off in a random direction" bug
--      class. A higher-priority motion now preempts and cleans up the
--      lower-priority one.
--
--   3. Movers are LinearVelocity constraints rather than the deprecated
--      BodyVelocity/BodyGyro. Plane mode reproduces BodyVelocity's
--      `MaxForce = (1,0,1)` behaviour exactly — the XZ velocity is
--      driven while gravity keeps acting on Y — but it survives
--      network-ownership changes far more predictably.
--
-- Invariant: moving a victim requires an explicit launch / slam / drag
-- spec on the move, which the PvP rules then scale. A move that authors
-- none of those displaces nobody, including its caster.

local Players = game:GetService('Players')
local RunService = game:GetService('RunService')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CombatConfigModule = ReplicatedModules.Data.CombatConfig
local CombatMovesets = ReplicatedModules.Data.CombatMovesets

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Motion kinds and their precedence. A motion may only be replaced by
-- one of equal or higher priority; anything lower is refused outright
-- so a late-arriving dodge cannot resurrect itself on top of a slam.
----------------------------------------------------------------------
Module.Kinds = {
	-- `Dodge` is the only horizontal motion an attacker can still be
	-- given, and it is a defensive move the player explicitly asked for
	-- rather than something an attack does to them.
	Dodge = 'Dodge',
	AirFollow = 'AirFollow',
	Drag = 'Drag',
	Launch = 'Launch',
	Slam = 'Slam',
}

local PRIORITY: { [string]: number } = {
	Dodge = 15,
	AirFollow = 18,
	Drag = 30,
	Launch = 40,
	Slam = 50,
}

type Motion = {
	Kind: string,
	Priority: number,
	Token: number,
	ActionId: string?,
	Connections: { RBXScriptConnection },
	Instances: { Instance },
	RestoreOwnership: (() -> ())?,
	RestoreController: (() -> ())?,
}

local Motions: { [Model]: Motion } = setmetatable({}, { __mode = 'k' })
local NextToken = 0

local function now(): number
	return workspace:GetServerTimeNow()
end

local function getLiveRoot(model: Model?): (Humanoid?, BasePart?)
	if not model or not model.Parent then return nil, nil end
	local humanoid = model:FindFirstChildOfClass('Humanoid')
	if not humanoid or humanoid.Health <= 0 then return nil, nil end
	local root = model:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not root or root.Anchored then return nil, nil end
	return humanoid, root
end

local function flatten(vector: Vector3): Vector3
	return Vector3.new(vector.X, 0, vector.Z)
end

----------------------------------------------------------------------
-- Humanoid ground controller.
--
-- A Humanoid in a grounded state actively holds itself at hip height
-- above the floor and re-enters Running the moment it touches down. That
-- controller cancels any vertical mover within a frame, which is why
-- planar X/Z movers always worked while launch and slam did nothing at
-- all: the controller has no opinion about horizontal motion and every
-- opinion about vertical. ChangeState(Freefall) alone does not
-- survive the state machine's next re-evaluation.
--
-- Disabling the grounded states is preferred over PlatformStand, which
-- would also work but goes limp — unacceptable for the ATTACKER riding
-- their own juggle, who still needs animation and control.
----------------------------------------------------------------------
local GROUNDED_STATES = {
	Enum.HumanoidStateType.Running,
	Enum.HumanoidStateType.RunningNoPhysics,
	Enum.HumanoidStateType.Climbing,
}

local function suspendGroundController(humanoid: Humanoid?): (() -> ())?
	if not humanoid then return nil end
	local function setGroundedEnabled(enabled: boolean)
		for _, state in GROUNDED_STATES do
			pcall(function()
				humanoid:SetStateEnabled(state, enabled)
			end)
		end
	end

	setGroundedEnabled(false)
	pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Freefall) end)

	local restored = false
	return function()
		if restored then return end
		restored = true
		-- Re-enabling is enough; the state machine re-detects ground and
		-- transitions itself. Forcing a state here would fight it.
		setGroundedEnabled(true)
	end
end

local function safeUnit(vector: Vector3, fallback: Vector3): Vector3
	if vector.Magnitude < 0.01 then return fallback end
	return vector.Unit
end

----------------------------------------------------------------------
-- Network ownership.
--
-- Forced motion on a player-owned character only looks right if the
-- server temporarily owns the physics; otherwise the client's own
-- simulation fights the constraint and the character rubber-bands.
--
-- Claims are reference-counted per part because overlapping motions
-- (a launch that becomes a hover) must not have the first one's
-- restore stomp the second one's claim.
----------------------------------------------------------------------
local OwnershipClaims: { [BasePart]: any } = setmetatable({}, { __mode = 'k' })

local function restoreOwnership(root: BasePart, wasAuto: boolean, previousOwner: Player?)
	if not root or not root.Parent then return end
	local okCanSet, canSet = pcall(function() return root:CanSetNetworkOwnership() end)
	if not okCanSet or not canSet then return end
	if wasAuto then
		pcall(function() root:SetNetworkOwnershipAuto() end)
		return
	end
	pcall(function() root:SetNetworkOwner(previousOwner) end)
end

local function claimServerOwnership(root: BasePart, duration: number): (() -> ())?
	if not RunService:IsServer() then return nil end

	local claim = OwnershipClaims[root]
	if not claim then
		local okCanSet, canSet = pcall(function() return root:CanSetNetworkOwnership() end)
		if not okCanSet or not canSet then return nil end

		local okAuto, wasAuto = pcall(function() return root:GetNetworkOwnershipAuto() end)
		if not okAuto then return nil end

		local previousOwner: Player? = nil
		if not wasAuto then
			local okOwner, owner = pcall(function() return root:GetNetworkOwner() end)
			if okOwner and typeof(owner) == 'Instance' and owner:IsA('Player') then
				previousOwner = owner
			end
		end

		if not pcall(function() root:SetNetworkOwner(nil) end) then return nil end

		claim = { Count = 0, WasAuto = wasAuto, PreviousOwner = previousOwner }
		OwnershipClaims[root] = claim
	end

	claim.Count += 1
	local released = false
	local function release()
		if released then return end
		released = true
		claim.Count -= 1
		if claim.Count > 0 then return end
		if OwnershipClaims[root] ~= claim then return end
		OwnershipClaims[root] = nil
		restoreOwnership(root, claim.WasAuto, claim.PreviousOwner)
	end

	-- Belt-and-braces timeout. If a motion's own cleanup is ever missed,
	-- ownership still comes back rather than leaving the character
	-- permanently server-simulated.
	task.delay(duration + 0.25, release)
	return release
end

----------------------------------------------------------------------
-- Mover construction. All movers hang off a single attachment so
-- cleanup is one Destroy.
----------------------------------------------------------------------
local function makeAttachment(root: BasePart, name: string): Attachment
	local existing = root:FindFirstChild(name)
	if existing then existing:Destroy() end
	local attachment = Instance.new('Attachment')
	attachment.Name = name
	attachment.Parent = root
	return attachment
end

-- Horizontal driver. Plane mode leaves Y untouched, so gravity, jumps
-- and falls continue to behave normally underneath the forced motion.
--
-- `maxForce` is optional and the one current caller (dodge) does not
-- pass it: an evade is supposed to be irresistible. It is kept because
-- a mover that has to stop against another body rather than shove it
-- through needs a finite ceiling, and that is a plausible thing to want
-- again.
local function makePlanarVelocity(attachment: Attachment, velocity: Vector3, maxForce: number?): LinearVelocity
	local mover = Instance.new('LinearVelocity')
	mover.Name = 'CombatPlanarVelocity'
	mover.Attachment0 = attachment
	mover.RelativeTo = Enum.ActuatorRelativeTo.World
	mover.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	mover.PrimaryTangentAxis = Vector3.new(1, 0, 0)
	mover.SecondaryTangentAxis = Vector3.new(0, 0, 1)
	mover.PlaneVelocity = Vector2.new(velocity.X, velocity.Z)
	if maxForce and maxForce > 0 then
		mover.ForceLimitsEnabled = true
		mover.ForceLimitMode = Enum.ForceLimitMode.Magnitude
		mover.MaxForce = maxForce
	else
		mover.ForceLimitsEnabled = false
	end
	mover.Parent = attachment
	return mover
end

-- Vertical driver, used by launch / hover / slam.
local function makeVerticalVelocity(attachment: Attachment, speed: number, name: string): LinearVelocity
	local mover = Instance.new('LinearVelocity')
	mover.Name = name
	mover.Attachment0 = attachment
	mover.RelativeTo = Enum.ActuatorRelativeTo.World
	mover.VelocityConstraintMode = Enum.VelocityConstraintMode.Line
	mover.LineDirection = Vector3.new(0, 1, 0)
	mover.LineVelocity = speed
	mover.ForceLimitsEnabled = false
	mover.Parent = attachment
	return mover
end

-- No orientation mover here on purpose. The only thing that steered a
-- character's facing was the step-in, and it did so with a per-frame
-- AlignOrientation on a body the client also rotates — two writers for
-- one value. Facing is now a single CFrame write in Module.FaceTarget.

-- Cancels gravity so a hovering victim hangs long enough to be hit
-- again, without anchoring (which breaks animation and replication).
local function makeGravityHold(attachment: Attachment, root: BasePart): VectorForce
	local force = Instance.new('VectorForce')
	force.Name = 'CombatGravityHold'
	force.Attachment0 = attachment
	force.ApplyAtCenterOfMass = true
	force.RelativeTo = Enum.ActuatorRelativeTo.World
	force.Force = Vector3.new(0, root.AssemblyMass * workspace.Gravity, 0)
	force.Parent = attachment
	return force
end

----------------------------------------------------------------------
-- Slot management.
----------------------------------------------------------------------
local function destroyMotion(motion: Motion)
	for _, connection in motion.Connections do
		connection:Disconnect()
	end
	table.clear(motion.Connections)
	for _, instance in motion.Instances do
		if instance and instance.Parent then instance:Destroy() end
	end
	table.clear(motion.Instances)
	if motion.RestoreOwnership then
		motion.RestoreOwnership()
		motion.RestoreOwnership = nil
	end
	-- Runs on EVERY teardown path (natural expiry, preemption by a
	-- higher-priority motion, death, despawn), so a suspended ground
	-- controller can never outlive the motion that suspended it and
	-- leave a character permanently unable to stand.
	if motion.RestoreController then
		motion.RestoreController()
		motion.RestoreController = nil
	end
end

-- Clear the model's motion. When `expectedToken` is supplied only that
-- exact motion is cleared, so a delayed cleanup from an old swing can
-- never destroy a newer one's mover.
function Module.ClearMotion(model: Model?, expectedToken: number?): boolean
	if not model then return false end
	local motion = Motions[model]
	if not motion then return false end
	if expectedToken and motion.Token ~= expectedToken then return false end
	Motions[model] = nil
	destroyMotion(motion)
	return true
end

-- Clear only if the current motion belongs to a given action id. Used
-- when an action ends and wants to release its own air hover without
-- touching a launch or slam that landed on it in the meantime.
function Module.ClearMotionForAction(model: Model?, actionId: string): boolean
	if not model then return false end
	local motion = Motions[model]
	if not motion or motion.ActionId ~= actionId then return false end
	return Module.ClearMotion(model, motion.Token)
end

-- Claim the slot. Returns the new motion, or nil when a higher-priority
-- motion already owns the model.
local function beginMotion(model: Model, kind: string, actionId: string?): Motion?
	local priority = PRIORITY[kind] or 0
	local existing = Motions[model]
	if existing and existing.Priority > priority then
		return nil
	end
	if existing then
		Motions[model] = nil
		destroyMotion(existing)
	end

	NextToken += 1
	local motion: Motion = {
		Kind = kind,
		Priority = priority,
		Token = NextToken,
		ActionId = actionId,
		Connections = {},
		Instances = {},
	}
	Motions[model] = motion

	-- A character that dies or despawns mid-motion must not leave a
	-- constraint (or a server ownership claim) behind.
	motion.Connections[#motion.Connections + 1] = model.Destroying:Connect(function()
		Module.ClearMotion(model, motion.Token)
	end)
	return motion
end

function Module.GetMotionKind(model: Model?): string?
	local motion = model and Motions[model]
	return motion and motion.Kind or nil
end

----------------------------------------------------------------------
-- Face the target.
--
-- This is what replaced the step-in, and it is the whole of an attack's
-- effect on the attacker's own transform: a swing turns you toward what
-- you are hitting and then plays, feet planted.
--
-- NPCS ONLY. This writes HumanoidRootPart.CFrame, and only the owner of
-- a part may do that.
--
-- A player's root is client-owned, so a server-side CFrame write there
-- is not "rotate them" — CFrame carries position too, and the position
-- the server has is whatever the client last reported, roughly half a
-- round trip ago. Writing it back replicates that stale transform to a
-- client that has already run past it, and the player sees themselves
-- yanked backwards on every single swing. There is no way to write only
-- the rotation half; the assignment is atomic.
--
-- So player facing is the CLIENT's job and lives in
-- CombatMotionClient.OnActionStarted, which spins the character toward
-- the target over the wind-up. It owns the character, so it can rotate
-- it without fighting anything. This function handles NPCs, whose roots
-- the server genuinely owns.
--
-- Yaw only. Pitch and roll are left alone so this can never lay a
-- character over, and the Y component of the look vector is discarded so
-- a swing at a target on a ledge does not tip the attacker.
----------------------------------------------------------------------
function Module.FaceTarget(caster: Model?, target: Model?): boolean
	if not caster or not target then return false end
	-- The ownership rule above, enforced. A player character never gets
	-- its transform written from here.
	if Players:GetPlayerFromCharacter(caster) then return false end

	local _casterHumanoid, casterRoot = getLiveRoot(caster)
	local _targetHumanoid, targetRoot = getLiveRoot(target)
	if not casterRoot or not targetRoot then return false end

	local heading = flatten(targetRoot.Position - casterRoot.Position)
	if heading.Magnitude < 0.1 then return false end

	casterRoot.CFrame = CFrame.lookAt(casterRoot.Position, casterRoot.Position + heading.Unit)
	return true
end


----------------------------------------------------------------------
-- Launch, hover and air-follow.
--
-- A launch is two beats: a controlled rise, then a hover that holds the
-- victim in place long enough to actually be hit again. Without the
-- hover, gravity returns the victim to the floor before the attacker's
-- next swing can connect and the "air combo" is unreachable.
--
-- The impulse is ballistic: the initial vertical velocity is the one
-- that reaches `lift` studs in `duration` seconds under real gravity,
-- so a launch looks like a launch rather than a teleport.
----------------------------------------------------------------------
local function ballisticLiftVelocity(lift: number, duration: number): number
	return (lift + (0.5 * workspace.Gravity * duration * duration)) / duration
end

export type LaunchSpec = {
	Lift: number,
	Duration: number,
	HoverDuration: number,
	ClaimOwnership: boolean?,
}

-- A hover is PURELY vertical: hold altitude, cancel gravity, and touch
-- the horizontal axis not at all. There used to be a lateral drift here
-- pushing the juggled victim along the attacker's facing; it is gone
-- because it slid the victim out from over the attacker, who no longer
-- has any way to follow. Straight up and straight back down is what
-- keeps an air chain connectable.
local function applyHover(model: Model, motion: Motion, duration: number)
	local _humanoid, root = getLiveRoot(model)
	if not root or duration <= 0 then return end

	local attachment = makeAttachment(root, 'CombatHoverAttachment')
	makeVerticalVelocity(attachment, 0, 'CombatHoverVelocity')
	makeGravityHold(attachment, root)

	motion.Instances[#motion.Instances + 1] = attachment
end

function Module.ApplyLaunch(victim: Model?, spec: LaunchSpec, isPvP: boolean?): boolean
	if not victim then return false end
	local lift = spec.Lift or 0
	local duration = spec.Duration or 0.18
	if lift <= 0 or duration <= 0 then return false end

	local humanoid, root = getLiveRoot(victim)
	if not root then return false end

	if isPvP then
		lift *= (CombatConfigModule.CombatConfig.PvP_AIR_JUGGLE_MULT or 0.35)
	end

	local hoverDuration = spec.HoverDuration or CombatConfigModule.CombatConfig.AIR_JUGGLE_HOVER_DURATION or 0.55
	local total = duration + hoverDuration

	local motion = beginMotion(victim, Module.Kinds.Launch, nil)
	if not motion then return false end

	motion.RestoreOwnership = claimServerOwnership(root, total)

	-- Stops the Humanoid state machine from immediately re-grounding the
	-- character and cancelling the rise. Freefall alone was not enough —
	-- the machine re-evaluates and flips straight back to Running.
	motion.RestoreController = suspendGroundController(humanoid)
	pcall(function()
		local velocity = root.AssemblyLinearVelocity
		local kick = ballisticLiftVelocity(lift, duration)
		if velocity.Y < kick then
			root.AssemblyLinearVelocity = Vector3.new(velocity.X, kick, velocity.Z)
		end
	end)

	local attachment = makeAttachment(root, 'CombatLaunchAttachment')
	makeVerticalVelocity(attachment, lift / duration, 'CombatLaunchVelocity')
	motion.Instances[#motion.Instances + 1] = attachment

	-- Hand off from rise to hover in the same motion slot, so the whole
	-- launch is one preemptible unit.
	task.delay(duration, function()
		if Motions[victim] ~= motion then return end
		if attachment.Parent then attachment:Destroy() end
		applyHover(victim, motion, hoverDuration)
	end)
	task.delay(total, function()
		Module.ClearMotion(victim, motion.Token)
	end)
	return true
end

-- The attacker rises with the victim so an air chain keeps contact.
-- Capped hard: the attacker follows a fraction of the victim's lift and
-- never claims network ownership, because taking physics control away
-- from the player doing the juggling feels dreadful.
function Module.ApplyAirFollow(attacker: Model?, lift: number, duration: number): boolean
	if not attacker or lift <= 0 or duration <= 0 then return false end
	local humanoid, root = getLiveRoot(attacker)
	if not root then return false end

	local cap = CombatConfigModule.CombatConfig.AIR_JUGGLE_ATTACKER_MAX_LIFT or 5
	lift = math.clamp(lift, 0, cap)
	if lift <= 0 then return false end

	local motion = beginMotion(attacker, Module.Kinds.AirFollow, nil)
	if not motion then return false end

	local hoverDuration = CombatConfigModule.CombatConfig.AIR_JUGGLE_HOVER_DURATION or 0.55

	motion.RestoreController = suspendGroundController(humanoid)
	pcall(function()
		local velocity = root.AssemblyLinearVelocity
		local kick = ballisticLiftVelocity(lift, duration)
		if velocity.Y < kick then
			root.AssemblyLinearVelocity = Vector3.new(velocity.X, kick, velocity.Z)
		end
	end)

	local attachment = makeAttachment(root, 'CombatAirFollowAttachment')
	makeVerticalVelocity(attachment, lift / duration, 'CombatAirFollowVelocity')
	motion.Instances[#motion.Instances + 1] = attachment

	task.delay(duration, function()
		if Motions[attacker] ~= motion then return end
		if attachment.Parent then attachment:Destroy() end
		applyHover(attacker, motion, hoverDuration)
	end)
	task.delay(duration + hoverDuration, function()
		Module.ClearMotion(attacker, motion.Token)
	end)
	return true
end

-- Re-arm the hover without a fresh lift. Used when an air hit connects
-- but the juggle is already at its lift cap: the victim stays up for
-- another beat rather than being popped higher every time.
--
-- `actionId` tags the hover as belonging to a specific swing, so
-- ClearMotionForAction can drop it the moment that swing ends or is
-- cancelled. An air attack that gets dodge-cancelled mid-swing should
-- stop holding the attacker up immediately rather than parking them in
-- the air for the rest of the original duration. Victim-side hovers
-- pass nil: they belong to the juggle, not to any one swing.
function Module.RefreshHover(model: Model?, duration: number, claimOwnership: boolean?, actionId: string?): boolean
	if not model or duration <= 0 then return false end
	local humanoid, root = getLiveRoot(model)
	if not root then return false end

	local motion = beginMotion(model, Module.Kinds.AirFollow, actionId)
	if not motion then return false end
	if claimOwnership then
		motion.RestoreOwnership = claimServerOwnership(root, duration)
	end
	-- A hover is pure vertical hold, so it needs the ground controller
	-- suspended for exactly the same reason the launch does.
	motion.RestoreController = suspendGroundController(humanoid)
	applyHover(model, motion, duration)
	task.delay(duration, function()
		Module.ClearMotion(model, motion.Token)
	end)
	return true
end

----------------------------------------------------------------------
-- Slam. Drives an airborne victim into the ground and knocks it down on
-- arrival. This is the readable "combo is over" beat that stops juggles
-- from running forever.
----------------------------------------------------------------------
export type SlamSpec = {
	Velocity: number,
	Duration: number,
	Lockout: number?,
	KnockdownDuration: number?,
}

function Module.ApplySlam(victim: Model?, attacker: Model?, spec: SlamSpec, isPvP: boolean?): boolean
	if not victim then return false end
	local velocity = spec.Velocity or 38
	local duration = spec.Duration or 0.28
	if velocity <= 0 or duration <= 0 then return false end

	local humanoid, root = getLiveRoot(victim)
	if not root then return false end

	local motion = beginMotion(victim, Module.Kinds.Slam, nil)
	if not motion then return false end
	motion.RestoreOwnership = claimServerOwnership(root, duration)
	-- Same reason as the launch: without this the ground controller eats
	-- the downward mover the instant the victim nears the floor, and the
	-- slam reads as the victim simply falling.
	motion.RestoreController = suspendGroundController(humanoid)

	-- Lockout prevents an immediate re-launch off the bounce.
	local lockout = spec.Lockout or CombatConfigModule.CombatConfig.AIR_JUGGLE_SLAM_LOCKOUT or 2
	victim:SetAttribute('AirJuggleSlammedUntil', now() + lockout)

	pcall(function()
		local current = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(current.X, -velocity, current.Z)
	end)

	local attachment = makeAttachment(root, 'CombatSlamAttachment')
	makeVerticalVelocity(attachment, -velocity, 'CombatSlamVelocity')
	motion.Instances[#motion.Instances + 1] = attachment

	local CombatStateServer = SystemsContainer.CombatStateServer
	task.delay(duration, function()
		Module.ClearMotion(victim, motion.Token)
		if CombatStateServer then
			CombatStateServer.ClearAirborne(victim)
			CombatStateServer.ApplyKnockdown(victim, spec.KnockdownDuration, isPvP)
		end
	end)

	-- The attacker rides the slam down so the pair land together. No
	-- knockdown for them, and no ownership claim.
	if attacker then
		local attackerHumanoid, attackerRoot = getLiveRoot(attacker)
		if attackerRoot then
			local followMotion = beginMotion(attacker, Module.Kinds.Slam, nil)
			if followMotion then
				followMotion.RestoreController = suspendGroundController(attackerHumanoid)
				pcall(function()
					local current = attackerRoot.AssemblyLinearVelocity
					attackerRoot.AssemblyLinearVelocity = Vector3.new(current.X, -velocity, current.Z)
				end)
				local followAttachment = makeAttachment(attackerRoot, 'CombatSlamFollowAttachment')
				makeVerticalVelocity(followAttachment, -velocity, 'CombatSlamFollowVelocity')
				followMotion.Instances[#followMotion.Instances + 1] = followAttachment
				task.delay(duration, function()
					Module.ClearMotion(attacker, followMotion.Token)
					if CombatStateServer then
						CombatStateServer.ClearAirborne(attacker)
					end
				end)
			end
		end
	end
	return true
end

function Module.IsSlamLocked(model: Model?): boolean
	if not model then return false end
	local untilTime = model:GetAttribute('AirJuggleSlammedUntil')
	return typeof(untilTime) == 'number' and untilTime > now()
end

----------------------------------------------------------------------
-- Drag / gap-close.
--
-- Two modes, and the asymmetry is deliberate per NIER_COMBAT.md's PvP
-- rules: pulling the CASTER to a target is always allowed, while
-- pulling a TARGET to the caster is the one that can be abused to drag
-- players around, so it is capped hard and short.
----------------------------------------------------------------------
export type DragSpec = {
	Mode: string,          -- 'PullCaster' | 'PullTarget'
	Duration: number,
	MaxDistance: number,
	MaxSpeed: number,
	StopDistance: number?,
}

function Module.ApplyDrag(mover: Model?, anchor: Model?, spec: DragSpec, isPvP: boolean?): boolean
	if not mover or not anchor then return false end
	local duration = spec.Duration or 0.3
	if duration <= 0 then return false end

	local _moverHumanoid, moverRoot = getLiveRoot(mover)
	local _anchorHumanoid, anchorRoot = getLiveRoot(anchor)
	if not moverRoot or not anchorRoot then return false end

	local offset = flatten(anchorRoot.Position - moverRoot.Position)
	if offset.Magnitude > (spec.MaxDistance or 60) then return false end

	if isPvP then
		-- Short, telegraphed pulls only. A long forced carry of another
		-- player is out of scope until the arena rules land.
		duration = math.min(duration, 0.4)
	end

	local motion = beginMotion(mover, Module.Kinds.Drag, nil)
	if not motion then return false end
	motion.RestoreOwnership = claimServerOwnership(moverRoot, duration)

	local stopDistance = spec.StopDistance or 4
	local maxSpeed = spec.MaxSpeed or 90
	local attachment = makeAttachment(moverRoot, 'CombatDragAttachment')
	local planar = makePlanarVelocity(attachment, Vector3.zero)
	motion.Instances[#motion.Instances + 1] = attachment

	local function step()
		if Motions[mover] ~= motion then return end
		local _liveMoverHumanoid, liveMoverRoot = getLiveRoot(mover)
		local _liveAnchorHumanoid, liveAnchorRoot = getLiveRoot(anchor)
		if not liveMoverRoot or not liveAnchorRoot then
			Module.ClearMotion(mover, motion.Token)
			return
		end
		local delta = flatten(liveAnchorRoot.Position - liveMoverRoot.Position)
		if delta.Magnitude <= stopDistance then
			Module.ClearMotion(mover, motion.Token)
			return
		end
		local velocity = delta.Unit * math.min(delta.Magnitude / duration, maxSpeed)
		planar.PlaneVelocity = Vector2.new(velocity.X, velocity.Z)
	end

	motion.Connections[#motion.Connections + 1] = RunService.Heartbeat:Connect(step)
	task.delay(duration, function()
		Module.ClearMotion(mover, motion.Token)
	end)
	step()
	return true
end

----------------------------------------------------------------------
-- Dodge impulse. Shared by players and NPCs so both evade identically.
----------------------------------------------------------------------
function Module.ApplyDodge(model: Model?, direction: Vector3): boolean
	if not model then return false end
	local _humanoid, root = getLiveRoot(model)
	if not root then return false end

	local cfg = CombatConfigModule.CombatConfig
	local duration = cfg.DODGE_DURATION or 0.35
	local distance = cfg.DODGE_DISTANCE or 14
	if duration <= 0 or distance <= 0 then return false end

	-- Dodge sits below a launch on purpose: you can evade out of your own
	-- swing, but not out of being airborne.
	local motion = beginMotion(model, Module.Kinds.Dodge, nil)
	if not motion then return false end

	local heading = safeUnit(flatten(direction), flatten(root.CFrame.LookVector))
	local attachment = makeAttachment(root, 'CombatDodgeAttachment')
	makePlanarVelocity(attachment, heading * (distance / duration))
	motion.Instances[#motion.Instances + 1] = attachment

	task.delay(duration, function()
		Module.ClearMotion(model, motion.Token)
	end)
	return true
end

----------------------------------------------------------------------
-- Resolve the move's authored motion into an actual applied motion.
-- Called by the action runtime at the start of the swing.
--
-- Every ground attack lands here with nothing horizontal to do. The one
-- thing an attack does to its own caster's transform is turn them to
-- face the target; the swing itself is carried by the animation in the
-- move's AnimationSlot, which is why the slot list in
-- CombatConfig.AttackSets is the place to make hits read differently
-- rather than this file.
--
-- `Hover` is the exception and it is VERTICAL: an air move holds the
-- attacker up for the length of the swing so they do not drop out of
-- their own combo. That axis is now uncontested, which is the point —
-- a launcher or a slam only has to describe its lift.
----------------------------------------------------------------------
function Module.ApplyMoveMotion(caster: Model, target: Model?, move: any, actionId: string, duration: number)
	-- Face first, and unconditionally: a swing should point at what it is
	-- aimed at whether or not the move authored any motion at all.
	Module.FaceTarget(caster, target)

	local motionSpec = move.Motion
	if typeof(motionSpec) ~= 'table' then return end

	if motionSpec.Mode == CombatMovesets.MotionModes.Hover then
		Module.RefreshHover(caster, duration, false, actionId)
	end
end

function Module.Start()
	-- Drop any motion owned by a leaving player's character so a
	-- constraint cannot outlive the model it was driving.
	Players.PlayerRemoving:Connect(function(player)
		local character = player.Character
		if character then
			Module.ClearMotion(character)
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="ServerStorage/Modules"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="ServerStorage/Modules/Data"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="ServerStorage/Modules/Data/LootTables"><![CDATA[
local function ResolveRNGRange( Value, RNG )
	RNG = RNG or Random.new()
	return typeof(Value) == "table" and RNG:NextInteger(unpack(Value)) or Value
end

local function ArrayCopyTo( destination, ... )
	for _, source in {...} do
		for _, item in source do
			if not table.find(destination, item) then
				table.insert(destination, source)
			end
		end
	end
end

-- // Module // --
local Module = {}

Module.ItemLootTables = {
	CommonRedPotion = {
		{ ID = 'RedPotion', Quantity = { 1, 2 }, Weight = 3 },
		{ ID = 'RedPotion', Quantity = { 1, 3 }, Weight = 1 },
	},

	BundleRedPotion = {
		{ ID = 'RedPotion', Quantity = { 1, 3 }, Weight = 50 },
		{ ID = 'RedPotion', Quantity = { 2, 7 }, Weight = 25 },
		{ ID = 'RedPotion', Quantity = { 6, 12 }, Weight = 5 },
	},
}

Module.MobLootTables = {

	Boar_Floor1 = {
		Currency = { 1, 10 },
		Experience = { 3, 7 },

		Items = { }, -- set items with 100% chance
		WeightedItems = Module.ItemLootTables.CommonRedPotion, -- weighted item drop

		Attributes = false,  -- set attributes with 100% chance
		WeightedAttributes = false, -- weighted item drop

		Skills = false, -- set skills with 100% chance
		WeightedSkills = false, -- weighted item drop

		Quests = false,  -- set quests with 100% chance
		WeightedQuests = false, -- weighted item drop

		Callbacks = false, -- set function callbacks with 100% chance
		WeightedCallbacks = false, -- weighted callback functions

		-- Multi-drop rolls. Each entry is an independent roll that fires
		-- with its own Chance, then picks weighted from Pool. Lets a mob
		-- drop several items per kill instead of one.
		MultiDrops = {
			-- 25% chance at a Waystone Piece.
			{
				Chance = 0.25,
				Pool = {
					{ ItemId = 'WaystonePieceCommon', Weight = 80, Quantity = 1 },
					{ ItemId = 'WaystonePieceRare',   Weight = 20, Quantity = 1 },
				},
			},
			-- Boar butchery — feeds the cooking + tailoring chains.
			{
				Chance = 0.85,
				Pool = {
					{ ItemId = 'RawBoarMeat', Weight = 60, Quantity = { 1, 2 } },
					{ ItemId = 'BoarFur',     Weight = 25, Quantity = 1 },
					{ ItemId = 'BoarHide',    Weight = 15, Quantity = 1 },
				},
			},
		},
	},

}

----------------------------------------------------------------------
-- Boss tables. Bosses fire many independent rolls per kill so a single
-- defeat can yield gear + materials + a candy + (occasionally) an aura.
-- Aura drops use the prefix 'aura:<auraId>' so LootTableServer routes
-- them to AurasServer.AttemptUnlockAura instead of the inventory.
----------------------------------------------------------------------
Module.BossLootTables = {

	Boss_Floor1 = {
		Currency = { 50, 120 },
		Experience = { 80, 150 },

		MultiDrops = {
			-- Guaranteed drop: gear or a Waystone Piece pair.
			{
				GuaranteeOne = true,
				Pool = {
					{ ItemId = 'WoodenSword',  Weight = 70, Quantity = 1 },
					{ ItemId = 'WaystonePieceCommon', Weight = 30, Quantity = { 1, 2 } },
				},
			},
			-- 25% rare-tier roll.
			{
				Chance = 0.25,
				Pool = {
					{ ItemId = 'WaystonePieceRare', Weight = 80, Quantity = 1 },
					{ ItemId = 'companion_candy_minor', Weight = 20, Quantity = { 1, 2 } },
				},
			},
			-- 5% candy upgrade.
			{
				Chance = 0.05,
				Pool = {
					{ ItemId = 'companion_candy_major', Weight = 100, Quantity = 1 },
				},
			},
			-- 1% legendary roll: candies, auras, or rare waystone pieces.
			{
				Chance = 0.01,
				Pool = {
					{ ItemId = 'companion_candy_legendary', Weight = 50, Quantity = 1 },
					{ ItemId = 'WaystonePieceLegendary',     Weight = 30, Quantity = 1 },
					{ ItemId = 'aura:character_glow_amber',  Weight = 10, Quantity = 1 },
					{ ItemId = 'aura:sword_glow_void',        Weight = 5,  Quantity = 1 },
					{ ItemId = 'aura:mount_glow_storm',       Weight = 5,  Quantity = 1 },
				},
			},
		},
	},

}

-- sorting method for weights
for _, Data in Module.ItemLootTables do
	table.sort(Data, function(A, B)
		return A.Weight > B.Weight
	end)
end

function Module.ResolvePoolWeightedMatrix( PresetPool, TotalWeight )
	if not TotalWeight then
		TotalWeight = 0
		for _, itemData in PresetPool do
			TotalWeight += itemData.Weight
		end
	end

	local Rand = Random.new():NextInteger(1, TotalWeight)
	local Adder = 0
	for _, itemData in PresetPool do
		Adder += itemData.Weight
		if Adder >= Rand then
			return itemData
		end
	end
	return PresetPool[1]
end

-- Pure helper that resolves a single DropRoll into a list of awards.
-- Each award is { ItemId = string, Quantity = int }. Callers (LootTableServer)
-- iterate the awards and route by prefix: 'aura:*' goes to AurasServer,
-- everything else goes to PlayerInventoryServer.
--
-- `luckMul` (optional, default 1.0) scales the per-roll Chance check —
-- a player on a difficulty with LuckMul = 1.25 sees 25% better odds on
-- every probabilistic drop. Capped at 1.0 so a luck stack can't exceed
-- 100% drop rate (which would defeat the point of weighted pools).
-- GuaranteeOne rolls bypass the chance gate entirely so luck has no
-- effect on always-fires drops — also intentional, no infinite-stack
-- exploit through duplicate guaranteed rolls.
-- `rarityLookup` (optional) takes an itemId and returns its Rarity (number,
-- 1 = lowest). When provided alongside `rarityBias > 1`, each Pool entry's
-- effective weight is multiplied by `rarityBias ^ (rarity - 1)` — so a
-- bias of 1.25 doubles a Rarity-4 item's selection weight relative to
-- Rarity-1 in the same pool. Caller injects the lookup so this data
-- module stays decoupled from Items config.
function Module.ResolveDropRoll( DropRoll, RNG, luckMul, rarityBias, rarityLookup )
	RNG = RNG or Random.new()
	luckMul = (typeof(luckMul) == 'number' and luckMul > 0) and luckMul or 1
	rarityBias = (typeof(rarityBias) == 'number' and rarityBias > 0) and rarityBias or 1
	local awards = {}
	if not DropRoll or typeof(DropRoll.Pool) ~= 'table' or #DropRoll.Pool == 0 then
		return awards
	end
	local repeats = DropRoll.Repeat or 1
	for _ = 1, repeats do
		local fires = DropRoll.GuaranteeOne == true
		if not fires then
			local chance = math.min(1, (DropRoll.Chance or 1) * luckMul)
			fires = RNG:NextNumber() < chance
		end
		if fires then
			-- Pool is a list of { ItemId, Weight, Quantity }; pick one
			-- weighted, resolve quantity range. With rarityBias > 1 +
			-- a rarityLookup, each entry's weight is scaled before the
			-- pick — biases toward rarer items in the same pool.
			local effectiveWeights: {number} = {}
			local totalWeight = 0
			for i, entry in DropRoll.Pool do
				local w = entry.Weight or 1
				if rarityBias > 1 and rarityLookup then
					local rarity = rarityLookup(entry.ItemId) or 1
					if rarity > 1 then
						w = w * (rarityBias ^ (rarity - 1))
					end
				end
				effectiveWeights[i] = w
				totalWeight += w
			end
			local pick = RNG:NextNumber() * math.max(0.0001, totalWeight)
			local adder = 0
			local chosen = DropRoll.Pool[1]
			for i, entry in DropRoll.Pool do
				adder += effectiveWeights[i]
				if adder >= pick then chosen = entry; break end
			end
			local quantity = ResolveRNGRange(chosen.Quantity or 1, RNG)
			table.insert(awards, { ItemId = chosen.ItemId, Quantity = quantity })
		end
	end
	return awards
end

-- Walk a loot table's MultiDrops and return all award entries. Used by
-- LootTableServer to fan out per-roll awards into inventory + auras.
-- `luckMul` (optional) is forwarded into every per-drop chance roll.
function Module.ResolveMultiDrops( LootTable, luckMul, rarityBias, rarityLookup )
	local out = {}
	if typeof(LootTable.MultiDrops) ~= 'table' then return out end
	local RNG = Random.new()
	for _, dropRoll in LootTable.MultiDrops do
		for _, award in Module.ResolveDropRoll(dropRoll, RNG, luckMul, rarityBias, rarityLookup) do
			table.insert(out, award)
		end
	end
	return out
end

function Module.ResolveLootTableGeneric( LootTable )
	local RNG = Random.new()

	local LootRewards = {
		Currency = ResolveRNGRange( LootTable.Currency, RNG ),
		Experience = ResolveRNGRange( LootTable.Experience, RNG ),

		Items = { },
		Attributes = { },
		Skills = { },
		Quests = { },
		Dialogue = { },

		Callbacks = { },
	}

	if LootTable.Items then
		ArrayCopyTo( LootRewards.Items, LootTable.Items )
	end

	-- weighted items
	local ItemData = LootTable.WeightedItems and Module.ResolvePoolWeightedMatrix( LootTable.WeightedItems, false )
	if ItemData then
		local Amount = ItemData.Quantity
		Amount = Amount and ResolveRNGRange(Amount, RNG) or 1
		if not LootRewards.Items[ItemData.ID] then
			LootRewards.Items[ItemData.ID] = 0
		end
		LootRewards.Items[ItemData.ID] += Amount
	end

	if LootTable.Attributes then
		ArrayCopyTo( LootRewards.Attributes, LootTable.Attributes )
	end
	if LootTable.WeightedAttributes then
		-- TODO: implement
		warn('LootTable - WEIGHTED ATTRIBUTES loot not implemented')
	end

	if LootTable.Skills then
		ArrayCopyTo( LootRewards.Skills, LootTable.Skills )
	end
	if LootTable.WeightedSkills then
		-- TODO: implement
		warn('LootTable - WEIGHTED SKILLS loot not implemented')
	end

	if LootTable.Quests then
		ArrayCopyTo( LootRewards.Quests, LootTable.Quests )
	end
	if LootTable.WeightedQuests then
		-- TODO: implement
		warn('LootTable - WEIGHTED QUESTS loot not implemented')
	end

	if LootTable.Dialogue then
		ArrayCopyTo( LootRewards.Dialogue, LootTable.Dialogue )
	end
	if LootTable.WeightedDialogue then
		-- TODO: implement
		warn('LootTable - WEIGHTED DIALOGUE loot not implemented')
	end

	if LootTable.Callbacks then
		ArrayCopyTo( LootRewards.Dialogue, LootTable.Dialogue )
	end
	if LootTable.WeightedDialogue then
		-- TODO: implement
		warn('LootTable - WEIGHTED CALLBACK loot not implemented')
	end

	return LootRewards
end

return Module
]]></Source>
