	-- // Essences //
	-- Crafting / artisan inputs that aren't tied to a forge material
	-- catalog. Each is Type='Material' so the inventory tab buckets
	-- them with other crafting reagents; recipe / system code looks
	-- them up by item id directly (no separate Essence registry).
	-- Used by:
	--   * EnchantEssence + <Rarity>RarityEssence — EnchantServer.AttemptEnchant
	--     consumes 1 EnchantEssence + N rarity essences sized to the
	--     target weapon's rarity (see IMPLEMENTATION_PLAN §2).
	--   * GemEssence — GemSocketServer.AttemptUnsocket consumes 1 to
	--     refund a socketed gem (Smash path destroys the gem instead).
	EnchantEssence = FastDefineItem({
		Type = 'Material', Rarity = RaritiesConfig.RarityEnums.Uncommon, MaxQuantity = 999,
		Display = BasicColorDisplay(
			'Enchant Essence',
			'A residue of arcane scribecraft. Required to inscribe a scroll onto a weapon.',
			Color3.fromRGB(200, 140, 255)
		),
	}),
	CommonRarityEssence = FastDefineItem({
		Type = 'Material', Rarity = RaritiesConfig.RarityEnums.Common, MaxQuantity = 999,
		Display = BasicColorDisplay(
			'Common Rarity Essence',
			'Refined dust of common-tier gear. Enchant cost for common weapons.',
			Color3.fromRGB(154, 166, 184)
		),
	}),
	RareRarityEssence = FastDefineItem({
		Type = 'Material', Rarity = RaritiesConfig.RarityEnums.Rare, MaxQuantity = 999,
		Display = BasicColorDisplay(
			'Rare Rarity Essence',
			'Crystallized rare-tier residue. Enchant cost for rare weapons.',
