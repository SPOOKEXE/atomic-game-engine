local ServerModules = require(ServerStorage:WaitForChild('Modules'))
local ServerCore = require(ServerStorage:WaitForChild('Core'))

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ItemsConfig = ServerModules.Data.Items  -- migrated to per-player config replication; server reads canonical.

return function(_context, target: Player, itemId: string, quantity: number)
	if not ItemsConfig.Items[itemId] then
		return string.format("No item config registered for '%s'.", itemId)
	end
	quantity = math.max(1, math.floor(quantity or 1))
	local uuids = ServerCore.PlayerInventoryServer.GiveQuantityOfItemIdToPlayer(target, itemId, quantity)
	local count = (typeof(uuids) == 'table') and #uuids or quantity
	return string.format("Gave %s x%d to %s (%s).", itemId, count, target.Name, target.UserId)
end
]]></Source>
