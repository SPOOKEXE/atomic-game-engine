		<Source path="src/ServerScriptService/CmdrSetup/Commands/companions/SetCompanionModeServer.luau"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

return function(_context, target: Player, companionId: string, mode: string)
	if mode ~= 'float' and mode ~= 'walk' then
		return "mode must be 'float' or 'walk'."
	end
	local Companions = ServerCore.CompanionsServer
	if not Companions or not Companions.AttemptSetMovementMode then
		return 'CompanionsServer unavailable.'
	end
	local ok = Companions.AttemptSetMovementMode(target, companionId, mode)
	if not ok then
		return string.format('Refused — companion %q has AllowWalkAndFloatBypass=false (or unknown id).', companionId)
	end
	return string.format('%s.%s mode → %s', target.Name, companionId, mode)
end
]]></Source>
