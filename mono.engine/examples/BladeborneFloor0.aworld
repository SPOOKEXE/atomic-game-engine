		<Source path="src/ServerScriptService/CmdrSetup/Commands/artisan/ForgeGrantServer.luau"><![CDATA[local ServerStorage = game:GetService("ServerStorage")
local ServerCore = require(ServerStorage:WaitForChild('Core'))

return function(_context, target: Player, blueprintId: string)
	if not ServerCore.ForgeServer or not ServerCore.ForgeServer.AttemptUnlockBlueprint then
		return "ForgeServer not loaded."
	end
	local ok = ServerCore.ForgeServer.AttemptUnlockBlueprint(target, blueprintId)
	if not ok then
		return string.format("Failed to unlock blueprint '%s' for %s.", blueprintId, target.Name)
	end
	return string.format("Unlocked blueprint '%s' for %s.", blueprintId, target.Name)
end
