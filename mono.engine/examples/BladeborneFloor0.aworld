		<Source path="src/ReplicatedStorage/Cmdr/BuiltInCommands/Debug/uptimeServer.luau"><![CDATA[local startTime = os.time()

return function()
	local uptime = os.time() - startTime
	return ("%dd %dh %dm %ds"):format(
		math.floor(uptime / (60 * 60 * 24)),
		math.floor(uptime / (60 * 60)) % 24,
		math.floor(uptime / 60) % 60,
		math.floor(uptime) % 60
	)
end
]]></Source>
