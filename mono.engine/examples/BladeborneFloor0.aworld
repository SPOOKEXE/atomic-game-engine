	Group = 'Admin',
	Args = {
		{ Type = 'player', Name = 'target',  Description = 'Target player.' },
		{ Type = 'string', Name = 'skillId', Description = "Skill id (e.g. great_slash, flash_strike)." },
	},
}
]]></Source>
		<Source path="src/ServerScriptService/CmdrSetup/Commands/skills/UnlockSkillNodeServer.luau"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local SkillsConfig = require(ReplicatedStorage:WaitForChild('Modules')).Data.Skills

-- Admin write helper. Bypasses every gate in SkillsServer.AttemptUnlockSkill
-- and stamps the canonical {UnlockedAt, Level} entry directly. Returns the
-- final Level so the command output shows whether a passive maxed out.
local function unlockOne(data: any, skillId: string): number
	if typeof(data.Skills) ~= 'table' then data.Skills = {} end
	if typeof(data.Skills.UnlockedSkills) ~= 'table' then data.Skills.UnlockedSkills = {} end
	local cfg = SkillsConfig.Skills[skillId]
	local level = 1
	if cfg and cfg.Passive and cfg.MaxLevel then
		level = cfg.MaxLevel
	end
	data.Skills.UnlockedSkills[skillId] = { UnlockedAt = os.time(), Level = level }
	return level
end

return function(_context, target: Player, skillId: string)
	local cfg = SkillsConfig.Skills[skillId]
	if not cfg then
		return string.format("No skill config registered for '%s'.", skillId)
	end
	local data = ServerCore.SavesManagerServer.GetPlayerSelectedSaveData(target)
	if not data then
		return string.format('No save data loaded for %s.', target.Name)
	end
	local level = unlockOne(data, skillId)
	return string.format("Unlocked '%s' for %s (Lv %d).", skillId, target.Name, level)
end
]]></Source>
		<Source path="src/ServerScriptService/CmdrSetup/Commands/skills/UnlockSkillTree.luau"><![CDATA[--!strict
return {
	Name = 'UnlockSkillTree',
	Aliases = { 'unlocktree', 'unlockschool' },
	Description = "Unlock every skill in a given tree tab on a player. Passives go to MaxLevel. Pass 'all' to unlock every tree.",
	Group = 'Admin',
	Args = {
		{ Type = 'player', Name = 'target',      Description = 'Target player.' },
		{ Type = 'string', Name = 'tabCategory', Description = "TabCategory id (e.g. 'dual', 'passives', or 'all')." },
	},
}
]]></Source>
		<Source path="src/ServerScriptService/CmdrSetup/Commands/skills/UnlockSkillTreeServer.luau"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local SkillsConfig = require(ReplicatedStorage:WaitForChild('Modules')).Data.Skills

-- Mirror of UnlockSkillNodeServer's helper. Inlined rather than shared so
-- each command file stays self-contained — Cmdr command modules don't have
-- a stable place to drop a shared utility module without leaking into the
-- Commands tree as a third "command".
local function unlockOne(data: any, skillId: string)
	local cfg = SkillsConfig.Skills[skillId]
	local level = 1
	if cfg and cfg.Passive and cfg.MaxLevel then
		level = cfg.MaxLevel
	end
	data.Skills.UnlockedSkills[skillId] = { UnlockedAt = os.time(), Level = level }
end

return function(_context, target: Player, tabCategory: string)
	local data = ServerCore.SavesManagerServer.GetPlayerSelectedSaveData(target)
	if not data then
		return string.format('No save data loaded for %s.', target.Name)
	end
	if typeof(data.Skills) ~= 'table' then data.Skills = {} end
	if typeof(data.Skills.UnlockedSkills) ~= 'table' then data.Skills.UnlockedSkills = {} end

	local lower = string.lower(tostring(tabCategory or ''))
	local count = 0

	if lower == 'all' then
		-- Walk Module.Skills directly so skills with no TabCategory (which
		-- Module.Trees omits) are still covered by the "all" form.
		for skillId in SkillsConfig.Skills do
			unlockOne(data, skillId)
			count += 1
		end
		return string.format('Unlocked %d skills (every tree) for %s.', count, target.Name)
	end

	local tree = SkillsConfig.Trees[lower]
	if not tree then
		-- Build a friendly list of valid tabs so the admin can iterate quickly.
		local known = {}
		for cat in SkillsConfig.Trees do table.insert(known, cat) end
		table.sort(known)
		return string.format("No tree '%s'. Known: %s (or 'all').",
			tostring(tabCategory), table.concat(known, ', '))
	end
	for skillId in tree.Nodes do
		unlockOne(data, skillId)
		count += 1
	end
	return string.format("Unlocked %d skills in tree '%s' for %s.", count, lower, target.Name)
end
]]></Source>
		<Source path="src/ServerScriptService/CmdrSetup/Commands/skills/UnlockSkillsUpTo.luau"><![CDATA[--!strict
return {
	Name = 'UnlockSkillsUpTo',
	Aliases = { 'unlockupto', 'unlockchain' },
	Description = "Unlock the target skill AND every skill on its Prereqs chain (transitive). Passives along the chain go to MaxLevel. Skips SkillPoint cost + level gates.",
	Group = 'Admin',
	Args = {
		{ Type = 'player', Name = 'target',  Description = 'Target player.' },
		{ Type = 'string', Name = 'skillId', Description = "Skill id at the END of the chain (e.g. lightning_strike unlocks quick_slash → flash_slash → flash_strike → lightning_strike)." },
	},
}
]]></Source>
		<Source path="src/ServerScriptService/CmdrSetup/Commands/skills/UnlockSkillsUpToServer.luau"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local SkillsConfig = require(ReplicatedStorage:WaitForChild('Modules')).Data.Skills

-- Walk Prereqs (NOT Depends) transitively. Prereqs is the unlock auth
-- chain; Depends is the display graph and can carry visual-only edges
-- that aren't enforced at unlock time. We want every skill the gameplay
-- gate requires, not every node the UI draws an edge to.
local function collectChain(rootId: string): { string }
	local visited: { [string]: boolean } = {}
	local order: { string } = {}
	local function dfs(id: string)
		if visited[id] then return end
		visited[id] = true
		local cfg = SkillsConfig.Skills[id]
		if not cfg then return end
		for _, prereqId in cfg.Prereqs do
			dfs(prereqId)
		end
		-- Post-order so prereqs land in the unlock list before their dependents.
		-- Not strictly required for the save mutation (we stamp the same
		-- table either way), but keeps the printed list readable.
		table.insert(order, id)
	end
	dfs(rootId)
	return order
end

return function(_context, target: Player, skillId: string)
	if not SkillsConfig.Skills[skillId] then
		return string.format("No skill config registered for '%s'.", skillId)
	end
	local data = ServerCore.SavesManagerServer.GetPlayerSelectedSaveData(target)
	if not data then
		return string.format('No save data loaded for %s.', target.Name)
	end
	if typeof(data.Skills) ~= 'table' then data.Skills = {} end
	if typeof(data.Skills.UnlockedSkills) ~= 'table' then data.Skills.UnlockedSkills = {} end

	local chain = collectChain(skillId)
	for _, id in chain do
		local cfg = SkillsConfig.Skills[id]
		local level = 1
		if cfg and cfg.Passive and cfg.MaxLevel then
			level = cfg.MaxLevel
		end
		data.Skills.UnlockedSkills[id] = { UnlockedAt = os.time(), Level = level }
	end
	return string.format("Unlocked %d skills up to '%s' for %s (%s).",
		#chain, skillId, target.Name, table.concat(chain, ' -> '))
end
]]></Source>
