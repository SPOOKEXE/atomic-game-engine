	-- // Pickaxe tools // — pickaxes use the existing EquipmentData.ToolUsage
	-- contract; their WeaponClass is set to 'Pickaxe' so combat code skips
	-- combo / animation lookups for them. Damage values matter for the
	-- harvest-tier check (a Wooden pickaxe can't break Iron nodes, etc.) —
	-- the ToolServer's tool-vs-node power gate reads the Damage range max.
	WoodenPickaxe = FastDefineItem({
		Rarity = RaritiesConfig.RarityEnums.Common, MaxQuantity = 1,
		EquipmentData = {
			EquipSlots = {Module.StandardEquipSlots.Hands},
			WeaponClass = 'Pickaxe',
			StandardOffset = CFrame.identity,
			BackOffsets = DEFAULT_BACK_OFFSETS,
			HandOffsets = Module.StandardHandOffsets.Sword, -- placeholder; pickaxe-specific offsets land with art
			WeaponUsage = nil,
			ToolUsage = {
				Operation = 1,
				Damage = { Percent = nil, Value = { Min = 1, Max = 2 } },
				Inflicts = {},
			},
			Model = 'WoodenPickaxe', -- AssetsShared.<Model> not yet present; DefinitionWarnings logs it
		},
		Display = BasicColorDisplay('Wooden Pickaxe', 'A crude pickaxe. Breaks soft nodes (wood, stone).', Color3.fromRGB(160, 110, 70)),
	}),
	IronPickaxe = FastDefineItem({
		Rarity = RaritiesConfig.RarityEnums.Uncommon, MaxQuantity = 1,
		EquipmentData = {
			EquipSlots = {Module.StandardEquipSlots.Hands},
			WeaponClass = 'Pickaxe',
			StandardOffset = CFrame.identity,
			BackOffsets = DEFAULT_BACK_OFFSETS,
			HandOffsets = Module.StandardHandOffsets.Sword,
			WeaponUsage = nil,
			ToolUsage = {
				Operation = 1,
				Damage = { Percent = nil, Value = { Min = 3, Max = 4 } },
				Inflicts = {},
			},
			Model = 'IronPickaxe',
		},
		Display = BasicColorDisplay('Iron Pickaxe', 'A solid pickaxe. Handles iron-tier nodes and lower.', Color3.fromRGB(176, 180, 188)),
	}),

