		<Source path="src/ServerScriptService/CmdrSetup/Commands/skills/ResetSkillTreesServer.luau"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

return function(_context, target: Player)
	local data = ServerCore.SavesManagerServer.GetPlayerSelectedSaveData(target)
	if not data then
		return string.format('No save data loaded for %s.', target.Name)
	end
	if typeof(data.Skills) ~= 'table' then data.Skills = {} end
	data.Skills.UnlockedSkills = {}
	-- great_slash is auto-granted on CharacterAdded in SkillsServer, so it
	-- comes back on the next respawn. The intent here is to wipe everything;
	-- leaving the auto-grant in place would obscure that.
	return string.format('Cleared all unlocked skills for %s.', target.Name)
end
