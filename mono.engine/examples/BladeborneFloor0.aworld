return {
	Name = 'GiveArtisanXP',
	Aliases = { 'give_artisan_xp', 'giveartisanxp', 'asxp' },
	Description = 'Grant artisan XP to one of the crafting schools.',
	Group = 'Admin',
	Args = {
		{ Type = 'player',  Name = 'target',  Description = 'Target player.' },
		{ Type = 'string',  Name = 'school',  Description = 'School id (Smithing/Tailoring/Alchemy/Cooking/Enchanting/Gemcutting).' },
