		<Source path="src/ServerScriptService/CmdrSetup/Commands/debug/RunSkillRecipeServer.luau"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

return function(context, recipeId: string)
	local Runtime = ServerCore.SkillRuntimeServer
	if not Runtime or not Runtime.RunRecipe then
		return 'SkillRuntimeServer unavailable.'
	end
	local executor = context.Executor
	local character = executor and executor.Character
	if not character then return 'Executor has no character.' end

	local caster = Runtime.CasterFromModel(character, executor)
	if not caster then return 'Could not build caster context.' end

	-- Run in its own task so the cmdr response returns immediately;
	-- the recipe yields on its windups internally and we don't want
	-- to block the cmdr's message channel.
	task.spawn(function()
		local ok = Runtime.RunRecipe(caster, recipeId)
		if not ok then
			warn(string.format("[RunSkillRecipe] recipe %q failed or unknown", recipeId))
		end
	end)
	return string.format("Running recipe '%s'.", recipeId)
end
]]></Source>
