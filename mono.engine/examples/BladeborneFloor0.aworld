		<Source path="src/ServerScriptService/CmdrSetup/Commands/cinematic/DialogueServer.luau"><![CDATA[local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local DialogueData = ReplicatedModules.Data.Dialogue

local ServerStorage = game:GetService('ServerStorage')
local ServerCore    = require(ServerStorage:WaitForChild('Core'))

return function(context, dialogueId)
	if not DialogueData.GetDialogueFromId(dialogueId) then
		local ids: { string } = {}
		for id in DialogueData.Dialogue do ids[#ids + 1] = id end
		table.sort(ids)
		return string.format('Unknown dialogue id %q. Available: %s',
			tostring(dialogueId), table.concat(ids, ', '))
	end
	local DialogueNPCServer = ServerCore.DialogueNPCServer
	if not DialogueNPCServer or not DialogueNPCServer.OpenDialogueForPlayer then
		return 'DialogueNPCServer module unavailable.'
	end
	DialogueNPCServer.OpenDialogueForPlayer(context.Executor, dialogueId)
	return string.format('Opened dialogue %q on %s.', dialogueId, context.Executor.Name)
end
]]></Source>
		<Source path="src/ServerScriptService/CmdrSetup/Commands/cinematic/Shake.luau"><![CDATA[--!strict
-- /shake <preset> — fire a single named shake preset on the caller's
-- camera. Routes through CinematicServer.FireCueForPlayer so the same
-- cue path the cinematic walker uses gets exercised.
return {
	Name = 'Shake',
	Aliases = { 'shake', 'cinshake' },
	Description = 'Fire a named camera-shake preset on yourself (see Data/CinematicPresets.luau).',
	Group = 'Admin',
	Args = {
		{
			Type = 'string',
			Name = 'presetName',
			Description = "Preset name: subtle / soft / medium / heavy / hit / finisher / explosion / earthquake.",
		},
	},
}
]]></Source>
		<Source path="src/ServerScriptService/CmdrSetup/Commands/cinematic/ShakeServer.luau"><![CDATA[local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local CinematicShared  = ReplicatedModules.Services.CinematicShared
local CinematicPresets = ReplicatedModules.Data.CinematicPresets

local ServerStorage = game:GetService('ServerStorage')
local ServerCore    = require(ServerStorage:WaitForChild('Core'))

return function(context, presetName)
	local p = CinematicPresets.Shakes[presetName]
	if not p then
		return string.format('Unknown shake preset %q. Try: %s', tostring(presetName),
			table.concat(CinematicPresets.ListShakes(), ', '))
	end
	local CinematicServer = ServerCore.CinematicServer
	if not CinematicServer or not CinematicServer.FireCueForPlayer then
		return 'CinematicServer module unavailable.'
	end
	CinematicServer.FireCueForPlayer(context.Executor, CinematicShared.CueKind.CameraShake, {
		Magnitude = p.Magnitude, Roughness = p.Roughness, Duration = p.Duration,
		FadeIn = p.FadeIn, FadeOut = p.FadeOut,
	})
	return string.format('Fired shake %q.', presetName)
end
]]></Source>
