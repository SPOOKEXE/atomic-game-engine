		<Source path="src/ReplicatedStorage/Modules/Data/Items.luau"><![CDATA[-- // Items — CLIENT-SIDE SHELL //
--
-- Authored data lives at ServerStorage/Modules/Data/Items.luau. This
-- file's `Module.Items` table starts EMPTY and is populated at runtime
-- by ConfigReplicationClient as the server pushes rows for items the
-- player owns (or, for whitelisted admins, the full registry on join).
-- Inventory widgets, hotbar, equipment renderer, etc. continue to call
-- `Module.Items[id]` and `Module.GetConfigFromId(id)` verbatim — the
-- shell returns nil for unowned items, which existing call sites
-- already handle (those paths predate the migration; they treat
-- "unknown id" as "skip / hide").
--
-- The TYPES and CONSTANT TABLES (EquipmentSlotEnums, ItemCategory,
-- ItemTags, ItemSourceLabels, StandardEquipSlots, etc.) intentionally
-- LIVE here, populated. They aren't spoiler content — they describe
-- shapes / enumerate slots — and many widgets read them directly to
-- render UI. Helpers (HasTag, GetEffectiveRarity, GetItemCategories,
-- etc.) operate on a passed-in cfg arg so they work regardless of
-- which side owns the data.
--
-- See ROADMAP.md §"Empty client shell" for the full pattern.

local StatusEffectsConfig = require(script.Parent:WaitForChild('StatusEffects'))
export type EffectDisplay = StatusEffectsConfig.EffectDisplay
export type Effect = StatusEffectsConfig.Effect

local RaritiesConfig = require(script.Parent:WaitForChild('Rarities'))
export type RarityNames = RaritiesConfig.RarityNames

local CompositionalConfig = require(script.Parent:WaitForChild('Compositional'))
export type ForgeCompositionConfig = CompositionalConfig.ForgeCompositionConfig
export type EnchantCompositionConfig = CompositionalConfig.EnchantCompositionConfig
export type SocketingCompositionConfig = CompositionalConfig.SocketingCompositionConfig
export type ItemCompositionConfig = CompositionalConfig.ItemCompositionConfig

export type EquipmentSlotsLabels =
	"Hand" |
	"Head" |
	"Chest" |
	"Legs" |
	"Boots" |
	"Bracelet" |
	"Neck" |
	"LeftEar" |
	"RightEar" |
	"Finger" |
	"Curio"

export type NumberRangeValues = {Min: number, Max: number}

export type DamageValues = {
	Percent: NumberRangeValues,
	Value: NumberRangeValues,
}

export type InflictEffects = {
	Effects: {Effect},
	Chance: NumberRangeValues,
}

export type EquipmentSlotConfig = {
	Slot: number,
	IndexMax: number, -- max extra index for hands/fingers/ears
	AllowMultiEquip: boolean, -- allow multi-equip in other slots
	MaxMultiEquip: number,
}

export type EquipmentUsageConfig = {
	Operation: number,
	Damage: DamageValues,
	Inflicts: {InflictEffects},
}

-- Per-hand-index offsets. Keyed by the equip sub-index that
-- `EquipmentSlotConfig.IndexMax` establishes — `[1]` is the only
-- meaningful slot for single-instance equipment (Head, Chest, …),
-- while dual-wield items carry `[1]` (left) and `[2]` (right). The
-- artist authors each side directly so the renderer doesn't have to
-- guess at a mirror.
export type HandIndexedOffsets = {[number]: CFrame}

-- Per-socket spec for socketable equipment. `Color` is one of the
-- ColorClass values from Gems.luau ('red' / 'blue' / 'green' / 'gold' /
-- 'purple' / 'white' / 'black') OR 'any' for color-agnostic sockets.
-- The socket order in this list = socket index in
-- Composition.Socketing.Slots (1-based).
export type ItemSocketSpec = {
	Color: string,
}

export type ItemEquipmentConfig = {
	EquipSlots: {EquipmentSlotConfig},
	--
	StandardOffset: CFrame,
	BackOffsets: HandIndexedOffsets,
	HandOffsets: HandIndexedOffsets,
	--
	WeaponUsage: EquipmentUsageConfig?,
	ToolUsage: EquipmentUsageConfig?,
	--
	Model: string,
	-- Optional socket list — items with Sockets set are gem-socketable.
	-- See GemSocketShared.GetSocketColors for the runtime read path.
	Sockets: {ItemSocketSpec}?,
}

export type ItemConsumeActivateConfigBase = {
	Effects: {Effect},
	Inflicts: {InflictEffects},
	Consumes: boolean,
	ConsumeQuantity: number,
	MinimumQuantity: number,
	Cooldown: number,
}

export type ItemConsumptionConfig = ItemConsumeActivateConfigBase & {
}

export type ItemActivationConfig = ItemConsumeActivateConfigBase & {
}

export type ItemDisplayConfig = {
	Title: {Text: string, TextColor3: Color3?},
	Description: {Text: string, TextColor3: Color3?},
	Icon: {Image: string, ImageColor3: Color3?}?,
	Viewport: {ImageColor3: Color3?, CFrame: CFrame?}?,
}

-- Companion candy items carry this block instead of (or alongside)
-- regular consumption data. `XPAmount` is added to the equipped
-- companion's XP when the candy is used.
export type CompanionCandyData = {
	XPAmount: number,
}

-- Attribute-XP scroll payload. ConsumptionServer reads this when an
-- item with Type='AttributeScroll' is consumed: AttributeId picks the
-- target stat (Strength / Agility / etc., must match a key in
-- Data/Attributes.luau), Amount is the XP grant.
-- Single-target shape — kept for legacy single-attribute scrolls.
export type AttributeXPData = {
	AttributeId: string,
	Amount: number,
}

-- Experience-scroll payload — multi-target variant. Use when a scroll
-- grants XP to MULTIPLE attributes at once ("Greater Insight Scroll:
-- +20 Insight, +10 Focus"). ConsumptionServer iterates `Grants` and
-- routes each entry through AttributeServer.IncrementAttributeExperience.
-- Grants is intentionally an array (not a dict) so the same attribute
-- could be listed twice with different amounts if a designer wants
-- compounding effects — the consumer applies each entry verbatim.
-- Item config also supports the legacy single-target `AttributeXPData`;
-- consumers prefer `ExperienceScrollData` when both are present.
export type ExperienceScrollGrant = {
	AttributeId: string,
	Amount: number,
}
export type ExperienceScrollData = {
	Grants: { ExperienceScrollGrant },
}

-- // Artisan input metadata — see ARTISAN.md §5 //
-- These three fields point an inventory item into the matching artisan
-- catalog (Materials / Gems / Enchants). Multiple ItemConfigs CAN share
-- the same target id (e.g. CrudeIronBar + RefinedIronBar both →
-- ForgeMaterialId='iron') with different per-item metadata to express
-- yield/quality variants. Authors may use the shorthand string field
-- (`ForgeMaterialId = 'iron'`) for the simple case OR the longhand
-- table (`ForgeMaterial = { Id = 'iron', UnitsPerStack = 5 }`) when they
-- need extra metadata. `GetForgeMaterial` / `GetGem` / `GetEnchantInput`
-- below normalize both forms into the longhand shape so callers never
-- branch on which field was used.

export type ForgeMaterialMetadata = {
	Id: string,                     -- → Materials.Materials[id]
	UnitsPerStack: number?,         -- default 1; smelted bars could be 5
}

export type GemMetadata = {
	Id: string,                     -- → Gems.Gems[id] (cut baked into id)
}

export type EnchantInputMetadata = {
	Id: string,                     -- → Enchants.Enchants[id]
	Level: number?,                 -- nil = "any level up to MaxLevel"
	Charges: number?,               -- default 1; rare scrolls could grant multiple applies
}

export type BaseItemConfig = {
	-- Optional category tag for items that fall outside the standard
	-- equipment/consumable/etc. composition. Currently used for
	-- 'CompanionCandy'; may be extended for other category-specific
	-- items (key items, recipe pages, etc.).
	Type: string?,

	-- Optional semantic tag list. Each entry is a value from
	-- `Module.ItemTags`. Tags drive UI eligibility (hotbar accepts
	-- only Skill/Food/Potion; the inventory tab filters by Weapon/
	-- Equipment/Accessory) WITHOUT changing the underlying data shape.
	-- Items can carry multiple tags — a battle-buff scroll could be
	-- {AttributeScroll, Potion}.
	Tags: { number }?,

	-- Optional source list — author-declared "where can the player
	-- get this from?". Each entry is a `Module.ItemSources` value.
	-- Surfaced as text in the inventory detail's "CAN BE OBTAINED
	-- FROM" row. Multi-source items list every origin.
	Sources: { number }?,

	Rarity: number,
	MaxQuantity: number,

	EquipmentData: ItemEquipmentConfig?, -- can be 'equipped'
	ConsumptionData: ItemConsumptionConfig?, -- can be 'consumed'
	ActivationData: ItemActivationConfig?, -- can be 'activated'
	Composition: ItemCompositionConfig?, -- extra metadata

	-- Companion candy payload. Read by CompanionsServer.UseCompanionCandy.
	CandyData: CompanionCandyData?,

	-- Attribute-XP scroll payload. Read by ConsumptionServer when
	-- Type='AttributeScroll' (one scroll → +Amount XP toward the
	-- specified attribute). Independent of CompanionCandy so an item
	-- could conceivably carry both, though no current scroll does.
	AttributeXPData: AttributeXPData?,

	-- Experience-scroll metadata. Set this on items tagged with
	-- ItemTags.ExperienceScroll so ConsumptionServer can grant XP to
	-- every listed attribute in one consume. Multi-target — a single
	-- legendary scroll can roll +50 Strength, +50 Vitality at once.
	ExperienceScrollData: ExperienceScrollData?,

	-- // Artisan input pointers. Set EITHER the *Id shorthand OR the
	-- corresponding longhand table; never both. //
	ForgeMaterialId: string?,
	ForgeMaterial: ForgeMaterialMetadata?,
	GemId: string?,
	Gem: GemMetadata?,
	EnchantInputData: EnchantInputMetadata?,

	Display: ItemDisplayConfig,
}

-- Per-hand back offsets for sheathed weapons. The two CFrames are
-- mirrored across the body's X axis (yaw sign flipped) so two
-- sheathed swords sit symmetrically on either side of the spine.
-- Tune each entry independently if a specific weapon needs an
-- asymmetric mount (e.g. a quiver vs. a sword sharing a back).
local DEFAULT_BACK_OFFSETS = {
	[1] = CFrame.new(0, 0, 0.5) * CFrame.Angles(math.rad(-90), math.rad(-45), 0) * CFrame.new(0, 0, 2),
	[2] = CFrame.new(0, 0, 0.5) * CFrame.Angles(math.rad(-90), math.rad( 45), 0) * CFrame.new(0, 0, 2),
}

local WHITE_COLOR = Color3.new(1,1,1)

local function SetProperties<T>(parent: T, properties: {[string]: any}?): T
	if properties then
		for k, v in properties do
			parent[k] = v
		end
	end
	return parent
end

local function BasicColorDisplay(name: string, description: string, color: Color3?): ItemDisplayConfig
	return {
		Title = {Text = name, TextColor3 = color},
		Description = {Text = description, TextColor3 = color},
		Icon = nil,
		Viewport = nil,
	}
end

local function BasicIconDisplay(name: string, description: string, color: Color3, image: string, imageColor: Color3?): ItemDisplayConfig
	return {
		Title = {Text = name, TextColor3 = color},
		Description = {Text = description, TextColor3 = color},
		Icon = {Image = image, ImageColor3 = imageColor},
		Viewport = nil,
	}
end

local function BasicViewportDisplay(name: string, description: string, color: Color3, viewportCFrame: CFrame?, viewportColor: Color3?): ItemDisplayConfig
	return {
		Title = {Text = name, TextColor3 = color},
		Description = {Text = description, TextColor3 = color},
		Icon = nil,
		Viewport = {ImageColor3 = viewportColor, CFrame = viewportCFrame},
	}
end

local function StandardViewportDisplay(name: string, description: string)
	return BasicViewportDisplay(name, description, WHITE_COLOR, CFrame.identity, WHITE_COLOR)
end

local function FastDefineItem(properties: BaseItemConfig?): BaseItemConfig
	return SetProperties({
		Rarity = RaritiesConfig.RarityEnums.Common,
		MaxQuantity = 1,

		EquipmentData = nil,
		ConsumptionData = nil,
		ActivationData = nil,
		Composition = nil,

		Display = BasicColorDisplay('null', 'null', WHITE_COLOR),
	}, properties)
end

local Module = {}

Module.EquipmentSlotEnums = {
	Hand = 1,
	Head = 2,
	Chest = 3,
	Legs = 4,
	Boots = 5,
	--
	Bracelet = 10,
	Neck = 11,
	Ear = 12,
	Finger = 13,
	--
	Curio = 99,
}

-- General-purpose item categories. An item can belong to multiple buckets
-- simultaneously (a pickaxe is both Weapon + Tool; a charm could be both
-- Activatable + Consumable), so `GetItemCategories` returns an array.
-- These are derived from the cfg's composition tables — there's no stored
-- `Categories` field on items, so the enum and the cfg shape can never drift.
Module.ItemCategory = {
	Weapon        = 1, -- EquipmentData.WeaponUsage present
	Tool          = 2, -- EquipmentData.ToolUsage present
	Equipment     = 3, -- EquipmentData with armor slot (Head/Chest/Legs/Boots)
	Accessory     = 4, -- EquipmentData with jewelry slot (Bracelet/Neck/Ear/Finger/Curio)
	Consumable    = 5, -- ConsumptionData present
	Activatable   = 6, -- ActivationData present
	Material      = 7, -- forge / craft input (ForgeMaterialId set), or generic fallback
	Gem           = 8, -- gem socket input (GemId set)
	EnchantScroll = 9, -- enchant input (EnchantInputData set)
}

----------------------------------------------------------------------
-- Item tags. Author-supplied semantic labels per item, separate from
-- the data-shape-derived `ItemCategory`. Where ItemCategory answers
-- "what data does this item carry?", Tags answer "what is this item
-- *for*?". A consumable with `ConsumptionData` could be Food OR Potion;
-- the data shape is identical, the *intent* differs — and UI surfaces
-- like the hotbar (only skills/food/potions allowed) need the intent
-- to filter correctly.
--
-- Multi-tag is supported: a torch could be {Tool, Equipment}; a
-- battle-buff scroll could be {Potion, AttributeScroll}. Authors set
-- `Tags = { Module.ItemTags.X, ... }` on item entries; HasTag helps
-- consumers query.
--
-- IDs are grouped by domain (combat 1-9, consumable 10-19, crafting
-- 20-29, special 30-39) so adding a new tag in one domain doesn't
-- shift ids in another. Save files that store tag ids stay valid.
----------------------------------------------------------------------
----------------------------------------------------------------------
-- Item sources. Author-tagged origin labels — answers "where can I
-- get this?". Surfaced in the inventory detail's "CAN BE OBTAINED
-- FROM" row so the player knows whether to grind a mob, head to the
-- shop, or craft. An item can list multiple sources (a sword that
-- drops AND can be crafted carries both).
----------------------------------------------------------------------
Module.ItemSources = {
	Crafted    = 1,   -- crafting recipe output
	Drop       = 2,   -- mob drop
	Shop       = 3,   -- bought from a vendor
	Quest      = 4,   -- quest reward
	Treasure   = 5,   -- chest / world discovery
	Forge      = 6,   -- forge output (different from generic Crafted)
	Starter    = 7,   -- given on first join / new save
	Event      = 8,   -- limited-time event reward
	Boss       = 9,   -- boss-specific drop (separate from generic Drop)
}

-- Display labels for the source enum. Used by the inventory detail
-- "CAN BE OBTAINED FROM" row + any future filter chip surfaces.
Module.ItemSourceLabels = {
	[Module.ItemSources.Crafted]  = 'Crafted',
	[Module.ItemSources.Drop]     = 'Monster Drop',
	[Module.ItemSources.Shop]     = 'Shop',
	[Module.ItemSources.Quest]    = 'Quest Reward',
	[Module.ItemSources.Treasure] = 'Treasure',
	[Module.ItemSources.Forge]    = 'Forge',
	[Module.ItemSources.Starter]  = 'Starter Pack',
	[Module.ItemSources.Event]    = 'Event Reward',
	[Module.ItemSources.Boss]     = 'Boss Drop',
}

Module.ItemTags = {
	-- // Combat / equippable.
	Weapon          = 1,
	Tool            = 2,
	Equipment       = 3,  -- armor body slots
	Accessory       = 4,  -- jewelry / curio
	-- // Consumable.
	Food             = 10,
	Potion           = 11,
	AttributeScroll  = 12,
	Candy            = 13,
	-- Multi-target experience scroll (uses ExperienceScrollData on the
	-- cfg). AttributeScroll above remains for the legacy single-target
	-- shape (AttributeXPData). Two tags so a UI surface can filter
	-- between "single-stat scroll" and "multi-stat scroll" if desired.
	ExperienceScroll = 14,
	-- // Crafting.
	Material        = 20,
	Gem             = 21,
	EnchantScroll   = 22,
	-- // Special.
	Quest           = 30,  -- can't be sold / dropped
	Cosmetic        = 31,  -- visual-only
}

-- True when the item's `Tags` array contains the given tag id. Returns
-- false on missing/invalid configs and on configs that omit the Tags
-- field (no tags = no tag matches).
function Module.HasTag(itemConfig: any, tagId: number): boolean
	if typeof(itemConfig) ~= 'table' then return false end
	local tags = itemConfig.Tags
	if typeof(tags) ~= 'table' then return false end
	for _, t in tags do
		if t == tagId then return true end
	end
	return false
end

-- Slot enums that classify as "jewelry" rather than armor. Lookup table
-- so `GetItemCategories` doesn't repeat a chain of `or`s for each call.
local ACCESSORY_SLOT_LOOKUP = {
	[Module.EquipmentSlotEnums.Bracelet] = true,
	[Module.EquipmentSlotEnums.Neck]     = true,
	[Module.EquipmentSlotEnums.Ear]      = true,
	[Module.EquipmentSlotEnums.Finger]   = true,
	[Module.EquipmentSlotEnums.Curio]    = true,
}

-- Per-hand-index hand offsets. Index 1 is the LEFT hand, 2 is the
-- RIGHT hand. The two CFrames are mirrored: same translation
-- magnitude, opposite Z-rotation sign so the grip orientation faces
-- the same body-relative direction on both sides.
Module.StandardHandOffsets = {
	Sword = {
		[1] = CFrame.Angles(0, 0, math.rad( 90)) * CFrame.new(0.18, 0, 0),
		[2] = CFrame.Angles(0, 0, math.rad(-90)) * CFrame.new(0.18, 0, 0),
	},
}

Module.StandardEquipSlots = {
	Hands = {
		Slot = Module.EquipmentSlotEnums.Hand,
		IndexMax = 2, -- 1 = left, 2 = right
		AllowMultiEquip = true,
		MaxMultiEquip = 2,
	},
}

Module.WeaponUsageOperations = {
	Longsword = 1,
}

-- Empty at boot — populated by ConfigReplicationClient (category 'Items').
Module.Items = {} :: {[string]: BaseItemConfig}


function Module.GetConfigFromId(id: string): BaseItemConfig
	return Module.Items[id]
end

-- Effective rarity for a stack. Forged stacks may carry a per-stack
-- RarityOverride baked at forge time (Composition.Forged.RarityOverride),
-- which beats the cfg's static Rarity. Future systems (enchant tiers,
-- ascended drops) can layer their own overrides on the stack root and
-- this helper picks the highest available.
--
-- All rarity-aware UI sites (inventory tooltip, hotbar slot color,
-- equipment renderer cards) call into this so the override surfaces
-- consistently. cfg-only paths (bulk catalog browsers, missing-stack
-- previews) keep using cfg.Rarity directly.
function Module.GetEffectiveRarity(itemConfig: BaseItemConfig?, stack: any?): number
	local base = itemConfig and itemConfig.Rarity or 1
	if typeof(stack) ~= 'table' then return base end
	-- Direct stack-root override (e.g. ascended loot drop).
	if typeof(stack.Rarity) == 'number' then return stack.Rarity end
	-- Forge override.
	if typeof(stack.Composition) == 'table' then
		local forged = stack.Composition.Forged
		if forged and typeof(forged.RarityOverride) == 'number' then
			return forged.RarityOverride
		end
	end
	return base
end

-- Returns every category bucket the item belongs to, as an array of
-- `Module.ItemCategory` enum numbers. Order is stable: Weapon → Tool →
-- Equipment/Accessory → Consumable → Activatable → Material. The array
-- is freshly allocated on each call; cache it at the call site if it
-- ever shows up in a profile.
function Module.GetItemCategories(itemConfig: BaseItemConfig?): {number}
	local cats = {}
	if not itemConfig then
		table.insert(cats, Module.ItemCategory.Material)
		return cats
	end
	local equip = itemConfig.EquipmentData
	if equip then
		if equip.WeaponUsage then table.insert(cats, Module.ItemCategory.Weapon) end
		if equip.ToolUsage   then table.insert(cats, Module.ItemCategory.Tool)   end
		-- An item that's neither a weapon nor a tool but has equip slots
		-- is wearable; classify by primary slot to split armor vs jewelry.
		if not equip.WeaponUsage and not equip.ToolUsage then
			local firstSlot = equip.EquipSlots and equip.EquipSlots[1]
			local slotEnum = firstSlot and firstSlot.Slot
			if slotEnum and ACCESSORY_SLOT_LOOKUP[slotEnum] then
				table.insert(cats, Module.ItemCategory.Accessory)
			else
				table.insert(cats, Module.ItemCategory.Equipment)
			end
		end
	end
	if itemConfig.ConsumptionData then table.insert(cats, Module.ItemCategory.Consumable)  end
	if itemConfig.ActivationData  then table.insert(cats, Module.ItemCategory.Activatable) end
	-- Artisan input categories. Gem / EnchantScroll are pure metadata
	-- pointers — they layer cleanly on top of any other category.
	if itemConfig.GemId or itemConfig.Gem then
		table.insert(cats, Module.ItemCategory.Gem)
	end
	if itemConfig.EnchantInputData then
		table.insert(cats, Module.ItemCategory.EnchantScroll)
	end
	-- Material is mutually exclusive with the equippable / consumable /
	-- activatable buckets: an item that already classifies as one of
	-- those is NOT additionally a material, even if it has a forge
	-- pointer. Otherwise a "consumable scroll with a forge tag" would
	-- show up in BOTH the consumables tab AND the materials tab —
	-- visually duplicative and not what the player expects.
	local isAlreadyEquipOrConsume = false
	for _, c in cats do
		if c == Module.ItemCategory.Weapon
			or c == Module.ItemCategory.Tool
			or c == Module.ItemCategory.Equipment
			or c == Module.ItemCategory.Accessory
			or c == Module.ItemCategory.Consumable
			or c == Module.ItemCategory.Activatable
		then isAlreadyEquipOrConsume = true; break end
	end
	if not isAlreadyEquipOrConsume
		and (itemConfig.ForgeMaterialId or itemConfig.ForgeMaterial) then
		table.insert(cats, Module.ItemCategory.Material)
	end
	-- Final fallback: nothing matched — treat as a material so the item
	-- still appears in the inventory somewhere. Anything legitimately
	-- equippable would have already taken its bucket above.
	if #cats == 0 then table.insert(cats, Module.ItemCategory.Material) end
	return cats
end

-- // Artisan input resolvers — see ARTISAN.md §6 //
-- Both shorthand (Id-only string field) and longhand (full metadata
-- table field) are supported on ItemConfig. These helpers normalize
-- both forms into the longhand shape with default fields filled in,
-- so call sites never have to branch on which field was used.
-- Returns nil if the item isn't a forge / gem / enchant input at all.

function Module.GetForgeMaterial(itemConfig: BaseItemConfig?): ForgeMaterialMetadata?
	if not itemConfig then return nil end
	if itemConfig.ForgeMaterial then
		local m = itemConfig.ForgeMaterial
		return { Id = m.Id, UnitsPerStack = m.UnitsPerStack or 1 }
	end
	if typeof(itemConfig.ForgeMaterialId) == 'string' then
		return { Id = itemConfig.ForgeMaterialId, UnitsPerStack = 1 }
	end
	return nil
end

function Module.GetGem(itemConfig: BaseItemConfig?): GemMetadata?
	if not itemConfig then return nil end
	if itemConfig.Gem then return { Id = itemConfig.Gem.Id } end
	if typeof(itemConfig.GemId) == 'string' then return { Id = itemConfig.GemId } end
	return nil
end

function Module.GetEnchantInput(itemConfig: BaseItemConfig?): EnchantInputMetadata?
	if not itemConfig then return nil end
	local e = itemConfig.EnchantInputData
	if not e or typeof(e.Id) ~= 'string' then return nil end
	return { Id = e.Id, Level = e.Level, Charges = e.Charges or 1 }
end

-- Convenience: walk Module.Items to find every item config whose
-- ForgeMaterialId resolves to the given material id. Used by the cmdr
-- /give_material command to pick a canonical inventory item to grant.
-- Returns the lowest-rarity match first (deterministic ordering).
function Module.GetItemIdsByForgeMaterialId(materialId: string): {string}
	local matches = {}
	for itemId, cfg in Module.Items do
		local fm = Module.GetForgeMaterial(cfg)
		if fm and fm.Id == materialId then
			table.insert(matches, { Id = itemId, Rarity = cfg.Rarity or 1 })
		end
	end
	table.sort(matches, function(a, b) return a.Rarity < b.Rarity end)
	local out = {}
	for _, m in matches do table.insert(out, m.Id) end
	return out
end

-- Single-membership convenience check. Cheaper to call when you only
-- care about one bucket — avoids walking the array at the call site.
function Module.HasItemCategory(itemConfig: BaseItemConfig?, category: number): boolean
	if not itemConfig then
		return category == Module.ItemCategory.Material
	end
	local equip = itemConfig.EquipmentData
	if category == Module.ItemCategory.Weapon then
		return equip ~= nil and equip.WeaponUsage ~= nil
	elseif category == Module.ItemCategory.Tool then
		return equip ~= nil and equip.ToolUsage ~= nil
	elseif category == Module.ItemCategory.Equipment or category == Module.ItemCategory.Accessory then
		if not equip or equip.WeaponUsage or equip.ToolUsage then return false end
		local firstSlot = equip.EquipSlots and equip.EquipSlots[1]
		local slotEnum = firstSlot and firstSlot.Slot
		local isAccessory = slotEnum ~= nil and ACCESSORY_SLOT_LOOKUP[slotEnum] == true
		return (category == Module.ItemCategory.Accessory) == isAccessory
	elseif category == Module.ItemCategory.Consumable then
		return itemConfig.ConsumptionData ~= nil
	elseif category == Module.ItemCategory.Activatable then
		return itemConfig.ActivationData ~= nil
	elseif category == Module.ItemCategory.Material then
		return Module.GetForgeMaterial(itemConfig) ~= nil
			or (equip == nil
				and itemConfig.ConsumptionData == nil
				and itemConfig.ActivationData == nil
				and Module.GetGem(itemConfig) == nil
				and Module.GetEnchantInput(itemConfig) == nil)
	elseif category == Module.ItemCategory.Gem then
		return Module.GetGem(itemConfig) ~= nil
	elseif category == Module.ItemCategory.EnchantScroll then
		return Module.GetEnchantInput(itemConfig) ~= nil
	end
	return false
end

function Module.FindInventoryItemOfUUID(inventory, uuid: string): ({}?, string?)
	for itemId, uuidDict in inventory do
		if uuidDict[uuid] then
			return uuidDict[uuid], itemId
		end
	end
	return nil, nil
end

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/LODSettings.luau"><![CDATA[--[==[
	LODa1 - lower poly, render further
	LODa2 - higher poly, render closer

	TreeLOD - trees
	FoliageLOD - bushes/flowers

	PlayerEquipment - client-sided equipment rendering?
	PlayerCharacter - individual player characters
]==]

--[==[
	Buildings:
	- interior renderer (interior of building detail)
	- exterior renderer (building details, entrance, basic interior if there)
]==]

local Module = {}

-- level-of-detail tags
Module.LODTags = {'LODa1', 'LODa2', 'FoliageLOD', 'TreeLOD', 'PlayerEquipment', 'PlayerCharacter'}

-- interior-rendering tags
Module.InteriorTags = {'TownRegionLOD'}

-- tags that are ALWAYS visible on the server, LOD = exterior shell
Module.ServerEnabled = {'PlayerCharacter'}

-- tags that are ALWAYS visible on the client, LOD = exterior shell
Module.ClientEnabled = {}

-- high velocity threshold
Module.HighVelocityThreshold = 1_000

-- when in high velocity, only render these LOD tags
Module.HighVelocityTagWhitelist = {'PlayerCharacter'}

-- tags that have billboard entities enabled
Module.BillboardEnabledTags = {'TreeLOD'}

-- render distances for main tags
Module.LODRenderDistances = {
	Default = 512,

}

-- render distances for billboards
Module.BillboardRenderDistances = {
	Default = 1280,

}

-- maximum bounds of the quad-tree (divisble by 2)
Module.MaximumQuadTreeBounds = 131_072

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/LeaderboardConfig.luau"><![CDATA[-- LeaderboardConfig — per-category leaderboard authoring. Each
-- category has:
--   * Id        — stable identifier (used as ReplicatedData sub-key
--                 + DataStore key suffix). Never rename.
--   * Label     — display string.
--   * StoreKey  — OrderedDataStore name (typically 'LB_' + Id). Studio
--                 suffix appended at runtime so test data stays out of
--                 prod boards.
--   * Extract   — function(saveData) -> number. Pulls the score for
--                 this category out of saveData. Sum-style stats
--                 (e.g. total bosses defeated) live in saveData.Statistics
--                 as Map values; the extractor sums them. Non-stat
--                 fields (like character Level) read directly from
--                 saveData.
--
-- Reference design (modeled on a Knit/Replica-based service):
--   * Commit window: every CycleSec, walk every on-server player and
--     SetAsync their current value into each category store. Writes
--     are spread over CommitWindowSec to stay inside Roblox's per-
--     minute SetAsync budget.
--   * Pull: GetSortedAsync(top MaxEntries) for each category and
--     publish into a public 'Leaderboard' ReplicatedData category.
--   * Studio segmentation via STORE_SUFFIX so test data never bleeds
--     into the live boards.

-- Sibling-relative require: data modules are loaded as part of
-- `Modules` registration, and requiring the Modules tree from inside
-- a Data module triggers a recursive-require error. Reach into the
-- StatisticsConfig sibling directly. Same pattern Items.luau /
-- Boosters.luau / Achievements.luau use.
local StatisticsConfig = require(script.Parent:WaitForChild('StatisticsConfig'))

local Module = {}

----------------------------------------------------------------------
-- Constants. Tuned for a typical session — a 300s cycle (5 min) gives
-- enough room for the commit window + leaves the second half of the
-- cycle for the OrderedDataStore reads + Replica publish without the
-- write/read budgets stomping on each other.
----------------------------------------------------------------------
Module.CycleSec        = 300
Module.CommitWindowSec = 120
Module.MaxEntries      = 25

-- Public ReplicatedData category. Server publishes the merged board
-- snapshot; clients read non-yielding via LeaderboardClient.
Module.PublicCategory  = 'Leaderboard'

----------------------------------------------------------------------
-- Helpers — sum every value in a Statistics Map, or default to 0 when
-- the entry is missing or wrong-shaped.
----------------------------------------------------------------------
local function statValue(saveData: any, statId: number): number
	if typeof(saveData) ~= 'table' then return 0 end
	if typeof(saveData.Statistics) ~= 'table' then return 0 end
	local v = saveData.Statistics[tostring(statId)]
	return tonumber(v) or 0
end

local function statMapSum(saveData: any, statId: number): number
	if typeof(saveData) ~= 'table' then return 0 end
	if typeof(saveData.Statistics) ~= 'table' then return 0 end
	local m = saveData.Statistics[tostring(statId)]
	if typeof(m) ~= 'table' then return 0 end
	local total = 0
	for _, v in m do
		total += tonumber(v) or 0
	end
	return total
end

local IDS = StatisticsConfig.StatisticIds

----------------------------------------------------------------------
-- Category registry. Display order = array order. Adding a new
-- category here AND deploying once is enough — the server module's
-- store-acquisition pass picks them up on boot.
----------------------------------------------------------------------
-- PartName drives the in-world SurfaceGui binding: the
-- LeaderboardSurfaceClient looks up tagged ('Leaderboards') BaseParts /
-- Models by their .Name and matches it against this field. Kept
-- distinct from `Id` so designers can name a tagged model for clarity
-- ('TotalDamageBoard') without colliding with the shorter replica id.
--
-- Format hint for the UI:
--   * 'integer'  — comma-grouped count (default).
--   * 'duration' — H:MM (PlayTime + similar).
--   * 'gold'     — 'G' suffix (for currency-flavored counters).
Module.Categories = {
	{
		Id       = 'TotalDamage',
		Label    = 'Total Damage Dealt',
		StoreKey = 'LB_TotalDamage',
		PartName = 'TotalDamageBoard',
		Format   = 'integer',
		Extract  = function(saveData) return statValue(saveData, IDS.DamageDealtTotal) end,
	},
	{
		Id       = 'PvPDamage',
		Label    = 'PvP Damage Dealt',
		StoreKey = 'LB_PvPDamage',
		PartName = 'PvPDamageBoard',
		Format   = 'integer',
		Extract  = function(saveData) return statValue(saveData, IDS.DamageDealtPvP) end,
	},
	{
		Id       = 'PvEDamage',
		Label    = 'PvE Damage Dealt',
		StoreKey = 'LB_PvEDamage',
		PartName = 'PvEDamageBoard',
		Format   = 'integer',
		Extract  = function(saveData) return statValue(saveData, IDS.DamageDealtPvE) end,
	},
	{
		Id       = 'HighestLevel',
		Label    = 'Highest Level',
		StoreKey = 'LB_HighestLevel',
		PartName = 'HighestLevelBoard',
		Format   = 'integer',
		Extract  = function(saveData)
			-- Save struct's Level field is the source of truth. Newer
			-- saves keep it nil-safe.
			if typeof(saveData) ~= 'table' then return 0 end
			return tonumber(saveData.Level) or 1
		end,
	},
	{
		Id       = 'LevelExperience',
		Label    = 'Level XP Earned',
		StoreKey = 'LB_LevelExperience',
		PartName = 'LevelExperienceBoard',
		Format   = 'integer',
		Extract  = function(saveData) return statValue(saveData, IDS.LevelExperienceTotal) end,
	},
	{
		Id       = 'BossesDefeated',
		Label    = 'Bosses Defeated',
		StoreKey = 'LB_BossesDefeated',
		PartName = 'BossesDefeatedBoard',
		Format   = 'integer',
		Extract  = function(saveData) return statMapSum(saveData, IDS.BossesDefeated) end,
	},
	{
		Id       = 'QuestsCompleted',
		Label    = 'Quests Completed',
		StoreKey = 'LB_QuestsCompleted',
		PartName = 'QuestsCompletedBoard',
		Format   = 'integer',
		Extract  = function(saveData) return statValue(saveData, IDS.QuestsCompleted) end,
	},
	{
		Id       = 'GoldEarned',
		Label    = 'Gold Earned',
		StoreKey = 'LB_GoldEarned',
		PartName = 'GoldEarnedBoard',
		Format   = 'gold',
		Extract  = function(saveData) return statValue(saveData, IDS.GoldEarned) end,
	},
	{
		Id       = 'PlayTime',
		Label    = 'Total Play Time',
		StoreKey = 'LB_PlayTime',
		PartName = 'PlayTimeBoard',
		Format   = 'duration',
		Extract  = function(saveData) return statValue(saveData, IDS.PlayTimeTotal) end,
	},
	{
		Id       = 'KillStreak',
		Label    = 'Best Kill Streak',
		StoreKey = 'LB_KillStreak',
		PartName = 'KillStreakBoard',
		Format   = 'integer',
		Extract  = function(saveData) return statValue(saveData, IDS.KillStreakRecord) end,
	},
	{
		Id       = 'HighestHit',
		Label    = 'Highest Single Hit',
		StoreKey = 'LB_HighestHit',
		PartName = 'HighestHitBoard',
		Format   = 'integer',
		Extract  = function(saveData) return statValue(saveData, IDS.HighestSingleHit) end,
	},
	{
		Id       = 'ItemsCrafted',
		Label    = 'Items Crafted',
		StoreKey = 'LB_ItemsCrafted',
		PartName = 'ItemsCraftedBoard',
		Format   = 'integer',
		Extract  = function(saveData) return statMapSum(saveData, IDS.ItemsCrafted) end,
	},
}

-- Look up by PartName (used by LeaderboardSurfaceClient). Tiny linear
-- scan; simpler than maintaining a side map. Matches:
--   1. Exact PartName (e.g. 'TotalDamageBoard').
--   2. Bare Id (e.g. 'TotalDamage') — designers commonly name parts
--      after the id directly without the 'Board' suffix.
--   3. Bare Id with 'Board' suffix stripped (in case PartName includes it).
-- Order matters: PartName wins over Id so a category that has both
-- patterns assigned can disambiguate.
function Module.GetCategoryByPartName(name: string)
	for _, def in Module.Categories do
		if def.PartName == name then return def end
	end
	for _, def in Module.Categories do
		if def.Id == name then return def end
	end
	return nil
end

function Module.GetCategory(id: string)
	for _, cat in Module.Categories do
		if cat.Id == id then return cat end
	end
	return nil
end

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/LevelGates.luau"><![CDATA[-- LevelGates — single source of truth for per-system minimum-level gates.
--
-- Five gated systems, in escalating order of complexity:
--   * Skills   → level 5    (cast skills from the hotbar / skill tree)
--   * Crafting → level 7    (CraftingServer.AttemptCraft)
--   * Forge    → level 10   (ForgeWidget + ForgeServer.AttemptForgeWeapon)
--   * Gems     → level 15   (GemSocketWidget + GemSocketServer)
--   * Enchant  → level 20   (EnchantingWidget + EnchantServer)
--
-- Both sides (client UI gate + server use-validation) read this module
-- so a level requirement is one-line authored. The server is
-- authoritative — clients can only suppress UI; the server check is
-- what actually refuses the action.
--
-- Two bypass mechanisms, ORed inside CanUseSystem:
--   * Per-player flag `saveData.Flags.LevelGateBypass` (boolean,
--     default false). Persists on the save. Cmdr `SetLevelGateBypass
--     <player> <bool>`. Replicated through the standard PlayerData
--     path so the client honors it the same frame.
--   * Server-wide global flag — owned by `LevelGatesServer.GlobalBypass`,
--     in-memory only (resets on server start). Cmdr
--     `SetGlobalLevelGateBypass <bool>`. Replicated to clients via the
--     public 'ServerFlags' category. Callers pass it as the optional
--     `globalBypass` arg to CanUseSystem; this shared module is
--     intentionally context-free and doesn't require either client or
--     server state directly.

local Module = {}

----------------------------------------------------------------------
-- System enum. String constants so call sites read clearly:
--   LevelGates.Systems.Forge instead of literals like 'forge'.
----------------------------------------------------------------------
Module.Systems = {
	Skills   = 'skills',
	Crafting = 'crafting',
	Forge    = 'forge',
	Gems     = 'gems',
	Enchant  = 'enchant',
}

----------------------------------------------------------------------
-- Required level per system. Treated as `>=` — at the gate level
-- the action is allowed. Edit here to retune progression pacing.
----------------------------------------------------------------------
Module.RequiredLevels = {
	[Module.Systems.Skills]   = 5,
	[Module.Systems.Crafting] = 7,
	[Module.Systems.Forge]    = 10,
	[Module.Systems.Gems]     = 15,
	[Module.Systems.Enchant]  = 20,
}

----------------------------------------------------------------------
-- Player-facing display labels. Used by the level-lock overlay and
-- the toast surfaced when server-side gates refuse an action.
----------------------------------------------------------------------
Module.DisplayLabels = {
	[Module.Systems.Skills]   = 'Skills',
	[Module.Systems.Crafting] = 'Crafting',
	[Module.Systems.Forge]    = 'Forge',
	[Module.Systems.Gems]     = 'Gem Socketing',
	[Module.Systems.Enchant]  = 'Enchanting',
}

----------------------------------------------------------------------
-- Pure predicates.
----------------------------------------------------------------------
function Module.GetRequiredLevel(systemId: string): number
	return Module.RequiredLevels[systemId] or 1
end

function Module.GetDisplayLabel(systemId: string): string
	return Module.DisplayLabels[systemId] or systemId
end

-- Read the per-save bypass for `systemId`. Honors three shapes the
-- LevelGateBypass field can take, in order of preference:
--   * Table (current) — `{ all = bool, [systemId] = bool, ... }`. Either
--     the master `all` or the system-specific key being true grants bypass.
--   * Boolean (legacy) — `true` treated as `all = true` so old admin
--     writes still take effect until upgraded.
--   * Anything else / nil — treated as no bypass.
--
-- Top-level `saveData.LevelGateBypass` (older-still legacy from before
-- the Flags sub-table) is intentionally NOT read — a wiped admin grant
-- in that location must not silently re-grant after a structural
-- migration; this is the safe failure mode.
function Module.IsBypassed(saveData: any, systemId: string?): boolean
	if typeof(saveData) ~= 'table' then return false end
	local flags = saveData.Flags
	if typeof(flags) ~= 'table' then return false end
	local bypass = flags.LevelGateBypass
	if typeof(bypass) == 'boolean' then return bypass end  -- legacy
	if typeof(bypass) ~= 'table' then return false end
	if bypass.all == true then return true end
	if systemId ~= nil and bypass[systemId] == true then return true end
	return false
end

-- Predicate: is the global-bypass payload either the master `all`
-- flag or the system-specific key set? Accepts:
--   * Boolean — legacy "all" master.
--   * Table   — `{ all = bool, [systemId] = bool, ... }`.
--   * nil / anything else — no bypass.
function Module.IsGlobalBypassed(globalBypass: any, systemId: string?): boolean
	if typeof(globalBypass) == 'boolean' then return globalBypass end
	if typeof(globalBypass) ~= 'table' then return false end
	if globalBypass.all == true then return true end
	if systemId ~= nil and globalBypass[systemId] == true then return true end
	return false
end

-- Authoritative gate check. Returns (allowed, reason).
--   * allowed = true and reason = '' on pass.
--   * allowed = false and reason = 'level_locked' otherwise.
--
-- Three escape hatches, ANY one of which grants access:
--   1. Per-player save flag (saveData.Flags.LevelGateBypass) — set via
--      Cmdr SetLevelGateBypass <player> <system> <bool>. Per-system
--      keys + an `all` master.
--   2. Server-wide global bypass (caller-supplied `globalBypass`) —
--      passed by the server as LevelGatesServer.GetGlobalBypass(), by
--      the client as LevelGatesClient.GetGlobalBypass(). Same shape
--      as the per-player table; same `all`+per-system semantics.
--      Boolean form still accepted as a legacy "all" master.
--   3. Player level >= system's required level.
--
-- `globalBypass` is optional; nil treated as "not globally bypassed".
function Module.CanUseSystem(saveData: any, systemId: string, globalBypass: any?): (boolean, string)
	if Module.IsGlobalBypassed(globalBypass, systemId) then return true, '' end
	if Module.IsBypassed(saveData, systemId) then return true, '' end
	local required = Module.GetRequiredLevel(systemId)
	local current = (typeof(saveData) == 'table' and tonumber(saveData.Level)) or 1
	if current >= required then return true, '' end
	return false, 'level_locked'
end

-- Pre-formatted "Requires level N (System)" string for toasts/UI.
function Module.FormatGateMessage(systemId: string): string
	return string.format('Requires level %d to use %s.',
		Module.GetRequiredLevel(systemId),
		Module.GetDisplayLabel(systemId))
end

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Leveling.luau"><![CDATA[
local Module = {}

-- GRAPH 1
-- = 25 + FLOOR.MATH((100 * $A1) * (POWER(MAX($A1-1, 0), 1.2) / MAX($A1 * 1.2, 1))) + FLOOR.MATH(2500 * FLOOR.MATH(A1-1)/50)

Module.MaxLevel = 50
function Module.GetExperienceToLevel(level : number) : number
	return 25 + math.floor((100 * level) * (math.pow(math.max(level-1, 0), 1.2) / math.max(level * 1.2, 1))) + math.floor(2500 * math.floor(level-1)/50)
end

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Materials.luau"><![CDATA[-- Forge material catalog. Definitions = registry — see ARTISAN.md §4.
-- The table literal IS the registry; ItemConfig.ForgeMaterialId references
-- entries here. Multiple inventory items can share the same material id
-- (e.g. CrudeIronBar + RefinedIronBar both → 'iron') with different
-- UnitsPerStack on the ItemConfig side.

export type Material = {
	Id: string,
	Name: string,
	Color: Color3,
	-- Stat contributions per material unit. Forge stat math composites
	-- these via per-slot weight (ForgeShared.ComputeStats walks the
	-- blueprint's slots and sums weighted contributions).
	Damage: number,
	Speed: number,
	Weight: number,
	Durability: number,
	-- Trait token surfaced on tooltips + stored in StatSnapshot.BonusTraits.
	-- Non-mechanical in v1 (cosmetic / informational); future passes can
	-- map traits to combat-side effects.
	Trait: string,
	-- Minimum Smithing artisan level needed to use this material.
	-- ForgeShared.CanForgeWeapon refuses commits whose materials list
	-- includes any with RequiredLevel > player's Smithing level.
	-- Tier ladder is rough damage tiers; designers retune as needed.
	RequiredLevel: number,
	-- Tier (1..6) drives the dynamic rarity ladder of forged items
	-- via ForgeShared.ComputeForgedRarity. Cosmetically aligns with
	-- the Rarities enum (Common = 1 … Mythic = 6).
	Tier: number,
}

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

local Module = {}

Module.Materials = {
	iron       = { Id='iron',       Name='Iron',       Color=rgb(176,180,188), Damage=80,  Speed=1.0, Weight=1.2, Durability=1.0, Trait='—',                  RequiredLevel=1,  Tier=1 },
	steel      = { Id='steel',      Name='Steel',      Color=rgb(224,228,236), Damage=120, Speed=1.1, Weight=1.0, Durability=1.3, Trait='Heavy',              RequiredLevel=8,  Tier=2 },
	obsidian   = { Id='obsidian',   Name='Obsidian',   Color=rgb(58,42,72),    Damage=160, Speed=0.9, Weight=0.8, Durability=0.7, Trait='Brittle · crit',     RequiredLevel=15, Tier=2 },
	moonsteel  = { Id='moonsteel',  Name='Moonsteel',  Color=rgb(180,200,255), Damage=210, Speed=1.2, Weight=0.7, Durability=1.5, Trait='Lunar · regen',      RequiredLevel=22, Tier=3 },
	emberite   = { Id='emberite',   Name='Emberite',   Color=rgb(255,128,64),  Damage=240, Speed=1.1, Weight=0.9, Durability=1.1, Trait='Pyromantic',         RequiredLevel=30, Tier=3 },
	voidglass  = { Id='voidglass',  Name='Voidglass',  Color=rgb(200,157,255), Damage=280, Speed=1.3, Weight=0.6, Durability=0.9, Trait='Phase · +10% crit',  RequiredLevel=45, Tier=4 },
	dragonbone = { Id='dragonbone', Name='Dragonbone', Color=rgb(255,198,112), Damage=340, Speed=1.0, Weight=1.1, Durability=1.8, Trait='+8% DMG vs boss',    RequiredLevel=65, Tier=5 },
	starsilk   = { Id='starsilk',   Name='Starsilk',   Color=rgb(224,234,255), Damage=40,  Speed=1.6, Weight=0.3, Durability=1.2, Trait='Swift · +AGI',       RequiredLevel=80, Tier=6 },
} :: { [string]: Material }

-- Derived index: ascending damage for catalog browsers / UI sorting.
-- Compiled once at module load; cheap (small N).
Module.MaterialsByDamage = {}
do
	for _, m in Module.Materials do
		table.insert(Module.MaterialsByDamage, m)
	end
	table.sort(Module.MaterialsByDamage, function(a, b) return a.Damage < b.Damage end)
end

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Mobs.luau"><![CDATA[
export type Animations = {
	Idle: string,
	Walk: string,
	[string]: string,
}

export type MobConfig = {
	HasOverheadInfo: boolean,
	HasCrystalCrystal: boolean,
	IsInvulnerable: boolean,
	RewardLootOnDeath: boolean,

	WalkSpeed: number,

	MaxTrackRange: number,

	MaxAttackRange: number,
	AttackDashSpeed: number,
	AttackDamage: number,
	FactionId: string?,

	Animations: Animations,
}

local function SetProperties(parent, properties)
	for i, v in properties do
		parent[i] = v
	end
	return parent
end

-- default mob properties
local function BuildDefault(properties): MobConfig
	return SetProperties({
		HasOverheadInfo = true,
		HasCrystalCrystal = true,
		IsInvulnerable = false,

		Animations = nil,

		RewardLootOnDeath = true,
		FactionId = nil,
	}, properties)
end

-- // Module // --
local Module = {}

-- customize mob properties
Module.Mobs = {
	-- Baseline melee enemy. These values drive the shared combat runtime
	-- exactly as a player's equipped weapon does — the mob resolves the
	-- default weapon class's moveset and runs the same combo grammar.
	Generic = BuildDefault({
		MaxTrackRange = 50,
		MaxAttackRange = 7,
		-- Where pursuit parks. Sitting slightly inside attack range
		-- stops the mob walking into the player and shoving them.
		PreferredRange = 5,
		AttackDamage = 10,
		AttackInterval = 1,
		-- Probability of evading when a hostile hitbox is genuinely live
		-- and overlapping this mob. Not a timer: see TryEvadeIncoming.
		DodgeChance = 0.15,
		-- Poise archetype governs how much punishment it absorbs before
		-- staggering, and whether it can be launched at all.
		PoiseArchetype = 'Fodder',
	}),

	-- Attack-dummy class. Stationary swing-on-tick — no target tracking,
	-- no wander, no movement. Used by SetupTestDummies to drive the
	-- workspace.Attacking / LeftAttacker / RightAttacker / DualAttacker
	-- rigs. SwingInterval governs the period between swings; the
	-- ForceBlockBreak boolean attribute on the model (set per-rig in
	-- SetupTestDummies) overrides the BT's default swing args.
	AttackDummy = BuildDefault({
		SwingInterval = 1.0,
		-- The BT routes through the shared combat runtime, so a dummy
		-- swings with the same moveset, reach and combo grammar a player
		-- would get from the same weapon. It walks an L, L, H pattern,
		-- meaning the third beat is the class's launcher — parking a
		-- character in front is enough to see the full chain.
		--
		-- No movement: the dummy faces wherever it was placed in Studio.
		PoiseArchetype = 'Fodder',
	}),

	Boar = BuildDefault({
		WalkSpeed = 14,

		MaxTrackRange = 36,

		MaxAttackRange = 24,
		AttackDashSpeed = 36,
		AttackDamage = 10,

		Animations = {
			Idle = 'rbxassetid://15145743300',
			Walk = 'rbxassetid://15145746545',

			ChargeRun = 'rbxassetid://15145755732'
		},
	}),

	-- BossBoar — phased boss variant. Same model + animations as Boar
	-- but ~10× HP, BossId set so EnemyServer routes it through
	-- BossServer for phase tracking, and HasOverheadInfo=false because
	-- BossHealthbarWidget owns the visual surface for bosses.
	-- The Boss config (Data/Bosses.luau:boss_boar) drives every
	-- attack pattern — recipes from Data/CombatSkills.luau drive
	-- the actual telegraph + damage path.
	BossBoar = BuildDefault({
		HasOverheadInfo = false,
		HasCrystalCrystal = false,
		BossId = 'boss_boar',

		WalkSpeed = 14,
		MaxTrackRange = 60,
		MaxAttackRange = 28,
		AttackDashSpeed = 38,
		AttackDamage = 14,    -- baseline; per-recipe damage overrides

		-- BossBoar shares the Boar's animation rig — the procedural
		-- size/health bumps come from BossBoar.luau on init.
		Animations = {
			Idle = 'rbxassetid://15145743300',
			Walk = 'rbxassetid://15145746545',
			ChargeRun = 'rbxassetid://15145755732',
		},
	}),
} :: {[string]: MobConfig}

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Modifiers.luau"><![CDATA[-- // Modifiers — CLIENT-SIDE SHELL //
--
-- Authored data lives at ServerStorage/Modules/Data/Modifiers.luau.
-- This file's `Module.Modifiers` table starts EMPTY at boot. The shell
-- is populated by ItemsConfigReplicationServer's piggy-back pass —
-- when items bundle, any Modifier ids referenced via the player's
-- forged stacks (Composition.Forged.Modifiers) are pushed alongside.
-- ForgeServer also pushes individual Modifier rows on each forge
-- commit. See ROADMAP.md §"Empty client shell."
--
-- Reading: callers (ForgeWidget, InventoryTab tooltips) call
-- `Module.Modifiers[id]` and tolerate nil — un-replicated mod ids
-- render as a generic chip rather than erroring.
--
-- The TYPES + the `MaxModifierSlots` constant intentionally LIVE here
-- (populated). They aren't spoiler content — modifier-slot budget is
-- a UI authority that the forge widget reads to enforce the cost cap.
--
-- Forge modifier catalog — see ARTISAN.md §4.
-- Modifiers are slottable bonuses applied on top of a forged weapon's
-- base material stats. Each modifier has a `Cost` (modifier slots
-- consumed) and a `MaxStack` (how many times it can be applied to a
-- single weapon).
--
-- Two payload channels:
--   * `StatDelta` — flat / percent contributions baked into the
--     forge StatSnapshot (combat reads via composition multipliers).
--     Authors set fields they want to bump; nil = no change.
--   * `OnHit` — per-strike inflict reference. When the weapon lands a
--     hit, CombatUtility walks ComputeActiveModifiers(stack) and rolls
--     each OnHit's Chance to inflict the named effect. PerStackPotency
--     scales the potency by stack count so an Ember×3 ember-mod hits
--     harder than Ember×1.

export type ModifierStatDelta = {
	-- Flat damage added per stack.
	Damage: number?,
	-- Percent multipliers (1.0-baseline, 0.10 = +10%).
	SpeedPct: number?,
	CritPct: number?,
	DurabilityPct: number?,
	-- Bonus tag surfaced on tooltip; non-mechanical.
	TraitTag: string?,
}

export type ModifierOnHit = {
	-- Effect id from Data/Effects.luau registry.
	EffectId: string,
	-- 0..1 chance per swing per stack. Total per-swing chance is
	-- 1 - (1 - Chance) ^ stackCount when applied across stacks.
	Chance: number,
	-- Optional duration / potency overrides; nil = effect cfg defaults.
	Duration: number?,
	Potency: number?,
	-- Per-stack potency add. When set, the runtime infliction's
	-- Potency = (Potency or default) + (PerStackPotency × stackCount).
	-- Useful for Ember (each stack burns harder), Onyx-bleed, etc.
	PerStackPotency: number?,
}

export type Modifier = {
	Id: string,
	Name: string,
	Color: Color3,
	Effect: string,                 -- player-facing effect description
	Cost: number,                   -- modifier slots consumed per stack
	MaxStack: number,               -- max times this can be stacked on one weapon
	-- New optional fields. Existing entries keep working with nil here;
	-- CombatUtility / ForgeShared early-return on missing fields.
	StatDelta: ModifierStatDelta?,
	OnHit: ModifierOnHit?,
}

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

local Module = {}

-- Total modifier-slot budget per weapon. Forge UI / server enforces
-- that the sum of (cost × stacks-applied) stays ≤ this number.
Module.MaxModifierSlots = 12

-- Empty at boot — populated by ConfigReplicationClient (category 'Modifiers').
-- See Items piggy-back: ItemsConfigReplicationServer pushes both 'Items'
-- and 'Modifiers' bundles together when forged stacks come into view.
Module.Modifiers = {} :: { [string]: Modifier }


return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Mounts.luau"><![CDATA[-- // Mounts — CLIENT-SIDE SHELL //
--
-- Authored data lives at ServerStorage/Modules/Data/Mounts.luau.
-- This file's `Module.Mounts` table starts EMPTY and is populated at
-- runtime by MountsConfigReplicationClient as the server pushes rows
-- the player has earned (owned mounts + transitive deps), or — for
-- whitelisted admin UserIds — the full registry on join.
--
-- // Reading contract //
-- Callers must tolerate `Module.Mounts[id] == nil` for a player who
-- doesn't own the mount yet. Treat absent ids as "not currently
-- visible to this player" and render nothing rather than erroring
-- (e.g. the Mounts tab hides un-replicated entries; the hotbar's
-- mount slot greys out if the equipped mount's config isn't replicated
-- yet — though in practice the bootstrap pass populates owned mounts
-- before the first frame the widget can open).
--
-- The type exports below are STILL valid — they describe the shape of
-- a mount config row, which the server-side authored copy still
-- conforms to and the replicator pushes verbatim. Type-checked code
-- that asserts `mountCfg :: MountConfig` continues to compile.
--
-- See ROADMAP.md §"Empty client shell" for the full pattern.
--
-- Mount kinds:
--   'land'   — runs on the ground; humanoid WalkSpeed boost.
--   'hover'  — floats above the ground at HoverHeight, walks normally.
--             No flight controls — Space/Ctrl don't ascend/descend; the
--             rider is just "elevated" while moving with WSAD. Reads as
--             "magic carpet" / "hoverboard" in feel.
--   'flight' — true flight rig: humanoid.PlatformStand + BodyVelocity,
--             Space/Ctrl ascend/descend with FlightCeiling cap.
export type MountKind = 'land' | 'hover' | 'flight'

export type MountStats = {
	Speed: number,                  -- forward studs/sec while mounted
	Acceleration: number,           -- studs/sec² ramp
	TurnRate: number,               -- rad/sec yaw
	JumpPower: number?,             -- land/hover mounts; nil = use base humanoid
	HoverHeight: number?,           -- hover only: studs above ground (humanoid HipHeight)
	FlightCeiling: number?,         -- max height above ground in studs (flight only)
	FlightAscentRate: number?,      -- studs/sec when ascending (flight only)
	FlightDescentRate: number?,     -- studs/sec when descending or no input (flight only)
	DismountOnDamage: boolean,
}

export type MountAnimations = {
	Idle: string?,
	Walk: string?,
	Run: string?,
	Jump: string?,
	Land: string?,
	Hover: string?,                 -- flight only
	Glide: string?,                 -- flight only
	RiderIdle: string?,             -- player rider animation while seated
	RiderRun: string?,
}

export type MountSoundEffects = {
	Mount: { Sound: string, Volume: number? }?,
	Dismount: { Sound: string, Volume: number? }?,
	Footstep: { Sound: string, Volume: number? }?,
	WingFlap: { Sound: string, Volume: number? }?,
}

export type MountConfig = {
	Display: {
		Name: string,
		Description: string,
		Icon: string?,
	},
	Kind: MountKind,
	Model: string,                  -- AssetsShared.Mounts.<Model>
	SeatOffset: CFrame,             -- where the rider sits relative to the model
	Stats: MountStats,
	Animations: MountAnimations,
	SFX: MountSoundEffects,
	Tint: Color3?,                  -- procedural placeholder tint for the mount's breed color
	UnlockSource: 'quest' | 'shop' | 'achievement' | 'event' | 'starter',
}

-- Backwards-compat alias: older code may refer to MountsConfig (singular
-- key). Both names point at the same shape.
export type MountsConfig = MountConfig

local Module = {}

-- Empty at boot — populated by MountsConfigReplicationClient.
Module.Mounts = {} :: { [string]: MountConfig }

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Onboarding.luau"><![CDATA[-- Onboarding step configs. Each step has an id, a one-line cue, and an
-- optional CompletionCheck function (so a step can auto-complete when
-- the player performs the expected action — e.g. opens inventory).
-- The OnboardingServer iterates these in StepOrder; the client renders
-- the active step as an overlay tooltip + optional spotlight cutout.
--
-- Storyline arc — the trapped-in-game premise:
--   You wake at spawn with no memory; the Tutor explains you have been
--   pulled into Bladeborne and will only return home by reaching
--   Floor 100 and defeating its boss. Onboarding walks you through the
--   essential controls (movement, combat, inventory, map / waystones)
--   and ends with the long-running quest entry.
--
-- StepOrder advances strictly in array order. The Tutor NPC dialogue
-- + cinematic camera live on the OnboardingServer side; per-step
-- highlights drive the tutorial overlay's spotlight.

export type HighlightAnchor =
	  'screen_rect'   -- Position/Size in fromScale (top-left) on the screen
	| 'world_part'    -- TODO: project a workspace BasePart's bounds
	| 'tab_chip'      -- Anchored to a specific tab chip via TabId

export type OnboardingHighlight = {
	Anchor: HighlightAnchor,
	-- For 'screen_rect': fromScale Vector2 anchor (top-left) + Size in fromScale.
	-- For 'tab_chip': TabId is the rail id — OnboardingClient resolves at render.
	-- For 'world_part': InstancePath strings via CinematicShared.ResolveInstancePath.
	Position: Vector2?,
	Size: Vector2?,
	TabId: string?,
	InstancePath: string?,
	-- Optional caption shown below the cutout (≤ 80 chars). Defaults to
	-- the step's Title when nil.
	Caption: string?,
}

export type OnboardingStep = {
	Id: string,
	Title: string,
	Body: string,
	-- Returns true when the step should be considered complete. Server
	-- runs the check periodically; can also be tripped externally by
	-- gameplay code calling OnboardingServer.AdvanceIfStep(player, id).
	CompletionCheck: ((player: Player, saveData: any) -> boolean)?,
	-- Optional spotlight cutout — OnboardingWidget darkens the screen
	-- and "punches" a hole here so the player's eye lands on the
	-- right UI element. nil = no overlay (text-only tooltip).
	Highlight: OnboardingHighlight?,
	-- Whether the player can dismiss this step manually via the GOT IT
	-- button. Story / cinematic steps disable this so the player can't
	-- skip the premise. Defaults to true.
	AllowDismiss: boolean?,
}

local Module = {}

----------------------------------------------------------------------
-- OnboardingEvent remote protocol. The first arg of every fire is one of
-- these action discriminators. Both the server (FireClient/OnServerEvent)
-- and the client widgets (OnClientEvent/FireServer) reference these
-- constants rather than the raw strings, so a rename is a single-site
-- change and a typo is a nil-index — not a silently dead branch.
----------------------------------------------------------------------
export type OnboardingAction =
	  'ShowWelcome'
	| 'FinishWelcome'
	| 'StepChanged'
	| 'MarkComplete'

Module.Actions = {
	ShowWelcome   = 'ShowWelcome',    -- S→C: open the first-join welcome modal
	FinishWelcome = 'FinishWelcome',  -- C→S: player clicked FINISH; sets JoinGame1
	StepChanged   = 'StepChanged',    -- S→C: tutorial advanced to a new step
	MarkComplete  = 'MarkComplete',   -- C→S: player dismissed the active step
} :: { [string]: OnboardingAction }

----------------------------------------------------------------------
-- Welcome popup pages. Rendered as a centered multi-page modal by
-- JoinGameWelcomeWidget on a player's first join (before the
-- FFlags.JoinGame1 flag is set — see Data.FFlags). The final page's
-- button reads FINISH and sets that flag.
--   1. General game premise.
--   2. Early-game (≤ level 5) gameplay loop.
--   3. UI orientation.
----------------------------------------------------------------------
export type WelcomePage = {
	Eyebrow: string,   -- small mono uppercase kicker
	Title: string,
	Body: string,
}

Module.WelcomePages = {
	{
		Eyebrow = 'WELCOME TO BLADEBORNE',
		Title = 'You are trapped in the game',
		Body = "You've been pulled into Bladeborne with no way out but forward. The only path home is to climb to Floor 100 and defeat its keeper. Gather allies, sharpen your blade, and survive.",
	},
	{
		Eyebrow = 'YOUR FIRST FEW LEVELS',
		Title = 'Levels 1–5: find your feet',
		Body = "Stay near the spawn town while you're under level 5 — the early enemies here are forgiving. Left-click to swing, hold guard to block, and dash with LeftCtrl. Defeat enemies and complete your first quest to earn XP, level up, and unlock new abilities.",
	},
	{
		Eyebrow = 'GETTING AROUND THE UI',
		Title = 'Know your HUD',
		Body = "Press [Tab] to open your menu — inventory, skills, and travel all live there. Your hotbar sits bottom-center for weapons and abilities. Tracked quests show top-right, and the minimap helps you navigate. A starter quest has been added to your log.",
	},
} :: { WelcomePage }

----------------------------------------------------------------------
-- Step order. First entry plays after the intro cinematic; subsequent
-- entries play once the previous step's CompletionCheck succeeds.
----------------------------------------------------------------------
Module.StepOrder = {
	'wake_up',
	'meet_tutor',
	'learn_movement',
	'learn_combat',
	'learn_inventory',
	'learn_map',
	'finished',
}

Module.Steps = {

	-- // Storyline: the player wakes at spawn //
	wake_up = {
		Id = 'wake_up',
		Title = 'Where am I?',
		Body = 'You wake at the edge of a strange town. A figure approaches. Speak with them.',
		AllowDismiss = false,
		-- No highlight — the player should look around the world, not
		-- the UI. The Tutor walks toward them and triggers the next step.
	},

	meet_tutor = {
		Id = 'meet_tutor',
		Title = 'The Tutor',
		Body = 'You are inside Bladeborne. To return home, reach Floor 100 and defeat its keeper. Press [E] to talk to the Tutor.',
		AllowDismiss = false,
		-- Highlights the Tutor NPC via instance path so the spotlight
		-- lands on the world. OnboardingClient projects the world
		-- position to screen each frame.
		Highlight = {
			Anchor = 'world_part',
			InstancePath = 'workspace.NPCs.Tutor.HumanoidRootPart',
			Caption = 'Walk up and press E',
		},
	},

	learn_movement = {
		Id = 'learn_movement',
		Title = 'Move',
		Body = 'WASD walks. Spacebar jumps. Hold LeftCtrl for the dash. Try them now.',
	},

	learn_combat = {
		Id = 'learn_combat',
		Title = 'Combat',
		Body = 'Left-click to swing. Press R to lock onto a target. F holds your guard.',
		Highlight = {
			Anchor = 'screen_rect',
			-- Cluster around the bottom-center hotbar so the player
			-- sees the Attack hint visualized in context.
			Position = Vector2.new(0.30, 0.85),
			Size = Vector2.new(0.40, 0.10),
			Caption = 'Hotbar — equip a weapon, then click',
		},
	},

	learn_inventory = {
		Id = 'learn_inventory',
		Title = 'Inventory',
		Body = 'Press [Tab] to open the menu. Inventory shows what you carry; right-click to use or equip.',
		Highlight = {
			Anchor = 'tab_chip',
			TabId = 'Inventory',
			Caption = 'Click the Inventory rail entry',
		},
	},

	learn_map = {
		Id = 'learn_map',
		Title = 'Travel',
		Body = 'Open the Travel tab to view waystones. Walk to a waystone marker on the world to unlock it.',
		Highlight = {
			Anchor = 'tab_chip',
			TabId = 'Travel',
			Caption = 'Travel tab',
		},
	},

	finished = {
		Id = 'finished',
		Title = 'Floor 1 awaits',
		Body = "You're ready. The path to Floor 100 is long — find allies, level your skills, forge real weapons. Good luck.",
	},

} :: { [string]: OnboardingStep }

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/PremiumConfig.luau"><![CDATA[-- Premium config — gamepass ids and the per-feature benefit they
-- unlock. Single source of truth for both the server's
-- UserOwnsGamePassAsync gate AND the client's UI badges.
--
-- Usage:
--   local PremiumConfig = ReplicatedModules.Data.PremiumConfig
--   PremiumConfig.GAMEPASSES.AuraSlots         → number (Roblox gamepass id)
--   PremiumConfig.GetMaxAuraSlots(hasPass)     → number (1 or 3)
--
-- Server-side: prefer SystemsContainer.PremiumServer.GetMaxAuraSlots(player).
-- Client-side: prefer reading replicated PlayerData.Premium booleans and
-- using the helpers below.

local Module = {}

----------------------------------------------------------------------
-- Gamepass id registry. Replace the placeholder zeros with the real
-- gamepass ids once published. Until then the server's
-- UserOwnsGamePassAsync call returns false (Roblox treats id 0 as
-- "not a gamepass") so every player is treated as default-tier.
----------------------------------------------------------------------
Module.GAMEPASSES = {
	-- Increases the player's aura-slot cap from 1 → 3. Three is the
	-- design max so multi-anchor (character + sword + mount) is the
	-- gamepass headline; lower counts are intentionally not offered.
	AuraSlots = 0,
	-- Increases the player's companion-slot cap from 1 → 3. Mirrors
	-- AuraSlots: free tier ships with the headline cap so the system
	-- is fully usable; gamepass design will retarget once a real
	-- cap-extending benefit ships.
	CompanionSlots = 0,
}

----------------------------------------------------------------------
-- Aura slots benefit. Default cap is 1 (one aura equipped at a time);
-- gamepass cap is 3 (the original anchor-trio reach goal).
----------------------------------------------------------------------
-- Default cap raised to 3 (the design max) so a fresh player can equip
-- one aura per anchor (character + sword + mount) without the gamepass.
-- The gamepass design will need re-targeting once a real cap-extending
-- benefit ships; for now it's a no-op since the placeholder pass id is 0.
Module.AuraSlots = {
	Default       = 3,
	WithGamepass  = 3,
	-- Display string surfaced in the gamepass purchase prompt /
	-- inventory UI. Kept in this config so swapping copy doesn't
	-- require touching server code.
	GamepassName  = 'Aura Slot Pack',
}

function Module.GetMaxAuraSlots(hasGamepass: boolean): number
	return hasGamepass and Module.AuraSlots.WithGamepass or Module.AuraSlots.Default
end

----------------------------------------------------------------------
-- Companion slots benefit. Mirrors AuraSlots: 3-slot default so the
-- system is fully usable without the gamepass; the pass exists as a
-- placeholder to retarget once a true cap-extending benefit ships.
----------------------------------------------------------------------
Module.CompanionSlots = {
	Default       = 3,
	WithGamepass  = 3,
	GamepassName  = 'Companion Slot Pack',
}

function Module.GetMaxCompanionSlots(hasGamepass: boolean): number
	return hasGamepass and Module.CompanionSlots.WithGamepass or Module.CompanionSlots.Default
end

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Quests.luau"><![CDATA[
export type BaseQuestData = {
	SubQuestIndex: number,
	Contributions: {[string]: number},
	-- Is this in-flight quest currently surfaced in the on-screen tracker?
	-- Toggled via QuestServer's `RemoteJobs.ToggleTracked` job.
	is_tracked: boolean,
}

export type DataQuestContainer = {
	-- [questId]
	[string]: {
		-- [uuid]: QuestData
		[string]: BaseQuestData
	}
}

export type CompletedQuestsContainer = {[string]: number}

export type BasePlayerData = {
	Level: number,
	ActiveQuests: DataQuestContainer,
	CompletedQuests: CompletedQuestsContainer,
}

export type ViewportIcon = {}

export type DisplayConfig = {
	Title: {Text: string, TextColor3: Color3},
	Description: {Text: string, TextColor3: Color3},
	Icon: ViewportIcon | string | number,
}

export type ContributionsConfig = {
	[string]: {string} | {[string]: number},
}

export type SubQuestConfig = {
	Contributions: ContributionsConfig,
	Display: DisplayConfig,
}

export type RewardsConfigTable = {
	Currency: number?,
	Experience: number?,

	Items: {[string]: number}?,
	Skills: {string}?,
	Attributes: {string}?,
}

export type QuestConfigTable = {
	Requirements: {
		Repeatable: boolean,
		MinimumLevel: number,
	},
	SubQuests: {SubQuestConfig},
	Continuation: {string},
	Rewards: RewardsConfigTable
}

export type PlayerDataBase = {
	Quests: DataQuestContainer,
	ActiveQuests: {[string] : {string}}
}

local function CountDictionary(dict: {[any]: any}): number
	local count = 0
	for k, v in dict do
		count += 1
	end
	return count
end


local function CreateBaseDisplay(TitleText, Description, IconData)
	return {
		Title = { Text = TitleText, TextColor3 = Color3.new(1, 1, 1), },
		Description = { Text = Description, TextColor3 = Color3.new(1, 1, 1), },
		Icon = IconData, -- table = viewport data, string/number = icon image id
	}
end

local function CreateSubQuestData(contributions, display): SubQuestConfig
	return { Contributions = contributions, Display = display, }
end

-- // Module // --
local Module = {}

Module.ArrayContributions = {
	-- array of strings (npc names)
	Defeat = "1",
	-- array of strings (places to visit)
	Visit = "2",
	-- array of strings relating to objects
	Interact = "3",
	-- array of strings relating to NPCs
	Talk = "4",
}

Module.DictContributions = {
	-- dictionary, itemName = amount
	Collect = "5",
	-- dictionary, npcName = amount
	Subjugate = "6",
	-- dict, statName = reqAmount
	StatValues = "7",
}

Module.ContributionStringFormating = {
	Default = function(a, b)
		return tostring(a)..' - '..tostring(b)
	end,

	[Module.ArrayContributions.Defeat] = function(_, value)
		return string.format("Defeat [%s]", tostring(value))
	end,
	[Module.ArrayContributions.Visit] = function(_, value)
		return string.format("Visit [%s]", tostring(value))
	end,
	[Module.ArrayContributions.Interact] = function(_, value)
		return string.format("Interact with [%s]", tostring(value))
	end,
	[Module.ArrayContributions.Talk] = function(_, value)
		return string.format("Talk to [%s]", tostring(value))
	end,

	[Module.DictContributions.Collect] = function(id, value)
		return string.format("Collect %s of [%s]", tostring(value), tostring(id))
	end,
	[Module.DictContributions.Subjugate] = function(id, value)
		return string.format("Subjugate %s of [%s]", tostring(value), tostring(id))
	end,
	[Module.DictContributions.StatValues] = function(id, value)
		return string.format("Increase the stat [%s] to %s", tostring(id), tostring(value))
	end,
} :: {[string]: (string, any) -> string}

--[[
	NOTES:
	- npcs need to have the ability to spawn DURING and AFTER quests.
	- npcs can start quests when talked to
	- if the REQUIREMENTS function returns false, the corrosponding string or table of strings returned is the dialogue
	- all quests are made of subquests, those subquests are step-by-step objectives
	- somehow relate the sub-quest contributions to NPCs / items / etc.
]]
Module.Quests = {

	-- // Menu test fixtures //
	-- Each subquest carries a SYNTHETIC contribution target — an ID that
	-- nothing in the world ever fires `AppendQuestContributions` for. This
	-- matters because `IsSubQuestCompletedFromUUID` returns `true` for any
	-- subquest whose Contributions table is empty (the iteration just
	-- falls through). The first time the player crosses a zone boundary
	-- after joining, `CheckPlayerQuestStates` would walk the active quests
	-- and auto-advance every empty-contribution step in one go — rewarding
	-- and removing the fixture before the menu ever renders it.
	--
	-- Using fake `Interact` targets keeps the quest "stuck" at whatever
	-- `SubQuestIndex` the seeder wrote (see `TEST_QUESTS` in
	-- GameControllerServer.OnPlayerAdded). `IsValidSubQuestContribution`
	-- gates real game events to "the ID must appear in this subquest's
	-- config", so these synthetic IDs are inert across the whole game loop.
	--
	-- Repeatable so a hot-reload + RemoveQuestOfUUID + re-seed cycle isn't
	-- bounced by CanAcquireQuestOfId's "already completed once" check.
	MenuTestQuest_A = {
		Requirements = {
			Repeatable = true,
			MinimumLevel = 1,
		},
		SubQuests = {
			CreateSubQuestData(
				{ [Module.ArrayContributions.Interact] = { '__menu_test_a_step_1__' } },
				CreateBaseDisplay('First placeholder step',  '', 'rbxassetid://-1')
			),
			CreateSubQuestData(
				{ [Module.ArrayContributions.Interact] = { '__menu_test_a_step_2__' } },
				CreateBaseDisplay('Second placeholder step', '', 'rbxassetid://-1')
			),
			CreateSubQuestData(
				{ [Module.ArrayContributions.Interact] = { '__menu_test_a_step_3__' } },
				CreateBaseDisplay('Third placeholder step',  '', 'rbxassetid://-1')
			),
			CreateSubQuestData(
				{ [Module.ArrayContributions.Interact] = { '__menu_test_a_step_4__' } },
				CreateBaseDisplay('Fourth placeholder step', '', 'rbxassetid://-1')
			),
		},
		Continuation = {},
		Rewards = {
			Currency = 100,
			Experience = 50,
			Items = {},
			Skills = {},
		},
		Display = CreateBaseDisplay(
			'Menu Test Quest A',
			'Placeholder quest used to populate the quest menu during UI development.',
			'rbxassetid://-1'
		),
	},

	MenuTestQuest_B = {
		Requirements = {
			Repeatable = true,
			MinimumLevel = 1,
		},
		SubQuests = {
			CreateSubQuestData(
				{ [Module.ArrayContributions.Interact] = { '__menu_test_b_step_1__' } },
				CreateBaseDisplay('Single placeholder step', '', 'rbxassetid://-1')
			),
		},
		Continuation = {},
		Rewards = {
			Currency = 25,
			Experience = 10,
			Items = {},
			Skills = {},
		},
		Display = CreateBaseDisplay(
			'Menu Test Quest B',
			'Second placeholder for menu testing — single-step so the step counter stays hidden.',
			'rbxassetid://-1'
		),
	},

	TestQuestLine1 = {
		-- requirements to acquire this quest
		Requirements = {
			Repeatable = false,
			MinimumLevel = 1,
		},

		-- sub-quests
		SubQuests = {
			CreateSubQuestData(
				{
					[Module.ArrayContributions.Interact] = { 'Interact1' }
				},
				CreateBaseDisplay(
					'Interact with block number 1!',
					'',
					'rbxassetid://-1'
				)
			),
			CreateSubQuestData(
				{
					[Module.DictContributions.Subjugate] = { Rig = 2 },
					[Module.ArrayContributions.Visit] = { 'RegionPart2' },
				},
				CreateBaseDisplay(
					'Subjugate 1 Rig NPCs!',
					'',
					'rbxassetid://-1'
				)
			),
			CreateSubQuestData(
				{
					[Module.ArrayContributions.Talk] = { 'Interact2' }
				},
				CreateBaseDisplay(
					'Talk to the Interact2 NPC!',
					'',
					'rbxassetid://-1'
				)
			),
			CreateSubQuestData(
				{
					[Module.ArrayContributions.Visit] = { 'RegionPart2' }
				},
				CreateBaseDisplay(
					'Visit the region: "RegionPart2"!',
					'',
					'rbxassetid://-1'
				)
			),
			CreateSubQuestData(
				{
					[Module.ArrayContributions.Interact] = { 'FinishQuest' }
				},
				CreateBaseDisplay(
					'Interact with the finish quest block!',
					'',
					'rbxassetid://-1'
				)
			),
		},

		-- automatically start the(se) quest(s) after this one completes.
		Continuation = {'TestQuestLine2'},

		-- the rewards from the quest upon completion
		Rewards = {
			Currency = 5,
			Experience = 20,

			Items = { RedPotion = 5, WoodenSword = 1 },
			Skills = { 'Roll' },
		},

		-- ui display information
		Display = CreateBaseDisplay(
			'Test Quest Line 1',
			'Complete the longer questline for a simple reward!',
			'rbxassetid://-1'
		),
	},

	TestQuestLine2 = {
		-- requirements to acquire this quest
		Requirements = {
			Repeatable = false,
			MinimumLevel = 1,
		},

		-- sub-quests
		SubQuests = {
			CreateSubQuestData(
				{
					[Module.ArrayContributions.Talk] = { 'Interact4' }
				},
				CreateBaseDisplay(
					'Talk to the Interact4 NPC!',
					'',
					'rbxassetid://-1'
				)
			)
		},

		-- automatically start the(se) quest(s) after this one completes.
		Continuation = { },

		-- the rewards from the quest upon completion
		Rewards = {
			Currency = 5,
			Experience = 0,

			Items = { RedPotion = 5 },
			Skills = { },
		},

		-- ui display information
		Display = CreateBaseDisplay(
			'Test Quest Line 2',
			'Complete the short questline for a simple reward!',
			'rbxassetid://-1'
		),
	},

	--[[TrainerMockBattle = {
		-- requirements to acquire this quest
		Requirements = {
			Repeatable = false,
			MinimumLevel = 3,
		},

		-- sub-quests
		SubQuests = {
			CreateSubQuestData(
				{
					[Module.ArrayContributions.Visit] = {'MockBattleTrainer1'}
				},
				CreateBaseDisplay(
					'Find the trainer.',
					'Find the mock battle trainer in the training grounds.',
					'rbxassetid://-1'
				)
			),
			CreateSubQuestData(
				{
					[Module.ArrayContributions.Talk] = {'MockBattleTrainer1'}
				},
				CreateBaseDisplay(
					'Ask for a mock battle.',
					'Ask the trainer in the training grounds for a mock battle.',
					'rbxassetid://-1'
				)
			),
			CreateSubQuestData(
				{
					[Module.ArrayContributions.Defeat] = {'MockBattleTrainer1'}
				},
				CreateBaseDisplay(
					'Defeat the trainer.',
					'Defeat the trainer in a mock battle.',
					'rbxassetid://-1'
				)
			),
			CreateSubQuestData(
				{
					[Module.ArrayContributions.Talk] = {'MockBattleTrainer1'}
				},
				CreateBaseDisplay(
					'Talk to the trainer.',
					'Thank the trainer for the mock battle.',
					'rbxassetid://-1'
				)
			),
		},

		-- automatically start the(se) quest(s) after this one completes.
		Continuation = { },

		-- the rewards from the quest upon completion
		Rewards = {
			Currency = 1,
			Experience = 10,

			Items = { RedPotion = 1, WoodenSword = 1 },
			Skills = { 'Roll' },
		},

		-- ui display information
		Display = CreateBaseDisplay(
			'Mock Battle with the Trainer',
			'Defeat the mock battle trainer in the training grounds.',
			'rbxassetid://-1'
		),
	},]]

} :: {[string]: QuestConfigTable}

function Module.GetConfigFromId(questId: string): QuestConfigTable?
	return Module.Quests[questId]
end

function Module.FindQuestFromUUID(quests: DataQuestContainer, uuid: string): (BaseQuestData?, string?)
	for questId, uuidDict in quests do
		if uuidDict[uuid] then
			return uuidDict[uuid], questId
		end
	end
	return nil, nil
end

function Module.CountCompletedQuestId(questId: string, playerData: BasePlayerData): number
	return playerData.CompletedQuests[questId] or 0
end

function Module.CountActiveQuestId(questId: string, playerData: BasePlayerData): number
	local activeQuest = playerData.ActiveQuests[questId]
	return activeQuest and CountDictionary(activeQuest) or 0
end

function Module.IsValidSubQuestContribution(questId: string, subQuestIndex: number, contributionType: string, contributionId: string): (boolean, string)
	local questConfig = Module.GetConfigFromId(questId)
	if not questConfig then
		return false, string.format("Could not find quest of id %s", tostring(questId))
	end

	local subQuestConfig = questConfig.SubQuests[subQuestIndex]
	if not subQuestConfig then
		return false, string.format("Invalid sub-quest index passed, %s", tostring(subQuestIndex))
	end

	local categoryData = subQuestConfig.Contributions[contributionType]
	if not categoryData then
		return false, string.format("Cannot find subquest contribution category %s", tostring(contributionType))
	end

	if #categoryData == 0 then
		-- dictionary
		local value = categoryData[contributionId]
		return value ~= nil, value and "Dict found" or "Dict non-exist"
	end
	-- array
	local value = table.find(categoryData, contributionId)
	return value ~= nil, value and "Array found" or "Array non-exist"
end

function Module.IsSubQuestCompletedFromUUID(uuid: string, playerData: BasePlayerData): (boolean, string)
	local questData, questId = Module.FindQuestFromUUID(playerData.ActiveQuests, uuid)
	if not questId then
		return false, string.format("Could not find quest given uuid %s.", uuid)
	end

	if not questData then
		return false, string.format("No such quest of id %s in player data.", questId)
	end

	local questConfig: QuestConfigTable? = Module.GetConfigFromId(questId)
	if not questConfig then
		return false, string.format("Could not find quest config of id %s", questId)
	end

	local subQuestConfig: SubQuestConfig? = questConfig.SubQuests[questData.SubQuestIndex]
	if not subQuestConfig then
		return false, string.format("quest of id %s does not have a subindex %s", questId, tostring(questData.SubQuestIndex))
	end

	for contribType, contributions in subQuestConfig.Contributions do
		if #contributions == 0 then
			-- dictionary
			for contribId, requiredAmount in contributions do
				local contribArr = questData.Contributions[contribType]
				local currentAmount = contribArr and contribArr[contribId] or 0
				if currentAmount < requiredAmount then
					return false, string.format("Missing dictionary contribution %s, has %d need %d", contribId, currentAmount, requiredAmount)
				end
			end
		end
		-- array
		for _, contribId in contributions do
			local contribArr = questData.Contributions[contribType]
			if not contribArr or not table.find(contribArr, contribId) then
				return false, string.format("Missing array contribution %s", contribId)
			end
		end
	end

	return true, "Has requirements"
end

function Module.IsQuestOfUUIDCompleted(uuid: string, playerData: BasePlayerData): (boolean, string)
	local questData, questId = Module.FindQuestFromUUID(playerData.ActiveQuests, uuid)
	if not questData then
		return false, string.format("No such quest data in player data %s", uuid)
	end

	local questConfig = Module.GetConfigFromId(questId)
	if not questConfig then
		return false, string.format('Could not find quest of id %s', tostring(questId))
	end

	return questData.SubQuestIndex > #questConfig.SubQuests, "Found"
end

function Module.CanAcquireQuestOfId(questId: string, playerData: BasePlayerData): (boolean, string)
	local questConfig = Module.GetConfigFromId(questId)
	if not questConfig then
		return false, string.format('Could not find quest of id %s', tostring(questId))
	end

	if Module.CountActiveQuestId(questId, playerData) > 0 then
		return false, string.format('You are already doing this quest %s', questId)
	end

	if questConfig.Requirements then
		if not questConfig.Requirements.Repeatable and Module.CountCompletedQuestId(questId, playerData) > 0 then
			return false, string.format('You can only do this quest once %s', questId)
		end
		if questConfig.Requirements.MinimumLevel and playerData.Level < questConfig.Requirements.MinimumLevel then
			return false, string.format('You must be level %d to take this quest of id %s.', questConfig.Requirements.MinimumLevel, questId)
		end
	end

	return true, "Taken quest"
end

function Module.IsArrayTypeContrib(contributionId: string): boolean
	-- check if its a key
	if Module.ArrayContributions[contributionId] then
		return true
	end
	-- check if its a value
	for _, value in Module.ArrayContributions do
		if value == contributionId then
			return true
		end
	end
	return false
end

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Rarities.luau"><![CDATA[
export type RarityNames =
	"Common" |
	"Uncommon" |
	"Rare" |
	"Epic" |
	"Legendary" |
	"Exclusive" |
	"Unique" |
	"Godly"

local Module = {}

Module.RarityValues = {
	'Common',
	'Uncommon',
	'Rare',
	'Epic',
	'Legendary',
	'Exclusive',
	'Unique',
	'Godly',
}

Module.RarityColors = {
	Color3.new(1, 1, 1),
	Color3.new(1, 1, 1),
	Color3.new(1, 1, 1),
	Color3.new(1, 1, 1),
	Color3.new(1, 1, 1),
	Color3.new(1, 1, 1),
	Color3.new(1, 1, 1),
	Color3.new(1, 1, 1),
}

Module.RarityEnums = {
	Common = 1,
	Uncommon = 2,
	Rare = 3,
	Epic = 4,
	Legendary = 5,
	Exclusive = 6,
	Unique = 7,
	Godly = 8
}

function Module.GetRarityData(index: number): (string, Color3)
	index = math.clamp(index, 1, #Module.RarityValues)
	return Module.RarityValues[index], Module.RarityColors[index]
end

return Module]]></Source>
