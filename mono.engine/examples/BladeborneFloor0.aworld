				Lifetime = NumberRange.new(0.7, 1.0),
				Speed = NumberRange.new(0.5, 1.5),
				SpreadAngle = Vector2.new(180, 180),
				Acceleration = Vector3.new(0, 1.4, 0),
				LightEmission = 0.7,
			},
			Light = { Color = Color3.fromRGB(235, 240, 255), Brightness = 1.4, Range = 8 },
		},
	}),

} :: { [string]: AuraConfig }

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Blueprints.luau"><![CDATA[-- // Blueprints — CLIENT-SIDE SHELL //
--
-- Authored data lives at ServerStorage/Modules/Data/Blueprints.luau.
-- This file's `Module.Blueprints` table starts EMPTY and is populated
-- at runtime by ConfigReplicationClient as the server pushes rows for
-- blueprints the player has unlocked (or, for whitelisted admins, the
-- full registry on join). The Forge widget hides un-replicated rows.
--
-- // Reading contract //
-- Callers must tolerate `Module.Blueprints[id] == nil` for blueprints
-- not yet unlocked. Treat absent ids as "not currently visible to
-- this player" — render nothing rather than erroring.
--
-- See ROADMAP.md §"Empty client shell" for the full pattern.
--
-- A Blueprint declares the per-slot structure of a craftable weapon.
-- Each slot has a `key` (matched in Composition.Forged.Parts) and a
-- player-facing `Label`. Weapon-class is implicit from `Id` for now;
-- when render-side model-swapping lands the blueprint will gain a
-- ResultingItemId pointer for the minted weapon's ItemConfig.
--
-- BLADEBORNE is a sword-only game. Ranged blueprints (bow, crossbow)
-- and magic blueprints (staff, wand) are intentionally absent — the
-- combat loop is melee + parry + dodge, not projectile or cast.

-- Per-slot grid position for the forge template visualization
-- (Tinkers-Construct-style diagonal weapon-shape preview). Uses (col, row)
-- with TOP-LEFT origin so a sword's blade sits at the top-right of the
-- grid and the handle sits at the bottom-left. Optional: when nil, the
-- ForgeWidget falls back to a simple staircase using the slot's array
-- index.
export type GridPosition = { x: number, y: number }

export type BlueprintSlot = {
	key: string,
	Label: string,
	-- Diagonal weapon-shape coordinate. Origin top-left. The whole
	-- pattern is normalized client-side so authors only need to worry
	-- about RELATIVE placement, not absolute pixel positions.
	Position: GridPosition?,
}

export type Blueprint = {
	Id: string,
	Name: string,
	Slots: { BlueprintSlot },
	-- ItemId minted by ForgeServer.AttemptForgeWeapon when this blueprint
	-- is committed (TargetItemId path). The minted item carries the per-
	-- craft Composition.Forged.StatSnapshot via PlayerInventoryServer.
	-- GiveQuantityOfItemIdToPlayer + the server's compose step.
	ResultingItemId: string,
}

local Module = {}

-- Empty at boot — populated by ConfigReplicationClient (category 'Blueprints').
Module.Blueprints = {} :: { [string]: Blueprint }

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Boosters.luau"><![CDATA[-- Boosters registry. Timed (or permanent) buffs that layer multipliers
-- and additive bonuses across the game's economy / combat / movement
-- systems. Each booster declares one or more `Effects`; servers query
-- the active stack for a given Kind via BoostersServer.GetMultiplier
-- (for *_mul kinds) or .GetAddend (for *_add kinds).
--
-- Stacking semantics (per design call):
--   * Add-kinds (walk_speed_add, crit_chance_add) always sum.
--   * Mul-kinds split by Value:
--       Buffs (Value >= 1) → SUM of values, additively.
--                            One 2× XP = 2×. Two 2× = 4×. Four 2× = 8×.
--                            (Mixed: one 2× + one 3× = 5×.)
--       Nerfs (Value <  1) → PRODUCT of values.
--                            One 0.8× damage taken = 0.8×.
--                            Two 0.8× = 0.64× (correct reduction stacking).
-- Without the split, two 0.8× damage-reduction stacks would sum to
-- 1.6× and amplify damage instead of reducing it.

-- Local SetProperties — inlined rather than required from Utility.Table
-- because data modules are loaded as part of `Modules` registration, and
-- requiring the Modules tree from inside a Data module triggers a
-- recursive-require error. Items.luau follows the same pattern.
local function SetProperties<T>(parent: T, properties: {[string]: any}?): T
	if properties then
		for k, v in properties do
			(parent :: any)[k] = v
		end
	end
	return parent
end

export type BoosterEffectKind =
	  'experience_mul'
	| 'currency_mul'
	| 'loot_quantity_mul'
	| 'loot_rarity_bias'
	| 'damage_out_mul'
	| 'damage_in_mul'
	| 'walk_speed_add'
	| 'skill_cdr_mul'
	| 'crit_chance_add'
	| 'crit_damage_mul'
	| 'attribute_xp_mul'
	| 'companion_xp_mul'
	| 'reputation_mul'
	| 'bounty_decay_mul'

export type BoosterEffect = {
	Kind  : BoosterEffectKind,
	Value : number,
}

export type BoosterStacking =
	  'add'        -- per-design default: stacks add (see header)
	| 'replace'   -- only the highest-Value stack of this id wins
	| 'unique'    -- block re-application while one is active

export type BoosterSource = 'Reward' | 'Purchase' | 'Quest' | 'Admin' | 'Achievement'

export type BoosterDisplay = {
	Name        : string,
	Description : string,
	Icon        : (string | number)?,
	Color       : Color3?,
}

export type BoosterConfig = {
	Id        : string,
	Display   : BoosterDisplay,
	-- Seconds of effect duration. 0 → permanent (until manually removed).
	Duration  : number,
	Effects   : {BoosterEffect},
	Stacking  : BoosterStacking?,
	-- Per-id stack cap. Default 5 — generous enough that players can
	-- combine event boosters with reward boosters without hitting the
	-- ceiling, but bounded so a buggy grant loop can't run away.
	MaxStacks : number?,
	Source    : BoosterSource?,
}

local function BoosterData(properties): BoosterConfig
	return SetProperties({
		Id        = 'null',
		Display   = { Name = 'Null', Description = '', Color = Color3.new(1, 1, 1) },
		Duration  = 0,
		Effects   = {},
		Stacking  = 'add',
		MaxStacks = 5,
		Source    = 'Reward',
	}, properties)
end

local Module = {}

-- // Effect kind enum — string constants so call sites do
-- BoostersConfig.Kinds.ExperienceMul rather than typo-prone literals.
Module.Kinds = {
	ExperienceMul    = 'experience_mul',
	CurrencyMul      = 'currency_mul',
	LootQuantityMul  = 'loot_quantity_mul',
	LootRarityBias   = 'loot_rarity_bias',
	DamageOutMul     = 'damage_out_mul',
	DamageInMul      = 'damage_in_mul',
	WalkSpeedAdd     = 'walk_speed_add',
	SkillCdrMul      = 'skill_cdr_mul',
	CritChanceAdd    = 'crit_chance_add',
	CritDamageMul    = 'crit_damage_mul',
	AttributeXpMul   = 'attribute_xp_mul',
	CompanionXpMul   = 'companion_xp_mul',
	ReputationMul    = 'reputation_mul',
	BountyDecayMul   = 'bounty_decay_mul',
}

-- Classification helper: callers of GetMultiplier / GetAddend pick the
-- right query function based on whether the kind is mul-style or
-- add-style. Keeps the math in one place.
Module.AddKinds = {
	[Module.Kinds.WalkSpeedAdd]   = true,
	[Module.Kinds.CritChanceAdd]  = true,
}

function Module.IsAddKind(kind: BoosterEffectKind): boolean
	return Module.AddKinds[kind] == true
end

-- // Registry. // --
-- Sample boosters cover every supported Kind so QA can sanity-check
-- each plug-point without authoring a new config.
Module.Boosters = {
	xp_2x_30m = BoosterData({
		Id      = 'xp_2x_30m',
		Display = { Name = '2× Experience (30 min)',
		            Description = 'Doubles all experience gained for 30 minutes.',
		            Color = Color3.fromRGB(255, 198, 112) },
		Duration = 30 * 60,
		Effects  = { { Kind = Module.Kinds.ExperienceMul, Value = 2 } },
	}),
	gold_2x_30m = BoosterData({
		Id      = 'gold_2x_30m',
		Display = { Name = '2× Gold (30 min)',
		            Description = 'Doubles all currency gained for 30 minutes.',
		            Color = Color3.fromRGB(255, 215, 138) },
		Duration = 30 * 60,
		Effects  = { { Kind = Module.Kinds.CurrencyMul, Value = 2 } },
	}),
	loot_drop_15m = BoosterData({
		Id      = 'loot_drop_15m',
		Display = { Name = '+50% Loot Quantity (15 min)',
		            Description = 'Drops 50% more items from kills for 15 minutes.',
		            Color = Color3.fromRGB(126, 200, 255) },
		Duration = 15 * 60,
		Effects  = { { Kind = Module.Kinds.LootQuantityMul, Value = 1.5 } },
	}),
	rare_finder_30m = BoosterData({
		Id      = 'rare_finder_30m',
		Display = { Name = 'Rarefinder (30 min)',
		            Description = 'Biases loot rolls toward higher rarities.',
		            Color = Color3.fromRGB(200, 157, 255) },
		Duration = 30 * 60,
		Effects  = { { Kind = Module.Kinds.LootRarityBias, Value = 1.25 } },
	}),
	berserker_5m = BoosterData({
		Id      = 'berserker_5m',
		Display = { Name = "Berserker's Edge (5 min)",
		            Description = '+25% outgoing damage for 5 minutes.',
		            Color = Color3.fromRGB(255, 140, 120) },
		Duration = 5 * 60,
		Effects  = { { Kind = Module.Kinds.DamageOutMul, Value = 1.25 } },
	}),
	ironskin_5m = BoosterData({
		Id      = 'ironskin_5m',
		Display = { Name = 'Ironskin (5 min)',
		            Description = '−20% incoming damage for 5 minutes.',
		            Color = Color3.fromRGB(180, 200, 220) },
		Duration = 5 * 60,
		Effects  = { { Kind = Module.Kinds.DamageInMul, Value = 0.80 } },
	}),
	swiftfoot_10m = BoosterData({
		Id      = 'swiftfoot_10m',
		Display = { Name = 'Swiftfoot (10 min)',
		            Description = '+4 walk speed for 10 minutes.',
		            Color = Color3.fromRGB(140, 240, 200) },
		Duration = 10 * 60,
		Effects  = { { Kind = Module.Kinds.WalkSpeedAdd, Value = 4 } },
	}),
	cooldown_10m = BoosterData({
		Id      = 'cooldown_10m',
		Display = { Name = 'Quickwit (10 min)',
		            Description = '−15% skill cooldowns for 10 minutes.',
		            Color = Color3.fromRGB(160, 220, 255) },
		Duration = 10 * 60,
		Effects  = { { Kind = Module.Kinds.SkillCdrMul, Value = 0.85 } },
	}),
	crit_blessing_15m = BoosterData({
		Id      = 'crit_blessing_15m',
		Display = { Name = "Crit Blessing (15 min)",
		            Description = '+10% crit chance and +25% crit damage.',
		            Color = Color3.fromRGB(255, 175, 80) },
		Duration = 15 * 60,
		Effects  = {
			{ Kind = Module.Kinds.CritChanceAdd, Value = 0.10 },
			{ Kind = Module.Kinds.CritDamageMul, Value = 1.25 },
		},
	}),
	attr_xp_2x_30m = BoosterData({
		Id      = 'attr_xp_2x_30m',
		Display = { Name = '2× Attribute XP (30 min)',
		            Description = 'Doubles attribute XP for 30 minutes.',
		            Color = Color3.fromRGB(255, 220, 160) },
		Duration = 30 * 60,
		Effects  = { { Kind = Module.Kinds.AttributeXpMul, Value = 2 } },
	}),
	companion_xp_2x_30m = BoosterData({
		Id      = 'companion_xp_2x_30m',
		Display = { Name = '2× Companion XP (30 min)',
		            Description = 'Doubles companion XP for 30 minutes.',
		            Color = Color3.fromRGB(180, 255, 200) },
		Duration = 30 * 60,
		Effects  = { { Kind = Module.Kinds.CompanionXpMul, Value = 2 } },
	}),
	rep_2x_30m = BoosterData({
		Id      = 'rep_2x_30m',
		Display = { Name = '2× Reputation (30 min)',
		            Description = 'Doubles reputation gained for 30 minutes.',
		            Color = Color3.fromRGB(255, 230, 110) },
		Duration = 30 * 60,
		Effects  = { { Kind = Module.Kinds.ReputationMul, Value = 2 } },
	}),
	bounty_cooldown_10m = BoosterData({
		Id      = 'bounty_cooldown_10m',
		Display = { Name = 'Lay Low (10 min)',
		            Description = 'Bounty decays 50% faster for 10 minutes.',
		            Color = Color3.fromRGB(220, 180, 220) },
		Duration = 10 * 60,
		Effects  = { { Kind = Module.Kinds.BountyDecayMul, Value = 1.5 } },
	}),
} :: { [string]: BoosterConfig }

-- // Standard Boosters. // --
-- Generated grid of the three most common economy buffs at two
-- magnitudes (+10% / +25%) and three durations (1m / 5m / 10m).
-- Built from a spec list so the 18 entries stay consistent; each
-- inserted value is a full BoosterData({...}) matching BoosterConfig.
do
	local stdKinds = {
		{ slug = 'exp',     kind = Module.Kinds.ExperienceMul,  noun = 'Experience',   color = Color3.fromRGB(255, 198, 112) },
		{ slug = 'gold',    kind = Module.Kinds.CurrencyMul,    noun = 'Gold',         color = Color3.fromRGB(255, 215, 138) },
		{ slug = 'attrxp',  kind = Module.Kinds.AttributeXpMul, noun = 'Attribute XP', color = Color3.fromRGB(255, 220, 160) },
	}
	local stdMagnitudes = {
		{ pct = 10, value = 1.10 },
		{ pct = 25, value = 1.25 },
	}
	local stdDurations = {
		{ tag = '1m',  label = '1 min',  seconds = 60 },
		{ tag = '5m',  label = '5 min',  seconds = 300 },
		{ tag = '10m', label = '10 min', seconds = 600 },
	}

	for _, k in stdKinds do
		for _, mag in stdMagnitudes do
			for _, dur in stdDurations do
				local id = string.format('std_%s_%d_%s', k.slug, mag.pct, dur.tag)
				Module.Boosters[id] = BoosterData({
					Id      = id,
					Display = {
						Name        = string.format('+%d%% %s (%s)', mag.pct, k.noun, dur.label),
						Description = string.format('+%d%% %s gain for %s.', mag.pct, k.noun, dur.label),
						Color       = k.color,
					},
					Duration = dur.seconds,
					Effects  = { { Kind = k.kind, Value = mag.value } },
				})
			end
		end
	end
end

function Module.GetBoosterConfig(boosterId: string): BoosterConfig?
	return Module.Boosters[boosterId]
end

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Character.luau"><![CDATA[
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')

local Module = {}

Module.Races = {
	Human = 1,
}

Module.Customizations = {
	Hair1 = ReplicatedAssets.Character.Hairs,
	Hair2 = ReplicatedAssets.Character.Hairs,
	Face = ReplicatedAssets.Character.Faces,
	Clothes = ReplicatedAssets.Character.Clothes,
}

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/CinematicPresets.luau"><![CDATA[-- CinematicPresets — named bundles of args for cue-kinds that
-- cinematic authors reach for repeatedly. Three groups:
--
--   Shake       — magnitude / roughness / duration / fades
--   CameraShot  — relative CFrame offsets for "shot composition"
--                 (over-shoulder, low-hero, wide-establishing, …)
--   VFX         — template name + duration + default anchor
--
-- Authors compose cinematics by preset *name* (e.g. 'heavy',
-- 'over_shoulder', 'slash_burst'); the builder API in
-- Services/CinematicBuilder resolves names to cue args. Keeps
-- Cinematics.luau readable + lets us re-tune one preset and have
-- every cinematic that referenced it pick up the change.
--
-- Adding a preset: drop an entry into the right table below. Use
-- ResolveShake / ResolveShot / ResolveVFX to look one up at
-- runtime; missing names log a warn and return a safe default.

local CinematicShared = require(script.Parent.Parent.Services.CinematicShared)

local Module = {}

----------------------------------------------------------------------
-- Shake presets. Magnitude / Roughness / Duration with optional
-- FadeIn / FadeOut. Tuned so 'subtle' is barely-perceptible head
-- nudge and 'earthquake' is a 1.2s cinematic-grade rumble.
----------------------------------------------------------------------
export type ShakePreset = {
	Magnitude: number,
	Roughness: number,
	Duration: number,
	FadeIn: number?,
	FadeOut: number?,
}

Module.Shakes = ({
	-- Head-nudge. Use under dialogue lines, breathing camera, etc.
	subtle    = { Magnitude = 0.08, Roughness = 6, Duration = 0.30, FadeIn = 0.05, FadeOut = 0.20 },
	-- Default per-hit weight. Combat connect feedback.
	soft      = { Magnitude = 0.20, Roughness = 5, Duration = 0.30, FadeIn = 0.04, FadeOut = 0.20 },
	medium    = { Magnitude = 0.35, Roughness = 5, Duration = 0.45, FadeIn = 0.05, FadeOut = 0.30 },
	-- Heavy hit / counter / parry land.
	heavy     = { Magnitude = 0.55, Roughness = 6, Duration = 0.50, FadeIn = 0.04, FadeOut = 0.35 },
	-- Crunchy attack-connect "hit-stop" feel.
	hit       = { Magnitude = 0.45, Roughness = 8, Duration = 0.18, FadeIn = 0.01, FadeOut = 0.10 },
	-- Finisher / boss-stagger. Bigger, slightly slower roughness.
	finisher  = { Magnitude = 0.85, Roughness = 5, Duration = 0.65, FadeIn = 0.05, FadeOut = 0.40 },
	-- Big slow rumble — explosions, environmental beats.
	explosion = { Magnitude = 1.10, Roughness = 4, Duration = 0.85, FadeIn = 0.10, FadeOut = 0.50 },
	-- Earthquake / boss spawn / world-event scale.
	earthquake = { Magnitude = 1.40, Roughness = 3, Duration = 1.20, FadeIn = 0.20, FadeOut = 0.60 },
}) :: { [string]: ShakePreset }

local DEFAULT_SHAKE: ShakePreset = Module.Shakes.medium

function Module.ResolveShake(name: string): ShakePreset
	local p = Module.Shakes[name]
	if not p then
		warn(string.format('CinematicPresets.ResolveShake: unknown shake %q (defaulting to medium)', tostring(name)))
		return DEFAULT_SHAKE
	end
	return p
end

----------------------------------------------------------------------
-- Camera shot presets. Stored as a CFrame OFFSET applied relative
-- to the subject's pivot — the builder expands these into CameraTo
-- cue args by passing them through as `Offset` on instance-anchored
-- CameraTo. Lerp time is per-preset so an "establishing" shot eases
-- in slowly while a "snap_close" cuts hard.
----------------------------------------------------------------------
export type CameraShotPreset = {
	Offset: CFrame,
	Lerp: number,
}

local function shot(offset: CFrame, lerp: number): CameraShotPreset
	return { Offset = offset, Lerp = lerp }
end

Module.CameraShots = ({
	-- Behind-shoulder, slight tilt down. Standard dialogue / quest pose.
	over_shoulder      = shot(CFrame.new(2.5, 2, 6) * CFrame.Angles(math.rad(-8), 0, 0), 0.6),
	-- Tight close-up — front-facing, eyes-level.
	closeup            = shot(CFrame.new(0, 1.5, 4),                                       0.5),
	-- Hero low-angle — looking up at the subject. Boss intros.
	low_hero           = shot(CFrame.new(0, -1, 7) * CFrame.Angles(math.rad(12), 0, 0),    0.8),
	-- Wide establishing — pulled back + slight crane-down feel.
	wide_establishing  = shot(CFrame.new(0, 8, 18) * CFrame.Angles(math.rad(-15), 0, 0),   1.2),
	-- Profile — side view, useful for two-character framings.
	profile_left       = shot(CFrame.new(-7, 1.5, 3) * CFrame.Angles(0, math.rad(70), 0),  0.7),
	profile_right      = shot(CFrame.new(7, 1.5, 3) * CFrame.Angles(0, math.rad(-70), 0),  0.7),
	-- Snap-cut close — for stingers / camera-pop on dramatic beats.
	snap_close         = shot(CFrame.new(0, 1.5, 3.5),                                     0.15),
}) :: { [string]: CameraShotPreset }

local DEFAULT_SHOT: CameraShotPreset = Module.CameraShots.over_shoulder

function Module.ResolveShot(name: string): CameraShotPreset
	local p = Module.CameraShots[name]
	if not p then
		warn(string.format('CinematicPresets.ResolveShot: unknown shot %q (defaulting to over_shoulder)', tostring(name)))
		return DEFAULT_SHOT
	end
	return p
end

----------------------------------------------------------------------
-- VFX presets. Maps a preset name to a TemplateName under
-- ReplicatedStorage.AssetsShared.VFX and a default duration. The
-- runtime VFX cue (CinematicShared.CueKind.PlayVFX) silently no-ops
-- when the template is missing, so it's safe to author presets that
-- reference assets that haven't been added to the project yet.
----------------------------------------------------------------------
export type VFXPreset = {
	Template: string,
	Duration: number,
	-- Suggested anchor mode when the preset is fired without one.
	-- 'world' positions at args.Position; 'instance' tracks args.InstancePath.
	DefaultAnchor: 'world' | 'instance',
}

Module.VFX = ({
	slash_burst   = { Template = 'SlashBurst',  Duration = 1.2, DefaultAnchor = 'instance' },
	hit_spark     = { Template = 'HitSpark',    Duration = 0.6, DefaultAnchor = 'instance' },
	dust_poof     = { Template = 'DustPoof',    Duration = 1.5, DefaultAnchor = 'world' },
	smoke_pillar  = { Template = 'SmokePillar', Duration = 4.0, DefaultAnchor = 'world' },
	rune_circle   = { Template = 'RuneCircle',  Duration = 3.0, DefaultAnchor = 'world' },
	-- Screen-attached flash — anchors at the player's HRP for a
	-- camera-relative pop. Used for thunderclap / counter cue beats.
	screen_flash  = { Template = 'ScreenFlash', Duration = 0.35, DefaultAnchor = 'world' },
}) :: { [string]: VFXPreset }

local DEFAULT_VFX: VFXPreset = { Template = '__missing__', Duration = 1.0, DefaultAnchor = 'world' }

function Module.ResolveVFX(name: string): VFXPreset
	local p = Module.VFX[name]
	if not p then
		warn(string.format('CinematicPresets.ResolveVFX: unknown vfx %q', tostring(name)))
		return DEFAULT_VFX
	end
	return p
end

----------------------------------------------------------------------
-- Listing helpers — used by the test widget + Cmdr autocomplete to
-- enumerate available presets without snooping the table directly.
----------------------------------------------------------------------
local function namesOf(t): { string }
	local names = {}
	for k in t do names[#names + 1] = k end
	table.sort(names)
	return names
end

function Module.ListShakes(): { string }    return namesOf(Module.Shakes)      end
function Module.ListShots(): { string }     return namesOf(Module.CameraShots) end
function Module.ListVFX(): { string }       return namesOf(Module.VFX)         end

-- Re-export the shared cue-kind enum so callers don't have to require
-- both modules just to read CueKind.<X> when authoring presets.
Module.CueKind = CinematicShared.CueKind

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Cinematics.luau"><![CDATA[-- Cinematic configs — schedules of cues fired client-side via CinematicEvent.
-- Each cinematic has an id, a total duration, and an ordered list of cues.
-- Authors edit this file to add new cutscenes; runtime systems reference
-- cinematics by id (e.g. Floor1 entry, boss intro, quest reward burst).
--
-- Cue kinds + arg shapes are documented in CinematicShared.CueKind. Keep
-- new kinds in sync between this file (authors) and CinematicClient
-- (renderer dispatch).

local CinematicShared  = require(script.Parent.Parent.Services.CinematicShared)
local CinematicBuilder = require(script.Parent.Parent.Services.CinematicBuilder)

export type CinematicConfig = CinematicShared.CinematicConfig

local Module = {}

-- Re-export the builder so authors can do
--   local Cinematics = require(...).Cinematics
--   local Build      = Cinematics.Builder
-- without needing two requires for what is conceptually one author
-- surface.
Module.Builder = CinematicBuilder

----------------------------------------------------------------------
-- Sample cinematics — one short demo so the system is testable
-- end-to-end without needing other system content. Real authored
-- cutscenes get appended below.
----------------------------------------------------------------------
Module.Cinematics = {

	-- Floor 1 entry teaser: pan to the floor, label, sting, return.
	floor1_entry = {
		Id = 'floor1_entry',
		Duration = 4.5,
		LockMovement = true,
		LockHUD = true,
		SkipKeyCode = Enum.KeyCode.Escape.Value,
		Cues = {
			{ At = 0.0, Kind = 'CameraTo', Args = {
				Anchor = 'world',
				Position = CFrame.new(120, 80, 240, -0.7, 0, -0.7, 0, 1, 0, 0.7, 0, -0.7),
				Lerp = 1.0,
			}},
			{ At = 0.2, Kind = 'ShowLabel', Args = {
				Title = 'Floor 1', Subtitle = 'Town of Beginnings', Anchor = 'top',
			}},
			{ At = 0.6, Kind = 'PlaySFX', Args = {
				Sound = 'rbxassetid://9114015882', Pitch = 0.7,
			}},
			{ At = 1.5, Kind = 'CameraShake', Args = {
				Magnitude = 0.4, Roughness = 4, Duration = 0.6, FadeIn = 0.1, FadeOut = 0.4,
			}},
			{ At = 3.4, Kind = 'HideLabel', Args = { Anchor = 'top' } },
			{ At = 4.0, Kind = 'CameraReset', Args = {} },
		},
	},

	-- Generic short victory sting — used after boss kills.
	boss_kill = {
		Id = 'boss_kill',
		Duration = 2.4,
		LockMovement = false,
		LockHUD = false,
		Cues = {
			{ At = 0.0, Kind = 'CameraShake', Args = {
				Magnitude = 0.6, Roughness = 5, Duration = 0.5, FadeIn = 0.05, FadeOut = 0.3,
			}},
			{ At = 0.1, Kind = 'ShowLabel', Args = {
				Title = 'VICTORY', Subtitle = 'Boss Defeated', Anchor = 'top',
			}},
			{ At = 1.8, Kind = 'HideLabel', Args = { Anchor = 'top' } },
		},
	},

} :: { [string]: CinematicConfig }

----------------------------------------------------------------------
-- Builder-authored cinematics. These all reference an instance path
-- that may not exist yet (the test NPC etc.); CinematicClient's
-- ResolveInstancePath silently no-ops on a missing path so the
-- cinematic still completes — only the camera + VFX cues that
-- needed the instance are skipped.
--
-- Convention: instance path defaults assume the test NPC is tagged
-- 'DialogueNPC' and parented somewhere reachable via the path
-- 'workspace.NPCs.TestDialogueNPC'. Authors override the path by
-- editing the cinematic body — paths are by-design hardcoded so
-- the cinematic file is self-documenting.
----------------------------------------------------------------------

-- Boss intro: orbit + heroic-low-angle + finisher shake + label.
-- Generic enough to drop into any boss spawn — substitute the
-- instance path for the boss model's HRP.
local BOSS_HRP_PATH = 'workspace.NPCs.TestDialogueNPC.HumanoidRootPart'

Module.Cinematics.boss_intro_orbit = CinematicBuilder.New('boss_intro_orbit', 5.5)
	:LockMovement(true)
	:LockHUD(true)
	:SkipKey(Enum.KeyCode.Escape)
	:OrbitAt(0.0, BOSS_HRP_PATH, { Radius = 14, Speed = 0.6, Pitch = -0.2 })
	:LabelAt(0.4, 'BOSS', 'Test Subject', 'top')
	:SFXAt(0.5, 'rbxassetid://9114015882', 0.7)
	:ShakeAt(0.6, 'medium')
	:ShotAt(3.2, 'low_hero', BOSS_HRP_PATH)
	:ShakeAt(3.2, 'finisher')
	:HideLabelAt(4.6, 'top')
	:CameraResetAt(5.0)
	:Build()

-- Dialogue intro: pulls the camera to over-shoulder, plays a soft
-- shake to "settle" the camera, then opens the dialogue widget.
-- Cinematic ends after the StartDialogue cue — the dialogue widget
-- takes input from there (cinematic itself doesn't gate it; the
-- widget closes on player choice).
Module.Cinematics.dialogue_intro = CinematicBuilder.New('dialogue_intro', 1.6)
	:LockMovement(true)
	:LockHUD(false)
	:SkipKey(Enum.KeyCode.Escape)
	:ShotAt(0.0, 'over_shoulder', BOSS_HRP_PATH)
	:ShakeAt(0.4, 'subtle')
	:DialogueAt(0.8, 'TestNPC_Greeting', BOSS_HRP_PATH)
	:CameraResetAt(1.5)
	:Build()

-- Screen flash — short stinger. Used as a "counter landed" beat.
Module.Cinematics.screen_flash = CinematicBuilder.New('screen_flash', 0.6)
	:LockMovement(false)
	:LockHUD(false)
	:ShakeAt(0.0, 'hit')
	:VFXAt(0.0, 'screen_flash')
	:CameraResetAt(0.55)
	:Build()

-- Finisher pulse — combat-grade hitstop + wide rumble + label.
-- Suited to swing-finisher landings. No HUD lock so the player can
-- still read damage indicators / health bar.
Module.Cinematics.finisher_pulse = CinematicBuilder.New('finisher_pulse', 1.0)
	:LockMovement(false)
	:LockHUD(false)
	:ShakeAt(0.0, 'finisher')
	:VFXAt(0.05, 'hit_spark')
	:LabelAt(0.0, 'FINISHER', nil, 'top')
	:HideLabelAt(0.9, 'top')
	:Build()

-- Establishing shot — slow pan to a wide composition over the
-- subject. Designed for environmental beats (region entry, quest
-- objective reveal). Keeps the HUD up for context.
Module.Cinematics.establishing = CinematicBuilder.New('establishing', 4.0)
	:LockMovement(true)
	:LockHUD(false)
	:SkipKey(Enum.KeyCode.Escape)
	:ShotAt(0.0, 'wide_establishing', BOSS_HRP_PATH)
	:LabelAt(0.6, 'Test Region', 'A subtitle here', 'top')
	:ShakeAt(2.5, 'subtle')
	:HideLabelAt(3.4, 'top')
	:CameraResetAt(3.8)
	:Build()

-- // Game Intro // — fired once on a player's FIRST spawn by
-- GameIntroServer.PlayIntroFor. Single combined cinematic (vs the
-- three sub-cinematics the original planning stub described) so skip
-- handling is one ESC press, not three. The label beats sketch the
-- trapped-in-game premise; replace Subtitle strings as final copy locks in.
local SPAWN_PATH = 'workspace.NPCs.Tutor.HumanoidRootPart'

Module.Cinematics.intro_full = CinematicBuilder.New('intro_full', 12.0)
	:LockMovement(true)
	:LockHUD(true)
	:SkipKey(Enum.KeyCode.Escape)
	-- Beat 1 — logo / title (~3s).
	:LabelAt(0.0, 'BLADEBORNE', '\u{2014} a hundred floors stand between you and home \u{2014}', 'top')
	:ShakeAt(0.4, 'subtle')
	:HideLabelAt(2.8, 'top')
	-- Beat 2 — wide establishing shot of the spawn town (~4s).
	:ShotAt(3.0, 'wide_establishing', SPAWN_PATH)
	:LabelAt(3.4, 'Floor 1', 'Town of Beginnings', 'top')
	:ShakeAt(3.6, 'soft')
	:HideLabelAt(6.6, 'top')
	-- Beat 3 — close in on the Tutor (~3s).
	:ShotAt(7.0, 'over_shoulder', SPAWN_PATH)
	:LabelAt(7.5, 'A figure approaches\u{2026}', nil, 'bottom')
	:ShakeAt(7.8, 'subtle')
	:HideLabelAt(10.5, 'bottom')
	-- Beat 4 — release control to the player.
	:CameraResetAt(11.5)
	:Build()

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/CombatActions.luau"><![CDATA[-- CombatActions — shared combat action constants and intent payload types.
--
-- This is the whole CombatEvent wire contract. Every combat message, in
-- both directions, uses one of the named discriminators below plus a
-- single table payload.
--
-- The previous numeric enum and its positional-argument payloads are
-- gone. That shape had two problems worth recording so they are not
-- reintroduced: argument order was load-bearing across two files (a
-- thirteen-argument FireServer whose slots were documented only in a
-- comment), and it carried client-measured animation timings that the
-- server read and then ignored — a field that looked authoritative,
-- was not, and invited someone to start trusting it.

local Module = {}

Module.Version = 2

Module.Actions = {
	-- Client -> Server. Every request carries a CommandId so replies can
	-- be correlated and replayed commands rejected.
	RequestLightAttack = 'RequestLightAttack',
	RequestHeavyAttack = 'RequestHeavyAttack',
	RequestSkill = 'RequestSkill',
	RequestDodge = 'RequestDodge',
	RequestGuardStart = 'RequestGuardStart',
	RequestGuardEnd = 'RequestGuardEnd',
	RequestWeaponToggle = 'RequestWeaponToggle',
	RequestDroneFire = 'RequestDroneFire',
	RequestDroneProgram = 'RequestDroneProgram',

	-- Server -> owning client.
	ActionAccepted = 'ActionAccepted',
	ActionRejected = 'ActionRejected',
	PerfectDodge = 'PerfectDodge',

	-- Server -> all clients. Cosmetic and reconciliation cues only; none
	-- of these carry authority, and a client that drops every one of
	-- them still experiences correct gameplay.
	ActionStarted = 'ActionStarted',
	ActionCancelled = 'ActionCancelled',
	HitConfirmed = 'HitConfirmed',
	StatusApplied = 'StatusApplied',
	StateChanged = 'StateChanged',
	GuardBlocked = 'GuardBlocked',
	GuardBroken = 'GuardBroken',
	WeaponToggled = 'WeaponToggled',
}

Module.InputKinds = {
	Light = 'L',
	Heavy = 'H',
	Dodge = 'Dodge',
	Skill = 'Skill',
	Drone = 'Drone',
}

Module.Contexts = {
	Ground = 'Ground',
	Air = 'Air',
	DodgeCounter = 'DodgeCounter',
	Dash = 'Dash',
}

export type CombatAction =
	'RequestLightAttack'
	| 'RequestHeavyAttack'
	| 'RequestSkill'
	| 'RequestDodge'
	| 'RequestGuardStart'
	| 'RequestGuardEnd'
	| 'RequestWeaponToggle'
	| 'RequestDroneFire'
	| 'RequestDroneProgram'
	| 'ActionAccepted'
	| 'ActionRejected'
	| 'ActionStarted'
	| 'ActionCancelled'
	| 'HitConfirmed'
	| 'StatusApplied'
	| 'StateChanged'
	| 'PerfectDodge'
	| 'GuardBlocked'
	| 'GuardBroken'
	| 'WeaponToggled'

export type CombatInputKind = 'L' | 'H' | 'Dodge' | 'Skill' | 'Drone'
export type CombatContext = 'Ground' | 'Air' | 'DodgeCounter' | 'Dash'

-- The client -> server payload. Every field is a HINT except CommandId
-- and the action discriminator itself: the server re-derives the weapon
-- class, the combo context, the real chain, the target and every timing
-- from its own state.
--
-- Note what is absent and must stay absent: no damage, no hit list, no
-- active/recovery durations, no status application, no resulting
-- position for anyone. If a field like that ever appears here, the
-- server has started trusting the client.
export type CombatIntent = {
	CommandId: number,
	InputKind: CombatInputKind?,
	-- The chain the client BELIEVES it is on. Compared against the
	-- server's tracked chain; a mismatch downgrades the swing rather
	-- than rejecting it, so honest desync is survivable.
	ComboKey: string?,
	SkillId: string?,
	ClientTime: number?,
	Origin: Vector3?,
	Look: Vector3?,
	Direction: Vector3?,
	AimPoint: Vector3?,
	TargetInstance: Instance?,
}

export type CombatStartResult = {
	Accepted: boolean,
	Reason: string,
	ServerActionId: string?,
	ServerTime: number,
	MoveId: string?,
	StateUntil: number?,
}

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/CombatConfig.luau"><![CDATA[
-- // Module // --
local Module = {}

Module.CombatConfig = {
	ATTACK_DURATION = 0.6, -- how many seconds to allow hits to register
	CUTOFF_TIME = 0.6, -- how many seconds max inbetween each press for combo (if over the time, starts cooldown period)
	MAX_DISTANCE_CUTOFF = 9,
	Damage = 10,

	BLOCK_MAX_HITS = 5,
	BLOCK_COOLDOWN = 1.5,
	-- Short post-block delay BEFORE the player can attack again. The
	-- block cooldown still runs for the full BLOCK_COOLDOWN seconds —
	-- you can't re-block until that drains — but attacks free up much
	-- sooner (0.1 s) so a block-cancel into a swing feels responsive.
	-- Tuned so a player who block-cancels gets a frame of swing-window
	-- rather than the full re-block lockout the old "shared cooldown"
	-- model imposed.
	BLOCK_TO_ATTACK_DELAY = 0.1,
	-- WalkSpeed (studs/sec) applied to the character while blocking.
	-- Default is 16; we drop to 8 so the player can reposition mid-
	-- block but can't kite an enemy by holding F + WASD. Restored
	-- to the cached pre-block value on EndCharacterBlock.
	BLOCK_WALK_SPEED = 8,

	ROLL_COOLDOWN = 3,
	ROLL_DISTANCE = 25,
	ROLL_DURATION = 0.35,

	-- Dodge — Nier-style short evade with i-frame window. Distinct from
	-- ROLL_* so future systems can split the two (roll = dedicated
	-- traversal mechanic, dodge = combat evade).
	DODGE_COOLDOWN = 1.2,            -- seconds between dodges
	DODGE_DURATION = 0.35,           -- total locomotion override window
	DODGE_IFRAME_WINDOW = 0.25,      -- i-frame portion of the window
	DODGE_DISTANCE = 14,             -- studs covered

	-- Combo system. See NIER_COMBAT.md for the design + CombatMovesets.luau
	-- for the registry.
	--
	-- COMBO_BUFFER is the heart of the chain feel: an input arriving this
	-- many seconds BEFORE a move's cancel point is queued and replayed at
	-- the cancel point instead of being dropped. Without it, a player
	-- mashing at the natural rhythm loses roughly one press in three,
	-- which reads as the game ignoring input.
	COMBO_BUFFER       = 0.18,       -- input-buffer window ahead of a cancel point (s)
	COMBO_MAX_LENGTH   = 4,          -- inputs in a chain before forced reset
	-- Input-to-input window before the chain resets to a fresh single
	-- letter. Must exceed the slowest authored move's total duration or
	-- heavy classes could never reach their own second step.
	COMBO_RESET_WINDOW = 1.5,

	-- Perfect dodge counter. PERFECT_DODGE_WINDOW is the overlap window
	-- between a player's dodge and a nearby enemy's active swing/attacking
	-- state — within this many seconds = perfect dodge. The COUNTER_WINDOW
	-- is how long the bonus state persists; COUNTER_DAMAGE_MULT is the
	-- multiplier applied to the player's next swing(s) during the window.
	PERFECT_DODGE_WINDOW = 0.10,
	COUNTER_WINDOW       = 1.5,
	COUNTER_DAMAGE_MULT  = 1.5,
	-- Search radius for "is there an enemy currently swinging at me?"
	-- when resolving perfect dodge. Studs.
	PERFECT_DODGE_DETECT_RADIUS = 12,

	ATTACK_TRACK_RADIUS = 16,        -- semi-auto target search radius on attack input
	ATTACK_TRACK_CONE_DOT = 0.15,    -- forward cone; locked targets bypass this
	ATTACK_TRACK_CLOSE_RANGE = 5,    -- close targets can be slightly off-axis

	-- Air juggle. The first slice is intentionally simple: later combo-chain
	-- hits and heavy inputs lift PvE targets, and the attacker follows upward a
	-- little so the chain keeps contact.
	AIR_JUGGLE_START_CHAIN = 5,
	AIR_JUGGLE_LIFT = 8,
	AIR_JUGGLE_HEAVY_LIFT = 12,
	AIR_JUGGLE_DURATION = 0.18,
	AIR_JUGGLE_STATE_DURATION = 0.75,
	AIR_JUGGLE_HOVER_DURATION = 0.55,
	AIR_JUGGLE_AIR_HIT_HOVER_DURATION = 0.65,
	AIR_JUGGLE_ATTACKER_FOLLOW = 0.45,
	AIR_JUGGLE_ATTACKER_MAX_LIFT = 5,
	AIR_JUGGLE_SLAM_CHAIN = 10,
	AIR_JUGGLE_SLAM_VELOCITY = 38,
	AIR_JUGGLE_SLAM_DURATION = 0.28,
	AIR_JUGGLE_SLAM_LOCKOUT = 2,
	AIR_JUGGLE_SLAM_ATTACK_COOLDOWN = 2,

	-- Pod-style companion auto-attack (Stage F). Interval between pulses
	-- and per-shot damage scalar. Damage formula:
	--   shotDamage = companion.Level * POD_DAMAGE_PER_LEVEL
	-- which gives small per-shot but meaningful DPS over a long fight.
	POD_ATTACK_INTERVAL    = 0.3,
	POD_ATTACK_RANGE       = 8,   -- studs; melee-radius pod, not a sniper
	POD_DAMAGE_PER_LEVEL   = 2,

	-- PvP scalars. Multiplied / capped against PvE values when a swing
	-- resolves between two players. See NIER_COMBAT.md.
	PvP_COMBO_CAP          = 2,         -- max chain length in PvP
	PvP_FINISHER_ENABLED   = false,     -- finishers disabled in PvP
	PvP_RESONANCE_MULT     = 0.5,       -- gem resonance halved
	PvP_COUNTER_MULT       = 1.25,      -- perfect-dodge counter scalar in PvP
	PvP_AIR_JUGGLE_MULT    = 0.35,      -- PvP CC movement is shorter/capped
	PvP_MAX_JUGGLE         = 1,         -- air hits allowed against a player

	----------------------------------------------------------------
	-- Poise / stagger.
	--
	-- Poise decouples "did this hit land" from "did this hit stagger".
	-- Without it every connect hard-stuns, which is what made trading
	-- with a mob a stun-lock in either direction. A combatant absorbs
	-- PoiseDamage until the pool empties, staggers once, then the pool
	-- regenerates after POISE_REGEN_DELAY of not being hit.
	--
	-- Archetype defaults are applied by CombatStateServer from the
	-- model's `PoiseArchetype` attribute; mobs can override with an
	-- explicit `MaxPoise` attribute.
	----------------------------------------------------------------
	POISE_REGEN_DELAY      = 2.0,   -- seconds without a hit before regen starts
	POISE_REGEN_RATE       = 30,    -- poise per second once regen begins
	POISE_ARCHETYPES = {
		-- MaxPoise, stagger duration on break, whether launch is allowed
		Fodder = { MaxPoise = 25,  StaggerDuration = 0.55, Launchable = true,  MaxJuggle = 3 },
		Medium = { MaxPoise = 60,  StaggerDuration = 0.45, Launchable = true,  MaxJuggle = 2 },
		Elite  = { MaxPoise = 140, StaggerDuration = 0.35, Launchable = false, MaxJuggle = 0 },
		Boss   = { MaxPoise = 320, StaggerDuration = 0.30, Launchable = false, MaxJuggle = 0 },
		Player = { MaxPoise = 90,  StaggerDuration = 0.30, Launchable = true,  MaxJuggle = 1 },
	},
	POISE_DEFAULT_ARCHETYPE = 'Fodder',

	----------------------------------------------------------------
	-- Attack motion: nothing is displaced horizontally, by anyone.
	--
	-- Attacks do not close distance and hits do not push their victim
	-- back, so there is no step-in tuning and no knockback tuning here
	-- any more. A swing turns the caster toward its target and plays on
	-- the spot; the victim keeps its footing and its position. A class's
	-- ability to reach an enemy is entirely CombatMovesets `Reach` +
	-- `HitboxSize`, and covering ground is the player's job.
	--
	-- The forced motion that remains is vertical (launch / hover /
	-- air-follow / slam, tuned below). Keeping the horizontal plane empty
	-- is what makes the vertical work authorable: a launcher describes a
	-- lift and nothing else is competing for the same body.
	----------------------------------------------------------------
	-- WalkSpeed applied to the attacker for the length of their own
	-- swing. NOT zero: the character is never frozen in place. Attacking
	-- commits you to a direction and slows you to a shuffle, but you keep
	-- enough control to adjust a step, which is what stops a committed
	-- swing feeling like a cutscene.
	--
	-- Restored to the speed cached before the swing, not to a hardcoded
	-- 16 — a mount, a booster or a debuff may own the real value.
	ATTACK_WALK_SPEED = 5,
	-- How fast the attacker turns toward the target when a swing starts,
	-- as an exponential rate (higher = snappier). Applied client-side
	-- over the wind-up; see CombatMotionClient.
	ATTACK_TURN_RATE = 14,

	----------------------------------------------------------------
	-- Poise-break and crowd-control durations, split PvE / PvP.
	-- PvP values sit at the 35-50% band NIER_COMBAT.md specifies.
	----------------------------------------------------------------
	STAGGER_PVP_SCALE       = 0.45,
	KNOCKDOWN_DURATION      = 0.9,
	KNOCKDOWN_PVP_DURATION  = 0.5,
	-- Getup invulnerability after a hard knockdown. Without this a
	-- knockdown into a fresh launcher is an infinite loop.
	GETUP_IFRAMES           = 0.9,
	GETUP_IFRAMES_PVP       = 1.1,

	----------------------------------------------------------------
	-- Juggle decay. Each successive air hit lifts less than the last,
	-- so a juggle terminates on its own even before the count cap.
	----------------------------------------------------------------
	AIR_JUGGLE_DECAY        = 0.7,
	-- Maximum drift the attacker's air-follow will cover chasing a
	-- juggled victim horizontally.
	AIR_FOLLOW_MAX_DRIFT    = 12,

	----------------------------------------------------------------
	-- Perfect evade. The window is now measured against real server
	-- hitbox activity rather than a proximity scan: a dodge counts as
	-- perfect when its i-frames overlap an active enemy hitbox that
	-- would otherwise have connected.
	----------------------------------------------------------------
	PERFECT_DODGE_OVERLAP_GRACE = 0.12, -- extra leniency around the active window (s)

	----------------------------------------------------------------
	-- Server-side remote budget. Per-action minimum intervals plus a
	-- stricter allowance for malformed payloads, per NIER_COMBAT.md's
	-- anti-exploit section.
	----------------------------------------------------------------
	RATE_MIN_ATTACK_INTERVAL = 0.04,
	RATE_MIN_DODGE_INTERVAL  = 0.12,
	RATE_MIN_GUARD_INTERVAL  = 0.10,
	RATE_MALFORMED_BUDGET    = 12,   -- malformed payloads before denial logging escalates
	RATE_MALFORMED_WINDOW    = 10,   -- rolling window for the above (s)

	-- Maximum drift between the client's reported origin and the server's
	-- own view of the character before the hint is discarded.
	MAX_ORIGIN_DRIFT = 5,
}

Module.StunDurations = {
	NPC = 0.8,
	Player = 0.4,
	LastComboHit = 0.8,
	BlockBreak = 1.4,
}

-- default animations if none specified per-weapon
Module.Defaults = {
	Stunned = 'rbxassetid://111802956280579',
	KnockedDown = 'rbxassetid://122191447461183',

	ToSheatheLeft = 'rbxassetid://99815494080346', -- unequip
	UnSheatheLeft = 'rbxassetid://140385807835124', -- equip

	ToSheatheRight = 'rbxassetid://122699356986057', -- unequip
	UnSheatheRight = 'rbxassetid://107077981323776', -- equip

	Blocking = 'rbxassetid://111658160229445',
	BlockBreak = 'rbxassetid://140386892607780',
}

-- SFX for weapon draw/sheathe. `Volume` is the *base* config volume; the
-- effective playback volume is `Volume × SettingsRegistry.SFXVolume ×
-- SettingsRegistry.MasterVolume` (applied inside playCombatSFX so the
-- user's audio sliders take effect).
--
-- `SoundId` is resolved by SoundService.ResolveSoundToInstance, which
-- accepts: an `rbxassetid://N` URI (creates a fresh Sound), a direct
-- child name in AssetsShared.Sounds, or a slash-separated nested path
-- (e.g. 'Game/sheathe' → AssetsShared.Sounds.Game.sheathe). Path lookup
-- preserves any spatial properties (RollOff, MaxDistance, etc.) authored
-- on the source Sound instance.
Module.SoundEffects = {
	UnSheathe = { SoundId = 'Game/unsheathe', Volume = 0.5 },
	ToSheathe = { SoundId = 'Game/sheathe',   Volume = 0.5 },
	Block     = { SoundId = 'rbxassetid://4773909987', Volume = 0.6 },
}

-- Per-weapon-class animation registry. Each class declares its own
-- slots so the look matches the per-class move timings in
-- CombatMovesets.luau. The legacy LeftHand/RightHand/DualHand arrays
-- remain as a per-class fallback for lookups when a per-key slot is
-- missing.
--
-- IMPORTANT: this registry is COSMETIC. Nothing here participates in
-- gameplay timing, hit detection or state. A class with no entry, an
-- unresolvable asset id, or an animation that never finishes loading
-- produces a silent visual gap and a fully functional swing. See
-- CombatAnimationClient for the nil-safe resolution layer.
--
-- Asset IDs default to the existing light-attack asset until designers
-- author per-class mocaps. Each class points at its own copy so
-- swapping in new IDs per class is a single-file edit.
local _DEFAULT_LIGHT = 'rbxassetid://130197342886283'
local function classDefaults(): { [string]: any }
	-- Build a fresh table per class so editing one class's slots
	-- doesn't accidentally mutate another's registry. (Lua tables
	-- are passed by reference; sharing a single seed table would
	-- couple the classes.)
	return {
		LeftHand  = { _DEFAULT_LIGHT },
		RightHand = { _DEFAULT_LIGHT },
		DualHand  = { _DEFAULT_LIGHT },

		-- Ground chain. These four are the light string and they are what
		-- a player sees most, so they are the ones most worth making
		-- distinct — the character no longer travels during a swing, so
		-- the animation is now the ONLY thing distinguishing hit 1 from
		-- hit 3. Any root motion baked into the clip is welcome here:
		-- nothing else is driving the character horizontally to fight it.
		L1     = _DEFAULT_LIGHT, -- opener
		L2     = _DEFAULT_LIGHT, -- second, ideally mirrored from L1
		L3     = _DEFAULT_LIGHT, -- third
		L_FIN  = _DEFAULT_LIGHT, -- light finisher, biggest of the four
		H1     = _DEFAULT_LIGHT, -- heavy; sell the weight in the clip
		H2     = _DEFAULT_LIGHT, -- heavy follow-up

		-- Vertical. These two are the uprise/slam pair, and they are the
		-- reason the horizontal axis was cleared: the character is being
		-- moved straight up (H_LAUNCH) or straight down (A_SLAM) by
		-- CombatMotionServer while these play, so an upward-swinging clip
		-- and a downward-spiking clip now read exactly as intended
		-- instead of being smeared sideways by a step-in.
		H_LAUNCH = _DEFAULT_LIGHT, -- ground launcher: swing UP
		A_SLAM   = _DEFAULT_LIGHT, -- air finisher: spike DOWN

		-- Air chain (Context = Air). Plays while hovering.
		A_L1   = _DEFAULT_LIGHT,

		-- Perfect-evade counter (Context = DodgeCounter).
		C_L1   = _DEFAULT_LIGHT,
		C_H1   = _DEFAULT_LIGHT,
	}
end

Module.AttackSets = {
	-- Generic fallback used by the animation loader when the active
	-- class's set is missing entirely. Empty arrays so the legacy
	-- round-robin returns nil and pickAnimByEntry falls back cleanly.
	Default = {
		LeftHand = {},
		RightHand = {},
		DualHand = {},
	},

	-- Per-class sets. Class names match CombatMovesets.Classes keys.
	Sword       = classDefaults(),
	Longsword   = classDefaults(),
	Greatsword  = classDefaults(),
	Dagger      = classDefaults(),
	DualDagger  = classDefaults(),
	Spear       = classDefaults(),
	Mace        = classDefaults(),
	Hammer      = classDefaults(),
}

Module.AnimationSets = {

	-- DEFAULT
	Default = {
		Stunned = Module.Defaults.Stunned,
		KnockedDown = Module.Defaults.KnockedDown,

		ToSheatheLeft = Module.Defaults.ToSheatheLeft,
		UnSheatheLeft = Module.Defaults.UnSheatheLeft,

		ToSheatheRight= Module.Defaults.ToSheatheRight,
		UnSheatheRight= Module.Defaults.UnSheatheRight,

		Blocking = Module.Defaults.Blocking,
		BlockBroken = Module.Defaults.BlockBreak,

		Attacking = Module.AttackSets.Default, -- attack for both single and dual wield
	},

	-- SWORD
	Sword = {
		Stunned = Module.Defaults.Stunned,
		KnockedDown = Module.Defaults.KnockedDown,

		ToSheatheLeft = Module.Defaults.ToSheatheLeft,
		UnSheatheLeft = Module.Defaults.UnSheatheLeft,

		ToSheatheRight= Module.Defaults.ToSheatheRight,
		UnSheatheRight= Module.Defaults.UnSheatheRight,

		Blocking = Module.Defaults.Blocking,
		BlockBroken = Module.Defaults.BlockBreak,

		Attacking = Module.AttackSets.Sword, -- attack for both single and dual wield
	},
}

--[[

	Dual Wield
	- Daggers

	One Handed (right)
	- Shortsword
	- Longsword
	- Mace
	- Hammer
	- Waraxe
]]

Module.Emotes = {
	Sleep = 'rbxassetid://-1',
}

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/CombatFactions.luau"><![CDATA[-- CombatFactions — shared faction and target-filter rules for combat.
--
-- This is a small pure contract around tags/attributes. Server runtimes use
-- it before damage/status/motion so players, NPCs, and future companions do
-- not each re-invent hostile-target checks.

local CollectionService = game:GetService('CollectionService')
local Players = game:GetService('Players')

local Module = {}

Module.Version = 1

Module.Tags = {
	PlayerCharacter = 'PLAYER_CHARACTER',
	AICharacter = 'AICharacter',
}

Module.Attributes = {
	FactionId = 'CombatFactionId',
	LegacyFactionId = 'FactionId',
	AllowFriendlyFire = 'AllowFriendlyFire',
	-- Explicit "never a valid combat target" marker. Needed because an
	-- UNREGISTERED model is now hittable (see CanHit); protection has to
	-- be declared rather than inferred from the absence of a tag.
	NoCombatTarget = 'NoCombatTarget',
}

Module.Factions = {
	Players = 'Players',
	NPCs = 'NPCs',
	Neutral = 'Neutral',
}

Module.TargetModes = {
	Hostiles = 'hostiles',
	All = 'all',
	Self = 'self',
	Players = 'players',
	NPCs = 'npcs',
}

export type CombatTargetMode = 'hostiles' | 'all' | 'self' | 'players' | 'npcs'

export type HitContext = {
	TargetMode: CombatTargetMode?,
	AllowSelf: boolean?,
	AllowFriendlyFire: boolean?,
}

local function getStringAttribute(instance: Instance, attributeName: string): string?
	local value = instance:GetAttribute(attributeName)
	if typeof(value) == 'string' and #value > 0 then
		return value
	end
	return nil
end

-- True when the model actually DECLARES a faction, as opposed to falling
-- through to the Neutral default. GetFactionId cannot express the
-- difference on its own, and the difference is load-bearing: a declared
-- Neutral is a protected bystander, an undeclared one is just unknown.
local function hasExplicitFaction(model: Instance): boolean
	return getStringAttribute(model, Module.Attributes.FactionId) ~= nil
		or getStringAttribute(model, Module.Attributes.LegacyFactionId) ~= nil
end

-- A player's character is a combatant whether or not the tag has landed.
--
-- The PLAYER_CHARACTER tag is written by GameControllerServer only AFTER
-- its `while (not Data)` save-load wait resolves, and is stripped again
-- on death. Every hit now runs through CanHit, which fails closed on
-- IsCombatant — so keying combat identity solely on that tag makes a
-- player's swings land on nothing during the window before it appears.
-- Players:GetPlayerFromCharacter is true the instant the character
-- exists, on both client and server, so it is the reliable signal and
-- the tag is the fallback (rigs that mimic a player without a Player).
function Module.IsPlayerCombatant(model: Instance?): boolean
	if model == nil then
		return false
	end
	if Players:GetPlayerFromCharacter(model) ~= nil then
		return true
	end
	return CollectionService:HasTag(model, Module.Tags.PlayerCharacter)
end

function Module.IsNpcCombatant(model: Instance?): boolean
	return model ~= nil and CollectionService:HasTag(model, Module.Tags.AICharacter)
end

function Module.IsCombatant(model: Instance?): boolean
	return Module.IsPlayerCombatant(model) or Module.IsNpcCombatant(model)
end

function Module.GetFactionId(model: Instance?): string
	if not model then
		return Module.Factions.Neutral
	end

	local explicitFaction = getStringAttribute(model, Module.Attributes.FactionId)
		or getStringAttribute(model, Module.Attributes.LegacyFactionId)
	if explicitFaction then
		return explicitFaction
	end

	if Module.IsPlayerCombatant(model) then
		return Module.Factions.Players
	end

	-- NPCs default to a shared faction. Set CombatFactionId/FactionId on
	-- a model or Mobs config when two NPC groups should fight each other.
	if Module.IsNpcCombatant(model) then
		return Module.Factions.NPCs
	end

	return Module.Factions.Neutral
end

function Module.GetCandidateTagsForTargetMode(caster: Instance?, targetMode: CombatTargetMode?): { string }
	if targetMode == Module.TargetModes.Self then
		return {}
	end
	if targetMode == Module.TargetModes.Players then
		return { Module.Tags.PlayerCharacter }
	end
	if targetMode == Module.TargetModes.NPCs then
		return { Module.Tags.AICharacter }
	end
	if targetMode == Module.TargetModes.All then
		return { Module.Tags.PlayerCharacter, Module.Tags.AICharacter }
	end

	-- Hostiles: players can hit NPCs by default; NPCs can hit players and
	-- other NPCs, with same-faction filtering handled by CanHit.
	if Module.IsPlayerCombatant(caster) then
		return { Module.Tags.AICharacter, Module.Tags.PlayerCharacter }
	end
	return { Module.Tags.PlayerCharacter, Module.Tags.AICharacter }
end

function Module.CanHit(attacker: Instance?, target: Instance?, context: HitContext?): (boolean, string)
	if not attacker or not target then
		return false, 'MissingCombatant'
	end
	-- The ATTACKER must be a registered combatant. This one stays strict:
	-- it is what stops an arbitrary rig from becoming a damage source.
	if not Module.IsCombatant(attacker) then
		return false, 'AttackerNotCombatant'
	end

	-- The TARGET deliberately does NOT have to be registered.
	--
	-- Requiring it made every unregistered humanoid an invulnerable prop:
	-- a Studio rig, a freshly cloned NPC that has not reached
	-- EnemyServer.InitializeMob yet, anything authored ahead of code. The
	-- liveness check below ("does it have a Humanoid with health") is the
	-- real question; registration decides which RULES apply, not whether
	-- the thing exists. Protection is opt-in via NoCombatTarget or an
	-- explicit Neutral faction, both handled further down.

	context = context or {}
	local targetMode = context.TargetMode
	if attacker == target then
		if context.AllowSelf or targetMode == Module.TargetModes.Self then
			return true, ''
		end
		return false, 'SelfTarget'
	end

	local humanoid = target:FindFirstChildOfClass('Humanoid')
	if not humanoid or humanoid.Health <= 0 then
		return false, 'TargetDead'
	end

	-- Explicit opt-out for scenery characters, cutscene actors and quest
	-- givers that must never be swingable.
	if target:GetAttribute(Module.Attributes.NoCombatTarget) == true then
		return false, 'TargetProtected'
	end

	if targetMode == Module.TargetModes.Players and not Module.IsPlayerCombatant(target) then
		return false, 'TargetNotPlayer'
	end
	if targetMode == Module.TargetModes.NPCs and not Module.IsNpcCombatant(target) then
		return false, 'TargetNotNpc'
	end

	if context.AllowFriendlyFire
		or targetMode == Module.TargetModes.All
		or target:GetAttribute(Module.Attributes.AllowFriendlyFire) == true then
		return true, ''
	end

	local attackerFaction = Module.GetFactionId(attacker)
	local targetFaction = Module.GetFactionId(target)

	if attackerFaction == targetFaction then
		return false, 'SameFaction'
	end
	-- A DECLARED Neutral is a protected bystander. An undeclared one is
	-- just an unregistered model, and blocking those is what made plain
	-- rigs unkillable — so only the declaration protects.
	if targetFaction == Module.Factions.Neutral and hasExplicitFaction(target) then
		return false, 'NeutralFaction'
	end
	-- An attacker with no faction of its own cannot be hostile to
	-- anything; it has nothing to be hostile relative to.
	if attackerFaction == Module.Factions.Neutral then
		return false, 'NeutralFaction'
	end

	return true, ''
end

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/CombatMovesets.luau"><![CDATA[-- // CombatMovesets.luau //
-- Single authority for standard-attack move recipes. Replaces the old
-- CombatCombos.luau registry and absorbs its per-class tuning.
--
-- See NIER_COMBAT.md for the design.
--
-- A "move" is everything the server needs to run one swing WITHOUT
-- consulting an animation:
--
--   * timings      Windup / Active / Recovery, in seconds
--   * cancel       when the move may be interrupted, per input kind
--   * hitboxes     server-space boxes with their own active sub-windows
--   * damage       DamageMult + PoiseDamage
--   * motion       whether the CASTER holds altitude (air chains only;
--                  attacks never move the caster horizontally)
--   * on-hit       launch / slam applied to the VICTIM (never a
--                  horizontal shove — see CombatMotionServer)
--
-- `Anim` is a cosmetic slot name only. Nothing in this file's gameplay
-- contract depends on an animation existing, loading, or reporting a
-- length. If every AttackSet asset id were deleted, combat would still
-- swing, hit, launch and slam on exactly these numbers.
--
-- Lookup shape (see CombosShared for the resolver):
--     class   = ResolveActiveClass(lightClass, heavyClass)
--     context = Ground | Air | DodgeCounter        -- caster state
--     key     = 'L' | 'LL' | 'LLL' | 'LLLL' | 'H' | 'LH' | 'LLH' | ...
--     move    = CombatMovesets.ResolveMove(class, context, key)
--
-- Classes only need to author their Ground chain. Air and DodgeCounter
-- entries are DERIVED from the class profile when unauthored, so adding
-- a new weapon class never requires filling a 3-context matrix by hand.

local Module = {}

Module.Version = 1

-- Class used when an item declares no `WeaponClass` in its EquipmentData.
Module.DefaultClass = 'Sword'

----------------------------------------------------------------------
-- Contexts. The caster's situation at the moment the input resolves,
-- picked server-side from authoritative state (never from the client).
----------------------------------------------------------------------
Module.Contexts = {
	Ground = 'Ground',
	Air = 'Air',
	DodgeCounter = 'DodgeCounter',
}

----------------------------------------------------------------------
-- Caster motion modes, executed by CombatMotionServer.
--   None      the caster is not moved at all — every ground attack
--   Hover     hold altitude for the length of the swing (air chains)
--
-- There is no horizontal mode. Attacks do not step in, close distance
-- or lunge; a swing turns the caster to face its target and plays on
-- the spot. Impact is sold by the move's AnimationSlot, not by shoving
-- the character around, and leaving the horizontal axis empty is what
-- lets a launcher or a slam describe purely a lift.
--
-- If a move needs to cover ground, that is a DASH — a separate verb the
-- player inputs, not something an attack does to them.
----------------------------------------------------------------------
Module.MotionModes = {
	None = 'None',
	Hover = 'Hover',
}

----------------------------------------------------------------------
-- Cancel windows.
--
-- Expressed as a FRACTION of the move's total duration. A move may be
-- cancelled into input X once `elapsed >= Total * CancelFrom[X]`.
--
-- Values below 1.0 that fall inside the active window make a move
-- "dodge-cancelable mid-swing", which is the NieR verb: you can always
-- bail out of a committed attack. Light/heavy cancel points sit inside
-- recovery so chains feel continuous instead of waiting out the full
-- animation tail.
--
-- CombatConfig.COMBO_BUFFER lets an input that arrives slightly BEFORE
-- the cancel point queue rather than drop.
----------------------------------------------------------------------
local DEFAULT_CANCEL_FROM = {
	Ground = { L = 0.58, H = 0.62, Dodge = 0.22 },
	Air = { L = 0.52, H = 0.58, Dodge = 0.20 },
	DodgeCounter = { L = 0.60, H = 0.64, Dodge = 0.18 },
}

----------------------------------------------------------------------
-- Per-class physical profile. Governs reach, swing volume and weight.
-- These are the values a designer changes to make a class "feel"
-- different independent of the per-step damage numbers.
--
--   Reach              forward offset of the hitbox from the caster HRP
--   HitboxSize         swing volume (studs)
--   MaxTargets         cap on humanoids damaged by one hitbox window
--   PoiseDamage        default stagger pressure per landed hit
--
-- Since attacks no longer close distance, REACH is the only thing that
-- decides whether a swing connects — a class's range is now entirely
-- `Reach` plus the depth of its `HitboxSize`, and nothing moves the
-- caster to make up a shortfall. Sword reaches 3.5 with a 5-deep box,
-- so it covers roughly 1 to 6 studs of root-to-root gap; Spear reaches
-- 5.0 with an 8-deep box for roughly 1 to 9.
----------------------------------------------------------------------
Module.ClassProfiles = {
	Sword = {
		Wield = 'OneHand',
		Reach = 3.5,
		HitboxSize = Vector3.new(5, 5, 5),
		MaxTargets = 5,
		PoiseDamage = 18,
	},
	Longsword = {
		Wield = 'OneHand',
		Reach = 3.9,
		HitboxSize = Vector3.new(5.5, 5, 5.5),
		MaxTargets = 5,
		PoiseDamage = 20,
	},
	Greatsword = {
		Wield = 'TwoHand',
		Reach = 4.2,
		HitboxSize = Vector3.new(7, 5.5, 6),
		MaxTargets = 8,
		PoiseDamage = 34,
	},
	Dagger = {
		Wield = 'OneHand',
		Reach = 3.0,
		HitboxSize = Vector3.new(4.5, 5, 4.5),
		MaxTargets = 3,
		PoiseDamage = 10,
	},
	DualDagger = {
		Wield = 'DualWield',
		Reach = 3.0,
		HitboxSize = Vector3.new(4.8, 5, 4.8),
		MaxTargets = 4,
		PoiseDamage = 12,
	},
	Spear = {
		Wield = 'TwoHand',
		-- Long, narrow thrust volume: reaches further than any other
		-- class but sweeps a thinner arc.
		Reach = 5.0,
		HitboxSize = Vector3.new(4.5, 5, 8),
		MaxTargets = 6,
		PoiseDamage = 22,
	},
	Mace = {
		Wield = 'OneHand',
		Reach = 3.5,
		HitboxSize = Vector3.new(5.5, 5, 5),
		MaxTargets = 5,
		PoiseDamage = 30,
	},
	Hammer = {
		Wield = 'TwoHand',
		Reach = 4.5,
		HitboxSize = Vector3.new(7.5, 6, 6.5),
		MaxTargets = 8,
		PoiseDamage = 40,
	},
}

-- Profile used when a class has no entry above. Keeps combat swinging
-- for content authored ahead of code.
Module.FallbackProfile = {
	Wield = 'OneHand',
	Reach = 3.5,
	HitboxSize = Vector3.new(5, 5, 5),
	MaxTargets = 5,
	PoiseDamage = 18,
}

----------------------------------------------------------------------
-- Launch / slam specs shared by launcher moves. Scaled per class by
-- `LaunchScale` on the entry.
----------------------------------------------------------------------
Module.DefaultLaunch = {
	Lift = 12,          -- studs of controlled rise
	Duration = 0.18,    -- rise time before the hover takes over
	HoverDuration = 0.55,
	JuggleAdd = 1,
	MaxJuggle = 3,      -- PvE cap before a slam is forced
	PvPScale = 0.35,
	PvPMaxJuggle = 1,
}

Module.DefaultSlam = {
	Velocity = 38,
	Duration = 0.28,
	Lockout = 2,        -- attacker cannot re-launch this victim for N s
	DamageMult = 1.35,
	KnockdownDuration = 0.9,
	PvPKnockdownDuration = 0.5,
	GetupIFrames = 0.9,
}

----------------------------------------------------------------------
-- Per-class Ground chains.
--
-- Numbers migrated verbatim from the previous CombatCombos.luau so the
-- feel of every already-tuned class is preserved through the runtime
-- swap. New fields (IsLauncher / PoiseMult / Motion) are additive.
--
-- Field reference (all optional except the timings):
--   Anim          cosmetic animation slot; never affects gameplay
--   DamageMult    multiplier on rolled base damage
--   PoiseMult     scales the class profile's PoiseDamage for this step
--   IsFinisher    terminates the chain and unlocks finisher-only VFX
--   IsLauncher    lifts the victim into the Air context
--   LaunchScale   multiplier over DefaultLaunch.Lift
--   Windup/Active/Recovery   authoritative gameplay timings, seconds
--   Motion        override the context's default caster motion
--   CancelFrom    override the context's default cancel fractions
----------------------------------------------------------------------
Module.Classes = {

	Sword = {
		Ground = {
			L    = { Anim = 'L1',    DamageMult = 1.00, IsFinisher = false,
			         Windup = 0.05, Active = 0.15, Recovery = 0.20 },
			LL   = { Anim = 'L2',    DamageMult = 1.05, IsFinisher = false,
			         Windup = 0.05, Active = 0.15, Recovery = 0.18 },
			LLL  = { Anim = 'L3',    DamageMult = 1.10, IsFinisher = false,
			         Windup = 0.05, Active = 0.15, Recovery = 0.16 },
			LLLL = { Anim = 'L_FIN', DamageMult = 1.50, IsFinisher = true,
			         PoiseMult = 1.6,
			         Windup = 0.10, Active = 0.20, Recovery = 0.30 },
			H    = { Anim = 'H1',    DamageMult = 1.35, IsFinisher = false,
			         PoiseMult = 1.4,
			         Windup = 0.14, Active = 0.18, Recovery = 0.34 },
			LH   = { Anim = 'H2',    DamageMult = 1.55, IsFinisher = false,
			         PoiseMult = 1.5,
			         Windup = 0.12, Active = 0.20, Recovery = 0.36 },
			-- Launcher. Ends the ground chain by popping the victim up;
			-- follow-ups resolve in the Air context.
			LLH  = { Anim = 'H_LAUNCH', DamageMult = 1.45, IsFinisher = true,
			         IsLauncher = true, LaunchScale = 1.0, PoiseMult = 1.8,
			         Windup = 0.16, Active = 0.20, Recovery = 0.42 },
		},
	},

	Greatsword = {
		Ground = {
			L    = { Anim = 'L1',    DamageMult = 1.20, IsFinisher = false,
			         Windup = 0.10, Active = 0.20, Recovery = 0.32 },
			LL   = { Anim = 'L2',    DamageMult = 1.30, IsFinisher = false,
			         Windup = 0.10, Active = 0.20, Recovery = 0.30 },
			LLL  = { Anim = 'L3',    DamageMult = 1.40, IsFinisher = false,
			         Windup = 0.12, Active = 0.22, Recovery = 0.30 },
			LLLL = { Anim = 'L_FIN', DamageMult = 1.80, IsFinisher = true,
			         PoiseMult = 1.6,
			         Windup = 0.18, Active = 0.25, Recovery = 0.40 },
			H    = { Anim = 'H1',    DamageMult = 1.60, IsFinisher = false,
			         PoiseMult = 1.5,
			         Windup = 0.22, Active = 0.24, Recovery = 0.44 },
			LH   = { Anim = 'H2',    DamageMult = 1.80, IsFinisher = false,
			         PoiseMult = 1.6,
			         Windup = 0.20, Active = 0.26, Recovery = 0.46 },
			LLH  = { Anim = 'H_LAUNCH', DamageMult = 1.70, IsFinisher = true,
			         IsLauncher = true, LaunchScale = 0.85, PoiseMult = 2.0,
			         Windup = 0.26, Active = 0.24, Recovery = 0.52 },
		},
	},

	Longsword = {
		Ground = {
			L    = { Anim = 'L1',    DamageMult = 1.05, IsFinisher = false,
			         Windup = 0.06, Active = 0.16, Recovery = 0.22 },
			LL   = { Anim = 'L2',    DamageMult = 1.12, IsFinisher = false,
			         Windup = 0.06, Active = 0.16, Recovery = 0.20 },
			LLL  = { Anim = 'L3',    DamageMult = 1.20, IsFinisher = false,
			         Windup = 0.06, Active = 0.16, Recovery = 0.18 },
			LLLL = { Anim = 'L_FIN', DamageMult = 1.60, IsFinisher = true,
			         PoiseMult = 1.6,
			         Windup = 0.12, Active = 0.22, Recovery = 0.32 },
			H    = { Anim = 'H1',    DamageMult = 1.42, IsFinisher = false,
			         PoiseMult = 1.4,
			         Windup = 0.16, Active = 0.19, Recovery = 0.36 },
			LH   = { Anim = 'H2',    DamageMult = 1.62, IsFinisher = false,
			         PoiseMult = 1.5,
			         Windup = 0.14, Active = 0.21, Recovery = 0.38 },
			LLH  = { Anim = 'H_LAUNCH', DamageMult = 1.52, IsFinisher = true,
			         IsLauncher = true, LaunchScale = 0.95, PoiseMult = 1.8,
			         Windup = 0.18, Active = 0.21, Recovery = 0.44 },
		},
	},

	Dagger = {
		Ground = {
			L    = { Anim = 'L1',    DamageMult = 0.85, IsFinisher = false,
			         Windup = 0.03, Active = 0.10, Recovery = 0.14 },
			LL   = { Anim = 'L2',    DamageMult = 0.90, IsFinisher = false,
			         Windup = 0.03, Active = 0.10, Recovery = 0.13 },
			LLL  = { Anim = 'L3',    DamageMult = 0.95, IsFinisher = false,
			         Windup = 0.03, Active = 0.10, Recovery = 0.12 },
			LLLL = { Anim = 'L_FIN', DamageMult = 1.30, IsFinisher = true,
			         PoiseMult = 1.5,
			         Windup = 0.05, Active = 0.15, Recovery = 0.22 },
			H    = { Anim = 'H1',    DamageMult = 1.15, IsFinisher = false,
			         PoiseMult = 1.4,
			         Windup = 0.08, Active = 0.12, Recovery = 0.24 },
			LH   = { Anim = 'H2',    DamageMult = 1.28, IsFinisher = false,
			         PoiseMult = 1.5,
			         Windup = 0.07, Active = 0.13, Recovery = 0.26 },
			LLH  = { Anim = 'H_LAUNCH', DamageMult = 1.22, IsFinisher = true,
			         IsLauncher = true, LaunchScale = 1.15, PoiseMult = 1.7,
			         Windup = 0.09, Active = 0.14, Recovery = 0.30 },
		},
	},

	DualDagger = {
		Ground = {
			L    = { Anim = 'L1',    DamageMult = 0.85, IsFinisher = false,
			         Windup = 0.03, Active = 0.10, Recovery = 0.12 },
			LL   = { Anim = 'L2',    DamageMult = 1.00, IsFinisher = false,
			         Windup = 0.03, Active = 0.10, Recovery = 0.11 },
			LLL  = { Anim = 'L3',    DamageMult = 1.10, IsFinisher = false,
			         Windup = 0.03, Active = 0.10, Recovery = 0.10 },
			LLLL = { Anim = 'L_FIN', DamageMult = 1.50, IsFinisher = true,
			         PoiseMult = 1.5,
			         Windup = 0.05, Active = 0.18, Recovery = 0.24 },
			H    = { Anim = 'H1',    DamageMult = 1.20, IsFinisher = false,
			         PoiseMult = 1.4,
			         Windup = 0.07, Active = 0.13, Recovery = 0.22 },
			LH   = { Anim = 'H2',    DamageMult = 1.34, IsFinisher = false,
			         PoiseMult = 1.5,
			         Windup = 0.06, Active = 0.14, Recovery = 0.24 },
			LLH  = { Anim = 'H_LAUNCH', DamageMult = 1.30, IsFinisher = true,
			         IsLauncher = true, LaunchScale = 1.2, PoiseMult = 1.7,
			         Windup = 0.08, Active = 0.15, Recovery = 0.28 },
		},
	},

	Spear = {
		Ground = {
			L    = { Anim = 'L1',    DamageMult = 1.10, IsFinisher = false,
			         Windup = 0.06, Active = 0.18, Recovery = 0.22 },
			LL   = { Anim = 'L2',    DamageMult = 1.15, IsFinisher = false,
			         Windup = 0.06, Active = 0.18, Recovery = 0.20 },
			LLL  = { Anim = 'L3',    DamageMult = 1.25, IsFinisher = false,
			         Windup = 0.06, Active = 0.18, Recovery = 0.20 },
			LLLL = { Anim = 'L_FIN', DamageMult = 1.55, IsFinisher = true,
			         PoiseMult = 1.6,
			         Windup = 0.12, Active = 0.25, Recovery = 0.36 },
			H    = { Anim = 'H1',    DamageMult = 1.45, IsFinisher = false,
			         PoiseMult = 1.4,
			         Windup = 0.15, Active = 0.20, Recovery = 0.34 },
			LH   = { Anim = 'H2',    DamageMult = 1.62, IsFinisher = false,
			         PoiseMult = 1.5,
			         Windup = 0.13, Active = 0.22, Recovery = 0.36 },
			LLH  = { Anim = 'H_LAUNCH', DamageMult = 1.55, IsFinisher = true,
			         IsLauncher = true, LaunchScale = 1.25, PoiseMult = 1.9,
			         -- The classic polearm lift: bigger pop, less reach-in.
			         Windup = 0.18, Active = 0.22, Recovery = 0.46 },
		},
	},

	Mace = {
		Ground = {
			L    = { Anim = 'L1',    DamageMult = 1.15, IsFinisher = false,
			         Windup = 0.08, Active = 0.18, Recovery = 0.28 },
			LL   = { Anim = 'L2',    DamageMult = 1.25, IsFinisher = false,
			         Windup = 0.08, Active = 0.18, Recovery = 0.26 },
			LLL  = { Anim = 'L3',    DamageMult = 1.35, IsFinisher = false,
			         Windup = 0.08, Active = 0.18, Recovery = 0.26 },
			LLLL = { Anim = 'L_FIN', DamageMult = 1.75, IsFinisher = true,
			         PoiseMult = 1.6,
			         Windup = 0.14, Active = 0.22, Recovery = 0.38 },
			H    = { Anim = 'H1',    DamageMult = 1.55, IsFinisher = false,
			         PoiseMult = 1.5,
			         Windup = 0.19, Active = 0.21, Recovery = 0.40 },
			LH   = { Anim = 'H2',    DamageMult = 1.72, IsFinisher = false,
			         PoiseMult = 1.6,
			         Windup = 0.17, Active = 0.23, Recovery = 0.42 },
			LLH  = { Anim = 'H_LAUNCH', DamageMult = 1.65, IsFinisher = true,
			         IsLauncher = true, LaunchScale = 0.9, PoiseMult = 2.0,
			         Windup = 0.22, Active = 0.22, Recovery = 0.48 },
		},
	},

	Hammer = {
		Ground = {
			L    = { Anim = 'L1',    DamageMult = 1.30, IsFinisher = false,
			         Windup = 0.12, Active = 0.22, Recovery = 0.36 },
			LL   = { Anim = 'L2',    DamageMult = 1.40, IsFinisher = false,
			         Windup = 0.12, Active = 0.22, Recovery = 0.34 },
			LLL  = { Anim = 'L3',    DamageMult = 1.50, IsFinisher = false,
			         Windup = 0.12, Active = 0.22, Recovery = 0.34 },
			LLLL = { Anim = 'L_FIN', DamageMult = 2.00, IsFinisher = true,
			         PoiseMult = 1.6,
			         Windup = 0.20, Active = 0.30, Recovery = 0.46 },
			H    = { Anim = 'H1',    DamageMult = 1.75, IsFinisher = false,
			         PoiseMult = 1.5,
			         Windup = 0.26, Active = 0.26, Recovery = 0.50 },
			LH   = { Anim = 'H2',    DamageMult = 1.95, IsFinisher = false,
			         PoiseMult = 1.6,
			         Windup = 0.24, Active = 0.28, Recovery = 0.52 },
			LLH  = { Anim = 'H_LAUNCH', DamageMult = 1.85, IsFinisher = true,
			         IsLauncher = true, LaunchScale = 0.8, PoiseMult = 2.2,
			         Windup = 0.30, Active = 0.26, Recovery = 0.58 },
		},
	},
}

----------------------------------------------------------------------
-- Generic fallbacks. Used when the active class has no entry for a
-- resolved key, so an unauthored chain still swings instead of failing
-- closed. Combat must never break because content lags behind code.
----------------------------------------------------------------------
Module.Generic = {
	L = { Anim = 'L1', DamageMult = 1.00, IsFinisher = false,
	      Windup = 0.05, Active = 0.15, Recovery = 0.20 },
	H = { Anim = 'H1', DamageMult = 1.35, IsFinisher = false,
	      PoiseMult = 1.4,
	      Windup = 0.12, Active = 0.20, Recovery = 0.34 },
}

----------------------------------------------------------------------
-- Derived Air / DodgeCounter entries.
--
-- Air chains are shorter and snappier than their ground counterparts
-- (the victim is falling, so the window to connect is small), and the
-- heavy air input is always the SLAM that ends the juggle.
--
-- DodgeCounter is the perfect-evade reward: one elevated-damage hit
-- with extra poise pressure, available for COUNTER_WINDOW seconds.
--
-- Both are generated from the class's ground L / H entries so a new
-- class inherits a complete moveset from its ground chain alone.
-- A class may still author `Air` / `DodgeCounter` tables explicitly to
-- override any generated key.
----------------------------------------------------------------------
local AIR_TIME_SCALE = 0.8
local AIR_DAMAGE_SCALE = 0.95
local COUNTER_TIME_SCALE = 0.9

local function scaleTimings(entry: any, timeScale: number): (number, number, number)
	return (entry.Windup or 0.05) * timeScale,
		(entry.Active or 0.15) * timeScale,
		(entry.Recovery or 0.20) * timeScale
end

local function buildAirEntries(ground: { [string]: any }): { [string]: any }
	local baseLight = ground.L or Module.Generic.L
	local baseHeavy = ground.H or Module.Generic.H
	local lw, la, lr = scaleTimings(baseLight, AIR_TIME_SCALE)
	local hw, ha, hr = scaleTimings(baseHeavy, AIR_TIME_SCALE)

	-- Air light keeps the victim afloat; each connect re-lifts a little
	-- less than the last (CombatConfig.AIR_JUGGLE_DECAY), which is what
	-- keeps juggles finite without a hard "you may not hit" rule.
	local airLight = {
		Anim = 'A_L1',
		DamageMult = (baseLight.DamageMult or 1.0) * AIR_DAMAGE_SCALE,
		IsFinisher = false,
		PoiseMult = baseLight.PoiseMult,
		Windup = lw, Active = la, Recovery = lr,
		Motion = { Mode = Module.MotionModes.Hover },
		AirSustain = true,
	}

	-- Air heavy is the spike. It ends the juggle and drives the victim
	-- into the ground, which is the readable "combo over" beat.
	local airHeavy = {
		Anim = 'A_SLAM',
		DamageMult = (baseHeavy.DamageMult or 1.35) * 1.1,
		IsFinisher = true,
		PoiseMult = (baseHeavy.PoiseMult or 1.4) * 1.3,
		Windup = hw, Active = ha, Recovery = hr,
		Motion = { Mode = Module.MotionModes.Hover },
		IsSlam = true,
	}

	return {
		L = airLight,
		LL = airLight,
		LLL = airLight,
		LLLL = airLight,
		H = airHeavy,
		LH = airHeavy,
		LLH = airHeavy,
	}
end

local function buildDodgeCounterEntries(ground: { [string]: any }): { [string]: any }
	local baseLight = ground.L or Module.Generic.L
	local baseHeavy = ground.H or Module.Generic.H
	local lw, la, lr = scaleTimings(baseLight, COUNTER_TIME_SCALE)
	local hw, ha, hr = scaleTimings(baseHeavy, COUNTER_TIME_SCALE)

	local counterLight = {
		Anim = 'C_L1',
		DamageMult = (baseLight.DamageMult or 1.0) * 1.6,
		IsFinisher = true,
		PoiseMult = (baseLight.PoiseMult or 1.0) * 1.8,
		Windup = lw, Active = la, Recovery = lr,
		IsCounter = true,
	}

	local counterHeavy = {
		Anim = 'C_H1',
		DamageMult = (baseHeavy.DamageMult or 1.35) * 1.5,
		IsFinisher = true,
		IsLauncher = true,
		LaunchScale = 1.1,
		PoiseMult = (baseHeavy.PoiseMult or 1.4) * 1.9,
		Windup = hw, Active = ha, Recovery = hr,
		IsCounter = true,
	}

	return {
		L = counterLight, LL = counterLight, LLL = counterLight, LLLL = counterLight,
		H = counterHeavy, LH = counterHeavy, LLH = counterHeavy,
	}
end

----------------------------------------------------------------------
-- Resolution + composition.
--
-- ResolveMove composes the final CombatMove from three layers:
--   class profile  (reach, volume, weight, approach behaviour)
-- + context        (cancel windows, default motion mode)
-- + entry          (per-step timings, damage, on-hit effects)
--
-- Results are memoised per (class, context, key). The tables handed
-- back are treated as immutable by every caller; the runtime copies
-- anything it needs to mutate.
----------------------------------------------------------------------
local MoveCache: { [string]: any } = {}
local ContextCache: { [string]: { [string]: any } } = {}

function Module.GetClassProfile(weaponClass: string?)
	if typeof(weaponClass) ~= 'string' then
		return Module.FallbackProfile
	end
	return Module.ClassProfiles[weaponClass] or Module.FallbackProfile
end

function Module.HasClass(weaponClass: string?): boolean
	return typeof(weaponClass) == 'string' and Module.Classes[weaponClass] ~= nil
end

-- Returns the entry table for one (class, context) pair, generating and
-- caching the derived Air / DodgeCounter tables on first use.
local function getContextEntries(weaponClass: string, context: string): { [string]: any }
	local cacheKey = weaponClass .. '|' .. context
	local cached = ContextCache[cacheKey]
	if cached then return cached end

	local classEntry = Module.Classes[weaponClass] or Module.Classes[Module.DefaultClass]
	local ground = (classEntry and classEntry.Ground) or {}

	local entries
	if context == Module.Contexts.Air then
		entries = buildAirEntries(ground)
		-- Authored overrides win over the generated table.
		for key, value in (classEntry and classEntry.Air) or {} do
			entries[key] = value
		end
	elseif context == Module.Contexts.DodgeCounter then
		entries = buildDodgeCounterEntries(ground)
		for key, value in (classEntry and classEntry.DodgeCounter) or {} do
			entries[key] = value
		end
	else
		entries = ground
	end

	ContextCache[cacheKey] = entries
	return entries
end

-- Pick the fallback entry for an unauthored key. Heavy-terminated keys
-- get the heavy generic so an unauthored `LLH` still hits like a heavy.
local function fallbackEntryForKey(key: string?): any
	if typeof(key) == 'string' and string.sub(key, -1, -1) == 'H' then
		return Module.Generic.H
	end
	return Module.Generic.L
end

-- Compose the fully-resolved move. Never returns nil.
function Module.ResolveMove(weaponClass: string?, context: string?, comboKey: string?)
	local class = (typeof(weaponClass) == 'string' and Module.Classes[weaponClass])
		and weaponClass
		or Module.DefaultClass
	local ctx = context
	if ctx ~= Module.Contexts.Air and ctx ~= Module.Contexts.DodgeCounter then
		ctx = Module.Contexts.Ground
	end
	local key = typeof(comboKey) == 'string' and #comboKey > 0 and comboKey or 'L'

	local cacheKey = class .. '|' .. ctx .. '|' .. key
	local cached = MoveCache[cacheKey]
	if cached then return cached end

	local entry = getContextEntries(class, ctx)[key] or fallbackEntryForKey(key)
	local profile = Module.GetClassProfile(class)

	local windup = math.max(entry.Windup or 0.05, 0.01)
	local active = math.max(entry.Active or 0.15, 0.01)
	local recovery = math.max(entry.Recovery or 0.20, 0.01)
	local total = windup + active + recovery

	-- Ground attacks move the caster not at all. Only the air chain
	-- authors a motion, and the only thing it can ask for is to hold
	-- altitude for the swing.
	local motion = entry.Motion or { Mode = Module.MotionModes.None }

	local move = {
		Id = cacheKey,
		WeaponClass = class,
		Context = ctx,
		ComboKey = key,
		-- Cosmetic only. Nothing below reads this.
		AnimationSlot = entry.Anim,

		Windup = windup,
		Active = active,
		Recovery = recovery,
		Total = total,

		CancelFrom = entry.CancelFrom or DEFAULT_CANCEL_FROM[ctx] or DEFAULT_CANCEL_FROM.Ground,

		-- One box for standard attacks. The scheduler accepts a list so
		-- multi-hit moves are a data change, not a code change.
		Hitboxes = {
			{
				Id = 'primary',
				Offset = profile.Reach,
				Size = profile.HitboxSize,
				-- Relative to the START of the active window.
				ActiveAt = 0,
				Duration = active,
				MaxTargets = profile.MaxTargets,
				HitOnce = true,
			},
		},

		DamageMult = entry.DamageMult or 1.0,
		PoiseDamage = profile.PoiseDamage * (entry.PoiseMult or 1.0),

		IsFinisher = entry.IsFinisher == true,
		IsLauncher = entry.IsLauncher == true,
		IsSlam = entry.IsSlam == true,
		IsCounter = entry.IsCounter == true,
		AirSustain = entry.AirSustain == true,
		LaunchScale = entry.LaunchScale or 1.0,

		Motion = motion,
	}

	MoveCache[cacheKey] = move
	return move
end

-- True when the (class, context) pair actually authors this key, as
-- opposed to falling through to the generic entry. The server uses this
-- to decide whether a client's claimed combo key was real.
function Module.HasAuthoredMove(weaponClass: string?, context: string?, comboKey: string?): boolean
	if typeof(comboKey) ~= 'string' or #comboKey == 0 then return false end
	local class = (typeof(weaponClass) == 'string' and Module.Classes[weaponClass])
		and weaponClass
		or Module.DefaultClass
	local ctx = context
	if ctx ~= Module.Contexts.Air and ctx ~= Module.Contexts.DodgeCounter then
		ctx = Module.Contexts.Ground
	end
	return getContextEntries(class, ctx)[comboKey] ~= nil
end

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/CombatSkills.luau"><![CDATA[-- CombatSkills — runtime recipe registry. Each entry is a
-- SkillRecipe consumed by SkillRuntimeServer.RunRecipe. Bosses /
-- mobs / player skills all reference recipes by Id, so a new attack
-- pattern is data-only — no server code changes unless it needs a
-- step kind that doesn't exist yet.
--
-- This file holds RUNTIME recipes (the actual "what happens when this
-- skill activates"). Player-skill UNLOCK metadata stays in
-- Data/Skills.luau; that side of the schema reads `RecipeId` to bind
-- a tree node to a recipe here. One recipe can be reused across
-- multiple unlock-skill entries (e.g. a "basic strike" recipe shared
-- by every weapon's first slot).

local Module = {}

-- // Recipe seed — one entry per step kind so each branch in the
-- // executor has a working example to cross-reference. Real recipes
-- // accumulate here as systems migrate (Boar dash, player skills,
-- // boss attack patterns).
Module.Recipes = {

	-- A standard melee swing — the runtime equivalent of the inline
	-- Generic.AttackNearbyTarget code. Used by basic mobs.
	melee_swing = {
		Id = 'melee_swing',
		Name = 'Melee Swing',
		TargetMode = 'hostiles',
		Steps = {
			{
				Kind = 'telegraph_hit',
				Telegraph = { Kind = 'Circle', Radius = 7 },
				Windup = 0.35,
				Damage = 12,
				Recovery = 0.3,
			},
		},
	},

	-- "Attack around" — heavy ground slam dealing damage in a 360°
	-- ring around the caster. Single circle telegraph, larger radius,
	-- longer windup so players can get out.
	ground_slam = {
		Id = 'ground_slam',
		Name = 'Ground Slam',
		TargetMode = 'hostiles',
		Steps = {
			{
				Kind = 'telegraph_hit',
				Telegraph = { Kind = 'Circle', Radius = 12 },
				Windup = 0.9,
				Damage = 22,
				Status = { Id = 'paralysed', Duration = 0.6 },
				Recovery = 0.7,
			},
		},
	},

	-- "Attacks at positions" — three slams at fixed offsets (left /
	-- right / center). Demonstrates PositionalHits with shared windup.
	tri_pillar = {
		Id = 'tri_pillar',
		Name = 'Triple Pillar',
		TargetMode = 'hostiles',
		Steps = {
			{
				Kind = 'positional_hits',
				Telegraph = { Kind = 'Circle', Radius = 4 },
				Offsets = {
					Vector3.new(-7, 0, 6),
					Vector3.new( 0, 0, 9),
					Vector3.new( 7, 0, 6),
				},
				Windup = 0.7,
				Damage = 16,
				Recovery = 0.5,
			},
		},
	},

	-- "Wave attack" — sweeping line in front of the caster that
	-- travels forward over TravelTime. Two-phase: telegraph the path,
	-- then resolve sub-hits as the wave moves through it.
	frost_wave = {
		Id = 'frost_wave',
		Name = 'Frost Wave',
		TargetMode = 'hostiles',
		Steps = {
			{
				Kind = 'wave',
				Width = 8,
				Length = 4,
				TravelDistance = 28,
				TravelTime = 0.8,
				Damage = 14,
				Status = { Id = 'chilled', Duration = 3 },
				Recovery = 0.5,
			},
		},
	},

	-- Status-only zone — ground frost that slows for a few seconds.
	-- No damage; uses StatusZone so the damage indicator path is
	-- skipped and the visual reads as "field," not "hit."
	chill_field = {
		Id = 'chill_field',
		Name = 'Chill Field',
		TargetMode = 'hostiles',
		Steps = {
			{
				Kind = 'status_zone',
				Telegraph = { Kind = 'Circle', Radius = 10 },
				Windup = 0.5,
				Status = { Id = 'chilled', Duration = 4, Potency = 0.4 },
				Recovery = 0.4,
			},
		},
	},

	-- Compound recipe: VFX cue → wait → cleave → wait → ground slam.
	-- Demonstrates step ordering for a multi-beat pattern.
	cleave_then_slam = {
		Id = 'cleave_then_slam',
		Name = 'Cleave then Slam',
		TargetMode = 'hostiles',
		Steps = {
			{ Kind = 'vfx', Cue = 'cleave_charge_glow', Duration = 0.3 },
			{ Kind = 'telegraph_hit',
			  Telegraph = { Kind = 'Cone', Radius = 14, Angle = math.pi * 0.4 },
			  Windup = 0.5, Damage = 18, Recovery = 0.2 },
			{ Kind = 'wait', Seconds = 0.25 },
			{ Kind = 'telegraph_hit',
			  Telegraph = { Kind = 'Circle', Radius = 9 },
			  Windup = 0.7, Damage = 24, Recovery = 0.6 },
		},
	},

	-- // BossBoar recipes // --

	-- Phase 1: charge — long forward rect, telegraphed for almost a
	-- full second, deals heavy damage. Slow + readable.
	boss_boar_charge = {
		Id = 'boss_boar_charge',
		Name = 'Boar Charge',
		TargetMode = 'hostiles',
		Steps = {
			{ Kind = 'animation', AnimationId = 'ChargeRun' },
			{ Kind = 'telegraph_hit',
			  Telegraph = { Kind = 'Rect', Size = Vector3.new(8, 0, 32) },
			  Windup = 0.9, Damage = 28, Recovery = 0.8 },
		},
	},

	-- Phase 2: stomp — close-range AOE around the boar with a small
	-- paralysis on hit. Forces players to back off.
	boss_boar_stomp = {
		Id = 'boss_boar_stomp',
		Name = 'Boar Stomp',
		TargetMode = 'hostiles',
		Steps = {
			{ Kind = 'telegraph_hit',
			  Telegraph = { Kind = 'Circle', Radius = 14 },
			  Windup = 0.7, Damage = 22,
			  Status = { Id = 'paralysed', Duration = 0.4 },
			  Recovery = 0.6 },
		},
	},

	-- Phase 3: squeal — three-pillar burst at offset positions.
	-- Tests positional_hits with synchronized windup; players have to
	-- pick a safe gap and dodge into it.
	boss_boar_squeal = {
		Id = 'boss_boar_squeal',
		Name = 'Boar Squeal',
		TargetMode = 'hostiles',
		Steps = {
			{ Kind = 'vfx', Cue = 'cleave_charge_glow', Duration = 0.4 },
			{ Kind = 'positional_hits',
			  Telegraph = { Kind = 'Circle', Radius = 6 },
			  Offsets = {
			      Vector3.new(-10, 0,  10),
			      Vector3.new( 10, 0,  10),
			      Vector3.new(  0, 0,  18),
			  },
			  Windup = 0.9, Damage = 18, Recovery = 0.6 },
		},
	},

	-- Stampede — the boar's signature ground-smash. Wide circular AOE
	-- with the `stampede_smash` particle cue (dust ring + ground
	-- shake) firing on contact. Heavy windup so it telegraphs clearly,
	-- and the recovery is long enough that a kited boar pays for
	-- mis-timing the stamp. Damage is the highest of the boar's
	-- single-hit attacks — landing this should hurt.
	boss_boar_stampede = {
		Id = 'boss_boar_stampede',
		Name = 'Stampede',
		TargetMode = 'hostiles',
		Steps = {
			-- Tell — paw at the ground, kicks up a small puff. Gives
			-- the player ~0.35 s of "something's coming" before the
			-- big telegraph rectangle appears.
			{ Kind = 'vfx', Cue = 'stampede_smash_tell', Duration = 0.35 },
			{ Kind = 'wait', Seconds = 0.25 },

			-- The smash itself. Circle telegraph, big radius, paired
			-- with the visual dust-ring burst at impact (cue fires in
			-- parallel; the telegraph_hit step yields on its own
			-- windup so the cue lands roughly at the same instant
			-- the bar hits 100%).
			{ Kind = 'vfx', Cue = 'stampede_smash', Duration = 0.6 },
			{ Kind = 'telegraph_hit',
			  Telegraph = { Kind = 'Circle', Radius = 16 },
			  Windup = 0.9, Damage = 32,
			  Status = { Id = 'paralysed', Duration = 0.5 },
			  Recovery = 0.9 },
		},
	},

	-- Gore — close-range tusk swipe. Cone, short windup, lower damage
	-- than the stomp/stampede but cheap to throw out so the boar can
	-- punish a player who tries to hug it. Pool entry is range-gated
	-- (MaxRange ≈ tusk reach) so it only triggers when the player is
	-- already in tusk range.
	boss_boar_gore = {
		Id = 'boss_boar_gore',
		Name = 'Gore',
		TargetMode = 'hostiles',
		Steps = {
			{ Kind = 'telegraph_hit',
			  Telegraph = { Kind = 'Cone', Radius = 10 },
			  Windup = 0.30, Damage = 16, Recovery = 0.35 },
		},
	},

	-- Double-tap — two quick stomps in succession. Tests the player's
	-- patience to dodge twice; the first stomp pushes them out of
	-- melee range and the second catches the dodge-back. Damage is
	-- per-hit, so eating both is punishing.
	boss_boar_double_tap = {
		Id = 'boss_boar_double_tap',
		Name = 'Double Tap',
		TargetMode = 'hostiles',
		Steps = {
			{ Kind = 'telegraph_hit',
			  Telegraph = { Kind = 'Circle', Radius = 11 },
			  Windup = 0.45, Damage = 14, Recovery = 0.15 },
			{ Kind = 'telegraph_hit',
			  Telegraph = { Kind = 'Circle', Radius = 11 },
			  Windup = 0.40, Damage = 16, Recovery = 0.45 },
		},
	},

	-- Paw-the-ground — non-damaging windup tell. Used as a phase-3
	-- "berserk roar" enter recipe. The tell cue + a brief wait is
	-- intentionally pure flavor; lets the player register that the
	-- boar's escalating before the next attack lands.
	boss_boar_paw_tell = {
		Id = 'boss_boar_paw_tell',
		Name = 'Paw Ground',
		TargetMode = 'self',
		Steps = {
			{ Kind = 'vfx', Cue = 'stampede_smash_tell', Duration = 0.5 },
			{ Kind = 'wait', Seconds = 0.45 },
		},
	},

	-- Boss intro — short label + camera ping. Plays once when the
	-- boss spawns / the player approaches.
	boss_boar_intro = {
		Id = 'boss_boar_intro',
		Name = 'Boss Boar Intro',
		TargetMode = 'self',
		Steps = {
			{ Kind = 'vfx', Cue = 'cleave_charge_glow', Duration = 1.0 },
			{ Kind = 'wait', Seconds = 1.0 },
		},
	},

	-- Boss death — burst + brief slow-mo (slot for cinematic cue).
	boss_boar_death = {
		Id = 'boss_boar_death',
		Name = 'Boss Boar Death',
		TargetMode = 'self',
		Steps = {
			{ Kind = 'vfx', Cue = 'cleave_charge_glow', Duration = 1.5 },
		},
	},

	-- Phase 2 enter — quick burst when the boss crosses the 2/3 HP gate.
	boss_boar_phase2_enter = {
		Id = 'boss_boar_phase2_enter',
		Name = 'BossBoar P2 Enter',
		TargetMode = 'self',
		Steps = {
			{ Kind = 'vfx', Cue = 'cleave_charge_glow', Duration = 0.5 },
			{ Kind = 'wait', Seconds = 0.5 },
		},
	},

	-- Phase 3 enter — same primitive at higher intensity.
	boss_boar_phase3_enter = {
		Id = 'boss_boar_phase3_enter',
		Name = 'BossBoar P3 Enter',
		TargetMode = 'self',
		Steps = {
			{ Kind = 'vfx', Cue = 'cleave_charge_glow', Duration = 0.7 },
			{ Kind = 'wait', Seconds = 0.7 },
		},
	},
} :: { [string]: any }

function Module.GetRecipe(id: string)
	return Module.Recipes[id]
end

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/CombatStates.luau"><![CDATA[-- CombatStates — shared combat state and character-attribute constants.
--
-- CharacterStates still stores these as Roblox attributes. This module only
-- names the contract so future server, client, and recipe code do not retype
-- state strings across files.

local Module = {}

Module.Version = 1

Module.States = {
	Idle = 'Idle',
	Windup = 'Windup',
	Active = 'Active',
	Recovery = 'Recovery',
	Dodge = 'Dodge',
	Guard = 'Guard',
	ParryCounter = 'ParryCounter',
	Stunned = 'Stunned',
	Lifted = 'Lifted',
	Dragged = 'Dragged',
	Airborne = 'Airborne',
	Knockdown = 'Knockdown',
	Dead = 'Dead',
}

Module.Attributes = {
	CombatState = 'CombatState',
	CombatStateUntil = 'CombatStateUntil',
	CurrentMoveId = 'CurrentMoveId',
	CurrentActionId = 'CurrentActionId',

	Attacking = 'Attacking',
	Dodging = 'Dodging',
	IFrames = 'IFrames',
	UsingSkill = 'UsingSkill',
	Blocking = 'Blocking',
	BlockingCount = 'BlockingCount',
	Stunned = 'Stunned',
	KnockedDown = 'KnockedDown',
	Lifted = 'Lifted',
	Dragged = 'Dragged',
	Airborne = 'Airborne',
	JuggleCount = 'JuggleCount',
	Poise = 'Poise',

	SwordDrawn = 'SwordDrawn',
	SwordDrawing = 'SwordDrawing',
	Dashing = 'Dashing',
	AttackCooldown = 'AttackCooldown',
	DashCooldown = 'DashCooldown',
	PerfectDodgeCounter = 'PerfectDodgeCounter',
	BlockCooldownUntil = 'BlockCooldownUntil',
	PostBlockAttackUntil = 'PostBlockAttackUntil',
	DodgeCooldownUntil = 'DodgeCooldownUntil',
	HasWeaponEquipped = 'HasWeaponEquipped',
}

Module.HardCrowdControlAttributes = {
	Module.Attributes.Stunned,
	Module.Attributes.KnockedDown,
	Module.Attributes.Lifted,
	Module.Attributes.Dragged,
}

export type CombatState =
	'Idle'
	| 'Windup'
	| 'Active'
	| 'Recovery'
	| 'Dodge'
	| 'Guard'
	| 'ParryCounter'
	| 'Stunned'
	| 'Lifted'
	| 'Dragged'
	| 'Airborne'
	| 'Knockdown'
	| 'Dead'

export type CombatStateAttribute =
	'CombatState'
	| 'CombatStateUntil'
	| 'CurrentMoveId'
	| 'CurrentActionId'
	| 'Attacking'
	| 'Dodging'
	| 'IFrames'
	| 'UsingSkill'
	| 'Blocking'
	| 'BlockingCount'
	| 'Stunned'
	| 'KnockedDown'
	| 'Lifted'
	| 'Dragged'
	| 'Airborne'
	| 'JuggleCount'
	| 'Poise'
	| 'SwordDrawn'
	| 'SwordDrawing'
	| 'Dashing'
	| 'AttackCooldown'
	| 'DashCooldown'
	| 'PerfectDodgeCounter'
	| 'BlockCooldownUntil'
	| 'PostBlockAttackUntil'
	| 'DodgeCooldownUntil'
	| 'HasWeaponEquipped'

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Companions.luau"><![CDATA[-- // Companions — CLIENT-SIDE SHELL //
--
-- Authored data lives at ServerStorage/Modules/Data/Companions.luau.
-- This file's `Module.Companions` table starts EMPTY and is populated
-- at runtime by ConfigReplicationClient as the server pushes rows
-- the player has earned (owned companions + transitive deps), or —
-- for whitelisted admin UserIds — the full registry on join.
--
-- // Reading contract //
-- Callers must tolerate `Module.Companions[id] == nil` for a player
-- who doesn't own the companion yet. Treat absent ids as "not
-- currently visible to this player" and render nothing rather than
-- erroring (e.g. the Companions tab hides un-replicated entries).
-- The bootstrap fires after the auto-unlock pass so on first spawn
-- the player's owned companions are already in the shell.
--
-- See ROADMAP.md §"Empty client shell" for the full pattern.
--
-- Companion configs. Companions are small visual entities (fairies) that
-- hover near the player. Levels up over time when equipped + via consuming
-- companion candy. Per-level benefits unlock thresholds give small stat
-- bonuses queried by other systems via CompanionsServer.GetActiveBonuses.
--
-- Visual fields (Model, Animations, SFX) are reserved for the visual
-- layer added later; the system works without them (renderer falls back
-- to a generic hover sphere if Model is missing).

export type CompanionElement = 'fire' | 'water' | 'earth' | 'air' | 'arcane'

export type BenefitStat =
	  'XPGain'           -- multiplier on player XP gain (additive bonus)
	| 'LootRoll'         -- chance bonus to loot rolls
	| 'Currency'         -- currency drop multiplier
	| 'Crit'             -- crit chance bonus
	| 'BondAura'         -- string-typed flavor aura, parsed by gameplay code
	-- Direct stat bumps. Combat code reads these via
	-- CompanionsServer.GetActiveBonuses and adds them to the rider's
	-- effective stats. Numeric fractional (0.05 = +5%) for the percent
	-- ones; flat numbers for Health.
	| 'Attack'           -- additive % outgoing damage
	| 'Defense'          -- additive % damage reduction
	| 'Health'           -- flat MaxHealth bonus
	| 'Agility'          -- additive % movement / dodge speed

export type CompanionBenefit = {
	AtLevel: number,
	Stat: BenefitStat,
	Bonus: number | string,
}

export type CompanionAnimations = {
	Idle: string?,
	Float: string?,
	Cheer: string?,
}

export type CompanionSoundEffects = {
	Spawn: { Sound: string, Volume: number? }?,
	LevelUp: { Sound: string, Volume: number? }?,
	Cheer: { Sound: string, Volume: number? }?,
}

export type CompanionHoverConfig = {
	Height: number,         -- studs above player HRP
	BobAmplitude: number,   -- studs vertical bob
	BobFrequency: number,   -- Hz
	OrbitRadius: number,    -- horizontal orbit radius
	OrbitSpeed: number,     -- rad/sec
}

-- Walking mode tunables. The companion stays grounded (raycasts down
-- to find floor) and slots into a per-companion semi-circle behind
-- the player. Used when the player toggles MovementMode='walk' AND
-- the companion's cfg.AllowWalkAndFloatBypass is true.
export type CompanionWalkConfig = {
	-- Distance behind the player along their LookVector for the
	-- center of the semi-circle.
	BackDistance: number,
	-- Width of the semi-circle (studs from center to outermost slot).
	ArcRadius: number,
	-- Total arc width in radians. π = 180° (semi-circle); π/2 = quarter.
	ArcAngle: number,
	-- Height above the ground (small positive value so model doesn't
	-- z-fight with the floor mesh).
	GroundOffset: number,
	-- How sharply the companion eases toward its target slot. Higher
	-- = snappier; 8 reads as "follows but with weight."
	FollowRate: number,
}

export type CompanionMovementMode = 'float' | 'walk'

export type CompanionConfig = {
	Display: {
		Name: string,
		Description: string,
		Icon: string?,
	},
	Model: string,                          -- AssetsShared.Companions.<Model>
	Element: CompanionElement,
	XPCurve: (level: number) -> number,     -- xp required to reach `level + 1`
	MaxLevel: number,
	Benefits: { CompanionBenefit },
	Animations: CompanionAnimations,
	SFX: CompanionSoundEffects,
	Hover: CompanionHoverConfig,
	-- Walk-mode tunables. Used only when MovementMode='walk' is
	-- active; safe to leave as defaults via the wisp() factory.
	Walk: CompanionWalkConfig,
	-- Default rendering mode. 'float' = orbit/bob (the v1 behaviour);
	-- 'walk' = ground-anchored. Players can override at runtime when
	-- AllowWalkAndFloatBypass is true.
	MovementMode: CompanionMovementMode,
	-- DEBUG: when true, the inventory tab shows a Float/Walk dropdown
	-- on this companion. Keep this off in production for non-testbed
	-- companions; the toggle is a power user / debug surface for now.
	AllowWalkAndFloatBypass: boolean?,
	-- Procedural-renderer tint. Used by CompanionsClient's fallback
	-- (no-template) wisp shape so the four colored wisps look
	-- correct without an art pass.
	ProceduralColor: Color3?,
}

local Module = {}

-- Empty at boot — populated by ConfigReplicationClient (category 'Companions').
Module.Companions = {} :: { [string]: CompanionConfig }

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Compositional.luau"><![CDATA[-- Per-item Composition struct — see ARTISAN.md §3 for the design rationale.
--
-- Each owned inventory stack (data.Inventory[itemId][uuid]) optionally
-- carries one of these structs in its `Composition` field. The three
-- artisan systems (forge, enchant, gem-socket) write into / read from
-- their respective sub-table; nil sub-tables mean "this system has
-- never touched this item."
--
-- All fields use catalog ids (e.g. 'iron', 'sharpness', 'ruby_pristine')
-- referencing the per-system data modules under ReplicatedStorage/Modules/
-- Data/. Resolving an id → its full config is a one-liner via the
-- corresponding *Shared module's GetXConfig(id) helper.

-- // Forge ////////////////////////////////////////////////////////////
-- StatSnapshot is BAKED at forge time. Damage / Speed / Weight /
-- Durability are the merged values from blueprint base + per-slot
-- material contributions + applied modifiers; downstream combat math
-- reads StatSnapshot directly rather than recomputing on every swing.
export type ForgeStatSnapshot = {
	Damage: number,
	Speed: number,
	Weight: number,
	Durability: number,
	BonusTraits: { string },        -- material trait flags ('Phase', 'Lunar', etc.)
}

export type ForgeModifierEntry = { id: string, level: number }

-- Identity stamp recorded on every forge commit. Captures who minted
-- (or last re-forged) this weapon so collectible / lore / "Forged by"
-- tooltips can surface attribution. UserId is permanent across name
-- changes; Name is the display name AT THE TIME OF FORGING — kept
-- alongside so old re-forges show the historical name.
export type BlacksmithIdentity = {
	UserId: number,
	Name: string,
}

export type ForgeCompositionConfig = {
	BlueprintId: string,            -- → Blueprints.Blueprints[id]
	Parts: { [string]: string },    -- { [slotKey] = materialId } (catalog ids)
	Modifiers: { ForgeModifierEntry },
	StatSnapshot: ForgeStatSnapshot,
	ForgedAt: number,               -- os.time() of last forge commit
	-- Optional so legacy / seeded forged items (loot table grants, cmdr
	-- forced-forges) don't have to provide one. UI nil-checks before
	-- rendering the "Forged by" row.
	BlacksmithIdentity: BlacksmithIdentity?,
	-- Per-stack rarity override (1..6). Set by ForgeServer at commit
	-- time via ForgeShared.ComputeForgedRarity so the same forged
	-- itemId can mint a Common iron-iron-iron sword for a Lv 1 smith
	-- and a Legendary moonsteel-moonsteel-emberite sword for a Lv 50
	-- smith. UI / loot read this through Items.GetEffectiveRarity which
	-- falls through to cfg.Rarity when nil.
	RarityOverride: number?,
}

-- // Enchant //////////////////////////////////////////////////////////
-- Entries is an ordered list, NOT a map, so future "later overrides
-- earlier" semantics are possible without schema migration. TotalCost
-- tracks cumulative spend (refund-tracking hook for v2).
export type EnchantEntry = {
	Id: string,                     -- → Enchants.Enchants[id]
	Level: number,
	AppliedAt: number,
}

export type EnchantCompositionConfig = {
	Entries: { EnchantEntry },
	TotalCost: number,
}

-- // Gem socketing ////////////////////////////////////////////////////
-- Slots is array-indexed (slots[1] = first socket). Color is the
-- REQUIREMENT baked at item creation; GemUuid is the player's
-- inventory uuid currently filling that socket (or nil for empty).
-- ResonanceBonus is derived state cached on every set/remove via
-- GemSocketShared.RefreshResonance(stack) — recomputing per damage
-- tick would be wasteful.
export type SocketSlot = {
	Color: string,                  -- 'red' / 'blue' / ... / 'any'
	GemUuid: string?,               -- player-inventory uuid; nil = empty
}

export type SocketingResonance = {
	Active: string?,                -- color string or nil
	Multiplier: number?,            -- 1.0 baseline; >1 when 3+ matched
}

export type SocketingCompositionConfig = {
	Slots: { SocketSlot },
	ResonanceBonus: SocketingResonance,
}

-- // Aggregate ////////////////////////////////////////////////////////
export type ItemCompositionConfig = {
	Forged:    ForgeCompositionConfig?,
	Enchants:  EnchantCompositionConfig?,
	Socketing: SocketingCompositionConfig?,
}

local Module = {}

----------------------------------------------------------------------
-- Empty-Composition factories. Used by the workstation servers when
-- they touch an item for the first time so callers never have to
-- nil-check sub-tables. Cheap to allocate; no shared references.
----------------------------------------------------------------------

function Module.MakeEmptyForge(blueprintId: string): ForgeCompositionConfig
	return {
		BlueprintId = blueprintId,
		Parts = {},
		Modifiers = {},
		StatSnapshot = {
			Damage = 0, Speed = 1, Weight = 1, Durability = 1,
			BonusTraits = {},
		},
		ForgedAt = os.time(),
	}
end

function Module.MakeEmptyEnchants(): EnchantCompositionConfig
	return { Entries = {}, TotalCost = 0 }
end

function Module.MakeEmptySocketing(socketColors: { string }): SocketingCompositionConfig
	local slots = {}
	for _, color in socketColors do
		table.insert(slots, { Color = color, GemUuid = nil })
	end
	return {
		Slots = slots,
		ResonanceBonus = { Active = nil, Multiplier = 1 },
	}
end

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Crafting.luau"><![CDATA[-- Crafting configs. Schools (Smithing, Tailoring, Alchemy, Cooking,
-- Enchanting), recipes (reagents → output + XP), and an Artisan rank
-- ladder (Apprentice → Experienced → Master → Grandmaster → Legendary
-- Artisan). Per-school level + XP lives in the player save struct under
-- `data.Crafting.ArtisanLevels[school]`.
--
-- The Artisan rank is computed from a school's current level via
-- `GetArtisanRank(level)`. Recipes gate access by `RequiredLevel` (an
-- integer); the rank is a display-tier derived from level, not a separate
-- stored field.

local Module = {}

----------------------------------------------------------------------
-- Artisan ranks. Ordered by tier; level thresholds chosen so each rank
-- represents a clear progression milestone. Override per-school by
-- setting MaxLevel below — ranks scale to MaxLevel proportionally.
----------------------------------------------------------------------
export type ArtisanRank = {
	Id: string,
	Name: string,
	MinLevel: number,        -- inclusive lower bound
	Color: Color3,
}

Module.ArtisanRanks = {
	{ Id = 'apprentice',   Name = 'Apprentice',         MinLevel = 1,   Color = Color3.fromRGB(154, 166, 184) },
	{ Id = 'experienced',  Name = 'Experienced',        MinLevel = 11,  Color = Color3.fromRGB(126, 200, 255) },
	{ Id = 'master',       Name = 'Master',             MinLevel = 26,  Color = Color3.fromRGB(180, 157, 255) },
	{ Id = 'grandmaster',  Name = 'Grandmaster',        MinLevel = 51,  Color = Color3.fromRGB(255, 215, 138) },
	{ Id = 'legendary',    Name = 'Legendary Artisan',  MinLevel = 91,  Color = Color3.fromRGB(255, 109, 144) },
} :: { ArtisanRank }

function Module.GetArtisanRank(level: number): ArtisanRank
	local rank = Module.ArtisanRanks[1]
	for _, r in Module.ArtisanRanks do
		if level >= r.MinLevel then rank = r else break end
	end
	return rank
end

----------------------------------------------------------------------
-- Schools.
----------------------------------------------------------------------
export type ArtisanSchool = {
	Id: string,
	Display: { Name: string, Icon: string?, Color: Color3 },
	XPCurve: (level: number) -> number,    -- XP required to reach `level + 1`
	MaxLevel: number,
}

local function defaultSchoolXPCurve(level: number): number
	return math.floor(80 + (level - 1) * 60 + (level - 1) ^ 2 * 6)
end

Module.Schools = {
	Smithing = {
		Id = 'Smithing',
		Display = { Name = 'Smithing', Icon = nil, Color = Color3.fromRGB(220, 170, 100) },
		XPCurve = defaultSchoolXPCurve,
		MaxLevel = 100,
	},
	Tailoring = {
		Id = 'Tailoring',
		Display = { Name = 'Tailoring', Icon = nil, Color = Color3.fromRGB(180, 200, 255) },
		XPCurve = defaultSchoolXPCurve,
		MaxLevel = 100,
	},
	Alchemy = {
		Id = 'Alchemy',
		Display = { Name = 'Alchemy', Icon = nil, Color = Color3.fromRGB(150, 230, 180) },
		XPCurve = defaultSchoolXPCurve,
		MaxLevel = 100,
	},
	Cooking = {
		Id = 'Cooking',
		Display = { Name = 'Cooking', Icon = nil, Color = Color3.fromRGB(255, 200, 130) },
		XPCurve = defaultSchoolXPCurve,
		MaxLevel = 100,
	},
	-- Provisioner — field supplies (torches, camp light, utility) split out
	-- of Cooking so "make light/utility" isn't lumped in with food.
	Provisioner = {
		Id = 'Provisioner',
		Display = { Name = 'Provisioner', Icon = nil, Color = Color3.fromRGB(200, 180, 140) },
		XPCurve = defaultSchoolXPCurve,
		MaxLevel = 100,
	},
	Enchanting = {
		Id = 'Enchanting',
		Display = { Name = 'Enchanting', Icon = nil, Color = Color3.fromRGB(200, 140, 255) },
		XPCurve = defaultSchoolXPCurve,
		MaxLevel = 100,
	},
	-- Gem socketing has its own progression so a player who never
	-- enchants but socket-stacks gems can still climb a tier ladder.
	-- GemSocketServer reads the Gemcutting level when validating a
	-- TrySet against the gem's RequiredLevel.
	Gemcutting = {
		Id = 'Gemcutting',
		Display = { Name = 'Gemcutting', Icon = nil, Color = Color3.fromRGB(80, 224, 200) },
		XPCurve = defaultSchoolXPCurve,
		MaxLevel = 100,
	},
} :: { [string]: ArtisanSchool }

----------------------------------------------------------------------
-- Recipes.
----------------------------------------------------------------------
export type Reagent = { ItemId: string, Quantity: number }

export type RecipeConfig = {
	Id: string,
	Display: { Name: string, Description: string, Icon: string? },
	School: string,                     -- key into Module.Schools
	RequiredLevel: number,
	Reagents: { Reagent },
	Output: { ItemId: string, Quantity: number },
	XPGain: number,
	-- Active progress while the craft runs. The bar fills over this
	-- many seconds; when it hits the end, output is granted.
	CraftTime: number?,                 -- seconds; nil/0 = instant
	-- Post-craft lockout. Distinct from CraftTime: a 'rate-limited'
	-- recipe (master tier potions, etc.) sets a long Cooldown but a
	-- short CraftTime so the bar fills fast yet the player has to
	-- wait before re-crafting. Per-(player, recipeId) and persists
	-- across save flushes.
	Cooldown: number?,                  -- seconds; nil/0 = no lockout
	-- Required workstation kind. 'CookingPot' for cooked food,
	-- 'Forge' for smithing-grade recipes, 'AlchemyBench' for potions,
	-- nil for craft-anywhere recipes (bandages, torches, etc.).
	-- Workstation matching uses CollectionService tags; see
	-- ServerStorage/Core/WorkstationServer.luau.
	Workstation: string?,
	-- Required substation kind — secondary ambient gate. The player
	-- must be standing inside a Substation zone of this kind in
	-- ADDITION to satisfying the Workstation rule. nil → no
	-- substation requirement (recipe ignores substation membership).
	-- See ServerStorage/Core/SubstationServer.luau and
	-- ReplicatedStorage/Modules/Data/Substations.luau for the kind
	-- registry. Examples: 'Kiln', 'BrewingBarrel', 'MortarPestle'.
	RequiredSubstation: string?,
	-- Granted to every player on first join. Marks the recipe as a
	-- "starter" — visible in the crafting menu the moment a fresh
	-- save is created, no quest / discovery required. Non-starter
	-- recipes stay hidden until something explicitly unlocks them.
	AutoUnlock: boolean?,
}

Module.Recipes = {

	-- // COOKING — requires CookingPot workstation //
	cooked_meat = {
		AutoUnlock = true,
		Id = 'cooked_meat',
		Display = {
			Name = 'Cooked Boar Meat',
			Description = 'Roasted on the cooking pot. Restores HP.',
		},
		School = 'Cooking',
		RequiredLevel = 1,
		Reagents = {
			{ ItemId = 'RawBoarMeat', Quantity = 1 },
			{ ItemId = 'WoodLog', Quantity = 1 },  -- fuel
		},
		Output = { ItemId = 'CookedMeat', Quantity = 1 },
		XPGain = 12,
		CraftTime = 4,
		Cooldown = 0,
		Workstation = 'CookingPot',
	},

	herbal_stew = {
		Id = 'herbal_stew',
		Display = {
			Name = 'Herbal Stew',
			Description = 'Stewed herbs + meat. HP + 30s regen.',
		},
		School = 'Cooking',
		RequiredLevel = 5,
		Reagents = {
			{ ItemId = 'RawBoarMeat',     Quantity = 1 },
			{ ItemId = 'WildHerb',    Quantity = 2 },
			{ ItemId = 'RiverWater',  Quantity = 1 },
		},
		Output = { ItemId = 'HerbalStew', Quantity = 1 },
		XPGain = 22,
		CraftTime = 8,
		Cooldown = 0,
		Workstation = 'CookingPot',
	},

	berry_jam = {
		Id = 'berry_jam',
		Display = {
			Name = 'Berry Jam',
			Description = 'Sweet preserved berries. Trail food.',
		},
		School = 'Cooking',
		RequiredLevel = 2,
		Reagents = {
			{ ItemId = 'WildBerry', Quantity = 3 },
			{ ItemId = 'WoodLog',   Quantity = 1 },
		},
		Output = { ItemId = 'BerryJam', Quantity = 2 },
		XPGain = 15,
		CraftTime = 6,
		-- 30s rate-limit on this recipe specifically — Berry Jam is
		-- cheap to make and would otherwise be the dominant HP source.
		-- Designers retune by editing this single field.
		Cooldown = 30,
		Workstation = 'CookingPot',
	},

	-- // Substation-gated example: SmokingRack + CookingPot //
	-- Requires the player to be at a CookingPot workstation AND
	-- standing inside a SmokingRack substation zone. Lets the design
	-- gate "fancy" cooked outputs behind a player visiting both nodes.
	smoked_meat = {
		Id = 'smoked_meat',
		Display = {
			Name = 'Smoked Meat',
			Description = 'Cured over the smoking rack. Long-lasting.',
		},
		School = 'Cooking',
		RequiredLevel = 6,
		Reagents = {
			{ ItemId = 'RawBoarMeat', Quantity = 2 },
			{ ItemId = 'WoodLog', Quantity = 2 },
		},
		Output = { ItemId = 'CookedMeat', Quantity = 2 },
		XPGain = 28,
		CraftTime = 10,
		Cooldown = 0,
		Workstation = 'CookingPot',
		RequiredSubstation = 'SmokingRack',
	},

	-- // CRAFTING (no workstation) — quick, anywhere //
	herbal_bandage = {
		AutoUnlock = true,
		Id = 'herbal_bandage',
		Display = {
			Name = 'Herbal Bandage',
			Description = 'Wrap herbs in plant fiber. Field-grade aid.',
		},
		School = 'Alchemy',
		RequiredLevel = 1,
		Reagents = {
			{ ItemId = 'WildHerb',   Quantity = 2 },
			{ ItemId = 'PlantFiber', Quantity = 1 },
		},
		Output = { ItemId = 'HerbalBandage', Quantity = 1 },
		XPGain = 10,
		CraftTime = 0,    -- instant
		Cooldown = 0,
		Workstation = nil,
	},

	basic_torch = {
		AutoUnlock = true,
		Id = 'basic_torch',
		Display = {
			Name = 'Basic Torch',
			Description = 'Wood log + plant fiber wick. Light a dark room.',
		},
		School = 'Provisioner',  -- field-supplies school; moved out of Cooking
		RequiredLevel = 1,
		Reagents = {
			{ ItemId = 'WoodLog',    Quantity = 1 },
			{ ItemId = 'PlantFiber', Quantity = 1 },
		},
		Output = { ItemId = 'BasicTorch', Quantity = 1 },
		XPGain = 6,
		CraftTime = 2,
		Cooldown = 0,
		Workstation = nil,
	},

	-- // SMITHING — workshop-less recipe so the school has an entry path //
	sharpening_stone = {
		Id = 'sharpening_stone',
		Display = {
			Name = 'Sharpening Stone',
			Description = 'Hone an edge. Field-rough, but it works.',
		},
		School = 'Smithing',
		RequiredLevel = 1,
		Reagents = {
			{ ItemId = 'StoneChunk', Quantity = 2 },
			{ ItemId = 'WildHerb',   Quantity = 1 },  -- abrasive paste
		},
		Output = { ItemId = 'SharpeningStone', Quantity = 1 },
		XPGain = 8,
		CraftTime = 3,
		Cooldown = 0,
		Workstation = nil,
	},

	-- // SMITHING — ore → ingot smelting at a Forge //
	smelt_copper = {
		AutoUnlock = true,
		Id = 'smelt_copper',
		Display = { Name = 'Smelt Copper Ingot', Description = 'Smelt copper ore down into a workable bar.' },
		School = 'Smithing',
		RequiredLevel = 1,
		Reagents = { { ItemId = 'CopperOre', Quantity = 2 } },
		Output = { ItemId = 'CopperIngot', Quantity = 1 },
		XPGain = 10,
		CraftTime = 4,
		Cooldown = 0,
		Workstation = 'Forge',
	},
	smelt_iron = {
		AutoUnlock = true,
		Id = 'smelt_iron',
		Display = { Name = 'Smelt Iron Ingot', Description = 'Smelt iron ore down into a workable bar.' },
		School = 'Smithing',
		RequiredLevel = 3,
