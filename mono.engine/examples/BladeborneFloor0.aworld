}
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/world/KillNearbyMobsServer"><![CDATA[local CollectionService = game:GetService("CollectionService")

return function(_context, target: Player, radius: number)
	local character = target.Character
	local hrp = character and character:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not hrp then
		return string.format("%s has no HumanoidRootPart — can't anchor search.", target.Name)
	end
	radius = math.max(1, radius or 50)

	local origin = hrp.Position
	local killed = 0
	for _, mob in CollectionService:GetTagged('AICharacter') do
		if not mob:IsA('Model') then continue end
		local mobHrp = mob:FindFirstChild('HumanoidRootPart') :: BasePart?
		if not mobHrp then continue end
		if (mobHrp.Position - origin).Magnitude > radius then continue end
		local humanoid = mob:FindFirstChildWhichIsA('Humanoid')
		if humanoid and humanoid.Health > 0 then
			humanoid.Health = 0
			killed += 1
		end
	end
	return string.format("Killed %d mobs within %.0f studs of %s.", killed, radius, target.Name)
end
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/world/SetWeather"><![CDATA[--!strict
