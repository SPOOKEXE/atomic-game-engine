				EndOffset = Vector3.new(0, 4, 0),
				TextureLength = 1.0, TextureSpeed = 2.5,
				FaceCamera = true,
			},
			Light = { Color = Color3.fromRGB(255, 150, 60), Brightness = 1.4, Range = 4 },
		},
	}),

	-- // MOUNT — storm mantle, dense particle aura //
	mount_glow_storm = aura({
		Anchor = 'mount',
		Display = { Name = 'Storm Mantle', Description = 'Crackling lightning wreathes the mount.' },
		Rarity = 3,
		VFX = {
			Particle = 'StormMantle',
			Light = { Color = Color3.fromRGB(120, 200, 255), Brightness = 1.6, Range = 10 },
		},
		Procedural = {
			TemplateName = 'StormMantle',
			Particle = {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0,   Color3.fromRGB(100, 180, 255)),
