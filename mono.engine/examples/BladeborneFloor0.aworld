		Properties = {
			SoundId = "rbxassetid://124027970389012",
			Volume = 0.2,
		},
	},

	CozyTavernFireplace = {
		Properties = {
			SoundId = "rbxassetid://120673152613747",
			Volume = 0.2,
		},
	},

	PeacefulRPGTownMusicForFocus = {
		Properties = {
			SoundId = "rbxassetid://92869831067356",
			Volume = 0.2,
		},
	},
}

local SongIds = { }
for songId, _ in Module.SongData do
	table.insert(SongIds, songId)
end

Module.RegionSongs = {
	Default = SongIds,

	-- TestRegion1 = { 'Ambient6' },
	-- TestRegion2 = { 'Ambient2' },
}

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Modules/Data/LightingData"><![CDATA[local function CreateRainPreset(thunderChance : number | nil, data : table) : table
	return {
		WindLoudness = 0.1,
		CanThunder = typeof(thunderChance) == 'number',
		ThunderChance = thunderChance,
		ActivateRain = true,
		Properties = data.Properties,
		Effects = data.Effects,
	}
end

-- // Module // --
