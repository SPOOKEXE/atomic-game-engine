		<Source path="ServerScriptService/CmdrSetup/Commands/companions/GiveCompanionServer"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore    = require(ServerStorage:WaitForChild('Core'))
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

-- Cmdr is server-side; reads the full registry from the canonical copy.
local CompanionsConfig = ServerModules.Data.Companions

return function(_context, target: Player, companionId: string, autoEquip: boolean?)
	if not CompanionsConfig.Companions[companionId] then
		local known: { string } = {}
		for id in CompanionsConfig.Companions do known[#known + 1] = id end
		table.sort(known)
		return string.format('Unknown companion id %q. Known: %s', companionId, table.concat(known, ', '))
	end
	local Companions = ServerCore.CompanionsServer
	if not Companions or not Companions.AttemptUnlockCompanion then
		return 'CompanionsServer unavailable.'
	end
	local unlocked = Companions.AttemptUnlockCompanion(target, companionId)
	if not unlocked then return 'Failed to unlock.' end
	if autoEquip == true then
		Companions.AttemptEquipCompanion(target, companionId)
		return string.format('Unlocked + equipped %q for %s.', companionId, target.Name)
	end
	return string.format('Unlocked %q for %s.', companionId, target.Name)
end
]]></Source>
