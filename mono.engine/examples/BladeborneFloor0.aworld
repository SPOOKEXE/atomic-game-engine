	},
	-- floor 1
	F1_ToB = {
		Name = 'Town of Beginnings',
		Category = 'Floor1',
		LayoutOrder = 1,
		AutoUnlock = true,
		Floor = 1,
		LargeWaystone = true,
	},
	-- F1_MainPath1 = {
