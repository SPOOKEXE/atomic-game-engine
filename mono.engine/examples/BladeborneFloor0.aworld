		<Source path="src/ServerScriptService/CmdrSetup/Commands/debug/TestTelegraphServer.luau"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

return function(context, kind: string, duration: number)
	local Telegraph = ServerCore.EnemyTelegraphServer
	if not Telegraph or not Telegraph.Show then
		return 'EnemyTelegraphServer unavailable.'
	end
	local executor = context.Executor
	local character = executor and executor.Character
	if not character then return 'Executor has no character.' end

	local kindLower = string.lower(tostring(kind or ''))
	local payload: any
	if kindLower == 'circle' then
		payload = { Kind = 'Circle', Origin = character:GetPivot(),
		            Radius = 8, Duration = duration }
	elseif kindLower == 'rect' then
		payload = { Kind = 'Rect', Origin = character:GetPivot(),
		            Size = Vector3.new(6, 0, 18), Duration = duration }
	elseif kindLower == 'cone' then
		payload = { Kind = 'Cone', Origin = character:GetPivot(),
		            Radius = 12, Angle = math.pi * 0.4,
		            Duration = duration }
	else
		return string.format("Unknown kind '%s'. Use circle | rect | cone.", tostring(kind))
	end
	local id = Telegraph.Show(payload)
	-- Auto-hide after the duration in case the renderer's failsafe
	-- doesn't fire (it has +0.5s padding via Debris already).
	task.delay(duration + 0.05, function()
		Telegraph.Hide(id)
	end)
	return string.format("Telegraph (%s, %.2fs) fired.", kindLower, duration)
end
]]></Source>
		<Source path="src/ServerScriptService/CmdrSetup/Commands/effects/ApplyEffect.luau"><![CDATA[--!strict
-- /apply_effect [target] [effect_id] [duration?] [potency?] —
-- runs through StatusEffectsRuntime.Apply on the player's character.
return {
	Name = 'ApplyEffect',
	Aliases = { 'apply_effect', 'applyeffect', 'effect' },
	Description = 'Apply a named effect (burn / poison / crumbling / pierced / etc.) to a player.',
	Group = 'Admin',
	Args = {
		{ Type = 'player', Name = 'target',   Description = 'Target player.' },
		{ Type = 'string', Name = 'effectId', Description = "Effect id from Data/StatusEffects.luau." },
		{ Type = 'number', Name = 'duration', Description = 'Override duration in seconds (omit for cfg default).', Optional = true },
		{ Type = 'number', Name = 'potency',  Description = 'Override potency (omit for cfg default).', Optional = true },
	},
}
]]></Source>
		<Source path="src/ServerScriptService/CmdrSetup/Commands/effects/ApplyEffectServer.luau"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local StatusEffectsConfig = require(ReplicatedStorage:WaitForChild('Modules')).Data.StatusEffects

return function(context, target: Player, effectId: string, duration: number?, potency: number?)
	-- Resolved through GetEffectFromId rather than indexing the registry,
	-- so legacy aliases are accepted here exactly as the runtime accepts
	-- them. Indexing directly would reject an id that Apply would happily
	-- take, which is a confusing thing for a debug command to do.
	if not StatusEffectsConfig.GetEffectFromId(effectId) then
		local known: { string } = {}
		for id in StatusEffectsConfig.StatusEffects do known[#known + 1] = id end
		table.sort(known)
		return string.format('Unknown effect id %q. Known: %s', effectId, table.concat(known, ', '))
	end
	local StatusEffects = ServerCore.StatusEffectsRuntime
	if not StatusEffects or not StatusEffects.Apply then
		return 'StatusEffectsRuntime unavailable.'
	end
	local char = target.Character
	if not char then return string.format('%s has no character.', target.Name) end
	-- Source := executor's character (so kill credit / DoT source wires
	-- correctly when the executor inflicts damage on the target).
	local source: Player? = (typeof(context.Executor) == 'Instance' and context.Executor:IsA('Player'))
		and context.Executor or nil
	local ok = StatusEffects.Apply(char, effectId, {
		Duration = duration,
		Potency = potency,
		Source = source,
	})
	if not ok then return 'Apply rejected (target dead, despawned, or category not handled).' end
	return string.format('Applied %s to %s.', effectId, target.Name)
end
]]></Source>
		<Source path="src/ServerScriptService/CmdrSetup/Commands/effects/ClearEffects.luau"><![CDATA[--!strict
-- /clear_effects [target] — wipe every active effect on a player's
