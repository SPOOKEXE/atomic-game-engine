return {
	Name = 'UnlockSkillNode',
	Aliases = { 'unlockskill', 'unlocknode' },
	Description = "Unlock a single skill node on a player's save (bypasses SkillPoint cost + prereq + level checks). Passives go straight to MaxLevel.",
	Group = 'Admin',
	Args = {
		{ Type = 'player', Name = 'target',  Description = 'Target player.' },
