	-- // Multi-attribute experience scrolls //
	-- Use ExperienceScrollData to grant XP to multiple attributes per
	-- consume. ConsumptionServer's handleExperienceScroll iterates the
	-- Grants array, routing each entry through AttributeServer. Tag
	-- with ItemTags.ExperienceScroll so future UI surfaces can filter.
	-- Sources tagged so the inventory detail's "CAN BE OBTAINED FROM"
	-- row reads correctly out of the box.
	WarriorTomeScroll = FastDefineItem({
		Type = 'ExperienceScroll',
		Tags = { Module.ItemTags.ExperienceScroll },
		Sources = { Module.ItemSources.Quest, Module.ItemSources.Boss },
		Rarity = RaritiesConfig.RarityEnums.Rare,
		MaxQuantity = 99,
		ExperienceScrollData = {
			Grants = {
				{ AttributeId = 'Strength', Amount = 60 },
				{ AttributeId = 'Vitality', Amount = 40 },
			},
		},
		ConsumptionData = { Effects = {}, Inflicts = {}, Consumes = true, ConsumeQuantity = 1, MinimumQuantity = 1, Cooldown = 0.5 },
		Display = BasicColorDisplay(
			"Warrior's Tome",
			'+60 Strength XP, +40 Vitality XP. The warrior way.',
			Color3.fromRGB(232, 92, 92)
		),
	}),

	ScoutTomeScroll = FastDefineItem({
		Type = 'ExperienceScroll',
		Tags = { Module.ItemTags.ExperienceScroll },
		Sources = { Module.ItemSources.Quest, Module.ItemSources.Treasure },
		Rarity = RaritiesConfig.RarityEnums.Rare,
		MaxQuantity = 99,
