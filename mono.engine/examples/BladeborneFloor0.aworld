}
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/mounts/DeleteMountServer"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

return function(_context, target: Player, mountId: string)
	local MountsServer = ServerCore.MountsServer
	if not MountsServer or not MountsServer.AttemptRevokeMount then
		return 'MountsServer module unavailable.'
	end
	local ok = MountsServer.AttemptRevokeMount(target, mountId)
	if not ok then
		return string.format('%s does not own %q (or mount unknown).', target.Name, mountId)
	end
	return string.format('Revoked %q from %s.', mountId, target.Name)
end
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/auras/GiveAura"><![CDATA[--!strict
-- /giveaura <player> <auraId> [autoEquip] — unlock an aura on the
-- target's save struct. When autoEquip is true (default), also
-- attempts to fill an open slot with it.
return {
	Name = 'GiveAura',
	Aliases = { 'giveaura', 'unlockaura' },
	Description = 'Unlock an aura on a player; optionally auto-equip if a slot is free.',
	Group = 'Admin',
	Args = {
		{ Type = 'player',  Name = 'target',     Description = 'Target player.' },
		{ Type = 'string',  Name = 'auraId',     Description = "Aura id from Data/Auras.luau (e.g. 'character_runic')." },
		{ Type = 'boolean', Name = 'autoEquip',  Description = 'Auto-equip into an open slot. Default true.', Optional = true },
	},
}
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/auras/GiveAuraServer"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local AurasConfig = require(ReplicatedStorage:WaitForChild('Modules')).Data.Auras

return function(_context, target: Player, auraId: string, autoEquip: boolean?)
	if not AurasConfig.Auras[auraId] then
		local known: { string } = {}
		for id in AurasConfig.Auras do known[#known + 1] = id end
		table.sort(known)
		return string.format("Unknown aura id %q. Known: %s", auraId, table.concat(known, ', '))
	end
	local AurasServer = ServerCore.AurasServer
	if not AurasServer or not AurasServer.AttemptUnlockAura then
		return 'AurasServer module unavailable.'
	end
	local unlocked = AurasServer.AttemptUnlockAura(target, auraId)
	if not unlocked then
		return string.format('Failed to unlock %q for %s.', auraId, target.Name)
	end
	-- autoEquip default = true. Cmdr boolean args don't have a default
	-- system, so nil is treated as "yes" here for ergonomic admin use.
	if autoEquip ~= false then
		local equipped = AurasServer.AttemptEquipAura(target, auraId)
		if not equipped then
			-- Slot may be full — still successful at unlocking.
			return string.format('Unlocked %q for %s. (Equip skipped: slots full.)', auraId, target.Name)
		end
		return string.format('Unlocked + equipped %q for %s.', auraId, target.Name)
	end
	return string.format('Unlocked %q for %s.', auraId, target.Name)
end
]]></Source>
