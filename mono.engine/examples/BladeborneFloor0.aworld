		<Source path="ServerScriptService/CmdrSetup/Commands/quests/GiveQuestServer"><![CDATA[local ServerStorage = game:GetService("ServerStorage")
local ServerCore = require(ServerStorage:WaitForChild('Core'))

return function(_context, target: Player, questId: string)
	local result = ServerCore.QuestServer.GiveQuestOfId(target, questId)
	-- GiveQuestOfId returns either the new uuid (on success) OR a CanAcquire
	-- failure string. Use the result shape to disambiguate the two cases.
	if typeof(result) == "string" and string.match(result, "^[0-9a-fA-F%-]+$") then
		return string.format("Gave quest '%s' to %s (uuid=%s).", questId, target.Name, result)
	elseif typeof(result) == "string" then
		return string.format("Could not give quest '%s' to %s: %s", questId, target.Name, result)
	end
	return string.format("Gave quest '%s' to %s.", questId, target.Name)
end
]]></Source>
