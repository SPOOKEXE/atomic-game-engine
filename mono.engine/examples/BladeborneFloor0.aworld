		<Source path="src/ServerScriptService/CmdrSetup/Commands/player/WipePlayerDataServer.luau"><![CDATA[local ServerStorage = game:GetService("ServerStorage")
local ServerCore = require(ServerStorage:WaitForChild('Core'))

return function(_context, userId: number)
	-- WipeUserId returns (true) on success and (false, errString) when the
	-- profile can't be loaded. We capture both and surface whichever case
	-- applies; pcall wraps any unexpected runtime error as `(false, msg)`.
	local pcallOk, success, errMsg = pcall(ServerCore.DataEditServer.WipeUserId, userId)
	if not pcallOk then
		return string.format("WipeUserId(%d) errored: %s", userId, tostring(success))
	end
	if not success then
		return string.format("WipeUserId(%d) failed: %s", userId, tostring(errMsg or 'profile load failed'))
	end
	return string.format("Wiped persistent data for UserId %d.", userId)
end
]]></Source>
