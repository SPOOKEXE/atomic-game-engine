		<Source path="StarterPlayer/StarterPlayerScripts/Modules/Modules/Rain"><![CDATA[--[[
	Rain module v1.0 by buildthomas (July 2018)
	This module is licensed under the APLv2:
	http://www.apache.org/licenses/LICENSE-2.0
	In short, you may use this code only if you agree to the following:
	* This notice must always be present and may not be modified or removed in any copy of this code or derived code.
	* You may use this in commercial, closed source projects, and you may modify the source code itself.
	Refer to the license for a full description.
	For questions please reach out on the Developer Forum (@buildthomas)
	or via Twitter (https://www.twitter.com/buildthomasRBX)
	------
	Rain:Enable(<TweenInfo> tweenInfo)
		Enable the rain effects instantly, or over a given easing function if tweenInfo is given.
		Rain:Disable(<TweenInfo> tweenInfo)
		Disable the rain effects instantly, or over a given easing function if tweenInfo is given.
			Rain:SetColor(<Color3> color, <TweenInfo> tweenInfo)
		Set the global color of all rain particles to a given Color3 value.
		Sets the color instantly, or over a given easing function if tweenInfo is given.
		Color sequences are not supported because this would lead to a messy effect.
		The starting value is RAIN_DEFAULT_COLOR.
		Rain:SetTransparency(<number> transparency, <TweenInfo> tweenInfo)
		Set the global transparency of all rain effects. 0 = regular visibility, 1 = fully invisible.
		Sets the transparency instantly, or over a given easing function if tweenInfo is given.
		Clamped between 0 and 1, the starting value is RAIN_DEFAULT_TRANSPARENCY.
	Rain:SetSpeedRatio(<number> ratio, <TweenInfo> tweenInfo)
		Set the vertical falling speed of the rain particles. 0 = still, 1 = max falling speed.
		Sets the speed instantly, or over a given easing function if tweenInfo is given.
		Clamped between 0 and 1, the starting value is RAIN_DEFAULT_SPEEDRATIO.
		Rain:SetIntensityRatio(<number> ratio, <TweenInfo> tweenInfo)
		Set the intensity of the rain. 0 = no effects, 1 = full effects.
		Sets the intensity instantly, or over a given easing function if tweenInfo is given.
		Clamped between 0 and 1, the starting value is RAIN_DEFAULT_INTENSITYRATIO.
		Rain:SetLightEmission(<number> ratio, <TweenInfo> tweenInfo)
		Set the global light emission of all rain effects.
		Sets the light emission instantly, or over a given easing function if tweenInfo is given.
		Clamped between 0 and 1, the starting value is RAIN_DEFAULT_LIGHTEMISSION.
		Rain:SetLightInfluence(<number> transparency, <TweenInfo> tweenInfo)
		Set the global light influence of all rain effects.
		Sets the light influence instantly, or over a given easing function if tweenInfo is given.
		Clamped between 0 and 1, the starting value is RAIN_DEFAULT_LIGHTINFLUENCE.
			Rain:SetVolume(<number> volume, <TweenInfo> tweenInfo)
		Set the global max volume of rain instantly, or over a given easing function if tweenInfo is given.
		The initial volume of the rain's soundgroup is RAIN_SOUND_BASEVOLUME.
			Rain:SetCeiling(<Variant<number, nil>> ceiling)
		Set a Y coordinate that marks the ceiling of the world. Above this spot, rain will act as if it's indoors.
		Feed nil to remove any previously set ceiling.
			Rain:SetDirection(<Vector3> direction, <TweenInfo> tweenInfo)
		Set the direction that rain falls from. The direction parameter should be a unit direction.
		Sets the rain direction instantly, or over a given easing function if tweenInfo is given.
		Rain:SetStraightTexture(<string> asset)
	Rain:SetTopDownTexture(<string> asset)
	Rain:SetSplashTexture(<string> asset)
		Adjust textures of the rain effect.
		Rain:SetSoundId(<string> asset)
		Adjust sound effect of the rain effect.
		Rain:SetCollisionMode(<Rain.CollisionMode> mode, ...)
		Sets the current way collisions are determined for the rain.
			Rain.CollisionMode
			A table that should be seen as an enumerator for the collision mode.
			The following values are available:
			* Rain.CollisionMode.None			- All parts in the default collision group will block the rain.
			* Rain.CollisionMode.Whitelist		- Use the whitelist provided by Rain::SetCollisionWhitelist.
			* Rain.CollisionMode.Blacklist		- Use the blacklist provided by Rain::SetCollisionBlacklist.
			* Rain.CollisionMode.Function		- Use the test function provided by Rain::SetCollisionFunction and do deep-casts.
				Rain:SetCollisionMode(Rain.CollisionMode.None)
			No parameters.
				Rain:SetCollisionMode(Rain.CollisionMode.Whitelist, <Variant<Instance, table>> whitelist)
			The provided value can either be a hierarchy of objects or a table of objects to filter with.
			Rain:SetCollisionMode(Rain.CollisionMode.Blacklist, <Variant<Instance, table>> blacklist)
			The provided value can either be a hierarchy of objects or a table of objects to filter out.
				Rain:SetCollisionMode(Rain.CollisionMode.Function, <function<BasePart -> boolean>> f)
			If f(part) returns a value that lua evaluates to a true condition, that part can be hit by rain.
			If f(part) returns any other value, that part cannot be hit by the rain.
		--]]

-- Options:

local MIN_SIZE = Vector3.new(0.05,0.05,0.05)				-- Size of main emitter part when rain inactive

local RAIN_DEFAULT_COLOR = Color3.new(1,1,1)				-- Default color3 of all rain elements
local RAIN_DEFAULT_TRANSPARENCY = 0							-- Default transparency scale ratio of all rain elements
local RAIN_DEFAULT_SPEEDRATIO = 1							-- Default speed scale ratio of falling rain effects
local RAIN_DEFAULT_INTENSITYRATIO = 1						-- Default intensity ratio of all rain elements
local RAIN_DEFAULT_LIGHTEMISSION = 0.05						-- Default LightEmission of all rain elements
local RAIN_DEFAULT_LIGHTINFLUENCE = 0.9						-- Default LightInfluence of all rain elements
local RAIN_DEFAULT_DIRECTION = Vector3.new(0,-1,0)			-- Default direction for rain to fall into

local RAIN_TRANSPARENCY_T1 = .25							-- Define the shape (time-wise) of the transparency curves for emitters
local RAIN_TRANSPARENCY_T2 = .75

local RAIN_SCANHEIGHT = 1000								-- How many studs to scan up from camera position to determine whether occluded

local RAIN_EMITTER_DIM_DEFAULT = 40							-- Size of emitter block to the side/up
local RAIN_EMITTER_DIM_MAXFORWARD = 100						-- Size of emitter block forwards when looking at the horizon
local RAIN_EMITTER_UP_MODIFIER = 20							-- Maximum vertical displacement of emitter (when looking fully up/down)

local RAIN_SOUND_ASSET = "rbxassetid://1516791621"
local RAIN_SOUND_BASEVOLUME = 0.2							-- Starting volume of rain sound effect when not occluded
local RAIN_SOUND_FADEIN_TIME = 1							-- Tween in/out times for sound volume
local RAIN_SOUND_FADEOUT_TIME = 1

local RAIN_STRAIGHT_ASSET = "rbxassetid://1822883048"		-- Some properties of the straight rain particle effect
local RAIN_STRAIGHT_ALPHA_LOW = 0.7							-- Minimum particle transparency for the straight rain emitter
local RAIN_STRAIGHT_SIZE = NumberSequence.new(10)
local RAIN_STRAIGHT_LIFETIME = NumberRange.new(0.8)
local RAIN_STRAIGHT_MAX_RATE = 600							-- Maximum rate for the straight rain emitter
local RAIN_STRAIGHT_MAX_SPEED = 60							-- Maximum speed for the straight rain emitter

local RAIN_TOPDOWN_ASSET = "rbxassetid://1822856633"		-- Some properties of the top-down rain particle effect
local RAIN_TOPDOWN_ALPHA_LOW = 0.85							-- Minimum particle transparency for the top-down rain emitter
local RAIN_TOPDOWN_SIZE = NumberSequence.new {
	NumberSequenceKeypoint.new(0, 5.33, 2.75);
	NumberSequenceKeypoint.new(1, 5.33, 2.75);
}		local RAIN_TOPDOWN_LIFETIME = NumberRange.new(0.8)
local RAIN_TOPDOWN_ROTATION = NumberRange.new(0,360)
local RAIN_TOPDOWN_MAX_RATE = 600							-- Maximum rate for the top-down rain emitter
local RAIN_TOPDOWN_MAX_SPEED = 60							-- Maximum speed for the top-down rain emitter

local RAIN_SPLASH_ASSET = "rbxassetid://1822856633"			-- Some properties of the splash particle effect
local RAIN_SPLASH_ALPHA_LOW = 0.6							-- Minimum particle transparency for the splash emitters
local RAIN_SPLASH_SIZE = NumberSequence.new {				NumberSequenceKeypoint.new(0, 0);
	NumberSequenceKeypoint.new(.4, 3);
	NumberSequenceKeypoint.new(1, 0);
}
local RAIN_SPLASH_LIFETIME = NumberRange.new(0.1, 0.15)
local RAIN_SPLASH_ROTATION = NumberRange.new(0,360)
local RAIN_SPLASH_NUM = 20									-- Amount of splashes per frame
local RAIN_SPLASH_CORRECTION_Y = .5							-- Offset from impact position for visual reasons
local RAIN_SPLASH_STRAIGHT_OFFSET_Y = 50					-- Offset against rain direction for straight rain particles from splash position
local RAIN_NOSPLASH_STRAIGHT_OFFSET_Y_MIN = 20				-- Min/max vertical offset from camera height for straight rain particles
local RAIN_NOSPLASH_STRAIGHT_OFFSET_Y_MAX = 100				-- when no splash position could be found (i.e. no floor at that XZ-column)

local RAIN_OCCLUDED_MINSPEED = 70							-- Minimum speed for the occluded straight rain emitters
local RAIN_OCCLUDED_MAXSPEED = 100							-- Maximum speed for the occluded straight rain emitters
local RAIN_OCCLUDED_SPREAD = Vector2.new(10,10)				-- Spread angle for the occluded straight rain emitters
local RAIN_OCCLUDED_MAXINTENSITY = 2						-- How many occluded straight rain particles are emitted for every splash for max intensity

local RAIN_OCCLUDECHECK_OFFSET_Y = 500						-- Vertical offset from camera height to start scanning downward from for splashes
local RAIN_OCCLUDECHECK_OFFSET_XZ_MIN = -100				-- Range of possible XZ offset values from camera XZ position for the splashes
local RAIN_OCCLUDECHECK_OFFSET_XZ_MAX = 100
local RAIN_OCCLUDECHECK_SCAN_Y = 550						-- Scan magnitude along rain path

local RAIN_UPDATE_PERIOD = 6								-- Update the transparency of the main emitters + volume of rain inside every X frames

local RAIN_VOLUME_SCAN_RADIUS = 35							-- Defining grid for checking how far the camera is away from a spot exposed to rain
local RAIN_VOLUME_SCAN_GRID = {								-- Unit range grid for scanning how far away user is from rain space
	-- range 0.2, 4 pts
	Vector3.new(0.141421363, 0, 0.141421363);
	Vector3.new(-0.141421363, 0, 0.141421363);
	Vector3.new(-0.141421363, 0, -0.141421363);
	Vector3.new(0.141421363, 0, -0.141421363);
	-- range 0.4, 8 pts
	Vector3.new(0.400000006, 0, 0);
	Vector3.new(0.282842726, 0, 0.282842726);
	Vector3.new(2.44929371e-17, 0, 0.400000006);
	Vector3.new(-0.282842726, 0, 0.282842726);
	Vector3.new(-0.400000006, 0, 4.89858741e-17);
	Vector3.new(-0.282842726, 0, -0.282842726);
	Vector3.new(-7.34788045e-17, 0, -0.400000006);
	Vector3.new(0.282842726, 0, -0.282842726);
	-- range 0.6, 10 pts
	Vector3.new(0.600000024, 0, 0);
	Vector3.new(0.485410213, 0, 0.352671146);
	Vector3.new(0.185410202, 0, 0.570633948);
	Vector3.new(-0.185410202, 0, 0.570633948);
	Vector3.new(-0.485410213, 0, 0.352671146);
	Vector3.new(-0.600000024, 0, 7.34788112e-17);
	Vector3.new(-0.485410213, 0, -0.352671146);
	Vector3.new(-0.185410202, 0, -0.570633948);
	Vector3.new(0.185410202, 0, -0.570633948);
	Vector3.new(0.485410213, 0, -0.352671146);
	-- range 0.8, 12 pts
	Vector3.new(0.772740662, 0, 0.207055241);
	Vector3.new(0.565685451, 0, 0.565685451);
	Vector3.new(0.207055241, 0, 0.772740662);
	Vector3.new(-0.207055241, 0, 0.772740662);
	Vector3.new(-0.565685451, 0, 0.565685451);
	Vector3.new(-0.772740662, 0, 0.207055241);
	Vector3.new(-0.772740662, 0, -0.207055241);
	Vector3.new(-0.565685451, 0, -0.565685451);
	Vector3.new(-0.207055241, 0, -0.772740662);
	Vector3.new(0.207055241, 0, -0.772740662);
	Vector3.new(0.565685451, 0, -0.565685451);
	Vector3.new(0.772740662, 0, -0.207055241);
}


-- Enumerators:

local CollisionMode = {
	None = 0;
	Whitelist = 1;
	Blacklist = 2;
	Function = 3;
}


-- Variables & setup:

-- services
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local GlobalModifier = Instance.new("NumberValue")			-- modifier for rain visibility for disabling/enabling over time span
GlobalModifier.Value = 1									-- 0 = fully visible, 1 = invisible

local connections = {}										-- Stores connections to RunService signals when enabled

local disabled = true										-- Value to figure out whether we are moving towards a disabled state (useful during tweens)

local rainDirection = RAIN_DEFAULT_DIRECTION				-- Direction that rain falls into

local currentCeiling = nil									-- Y coordinate of ceiling (if present)

local collisionMode = CollisionMode.None					-- Collision mode (from Rain.CollisionMode) for raycasting
local collisionList = nil									-- Blacklist/whitelist for raycasting
local collisionFunc = nil									-- Raycasting test function for when collisionMode == Rain.CollisionMode.Function

local straightLowAlpha = 1									-- Current transparency for straight rain particles
local topdownLowAlpha = 1									-- Current transparency for top-down rain particles
local intensityOccludedRain = 0								-- Current intensity of occluded rain particles
local numSplashes = 0										-- Current number of generated splashes per frame
local volumeTarget = 0										-- Current (target of tween for) sound volume

-- shorthands
local v3 = Vector3.new
local NSK010 = NumberSequenceKeypoint.new(0, 1, 0)
local NSK110 = NumberSequenceKeypoint.new(1, 1, 0)

local volumeScanGrid = {}									-- Pre-generate grid used for raining area distance scanning
for _,v in RAIN_VOLUME_SCAN_GRID do
	table.insert(volumeScanGrid, v * RAIN_VOLUME_SCAN_RADIUS)
end
table.sort(volumeScanGrid, function(a,b)					-- Optimization: sort from close to far away for fast evaluation if closeby
	return a.magnitude < b.magnitude
end)

-- sound group for easy main volume tweaking
local SoundGroup = Instance.new("SoundGroup")
SoundGroup.Name = "__RainSoundGroup"
SoundGroup.Volume = RAIN_SOUND_BASEVOLUME
SoundGroup.Archivable = false

local Sound = Instance.new("Sound")
Sound.Name = "RainSound"
Sound.Volume = volumeTarget
Sound.SoundId = RAIN_SOUND_ASSET
Sound.Looped = true
Sound.SoundGroup = SoundGroup
Sound.Parent = SoundGroup
Sound.Archivable = false

-- emitter block around camera used when outside
local Emitter do
	Emitter = Instance.new("Part")
	Emitter.Transparency = 1
	Emitter.Anchored = true
	Emitter.CanCollide = false
	Emitter.Locked = false
	Emitter.Archivable = false
	Emitter.TopSurface = Enum.SurfaceType.Smooth
	Emitter.BottomSurface = Enum.SurfaceType.Smooth
	Emitter.Name = "__RainEmitter"
	Emitter.Size = MIN_SIZE
	Emitter.Archivable = false
	local straight = Instance.new("ParticleEmitter")
	straight.Name = "RainStraight"
	straight.LightEmission = RAIN_DEFAULT_LIGHTEMISSION
	straight.LightInfluence = RAIN_DEFAULT_LIGHTINFLUENCE
	straight.Size = RAIN_STRAIGHT_SIZE
	straight.Texture = RAIN_STRAIGHT_ASSET
	straight.LockedToPart = true
	straight.Enabled = false
	straight.Lifetime = RAIN_STRAIGHT_LIFETIME
	straight.Rate = RAIN_STRAIGHT_MAX_RATE
	straight.Speed = NumberRange.new(RAIN_STRAIGHT_MAX_SPEED)
	straight.EmissionDirection = Enum.NormalId.Bottom
	straight.Parent = Emitter
	local topdown = Instance.new("ParticleEmitter")
	topdown.Name = "RainTopDown"
	topdown.LightEmission = RAIN_DEFAULT_LIGHTEMISSION
	topdown.LightInfluence = RAIN_DEFAULT_LIGHTINFLUENCE
	topdown.Size = RAIN_TOPDOWN_SIZE
	topdown.Texture = RAIN_TOPDOWN_ASSET
	topdown.LockedToPart = true
	topdown.Enabled = false
	topdown.Rotation = RAIN_TOPDOWN_ROTATION
	topdown.Lifetime = RAIN_TOPDOWN_LIFETIME
	topdown.Rate = RAIN_TOPDOWN_MAX_RATE
	topdown.Speed = NumberRange.new(RAIN_TOPDOWN_MAX_SPEED)
	topdown.EmissionDirection = Enum.NormalId.Bottom
	topdown.Parent = Emitter
end

local splashAttachments, rainAttachments do
	splashAttachments = {}
	rainAttachments = {}
	for i = 1, RAIN_SPLASH_NUM do
			-- splashes on ground
		local splashAttachment = Instance.new("Attachment")
		splashAttachment.Name = "__RainSplashAttachment"
		local splash = Instance.new("ParticleEmitter")
		splash.LightEmission = RAIN_DEFAULT_LIGHTEMISSION
		splash.LightInfluence = RAIN_DEFAULT_LIGHTINFLUENCE
		splash.Size = RAIN_SPLASH_SIZE
		splash.Texture = RAIN_SPLASH_ASSET
		splash.Rotation = RAIN_SPLASH_ROTATION
		splash.Lifetime = RAIN_SPLASH_LIFETIME
		splash.Transparency = NumberSequence.new {
			NSK010;
			NumberSequenceKeypoint.new(RAIN_TRANSPARENCY_T1, RAIN_SPLASH_ALPHA_LOW, 0);
			NumberSequenceKeypoint.new(RAIN_TRANSPARENCY_T2, RAIN_SPLASH_ALPHA_LOW, 0);
			NSK110;
		}
		splash.Enabled = false
		splash.Rate = 0
		splash.Speed = NumberRange.new(0)
		splash.Name = "RainSplash"
		splash.Parent = splashAttachment
		splashAttachment.Archivable = false
		table.insert(splashAttachments, splashAttachment)
			-- occluded rain particle generation
		local rainAttachment = Instance.new("Attachment")
		rainAttachment.Name = "__RainOccludedAttachment"
		local straightOccluded = Emitter.RainStraight:Clone()
		straightOccluded.Speed = NumberRange.new(RAIN_OCCLUDED_MINSPEED, RAIN_OCCLUDED_MAXSPEED)
		straightOccluded.SpreadAngle = RAIN_OCCLUDED_SPREAD
		straightOccluded.LockedToPart = false
		straightOccluded.Enabled = false
		straightOccluded.Parent = rainAttachment
		local topdownOccluded = Emitter.RainTopDown:Clone()
		topdownOccluded.Speed = NumberRange.new(RAIN_OCCLUDED_MINSPEED, RAIN_OCCLUDED_MAXSPEED)
		topdownOccluded.SpreadAngle = RAIN_OCCLUDED_SPREAD
		topdownOccluded.LockedToPart = false
		topdownOccluded.Enabled = false
		topdownOccluded.Parent = rainAttachment
		rainAttachment.Archivable = false
		table.insert(rainAttachments, rainAttachment)
		end
end


-- Helper methods:

local ignoreEmitterList = { Emitter }

local raycastFunctions = {
	[CollisionMode.None] = function(ray, ignoreCharacter)
		return workspace:FindPartOnRayWithIgnoreList(ray, ignoreCharacter and {Emitter, Players.LocalPlayer and Players.LocalPlayer.Character} or ignoreEmitterList)
	end;
	[CollisionMode.Blacklist] = function(ray)
		return workspace:FindPartOnRayWithIgnoreList(ray, collisionList)
	end;
	[CollisionMode.Whitelist] = function(ray)
		return workspace:FindPartOnRayWithWhitelist(ray, collisionList)
	end;
	[CollisionMode.Function] = function(ray)
		local destination = ray.Origin + ray.Direction
		-- draw multiple raycasts concatenated to each other until no hit / valid hit found
		while ray.Direction.magnitude > 0.001 do
			local part, pos, norm, mat = workspace:FindPartOnRayWithIgnoreList(ray, ignoreEmitterList)
			if not part or collisionFunc(part) then
				return part, pos, norm, mat
			end
			local start = pos + ray.Direction.Unit * 0.001
			ray = Ray.new(start, destination - start)
		end
	end;
}
local raycast = raycastFunctions[collisionMode]

local function connectLoop()
	local rand = Random.new()
	local inside = true					-- Whether camera is currently in a spot occluded from the sky
	local frame = RAIN_UPDATE_PERIOD	-- Frame counter, and force update cycle right now
	-- Update Emitter on RenderStepped since it needs to be synced to Camera
	table.insert(connections, RunService.RenderStepped:connect(function()
			-- Check if camera is outside or inside
		local part, position = raycast(Ray.new(workspace.CurrentCamera.CFrame.p, -rainDirection * RAIN_SCANHEIGHT), true)
			if (not currentCeiling or workspace.CurrentCamera.CFrame.p.y <= currentCeiling) and not part then
					-- Camera is outside and under ceiling
						if volumeTarget < 1 and not disabled then
				volumeTarget = 1
				TweenService:Create(Sound, TweenInfo.new(.5), {Volume = 1}):Play()
			end
					frame = RAIN_UPDATE_PERIOD
					local t = math.abs(workspace.CurrentCamera.CFrame.lookVector:Dot(rainDirection))
					local center = workspace.CurrentCamera.CFrame.p
			local right = workspace.CurrentCamera.CFrame.lookVector:Cross(-rainDirection)
			right = right.magnitude > 0.001 and right.unit or -rainDirection
			local forward = rainDirection:Cross(right).unit
					Emitter.Size = v3(
				RAIN_EMITTER_DIM_DEFAULT,
				RAIN_EMITTER_DIM_DEFAULT,
				RAIN_EMITTER_DIM_DEFAULT + (1 - t)*(RAIN_EMITTER_DIM_MAXFORWARD - RAIN_EMITTER_DIM_DEFAULT)
			)
					Emitter.CFrame =
				CFrame.new(
					center.x, center.y, center.z,
					right.x, -rainDirection.x, forward.x,
					right.y, -rainDirection.y, forward.y,
					right.z, -rainDirection.z, forward.z
				)
				+ (1 - t) * workspace.CurrentCamera.CFrame.lookVector * Emitter.Size.Z/3
				- t * rainDirection * RAIN_EMITTER_UP_MODIFIER
					Emitter.RainStraight.Enabled = true
			Emitter.RainTopDown.Enabled = true
					inside = false
				else
					-- Camera is inside / above ceiling
					Emitter.RainStraight.Enabled = false
			Emitter.RainTopDown.Enabled = false
				inside = true
				end
		end))

	-- Do the other effects on Stepped
	local signal = RunService:IsRunning() and RunService.Stepped or RunService.RenderStepped
	table.insert(connections, signal:connect(function()
			frame = frame + 1
			-- Only do some updates once every few frames
		if frame >= RAIN_UPDATE_PERIOD then
					-- Measure of how much camera is facing down (0-1)
			local t = math.abs(workspace.CurrentCamera.CFrame.lookVector:Dot(rainDirection))
					-- More looking down = see straight particles less and see top-down particles more
			local straightSequence = NumberSequence.new {
				NSK010;
				NumberSequenceKeypoint.new(RAIN_TRANSPARENCY_T1, (1 - t)*straightLowAlpha + t, 0);
				NumberSequenceKeypoint.new(RAIN_TRANSPARENCY_T2, (1 - t)*straightLowAlpha + t, 0);
				NSK110;
			}
			local topdownSequence = NumberSequence.new {
				NSK010;
				NumberSequenceKeypoint.new(RAIN_TRANSPARENCY_T1, t*topdownLowAlpha + (1 - t), 0);
				NumberSequenceKeypoint.new(RAIN_TRANSPARENCY_T2, t*topdownLowAlpha + (1 - t), 0);
				NSK110;
			}
					-- Find desired rotation for the straight rain particles
			local mapped = workspace.Camera.CFrame:inverse() * (workspace.Camera.CFrame.p - rainDirection)
			local straightRotation = NumberRange.new(math.deg(math.atan2(-mapped.x, mapped.y)))
					if inside then
							-- Update emitter properties
				for _,v in rainAttachments do
					v.RainStraight.Transparency = straightSequence
					v.RainStraight.Rotation = straightRotation
					v.RainTopDown.Transparency = topdownSequence
				end
				if not disabled then
					-- Only do occluded volume check if not moving towards disabled state
					local volume = 0
					if (not currentCeiling or workspace.CurrentCamera.CFrame.p.y <= currentCeiling) then
						-- Check how far away camera is from a space open to the sky using volume scan grid
						local minDistance = RAIN_VOLUME_SCAN_RADIUS
						local rayDirection = -rainDirection * RAIN_SCANHEIGHT
						for i = 1, #volumeScanGrid do -- In order, so first hit is closest
							if not raycast(Ray.new(workspace.CurrentCamera.CFrame * volumeScanGrid[i], rayDirection), true) then
								minDistance = volumeScanGrid[i].magnitude
								break
							end
						end
						-- Volume is inversely proportionate to minimum distance
						volume = 1 - minDistance / RAIN_VOLUME_SCAN_RADIUS
										end
									if math.abs(volume - volumeTarget) > .01 then
						-- Value is sufficiently different from previous target, overwrite it
						volumeTarget = volume
						TweenService:Create(Sound, TweenInfo.new(1), {Volume = volumeTarget}):Play()
					end
				end
			else
				-- Update emitter properties
				Emitter.RainStraight.Transparency = straightSequence
				Emitter.RainStraight.Rotation = straightRotation
				Emitter.RainTopDown.Transparency = topdownSequence
			end
			-- Reset frame counter
			frame = 0
		end
		local center = workspace.CurrentCamera.CFrame.p
		local right = workspace.CurrentCamera.CFrame.lookVector:Cross(-rainDirection)
		right = right.magnitude > 0.001 and right.unit or -rainDirection
		local forward = rainDirection:Cross(right).unit
		local transform = CFrame.new(
			center.x, center.y, center.z,
			right.x, -rainDirection.x, forward.x,
			right.y, -rainDirection.y, forward.y,
			right.z, -rainDirection.z, forward.z
		)
		local rayDirection = rainDirection * RAIN_OCCLUDECHECK_SCAN_Y
			-- Splash and occlusion effects
		for i = 1, numSplashes do
					local splashAttachment = splashAttachments[i]
			local rainAttachment = rainAttachments[i]
					-- Sample random splash position
			local x = rand:NextNumber(RAIN_OCCLUDECHECK_OFFSET_XZ_MIN, RAIN_OCCLUDECHECK_OFFSET_XZ_MAX)
			local z = rand:NextNumber(RAIN_OCCLUDECHECK_OFFSET_XZ_MIN, RAIN_OCCLUDECHECK_OFFSET_XZ_MAX)
			local part, position, normal = raycast(Ray.new(transform * v3(x, RAIN_OCCLUDECHECK_OFFSET_Y, z), rayDirection))
					if part then
							-- Draw a splash at hit
				splashAttachment.Position = position + normal * RAIN_SPLASH_CORRECTION_Y
				splashAttachment.RainSplash:Emit(1)
							if inside then
									-- Draw occlusion rain particles a little bit above the splash position
					local corrected = position - rainDirection * RAIN_SPLASH_STRAIGHT_OFFSET_Y
					if currentCeiling and corrected.Y > currentCeiling and rainDirection.Y < 0 then
						corrected = corrected + rainDirection * (currentCeiling - corrected.Y) / rainDirection.Y
					end
					rainAttachment.CFrame = transform - transform.p + corrected
					rainAttachment.RainStraight:Emit(intensityOccludedRain)
					rainAttachment.RainTopDown:Emit(intensityOccludedRain)
								end
						elseif inside then
							-- Draw occlusion rain particles on the XZ-position at around the camera's height
				local corrected = transform * v3(x, rand:NextNumber(RAIN_NOSPLASH_STRAIGHT_OFFSET_Y_MIN, RAIN_NOSPLASH_STRAIGHT_OFFSET_Y_MAX), z)
				if currentCeiling and corrected.Y > currentCeiling and rainDirection.Y < 0 then
					corrected = corrected + rainDirection * (currentCeiling - corrected.Y) / rainDirection.Y
				end
				rainAttachment.CFrame = transform - transform.p + corrected
				rainAttachment.RainStraight:Emit(intensityOccludedRain)
				rainAttachment.RainTopDown:Emit(intensityOccludedRain)
						end
				end
		end))

end

local function disconnectLoop()
	-- If present, disconnect all RunService connections
	if #connections > 0 then
		for _,v in connections do
			v:disconnect()
		end
		connections = {}
	end
end

local function disableSound(tweenInfo)
	-- Tween the rain sound to be mute over a given easing function
	volumeTarget = 0
	local tween = TweenService:Create(Sound, tweenInfo, {Volume = 0})
	tween.Completed:connect(function(state)
		if state == Enum.PlaybackState.Completed then
			Sound:Stop()
		end
		tween:Destroy()
	end)
	tween:Play()
end

local function disable()
	disconnectLoop()
	-- Hide Emitter
	Emitter.RainStraight.Enabled = false
	Emitter.RainTopDown.Enabled = false
	Emitter.Size = MIN_SIZE
	-- Disable sound now if not tweened into disabled state beforehand
	if not disabled then
		disableSound(TweenInfo.new(RAIN_SOUND_FADEOUT_TIME))
	end
end

-- Shorthand for creating a tweenable "variable" using value object
local function makeProperty(valueObjectClass, defaultValue, setter)
	local valueObject = Instance.new(valueObjectClass)
	if defaultValue then
		valueObject.Value = defaultValue
	end
	valueObject.Changed:connect(setter)
	setter(valueObject.Value)
	return valueObject
end

local Color = makeProperty("Color3Value", RAIN_DEFAULT_COLOR, function(value)
	local value = ColorSequence.new(value)
	Emitter.RainStraight.Color = value
	Emitter.RainTopDown.Color = value
	for _,v in splashAttachments do
		v.RainSplash.Color = value
	end
	for _,v in rainAttachments do
		v.RainStraight.Color = value
		v.RainTopDown.Color = value
	end
end)

local function updateTransparency(value)
	local opacity = (1 - value) * (1 - GlobalModifier.Value)
	local transparency = 1 - opacity
	straightLowAlpha = RAIN_STRAIGHT_ALPHA_LOW * opacity + transparency
	topdownLowAlpha = RAIN_TOPDOWN_ALPHA_LOW * opacity + transparency
	local splashSequence = NumberSequence.new {
		NSK010;
		NumberSequenceKeypoint.new(RAIN_TRANSPARENCY_T1, opacity*RAIN_SPLASH_ALPHA_LOW + transparency, 0);
		NumberSequenceKeypoint.new(RAIN_TRANSPARENCY_T2, opacity*RAIN_SPLASH_ALPHA_LOW + transparency, 0);
		NSK110;
	}
	for _,v in splashAttachments do
		v.RainSplash.Transparency = splashSequence
	end
end
local Transparency = makeProperty("NumberValue", RAIN_DEFAULT_TRANSPARENCY, updateTransparency)
GlobalModifier.Changed:connect(updateTransparency)

local SpeedRatio = makeProperty("NumberValue", RAIN_DEFAULT_SPEEDRATIO, function(value)
	Emitter.RainStraight.Speed = NumberRange.new(value * RAIN_STRAIGHT_MAX_SPEED)
	Emitter.RainTopDown.Speed = NumberRange.new(value * RAIN_TOPDOWN_MAX_SPEED)
end)

local IntensityRatio = makeProperty("NumberValue", RAIN_DEFAULT_INTENSITYRATIO, function(value)
	Emitter.RainStraight.Rate = RAIN_STRAIGHT_MAX_RATE * value
	Emitter.RainTopDown.Rate = RAIN_TOPDOWN_MAX_RATE * value
	intensityOccludedRain = math.ceil(RAIN_OCCLUDED_MAXINTENSITY * value)
	numSplashes = RAIN_SPLASH_NUM * value
end)

local LightEmission = makeProperty("NumberValue", RAIN_DEFAULT_LIGHTEMISSION, function(value)
	Emitter.RainStraight.LightEmission = value
	Emitter.RainTopDown.LightEmission = value
	for _,v in rainAttachments do
		v.RainStraight.LightEmission = value
		v.RainTopDown.LightEmission = value
	end
	for _,v in splashAttachments do
		v.RainSplash.LightEmission = value
	end
end)

local LightInfluence = makeProperty("NumberValue", RAIN_DEFAULT_LIGHTINFLUENCE, function(value)
	Emitter.RainStraight.LightInfluence = value
	Emitter.RainTopDown.LightInfluence = value
	for _,v in rainAttachments do
		v.RainStraight.LightInfluence = value
		v.RainTopDown.LightInfluence = value
	end
	for _,v in splashAttachments do
		v.RainSplash.LightInfluence = value
	end
end)

local RainDirection = makeProperty("Vector3Value", RAIN_DEFAULT_DIRECTION, function(value)
	if value.magnitude > 0.001 then
		rainDirection = value.unit
	end
end)


-- Exposed API:

local Rain = {}

Rain.CollisionMode = CollisionMode

function Rain:Enable(tweenInfo)
	if tweenInfo ~= nil and typeof(tweenInfo) ~= "TweenInfo" then
		error("bad argument #1 to 'Enable' (TweenInfo expected, got " .. typeof(tweenInfo) .. ")", 2)
	end
	disconnectLoop() -- Just in case :Enable(..) is called multiple times on accident
	Emitter.RainStraight.Enabled = true
	Emitter.RainTopDown.Enabled = true
	Emitter.Parent = workspace.CurrentCamera
	for i = 1, RAIN_SPLASH_NUM do
		splashAttachments[i].Parent = workspace.Terrain
		rainAttachments[i].Parent = workspace.Terrain
	end
	if RunService:IsRunning() then -- don't need sound in studio preview, it won't work anyway
		SoundGroup.Parent = game:GetService("SoundService")
	end
	connectLoop()
	if tweenInfo then
		TweenService:Create(GlobalModifier, tweenInfo, {Value = 0}):Play()
	else
		GlobalModifier.Value = 0
	end
	if not Sound.Playing then
		Sound:Play()
		Sound.TimePosition = Random.new():NextNumber() * Sound.TimeLength
	end
	disabled = false
end

function Rain:Disable(tweenInfo)
	if tweenInfo ~= nil and typeof(tweenInfo) ~= "TweenInfo" then
		error("bad argument #1 to 'Disable' (TweenInfo expected, got " .. typeof(tweenInfo) .. ")", 2)
	end
	if tweenInfo then
		local tween = TweenService:Create(GlobalModifier, tweenInfo, {Value = 1})
		tween.Completed:connect(function(state)
			if state == Enum.PlaybackState.Completed then
				-- Only disable the rain completely once the visual effects are faded out
				disable()
			end
			tween:Destroy()
		end)
		tween:Play()
		-- Start tweening out sound now as well
		disableSound(tweenInfo)
	else
		GlobalModifier.Value = 1
		disable()
	end
	disabled = true
end

function Rain:SetColor(value, tweenInfo)
		if typeof(value) ~= "Color3" then
		error("bad argument #1 to 'SetColor' (Color3 expected, got " .. typeof(value) .. ")", 2)
	elseif tweenInfo ~= nil and typeof(tweenInfo) ~= "TweenInfo" then
		error("bad argument #2 to 'SetColor' (TweenInfo expected, got " .. typeof(tweenInfo) .. ")", 2)
	end
	if tweenInfo then
		TweenService:Create(Color, tweenInfo, {Value = value}):Play()
	else
		Color.Value = value
	end
end

local function makeRatioSetter(methodName, valueObject)
	-- Shorthand because most of the remaining property setters are very similar
	return function(_, value, tweenInfo)
			if typeof(value) ~= "number" then
			error("bad argument #1 to '" .. methodName .. "' (number expected, got " .. typeof(value) .. ")", 2)
		elseif tweenInfo ~= nil and typeof(tweenInfo) ~= "TweenInfo" then
			error("bad argument #2 to '" .. methodName .. "' (TweenInfo expected, got " .. typeof(tweenInfo) .. ")", 2)
		end
			value = math.clamp(value, 0, 1)
			if tweenInfo then
			TweenService:Create(valueObject, tweenInfo, {Value = value}):Play()
		else
			valueObject.Value = value
		end
		end
end

Rain.SetTransparency = makeRatioSetter("SetTransparency", Transparency)
Rain.SetSpeedRatio = makeRatioSetter("SetSpeedRatio", SpeedRatio)
Rain.SetIntensityRatio = makeRatioSetter("SetIntensityRatio", IntensityRatio)
Rain.SetLightEmission = makeRatioSetter("SetLightEmission", LightEmission)
Rain.SetLightInfluence = makeRatioSetter("SetLightInfluence", LightInfluence)

function Rain:SetVolume(volume, tweenInfo)
	if typeof(volume) ~= "number" then
		error("bad argument #1 to 'SetVolume' (number expected, got " .. typeof(volume) .. ")", 2)
	elseif tweenInfo ~= nil and typeof(tweenInfo) ~= "TweenInfo" then
		error("bad argument #2 to 'SetVolume' (TweenInfo expected, got " .. typeof(tweenInfo) .. ")", 2)
	end
	if tweenInfo then
		TweenService:Create(SoundGroup, tweenInfo, {Volume = volume}):Play()
	else
		SoundGroup.Volume = volume
	end
end

function Rain:SetDirection(direction, tweenInfo)
	if typeof(direction) ~= "Vector3" then
		error("bad argument #1 to 'SetDirection' (Vector3 expected, got " .. typeof(direction) .. ")", 2)
	elseif tweenInfo ~= nil and typeof(tweenInfo) ~= "TweenInfo" then
		error("bad argument #2 to 'SetDirection' (TweenInfo expected, got " .. typeof(tweenInfo) .. ")", 2)
	end
	if not (direction.unit.magnitude > 0) then -- intentional statement formatting since NaN comparison
		warn("Attempt to set rain direction to a zero-length vector, falling back on default direction = (" .. tostring(RAIN_DEFAULT_DIRECTION) .. ")")
		direction = RAIN_DEFAULT_DIRECTION
	end
	if tweenInfo then
		TweenService:Create(RainDirection, tweenInfo, {Value = direction}):Play()
	else
		RainDirection.Value = direction
	end
end

function Rain:SetCeiling(ceiling)
	if ceiling ~= nil and typeof(ceiling) ~= "number" then
		error("bad argument #1 to 'SetCeiling' (number expected, got " .. typeof(ceiling) .. ")", 2)
	end
	currentCeiling = ceiling
end

function Rain:SetStraightTexture(asset)
	if typeof(asset) ~= "string" then
		error("bad argument #1 to 'SetStraightTexture' (string expected, got " .. typeof(asset) .. ")", 2)
	end
	Emitter.RainStraight.Texture = asset
	for _,v in rainAttachments do
		v.RainStraight.Texture = asset
	end
end

function Rain:SetTopDownTexture(asset)
	if typeof(asset) ~= "string" then
		error("bad argument #1 to 'SetStraightTexture' (string expected, got " .. typeof(asset) .. ")", 2)
	end
	Emitter.RainTopDown.Texture = asset
	for _,v in rainAttachments do
		v.RainTopDown.Texture = asset
	end
end

function Rain:SetSplashTexture(asset)
	if typeof(asset) ~= "string" then
		error("bad argument #1 to 'SetStraightTexture' (string expected, got " .. typeof(asset) .. ")", 2)
	end
	for _,v in splashAttachments do
		v.RainSplash.Texture = asset
	end
end

function Rain:SetSoundId(asset)
	if typeof(asset) ~= "string" then
		error("bad argument #1 to 'SetSoundId' (string expected, got " .. typeof(asset) .. ")", 2)
	end
	Sound.SoundId = asset
end

function Rain:SetCollisionMode(mode, param)
	if mode == CollisionMode.None then
			-- Regular mode needs no white/blacklist or test function
		collisionList = nil
		collisionFunc = nil
		elseif mode == CollisionMode.Blacklist then
			if typeof(param) == "Instance" then
			-- Add Emitter anyway, since users will probably not expect collisions with emitter block regardless
			collisionList = {param, Emitter}
		elseif typeof(param) == "table" then
			for i = 1, #param do
				if typeof(param[i]) ~= "Instance" then
					error("bad argument #2 to 'SetCollisionMode' (blacklist contained a " .. typeof(param[i]) .. " on index " .. tostring(i) .. " which is not an Instance)", 2)
				end
			end
			collisionList = {Emitter} -- see above
			for i = 1, #param do
				table.insert(collisionList, param[i])
			end
		else
			error("bad argument #2 to 'SetCollisionMode (Instance or array of Instance expected, got " .. typeof(param) .. ")'", 2)
		end
			-- Blacklist does not need a test function
		collisionFunc = nil
		elseif mode == CollisionMode.Whitelist then
			if typeof(param) == "Instance" then
			collisionList = {param}
		elseif typeof(param) == "table" then
			for i = 1, #param do
				if typeof(param[i]) ~= "Instance" then
					error("bad argument #2 to 'SetCollisionMode' (whitelist contained a " .. typeof(param[i])  .. " on index " .. tostring(i) .. " which is not an Instance)", 2)
				end
			end
			collisionList = {}
			for i = 1, #param do
				table.insert(collisionList, param[i])
			end
		else
			error("bad argument #2 to 'SetCollisionMode (Instance or array of Instance expected, got " .. typeof(param) .. ")'", 2)
		end
			-- Whitelist does not need a test function
		collisionFunc = nil
		elseif mode == CollisionMode.Function then
			if typeof(param) ~= "function" then
			error("bad argument #2 to 'SetCollisionMode' (function expected, got " .. typeof(param) .. ")", 2)
		end
			-- Test function does not need a list
		collisionList = nil
			collisionFunc = param
		else
		error("bad argument #1 to 'SetCollisionMode (Rain.CollisionMode expected, got " .. typeof(param) .. ")'", 2)
	end
	collisionMode = mode
	raycast = raycastFunctions[mode]
end

return Rain]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Modules/Modules/HUDCommon"><![CDATA[-- Shared Fusion UI primitives for the game HUD.
-- Visual tokens sourced from tmp/aincrad-ui/tokens.css (Crystal dark palette).
-- Component patterns sourced from tmp/aincrad-ui/hud.jsx + shared.jsx.

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local TweenService = game:GetService('TweenService')

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local Signal = ReplicatedModules.Modules.Signal

local Module = {}

-- Fires AFTER Module.PALETTE is rewritten by ApplyTheme. Theme switching
-- now uses a walk-and-tween strategy in `ApplyTheme` itself (it scans the
-- master ScreenGui for color properties matching the OLD palette and
-- TweenService-creates each one to the new color). The signal is kept
-- around for any non-color follow-up work (e.g. re-rendering a viewport
-- whose lighting derived from PALETTE), but most callers don't need it
-- anymore — `BindLiveTheme` is a no-op for backward compatibility.
Module.OnPaletteChanged = Signal.New()

-- // Crystal palette (dark) — matches tokens.css // --
-- The PALETTE table is mutated in-place by `ApplyTheme`. Color3 values are
-- baked into Fusion trees at build time, so already-rendered widgets won't
-- reactively re-tint from a table mutation. Live re-tinting is achieved by
-- firing `OnPaletteChanged` after the mutation; long-lived widgets opt in
-- via `BindLiveTheme(Module)` from their Start function, which closes and
-- reopens them so their tree rebuilds against the new palette.
Module.THEMES = {
	['Crystal dark'] = {
		bg0       = Color3.fromRGB(5, 8, 15),     bg1 = Color3.fromRGB(11, 18, 34),
		bg2       = Color3.fromRGB(19, 27, 48),   panel = Color3.fromRGB(18, 28, 52),
		strokeHot = Color3.fromRGB(150, 220, 255),
		ink       = Color3.fromRGB(229, 236, 247),
		inkDim    = Color3.fromRGB(138, 160, 197),
		inkFaint  = Color3.fromRGB(85, 102, 133),
		accent    = Color3.fromRGB(126, 200, 255),
		accentHot = Color3.fromRGB(182, 227, 255),
		violet    = Color3.fromRGB(180, 157, 255),
		gold      = Color3.fromRGB(255, 215, 138),
		danger    = Color3.fromRGB(255, 93, 109),
		success   = Color3.fromRGB(106, 227, 168),
	},
	['Aincrad day'] = {
		bg0       = Color3.fromRGB(28, 30, 36),   bg1 = Color3.fromRGB(48, 52, 62),
		bg2       = Color3.fromRGB(70, 76, 90),   panel = Color3.fromRGB(60, 66, 80),
		strokeHot = Color3.fromRGB(255, 245, 215),
		ink       = Color3.fromRGB(245, 240, 230),
		inkDim    = Color3.fromRGB(200, 192, 170),
		inkFaint  = Color3.fromRGB(140, 132, 110),
		accent    = Color3.fromRGB(255, 197, 110),
		accentHot = Color3.fromRGB(255, 220, 160),
		violet    = Color3.fromRGB(220, 184, 240),
		gold      = Color3.fromRGB(255, 230, 140),
		danger    = Color3.fromRGB(232, 92, 92),
		success   = Color3.fromRGB(140, 220, 150),
	},
	['Labyrinth red'] = {
		-- Reworked: deeper, less-pink reds with a subtle ember-orange
		-- accent. The previous palette skewed bubble-gum because every
		-- channel had a fair amount of green; the new bg+panel ladder
		-- stays in the wine/blood family and the accents push toward
		-- crimson rather than coral.
		bg0       = Color3.fromRGB(18, 6, 10),    bg1 = Color3.fromRGB(34, 12, 18),
		bg2       = Color3.fromRGB(58, 20, 28),   panel = Color3.fromRGB(48, 14, 22),
		strokeHot = Color3.fromRGB(255, 130, 120),
		ink       = Color3.fromRGB(252, 230, 226),
		inkDim    = Color3.fromRGB(210, 150, 150),
		inkFaint  = Color3.fromRGB(140, 80, 88),
		accent    = Color3.fromRGB(232, 60, 78),
		accentHot = Color3.fromRGB(255, 120, 110),
		violet    = Color3.fromRGB(200, 100, 160),
		gold      = Color3.fromRGB(255, 180, 90),
		danger    = Color3.fromRGB(255, 70, 80),
		success   = Color3.fromRGB(180, 220, 130),
	},
	['Royal purple'] = {
		-- Rich amethyst palette: deep violet panel with magenta accents
		-- and a warm gold for legendary highlights. Designed to feel
		-- regal — sits opposite the cool-blue Crystal dark theme on the
		-- saturation wheel.
		bg0       = Color3.fromRGB(12, 8, 22),    bg1 = Color3.fromRGB(24, 16, 44),
		bg2       = Color3.fromRGB(40, 28, 64),   panel = Color3.fromRGB(34, 22, 56),
		strokeHot = Color3.fromRGB(220, 180, 255),
		ink       = Color3.fromRGB(238, 230, 252),
		inkDim    = Color3.fromRGB(180, 160, 210),
		inkFaint  = Color3.fromRGB(120, 100, 150),
		accent    = Color3.fromRGB(180, 120, 255),
		accentHot = Color3.fromRGB(220, 170, 255),
		violet    = Color3.fromRGB(220, 150, 255),
		gold      = Color3.fromRGB(255, 210, 130),
		danger    = Color3.fromRGB(255, 90, 130),
		success   = Color3.fromRGB(140, 230, 180),
	},
	['Obsidian'] = {
		bg0       = Color3.fromRGB(2, 2, 4),      bg1 = Color3.fromRGB(8, 8, 12),
		bg2       = Color3.fromRGB(14, 14, 20),   panel = Color3.fromRGB(12, 12, 18),
		strokeHot = Color3.fromRGB(220, 220, 230),
		ink       = Color3.fromRGB(232, 232, 240),
		inkDim    = Color3.fromRGB(150, 150, 160),
		inkFaint  = Color3.fromRGB(85, 85, 95),
		accent    = Color3.fromRGB(200, 200, 215),
		accentHot = Color3.fromRGB(245, 245, 255),
		violet    = Color3.fromRGB(155, 145, 200),
		gold      = Color3.fromRGB(220, 200, 140),
		danger    = Color3.fromRGB(220, 80, 95),
		success   = Color3.fromRGB(110, 200, 150),
	},
}
Module.PALETTE = {}
for k, v in Module.THEMES['Crystal dark'] do Module.PALETTE[k] = v end

-- Master-ScreenGui singleton name + display order. Created lazily on first
-- `ensureScreenGui` call and reused thereafter. Declared up here so
-- `ApplyTheme`'s walk-and-tween can find the master ScreenGui by name.
local MASTER_GUI_NAME = 'HUD'

-- Walk-and-tween config — the property table below is conservative on
-- purpose. Adding a class/property here makes it eligible for in-place
-- recoloring on theme change; everything else is left untouched (so e.g.
-- RARITY colors and hardcoded health-bar tones don't get clobbered).
local THEME_COLOR_PROPS: { [string]: { string } } = {
	Frame          = { 'BackgroundColor3', 'BorderColor3' },
	TextLabel      = { 'BackgroundColor3', 'BorderColor3', 'TextColor3', 'TextStrokeColor3' },
	TextButton     = { 'BackgroundColor3', 'BorderColor3', 'TextColor3', 'TextStrokeColor3' },
	TextBox        = { 'BackgroundColor3', 'BorderColor3', 'TextColor3', 'TextStrokeColor3', 'PlaceholderColor3' },
	ImageLabel     = { 'BackgroundColor3', 'BorderColor3', 'ImageColor3' },
	ImageButton    = { 'BackgroundColor3', 'BorderColor3', 'ImageColor3' },
	ScrollingFrame = { 'BackgroundColor3', 'BorderColor3', 'ScrollBarImageColor3' },
	ViewportFrame  = { 'BackgroundColor3', 'BorderColor3', 'ImageColor3', 'Ambient', 'LightColor' },
	CanvasGroup    = { 'BackgroundColor3', 'BorderColor3' },
	UIStroke       = { 'Color' },
}
-- Tween length when fading colors between themes. Long enough to read as
-- a "rollout" (vs. an instant snap) without blocking the player from
-- doing anything else — the SettingsRegistry slider stays usable during
-- the tween.
local THEME_TWEEN_INFO = TweenInfo.new(
	0.35,
	Enum.EasingStyle.Quad,
	Enum.EasingDirection.Out
)

local function rgbKey(c: Color3): string
	return string.format('%d_%d_%d',
		math.floor(c.R * 255 + 0.5),
		math.floor(c.G * 255 + 0.5),
		math.floor(c.B * 255 + 0.5))
end

function Module.ApplyTheme(themeName: string)
	local theme = Module.THEMES[themeName]
	if not theme then return end
	-- Snapshot the OLD palette as an rgb→key map BEFORE we mutate it.
	-- Used to identify which currently-rendered properties carry a
	-- known palette color (and which key they map to).
	local oldByRgb: { [string]: string } = {}
	for paletteKey, color in Module.PALETTE do
		oldByRgb[rgbKey(color)] = paletteKey
	end
	-- Mutate PALETTE in place so future code paths read the new values.
	for k, v in theme do
		Module.PALETTE[k] = v
	end
	-- Walk the master HUD ScreenGui and tween every matching property
	-- to the new palette color. Avoids the heavy "close + reopen every
	-- widget" path that used to fire here.
	local Players = game:GetService('Players')
	local LocalPlayer = Players.LocalPlayer
	local playerGui = LocalPlayer and LocalPlayer:FindFirstChild('PlayerGui')
	local master = playerGui and playerGui:FindFirstChild(MASTER_GUI_NAME)
	if master then
		for _, inst in master:GetDescendants() do
			local props = THEME_COLOR_PROPS[inst.ClassName]
			if not props then continue end
			for _, prop in props do
				local ok, current = pcall(function() return (inst :: any)[prop] end)
				if not ok or typeof(current) ~= 'Color3' then continue end
				local matchedKey = oldByRgb[rgbKey(current)]
				if not matchedKey then continue end
				local newColor = Module.PALETTE[matchedKey]
				if newColor and newColor ~= current then
					TweenService:Create(inst, THEME_TWEEN_INFO, { [prop] = newColor }):Play()
				end
			end
		end
	end
	-- Notify any modules that need to react beyond color (e.g. viewport
	-- re-render). Color recoloring is already handled above.
	Module.OnPaletteChanged:Fire()
end

-- Backward-compatibility shim. Theme switching is now in-place via
-- `ApplyTheme`'s walk-and-tween, so no per-widget rebuild is needed.
-- Existing call sites can leave this in (it's a no-op) or remove the
-- call when convenient.
function Module.BindLiveTheme(_widget: any)
	-- Intentional no-op. Kept for callers that pre-date the in-place
	-- theme path. If a widget needs to react to themes for non-color
	-- reasons, hook `Module.OnPaletteChanged` directly.
end

-- Rarity tiers (hud.jsx rarityColor).
--
-- Each RGB shifted by 1 unit relative to the source palette so RARITY
-- colors NEVER exactly equal a PALETTE color. Without this offset, the
-- walk-and-tween in `ApplyTheme` would mis-match items currently tinted
-- by RARITY (e.g. uncommon = success in Crystal dark) and re-theme them
-- on every theme change. Visually indistinguishable from the source
-- values; the offset only affects rgb-key equality in the reverse map.
-- Components clamped at 255 are shifted -1 instead of +1.
Module.RARITY = {
	common    = Color3.fromRGB(155, 167, 185),
	uncommon  = Color3.fromRGB(107, 228, 169),
	rare      = Color3.fromRGB(127, 201, 254),
	epic      = Color3.fromRGB(201, 158, 254),
	legendary = Color3.fromRGB(254, 199, 113),
	mythic    = Color3.fromRGB(254, 110, 145),
}

-- // Fonts // --
-- Single custom font asset for every UI surface. The value is a Font
-- datatype, so call sites assign it to the `FontFace` property (NOT the
-- legacy `Font` Enum property). All four named slots resolve to the same
-- typeface today; the slot names are kept so per-role tweaks (e.g. give
-- FONT_DISPLAY a heavier weight later) stay a one-line change here.
local CUSTOM_FONT = Font.new(
	'rbxassetid://12187360881',
	Enum.FontWeight.Regular,
	Enum.FontStyle.Normal
)
Module.FONT_DISPLAY = CUSTOM_FONT
Module.FONT_UI      = CUSTOM_FONT
Module.FONT_MONO    = CUSTOM_FONT
Module.FONT_BUTTON  = CUSTOM_FONT

-- // Helpers // --

-- L-shaped corner tick on a 14x14 region — `corner` is 'tl'|'tr'|'bl'|'br'.
function Module.cornerTick(scope, corner: string, accent: Color3)
	local meta = ({
		tl = { pos = UDim2.fromOffset(0, 0), anchor = Vector2.new(0, 0), top = true,    left  = true },
		tr = { pos = UDim2.new(1, 0, 0, 0),  anchor = Vector2.new(1, 0), top = true,    right = true },
		bl = { pos = UDim2.new(0, 0, 1, 0),  anchor = Vector2.new(0, 1), bottom = true, left  = true },
		br = { pos = UDim2.new(1, 0, 1, 0),  anchor = Vector2.new(1, 1), bottom = true, right = true },
	})[corner]

	local children = {}
	if meta.top then
		table.insert(children, scope:New('Frame') {
			Size = UDim2.new(1, 0, 0, 1),
			BackgroundColor3 = accent, BorderSizePixel = 0,
		})
	end
	if meta.bottom then
		table.insert(children, scope:New('Frame') {
			Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1),
			BackgroundColor3 = accent, BorderSizePixel = 0,
		})
	end
	if meta.left then
		table.insert(children, scope:New('Frame') {
			Size = UDim2.new(0, 1, 1, 0),
			BackgroundColor3 = accent, BorderSizePixel = 0,
		})
	end
	if meta.right then
		table.insert(children, scope:New('Frame') {
			Size = UDim2.new(0, 1, 1, 0), Position = UDim2.new(1, -1, 0, 0),
			BackgroundColor3 = accent, BorderSizePixel = 0,
		})
	end

	return scope:New('Frame') {
		Size = UDim2.fromOffset(14, 14),
		Position = meta.pos,
		AnchorPoint = meta.anchor,
		BackgroundTransparency = 1,
		[Fusion.Children] = children,
	}
end

-- Chiseled translucent panel with corner ticks + stroke.
function Module.chiseledPanel(scope, props: {
	Size: UDim2, Position: UDim2?, AnchorPoint: Vector2?,
	AccentColor: Color3?, BackgroundTransparency: number?,
	LayoutOrder: number?, Visible: any?, Name: string?,
	Children: {any}?,
	-- Optional shape lock. When provided, a UIAspectRatioConstraint is
	-- attached to the PANEL ROOT itself (not the inner children wrapper),
	-- so the panel keeps the requested width:height shape on every screen.
	AspectRatio: number?,
})
	local accent = props.AccentColor or Module.PALETTE.accent
	return scope:New('Frame') {
		Name = props.Name or 'Panel',
		Size = props.Size,
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		BackgroundColor3 = Module.PALETTE.panel,
		BackgroundTransparency = props.BackgroundTransparency or 0.28,
		BorderSizePixel = 0,
		LayoutOrder = props.LayoutOrder or 0,
		Visible = props.Visible,
		[Fusion.Children] = {
			props.AspectRatio and scope:New('UIAspectRatioConstraint') {
				AspectRatio = props.AspectRatio,
				AspectType = Enum.AspectType.FitWithinMaxSize,
				DominantAxis = Enum.DominantAxis.Width,
			} or nil,
			scope:New('UIStroke') {
				Color = accent, Transparency = 0.78, Thickness = 1,
			},
			Module.cornerTick(scope, 'tl', accent),
			Module.cornerTick(scope, 'br', accent),
			props.Children and scope:New('Frame') {
				Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
				[Fusion.Children] = props.Children,
			} or nil,
		},
	}
end

-- A thin mono uppercase "eyebrow" label (`◆ ACTIVE QUEST` style).
function Module.eyebrowLabel(scope, props: { Text: any, Color: Color3?, Size: UDim2?, TextSize: number?, LayoutOrder: number? })
	return scope:New('TextLabel') {
		Size = props.Size or UDim2.new(1, 0, 0, 12),
		BackgroundTransparency = 1,
		FontFace = Module.FONT_MONO,
		Text = props.Text,
		TextSize = props.TextSize or 10,
		TextColor3 = props.Color or Module.PALETTE.accent,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		LayoutOrder = props.LayoutOrder or 0,
	}
end

-- Tweened horizontal fill bar.
-- `value` and `max` may be peek-able (Fusion Value) or plain numbers via Computed.
-- Produces: container Frame containing a background + fill.
function Module.smoothBar(scope, props: {
	Value: any,             -- Computed<number> or static
	Max: any,               -- Computed<number> or static
	Color: Color3,
	Height: number?,
	LayoutOrder: number?,
	-- When true, the bar fills its parent (fromScale(1,1)) instead of its
	-- own pixel height. Use this when the caller has already scale-sized a
	-- wrapper to the desired bar thickness.
	FillParent: boolean?,
})
	local height = props.Height or 6
	local color = props.Color

	local fillFrame

	local function computeFill()
		local v = typeof(props.Value) == 'table' and Fusion.peek(props.Value) or props.Value
		local m = typeof(props.Max) == 'table' and Fusion.peek(props.Max) or props.Max
		if typeof(v) ~= 'number' or typeof(m) ~= 'number' or m <= 0 then
			return 0
		end
		return math.clamp(v / m, 0, 1)
	end

	fillFrame = scope:New('Frame') {
		Name = 'Fill',
		Size = UDim2.fromScale(computeFill(), 1),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIGradient') {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, color),
					ColorSequenceKeypoint.new(1, color:Lerp(Color3.new(1, 1, 1), 0.35)),
				}),
			},
		},
	}

	-- Observe value/max changes and tween fill scale.
	local TI = TweenInfo.new(0.15, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	local function retween()
		local alpha = computeFill()
		if fillFrame and fillFrame.Parent then
			TweenService:Create(fillFrame, TI, { Size = UDim2.new(alpha, 0, 1, 0) }):Play()
		end
	end
	if typeof(props.Value) == 'table' then
		scope:Observer(props.Value):onChange(retween)
	end
	if typeof(props.Max) == 'table' then
		scope:Observer(props.Max):onChange(retween)
	end

	return scope:New('Frame') {
		Size = props.FillParent and UDim2.fromScale(1, 1) or UDim2.new(1, 0, 0, height),
		BackgroundColor3 = Module.PALETTE.bg0,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		LayoutOrder = props.LayoutOrder or 0,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = color, Transparency = 0.7, Thickness = 1,
			},
			fillFrame,
		},
	}
end

-- Workstation shell: full-screen dimmed overlay + bordered modal with a header
-- (title/subtitle/location + close button). Returns the root ScreenGui frame and
-- a `Content` Frame the caller populates with tool-specific widgets.
-- Width reserved on the left edge of a workstation header so the title
-- stack doesn't collide with Roblox's top-bar buttons (menu + chat +
-- leaderboard). The master ScreenGui uses IgnoreGuiInset, so we can't
-- rely on GetGuiInset() to auto-size this — it's a measured constant.
local TOPBAR_BUTTON_RESERVE = 180

function Module.workstationShell(scope, props: {
	Title: string,
	Subtitle: string?,
	Location: string?,
	Visible: any?,
	OnClose: () -> ()?,
	Width: number?, Height: number?,
	AccentColor: Color3?,
})
	local accent = props.AccentColor or Module.PALETTE.accent

	local content = scope:New('Frame') {
		Name = 'Content',
		Size = UDim2.new(1, 0, 1, -68),
		Position = UDim2.fromOffset(0, 68),
		BackgroundTransparency = 1,
	}

	local header = scope:New('Frame') {
		Name = 'Header',
		Size = UDim2.new(1, 0, 0, 68),
		BackgroundColor3 = Module.PALETTE.bg1,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = accent, Transparency = 0.7, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
				PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 18),
			},
			-- Reserve the left portion of the header for Roblox's top-bar
			-- buttons (menu + chat + leaderboard). Shifting the eyebrow/
			-- title/subtitle labels right by this offset prevents the
			-- workstation name from rendering under those core-UI icons.
			scope:New('TextLabel') {
				Position = UDim2.fromOffset(TOPBAR_BUTTON_RESERVE, 0),
				Size = UDim2.new(1, -(120 + TOPBAR_BUTTON_RESERVE), 0, 12),
				BackgroundTransparency = 1,
				FontFace = Module.FONT_MONO,
				Text = '◆ WORKSTATION',
				TextSize = 10,
				TextColor3 = accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				Position = UDim2.fromOffset(TOPBAR_BUTTON_RESERVE, 14),
				Size = UDim2.new(1, -(120 + TOPBAR_BUTTON_RESERVE), 0, 22),
				BackgroundTransparency = 1,
				FontFace = Module.FONT_DISPLAY,
				Text = props.Title,
				TextSize = 20,
				TextColor3 = accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				Position = UDim2.fromOffset(TOPBAR_BUTTON_RESERVE, 38),
				Size = UDim2.new(1, -(120 + TOPBAR_BUTTON_RESERVE), 0, 12),
				BackgroundTransparency = 1,
				FontFace = Module.FONT_MONO,
				Text = props.Subtitle or '',
				TextSize = 10,
				TextColor3 = Module.PALETTE.inkFaint,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -120, 0.5, 0),
				Size = UDim2.fromOffset(200, 20),
				BackgroundTransparency = 1,
				FontFace = Module.FONT_MONO,
				Text = props.Location or '',
				TextSize = 11,
				TextColor3 = accent,
				TextXAlignment = Enum.TextXAlignment.Right,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
			scope:New('TextButton') {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.fromOffset(110, 32),
				BackgroundColor3 = Module.PALETTE.bg0,
				BackgroundTransparency = 0.3,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				FontFace = Module.FONT_MONO,
				Text = 'ESC · LEAVE',
				TextSize = 11,
				TextColor3 = Module.PALETTE.ink,
				[Fusion.OnEvent('Activated')] = props.OnClose,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = accent, Transparency = 0.4, Thickness = 1 },
				},
			},
		},
	}

	local modal = Module.chiseledPanel(scope, {
		Name = 'Modal',
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromScale(0, 0),
		AnchorPoint = Vector2.new(0, 0),
		AccentColor = accent,
		BackgroundTransparency = 0.08,
		Children = { header, content },
	})

	local root = scope:New('Frame') {
		Name = 'WorkstationRoot',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = props.Visible,
		[Fusion.Children] = { modal },
	}

	return root, content
end

-- Design resolution for the aincrad-ui mockups. Individual widget panels
-- should add their own UIAspectRatioConstraint (16:9) where they need to
-- maintain aspect — the shell itself is just the ScreenGui.
Module.DESIGN_SIZE = Vector2.new(1920, 1080)
Module.DESIGN_ASPECT = Module.DESIGN_SIZE.X / Module.DESIGN_SIZE.Y

-- Attach a UIAspectRatioConstraint to a GuiObject, auto-flipping DominantAxis
-- against the nearest ScreenGui viewport so the element always fits. Returns
-- the constraint so callers can override properties if needed.
function Module.attachAspectRatio(instance: GuiObject, aspectRatio: number?): UIAspectRatioConstraint
	local ratio = aspectRatio or Module.DESIGN_ASPECT
	local constraint = Instance.new('UIAspectRatioConstraint')
	constraint.AspectRatio = ratio
	constraint.AspectType = Enum.AspectType.ScaleWithParentSize
	constraint.DominantAxis = Enum.DominantAxis.Width
	constraint.Parent = instance

	local function findScreenGui(): ScreenGui?
		local cur = instance.Parent
		while cur and not cur:IsA('ScreenGui') do
			cur = cur.Parent
		end
		return cur
	end

	local function updateDominantAxis()
		local gui = findScreenGui()
		if not gui then return end
		local abs = gui.AbsoluteSize
		if abs.X <= 0 or abs.Y <= 0 then return end
		constraint.DominantAxis = (abs.X / abs.Y > ratio)
			and Enum.DominantAxis.Height
			or Enum.DominantAxis.Width
	end
	instance.AncestryChanged:Connect(function()
		local gui = findScreenGui()
		if gui then
			gui:GetPropertyChangedSignal('AbsoluteSize'):Connect(updateDominantAxis)
			updateDominantAxis()
		end
	end)
	task.defer(updateDominantAxis)
	return constraint
end

-- Fetch-or-create the one ScreenGui that hosts every widget's container.
-- Kept local because `ensureScreenGui` is the only API external modules
-- should call — direct access to the master gui isn't part of the contract.
local function getMasterGui(): ScreenGui
	local Players = game:GetService('Players')
	local playerGui = Players.LocalPlayer:WaitForChild('PlayerGui')
	local existing = playerGui:FindFirstChild(MASTER_GUI_NAME)
	if existing and existing:IsA('ScreenGui') then
		return existing
	end
	local gui = Instance.new('ScreenGui')
	gui.Name = MASTER_GUI_NAME
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 0
	gui.Parent = playerGui

	-- (HUDScale UIScale instance removed — UI scale system parked while
	-- the resolution-aware scaling is redesigned. The master GUI now
	-- renders at the engine's natural size; widgets are responsible for
	-- their own sizing inside it.)
	return gui
end

-- Get-or-create a named FULL-SCREEN CONTAINER FRAME inside the single master
-- ScreenGui. The name parameter (e.g. 'HUD_Forge', 'HUD_Music') keys the
-- container, and `displayOrder` becomes the container's `ZIndex` so widgets
-- composite in their intended paint order — all while sharing one ScreenGui
-- (fewer top-level layers = lower draw-call overhead + simpler layering).
--
-- Returns a Frame, not a ScreenGui. Every existing caller uses the result
-- only as a parent (`myFrame.Parent = x`) or destroys it on widget close
-- (`x:Destroy()`) — both semantics carry over unchanged to a Frame. Type
-- annotation intentionally loosened to `GuiObject` to reflect the contract.
function Module.ensureScreenGui(name: string, displayOrder: number?): GuiObject
	local master = getMasterGui()
	local existing = master:FindFirstChild(name)
	if existing and existing:IsA('Frame') then
		return existing
	end
	-- Fresh container. Fill the full screen so child absolute positions
	-- continue to resolve against viewport dimensions, exactly as they did
	-- when each widget had its own ScreenGui.
	local container = Instance.new('Frame')
	container.Name = name
	container.Size = UDim2.fromScale(1, 1)
	container.BackgroundTransparency = 1
	container.BorderSizePixel = 0
	container.ZIndex = displayOrder or 1
	container.Parent = master
	return container
end

-- Wire UI theme settings into the master HUD. SettingsRegistry is a
-- sibling module under PlayerScripts/Modules; deferred require avoids
-- a load-order gotcha if SettingsRegistry happens to require HUDCommon back.
-- (UI scale wiring removed — feature parked.)
task.defer(function()
	local Players = game:GetService('Players')
	local LocalPlayer = Players.LocalPlayer
	if not LocalPlayer then return end
	local PlayerScripts = LocalPlayer:FindFirstChild('PlayerScripts')
	local LocalModulesFolder = PlayerScripts and PlayerScripts:FindFirstChild('Modules')
	if not LocalModulesFolder then return end
	local LocalModules = require(LocalModulesFolder)
	local SettingsRegistry = LocalModules.Modules.SettingsRegistry
	if not SettingsRegistry then return end

	Module.ApplyTheme(SettingsRegistry.UITheme)

	SettingsRegistry.Changed:Connect(function(key, value)
		-- key == nil signals a bulk re-sync from PlayerData (SyncFromSave).
		-- Pull every relevant setting fresh from the registry.
		if key == nil then
			Module.ApplyTheme(SettingsRegistry.UITheme)
			return
		end
		if key == 'UITheme' then
			Module.ApplyTheme(value)
		end
	end)

	-- Subscribe to PlayerData replication: when the server pushes the
	-- player's saved Settings, mirror them into the registry so every
	-- listener (HUDCommon theme/scale, audio service, widget toggles)
	-- picks up the persisted values. The first replication after join
	-- effectively "boots" the registry from the saved file.
	local ReplicatedData = ReplicatedModules.Services.ReplicatedData
	if ReplicatedData and ReplicatedData.OnUpdated then
		local function syncFromPlayerData()
			local data = ReplicatedData.GetData('PlayerData', false)
			if data and typeof(data.Settings) == 'table' then
				SettingsRegistry.SyncFromSave(data.Settings)
			end
		end
		-- Initial pull (data may already be present if this listener
		-- attaches after the first replication).
		task.defer(syncFromPlayerData)
		ReplicatedData.OnUpdated:Connect(function(category)
			if category == 'PlayerData' then syncFromPlayerData() end
		end)
	end
end)

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Modules/Modules/PanZoomCanvas"><![CDATA[-- PanZoomCanvas — a ScrollingFrame that supports middle/right-click drag panning
-- and mouse-wheel zooming. Designed for node-graph style UIs (skill tree,
-- map, etc.). Usage:
--
--   local canvas = PanZoomCanvas.create(scope, {
--       ContentWidth  = 1200,   -- unscaled virtual canvas size
--       ContentHeight = 800,
--       MinZoom       = 0.5,
--       MaxZoom       = 2.0,
--       InitialZoom   = 1.0,
--   })
--   canvas.Frame.Parent = parentGui        -- the ScrollingFrame
--   myNode.Parent      = canvas.Content    -- nodes live inside content
--
-- Design notes (see .claude/skills/custom-roblox-ui/SKILL.md):
--   * `UIScale` is attached to the Content frame so zooming is a pure visual
--     transform — no per-node position math required.
--   * Because `UIScale` is invisible to `ScrollingFrame.CanvasSize`, we update
--     CanvasSize manually to `ContentSize * zoom`, otherwise the scroll extents
--     won't match the visually-scaled content.
--   * Wheel zoom is mouse-anchored: after changing zoom, we adjust
--     CanvasPosition so the world-point under the cursor stays fixed — the
--     "zoom into cursor" feel.
--   * Drag-pan uses MouseButton2 + MouseButton3 (right/middle click). Left click
--     is left free so TextButton children can be clicked normally.
--   * Native `ScrollingEnabled = true` is kept so the scrollbars and flick-
--     scrolling still work — the wheel is intercepted for zoom instead.

local UserInputService = game:GetService('UserInputService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local peek = Fusion.peek

local Module = {}

export type Config = {
	ContentWidth: number,
	ContentHeight: number,
	MinZoom: number?,
	MaxZoom: number?,
	InitialZoom: number?,
	ZoomStep: number?,
	-- Default ScrollBarThickness is 0 → scrollbar is invisible. Pan/zoom is
	-- driven entirely by mouse drag + wheel, so the bar is just noise. Pass a
	-- positive number to re-enable the native scrollbars when desired.
	ScrollBarThickness: number?,
	ScrollBarColor: Color3?,
}

export type Handle = {
	Frame: ScrollingFrame,
	Content: Frame,
	Zoom: any, -- Fusion Value<number>
}

function Module.create(scope, props: Config): Handle
	local minZoom = props.MinZoom or 0.5
	local maxZoom = props.MaxZoom or 2.0
	local zoomStep = props.ZoomStep or 1.15
	local contentW = props.ContentWidth
	local contentH = props.ContentHeight

	local zoom = scope:Value(props.InitialZoom or 1.0)

	-- The content frame is pixel-sized at its UNSCALED dimensions. UIScale
	-- scales everything visually; CanvasSize is updated below to match.
	local contentFrame: Frame
	contentFrame = scope:New('Frame') {
		Name = 'Content',
		Size = UDim2.fromOffset(contentW, contentH),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIScale') { Scale = zoom },
		},
	}

	local canvasSize = scope:Computed(function(use)
		local z = use(zoom)
		return UDim2.fromOffset(math.floor(contentW * z), math.floor(contentH * z))
	end)

	local scrollFrame: ScrollingFrame
	scrollFrame = scope:New('ScrollingFrame') {
		Name = 'PanZoomCanvas',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		CanvasSize = canvasSize,
		-- Active = true so the InputBegan/InputEnded handlers below fire
		-- on right/middle-click. Without this, GuiObjects with
		-- BackgroundTransparency = 1 don't capture clicks (the input
		-- falls through to whatever sits underneath), so the pan-drag
		-- handler below would never run.
		Active = true,
		-- ScrollingEnabled stays true so programmatic CanvasPosition updates
		-- (from drag-pan + wheel-zoom) are applied by the engine.
		ScrollingEnabled = true,
		ScrollBarThickness = props.ScrollBarThickness or 0,
		ScrollBarImageColor3 = props.ScrollBarColor or Color3.fromRGB(126, 200, 255),
		ScrollBarImageTransparency = 1,
		ElasticBehavior = Enum.ElasticBehavior.Never,
		[Fusion.Children] = { contentFrame },
	}

	-- // Drag-pan (middle or right mouse button) // --
	local dragging = false
	local lastMousePos: Vector2 = Vector2.zero

	local function isDragButton(input: InputObject): boolean
		return input.UserInputType == Enum.UserInputType.MouseButton2
			or input.UserInputType == Enum.UserInputType.MouseButton3
	end

	scrollFrame.InputBegan:Connect(function(input)
		if isDragButton(input) then
			dragging = true
			lastMousePos = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)
	scrollFrame.InputEnded:Connect(function(input)
		if isDragButton(input) then
			dragging = false
		end
	end)
	-- Using UserInputService (not scrollFrame.InputChanged) so we keep tracking
	-- even if the cursor briefly leaves the frame during a drag.
	local dragConn = UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
		local cur = Vector2.new(input.Position.X, input.Position.Y)
		local delta = cur - lastMousePos
		lastMousePos = cur
		-- Dragging "grabs" the canvas: move canvas opposite to mouse delta.
		scrollFrame.CanvasPosition = scrollFrame.CanvasPosition - delta
	end)
	scrollFrame.AncestryChanged:Connect(function(_, parent)
		if parent == nil then dragConn:Disconnect() end
	end)

	-- // Wheel zoom (mouse-anchored) // --
	scrollFrame.InputChanged:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseWheel then return end

		local oldZoom = peek(zoom)
		local step = input.Position.Z > 0 and zoomStep or (1 / zoomStep)
		local newZoom = math.clamp(oldZoom * step, minZoom, maxZoom)
		if math.abs(newZoom - oldZoom) < 1e-4 then return end

		-- Convert mouse screen position → position inside the scrollframe's
		-- viewport. CanvasPosition + mouseInFrame = point on the scaled canvas.
		local abs = scrollFrame.AbsolutePosition
		local mouseInFrame = Vector2.new(
			input.Position.X - abs.X,
			input.Position.Y - abs.Y
		)
		local canvasPt = scrollFrame.CanvasPosition + mouseInFrame
		local worldPt = canvasPt / oldZoom

		zoom:set(newZoom)

		-- CanvasSize updates via Fusion Computed the same frame; defer one
		-- step so the engine has processed the new extents before we reposition.
		task.defer(function()
			if not scrollFrame.Parent then return end
			local newCanvasPt = worldPt * newZoom
			local target = newCanvasPt - mouseInFrame
			-- Clamp to valid CanvasPosition range.
			local cs = scrollFrame.AbsoluteCanvasSize
			local vs = scrollFrame.AbsoluteWindowSize
			scrollFrame.CanvasPosition = Vector2.new(
				math.clamp(target.X, 0, math.max(0, cs.X - vs.X)),
				math.clamp(target.Y, 0, math.max(0, cs.Y - vs.Y))
			)
		end)
	end)

	return {
		Frame = scrollFrame,
		Content = contentFrame,
		Zoom = zoom,
	}
end

-- Helper — draw a straight line between two points in unscaled-canvas space.
-- Returns a Frame you can parent into `handle.Content`. The line auto-positions,
-- rotates, and sizes itself to span (fromX,fromY) → (toX,toY) in pixels.
--
-- Design: a 1-D Frame (Size = length × thickness) rotated to match the angle
-- between endpoints. AnchorPoint = (0.5, 0.5) so Position is the midpoint.
function Module.line(scope, props: {
	FromX: number, FromY: number,
	ToX: number, ToY: number,
	Thickness: number?,
	Color: Color3?,
	Transparency: number?,
	ZIndex: number?,
}): Frame
	local dx = props.ToX - props.FromX
	local dy = props.ToY - props.FromY
	local length = math.sqrt(dx * dx + dy * dy)
	local midX = (props.FromX + props.ToX) / 2
	local midY = (props.FromY + props.ToY) / 2
	local angleDeg = math.deg(math.atan2(dy, dx))

	return scope:New('Frame') {
		Name = 'Line',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(midX, midY),
		Size = UDim2.fromOffset(length, props.Thickness or 2),
		Rotation = angleDeg,
		BackgroundColor3 = props.Color or Color3.fromRGB(126, 200, 255),
		BackgroundTransparency = props.Transparency or 0.4,
		BorderSizePixel = 0,
		ZIndex = props.ZIndex or 1,
	}
end

-- Split a logical line into N small rotated-rectangle segments parented
-- directly to `props.Parent` (which is expected to have ClipsDescendants
-- = true, e.g. a SkillsTab canvas wrap). Roblox's ClipsDescendants culls
-- each child by its axis-aligned bounding box; a single long rotated
-- line has a large bounding box so it's all-or-nothing visible. Splitting
-- into many small chunks gives the engine many small bounding boxes,
-- each of which is clipped individually — so a line crossing the canvas
-- edge has its outside half culled while the inside half stays drawn.
--
-- Returns nothing — segments are parented as a side-effect.
function Module.lineSegmented(scope, props: {
	FromX: number, FromY: number,
	ToX: number, ToY: number,
	Segments: number?,
	Thickness: number?,
	Color: Color3?,
	Transparency: number?,
	ZIndex: number?,
	Parent: Instance,
})
	local segments = props.Segments or 16
	local dx = props.ToX - props.FromX
	local dy = props.ToY - props.FromY
	local total = math.sqrt(dx * dx + dy * dy)
	if total <= 0 then return end
	local segLen = total / segments
	local angleDeg = math.deg(math.atan2(dy, dx))
	for i = 0, segments - 1 do
		local t = (i + 0.5) / segments
		local cx = props.FromX + dx * t
		local cy = props.FromY + dy * t
		scope:New('Frame') {
			Name = 'LineSeg_' .. tostring(i),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(cx, cy),
			Size = UDim2.fromOffset(segLen, props.Thickness or 2),
			Rotation = angleDeg,
			BackgroundColor3 = props.Color or Color3.fromRGB(126, 200, 255),
			BackgroundTransparency = props.Transparency or 0.4,
			BorderSizePixel = 0,
			ZIndex = props.ZIndex or 1,
			Parent = props.Parent,
		}
	end
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Modules/Modules/SettingsRegistry"><![CDATA[-- Centralized live state for user-facing settings (audio sliders, UI theme,
-- etc.). The SettingsTab UI writes here; HUD widgets and the SoundService
-- subscribe to read.
--
-- Volumes are stored as 0..1 fractions (sliders convert from 0..100 ints).
-- Effective music volume = config.Volume * MusicVolume * MasterVolume.
-- Effective SFX   volume = sound.Volume  * SFXVolume   * MasterVolume.

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Signal = ReplicatedModules.Modules.Signal

local Module = {}

Module.MasterVolume = 0.72
Module.MusicVolume  = 0.48
Module.SFXVolume    = 0.80
Module.UITheme      = 'Crystal dark'
-- Dash directional mode. Determines how the dodge direction is computed
-- when the player presses the Dash keybind. See CombatInputClient.AttemptDodge.
--   'CameraDirection'         — dash forward in the camera's look direction
--   'CharacterDirection'      — dash forward in the character's facing
--   'CharacterDirectionalKey' — wait ≤0.5s for a WASD press; dash that
--                               way relative to the character
--   'CameraDirectionalKey'    — wait ≤0.5s for a WASD press; dash that
--                               way relative to the camera
Module.DashMode = 'CameraDirection'
-- (UIScale removed — implementation was buggy across resolutions and
-- the user-driven slider is parked until we revisit. The master HUD
-- now renders at the engine's natural resolution.)
-- Per-widget visibility toggles. Each gates an Open/Close cycle on its
-- widget (MusicWidget/MinimapWidget) or a frame-level Visible binding
-- (OnscreenButtons widget + the Hotbar's ability/utility clusters).
Module.MusicWidgetEnabled    = true
Module.MinimapEnabled        = true
Module.OnscreenButtonsEnabled = true
-- PvP lock-on consent. When false, other players can't be R-locked
-- onto this player. Defaults to false so opt-in PvP is the explicit
-- player choice.
Module.PvPLockOnConsent      = false
-- Server-authoritative "allow PvP damage to me" gate. When false, any
-- damage routed through DamageModule.DamageHumanoid where attacker AND
-- victim are both Players and the victim has AllowPvP=false is
-- silently dropped (with a MISS indicator). Distinct from
-- PvPLockOnConsent — that gate is just the lock-on UX; this gate is
-- the actual damage block. Defaults to false (opt-in PvP).
Module.AllowPvP              = false
-- Companion auto-attack toggle. When true, an equipped companion
-- emits Pod-style ranged pulses while the player has their weapon
-- drawn and an enemy is in range. Defaults to true; players who want
-- non-combat companions can disable in settings.
Module.CompanionAutoAttack   = true
-- World-waypoint toggles. WaypointsClient renders a 3D billboard
-- marker over each tagged Workstation and each unlocked Waystone in
-- the world. These two booleans gate the categories independently
-- so a player can keep workstation pins on while hiding waystones
-- (or vice versa). Defaults to true so the markers exist out-of-box.
Module.WaypointsWorkstationsEnabled = true
Module.WaypointsWaystonesEnabled    = true
Module.WaypointsSubstationsEnabled  = true
-- CompassWidget visibility. The compass projects every active waypoint
-- (workstations + unlocked waystones) onto a strip across the top of
-- the screen so the player can orient toward off-camera markers. Toggle
-- exists for players who prefer a clean HUD; defaults on so the affordance
-- is discoverable. CompassWidget reads this on Start and on .Changed.
Module.CompassEnabled               = true

-- Overhead-billboard visibility toggles. The OverheadInfo module attaches
-- a nameplate (name + level + HP/stamina bars) over every tagged
-- character. These three flags split the population so a player can hide
-- their own billboard (cleaner first-person feel), other players' (less
-- screen clutter in PvP), or enemies' (immersion / minimal-HUD play),
-- independently. All default `true` so the new gates are inert for
-- existing saves until the player opts to disable them.
Module.OverheadOwnEnabled      = true
Module.OverheadOthersEnabled   = true
Module.OverheadEnemiesEnabled  = true

-- Generic setting -> default value (so future toggles can register without
-- adding new module fields). Stored separately to avoid clashes with the
-- well-known fields above.
Module.Generic = {} :: {[string]: any}

Module.Changed = Signal.New()

local KNOWN_KEYS: {[string]: true} = {
	MasterVolume = true, MusicVolume = true, SFXVolume = true,
	UITheme = true,
	MusicWidgetEnabled = true, MinimapEnabled = true, OnscreenButtonsEnabled = true,
	DashMode = true,
	PvPLockOnConsent = true, AllowPvP = true, CompanionAutoAttack = true,
	WaypointsWorkstationsEnabled = true, WaypointsWaystonesEnabled = true,
	WaypointsSubstationsEnabled  = true,
	CompassEnabled = true,
	OverheadOwnEnabled = true, OverheadOthersEnabled = true, OverheadEnemiesEnabled = true,
}

-- True for the duration of a SyncFromSave call so the publish path
-- below skips firing remotes (the value just came from the server,
-- pushing it back would be a redundant round-trip).
local Syncing = false

-- Publish to the server via the SettingsEvent remote. Lazy-resolved so
-- we don't pay the require cost at module load and don't crash if the
-- remote isn't created yet (e.g. during early startup tests).
local function publishToServer(key: string, value: any, kind: string)
	if Syncing then return end
	local ok, RemoteService = pcall(function()
		return ReplicatedModules.Services.RemoteService
	end)
	if not ok or not RemoteService then return end
	local SettingsEvent = RemoteService.GetRemote('SettingsEvent', 'RemoteEvent', false)
	if SettingsEvent then
		SettingsEvent:FireServer(kind, key, value)
	end
end

function Module.Set(key: string, value: any)
	if KNOWN_KEYS[key] then
		if Module[key] == value then return end
		Module[key] = value
		Module.Changed:Fire(key, value)
		publishToServer(key, value, 'Set')
	else
		if Module.Generic[key] == value then return end
		Module.Generic[key] = value
		Module.Changed:Fire(key, value)
		publishToServer(key, value, 'SetGeneric')
	end
end

-- Apply a saved Settings struct from PlayerData. Routes each key
-- through `Set` under the `Syncing` flag, which fires per-key Changed
-- (so existing per-key listeners — SoundService, MusicWidget, theme,
-- scale — all pick up the bulk load) WITHOUT pushing back to the
-- server (the values just came from the server). Concludes with one
-- additional `Changed(nil, nil)` so listeners that prefer a single
-- "bulk done" tick can sync once at the end.
--
-- Called on first PlayerData replication (and on subsequent updates if
-- a remote source like Cmdr changes a setting server-side).
function Module.SyncFromSave(savedSettings: any)
	if typeof(savedSettings) ~= 'table' then return end
	Syncing = true
	-- Known keys — fire Set per key under Syncing so listeners react
	-- normally but the remote echo is suppressed.
	for key in KNOWN_KEYS do
		local v = savedSettings[key]
		if v ~= nil then Module.Set(key, v) end
	end
	-- Generic bucket. Fire Set for each entry so any registered
	-- listener for that key wakes up.
	if typeof(savedSettings.Generic) == 'table' then
		for k, v in savedSettings.Generic do
			Module.Set(k, v)
		end
	end
	Syncing = false
	-- Bulk-done notification for listeners that prefer it.
	Module.Changed:Fire(nil, nil)
end

function Module.Get(key: string): any
	if KNOWN_KEYS[key] then return Module[key] end
	return Module.Generic[key]
end

-- Convenience getters used by audio call sites.
function Module.GetMusicMultiplier(): number
	return Module.MasterVolume * Module.MusicVolume
end
function Module.GetSFXMultiplier(): number
	return Module.MasterVolume * Module.SFXVolume
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Modules/Modules/CombatLog"><![CDATA[-- Tracks "in combat" state on the client and gates actions like waystone
-- teleport. The character is considered in combat for COMBAT_LOG_DURATION
-- seconds after taking damage, dealing damage, or starting a block — i.e.
-- any action that meaningfully engages the combat system.
--
-- Owners of the combat-gated action call IsInCombat() at decision time,
-- not at trigger time, so the timer continues to tick down naturally
-- without anyone having to debounce it.

local Players = game:GetService('Players')
local LocalPlayer = Players.LocalPlayer

local Module = {}
Module.LastCombatAt = 0
Module.COMBAT_LOG_DURATION = 8 -- seconds; tweakable via Bump call sites

local function now(): number
	return os.clock()
end

function Module.Bump()
	Module.LastCombatAt = now()
end

function Module.IsInCombat(): boolean
	return (now() - Module.LastCombatAt) < Module.COMBAT_LOG_DURATION
end

function Module.SecondsRemaining(): number
	return math.max(0, Module.COMBAT_LOG_DURATION - (now() - Module.LastCombatAt))
end

local trackedHumanoid: Humanoid? = nil
local trackedConn: RBXScriptConnection? = nil

local function trackHumanoid(character: Model?)
	if trackedConn then trackedConn:Disconnect(); trackedConn = nil end
	trackedHumanoid = nil
	if not character then return end
	local humanoid = character:FindFirstChildOfClass('Humanoid') or character:WaitForChild('Humanoid', 5)
	if not humanoid then return end
	trackedHumanoid = humanoid
	local last = humanoid.Health
	trackedConn = humanoid.HealthChanged:Connect(function(newHealth)
		-- Only damage (decrease) bumps the combat timer. Healing through
		-- consumables/regen shouldn't lock the player out of waystones.
		if newHealth < last then
			Module.Bump()
		end
		last = newHealth
	end)
end

function Module.Start()
	if LocalPlayer.Character then trackHumanoid(LocalPlayer.Character) end
	LocalPlayer.CharacterAdded:Connect(trackHumanoid)
	-- Also bump on the local Attacking/Blocking attribute toggling true,
	-- so initiating combat (not just receiving damage) starts the timer.
	local function watchCombatAttrs(character: Model?)
		if not character then return end
		character:GetAttributeChangedSignal('Attacking'):Connect(function()
			if character:GetAttribute('Attacking') then Module.Bump() end
		end)
		character:GetAttributeChangedSignal('Blocking'):Connect(function()
			if character:GetAttribute('Blocking') then Module.Bump() end
		end)
	end
	if LocalPlayer.Character then task.defer(watchCombatAttrs, LocalPlayer.Character) end
	LocalPlayer.CharacterAdded:Connect(watchCombatAttrs)
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Modules/Modules/LevelLockOverlay"><![CDATA[-- LevelLockOverlay — reusable "this system is locked behind level N"
-- modal. Shown when a workshop widget refuses to open because the
-- player is below the system's required level (per LevelGates).
--
-- Layout: scale-based throughout. The chiseled panel is positioned
-- center-screen via Position = fromScale(0.5, 0.5) and sized as a
-- fraction of viewport so it fits 16:9 / 21:9 / portrait without an
-- aspect-ratio constraint (panel content is short text + one button).
--
-- Public API:
--   LevelLockOverlay.Show(systemId, currentLevel)
--   LevelLockOverlay.Hide()
-- Calling Show twice with the same systemId no-ops (idempotent).
-- Calling Show with a different systemId tears down and rebuilds with
-- the new content.

local UserInputService = game:GetService('UserInputService')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped    = Fusion.scoped
local doCleanup = Fusion.doCleanup
local LevelGates = ReplicatedModules.Data.LevelGates

local HUDCommon = require(script.Parent:WaitForChild('HUDCommon'))
local PALETTE = HUDCommon.PALETTE

local Players = game:GetService('Players')
local LocalPlayer = Players.LocalPlayer

local Module = {}

local ScreenGui: ScreenGui? = nil
local RootScope = nil
local ShownSystem: string? = nil

local function tearDown()
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
	ShownSystem = nil
end

----------------------------------------------------------------------
-- Build. Returns the root frame inside the parent ScreenGui.
-- All sizes / positions are SCALE so the modal proportionally fits
-- whatever screen rect it ends up on.
----------------------------------------------------------------------
local function buildModal(scope, systemId: string, currentLevel: number)
	local label = LevelGates.GetDisplayLabel(systemId)
	local required = LevelGates.GetRequiredLevel(systemId)

	-- Full-screen scrim — dim the world behind the modal.
	scope:New('Frame') {
		Name = 'Scrim',
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
		Parent = ScreenGui,
		ZIndex = 1,
	}

	-- Center modal — 32% width × 22% height of viewport. Tight enough
	-- to read as a popup on ultrawide; large enough to be legible on
	-- mobile portrait. No aspect ratio constraint — the content is
	-- short and re-flows acceptably across aspect ratios.
	local panel = HUDCommon.chiseledPanel(scope, {
		Name = 'LevelLockPanel',
		Size = UDim2.fromScale(0.32, 0.22),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		AccentColor = PALETTE.gold,
		BackgroundTransparency = 0.12,
		Children = {
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(0.06, 0),
				PaddingBottom = UDim.new(0.06, 0),
				PaddingLeft   = UDim.new(0.06, 0),
				PaddingRight  = UDim.new(0.06, 0),
			},

			-- Eyebrow.
			scope:New('TextLabel') {
				Name = 'Eyebrow',
				Position = UDim2.fromScale(0, 0),
				Size = UDim2.fromScale(1, 0.12),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = '◆ LOCKED',
				TextScaled = true,
				TextColor3 = PALETTE.gold,
				TextXAlignment = Enum.TextXAlignment.Left,
			},

			-- Title — big system name. Inner UIPadding shrinks the
			-- TextScaled effective rect so the glyph height drops by
			-- 5% top + 5% bottom — keeps the title from overpowering
			-- the panel (TextScaled fills its parent rect; reducing
			-- the rect via padding is the standard way to "size down"
			-- a TextScaled label without disabling TextScaled).
			scope:New('TextLabel') {
				Name = 'Title',
				Position = UDim2.fromScale(0, 0.16),
				Size = UDim2.fromScale(1, 0.28),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = string.upper(label),
				TextScaled = true,
				TextColor3 = PALETTE.gold,
				TextXAlignment = Enum.TextXAlignment.Left,
				[Fusion.Children] = {
					scope:New('UIPadding') {
						PaddingTop    = UDim.new(0.05, 0),
						PaddingBottom = UDim.new(0.05, 0),
					},
				},
			},

			-- Body — required-level message + current level.
			scope:New('TextLabel') {
				Name = 'Body',
				Position = UDim2.fromScale(0, 0.48),
				Size = UDim2.fromScale(1, 0.20),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = string.format('Requires character level %d. You are level %d.',
					required, currentLevel),
				TextScaled = true,
				TextColor3 = PALETTE.inkDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextWrapped = true,
			},

			-- Close button — dismisses the modal. Pinned bottom-right.
			scope:New('TextButton') {
				Name = 'Close',
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.fromScale(1, 1),
				Size = UDim2.fromScale(0.30, 0.20),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
				FontFace = HUDCommon.FONT_BUTTON,
				Text = 'CLOSE',
				TextScaled = true,
				TextColor3 = PALETTE.gold,
				AutoButtonColor = true,
				[Fusion.Children] = {
					scope:New('UIStroke') {
						Color = PALETTE.gold, Transparency = 0.4, Thickness = 1,
					},
					scope:New('UIPadding') {
						PaddingTop = UDim.new(0.16, 0),
						PaddingBottom = UDim.new(0.16, 0),
					},
				},
				[Fusion.OnEvent('Activated')] = function()
					Module.Hide()
				end,
			},
		},
	})
	panel.ZIndex = 2
	panel.Parent = ScreenGui

	-- Scrim swallows clicks so the player must explicitly press CLOSE
	-- (or ESC, see Start binding) — prevents an accidental click-through
	-- to the underlying world while the modal is up.
	local scrimEater = scope:New('TextButton') {
		Name = 'ScrimEater',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = '',
		AutoButtonColor = false,
		ZIndex = 0,
		Parent = ScreenGui,
		[Fusion.OnEvent('Activated')] = function() Module.Hide() end,
	}
	scrimEater.Modal = false  -- don't capture mouse system-wide
	return panel
end

----------------------------------------------------------------------
-- Public API.
----------------------------------------------------------------------
function Module.Show(systemId: string, currentLevel: number?)
	-- Idempotent for the same system — a second Show with the same id
	-- doesn't rebuild (avoids tearing/flickering when multiple
	-- subscribers fire on the same event, e.g. zone-enter + remote).
	if ShownSystem == systemId and ScreenGui then return end
	tearDown()
	ShownSystem = systemId

	ScreenGui = HUDCommon.ensureScreenGui('HUD_LevelLock', 60)
	-- High display order so the modal paints above every workshop
	-- widget surface (40-range) and above the TabWidget shell. ESC
	-- dismiss — wired in Start().
	RootScope = scoped(Fusion)
	buildModal(RootScope, systemId, tonumber(currentLevel) or 1)
end

function Module.Hide()
	tearDown()
end

-- Targeted hide: only tears down if the overlay is currently showing
-- THIS system's lock. Used by workstation widgets on ZoneLeave so a
-- player walking out of (e.g.) the Forge zone doesn't dismiss a Gems
-- lock someone else triggered first.
function Module.HideIfShowing(systemId: string): boolean
	if ShownSystem ~= systemId then return false end
	tearDown()
	return true
end

function Module.IsOpen(): boolean
	return ShownSystem ~= nil
end

function Module.Start()
	-- ESC dismiss — InputBegan instead of CAS so we don't claim the
	-- key globally when the modal isn't up.
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if not Module.IsOpen() then return end
		if input.KeyCode == Enum.KeyCode.Escape then
			Module.Hide()
		end
	end)
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Modules/Modules/LevelGatesClient"><![CDATA[-- LevelGatesClient — thin client-side reader for the server-wide
-- level-gate bypass map. Backed by the public 'ServerFlags' category
-- on ReplicatedData; the server publishes via LevelGatesServer.
--
-- Pure helper: no Init / Start. Widgets call GetGlobalBypass() (the
-- whole map) when invoking LevelGates.CanUseSystem so per-system + the
-- `all` master are both visible to the predicate; or
-- IsGloballyBypassed(systemId?) for a single boolean answer.

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local ReplicatedData = ReplicatedModules.Services.ReplicatedData

local SERVER_FLAGS_CATEGORY = 'ServerFlags'

local Module = {}

-- Returns the full bypass map (or nil if replication hasn't landed
-- yet). Use this when calling LevelGates.CanUseSystem so per-system +
-- the `all` master are both consulted in one read.
function Module.GetGlobalBypass(): { [string]: boolean }?
	local flags = ReplicatedData.GetData(SERVER_FLAGS_CATEGORY, false)
	if typeof(flags) ~= 'table' then return nil end
	local bypass = flags.LevelGateBypass
	if typeof(bypass) ~= 'table' then return nil end
	return bypass
end

-- Single-boolean accessor. Honors the `all` master and (when systemId
-- is passed) the system-specific key. Defaults to `false` until the
-- first replication tick lands the map.
function Module.IsGloballyBypassed(systemId: string?): boolean
	local bypass = Module.GetGlobalBypass()
	if not bypass then return false end
	if bypass.all == true then return true end
	if systemId ~= nil and bypass[systemId] == true then return true end
	return false
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Modules/Modules/LeaderboardClient"><![CDATA[-- LeaderboardClient — thin client-side reader over the public
-- 'Leaderboard' ReplicatedData category. Pure helper, no Init/Start.
-- The tab UI binds to ReplicatedData.OnUpdated for re-renders.

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local ReplicatedData    = ReplicatedModules.Services.ReplicatedData
local LeaderboardConfig = ReplicatedModules.Data.LeaderboardConfig

local Module = {}

-- Returns the full snapshot table (or nil before first replication
-- tick). Shape:
--   {
--     Updated = number,            -- epoch seconds of last server publish
--     [categoryId] = {
--       Entries = {
--         { userId = number, value = number, name = string? },
--         ...
--       },
--     },
--   }
function Module.GetSnapshot(): any?
	return ReplicatedData.GetData(LeaderboardConfig.PublicCategory, false)
end

function Module.GetCategoryEntries(categoryId: string): { any }
	local snap = Module.GetSnapshot()
	if typeof(snap) ~= 'table' then return {} end
	local entry = snap[categoryId]
	if typeof(entry) ~= 'table' or typeof(entry.Entries) ~= 'table' then
		return {}
	end
	return entry.Entries
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Modules/Modules/ConfigReplicationClient"><![CDATA[-- ConfigReplicationClient — single dispatcher for every config-replication
-- category. The server holds the canonical authored data (under
-- ServerStorage/Modules/Data/X.luau); this module's job is to receive
-- per-player projections of that data and write them into the shared
-- empty shells at ReplicatedStorage/Modules/Data/X.luau.
--
-- // Architecture rationale //
-- We deliberately consolidate ALL category dispatching into one file
-- (rather than one *ReplicationClient per system) because:
--   1. The client-side write logic is identical for the common case —
--      Bundle replaces, Add inserts, Remove deletes. One generic
--      dispatcher covers every system that fits that shape (Mounts,
--      Companions, Blueprints, Items, Modifiers, Materials, Enchants,
--      Gems, …). Per-system files would just be five lines of
--      boilerplate each.
--   2. There's exactly one shared `ConfigReplicationEvent` remote, so
--      the OnClientEvent connection is naturally one place. Splitting
--      across files would multiply the number of network listeners
--      for no gain.
--   3. The server-side replicator modules stay per-system because
--      bootstrap logic, save-field walks, and trigger hooks are
--      genuinely system-specific. They all push through the shared
--      remote with a category prefix.
--
-- // Wire protocol //
-- The shared remote carries (category, action, ...) tuples:
--   ConfigReplicationEvent ('<Category>', 'Bundle', { [id] = cfg, ... })
--     — full replace; the bundle is the server's authoritative current
--       view for this player. Replaces, doesn't merge.
--   ConfigReplicationEvent ('<Category>', 'Add', id, cfg)
--     — incremental append; new row earned mid-session.
--   ConfigReplicationEvent ('<Category>', 'Remove', id)
--     — admin-revoke / server-side cleanup. Drops the row from the shell.
--
-- // Registration //
-- Each system that follows the generic pattern is registered in the
-- centralized `registerCategories` block below. Adding a new system is
-- one line:
--   register('Mounts', ReplicatedModules.Data.Mounts.Mounts)
-- The second arg is the LIVE table the dispatcher writes into — the
-- client-shell module's data table. The category string must match
-- whatever the system's *ReplicationServer module fires.
--
-- // Custom handlers //
-- For systems that don't fit "Bundle replaces a [id]→cfg map" (e.g. a
-- system that needs to drive UI side-effects on each push, or one whose
-- shape isn't a flat table), use `RegisterCustom(category, fn)` and
-- the dispatcher hands the full (action, ...) tuple to your function
-- instead of running the generic write. Registered custom handlers
-- still get a per-category OnReplicated signal fired after the function
-- returns — same as generic categories.

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local RemoteService = ReplicatedModules.Services.RemoteService
local Signal        = ReplicatedModules.Modules.Signal
local Jobs          = ReplicatedModules.Services.ConfigReplicationShared.Jobs

local ConfigReplicationEvent = RemoteService.GetRemote('ConfigReplicationEvent', 'RemoteEvent', false)

local Module = {}

-- Registry shape:
--   [category] = {
--       Target         = { [id] = cfg, ... }  -- generic mode (live table to mutate)
--       CustomHandler  = function(action, ...) ... end  -- custom mode
--       OnReplicated   = Signal  -- fires with (action) after every push
--   }
-- Exactly one of Target / CustomHandler is set per registration.
local Registry: { [string]: any } = {}

----------------------------------------------------------------------
-- Generic write helpers — single-writer convention: only this module's
-- dispatch path mutates the registered Target tables on the client.
----------------------------------------------------------------------
local function applyBundle(target, rows)
	if typeof(rows) ~= 'table' then return end
	-- Replace, don't merge — Bundle is the server saying "this is the
	-- complete current view for this player." Anything previously in
	-- the table that's not in the bundle was either revoked (admin
	-- path) or never legit; either way we honor the server's view.
	table.clear(target)
	for id, cfg in rows do
		target[id] = cfg
	end
end

local function applyAdd(target, id, cfg)
	if typeof(id) ~= 'string' or typeof(cfg) ~= 'table' then return end
	target[id] = cfg
end

local function applyRemove(target, id)
	if typeof(id) ~= 'string' then return end
	target[id] = nil
end

----------------------------------------------------------------------
-- Public registration API.
----------------------------------------------------------------------

-- Register a category for the generic Bundle/Add/Remove pattern.
-- `target` is the live table the dispatcher writes into — typically
-- the data table on a client-shell module (e.g.
-- ReplicatedModules.Data.Mounts.Mounts). Returns the per-category
-- OnReplicated signal so callers can capture it inline.
function Module.Register(category: string, target: { [string]: any }): any
	if Registry[category] then
		warn(string.format('[ConfigReplicationClient] category %q re-registered', category))
	end
	local sig = Signal.New('ConfigRepl_' .. category)
	Registry[category] = { Target = target, OnReplicated = sig }
	return sig
end

-- Register a category with a custom dispatch handler — for systems
-- that need bespoke handling (UI side-effects, non-map data shapes,
-- etc.). The handler receives the raw (action, ...) tuple straight
-- from the wire. After it returns, the per-category OnReplicated
-- signal still fires with (action), same as generic categories.
function Module.RegisterCustom(category: string, handler: (string, ...any) -> ()): any
	if Registry[category] then
		warn(string.format('[ConfigReplicationClient] category %q re-registered', category))
	end
	local sig = Signal.New('ConfigRepl_' .. category)
	Registry[category] = { CustomHandler = handler, OnReplicated = sig }
	return sig
end

-- Fetch the OnReplicated signal for a category — useful for widgets
-- that mounted before bootstrap landed and want to re-render on the
-- next push. Returns nil if the category isn't registered yet (call
-- this from Start, not Init, to be safe).
function Module.GetSignal(category: string): any
	local entry = Registry[category]
	return entry and entry.OnReplicated or nil
end

----------------------------------------------------------------------
-- Dispatcher.
----------------------------------------------------------------------
local function dispatch(category, action, ...)
	if typeof(category) ~= 'string' or typeof(action) ~= 'string' then return end
	local entry = Registry[category]
	if not entry then
		-- Server pushed a category the client hasn't registered. Likely
		-- a config drift between server and client — warn quietly so
		-- it surfaces in dev without spamming production.
		warn(string.format('[ConfigReplicationClient] unknown category %q', category))
		return
	end
	if entry.CustomHandler then
		local ok, err = pcall(entry.CustomHandler, action, ...)
		if not ok then
			warn(string.format('[ConfigReplicationClient] custom handler %q errored: %s',
				category, tostring(err)))
			return
		end
	else
		local target = entry.Target
		if action == Jobs.Bundle then
			applyBundle(target, ...)
		elseif action == Jobs.Add then
			applyAdd(target, ...)
		elseif action == Jobs.Remove then
			applyRemove(target, ...)
		else
			-- Unknown action — server may have evolved past this client.
			-- Silently skip rather than error so old clients don't crash.
			return
		end
	end
	entry.OnReplicated:Fire(action)
end

----------------------------------------------------------------------
-- Centralized registrations.
--
-- New categories slot in here — one line for the generic case. Keep
-- the list alphabetized and grouped by phase for readability. The
-- second argument is the live table the dispatcher writes into; it
-- must be a reference to the data table on the corresponding
-- client-shell module so writes are visible to every existing widget
-- that already reads `ReplicatedModules.Data.X`.
----------------------------------------------------------------------
local function registerCategories()
	-- Phase 2 — owned-only.
	Module.Register('Mounts',     ReplicatedModules.Data.Mounts.Mounts)
	Module.Register('Companions', ReplicatedModules.Data.Companions.Companions)
	Module.Register('Blueprints', ReplicatedModules.Data.Blueprints.Blueprints)
	Module.Register('Items',      ReplicatedModules.Data.Items.Items)
	-- Modifiers piggy-backs on Items' replicator: ItemsConfigReplicationServer
	-- pushes a 'Modifiers' bundle alongside its 'Items' bundle on
	-- BootstrapPlayer (walking forged stacks for referenced modifier ids),
	-- and ForgeServer pushes individual Modifier rows on each forge commit.
	-- The dispatch / writeback is fully generic from the client's POV.
	Module.Register('Modifiers',  ReplicatedModules.Data.Modifiers.Modifiers)

	-- Phase 3 — seen/encountered. Wire up as each phase ships.
	-- Module.Register('Materials',     ReplicatedModules.Data.Materials.Materials)
	-- Module.Register('Enchants',      ReplicatedModules.Data.Enchants.Enchants)
	-- Module.Register('Gems',          ReplicatedModules.Data.Gems.Gems)
	-- Module.Register('StatusEffects', ReplicatedModules.Data.StatusEffects.StatusEffects)
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	-- The OnClientEvent connect must happen in Start (events fired
	-- before Connect are dropped, not queued — but the framework
	-- guarantees all Starts complete before any server push reaches
	-- the client). Registrations already happened in Init so
	-- GetSignal works from sibling modules' Start phase.
	ConfigReplicationEvent.OnClientEvent:Connect(dispatch)
end

function Module.Init()
	-- Register all categories in Init (not Start) so any other module's
	-- Start can call GetSignal('<Category>') without racing on which
	-- Start ran first. The framework runs all Inits before any Start,
	-- so by the time any sibling Start runs, the registry is populated.
	registerCategories()
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Modules/Services"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Modules/Services/WindShake"><![CDATA[--[=[

WindShake- High performance wind effect for leaves and foliage
by: boatbomber, CloneTrooper1019

Docs: https://devforum.roblox.com/t/wind-shake-high-performance-wind-effect-for-leaves-and-foliage/1039806/1

--]=]

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Settings = require(script.Settings)
local VectorMap = require(script.VectorMap)

local COLLECTION_TAG = "WindShake" -- The CollectionService tag to be watched and mounted automatically

-- Use the script's attributes as the default settings.
-- The table provided is a fallback if the attributes
-- are undefined or using the wrong value types.

local FALLBACK_SETTINGS = {
	WindDirection = Vector3.new(0.5, 0, 0.5),
	WindSpeed = 20,
	WindPower = 0.5,
}

-----------------------------------------------------------------------------------------------------------------

local ObjectShakeAddedEvent = Instance.new("BindableEvent")
local ObjectShakeRemovedEvent = Instance.new("BindableEvent")
local ObjectShakeUpdatedEvent = Instance.new("BindableEvent")
local PausedEvent = Instance.new("BindableEvent")
local ResumedEvent = Instance.new("BindableEvent")

local WindShake = {
	RenderDistance = 150,
	MaxRefreshRate = 1 / 60,
	SharedSettings = Settings.new(script),

	ObjectMetadata = {},
	VectorMap = VectorMap.new(),

	Handled = 0,
	Active = 0,

	_partList = table.create(500),
	_cframeList = table.create(500),

	ObjectShakeAdded = ObjectShakeAddedEvent.Event,
	ObjectShakeRemoved = ObjectShakeRemovedEvent.Event,
	ObjectShakeUpdated = ObjectShakeUpdatedEvent.Event,
	Paused = PausedEvent.Event,
	Resumed = ResumedEvent.Event,
}

export type WindShakeSettings = {
	WindDirection: Vector3?,
	WindSpeed: number?,
	WindPower: number?,
}

function WindShake:Connect(funcName: string, event: RBXScriptSignal): RBXScriptConnection
	local callback = self[funcName]
	assert(typeof(callback) == "function", "Unknown function: " .. funcName)

	return event:Connect(function(...)
		return callback(self, ...)
	end)
end

function WindShake:AddObjectShake(object: BasePart | Bone, settingsTable: WindShakeSettings?)
	if typeof(object) ~= "Instance" then
		return
	end

	if not (object:IsA("BasePart") or object:IsA("Bone")) then
		return
	end

	local metadata = self.ObjectMetadata

	if metadata[object] then
		return
	else
		self.Handled += 1
	end

	metadata[object] = {
		ChunkKey = self.VectorMap:AddObject(
			if object:IsA("Bone") then object.WorldPosition else object.Position,
			object
		),
		Settings = Settings.new(object),

		Seed = math.random(5000) * 0.32,
		Origin = if object:IsA("Bone") then object.WorldCFrame else object.CFrame,
		LastUpdate = os.clock(),
	}

	if settingsTable then
		self:UpdateObjectSettings(object, settingsTable)
	end

	ObjectShakeAddedEvent:Fire(object)
end

function WindShake:RemoveObjectShake(object: BasePart | Bone)
	if typeof(object) ~= "Instance" then
		return
	end

	local metadata = self.ObjectMetadata
	local objMeta = metadata[object]

	if objMeta then
		self.Handled -= 1
		metadata[object] = nil
		objMeta.Settings:Destroy()
		self.VectorMap:RemoveObject(objMeta.ChunkKey, object)

		if object:IsA("BasePart") then
			object.CFrame = objMeta.Origin
		elseif object:IsA("Bone") then
			object.WorldCFrame = objMeta.Origin
		end
	end

	ObjectShakeRemovedEvent:Fire(object)
end

function WindShake:Update(deltaTime: number)
	debug.profilebegin("WindShake")

	local active = 0

	debug.profilebegin("Update")

	local now = os.clock()
	local slowerDeltaTime = deltaTime * 3
	local step = math.min(1, deltaTime * 5)

	-- Reuse tables to avoid garbage collection
	local bulkMoveIndex = 0
	local partList = self._partList
	local cframeList = self._cframeList
	table.clear(partList)
	table.clear(cframeList)

	-- Cache hot values
	local objectMetadata = self.ObjectMetadata
	local camera = workspace.CurrentCamera
	local cameraPos = camera.CFrame.Position
	local renderDistance = self.RenderDistance
	local maxRefreshRate = self.MaxRefreshRate
	local sharedSettings = self.SharedSettings
	local sharedWindPower = sharedSettings.WindPower
	local sharedWindSpeed = sharedSettings.WindSpeed
	local sharedWindDirection = sharedSettings.WindDirection

	-- Update objects in view at their respective refresh rates
	self.VectorMap:ForEachObjectInView(camera, renderDistance, function(className: string, object: BasePart | Bone)
		local objMeta = objectMetadata[object]
		local lastUpdate = objMeta.LastUpdate or 0
		local isBone = className == "Bone"

		-- Determine if the object refresh rate
		local objectCFrame = if isBone then (object :: Bone).WorldCFrame else object.CFrame
		local distanceAlpha = ((cameraPos - objectCFrame.Position).Magnitude / renderDistance)
		local distanceAlphaSq = distanceAlpha * distanceAlpha
		local jitter = (1 / math.random(60, 120))
		local refreshRate = (slowerDeltaTime * distanceAlphaSq) + maxRefreshRate

		if (now - lastUpdate) + jitter <= refreshRate then
			-- It is not yet time to update
			return
		end

		objMeta.LastUpdate = now
		active += 1

		local objSettings = objMeta.Settings

		local windDirection = (objSettings.WindDirection or sharedWindDirection)
		if windDirection.Magnitude < 1e-5 then
			return
		end

		local amp = (objSettings.WindPower or sharedWindPower) * 0.2
		if amp < 1e-5 then
			return
		end

		local freq = now * ((objSettings.WindSpeed or sharedWindSpeed) * 0.08)
		if freq < 1e-5 then
			return
		end

		local seed = objMeta.Seed
		local animValue = (math.noise(freq, 0, seed) + 0.4) * amp
		local lerpAlpha = math.clamp(step + distanceAlphaSq, 0.1, 0.5)
		local lowAmp = amp / 3

		local origin = objMeta.Origin * (objSettings.PivotOffset or CFrame.identity)
		local localWindDirection = origin:VectorToObjectSpace(windDirection)

		if isBone then
			local bone: Bone = object :: Bone
			bone.Transform = bone.Transform:Lerp(
				(
					CFrame.fromAxisAngle(localWindDirection:Cross(Vector3.yAxis), -animValue)
					* CFrame.Angles(
						math.noise(seed, 0, freq) * lowAmp,
						math.noise(seed, freq, 0) * lowAmp,
						math.noise(freq, seed, 0) * lowAmp
					)
				) + (localWindDirection * animValue * amp),
				lerpAlpha
			)
		else
			bulkMoveIndex += 1
			partList[bulkMoveIndex] = object
			cframeList[bulkMoveIndex] = objectCFrame:Lerp(
				(
					origin
					* CFrame.fromAxisAngle(localWindDirection:Cross(Vector3.yAxis), -animValue)
					* CFrame.Angles(
						math.noise(seed, 0, freq) * lowAmp,
						math.noise(seed, freq, 0) * lowAmp,
						math.noise(freq, seed, 0) * lowAmp
					)
					* (objSettings.PivotOffsetInverse or CFrame.identity)
				) + (windDirection * animValue * (amp * 2)),
				lerpAlpha
			)
		end
	end)

	self.Active = active

	debug.profileend()

	workspace:BulkMoveTo(partList, cframeList, Enum.BulkMoveMode.FireCFrameChanged)

	debug.profileend()
end

function WindShake:Pause()
	if self.UpdateConnection then
		self.UpdateConnection:Disconnect()
		self.UpdateConnection = nil
	end

	self.Active = 0
	self.Running = false

	PausedEvent:Fire()
end

function WindShake:Resume()
	if self.Running then
		return
	else
		self.Running = true
	end

	-- Connect updater
	self.UpdateConnection = self:Connect("Update", RunService.Heartbeat)

	ResumedEvent:Fire()
end

function WindShake:Initi(config: { MatchWorkspaceWind: boolean? })
	if self.Initialized then
		return
	end

	-- Define attributes if they're undefined.
	local power = script:GetAttribute("WindPower")
	local speed = script:GetAttribute("WindSpeed")
	local direction = script:GetAttribute("WindDirection")

	if typeof(power) ~= "number" then
		script:SetAttribute("WindPower", FALLBACK_SETTINGS.WindPower)
	end

	if typeof(speed) ~= "number" then
		script:SetAttribute("WindSpeed", FALLBACK_SETTINGS.WindSpeed)
	end

	if typeof(direction) ~= "Vector3" then
		script:SetAttribute("WindDirection", FALLBACK_SETTINGS.WindDirection)
	end

	-- Clear any old stuff.
	self:Cleanup()
	self.Initialized = true

	-- Wire up tag listeners.
	local windShakeAdded = CollectionService:GetInstanceAddedSignal(COLLECTION_TAG)
	self.AddedConnection = self:Connect("AddObjectShake", windShakeAdded)

	local windShakeRemoved = CollectionService:GetInstanceRemovedSignal(COLLECTION_TAG)
	self.RemovedConnection = self:Connect("RemoveObjectShake", windShakeRemoved)

	for _, object in CollectionService:GetTagged(COLLECTION_TAG) do
		self:AddObjectShake(object)
	end

	-- Wire up workspace wind.
	if config and config.MatchWorkspaceWind then
		self:MatchWorkspaceWind()
		self.WorkspaceWindConnection = workspace:GetPropertyChangedSignal("GlobalWind"):Connect(function()
			self:MatchWorkspaceWind()
		end)
	end

	-- Automatically start.
	self:Resume()
end

function WindShake:Cleanup()
	if not self.Initialized then
		return
	end

	self:Pause()

	if self.AddedConnection then
		self.AddedConnection:Disconnect()
		self.AddedConnection = nil
	end

	if self.RemovedConnection then
		self.RemovedConnection:Disconnect()
		self.RemovedConnection = nil
	end

	if self.WorkspaceWindConnection then
		self.WorkspaceWindConnection:Disconnect()
		self.WorkspaceWindConnection = nil
	end

	table.clear(self.ObjectMetadata)
	self.VectorMap:ClearAll()

	self.Handled = 0
	self.Active = 0
	self.Initialized = false
end

function WindShake:UpdateObjectSettings(object: Instance, settingsTable: WindShakeSettings)
	if typeof(object) ~= "Instance" then
		return
	end

	if typeof(settingsTable) ~= "table" then
		return
	end

	if not self.ObjectMetadata[object] and (object ~= script) then
		return
	end

	for key, value in settingsTable do
		object:SetAttribute(key, value)
	end

	ObjectShakeUpdatedEvent:Fire(object)
end

function WindShake:UpdateAllObjectSettings(settingsTable: WindShakeSettings)
	if typeof(settingsTable) ~= "table" then
		return
	end

	for obj, _objMeta in self.ObjectMetadata do
		for key, value in settingsTable do
			obj:SetAttribute(key, value)
		end
		ObjectShakeUpdatedEvent:Fire(obj)
	end
end

function WindShake:SetDefaultSettings(settingsTable: WindShakeSettings)
	self:UpdateObjectSettings(script, settingsTable)
end

function WindShake:MatchWorkspaceWind()
	local workspaceWind = workspace.GlobalWind
	local windDirection = workspaceWind.Unit
	local windSpeed, windPower = 0, 0

	local windMagnitude = workspaceWind.Magnitude
	if windMagnitude > 0 then
		windPower = if windMagnitude > 1 then math.log10(windMagnitude) + 0.2 else 0.3
		windSpeed = if windMagnitude < 100 then (windMagnitude * 1.2) + 5 else 125
	end

	self:SetDefaultSettings({
		WindDirection = windDirection,
		WindSpeed = windSpeed,
		WindPower = windPower,
	})
end

return WindShake
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Modules/Services/WindShake/VectorMap"><![CDATA[--!strict

local VectorMap = {}
VectorMap.__index = VectorMap

function VectorMap.new(voxelSize: number?)
	return setmetatable({
		_voxelSize = voxelSize or 50,
		_voxels = {},
	}, VectorMap)
end

function VectorMap:_debugDrawVoxel(voxelKey: Vector3)
	local box = Instance.new("Part")
	box.Name = tostring(voxelKey)
	box.Anchored = true
	box.CanCollide = false
	box.Transparency = 1
	box.Size = Vector3.one * self._voxelSize
	box.Position = (voxelKey * self._voxelSize) + (Vector3.one * (self._voxelSize / 2))
	box.Parent = workspace

	local selection = Instance.new("SelectionBox")
	selection.Color3 = Color3.new(0, 0, 1)
	selection.Adornee = box
	selection.Parent = box

	task.delay(1 / 30, box.Destroy, box)
end

function VectorMap:AddObject(position: Vector3, object: any)
	local className = object.ClassName

	local voxelSize = self._voxelSize
	local voxelKey = Vector3.new(
		math.floor(position.X / voxelSize),
		math.floor(position.Y / voxelSize),
		math.floor(position.Z / voxelSize)
	)

	local voxel = self._voxels[voxelKey]

	if voxel == nil then
		self._voxels[voxelKey] = {
			[className] = { object },
		}
	elseif voxel[className] == nil then
		voxel[className] = { object }
	else
		table.insert(voxel[className], object)
	end

	return voxelKey
end

function VectorMap:RemoveObject(voxelKey: Vector3, object: any)
	local voxel = self._voxels[voxelKey]

	if voxel == nil then
		return
	end

	local className = object.ClassName
	if voxel[className] == nil then
		return
	end

	local classBucket = voxel[className]
	for index, storedObject in classBucket do
		if storedObject == object then
			-- Swap remove to avoid shifting
			local n = #classBucket
			classBucket[index] = classBucket[n]
			classBucket[n] = nil
			break
		end
	end

	-- Remove empty class bucket
	if #classBucket == 0 then
		voxel[className] = nil

		-- Remove empty voxel
		if next(voxel) == nil then
			self._voxels[voxelKey] = nil
		end
	end
end

function VectorMap:GetVoxel(voxelKey: Vector3)
	return self._voxels[voxelKey]
end

function VectorMap:ForEachObjectInRegion(top: Vector3, bottom: Vector3, callback: (string, any) -> ())
	local voxelSize = self._voxelSize
	local xMin, yMin, zMin = math.min(bottom.X, top.X), math.min(bottom.Y, top.Y), math.min(bottom.Z, top.Z)
	local xMax, yMax, zMax = math.max(bottom.X, top.X), math.max(bottom.Y, top.Y), math.max(bottom.Z, top.Z)

	for x = math.floor(xMin / voxelSize), math.floor(xMax / voxelSize) do
		for z = math.floor(zMin / voxelSize), math.floor(zMax / voxelSize) do
			for y = math.floor(yMin / voxelSize), math.floor(yMax / voxelSize) do
				local voxel = self._voxels[Vector3.new(x, y, z)]
				if not voxel then
					continue
				end

				for className, objects in voxel do
					for _, object in objects do
						callback(className, object)
					end
				end
			end
		end
	end
end

function VectorMap:ForEachObjectInView(camera: Camera, distance: number, callback: (string, any) -> ())
	local voxelSize = self._voxelSize
	local cameraCFrame = camera.CFrame
	local cameraPos = cameraCFrame.Position
	local rightVec, upVec = cameraCFrame.RightVector, cameraCFrame.UpVector

	local distance2 = distance / 2
	local farPlaneHeight2 = math.tan(math.rad((camera.FieldOfView + 5) / 2)) * distance
	local farPlaneWidth2 = farPlaneHeight2 * (camera.ViewportSize.X / camera.ViewportSize.Y)
	local farPlaneCFrame = cameraCFrame * CFrame.new(0, 0, -distance)
	local farPlaneTopLeft = farPlaneCFrame * Vector3.new(-farPlaneWidth2, farPlaneHeight2, 0)
	local farPlaneTopRight = farPlaneCFrame * Vector3.new(farPlaneWidth2, farPlaneHeight2, 0)
	local farPlaneBottomLeft = farPlaneCFrame * Vector3.new(-farPlaneWidth2, -farPlaneHeight2, 0)
	local farPlaneBottomRight = farPlaneCFrame * Vector3.new(farPlaneWidth2, -farPlaneHeight2, 0)

	local frustumCFrameInverse = (cameraCFrame * CFrame.new(0, 0, -distance2)):Inverse()

	local rightNormal = upVec:Cross(farPlaneBottomRight - cameraPos).Unit
	local leftNormal = upVec:Cross(farPlaneBottomLeft - cameraPos).Unit
	local topNormal = rightVec:Cross(cameraPos - farPlaneTopRight).Unit
	local bottomNormal = rightVec:Cross(cameraPos - farPlaneBottomRight).Unit

	local minBound =
		cameraPos:Min(farPlaneTopLeft):Min(farPlaneTopRight):Min(farPlaneBottomLeft):Min(farPlaneBottomRight)
	local maxBound =
		cameraPos:Max(farPlaneTopLeft):Max(farPlaneTopRight):Max(farPlaneBottomLeft):Max(farPlaneBottomRight)

	minBound = Vector3.new(
		math.floor(minBound.X / voxelSize),
		math.floor(minBound.Y / voxelSize),
		math.floor(minBound.Z / voxelSize)
	)
	maxBound = Vector3.new(
		math.floor(maxBound.X / voxelSize),
		math.floor(maxBound.Y / voxelSize),
		math.floor(maxBound.Z / voxelSize)
	)

	local function isPointInView(point: Vector3): boolean
		-- Check if point lies outside frustum OBB
		local relativeToOBB = frustumCFrameInverse * point
		if
			relativeToOBB.X > farPlaneWidth2
			or relativeToOBB.X < -farPlaneWidth2
			or relativeToOBB.Y > farPlaneHeight2
			or relativeToOBB.Y < -farPlaneHeight2
			or relativeToOBB.Z > distance2
			or relativeToOBB.Z < -distance2
		then
			return false
		end

		-- Check if point lies outside a frustum plane
		local lookToCell = point - cameraPos
		if
			rightNormal:Dot(lookToCell) < 0
			or leftNormal:Dot(lookToCell) > 0
			or topNormal:Dot(lookToCell) < 0
			or bottomNormal:Dot(lookToCell) > 0
		then
			return false
		end

		return true
	end

	for x = minBound.X, maxBound.X do
		local xMin = x * voxelSize
		local xMax = xMin + voxelSize
		local xPos = math.clamp(farPlaneCFrame.X, xMin, xMax)

		for y = minBound.Y, maxBound.Y do
			local yMin = y * voxelSize
			local yMax = yMin + voxelSize
			local yPos = math.clamp(farPlaneCFrame.Y, yMin, yMax)

			for z = minBound.Z, maxBound.Z do
				local zMin = z * voxelSize
				local zMax = zMin + voxelSize

				local voxelNearestPoint = Vector3.new(xPos, yPos, math.clamp(farPlaneCFrame.Z, zMin, zMax))
				if isPointInView(voxelNearestPoint) then
					-- Found the first in frustum, now binary search for the last
					local entry, exit = z, minBound.Z - 1
					local left = z
					local right = maxBound.Z

					while left <= right do
						local mid = math.floor((left + right) / 2)
						local midPos = Vector3.new(
							xPos,
							yPos,
							math.clamp(farPlaneCFrame.Z, mid * voxelSize, mid * voxelSize + voxelSize)
						)

						if isPointInView(midPos) then
							exit = mid
							left = mid + 1
						else
							right = mid - 1
						end
					end

					for fillZ = entry, exit do
						local voxel = self._voxels[Vector3.new(x, y, fillZ)]
						if voxel then
							for className, objects in voxel do
								for _, object in objects do
									callback(className, object)
								end
							end
						end
					end

					break
				end
			end
		end
	end
end

function VectorMap:ClearAll()
	self._voxels = {}
end

return VectorMap
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Modules/Services/WindShake/Settings"><![CDATA[local Settings = {}

local SettingTypes = {
	WindPower = "number",
	WindSpeed = "number",
	WindDirection = "Vector3",
	PivotOffset = "CFrame",
}

function Settings.new(object: BasePart | Bone | ModuleScript)
	local objectSettings = {}

	-- Initial settings
	local WindPower = object:GetAttribute("WindPower")
	local WindSpeed = object:GetAttribute("WindSpeed")
	local WindDirection = object:GetAttribute("WindDirection")

	objectSettings.WindPower = if typeof(WindPower) == SettingTypes.WindPower then WindPower else nil
	objectSettings.WindSpeed = if typeof(WindSpeed) == SettingTypes.WindSpeed then WindSpeed else nil
	objectSettings.WindDirection = if typeof(WindDirection) == SettingTypes.WindDirection
		then (if WindDirection.Magnitude > 0 then WindDirection.Unit else Vector3.zero)
		else nil
	objectSettings.PivotOffset = if object:IsA("BasePart") then object.PivotOffset else nil
	objectSettings.PivotOffsetInverse = if typeof(objectSettings.PivotOffset) == "CFrame"
		then objectSettings.PivotOffset:Inverse()
		else nil

	-- Update settings on event

	local PowerConnection = object:GetAttributeChangedSignal("WindPower"):Connect(function()
		WindPower = object:GetAttribute("WindPower")
		objectSettings.WindPower = if typeof(WindPower) == SettingTypes.WindPower then WindPower else nil
	end)

	local SpeedConnection = object:GetAttributeChangedSignal("WindSpeed"):Connect(function()
		WindSpeed = object:GetAttribute("WindSpeed")
		objectSettings.WindSpeed = if typeof(WindSpeed) == SettingTypes.WindSpeed then WindSpeed else nil
	end)

	local DirectionConnection = object:GetAttributeChangedSignal("WindDirection"):Connect(function()
		WindDirection = object:GetAttribute("WindDirection")
		objectSettings.WindDirection = if typeof(WindDirection) == SettingTypes.WindDirection
			then (if WindDirection.Magnitude > 0 then WindDirection.Unit else Vector3.zero)
			else nil
	end)

	local PivotConnection
	if object:IsA("BasePart") then
		PivotConnection = object:GetPropertyChangedSignal("PivotOffset"):Connect(function()
			objectSettings.PivotOffset = object.PivotOffset
			objectSettings.PivotOffsetInverse = objectSettings.PivotOffset:Inverse()
		end)
	end

	-- Cleanup function for when shake is removed or object is unloaded

	function objectSettings:Destroy()
		PowerConnection:Disconnect()
		SpeedConnection:Disconnect()
		DirectionConnection:Disconnect()
		if PivotConnection then
			PivotConnection:Disconnect()
		end

		table.clear(objectSettings)
	end

	return objectSettings
end

return Settings
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Modules/Services/WindLines"><![CDATA[
-- SERVICES
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- VARIABLES
local Player = Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local RNG = Random.new()

-- TEMPLATE
local WindTemplate = Instance.new('Part') do
	WindTemplate.Anchored = true
	WindTemplate.CanCollide = false
	WindTemplate.CanTouch = false
	WindTemplate.CanQuery = false
	WindTemplate.Massless = true
	WindTemplate.Transparency = 1
	WindTemplate.Color = Color3.fromRGB(255, 0, 255)
	WindTemplate.Size = Vector3.new(0.2, 0.2, 0.6)
	local Att0 = Instance.new('Attachment')
	Att0.CFrame = CFrame.new(Vector3.new(0, 0, 0.2))
	Att0.Parent = WindTemplate
	local Att1 = Instance.new('Attachment')
	Att1.CFrame = CFrame.new(Vector3.new(0, 0, -0.2))
	Att1.Parent = WindTemplate
	local Trail = Instance.new('Trail')
	Trail.Brightness = 1
	Trail.Color = ColorSequence.new(Color3.new(1, 1, 1))
	Trail.LightEmission = 1
	Trail.FaceCamera = true
	Trail.LightInfluence = 0
	Trail.Texture = ''
	Trail.Attachment0 = Att0
	Trail.Attachment1 = Att1
	Trail.Enabled = true
	Trail.Lifetime = 2
	Trail.MaxLength = 0
	Trail.MinLength = 0
	Trail.WidthScale = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0)})
	Trail.Parent = WindTemplate
end

-- CLASS
local WindService = {}
WindService.__index = WindService

-- FUNCTIONS
function WindService.new(setting)
	local Object = {}
	setmetatable(Object, WindService)

	if RunService:IsClient() then
		Object.Location = setting.Location or workspace.CurrentCamera
	else
		Object.Location = setting.Location or workspace.Camera
	end

	Object.Randomized = setting.Randomized or false
	Object.Velocity = setting.Velocity or Vector3.new(0.45, 0, 0)
	Object.Amount = setting.Amount or 10
	Object.Current = 0
	Object.Frequency = setting.Frequency or 0.5
	Object.Lifetime = setting.Lifetime or 2
	Object.Amplitude = setting.Amplitude or 0.35
	Object.Range = setting.Range or 50
	Object.Part = WindTemplate
	Object.Time = setting.Time or nil

	return Object
end

-- METHODS
function WindService:Startt()
	if self.Time then
		local Timer = tick()
		self.While = RunService.Heartbeat:Connect(function()
			if (tick() - Timer) >= self.Time then
				Timer += self.Time
				if self.Current < self.Amount then
					self:CreateWind()
				end
			end
		end)
	else
		self.While = RunService.Heartbeat:Connect(function()
			while self.Current < self.Amount do
				self:CreateWind()
			end
		end)
	end
end

function WindService:Stop()
	if self.Connection then
		if self.Connection.Connected then
			self.Connection:Disconnect()
		end
	end
	if self.While then
		if self.While.Connected then
			self.While:Disconnect()
		end
	end
end

function WindService:GetRandomPosition()
	if not Character.PrimaryPart then
		return
	end
	return Vector3.new(
		Character.PrimaryPart.Position.X + RNG:NextInteger(-self.Range, self.Range) - (self.Range / 2),
		Character.PrimaryPart.Position.Y + RNG:NextInteger(6, 30),
		Character.PrimaryPart.Position.Z + RNG:NextInteger(-self.Range, self.Range) - (self.Range / 2)
	)
end

function WindService:CalculateSineWave(amp, x, freq, phase)
	return amp * math.sin((x / freq) + phase)
end

function WindService:FadeWind(part)
	for i = 0, 1, 0.01 do
		task.wait(0.01)
		part.Trail.Transparency = NumberSequence.new{
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.3, i),
			NumberSequenceKeypoint.new(0.6, i),
			NumberSequenceKeypoint.new(1, 1),
		}
	end
	task.wait(0.1)
end

function WindService:CreateWind()
	local Part = self.Part:Clone()
	Part.Parent = self.Location
	Part.Position = self:GetRandomPosition()
	self.Current += 1

	-- CHECK RANDOM STATE:
	if self.Randomized then
		-- GET RANDOM VALUES:
		local Towards = Vector3.new(RNG:NextNumber(-self.Velocity.X, self.Velocity.X), RNG:NextNumber(-self.Velocity.Y, self.Velocity.Y), RNG:NextNumber(-self.Velocity.Z, -self.Velocity.Z))
		local Latency = RNG:NextNumber(self.Lifetime, self.Lifetime + RNG:NextNumber(0.5, 1.5))

		-- MOVEMENT:
		local Render = RunService.RenderStepped:Connect(function()
			local Formula = WindService:CalculateSineWave(self.Amplitude, tick(), self.Frequency, 0)
			Part.CFrame = Part.CFrame * CFrame.new(0, 0, Formula) + Towards
		end)

		-- CLEANUP:
		task.delay(Latency, function()
			WindService:FadeWind(Part)
			Render:Disconnect()
			Part:Destroy()
			self.Current -= 1
		end)
	else
		-- MOVEMENT:
		local Render = RunService.RenderStepped:Connect(function()
			local Formula = WindService:CalculateSineWave(self.Amplitude, tick(), self.Frequency, 0)
			Part.CFrame = Part.CFrame * CFrame.new(0, 0, Formula) + self.Velocity
		end)

		-- START ENDING:
		task.delay(self.Lifetime, function()
			WindService:FadeWind(Part)
			Render:Disconnect()
			Part:Destroy()
			self.Current -= 1
		end)
	end
end

return WindService
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Modules/Utility"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Modules/Utility/Viewport"><![CDATA[
local Module = {}

function Module.SetupModelForViewport(model: Model)
	local Humanoid = model:FindFirstChildWhichIsA("Humanoid")
	if Humanoid then
		Humanoid.HealthDisplayDistance = Enum.HumanoidHealthDisplayType.AlwaysOff
		Humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	if model:IsA("Model") and model.PrimaryPart then
		model.PrimaryPart.Anchored = true
	end
end

function Module.SetupModelViewport(viewport: ViewportFrame, model: Model, cameraCFrame: CFrame?, modelCFrame: CFrame?): (Instance?, Camera)
	assert(typeof(model) == "Instance", "Passed Model must be an Instance.")
	local Camera = Module.ViewportCamera(viewport)
	if viewport:GetAttribute("Current") == model.Name then
		return viewport:FindFirstChild(model.Name), Camera
	end
	viewport:SetAttribute("Current", model.Name)
	model = model:Clone()
	if modelCFrame then
		model:PivotTo(modelCFrame)
	end
	model.Parent = viewport
	if cameraCFrame then
		Camera.CFrame = cameraCFrame
	end
	return model, Camera
end

function Module.ViewportCamera(ViewportFrame : ViewportFrame): Camera
	local camera = ViewportFrame:FindFirstChildOfClass('Camera')
	if not camera then
		camera = Instance.new('Camera')
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = CFrame.new()
		camera.Parent = ViewportFrame
		ViewportFrame.CurrentCamera = camera
	end
	return camera
end

function Module.ClearViewport(ViewportFrame : ViewportFrame)
	for _, item in ViewportFrame:GetChildren() do
		if not item:IsA('Camera') then
			item:Destroy()
		end
	end
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Modules/Utility/Platform"><![CDATA[
local GuiService = game:GetService('GuiService')
local UserInputService = game:GetService('UserInputService')

--[=[
	Platform utilities; mainly to identify the user platform and other miscellaneous things.

	@class PlatformUtility
	@client
]=]
local Module = { }

--[=[
	Get the user platform; 'Console', 'Mobile' or 'Desktop'.

	@within PlatformUtility
]=]
function Module.GetPlatform()
	if GuiService:IsTenFootInterface() then
		return "Console"
	elseif UserInputService.TouchEnabled and (not UserInputService.MouseEnabled) then
		return "Mobile"
	else
		return "Desktop"
	end
end

return Module

]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Modules/Utility/UserInterface"><![CDATA[local TweenService = game:GetService('TweenService')

local baseTweenInfo = TweenInfo.new(0.75, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)

--[=[
	@class UserInterfaceUtility
	@client
]=]
local Module = {}

local baseButton = Instance.new('ImageButton')
baseButton.Name = 'Button'
baseButton.AnchorPoint = Vector2.new(0.5, 0.5)
baseButton.Position = UDim2.fromScale(0.5, 0.5)
baseButton.Size = UDim2.fromScale(1, 1)
baseButton.BackgroundTransparency = 1
baseButton.Selectable = true
baseButton.ImageTransparency = 1
baseButton.ZIndex = 50

--[=[
	Create a new action button with the given properties if passed.

	@within UserInterfaceUtility
]=]
function Module.CreateActionButton(properties : table?) : ImageButton
	local button = baseButton:Clone()
	if typeof(properties) == 'table' then
		for k, v in properties do
			button[k] = v
		end
	end
	return button
end

--[=[
	Set the label properties under the given frame parent, essentially you pass a properties tablel like { Title = {Text = 'Hello!'} } and it'll look for the Title child under the passed Parent then set the properties table for that instance.

	@within UserInterfaceUtility
]=]
function Module.SetLabelDisplayProperties( Parent : Instance, propertiesTable : table )
	for guiObjectName, labelProperties in propertiesTable do
		local targetGuiObject = Parent:FindFirstChild( guiObjectName )
		if targetGuiObject and targetGuiObject:IsA('Frame') then
			targetGuiObject = targetGuiObject:FindFirstChild('Label')
		end
		if not targetGuiObject then
			continue
		end
		for propertyName, propertyValue in labelProperties do
			targetGuiObject[propertyName] = propertyValue
		end
	end
end

--[=[
	Fade all descendant gui objects under the given parent.

	@within UserInterfaceUtility
]=]
function Module.FadeGuiObjects( Parent : Instance, endTransparency : number, customTweenInfo : TweenInfo? )
	local Objs = Parent:GetDescendants()
	if Parent:IsA('GuiObject') then
		table.insert(Objs, Parent)
	end
	local tweenInfo = (customTweenInfo or baseTweenInfo)
	for _, GuiObject in Objs do
		local objectGoal = nil
		if GuiObject:IsA('Frame') then
			objectGoal = {BackgroundTransparency = endTransparency}
		elseif GuiObject:IsA('TextLabel') then
			objectGoal = {BackgroundTransparency = endTransparency, TextTransparency = endTransparency}
		elseif GuiObject:IsA('UIStroke') then
			objectGoal = {Transparency = endTransparency}
		elseif GuiObject:IsA('ImageLabel') or GuiObject:IsA('ImageButton') then
			objectGoal = {BackgroundTransparency = endTransparency, ImageTransparency = endTransparency}
		end
		TweenService:Create(GuiObject, tweenInfo, objectGoal):Play()
	end
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Modules/Utility/UISinkInputs"><![CDATA[-- UISinkInputs — shared input-sink dispatcher for UI widgets that need
-- to absorb specific inputs without each registering its own
-- ContextActionService bind.
--
-- Architecture:
--   * A single shared CAS action ("UISinkInputs_Action") is bound only
--     to the inputs that AT LEAST ONE registered processor declares
--     interest in. Each input has a refcount; when the count crosses
--     0→1 we unbind+rebind with the new (larger) input list, when it
--     crosses 1→0 we unbind+rebind with the smaller list, and when no
--     inputs remain we leave the action unbound entirely.
--   * Why dynamic registration: a static "always bind Mouse1/Mouse2/
--     Wheel" approach intercepts inputs even when no processor cares,
--     which can interfere with other CAS consumers (camera zoom, the
--     TabWidget Tab keybind, weapon-swap binds, etc.) at startup. By
--     binding only what's needed, we minimize CAS-level surface area.
--   * Widgets register *processors* via AddProcessorCallback. Each
--     processor declares:
--       * Inputs: { Enum.UserInputType | Enum.KeyCode }
--           inputs the processor is interested in. CAS:BindAction
--           accepts both types, so we forward whatever the caller
--           passes verbatim.
--       * Filter(state, obj) -> bool — predicate ("does my rule apply
--           to this input?"; commonly: hit-test mouse over my frame +
--           is widget visible).
--       * Sink(state, obj)   -> bool — decision (return true to sink,
--           false to pass). Side-effects can run here.
--   * On each input, processors are walked in registration order. The
--     first processor whose Filter returns true AND whose Sink returns
--     true causes a Sink result; otherwise Pass.
--
-- No mobile touch button — the 3rd arg of CAS:BindAction is `false`,
-- per the spec. Mouse-only widgets shouldn't surface a touch button.
--
-- Caller pattern:
--   local id = UISinkInputs.AddProcessorCallback({
--       Name   = 'minimap-wheel',
--       Inputs = { Enum.UserInputType.MouseWheel },
--       Filter = function(state, obj)
--           return isMouseOver(myPanel)
--       end,
--       Sink   = function() return true end,
--   })
--   -- ... later, when widget tears down:
--   UISinkInputs.RemoveProcessor(id)

local ContextActionService = game:GetService('ContextActionService')

local Module = {}

local ACTION_NAME = 'UISinkInputs_Action'

export type InputKey = Enum.UserInputType | Enum.KeyCode

export type Processor = {
	Id     : string,
	Name   : string?,
	Inputs : {InputKey},
	Filter : (state: any, obj: InputObject) -> boolean,
	Sink   : (state: any, obj: InputObject) -> boolean,
}

-- Registration order matters: earlier processors get first chance to
-- sink. We use a list (not a map) for deterministic iteration; lookup
-- by id is O(N) but the list is bounded by the number of mounted
-- widgets so this is fine.
Module.Processors = {} :: {Processor}

-- Per-input refcount. Key is the input enum (UserInputType or KeyCode).
-- When a processor declares Inputs = { A, B }, AddProcessorCallback
-- bumps InputCounts[A] and InputCounts[B]. RemoveProcessor decrements.
-- The CAS bind list is rebuilt from this map whenever any count
-- crosses 0↔1 (i.e. an input becomes newly-needed or fully-unneeded).
local InputCounts: {[InputKey]: number} = {}

local nextId = 0
local boundInputs: {InputKey} = {}  -- snapshot of last-bound input set

----------------------------------------------------------------------
-- Bound-input set comparison. Returns true if `a` and `b` describe the
-- same set, regardless of order. Cheap because the lists are short.
----------------------------------------------------------------------
local function sameSet(a: {InputKey}, b: {InputKey}): boolean
	if #a ~= #b then return false end
	for _, x in a do
		local hit = false
		for _, y in b do
			if x == y then hit = true; break end
		end
		if not hit then return false end
	end
	return true
end

----------------------------------------------------------------------
-- Build the active input list from InputCounts. Order is non-
-- deterministic across hash iterations but doesn't matter — CAS
-- treats the list as a set.
----------------------------------------------------------------------
local function activeInputs(): {InputKey}
	local out: {InputKey} = {}
	for input, count in InputCounts do
		if count > 0 then table.insert(out, input) end
	end
	return out
end

----------------------------------------------------------------------
-- Main dispatch handler. Signature matches CAS:BindAction's callback
-- contract: (actionName, inputState, inputObject). The actionName is
-- ignored by processors but kept in the signature for CAS.
----------------------------------------------------------------------
function Module.OnBindsProcessed(_actionName: string, inputState: Enum.UserInputState, inputObject: InputObject)
	for _, item in Module.Processors do
		if item.Filter(inputState, inputObject) then
			if item.Sink(inputState, inputObject) then
				return Enum.ContextActionResult.Sink
			end
		end
	end
	return Enum.ContextActionResult.Pass
end

----------------------------------------------------------------------
-- Bind / unbind the shared CAS action against the current active set.
-- Always unbind first if previously bound, since CAS:BindAction
-- replaces the input list — no incremental "add this input" API.
----------------------------------------------------------------------
function Module.SetupBinds()
	local desired = activeInputs()
	-- No-op if the bound set already matches.
	if sameSet(desired, boundInputs) then return end
	-- Unbind first (idempotent on an unbound action).
	if #boundInputs > 0 then
		ContextActionService:UnbindAction(ACTION_NAME)
	end
	boundInputs = desired
	if #desired == 0 then return end
	-- Third arg `false` = no mobile touch button. Per spec.
	-- BindActionAtPriority sets priority inline; `SetPriority` doesn't
	-- exist on ContextActionService (only on the older deprecated
	-- input-binding API). High priority so we beat default-priority
	-- CAS binds; lets a widget's sink intercept inputs before camera /
	-- weapon-swap bindings consume them.
	ContextActionService:BindActionAtPriority(
		ACTION_NAME,
		Module.OnBindsProcessed,
		false,
		Enum.ContextActionPriority.High.Value,
		table.unpack(desired)
	)
end

function Module.ReleaseBinds()
	if #boundInputs == 0 then return end
	ContextActionService:UnbindAction(ACTION_NAME)
	boundInputs = {}
end

----------------------------------------------------------------------
-- Refcount helpers. Increment/decrement a single input; return true if
-- the count crossed the 0↔1 boundary (which means the bound set has
-- changed and a rebind is needed).
----------------------------------------------------------------------
local function incInput(input: InputKey): boolean
	local prev = InputCounts[input] or 0
	InputCounts[input] = prev + 1
	return prev == 0  -- newly-needed
end

local function decInput(input: InputKey): boolean
	local prev = InputCounts[input] or 0
	if prev <= 0 then
		-- Defensive: counter underflow shouldn't happen, but warn
		-- loudly so a mismatched Add/Remove pair is visible in dev.
		warn(string.format('[UISinkInputs] decInput on %s with count=0', tostring(input)))
		return false
	end
	InputCounts[input] = prev - 1
	if prev == 1 then InputCounts[input] = nil end  -- prune zero entries
	return prev == 1  -- newly-unneeded
end

----------------------------------------------------------------------
-- Add a processor.
--   * `Inputs` is REQUIRED — declares which inputs this processor
--     wants to see. The CAS bind only includes inputs declared by at
--     least one registered processor.
--   * Filter / Sink default to always-true if omitted, so a processor
--     can be "sink anything that hits my declared inputs" by passing
--     just `Inputs`.
-- Returns a stable id; callers must keep it for RemoveProcessor.
----------------------------------------------------------------------
function Module.AddProcessorCallback(props: {
	Name   : string?,
	Inputs : {InputKey},
	Filter : ((state: any, obj: InputObject) -> boolean)?,
	Sink   : ((state: any, obj: InputObject) -> boolean)?,
}): string
	assert(typeof(props.Inputs) == 'table' and #props.Inputs > 0,
		'UISinkInputs.AddProcessorCallback requires non-empty `Inputs`.')

	nextId += 1
	local id = string.format('proc_%d', nextId)
	-- Snapshot the inputs list so RemoveProcessor decrements the same
	-- entries the caller incremented (caller-owned mutations after
	-- registration must not corrupt our refcount).
	local snapshot: {InputKey} = {}
	for _, input in props.Inputs do table.insert(snapshot, input) end

	table.insert(Module.Processors, {
		Id     = id,
		Name   = props.Name,
		Inputs = snapshot,
		Filter = props.Filter or function() return true end,
		Sink   = props.Sink   or function() return true end,
	})

	-- Increment refcounts; rebind if any input newly entered the set.
	local needsRebind = false
	for _, input in snapshot do
		if incInput(input) then needsRebind = true end
	end
	if needsRebind then Module.SetupBinds() end

	return id
end

-- Convenience alias so callers can use either spelling. The user's
-- original spec named the function "Add[Middleware/Processor]Callback".
Module.AddMiddlewareCallback = Module.AddProcessorCallback

function Module.RemoveProcessor(id: string): boolean
	for i, item in Module.Processors do
		if item.Id == id then
			table.remove(Module.Processors, i)
			-- Decrement refcounts; rebind if any input fully exited
			-- the set. A `task.defer` wrapper is intentionally absent
			-- — the rebind happens synchronously so a widget that
			-- closes mid-frame stops sinking immediately.
			local needsRebind = false
			for _, input in item.Inputs do
				if decInput(input) then needsRebind = true end
			end
			if needsRebind then Module.SetupBinds() end
			return true
		end
	end
	return false
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Effects"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Effects/UnlockedCinematic"><![CDATA[
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local DiscoveryData = ReplicatedModules.Data.Discovery

local RemoteService = ReplicatedModules.Services.RemoteService
local DiscoveryEvent = RemoteService.GetRemote('DiscoveryEvent', 'RemoteEvent', false)

local SystemsContainer = {}

-- // Module // --
local Module = {}

function Module.DisplayAchievement(title : string, description : string, duration : number, sound : Instance?)
	local OnPlaySignal = SystemsContainer.CinematicLabels.CinematicTopWhite(title, description, duration)
	if not sound then
		return
	end

	OnPlaySignal:Once(function()
		local Sound : Sound = sound:Clone()
		Sound.Parent = LocalPlayer:WaitForChild("PlayerGui")
		Sound:Play()
		Sound.DidLoop:Once(function()
			Sound:Destroy()
		end)
	end)
end

function Module.DisplayMilestoneAchievement(title : string, description : string)
	Module.DisplayAchievement(title, description, 7, ReplicatedAssets.Sounds.Local.MilestoneAchievement)
end

function Module.DisplayShortUnlock(title : string, description : string)
	Module.DisplayAchievement(title, description, 4, ReplicatedAssets.Sounds.Local.ProgressionAchievement)
end

function Module.Start()

	DiscoveryEvent.OnClientEvent:Connect(function(zoneName : string)
		local display_info = DiscoveryData.DiscoveryDisplayInfo[zoneName]
		if display_info then
			Module.DisplayShortUnlock('Discovery', string.format('You have discovered the region %s!', display_info.Name))
		end
	end)

end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Effects/CinematicLabels"><![CDATA[-- Full-screen cinematic title/description bars (top + bottom).
-- Fusion-generated ScreenGui replaces the legacy GameInterface.CinematicTop/Bottom template.
-- Public API preserved: CinematicTopWhite, CinematicBottomWhite, AppendCinematic.
--
-- Layout strategy (see .claude/skills/custom-roblox-ui/SKILL.md §8):
-- The block is a top-level HUD element, so it's Scale-sized + aspect-
-- locked (FitWithinMaxSize) — keeps its 6:1 design shape on every aspect.
-- Children fill the locked parent via scale-1 width + pixel-height rows
-- (skill §3 "stack of pixel-exact atoms").

local DESIGN_SCREEN_W, DESIGN_SCREEN_H = 1920, 1080
local DESIGN_BLOCK_W, DESIGN_BLOCK_H   = 720, 120
local DESIGN_DIVIDER_W = 180

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local TweenService = game:GetService('TweenService')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local doCleanup = Fusion.doCleanup

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE = HUDCommon.PALETTE

local SystemsContainer = {}

local CinematicsQueue = {}

local TI = TweenInfo.new(1)

-- Fusion-built refs (built once during Start).
local RootScope = nil
local ScreenGui = nil

type CinematicFrame = {
	Frame: Frame,
	Title: TextLabel,
	Description: TextLabel,
	Divider: Frame,
}

local TopFrame: CinematicFrame = nil :: any
local BottomFrame: CinematicFrame = nil :: any

local function buildCinematicBlock(scope, anchor: 'top' | 'bottom'): CinematicFrame
	local position = anchor == 'top'
		and UDim2.new(0.5, 0, 0.18, 0)
		or  UDim2.new(0.5, 0, 0.82, 0)

	local title: TextLabel
	local description: TextLabel
	local divider: Frame

	local frame = scope:New('Frame') {
		Name = anchor == 'top' and 'CinematicTop' or 'CinematicBottom',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position,
		-- Scale + aspect-lock: the block keeps its 720:120 (6:1) shape
		-- on every screen, instead of staying 720 px on a 1080p monitor
		-- and looking tiny on a 4K monitor. UIScale at the master HUD
		-- still applies on top per the "On-screen buttons"-style
		-- toggle, but the base size now scales with the screen too.
		Size = UDim2.fromScale(DESIGN_BLOCK_W / DESIGN_SCREEN_W, DESIGN_BLOCK_H / DESIGN_SCREEN_H),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = ScreenGui,
		[Fusion.Children] = {
			scope:New('UIAspectRatioConstraint') {
				AspectRatio = DESIGN_BLOCK_W / DESIGN_BLOCK_H,
				AspectType = Enum.AspectType.FitWithinMaxSize,
				DominantAxis = Enum.DominantAxis.Width,
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				Padding = UDim.new(0, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
		},
	}

	title = scope:New('TextLabel') {
		Name = 'Title', LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_DISPLAY,
		TextSize = 34,
		TextColor3 = PALETTE.ink,
		TextTransparency = 1,
		Text = '',
		TextStrokeTransparency = 0.4,
		TextStrokeColor3 = PALETTE.bg0,
		Parent = frame,
	}

	divider = scope:New('Frame') {
		Name = 'Divider', LayoutOrder = 2,
		-- Scale-width within the now-aspect-locked block; pixel height
		-- stays (1-px hairline is a pixel-designed atom per skill §8).
		Size = UDim2.new(DESIGN_DIVIDER_W / DESIGN_BLOCK_W, 0, 0, 1),
		BackgroundColor3 = PALETTE.accent,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = frame,
	}

	description = scope:New('TextLabel') {
		Name = 'Description', LayoutOrder = 3,
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_UI,
		TextSize = 14,
		TextColor3 = PALETTE.inkDim,
		TextTransparency = 1,
		Text = '',
		Parent = frame,
	}

	return {
		Frame = frame,
		Title = title,
		Description = description,
		Divider = divider,
	}
end

local function applyProps(instance, props)
	for k, v in props do instance[k] = v end
end

-- // Module // --
local Module = {}

function Module.RunCinematicLabel(targetFrame: CinematicFrame, titleProps, descriptionProps, holdDuration)
	local frame = targetFrame.Frame
	frame.Visible = true

	applyProps(targetFrame.Title, titleProps)
	applyProps(targetFrame.Description, descriptionProps)

	TweenService:Create(targetFrame.Description, TI, { TextTransparency = 0 }):Play()
	TweenService:Create(targetFrame.Divider, TI, { BackgroundTransparency = 0 }):Play()
	local tween = TweenService:Create(targetFrame.Title, TI, { TextTransparency = 0 })
	tween:Play()
	if tween.PlaybackState ~= Enum.PlaybackState.Completed then
		tween.Completed:Wait()
	end

	task.wait(holdDuration)

	TweenService:Create(targetFrame.Description, TI, { TextTransparency = 1 }):Play()
	TweenService:Create(targetFrame.Divider, TI, { BackgroundTransparency = 1 }):Play()
	tween = TweenService:Create(targetFrame.Title, TI, { TextTransparency = 1 })
	tween:Play()
	if tween.PlaybackState ~= Enum.PlaybackState.Completed then
		tween.Completed:Wait()
	end

	frame.Visible = false
end

function Module.AppendCinematic(
	frame: CinematicFrame, titleText, titleColor, descriptionText, descriptionColor,
	textDuration, priority
): RBXScriptSignal
	local event = Instance.new('BindableEvent')
	table.insert(CinematicsQueue, {
		Frame = frame,
		Title = { Text = titleText, TextColor3 = titleColor },
		Description = { Text = descriptionText, TextColor3 = descriptionColor },
		Duration = textDuration,
		Priority = priority,
		_OnPlayEvent = event,
	})
	return event.Event
end

function Module.CinematicTopWhite(titleText, descriptionText, priority)
	return Module.AppendCinematic(
		TopFrame, titleText, Color3.new(1, 1, 1), descriptionText, Color3.new(1, 1, 1), 2, priority
	)
end

function Module.CinematicBottomWhite(titleText, descriptionText, priority)
	return Module.AppendCinematic(
		BottomFrame, titleText, Color3.new(1, 1, 1), descriptionText, Color3.new(1, 1, 1), 2, priority
	)
end

function Module.OnUpdate()
	table.sort(CinematicsQueue, function(a, b)
		return (a.Priority or 0) < (b.Priority or 0)
	end)

	while #CinematicsQueue > 0 do
		task.wait()
		local data = table.remove(CinematicsQueue, 1)
		if data._OnPlayEvent then
			data._OnPlayEvent:Fire()
		end
		Module.RunCinematicLabel(data.Frame, data.Title, data.Description, data.Duration)
	end
end

function Module.Start()
	ScreenGui = HUDCommon.ensureScreenGui('HUD_Cinematic', 10)
	RootScope = scoped(Fusion)

	TopFrame    = buildCinematicBlock(RootScope, 'top')
	BottomFrame = buildCinematicBlock(RootScope, 'bottom')

	task.defer(function()
		while true do
			Module.OnUpdate()
			task.wait(0.25)
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Effects/RegionCinematics"><![CDATA[
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedSharedAssets = ReplicatedStorage:WaitForChild('AssetsShared')
local ReplicatedGameAssets = ReplicatedStorage:WaitForChild('Assets')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local ZoneService = ReplicatedModules.Services.ZoneService

local SystemsContainer = {}

local WHITELISTED_CINEMATIC_REGIONS = {'TestRegion1', 'TestRegion2', 'Town Of Beginnings'}

-- // Module // --
local Module = {}

Module.ActiveRegions = { }
Module.CinematicQueue = { Entered = {}, Left = {}, }

function Module.OnRegionsEntered()
	for _, regionName in ZoneService.GetZonesPlayerIsWithin(LocalPlayer) do
		if not table.find(WHITELISTED_CINEMATIC_REGIONS, regionName) then
			continue
		end
		if not table.find(Module.ActiveRegions, regionName) then
			table.insert(Module.CinematicQueue.Entered, regionName)
			table.insert(Module.ActiveRegions, regionName)
		end
	end
end

function Module.OnRegionsLeft()
	local function ArrayRemoveAll( array, value )
		local index = 1
		while index <= #array do
			if array[index] == value then
				table.remove(array, index)
			else
				index += 1
			end
		end
	end

	local index = 1
	while index <= #Module.ActiveRegions do
		local regionName = Module.ActiveRegions[index]
		if table.find(ZoneService.GetZonesPlayerIsWithin(LocalPlayer), regionName) then
			index += 1
		else
			ArrayRemoveAll( Module.CinematicQueue.Entered, regionName )
			-- table.insert( Module.CinematicQueue.Left, regionName )
			table.remove( Module.ActiveRegions, index )
		end
	end
end

function Module.UpdateCinematic()
	if #Module.CinematicQueue.Entered > 0 then
		local EnteredValues = Module.CinematicQueue.Entered
		Module.CinematicQueue.Entered = { }
		if #EnteredValues == 1 then
			SystemsContainer.CinematicLabels.CinematicTopWhite( "You have entered the region:", EnteredValues[1], 1 )
		else
			SystemsContainer.CinematicLabels.CinematicTopWhite( "You have entered the following regions:", table.concat(EnteredValues, " "), 1 )
		end
	elseif #Module.CinematicQueue.Left > 0 then
		local LeftValues = Module.CinematicQueue.Left
		Module.CinematicQueue.Left = { }
		if #Module.CinematicQueue.Left == 1 then
			SystemsContainer.CinematicLabels.CinematicTopWhite( "You have left the region:", LeftValues[1], 1 )
		else
			SystemsContainer.CinematicLabels.CinematicTopWhite( "You have left the following regions:", table.concat(LeftValues, " "), 1 )
		end
	end
end

function Module.Start()
	local RegionParts = ReplicatedGameAssets:FindFirstChild("Regions")
	if RegionParts then
		RegionParts.Parent = workspace
	else
		print("There is no Regions folder/model in ReplicatedStorage.Assets.")
	end

	ZoneService.ZoneEnter:Connect(function()
		Module.OnRegionsEntered()
	end)

	ZoneService.ZoneLeave:Connect(function()
		Module.OnRegionsLeft()
	end)

	task.spawn(function()
		while true do
			task.wait(0.2)
			Module.UpdateCinematic()
		end
	end)

end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Effects/CinematicClient"><![CDATA[-- Cinematic client — owns the camera state machine and per-cue rendering.
-- Receives cue cues over CinematicEvent and dispatches by Kind. The camera
-- has two orthogonal channels:
--   * BASE mode (Default | Tracking | Orbiting | LerpTo)
--   * SHAKE channel (additive perlin offset on top of base)
--
-- A `CameraTo`/`CameraTrack` switches the base mode; `CameraShake` writes
-- shake parameters that decay over `Duration`. RenderStepped composes both
-- into the final camera.CFrame.
--
-- Public API used by other systems (Dialogue, Cinematic, etc.):
--   Module.PlayCue(kind, args)        — direct dispatch (e.g. dialogue lines
--                                       embed cues without a full cinematic)

local UserInputService = game:GetService('UserInputService')
local RunService       = game:GetService('RunService')
local Players          = game:GetService('Players')
local Debris           = game:GetService('Debris')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local CinematicShared = ReplicatedModules.Services.CinematicShared
local SoundService    = ReplicatedModules.Services.SoundService
local RemoteService   = ReplicatedModules.Services.RemoteService

local CinematicEvent = RemoteService.GetRemote('CinematicEvent', 'RemoteEvent', false)

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Camera state.
----------------------------------------------------------------------
local CameraMode: 'Default' | 'LerpTo' | 'Track' | 'Orbit' = 'Default'
local CameraTarget: CFrame? = nil               -- LerpTo destination
local CameraLerpAlpha = 0                        -- 0..1 progress toward CameraTarget
local CameraLerpSpeed = 1.0                      -- per-second
local CameraTrackInstance: Instance? = nil
local CameraOrbitParams = { Radius = 16, Speed = 1, Pitch = -0.3 }
local CameraOrbitT = 0

-- Shake channel.
local Shake = {
	Active = false,
	Magnitude = 0, Roughness = 5, Duration = 0,
	StartTime = 0, FadeIn = 0, FadeOut = 0,
}

-- Lock state — driven by Begin/End cinematic events.
local MovementLocked = false
local HUDLocked = false
local SkipKeyCode: Enum.KeyCode? = nil
local ActiveCinematicId: string? = nil

----------------------------------------------------------------------
-- Per-cue dispatch.
----------------------------------------------------------------------
local DispatchTable = {} :: { [string]: (args: { [string]: any }) -> () }

DispatchTable[CinematicShared.CueKind.CameraTo] = function(args)
	local lerp = args.Lerp or 0.6
	local target: CFrame? = nil
	if args.Anchor == 'instance' and args.InstancePath then
		local inst = CinematicShared.ResolveInstancePath(args.InstancePath)
		if inst then
			-- PVInstance is the abstract base for Model + BasePart, both
			-- of which have :GetPivot(). Testing for the method via
			-- `:GetPivot and ...` is invalid Luau (method-call syntax
			-- can't reference without invoking), so use IsA gates.
			local offset = args.Offset or CFrame.new(0, 4, 8)
			if inst:IsA('PVInstance') then
				target = (inst :: PVInstance):GetPivot() * offset
			end
		end
	elseif args.Anchor == 'world' and args.Position then
		target = args.Position
	end
	if not target then return end
	CameraMode = 'LerpTo'
	CameraTarget = target
	CameraLerpAlpha = 0
	CameraLerpSpeed = math.max(0.05, lerp)
	CameraTrackInstance = nil
end

DispatchTable[CinematicShared.CueKind.CameraTrack] = function(args)
	local inst = args.InstancePath and CinematicShared.ResolveInstancePath(args.InstancePath)
	if not inst then return end
	CameraMode = 'Track'
	CameraTrackInstance = inst
	CameraOrbitParams.Radius = args.OrbitRadius or 16
	CameraOrbitParams.Speed  = args.OrbitSpeed or 0
	CameraOrbitParams.Pitch  = args.Pitch or -0.3
	CameraOrbitT = 0
	CameraMode = 'Orbit'
end

DispatchTable[CinematicShared.CueKind.CameraShake] = function(args)
	Shake.Active   = true
	Shake.Magnitude = args.Magnitude or 0.4
	Shake.Roughness = args.Roughness or 4
	Shake.Duration  = args.Duration or 0.4
	Shake.FadeIn    = args.FadeIn or 0.05
	Shake.FadeOut   = args.FadeOut or 0.2
	Shake.StartTime = os.clock()
end

DispatchTable[CinematicShared.CueKind.CameraReset] = function()
	CameraMode = 'Default'
	CameraTarget = nil
	CameraTrackInstance = nil
	local cam = workspace.CurrentCamera
	if cam then cam.CameraType = Enum.CameraType.Custom end
end

DispatchTable[CinematicShared.CueKind.PlaySFX] = function(args)
	if not args.Sound then return end
	local pos = args.Position
	if typeof(pos) ~= 'Vector3' then
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild('HumanoidRootPart')
		pos = hrp and (hrp :: BasePart).Position or workspace.CurrentCamera.CFrame.Position
	end
	SoundService.PlaySoundAtPosition(args.Sound, pos, args.Pitch)
end

-- Build a procedural placeholder ParticleEmitter so test surfaces produce
-- something visible even when the authored template is missing from
-- ReplicatedStorage.AssetsShared.VFX. Each preset name picks a hue so the
-- tester can tell `slash_burst` apart from `dust_poof` at a glance — purely
-- a debug affordance; once real assets land, this branch never runs.
local FALLBACK_VFX_COLORS: { [string]: Color3 } = {
	SlashBurst   = Color3.fromRGB(255, 230, 140),
	HitSpark     = Color3.fromRGB(255, 170,  80),
	DustPoof     = Color3.fromRGB(180, 160, 120),
	SmokePillar  = Color3.fromRGB(120, 120, 140),
	RuneCircle   = Color3.fromRGB(160, 120, 255),
	ScreenFlash  = Color3.fromRGB(255, 255, 255),
}
local function buildFallbackEmitter(templateName: string?, parent: Attachment)
	local emitter = Instance.new('ParticleEmitter')
	emitter.Name = 'FallbackVFX'
	local color = (templateName and FALLBACK_VFX_COLORS[templateName])
		or Color3.fromRGB(255, 200, 240)  -- magenta-pink: "missing asset" tint
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 0.7
	emitter.LightInfluence = 0
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.4),
		NumberSequenceKeypoint.new(0.5, 1.6),
		NumberSequenceKeypoint.new(1, 0.2),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime = NumberRange.new(0.5, 1.0)
	emitter.Rate = 0  -- one-shot only — Emit() below
	emitter.Speed = NumberRange.new(8, 14)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-180, 180)
	emitter.Texture = 'rbxasset://textures/particles/sparkles_main.dds'
	emitter.Parent = parent
	emitter:Emit(45)
	return emitter
end

DispatchTable[CinematicShared.CueKind.PlayVFX] = function(args)
	print(string.format('[CinematicClient] PlayVFX cue: template=%s anchor=%s instancePath=%s',
		tostring(args.TemplateName), tostring(args.Anchor), tostring(args.InstancePath)))

	local templateRoot = ReplicatedStorage:FindFirstChild('AssetsShared')
	templateRoot = templateRoot and templateRoot:FindFirstChild('VFX')
	local template = templateRoot and args.TemplateName and templateRoot:FindFirstChild(args.TemplateName, true)

	-- Resolve spawn position. Priority:
	--   1. Resolved instance path (when Anchor='instance')
	--   2. Explicit Position arg (when Anchor='world')
	--   3. Local player's HumanoidRootPart (the test surface always lands here)
	--   4. Camera CFrame (last-resort fallback for headless contexts)
	local pivot: CFrame
	local pivotSource: string
	if args.Anchor == 'instance' and args.InstancePath then
		local inst = CinematicShared.ResolveInstancePath(args.InstancePath)
		if inst and (inst :: any):IsA('BasePart') then
			pivot = (inst :: BasePart).CFrame
			pivotSource = 'instance(BasePart):' .. args.InstancePath
		elseif inst and inst:IsA('Model') then
			pivot = (inst :: Model):GetPivot()
			pivotSource = 'instance(Model):' .. args.InstancePath
		end
	end
	if not pivot and args.Position then
		pivot = typeof(args.Position) == 'CFrame' and args.Position or CFrame.new(args.Position)
		pivotSource = 'arg.Position'
	end
	if not pivot then
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild('HumanoidRootPart')
		if hrp and hrp:IsA('BasePart') then
			pivot = (hrp :: BasePart).CFrame
			pivotSource = 'localPlayer.HRP'
		end
	end
	if not pivot then
		pivot = workspace.CurrentCamera and workspace.CurrentCamera.CFrame or CFrame.new()
		pivotSource = 'camera'
	end

	-- Always create an Attachment in workspace.Terrain at the resolved pivot.
	-- ParticleEmitters / Beams / Trails / PointLights need a BasePart-or-
	-- Attachment parent to actually emit, so a free-floating Terrain
	-- Attachment is the most universal mount point. Author intent ("move
	-- attachments to move particles") is now natural — clone is reparented
	-- under this anchor.
	local anchor = Instance.new('Attachment')
	anchor.Name = 'CinematicVFX_' .. tostring(args.TemplateName or 'unknown')
	anchor.Parent = workspace.Terrain
	anchor.WorldCFrame = pivot
	Debris:AddItem(anchor, args.Duration or 3)

	print(string.format('[CinematicClient] VFX anchor at %s pivotSource=%s pos=(%.1f, %.1f, %.1f)',
		anchor:GetFullName(), pivotSource, pivot.Position.X, pivot.Position.Y, pivot.Position.Z))

	if not template then
		-- No authored template — spawn the procedural placeholder so the
		-- tester sees *something* and the AssetsShared.VFX missing-folder
		-- case is visually obvious.
		warn(string.format(
			'[CinematicClient] no VFX template %q under ReplicatedStorage.AssetsShared.VFX — using procedural fallback. Author the template to silence this warning.',
			tostring(args.TemplateName)))
		buildFallbackEmitter(args.TemplateName, anchor)
		return
	end

	print(string.format('[CinematicClient] VFX template found: %s (class=%s)',
		template:GetFullName(), template.ClassName))

	-- Reparent the clone under the anchor. For Attachment-typed templates,
	-- hoist their children into our anchor (Roblox doesn't allow nesting
	-- Attachments — children must be on a BasePart-or-Attachment parent,
	-- and our anchor IS the attachment). For everything else, parent the
	-- clone directly under the anchor; particle/light/etc. classes accept
	-- Attachments as parents and emit from the attachment's world position.
	local clone = template:Clone()
	if clone:IsA('Attachment') then
		for _, child in clone:GetChildren() do
			child.Parent = anchor
		end
		clone:Destroy()
	elseif clone:IsA('Model') then
		-- Models can't parent under an Attachment. Pivot it to the anchor's
		-- world position and parent to Terrain so it cleans up alongside
		-- the anchor (Debris on the anchor only kills the anchor — give
		-- the model its own Debris timer).
		clone:PivotTo(pivot)
		clone.Parent = workspace.Terrain
		Debris:AddItem(clone, args.Duration or 3)
	elseif clone:IsA('BasePart') then
		clone.CFrame = pivot
		clone.Parent = workspace.Terrain
		Debris:AddItem(clone, args.Duration or 3)
	else
		-- ParticleEmitter / Beam / Trail / PointLight / Sound / etc.
		-- Parent under the attachment so they emit at the anchor.
		clone.Parent = anchor
		-- One-shot emitter classes need an explicit Emit() to fire when
		-- their Rate is 0 (which is the typical authored shape). Best-
		-- effort — pcall protects against classes without :Emit().
		if clone:IsA('ParticleEmitter') then
			pcall(function() (clone :: ParticleEmitter):Emit(50) end)
		end
	end
end

DispatchTable[CinematicShared.CueKind.ShowLabel] = function(args)
	local CinematicLabels = SystemsContainer.CinematicLabels
		or (SystemsContainer.ParentSystems and SystemsContainer.ParentSystems.Effects
		    and SystemsContainer.ParentSystems.Effects.CinematicLabels)
	if not CinematicLabels then return end
	-- Use the high-level CinematicTopWhite / CinematicBottomWhite helpers,
	-- not AppendCinematic directly — AppendCinematic's first arg is a
	-- CinematicFrame ref (TopFrame / BottomFrame), not a title string.
	if args.Anchor == 'top' or args.Anchor == nil then
		if CinematicLabels.CinematicTopWhite then
			CinematicLabels.CinematicTopWhite(args.Title or '', args.Subtitle or '')
		end
	else
		if CinematicLabels.CinematicBottomWhite then
			CinematicLabels.CinematicBottomWhite(args.Title or '', args.Subtitle or '')
		end
	end
end

DispatchTable[CinematicShared.CueKind.HideLabel] = function()
	-- CinematicLabels has its own auto-fade; explicit hide is a hint, not a hard requirement.
end

DispatchTable[CinematicShared.CueKind.WaitFor] = function() end

DispatchTable[CinematicShared.CueKind.StartDialogue] = function(args)
	local Dialogue = SystemsContainer.DialogueWidget
		or (SystemsContainer.ParentSystems and SystemsContainer.ParentSystems.Widgets
		    and SystemsContainer.ParentSystems.Widgets.DialogueWidget)
	if Dialogue and Dialogue.RequestStart then
		Dialogue.RequestStart(args.DialogueId, args.NPCInstancePath)
	end
end

----------------------------------------------------------------------
-- Public direct-dispatch entry point (used by DialogueClient etc.)
----------------------------------------------------------------------
function Module.PlayCue(kind: string, args: { [string]: any }?)
	local fn = DispatchTable[kind]
	if not fn then
		warn(string.format('[CinematicClient] PlayCue: no dispatcher for kind %q', tostring(kind)))
		return
	end
	fn(args or {})
end

-- Forward declarations so the public API below can refer to the
-- locks helper before its definition (it lives near the other
-- private functions, and Lua local-function ordering matters for
-- closures captured at module-load time).
local applyLocks

-- Public lock-toggle. CinematicCharacter (runtime shot API) drives
-- locks for hold-style shots without needing to author a full
-- cinematic envelope.
function Module.ApplyLocks(lockMovement: boolean, lockHUD: boolean)
	applyLocks(lockMovement, lockHUD)
end

----------------------------------------------------------------------
-- HUD/movement lock.
----------------------------------------------------------------------
local PlayerControls
local function getControls()
	if PlayerControls then return PlayerControls end
	local ok, mod = pcall(function()
		return require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('PlayerModule'))
	end)
	if ok and mod and mod.GetControls then
		PlayerControls = mod:GetControls()
	end
	return PlayerControls
end

function applyLocks(lockMovement: boolean, lockHUD: boolean)
	MovementLocked = lockMovement
	HUDLocked = lockHUD
	local controls = getControls()
	if controls then
		if lockMovement then controls:Disable() else controls:Enable() end
	end
	-- HUD fade — best-effort; if HUDCommon doesn't expose a master fade,
	-- this no-ops and the HUD stays visible. (Adding a master fade is a
	-- future polish; the cinematic itself still works.)
	if typeof(HUDCommon.SetHUDLocked) == 'function' then
		HUDCommon.SetHUDLocked(lockHUD)
	end
end

----------------------------------------------------------------------
-- RenderStepped composition.
----------------------------------------------------------------------
local function computeShakeOffset(now: number): CFrame
	if not Shake.Active then return CFrame.identity end
	local elapsed = now - Shake.StartTime
	if elapsed >= Shake.Duration then
		Shake.Active = false
		return CFrame.identity
	end
	local env = 1
	if elapsed < Shake.FadeIn then env = elapsed / math.max(Shake.FadeIn, 1e-3)
	elseif elapsed > (Shake.Duration - Shake.FadeOut) then
		env = math.max(0, (Shake.Duration - elapsed) / math.max(Shake.FadeOut, 1e-3))
	end
	-- Perlin sampled at three offset axes so X/Y/Z move independently.
	local r = Shake.Roughness
	local n = function(seed) return (math.noise(elapsed * r, seed) * 2) end
	local m = Shake.Magnitude * env
	return CFrame.new(n(0) * m, n(0.37) * m, n(0.91) * m)
		* CFrame.Angles(n(1.3) * m * 0.05, n(2.1) * m * 0.05, n(2.9) * m * 0.05)
end

local function step(dt: number)
	local cam = workspace.CurrentCamera
	if not cam then return end

	local now = os.clock()
	local shakeOffset = computeShakeOffset(now)

	if CameraMode == 'LerpTo' and CameraTarget then
		cam.CameraType = Enum.CameraType.Scriptable
		CameraLerpAlpha = math.min(1, CameraLerpAlpha + dt / CameraLerpSpeed)
		local t = CameraLerpAlpha * CameraLerpAlpha * (3 - 2 * CameraLerpAlpha)  -- smoothstep
		cam.CFrame = cam.CFrame:Lerp(CameraTarget, t) * shakeOffset
	elseif CameraMode == 'Orbit' and CameraTrackInstance then
		cam.CameraType = Enum.CameraType.Scriptable
		CameraOrbitT = CameraOrbitT + dt * CameraOrbitParams.Speed
		local target: CFrame
		if CameraTrackInstance:IsA('BasePart') then
			target = CameraTrackInstance.CFrame
		elseif CameraTrackInstance:IsA('Model') then
			target = (CameraTrackInstance :: Model):GetPivot()
		else
			target = cam.CFrame
		end
		local r = CameraOrbitParams.Radius
		local p = CameraOrbitParams.Pitch
		local x = math.cos(CameraOrbitT) * r
		local z = math.sin(CameraOrbitT) * r
		local eye = target.Position + Vector3.new(x, math.sin(p) * r, z)
		cam.CFrame = CFrame.lookAt(eye, target.Position) * shakeOffset
	elseif Shake.Active and CameraMode == 'Default' then
		-- Default camera + additive shake. Re-target every frame to avoid
		-- drifting away from where Roblox's default camera "wants" to be.
		cam.CFrame = cam.CFrame * shakeOffset
	end
end

----------------------------------------------------------------------
-- Module lifecycle.
----------------------------------------------------------------------
function Module.Start()
	RunService.RenderStepped:Connect(step)

	CinematicEvent.OnClientEvent:Connect(function(action, ...)
		if action == CinematicShared.CinematicActions.Begin then
			local cinematicId, blob = ...
			ActiveCinematicId = cinematicId
			-- SkipKeyCode arrives as the EnumItem's numeric .Value (e.g. 27
			-- for Escape). Reconstruct via CinematicShared.EnumItemFromValue —
			-- Enum.KeyCode is name-indexable only, so Enum.KeyCode[27] errors.
			SkipKeyCode = blob and blob.SkipKeyCode
				and CinematicShared.EnumItemFromValue(Enum.KeyCode, blob.SkipKeyCode)
				or nil
			applyLocks((blob and blob.LockMovement) == true, (blob and blob.LockHUD) == true)
		elseif action == CinematicShared.CinematicActions.Cue then
			local _cueIdx, kind, args = ...
			Module.PlayCue(kind, args)
		elseif action == CinematicShared.CinematicActions.End then
			ActiveCinematicId = nil
			SkipKeyCode = nil
			-- Restore camera + locks.
			DispatchTable[CinematicShared.CueKind.CameraReset]({})
			applyLocks(false, false)
		end
	end)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if SkipKeyCode and input.KeyCode == SkipKeyCode and ActiveCinematicId then
			CinematicEvent:FireServer(CinematicShared.CinematicActions.Skip)
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Effects/LevelUpClient"><![CDATA[-- Level-up client. Plays the full level-up beat for the local player
-- and a reduced version for other players. Three layers:
--
--   1. World VFX  — expanding ring + point light + particle burst at
--                   the leveling player's HRP (everyone sees these)
--   2. Audio     — golden chime SFX positional at the HRP
--   3. Onscreen  — big "LEVEL UP" overlay with the new level (only
--                  shown to the leveling player; locked to camera)
--
-- The particle emitter is built procedurally from a small spec table
-- so we don't depend on art assets that may not be in the project
-- yet — designers can replace SpawnLevelUpParticles with a clone of
-- a real AssetsShared template once art lands.

local Players      = game:GetService('Players')
local Debris       = game:GetService('Debris')
local TweenService = game:GetService('TweenService')
local RunService   = game:GetService('RunService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion        = ReplicatedModules.Libraries.Fusion
local scoped        = Fusion.scoped
local doCleanup     = Fusion.doCleanup

local RemoteService = ReplicatedModules.Services.RemoteService
local SoundService  = ReplicatedModules.Services.SoundService

local LevelUpEvent = RemoteService.GetRemote('LevelUpEvent', 'RemoteEvent', false)

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local SystemsContainer = {}

local Module = {}

-- Default sound. Designers swap this constant when the dedicated
-- level-up chime asset is finalized; a TestSound id is fine for
-- placeholder play-through. Pitch + volume are tuned to feel "warm
-- chime" rather than "trumpet blast".
local LEVELUP_SOUND_ID = 'rbxassetid://9114015882'
local LEVELUP_SOUND_VOLUME = 0.8
local LEVELUP_SOUND_PITCH  = 1.0

----------------------------------------------------------------------
-- Particle burst — procedural so it works without bundled assets.
-- Emits ~30 sparkles over a 0.4s window from an attachment at the
-- character's HRP, then auto-cleans the attachment via Debris.
----------------------------------------------------------------------
local function spawnLevelUpParticles(hrp: BasePart)
	local att = Instance.new('Attachment')
	att.Name = 'LevelUpEmit'
	att.Parent = hrp

	local emitter = Instance.new('ParticleEmitter')
	-- Default texture — Roblox's built-in twinkle. Swap for an
	-- AssetsShared.VFX.LevelUp asset when art is ready.
	emitter.Texture = 'rbxasset://textures/particles/sparkles_main.dds'
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.6, 1.0)
	emitter.Speed = NumberRange.new(8, 14)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-180, 180)
	emitter.Acceleration = Vector3.new(0, -10, 0)
	emitter.LightEmission = 0.7
	emitter.LightInfluence = 0
	emitter.Color = ColorSequence.new(Color3.fromRGB(255, 220, 130), Color3.fromRGB(255, 240, 180))
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(0.7, 0.4),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.6),
		NumberSequenceKeypoint.new(0.5, 0.9),
		NumberSequenceKeypoint.new(1, 0.2),
	})
	emitter.Drag = 1.5
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Parent = att

	-- Two bursts: a big ground-anchored pop, then a smaller follow-up
	-- so the burst doesn't visually flatline after one frame.
	emitter:Emit(28)
	task.delay(0.18, function()
		if emitter.Parent then emitter:Emit(14) end
	end)

	Debris:AddItem(att, 1.4)
end

----------------------------------------------------------------------
-- Onscreen overlay — Fusion-managed big "LEVEL UP" pop. Locked to
-- a per-event scope so a fresh level-up mid-fade tears down the
-- previous overlay cleanly. Local player only.
----------------------------------------------------------------------
local OverlayScope = nil
local OverlayGui: ScreenGui? = nil

local function tearDownOverlay()
	if OverlayScope then doCleanup(OverlayScope); OverlayScope = nil end
	if OverlayGui then OverlayGui:Destroy(); OverlayGui = nil end
end

local function showLocalOverlay(newLevel: number, levelsGained: number?)
	tearDownOverlay()
	OverlayGui = HUDCommon.ensureScreenGui('HUD_LevelUpOverlay', 80)
	OverlayScope = scoped(Fusion)
	local scope = OverlayScope

	-- Animation state. `progress` runs 0 → 1 across the full overlay
	-- lifetime; the labels' transparency / scale Computed off it.
	local progress = scope:Value(0)

	-- Driver loop. Heartbeat-driven Computed-friendly timeline; we
	-- don't tween Fusion Values via TweenService directly because
	-- Fusion Values aren't Instance properties. Manual lerp keeps the
	-- math local + readable.
	local IN_TIME, HOLD_TIME, OUT_TIME = 0.35, 1.0, 0.6
	local TOTAL = IN_TIME + HOLD_TIME + OUT_TIME

	scope:New('Frame') {
		Name = 'LevelUpOverlay',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.fromOffset(640, 180),
		BackgroundTransparency = 1,
		Parent = OverlayGui,
		[Fusion.Children] = {
			-- Big "LEVEL UP" word.
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.fromScale(0.5, 0),
				Size = UDim2.fromScale(1, 0.55),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = 'LEVEL UP',
				TextScaled = true,
				TextColor3 = PALETTE.gold,
				TextStrokeColor3 = Color3.new(0, 0, 0),
				TextStrokeTransparency = 0.2,
				TextTransparency = scope:Computed(function(use)
					local p = use(progress)
					if p < IN_TIME / TOTAL then
						return 1 - (p / (IN_TIME / TOTAL))
					elseif p > 1 - (OUT_TIME / TOTAL) then
						return (p - (1 - OUT_TIME / TOTAL)) / (OUT_TIME / TOTAL)
					end
					return 0
				end),
				[Fusion.Children] = {
					scope:New('UIScale') {
						-- Scale pulse: pop up to 1.05× during hold, settle.
						Scale = scope:Computed(function(use)
							local p = use(progress)
							if p < IN_TIME / TOTAL then
								local t = p / (IN_TIME / TOTAL)
								return 0.7 + 0.4 * t  -- 0.7 → 1.1
							elseif p < (IN_TIME + 0.2) / TOTAL then
								local t = (p - IN_TIME / TOTAL) / (0.2 / TOTAL)
								return 1.1 - 0.05 * t  -- 1.1 → 1.05
							end
							return 1.05
						end),
					},
				},
			},
			-- New level number ('Lv. 12' or 'Lv. 12 (+2)' if multi-up)
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.fromScale(0.5, 1),
				Size = UDim2.fromScale(1, 0.4),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = (levelsGained and levelsGained > 1)
					and string.format('Lv. %d (+%d)', newLevel, levelsGained)
					or  string.format('Lv. %d', newLevel),
				TextScaled = true,
				TextColor3 = PALETTE.ink,
				TextStrokeColor3 = Color3.new(0, 0, 0),
				TextStrokeTransparency = 0.4,
				TextTransparency = scope:Computed(function(use)
					-- Sub-label slightly delayed in / lingering out.
					local p = use(progress)
					local subIn = IN_TIME / TOTAL + 0.05
					if p < subIn then
						return math.max(0, 1 - p / subIn)
					elseif p > 1 - (OUT_TIME * 0.8) / TOTAL then
						return (p - (1 - OUT_TIME * 0.8 / TOTAL)) / (OUT_TIME * 0.8 / TOTAL)
					end
					return 0
				end),
			},
		},
	}

	-- Drive the timeline. Heartbeat tick advances progress until
	-- TOTAL elapses, then teardown. Cancellation: tearDownOverlay
	-- destroys OverlayScope, which sets `progress` to nil; we read
	-- through a local capture so the loop bails on next iteration.
	local localProgress = progress
	local startedAt = os.clock()
	local conn
	conn = RunService.Heartbeat:Connect(function()
		local elapsed = os.clock() - startedAt
		if elapsed >= TOTAL then
			conn:Disconnect()
			-- Defensive — only tear down if we're still the active
			-- overlay (a fresh level-up mid-tween already torn us down).
			if localProgress == progress then
				tearDownOverlay()
			end
			return
		end
		if localProgress == progress then
			localProgress:set(elapsed / TOTAL)
		else
			-- Superseded by a fresh level-up; stop driving.
			conn:Disconnect()
		end
	end)
end

----------------------------------------------------------------------
-- World VFX — runs for every observer (the leveling player + any
-- nearby player). Particle/ring/light layered for a cohesive pop.
----------------------------------------------------------------------
local function runWorldVFX(player: Player)
	local character = player.Character
	local hrp = character and character:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not hrp then return end

	-- Expanding cylinder ring of light at the character's feet.
	local ring = Instance.new('Part')
	ring.Name = 'LevelUpRing'
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.2, 1, 1)
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(255, 220, 130)
	ring.CFrame = hrp.CFrame * CFrame.new(0, -2.8, 0) * CFrame.Angles(0, 0, math.rad(90))
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Transparency = 0.2
	ring.Parent = workspace.Terrain

	local growth = TweenService:Create(ring, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.2, 14, 14),
		Transparency = 1,
	})
	growth:Play()
	Debris:AddItem(ring, 0.7)

	-- Aura point light flash.
	local light = Instance.new('PointLight')
	light.Color = Color3.fromRGB(255, 220, 130)
	light.Brightness = 4
	light.Range = 14
	light.Parent = hrp
	task.delay(0.4, function() if light.Parent then light:Destroy() end end)

	-- Particle burst.
	spawnLevelUpParticles(hrp)

	-- Audio — positional so distant level-ups feel placed in space.
	if SoundService and SoundService.PlaySoundAtPosition then
		local pos = hrp.Position
		SoundService.PlaySoundAtPosition(LEVELUP_SOUND_ID, pos, LEVELUP_SOUND_PITCH)
	else
		-- Fallback: spawn a one-shot sound parented to terrain.
		local sound = Instance.new('Sound')
		sound.SoundId = LEVELUP_SOUND_ID
		sound.Volume  = LEVELUP_SOUND_VOLUME
		sound.PlaybackSpeed = LEVELUP_SOUND_PITCH
		sound.RollOffMode = Enum.RollOffMode.InverseTapered
		sound.Parent = hrp
		sound:Play()
		Debris:AddItem(sound, 3)
	end
end

----------------------------------------------------------------------
-- Public entry — called from Module.Start's remote listener AND
-- exposed for cmdr / debug paths to fire a synthetic level-up.
----------------------------------------------------------------------
function Module.PlayLevelUp(player: Player, newLevel: number, levelsGained: number?)
	runWorldVFX(player)

	if player == LocalPlayer then
		showLocalOverlay(newLevel, levelsGained)

		-- Camera shake — only for the local rider, via cinematic client.
		local CinematicClient = SystemsContainer.CinematicClient
			or (SystemsContainer.ParentSystems and SystemsContainer.ParentSystems.Effects
				and SystemsContainer.ParentSystems.Effects.CinematicClient)
		if CinematicClient and CinematicClient.PlayCue then
			CinematicClient.PlayCue('CameraShake', {
				Magnitude = 0.4, Roughness = 5, Duration = 0.4, FadeIn = 0.05, FadeOut = 0.25,
			})
		end
	end
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	LevelUpEvent.OnClientEvent:Connect(function(player, newLevel, levelsGained)
		Module.PlayLevelUp(player, newLevel, levelsGained)
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Effects/CinematicCharacter"><![CDATA[-- CinematicCharacter — high-level runtime shot API. Picks a camera
-- shot preset (over-shoulder, low-hero, etc.) and frames it against
-- a Model reference at runtime. Wrapper over CinematicClient.PlayCue
-- so the camera FSM stays the only owner of camera state.
--
-- Usage (from any client-side gameplay code):
--   local Cinematic = SystemsContainer.CinematicCharacter
--   Cinematic.OverTheShoulderSwitch(npcModel)
--   Cinematic.LowHero(bossModel, { Lerp = 0.3, ExtraCFrame = CFrame.new(0, 0.5, 0) })
--   Cinematic.SnapClose(npcModel, { Hold = 2.5 })  -- auto-reset after 2.5s
--   Cinematic.Reset()
--
-- Options (`opts` table, all fields optional):
--   Lerp        : number  — override preset's Lerp (lower = snappier)
--   Snap        : boolean — bypass lerp; effectively-instant cut
--   ExtraCFrame : CFrame  — composed onto preset.Offset (translate +
--                            rotate the framing without authoring a
--                            new preset)
--   LockMovement: boolean — disable WASD while shot active
--   LockHUD     : boolean — fade HUD while shot active
--   Hold        : number  — auto-reset after this many seconds
--   OnReset     : ()->()  — called when the auto-reset fires (or
--                            manual Reset() interrupts the hold)
--
-- All shot helpers route through SetShot, so adding a new preset
-- in CinematicPresets.CameraShots makes it available immediately
-- via SetShot(model, '<presetName>', opts) without code changes.

local Players = game:GetService('Players')

local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CinematicShared  = ReplicatedModules.Services.CinematicShared
local CinematicPresets = ReplicatedModules.Data.CinematicPresets

-- Sibling controllers populated via Init.
local SystemsContainer = {}

-- Snap "lerp" — small enough that one frame's `dt / Lerp` >= 1 so
-- CinematicClient's smoothstep clamps to the destination. Not zero
-- (would div-by-zero); not large (would feel laggy).
local SNAP_LERP_SECONDS = 1e-3

local Module = {}

----------------------------------------------------------------------
-- Active-shot bookkeeping. Tracks the current hold-timer so a fresh
-- shot cancels any pending auto-reset from a previous one. Generation
-- counter prevents a stale task.delay from resetting the camera mid-
-- new-shot.
----------------------------------------------------------------------
local ActiveGeneration = 0
local ActiveOnReset: (() -> ())? = nil

local function bumpGeneration(): number
	ActiveGeneration += 1
	return ActiveGeneration
end

----------------------------------------------------------------------
-- Cue dispatch helper. Resolves dependencies once per call so this
-- module survives a cinematic-controller reload at runtime (Studio
-- iteration). Returns the live CinematicClient or nil.
----------------------------------------------------------------------
local function getClient()
	-- SystemsContainer is the framework-injected sibling map. The
	-- ParentSystems walk handles cases where CinematicCharacter ends
	-- up in a different namespace folder than CinematicClient.
	local client = SystemsContainer.CinematicClient
	if client then return client end
	if SystemsContainer.ParentSystems then
		local effects = SystemsContainer.ParentSystems.Effects
		if effects and effects.CinematicClient then
			return effects.CinematicClient
		end
	end
	return nil
end

----------------------------------------------------------------------
-- Resolve a Model + shot preset into a world-space CameraTo cue
-- argument. Builder-style internal: keeps SetShot's body short and
-- the offset composition order (preset → extra) consistent.
----------------------------------------------------------------------
local function buildCameraToArgs(model: Model, presetName: string, opts: { [string]: any }?): { [string]: any }?
	if not model or not model:IsA('Model') then return nil end
	local pivot = model:GetPivot()
	local shot = CinematicPresets.ResolveShot(presetName)
	-- ExtraCFrame is composed *after* the preset offset so authors
	-- can think of it as "additional framing relative to the shot's
	-- viewpoint." e.g. `ExtraCFrame = CFrame.new(0, 0.5, 0)` raises
	-- the camera 0.5 studs above whatever the preset chose.
	local offset = shot.Offset
	if opts and typeof(opts.ExtraCFrame) == 'CFrame' then
		offset = offset * opts.ExtraCFrame
	end
	local lerp = (opts and opts.Lerp) or shot.Lerp
	if opts and opts.Snap == true then
		lerp = SNAP_LERP_SECONDS
	end
	return {
		Anchor   = 'world',
		Position = pivot * offset,
		Lerp     = math.max(SNAP_LERP_SECONDS, lerp),
	}
end

----------------------------------------------------------------------
-- Public API.
----------------------------------------------------------------------

-- Generic shot-set. Every named helper below is a thin call into
-- this; SetShot can also reach presets the helpers don't wrap.
function Module.SetShot(model: Model, presetName: string, opts: { [string]: any }?)
	local client = getClient()
	if not client then
		warn('CinematicCharacter.SetShot: CinematicClient unavailable')
		return
	end

	local args = buildCameraToArgs(model, presetName, opts)
	if not args then return end

	-- Cancel any in-flight auto-reset before starting a new shot.
	-- The previous OnReset (if any) is called so cleanup hooks
	-- (locking, UI fades) get notified that the shot is being
	-- replaced rather than naturally ending.
	if ActiveOnReset then
		local prev = ActiveOnReset
		ActiveOnReset = nil
		task.spawn(prev)
	end
	local generation = bumpGeneration()

	client.PlayCue(CinematicShared.CueKind.CameraTo, args)

	-- Locks. Apply when set; the matching restore runs on Reset() or
	-- when the auto-reset fires below.
	if opts and (opts.LockMovement == true or opts.LockHUD == true) then
		client.ApplyLocks(opts.LockMovement == true, opts.LockHUD == true)
	end

	if opts and typeof(opts.Hold) == 'number' and opts.Hold > 0 then
		ActiveOnReset = opts.OnReset
		task.delay(opts.Hold, function()
			-- Bail if a newer shot superseded this one; cancellation
			-- is silent because SetShot already invoked the prior
			-- OnReset.
			if generation ~= ActiveGeneration then return end
			Module.Reset()
		end)
	else
		ActiveOnReset = opts and opts.OnReset or nil
	end
end

-- Reset the camera to the default Roblox-controlled mode. Releases
-- locks and invokes the active OnReset hook (if any). Idempotent —
-- calling Reset on an already-default camera is a cheap no-op.
function Module.Reset()
	local client = getClient()
	if not client then return end
	bumpGeneration()
	client.PlayCue(CinematicShared.CueKind.CameraReset, {})
	client.ApplyLocks(false, false)
	if ActiveOnReset then
		local cb = ActiveOnReset
		ActiveOnReset = nil
		task.spawn(cb)
	end
end

----------------------------------------------------------------------
-- Named shot helpers. Each one is the single line a gameplay
-- programmer wants to write — `Cinematic.OverTheShoulderSwitch(npc)`
-- reads at the call-site without a string-typed second arg.
----------------------------------------------------------------------
function Module.OverTheShoulderSwitch(model: Model, opts: { [string]: any }?)
	Module.SetShot(model, 'over_shoulder', opts)
end

function Module.Closeup(model: Model, opts: { [string]: any }?)
	Module.SetShot(model, 'closeup', opts)
end

function Module.LowHero(model: Model, opts: { [string]: any }?)
	Module.SetShot(model, 'low_hero', opts)
end

function Module.WideEstablishing(model: Model, opts: { [string]: any }?)
	Module.SetShot(model, 'wide_establishing', opts)
end

function Module.ProfileLeft(model: Model, opts: { [string]: any }?)
	Module.SetShot(model, 'profile_left', opts)
end

function Module.ProfileRight(model: Model, opts: { [string]: any }?)
	Module.SetShot(model, 'profile_right', opts)
end

function Module.SnapClose(model: Model, opts: { [string]: any }?)
	-- snap_close preset already has a tight Lerp; merging Snap=true
	-- via the opts pipe forces the SNAP_LERP_SECONDS path so the cut
	-- is always 1-frame regardless of the preset's authored value.
	local merged: { [string]: any } = { Snap = true }
	if opts then
		for k, v in opts do merged[k] = v end
		-- Allow caller to opt out of Snap via opts.Snap=false.
		if opts.Snap == false then merged.Snap = false end
	end
	Module.SetShot(model, 'snap_close', merged)
end

----------------------------------------------------------------------
-- Self-target helpers. Useful for player-perspective beats — frame
-- *the local player* with one of the named shots without needing
-- to fetch their character every call.
----------------------------------------------------------------------
local function localCharacter(): Model?
	return LocalPlayer.Character
end

function Module.SelfShot(presetName: string, opts: { [string]: any }?)
	local char = localCharacter()
	if not char then return end
	Module.SetShot(char, presetName, opts)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

function Module.Start()
	-- No bound input or render loop here — this module is purely
	-- API. Reset on local player respawn so a death mid-shot doesn't
	-- leave the camera stuck pointing at the previous body.
	LocalPlayer.CharacterAdded:Connect(function()
		Module.Reset()
	end)
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Effects/AttributeLevelUpClient"><![CDATA[-- Attribute level-up client. Renders a *subtler* version of the
-- character level-up — small particle puff at the HRP, a softer
-- chime, and no onscreen overlay (the toast carries the textual
-- feedback). Triggered when AttributeServer.CheckAttributeLeveling
-- promotes any attribute (Strength → 5, Vitality → 3, etc.).
--
-- Why two effects instead of reusing LevelUpClient: attribute
-- level-ups happen far more often than character level-ups (every
-- few hits during sustained combat once XP grants stack). A full
-- LevelUp pop on every Strength tick would be obnoxious — this
-- effect is intentionally short, single-burst, and quiet.

local Players = game:GetService('Players')
local Debris  = game:GetService('Debris')
local TweenService = game:GetService('TweenService')

local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local RemoteService = ReplicatedModules.Services.RemoteService
local SoundService  = ReplicatedModules.Services.SoundService

local AttributeLevelUpEvent = RemoteService.GetRemote('AttributeLevelUpEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

-- Subtler than the full level-up chime. Lower volume + slightly
-- detuned playback so it reads as a "tick" rather than a "fanfare."
local ATTR_SOUND_ID     = 'rbxassetid://9114015882'
local ATTR_SOUND_VOLUME = 0.35
local ATTR_SOUND_PITCH  = 1.4

----------------------------------------------------------------------
-- Particle puff. Single short burst at the local player's HRP. ~10
-- particles, white/cyan-tinged, fast cleanup so back-to-back ticks
-- don't pile up emitters.
----------------------------------------------------------------------
local function spawnPuff(hrp: BasePart)
	local att = Instance.new('Attachment')
	att.Name = 'AttrLevelUpEmit'
	-- Float slightly above shoulder so the puff isn't lost in the
	-- character's torso-clipping radius.
	att.CFrame = CFrame.new(0, 1, 0)
	att.Parent = hrp

	local emitter = Instance.new('ParticleEmitter')
	emitter.Texture = 'rbxasset://textures/particles/sparkles_main.dds'
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.4, 0.7)
	emitter.Speed = NumberRange.new(3, 6)
	emitter.SpreadAngle = Vector2.new(60, 60)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-90, 90)
	emitter.Acceleration = Vector3.new(0, 1.5, 0)  -- gentle rise, not the gravity-heavy LevelUp drop
	emitter.LightEmission = 0.5
	emitter.Color = ColorSequence.new(Color3.fromRGB(220, 240, 255), Color3.fromRGB(180, 220, 255))
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(0.6, 0.5),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 0.05),
	})
	emitter.Drag = 1.0
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Parent = att

	emitter:Emit(10)
	-- 0.9s lifetime cap > particle Lifetime max, so the longest-lived
	-- particle finishes before the emitter detaches.
	Debris:AddItem(att, 0.9)
end

----------------------------------------------------------------------
-- Optional aura ring — much smaller than the character level-up's
-- 14-stud expanding cylinder. Just a quick 3-stud halo to mark the
-- moment without dominating the screen.
----------------------------------------------------------------------
local function spawnHalo(hrp: BasePart)
	local ring = Instance.new('Part')
	ring.Name = 'AttrLevelUpHalo'
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.1, 1, 1)
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(190, 220, 255)
	ring.CFrame = hrp.CFrame * CFrame.new(0, -2.6, 0) * CFrame.Angles(0, 0, math.rad(90))
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Transparency = 0.5
	ring.Parent = workspace.Terrain

	TweenService:Create(ring, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.1, 6, 6),
		Transparency = 1,
	}):Play()
	Debris:AddItem(ring, 0.5)
end

----------------------------------------------------------------------
-- Public entry — fired by the remote listener.
----------------------------------------------------------------------
function Module.PlayAttributeLevelUp(_attributeId: string, _newLevel: number, _levelsGained: number?)
	local character = LocalPlayer.Character
	local hrp = character and character:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not hrp then return end

	spawnPuff(hrp)
	spawnHalo(hrp)

	-- Quiet positional sound. SoundService helper handles the
	-- terrain-attachment + auto-debris pattern.
	if SoundService and SoundService.PlaySoundAtPosition then
		SoundService.PlaySoundAtPosition(ATTR_SOUND_ID, hrp.Position, ATTR_SOUND_PITCH)
	else
		local sound = Instance.new('Sound')
		sound.SoundId = ATTR_SOUND_ID
		sound.Volume  = ATTR_SOUND_VOLUME
		sound.PlaybackSpeed = ATTR_SOUND_PITCH
		sound.RollOffMode = Enum.RollOffMode.InverseTapered
		sound.Parent = hrp
		sound:Play()
		Debris:AddItem(sound, 2)
	end
end

function Module.Start()
	AttributeLevelUpEvent.OnClientEvent:Connect(function(attributeId, newLevel, levelsGained)
		Module.PlayAttributeLevelUp(attributeId, newLevel, levelsGained)
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Effects/DamageIndicator"><![CDATA[local TweenService = game:GetService('TweenService')

local Players = game:GetService('Players')
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local RemoteService = ReplicatedModules.Services.RemoteService
local DamageIndicatorEvent = RemoteService.GetRemote('DamageIndicatorEvent', 'RemoteEvent', false)
local CombatUtility = ReplicatedModules.Utility.CombatUtility

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE = HUDCommon.PALETTE

local SystemsContainer = {}

-- Reference: hud.jsx DmgNumber — crit => gold + larger, heal => success, plain => white.
-- The current server signature only sends (Humanoid, Damage), so crit/kind aren't inferable
-- here. Flag a crit heuristically when the damage is large (>= 50) to approximate the
-- visual pop from the mockup without changing the remote contract.
local function styleForDamage(damage: number): (Color3, number, boolean)
	local isCrit = damage >= 50
	if isCrit then
		return PALETTE.gold, 34, true
	end
	return PALETTE.ink, 22, false
end

-- // Module // --
local Module = {}

function Module.OnDamageIndicator( Humanoid, Damage )

	-- Batched form: server collapsed N hits per swing into one FireAllClients
	-- carrying a flat {humanoid, damage, humanoid, damage, ...} array. Detect
	-- by typeof — single-hit callers (status ticks, companion shots) still send
	-- (Humanoid, Damage) and land in the legacy path below.
	if typeof(Humanoid) == 'table' then
		local buffer = Humanoid
		for i = 1, #buffer, 2 do
			local h = buffer[i]
			local d = buffer[i + 1]
			if typeof(h) == 'Instance' and typeof(d) == 'number' then
				Module.OnDamageIndicator(h, d)
			end
		end
		return
	end

	local Position = Humanoid.Parent:GetPivot().Position

	local Att = Instance.new('Attachment')
	Att.Name = Humanoid:GetFullName()
	Att.WorldCFrame = CFrame.new( Position )
	Att.Parent = workspace.Terrain

	local color, textSize, isCrit = styleForDamage(Damage)

	local billboard = Instance.new('BillboardGui')
	billboard.Name = 'DamageIndicator'
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.Size = UDim2.fromScale(3, 1)
	billboard.MaxDistance = 160
	billboard.Enabled = true

	local label = Instance.new('TextLabel')
	label.Name = 'Label'
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.FontFace = HUDCommon.FONT_DISPLAY
	label.TextSize = textSize
	label.TextColor3 = color
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0.2
	-- Formatted rather than tostring()'d. DamageModule already rounds, but
	-- this remote is also fired directly by status ticks, skills and world
	-- hazards, and a raw tostring on an unrounded float32 delta renders as
	-- '13.699999809265137' across the screen.
	local damageText = CombatUtility.FormatCombatNumber(Damage)
	label.Text = isCrit and (damageText .. '!') or damageText
	label.Parent = billboard

	billboard.Parent = Att

	task.delay(1.5, function()
		for alpha = 1, 0, -0.05 do
			billboard.Size = UDim2.fromScale( 3 * alpha, alpha )
			Att.WorldCFrame *= CFrame.new(0, 0.05, 0)
			task.wait()
		end
		Att:Destroy()
	end)

end

function Module.Start()

	DamageIndicatorEvent.OnClientEvent:Connect(Module.OnDamageIndicator)

end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Effects/EnemyTelegraphClient"><![CDATA[-- EnemyTelegraphClient — renders the "red outline + progress bar" for
-- enemy attack windups. Subscribes to EnemyTelegraphEvent (Show / Hide
-- actions) and builds an anchored, non-collidable ground plane part
-- with a SurfaceGui showing a horizontal progress bar that fills over
-- the windup duration.
--
-- Visual design (World Zero / Dungeon Heroes feel):
--   * Translucent red FILL covering the full hit volume.
--   * Brighter red OUTLINE so the edge of the danger zone reads at a
--     glance even when the fill blends with the terrain.
--   * Progress bar pinned at the top of the volume's SurfaceGui,
--     filling from 0 → 1 over Duration. When it reaches 1.0 the damage
--     applies and the telegraph despawns (or earlier if Hide is fired).
--
-- Shape primitives (matches the Kind enum on the server):
--   * Circle — a flat thin Part disc-shaped via UICorner on the
--               SurfaceGui (full-circle corner radius). Sized by Radius.
--   * Rect   — flat Part with X = width, Z = length. The Origin
--               CFrame's LookVector aligns the Z axis with the
--               attacker's facing.
--   * Cone   — same primitive as Rect, sized by `Radius * 2`-wide ×
--               `Radius`-deep, with a triangular UI mask cut into the
--               SurfaceGui. Reasonable approximation; future polish
--               can switch to a custom mesh.
--
-- The Part lives under a single dedicated folder under workspace
-- (workspace.EnemyTelegraphFX) so it can be cleared en-masse on
-- session end / level transitions without scanning workspace.

local Players = game:GetService('Players')
local RunService = game:GetService('RunService')
local Debris = game:GetService('Debris')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local RemoteService = ReplicatedModules.Services.RemoteService
local EnemyTelegraph = ReplicatedModules.Services.EnemyTelegraph

local TelegraphEvent = RemoteService.GetRemote('EnemyTelegraphEvent', 'RemoteEvent', false)

local Module = {}

-- Active telegraphs by id → { part, fillFrame, startedAt, duration }.
-- Heartbeat ticks the fill width per active entry; on duration-elapsed
-- the entry self-cleans up (in addition to the explicit Hide path).
local Active: { [string]: any } = {}

local function getFolder(): Folder
	local existing = workspace:FindFirstChild('EnemyTelegraphFX')
	if existing and existing:IsA('Folder') then return existing end
	local f = Instance.new('Folder')
	f.Name = 'EnemyTelegraphFX'
	f.Parent = workspace
	return f
end

----------------------------------------------------------------------
-- Build helpers per shape.
----------------------------------------------------------------------
local function buildPlanePart(): Part
	local part = Instance.new('Part')
	-- Thin disc/box hugging the ground. Flat enough that the player's
	-- feet don't visibly intersect, opaque enough to read.
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CastShadow = false
	part.Transparency = 1  -- visual is on the SurfaceGui, not the part
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	return part
end

local function buildSurfaceGui(part: Part, color: Color3, isCircle: boolean): SurfaceGui
	local sg = Instance.new('SurfaceGui')
	sg.Face = Enum.NormalId.Top
	sg.AlwaysOnTop = true  -- read through foliage / decals
	sg.LightInfluence = 0
	sg.Brightness = 1.5
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 32
	sg.Parent = part

	-- Fill — translucent red.
	local fill = Instance.new('Frame')
	fill.Name = 'Fill'
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = color
	fill.BackgroundTransparency = 0.55
	fill.BorderSizePixel = 0
	fill.Parent = sg

	-- Outline — UIStroke for the edge.
	local stroke = Instance.new('UIStroke')
	stroke.Color = color
	stroke.Thickness = 4
	stroke.Transparency = 0
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = fill

	if isCircle then
		-- Round the fill into a disc. UICorner with a 50% radius on a
		-- square SurfaceGui draws a circle. (We make the part's X = Z
		-- = diameter to keep the fill square.)
		local corner = Instance.new('UICorner')
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = fill
	end

	return sg
end

local function buildProgressBar(parent: SurfaceGui, color: Color3): Frame
	-- World-space progress bar. Same SurfaceGui plane as the fill so
	-- it reads as part of the danger-zone decal rather than screen UI.
	--
	-- Track placement: y position 1 + negative-Y Size — the
	-- "anchor-top, push-to-bottom, grow-upward" trick. The track
	-- sits at the BOTTOM edge of the SurfaceGui (relative to local
	-- coords) and extends 10% of the surface height UPWARD from
	-- there. From above the part this reads as the bar being on
	-- the OPPOSITE edge from the previous top-edge placement; flips
	-- the bar's apparent direction from bottom-to-top to top-to-bottom.
	local barTrack = Instance.new('Frame')
	barTrack.Name = 'BarTrack'
	barTrack.AnchorPoint = Vector2.new(0.5, 0)
	barTrack.Position = UDim2.fromScale(0.5, 1)
	barTrack.Size = UDim2.new(0.85, 0, -0.10, 0)
	barTrack.BackgroundColor3 = Color3.new(0, 0, 0)
	barTrack.BackgroundTransparency = 0.4
	barTrack.BorderSizePixel = 0
	barTrack.ZIndex = 2
	barTrack.Parent = parent

	local trackStroke = Instance.new('UIStroke')
	trackStroke.Color = color
	trackStroke.Thickness = 2
	trackStroke.Transparency = 0.2
	trackStroke.Parent = barTrack

	local fill = Instance.new('Frame')
	fill.Name = 'BarFill'
	fill.Size = UDim2.fromScale(-0, 1)  -- starts at 0; ticked by Heartbeat
	fill.Position = UDim2.fromScale(1, 0)
	fill.BackgroundColor3 = color
	fill.BackgroundTransparency = 0
	fill.BorderSizePixel = 0
	fill.ZIndex = 3
	fill.Parent = barTrack

	return fill
end

----------------------------------------------------------------------
-- Show.
----------------------------------------------------------------------
local function show(payload)
	if typeof(payload) ~= 'table' or typeof(payload.Id) ~= 'string' then return end
	-- Replace any prior telegraph with the same id (rare; defensive).
	if Active[payload.Id] then
		Active[payload.Id].part:Destroy()
		Active[payload.Id] = nil
	end

	local kind = payload.Kind or EnemyTelegraph.Kinds.Circle
	local color = payload.Color or EnemyTelegraph.Defaults.Color
	local barColor = EnemyTelegraph.Defaults.BarColor
	local origin = payload.Origin
	if typeof(origin) ~= 'CFrame' then return end
	local duration = math.max(0.05, tonumber(payload.Duration) or 0.5)

	local part = buildPlanePart()
	part.Color = color

	-- Shape sizing.
	local thickness = 0.2  -- thin disc / pad
	if kind == EnemyTelegraph.Kinds.Circle then
		local radius = math.max(0.5, tonumber(payload.Radius) or 4)
		part.Size = Vector3.new(radius * 2, thickness, radius * 2)
	elseif kind == EnemyTelegraph.Kinds.Rect then
		local size = payload.Size or Vector3.new(4, thickness, 8)
		part.Size = Vector3.new(math.max(0.5, size.X), thickness, math.max(0.5, size.Z))
	elseif kind == EnemyTelegraph.Kinds.Cone then
		-- Approximated as a Rect (radius wide × radius deep with the
		-- attacker at one end). Polishing pass can swap in a fan mesh.
		local radius = math.max(0.5, tonumber(payload.Radius) or 6)
		part.Size = Vector3.new(radius * 1.6, thickness, radius)
	else
		-- Unknown kind; skip silently.
		part:Destroy()
		return
	end

	-- Flatten the origin's facing onto the horizontal plane. The server
	-- typically passes the attacker's `model:GetPivot()` directly —
	-- which can carry pitch/roll on uneven terrain or for ragdolled
	-- models. EnemyTelegraph.HorizontalForward projects + normalizes
	-- with a deterministic fallback for vertical-only pivots.
	local horizLook = EnemyTelegraph.HorizontalForward(origin)
	-- Position: origin's X / Z; Y dropped to foot-level so the disc
	-- sits just above terrain rather than at the model's pivot height
	-- (which is usually mid-torso for humanoid mobs).
	local groundY = origin.Position.Y - 2.5
	local alignedCF = CFrame.new(origin.Position.X, groundY, origin.Position.Z)
		* CFrame.Angles(0, math.atan2(horizLook.X, horizLook.Z), 0)

	-- For Rect/Cone, push the part center forward along the horizontal
	-- LookVector by HALF the part's depth — so the attacker's pivot
	-- sits at the NEAR edge and the visible zone extends forward by
	-- the full depth. (Original geometry: pushing by 0.5*Size centers
	-- the front edge on the pivot, so a Rect of Size.Z=24 with a
	-- pivot at the boar's HRP shows a 24-stud-deep zone *in front*
	-- of the boar.) The server's effectiveOrigin matches this offset
	-- 1:1 so visible == hit.
	if kind == EnemyTelegraph.Kinds.Rect or kind == EnemyTelegraph.Kinds.Cone then
		alignedCF = EnemyTelegraph.ForwardOffset(alignedCF, part.Size.Z * -0.5)
	end
	part.CFrame = alignedCF

	local isCircle = (kind == EnemyTelegraph.Kinds.Circle)
	local sg = buildSurfaceGui(part, color, isCircle)
	local barFill = buildProgressBar(sg, barColor)

	part.Parent = getFolder()

	Active[payload.Id] = {
		part = part,
		barFill = barFill,
		startedAt = os.clock(),
		duration = duration,
	}

	-- Failsafe: if the server forgot to Hide and our Heartbeat falls
	-- behind, Debris cleans up at duration + 0.5s padding.
	Debris:AddItem(part, duration + 0.5)
end

----------------------------------------------------------------------
-- Hide.
----------------------------------------------------------------------
local function hide(payload)
	if typeof(payload) ~= 'table' or typeof(payload.Id) ~= 'string' then return end
	local entry = Active[payload.Id]
	if not entry then return end
	if entry.part then entry.part:Destroy() end
	Active[payload.Id] = nil
end

----------------------------------------------------------------------
-- Heartbeat: tick the bar fill across active telegraphs. Cheap O(N)
-- where N is the active telegraph count (typically 1-3 — number of
-- nearby AI mid-windup).
----------------------------------------------------------------------
local function tickBars()
	local now = os.clock()
	for id, entry in Active do
		if not entry.part or not entry.part.Parent then
			Active[id] = nil
			continue
		end
		local elapsed = now - entry.startedAt
		local frac = math.clamp(elapsed / entry.duration, 0, 1)
		entry.barFill.Size = UDim2.fromScale(-frac, 1)
		if frac >= 1 then
			-- Telegraph completed naturally; clean up. Server may also
			-- send Hide on the same frame — Hide's defensive lookup
			-- handles the already-removed case.
			entry.part:Destroy()
			Active[id] = nil
		end
	end
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	TelegraphEvent.OnClientEvent:Connect(function(action, payload)
		if action == EnemyTelegraph.Actions.Show then
			show(payload)
		elseif action == EnemyTelegraph.Actions.Hide then
			hide(payload)
		end
	end)
	RunService.Heartbeat:Connect(tickBars)
end

function Module.Init() end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Effects/SkillVfxClient"><![CDATA[-- SkillVfxClient — receives visual-only cue dispatches from
-- SkillRuntimeServer's `vfx` step kind and renders them locally.
--
-- "Visual only" means: NO damage, NO status, NO logic. Just
-- particles, lighting flashes, screen shake, audio one-shots — all
-- the polish that makes a cleave actually feel like a cleave.
--
-- This module is a small registry mapping `Cue` ids to render
-- functions. Cues are looked up by id; unknown cues warn and skip.
-- Adding a new cue is one entry in CueDispatch — typical body is a
-- ParticleEmitter:Emit() against a temp Attachment, or a tween on
-- workspace lighting.
--
-- Pair with the server side: SkillRuntimeServer fires
-- `SkillVfxEvent:FireAllClients({ Cue, OriginCFrame, Duration?, Args? })`
-- whenever a recipe hits a `vfx` step.

local Debris = game:GetService('Debris')
local TweenService = game:GetService('TweenService')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local RemoteService = ReplicatedModules.Services.RemoteService
local SkillVfxEvent = RemoteService.GetRemote('SkillVfxEvent', 'RemoteEvent', false)

local Module = {}

----------------------------------------------------------------------
-- Cue registry. Each entry is `function(args)` where args carries
-- whatever the server sent (OriginCFrame is the most common). Keep
-- entries lightweight — heavy effects (full particle systems) should
-- live as templates in ReplicatedStorage and be cloned here, not
-- constructed inline per-cue.
----------------------------------------------------------------------
local CueDispatch: { [string]: (any) -> () } = {}

----------------------------------------------------------------------
-- Built-in stub cue: a brief PointLight pulse at the origin. Useful
-- as a "the system is wired" smoke test until art-side cues land.
----------------------------------------------------------------------
CueDispatch.cleave_charge_glow = function(args)
	local origin = args.OriginCFrame
	if typeof(origin) ~= 'CFrame' then return end
	local part = Instance.new('Part')
	part.Anchored = true; part.CanCollide = false; part.CanTouch = false
	part.CanQuery = false; part.CastShadow = false; part.Massless = true
	part.Size = Vector3.new(1, 1, 1)
	part.Transparency = 1
	part.CFrame = origin
	part.Parent = workspace

	local light = Instance.new('PointLight')
	light.Brightness = 4
	light.Range = 18
	light.Color = Color3.fromRGB(232, 60, 78)
	light.Parent = part

	local duration = math.max(0.15, tonumber(args.Duration) or 0.3)
	TweenService:Create(light, TweenInfo.new(duration), { Brightness = 0 }):Play()
	Debris:AddItem(part, duration + 0.1)
end

----------------------------------------------------------------------
-- Helpers — built inline rather than templated so this file stays
-- self-contained for a small number of cues. If/when the cue list
-- grows past ~6 entries, factor these into a templates folder under
-- ReplicatedStorage/Effects/.
----------------------------------------------------------------------
local function makeAnchorPart(originCF: CFrame): Part
	local part = Instance.new('Part')
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Massless = true
	part.Size = Vector3.new(1, 1, 1)
	part.Transparency = 1
	-- Drop the anchor onto the ground plane (the origin's CFrame is
	-- the caster's pivot — usually mid-torso). Subtracting 2.5 studs
	-- on Y matches the EnemyTelegraphClient's groundY offset so the
	-- particles puff at the same height as the red telegraph plane.
	part.CFrame = originCF - Vector3.new(0, 2.5, 0)
	part.Parent = workspace
	return part
end

local function makeDustEmitter(parent: Instance, intensity: number): ParticleEmitter
	-- Tan/brown puff. `smoke_main` is a built-in studio asset — no
	-- upload needed. The numbers are tuned for "ground impact dust":
	-- low lifetime, fast initial speed, downward gravity so the
	-- cloud spreads outward and settles, transparency ramp so the
	-- edge of the cloud feathers out instead of cutting hard.
	local emitter = Instance.new('ParticleEmitter')
	emitter.Texture = 'rbxasset://textures/particles/smoke_main.dds'
	emitter.Color = ColorSequence.new(Color3.fromRGB(160, 120, 86))
	emitter.LightEmission = 0
	emitter.LightInfluence = 1
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0,    1.5 * intensity),
		NumberSequenceKeypoint.new(0.4,  3.5 * intensity),
		NumberSequenceKeypoint.new(1,    5.0 * intensity),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0,   0.25),
		NumberSequenceKeypoint.new(0.4, 0.45),
		NumberSequenceKeypoint.new(1,   1.00),
	})
	emitter.Lifetime = NumberRange.new(0.55, 1.10)
	emitter.Rate = 0  -- burst-only, never streams
	emitter.Speed = NumberRange.new(8 * intensity, 16 * intensity)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Acceleration = Vector3.new(0, -10, 0)
	emitter.VelocityInheritance = 0
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-90, 90)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Drag = 4
	emitter.Parent = parent
	return emitter
end

----------------------------------------------------------------------
-- stampede_smash — the impact burst on the BossBoar's Stampede skill.
-- Two-layer effect:
--   * Outer dust ring: thick brown puff radiating outward from the
--     impact point (the "kick of dirt" beat).
--   * Inner light flash: brief amber flash that reads as ground
--     impact even at distance / through foliage.
-- Designed to read at the same instant the Stampede telegraph fills,
-- so the skill plays as one beat ("BAM + dust") rather than two.
----------------------------------------------------------------------
CueDispatch.stampede_smash = function(args)
	local origin = args.OriginCFrame
	if typeof(origin) ~= 'CFrame' then return end
	local part = makeAnchorPart(origin)

	-- Outer dust burst. Heavy intensity matched to the ~16-stud AOE
	-- of the Stampede recipe so the dust visually fills the danger zone.
	local outer = makeDustEmitter(part, 1.2)
	outer:Emit(28)

	-- Inner punch — same emitter tuned tighter, fewer particles, faster
	-- lifetime. Reads as the "core" of the impact while the outer puff
	-- billows around it.
	local inner = makeDustEmitter(part, 0.45)
	inner.Lifetime = NumberRange.new(0.20, 0.40)
	inner.Speed = NumberRange.new(2, 5)
	inner:Emit(18)

	-- Amber ground flash for "felt" impact at distance.
	local light = Instance.new('PointLight')
	light.Brightness = 6
	light.Range = 22
	light.Color = Color3.fromRGB(255, 200, 120)
	light.Parent = part
	TweenService:Create(light, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Brightness = 0 }):Play()

	-- Cleanup — emitters keep rendering existing particles after the
	-- anchor part is gone (they're queued in the renderer), so we can
	-- destroy the part as soon as both emitters are done emitting +
	-- max lifetime has elapsed. 1.5 s covers the longest outer-puff
	-- lifetime with margin.
	Debris:AddItem(part, 1.5)
end

----------------------------------------------------------------------
-- stampede_smash_tell — pre-stampede windup. Tiny dust puff at the
-- boar's feet to read as "pawing the ground." Identical emitter to
-- the smash, but fewer particles and shorter lifetime so it doesn't
-- compete visually with the main impact half a beat later.
----------------------------------------------------------------------
CueDispatch.stampede_smash_tell = function(args)
	local origin = args.OriginCFrame
	if typeof(origin) ~= 'CFrame' then return end
	local part = makeAnchorPart(origin)
	local emitter = makeDustEmitter(part, 0.35)
	emitter.Lifetime = NumberRange.new(0.30, 0.60)
	emitter.Speed = NumberRange.new(3, 6)
	emitter:Emit(8)
	Debris:AddItem(part, 0.9)
end

----------------------------------------------------------------------
-- Public registration API — game-specific cues register from their
-- own modules so this file stays a dispatcher, not a content dump.
----------------------------------------------------------------------
function Module.RegisterCue(cueId: string, fn: (any) -> ())
	CueDispatch[cueId] = fn
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	SkillVfxEvent.OnClientEvent:Connect(function(payload)
		if typeof(payload) ~= 'table' or typeof(payload.Cue) ~= 'string' then return end
		local fn = CueDispatch[payload.Cue]
		if not fn then
			-- Quiet dev-time warn; production should silently skip
			-- unknown cues so a missing client patch doesn't error-spam.
			warn(string.format('[SkillVfxClient] unknown cue %q', payload.Cue))
			return
		end
		local ok, err = pcall(fn, payload)
		if not ok then warn('[SkillVfxClient] cue error:', err) end
	end)
end

function Module.Init() end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Effects/LeaderboardSurfaceClient"><![CDATA[-- LeaderboardSurfaceClient — in-world leaderboard SurfaceGuis.
--
-- Discovery:
--   * Primary: every direct child of `workspace.Leaderboards` (the
--     folder pattern the level layout uses today). Each child's
--     *Name* selects the category via LeaderboardConfig.PartName.
--   * Secondary: every instance with the CollectionService tag
--     'Leaderboards' (matches the reference design; lets a level
--     designer drop a board outside the folder if needed).
--   Both paths feed the same `onTaggedAdded` binder; the _bindings
--   map de-dupes a single instance discovered via both routes.
--
-- Per board:
--   1. Resolve the adornee BasePart (Model → PrimaryPart → first
--      descendant BasePart).
--   2. Destroy any LineHandleAdornments under the part — Studio-only
--      level-design visualizers.
--   3. Build a SurfaceGui with header + scrollable row list +
--      "Updated Xs ago" footer. MaxEntries rows pre-allocated; the
--      refresh just toggles `Visible` and reassigns text on each
--      replicated diff.
--
-- Data source: the public 'Leaderboard' ReplicatedData category
-- (single SetData on the server's Start; mutated in place per cycle).
-- We subscribe to ReplicatedData.OnUpdated and re-render on each
-- publish — independent of PlayerData replication ticks.
--
-- Streaming-aware: bindings are keyed by the *tagged/folder-child*
-- instance (not the resolved BasePart) so a Model streaming in/out
-- fires Add/Remove with the same reference and the binding balances
-- cleanly.

local CollectionService = game:GetService('CollectionService')
local Players = game:GetService('Players')
local Workspace = game:GetService('Workspace')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local ReplicatedData    = ReplicatedModules.Services.ReplicatedData
local LeaderboardConfig = ReplicatedModules.Data.LeaderboardConfig

local LocalPlayer = Players.LocalPlayer
local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon

local TAG               = 'Leaderboards'
local FOLDER_NAME       = 'Leaderboards'
local DEFAULT_FACE      = Enum.NormalId.Front
local SURFACE_GUI_NAME  = 'LeaderboardSurface'
local UPDATED_TICK_SEC  = 30  -- "Updated Xs ago" footer refresh cadence

local Module = {}

----------------------------------------------------------------------
-- Format helpers — value display per category Format. Keep in lockstep
-- with LeaderboardConfig.Categories[*].Format. Pure presentation; the
-- replica payload is always raw integers.
----------------------------------------------------------------------
local function commaFormat(n: number): string
	-- Roblox Lua has no built-in comma-grouping. Reverse → group every
	-- three → reverse back.
	local s = tostring(math.floor(math.abs(n)))
	local rev = s:reverse()
	local grouped = rev:gsub('(%d%d%d)', '%1,')
	local out = grouped:reverse()
	if out:sub(1, 1) == ',' then out = out:sub(2) end
	if n < 0 then out = '-' .. out end
	return out
end

local function formatDuration(secs: number): string
	local total = math.floor(secs)
	local hours = math.floor(total / 3600)
	local minutes = math.floor((total % 3600) / 60)
	return string.format('%d:%02d', hours, minutes)
end

local function formatValue(value: number, format: string?): string
	if format == 'duration' then return formatDuration(value) end
	if format == 'gold'     then return commaFormat(value) .. ' G' end
	return commaFormat(value)
end

----------------------------------------------------------------------
-- Per-binding bookkeeping. Keyed by the tagged Instance so a Model
-- removal cleans up the SurfaceGui (previously a model-keyed entry
-- could leak when only the part was tracked).
----------------------------------------------------------------------
type EntryRow = { userId: number, value: number, name: string? }
-- Per-binding paint refs. Stash every instance whose color we want to
-- live-update on theme change so `repaintBinding` is a flat property
-- write per ref (no tree walk). Atom strokes are tracked by category
-- accent (header / divider / scrollbar / row strokes share the same
-- value) so a single PALETTE.accent reassignment covers the lot.
type Binding = {
	Tagged           : Instance,
	Part             : BasePart,
	Category         : any,
	Gui              : SurfaceGui,
	Rows             : { Frame },
	HeaderLabel      : TextLabel,
	UpdatedLabel     : TextLabel,
	BackgroundFrame  : Frame,
	Divider          : Frame,
	ListFrame        : ScrollingFrame,
	OuterStroke      : UIStroke,
	CornerTicks      : { Frame },
}

local _bindings: { [Instance]: Binding } = {}
local _replicaConn: RBXScriptConnection? = nil

----------------------------------------------------------------------
-- Adornee resolution. Tag may sit on a BasePart OR a Model; for the
-- model case we prefer PrimaryPart, fall back to the first descendant
-- BasePart so designers don't have to wire PrimaryPart.
----------------------------------------------------------------------
local function resolveAdorneePart(inst: Instance): BasePart?
	if inst:IsA('BasePart') then return inst :: BasePart end
	if inst:IsA('Model') then
		local pp = (inst :: Model).PrimaryPart
		if pp then return pp end
		for _, child in inst:GetDescendants() do
			if child:IsA('BasePart') then return child :: BasePart end
		end
	end
	return nil
end

local function resolveFace(part: BasePart): Enum.NormalId
	-- Designers can override per-part with a 'LeaderboardFace' string
	-- attribute (e.g. "Top", "Back"); otherwise default to Front.
	local override = part:GetAttribute('LeaderboardFace')
	if typeof(override) == 'string' then
		local ok, enumItem = pcall(function()
			return (Enum.NormalId :: any)[override]
		end)
		if ok and typeof(enumItem) == 'EnumItem' then
			return enumItem :: Enum.NormalId
		end
	end
	return DEFAULT_FACE
end

local function clearLineHandleAdornments(part: BasePart)
	-- Descendants, not just children: level design sometimes nests a
	-- Folder/Attachment under the part to organize visualizers.
	for _, desc in part:GetDescendants() do
		if desc:IsA('LineHandleAdornment') then desc:Destroy() end
	end
end

----------------------------------------------------------------------
-- Corner-tick atom. Mirrors HUDCommon.cornerTick — the L-shaped
-- accent slash in the corners of every chiseledPanel — so the
-- SurfaceGui visually inherits the widget chrome. We can't call
-- HUDCommon.cornerTick directly because that builds Fusion-scoped
-- nodes; SurfaceGui plates use plain Instance.new for the build
-- side but feed colors from the live palette so theme swaps land.
----------------------------------------------------------------------
local function buildCornerTick(corner: string): Frame
	local size = UDim2.fromOffset(14, 14)
	local pos
	local anchor = Vector2.new(0, 0)
	if corner == 'tl' then
		pos = UDim2.new(0, 4, 0, 4)
	elseif corner == 'tr' then
		pos = UDim2.new(1, -4, 0, 4); anchor = Vector2.new(1, 0)
	elseif corner == 'bl' then
		pos = UDim2.new(0, 4, 1, -4); anchor = Vector2.new(0, 1)
	else  -- 'br'
		pos = UDim2.new(1, -4, 1, -4); anchor = Vector2.new(1, 1)
	end
	local tick = Instance.new('Frame')
	tick.Name = 'CornerTick_' .. corner
	tick.AnchorPoint = anchor
	tick.Position = pos
	tick.Size = size
	tick.BackgroundTransparency = 1
	tick.BorderSizePixel = 0

	-- L-shape via two thin Frames (horizontal + vertical bars). Color
	-- assigned at build time from the live palette; repainted on theme
	-- change.
	local h = Instance.new('Frame')
	h.Name = 'H'
	h.Size = UDim2.new(1, 0, 0, 2)
	h.BackgroundColor3 = HUDCommon.PALETTE.accent
	h.BorderSizePixel = 0
	h.Parent = tick
	local v = Instance.new('Frame')
	v.Name = 'V'
	v.Size = UDim2.new(0, 2, 1, 0)
	v.BackgroundColor3 = HUDCommon.PALETTE.accent
	v.BorderSizePixel = 0
	v.Parent = tick

	return tick
end

----------------------------------------------------------------------
-- Row template. Pre-allocated (`buildSurfaceGui` builds MaxEntries of
-- these and toggles `Visible` on refresh) so the per-cycle diff
-- doesn't churn instances.
--
-- Colors pulled from HUDCommon.PALETTE; row chrome reuses widget
-- tokens so a theme switch on the tab menu propagates to the in-world
-- board on the same `OnPaletteChanged` tick (see Module.Start).
----------------------------------------------------------------------
local function buildRow(index: number): Frame
	local row = Instance.new('Frame')
	row.Name = 'Row_' .. tostring(index)
	row.BackgroundColor3 = HUDCommon.PALETTE.bg1
	-- Alternate-row tinting reads at a glance even on a small SurfaceGui.
	row.BackgroundTransparency = (index % 2 == 0) and 0.55 or 0.78
	row.BorderSizePixel = 0
	row.Size = UDim2.new(1, 0, 0, 36)
	row.LayoutOrder = index
	row.Visible = false

	-- Subtle accent stroke on every row — same line weight the
	-- chiseledPanel atoms use so the rows feel like sub-panels.
	local stroke = Instance.new('UIStroke')
	stroke.Color = HUDCommon.PALETTE.accent
	stroke.Transparency = 0.85
	stroke.Thickness = 1
	stroke.Parent = row

	local rank = Instance.new('TextLabel')
	rank.Name = 'Rank'
	rank.BackgroundTransparency = 1
	rank.Size = UDim2.fromScale(0.12, 1)
	rank.Position = UDim2.fromScale(0, 0)
	rank.FontFace = HUDCommon.FONT_MONO
	rank.TextColor3 = HUDCommon.PALETTE.gold
	rank.TextScaled = true
	rank.TextXAlignment = Enum.TextXAlignment.Center
	rank.Text = string.format('%02d', index)
	rank.Parent = row

	local nameLabel = Instance.new('TextLabel')
	nameLabel.Name = 'PlayerName'
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.fromScale(0.58, 1)
	nameLabel.Position = UDim2.fromScale(0.13, 0)
	nameLabel.FontFace = HUDCommon.FONT_UI
	nameLabel.TextColor3 = HUDCommon.PALETTE.ink
	nameLabel.TextScaled = true
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.Text = ''
	nameLabel.Parent = row

	local valueLabel = Instance.new('TextLabel')
	valueLabel.Name = 'Value'
	valueLabel.BackgroundTransparency = 1
	valueLabel.Size = UDim2.fromScale(0.28, 1)
	valueLabel.Position = UDim2.fromScale(0.72, 0)
	valueLabel.FontFace = HUDCommon.FONT_MONO
	valueLabel.TextColor3 = HUDCommon.PALETTE.accent
	valueLabel.TextScaled = true
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right
	valueLabel.Text = ''
	valueLabel.Parent = row

	local pad = Instance.new('UIPadding')
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.Parent = row

	return row
end

----------------------------------------------------------------------
-- SurfaceGui builder. One Frame per binding; the `Rows` array is
-- recycled across refreshes (just toggle Visible + reassign Text).
----------------------------------------------------------------------
local function buildSurfaceGui(tagged: Instance, part: BasePart, category: any): Binding
	local gui = Instance.new('SurfaceGui')
	gui.Name = SURFACE_GUI_NAME
	gui.Face = resolveFace(part)
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 50
	gui.LightInfluence = 0
	gui.Brightness = 1.5
	gui.AlwaysOnTop = false
	gui.ClipsDescendants = true
	gui.Adornee = part
	gui.ResetOnSpawn = false

	-- Chiseled-panel chrome via background + outer stroke + corner
	-- ticks. Mirrors HUDCommon.chiseledPanel's visual: a panel-tinted
	-- backdrop, an accent UIStroke, and four L-tick atoms in the
	-- corners. Lets the in-world board feel cohesive with the tab
	-- widgets even though it's a SurfaceGui (can't share the Fusion
	-- builder directly).
	local bg = Instance.new('Frame')
	bg.Name = 'Background'
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = HUDCommon.PALETTE.panel
	bg.BackgroundTransparency = 0.12
	bg.BorderSizePixel = 0
	bg.Parent = gui

	local outerStroke = Instance.new('UIStroke')
	outerStroke.Color = HUDCommon.PALETTE.accent
	outerStroke.Transparency = 0.55
	outerStroke.Thickness = 2
	outerStroke.Parent = bg

	-- Corner ticks pinned to the panel edges. TL+BR matches the
	-- chiseledPanel default; we add TR+BL too because the surface
	-- board reads as a more formal monument than the in-tab panels.
	local cornerTicks: { Frame } = {}
	for _, corner in { 'tl', 'tr', 'bl', 'br' } do
		local tick = buildCornerTick(corner)
		tick.Parent = bg
		table.insert(cornerTicks, tick)
	end

	local header = Instance.new('TextLabel')
	header.Name = 'Header'
	header.BackgroundTransparency = 1
	header.Size = UDim2.fromScale(1, 0.12)
	header.Position = UDim2.fromScale(0, 0)
	header.FontFace = HUDCommon.FONT_DISPLAY
	header.TextColor3 = HUDCommon.PALETTE.gold
	header.TextScaled = true
	header.Text = string.upper(category.Label)
	header.Parent = bg

	-- Inner UIPadding shrinks the TextScaled glyph height (10% total —
	-- 5% top + 5% bottom) so the header doesn't dominate the panel.
	-- Same technique used on the LevelLockOverlay title; TextScaled
	-- fills the rect, padding the rect down is the standard scale-down.
	local headerPad = Instance.new('UIPadding')
	headerPad.PaddingTop    = UDim.new(0.05, 0)
	headerPad.PaddingBottom = UDim.new(0.05, 0)
	headerPad.Parent = header

	local divider = Instance.new('Frame')
	divider.Name = 'Divider'
	divider.Size = UDim2.new(0.92, 0, 0, 2)
	divider.Position = UDim2.fromScale(0.04, 0.13)
	divider.BackgroundColor3 = HUDCommon.PALETTE.accent
	divider.BackgroundTransparency = 0.35
	divider.BorderSizePixel = 0
	divider.Parent = bg

	local list = Instance.new('ScrollingFrame')
	list.Name = 'List'
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.Size = UDim2.fromScale(1, 0.82)
	list.Position = UDim2.fromScale(0, 0.14)
	list.CanvasSize = UDim2.fromScale(0, 0)
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.ScrollBarThickness = 4
	list.ScrollBarImageColor3 = HUDCommon.PALETTE.accent
	list.ScrollBarImageTransparency = 0.4
	list.ElasticBehavior = Enum.ElasticBehavior.Never
	list.Parent = bg

	local listPad = Instance.new('UIPadding')
	listPad.PaddingLeft = UDim.new(0, 8)
	listPad.PaddingRight = UDim.new(0, 8)
	listPad.Parent = list

	local layout = Instance.new('UIListLayout')
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 2)
	layout.Parent = list

	local rows: { Frame } = {}
	for i = 1, LeaderboardConfig.MaxEntries do
		local row = buildRow(i)
		row.Parent = list
		table.insert(rows, row)
	end

	local updated = Instance.new('TextLabel')
	updated.Name = 'Updated'
	updated.BackgroundTransparency = 1
	updated.Size = UDim2.fromScale(1, 0.04)
	updated.Position = UDim2.fromScale(0, 0.96)
	updated.FontFace = HUDCommon.FONT_MONO
	updated.TextColor3 = HUDCommon.PALETTE.inkFaint
	updated.TextScaled = true
	updated.Text = ''
	updated.Parent = bg

	gui.Parent = part

	return {
		Tagged          = tagged,
		Part            = part,
		Category        = category,
		Gui             = gui,
		Rows            = rows,
		HeaderLabel     = header,
		UpdatedLabel    = updated,
		BackgroundFrame = bg,
		Divider         = divider,
		ListFrame       = list,
		OuterStroke     = outerStroke,
		CornerTicks     = cornerTicks,
	}
end

----------------------------------------------------------------------
-- Refresh. Reads the current snapshot from ReplicatedData; each row
-- is either populated (Visible=true with name+value) or hidden. The
-- LocalPlayer's row gets a subtle gold tint so they can pick
-- themselves out at a glance.
----------------------------------------------------------------------
local function applyEntries(binding: Binding, entries: { EntryRow })
	local format = binding.Category.Format
	local localUserId = Players.LocalPlayer and Players.LocalPlayer.UserId
	for i, row in binding.Rows do
		local entry = entries[i]
		if entry then
			local nameChild = row:FindFirstChild('PlayerName') :: TextLabel?
			local valueChild = row:FindFirstChild('Value') :: TextLabel?
			local isYou = entry.userId == localUserId
			if nameChild then
				nameChild.Text = entry.name or ('User ' .. tostring(entry.userId))
				-- Highlight the local player's row in gold; everyone
				-- else stays at the default `ink`. Repainted on theme
				-- change via repaintBinding.
				nameChild.TextColor3 = isYou and HUDCommon.PALETTE.gold or HUDCommon.PALETTE.ink
			end
			if valueChild then
				valueChild.Text = formatValue(entry.value, format)
				-- Value column accents to gold on the local row so
				-- the entire row visually pops together.
				valueChild.TextColor3 = isYou and HUDCommon.PALETTE.gold or HUDCommon.PALETTE.accent
			end
			row.Visible = true
		else
			row.Visible = false
		end
	end
end

----------------------------------------------------------------------
-- Re-tint a binding from the live palette. Called on every
-- HUDCommon.OnPaletteChanged signal — the SurfaceGui isn't part of
-- the master HUD ScreenGui so HUDCommon.ApplyTheme's walk-and-tween
-- pass doesn't reach it; we have to repaint manually.
--
-- Cheap: ~20 property writes per binding, the bindings count is tiny
-- (one per board in the world). Skips disabled / streamed-out parts
-- via the Gui.Parent guard.
----------------------------------------------------------------------
-- Forward-declare refresh helpers so repaintAll can call refreshAll
-- — the actual definitions live below, beneath repaintBinding.
local refreshBinding: (Binding) -> ()
local refreshAll: () -> ()

local function repaintBinding(binding: Binding)
	local PAL = HUDCommon.PALETTE
	if not binding.Gui or not binding.Gui.Parent then return end
	binding.BackgroundFrame.BackgroundColor3 = PAL.panel
	binding.OuterStroke.Color    = PAL.accent
	binding.HeaderLabel.TextColor3 = PAL.gold
	binding.Divider.BackgroundColor3 = PAL.accent
	binding.ListFrame.ScrollBarImageColor3 = PAL.accent
	binding.UpdatedLabel.TextColor3 = PAL.inkFaint
	for _, tick in binding.CornerTicks do
		local h = tick:FindFirstChild('H') :: Frame?
		local v = tick:FindFirstChild('V') :: Frame?
		if h then h.BackgroundColor3 = PAL.accent end
		if v then v.BackgroundColor3 = PAL.accent end
	end
	-- Rows: alternating bg + per-row stroke. Re-walking applyEntries'
	-- per-row text-color decisions (local-player gold, others ink)
	-- from here would require knowing the live entries — easier to
	-- defer to the next refresh which happens on every server publish
	-- + the periodic repainter. Just refresh the structural colors
	-- here.
	local localUserId = Players.LocalPlayer and Players.LocalPlayer.UserId
	for _, row in binding.Rows do
		row.BackgroundColor3 = PAL.bg1
		local stroke = row:FindFirstChildOfClass('UIStroke')
		if stroke then stroke.Color = PAL.accent end
		local rank = row:FindFirstChild('Rank') :: TextLabel?
		if rank then rank.TextColor3 = PAL.gold end
		-- Re-derive name/value text color from the row's current name
		-- (the userId isn't stored on the row, so we read it back via
		-- the in-replica Entries list at the next applyEntries call).
		-- Reset to neutral defaults here — the next refresh will tint
		-- the local player's row gold again.
		local name = row:FindFirstChild('PlayerName') :: TextLabel?
		if name then name.TextColor3 = PAL.ink end
		local value = row:FindFirstChild('Value') :: TextLabel?
		if value then value.TextColor3 = PAL.accent end
	end
end

local function repaintAll()
	for _, binding in _bindings do repaintBinding(binding) end
	-- After repaint, refresh entries so the local-player gold tint
	-- lands on the right row again. refreshAll re-reads the snapshot
	-- and re-runs applyEntries; cheap (no DataStore round trip).
	refreshAll()
end

local function applyUpdated(binding: Binding, updated: number?)
	if typeof(updated) ~= 'number' or updated <= 0 then
		binding.UpdatedLabel.Text = 'Awaiting first update...'
		return
	end
	local secondsAgo = math.max(0, os.time() - updated)
	if secondsAgo < 60 then
		binding.UpdatedLabel.Text = string.format('Updated %ds ago', secondsAgo)
	else
		binding.UpdatedLabel.Text = string.format('Updated %dm ago', math.floor(secondsAgo / 60))
	end
end

function refreshBinding(binding: Binding)
	local snap = ReplicatedData.GetData(LeaderboardConfig.PublicCategory, false)
	if typeof(snap) ~= 'table' then
		applyEntries(binding, {})
		applyUpdated(binding, nil)
		return
	end
	local categoryData = snap[binding.Category.Id]
	local entries = (typeof(categoryData) == 'table' and categoryData.Entries) or {}
	applyEntries(binding, entries)
	applyUpdated(binding, snap.Updated)
end

function refreshAll()
	for _, binding in _bindings do refreshBinding(binding) end
end

----------------------------------------------------------------------
-- Tag-add / tag-remove handlers. Streaming-driven adds and removes
-- fire with the same Instance reference, so the _bindings map
-- balances cleanly across stream cycles.
----------------------------------------------------------------------
local function onTaggedAdded(inst: Instance)
	if _bindings[inst] then return end

	local part = resolveAdorneePart(inst)
	if not part then
		warn(string.format(
			"[LeaderboardSurfaceClient] tagged %q (%s) has no usable BasePart — skipping",
			inst:GetFullName(), inst.ClassName))
		return
	end

	-- Match the tagged-instance Name first, fall back to the resolved
	-- BasePart's name. Designers can either name the Model (e.g.
	-- 'TotalDamageBoard' on a decoration model) or name the part
	-- itself.
	local category = LeaderboardConfig.GetCategoryByPartName(inst.Name)
	if not category and part ~= inst then
		category = LeaderboardConfig.GetCategoryByPartName(part.Name)
	end
	if not category then
		warn(string.format(
			"[LeaderboardSurfaceClient] tagged %q has no matching PartName in LeaderboardConfig.",
			inst.Name))
		return
	end

	clearLineHandleAdornments(part)

	-- A previous session of this controller (or a designer-placed
	-- placeholder) may have left a SurfaceGui under the part. Replace
	-- it cleanly.
	local existing = part:FindFirstChild(SURFACE_GUI_NAME)
	if existing then existing:Destroy() end

	local binding = buildSurfaceGui(inst, part, category)
	_bindings[inst] = binding
	refreshBinding(binding)
end

local function onTaggedRemoved(inst: Instance)
	local binding = _bindings[inst]
	if not binding then return end
	_bindings[inst] = nil
	-- Streaming may have already destroyed the part + its descendants
	-- (including our SurfaceGui). Guard with a Parent check so we
	-- don't double-Destroy a collected instance.
	if binding.Gui and binding.Gui.Parent then
		binding.Gui:Destroy()
	end
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	-- Discovery path 1: CollectionService tag 'Leaderboards'.
	for _, inst in CollectionService:GetTagged(TAG) do
		onTaggedAdded(inst)
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(onTaggedAdded)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(onTaggedRemoved)

	-- Discovery path 2: every direct child of workspace.Leaderboards.
	-- Matches the level layout currently in use (parts grouped under
	-- a folder rather than tagged). The same binder handles both
	-- paths; _bindings de-dupes if a single instance is discovered
	-- via both. Folder may not exist yet (place still loading) —
	-- watch ChildAdded on workspace too so a deferred Leaderboards
	-- folder still hooks up.
	local function bindFolder(folder: Instance)
		for _, child in folder:GetChildren() do
			onTaggedAdded(child)
		end
		folder.ChildAdded:Connect(onTaggedAdded)
		folder.ChildRemoved:Connect(onTaggedRemoved)
	end
	local existing = Workspace:FindFirstChild(FOLDER_NAME)
	if existing then
		bindFolder(existing)
	else
		Workspace.ChildAdded:Connect(function(child)
			if child.Name == FOLDER_NAME then bindFolder(child) end
		end)
	end

	-- Subscribe to the public 'Leaderboard' category. Each server
	-- publish (once per CycleSec) re-renders all visible boards.
	-- Decoupled from PlayerData ticks so per-player save replication
	-- doesn't trigger redundant rebuilds.
	_replicaConn = ReplicatedData.OnUpdated:Connect(function(category)
		if category == LeaderboardConfig.PublicCategory then
			refreshAll()
		end
	end)

	-- Live-theme: HUDCommon fires OnPaletteChanged AFTER its in-place
	-- palette mutation. The master ScreenGui's walk-and-tween repaint
	-- doesn't reach our SurfaceGui (it's parented under workspace
	-- BaseParts, not under HUDCommon's master GUI), so we explicitly
	-- repaint each binding from the new palette and re-run a full
	-- entry refresh (which restores the local-player gold tint).
	if HUDCommon.OnPaletteChanged and HUDCommon.OnPaletteChanged.Connect then
		HUDCommon.OnPaletteChanged:Connect(repaintAll)
	end

	-- Re-sticker the "Updated Xs ago" footer every 30s so the elapsed
	-- text stays honest between server pulls (UPDATED_TICK_SEC <
	-- CycleSec / 4 so the footer never lies by more than a quarter
	-- of a cycle).
	task.spawn(function()
		while true do
			task.wait(UPDATED_TICK_SEC)
			local snap = ReplicatedData.GetData(LeaderboardConfig.PublicCategory, false)
			local updated = (typeof(snap) == 'table' and snap.Updated) or nil
			for _, binding in _bindings do
				applyUpdated(binding, updated)
			end
		end
	end)
end

function Module.Init() end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Gameplay"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Gameplay/EquipmentRendererClient"><![CDATA[local Players = game:GetService('Players')
local CollectionService = game:GetService('CollectionService')
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local MaidClassModule = ReplicatedModules.Modules.Maid
local SignalClassModule = ReplicatedModules.Modules.Signal
local ItemConfigModule = ReplicatedModules.Data.Items
local AssetService = ReplicatedModules.Services.AssetService
local CharacterStatesService = ReplicatedModules.Services.CharacterStates
local CombatSharedModule = ReplicatedModules.Services.CombatShared
local TableUtility = ReplicatedModules.Utility.Table
local ModelsUtility = ReplicatedModules.Utility.Models
local CombatUtility = ReplicatedModules.Utility.CombatUtility

local RemoteService = ReplicatedModules.Services.RemoteService
local EquipmentRenderEvent = RemoteService.GetRemote('EquipmentRenderEvent', 'RemoteEvent', false)

local RemoteJobs = { BulkSet = 1, BulkRemove = 3, Cleanup = 4 }

local SystemsContainer = {}

local function GetTargetPlayerCharacter( characterName )
	return Players:FindFirstChild(characterName) and Players[characterName].Character
end

local function AccessorifyModel( Model )
	for _, BasePart in Model:GetChildren() do
		if BasePart:IsA("BasePart") then
			BasePart.Anchored = false
			BasePart.CanCollide = false
			BasePart.CanTouch = false
			BasePart.CanQuery = false
			BasePart.Massless = true
		end
	end
end

local function WeldToPrimaryPart(Model)
	local PrimaryPart = Model.PrimaryPart
	for _, object in Model:GetDescendants() do
		if object:IsA('BasePart') and object ~= PrimaryPart then
			local Weld = Instance.new('WeldConstraint')
			Weld.Part0 = object
			Weld.Part1 = PrimaryPart
			Weld.Parent = PrimaryPart
		end
	end
end

-- // Module // --
local Module = {}

Module.ActiveDataCache = {}
Module.ActiveInstanceCache = {}

Module.OnWeaponEquipped = SignalClassModule.New()
Module.OnWeaponUnequipped = SignalClassModule.New()

function Module.AdjustWeaponLocation(character : Model, model : Model, weaponID : string, handIndex : number)
	local itemConfig = ItemConfigModule.Items[ weaponID ]
	-- Post-migration the shell may not yet have this id (other players'
	-- equipped weapons aren't broadcast yet). Bail quietly — the
	-- weapon's parent Folder placeholder will be replaced when configs
	-- land, at which point a re-equip event will retrigger this path.
	if not itemConfig or not itemConfig.EquipmentData then return end
	local hasWeaponDrawn = CombatSharedModule.IsWeaponDrawn(character)

	local targetAttach = nil
	local offsetCFrame = nil

	-- Per-hand offsets keyed by `handIndex` (1 = left, 2 = right). The
	-- artist authors each side directly in `Items.luau`; the renderer
	-- doesn't try to mirror a single offset anymore. `[handIndex]`
	-- with a fallback to `[1]` keeps single-instance equipment (Head,
	-- Chest, …) working when only the primary entry is provided.
	local equipData = itemConfig.EquipmentData
	if hasWeaponDrawn then
		offsetCFrame = equipData.HandOffsets[handIndex] or equipData.HandOffsets[1]
		-- Different attach parts on each hand naturally mirror the
		-- weapon left↔right because R15's LeftHand and RightHand have
		-- opposite outward-pointing X axes. Use `GetSlotAttachName` to
		-- stay consistent with the Default-equipment branch instead of
		-- hardcoding the part name a second time.
		targetAttach = CombatUtility.GetSlotAttachName(ItemConfigModule.EquipmentSlotEnums.Hand, handIndex)
	else
		offsetCFrame = equipData.BackOffsets[handIndex] or equipData.BackOffsets[1]
		targetAttach = 'UpperTorso'
	end

	local attachInstance = character and character:FindFirstChild( targetAttach )
	if not attachInstance then
		print("Could not find the instance to attach weapon to: ", targetAttach)
		return
	end

	local oldWeld = model.PrimaryPart:FindFirstChildWhichIsA('WeldConstraint')
	if oldWeld then
		oldWeld:Destroy()
	end

	model:PivotTo(attachInstance.CFrame * offsetCFrame)
	ModelsUtility.WeldConstraint(model.PrimaryPart, attachInstance)
end

Module.EquipFunctions = {

	Default = function( character, itemID )
		local itemConfig = ItemConfigModule.GetConfigFromId(itemID)

		print(itemID, itemConfig)
		local equipData = itemConfig and itemConfig.EquipmentData
		if not equipData then
			print("Item is not equippable: ", itemID)
			return Instance.new('Folder')
		end

		local itemModel = AssetService.GetEquipmentByName( equipData.Model )
		if not itemModel then
			print("Could not find item model of id: ", itemID, equipData.Model )
			return Instance.new('Folder')
		end

		-- Resolve attach part from the item's primary EquipSlot enum
		-- (replaces the removed `EquipData.BodyPart` string).
		local primarySlotCfg = equipData.EquipSlots and equipData.EquipSlots[1]
		local attachName = primarySlotCfg and CombatUtility.GetSlotAttachName(primarySlotCfg.Slot, 2) or 'UpperTorso'
		local attachInstance = character and character:FindFirstChild( attachName )
		if not attachInstance then
			print("Could not find the instance to attach weapon to: ", attachName)
			return Instance.new('Folder')
		end

		itemModel = itemModel:Clone()
		AccessorifyModel( itemModel )
		itemModel:PivotTo(attachInstance.CFrame * equipData.StandardOffset)
		itemModel.Parent = character
		ModelsUtility.WeldConstraint(itemModel.PrimaryPart, attachInstance)
		WeldToPrimaryPart( itemModel )
		return itemModel
	end,

	Weapon = function( character, weaponID, handIndex ) : Instance
		local weaponConfig = ItemConfigModule.GetConfigFromId(weaponID)
		-- Post-migration: Items is replicated per-player. The LOCAL
		-- player's owned items are populated after BootstrapPlayer, but
		-- OTHER players' equipped weapons aren't in the local shell
		-- (no replication path pushes them yet). Rather than crash with
		-- "index nil with EquipmentData", render an empty folder; the
		-- weapon will pop in once the server-side broadcast for
		-- visible-equipped items lands. See ROADMAP.md for the
		-- broadcast-on-equip pattern (deferred follow-up).
		if not weaponConfig or not weaponConfig.EquipmentData then
			return Instance.new('Folder')
		end

		local weaponModel = ReplicatedAssets.Weapons:FindFirstChild( weaponConfig.EquipmentData.Model )
		if not weaponModel then
			print("Could not find weapon model of id: ", weaponID, weaponConfig.EquipmentData.Model )
			return Instance.new('Folder')
		end

		weaponModel = weaponModel:Clone()
		-- Tag every equipped weapon model so other systems (AurasClient
		-- 'sword' anchor; any future weapon-aware widget) can locate
		-- them via CollectionService without coupling to this module.
		-- Hand index attribute is set so consumers can distinguish L/R.
		CollectionService:AddTag(weaponModel, 'EquippedWeapon')
		weaponModel:SetAttribute('HandIndex', handIndex)
		AccessorifyModel( weaponModel )
		Module.AdjustWeaponLocation(character, weaponModel, weaponID, handIndex)
		WeldToPrimaryPart( weaponModel )
		weaponModel.Parent = character
		return weaponModel
	end,

}

function Module.CleanupCharacterVisuals(character : Model)
	if not Module.ActiveInstanceCache[character] then
		return
	end
	for _, object in Module.ActiveInstanceCache[character] do
		object:Destroy()
	end
	Module.ActiveInstanceCache[character] = nil
end

function Module.CleanupCharacterData(character : Model)
	if Module.ActiveDataCache[character] then
		Module.ActiveDataCache[character] = nil
	end
	Module.CleanupCharacterVisuals(character)
	Module.UpdateCharacterVisuals(character)
end

function Module.BulkSetCharacterVisuals(character : Model, slotData : { {slotId : string, data : {uuid : string, itemId : string}} })
	if not Module.ActiveDataCache[character] then
		Module.ActiveDataCache[character] = {}
	end
	for _, data in slotData do
		Module.ActiveDataCache[character][data.slotId] = data.data
	end
	Module.UpdateCharacterVisuals(character)
end

function Module.BulkRemoveCharacterVisuals(character : Model, slotIds : {string})
	if not Module.ActiveDataCache[character] then
		return
	end

	for _, slotId in slotIds do
		Module.ActiveDataCache[character][slotId] = nil
	end
	Module.UpdateCharacterVisuals(character)
end

function Module.UpdateCharacterVisuals(character : Model)
	if not Module.ActiveDataCache[character] then
		Module.CleanupCharacterVisuals(character)
		return
	end

	local DataContainer = character:FindFirstChild('RENDER_DATA')
	if not DataContainer then
		DataContainer = Instance.new('Folder')
		DataContainer.Name = 'RENDER_DATA'
		DataContainer.Parent = character
	end

	DataContainer:ClearAllChildren()
	TableUtility.TableToObject(Module.ActiveDataCache[character], DataContainer, {})

	if not Module.ActiveInstanceCache[character] then
		Module.ActiveInstanceCache[character] = {}
	end

	local ActiveUUIDs = {}

	for slotId, slotData in Module.ActiveDataCache[character] do
		-- equipping specifically a weapon
		if string.find(slotId, "Weapon") then
			table.insert(ActiveUUIDs, slotData.uuid)
			if Module.ActiveInstanceCache[character][slotData.uuid] then
				Module.ActiveInstanceCache[character][slotData.uuid]:Destroy()
			end
			Module.ActiveInstanceCache[character][slotData.uuid] = nil
			if character == LocalPlayer.Character then
				Module.OnWeaponEquipped:Fire(slotId, slotData.uuid, slotData.itemId)
			end
			local handIndex : number = string.find(slotId, "1_") and 1 or 2
			print(slotData.itemId, handIndex)
			Module.ActiveInstanceCache[character][slotData.uuid] = Module.EquipFunctions.Weapon(character, slotData.itemId, handIndex)
			continue
		end
		-- equipping anything else
		for uuid, itemData in slotData do
			table.insert(ActiveUUIDs, uuid)
			if Module.ActiveInstanceCache[character][uuid] then
				Module.ActiveInstanceCache[character][uuid]:Destroy()
			end
			Module.ActiveInstanceCache[character][uuid] = nil
			if character == LocalPlayer.Character then
				Module.OnWeaponEquipped:Fire(slotId, uuid, itemData.itemId)
			end
			Module.ActiveInstanceCache[character][uuid] = Module.EquipFunctions.Default(character, itemData.itemId)
		end
	end

	-- destroy any unequipped models
	for uuid, model in Module.ActiveInstanceCache[character] do
		if not table.find(ActiveUUIDs, uuid) then
			model:Destroy()
			Module.ActiveInstanceCache[character][uuid] = nil
		end
	end

end

function Module.ReloadCharacterVisuals(character : Model)
	task.wait()
	local Humanoid = character:FindFirstChildWhichIsA('Humanoid')
	if not Humanoid then
		return
	end
	CombatSharedModule.SetupCharacterAnimations(character, Humanoid)
	Module.UpdateCharacterVisuals(character)

	local connection = CharacterStatesService.StateChanged(character):Connect(function(stateName)
		if stateName == "SwordDrawn" then
			Module.UpdateCharacterVisuals(character)
		end
	end)

	Humanoid.Destroying:Wait()

	connection:Disconnect()
end

function Module.Start()

	EquipmentRenderEvent.OnClientEvent:Connect(function(job : number, ...)
		if job == RemoteJobs.BulkSet then
			Module.BulkSetCharacterVisuals(...)
		elseif job == RemoteJobs.Cleanup then
			Module.CleanupCharacterData(...)
		elseif job == RemoteJobs.BulkRemove then
			Module.BulkRemoveCharacterVisuals(...)
		end
	end)

	-- Roblox doesn't guarantee event ordering across different
	-- RemoteEvents. The server's broadcast of item configs (via
	-- ConfigReplicationEvent) and the equip render event (via
	-- EquipmentRenderEvent) can arrive in either order on the client.
	-- If BulkSet lands first, the renderer's defensive guards return
	-- empty Folders for items whose configs aren't yet in the shell.
	-- When the configs DO land, ConfigReplicationClient fires the
	-- 'Items' OnReplicated signal — re-render every active character
	-- so the placeholder Folders get replaced with the real visuals.
	local LocalModulesRoot = LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules')
	local LocalModules = require(LocalModulesRoot)
	local ConfigReplicationClient = LocalModules.Modules.ConfigReplicationClient
	local itemsSig = ConfigReplicationClient and ConfigReplicationClient.GetSignal
		and ConfigReplicationClient.GetSignal('Items')
	if itemsSig then
		itemsSig:Connect(function()
			-- Walk every cached character and refresh its visuals. The
			-- update is idempotent (placeholder Folders get destroyed
			-- and rebuilt; real models stay if their configs were
			-- already populated).
			for character in Module.ActiveDataCache do
				Module.UpdateCharacterVisuals(character)
			end
		end)
	end

	local function OnPlayerAdded( player : Player )
		if player.Character then
			task.spawn(Module.ReloadCharacterVisuals, player.Character)
		end

		local Maid = MaidClassModule.New()

		Maid:Give(player.CharacterAdded:Connect(Module.ReloadCharacterVisuals))
		Maid:Give(player:GetAttributeChangedSignal('SwordDrawing'):Connect(function()
			if not player.Character then
				return
			end
			Module.UpdateCharacterVisuals(player.Character)
		end))

		player.Destroying:Wait()

		Maid:Cleanup()
	end

	for _, player in Players:GetPlayers() do
		task.defer(OnPlayerAdded, player)
	end
	Players.PlayerAdded:Connect(OnPlayerAdded)

	EquipmentRenderEvent:FireServer()

	task.spawn(function()
		while true do
			task.wait(30)
			for character, _ in Module.ActiveDataCache do
				-- cleanup any dead characters / null references
				if character and character:IsDescendantOf(workspace) then
					continue
				end
				Module.CleanupCharacterData(character)
			end
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Gameplay/CombatClient"><![CDATA[-- // CombatClient.luau //
-- Combat client shell: wiring and remote dispatch.
--
-- See NIER_COMBAT.md for the design.
--
-- This module used to be 1189 lines holding input binding, combo
-- prediction, animation loading and length measurement, dodge direction
-- resolution, control locking, guard walk-speed handling and the remote
-- listener all at once. Those are now four focused modules:
--
--   CombatInputClient       bindings, input buffer, intent dispatch
--   CombatPredictionClient  local combo, cancel windows, reconciliation
--   CombatAnimationClient   every AnimationTrack, and nothing else
--   CombatMotionClient      control lock, guard speed, lock-on facing
--
-- What remains here is the seam: lifecycle wiring and the single
-- OnClientEvent dispatcher. Keeping the entry point at this name means
-- HotbarWidget and the settings tabs continue to reach combat where
-- they always have.

local Players = game:GetService('Players')
local Debris = game:GetService('Debris')

local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CombatConfigModule = ReplicatedModules.Data.CombatConfig
local CombatActions = ReplicatedModules.Data.CombatActions
local CombatShared = ReplicatedModules.Services.CombatShared
local SoundService = ReplicatedModules.Services.SoundService
local ReplicatedData = ReplicatedModules.Services.ReplicatedData

local RemoteService = ReplicatedModules.Services.RemoteService
local CombatEvent = RemoteService.GetRemote('CombatEvent', 'RemoteEvent', false)

local LocalSettingsRegistry =
	require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules')).Modules.SettingsRegistry

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Sub-module access. These are siblings in the Gameplay container; the
-- framework fills SystemsContainer during Init.
----------------------------------------------------------------------
local function inputClient() return SystemsContainer.CombatInputClient end
local function animationClient() return SystemsContainer.CombatAnimationClient end
local function predictionClient() return SystemsContainer.CombatPredictionClient end
local function motionClient() return SystemsContainer.CombatMotionClient end
local function perfectDodgeClient() return SystemsContainer.PerfectDodgeClient end

----------------------------------------------------------------------
-- Audio.
----------------------------------------------------------------------
local function playCombatSFX(character: Instance, configKey: string)
	local config = CombatConfigModule.SoundEffects and CombatConfigModule.SoundEffects[configKey]
	if not config then return end
	local root = character:FindFirstChild('HumanoidRootPart')
	local position = root and (root :: BasePart).Position or character:GetPivot().Position
	local sound, attachment = SoundService.CreateSoundAtPosition(config.SoundId, position)
	if not sound or not attachment then return end
	sound.Volume = config.Volume * LocalSettingsRegistry.GetSFXMultiplier()
	sound:Play()
	Debris:AddItem(attachment, sound.TimeLength + 0.5)
end

----------------------------------------------------------------------
-- Weapon draw. Public because HotbarWidget binds the same action.
----------------------------------------------------------------------
function Module.AttemptWeaponDrawnToggle()
	local character = LocalPlayer.Character
	if not character then return end
	local input = inputClient()
	if input then
		input.AttemptWeaponToggle()
	end
end

-- Plays the sheathe/unsheathe presentation. Driven by the server's
-- WeaponToggled broadcast rather than by the local press, so the
-- animation never disagrees with the authoritative drawn state.
local function onWeaponToggled(payload: any)
	if typeof(payload) ~= 'table' then return end
	local character = payload.Caster
	if character ~= LocalPlayer.Character then return end

	local Animation = animationClient()
	if not Animation then return end

	-- Agility sheathe-speed perk: +1% playback per level. Visual only.
	local data = ReplicatedData.GetData('PlayerData', false)
	local level = 0
	if data and typeof(data.Attributes) == 'table' then
		local entry = data.Attributes.Agility
		if typeof(entry) == 'number' then
			level = entry
		elseif typeof(entry) == 'table' and tonumber(entry.Level) then
			level = entry.Level
		end
	end
	local speed = 1 + level * 0.01

	local drawing = payload.Drawn == true
	local hasLeft = CombatShared.DoesCharacterHaveLeftWeapon(character)
	local hasRight = CombatShared.DoesCharacterHaveRightWeapon(character)

	if drawing then
		if hasLeft then Animation.PlayStateOnce('UnSheatheLeft', speed) end
		if hasRight then Animation.PlayStateOnce('UnSheatheRight', speed) end
		playCombatSFX(character, 'UnSheathe')
	else
		if hasLeft then Animation.PlayStateOnce('ToSheatheLeft', speed) end
		if hasRight then Animation.PlayStateOnce('ToSheatheRight', speed) end
		playCombatSFX(character, 'ToSheathe')
	end
end

----------------------------------------------------------------------
-- Remote dispatch.
--
-- Every message is (actionString, payloadTable). None of these carry
-- authority: a client that dropped all of them would still be playing
-- the same game, just without impact effects and with a combo string
-- that drifts until the next confirmation.
----------------------------------------------------------------------
local function onCombatEvent(action: string, payload: any)
	if typeof(action) ~= 'string' then return end
	local Actions = CombatActions.Actions

	if action == Actions.ActionStarted then
		local Prediction = predictionClient()
		if Prediction then Prediction.OnActionStarted(payload) end
		-- Turn toward the server's acquired target and apply the swing's
		-- movement penalty. Both are the local character's own job: its
		-- root is client-owned, so the server can neither rotate it nor
		-- hold it in place without replicating a stale transform back.
		local Motion = motionClient()
		if Motion and Motion.OnActionStarted then
			Motion.OnActionStarted(payload)
		end

	elseif action == Actions.ActionRejected then
		local Prediction = predictionClient()
		if Prediction then Prediction.OnActionRejected(payload) end

	elseif action == Actions.ActionCancelled then
		local Prediction = predictionClient()
		if Prediction then Prediction.OnActionCancelled(payload) end

	elseif action == Actions.HitConfirmed then
		-- Impact presentation. The finisher flourish is only rendered
		-- when the server itself flagged the hit as a finisher, so a
		-- forged combo claim cannot manufacture the VFX.
		if typeof(payload) == 'table' and payload.IsFinisher then
			local PerfectDodge = perfectDodgeClient()
			if PerfectDodge and PerfectDodge.OnFinisherHit then
				PerfectDodge.OnFinisherHit(payload.Caster, payload.Victims)
			end
		end

	elseif action == Actions.PerfectDodge then
		local PerfectDodge = perfectDodgeClient()
		if PerfectDodge and PerfectDodge.OnPerfectDodge and typeof(payload) == 'table' then
			PerfectDodge.OnPerfectDodge(payload.Caster)
		end

	elseif action == Actions.GuardBlocked then
		if typeof(payload) == 'table' then
			CombatShared.BlockedEffect(payload.Caster)
		end

	elseif action == Actions.GuardBroken then
		if typeof(payload) == 'table' then
			CombatShared.BlockBreakEffect(payload.Caster)
		end

	elseif action == Actions.WeaponToggled then
		onWeaponToggled(payload)
	end
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.OnCharacterAdded(character: Model)
	local Animation = animationClient()
	if Animation then Animation.BindCharacter(character) end

	local Motion = motionClient()
	if Motion then Motion.OnCharacterAdded(character) end

	local Input = inputClient()
	if Input then Input.OnCharacterAdded() end

	local Prediction = predictionClient()
	if Prediction then Prediction.ResetCombo() end
end

function Module.Start()
	local Input = inputClient()
	if Input then Input.BindInputs() end

	if LocalPlayer.Character then
		Module.OnCharacterAdded(LocalPlayer.Character)
	end
	LocalPlayer.CharacterAdded:Connect(Module.OnCharacterAdded)

	CombatEvent.OnClientEvent:Connect(onCombatEvent)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Gameplay/OverheadInfo"><![CDATA[local CollectionService = game:GetService('CollectionService')
local TweenService = game:GetService('TweenService')

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local MaidClassModule = ReplicatedModules.Modules.Maid

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local SettingsRegistry = LocalModules.Modules.SettingsRegistry
local PALETTE = HUDCommon.PALETTE

local TitlesConfig  = ReplicatedModules.Data.Titles
local TitleRenderer = ReplicatedModules.Utility.TitleRenderer
local CombatUtility = ReplicatedModules.Utility.CombatUtility

local SystemsContainer = {}

-- Per-label active-effect cleanup map. ApplyTitle calls into
-- TitleRenderer which returns a cleanup closure; we stash it here
-- keyed by the label so the next ApplyTitle call (or a label
-- destruction) can run the previous cleanup before re-applying.
-- Without this, gradients + Heartbeat connections leak per re-apply.
local TitleCleanups: { [TextLabel]: (() -> ())? } = {}

local CHARACTER_TAG_NAME = 'OVERHEAD_INFO'
local CharacterInstanceCache = { }
local updateTweenInfo = TweenInfo.new(0.5)

----------------------------------------------------------------------
-- Visibility classification.
--
-- Each tagged character belongs to one of three audiences (the player
-- can hide each independently via SettingsRegistry):
--   * 'own'     — LocalPlayer's own character.
--   * 'other'   — Some other player's character.
--   * 'enemy'   — NPC / world AI character (no associated Player).
--
-- The classification is done once per attach. The .Enabled property of
-- the BillboardGui is then driven by the relevant setting key, both at
-- attach time and via SettingsRegistry.Changed updates (cleaned up
-- through the per-character Maid).
----------------------------------------------------------------------
local function classifyCharacter(characterInstance: Instance): string
	local owner = Players:GetPlayerFromCharacter(characterInstance)
	if owner == LocalPlayer then return 'own' end
	if owner ~= nil then return 'other' end
	return 'enemy'
end

local function settingKeyForKind(kind: string): string
	if kind == 'own'   then return 'OverheadOwnEnabled'   end
	if kind == 'other' then return 'OverheadOthersEnabled' end
	return 'OverheadEnemiesEnabled'
end

local function isVisibleForKind(kind: string): boolean
	return SettingsRegistry[settingKeyForKind(kind)] ~= false
end

-- Reference: hud.jsx Nameplate — accent bar healthy, warn at 40%, danger at 20%.
-- Darker background tone per tier keeps the unfilled portion visible against the bar fill.
local HEALTH_BAR_SEQUENCES = {
	{
		0.4,
		Color3.fromRGB(30, 58, 44),   -- track tone (success)
		PALETTE.success,              -- fill (accent healthy)
	},
	{
		0.2,
		Color3.fromRGB(62, 48, 18),   -- track tone (gold)
		PALETTE.gold,                 -- fill (warning)
	},
	{
		0,
		Color3.fromRGB(70, 22, 28),   -- track tone (danger)
		PALETTE.danger,               -- fill (critical)
	},
}

-- Code-built nameplate. Preserves child paths used by Module.UpdateOverheadInfo
-- and the healthDelta/staminaDelta listeners:
--   Frame.NameLabel, Frame.LevelLabel, Frame.Health.Label,
--   Frame.Health.Bar.UIGradient, Frame.Stamina.Bar.UIGradient.
-- Plus the TitleLabel added above NameLabel:
--   Frame.TitleLabel  (Visible=false until ActiveTitle attribute is set).
--
-- Layout rewrite: BillboardGui is now sized in SCALE (5 × 1.5 studs) so the
-- nameplate shrinks/grows naturally with camera distance instead of being a
-- fixed-pixel overlay. Every inner frame/label uses UDim2.fromScale so the
-- whole plate keeps its proportions at any viewer zoom.
--
-- Vertical band layout (scale Y within the 5:1.5 billboard rect):
--   0.00 – 0.18   TitleLabel         (slim accent strip; hidden when no title)
--   0.20 – 0.42   NameLabel          (big, floats above the UI)
--   0.44 – 0.66   Pill + LevelLabel  (band; HP readout floats right of it)
--   0.70 – 0.80   Health bar
--   0.83 – 0.91   Stamina bar
local function buildNameplate(): BillboardGui
	local billboard = Instance.new('BillboardGui')
	billboard.Name = 'OverheadCharacter'
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	-- Scale size in studs, auto-scales with camera distance. Bumped to
	-- 5×1.5 to make room for the [TITLE] strip above the name without
	-- shrinking the existing bars/labels — extra height all goes into
	-- the new title band at the top.
	billboard.Size = UDim2.fromScale(5, 1.5)
	billboard.MaxDistance = 120

	local root = Instance.new('Frame')
	root.Name = 'Frame'
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.Parent = billboard

	-- TitleLabel — top band. Hidden until SetTitle is called (Visible=false
	-- by default so unowned/no-title characters keep the original look).
	-- TextScaled fills the 18%-height band; the label is monospace + accent
	-- color so it reads as a "tag" distinct from the display name below.
	local titleLabel = Instance.new('TextLabel')
	titleLabel.Name = 'TitleLabel'
	titleLabel.Visible = false
	titleLabel.AnchorPoint = Vector2.new(0.5, 0)
	titleLabel.Position = UDim2.fromScale(0.5, 0)
	titleLabel.Size = UDim2.fromScale(1, 0.18)
	titleLabel.BackgroundTransparency = 1
	titleLabel.FontFace = HUDCommon.FONT_MONO
	titleLabel.TextScaled = true
	titleLabel.TextColor3 = PALETTE.accent
	titleLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
	titleLabel.TextStrokeTransparency = 0.2
	titleLabel.TextXAlignment = Enum.TextXAlignment.Center
	titleLabel.TextYAlignment = Enum.TextYAlignment.Center
	titleLabel.TextTruncate = Enum.TextTruncate.AtEnd
	titleLabel.Text = ''
	titleLabel.Parent = root

	-- NameLabel — ABOVE the UI (top band, below title). TextScaled so it
	-- fills its band at any billboard size.
	local nameLabel = Instance.new('TextLabel')
	nameLabel.Name = 'NameLabel'
	nameLabel.AnchorPoint = Vector2.new(0.5, 0)
	nameLabel.Position = UDim2.fromScale(0.5, 0.20)
	nameLabel.Size = UDim2.fromScale(1, 0.22)
	nameLabel.BackgroundTransparency = 1
	nameLabel.FontFace = HUDCommon.FONT_DISPLAY
	nameLabel.TextScaled = true
	nameLabel.TextColor3 = PALETTE.ink
	nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
	nameLabel.TextStrokeTransparency = 0.2
	nameLabel.TextXAlignment = Enum.TextXAlignment.Center
	nameLabel.TextYAlignment = Enum.TextYAlignment.Center
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	nameLabel.Text = 'Unknown'
	nameLabel.Parent = root

	-- Pill band: translucent backing behind level + HP readout.
	local pill = Instance.new('Frame')
	pill.Name = 'Pill'
	pill.AnchorPoint = Vector2.new(0.5, 0)
	pill.Position = UDim2.fromScale(0.5, 0.44)
	pill.Size = UDim2.fromScale(0.92, 0.22)
	pill.BackgroundColor3 = Color3.new(0, 0, 0)
	pill.BackgroundTransparency = 0.35
	pill.BorderSizePixel = 0
	pill.Parent = root

	local pillStroke = Instance.new('UIStroke')
	pillStroke.Color = PALETTE.accent
	pillStroke.Transparency = 0.5
	pillStroke.Thickness = 1
	pillStroke.Parent = pill

	-- Level chip (left half of pill). Kept under `root` so the canonical
	-- path `Frame.LevelLabel` resolves (external callers depend on it).
	local levelLabel = Instance.new('TextLabel')
	levelLabel.Name = 'LevelLabel'
	levelLabel.AnchorPoint = Vector2.new(0, 0)
	levelLabel.Position = UDim2.fromScale(0.06, 0.46)
	levelLabel.Size = UDim2.fromScale(0.38, 0.18)
	levelLabel.BackgroundTransparency = 1
	levelLabel.FontFace = HUDCommon.FONT_MONO
	levelLabel.TextScaled = true
	levelLabel.TextColor3 = PALETTE.accent
	levelLabel.TextXAlignment = Enum.TextXAlignment.Left
	levelLabel.TextYAlignment = Enum.TextYAlignment.Center
	levelLabel.Text = 'Lvl: ???'
	levelLabel.Parent = root

	-- Health bar track beneath the pill.
	local health = Instance.new('Frame')
	health.Name = 'Health'
	health.AnchorPoint = Vector2.new(0.5, 0)
	health.Position = UDim2.fromScale(0.5, 0.70)
	health.Size = UDim2.fromScale(0.88, 0.10)
	health.BackgroundColor3 = HEALTH_BAR_SEQUENCES[1][2]
	health.BorderSizePixel = 0
	health.Parent = root

	local healthStroke = Instance.new('UIStroke')
	healthStroke.Color = PALETTE.accent
	healthStroke.Transparency = 0.6
	healthStroke.Thickness = 1
	healthStroke.Parent = health

	local healthBar = Instance.new('Frame')
	healthBar.Name = 'Bar'
	healthBar.Size = UDim2.fromScale(1, 1)
	healthBar.BackgroundColor3 = HEALTH_BAR_SEQUENCES[1][3]
	healthBar.BorderSizePixel = 0
	healthBar.Parent = health

	local healthGradient = Instance.new('UIGradient')
	healthGradient.Transparency = NumberSequence.new(0)
	healthGradient.Parent = healthBar

	-- HP readout. Kept parented under `health` so the canonical path
	-- `Frame.Health.Label` still resolves. Positioned in `health`-local
	-- scale space — since the bar frame is 0.10 tall in root-space, moving
	-- the label up ~2.5 bar-heights places it on the pill row above.
	local healthText = Instance.new('TextLabel')
	healthText.Name = 'Label'
	healthText.AnchorPoint = Vector2.new(1, 1)
	healthText.Position = UDim2.fromScale(1, -0.4)
	healthText.Size = UDim2.fromScale(0.55, 2.4)
	healthText.BackgroundTransparency = 1
	healthText.FontFace = HUDCommon.FONT_MONO
	healthText.TextScaled = true
	healthText.TextColor3 = PALETTE.ink
	healthText.TextStrokeTransparency = 0.4
	healthText.TextXAlignment = Enum.TextXAlignment.Right
	healthText.TextYAlignment = Enum.TextYAlignment.Center
	healthText.Text = '0 / 0'
	healthText.Parent = health

	-- Stamina bar: thinner, below health.
	local stamina = Instance.new('Frame')
	stamina.Name = 'Stamina'
	stamina.AnchorPoint = Vector2.new(0.5, 0)
	stamina.Position = UDim2.fromScale(0.5, 0.83)
	stamina.Size = UDim2.fromScale(0.88, 0.06)
	stamina.BackgroundColor3 = Color3.fromRGB(18, 30, 50)
	stamina.BorderSizePixel = 0
	stamina.Parent = root

	local staminaBar = Instance.new('Frame')
	staminaBar.Name = 'Bar'
	staminaBar.Size = UDim2.fromScale(1, 1)
	staminaBar.BackgroundColor3 = PALETTE.accent
	staminaBar.BackgroundTransparency = 0.15
	staminaBar.BorderSizePixel = 0
	staminaBar.Parent = stamina

	local staminaGradient = Instance.new('UIGradient')
	staminaGradient.Transparency = NumberSequence.new(0)
	staminaGradient.Parent = staminaBar

	return billboard
end

local function TweenOverheadOut( OverheadInstance )
	local ti = TweenInfo.new(1, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)

	local connections = {}
	local numberTween = Instance.new('NumberValue')
	numberTween.Value = 1

	local Tween = nil
	for _, Object in OverheadInstance:GetDescendants() do
		if Object:IsA("Frame") then
			Tween = TweenService:Create( Object, ti, { BackgroundTransparency = 1 } )
			Tween:Play()
		elseif Object:IsA("TextLabel") then
			Tween = TweenService:Create( Object, ti, { TextTransparency = 1 } )
			Tween:Play()
		elseif Object:IsA("ImageLabel") then
			Tween = TweenService:Create( Object, ti, { ImageTransparency = 1 } )
			Tween:Play()
		elseif Object:IsA("UIGradient") then
			table.insert(connections, numberTween.Changed:Connect(function()
				Object.Transparency = NumberSequence.new(numberTween.Value)
			end))
		end
	end

	if Tween and Tween.PlaybackState == Enum.PlaybackState.Playing then
		Tween.Completed:Wait()
		numberTween:Destroy()
		for _, item in connections do
			item:Disconnect()
		end
	end
end

-- // Module // --
local Module = {}

function Module.ApplyTitle(OverheadInstance, titleId)
	local titleLabel = OverheadInstance.Frame:FindFirstChild('TitleLabel')
	if not titleLabel then return end

	-- Always run any previous cleanup before re-applying — covers
	-- title swaps mid-session AND clears (titleId == nil/'') so
	-- gradient/effect resources don't survive a clear.
	local prev = TitleCleanups[titleLabel]
	if prev then prev() end
	TitleCleanups[titleLabel] = nil

	if typeof(titleId) ~= 'string' or titleId == '' then
		TitleRenderer.Clear(titleLabel)
		return
	end
	local cfg = TitlesConfig.Titles[titleId]
	if not cfg then
		TitleRenderer.Clear(titleLabel)
		return
	end

	-- Apply via the shared renderer. Returns the cleanup closure that
	-- destroys any UIGradient + disconnects Heartbeat-driven effects.
	-- Stash by label so the next ApplyTitle / clear path picks it up.
	local cleanup = TitleRenderer.Apply(titleLabel, cfg, {
		DefaultColor = PALETTE.accent,
	})
	TitleCleanups[titleLabel] = cleanup
	-- Auto-clear when the label gets destroyed externally (character
	-- despawn). Without this the TitleCleanups table would slowly
	-- accumulate stale entries each respawn — :Once means the connection
	-- is GC'd alongside the instance, no manual disconnect needed.
	titleLabel.Destroying:Once(function()
		local stash = TitleCleanups[titleLabel]
		if stash then stash() end
		TitleCleanups[titleLabel] = nil
	end)
end

function Module.UpdateOverheadInfo( Humanoid, OverheadInstance )
	-- health value
	-- Both sides formatted, not floored. MaxHealth is scaled per floor by
	-- EnemyServer's difficulty multipliers so it is not reliably whole,
	-- and flooring Health made the bar disagree with the damage numbers —
	-- 13.7 off 100 rendered as '86 / 100'.
	OverheadInstance.Frame.Health.Label.Text =
		CombatUtility.FormatCombatNumber(Humanoid.Health)
		.. ' / ' .. CombatUtility.FormatCombatNumber(Humanoid.MaxHealth)

	-- level value
	local Level = Humanoid.Parent:GetAttribute("Level")
	if Level then
		OverheadInstance.Frame.LevelLabel.Text = "Lvl: "..tostring(Level)
	else
		OverheadInstance.Frame.LevelLabel.Text = "???"
	end
end

function Module.OnCharacterInstanceAdded( CharacterInstance )
	local Humanoid = CharacterInstance:WaitForChild('Humanoid', 7) :: Humanoid
	local AdorneePart = CharacterInstance:WaitForChild('HumanoidRootPart', 7) or CharacterInstance.PrimaryPart
	if CharacterInstanceCache[ CharacterInstance ] or (not Humanoid) or (not AdorneePart) then
		return
	end

	print(CharacterInstance:GetFullName(), "OverheadInfo")

	local OverheadClone: BillboardGui = buildNameplate()
	-- Visibility is per-class (own / other player / enemy) and gated
	-- by SettingsRegistry. Initial Enabled reads the live setting; the
	-- Changed listener (set up below) flips it on subsequent toggles.
	local audienceKind = classifyCharacter(CharacterInstance)
	OverheadClone.Enabled = isVisibleForKind(audienceKind)
	OverheadClone.StudsOffset = Vector3.new(0, 5, 0)
	OverheadClone.Adornee = AdorneePart
	OverheadClone.Frame.NameLabel.Text = string.upper(CharacterInstance.Name)
	OverheadClone.Parent = CharacterInstance

	Humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	Humanoid.DisplayName = ""

	local MaidInstance = MaidClassModule.New()

	local healthDeltaValue = Instance.new('NumberValue')
	-- Track the active health tier so the BG/Bar color tween only fires
	-- when the tier ACTUALLY changes (healthy → warn → danger), not on
	-- every Changed frame as the deltaHealth tween animates. Previously
	-- every frame of the 0.5s health tween created two NEW Tween instances
	-- per nameplate — at 5 mobs being damaged that was ~30 frames × 5 ×
	-- 2 = 300 Tween allocations for one swing. The NumberSequence
	-- rebuild for the gradient still runs per frame (unavoidable for the
	-- bar to drain smoothly) but it's a single-instance reassignment.
	local healthHealthBar = OverheadClone.Frame.Health
	local healthBarFill = healthHealthBar.Bar
	local healthBarGradient = healthBarFill.UIGradient
	local activeTierIndex: number? = nil
	MaidInstance:Give(healthDeltaValue.Changed:Connect(function()
		local deltaHealth = math.clamp(healthDeltaValue.Value, 0.001, 0.998)
		-- Pick the matching tier by walking HEALTH_BAR_SEQUENCES (3 entries).
		-- Only re-tween the colors if the tier index changed since the
		-- last fire — avoids the per-frame Tween allocation storm.
		for i, sequenceData in HEALTH_BAR_SEQUENCES do
			if deltaHealth > sequenceData[1] then
				if activeTierIndex ~= i then
					activeTierIndex = i
					TweenService:Create(healthHealthBar, TweenInfo.new(0.5), { BackgroundColor3 = sequenceData[2] }):Play()
					TweenService:Create(healthBarFill, TweenInfo.new(0.5), { BackgroundColor3 = sequenceData[3] }):Play()
				end
				break
			end
		end
		healthBarGradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(deltaHealth, 0),
			NumberSequenceKeypoint.new(deltaHealth + 0.001, 1),
			NumberSequenceKeypoint.new(1, 1),
		})
	end))
	healthDeltaValue.Value = Humanoid.Health / Humanoid.MaxHealth
	MaidInstance:Give(healthDeltaValue)

	local staminaDeltaValue = Instance.new('NumberValue')
	MaidInstance:Give(staminaDeltaValue.Changed:Connect(function()
		local deltaStamina = math.clamp(staminaDeltaValue.Value, 0.01, 0.98)
		OverheadClone.Frame.Stamina.Bar.UIGradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(deltaStamina, 0),
			NumberSequenceKeypoint.new(deltaStamina + 0.01, 1),
			NumberSequenceKeypoint.new(1, 1),
		})
	end))
	staminaDeltaValue.Value = 0.5
	MaidInstance:Give(staminaDeltaValue)

	MaidInstance:Give(Humanoid.Died:Connect(function()
		MaidInstance:Cleanup()
	end))

	MaidInstance:Give(Humanoid.Destroying:Connect(function()
		MaidInstance:Cleanup()
	end))

	MaidInstance:Give(Humanoid.HealthChanged:Connect(function()
		TweenService:Create( healthDeltaValue, updateTweenInfo, { Value = Humanoid.Health / Humanoid.MaxHealth } ):Play()
		Module.UpdateOverheadInfo( Humanoid, OverheadClone )
	end))

	MaidInstance:Give(CharacterInstance:GetAttributeChangedSignal("Level"):Connect(function()
		Module.UpdateOverheadInfo( Humanoid, OverheadClone )
	end))

	-- Active title — server writes this attribute on the character (see
	-- TitlesServer.applyActiveTitleAttribute). Empty string / nil means
	-- "no title" so the row hides. Otherwise we render '[NAME]' in the
	-- title's configured Display.Color.
	local function refreshTitle()
		local titleId = CharacterInstance:GetAttribute('ActiveTitle')
		Module.ApplyTitle(OverheadClone, titleId)
	end
	MaidInstance:Give(CharacterInstance:GetAttributeChangedSignal('ActiveTitle'):Connect(refreshTitle))
	refreshTitle()

	-- Live toggle: when the player flips their nameplate-visibility
	-- setting for THIS audience class, flip the BillboardGui's Enabled.
	-- The Changed signal fires (key, value); we only react when the
	-- key matches our class (or when the bulk-load tick fires with
	-- key=nil, which means "re-read everything"). The connection is
	-- given to the maid so disposed characters don't keep listening.
	local relevantKey = settingKeyForKind(audienceKind)
	MaidInstance:Give(SettingsRegistry.Changed:Connect(function(key, _value)
		if key == nil or key == relevantKey then
			OverheadClone.Enabled = isVisibleForKind(audienceKind)
		end
	end))

	MaidInstance:Give(function()
		TweenOverheadOut( OverheadClone )
		OverheadClone:Destroy()
	end)

	MaidInstance:Give(function()
		CharacterInstanceCache[ CharacterInstance ] = nil
	end)

	CharacterInstanceCache[ CharacterInstance ] = MaidInstance
	Module.UpdateOverheadInfo( Humanoid, OverheadClone )
end

function Module.OnCharacterInstanceRemoved( CharacterInstance )
	if CharacterInstanceCache[ CharacterInstance ] then
		CharacterInstanceCache[ CharacterInstance ]:Cleanup()
	end
end

function Module.Start()
	for _, CharacterInstance in CollectionService:GetTagged(CHARACTER_TAG_NAME) do
		task.defer(Module.OnCharacterInstanceAdded, CharacterInstance)
	end

	CollectionService:GetInstanceAddedSignal(CHARACTER_TAG_NAME):Connect(Module.OnCharacterInstanceAdded)
	CollectionService:GetInstanceRemovedSignal(CHARACTER_TAG_NAME):Connect(Module.OnCharacterInstanceRemoved)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Gameplay/OverheadCrystal"><![CDATA[local RunService = game:GetService('RunService')
local CollectionService = game:GetService('CollectionService')

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local MaidClassModule = ReplicatedModules.Modules.Maid

local COLLECTION_TAG = 'OVERHEAD_CRYSTAL'
local CharacterInstanceCache = {}

local SystemsContainer = {}

-- // Module // --
local Module = {}

function Module.OnCharacterInstanceAdded( CharacterInstance )
	local Humanoid = CharacterInstance:WaitForChild('Humanoid', 3)
	local Head = CharacterInstance:FindFirstChild('Head')
	if CharacterInstanceCache[ CharacterInstance ] or (not Humanoid) or (not Head) then
		return
	end

	local OverheadDiamond = ReplicatedAssets.Models.Misc.Diamond:Clone()
	OverheadDiamond.Parent = workspace.CurrentCamera

	local MaidInstance = MaidClassModule.New()

	MaidInstance:Give(Humanoid.Died:Connect(function()
		MaidInstance:Cleanup()
	end))

	MaidInstance:Give(Humanoid.Destroying:Connect(function()
		MaidInstance:Cleanup()
	end))

	MaidInstance:Give(RunService.Heartbeat:Connect(function(_)
		local Offset = CFrame.Angles( 0, (time() % 360) * 0.1, 0 )
		local CF = CFrame.new(Head.Position + Vector3.new(0, 1.75, 0)) * Offset
		OverheadDiamond:PivotTo(CF)
	end))

	MaidInstance:Give( OverheadDiamond )

	MaidInstance:Give(function()
		CharacterInstanceCache[ CharacterInstance ] = nil
	end)

	CharacterInstanceCache[ CharacterInstance ] = MaidInstance
end

function Module.OnCharacterInstanceRemoved( CharacterInstance )
	if CharacterInstanceCache[ CharacterInstance ] then
		CharacterInstanceCache[ CharacterInstance ]:Cleanup()
	end
end

function Module.Start()
	for _, CharacterInstance in CollectionService:GetTagged(COLLECTION_TAG) do
		task.defer(Module.OnCharacterInstanceAdded, CharacterInstance)
	end

	CollectionService:GetInstanceAddedSignal(COLLECTION_TAG):Connect(Module.OnCharacterInstanceAdded)
	CollectionService:GetInstanceRemovedSignal(COLLECTION_TAG):Connect(Module.OnCharacterInstanceRemoved)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Gameplay/InteractionsClient"><![CDATA[
export type InteractableBase = {
	-- unique identifier for this interactable
	UID : string | number,
	-- interactable-specific id
	IID : string,

	-- the interactable object
	Object : Instance,
	-- adornee
	Adornee : BasePart,
	-- where the distance is calculated from
	Center : BasePart,

	-- object text
	ObjectText : string?,
	-- action text
	ActionText : string?,

	-- keyboard keycode
	KeyboardCode : Enum.KeyCode?,
	-- gamepad keycode
	GamepadCode : Enum.KeyCode?,
	-- is touch enabled for this interactable
	TouchEnabled : boolean,

	-- is single-use interaction
	SingleUse : boolean,
	-- cooldown for interaction if not single use
	Cooldown : number,
	-- how long it lasts
	HoldDuration: number,
	-- max distance it can be interacted at (<32 studs)
	MaxInteractDistance : number,
	-- whether or not to include height in the distance calculation
	MaxDistanceIncludesHeight : boolean,
	-- requires line of sight
	RequiresLineOfSight : boolean,
	-- show beam line
	ShowBeamLine : boolean,
	-- show highlight
	ShowHighlight : boolean,

	-- custom whitelist function
	IsInteractable : ((InteractableBase, (Player | Model)?) -> boolean)?,

	-- events
	InteractHoldBegin : RBXScriptSignal,
	InteractHoldEnd : RBXScriptSignal,
	InteractTriggered : RBXScriptSignal,
	InteractShown : RBXScriptSignal,
	InteractHidden : RBXScriptSignal,
}

local CollectionService = game:GetService("CollectionService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")

local LocalPlayer = game:GetService('Players').LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild('PlayerGui')

local LocalModules = require(LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("Modules"))
local PlatformModule = LocalModules.Utility.Platform
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE = HUDCommon.PALETTE

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local InteractableData = ReplicatedModules.Data.Interactable
local InteractableService = ReplicatedModules.Services.InteractableService

local CurrentCamera = workspace.CurrentCamera

local SystemsContainer = {}

local interactionHighlight : Highlight = nil

local interactionAttachment0 : Attachment = nil
local interactionAttachment1 : Attachment = nil
local interactionBeam : Beam = nil

local interactionBillboardAttachment : Attachment = nil
local interactionTextBillboard : BillboardGui = nil
local interactionKeyBillboard : BillboardGui = nil

local activeInteractable : InteractableBase? = nil
local holdTimerStart : number? = nil
local holdDelta : number = 0
local activelyHolding : boolean = false

local function TweenSize(frame : Frame, endSize : UDim2, duration : number?)
	frame:TweenSize(endSize, Enum.EasingDirection.InOut, Enum.EasingStyle.Linear, duration or 0.5, true)
end

-- // Module // --
local Module = {}

function Module.InternalStartHold(interactable, inputObject)
	interactable.InteractHoldBegin:Fire()

	holdTimerStart = time()
	holdDelta = 0
	activelyHolding = true

	local finishTime = holdTimerStart + interactable.HoldDuration
	while UserInputService:IsKeyDown(inputObject.KeyCode) and interactable and activelyHolding do
		holdDelta = (time() - holdTimerStart) / (finishTime - holdTimerStart)
		holdDelta = math.clamp(holdDelta, 0, 1)
		if interactionTextBillboard then
			TweenSize(interactionTextBillboard.BarFrame.Bar, UDim2.fromScale(holdDelta, 1), 0.05)
		end
		if holdDelta == 1 then
			break
		end
		-- print(holdDelta)
		task.wait()
	end

	activelyHolding = false
	TweenSize(interactionTextBillboard.BarFrame.Bar, UDim2.fromScale(0, 1), 0)

	if holdDelta >= 1 then
		-- print('Interaction UI Button has been completed!')
		InteractableService.HadInteractedWith(interactable, LocalPlayer)
		interactable.InteractTriggered:Fire()
	end

	-- print('Interaction UI Button has been released.')
	interactable.InteractHoldEnd:Fire()
end

function Module.HandleKeybindPress(inputState : Enum.UserInputState, inputObject : InputObject) : Enum.ContextActionResult
	if not activeInteractable then
		return Enum.ContextActionResult.Pass
	end

	if activeInteractable.KeyboardCode ~= inputObject.KeyCode and activeInteractable.GamepadCode ~= inputObject.KeyCode then
		return Enum.ContextActionResult.Pass
	end

	if inputState ~= Enum.UserInputState.Begin then
		return
	end

	-- print(inputObject.KeyCode.Name, inputObject.UserInputType.Name)
	task.spawn(Module.InternalStartHold, activeInteractable, inputObject)

	return Enum.ContextActionResult.Sink
end

function Module.CleanupActiveInteractable()
	-- walked away, exit key hold loop early
	activelyHolding = false
	-- cleanup interaction if it was visible
	if activeInteractable then
		activeInteractable.InteractHidden:Fire()
		ContextActionService:UnbindAction('InteractBind')
		interactionHighlight.Adornee = nil
		interactionHighlight.Enabled = false
		interactionBeam.Enabled = false
		interactionKeyBillboard.Enabled = false
		interactionTextBillboard.Enabled = false
	end
	activeInteractable = nil
end

local HAS_WARNED_CHANGE_INTERACTIVE_DURING_HOLD = false -- NOTE: TEMPORARY

function Module.HeartbeatStep(_ : number)
	InteractableService.UpdateDynamicPoints()

	-- check for nearby interactables
	local characterPosition : Vector3? = LocalPlayer.Character and LocalPlayer.Character:GetPivot().Position
	local nearby : {any} = characterPosition and InteractableService.FindClosestInteractables(characterPosition, LocalPlayer)
	if (not nearby) or #nearby == 0 then
		if activelyHolding then
			warn('Walked away from interaction during hold.')
		end
		HAS_WARNED_CHANGE_INTERACTIVE_DURING_HOLD = false
		interactionKeyBillboard.Enabled = false
		interactionTextBillboard.Enabled = false
		Module.CleanupActiveInteractable()
		return
	end

	local interactable : InteractableBase = nearby[1]

	-- dont change our active interactable if we're busy interacting and its still nearby
	if activelyHolding and table.find(nearby, activeInteractable) then
		if interactable ~= activeInteractable and not HAS_WARNED_CHANGE_INTERACTIVE_DURING_HOLD then
			HAS_WARNED_CHANGE_INTERACTIVE_DURING_HOLD = true
			warn('Busy with current interaction - do not change active.')
		end
		return
	end

	HAS_WARNED_CHANGE_INTERACTIVE_DURING_HOLD = false

	-- we've moved away from the closest or we're not currently interacting with the nearby one
	-- first time setup for a new neary interactable
	if interactable ~= activeInteractable then
		if activeInteractable then
			if activelyHolding then
				warn('Walked away from interaction during hold.')
			end
			Module.CleanupActiveInteractable()
		end
		interactable.InteractShown:Fire()

		ContextActionService:BindAction('InteractBind', function(actionName, inputState, inputObject)
			if actionName == 'InteractBind' and interactable then
				return Module.HandleKeybindPress(inputState, inputObject)
			end
			return Enum.ContextActionResult.Pass
		end, false, interactable.KeyboardCode, interactable.GamepadCode)
	end

	activeInteractable = interactable

	local center_position : Vector3 = interactable.Center.Position

	-- update billboard ui to display keybind
	local platform = PlatformModule.GetPlatform() :: "Console" | "Desktop" | "Mobile"
	if platform == "Desktop" or platform == "Console" then
		interactionKeyBillboard.Frame.TButton.Visible = true
		-- Defensive resolve: the previous direct `.Name` access produced
		-- a glyph blob whenever KeyboardCode wasn't an EnumItem (e.g. an
		-- interactable registered with a string fallback or a stale
		-- value that survived an API change). Walk the typeof chain so a
		-- string passes through verbatim and a missing/unknown value
		-- defaults to the registry's default 'E' keybind.
		local kc = interactable.KeyboardCode
		local keyText = 'E'
		if typeof(kc) == 'EnumItem' then
			keyText = kc.Name
		elseif typeof(kc) == 'string' and kc ~= '' then
			keyText = kc
		end
		interactionKeyBillboard.Frame.TButton.Text = keyText
		interactionKeyBillboard.Frame.IButton.Visible = false
	elseif platform == "Mobile" then
		interactionKeyBillboard.Frame.TButton.Visible = false
		-- Note: assumes that the IButton is set to the mobile tap icon
		interactionKeyBillboard.Frame.IButton.Visible = true
	end

	-- update billboard ui to display interact text
	interactionTextBillboard.ActionText.Text = interactable.ActionText or ""
	interactionTextBillboard.ObjectText.Text = interactable.ObjectText or ""

	-- update beams
	if interactable.ShowBeamLine then
		interactionBeam.Enabled = true
		interactionAttachment0.WorldCFrame = CFrame.new(characterPosition)
		interactionAttachment1.WorldCFrame = CFrame.new(center_position)
	else
		interactionBeam.Enabled = false
	end

	-- update highlight
	if interactable.ShowHighlight then
		interactionHighlight.Enabled = true
		interactionHighlight.Adornee = interactable.Object
	else
		interactionHighlight.Enabled = false
		interactionHighlight.Adornee = nil
	end

	-- update billboards
	interactionBillboardAttachment.WorldCFrame = CFrame.new(center_position)
	TweenSize(interactionTextBillboard.BarFrame.Bar, UDim2.fromScale(0, 1), 0.7)
	interactionKeyBillboard.Enabled = true
	interactionTextBillboard.Enabled = true
end

function Module.RegisterPresetCallback(presetId : string, interactable : InteractableBase)
	-- TODO
end

function Module.RegisterPresetInteractable(object : Instance) : InteractableBase?
	-- TODO
end

function Module.UnRegisterPresetInteractable(object : Instance)
	-- TODO
end

function Module.SetupTestInteractable()
	-- custom test interaction
	local customObject = workspace:WaitForChild('TestInteractable')

	local interactable = InteractableService.RegisterInteractable({
		-- interactable-specific id
		IID = '1',

		-- the interactable object
		Object = customObject,
		-- adornee
		Adornee = customObject.Adornee,
		-- where the distance is calculated from
		Center = customObject.Center,

		-- object text
		ObjectText = 'Custom Interactor',
		-- action text
		ActionText = 'Press me for something cool!',

		-- show beam line
		ShowBeamLine = true,
		-- show highlight
		ShowHighlight = true,
	})

	print(interactable)

	interactable.InteractHoldBegin:Connect(function()
		print('Interaction key is now held!')
	end)

	interactable.InteractHoldEnd:Connect(function()
		print('Interaction key is now released!')
	end)

	interactable.InteractTriggered:Connect(function()
		print('Interaction has been triggered!')
	end)

	interactable.InteractShown:Connect(function()
		print('Interaction now visible!')
	end)

	interactable.InteractHidden:Connect(function()
		print('Interaction now hidden!')
	end)
end

function Module.Start()
	for _, object in CollectionService:GetTagged(InteractableData.InteractableTag) do
		task.defer(Module.RegisterPresetInteractable, object)
	end
	CollectionService:GetInstanceAddedSignal(InteractableData.InteractableTag):Connect(Module.RegisterPresetInteractable)
	CollectionService:GetInstanceRemovedSignal(InteractableData.InteractableTag):Connect(Module.UnRegisterPresetInteractable)

	-- prefer loop as RunService will not wait for the previous iteration to finish
	task.spawn(function()
		while true do
			local dt : number = task.wait()
			Module.HeartbeatStep(dt)
		end
	end)

	-- setup interaction billboard buttons
	interactionKeyBillboard.Frame.IButton.Activated:Connect(function()
		if not activeInteractable then
			return
		end
		local interactable = activeInteractable
		-- print('Interaction UI Button has been pressed.')
		interactable.InteractHoldBegin:Fire()
		while UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) or UserInputService:IsMouseButtonPressed(Enum.UserInputType.Touch) do
			task.wait()
		end
		-- print('Interaction UI Button has been released.')
		interactable.InteractHoldEnd:Fire()
	end)

	interactionKeyBillboard.Frame.TButton.Activated:Connect(function()
		if not activeInteractable then
			return
		end
		local interactable = activeInteractable
		-- print('Interaction UI Button has been pressed.')
		interactable.InteractHoldBegin:Fire()
		while UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) or UserInputService:IsMouseButtonPressed(Enum.UserInputType.Touch) do
			task.wait()
		end
		-- print('Interaction UI Button has been released.')
		interactable.InteractHoldEnd:Fire()
	end)

	if workspace:FindFirstChild('TestInteractable') then
		task.defer(Module.SetupTestInteractable)
	else
		print("No TestInteractable found in workspace, skipping.")
	end
end

-- Build the text+progress billboard (ObjectText · ActionText · BarFrame > Bar).
local function buildInteractTextBillboard(): BillboardGui
	local bb = Instance.new('BillboardGui')
	bb.Name = 'InteractTextBillboard'
	bb.ResetOnSpawn = false
	bb.Size = UDim2.fromOffset(220, 70)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 2.4, 0)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.ClipsDescendants = false
	bb.Enabled = false

	local object = Instance.new('TextLabel')
	object.Name = 'ObjectText'
	object.Size = UDim2.new(1, 0, 0, 16)
	object.BackgroundTransparency = 1
	object.FontFace = HUDCommon.FONT_MONO
	object.TextSize = 11
	object.TextColor3 = PALETTE.accent
	object.TextStrokeTransparency = 0.6
	object.TextStrokeColor3 = Color3.new(0, 0, 0)
	object.Text = ''
	object.Parent = bb

	local action = Instance.new('TextLabel')
	action.Name = 'ActionText'
	action.Position = UDim2.fromOffset(0, 18)
	action.Size = UDim2.new(1, 0, 0, 20)
	action.BackgroundTransparency = 1
	action.FontFace = HUDCommon.FONT_UI
	action.TextSize = 15
	action.TextColor3 = PALETTE.ink
	action.TextStrokeTransparency = 0.4
	action.TextStrokeColor3 = Color3.new(0, 0, 0)
	action.Text = ''
	action.Parent = bb

	local barFrame = Instance.new('Frame')
	barFrame.Name = 'BarFrame'
	barFrame.AnchorPoint = Vector2.new(0.5, 1)
	barFrame.Position = UDim2.new(0.5, 0, 1, -8)
	barFrame.Size = UDim2.new(1, -40, 0, 3)
	barFrame.BackgroundColor3 = PALETTE.bg0
	barFrame.BackgroundTransparency = 0.35
	barFrame.BorderSizePixel = 0
	barFrame.Parent = bb

	local barStroke = Instance.new('UIStroke')
	barStroke.Color = PALETTE.accent
	barStroke.Transparency = 0.6
	barStroke.Thickness = 1
	barStroke.Parent = barFrame

	local bar = Instance.new('Frame')
	bar.Name = 'Bar'
	bar.Size = UDim2.fromScale(0, 1)
	bar.BackgroundColor3 = PALETTE.accent
	bar.BorderSizePixel = 0
	bar.Parent = barFrame

	return bb
end

-- Build the keybind chip billboard (Frame > TButton | IButton).
local function buildInteractKeyBillboard(): BillboardGui
	local bb = Instance.new('BillboardGui')
	bb.ResetOnSpawn = false
	bb.Name = 'InteractKeyBillboard'
	bb.Size = UDim2.fromOffset(60, 60)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 0.2, 0)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Enabled = false
	bb.Active = true

	local frame = Instance.new('Frame')
	frame.Name = 'Frame'
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.fromOffset(30, 30)
	frame.BackgroundTransparency = 1
	frame.Parent = bb

	local function styleKeyChip(btn: TextButton)
		btn.Size = UDim2.fromScale(1, 1)
		btn.BackgroundColor3 = Color3.new(0, 0, 0)
		btn.BackgroundTransparency = 0.2
		btn.AutoButtonColor = false
		btn.BorderSizePixel = 0
		btn.FontFace = HUDCommon.FONT_MONO
		-- TextScaled fits the glyph to the chip's bounds — fixes the
		-- "blob" rendering at small billboard sizes AND lets multi-char
		-- keybinds like 'LeftControl' / 'LeftShift' shrink to fit
		-- instead of overflowing the 30×30 button. TextSize is kept as
		-- the upper bound (Roblox honors it as the cap when TextScaled
		-- is on).
		btn.TextScaled = true
		btn.TextSize = 14
		btn.TextColor3 = PALETTE.accent
		btn.TextStrokeTransparency = 0.5
		btn.TextStrokeColor3 = Color3.new(0, 0, 0)
		local stroke = Instance.new('UIStroke')
		stroke.Color = PALETTE.accent
		stroke.Thickness = 1.5
		stroke.Transparency = 0
		stroke.Parent = btn
	end

	local tButton = Instance.new('TextButton')
	tButton.Name = 'TButton'
	tButton.Text = 'F'
	tButton.Visible = false
	styleKeyChip(tButton)
	tButton.Parent = frame

	local iButton = Instance.new('TextButton')
	iButton.Name = 'IButton'
	iButton.Text = '◆'
	iButton.Visible = false
	styleKeyChip(iButton)
	iButton.Parent = frame

	return bb
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems

	-- highlight
	interactionHighlight = Instance.new('Highlight')
	interactionHighlight.Name = 'InteractionHighlight'
	interactionHighlight.FillColor = PALETTE.accent
	interactionHighlight.FillTransparency = 0.75
	interactionHighlight.OutlineColor = PALETTE.accent
	interactionHighlight.OutlineTransparency = 0.2
	interactionHighlight.Parent = CurrentCamera

	-- beam attachments
	interactionAttachment0 = Instance.new('Attachment')
	interactionAttachment0.Parent = workspace:WaitForChild('Terrain')
	interactionAttachment1 = Instance.new('Attachment')
	interactionAttachment1.Parent = workspace:WaitForChild('Terrain')

	-- beam
	interactionBeam = Instance.new('Beam')
	interactionBeam.Attachment0 = interactionAttachment0
	interactionBeam.Attachment1 = interactionAttachment1
	interactionBeam.Width0 = 0.075
	interactionBeam.Width1 = 0.075
	interactionBeam.FaceCamera = true
	interactionBeam.Segments = 1
	interactionBeam.Transparency = NumberSequence.new(0.8)
	interactionBeam.Color = ColorSequence.new(PALETTE.accent)
	interactionBeam.LightEmission = 1
	interactionBeam.LightInfluence = 0
	interactionBeam.Parent = interactionAttachment0

	-- billboard attachment
	interactionBillboardAttachment = Instance.new('Attachment')
	interactionBillboardAttachment.Parent = workspace:WaitForChild('Terrain')

	-- billboards — code-built to match tmp/aincrad-ui/hud.jsx WorldPrompt.
	interactionTextBillboard = buildInteractTextBillboard()
	interactionTextBillboard.Adornee = interactionBillboardAttachment
	interactionTextBillboard.BarFrame.Bar.Size = UDim2.fromScale(0, 1)
	interactionTextBillboard.Parent = PlayerGui
	interactionKeyBillboard = buildInteractKeyBillboard()
	interactionKeyBillboard.Adornee = interactionBillboardAttachment
	interactionKeyBillboard.Parent = PlayerGui
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Gameplay/CharacterCosmeticsClient"><![CDATA[

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local ReplicatedData = ReplicatedModules.Services.ReplicatedData
local CharacterModelModule = ReplicatedModules.Utility.Character

local SystemsContainer = {}

-- // Module // --
local Module = {}

function Module.UpdatePlayerCosmetics()
	local playerCosmetics = ReplicatedData.GetData('PlayerCosmetics')
	if not playerCosmetics then
		return
	end

	for playerName, cosmeticData in playerCosmetics do
		local Character = workspace:FindFirstChild( playerName )
		if not Character then
			continue
		end

		local rootPart = Character:FindFirstChild('HumanoidRootPart')
		if rootPart and not rootPart:FindFirstChildWhichIsA('Light') then
			local bodyLight = Instance.new('PointLight')
			bodyLight.Range = 32
			bodyLight.Shadows = false
			bodyLight.Brightness = 0.05
			bodyLight.Parent = rootPart
		end

		CharacterModelModule.ClearBaseCustomizations( Character )
		CharacterModelModule.ApplyBaseCustomizations( Character, cosmeticData )
	end
end

function Module.UpdateWorkspaceCharacter( Character )
	local playerCosmetics = ReplicatedData.GetData('PlayerCosmetics')
	if not playerCosmetics then
		return
	end

	local cosmeticData = playerCosmetics[ Character.Name ]
	if not cosmeticData then
		return
	end

	CharacterModelModule.ClearBaseCustomizations( Character )
	CharacterModelModule.ApplyBaseCustomizations( Character, cosmeticData )
end

function Module.Start()
	ReplicatedData.OnUpdated:Connect(function(category, _)
		if category == 'PlayerCosmetics' then
			Module.UpdatePlayerCosmetics()
		end
	end)

	for _, Character in workspace:GetChildren() do
		if Character:IsA('Model') and Character:FindFirstChildWhichIsA('Humanoid') then
			task.spawn( Module.UpdateWorkspaceCharacter, Character )
		end
	end

	workspace.ChildAdded:Connect(function(Character)
		task.wait()
		if Character:IsA('Model') and Character:FindFirstChildWhichIsA('Humanoid') then
			task.spawn( Module.UpdateWorkspaceCharacter, Character )
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Gameplay/MovementController"><![CDATA[local CollectionService = game:GetService('CollectionService')

local LocalPlayer = game:GetService('Players').LocalPlayer

local PlayerModule = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('PlayerModule'))
local Controls = PlayerModule:GetControls()

local SystemsContainer = {}

-- // Module // --
local Module = {}

function Module.EnableMovement()
	Controls:Enable()
end

function Module.DisableMovement()
	Controls:Disable()
end

function Module.CheckMovementEnabled()
	local Items = CollectionService:GetTagged('MOVEMENT_DISABLE')
	local IsDisabled = table.find( Items, LocalPlayer.Character) or table.find( Items, LocalPlayer)
	if IsDisabled then
		Module.DisableMovement()
	else
		Module.EnableMovement()
	end
end

function Module.Start()
	task.defer(Module.CheckMovementEnabled)

	LocalPlayer.CharacterAdded:Connect(Module.CheckMovementEnabled)

	CollectionService:GetInstanceAddedSignal('MOVEMENT_DISABLE'):Connect(function(item)
		if LocalPlayer.Character == item or LocalPlayer == item then
			Module.CheckMovementEnabled()
		end
	end)

	CollectionService:GetInstanceRemovedSignal('MOVEMENT_DISABLE'):Connect(function(item)
		if (LocalPlayer.Character == item) or (LocalPlayer == item) then
			Module.CheckMovementEnabled()
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Gameplay/MountsClient"><![CDATA[-- Mounts client. Owns the visible mount Model, the weld/lock that keeps the
-- rider on the seat, locomotion replacement (land = WalkSpeed mod, flight =
-- velocity-driven rig), keybind for dismount, and per-frame camera tilt for
-- flight.
--
-- Public API:
--   Module.AttemptEquip(mountId)   — UI hook; sends TryEquip remote
--   Module.AttemptDismount()       — UI/keybind hook
--   Module.IsMounted() → boolean
--
-- Server replicates: data.Mounts.EquippedMount via ReplicatedData, and
-- per-spawn/despawn cues via MountEvent. We render local + other-player
-- mounts off the FireAllClients spawn cue.

local Players = game:GetService('Players')
local UserInputService = game:GetService('UserInputService')
local ContextActionService = game:GetService('ContextActionService')
local RunService = game:GetService('RunService')
local Debris = game:GetService('Debris')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local MountsShared = ReplicatedModules.Services.MountsShared
local MountsConfig = ReplicatedModules.Data.Mounts
local SoundService = ReplicatedModules.Services.SoundService
local RemoteService = ReplicatedModules.Services.RemoteService

local MountEvent = RemoteService.GetRemote('MountEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Per-rider state. Keyed by Player so other players' mounts also render
-- on this client. The local-player entry has extra fields for input
-- handling (flight controls, keybind hookup).
----------------------------------------------------------------------
type Rider = {
	mountId: string,
	model: Model?,
	cfg: any,
	connections: { RBXScriptConnection },
	-- Land + Hover share these (both use humanoid locomotion):
	originalWalkSpeed: number?,
	originalJumpPower: number?,
	originalHipHeight: number?,
	-- Flight only:
	bodyVelocity: BodyVelocity?,
	bodyGyro: BodyGyro?,
	-- Animation tracks:
	tracks: { [string]: AnimationTrack },
}

local Riders: { [Player]: Rider } = {}

----------------------------------------------------------------------
-- Helpers.
----------------------------------------------------------------------
local function findMountTemplate(modelName: string): Model?
	local assets = ReplicatedStorage:FindFirstChild('AssetsShared')
	local mounts = assets and assets:FindFirstChild('Mounts')
	local template = mounts and mounts:FindFirstChild(modelName)
	return template :: Model?
end

----------------------------------------------------------------------
-- Procedural placeholder. Built when the named template under
-- AssetsShared.Mounts.<Model> isn't present so flight rigs still
-- have a PrimaryPart to host BodyVelocity, and land riders have a
-- visible-but-blocky mount instead of an invisible "I'm just floating
-- around" experience. Per-mount tinting derives from the config Kind
-- so land mounts read brown / saddle-toned and flight mounts read
-- blue-grey.
----------------------------------------------------------------------
local function buildPlaceholderMount(cfg: any): Model
	local model = Instance.new('Model')
	model.Name = 'PlaceholderMount_' .. (cfg.Display and cfg.Display.Name or 'Mount')

	local kind = cfg.Kind or 'land'
	local bodyColor: Color3
	if typeof(cfg.Tint) == 'Color3' then
		-- Breed-specific tint (e.g. colored cloud mounts) wins over the
		-- generic Kind-based default.
		bodyColor = cfg.Tint
	elseif kind == 'flight' then
		bodyColor = Color3.fromRGB(120, 145, 180)
	elseif kind == 'hover' then
		-- Pale cloud-grey with a hint of cyan; reads as "wisp of mist".
		bodyColor = Color3.fromRGB(180, 200, 220)
	else
		bodyColor = Color3.fromRGB(120, 80, 50)
	end

	-- Body — primary part. Sized roughly so the player visibly sits on
	-- top via the cfg.SeatOffset, but small enough not to grief the
	-- room around them.
	local body = Instance.new('Part')
	body.Name = 'Body'
	if kind == 'flight' then
		body.Size = Vector3.new(4, 2.4, 6)
	elseif kind == 'hover' then
		-- Wide flat slab — magic-carpet silhouette.
		body.Size = Vector3.new(5, 0.5, 5)
	else
		body.Size = Vector3.new(3, 3, 5)
	end
	body.Color = bodyColor
	body.Material = Enum.Material.SmoothPlastic
	body.Anchored = false
	body.CanCollide = false
	body.Massless = true
	body.TopSurface = Enum.SurfaceType.Smooth
	body.BottomSurface = Enum.SurfaceType.Smooth
	body.Parent = model
	model.PrimaryPart = body

	-- Decorative head + (for flight) wings so the silhouette reads as
	-- something. All welded to the body so the BodyVelocity rig only
	-- needs to drive the body.
	local function attachDecor(part: BasePart, offset: CFrame)
		part.Massless = true
		part.CanCollide = false
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.Material = Enum.Material.SmoothPlastic
		part.Color = bodyColor:Lerp(Color3.new(1, 1, 1), 0.15)
		part.CFrame = body.CFrame * offset
		local weld = Instance.new('Weld')
		weld.Part0 = body
		weld.Part1 = part
		weld.C0 = offset
		weld.Parent = part
		part.Parent = model
	end

	-- Head decor on land/flight mounts only — a hover slab is faceless.
	if kind ~= 'hover' then
		local head = Instance.new('Part')
		head.Name = 'Head'
		head.Size = Vector3.new(1.4, 1.4, 1.6)
		attachDecor(head, CFrame.new(0, 0.7, -3))
	end

	if kind == 'flight' then
		-- Two thin wing slabs flanking the body. Welded so the BodyGyro
		-- yaw rotates the silhouette as the rider banks.
		local wingL = Instance.new('Part')
		wingL.Name = 'WingL'
		wingL.Size = Vector3.new(8, 0.3, 3)
		attachDecor(wingL, CFrame.new(-5, 0.5, 0))

		local wingR = Instance.new('Part')
		wingR.Name = 'WingR'
		wingR.Size = Vector3.new(8, 0.3, 3)
		attachDecor(wingR, CFrame.new(5, 0.5, 0))
	end

	return model
end

local function playSFX(entry: any?, position: Vector3?)
	if not entry or not entry.Sound then return end
	local pos = position or workspace.CurrentCamera.CFrame.Position
	SoundService.PlaySoundAtPosition(entry.Sound, pos)
end

local function isLocal(player: Player): boolean
	return player == LocalPlayer
end

----------------------------------------------------------------------
-- Spawn / despawn.
----------------------------------------------------------------------
local function despawnRider(player: Player, reason: string?)
	local rider = Riders[player]
	if not rider then return end
	for _, conn in rider.connections do
		conn:Disconnect()
	end
	if rider.bodyVelocity then rider.bodyVelocity:Destroy() end
	if rider.bodyGyro then rider.bodyGyro:Destroy() end
	for _, track in rider.tracks do
		if track then track:Stop() end
	end
	if rider.model then rider.model:Destroy() end

	-- Restore humanoid params (land/hover mounts stash original values).
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass('Humanoid')
	if humanoid then
		if rider.originalWalkSpeed then humanoid.WalkSpeed = rider.originalWalkSpeed end
		if rider.originalJumpPower then humanoid.JumpPower = rider.originalJumpPower end
		if rider.originalHipHeight then humanoid.HipHeight = rider.originalHipHeight end
		-- Flight rigs disable PlatformStand/AutoRotate; restore them so
		-- the rider can walk normally after dismount.
		if rider.cfg and rider.cfg.Kind == 'flight' then
			humanoid.PlatformStand = false
			humanoid.AutoRotate = true
		end
	end

	playSFX(rider.cfg.SFX and rider.cfg.SFX.Dismount,
		humanoid and (character :: Model):GetPivot().Position or nil)
	Riders[player] = nil

	if isLocal(player) then
		ContextActionService:UnbindAction('MountsClient_Dismount')
	end
end

local function attachAnimations(humanoid: Humanoid, animMap: any): { [string]: AnimationTrack }
	local out = {}
	if not humanoid then return out end
	local animator = humanoid:FindFirstChildOfClass('Animator')
		or humanoid:WaitForChild('Animator', 1)
	if not animator then return out end
	for stateName, assetId in animMap do
		if typeof(assetId) == 'string' and assetId ~= '' and assetId ~= 'rbxassetid://0' then
			local anim = Instance.new('Animation')
			anim.AnimationId = assetId
			local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
			if ok and track then out[stateName] = track end
			anim:Destroy()
		end
	end
	return out
end

local function spawnRider(player: Player, mountId: string)
	-- Already mounted? Despawn first to keep state clean.
	if Riders[player] then despawnRider(player, 'replace') end

	local cfg = MountsConfig.Mounts[mountId]
	if not cfg then return end
	local character = player.Character
	if not character then return end
	local hrp = character:FindFirstChild('HumanoidRootPart') :: BasePart?
	local humanoid = character:FindFirstChildOfClass('Humanoid')
	if not hrp or not humanoid then return end

	-- Resolve the visual model. Three paths:
	--   1. AssetsShared.Mounts.<Model> exists → clone it (the art-ready path).
	--   2. Asset missing AND it's a land mount → still render a placeholder
	--      so the rider has a visible animal under them.
	--   3. Asset missing AND it's a flight mount → MUST have a PrimaryPart
	--      to host BodyVelocity / BodyGyro; the placeholder provides that.
	-- The placeholder is built procedurally below; both kinds get one.
	local template = findMountTemplate(cfg.Model)
	local model: Model
	if template then
		model = template:Clone()
	else
		warn(string.format(
			"MountsClient: AssetsShared.Mounts.%s missing; using procedural placeholder.",
			tostring(cfg.Model)))
		model = buildPlaceholderMount(cfg)
	end

	-- Anchor the model to the rider via a Weld between the model's
	-- PrimaryPart (or first BasePart) and the rider's HRP. The
	-- SeatOffset CFrame is applied as the weld's C0/C1 so each
	-- mount's seat shape works without engine tuning.
	do
		local primary = model.PrimaryPart
		if not primary then
			for _, d in model:GetDescendants() do
				if d:IsA('BasePart') then primary = d; model.PrimaryPart = d; break end
			end
		end
		model:PivotTo(hrp.CFrame * cfg.SeatOffset:Inverse())
		model.Parent = workspace
		if primary then
			-- Anchor the mount and weld the rider so the rider's HRP
			-- stays glued to the seat. Anchored=true on the mount means
			-- the BodyVelocity (flight) drives the mount; the rider
			-- follows via the weld.
			primary.Anchored = (cfg.Kind == 'flight')
			local weld = Instance.new('Weld')
			weld.Part0 = primary
			weld.Part1 = hrp
			weld.C0 = cfg.SeatOffset
			weld.Parent = primary
		end
	end

	local rider: Rider = {
		mountId = mountId,
		model = model,
		cfg = cfg,
		connections = {},
		tracks = {},
		originalWalkSpeed = humanoid.WalkSpeed,
		originalJumpPower = humanoid.JumpPower,
		originalHipHeight = humanoid.HipHeight,
	}

	-- Land mount: humanoid speed/jump boost. Hover mount: same as land
	-- but lift the rider via humanoid.HipHeight so they appear to float
	-- (no actual flight controls — WSAD walks them around at altitude).
	-- Flight mount: full velocity-rig replaces normal locomotion.
	if cfg.Kind == 'land' then
		humanoid.WalkSpeed = cfg.Stats.Speed
		if cfg.Stats.JumpPower then humanoid.JumpPower = cfg.Stats.JumpPower end
	elseif cfg.Kind == 'hover' then
		humanoid.WalkSpeed = cfg.Stats.Speed
		if cfg.Stats.JumpPower then humanoid.JumpPower = cfg.Stats.JumpPower end
		-- HipHeight float — engine keeps the humanoid at this distance
		-- above the ground every physics step. Reads as "hovering" while
		-- still respecting collisions and walking input.
		humanoid.HipHeight = cfg.Stats.HoverHeight or 6
	elseif cfg.Kind == 'flight' then
		humanoid.PlatformStand = true
		humanoid.AutoRotate = false
		local primary = model and (model :: Model).PrimaryPart
		if primary then
			local bv = Instance.new('BodyVelocity')
			bv.MaxForce = Vector3.new(1, 1, 1) * 1e5
			bv.Velocity = Vector3.zero
			bv.Parent = primary
			rider.bodyVelocity = bv

			local bg = Instance.new('BodyGyro')
			bg.MaxTorque = Vector3.new(1, 1, 1) * 1e5
			bg.D = 800
			bg.P = 9000
			bg.CFrame = primary.CFrame
			bg.Parent = primary
			rider.bodyGyro = bg
		end
	end

	-- Animations (loaded lazily; anim ids of '0' or '' are skipped).
	rider.tracks = attachAnimations(humanoid, cfg.Animations or {})
	if rider.tracks.RiderIdle then rider.tracks.RiderIdle:Play(0.2) end
	if cfg.Kind == 'flight' and rider.tracks.Hover then rider.tracks.Hover:Play(0.2) end

	playSFX(cfg.SFX and cfg.SFX.Mount, hrp.Position)
	Riders[player] = rider

	-- Local rider only: keybinds + flight loop + camera tilt.
	if isLocal(player) then
		ContextActionService:BindAction(
			'MountsClient_Dismount',
			function(_, state)
				if state == Enum.UserInputState.Begin then
					Module.AttemptDismount()
				end
				return Enum.ContextActionResult.Pass
			end,
			false,
			Enum.KeyCode.LeftShift   -- dismount key
		)
		ContextActionService:SetTitle('MountsClient_Dismount', 'Dismount')

		-- Flight controls: W/S = pitch (ascend/descend), Heartbeat ticks
		-- BodyVelocity from current humanoid look + input.
		if cfg.Kind == 'flight' then
			local primary = model and (model :: Model).PrimaryPart
			local bv = rider.bodyVelocity
			local bg = rider.bodyGyro
			local connHb = RunService.Heartbeat:Connect(function(_dt)
				if not primary or not primary.Parent then return end
				if not bv or not bg then return end

				-- Forward intent from movement (humanoid.MoveDirection is
				-- the camera-relative WASD vector).
				local moveDir = humanoid.MoveDirection
				local cam = workspace.CurrentCamera and workspace.CurrentCamera.CFrame
				local lookFwd = cam and Vector3.new(cam.LookVector.X, 0, cam.LookVector.Z).Unit or Vector3.zAxis
				local horizontal = moveDir.Magnitude > 0
					and Vector3.new(moveDir.X, 0, moveDir.Z) * cfg.Stats.Speed
					or lookFwd * 0
				-- Ascend / descend with Space / LeftCtrl.
				local upDown = 0
				if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
					upDown = upDown + (cfg.Stats.FlightAscentRate or 28)
				end
				if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
					upDown = upDown - (cfg.Stats.FlightDescentRate or 22)
				end
				-- Ceiling clamp.
				local ceiling = cfg.Stats.FlightCeiling or math.huge
				if primary.Position.Y > ceiling and upDown > 0 then upDown = 0 end

				bv.Velocity = horizontal + Vector3.new(0, upDown, 0)
				if cam then bg.CFrame = cam - cam.Position + primary.Position end
			end)
			table.insert(rider.connections, connHb)
		end
	end
end

----------------------------------------------------------------------
-- Public client API.
----------------------------------------------------------------------
function Module.IsMounted(): boolean
	return Riders[LocalPlayer] ~= nil
end

-- Equip: set the active mount slot. Server hot-swaps visual when riding.
function Module.AttemptEquip(mountId: string)
	MountEvent:FireServer(MountsShared.MountActions.TryEquip, mountId)
end

-- Unequip: clear the active mount slot (auto-dismounts if riding).
function Module.AttemptUnequip()
	MountEvent:FireServer(MountsShared.MountActions.TryUnequip)
end

-- Mount: start riding the equipped mount. No-op if already riding.
function Module.AttemptMount()
	if Module.IsMounted() then return end
	MountEvent:FireServer(MountsShared.MountActions.TryMount)
end

-- Dismount: stop riding (preserves the equipped mount slot).
function Module.AttemptDismount()
	if not Module.IsMounted() then return end
	MountEvent:FireServer(MountsShared.MountActions.TryDismount)
end

-- Convenience for hotbar G key: dismount if riding, else mount.
function Module.AttemptToggleRide()
	if Module.IsMounted() then
		Module.AttemptDismount()
	else
		Module.AttemptMount()
	end
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	MountEvent.OnClientEvent:Connect(function(action, ...)
		if action == MountsShared.MountActions.Spawn then
			local player, mountId = ...
			spawnRider(player, mountId)
		elseif action == MountsShared.MountActions.Despawn then
			local player, reason = ...
			despawnRider(player, reason)
		elseif action == MountsShared.MountActions.Mounted
			or action == MountsShared.MountActions.Unmounted then
			-- Currently no extra client work — model already
			-- spawned/despawned via Spawn/Despawn cues. Reserved for
			-- future per-rider HUD changes (mount HP bar, etc.).
		end
	end)

	-- On respawn / leave, ensure no dangling riders persist.
	LocalPlayer.CharacterRemoving:Connect(function()
		if Riders[LocalPlayer] then despawnRider(LocalPlayer, 'death') end
	end)
	Players.PlayerRemoving:Connect(function(player)
		if Riders[player] then despawnRider(player, 'leave') end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Gameplay/CompanionsClient"><![CDATA[-- Companions client. Renders each player's equipped companion as a
-- hovering wisp / fairy / pet. Pure visual layer — server owns
-- ownership + level + bonuses + movement-mode preference.
--
-- ════════════════════════════════════════════════════════════════════
-- TODO — visual + behavioural extensions to land later. Each is its
-- own concern; pick whichever lands first as art / design lock in.
-- ════════════════════════════════════════════════════════════════════
--
--   1. ANIMATIONS
--      * Per-companion mocap loadouts (Idle / Float / Cheer / Hurt /
--        FollowRun) keyed by humanoid + Animator. Currently only the
--        single 'Idle' / 'Float' track ids exist on the cfg as
--        placeholders.
--      * State machine: Idle ⇄ Following ⇄ AlertedBySomethingNearby.
--        Drives which animation plays and how aggressively the
--        companion bobs / flickers.
--
--   2. EXPRESSIONS
--      * Procedural face-state mapping: Happy / Curious / Worried /
--        Battle. The wisp factory can paint a tiny eye-pair onto the
--        body via SurfaceGuis once art lands.
--      * Reactions to player events: enchant cast, level-up, low HP
--        (pulse + worried face).
--
--   3. INTERACTIONS
--      * Click-to-pet: prompt + small "happiness" buff (BondAura).
--      * Per-companion idle barks via SoundService at long intervals.
--      * Pickup nearby loot / harvested mats and float them to player.
--      * Bond-tied dialogue lines via DialogueWidget when the player
--        ALT-talks at the companion.
--
--   4. STATE TRANSITIONS
--      * Smooth despawn / respawn fades (alpha tween) instead of pop.
--      * Walk → Float swap with a blink VFX so the swap reads as
--        "deliberate" instead of "teleport-jank."
--
--   5. NETWORKING / REPLICATION
--      * Move per-frame model CFrame updates client-side only (current).
--        If observers ever need to see the SAME companion path the
--        rider sees, FireAllClients with a sub-second cadence.
--      * Server-authoritative attack pulses (PodShot already exists).
--
-- ════════════════════════════════════════════════════════════════════

local Players = game:GetService('Players')
local RunService = game:GetService('RunService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local CompanionsShared = ReplicatedModules.Services.CompanionsShared
local CompanionsConfig = ReplicatedModules.Data.Companions
local SoundService = ReplicatedModules.Services.SoundService
local RemoteService = ReplicatedModules.Services.RemoteService
local ReplicatedData = ReplicatedModules.Services.ReplicatedData

local CompanionEvent = RemoteService.GetRemote('CompanionEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Per-player active companion render state.
--
-- mode: live read of the player's MovementMode preference for THIS
--   companion. Updated on Spawn + on MovementChanged cues; keeps the
--   step() loop branch-free.
-- index/total: future-proofing for multi-equip — when one player has
--   N equipped companions, each gets a stable slot index in the
--   semi-circle. Today total is always 1 and index is 1.
-- currentPos: smoothed position used for the walk-mode follow lerp.
--   Float mode writes directly without smoothing.
----------------------------------------------------------------------
type RenderState = {
	companionId: string,
	model: Model?,
	cfg: any,
	t0: number,
	mode: string,         -- 'float' | 'walk'
	index: number,        -- 1..total
	total: number,
	-- Per-slot phase offset on the orbit, in radians. Computed once in
	-- reindexFor (and again whenever the slot count changes); read by
	-- targetForFloat as `cos(offset + t * OrbitSpeed)` / `sin(...)` to
	-- place the companion on its slot of the orbit circle. Stored on
	-- state so step() doesn't recompute slotAngle every frame, and so
	-- `spawn` can use it to position the model on its first frame
	-- (rather than gliding in from the player's origin).
	offset: number,
	currentPos: Vector3?,
	-- Set to true by spawn(); step() consumes it on the next frame to
	-- snap the model directly onto its target instead of lerping in
	-- from origin. See "Init for first position" comment in spawn().
	needsInit: boolean?,
}
-- Nested per-player → per-companionId render states. Multi-equip means
-- a single player can have N concurrent wisps; each gets its own
-- RenderState, indexed by companionId so spawn/despawn can target a
-- specific slot. (index, total) inside each state are recomputed
-- whenever the slot count changes so the orbit/walk arc spreads
-- correctly.
local Active: { [Player]: { [string]: RenderState } } = {}

-- Slot-angle helper hoisted up here so reindexFor can use it. The
-- target-composition functions further down also call it; the hoist
-- preserves a single source of truth.
--
-- Two cases:
--   * OPEN arc (arcAngle < 2π, e.g. walk-mode follow arc behind the
--     player) — use both endpoints. Spread index across [-arc/2, +arc/2]
--     with denominator (total - 1) so index 1 lands at -arc/2 and index
--     N at +arc/2.
--   * CLOSED arc (arcAngle ~= 2π, e.g. float-mode orbit around the
--     player) — exclude the endpoint, since +π and -π are the SAME
--     position on a circle. Use denominator `total` (not total-1) so
--     positions are evenly spaced and don't collide.
local TAU = math.pi * 2
local function slotAngle(index: number, total: number, arcAngle: number): number
	if total <= 1 then return 0 end
	if arcAngle >= TAU - 1e-3 then
		return (index - 1) / total * TAU
	end
	local t = (index - 1) / (total - 1)
	return -arcAngle * 0.5 + arcAngle * t
end

-- Walk every state for a player and renumber (index, total) based on
-- a deterministic alphabetical key order. Called after spawn/despawn
-- so the slot-angle math fans correctly.
local function reindexFor(player: Player)
	local byId = Active[player]; if not byId then return end
	local ids: { string } = {}
	for id in byId do ids[#ids + 1] = id end
	table.sort(ids)
	local total = #ids
	for i, id in ids do
		local s = byId[id]
		if s then
			s.index = i
			s.total = total
			-- Recompute orbit phase whenever the slot count changes.
			-- Float mode uses a closed (full-circle) arc so 3 slots
			-- become {0, 2π/3, 4π/3} — perfectly even spacing. The
			-- offset stays valid until total changes again.
			s.offset = slotAngle(i, total, TAU)
			-- Position-jump on slot reshuffle is jarring in walk mode —
			-- clear the smoothed position so the next step lerps fresh
			-- to the new arc anchor.
			s.currentPos = nil
		end
	end
end

local function getFirstStateFor(player: Player): RenderState?
	local byId = Active[player]; if not byId then return nil end
	for _, s in byId do return s end
	return nil
end

----------------------------------------------------------------------
-- Helpers — template lookup + procedural fallback. Wisps default to
-- procedural; templated companions render their authored model.
----------------------------------------------------------------------
local function templateFor(modelName: string): (Model | BasePart)?
	local assets = ReplicatedStorage:FindFirstChild('AssetsShared')
	local folder = assets and assets:FindFirstChild('Companions')
	local template = folder and folder:FindFirstChild(modelName)
	return template
end

-- Procedural wisp build. Color comes from the companion cfg's
-- ProceduralColor field (the four wisps each set a distinct hue).
-- Two-part rig: outer glow (Neon, low size) + inner core. Looks
-- decent without a single bundled asset.
local function buildProceduralWisp(cfg: any): Model
	local color = (cfg and cfg.ProceduralColor) or Color3.fromRGB(255, 220, 120)
	local model = Instance.new('Model')
	model.Name = 'Companion_' .. (cfg and cfg.Display.Name or 'Wisp')

	local core = Instance.new('Part')
	core.Name = 'Core'
	core.Shape = Enum.PartType.Ball
	core.Size = Vector3.new(0.45, 0.45, 0.45)
	core.Material = Enum.Material.Neon
	core.Color = color
	core.CanCollide = false; core.Anchored = true; core.CastShadow = false
	core.Parent = model
	model.PrimaryPart = core

	local glow = Instance.new('Part')
	glow.Name = 'Glow'
	glow.Shape = Enum.PartType.Ball
	glow.Size = Vector3.new(0.9, 0.9, 0.9)
	glow.Material = Enum.Material.ForceField
	glow.Color = color
	glow.Transparency = 0.55
	glow.CanCollide = false; glow.Anchored = true; glow.CastShadow = false
	glow.CFrame = core.CFrame
	-- Weld so the glow follows the core when we PivotTo the model.
	local weld = Instance.new('Weld')
	weld.Part0 = core; weld.Part1 = glow; weld.C0 = CFrame.new()
	weld.Parent = glow
	glow.Parent = model

	-- Point light inside the core so the wisp casts color on the
	-- world. Range is small to keep it subtle.
	local light = Instance.new('PointLight')
	light.Color = color
	light.Brightness = 1.6
	light.Range = 6
	light.Parent = core

	return model
end

local function fallbackFairy(cfg: any?): Model
	-- Wisps always go procedural; non-wisps get the legacy single-sphere
	-- look (matches the previous fallback shape). The procedural builder
	-- handles both — the difference is just that wisps explicitly carry
	-- ProceduralColor on cfg while older fairy entries don't.
	return buildProceduralWisp(cfg or {})
end

local function playSFX(entry: any?, position: Vector3?)
	if not entry or not entry.Sound then return end
	local pos = position or workspace.CurrentCamera.CFrame.Position
	SoundService.PlaySoundAtPosition(entry.Sound, pos)
end

----------------------------------------------------------------------
-- Spawn / despawn.
----------------------------------------------------------------------
local function despawn(player: Player, companionId: string?)
	local byId = Active[player]
	if not byId then return end
	-- nil id → unequip-all back-compat: tear down every slot. With an
	-- id supplied, only that slot's render state is destroyed and the
	-- remaining slots get re-indexed.
	if companionId == nil then
		for _, state in byId do
			if state.model then state.model:Destroy() end
		end
		Active[player] = nil
		return
	end
	local state = byId[companionId]
	if not state then return end
	if state.model then state.model:Destroy() end
	byId[companionId] = nil
	-- Empty map → drop the player entry so memory tracks the live set.
	if next(byId) == nil then
		Active[player] = nil
	else
		reindexFor(player)
	end
end

-- Resolve the current movement mode for (player, companionId). Reads
-- through the player's replicated PlayerData so the rider's local UI
-- and other clients all see the same mode.
local function resolveMode(player: Player, companionId: string): string
	-- Local player → fast path via ReplicatedData cache.
	if player == LocalPlayer then
		local data = ReplicatedData.GetData('PlayerData', false)
		if data then
			return CompanionsShared.GetMovementMode(data, companionId)
		end
	end
	-- Remote player → use cfg default. The MovementChanged cue
	-- updates the live state so the visual stays in sync without
	-- having to read another player's save.
	local cfg = CompanionsConfig.Companions[companionId]
	return (cfg and cfg.MovementMode) or 'float'
end

local function spawn(player: Player, companionId: string)
	-- Multi-equip aware: replace only the slot for THIS companionId. The
	-- other equipped companions stay live; reindexFor at the bottom
	-- spreads the arc/orbit math across the new slot count.
	despawn(player, companionId)
	local cfg = CompanionsConfig.Companions[companionId]
	if not cfg then return end
	local character = player.Character
	if not character then return end

	local template = templateFor(cfg.Model)
	local model: Model
	if template then
		if template:IsA('Model') then
			local clone = (template :: Model):Clone()
			for _, d in clone:GetDescendants() do
				if d:IsA('BasePart') then
					d.Anchored = true; d.CanCollide = false; d.CastShadow = false
				end
			end
			if not clone.PrimaryPart then
				for _, d in clone:GetDescendants() do
					if d:IsA('BasePart') then clone.PrimaryPart = d; break end
				end
			end
			model = clone
		else
			-- Single-part template — wrap in a Model for stable PivotTo.
			local part = (template :: BasePart):Clone()
			part.Anchored = true; part.CanCollide = false; part.CastShadow = false
			model = Instance.new('Model')
			part.Parent = model
			model.PrimaryPart = part
		end
	else
		model = fallbackFairy(cfg)
	end
	model.Parent = workspace.Terrain

	if not Active[player] then Active[player] = {} end
	Active[player][companionId] = {
		companionId = companionId,
		model = model,
		cfg = cfg,
		t0 = os.clock(),
		mode = resolveMode(player, companionId),
		-- Slot indices are placeholders; reindexFor sets the real
		-- (index, total) below across every active companion. `offset`
		-- defaults to 0 so the first frame (before reindex completes)
		-- still has a well-defined position.
		index = 1, total = 1, offset = 0,
		currentPos = nil,
	}
	reindexFor(player)

	-- "Init for first position" handled by step() on its first tick:
	-- when state.needsInit is true, step writes the target directly
	-- (no walk-mode lerp) so the companion lands ON its orbit slot
	-- rather than gliding in from world origin. Done as a flag
	-- because targetForFloat / targetForWalk are defined later in the
	-- file — calling them here would be a forward reference into a
	-- nil upvalue. Heartbeat fires within one frame of spawn so the
	-- delay is invisible.
	local state = Active[player][companionId]
	if state then state.needsInit = true end

	playSFX(cfg.SFX and cfg.SFX.Spawn, character:GetPivot().Position)
end

----------------------------------------------------------------------
-- Per-frame composition. Two paths share the same target-CFrame compose
-- but pick the target differently:
--
--   FLOAT — orbit + bob in a horizontal circle around the player's
--           head height. Multi-companion fans out via a per-index
--           orbit-phase offset so they don't pile on top of each other.
--
--   WALK  — semi-circle slot behind the player on the ground. Smoothed
--           via per-frame lerp (FollowRate) so the wisp drifts with
--           the rider rather than teleporting.
--
-- (slotAngle + TAU hoisted above reindexFor — see top-of-file
-- definition. Keeping the long header here for context on how the
-- math drives multi-companion arc spreading.)
----------------------------------------------------------------------

local function targetForFloat(player: Player, state: RenderState): Vector3?
	local character = player.Character
	local hrp = character and character:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not hrp then return nil end
	local cfg = state.cfg
	local hover = cfg.Hover
	-- Absolute time (NOT elapsed-since-spawn) so all companions in
	-- the orbit share a synchronized angular position — drift-free
	-- "perfect circle" spread instead of phase-misaligned slots that
	-- happen if each companion's clock starts at its own spawn moment.
	-- `state.offset` was computed in reindexFor (initially in spawn) so
	-- this read is O(1); no slotAngle call per frame.
	local t = os.clock()
	local orbit = state.offset + t * hover.OrbitSpeed
	local bob = math.sin(t * (hover.BobFrequency * 2 * math.pi)) * hover.BobAmplitude
	return hrp.Position + Vector3.new(
		math.cos(orbit) * hover.OrbitRadius,
		hover.Height + bob,
		math.sin(orbit) * hover.OrbitRadius
	)
end

local function targetForWalk(player: Player, state: RenderState): Vector3?
	local character = player.Character
	local hrp = character and character:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not hrp then return nil end
	local walkCfg = state.cfg.Walk
	-- Anchor in player-relative space:
	--   - back along -LookVector by BackDistance
	--   - +/- side along Right by ArcRadius * sin(angle)
	-- Then raycast down to find the ground and apply GroundOffset.
	local lookFlat = Vector3.new(hrp.CFrame.LookVector.X, 0, hrp.CFrame.LookVector.Z)
	if lookFlat.Magnitude < 0.01 then lookFlat = Vector3.zAxis end
	lookFlat = lookFlat.Unit
	local rightFlat = Vector3.new(-lookFlat.Z, 0, lookFlat.X)
	local angle = slotAngle(state.index, state.total, walkCfg.ArcAngle)
	-- Project the slot offset: depth = -cos(angle) * BackDistance (further
	-- back at center, less so at edges); side = sin(angle) * ArcRadius.
	local depth = -math.cos(angle) * walkCfg.BackDistance
	local side  = math.sin(angle) * walkCfg.ArcRadius
	local centerXZ = hrp.Position + lookFlat * depth + rightFlat * side
	-- Ground raycast.
	local rayOrigin = centerXZ + Vector3.new(0, 6, 0)
	local rayDir = Vector3.new(0, -50, 0)
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { character, state.model }
	local hit = workspace:Raycast(rayOrigin, rayDir, rayParams)
	local groundY = hit and hit.Position.Y or hrp.Position.Y - 3
	return Vector3.new(centerXZ.X, groundY + walkCfg.GroundOffset, centerXZ.Z)
end

local function step(dt: number)
	for player, byId in Active do
		for _, state in byId do
			if not state.model or not state.model.PrimaryPart then continue end
			local target: Vector3? = nil
			local lookAt: Vector3? = nil
			if state.mode == 'walk' then
				target = targetForWalk(player, state)
				-- Walking wisp faces the player to read as "tracking"
				-- (Pikmin-style). Float wisp does the same.
				local hrp = player.Character and player.Character:FindFirstChild('HumanoidRootPart') :: BasePart?
				lookAt = hrp and hrp.Position or nil
			else
				target = targetForFloat(player, state)
				local hrp = player.Character and player.Character:FindFirstChild('HumanoidRootPart') :: BasePart?
				lookAt = hrp and hrp.Position or nil
			end
			if not target then continue end

			-- Smoothed follow for walk; immediate write for float (its own
			-- math is already smooth from the bob/orbit sines).
			local pos: Vector3
			if state.needsInit then
				-- First-frame placement: snap to target regardless of
				-- mode so the companion appears on its orbit slot
				-- rather than gliding in from origin.
				pos = target
				state.currentPos = pos
				state.needsInit = nil
			elseif state.mode == 'walk' then
				local prev = state.currentPos or target
				local rate = state.cfg.Walk.FollowRate
				-- Frame-rate-independent lerp.
				local alpha = 1 - math.exp(-rate * dt)
				pos = prev:Lerp(target, alpha)
				state.currentPos = pos
			else
				pos = target
				state.currentPos = pos
			end

			local cf
			if lookAt then
				cf = CFrame.lookAt(pos, lookAt)
			else
				cf = CFrame.new(pos)
			end
			state.model:PivotTo(cf)
		end
	end
end

----------------------------------------------------------------------
-- Level-up flair: re-uses the cinematic label system as a toast.
----------------------------------------------------------------------
local function onLevelUp(companionId: string, newLevel: number)
	local CinematicLabels = SystemsContainer.CinematicLabels
		or (SystemsContainer.ParentSystems and SystemsContainer.ParentSystems.Effects
		    and SystemsContainer.ParentSystems.Effects.CinematicLabels)
	local cfg = CompanionsConfig.Companions[companionId]
	local name = cfg and cfg.Display.Name or companionId
	if CinematicLabels and CinematicLabels.AppendCinematic then
		CinematicLabels.AppendCinematic(
			'COMPANION · LEVEL UP',
			string.format('%s reached level %d', name, newLevel)
		)
	end
	playSFX(cfg and cfg.SFX and cfg.SFX.LevelUp, workspace.CurrentCamera.CFrame.Position)
end

----------------------------------------------------------------------
-- Public client API.
----------------------------------------------------------------------
function Module.AttemptEquip(companionId: string)
	CompanionEvent:FireServer(CompanionsShared.CompanionActions.TryEquip, companionId)
end

function Module.AttemptUnequip(companionId: string?)
	-- Multi-equip aware. With companionId set, server unequips that
	-- specific slot; nil triggers the back-compat "unequip all" path
	-- inside CompanionsServer.AttemptUnequipCompanion.
	CompanionEvent:FireServer(CompanionsShared.CompanionActions.TryUnequip, companionId)
end

function Module.UseCandy(candyItemId: string)
	CompanionEvent:FireServer(CompanionsShared.CompanionActions.UseCandy, candyItemId)
end

-- Toggle float ↔ walk for a companion (server-authoritative; the
-- request is rejected for companions whose cfg.AllowWalkAndFloatBypass
-- != true). UI dropdown calls this.
function Module.SetMovementMode(companionId: string, mode: string)
	if mode ~= 'float' and mode ~= 'walk' then return end
	CompanionEvent:FireServer(CompanionsShared.CompanionActions.SetMovementMode,
		companionId, mode)
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	RunService.Heartbeat:Connect(step)

	CompanionEvent.OnClientEvent:Connect(function(action, ...)
		if action == CompanionsShared.CompanionActions.Spawn then
			local player, companionId = ...
			spawn(player, companionId)
		elseif action == CompanionsShared.CompanionActions.Despawn then
			-- Multi-equip: server broadcasts the companionId being unequipped.
			-- Legacy callers (and the back-compat unequip-all path) send nil
			-- which collapses to "tear down all of this player's wisps".
			local player, companionId = ...
			despawn(player, companionId)
		elseif action == CompanionsShared.CompanionActions.LevelUp then
			local companionId, newLevel = ...
			onLevelUp(companionId, newLevel)
		elseif action == CompanionsShared.CompanionActions.MovementChanged then
			-- Live mode swap. Updates the matching companion slot's mode
			-- field so the next step() picks the right target. No
			-- despawn/respawn — keeps the visual fluid.
			local player, companionId, mode = ...
			local byId = Active[player]
			local state = byId and byId[companionId]
			if state then
				state.mode = mode
				-- Reset the smoothed position so the wisp doesn't dart
				-- from its float target to its walk target via a
				-- straight-line lerp through the player's head.
				state.currentPos = nil
			end
		elseif action == CompanionsShared.CompanionActions.PodShot then
			-- Pod auto-attack VFX: render a thin neon beam from the
			-- shooting companion's model to the target HRP. With multi-
			-- equip there are N companions per player; the server fires
			-- one cue per companion per tick, so we'd ideally key the
			-- shot to the SPECIFIC companion. The cue carries
			-- (player, target, damage) only — pick any active companion
			-- model as the beam origin. Round-robin by choosing the
			-- first state in the player's nested map; multi-shot bursts
			-- in the same tick will visually flicker across slots which
			-- reads correctly as "all my pods are firing".
			local player, target, _damage = ...
			local state = getFirstStateFor(player)
			if not state or not state.model or not state.model.PrimaryPart then return end
			if not target then return end
			local tHrp = (target :: any):FindFirstChild('HumanoidRootPart') :: BasePart?
			if not tHrp then return end
			local from = state.model.PrimaryPart.Position
			local to = tHrp.Position
			local part = Instance.new('Part')
			part.Anchored = true; part.CanCollide = false; part.CanTouch = false
			part.CanQuery = false; part.Massless = true; part.CastShadow = false
			part.Material = Enum.Material.Neon
			part.Color = state.cfg.ProceduralColor or Color3.fromRGB(255, 220, 120)
			part.Transparency = 0.2
			part.Size = Vector3.new(0.18, 0.18, (from - to).Magnitude)
			part.CFrame = CFrame.new((from + to) * 0.5, to)
			part.Parent = workspace.Terrain
			local TweenService = game:GetService('TweenService')
			local Debris = game:GetService('Debris')
			TweenService:Create(part, TweenInfo.new(0.18),
				{ Transparency = 1 }):Play()
			Debris:AddItem(part, 0.22)
		end
	end)

	Players.PlayerRemoving:Connect(function(player) despawn(player) end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Gameplay/AurasClient"><![CDATA[-- Auras client. Renders the equipped aura visual on the appropriate
-- anchor (character HRP / equipped sword / mount model). Per-player so
-- every client sees every player's auras.
--
-- Visual fallback: if AssetsShared.VFX.Auras.<Particle> doesn't exist,
-- spawns a PointLight + a tiny placeholder Attachment with no particles.
-- Real VFX templates drop in later.

local Players = game:GetService('Players')
local RunService = game:GetService('RunService')
local CollectionService = game:GetService('CollectionService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local AurasShared = ReplicatedModules.Services.AurasShared
local AurasConfig = ReplicatedModules.Data.Auras
local SoundService = ReplicatedModules.Services.SoundService
local RemoteService = ReplicatedModules.Services.RemoteService

local AuraEvent = RemoteService.GetRemote('AuraEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Active aura render state. One Render per (player, auraId). Each
-- render fans out into N attachments — one per anchor part:
--   * 'character' → every body part of the rig (head, torso, limbs)
--   * 'sword'     → every equipped weapon Tool's Handle
--   * 'mount'     → the active mount's primary part (single)
-- A single aura therefore owns N attachments, N×particles, and (when
-- spec'd) N×beams + N×lights. The Runtime hook (Setup/Step/Cleanup)
-- runs ONCE per render with the full attachment list — authors that
-- want per-part behavior iterate the list themselves.
----------------------------------------------------------------------
type Render = {
	auraId: string,
	anchor: string,
	-- One Attachment per resolved anchor part, in matching order.
	attachments: { Attachment },
	-- End-attachments parallel `attachments` for beam visuals.
	endAttachments: { Attachment },
	lights: { PointLight },
	particles: { ParticleEmitter },
	beams: { Beam },
	loopSound: Sound?,
	-- Runtime state returned by the optional Setup hook.
	runtimeState: any?,
	-- Heartbeat connection driving the optional Step hook.
	stepConn: RBXScriptConnection?,
	-- Cleanup callback (typed copy from cfg.Runtime so despawn doesn't
	-- need to re-look up the cfg if the aura was revoked mid-spawn).
	cleanup: ((state: any) -> ())?,
}
local Active: { [Player]: { [string]: Render } } = {}

-- Default texture for procedurally-built particles. Roblox's built-in
-- sparkles asset reads as a generic glow without bundling extra art.
local DEFAULT_PARTICLE_TEXTURE = 'rbxasset://textures/particles/sparkles_main.dds'
-- Default beam texture — neutral white-edged streak. Same goal as
-- the particle default: visible without dependencies.
local DEFAULT_BEAM_TEXTURE = 'rbxasset://textures/particles/sparkles_main.dds'

----------------------------------------------------------------------
-- Anchor resolution. Returns a LIST of BaseParts so a single aura can
-- visually span multiple targets:
--   * 'character' → every BasePart in the rig (head, torso, limbs).
--                   Particles emit from each, so a character glow now
--                   wreathes the WHOLE rig instead of just HRP.
--   * 'sword'     → every equipped weapon's Handle (both hands when
--                   dual-wielding).
--   * 'mount'     → the active mount's primary part (still one).
-- An empty list means the anchor isn't available yet (no character,
-- nothing equipped, not riding); the step() retry loop re-spawns the
-- aura when parts become available.
----------------------------------------------------------------------
local function findAnchorParts(player: Player, anchor: string): { BasePart }
	local character = player.Character
	if not character then return {} end
	local out: { BasePart } = {}

	if anchor == 'character' then
		-- Whole rig — every BasePart descendant of the character. Skips
		-- any tool Handles (those belong to the 'sword' anchor) so a
		-- character aura doesn't double-stack on equipped weapons.
		for _, descendant in character:GetDescendants() do
			if descendant:IsA('BasePart') and not descendant:FindFirstAncestorOfClass('Tool') then
				out[#out + 1] = descendant :: BasePart
			end
		end
		return out

	elseif anchor == 'sword' then
		-- Bladeborne weapons aren't Tools — they're Models cloned by
		-- EquipmentRendererClient and parented under the character.
		-- Each equipped weapon model is tagged 'EquippedWeapon' on
		-- spawn (see EquipmentRendererClient.EquipFunctions.Weapon),
		-- so iterating the tag set + filtering to descendants of THIS
		-- character finds every actively-held weapon (1-handed, dual,
		-- or whatever the future expands to). Returns the model's
		-- PrimaryPart — that's the BasePart particles/beams attach to.
		for _, weaponModel in CollectionService:GetTagged('EquippedWeapon') do
			if not weaponModel:IsA('Model') then continue end
			if not weaponModel:IsDescendantOf(character) then continue end
			local primary = weaponModel.PrimaryPart
			if primary and primary:IsA('BasePart') then
				out[#out + 1] = primary :: BasePart
			end
		end
		-- Legacy fallback (Tool-based weapons + name-keyed parts) for
		-- code that hasn't migrated to the tag yet.
		if #out == 0 then
			for _, child in character:GetChildren() do
				if child:IsA('Tool') then
					local handle = child:FindFirstChild('Handle')
					if handle and handle:IsA('BasePart') then
						out[#out + 1] = handle :: BasePart
					end
				end
			end
		end
		if #out == 0 then
			local fallback = character:FindFirstChild('Blade', true)
				or character:FindFirstChild('WeaponHandle', true)
			if fallback and fallback:IsA('BasePart') then
				out[#out + 1] = fallback :: BasePart
			end
		end
		return out

	elseif anchor == 'mount' then
		-- The MountsClient welds the mount primary to the rider's HRP
		-- but parents the Weld under the MOUNT, not the HRP.
		-- BasePart:GetJoints() walks every joint involving this part
		-- regardless of where the joint instance is parented; that's
		-- what finds the mount.
		local hrp = character:FindFirstChild('HumanoidRootPart') :: BasePart?
		if not hrp then return {} end
		for _, joint in hrp:GetJoints() do
			if joint:IsA('Weld') then
				local other = (joint.Part0 == hrp) and joint.Part1 or joint.Part0
				if other and other:IsA('BasePart') and other:IsDescendantOf(workspace) then
					out[#out + 1] = other :: BasePart
					break  -- single primary
				end
			end
		end
		return out
	end
	return out
end

----------------------------------------------------------------------
-- Spawn / despawn.
----------------------------------------------------------------------
local function despawn(player: Player, auraId: string)
	local byId = Active[player]; if not byId then return end
	local r = byId[auraId]; if not r then return end
	-- Step connection first so the runtime stops touching state we're
	-- about to destroy.
	if r.stepConn then r.stepConn:Disconnect() end
	-- Cleanup hook before tearing down attachments — the runtime might
	-- still be reading them, and Roblox would error on dead refs.
	if r.cleanup and r.runtimeState ~= nil then
		local ok, err = pcall(r.cleanup, r.runtimeState)
		if not ok then warn('AurasClient: aura cleanup errored: ', err) end
	end
	if r.loopSound then r.loopSound:Stop(); r.loopSound:Destroy() end
	-- Beams can live across two attachments — destroy explicitly so
	-- one attachment outliving the other for a frame doesn't leak.
	for _, beam in r.beams do if beam.Parent then beam:Destroy() end end
	for _, endAttach in r.endAttachments do
		if endAttach.Parent then endAttach:Destroy() end
	end
	for _, attach in r.attachments do
		if attach.Parent then attach:Destroy() end
	end
	byId[auraId] = nil
end

----------------------------------------------------------------------
-- Procedural builders. Translate the Procedural{Particle,Beam,Light}
-- table into Roblox instances. Authors can ship visuals without
-- dropping any AssetsShared.VFX.Auras templates; the procedural
-- layer always renders, and a template (when present) layers on top.
----------------------------------------------------------------------
local function buildProceduralParticle(spec: any, parent: Attachment): ParticleEmitter
	local pe = Instance.new('ParticleEmitter')
	pe.Texture = spec.Texture or DEFAULT_PARTICLE_TEXTURE
	-- Sensible defaults; spec values override when present.
	pe.Color = spec.Color or ColorSequence.new(Color3.new(1, 1, 1))
	pe.Size  = spec.Size  or NumberSequence.new(0.4, 0.05)
	pe.Transparency = spec.Transparency or NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	pe.Rate = spec.Rate or 12
	pe.Lifetime = spec.Lifetime or NumberRange.new(0.7, 1.0)
	pe.Speed = spec.Speed or NumberRange.new(1, 2)
	pe.SpreadAngle = spec.SpreadAngle or Vector2.new(180, 180)
	pe.Acceleration = spec.Acceleration or Vector3.new(0, 1, 0)
	pe.Drag = spec.Drag or 0
	pe.LightEmission = spec.LightEmission or 0.5
	pe.LightInfluence = 0
	pe.Parent = parent
	return pe
end

local function buildProceduralBeam(spec: any, attach0: Attachment, parent: BasePart): (Beam, Attachment)
	-- Beam needs two attachments; the second is offset by EndOffset
	-- from the first (in the parent BasePart's local space).
	local endAttach = Instance.new('Attachment')
	endAttach.Name = 'AuraBeamEnd'
	endAttach.CFrame = attach0.CFrame + (spec.EndOffset or Vector3.new(0, 4, 0))
	endAttach.Parent = parent

	local beam = Instance.new('Beam')
	beam.Attachment0 = attach0
	beam.Attachment1 = endAttach
	beam.Color = spec.Color or ColorSequence.new(Color3.new(1, 1, 1))
	beam.Width0 = spec.Width0 or 0.4
	beam.Width1 = spec.Width1 or 0.05
	beam.Transparency = spec.Transparency or NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 0.7),
	})
	beam.Texture = spec.Texture or DEFAULT_BEAM_TEXTURE
	beam.TextureLength = spec.TextureLength or 1.0
	beam.TextureSpeed = spec.TextureSpeed or 1.0
	beam.FaceCamera = spec.FaceCamera == true
	beam.LightEmission = 0.5
	beam.LightInfluence = 0
	beam.Parent = attach0
	return beam, endAttach
end

local function spawn(player: Player, auraId: string)
	despawn(player, auraId)
	local cfg = AurasConfig.Auras[auraId]
	if not cfg then return end
	local anchor = cfg.Anchor

	Active[player] = Active[player] or {}
	local r: Render = {
		auraId = auraId, anchor = anchor,
		attachments = {}, endAttachments = {}, lights = {}, particles = {}, beams = {},
	}
	Active[player][auraId] = r

	-- Resolve the anchor parts. Empty list = anchor not yet available
	-- (no character / no equipped weapon / not riding); the step() loop
	-- retries every Heartbeat until parts appear.
	local parts = findAnchorParts(player, anchor)
	if #parts == 0 then return end

	-- Asset template lookup. Same template applied per-part so a
	-- character aura with a `TemplateName` clones once per body part.
	local templateName = (cfg.Procedural and cfg.Procedural.TemplateName)
		or (cfg.VFX and cfg.VFX.Particle)
	local templateRoot = ReplicatedStorage:FindFirstChild('AssetsShared')
	templateRoot = templateRoot and templateRoot:FindFirstChild('VFX')
	templateRoot = templateRoot and templateRoot:FindFirstChild('Auras')
	local template = templateName and templateRoot and templateRoot:FindFirstChild(templateName)

	for _, part in parts do
		local attach = Instance.new('Attachment')
		-- Encode aura id + part name so the explorer reads cleanly:
		--   AuraAttach_character_glow_amber_RightUpperArm
		attach.Name = 'AuraAttach_' .. auraId .. '_' .. part.Name
		attach.Parent = part
		table.insert(r.attachments, attach)

		-- Per-part: clone the asset template (if any).
		local perPartEndAttach: Attachment? = nil
		if template then
			for _, child in template:GetDescendants() do
				if child:IsA('ParticleEmitter') then
					local pe = child:Clone()
					pe.Parent = attach
					table.insert(r.particles, pe)
				elseif child:IsA('Beam') then
					local beam = child:Clone()
					beam.Attachment0 = attach
					if not beam.Attachment1 then
						local endAttach = Instance.new('Attachment')
						endAttach.Name = 'AuraTemplateBeamEnd_' .. part.Name
						endAttach.CFrame = CFrame.new(0, 4, 0)
						endAttach.Parent = part
						beam.Attachment1 = endAttach
						perPartEndAttach = endAttach
					end
					beam.Parent = attach
					table.insert(r.beams, beam)
				end
			end
		end

		-- Per-part: procedural layer. ALWAYS runs — the procedural
		-- definition is the "art-missing" fallback that authors lean on.
		if cfg.Procedural and cfg.Procedural.Particle then
			local pe = buildProceduralParticle(cfg.Procedural.Particle, attach)
			table.insert(r.particles, pe)
		end
		if cfg.Procedural and cfg.Procedural.Beam and not perPartEndAttach then
			local beam, endAttach = buildProceduralBeam(cfg.Procedural.Beam, attach, part)
			perPartEndAttach = endAttach
			table.insert(r.beams, beam)
		end
		if perPartEndAttach then
			table.insert(r.endAttachments, perPartEndAttach)
		end

		local lightSpec = (cfg.Procedural and cfg.Procedural.Light) or (cfg.VFX and cfg.VFX.Light)
		if lightSpec then
			local light = Instance.new('PointLight')
			light.Color = lightSpec.Color or Color3.fromRGB(255, 220, 120)
			light.Brightness = lightSpec.Brightness or 1
			light.Range = lightSpec.Range or 6
			light.Parent = attach
			table.insert(r.lights, light)
		end
	end

	-- Looping SFX — single instance on the first attachment (the
	-- expected use is "ambient hum follows the player"; one source is
	-- plenty even with multi-anchor renders).
	local primaryAttach = r.attachments[1]
	if primaryAttach and cfg.SFX and cfg.SFX.Loop and cfg.SFX.Loop.Sound then
		local sound = Instance.new('Sound')
		sound.SoundId = cfg.SFX.Loop.Sound
		sound.Volume = cfg.SFX.Loop.Volume or 0.3
		sound.Looped = true
		sound.Parent = primaryAttach
		sound:Play()
		r.loopSound = sound
	end
	if cfg.SFX and cfg.SFX.Equip and cfg.SFX.Equip.Sound then
		SoundService.PlaySoundAtPosition(cfg.SFX.Equip.Sound, parts[1].Position)
	end

	-- Runtime hook (Setup → state, Step → tick, Cleanup → teardown).
	-- Setup gets the live attachment list so it can append per-part
	-- visuals or reposition things mid-flight. Step runs on Heartbeat
	-- if defined; Cleanup runs on despawn.
	local rt = cfg.Runtime
	if rt and rt.Setup then
		local ctx: AurasConfig.AuraRuntimeContext = {
			Player = player,
			AnchorParts = parts,
			Attachments = r.attachments,
		}
		local ok, state = pcall(rt.Setup, ctx)
		if ok then
			r.runtimeState = state
			r.cleanup = rt.Cleanup
			if rt.Step then
				r.stepConn = RunService.Heartbeat:Connect(function(dt)
					if not r.runtimeState then return end
					local stepOk, stepErr = pcall(rt.Step, r.runtimeState, dt)
					if not stepOk then
						warn('AurasClient: aura Step errored, disconnecting: ', stepErr)
						if r.stepConn then r.stepConn:Disconnect(); r.stepConn = nil end
					end
				end)
			end
		else
			warn('AurasClient: aura Setup errored: ', state)
		end
	end
end

----------------------------------------------------------------------
-- Re-attach loop. Anchors aren't always available at Spawn time
-- (mount might still be spawning, weapon might be sheathed); the loop
-- looks for unattached aura entries every tick and attaches them.
----------------------------------------------------------------------
local function step(_dt: number)
	for player, byId in Active do
		for auraId, r in byId do
			-- Re-spawn when no attachments are live OR the first
			-- attachment's parent is gone (character respawn /
			-- equipped weapon unequipped / mount despawned).
			local needsRespawn = (#r.attachments == 0)
				or (r.attachments[1] and not r.attachments[1].Parent)
			if not needsRespawn then
				-- Anchor part-list shape change: e.g. the player just
				-- equipped a second weapon, or the mount swapped to a
				-- new model. Cheap re-resolve + count comparison —
				-- O(parts_per_anchor) per render, per frame.
				local parts = findAnchorParts(player, r.anchor)
				if #parts ~= #r.attachments then needsRespawn = true end
			end
			if needsRespawn then
				spawn(player, auraId)
			end
		end
	end
end

----------------------------------------------------------------------
-- Slot state. Updated by SlotsChanged cue from the server. Other UI
-- widgets read these via Module.GetSlotState() — currently unused
-- by AurasClient itself, but exposed so a future AurasTab can
-- render `currentEquipped / maxSlots` without re-deriving.
----------------------------------------------------------------------
local SlotCurrent = 0
local SlotMax     = 1

function Module.GetSlotState(): (number, number)
	return SlotCurrent, SlotMax
end

----------------------------------------------------------------------
-- Public client API.
----------------------------------------------------------------------
function Module.AttemptEquip(auraId: string)
	AuraEvent:FireServer(AurasShared.AuraActions.TryEquip, auraId)
end

function Module.AttemptUnequip(auraId: string)
	-- Signature change: was anchor-keyed (TryUnequip 'character').
	-- The new server expects an aura id — UI passes the equipped id
	-- it wants to remove. Anchor-only unequip is no longer meaningful
	-- because multi-equip stacks several auras on the same anchor.
	AuraEvent:FireServer(AurasShared.AuraActions.TryUnequip, auraId)
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	RunService.Heartbeat:Connect(step)

	AuraEvent.OnClientEvent:Connect(function(action, ...)
		if action == AurasShared.AuraActions.Spawn then
			local player, auraId = ...
			spawn(player, auraId)
		elseif action == AurasShared.AuraActions.Despawn then
			local player, auraId = ...
			despawn(player, auraId)
		elseif action == AurasShared.AuraActions.SlotsChanged then
			local current, max = ...
			SlotCurrent = current or 0
			SlotMax     = max or 1
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		local byId = Active[player]
		if byId then
			for auraId in byId do despawn(player, auraId) end
		end
		Active[player] = nil
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Gameplay/SkillsClient"><![CDATA[-- Skills client. Owns:
--   * Input bindings (Z/X/C → first three unlocked skills, in unlock order)
--   * Predict-then-fire CanUseSkill check before sending the remote
--   * Animation playback + VFX/SFX cues for the local rider
--   * Hit-impact VFX cues for ALL clients (FireAllClients pulse)
--
-- Server is authoritative on damage; this module only renders.

local Players = game:GetService('Players')
local ContextActionService = game:GetService('ContextActionService')
local Debris = game:GetService('Debris')
local TweenService = game:GetService('TweenService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local SkillsShared = ReplicatedModules.Services.SkillsShared
local SkillsConfig = ReplicatedModules.Data.Skills
local SoundService = ReplicatedModules.Services.SoundService
local RemoteService = ReplicatedModules.Services.RemoteService
local ReplicatedData = ReplicatedModules.Services.ReplicatedData

local SkillEvent = RemoteService.GetRemote('SkillEvent', 'RemoteEvent', false)

-- Combat profiling instrumentation. Pairs `debug.profilebegin`/
-- `profileend` with an outer-side `os.clock()` benchmark print so
-- elapsed timing matches the MicroProfiler scope. _profileCall
-- handles early returns by routing through a closure.
local function _profileCall(label: string, fn: () -> ...any): ...any
	local t0 = os.clock()
	debug.profilebegin(label)
	local results = table.pack(fn())
	-- Defensive: if `fn` yielded (task.wait, etc.), the engine has already
	-- popped our profile scope, so calling profileend would error with
	-- "No active profile annotation". pcall swallows that — the os.clock
	-- benchmark below survives yields and is the canonical timing here.
	pcall(debug.profileend)
	print(string.format('[Profile][%s] %.3fms', label, (os.clock() - t0) * 1000))
	return table.unpack(results, 1, results.n)
end

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Active anim tracks per cast, keyed by character (Model). Player
-- characters AND NPC characters route through the same map — the
-- renderer doesn't care which kind of caster it is, just that there
-- is a character with a Humanoid + HRP to attach the cast to.
----------------------------------------------------------------------
local ActiveTracks: { [Model]: AnimationTrack? } = {}

local function loadAnimation(humanoid: Humanoid, assetId: string?): AnimationTrack?
	if not humanoid or typeof(assetId) ~= 'string' or assetId == '' or assetId == 'rbxassetid://0' then
		return nil
	end
	local animator = humanoid:FindFirstChildOfClass('Animator')
		or humanoid:WaitForChild('Animator', 1)
	if not animator then return nil end
	local anim = Instance.new('Animation')
	anim.AnimationId = assetId
	local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
	anim:Destroy()
	return ok and track or nil
end

local function playSFX(entry: any?, position: Vector3?)
	if not entry or not entry.Sound then return end
	local pos = position or workspace.CurrentCamera.CFrame.Position
	SoundService.PlaySoundAtPosition(entry.Sound, pos)
end

----------------------------------------------------------------------
-- Render: cast begin. Plays the cast animation + a placeholder slash
-- arc trail (a thin Neon ring that fades out), and the cast SFX.
-- Caster is a Model (player character or NPC character) — the cue
-- carries the character directly so the renderer is caster-agnostic.
----------------------------------------------------------------------
local function renderCastBegin(character: Model, skillId: string, totalDuration: number)
	return _profileCall('SkillsClient.renderCastBegin', function()
	local cfg = SkillsConfig.Skills[skillId]
	if not cfg then return end
	if not character or not character.Parent then return end
	local humanoid = character:FindFirstChildOfClass('Humanoid')
	local hrp = character:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not humanoid or not hrp then return end

	-- Animation.
	local track = loadAnimation(humanoid, cfg.Animations and cfg.Animations.Cast)
	if track then
		track:Play(0.05, 1, 1)
		ActiveTracks[character] = track
		task.delay(totalDuration + 0.1, function()
			if ActiveTracks[character] == track then
				track:Stop(0.1); ActiveTracks[character] = nil
			end
		end)
	else
		print(string.format('[SkillsClient] (stub anim) %s casting %s for %.2fs',
			character.Name, skillId, totalDuration))
	end

	-- Cast SFX.
	playSFX(cfg.SFX and cfg.SFX.Cast, hrp.Position)

	-- Placeholder slash arc — a thin Neon disc in front of the character
	-- that fades out over the active window. Real VFX templates drop in
	-- via cfg.VFX.Slash later (look up under AssetsShared.VFX.Skills).
	local arc = Instance.new('Part')
	arc.Name = 'SkillArcStub'
	arc.Anchored = true
	arc.CanCollide = false
	arc.CanTouch = false
	arc.CastShadow = false
	arc.Shape = Enum.PartType.Cylinder
	arc.Material = Enum.Material.Neon
	arc.Color = Color3.fromRGB(255, 240, 200)
	arc.Size = Vector3.new(0.2, cfg.Hitbox.Size.X, cfg.Hitbox.Size.Z)
	arc.CFrame = hrp.CFrame
		* CFrame.new(0, 0, -cfg.Hitbox.ForwardOffset)
		* CFrame.Angles(0, 0, math.rad(90))
	arc.Transparency = 0.4
	arc.Parent = workspace.Terrain

	TweenService:Create(arc,
		TweenInfo.new(cfg.ActiveTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Transparency = 1, Size = arc.Size + Vector3.new(0, 2, 2) }
	):Play()
	Debris:AddItem(arc, cfg.ActiveTime + 0.2)
	end)
end

local function renderCastHit(_character: Model, skillId: string, _hitIndex: number, hitPositions: { Vector3 })
	return _profileCall('SkillsClient.renderCastHit', function()
	local cfg = SkillsConfig.Skills[skillId]
	if not cfg then return end
	-- One impact flash per hit position. Tiny spherical glow.
	for _, pos in hitPositions do
		local impact = Instance.new('Part')
		impact.Anchored = true; impact.CanCollide = false; impact.CanTouch = false
		impact.CastShadow = false; impact.Shape = Enum.PartType.Ball
		impact.Material = Enum.Material.Neon
		impact.Color = Color3.fromRGB(255, 220, 130)
		impact.Size = Vector3.new(0.5, 0.5, 0.5)
		impact.Position = pos
		impact.Transparency = 0.2
		impact.Parent = workspace.Terrain
		TweenService:Create(impact,
			TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Transparency = 1, Size = Vector3.new(2.5, 2.5, 2.5) }
		):Play()
		Debris:AddItem(impact, 0.4)
	end
	playSFX(cfg.SFX and cfg.SFX.Hit, hitPositions[1])
	end)
end

local function renderCastEnd(character: Model, _skillId: string)
	return _profileCall('SkillsClient.renderCastEnd', function()
		local track = ActiveTracks[character]
		if track then track:Stop(0.15); ActiveTracks[character] = nil end
	end)
end

----------------------------------------------------------------------
-- Resolve the local player's first three unlocked skills for Z/X/C.
-- Order is the SkillsConfig order (great_slash → double_cross_slash →
-- quad_cross_slash) so the binding feels stable as the player progresses.
----------------------------------------------------------------------
local function getBoundSkillIds(): { string }
	local data = ReplicatedData.GetData('PlayerData', false)
	local out = {}
	-- Walk in canonical order so Z is always the most-basic unlocked
	-- skill, X the second, C the third.
	local order = { 'great_slash', 'double_cross_slash', 'quad_cross_slash' }
	for _, id in order do
		if SkillsShared.IsSkillUnlocked(data, id) then
			table.insert(out, id)
			if #out >= 3 then break end
		end
	end
	return out
end

----------------------------------------------------------------------
-- Public API used by the hotbar / skill tree.
----------------------------------------------------------------------
function Module.AttemptUseSkill(skillId: string)
	_profileCall('SkillsClient.AttemptUseSkill', function()
		local character = LocalPlayer.Character
		if not character then return end
		local data = ReplicatedData.GetData('PlayerData', false)
		local ok, reason = SkillsShared.CanUseSkill(character, data, skillId)
		if not ok then
			print('[SkillsClient] Cannot use:', skillId, '-', reason)
			return
		end
		local _t_send = os.clock()
		debug.profilebegin('SkillsClient.AttemptUseSkill.FireServer')
		SkillEvent:FireServer(SkillsShared.SkillActions.TryUseSkill, skillId)
		debug.profileend()
		print(string.format('[Profile][%s] %.3fms', 'SkillsClient.AttemptUseSkill.FireServer', (os.clock() - _t_send) * 1000))
	end)
end

function Module.GetBoundSkills(): { string }
	return getBoundSkillIds()
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	-- Bind Z/X/C to slot 1/2/3 of the player's unlocked-skills list.
	-- Slot lookup is dynamic so unlocking a new skill from the tree
	-- updates the bindings on next press without re-binding.
	local function handleSkillSlot(slotIndex: number)
		return function(_actionName, state, _input)
			if state ~= Enum.UserInputState.Begin then
				return Enum.ContextActionResult.Pass
			end
			local skills = getBoundSkillIds()
			local id = skills[slotIndex]
			if id then Module.AttemptUseSkill(id) end
			return Enum.ContextActionResult.Sink
		end
	end
	ContextActionService:BindAction('SkillsClient_Slot1', handleSkillSlot(1), false, Enum.KeyCode.Z)
	ContextActionService:BindAction('SkillsClient_Slot2', handleSkillSlot(2), false, Enum.KeyCode.X)
	ContextActionService:BindAction('SkillsClient_Slot3', handleSkillSlot(3), false, Enum.KeyCode.C)

	SkillEvent.OnClientEvent:Connect(function(action, ...)
		local _t_evt = os.clock()
		debug.profilebegin('SkillsClient.OnClientEvent')
		if action == SkillsShared.SkillActions.CastBegin then
			renderCastBegin(...)
		elseif action == SkillsShared.SkillActions.CastHit then
			renderCastHit(...)
		elseif action == SkillsShared.SkillActions.CastEnd then
			renderCastEnd(...)
		end
		debug.profileend()
		print(string.format('[Profile][%s] %.3fms', 'SkillsClient.OnClientEvent', (os.clock() - _t_evt) * 1000))
	end)

	-- Reap stale entries when characters get destroyed (player respawn,
	-- NPC death). The track itself disconnects when its parent goes
	-- away, but the table key would otherwise leak.
	Players.PlayerRemoving:Connect(function(player)
		local char = player.Character
		if char then ActiveTracks[char] = nil end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Gameplay/TargetLockClient"><![CDATA[-- Target lock client. Hover an enemy + press R → set lock; R again
-- to clear. While locked, a small circle BillboardGui floats above
-- the target so the player can see who they're locked onto.
--
-- Server integration is deliberately deferred — this module exposes
-- `Module.GetLockedTarget()` so combat / dodge / camera systems can
-- query the locked target later, but doesn't yet drive any of them
-- on its own. The visible indicator + Get accessor is the v1 surface.

local Players = game:GetService('Players')
local UserInputService = game:GetService('UserInputService')
local CollectionService = game:GetService('CollectionService')
local RunService = game:GetService('RunService')

local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CombatShared = ReplicatedModules.Services.CombatShared

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE = HUDCommon.PALETTE

local SystemsContainer = {}

local Module = {}

-- Currently-locked target (Model) or nil. Mutated by Toggle / clear.
local LockedTarget: Model? = nil
-- Cached AutoRotate state from BEFORE the lock engaged so we can
-- restore on clear. Roblox flips AutoRotate to true on respawn, so
-- this is read fresh per lock — never stale across deaths.
local PriorAutoRotate: boolean? = nil

-- Resolve CameraModeClient lazily so it can be loaded by the same
-- framework pass without requiring strict load order. SystemsContainer
-- is filled in via Module.Init.
local function getCameraModeClient()
	return SystemsContainer.CameraModeClient
		or (SystemsContainer.ParentSystems
			and SystemsContainer.ParentSystems.Gameplay
			and SystemsContainer.ParentSystems.Gameplay.CameraModeClient)
end
-- BillboardGui rendering the circle indicator. Re-parented to the
-- target when LockedTarget changes; destroyed on clear.
local LockGui: BillboardGui? = nil
-- Connections that auto-clear the lock when the target dies, leaves
-- workspace, or is destroyed. Walked + disconnected in clearLock so
-- a swap-lock (R on a different mob without first unlocking) doesn't
-- leak the previous target's listeners.
local TargetWatchConns: { RBXScriptConnection } = {}
local function disconnectTargetWatch()
	for _, conn in TargetWatchConns do
		conn:Disconnect()
	end
	table.clear(TargetWatchConns)
end

local LOCK_RAYCAST_MAX_DISTANCE = 120  -- studs from camera to target
-- Spherecast radius for the cursor pick. The previous raycast required
-- the cursor to land on a pixel of the enemy's mesh — even small enemies
-- or fast-moving targets would slip through. A 4-stud sphere catches
-- "I'm aiming roughly at them" without needing a pixel-perfect hover.
local LOCK_SHAPECAST_RADIUS = 4
-- Screen-space fallback radius (pixels). When the spherecast misses
-- entirely (target outside the swept volume but still on screen near
-- the crosshair), we project every AICharacter HRP to viewport space
-- and pick the candidate closest to the cursor within this radius.
-- 220 px is generous — about 12% of a 1920-wide viewport.
local LOCK_SCREEN_FALLBACK_RADIUS = 220

----------------------------------------------------------------------
-- Camera lock-on tunables. The camera holds a fixed offset behind
-- the player while continuously orienting toward the midpoint of the
-- (player → target) segment with a downward bias. Lerp keeps the
-- transition smooth; the player can briefly fight it via mouse but
-- cant fully escape until they unlock — Nier / Sekiro hard-lock feel.
----------------------------------------------------------------------
local CAMERA_DISTANCE     = 14      -- studs behind the player
local CAMERA_HEIGHT       = 5       -- studs above the player's HRP
local CAMERA_PITCH_DEG    = -8      -- looking down toward midpoint
local CAMERA_LERP_RATE    = 14      -- per-second smoothing rate (higher = snappier)
local CAMERA_TARGET_BIAS  = 0.5     -- 0=look at player, 1=look at target

-- RenderStepped connection driving the lock camera. Active only while
-- a target is locked; disconnected on clear so the default camera
-- regains control.
local CameraConn: RBXScriptConnection? = nil
-- The CameraType we replace on lock so we can restore on unlock.
-- Roblox's default is `Custom` — record per-lock in case the player
-- has changed it via a setting we don't own.
local PriorCameraType: Enum.CameraType? = nil
-- Render priority slot. Bind one above Camera so our override runs
-- AFTER the default camera writes its CFrame, ensuring our value is
-- the final word on the frame.
local CAMERA_RENDER_PRIORITY = Enum.RenderPriority.Camera.Value + 1
local CAMERA_RENDER_NAME = 'TargetLockCamera'

-- Build the BillboardGui indicator once. Returned object is parented
-- to the target HRP whenever a lock is set; reused so we don't spam-
-- create instances.
local function ensureLockGui(): BillboardGui
	if LockGui and LockGui.Parent then return LockGui end
	if LockGui then LockGui:Destroy() end
	local gui = Instance.new('BillboardGui')
	gui.Name = 'TargetLockIndicator'
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Size = UDim2.fromScale(2, 2)  -- 2x2 studs
	gui.MaxDistance = LOCK_RAYCAST_MAX_DISTANCE
	gui.StudsOffset = Vector3.new(0, 3, 0)  -- float above the head

	-- Outer ring: a circular Frame via UICorner(1, 0). Stroke gives the
	-- glowing edge; transparent fill so the player sees through to the
	-- target. ZIndex bumped so it paints over health bars below.
	local ring = Instance.new('Frame')
	ring.Name = 'Ring'
	ring.Size = UDim2.fromScale(1, 1)
	ring.BackgroundColor3 = PALETTE.accent
	ring.BackgroundTransparency = 0.85
	ring.BorderSizePixel = 0
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.Position = UDim2.fromScale(0.5, 0.5)
	ring.Parent = gui

	local corner = Instance.new('UICorner')
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = ring

	local stroke = Instance.new('UIStroke')
	stroke.Color = PALETTE.accent
	stroke.Thickness = 2
	stroke.Transparency = 0.1
	stroke.Parent = ring

	-- Crosshair dot in the center.
	local dot = Instance.new('Frame')
	dot.Size = UDim2.fromScale(0.18, 0.18)
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.fromScale(0.5, 0.5)
	dot.BackgroundColor3 = PALETTE.accent
	dot.BorderSizePixel = 0
	local dotCorner = Instance.new('UICorner')
	dotCorner.CornerRadius = UDim.new(1, 0)
	dotCorner.Parent = dot
	dot.Parent = ring

	LockGui = gui
	return gui
end

-- Is `model` a lock-eligible mob? Mobs only — PvP lock-on is
-- intentionally excluded. Centralized so every target-resolution
-- path (shapecast, ancestor walk, screen-space fallback) shares
-- the same eligibility contract.
--
-- The descendant-of-workspace check rejects targets that are still
-- referenced but parented to nil / a streaming-out folder; pairs
-- with the AncestryChanged auto-unlock in setLock so a despawn
-- mid-lock both stops the lock AND prevents re-acquisition during
-- the same toggle press.
local function isEligibleLockTarget(model: Model): boolean
	if not model or not model.Parent then return false end
	if not model:IsDescendantOf(workspace) then return false end
	if LocalPlayer.Character and model == LocalPlayer.Character then return false end
	return CollectionService:HasTag(model, 'AICharacter')
end

-- Resolve the lock-eligible Model that owns `hit` (an arbitrary part
-- the shapecast struck). Walks ancestors until it finds an eligible
-- Model or runs out of parents. The local player's character is
-- excluded by the cast filter so it never reaches this resolver.
local function resolveLockTargetFromHit(hit: Instance?): Model?
	local inst: Instance? = hit
	while inst and inst ~= workspace do
		if inst:IsA('Model') and isEligibleLockTarget(inst) then
			return inst
		end
		inst = inst.Parent
	end
	return nil
end

-- Read the player's current cursor target. Iteratively re-casts past
-- "skip" parts (named Hitbox or tagged Hitbox) so the lock-on doesn't
-- snap onto invisible combat hitboxes that float around or overlap
-- characters. Each iteration appends the hit part to the exclude list
-- and re-casts; bails after MAX_RECAST_DEPTH to avoid runaway loops.
local MAX_RECAST_DEPTH = 8
local function isSkipPart(inst: Instance?): boolean
	if not inst or not inst:IsA('BasePart') then return false end
	if inst.Name == 'Hitbox' then return true end
	if CollectionService:HasTag(inst, 'Hitbox') then return true end
	return false
end

-- Screen-space candidate scan. Walks every AICharacter-tagged model
-- and picks the one whose HRP, when projected to the viewport, sits
-- closest to the cursor — provided it's within
-- LOCK_SCREEN_FALLBACK_RADIUS pixels and on-screen. This is the
-- "I'm pointing roughly at them" fallback for when the spherecast
-- misses (e.g. camera is offset to the side, or the target is
-- partly occluded so the swept volume hits the obstruction first).
-- Mobs only — PvP characters are intentionally excluded by the
-- isEligibleLockTarget filter.
local function findClosestScreenCandidate(camera: Camera, mouse: Vector2): Model?
	local origin = camera.CFrame.Position
	local best: Model? = nil
	local bestDist = LOCK_SCREEN_FALLBACK_RADIUS

	-- The set is small in practice (one zone of mobs at a time), so a
	-- linear scan is fine — <1ms even at 100 candidates.
	for _, model in CollectionService:GetTagged('AICharacter') do
		if not model:IsA('Model') then continue end
		if not isEligibleLockTarget(model) then continue end
		local hrp = model:FindFirstChild('HumanoidRootPart') :: BasePart?
		if not hrp then continue end
		if (hrp.Position - origin).Magnitude > LOCK_RAYCAST_MAX_DISTANCE then continue end
		-- WorldToViewportPoint returns (Vector3 screen-coords, onScreen).
		-- The Z component of the screen vector is the depth; <= 0 means
		-- behind the camera, skip those.
		local screen, onScreen = camera:WorldToViewportPoint(hrp.Position)
		if not onScreen or screen.Z <= 0 then continue end
		local dx = screen.X - mouse.X
		local dy = screen.Y - mouse.Y
		local dist = math.sqrt(dx * dx + dy * dy)
		if dist < bestDist then
			best = model
			bestDist = dist
		end
	end
	return best
end

local function getCursorTarget(): Model?
	local mouse = UserInputService:GetMouseLocation()
	local camera = workspace.CurrentCamera
	if not camera then return nil end
	local ray = camera:ScreenPointToRay(mouse.X, mouse.Y, 1)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	-- Always exclude the local player's character; we'll grow this
	-- list with skip-parts as we re-cast past hitboxes.
	local excludes: { Instance } = { LocalPlayer.Character or Instance.new('Folder') }
	params.FilterDescendantsInstances = excludes

	-- Pass 1 — Spherecast along the cursor ray. The 4-stud radius
	-- swept volume catches small / lateral targets that a pixel-
	-- perfect ray would miss. We re-cast past skip-parts (named or
	-- tagged 'Hitbox') the same way the old raycast did.
	for _ = 1, MAX_RECAST_DEPTH do
		local result = workspace:Spherecast(ray.Origin, LOCK_SHAPECAST_RADIUS,
			ray.Direction * LOCK_RAYCAST_MAX_DISTANCE, params)
		if not result then break end
		local hit = result.Instance

		-- Skip parts: re-cast past them. Mutating the excludes table
		-- in place isn't enough — RaycastParams snapshots the list at
		-- assignment, so reassign each iteration.
		if isSkipPart(hit) then
			table.insert(excludes, hit)
			params.FilterDescendantsInstances = excludes
			continue
		end

		local target = resolveLockTargetFromHit(hit)
		if target then return target end
		-- Hit a non-eligible, non-skip part (a wall, a prop). Stop the
		-- recast loop and fall through to the screen-space fallback —
		-- a wall between cursor + enemy is still a lock-on candidate
		-- in the "aim roughly" model (Souls / Sekiro behavior).
		break
	end

	-- Pass 2 — screen-space fallback. Picks the closest on-screen
	-- candidate to the cursor when the swept ray didn't directly land
	-- on an eligible model.
	return findClosestScreenCandidate(camera, mouse)
end

----------------------------------------------------------------------
-- Camera tracking. Bind via RunService:BindToRenderStep so the
-- override runs at a deterministic priority slot relative to the
-- default camera scripts (which use the same priority bus).
----------------------------------------------------------------------
local function cameraStep(dt: number)
	local target = LockedTarget
	if not target or not target.Parent then return end
	local character = LocalPlayer.Character
	if not character then return end
	local hrp = character:FindFirstChild('HumanoidRootPart') :: BasePart?
	local tHrp = target:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not hrp or not tHrp then return end
	local camera = workspace.CurrentCamera
	if not camera then return end

	-- Vector from player to target (XZ flat). Camera sits OPPOSITE the
	-- target relative to the player: `desiredPos = playerPos - dir * dist`
	-- so the player is between camera and target, mid-frame.
	local dir = tHrp.Position - hrp.Position
	dir = Vector3.new(dir.X, 0, dir.Z)
	if dir.Magnitude < 0.5 then return end
	local fwd = dir.Unit

	local desiredPos = hrp.Position - fwd * CAMERA_DISTANCE + Vector3.new(0, CAMERA_HEIGHT, 0)
	-- Look-at point is biased between player and target so the player
	-- stays centered while the target frames into view.
	local lookPoint = hrp.Position:Lerp(tHrp.Position, CAMERA_TARGET_BIAS)
		+ Vector3.new(0, 1.5, 0)

	local desiredCF = CFrame.lookAt(desiredPos, lookPoint)
		* CFrame.Angles(math.rad(CAMERA_PITCH_DEG), 0, 0)

	-- Frame-rate-independent lerp. alpha = 1 - exp(-rate * dt) makes
	-- the smoothing the same wall-clock duration regardless of
	-- whether we're at 60fps or 120fps.
	local alpha = 1 - math.exp(-CAMERA_LERP_RATE * dt)
	camera.CFrame = camera.CFrame:Lerp(desiredCF, alpha)

	-- Continuous character rotation toward the target. AutoRotate=false
	-- (set in startCameraTracking) prevents Humanoid's MoveDirection
	-- pass from spinning the character on every WASD press. Movement
	-- stays camera-relative because Roblox PlayerModule computes
	-- WASD world-direction from the camera's basis regardless of the
	-- character's facing — so the player can press W to move toward
	-- the camera-forward (= toward target), strafe with A/D around
	-- the target, and the character visually follows.
	--
	-- Suppressed during hard crowd control. While the server owns this
	-- character's physics — launched, slammed, knocked down, dragged —
	-- writing HRP.CFrame every frame fights the server's motion
	-- constraint and the character visibly stutters mid-air. The lock
	-- resumes the instant the CC clears.
	if CombatShared.IsCharacterHardCrowdControlled(character) then return end
	hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + fwd)
end

local function startCameraTracking()
	if CameraConn then return end
	local camera = workspace.CurrentCamera
	if not camera then return end
	-- Switch to Scriptable so the default camera scripts release
	-- their CFrame writes; restore on unlock. Recording the prior
	-- type lets us cooperate with mounts / cinematic overrides that
	-- already changed CameraType.
	PriorCameraType = camera.CameraType
	camera.CameraType = Enum.CameraType.Scriptable

	-- Disable Humanoid.AutoRotate while locked so Roblox's MoveDirection
	-- rotation pass doesn't fight our per-frame "face the target" set
	-- on hrp.CFrame. Cache the prior value so a player who toggled
	-- AutoRotate elsewhere (e.g. mount system) gets it back on unlock.
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass('Humanoid')
	if humanoid then
		PriorAutoRotate = humanoid.AutoRotate
		humanoid.AutoRotate = false
	end

	-- Force-release shift-lock and prevent re-entry while target-locked.
	-- The CameraModeClient external-lock guard restores the player's
	-- prior shift-lock mode on unlock.
	local CameraModeClient = getCameraModeClient()
	if CameraModeClient and CameraModeClient.SetExternalLock then
		CameraModeClient.SetExternalLock(true)
	end

	-- BindToRenderStep instead of RenderStepped:Connect so we get a
	-- specific priority slot — runs AFTER the default camera (which
	-- itself binds at `Camera` priority) so any leftover writes from
	-- siblings that DIDN'T release control are overridden.
	RunService:BindToRenderStep(CAMERA_RENDER_NAME, CAMERA_RENDER_PRIORITY, cameraStep)
end

local function stopCameraTracking()
	if CameraConn then CameraConn:Disconnect(); CameraConn = nil end
	pcall(function() RunService:UnbindFromRenderStep(CAMERA_RENDER_NAME) end)
	-- Restore camera type. Falling back to Custom keeps the default
	-- camera scripts happy if the prior value was somehow nil.
	local camera = workspace.CurrentCamera
	if camera then
		camera.CameraType = PriorCameraType or Enum.CameraType.Custom
	end
	PriorCameraType = nil

	-- Restore Humanoid.AutoRotate. Default to true when the prior
	-- value is missing (lock engaged before character spawned, etc.)
	-- — the standard Roblox state.
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass('Humanoid')
	if humanoid then
		humanoid.AutoRotate = (PriorAutoRotate ~= false)
	end
	PriorAutoRotate = nil

	-- Release the CameraModeClient external lock so Shift cycling
	-- works again. CameraModeClient restores the prior shift-lock
	-- mode internally.
	local CameraModeClient = getCameraModeClient()
	if CameraModeClient and CameraModeClient.SetExternalLock then
		CameraModeClient.SetExternalLock(false)
	end
end

local function clearLock()
	LockedTarget = nil
	if LockGui then LockGui.Parent = nil end
	disconnectTargetWatch()
	stopCameraTracking()
end

local function setLock(target: Model)
	LockedTarget = target
	local hrp = target:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not hrp then clearLock(); return end
	local gui = ensureLockGui()
	gui.Adornee = hrp
	gui.Parent = hrp
	-- Drop any previous target's listeners before binding to this one,
	-- so a swap-lock doesn't leave a dead Died listener stuck around.
	disconnectTargetWatch()
	local function clearIfStillLocked()
		if LockedTarget == target then clearLock() end
	end
	-- Death → unlock. Standard Souls/Sekiro behavior.
	local humanoid = target:FindFirstChildOfClass('Humanoid')
	if humanoid then
		table.insert(TargetWatchConns, humanoid.Died:Connect(clearIfStillLocked))
	end
	-- Workspace eviction → unlock. AncestryChanged fires whenever the
	-- model's parent chain changes; we only care about the case where
	-- the target is no longer a descendant of workspace (despawn, mob
	-- streaming-out, server-initiated reparent). Without this listener
	-- a despawned target would freeze the camera lock until the player
	-- manually pressed R again.
	table.insert(TargetWatchConns, target.AncestryChanged:Connect(function()
		if not target:IsDescendantOf(workspace) then
			clearIfStillLocked()
		end
	end))
	-- Destroying → unlock. AncestryChanged fires before Destroy
	-- finalizes; this is a belt-and-suspenders catch for instances
	-- that go straight to Destroy without an intermediate parent flip.
	table.insert(TargetWatchConns, target.Destroying:Connect(clearIfStillLocked))
	-- Start the camera lock-on track. Idempotent — if the player
	-- swap-locks (R-on-different-target without unlocking first), the
	-- existing track stays active; only the LockedTarget pointer
	-- changes and the next cameraStep frame uses the new target.
	startCameraTracking()
end

----------------------------------------------------------------------
-- Public API.
----------------------------------------------------------------------

-- Returns the currently-locked target Model, or nil. Combat / camera
-- code can call this to bias targeting; for v1 nothing else does.
function Module.GetLockedTarget(): Model?
	if LockedTarget and LockedTarget.Parent then return LockedTarget end
	if LockedTarget then clearLock() end  -- target was destroyed / unparented
	return nil
end

-- Toggle: set the cursor target as locked, OR clear if it's already
-- the locked target, OR swap to a different cursor target. Bound to
-- the R key in Module.Start.
function Module.Toggle()
	local cursorTarget = getCursorTarget()
	if not cursorTarget then
		-- Empty cursor → if we already have a lock, clear it. R-to-
		-- unlock with cursor in empty space is a common UX in lock-on
		-- combat games (Sekiro, ER, MH).
		if LockedTarget then clearLock() end
		return
	end
	if LockedTarget == cursorTarget then
		clearLock()
	else
		setLock(cursorTarget)
	end
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------

function Module.Start()
	-- R-key toggle. Routed via UserInputService.InputBegan rather than
	-- ContextActionService so it doesn't compete with combat / camera
	-- bindings for sink priority.
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		if input.KeyCode == Enum.KeyCode.R then
			Module.Toggle()
		end
	end)

	-- Auto-clear lock on local-player respawn/death so the Scriptable
	-- camera doesn't stay sticky after a death — without this, the
	-- camera type stays Scriptable but cameraStep early-returns when
	-- the new character has no HRP yet, freezing the camera in place.
	local function bindCharacter(character: Model)
		local humanoid = character:FindFirstChildOfClass('Humanoid')
			or character:WaitForChild('Humanoid', 5)
		if not humanoid then return end
		humanoid.Died:Once(function() clearLock() end)
	end
	if LocalPlayer.Character then bindCharacter(LocalPlayer.Character) end
	LocalPlayer.CharacterAdded:Connect(function(character)
		-- New character → ensure any leftover lock is cleared so the
		-- camera type is restored before the next bind.
		clearLock()
		bindCharacter(character)
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Gameplay/PerfectDodgeClient"><![CDATA[-- Perfect dodge client — VFX + audio response to a server-detected
-- perfect dodge. The server fires CombatEvent with action
-- CombatActions.PerfectDodge; CombatClient's listener routes the call
-- here. We don't trust the client to detect perfect dodge on its own
-- — server is authoritative — so this module is purely visual.
--
-- Effects per perfect dodge (over CombatConfig.COUNTER_WINDOW seconds):
--   1. Time-slow: workspace.Gravity is dropped to GRAVITY_SLOW * normal,
--      then tweened back. Affects the whole world feel for the duration
--      so the player notices the pause.
--   2. Camera shake on the start: brief Humanoid CameraOffset jitter.
--   3. Blue ring expanding from the player at the perfect-dodge moment.
--   4. Optional audio cue (rbxassetid placeholder until designers spec).

local Players = game:GetService('Players')
local TweenService = game:GetService('TweenService')
local Debris = game:GetService('Debris')

local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CombatConfigModule = ReplicatedModules.Data.CombatConfig

-- MicroProfiler scope wrapper. Labels a region for a Studio capture and
-- costs nothing when no capture is running. These used to also emit an
-- os.clock() benchmark `print` per call — on a path that runs for every
-- hit of every swing, that Output flush was itself the lag it was
-- measuring. The scopes stayed; the prints did not.
local function _profileCall(label: string, fn: () -> ...any): ...any
	debug.profilebegin(label)
	local results = table.pack(fn())
	-- Defensive: if `fn` yielded, the engine already popped our scope
	-- and profileend would raise "No active profile annotation".
	pcall(debug.profileend)
	return table.unpack(results, 1, results.n)
end

local Module = {}

-- Multiplier on baseline gravity during the counter window. 0.4 is the
-- value called out in NIER_COMBAT.md; tweak in CombatConfig if it
-- becomes too distracting.
local GRAVITY_SLOW = 0.4

-- Track the in-flight tween so a second perfect dodge during a counter
-- window doesn't double-up gravity tweens (which would race + leave
-- gravity stuck low).
local activeGravityTween: Tween? = nil
local baselineGravity: number? = nil

-- Run the time-slow + restore for the COUNTER_WINDOW. Idempotent: if a
-- previous slow is still active, we extend (cancel old tween → start
-- fresh tween at current gravity → restore at end).
local function runTimeSlow()
	debug.profilebegin('PerfectDodgeClient.runTimeSlow')
	local cfg = CombatConfigModule.CombatConfig
	local window = cfg.COUNTER_WINDOW or 1.5
	if not baselineGravity then
		baselineGravity = workspace.Gravity
	end
	if activeGravityTween then
		activeGravityTween:Cancel()
		activeGravityTween = nil
	end
	-- Drop instantly, restore over `window` seconds. The drop is
	-- immediate so the slow-mo "hits" simultaneously with the player's
	-- on-screen blue ring.
	workspace.Gravity = (baselineGravity or 196.2) * GRAVITY_SLOW
	local restore = TweenService:Create(
		workspace, TweenInfo.new(window, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Gravity = baselineGravity or 196.2 })
	activeGravityTween = restore
	restore:Play()
	restore.Completed:Once(function()
		if activeGravityTween == restore then
			activeGravityTween = nil
		end
	end)
	debug.profileend()
end

-- Camera shake — brief CameraOffset jitter on the local Humanoid.
-- Cleans up by tween-back to zero; never modifies a non-zero baseline
-- (so other systems writing CameraOffset aren't trampled).
local function runCameraShake()
	debug.profilebegin('PerfectDodgeClient.runCameraShake')
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass('Humanoid')
	if not humanoid then
		debug.profileend()
		return
	end
	local original = humanoid.CameraOffset
	-- Three small kicks over 0.18s. Keeps the shake "punchy" without
	-- dragging out.
	for i = 1, 3 do
		task.delay(i * 0.06, function()
			if not humanoid or humanoid.Parent == nil then return end
			humanoid.CameraOffset = original + Vector3.new(
				(math.random() - 0.5) * 0.6,
				(math.random() - 0.5) * 0.4,
				(math.random() - 0.5) * 0.6)
		end)
	end
	task.delay(0.20, function()
		if humanoid and humanoid.Parent then
			TweenService:Create(humanoid, TweenInfo.new(0.15),
				{ CameraOffset = original }):Play()
		end
	end)
	debug.profileend()
end

-- Blue ring at the player's HRP. Expands + fades over RING_DURATION.
local function runBlueRing(character: Instance?)
	debug.profilebegin('PerfectDodgeClient.runBlueRing')
	character = character or LocalPlayer.Character
	if not character then
		debug.profileend()
		return
	end
	local hrp = (character :: any):FindFirstChild('HumanoidRootPart') :: BasePart?
	if not hrp then
		debug.profileend()
		return
	end
	local part = Instance.new('Part')
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.Material = Enum.Material.Neon
	part.Color = Color3.fromRGB(120, 200, 255)
	part.Transparency = 0.2
	part.Size = Vector3.new(2, 0.1, 2)
	part.Shape = Enum.PartType.Cylinder
	part.CFrame = hrp.CFrame * CFrame.Angles(0, 0, math.rad(90))
	part.Parent = workspace

	local tween = TweenService:Create(part,
		TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(0.1, 12, 12), Transparency = 1 })
	tween:Play()
	Debris:AddItem(part, 0.5)
	debug.profileend()
end

-- Public entry point. Called by CombatClient on server-fired
-- PerfectDodge cue. `character` is the local player's character at the
-- moment of the dodge; passed through so the ring renders on the right
-- HRP even if a respawn intervenes.
function Module.OnPerfectDodge(character: Instance?)
	_profileCall('PerfectDodgeClient.OnPerfectDodge', function()
		runTimeSlow()
		runCameraShake()
		runBlueRing(character)
	end)
end

local function spawnSlashArc(aHrp: BasePart, vHrp: BasePart)
	debug.profilebegin('PerfectDodgeClient.spawnSlashArc')
	local part = Instance.new('Part')
	part.Anchored = true; part.CanCollide = false; part.CanTouch = false; part.CanQuery = false
	part.Material = Enum.Material.Neon
	part.Color = Color3.fromRGB(255, 240, 200)
	part.Transparency = 0.3
	part.Size = Vector3.new(0.4, 0.4, (aHrp.Position - vHrp.Position).Magnitude)
	part.CFrame = CFrame.new((aHrp.Position + vHrp.Position) * 0.5,
		vHrp.Position) + Vector3.new(0, 1, 0)
	part.Parent = workspace
	TweenService:Create(part, TweenInfo.new(0.2),
		{ Transparency = 1, Size = part.Size + Vector3.new(0.1, 0.1, 0) }):Play()
	Debris:AddItem(part, 0.25)
	debug.profileend()
end

-- Renders a slash arc per victim from the attacker's HRP. `victims` may
-- be a single Model (legacy) or an array of Models (current server form
-- — one broadcast per swing carries every finisher victim). Only fires
-- when the local player is the attacker.
function Module.OnFinisherHit(attacker: Instance?, victims: any)
	_profileCall('PerfectDodgeClient.OnFinisherHit', function()
		if not attacker or attacker ~= LocalPlayer.Character then return end
		local aHrp = (attacker :: any):FindFirstChild('HumanoidRootPart') :: BasePart?
		if not aHrp then return end
		local list: { Instance }
		if typeof(victims) == 'table' then
			list = victims
		elseif typeof(victims) == 'Instance' then
			list = { victims }
		else
			return
		end
		for _, victim in list do
			local vHrp = (victim :: any):FindFirstChild('HumanoidRootPart') :: BasePart?
			if vHrp then
				spawnSlashArc(aHrp, vHrp)
			end
		end
	end)
end

function Module.Init(_otherSystems) end
function Module.Start() end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Gameplay/CameraModeClient"><![CDATA[-- // CameraModeClient.luau //
-- Three-mode camera / shift-lock cycle. Press Shift to advance:
--
--   Free            — standard Roblox camera. Mouse free, character
--                     auto-rotates with WASD movement.
--   CameraShiftLock — mouse locked to screen center (camera drag is
--                     wheel-only) but the character still auto-rotates
--                     with WASD. Useful for aiming the camera without
--                     forcing the character to face camera-forward.
--   CharacterShiftLock — standard Roblox shift lock: mouse locked AND
--                        the character continuously rotates to face
--                        the camera's flat-look direction. Default
--                        Roblox feel.
--
-- Roblox's built-in DevEnableMouseLock is left disabled (set in
-- Module.Start) — we drive the lock state ourselves so the cycle is
-- tri-state, not just on/off.
--
-- TargetLockClient takes precedence: while a target is locked, that
-- module owns the camera (Scriptable) + character orientation. Our
-- per-frame humanoid rotation skips the rotate step in that case so
-- both systems don't fight.

local Players              = game:GetService('Players')
local UserInputService      = game:GetService('UserInputService')
local RunService            = game:GetService('RunService')
local ContextActionService  = game:GetService('ContextActionService')

local LocalPlayer = Players.LocalPlayer

local Module = {}

-- Mode enum. Strings (not numeric) so error messages + telemetry
-- read clearly without an enum-name lookup.
local MODES = { 'Free', 'CameraShiftLock', 'CharacterShiftLock' }
local CurrentMode: string = 'Free'

-- External-lock guard. While true, CycleMode + Shift-key are no-ops
-- and the active mode is forced to Free. TargetLockClient flips this
-- on lock/clear so the player can't enter shift-lock while target-
-- locked (the lock-on system owns character rotation in that state).
local ExternalLockActive: boolean = false
-- Mode the player was in BEFORE the external lock engaged. Restored
-- on release so target-lock toggle doesn't permanently kick players
-- out of their preferred shift-lock setting.
local ModeBeforeExternalLock: string? = nil

-- RenderStep slot used by the character-shift-lock rotation pass.
-- Bound at `Camera + 1` priority so it runs AFTER the default camera
-- finalizes its CFrame each frame (same idiom as TargetLockClient).
local CHAR_ROTATE_RENDER_NAME = 'CameraModeCharacterRotate'
local CHAR_ROTATE_PRIORITY    = Enum.RenderPriority.Camera.Value + 1

-- Optional: small over-the-shoulder camera offset for character
-- shift-lock so the player can see what they're aiming at without
-- the camera being centered behind the head. 0 to disable.
local SHIFT_LOCK_CAMERA_OFFSET = Vector3.new(1.5, 0, 0)

-- CAS priority used to suppress Roblox's built-in MouseLockSwitchAction
-- (LeftAlt / RightAlt / `;`). PlayerModule binds it at the default
-- priority (2000); ContextActionPriority.High = 4000 reliably sinks
-- before that handler fires. Without this, pressing Alt with swords
-- drawn flips Humanoid.AutoRotate / CameraOffset under us — the
-- character visually freezes while the camera reframes.
local MOUSELOCK_SINK_NAME     = 'CameraMode_SinkMouseLockKeys'
local MOUSELOCK_SINK_PRIORITY = Enum.ContextActionPriority.High.Value

----------------------------------------------------------------------
-- Helpers.
----------------------------------------------------------------------

-- Returns true when TargetLockClient is currently driving the camera
-- via its Scriptable override. We yield character rotation to it
-- because lock-on-driven character orient is its responsibility.
local function isTargetLockActive(): boolean
	local camera = workspace.CurrentCamera
	if not camera then return false end
	return camera.CameraType == Enum.CameraType.Scriptable
end

-- Read the local player's humanoid; returns nil while the character
-- is mid-respawn.
local function getHumanoid(): Humanoid?
	local character = LocalPlayer.Character
	return character and (character:FindFirstChildOfClass('Humanoid'))
end

----------------------------------------------------------------------
-- Per-frame character rotation for CharacterShiftLock. Rotates the
-- humanoid's HRP toward the camera's XZ-flat look so movement input
-- is camera-relative AND the character visually faces forward.
-- Skipped when target-lock is active — that system owns rotation.
----------------------------------------------------------------------
local function characterRotateStep(_dt: number)
	if CurrentMode ~= 'CharacterShiftLock' then return end
	if isTargetLockActive() then return end
	local humanoid = getHumanoid()
	if not humanoid then return end
	local hrp = humanoid.RootPart
	if not hrp then return end
	local camera = workspace.CurrentCamera
	if not camera then return end

	local lookXZ = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
	if lookXZ.Magnitude < 0.01 then return end
	-- Set HRP CFrame to the camera-aligned look. AutoRotate=false (set
	-- when entering this mode) prevents Humanoid's MoveDirection-driven
	-- rotation from fighting us each frame.
	hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + lookXZ.Unit)
end

----------------------------------------------------------------------
-- Mode application. Idempotent — applies the current mode's settings
-- to MouseBehavior + Humanoid.AutoRotate + the optional CameraOffset.
-- Re-runnable on character spawn so a respawn doesn't drop the mode.
----------------------------------------------------------------------
local function applyMode()
	local humanoid = getHumanoid()

	if CurrentMode == 'Free' then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		if humanoid then
			humanoid.AutoRotate = true
			humanoid.CameraOffset = Vector3.zero
		end

	elseif CurrentMode == 'CameraShiftLock' then
		-- Lock the mouse to screen center but leave the character
		-- alone. Camera drags follow mouse delta naturally; character
		-- rotates to its WASD movement direction (not the camera's).
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		if humanoid then
			humanoid.AutoRotate = true
			humanoid.CameraOffset = Vector3.zero
		end

	elseif CurrentMode == 'CharacterShiftLock' then
		-- Mouse locked + per-frame humanoid rotation toward camera.
		-- AutoRotate=false stops Humanoid's MoveDirection rotation
		-- from spinning the character on every WASD press.
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		if humanoid then
			humanoid.AutoRotate = false
			humanoid.CameraOffset = SHIFT_LOCK_CAMERA_OFFSET
		end
	end
end

----------------------------------------------------------------------
-- Public API.
----------------------------------------------------------------------

function Module.GetMode(): string
	return CurrentMode
end

-- Set the camera mode explicitly. Useful for cmdr / settings hooks
-- that want to bypass the cycle order.
function Module.SetMode(mode: string)
	for _, valid in MODES do
		if valid == mode then
			CurrentMode = mode
			applyMode()
			return
		end
	end
end

-- Cycle Free → CameraShiftLock → CharacterShiftLock → Free.
function Module.CycleMode()
	-- Suppressed while another system owns the camera/character
	-- (e.g. TargetLockClient is target-locked). Cycling during that
	-- window would let the player enter shift-lock under the lock-on
	-- system's per-frame humanoid rotation pass — they'd fight.
	if ExternalLockActive then return end
	for i, mode in MODES do
		if mode == CurrentMode then
			CurrentMode = MODES[(i % #MODES) + 1]
			applyMode()
			return
		end
	end
	-- Defensive: unknown current mode → reset to Free.
	CurrentMode = 'Free'
	applyMode()
end

-- External lock toggle. While locked, the cycle is no-op and the
-- mode is forced to Free; releasing restores whatever the player had
-- selected before the lock engaged. Idempotent — re-locking while
-- already locked stashes the same prior mode.
function Module.SetExternalLock(locked: boolean)
	if locked == ExternalLockActive then return end
	ExternalLockActive = locked
	if locked then
		ModeBeforeExternalLock = CurrentMode
		CurrentMode = 'Free'
		applyMode()
	else
		-- Restore prior mode if we have one stashed; otherwise stay
		-- in Free (the lock entered with no prior mode known).
		if ModeBeforeExternalLock then
			CurrentMode = ModeBeforeExternalLock
			ModeBeforeExternalLock = nil
		end
		applyMode()
	end
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------

function Module.Start()
	-- DevEnableMouseLock is studio-only (the runtime rejects script
	-- writes with "Insufficient permissions"). The user disables it
	-- manually in Game Settings → Avatar → Mouse Lock so our
	-- tri-state cycle isn't fighting Roblox's built-in shift-lock
	-- toggle on the same key. Setup note in CAMERA_NIER_NOTES, not
	-- enforced here.

	-- Belt-and-suspenders: even when DevEnableMouseLock is left ON
	-- (forgotten in Game Settings, fresh place file, etc.), sink the
	-- keys PlayerModule.MouseLockController binds to the built-in
	-- MouseLockSwitchAction so the toggle never reaches that handler.
	-- Without this, pressing Alt with weapons drawn flips
	-- Humanoid.AutoRotate / CameraOffset out from under combat
	-- animations and the character reads as frozen mid-stride.
	ContextActionService:BindActionAtPriority(
		MOUSELOCK_SINK_NAME,
		function() return Enum.ContextActionResult.Sink end,
		false,
		MOUSELOCK_SINK_PRIORITY,
		Enum.KeyCode.LeftAlt,
		Enum.KeyCode.RightAlt,
		Enum.KeyCode.Semicolon
	)

	-- Shift cycles. Both Left and Right Shift → same handler so
	-- either physical shift key works. Filtered against `processed`
	-- so cmdr / chat / UI text inputs don't trigger a cycle.
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		if input.KeyCode == Enum.KeyCode.LeftShift
			or input.KeyCode == Enum.KeyCode.RightShift then
			Module.CycleMode()
		end
	end)

	-- Re-apply on character spawn — Humanoid is fresh each respawn,
	-- so AutoRotate / CameraOffset would otherwise reset to defaults
	-- and drop the mode silently.
	LocalPlayer.CharacterAdded:Connect(function()
		-- Wait one frame for the Humanoid to be parented.
		task.defer(applyMode)
	end)

	-- Per-frame character rotation for CharacterShiftLock. The
	-- callback no-ops when not in that mode — bound once and left
	-- alone for the session.
	RunService:BindToRenderStep(CHAR_ROTATE_RENDER_NAME, CHAR_ROTATE_PRIORITY, characterRotateStep)

	-- Apply current mode (Free) once on startup so MouseBehavior is
	-- in a known state if the player joined while their previous
	-- session left it locked.
	applyMode()
end

function Module.Init(_otherSystems) end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Gameplay/WaypointsClient"><![CDATA[-- WaypointsClient — world-space 3D waypoint markers.
--
-- Two categories:
--   * 'workstation' → tagged via CollectionService 'Workstation';
--                     kind read from WorkstationKind attribute.
--   * 'waystone'    → tagged via CollectionService 'Waystones';
--                     visibility gated by PlayerData.Waystones (only
--                     unlocked waystones get a marker).
--
-- Settings:
--   SettingsRegistry.WaypointsWorkstationsEnabled  → workstation markers visible
--   SettingsRegistry.WaypointsWaystonesEnabled     → unlocked-waystone markers visible
--
-- Each marker is a BillboardGui parented under a per-player Folder in
-- LocalPlayer.PlayerGui (so other players don't see this player's
-- markers). The BillboardGui's Adornee tracks the live model so the
-- marker follows the world part if it's ever moved.
--
-- Lifecycle:
--   * On Start: walk currently-tagged instances + listen for additions.
--   * On Setting changed: flip the .Enabled bool on every marker in
--     the affected category.
--   * On PlayerData replicated: refresh waystone markers (newly
--     unlocked → spawn; revoked → despawn).
--   * On Player removing or model removed: drop the BillboardGui.

local CollectionService = game:GetService('CollectionService')
local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local WaypointsData     = ReplicatedModules.Data.Waypoints
local WaystonesData     = ReplicatedModules.Data.Waystones
local SubstationsData   = ReplicatedModules.Data.Substations
local ReplicatedData    = ReplicatedModules.Services.ReplicatedData
local RemoteService     = ReplicatedModules.Services.RemoteService
-- WaystonesEvent fires on each fresh server-side unlock. Listening to
-- it (in addition to PlayerData replication) gives a tighter "marker
-- appears the moment the waystone is unlocked" feel without polling.
local WaystonesEvent = RemoteService.GetRemote('WaystonesEvent', 'RemoteEvent', false)

local LocalPlayerScripts = LocalPlayer:WaitForChild('PlayerScripts')
local LocalModules = require(LocalPlayerScripts:WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local SettingsRegistry = LocalModules.Modules.SettingsRegistry

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Marker registry. Keyed by the world Model so add/remove signals can
-- reach the right BillboardGui in O(1).
----------------------------------------------------------------------
type Marker = {
	Category: string,         -- 'workstation' | 'waystone' | 'substation'
	WaystoneId: string?,      -- only for 'waystone' markers; matches save lookup
	Gui: BillboardGui,
	-- Attachment we created under the host part to anchor the
	-- BillboardGui at the model's pivot center. We own this instance,
	-- so despawnMarker is responsible for destroying it (otherwise
	-- orphaned attachments would accumulate in the world).
	Attachment: Attachment?,
}
local Markers: { [Instance]: Marker } = {}
local MarkerFolder: Folder? = nil

----------------------------------------------------------------------
-- Resolve the host BasePart for an Attachment. Attachments must
-- parent under a BasePart (Workspace itself rejects them), so we
-- pick the model's PrimaryPart, falling back to the first BasePart
-- descendant. Models with no BaseParts at all (decals only / lights)
-- can't anchor a marker — return nil.
----------------------------------------------------------------------
local function hostPartOf(model: Instance): BasePart?
	if model:IsA('BasePart') then return model end
	if model:IsA('Model') then
		if model.PrimaryPart then return model.PrimaryPart end
		for _, d in model:GetDescendants() do
			if d:IsA('BasePart') then return d end
		end
	end
	return nil
end

----------------------------------------------------------------------
-- Pivot-anchored attachment. Creates (or reuses) an Attachment under
-- `host`, with its WorldPosition pinned to the model's pivot. Using
-- an Attachment as the BillboardGui Adornee lets us point at the
-- model's TRUE center even when the host BasePart sits off-center
-- (waystone base plates, low workstation slabs, etc.) — without the
-- StudsOffset gymnastics the old code did.
--
-- Two callers + two semantics:
--   * Workstations float `floatY` studs above the pivot so the icon
--     reads above the model rather than over its center mass.
--   * Waystones anchor exactly at the pivot (floatY = 0) so the
--     stud-scaled marker frames the structure.
--
-- We re-use any existing Attachment named `WaypointAnchor` on the
-- host (re-tagging mid-session won't double-create), and store the
-- attachment in the Marker entry for cleanup on despawn.
----------------------------------------------------------------------
local function createPivotAttachment(model: Instance, host: BasePart, floatY: number): Attachment
	local existing = host:FindFirstChild('WaypointAnchor')
	local att: Attachment
	if existing and existing:IsA('Attachment') then
		att = existing
	else
		att = Instance.new('Attachment')
		att.Name = 'WaypointAnchor'
		att.Parent = host
	end
	-- Pivot is the gold-standard "center of the model." On a Model
	-- with PrimaryPart it returns the PrimaryPart CFrame; on a Model
	-- without one it returns the bounding-box center; on a BasePart
	-- it returns the part CFrame. WorldPosition is the world-space
	-- write that handles parenting math for us.
	local pivotPos = (model :: any):GetPivot().Position + Vector3.new(0, floatY, 0)
	att.WorldPosition = pivotPos
	return att
end

----------------------------------------------------------------------
-- BillboardGui builder. Icon-only — a single TextLabel with a black
-- text stroke for legibility against any background. No pill / no
-- label clutters the world; the player just sees a colored icon
-- floating over the target. AlwaysOnTop keeps it visible through walls.
--
-- Adornee is an Attachment positioned at the model's pivot, so
-- StudsOffset is always Vector3.zero — the attachment IS the anchor.
-- Any "float above the model" lift is baked into the attachment's
-- WorldPosition by createPivotAttachment(floatY).
--
-- Optional `sizing.Size` overrides:
--   Default fromOffset(56, 56) — pixel-sized.
--   Pass UDim2.fromScale(N, N) for stud-sized markers that grow /
--   shrink with camera distance (waystones use this).
----------------------------------------------------------------------
local BILLBOARD_SIZE_PX  = 56

type BillboardSizing = {
	Size: UDim2?,
}

local function buildBillboard(adornee: Attachment, kindCfg, label: string?, category: string, sizing: BillboardSizing?): BillboardGui
	sizing = sizing or {}
	-- `label` reserved for future tooltip/minimap integration — pass-through.
	local _ = label

	local bg = Instance.new('BillboardGui')
	bg.Name = 'Waypoint_' .. category
	bg.Adornee = adornee
	bg.AlwaysOnTop = true
	bg.LightInfluence = 0
	bg.Size = sizing.Size or UDim2.fromOffset(BILLBOARD_SIZE_PX, BILLBOARD_SIZE_PX)
	bg.StudsOffset = Vector3.zero
	bg.MaxDistance = 250

	local icon = Instance.new('TextLabel')
	icon.Name = 'Icon'
	icon.AnchorPoint = Vector2.new(0.5, 0.5)
	icon.Position = UDim2.fromScale(0.5, 0.5)
	icon.Size = UDim2.fromScale(1, 1)
	icon.BackgroundTransparency = 1
	icon.FontFace = HUDCommon.FONT_DISPLAY
	icon.Text = kindCfg.Icon
	icon.TextScaled = true
	icon.TextColor3 = kindCfg.Color
	icon.TextStrokeColor3 = Color3.new(0, 0, 0)
	icon.TextStrokeTransparency = 0.2
	icon.Parent = bg

	bg.Parent = MarkerFolder
	return bg
end

----------------------------------------------------------------------
-- Visibility refresh. Called whenever a setting flips or the unlocked
-- waystone set changes. Cheap walk over every live marker.
----------------------------------------------------------------------
local function getCategoryEnabled(category: string): boolean
	if category == 'workstation' then
		return SettingsRegistry.WaypointsWorkstationsEnabled ~= false
	elseif category == 'waystone' then
		return SettingsRegistry.WaypointsWaystonesEnabled ~= false
	elseif category == 'substation' then
		return SettingsRegistry.WaypointsSubstationsEnabled ~= false
	end
	return true
end

local function refreshVisibility()
	for _, marker in Markers do
		marker.Gui.Enabled = getCategoryEnabled(marker.Category)
	end
end

----------------------------------------------------------------------
-- Workstation markers. Fired on tag added; checks WorkstationKind and
-- spawns a marker. The CollectionService removed-signal cleanup at the
-- bottom handles teardown.
----------------------------------------------------------------------
local function spawnWorkstationMarker(model: Instance)
	if Markers[model] then return end
	local host = hostPartOf(model)
	if not host then return end
	local kind = model:GetAttribute('WorkstationKind')
	local cfg = (typeof(kind) == 'string' and WaypointsData.Workstations[kind])
		or WaypointsData.WorkstationDefault
	-- Workstations float a few studs above the pivot so the icon
	-- reads above the model rather than overlapping it. The lift is
	-- in world space (attachment.WorldPosition += Vy), not StudsOffset.
	local attachment = createPivotAttachment(model, host, 6)
	local bg = buildBillboard(attachment, cfg, cfg.Label, 'workstation')
	Markers[model] = { Category = 'workstation', Gui = bg, Attachment = attachment }
	bg.Enabled = getCategoryEnabled('workstation')
end

----------------------------------------------------------------------
-- Substation markers. Mirror the workstation pattern but read the
-- per-kind icon/color/label from SubstationsData (the same data the
-- SubstationServer / crafting gate uses) so the world icon matches
-- the gameplay metadata 1:1.
----------------------------------------------------------------------
local function spawnSubstationMarker(model: Instance)
	if Markers[model] then return end
	local host = hostPartOf(model)
	if not host then return end
	local kind = model:GetAttribute(SubstationsData.AttributeKind)
	local cfg = (typeof(kind) == 'string' and SubstationsData.Kinds[kind])
		or SubstationsData.Default
	-- Same 6-stud float as workstations — substations are visually
	-- workstation-class nodes, just gated by a different system.
	local attachment = createPivotAttachment(model, host, 6)
	local bg = buildBillboard(attachment, cfg, cfg.Label, 'substation')
	Markers[model] = { Category = 'substation', Gui = bg, Attachment = attachment }
	bg.Enabled = getCategoryEnabled('substation')
end

----------------------------------------------------------------------
-- Waystone markers. Two-stage gate: the model must be tagged AND its
-- WaystoneId must appear in PlayerData.Waystones. Subscribe to both
-- the tag added/removed signals AND the PlayerData replication so
-- markers spawn/despawn when the player unlocks a new waystone.
----------------------------------------------------------------------
local function isWaystoneUnlocked(waystoneId: string): boolean
	local data = ReplicatedData.GetData('PlayerData', false)
	if typeof(data) ~= 'table' or typeof(data.Waystones) ~= 'table' then
		return false
	end
	for _, id in data.Waystones do
		if id == waystoneId then return true end
	end
	return false
end

local function spawnWaystoneMarker(model: Instance)
	if Markers[model] then return end
	-- ID resolution priority:
	--   1. `WaystoneId` attribute (canonical — what WaystonesServer reads)
	--   2. Model `.Name` (fallback for scenes that haven't set the
	--      attribute; the convention is for the model name to match the
	--      `WaystoneDisplays` key, e.g. `F0_World`).
	-- The fallback is matched against `WaystoneDisplays` to ensure we
	-- only treat it as an id when it's a known waystone — otherwise an
	-- arbitrary model tagged with the Waystones tag (and lacking both
	-- an attribute AND a recognized name) is rejected.
	local waystoneId: string? = model:GetAttribute('WaystoneId')
	if typeof(waystoneId) ~= 'string' or waystoneId == '' then
		if WaystonesData.WaystoneDisplays[model.Name] then
			waystoneId = model.Name
		else
			warn(string.format(
				'[WaypointsClient] Tagged waystone %s has no WaystoneId attribute and its Name (%q) is not a known WaystoneDisplays key — skipped',
				model:GetFullName(), tostring(model.Name)))
			return
		end
	end
	if not isWaystoneUnlocked(waystoneId :: string) then
		-- Not an error — most waystones start locked. Silent so refresh
		-- ticks don't spam the Output panel.
		return
	end
	local host = hostPartOf(model)
	if not host then
		warn(string.format(
			'[WaypointsClient] Waystone %s has no BasePart to host an Attachment — skipped',
			model:GetFullName()))
		return
	end
	-- Resolve a friendly label from the Waystones data module so the
	-- marker reads "Town of Beginnings" instead of "F1_ToB".
	local cfg = WaystonesData.WaystoneDisplays[waystoneId]
	local label = (cfg and cfg.Name) or waystoneId

	-- Anchor the attachment at the model's true pivot center —
	-- :GetPivot() returns the geometric center for a Model, which is
	-- exactly what we want for the stud-scaled marker. No floatY: the
	-- 10×10 stud frame already encloses the structure.
	local attachment = createPivotAttachment(model, host, 0)
	local bg = buildBillboard(attachment, WaypointsData.WaystoneStyle, label, 'waystone', {
		-- Stud-scaled size: 10×10 studs in world space. Marker grows
		-- and shrinks with distance like a true world object instead
		-- of staying a fixed pixel size on screen.
		Size = UDim2.fromScale(10, 10),
	})
	Markers[model] = {
		Category = 'waystone', WaystoneId = waystoneId,
		Gui = bg, Attachment = attachment,
	}
	bg.Enabled = getCategoryEnabled('waystone')
	print(string.format('[WaypointsClient] Spawned waystone marker %q at %s',
		waystoneId, attachment:GetFullName()))
end

local function despawnMarker(model: Instance)
	local marker = Markers[model]
	if not marker then return end
	marker.Gui:Destroy()
	-- We created the attachment ourselves; tear it down with the
	-- marker so re-tagged models don't accumulate orphaned anchors.
	if marker.Attachment then
		marker.Attachment:Destroy()
	end
	Markers[model] = nil
end

-- Re-evaluate every tagged Waystone model when PlayerData changes.
-- Newly-unlocked → spawn; not-yet-unlocked stays absent.
local function refreshWaystoneMarkers()
	for _, model in CollectionService:GetTagged(WaystonesData.WaystonesTag) do
		if Markers[model] then
			-- Already shown — keep as-is. (We don't despawn on
			-- "no longer unlocked" because waystones unlock once
			-- and never revert in the current design.)
			continue
		end
		spawnWaystoneMarker(model)
	end
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	-- Per-player folder so other clients' waypoints don't bleed into
	-- this player's view (BillboardGuis parented to PlayerGui are
	-- player-local by design; the folder keeps cleanup centralized).
	local playerGui = LocalPlayer:WaitForChild('PlayerGui')
	MarkerFolder = playerGui:FindFirstChild('Waypoints') :: Folder?
	if not MarkerFolder then
		MarkerFolder = Instance.new('Folder')
		MarkerFolder.Name = 'Waypoints'
		MarkerFolder.Parent = playerGui
	end

	-- Workstation tag — every existing instance + future additions.
	local WORKSTATION_TAG = 'Workstation'
	for _, m in CollectionService:GetTagged(WORKSTATION_TAG) do
		spawnWorkstationMarker(m)
	end
	CollectionService:GetInstanceAddedSignal(WORKSTATION_TAG):Connect(spawnWorkstationMarker)
	CollectionService:GetInstanceRemovedSignal(WORKSTATION_TAG):Connect(despawnMarker)

	-- Substation tag — same lifecycle as workstations, separate
	-- visibility category. The tag string lives on the Substations
	-- data module so server / client share one source of truth.
	local SUBSTATION_TAG = SubstationsData.Tag
	for _, m in CollectionService:GetTagged(SUBSTATION_TAG) do
		spawnSubstationMarker(m)
	end
	CollectionService:GetInstanceAddedSignal(SUBSTATION_TAG):Connect(spawnSubstationMarker)
	CollectionService:GetInstanceRemovedSignal(SUBSTATION_TAG):Connect(despawnMarker)

	-- Waystone tag — gate by save-data unlock check.
	local WAYSTONE_TAG = WaystonesData.WaystonesTag
	local taggedAtStart = CollectionService:GetTagged(WAYSTONE_TAG)
	print(string.format(
		'[WaypointsClient] Start: found %d tagged %q models in workspace',
		#taggedAtStart, WAYSTONE_TAG))
	for _, m in taggedAtStart do
		spawnWaystoneMarker(m)
	end
	CollectionService:GetInstanceAddedSignal(WAYSTONE_TAG):Connect(spawnWaystoneMarker)
	CollectionService:GetInstanceRemovedSignal(WAYSTONE_TAG):Connect(despawnMarker)

	-- PlayerData replication: re-check every tagged waystone so newly-
	-- unlocked ones spawn their marker.
	ReplicatedData.OnUpdated:Connect(function(category)
		if category == 'PlayerData' then
			refreshWaystoneMarkers()
		end
	end)
	-- Server-side unlock cue. Fires on each fresh unlock; refresh
	-- ensures the marker appears immediately even if PlayerData
	-- replication is throttled / batched.
	if WaystonesEvent then
		WaystonesEvent.OnClientEvent:Connect(function(_waystoneId)
			refreshWaystoneMarkers()
		end)
	end
	-- Initial refresh in case PlayerData replicated before Start ran
	-- (the race is a one-frame edge but cheap to defend).
	task.defer(refreshWaystoneMarkers)
	-- Belt-and-suspenders: a second deferred refresh ~1s in, after the
	-- usual server-side bootstrap window. Catches the case where
	-- ReplicatedData fired before our listener was wired.
	task.delay(1, refreshWaystoneMarkers)

	-- Settings: flip visibility per category when toggled.
	SettingsRegistry.Changed:Connect(function(key)
		if key == 'WaypointsWorkstationsEnabled'
			or key == 'WaypointsWaystonesEnabled'
			or key == 'WaypointsSubstationsEnabled'
		then
			refreshVisibility()
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Gameplay/CombatMotionClient"><![CDATA[-- // CombatMotionClient.luau //
-- Local movement responses to server-owned combat state.
--
-- See NIER_COMBAT.md for the design.
--
-- Two jobs:
--
--   1. Control lock during hard crowd control. While the server has us
--      stunned, knocked down, lifted or dragged, local input must stop
--      fighting the server's physics. Without this the client keeps
--      feeding walk input into a character the server is trying to
--      launch, and the result is a character that stutters mid-air.
--      Camera control is deliberately left alone — taking the camera
--      away during a knockdown is disorienting and buys nothing.
--
--   2. The guard and attack movement penalties, and the state
--      animations that follow from server-owned combat attributes.
--
--   3. Turning the character toward the target when a swing starts.
--      This lives on the client because it MUST: the local character's
--      HumanoidRootPart is client-owned, and a CFrame write from the
--      server replicates a transform captured half a round trip ago
--      back to a client that has already moved past it — which the
--      player sees as being snapped backwards on every attack. Only
--      the owner may write the transform, so the owner does the turn.
--
-- Everything here is driven from replicated ATTRIBUTES or from the
-- server's own ActionStarted broadcast, so the local character and
-- remote characters cannot disagree about who is stunned, and none of
-- it depends on an animation having loaded.

local Players = game:GetService('Players')
local RunService = game:GetService('RunService')

local LocalPlayer = Players.LocalPlayer

local PlayerModule = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('PlayerModule'))
local Controls = PlayerModule:GetControls()

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CombatConfigModule = ReplicatedModules.Data.CombatConfig
local CombatStatesData = ReplicatedModules.Data.CombatStates
local CombatShared = ReplicatedModules.Services.CombatShared
local CharacterStates = ReplicatedModules.Services.CharacterStates
local MaidClassModule = ReplicatedModules.Modules.Maid

local SystemsContainer = {}

local Module = {}

local CharacterMaid = MaidClassModule.New()
local ControlsDisabled = false

-- The character's WalkSpeed from BEFORE combat touched it. Captured
-- once, when the first modifier engages, and restored when the last one
-- clears. There is deliberately ONE cache for all combat modifiers:
-- with a cache per modifier, blocking during a swing would capture the
-- already-slowed attack speed as its "original" and restore the
-- character to 5 permanently.
local BaseWalkSpeed: number? = nil
-- os.clock() deadline for the attack movement penalty. Time-based
-- rather than attribute-based because the penalty spans the WHOLE swing
-- (windup through recovery), while the `Attacking` attribute is only
-- set for the active window.
local AttackSlowUntil = 0
local SpinConnection: RBXScriptConnection? = nil
local SpinRestoreAutoRotate: boolean? = nil

----------------------------------------------------------------------
-- Control lock.
----------------------------------------------------------------------
local function isHardCrowdControlled(character: Model): boolean
	for _, attribute in CombatStatesData.HardCrowdControlAttributes do
		if CharacterStates.GetStateTemporary(character, attribute) == true then
			return true
		end
	end
	return false
end

function Module.UpdateControls(character: Model)
	if not character then return end
	local shouldDisable = isHardCrowdControlled(character)
	-- Only touch the control module on an actual edge. Calling
	-- Enable()/Disable() every attribute change fights other systems
	-- (mounts, cinematics) that also own the controls.
	if shouldDisable == ControlsDisabled then return end
	ControlsDisabled = shouldDisable
	if shouldDisable then
		Controls:Disable()
	else
		Controls:Enable()
	end
end

----------------------------------------------------------------------
-- Combat movement penalties.
--
-- Guard and attack both slow the character rather than freezing it.
-- They resolve through ONE function against ONE cached base speed, and
-- the slowest active modifier wins, so overlapping states cannot leak a
-- modified speed into each other's "original" value.
----------------------------------------------------------------------
local function combatWalkSpeed(character: Model): number?
	local cfg = CombatConfigModule.CombatConfig
	local speed: number? = nil

	local function consider(value: number?)
		if not value then return end
		if speed == nil or value < speed then
			speed = value
		end
	end

	if CombatShared.IsCharacterBlocking(character) then
		consider(cfg.BLOCK_WALK_SPEED or 8)
	end
	if os.clock() < AttackSlowUntil then
		consider(cfg.ATTACK_WALK_SPEED or 5)
	end
	return speed
end

local function updateCombatMovement(character: Model)
	local humanoid = character:FindFirstChildOfClass('Humanoid')
	if not humanoid then return end

	local desired = combatWalkSpeed(character)
	if desired then
		-- Cache the LIVE speed, not a fixed default: a mount or buff may
		-- have set something other than 16, and restoring a hardcoded
		-- value would quietly strip it. Only the FIRST modifier to engage
		-- captures it.
		if BaseWalkSpeed == nil then
			BaseWalkSpeed = humanoid.WalkSpeed
		end
		humanoid.WalkSpeed = desired
	elseif BaseWalkSpeed ~= nil then
		humanoid.WalkSpeed = BaseWalkSpeed
		BaseWalkSpeed = nil
	end

	if CombatShared.IsCharacterBlocking(character) then
		CombatShared.SetupBlockingEffect(character)
	else
		CombatShared.ClearBlockingEffect(character)
	end
end

----------------------------------------------------------------------
-- Attack turn.
--
-- Spins the character toward the swing's target over the wind-up. This
-- is the ONLY thing an attack does to the local character's transform —
-- there is no step-in and no position lock; the player keeps walking,
-- just slowly.
--
-- Skipped entirely while a lock-on is active, because TargetLockClient
-- already writes HumanoidRootPart.CFrame every frame to face the locked
-- target and already owns Humanoid.AutoRotate. Two writers for one
-- transform is the wobble this whole module exists to avoid.
----------------------------------------------------------------------
local function stopSpin(character: Model?)
	if SpinConnection then
		SpinConnection:Disconnect()
		SpinConnection = nil
	end
	if SpinRestoreAutoRotate ~= nil then
		local humanoid = character and character:FindFirstChildOfClass('Humanoid')
		if humanoid then
			humanoid.AutoRotate = SpinRestoreAutoRotate
		end
		SpinRestoreAutoRotate = nil
	end
end

local function startSpin(character: Model, target: Model, duration: number)
	stopSpin(character)
	if duration <= 0 then return end

	local TargetLockClient = SystemsContainer.TargetLockClient
	if TargetLockClient and TargetLockClient.GetLockedTarget and TargetLockClient.GetLockedTarget() then
		return
	end

	local humanoid = character:FindFirstChildOfClass('Humanoid')
	local root = character:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not humanoid or not root then return end

	-- AutoRotate would turn the character toward its MoveDirection every
	-- frame, which fights the turn for exactly as long as the player is
	-- holding a key. Suspended for the wind-up and restored after, so
	-- normal movement facing resumes for the rest of the swing.
	SpinRestoreAutoRotate = humanoid.AutoRotate
	humanoid.AutoRotate = false

	local rate = CombatConfigModule.CombatConfig.ATTACK_TURN_RATE or 14
	local deadline = os.clock() + duration

	SpinConnection = RunService.RenderStepped:Connect(function(dt)
		local live = LocalPlayer.Character
		if live ~= character or not root.Parent or not target.Parent then
			stopSpin(character)
			return
		end
		-- Stand down the moment the server owns our physics; fighting a
		-- launch or a knockdown for a cosmetic turn is never worth it.
		if CombatShared.IsCharacterHardCrowdControlled(character) then
			stopSpin(character)
			return
		end

		local targetRoot = target:FindFirstChild('HumanoidRootPart') :: BasePart?
		if not targetRoot then
			stopSpin(character)
			return
		end

		-- Yaw only: the look point is forced to our own height so a
		-- target above or below never tips the character.
		local lookAt = Vector3.new(targetRoot.Position.X, root.Position.Y, targetRoot.Position.Z)
		if (lookAt - root.Position).Magnitude > 0.01 then
			local desired = CFrame.lookAt(root.Position, lookAt)
			-- Framerate-independent easing, and Lerp against a CFrame
			-- built at our own CURRENT position, so this rotates without
			-- ever translating the character.
			local alpha = 1 - math.exp(-rate * dt)
			root.CFrame = root.CFrame:Lerp(desired, alpha)
		end

		if os.clock() >= deadline then
			stopSpin(character)
		end
	end)
end

-- Called from CombatClient when the server confirms a swing started.
-- Ignored for every character but our own: remote players turn through
-- their own client's copy of this, replicated normally.
function Module.OnActionStarted(payload: any)
	if typeof(payload) ~= 'table' then return end
	local character = LocalPlayer.Character
	if not character or payload.Caster ~= character then return end

	local total = (payload.Windup or 0) + (payload.Active or 0) + (payload.Recovery or 0)
	if total > 0 then
		AttackSlowUntil = math.max(AttackSlowUntil, os.clock() + total)
		updateCombatMovement(character)
		-- Restore on expiry. Re-resolves rather than assuming, so a block
		-- that began during the swing keeps its own penalty.
		task.delay(total, function()
			local live = LocalPlayer.Character
			if live then
				updateCombatMovement(live)
			end
		end)
	end

	if typeof(payload.Target) == 'Instance' and payload.Target:IsA('Model') then
		startSpin(character, payload.Target, payload.Windup or 0.1)
	end
end

----------------------------------------------------------------------
-- Lock-on facing is NOT handled here.
--
-- TargetLockClient already owns it: it caches and clears
-- Humanoid.AutoRotate around the lock and rotates the character toward
-- the target inside its own camera step. Adding a second per-frame
-- writer for the same HumanoidRootPart CFrame would have the two
-- fighting each other on alternate frames.
--
-- The one thing that behaviour was missing — standing down while the
-- server owns the character's physics — was added to TargetLockClient's
-- step directly, via CombatShared.IsCharacterHardCrowdControlled.
----------------------------------------------------------------------

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.OnCharacterAdded(character: Model)
	CharacterMaid:Cleanup()
	stopSpin(nil)
	ControlsDisabled = false
	-- A fresh body starts from its own WalkSpeed. Carrying the previous
	-- character's cached base over would restore a dead rig's speed onto
	-- the new one.
	BaseWalkSpeed = nil
	AttackSlowUntil = 0
	Controls:Enable()

	local humanoid = character:WaitForChild('Humanoid', 5)
	if not humanoid then return end

	-- Wipe combat attributes inherited from a dying body through
	-- streaming or replication races.
	for _, attribute in {
		CombatStatesData.Attributes.Blocking,
		CombatStatesData.Attributes.BlockingCount,
		CombatStatesData.Attributes.Stunned,
		CombatStatesData.Attributes.KnockedDown,
		CombatStatesData.Attributes.Lifted,
		CombatStatesData.Attributes.Dragged,
		CombatStatesData.Attributes.Airborne,
		CombatStatesData.Attributes.Attacking,
	} do
		character:SetAttribute(attribute, nil)
	end

	local Animation = SystemsContainer.CombatAnimationClient

	local function bindStateAttribute(attribute: string, animationName: string?)
		CharacterMaid:Give(character:GetAttributeChangedSignal(attribute):Connect(function()
			Module.UpdateControls(character)
			if not animationName or not Animation then return end
			if character:GetAttribute(attribute) == true then
				Animation.PlayState(animationName)
			else
				Animation.StopState(animationName)
			end
		end))
	end

	bindStateAttribute(CombatStatesData.Attributes.Stunned, 'Stunned')
	bindStateAttribute(CombatStatesData.Attributes.KnockedDown, 'KnockedDown')
	bindStateAttribute(CombatStatesData.Attributes.Lifted, nil)
	bindStateAttribute(CombatStatesData.Attributes.Dragged, nil)

	CharacterMaid:Give(character:GetAttributeChangedSignal(CombatStatesData.Attributes.Blocking):Connect(function()
		updateCombatMovement(character)
		if not Animation then return end
		if CombatShared.IsCharacterBlocking(character) then
			Animation.PlayState('Blocking')
		else
			Animation.StopState('Blocking')
		end
	end))

	CharacterMaid:Give(humanoid.Died:Connect(function()
		stopSpin(character)
		ControlsDisabled = false
		BaseWalkSpeed = nil
		AttackSlowUntil = 0
		Controls:Enable()
		humanoid.AutoRotate = true
		CombatShared.ClearBlockingEffect(character)
	end))
end

function Module.Start()
	-- Safety net for the control lock AND the movement penalty. Both are
	-- driven by events — attribute signals and ActionStarted — and both
	-- would strand the character if an event were lost: controls stuck
	-- disabled, or WalkSpeed stuck at 5 because the swing that slowed it
	-- ended while the character was streamed out. A low-frequency
	-- reconcile makes either unrecoverable case merely brief.
	task.spawn(function()
		while true do
			task.wait(0.5)
			local character = LocalPlayer.Character
			if character then
				Module.UpdateControls(character)
				updateCombatMovement(character)
			end
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Gameplay/CombatInputClient"><![CDATA[-- // CombatInputClient.luau //
-- Input binding, local input buffering, and intent dispatch.
--
-- See NIER_COMBAT.md for the design.
--
-- The buffer is the reason this is its own module. Previously an input
-- that arrived while a swing was still running was simply dropped: the
-- client fired anyway, the server refused it because the attack
-- cooldown covered the entire move, and the press vanished. At the
-- rhythm a player naturally mashes, that loses roughly one input in
-- three and reads as the game ignoring you.
--
-- Now an early input is HELD and replayed the instant the running move
-- reaches its authored cancel point. The server buffers on the same
-- rule against the same numbers, so a replayed input is accepted rather
-- than merely re-rejected. One input is held at a time — mashing five
-- times during a slow hammer swing queues one follow-up, not five.

local ContextActionService = game:GetService('ContextActionService')
local UserInputService = game:GetService('UserInputService')
local Players = game:GetService('Players')

local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CombatConfigModule = ReplicatedModules.Data.CombatConfig
local CombatActions = ReplicatedModules.Data.CombatActions
local CombatShared = ReplicatedModules.Services.CombatShared
local ReplicatedData = ReplicatedModules.Services.ReplicatedData

local RemoteService = ReplicatedModules.Services.RemoteService
local CombatEvent = RemoteService.GetRemote('CombatEvent', 'RemoteEvent', false)

local LocalSettingsRegistry =
	require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules')).Modules.SettingsRegistry

local SystemsContainer = {}

local Module = {}

local HeldKeys: { [Enum.KeyCode]: boolean } = {}
local BufferedAttack: any? = nil
local SwingStep = 0

-- Default keybinds. Players override these in the settings keybind tab;
-- PlayerData.ActionKeybinds[actionId] holds the override.
local DEFAULT_ACTION_KEYBINDS: { [string]: string } = {
	Block         = 'F',
	SheatheToggle = 'Q',
	Mount         = 'G',
	Heal          = 'H',
	Dash          = 'LeftControl',
	HeavyAttack   = 'T',
}

-- How long a directional dash mode waits for a WASD press before giving
-- up. Long enough to be usable, short enough not to feel like a stall.
local DASH_DIRECTIONAL_TIMEOUT = 0.5

local function getActionKeyCode(actionId: string): Enum.KeyCode?
	local data = ReplicatedData.GetData('PlayerData', false)
	local override = data and typeof(data.ActionKeybinds) == 'table' and data.ActionKeybinds[actionId]
	local name = (typeof(override) == 'string' and #override > 0)
		and override
		or DEFAULT_ACTION_KEYBINDS[actionId]
	if not name then return nil end
	local ok, keyCode = pcall(function() return (Enum.KeyCode :: any)[name] end)
	if not ok then return nil end
	return keyCode
end

----------------------------------------------------------------------
-- Direction helpers for dodge.
----------------------------------------------------------------------
local function getInputMovementDir(): Vector3
	local x, z = 0, 0
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then z -= 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then z += 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then x -= 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then x += 1 end
	if x == 0 and z == 0 then return Vector3.zero end
	return Vector3.new(x, 0, z).Unit
end

local function waitForDirectionalKey(timeout: number): Vector3?
	local resolved: Vector3? = nil
	local connection = UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		local x, z = 0, 0
		if input.KeyCode == Enum.KeyCode.W then z = -1
		elseif input.KeyCode == Enum.KeyCode.S then z = 1
		elseif input.KeyCode == Enum.KeyCode.A then x = -1
		elseif input.KeyCode == Enum.KeyCode.D then x = 1
		else return
		end
		resolved = Vector3.new(x, 0, z).Unit
	end)
	local deadline = os.clock() + timeout
	while resolved == nil and os.clock() < deadline do task.wait() end
	connection:Disconnect()
	return resolved
end

-- Map input-space (forward = -Z, right = +X) into world space using
-- either the camera's or the character's flattened basis.
local function inputDirToWorld(inputDir: Vector3, useCamera: boolean): Vector3
	local basis
	if useCamera then
		local camera = workspace.CurrentCamera
		if not camera then return inputDir end
		basis = camera.CFrame
	else
		local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild('HumanoidRootPart') :: BasePart?
		if not root then return inputDir end
		basis = root.CFrame
	end
	local forward = Vector3.new(basis.LookVector.X, 0, basis.LookVector.Z)
	forward = forward.Magnitude > 0 and forward.Unit or Vector3.new(0, 0, -1)
	local right = Vector3.new(-forward.Z, 0, forward.X)
	return (right * inputDir.X) + (forward * -inputDir.Z)
end

local function getLockedTarget(): Model?
	local TargetLockClient = SystemsContainer.TargetLockClient
	if not TargetLockClient or not TargetLockClient.GetLockedTarget then return nil end
	return TargetLockClient.GetLockedTarget()
end

-- Resolve the dodge direction from the player's chosen dash mode, with
-- a lock-on override: while locked, the dodge basis is target-relative
-- so forward closes, back retreats and the strafes circle. That is the
-- lock-on evade the whole camera mode exists to support.
local function resolveDodgeDirection(character: Model): Vector3?
	local lockedTarget = getLockedTarget()
	if lockedTarget then
		local root = character:FindFirstChild('HumanoidRootPart') :: BasePart?
		local targetRoot = lockedTarget:FindFirstChild('HumanoidRootPart') :: BasePart?
		if root and targetRoot then
			local forward = Vector3.new(
				targetRoot.Position.X - root.Position.X, 0,
				targetRoot.Position.Z - root.Position.Z)
			forward = forward.Magnitude > 0 and forward.Unit or Vector3.new(0, 0, -1)
			local right = Vector3.new(-forward.Z, 0, forward.X)
			local input = getInputMovementDir()
			if input.Magnitude > 0.1 then
				local direction = (right * input.X) + (forward * -input.Z)
				return direction.Magnitude > 0 and direction.Unit or forward
			end
			-- No stick input while locked: step toward the target.
			return forward
		end
	end

	local mode = LocalSettingsRegistry.DashMode or 'CameraDirection'

	if mode == 'CameraDirection' or mode == 'CharacterDirection' then
		local useCamera = mode == 'CameraDirection'
		local input = getInputMovementDir()
		if input.Magnitude > 0.1 then
			return inputDirToWorld(input, useCamera)
		end
		-- Idle: backstep relative to the chosen basis.
		local basis
		if useCamera then
			basis = workspace.CurrentCamera and workspace.CurrentCamera.CFrame
		else
			local root = character:FindFirstChild('HumanoidRootPart') :: BasePart?
			basis = root and root.CFrame
		end
		if not basis then return Vector3.new(0, 0, 1) end
		local forward = Vector3.new(basis.LookVector.X, 0, basis.LookVector.Z)
		return forward.Magnitude > 0 and -forward.Unit or Vector3.new(0, 0, 1)
	end

	if mode == 'CharacterDirectionalKey' or mode == 'CameraDirectionalKey' then
		local input = waitForDirectionalKey(DASH_DIRECTIONAL_TIMEOUT)
		if not input then return nil end
		return inputDirToWorld(input, mode == 'CameraDirectionalKey')
	end

	return nil
end

----------------------------------------------------------------------
-- Attack dispatch.
----------------------------------------------------------------------
local function sendAttack(inputKind: string, comboKey: string, target: Model?)
	CombatEvent:FireServer(
		inputKind == CombatActions.InputKinds.Heavy
			and CombatActions.Actions.RequestHeavyAttack
			or CombatActions.Actions.RequestLightAttack,
		{
			CommandId = SystemsContainer.CombatPredictionClient.AllocateCommandId(),
			InputKind = inputKind,
			ComboKey = comboKey,
			TargetInstance = target,
			ClientTime = workspace:GetServerTimeNow(),
		})
end

-- Snap to face a locked target on swing input, so a forward-facing
-- animation visually connects. Purely cosmetic: the server recomputes
-- the hitbox from its own view of the character.
local function orientTowardTarget(character: Model, target: Model)
	local root = character:FindFirstChild('HumanoidRootPart') :: BasePart?
	local targetRoot = target:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not root or not targetRoot then return end
	local from = root.Position
	local to = Vector3.new(targetRoot.Position.X, from.Y, targetRoot.Position.Z)
	if (to - from).Magnitude < 0.1 then return end
	character:PivotTo(CFrame.lookAt(from, to))
end

local function getStrengthSpeedBonus(): number
	local data = ReplicatedData.GetData('PlayerData', false)
	local level = 0
	if data and typeof(data.Attributes) == 'table' then
		local entry = data.Attributes.Strength
		if typeof(entry) == 'number' then
			level = entry
		elseif typeof(entry) == 'table' and tonumber(entry.Level) then
			level = entry.Level
		end
	end
	-- +1% playback speed per level. Visual only — the gameplay window is
	-- fixed by the move recipe, so a high-Strength player's swing looks
	-- crisper without actually having different active frames.
	return 1 + level * 0.01
end

local function wieldTypeName(character: Model): string
	local wieldType = CombatShared.GetWeaponWieldType(character)
	if wieldType == CombatShared.WEAPON_WIELD_TYPES.DUAL then return 'DualHand' end
	if wieldType == CombatShared.WEAPON_WIELD_TYPES.LEFT then return 'LeftHand' end
	return 'RightHand'
end

function Module.AttemptAttack(inputKind: string)
	local character = LocalPlayer.Character
	if not character then return end

	local Prediction = SystemsContainer.CombatPredictionClient
	local Animation = SystemsContainer.CombatAnimationClient

	-- Situational gate only. Whether an in-flight move can be chained
	-- into is a separate question, answered next.
	local canAttack, _reason = CombatShared.CanCharacterAttack(character)
	if not canAttack then return end

	local allowed, remaining = Prediction.CanChainNow(inputKind)
	if not allowed then
		local buffer = CombatConfigModule.CombatConfig.COMBO_BUFFER or 0.18
		if remaining > buffer * 2 then
			-- Far too early to be a chain attempt; treat as a stray press.
			return
		end
		-- Hold it and replay at the cancel point. Overwrites any previous
		-- queued input rather than stacking.
		local queued = { InputKind = inputKind }
		BufferedAttack = queued
		task.delay(remaining, function()
			if BufferedAttack ~= queued then return end
			BufferedAttack = nil
			Module.AttemptAttack(queued.InputKind)
		end)
		return
	end

	local target = getLockedTarget()
	if target then
		orientTowardTarget(character, target)
	end

	local comboKey, move, activeClass = Prediction.PredictAttack(character, inputKind)
	sendAttack(inputKind, comboKey, target)

	SwingStep += 1
	if Animation then
		Animation.PlayMoveAnimation(activeClass, move, wieldTypeName(character), SwingStep, getStrengthSpeedBonus())
	end
end

function Module.AttemptDodge()
	local character = LocalPlayer.Character
	if not character then return end

	local canDodge, _reason = CombatShared.CanCharacterDodge(character)
	if not canDodge then return end

	local direction = resolveDodgeDirection(character)
	if direction then
		direction = Vector3.new(direction.X, 0, direction.Z)
		direction = direction.Magnitude > 0 and direction.Unit or nil
	end

	-- A dodge is a hard combat-state break: drop any queued input so a
	-- buffered swing cannot fire out of the evade.
	BufferedAttack = nil
	SystemsContainer.CombatPredictionClient.ResetCombo()

	CombatEvent:FireServer(CombatActions.Actions.RequestDodge, {
		CommandId = SystemsContainer.CombatPredictionClient.AllocateCommandId(),
		Direction = direction,
		ClientTime = workspace:GetServerTimeNow(),
	})
end

function Module.AttemptGuardHold(keyCode: Enum.KeyCode)
	local character = LocalPlayer.Character
	if not character then return end
	local canGuard, _reason = CombatShared.CanCharacterStartBlock(character)
	if not canGuard then return end

	BufferedAttack = nil
	SystemsContainer.CombatPredictionClient.ResetCombo()
	CombatEvent:FireServer(CombatActions.Actions.RequestGuardStart, {})

	-- Hold-to-guard: wait for the guard to actually come up, then for
	-- either the key release or the guard breaking.
	task.spawn(function()
		while HeldKeys[keyCode] and not CombatShared.IsCharacterBlocking(character) do
			task.wait(0.05)
		end
		while HeldKeys[keyCode] and CombatShared.IsCharacterBlocking(character) do
			task.wait(0.05)
		end
		CombatEvent:FireServer(CombatActions.Actions.RequestGuardEnd, {})
	end)
end

function Module.AttemptWeaponToggle()
	local character = LocalPlayer.Character
	if not character then return end
	local light = CombatShared.DoesCharacterHaveLeftWeapon(character)
	local heavy = CombatShared.DoesCharacterHaveRightWeapon(character)
	if not light and not heavy then return end
	CombatEvent:FireServer(CombatActions.Actions.RequestWeaponToggle, {})
end

----------------------------------------------------------------------
-- Binding.
--
-- Keyboard actions go through UserInputService rather than
-- ContextActionService because players may rebind to any key, and CAS
-- needs its key list fixed at bind time. Resolving the action from the
-- LIVE keybind map at press time means a rebind takes effect instantly
-- with no re-binding pass.
----------------------------------------------------------------------
local function dispatchKey(keyCode: Enum.KeyCode): boolean
	local handlers: { [string]: (Enum.KeyCode) -> () } = {
		Block = function(key) Module.AttemptGuardHold(key) end,
		SheatheToggle = function() Module.AttemptWeaponToggle() end,
		Dash = function() Module.AttemptDodge() end,
		HeavyAttack = function() Module.AttemptAttack(CombatActions.InputKinds.Heavy) end,
		Mount = function()
			local MountsClient = SystemsContainer.MountsClient
			if MountsClient and MountsClient.IsMounted and MountsClient.IsMounted()
				and MountsClient.AttemptDismount then
				MountsClient.AttemptDismount()
			end
		end,
	}
	for actionId, handler in handlers do
		if getActionKeyCode(actionId) == keyCode then
			handler(keyCode)
			return true
		end
	end
	return false
end

function Module.BindInputs()
	ContextActionService:BindAction('CombatPrimaryAttack', function(actionName, inputState)
		if actionName ~= 'CombatPrimaryAttack' then
			return Enum.ContextActionResult.Pass
		end
		if inputState == Enum.UserInputState.Begin then
			-- Deferred so a long-running handler cannot stall the input
			-- pipeline for the rest of the frame.
			task.defer(Module.AttemptAttack, CombatActions.InputKinds.Light)
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.UserInputType.MouseButton1)
	ContextActionService:SetTitle('CombatPrimaryAttack', 'Attack')
	ContextActionService:SetImage('CombatPrimaryAttack', 'rbxassetid://7485051715')

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		HeldKeys[input.KeyCode] = true
		dispatchKey(input.KeyCode)
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		-- Cleared regardless of `processed`: releasing a key while a
		-- text box has focus still has to end a held guard, or the
		-- character stays locked in a block forever.
		HeldKeys[input.KeyCode] = nil
	end)
end

function Module.ReleaseInputs()
	ContextActionService:UnbindAction('CombatPrimaryAttack')
	table.clear(HeldKeys)
	BufferedAttack = nil
end

function Module.OnCharacterAdded()
	table.clear(HeldKeys)
	BufferedAttack = nil
	SwingStep = 0
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

function Module.Start() end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Gameplay/CombatPredictionClient"><![CDATA[-- // CombatPredictionClient.luau //
-- Local combo prediction and server reconciliation.
--
-- See NIER_COMBAT.md for the design.
--
-- The client predicts exactly two things: which move its next input
-- will produce, and when that move becomes cancelable. Both are derived
-- from the SAME shared modules the server uses, so agreement is the
-- default and divergence is the exception rather than something we have
-- to actively keep in sync.
--
-- Everything else — whether the swing is allowed, what it hits, how
-- much it does, where anyone ends up — is the server's, and arrives
-- back as ActionStarted / ActionRejected.
--
-- Reconciliation policy: the server's combo string always wins, and it
-- wins silently. A rejected command rolls the local chain back to the
-- last server-confirmed state rather than clearing it, so one dropped
-- input costs the player one swing rather than their whole combo.

local Players = game:GetService('Players')
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CombatConfigModule = ReplicatedModules.Data.CombatConfig
local CombatShared = ReplicatedModules.Services.CombatShared
local CombosShared = ReplicatedModules.Services.CombosShared

local SystemsContainer = {}

local Module = {}

-- Monotonic per-session. The server keeps a high-water mark and rejects
-- anything at or below it, so these must never repeat or go backwards.
local NextCommandId = 0

local PredictedCombo: { string } = {}
local ConfirmedCombo: { string } = {}
local LastSentCommandId = 0
local LastConfirmedCommandId = 0

-- The move we believe is currently running, and when we started it.
-- Used purely to decide whether the next input can cancel into a chain
-- or has to be buffered.
local CurrentMove: any? = nil
local CurrentMoveStartedAt = 0
local LastInputAt = 0

local function copyCombo(combo: { string }): { string }
	local copy = {}
	for index, letter in combo do copy[index] = letter end
	return copy
end

function Module.AllocateCommandId(): number
	NextCommandId += 1
	LastSentCommandId = NextCommandId
	return NextCommandId
end

----------------------------------------------------------------------
-- Context + class resolution, mirroring the server's own resolution.
----------------------------------------------------------------------
function Module.ResolveActiveClass(character: Model): string
	local lightClass, heavyClass = CombatShared.GetActiveWeaponClasses(character)
	return CombosShared.ResolveActiveClass(lightClass, heavyClass)
end

function Module.ResolveContext(character: Model): string
	return CombosShared.ResolveContext(
		CombatShared.IsCharacterAirborne(character),
		CombatShared.IsPerfectCounterActive(character))
end

----------------------------------------------------------------------
-- Cancel windows.
--
-- Returns (allowed, secondsUntilAllowed). A caller that gets
-- allowed=false with a small remainder should buffer the input; the
-- server applies the same rule to the same move, so a buffered input
-- replayed at the cancel point is accepted rather than rejected.
----------------------------------------------------------------------
function Module.CanChainNow(inputKind: string): (boolean, number)
	if not CurrentMove then return true, 0 end

	local elapsed = os.clock() - CurrentMoveStartedAt
	-- A move whose whole timeline has elapsed is finished regardless of
	-- whether we ever heard back about it, so a dropped ActionStarted
	-- cannot wedge the local chain permanently.
	if elapsed >= (CurrentMove.Total or 0) then
		CurrentMove = nil
		return true, 0
	end

	local buffer = CombatConfigModule.CombatConfig.COMBO_BUFFER or 0.18
	return CombosShared.CanCancelInto(CurrentMove, elapsed, inputKind, buffer)
end

----------------------------------------------------------------------
-- Prediction.
--
-- Advances the local chain and returns the move we expect. The caller
-- sends the resolved key to the server as a CLAIM; the server compares
-- it against its own chain and downgrades the swing on mismatch rather
-- than rejecting, so a desynced client degrades gracefully.
----------------------------------------------------------------------
function Module.PredictAttack(character: Model, inputKind: string): (string, any, string)
	local cfg = CombatConfigModule.CombatConfig
	local activeClass = Module.ResolveActiveClass(character)
	local context = Module.ResolveContext(character)

	local currentTime = os.clock()
	if (currentTime - LastInputAt) > (cfg.COMBO_RESET_WINDOW or 1.5) then
		PredictedCombo = {}
	end
	LastInputAt = currentTime

	PredictedCombo = CombosShared.AppendInput(
		PredictedCombo, inputKind, cfg.COMBO_MAX_LENGTH or 4, activeClass, context)

	local key, move = CombosShared.ResolveComboKey(PredictedCombo, activeClass, context)

	CurrentMove = move
	CurrentMoveStartedAt = currentTime

	if move.IsFinisher then
		-- Mirror the server: the finisher fires on this key, and the
		-- NEXT press starts a fresh chain.
		PredictedCombo = {}
	end
	return key, move, activeClass
end

function Module.GetCurrentMove(): any?
	return CurrentMove
end

function Module.ResetCombo()
	PredictedCombo = {}
	ConfirmedCombo = {}
	CurrentMove = nil
	LastInputAt = 0
end

----------------------------------------------------------------------
-- Reconciliation.
----------------------------------------------------------------------

-- The server started an action for us. Adopt its combo string verbatim.
function Module.OnActionStarted(payload: any)
	if typeof(payload) ~= 'table' then return end
	if payload.Caster ~= LocalPlayer.Character then return end
	local commandId = payload.CommandId
	if typeof(commandId) ~= 'number' or commandId <= LastConfirmedCommandId then return end

	LastConfirmedCommandId = commandId

	if payload.IsFinisher then
		PredictedCombo = {}
	elseif typeof(payload.ComboKey) == 'string' then
		local adopted = {}
		for index = 1, #payload.ComboKey do
			adopted[index] = string.sub(payload.ComboKey, index, index)
		end
		PredictedCombo = adopted
	end
	ConfirmedCombo = copyCombo(PredictedCombo)
	LastInputAt = os.clock()

	-- Deliberately NOT re-anchoring the local move timeline here.
	--
	-- The payload carries Windup/Active/Recovery, and it is tempting to
	-- rebuild CurrentMove from them — but the payload has no CancelFrom
	-- fractions, so the rebuilt move would have no cancel points and the
	-- local chain would stall until its total duration elapsed.
	--
	-- It is also unnecessary. Both sides resolve the same recipe from
	-- CombatMovesets, so the durations already agree; the only
	-- difference is the start instant, and the client's is EARLIER than
	-- the server's by the trip time. That skew is in the safe direction:
	-- the client reaches its cancel point first and sends, and if the
	-- server is not there yet it buffers the input and replays it. The
	-- reverse skew would produce rejections.
end

-- The server refused a command. Roll back to the last confirmed chain
-- and drop the predicted animation.
function Module.OnActionRejected(payload: any)
	if typeof(payload) ~= 'table' then return end
	if payload.CommandId ~= LastSentCommandId then return end

	PredictedCombo = copyCombo(ConfirmedCombo)
	CurrentMove = nil
	LastInputAt = os.clock()

	local AnimationClient = SystemsContainer.CombatAnimationClient
	if AnimationClient then
		AnimationClient.StopAttackAnimations()
	end
end

-- The action was cancelled server-side (dodge, stun, death, or a chain
-- cancel into the next move). A chain cancel is immediately followed by
-- a new ActionStarted, so the combo is deliberately NOT cleared here —
-- only the local move timeline is released.
function Module.OnActionCancelled(payload: any)
	if typeof(payload) ~= 'table' then return end
	if payload.Caster ~= LocalPlayer.Character then return end

	CurrentMove = nil
	if payload.Reason ~= 'ChainCancel' then
		PredictedCombo = {}
		ConfirmedCombo = {}
		local AnimationClient = SystemsContainer.CombatAnimationClient
		if AnimationClient then
			AnimationClient.StopAttackAnimations()
		end
	end
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

function Module.Start() end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Gameplay/CombatAnimationClient"><![CDATA[-- // CombatAnimationClient.luau //
-- The only place combat touches an AnimationTrack.
--
-- See NIER_COMBAT.md for the design.
--
-- THIS MODULE IS ALLOWED TO FAIL. Every function here is a cosmetic
-- side effect with no return value the rest of combat consults. If an
-- asset id is wrong, an animation never replicates, `LoadAnimation`
-- throws, or a whole AttackSet is missing, the player sees a character
-- that swings without flourish — and every hitbox, timing, state
-- transition, launch and slam still resolves exactly as authored.
--
-- That property used to be untrue in a subtle way. The old client read
-- `track.Length` off loaded animations, fed it into a timing resolver,
-- and shipped the result to the server as the swing's active/recovery
-- window. The server ignored those numbers, so the visible swing and
-- the real hit window silently disagreed by however much the animation
-- differed from the authored duration — and only when the asset had
-- finished loading, making it a race. Animation length is no longer
-- read anywhere. The one remaining use of duration is the OPPOSITE
-- direction: we scale playback speed to fit the authored window, so the
-- visual matches gameplay rather than the other way round.

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CombatConfigModule = ReplicatedModules.Data.CombatConfig
local AnimationService = ReplicatedModules.Services.AnimationService

local Module = {}

-- Per-class loaded slot dictionaries, rebuilt on respawn.
local SlotTracksByClass: { [string]: { [string]: AnimationTrack } } = {}
-- Legacy per-hand arrays, kept as a round-robin fallback for classes
-- whose per-slot entries have not been authored yet.
local HandTracksByClass: { [string]: { [string]: { AnimationTrack } } } = {}
local StateTracks: { [string]: AnimationTrack } = {}
local ActiveAnimator: Animator? = nil

----------------------------------------------------------------------
-- Loading. Nothing below may throw into a caller.
----------------------------------------------------------------------
local function safeLoad(animator: Animator, value: any): AnimationTrack?
	if typeof(value) ~= 'string' and typeof(value) ~= 'number' then return nil end
	local ok, track = pcall(function()
		local resolved = AnimationService.ResolveAnimationValue(value)
		if not resolved then return nil end
		return animator:LoadAnimation(resolved)
	end)
	if not ok then return nil end
	return track
end

-- Loads one weapon class's set on demand. Returns two tables, either of
-- which may legitimately be empty.
local function ensureClassLoaded(weaponClass: string)
	if SlotTracksByClass[weaponClass] then return end

	local slots: { [string]: AnimationTrack } = {}
	local hands: { [string]: { AnimationTrack } } = {}
	SlotTracksByClass[weaponClass] = slots
	HandTracksByClass[weaponClass] = hands

	local animator = ActiveAnimator
	if not animator then return end

	local set = CombatConfigModule.AttackSets[weaponClass]
		or CombatConfigModule.AttackSets.Default
		or {}

	for key, value in set do
		if typeof(value) == 'table' then
			-- Hand arrays (LeftHand / RightHand / DualHand). The shared
			-- dictionary loader skips nested tables entirely, which is
			-- why the previous hand fallback silently resolved to nil
			-- for every class — handled explicitly here instead.
			local tracks = {}
			for _, entry in value do
				local track = safeLoad(animator, entry)
				if track then tracks[#tracks + 1] = track end
			end
			hands[key] = tracks
		else
			local track = safeLoad(animator, value)
			if track then slots[key] = track end
		end
	end
end

----------------------------------------------------------------------
-- Playback.
----------------------------------------------------------------------

-- Round-robin fallback so an unauthored slot still shows SOMETHING
-- class-appropriate rather than a frozen character.
local function pickFallback(weaponClass: string, wieldType: string, step: number): AnimationTrack?
	local hands = HandTracksByClass[weaponClass]
	local tracks = hands and hands[wieldType]
	if not tracks or #tracks == 0 then return nil end
	return tracks[((step - 1) % #tracks) + 1]
end

-- Plays the animation for a move. `move` is the authored recipe; the
-- only field read from it is the cosmetic slot name plus the total
-- duration used to fit playback speed.
--
-- `speedBonus` is the caller's stat-derived multiplier (Strength swing
-- speed). It is applied to PLAYBACK ONLY and never travels back into
-- gameplay timing.
function Module.PlayMoveAnimation(weaponClass: string, move: any, wieldType: string, step: number, speedBonus: number?)
	if typeof(weaponClass) ~= 'string' or typeof(move) ~= 'table' then return end
	ensureClassLoaded(weaponClass)

	local slots = SlotTracksByClass[weaponClass]
	local track = (slots and move.AnimationSlot) and slots[move.AnimationSlot] or nil
	if not track then
		track = pickFallback(weaponClass, wieldType or 'RightHand', step or 1)
	end
	if not track then return end

	local speed = speedBonus or 1
	-- Fit the clip into the authored window. `Length` is 0 until the
	-- asset finishes replicating, in which case we simply play at
	-- natural speed — a slightly mistimed visual, never a wrong hitbox.
	local ok, length = pcall(function() return track.Length end)
	if ok and typeof(length) == 'number' and length > 0 and (move.Total or 0) > 0 then
		speed *= (length / move.Total)
	end

	pcall(function()
		track:Play(0.1, 1, speed)
	end)
end

function Module.StopAttackAnimations(fadeTime: number?)
	for _, slots in SlotTracksByClass do
		for _, track in slots do
			pcall(function()
				if track.IsPlaying then track:Stop(fadeTime or 0.08) end
			end)
		end
	end
	for _, hands in HandTracksByClass do
		for _, tracks in hands do
			for _, track in tracks do
				pcall(function()
					if track.IsPlaying then track:Stop(fadeTime or 0.08) end
				end)
			end
		end
	end
end

----------------------------------------------------------------------
-- State animations (stunned, knocked down, guarding, sheathe).
--
-- These are driven from replicated ATTRIBUTES rather than from local
-- prediction, so what the player sees always agrees with the state the
-- server believes they are in.
----------------------------------------------------------------------
function Module.PlayState(name: string, fadeTime: number?)
	local track = StateTracks[name]
	if not track then return end
	pcall(function()
		if not track.IsPlaying then track:Play(fadeTime or 0.1) end
	end)
end

function Module.StopState(name: string, fadeTime: number?)
	local track = StateTracks[name]
	if not track then return end
	pcall(function()
		if track.IsPlaying then track:Stop(fadeTime or 0.1) end
	end)
end

function Module.PlayStateOnce(name: string, speed: number?)
	local track = StateTracks[name]
	if not track then return end
	pcall(function()
		track:Play(0.1, 1, speed or 1)
	end)
end

function Module.HasState(name: string): boolean
	return StateTracks[name] ~= nil
end

----------------------------------------------------------------------
-- Character lifecycle.
----------------------------------------------------------------------
function Module.BindCharacter(character: Model)
	table.clear(SlotTracksByClass)
	table.clear(HandTracksByClass)
	table.clear(StateTracks)
	ActiveAnimator = nil

	local humanoid = character:FindFirstChildWhichIsA('Humanoid')
	if not humanoid then return end

	local animator = humanoid:FindFirstChildWhichIsA('Animator')
	if not animator then
		animator = Instance.new('Animator')
		animator.Parent = humanoid
	end
	ActiveAnimator = animator

	local set = CombatConfigModule.AnimationSets.Default or {}
	for key, value in set do
		if typeof(value) ~= 'table' then
			local track = safeLoad(animator, value)
			if track then StateTracks[key] = track end
		end
	end
end

function Module.UnbindCharacter()
	table.clear(SlotTracksByClass)
	table.clear(HandTracksByClass)
	table.clear(StateTracks)
	ActiveAnimator = nil
end

function Module.Init(_otherSystems) end
function Module.Start() end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Miscellaneous"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Miscellaneous/FadeTest"><![CDATA[-- Full-screen black fade overlay used during boot + waystone teleports.
-- Ported off the legacy GameInterface.Fade template to a self-owned ScreenGui.

local TweenService = game:GetService('TweenService')
local ReplicatedFirst = game:GetService('ReplicatedFirst')

local Players = game:GetService('Players')
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local ReplicatedData = ReplicatedModules.Services.ReplicatedData

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon

local SystemsContainer = {}

local FadeFrame: Frame = nil :: any

local function ensureFade()
	if FadeFrame and FadeFrame.Parent then return FadeFrame end
	local gui = HUDCommon.ensureScreenGui('HUD_Fade', 100)
	local frame = Instance.new('Frame')
	frame.Name = 'Fade'
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.new(0, 0, 0)
	frame.BackgroundTransparency = 0
	frame.BorderSizePixel = 0
	frame.ZIndex = 1000
	frame.Parent = gui
	FadeFrame = frame
	return frame
end

-- // Module // --
local Module = {}

function Module.FadeInBlack(duration: number?)
	local f = ensureFade()
	TweenService:Create(f, TweenInfo.new(duration or 1), { BackgroundTransparency = 0 }):Play()
end

function Module.FadeOutBlack(duration: number?)
	local f = ensureFade()
	TweenService:Create(f, TweenInfo.new(duration or 1), { BackgroundTransparency = 1 }):Play()
end

function Module.Start()
	task.spawn(function()
		local f = ensureFade()
		f.BackgroundTransparency = 0
		ReplicatedFirst:RemoveDefaultLoadingScreen()
		task.wait(3)
		ReplicatedData.GetData('PlayerData', true)
		Module.FadeOutBlack()
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Miscellaneous/SoftShutdown"><![CDATA[local HttpService = game:GetService('HttpService')
local TweenService = game:GetService('TweenService')
local Lighting = game:GetService('Lighting')

local Players = game:GetService('Players')
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')

local SoftShutdownUI = ReplicatedAssets.UI:FindFirstChild('SoftShutdown')
assert(SoftShutdownUI, 'SoftShutdown UI could not be found.')
local MaintenanceUI = ReplicatedAssets.UI:FindFirstChild('Maintenance')
assert(MaintenanceUI, 'Maintenance UI could not be found.')

local SystemsContainer = {}

local HasShutdown = false
local HasTimerStarted = false
local LastWidgetPrompt = false

local ReminderTimeValues = { 300, 600, 1800, 3600 } -- countdown 3m, 10m, 30m, 1hr

local function GetHrsMinSec(seconds)
	local hrs = math.floor(seconds / 360)
	seconds -= (hrs * 360)
	local minutes = math.floor(seconds / 60)
	seconds -= (minutes * 60)
	return hrs, minutes, math.floor(seconds)
end

local function FormatTimerSplice(seconds)
	local hrs, min, sec = GetHrsMinSec(seconds)
	local hrtxt = hrs>0 and hrs..'hr' or '0h'
	local mtxt = min>0 and min..'m' or '0m'
	local stxt = sec>0 and sec..'s' or '0s'
	return hrs>0 and hrtxt..' '..mtxt or mtxt..' '..stxt
end

-- // Module // --
local Module = {}

function Module.OnSoftShutdown()
	local PlayerGui = LocalPlayer:WaitForChild('PlayerGui')
	for _, UIInstance in PlayerGui:GetChildren() do
		UIInstance.Enabled = false
	end

	local Item = SoftShutdownUI:Clone()
	Item.Parent = PlayerGui

	local ResultSize = Item.ShutdownBlur.Size
	Item.ShutdownBlur.Size = 0
	Item.ShutdownBlur.Enabled = true
	TweenService:Create(Item.ShutdownBlur, TweenInfo.new(1), {Size = ResultSize}):Play()
	Item.ShutdownBlur.Parent = Lighting

	Item.Notification:Play()
	task.delay(0.5, function()
		Item.Piano:Play()
	end)

	Item.Enabled = true
end

function Module.CheckSoftShutdownState()
	if HasShutdown or not workspace:GetAttribute('SoftShutdownEnabled') then
		return
	end
	HasShutdown = true
	print('SoftShutdown has occured.')

	workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable

	local Sound = SystemsContainer.ParentSystems.Gameplay.MusicClient.MusicSoundInstance
	local Tween = TweenService:Create( Sound, TweenInfo.new(1.5), {Volume = 0} )
	Tween.Completed:Connect(function()
		Sound:Destroy()
	end)
	Tween:Play()

	Module.OnSoftShutdown()
end

local ActiveMaintenanceUI = false
local UUID = HttpService:GenerateGUID(false)

function Module.ForceMaintenancePrompt(message)
	if not ActiveMaintenanceUI then
		ActiveMaintenanceUI = MaintenanceUI:Clone()
		ActiveMaintenanceUI.Enabled = true
		ActiveMaintenanceUI.Notification:Play()
		ActiveMaintenanceUI.Parent = LocalPlayer.PlayerGui
	end
	ActiveMaintenanceUI.Frame.Description.Text = message
	UUID = HttpService:GenerateGUID(false)
end

function Module.TemporaryMaintenancePrompt(message)
	if not ActiveMaintenanceUI then
		ActiveMaintenanceUI = MaintenanceUI:Clone()
		ActiveMaintenanceUI.Enabled = true
		ActiveMaintenanceUI.Parent = LocalPlayer.PlayerGui
	end
	ActiveMaintenanceUI.Notification:Play()
	ActiveMaintenanceUI.Frame.Description.Text = message
	local ID = HttpService:GenerateGUID(false)
	UUID = ID
	task.delay(5, function()
		if UUID ~= ID then
			return
		end
		ActiveMaintenanceUI:Destroy()
		ActiveMaintenanceUI = nil
	end)
end

function Module.UpdateSoftShutdownTimer()
	local timeUntil = workspace:GetAttribute('TimedShutdownTime') - tick()
	local message = 'A soft shutdown will occur in '..FormatTimerSplice(timeUntil)

	if timeUntil < ReminderTimeValues[1] then
		Module.ForceMaintenancePrompt(message)
		return
	end

	for _, value in ReminderTimeValues do
		-- print( timeUntil, value, LastWidgetPrompt )
		if timeUntil < value then
			if value ~= LastWidgetPrompt then
				LastWidgetPrompt = value
				Module.TemporaryMaintenancePrompt(message)
			end
			break
		end
	end
end

function Module.CheckTimedSoftShutdownState()
	if not workspace:GetAttribute('TimedShutdownTime') or HasTimerStarted then
		return
	end
	HasTimerStarted = true

	task.spawn(function()
		while HasTimerStarted and workspace:GetAttribute('TimedShutdownTime') do
			task.wait(1)
			Module.UpdateSoftShutdownTimer()
		end
	end)
end

function Module.Start()
	task.defer(function()
		Module.CheckSoftShutdownState()
		Module.CheckTimedSoftShutdownState()
	end)

	workspace:GetAttributeChangedSignal('TimedShutdownTime'):Connect(Module.CheckTimedSoftShutdownState)
	workspace:GetAttributeChangedSignal('SoftShutdownEnabled'):Connect(Module.CheckSoftShutdownState)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Miscellaneous/RobloxStuffDisabler"><![CDATA[
local StarterGui = game:GetService('StarterGui')

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local SystemsContainer = {}

-- // Module // --
local Module = {}

function Module.UpdateState()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Captures, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.SelfView, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, true)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true)
	StarterGui:SetCore("TopbarEnabled", false)
end

function Module.Start()
	if LocalPlayer.Character then
		task.spawn(function()
			LocalPlayer.Character:WaitForChild('Humanoid', 3)
			task.wait(1)
			Module.UpdateState()
		end)
	end
	LocalPlayer.CharacterAdded:Connect(Module.UpdateState)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Miscellaneous/DataDebug"><![CDATA[
local LocalPlayer = game:GetService('Players').LocalPlayer

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local ReplicatedData = ReplicatedModules.Services.ReplicatedData
local TableUtility = ReplicatedModules.Utility.Table

local SystemsContainer = {}

local DebugContainer = Instance.new('Folder')
DebugContainer.Name = 'DebugContainer'
DebugContainer.Parent = ReplicatedStorage

-- // Module // --
local Module = {}

function Module.OnDataUpdated( Category, Data )
	local DataContainer = DebugContainer:FindFirstChild( Category )
	if not DataContainer then
		DataContainer = Instance.new('Folder')
		DataContainer.Name = Category
		DataContainer.Parent = DebugContainer
	end

	DataContainer:ClearAllChildren()
	TableUtility.TableToObject(Data, DataContainer, {})
end

function Module.Start()
	for k, v in ReplicatedData.Replicated do
		task.spawn( Module.OnDataUpdated, k, v )
	end
	ReplicatedData.OnUpdated:Connect(function(Category, Data)
		Module.OnDataUpdated( Category, Data )
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/DialogueWidget"><![CDATA[-- NPC dialogue widget -- walks a dialogue tree from ReplicatedModules.Data.Dialogue
-- Node types: MultiOption, Action, Conditional, Exit. Tree walk is client-local.
--
-- Layout strategy (see .claude/skills/custom-roblox-ui/SKILL.md):
--   * Top-level DialoguePanel anchors bottom-center (AnchorPoint(0.5, 1)) with a
--     scaled pixel inset from the bottom. Width is pixel-exact (DESIGN_PANEL_W)
--     and height grows with content via AutomaticSize.Y so the panel absorbs
--     long body text and variable-count option lists without squashing.
--   * Inside: a vertical UIListLayout stacks eyebrow + speaker + body + options,
--     with scale/pixel-offset paddings derived from DESIGN_* constants.
--   * The body TextLabel uses TextWrapped + AutomaticSize.Y so wraps expand
--     the panel rather than clipping.
--   * Each option button is pixel-width (matches inner width) + AutomaticSize.Y
--     so multi-line options never squash.
--   * Mirrors the pattern used by OnscreenWidget / TopRightQuestsWidget: all
--     dimensions are named DESIGN_* constants at the top; no magic numbers.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local TweenService = game:GetService('TweenService')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local doCleanup = Fusion.doCleanup

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE = HUDCommon.PALETTE

local DialogueData = ReplicatedModules.Data.Dialogue
local DialogueShared = ReplicatedModules.Services.DialogueShared
local ReplicatedData = ReplicatedModules.Services.ReplicatedData
local MaidClassModule = ReplicatedModules.Modules.Maid

local RemoteService = ReplicatedModules.Services.RemoteService
local DialogueActionRemote = RemoteService.GetRemote('DialogueAction', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}
Module.WidgetMaid = MaidClassModule.New()

local ScreenGui: Frame? = nil
local RootScope = nil

local CurrentDialogueId: string? = nil
local CurrentNode: any = nil

-- Fusion Values (populated per-open)
local SpeakerTitle
local BodyText
local AutoAdvanceLabel  -- string Value: text shown on the continue button (e.g. 'Continue (3.0s)')

-- Imperative option rendering: option buttons are destroyed + rebuilt each
-- step under OptionsFrame, tracked via OptionMaid for cleanup. This avoids
-- a ForPairs reactivity layer that wasn't refreshing between nodes — the
-- dialogue tree walk is inherently imperative (one node at a time), so a
-- direct rebuild is both simpler and easier to reason about.
local OptionsFrame: Frame? = nil
local OptionsCanvas: CanvasGroup? = nil  -- wraps OptionsFrame so options fade in via GroupTransparency
local OptionsMaid = nil  -- holds button Instances + auto-advance task handles for the current node

----------------------------------------------------------------------
-- Design dimensions (pixels). Every Scale value is derived from these.
----------------------------------------------------------------------
local DESIGN_SCREEN_W, DESIGN_SCREEN_H = 1920, 1080

-- Panel: wide bottom-center speech panel. Wider than before since options
-- now live to the RIGHT of the body text — content is split horizontally.
local DESIGN_PANEL_W        = 880
local DESIGN_PANEL_MIN_H    = 180  -- minimum before AutomaticSize.Y grows it

-- Inner padding on the panel.
local DESIGN_PANEL_PAD      = 16

-- Inner usable width (after symmetric horizontal padding).
local DESIGN_PANEL_INNER_W  = DESIGN_PANEL_W - 2 * DESIGN_PANEL_PAD -- 848

-- Two-column horizontal split. Left column = eyebrow + speaker + body
-- (the "story" side); right column = scrollable option list. Body is
-- the larger share so speeches read comfortably; options column is
-- fixed-width so multi-line option labels stay legible.
local DESIGN_CONTENT_GAP    = 14   -- horizontal gap between left + right columns
local DESIGN_OPTIONS_W      = 280  -- fixed pixel width of the options column
local DESIGN_BODY_W         = DESIGN_PANEL_INNER_W - DESIGN_OPTIONS_W - DESIGN_CONTENT_GAP -- 554
-- Fixed scroll viewport height for the options column. ~6 buttons visible
-- before scroll kicks in (36 + 6 padding ≈ 42 per row → 252 / 42 = 6).
-- Long option lists (chapter selectors etc.) scroll within this viewport
-- instead of stretching the panel taller than the body.
local DESIGN_OPTIONS_VIEWPORT_H = 252

-- Internal row heights.
local DESIGN_EYEBROW_H      = 12   -- "◆ DIALOGUE" eyebrow
local DESIGN_SPEAKER_H      = 28   -- speaker name label
local DESIGN_BODY_MIN_H     = 100  -- body text (wraps, AutomaticSize.Y grows)

-- Gap between the stacked rows inside the panel.
local DESIGN_ROW_GAP        = 10

-- Option buttons (stacked inside an options list).
local DESIGN_OPTION_MIN_H   = 36
local DESIGN_OPTION_PAD_X   = 10   -- inner horizontal padding on each button
local DESIGN_OPTION_GAP     = 6    -- vertical gap between option buttons

-- Typewriter speed: characters per second for the body-text reveal.
-- 35 cps ≈ 700 wpm reading speed; quick but not instantaneous.
local TYPEWRITER_CPS        = 35
local OPTIONS_FADE_IN_TIME  = 0.35   -- seconds to fade options from invisible

-- Bottom-center anchor: lift the panel off the bottom edge by a scaled pixel
-- inset (24 px at the 1080 reference height).
local DESIGN_BOTTOM_INSET   = 24
local ANCHOR_Y_SCALE        = 1 - DESIGN_BOTTOM_INSET / DESIGN_SCREEN_H

local function resolveNode(node)
	-- Traverse Conditional nodes until we hit a MultiOption / Action / Exit.
	while node and node.Type == 'Conditional' do
		local playerData = ReplicatedData.GetData('PlayerData', false)
		local ok, result = pcall(node.Condition, LocalPlayer, playerData, CurrentDialogueId)
		if not ok then
			warn('Dialogue condition errored: ', result)
			result = false
		end
		node = result and node.True or node.False
	end
	return node
end

local function runActions(node)
	if typeof(node.Actions) == 'table' then
		for _, action in node.Actions do
			DialogueActionRemote:FireServer(CurrentDialogueId, action)
		end
	end
end

-- Build a single option button under OptionsFrame and track it in OptionsMaid
-- so the next stepToNode() can clear it. `idx` controls its LayoutOrder so
-- options stay in author order regardless of construction order.
local function spawnOptionButton(idx: number, label: string, onClick: () -> ())
	if not OptionsFrame or not RootScope then return end
	local btn = RootScope:New('TextButton') {
		Name = 'Option_' .. tostring(idx),
		LayoutOrder = idx,
		Size = UDim2.new(1, 0, 0, DESIGN_OPTION_MIN_H),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = PALETTE.bg1,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		FontFace = HUDCommon.FONT_UI,
		TextSize = 16,
		TextColor3 = PALETTE.ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextWrapped = true,
		-- `idx` should be an integer (array key), but if a malformed
		-- node smuggles a string key in we don't want the format call
		-- to crash. Coerce to number with a safe fallback.
		Text = string.format('%d. %s', tonumber(idx) or 1, tostring(label)),
		Parent = OptionsFrame,
		[Fusion.OnEvent('Activated')] = onClick,
		[Fusion.Children] = {
			RootScope:New('UIStroke') {
				Color = PALETTE.accent, Transparency = 0.7, Thickness = 1,
			},
			RootScope:New('UIPadding') {
				PaddingTop    = UDim.new(0, DESIGN_OPTION_PAD_X / 2),
				PaddingBottom = UDim.new(0, DESIGN_OPTION_PAD_X / 2),
				PaddingLeft   = UDim.new(0, DESIGN_OPTION_PAD_X),
				PaddingRight  = UDim.new(0, DESIGN_OPTION_PAD_X),
			},
		},
	}
	OptionsMaid:Give(btn)
	return btn
end

local function clearOptions()
	if OptionsMaid then OptionsMaid:Cleanup() end
end

local function stepToNode(node)
	node = resolveNode(node)
	if not node then
		Module.CloseWidget()
		return
	end
	-- Defensive unwrap mirroring DialogueBuilder.DisplayTextContent —
	-- if a Continue points at an option-entry (`{Display, Options}` with
	-- no Type), unwrap once so we step into the *actual* next node.
	-- Catches any author who hand-builds a malformed table or passes
	-- BuildExitButton() through a path the data-side unwrap doesn't
	-- cover.
	if typeof(node) == 'table'
		and node.Type == nil
		and node.Display ~= nil and node.Options ~= nil
		and (typeof(node.Options) ~= 'table' or node.Options.Type ~= nil
			 or (node.Options[1] == nil and next(node.Options) == nil)) then
		node = node.Options
		node = resolveNode(node)
		if not node then Module.CloseWidget(); return end
	end
	if node.Type == 'Exit' then
		Module.CloseWidget()
		return
	end
	if node.Type == 'Action' then
		runActions(node)
		if (node.Delay or 0) > 0 then
			task.delay(node.Delay, function() Module.CloseWidget() end)
		else
			Module.CloseWidget()
		end
		return
	end
	-- MultiOption
	CurrentNode = node
	local display = node.Display
	local titleData = display and display.Text and display.Text.Title or nil
	local descData  = display and display.Text and display.Text.Description or nil
	local fullBody  = (descData and descData.Text) or ''
	SpeakerTitle:set(titleData and titleData.Text or '')
	BodyText:set('')  -- typewriter fills it incrementally below
	AutoAdvanceLabel:set('')

	-- Hide options until the typewriter completes — stops the player from
	-- clicking through before reading. CanvasGroup.GroupTransparency
	-- blanket-fades every descendant in one property write (versus
	-- iterating every TextLabel/UIStroke individually).
	if OptionsCanvas then OptionsCanvas.GroupTransparency = 1 end

	-- Stub: play a per-NPC talking sound for this line. DialogueShared
	-- resolves the registry entry by dialogue id; per-line overrides
	-- can come from display.TalkingSound = { Sfx = ..., Properties = {…} }
	-- when authors want a stinger on a specific line.
	local lineOverride = display and display.TalkingSound
	DialogueShared.PlayTalkingSound(
		CurrentDialogueId,
		lineOverride and lineOverride.Sfx,
		lineOverride and lineOverride.Properties)

	-- Dispatch any cinematic cues attached to this dialogue line. Cues are
	-- the same shape as full cinematics (At + Kind + Args). For lines we
	-- play them at-start with their `At` honored as a relative delay so
	-- a line can pan camera 0.2s in, shake 0.5s in, etc., without leaving
	-- the dialogue flow. Used by Dialogue authors via the optional
	-- `Cues` field added to a node's Display table.
	local cues = display and display.Cues
	if typeof(cues) == 'table' and #cues > 0 then
		local CinematicClient = SystemsContainer.CinematicClient
			or (SystemsContainer.ParentSystems and SystemsContainer.ParentSystems.Effects
			    and SystemsContainer.ParentSystems.Effects.CinematicClient)
		if CinematicClient and CinematicClient.PlayCue then
			for _, cue in cues do
				task.delay(math.max(0, cue.At or 0), function()
					if CurrentNode ~= node then return end  -- node advanced; skip stale cue
					CinematicClient.PlayCue(cue.Kind, cue.Args or {})
				end)
			end
		end
	end

	-- Wipe last node's buttons + any pending auto-advance task before
	-- spawning fresh ones. OptionsMaid.Cleanup destroys child Instances
	-- and runs disconnect callbacks tied to the previous node.
	clearOptions()

	for idx, opt in node.Options do
		local label = opt.Display and opt.Display.Label and opt.Display.Label.Text or 'Continue'
		spawnOptionButton(idx, label, function()
			if opt.Options == nil then
				Module.CloseWidget()
			else
				stepToNode(opt.Options)
			end
		end)
	end

	-- Typewriter reveal of the body text. CurrentNode-guarded so a fast
	-- "Continue" press cancels the in-flight typewriter for the previous
	-- node (the next stepToNode resets BodyText anyway, but this prevents
	-- a stale revealing string flickering past the new body).
	-- When the typewriter completes, fade the options canvas group in.
	local nodeAtStart = node
	task.spawn(function()
		local n = #fullBody
		if n == 0 then
			-- Empty body — show options immediately.
			if CurrentNode == nodeAtStart and OptionsCanvas then
				TweenService:Create(OptionsCanvas,
					TweenInfo.new(OPTIONS_FADE_IN_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ GroupTransparency = 0 }):Play()
			end
			return
		end
		local startedAt = os.clock()
		while CurrentNode == nodeAtStart do
			local elapsed = os.clock() - startedAt
			local revealCount = math.min(n, math.floor(elapsed * TYPEWRITER_CPS))
			BodyText:set(string.sub(fullBody, 1, revealCount))
			if revealCount >= n then break end
			task.wait()
		end
		if CurrentNode == nodeAtStart and OptionsCanvas then
			TweenService:Create(OptionsCanvas,
				TweenInfo.new(OPTIONS_FADE_IN_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ GroupTransparency = 0 }):Play()
		end
	end)

	-- Time-based auto-advance: if the node carries `display.AutoAdvance =
	-- <seconds>`, schedule a tick that advances on the FIRST option after
	-- the timer expires. Cancellable: clearOptions() in the next step
	-- destroys this token before it fires. A live countdown label updates
	-- every 0.1s so the player sees how much time remains.
	local autoAdvance = display and display.AutoAdvance
	local firstOpt = node.Options and node.Options[1]
	if typeof(autoAdvance) == 'number' and autoAdvance > 0 and firstOpt then
		local cancelled = false
		OptionsMaid:Give(function() cancelled = true end)
		local startedAt = os.clock()
		task.spawn(function()
			while not cancelled do
				local remaining = autoAdvance - (os.clock() - startedAt)
				if remaining <= 0 then
					if not cancelled and CurrentNode == node then
						if firstOpt.Options == nil then
							Module.CloseWidget()
						else
							stepToNode(firstOpt.Options)
						end
					end
					return
				end
				AutoAdvanceLabel:set(string.format('Auto-continue in %.1fs', remaining))
				task.wait(0.1)
			end
		end)
	end
end

----------------------------------------------------------------------
-- Two-column content row. Left = eyebrow + speaker + body (the story
-- side, AutoSize.Y so it grows with the typewritten body). Right = a
-- scrollable options column with a fixed viewport height; option lists
-- longer than the viewport scroll instead of stretching the panel.
--
-- Right-column hierarchy:
--   ScrollingFrame (fixed pixel viewport, AutomaticCanvasSize.Y)
--     └─ CanvasGroup (AutoSize.Y, GroupTransparency for fade-in)
--          └─ OptionsFrame (vertical UIListLayout, AutoSize.Y)
--               └─ buttons (imperatively spawned)
-- The CanvasGroup's GroupTransparency cascades over every descendant so
-- one tween fades the entire button stack in after the typewriter
-- completes; AutomaticCanvasSize on the scroll reads the canvas group's
-- live height so scrollbars only appear when content overflows.
----------------------------------------------------------------------
local function buildContentRow(scope)
	-- Left column: eyebrow + speaker + body, stacked vertically.
	local leftColumn = scope:New('Frame') {
		Name = 'LeftColumn',
		LayoutOrder = 1,
		Size = UDim2.fromOffset(DESIGN_BODY_W, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
				HorizontalAlignment = Enum.HorizontalAlignment.Left,
			},
			HUDCommon.eyebrowLabel(scope, {
				Text = '\u{25C6} DIALOGUE',
				Color = PALETTE.accent,
				Size = UDim2.new(1, 0, 0, DESIGN_EYEBROW_H),
				LayoutOrder = 0,
			}),
			scope:New('TextLabel') {
				Name = 'Speaker',
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, DESIGN_SPEAKER_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				TextSize = 22,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
				Text = SpeakerTitle,
			},
			scope:New('TextLabel') {
				Name = 'Body',
				LayoutOrder = 2,
				Size = UDim2.fromOffset(DESIGN_BODY_W, DESIGN_BODY_MIN_H),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				TextSize = 15,
				TextColor3 = PALETTE.inkDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
				Text = BodyText,
			},
		},
	}

	-- Right column: scrollable options. OptionsFrame contains the live
	-- buttons; OptionsCanvas wraps it for the fade; the ScrollingFrame
	-- caps the visible height and surfaces a scrollbar on overflow.
	OptionsFrame = scope:New('Frame') {
		Name = 'Options',
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, DESIGN_OPTION_GAP),
				SortOrder = Enum.SortOrder.LayoutOrder,
				HorizontalAlignment = Enum.HorizontalAlignment.Right,
			},
			scope:New('TextLabel') {
				Name = 'AutoAdvance',
				LayoutOrder = 999,
				Size = UDim2.new(1, 0, 0, 16),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				TextSize = 12,
				TextColor3 = PALETTE.inkDim,
				TextXAlignment = Enum.TextXAlignment.Right,
				Text = AutoAdvanceLabel,
			},
		},
	}

	OptionsCanvas = scope:New('CanvasGroup') {
		Name = 'OptionsCanvas',
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		GroupTransparency = 1,  -- fades 1→0 when typewriter completes
		[Fusion.Children] = { OptionsFrame },
	}

	local optionsScroll = scope:New('ScrollingFrame') {
		Name = 'OptionsScroll',
		LayoutOrder = 2,
		Size = UDim2.fromOffset(DESIGN_OPTIONS_W, DESIGN_OPTIONS_VIEWPORT_H),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = PALETTE.accent,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		CanvasSize = UDim2.new(),  -- ignored once AutomaticCanvasSize is set
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ClipsDescendants = true,
		[Fusion.Children] = { OptionsCanvas },
	}

	-- Outer row holds the two columns side-by-side. AutoSize.Y so the
	-- panel grows with whichever column is taller (typically the left
	-- side once the body wraps to several lines; the right side caps at
	-- DESIGN_OPTIONS_VIEWPORT_H).
	return scope:New('Frame') {
		Name = 'ContentRow',
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, DESIGN_CONTENT_GAP),
				SortOrder = Enum.SortOrder.LayoutOrder,
				VerticalAlignment = Enum.VerticalAlignment.Top,
				HorizontalAlignment = Enum.HorizontalAlignment.Left,
			},
			leftColumn,
			optionsScroll,
		},
	}
end

----------------------------------------------------------------------
-- Build the panel. Pixel-exact width, AutomaticSize.Y so the panel
-- grows with body text + option count. Anchored bottom-center.
----------------------------------------------------------------------
local function buildPanel(scope)
	local panel = HUDCommon.chiseledPanel(scope, {
		Name = 'DialoguePanel',
		-- Bottom-center anchor. Width is Scale-sized (relative to the
		-- design screen) and the height auto-grows from a Scale-converted
		-- minimum. Aspect lock is intentionally omitted because content
		-- height is variable (AutomaticSize.Y); locking width:height
		-- would fight content growth. This is the same pattern as the
		-- TopRightQuestsWidget rail — top-level panel, scale width,
		-- variable height (SKILL §8 decision tree).
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, ANCHOR_Y_SCALE),
		Size = UDim2.fromScale(DESIGN_PANEL_W / DESIGN_SCREEN_W, DESIGN_PANEL_MIN_H / DESIGN_SCREEN_H),
		AutomaticSize = Enum.AutomaticSize.Y,
		AccentColor = PALETTE.accent,
		Children = {
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(0, DESIGN_PANEL_PAD),
				PaddingBottom = UDim.new(0, DESIGN_PANEL_PAD),
				PaddingLeft   = UDim.new(0, DESIGN_PANEL_PAD),
				PaddingRight  = UDim.new(0, DESIGN_PANEL_PAD),
			},
			-- The panel is now a single content row — the row owns its own
			-- internal layout (left = eyebrow + speaker + body, right =
			-- scrollable options). Keeping the panel as a thin shell with
			-- one child means the chiseledPanel's inner Frame doesn't have
			-- to manage cross-column alignment; that happens inside the
			-- row's horizontal UIListLayout.
			buildContentRow(scope),
		},
	})
	panel.Parent = ScreenGui
	return panel
end

function Module.IsWidgetOpen(): boolean
	return CurrentDialogueId ~= nil
end

-- Alias used by CinematicClient's StartDialogue cue. Same shape, just
-- the name the cinematic dispatcher expects.
function Module.RequestStart(dialogueId: string)
	Module.OpenDialogue(dialogueId)
end

function Module.OpenDialogue(dialogueId: string)
	if Module.IsWidgetOpen() then
		Module.CloseWidget()
	end
	local entry = DialogueData.GetDialogueFromId(dialogueId)
	if not entry or not entry.Tree then
		warn(string.format('DialogueWidget: unknown dialogue id %s', tostring(dialogueId)))
		return
	end

	CurrentDialogueId = dialogueId
	ScreenGui = HUDCommon.ensureScreenGui('HUD_Dialogue', 25)
	RootScope = scoped(Fusion)

	SpeakerTitle     = RootScope:Value('')
	BodyText         = RootScope:Value('')
	AutoAdvanceLabel = RootScope:Value('')
	OptionsMaid      = MaidClassModule.New()

	buildPanel(RootScope)
	stepToNode(entry.Tree)
end

function Module.CloseWidget()
	if not Module.IsWidgetOpen() then
		return
	end
	CurrentDialogueId = nil
	CurrentNode = nil
	if OptionsMaid then OptionsMaid:Cleanup(); OptionsMaid = nil end
	OptionsFrame = nil
	OptionsCanvas = nil
	if RootScope then
		doCleanup(RootScope)
		RootScope = nil
	end
	Module.WidgetMaid:Cleanup()
end

function Module.Start()
	-- no-op; opened on demand via Module.OpenDialogue
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/EnchantingWidget"><![CDATA[-- Phase 4 — Arcane Enchanting Table workstation.
-- Apotheosis-style enchant picker with tiers, prereqs, conflicts.
-- Visual reference: tmp/aincrad-ui/workstations.jsx (ArcaneEnchanter).
-- No server integration yet — commits will warn until EnchantServer lands.
--
-- Layout strategy (see .claude/skills/custom-roblox-ui/SKILL.md §2,3,4,8,10):
--   * Root frame fills its TabWidget content parent via fromScale(1, 1); this
--     is a SUB-panel, not a top-level HUD element — no screen-wide aspect
--     constraint, no anchor math.
--   * All atoms declared as DESIGN_* pixel constants and placed via
--     UDim2.fromOffset / UDim2.new(1, offset, 0, offset) so they never depend
--     on nested Scale multiplication.
--   * Left column (arcane visual + chosen + cost bar) uses UIListLayout with
--     AutomaticSize.Y on variable-content sub-sections.
--   * Right column (enchant catalog) is pixel width + internal UIListLayout;
--     the scrolling list auto-sizes its canvas.
--   * School filter: UIGridLayout with pixel CellSize + bounded MaxCells.
--   * Level buttons: UIListLayout horizontal, pixel cells.

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ContextActionService = game:GetService('ContextActionService')
local Players = game:GetService('Players')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local peek = Fusion.peek

-- Catalog import (Stage A) + commit remote (Stage B). The local ENCHANTS
-- / ENCHANT_INDEX / TIER_COLOR variables are rebuilt below as adapters
-- to the lowercase-field shape this widget code uses; the data module
-- itself uses CapsCase.
local EnchantsConfig = ReplicatedModules.Data.Enchants
local LevelGates     = ReplicatedModules.Data.LevelGates
local ReplicatedData = ReplicatedModules.Services.ReplicatedData
local RemoteService  = ReplicatedModules.Services.RemoteService
local EnchantShared  = ReplicatedModules.Services.EnchantShared
local EnchantEvent   = RemoteService.GetRemote('EnchantEvent', 'RemoteEvent', false)

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local LevelLockOverlay = LocalModules.Modules.LevelLockOverlay
local LevelGatesClient = LocalModules.Modules.LevelGatesClient
local PALETTE = HUDCommon.PALETTE

local SystemsContainer = {}

-- // Adapter shapes — re-projection of EnchantsConfig to the
-- lowercase-field shape this widget code uses. Built once at module load.

type Enchant = {
	id: string, name: string, tier: string, school: string,
	maxLv: number, cost: {number}, color: Color3,
	desc: string, descMult: number,
	conflict: {string}?, req: {id: string, lv: number}?,
}

local ENCHANTS: {Enchant} = {}
local ENCHANT_INDEX: {[string]: Enchant} = {}
do
	for _, e in EnchantsConfig.Enchants do
		local req = nil
		if e.Prereq then req = { id = e.Prereq.Id, lv = e.Prereq.Level } end
		local entry = {
			id = e.Id, name = e.Name, tier = e.Tier, school = e.School,
			maxLv = e.MaxLevel, cost = e.Cost, color = e.Color,
			desc = e.DescriptionFormat, descMult = e.DescriptionMultiplier,
			conflict = e.Conflict, req = req,
		}
		table.insert(ENCHANTS, entry)
		ENCHANT_INDEX[e.Id] = entry
	end
	-- Stable ordering: by tier then name. Tier order kept loose (mythic
	-- last) via a tier rank table.
	local TIER_RANK = { common = 1, uncommon = 2, rare = 3, epic = 4, mythic = 5 }
	table.sort(ENCHANTS, function(a, b)
		local ra, rb = TIER_RANK[a.tier] or 99, TIER_RANK[b.tier] or 99
		if ra ~= rb then return ra < rb end
		return a.name < b.name
	end)
end

local TIER_COLOR: {[string]: Color3} = EnchantsConfig.TierColors

local SCHOOLS: {string} = { 'all', 'Edge', 'Faith', 'Ward', 'Pyre', 'Frost', 'Wyrd', 'Bone', 'Astra' }

-- Placeholder equipment shown in the right-panel "Inventory" tab. Real
-- gear will come from PlayerData later, but we surface a short list now
-- so the tab is functional and the arcane-panel title can swap when the
-- player chooses a different item to inscribe.
type InvItem = { id: string, name: string, slot: string, tier: string, equipped: boolean }
local EQUIPMENT: {InvItem} = {
	{ id='elucidator', name='Elucidator',     slot='Greatsword',  tier='rare',     equipped=true  },
	{ id='dark_rep',   name='Dark Repulser',  slot='Longsword',   tier='rare',     equipped=false },
	{ id='blood_oath', name='Blood Oath',     slot='Dagger',      tier='uncommon', equipped=false },
	{ id='starfall',   name='Starfall Bow',   tier='epic',        slot='Bow',      equipped=false },
	{ id='moon_rite',  name='Moon Rite Staff',slot='Staff',       tier='epic',     equipped=false },
	{ id='kite_ward',  name='Kite of Warding',slot='Shield',      tier='common',   equipped=false },
	{ id='bone_plate', name='Bone Plate',     slot='Chest',       tier='uncommon', equipped=true  },
	{ id='shadow_gyre',name='Shadow Gyre',    slot='Ring',        tier='rare',     equipped=false },
}
local EQUIPMENT_INDEX: {[string]: InvItem} = {}
for _, it in EQUIPMENT do EQUIPMENT_INDEX[it.id] = it end

----------------------------------------------------------------------
-- DESIGN DIMENSIONS (pixels, from tmp/aincrad-ui/workstations.jsx)
----------------------------------------------------------------------

-- Column split: right catalog column is pixel-exact; left flex-fills.
local DESIGN_CATALOG_W        = 360        -- jsx: gridTemplateColumns '1fr 360px'

-- Left column padding + stack gap (jsx: padding:'16px 20px', gap:14).
local DESIGN_LEFT_PAD_X       = 20
local DESIGN_LEFT_PAD_Y       = 16
local DESIGN_LEFT_STACK_GAP   = 14

-- Arcane circle visual panel (jsx: flex:1, minHeight:300).
local DESIGN_ARCANE_MIN_H     = 300
local DESIGN_ARCANE_RADIUS    = 150        -- rune ring radius
local DESIGN_RUNE_SIZE        = 22         -- rune disc diameter (jsx r=11 → 22px)
local DESIGN_RUNE_TEXT        = 14
local DESIGN_WEAPON_SIL_W     = 144        -- jsx path ~-60..72 → ~132, rounded
local DESIGN_WEAPON_SIL_H     = 14
local DESIGN_WEAPON_TITLE_H   = 14

-- Chosen inscriptions section. Squashed to 4-col compact rows so many
-- inscriptions stay glanceable without pushing the arcane panel up.
-- Each card is single-line (name + LV) — description moves to tooltip.
local DESIGN_CHOSEN_HEADER_H  = 12
local DESIGN_CHOSEN_HEADER_GAP = 6
local DESIGN_CHOSEN_CARD_H    = 30         -- squashed single-line card
local DESIGN_CHOSEN_GRID_COLS = 4
local DESIGN_CHOSEN_PAD_X     = 8
local DESIGN_CHOSEN_PAD_Y     = 4
local DESIGN_CHOSEN_STRIP_W   = 3
local DESIGN_CHOSEN_NAME_H    = 14
local DESIGN_CHOSEN_LV_W      = 36
local DESIGN_CHOSEN_CLOSE     = 16
local DESIGN_CHOSEN_CARD_GAP_X = 6
local DESIGN_CHOSEN_CARD_GAP_Y = 4
-- ScrollingFrame fixed viewport height (roughly two squashed rows). The
-- AutomaticCanvasSize.Y on the frame lets it grow beyond this and scroll.
local DESIGN_CHOSEN_SCROLL_H  = DESIGN_CHOSEN_CARD_H * 2 + DESIGN_CHOSEN_CARD_GAP_Y

-- Cost bar (jsx: padding:'10px 14px', gap:14, inscribe button inline).
local DESIGN_INSCRIBE_W       = 160
local DESIGN_INSCRIBE_H       = 36

-- Right catalog column padding (jsx: padding:'14px 14px').
local DESIGN_RIGHT_PAD        = 14
local DESIGN_RIGHT_HEADER_H   = 14
local DESIGN_RIGHT_HEADER_GAP = 8

-- Right-panel tabs (INVENTORY | INSCRIPTIONS). Single segmented row
-- above the rest of the right-column stack. Height is intentionally
-- compact — tabs are navigation, not the primary affordance.
local DESIGN_RIGHT_TAB_H      = 26
local DESIGN_RIGHT_TAB_GAP    = 8

-- Inventory tab row (icon swatch + name/slot + equipped tag).
local DESIGN_INV_ROW_H        = 48
local DESIGN_INV_ROW_GAP      = 4
local DESIGN_INV_SWATCH       = 28
local DESIGN_INV_PAD_X        = 10

-- School filter row (jsx: flexWrap, 3×8 padding, gap:3).
local DESIGN_FILTER_BTN_W     = 56
local DESIGN_FILTER_BTN_H     = 20
local DESIGN_FILTER_PAD       = 3
local DESIGN_FILTER_MAX_COLS  = 5           -- wrap into two rows for 9 schools
local DESIGN_FILTER_ROW_H     = DESIGN_FILTER_BTN_H * 2 + DESIGN_FILTER_PAD
local DESIGN_FILTER_GAP       = 10

-- Catalog entry (jsx: padding:'7px 10px', per-card header + level row + warn).
local DESIGN_ENTRY_H          = 60
local DESIGN_ENTRY_PAD_X      = 10
local DESIGN_ENTRY_PAD_Y      = 6
local DESIGN_ENTRY_HEADER_H   = 14
local DESIGN_ENTRY_TIER_W     = 60
local DESIGN_ENTRY_LEVEL_H    = 18
local DESIGN_ENTRY_WARN_H     = 12
local DESIGN_ENTRY_ROW_GAP    = 4
local DESIGN_ENTRY_GAP        = 3          -- between consecutive entries
local DESIGN_LEVEL_BTN_GAP    = 2
local DESIGN_LEVEL_COST_W     = 40

-- // Module // --

local Module = {}

local ScreenGui: Frame? = nil
local RootScope = nil

-- Fusion Values
local IsOpen
local Chosen       -- Value<{[enchantId]: level}>
local SchoolFilter -- Value<string>
local AvailableXP  -- Value<number>  (placeholder; would come from PlayerData)
local AvailableSigils
local RightTab     -- Value<'inscriptions'|'inventory'>
local SelectedItem -- Value<string> — EQUIPMENT_INDEX key currently being inscribed
-- Tooltip: { title, body, color, x, y } or nil. Shared floating frame
-- parented to ScreenGui reads from this; hover targets write to it.
local ActiveTooltip

-- // Helpers // --

local function formatDesc(e: Enchant, lv: number): string
	local val = e.descMult * lv
	return string.format(e.desc, val)
end

local function totalCost(use): number
	local sum = 0
	for id, lv in use(Chosen) do
		local e = ENCHANT_INDEX[id]
		if e and e.cost[lv] then sum += e.cost[lv] end
	end
	return sum
end

local function checkAvail(e: Enchant, chosen): (boolean, string)
	if e.conflict then
		for _, cid in e.conflict do
			if chosen[cid] then
				return false, 'Conflicts with ' .. (ENCHANT_INDEX[cid] and ENCHANT_INDEX[cid].name or cid)
			end
		end
	end
	if e.req then
		local have = chosen[e.req.id] or 0
		if have < e.req.lv then
			local reqName = ENCHANT_INDEX[e.req.id] and ENCHANT_INDEX[e.req.id].name or e.req.id
			return false, string.format('Requires %s %d', reqName, e.req.lv)
		end
	end
	return true, ''
end

-- Tooltip helpers. Level-aware: hover on any level button shows the
-- *level's* effect (descMult * lv through the enchant's desc format),
-- not the base-level effect — matching the design requirement.
local function showTooltip(target: GuiObject, title: string, body: string, color: Color3)
	local abs = target.AbsolutePosition
	local size = target.AbsoluteSize
	ActiveTooltip:set({
		title = title, body = body, color = color,
		x = abs.X + size.X + 10, y = abs.Y,
	})
end
local function hideTooltip()
	ActiveTooltip:set(nil)
end

-- setLevel is the single place level-selection state is mutated, so the
-- "click the active level to deselect" toggle lives here (not duplicated
-- at every call site). If the requested level equals the current one,
-- the enchant is cleared; otherwise the new level is recorded.
local function setLevel(id: string, lv: number)
	local current = table.clone(peek(Chosen))
	local now = current[id] or 0
	if lv <= 0 or lv == now then
		current[id] = nil
	else
		current[id] = lv
	end
	Chosen:set(current)
end

local function removeEnchant(id: string)
	setLevel(id, 0)
end

-- // UI builders // --

----------------------------------------------------------------------
-- Chosen-inscription card. Pixel-exact height; width filled via grid.
----------------------------------------------------------------------
local function buildChosenEntry(scope, id: string, lv: number)
	local e = ENCHANT_INDEX[id]
	if not e then return nil end
	local c = TIER_COLOR[e.tier] or PALETTE.accent
	local card: Frame
	card = scope:New('Frame') {
		BackgroundColor3 = c,
		BackgroundTransparency = 0.9,
		BorderSizePixel = 0,
		-- Hover the whole card to see the effect at its current LV.
		[Fusion.OnEvent('MouseEnter')] = function()
			local body = string.format('LV %d · %d XP\n%s',
				lv, e.cost[lv] or 0, formatDesc(e, lv))
			showTooltip(card, e.name, body, c)
		end,
		[Fusion.OnEvent('MouseLeave')] = hideTooltip,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = c, Transparency = 0.5, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, DESIGN_CHOSEN_PAD_X),
				PaddingRight = UDim.new(0, DESIGN_CHOSEN_PAD_X),
				PaddingTop = UDim.new(0, DESIGN_CHOSEN_PAD_Y),
				PaddingBottom = UDim.new(0, DESIGN_CHOSEN_PAD_Y),
			},
			-- Colored left strip.
			scope:New('Frame') {
				AnchorPoint = Vector2.new(0, 0),
				Position = UDim2.fromOffset(0, 0),
				Size = UDim2.new(0, DESIGN_CHOSEN_STRIP_W, 1, 0),
				BackgroundColor3 = c, BorderSizePixel = 0,
			},
			-- Name (left, vertically centered — single-line squashed card).
			-- Shift past the colored strip + a small gap so text doesn't
			-- render on top of the 3-px strip at the card's left edge.
			scope:New('TextLabel') {
				Position = UDim2.fromOffset(DESIGN_CHOSEN_STRIP_W + 6, 0),
				Size = UDim2.new(1, -(DESIGN_CHOSEN_STRIP_W + 6 + DESIGN_CHOSEN_LV_W + DESIGN_CHOSEN_CLOSE), 1, 0),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = e.name,
				TextSize = 12, TextColor3 = c,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
			-- LV label (right of name, before close button).
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -DESIGN_CHOSEN_CLOSE, 0.5, 0),
				Size = UDim2.fromOffset(DESIGN_CHOSEN_LV_W, DESIGN_CHOSEN_NAME_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = string.format('LV %d', lv),
				TextSize = 10, TextColor3 = c,
				TextXAlignment = Enum.TextXAlignment.Right,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
			-- Close button (right edge, vertically centered).
			scope:New('TextButton') {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.fromOffset(DESIGN_CHOSEN_CLOSE, DESIGN_CHOSEN_CLOSE),
				BackgroundTransparency = 1,
				AutoButtonColor = false,
				FontFace = HUDCommon.FONT_MONO,
				Text = '✕',
				TextSize = 12, TextColor3 = PALETTE.inkDim,
				[Fusion.OnEvent('Activated')] = function() removeEnchant(id) end,
			},
		},
	}
	return card
end

----------------------------------------------------------------------
-- Chosen-inscription grid. Pixel cells, 2 cols, AutomaticSize.Y.
----------------------------------------------------------------------
local function buildChosenList(scope)
	return scope:New('Frame') {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIGridLayout') {
				-- Cell width = (parent/N) − ⌈gap·(N−1)/N⌉ so N cells + (N−1)
				-- gap-pads never overflow the parent width. (Same off-by-one
				-- math we fixed in the forge grids — floor rounds the wrong
				-- way and forces a wrap to a single column.)
				CellSize = UDim2.new(
					1 / DESIGN_CHOSEN_GRID_COLS,
					-math.ceil(DESIGN_CHOSEN_CARD_GAP_X * (DESIGN_CHOSEN_GRID_COLS - 1) / DESIGN_CHOSEN_GRID_COLS),
					0, DESIGN_CHOSEN_CARD_H
				),
				CellPadding = UDim2.fromOffset(DESIGN_CHOSEN_CARD_GAP_X, DESIGN_CHOSEN_CARD_GAP_Y),
				FillDirectionMaxCells = DESIGN_CHOSEN_GRID_COLS,
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:ForPairs(
				scope:Computed(function(use)
					local out = {}
					local i = 0
					for id, lv in use(Chosen) do
						i += 1
						table.insert(out, { order = i, id = id, lv = lv })
					end
					return out
				end),
				function(use, innerScope, idx, entry)
					local frame = buildChosenEntry(innerScope, entry.id, entry.lv)
					if frame then
						frame.LayoutOrder = entry.order
					end
					return entry.id, frame
				end
			),
		},
	}
end

----------------------------------------------------------------------
-- Arcane-circle visual. Fills its slot; rune ring radius is pixel-exact
-- via fromOffset positioning around a fromScale(0.5, 0.5) center.
----------------------------------------------------------------------
local function buildArcanePanel(scope)
	local runes = { '◆', '▲', '●', '◇', '■', '▼', '◐', '◆', '▲', '●', '◇', '■' }
	local children: {any} = {
		scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.75, Thickness = 1 },
	}
	for i, sym in runes do
		local angle = (i - 1) / #runes * math.pi * 2
		local x = math.cos(angle) * DESIGN_ARCANE_RADIUS
		local y = math.sin(angle) * DESIGN_ARCANE_RADIUS
		local litThreshold = i
		table.insert(children, scope:New('TextLabel') {
			Size = UDim2.fromOffset(DESIGN_RUNE_SIZE, DESIGN_RUNE_SIZE),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, x, 0.5, y),
			BackgroundColor3 = PALETTE.bg1,
			BackgroundTransparency = 0.4,
			BorderSizePixel = 0,
			FontFace = HUDCommon.FONT_MONO,
			Text = sym,
			TextSize = DESIGN_RUNE_TEXT,
			TextColor3 = scope:Computed(function(use)
				local total = 0
				for _, lv in use(Chosen) do total += lv end
				return total >= litThreshold and PALETTE.accent or PALETTE.inkFaint
			end),
			[Fusion.Children] = {
				scope:New('UIAspectRatioConstraint') { AspectRatio = 1 },
				scope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
				scope:New('UIStroke') {
					Color = PALETTE.accent,
					Transparency = scope:Computed(function(use)
						local total = 0
						for _, lv in use(Chosen) do total += lv end
						return total >= litThreshold and 0.2 or 0.8
					end),
					Thickness = 1,
				},
			},
		})
	end

	-- Central weapon silhouette (pixel-exact).
	table.insert(children, scope:New('Frame') {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(DESIGN_WEAPON_SIL_W, DESIGN_WEAPON_SIL_H),
		BackgroundColor3 = Color3.fromRGB(74, 72, 96),
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.2, Thickness = 1 },
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0.5, 0, 0, -8),
				Size = UDim2.fromOffset(DESIGN_WEAPON_SIL_W * 2, DESIGN_WEAPON_TITLE_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				-- Title tracks whichever item the player selected in the
				-- inventory tab; falls back to a generic label if the
				-- chosen id somehow isn't in EQUIPMENT_INDEX.
				Text = scope:Computed(function(use)
					local it = EQUIPMENT_INDEX[use(SelectedItem)]
					local name = it and string.upper(it.name) or 'NO ITEM'
					return string.format('◆ ARCANE TABLE · %s ◆', name)
				end),
				TextSize = 10, TextColor3 = PALETTE.accent,
				TextTransparency = 0.4,
			},
		},
	})

	-- Floating cost overlay pinned to the bottom-right of the arcane
	-- viewport. Replaces the dedicated cost bar row; the stats now sit
	-- "inside" the arcane scene as ambient HUD text, matching the
	-- reference layout where cost reads as part of the ritual stage.
	local enoughXP = scope:Computed(function(use)
		return totalCost(use) <= use(AvailableXP)
	end)
	local function floatStat(label: string, valueBind, valueColor)
		return scope:New('Frame') {
			Size = UDim2.fromOffset(0, 30),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				scope:New('TextLabel') {
					Size = UDim2.new(1, 0, 0, 10),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO, Text = label,
					TextSize = 9, TextColor3 = PALETTE.inkFaint,
					TextXAlignment = Enum.TextXAlignment.Right,
				},
				scope:New('TextLabel') {
					AnchorPoint = Vector2.new(0, 1),
					Position = UDim2.fromScale(0, 1),
					Size = UDim2.new(1, 0, 0, 18),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO, Text = valueBind,
					TextSize = 14, TextColor3 = valueColor,
					TextXAlignment = Enum.TextXAlignment.Right,
				},
			},
		}
	end
	-- Stats overlay: pinned to the bottom of the arcane viewport, spanning
	-- a wide horizontal region (55% of panel width on the right) with
	-- SpaceBetween flex so EXPERIENCE, SIGILS and COST fan out across the
	-- bottom band rather than clustering against the right edge.
	table.insert(children, scope:New('Frame') {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -24, 1, -16),
		Size = UDim2.new(0.55, 0, 0, 34),
		BackgroundTransparency = 1,
		ZIndex = 5,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 24),
				VerticalAlignment = Enum.VerticalAlignment.Center,
				HorizontalFlex = Enum.UIFlexAlignment.SpaceBetween,
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			(function() local b = floatStat('EXPERIENCE',
				scope:Computed(function(use)
					local xp = use(AvailableXP); local cost = totalCost(use)
					return string.format('%d ⟶ %d', xp, math.max(0, xp - cost))
				end),
				scope:Computed(function(use)
					return use(enoughXP) and PALETTE.success or PALETTE.danger
				end)); b.LayoutOrder = 1; return b end)(),
			(function() local b = floatStat('SIGILS',
				scope:Computed(function(use)
					return string.format('%d ⟶ %d', use(AvailableSigils), math.max(0, use(AvailableSigils) - 3))
				end),
				PALETTE.accent); b.LayoutOrder = 2; return b end)(),
			(function() local b = floatStat('COST',
				scope:Computed(function(use)
					return string.format('%d XP · 3 SIGILS', totalCost(use))
				end),
				PALETTE.gold); b.LayoutOrder = 3; return b end)(),
		},
	})

	return scope:New('Frame') {
		Name = 'ArcanePanel',
		-- Fills its parent slot (the left column's flex-1 section).
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.5,
		BorderSizePixel = 0,
		[Fusion.Children] = children,
	}
end

----------------------------------------------------------------------
-- Cost bar: XP / SIGILS / COST stat blocks + spacer + inscribe button.
----------------------------------------------------------------------
local function buildCostBar(scope)
	-- Stats (XP / SIGILS / COST) have migrated to the arcane-panel
	-- floating overlay. This bar is now just the right-aligned INSCRIBE
	-- button, kept as its own row so the commit affordance stays the
	-- bottom-most element of the left column — natural F-pattern exit.
	local enoughXP = scope:Computed(function(use)
		return totalCost(use) <= use(AvailableXP)
	end)

	return scope:New('Frame') {
		Name = 'CostBar',
		Size = UDim2.new(1, 0, 0, DESIGN_INSCRIBE_H),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('TextButton') {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.fromOffset(DESIGN_INSCRIBE_W, DESIGN_INSCRIBE_H),
				AutoButtonColor = false,
				BackgroundColor3 = PALETTE.accent,
				BackgroundTransparency = scope:Computed(function(use) return use(enoughXP) and 0.7 or 0.9 end),
				BorderSizePixel = 0,
				FontFace = HUDCommon.FONT_MONO,
				Text = '◆ INSCRIBE ◆',
				TextSize = 12,
				TextColor3 = scope:Computed(function(use) return use(enoughXP) and PALETTE.accent or PALETTE.danger end),
				[Fusion.OnEvent('Activated')] = function()
					if not peek(enoughXP) then return end
					-- Stage C inscribe path. Iterates the Chosen map (enchant
					-- id → level) and fires one TryApply per entry. Server
					-- (EnchantServer.AttemptApplyEnchant) re-validates each
					-- via EnchantShared.CanApplyEnchant; rejects fall through
					-- silently. SelectedItem is the local 'elucidator' id —
					-- the inventory uuid wiring is a Stage E follow-up.
					local chosen = peek(Chosen) or {}
					local targetUuid = peek(SelectedItem)
					if typeof(targetUuid) ~= 'string' or #targetUuid == 0 then
						warn('EnchantingWidget: no target item selected')
						return
					end
					for enchantId, level in chosen do
						EnchantEvent:FireServer(EnchantShared.EnchantActions.TryApply, targetUuid, enchantId, level, nil)
					end
				end,
				[Fusion.Children] = {
					scope:New('UIStroke') {
						Color = scope:Computed(function(use) return use(enoughXP) and PALETTE.accent or PALETTE.danger end),
						Transparency = 0.2, Thickness = 1,
					},
				},
			},
		},
	}
end

----------------------------------------------------------------------
-- School filter row: UIGridLayout with pixel cells; wraps to 2 rows.
----------------------------------------------------------------------
local function buildSchoolFilter(scope)
	local children: {any} = {
		scope:New('UIGridLayout') {
			CellSize = UDim2.fromOffset(DESIGN_FILTER_BTN_W, DESIGN_FILTER_BTN_H),
			CellPadding = UDim2.fromOffset(DESIGN_FILTER_PAD, DESIGN_FILTER_PAD),
			FillDirectionMaxCells = DESIGN_FILTER_MAX_COLS,
			SortOrder = Enum.SortOrder.LayoutOrder,
		},
	}
	for i, s in SCHOOLS do
		local isActive = scope:Computed(function(use) return use(SchoolFilter) == s end)
		table.insert(children, scope:New('TextButton') {
			LayoutOrder = i,
			AutoButtonColor = false,
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = scope:Computed(function(use) return use(isActive) and 0.4 or 0.2 end),
			BorderSizePixel = 0,
			FontFace = HUDCommon.FONT_MONO,
			Text = string.upper(s),
			TextSize = 9,
			TextColor3 = scope:Computed(function(use) return use(isActive) and PALETTE.accent or PALETTE.inkDim end),
			[Fusion.OnEvent('Activated')] = function() SchoolFilter:set(s) end,
			[Fusion.Children] = {
				scope:New('UIStroke') {
					Color = PALETTE.accent,
					Transparency = scope:Computed(function(use) return use(isActive) and 0.2 or 0.75 end),
					Thickness = 1,
				},
			},
		})
	end
	return scope:New('Frame') {
		Name = 'SchoolFilter',
		Size = UDim2.new(1, 0, 0, DESIGN_FILTER_ROW_H),
		BackgroundTransparency = 1,
		[Fusion.Children] = children,
	}
end

----------------------------------------------------------------------
-- Catalog entry: pixel height, header row + level-button row + warning.
----------------------------------------------------------------------
local function buildCatalogEntry(scope, e: Enchant)
	local c = TIER_COLOR[e.tier] or PALETTE.accent
	local lv = scope:Computed(function(use) return use(Chosen)[e.id] or 0 end)
	local availResult = scope:Computed(function(use)
		local ok, why = checkAvail(e, use(Chosen))
		return { ok = ok, why = why }
	end)

	-- Level-button sub-row: horizontal UIListLayout with pixel gaps and
	-- a scale-share width per button so all maxLv buttons + cost fit in
	-- the row without nested-scale math.
	local levelButtons: {any} = {
		scope:New('UIListLayout') {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, DESIGN_LEVEL_BTN_GAP),
			SortOrder = Enum.SortOrder.LayoutOrder,
		},
	}
	-- Each level button shares the row width minus the fixed cost label;
	-- that's the one place we need a derived scale, expressed against
	-- the immediate parent (itself a row of known height).
	local buttonShare = UDim2.new(
		1 / e.maxLv, -(DESIGN_LEVEL_BTN_GAP + math.floor(DESIGN_LEVEL_COST_W / e.maxLv)),
		1, 0
	)
	for i = 1, e.maxLv do
		local isLv = scope:Computed(function(use) return i <= use(lv) end)
		local btn: TextButton
		-- Capture i in a closure so the hover tooltip pulls the correct
		-- level's effect text (formatDesc against this specific level).
		btn = scope:New('TextButton') {
			LayoutOrder = i,
			Size = buttonShare,
			AutoButtonColor = false,
			BackgroundColor3 = scope:Computed(function(use) return use(isLv) and c or PALETTE.bg0 end),
			BackgroundTransparency = scope:Computed(function(use) return use(isLv) and 0.1 or 0.4 end),
			BorderSizePixel = 0,
			FontFace = HUDCommon.FONT_MONO,
			Text = tostring(i),
			TextSize = 10,
			TextColor3 = scope:Computed(function(use)
				return use(isLv) and Color3.fromRGB(20, 18, 30) or c
			end),
			-- Unified click behaviour: always route through setLevel.
			-- The warning row below already explains any conflict/req
			-- violations; gating the click here just makes the button
			-- feel broken when it is really just not-yet-satisfied.
			[Fusion.OnEvent('Activated')] = function()
				setLevel(e.id, i)
			end,
			-- Hover: show the LEVEL i effect, not the base. Includes the
			-- cost for this level so players can eyeball the trade-off.
			[Fusion.OnEvent('MouseEnter')] = function()
				local body = string.format('LV %d · %d XP\n%s',
					i, e.cost[i] or 0, formatDesc(e, i))
				showTooltip(btn, e.name, body, c)
			end,
			[Fusion.OnEvent('MouseLeave')] = hideTooltip,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = c, Transparency = 0.5, Thickness = 1 },
			},
		}
		table.insert(levelButtons, btn)
	end
	-- Trailing cost label (pixel width).
	table.insert(levelButtons, scope:New('TextLabel') {
		LayoutOrder = e.maxLv + 1,
		Size = UDim2.fromOffset(DESIGN_LEVEL_COST_W, DESIGN_ENTRY_LEVEL_H),
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_MONO,
		Text = scope:Computed(function(use)
			return string.format('%dxp', e.cost[math.max(1, use(lv))])
		end),
		TextSize = 10, TextColor3 = PALETTE.gold,
		TextXAlignment = Enum.TextXAlignment.Right,
	})

	return scope:New('Frame') {
		Size = UDim2.new(1, 0, 0, DESIGN_ENTRY_H),
		BackgroundColor3 = c,
		BackgroundTransparency = scope:Computed(function(use) return use(lv) > 0 and 0.88 or 0.95 end),
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = c,
				Transparency = scope:Computed(function(use) return use(lv) > 0 and 0.3 or 0.7 end),
				Thickness = 1,
			},
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, DESIGN_ENTRY_PAD_X),
				PaddingRight = UDim.new(0, DESIGN_ENTRY_PAD_X),
				PaddingTop = UDim.new(0, DESIGN_ENTRY_PAD_Y),
				PaddingBottom = UDim.new(0, DESIGN_ENTRY_PAD_Y),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, DESIGN_ENTRY_ROW_GAP),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- Header row: name + tier badge.
			scope:New('Frame') {
				LayoutOrder = 0,
				Size = UDim2.new(1, 0, 0, DESIGN_ENTRY_HEADER_H),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('TextLabel') {
						Size = UDim2.new(1, -DESIGN_ENTRY_TIER_W, 1, 0),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_UI,
						Text = e.name,
						TextSize = 12, TextColor3 = c,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					scope:New('TextLabel') {
						AnchorPoint = Vector2.new(1, 0),
						Position = UDim2.new(1, 0, 0, 0),
						Size = UDim2.fromOffset(DESIGN_ENTRY_TIER_W, DESIGN_ENTRY_HEADER_H),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = string.upper(e.tier),
						TextSize = 9, TextColor3 = c,
						TextTransparency = 0.3,
						TextXAlignment = Enum.TextXAlignment.Right,
					},
				},
			},
			-- Level buttons row.
			scope:New('Frame') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, DESIGN_ENTRY_LEVEL_H),
				BackgroundTransparency = 1,
				[Fusion.Children] = levelButtons,
			},
			-- Warning row (empty when available).
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, DESIGN_ENTRY_WARN_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					local r = use(availResult)
					return r.ok and '' or ('⚠ ' .. r.why)
				end),
				TextSize = 10, TextColor3 = PALETTE.danger,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
		},
	}
end

----------------------------------------------------------------------
-- Catalog list: a ScrollingFrame with AutomaticCanvasSize.Y and a
-- vertical UIListLayout. Pixel row gap.
----------------------------------------------------------------------
----------------------------------------------------------------------
-- Right-panel tab bar: segmented INVENTORY | INSCRIPTIONS pair. Clicking
-- a tab mutates `RightTab`; the tab-active look is computed from the
-- same value via Computed → BackgroundTransparency + UIStroke transparency.
----------------------------------------------------------------------
local function buildRightTabBar(scope)
	local tabs = {
		{ key = 'inventory',    label = 'INVENTORY'    },
		{ key = 'inscriptions', label = 'INSCRIPTIONS' },
	}
	local children: {any} = {
		scope:New('UIListLayout') {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, DESIGN_RIGHT_TAB_GAP),
			SortOrder = Enum.SortOrder.LayoutOrder,
		},
	}
	for i, t in tabs do
		local isActive = scope:Computed(function(use) return use(RightTab) == t.key end)
		table.insert(children, scope:New('TextButton') {
			LayoutOrder = i,
			-- Half-width minus half the gap keeps both tabs exactly flush
			-- with the column edges regardless of viewport width.
			Size = UDim2.new(0.5, -math.ceil(DESIGN_RIGHT_TAB_GAP / 2), 1, 0),
			AutoButtonColor = false,
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = scope:Computed(function(use) return use(isActive) and 0.1 or 0.5 end),
			BorderSizePixel = 0,
			FontFace = HUDCommon.FONT_MONO,
			Text = t.label,
			TextSize = 11,
			TextColor3 = scope:Computed(function(use) return use(isActive) and PALETTE.accent or PALETTE.inkDim end),
			[Fusion.OnEvent('Activated')] = function() RightTab:set(t.key) end,
			[Fusion.Children] = {
				scope:New('UIStroke') {
					Color = PALETTE.accent,
					Transparency = scope:Computed(function(use) return use(isActive) and 0.2 or 0.8 end),
					Thickness = 1,
				},
			},
		})
	end
	return scope:New('Frame') {
		Size = UDim2.new(1, 0, 0, DESIGN_RIGHT_TAB_H),
		BackgroundTransparency = 1,
		[Fusion.Children] = children,
	}
end

----------------------------------------------------------------------
-- Inventory row: colored swatch + item name + slot label + equipped tag.
-- Clicking sets SelectedItem, which the arcane panel title binds to.
----------------------------------------------------------------------
local function buildInventoryEntry(scope, item: InvItem)
	local c = TIER_COLOR[item.tier] or PALETTE.accent
	local isSelected = scope:Computed(function(use) return use(SelectedItem) == item.id end)
	return scope:New('TextButton') {
		Size = UDim2.new(1, 0, 0, DESIGN_INV_ROW_H),
		AutoButtonColor = false,
		BackgroundColor3 = c,
		BackgroundTransparency = scope:Computed(function(use) return use(isSelected) and 0.8 or 0.92 end),
		BorderSizePixel = 0,
		Text = '',
		[Fusion.OnEvent('Activated')] = function() SelectedItem:set(item.id) end,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = c,
				Transparency = scope:Computed(function(use) return use(isSelected) and 0.2 or 0.7 end),
				Thickness = 1,
			},
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, DESIGN_INV_PAD_X),
				PaddingRight = UDim.new(0, DESIGN_INV_PAD_X),
				PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
			},
			-- Colored swatch (placeholder for item icon).
			scope:New('Frame') {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 0, 0.5, 0),
				Size = UDim2.fromOffset(DESIGN_INV_SWATCH, DESIGN_INV_SWATCH),
				BackgroundColor3 = c,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					scope:New('UIAspectRatioConstraint') { AspectRatio = 1 },
					scope:New('UIStroke') { Color = c, Transparency = 0.3, Thickness = 1 },
				},
			},
			-- Name (top line).
			scope:New('TextLabel') {
				Position = UDim2.fromOffset(DESIGN_INV_SWATCH + 10, 4),
				Size = UDim2.new(1, -(DESIGN_INV_SWATCH + 10 + 60), 0, 16),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = item.name,
				TextSize = 13, TextColor3 = c,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			-- Slot label (below name).
			scope:New('TextLabel') {
				Position = UDim2.fromOffset(DESIGN_INV_SWATCH + 10, 20),
				Size = UDim2.new(1, -(DESIGN_INV_SWATCH + 10 + 60), 0, 12),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = string.upper(item.slot) .. ' · ' .. string.upper(item.tier),
				TextSize = 9, TextColor3 = PALETTE.inkFaint,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			-- Equipped tag + "SELECTED" marker.
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.fromOffset(72, DESIGN_INV_ROW_H - 12),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					if use(isSelected) then return '◆ ACTIVE' end
					return item.equipped and 'EQUIPPED' or ''
				end),
				TextSize = 9, TextColor3 = scope:Computed(function(use)
					return use(isSelected) and PALETTE.accent or PALETTE.inkFaint
				end),
				TextXAlignment = Enum.TextXAlignment.Right,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
		},
	}
end

local function buildInventoryList(scope)
	local children: {any} = {
		scope:New('UIListLayout') {
			FillDirection = Enum.FillDirection.Vertical,
			Padding = UDim.new(0, DESIGN_INV_ROW_GAP),
			SortOrder = Enum.SortOrder.LayoutOrder,
		},
	}
	for i, item in EQUIPMENT do
		local row = buildInventoryEntry(scope, item)
		row.LayoutOrder = i
		table.insert(children, row)
	end
	return scope:New('ScrollingFrame') {
		Name = 'Inventory',
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = PALETTE.accent,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		[Fusion.Children] = children,
	}
end

local function buildCatalog(scope)
	local children: {any} = {
		scope:New('UIListLayout') {
			Padding = UDim.new(0, DESIGN_ENTRY_GAP),
			SortOrder = Enum.SortOrder.LayoutOrder,
		},
	}
	for i, e in ENCHANTS do
		local entry = buildCatalogEntry(scope, e)
		entry.LayoutOrder = i
		entry.Visible = scope:Computed(function(use)
			local f = use(SchoolFilter)
			return f == 'all' or e.school == f
		end)
		table.insert(children, entry)
	end
	return scope:New('ScrollingFrame') {
		Name = 'Catalog',
		-- Fills remaining height of the right column (header + filter stripped).
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = PALETTE.accent,
		[Fusion.Children] = children,
	}
end

----------------------------------------------------------------------
-- Panels: left flex column + right pixel-width catalog column.
-- Root fills its tab content parent via fromScale(1, 1).
----------------------------------------------------------------------
----------------------------------------------------------------------
-- Floating tooltip: absolute-positioned Frame reading ActiveTooltip.
-- Parented to the widget's ScreenGui so it overlays every modal
-- element. Non-interactive (Active = false) so it doesn't swallow
-- hovers from the buttons beneath it.
----------------------------------------------------------------------
local function buildTooltip(scope)
	return scope:New('Frame') {
		Name = 'Tooltip',
		AnchorPoint = Vector2.new(0, 0),
		Position = scope:Computed(function(use)
			local t = use(ActiveTooltip)
			if not t then return UDim2.new() end
			return UDim2.fromOffset(t.x, t.y)
		end),
		Size = UDim2.fromOffset(240, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = PALETTE.bg1,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		Visible = scope:Computed(function(use) return use(ActiveTooltip) ~= nil end),
		ZIndex = 100,
		Active = false,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = scope:Computed(function(use)
					local t = use(ActiveTooltip); return t and t.color or PALETTE.accent
				end),
				Transparency = 0.2, Thickness = 1,
			},
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
				PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 4),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:New('TextLabel') {
				LayoutOrder = 0,
				Size = UDim2.new(1, 0, 0, 14),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = scope:Computed(function(use) local t = use(ActiveTooltip); return t and t.title or '' end),
				TextSize = 12,
				TextColor3 = scope:Computed(function(use)
					local t = use(ActiveTooltip); return t and t.color or PALETTE.accent
				end),
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use) local t = use(ActiveTooltip); return t and t.body or '' end),
				TextSize = 11, TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
			},
		},
	}
end

local function buildPanels(scope)
	-- LEFT: arcane circle + chosen list + cost bar, stacked vertically.
	-- Flex-fills remaining width to the left of the pixel-width catalog.
	local leftCol = scope:New('Frame') {
		Name = 'Left',
		Size = UDim2.new(1, -DESIGN_CATALOG_W, 1, 0),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, DESIGN_LEFT_PAD_Y),
				PaddingBottom = UDim.new(0, DESIGN_LEFT_PAD_Y),
				PaddingLeft = UDim.new(0, DESIGN_LEFT_PAD_X),
				PaddingRight = UDim.new(0, DESIGN_LEFT_PAD_X),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, DESIGN_LEFT_STACK_GAP),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- Arcane visual: flex-fills remaining vertical space above the
			-- chosen-list + cost-bar block. We express this with a Scale-Y
			-- of 1 and pixel subtraction for the fixed rows underneath —
			-- kept shallow so Scale doesn't compound deeper.
			scope:New('Frame') {
				LayoutOrder = 1,
				Size = UDim2.new(
					1, 0,
					1, -(DESIGN_CHOSEN_HEADER_H + DESIGN_CHOSEN_HEADER_GAP
						+ DESIGN_CHOSEN_SCROLL_H
						+ DESIGN_INSCRIBE_H + DESIGN_LEFT_STACK_GAP * 3)
				),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UISizeConstraint') {
						MinSize = Vector2.new(0, DESIGN_ARCANE_MIN_H),
					},
					buildArcanePanel(scope),
				},
			},
			-- Chosen eyebrow + scroll grid. Eyebrow reads the live count.
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, DESIGN_CHOSEN_HEADER_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					local n = 0
					for _ in use(Chosen) do n += 1 end
					return string.format('◆ CHOSEN INSCRIPTIONS · %d', n)
				end),
				TextSize = 10, TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			-- ScrollingFrame so overflow inscriptions scroll vertically
			-- rather than pushing the arcane panel up. AutomaticSize.Y
			-- grows the viewport to fit content up to DESIGN_CHOSEN_SCROLL_H
			-- (via UISizeConstraint), then AutomaticCanvasSize.Y makes the
			-- canvas track content so the scroll bar engages.
			scope:New('ScrollingFrame') {
				LayoutOrder = 3,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				CanvasSize = UDim2.new(),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ScrollBarThickness = 4,
				ScrollBarImageColor3 = PALETTE.accent,
				ScrollingDirection = Enum.ScrollingDirection.Y,
				[Fusion.Children] = {
					scope:New('UISizeConstraint') {
						MaxSize = Vector2.new(math.huge, DESIGN_CHOSEN_SCROLL_H),
					},
					buildChosenList(scope),
				},
			},
			(function()
				local bar = buildCostBar(scope); bar.LayoutOrder = 4; return bar
			end)(),
		},
	}

	-- RIGHT: pixel-width catalog column (header + filter + scrolling list).
	local rightCol = scope:New('Frame') {
		Name = 'Right',
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, DESIGN_CATALOG_W, 1, 0),
		BackgroundColor3 = PALETTE.bg1,
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.85, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, DESIGN_RIGHT_PAD),
				PaddingBottom = UDim.new(0, DESIGN_RIGHT_PAD),
				PaddingLeft = UDim.new(0, DESIGN_RIGHT_PAD),
				PaddingRight = UDim.new(0, DESIGN_RIGHT_PAD),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, DESIGN_RIGHT_HEADER_GAP),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- Tab bar: INVENTORY | INSCRIPTIONS (pinned at top).
			(function() local b = buildRightTabBar(scope); b.LayoutOrder = 1; return b end)(),
			-- Dynamic eyebrow: reflects whichever tab is active.
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, DESIGN_RIGHT_HEADER_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					return use(RightTab) == 'inventory' and '◆ EQUIPMENT' or '◆ ENCHANT CATALOG'
				end),
				TextSize = 10, TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			-- Inscriptions pane: school filter (only while inscriptions
			-- tab is active — the filter has no meaning for inventory).
			-- Visibility is bound via scope:Hydrate so the Computed is
			-- actually observed; assigning .Visible directly on a built
			-- instance would just set a Lua table and never react.
			(function()
				local f = buildSchoolFilter(scope)
				f.LayoutOrder = 3
				scope:Hydrate(f) {
					Visible = scope:Computed(function(use) return use(RightTab) == 'inscriptions' end),
				}
				return f
			end)(),
			-- Content area: fills remaining height. Both panes live here
			-- behind a Visible-gate so their internal state (scroll
			-- position, per-entry computeds) survives tab switches
			-- rather than being rebuilt each time.
			scope:New('Frame') {
				LayoutOrder = 4,
				Size = UDim2.new(
					1, 0,
					1, -(DESIGN_RIGHT_TAB_H + DESIGN_RIGHT_HEADER_H
						+ DESIGN_FILTER_ROW_H + DESIGN_RIGHT_HEADER_GAP * 3 + DESIGN_FILTER_GAP)
				),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					-- Inscriptions (existing catalog) — reactive Visible
					-- via Hydrate so tab clicks actually toggle it.
					(function()
						local c = buildCatalog(scope)
						scope:Hydrate(c) {
							Visible = scope:Computed(function(use) return use(RightTab) == 'inscriptions' end),
						}
						return c
					end)(),
					-- Inventory list — same Hydrate pattern.
					(function()
						local inv = buildInventoryList(scope)
						scope:Hydrate(inv) {
							Visible = scope:Computed(function(use) return use(RightTab) == 'inventory' end),
						}
						return inv
					end)(),
				},
			},
		},
	}

	return scope:New('Frame') {
		Name = 'EnchantingWidget',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = { leftCol, rightCol },
	}
end

-- // Lifecycle // --

function Module.IsWidgetOpen(): boolean
	return IsOpen and peek(IsOpen) or false
end

function Module.OpenWidget()
	if not IsOpen then return end
	-- Level gate (default L20). Per-player flag OR server-wide global.
	local data = ReplicatedData.GetData('PlayerData', false)
	local globalBypass = LevelGatesClient.GetGlobalBypass()
	if data and not LevelGates.CanUseSystem(data, LevelGates.Systems.Enchant, globalBypass) then
		LevelLockOverlay.Show(LevelGates.Systems.Enchant, tonumber(data.Level) or 1)
		return
	end
	IsOpen:set(true)
end

function Module.CloseWidget()
	if not IsOpen then return end
	IsOpen:set(false)
end

function Module.Start()
	ScreenGui = HUDCommon.ensureScreenGui('HUD_Enchanting', 41)

	local scope = scoped(Fusion)
	RootScope = scope

	IsOpen          = scope:Value(false)
	Chosen          = scope:Value({ sharpness = 3, vorpal = 2, lifesteal = 2, bleed = 1 })
	SchoolFilter    = scope:Value('all')
	AvailableXP     = scope:Value(184)
	AvailableSigils = scope:Value(42)
	-- Right panel defaults: open on the inscriptions tab with Elucidator
	-- selected, matching the pre-tab behaviour so nothing shifts visually
	-- on first open — the INVENTORY tab is a discoverable alternative.
	RightTab        = scope:Value('inscriptions')
	SelectedItem    = scope:Value('elucidator')
	ActiveTooltip   = scope:Value(nil)

	local root, content = HUDCommon.workstationShell(scope, {
		Title = 'ENCHANTING TABLE',
		Subtitle = '· Etch words of power into worked metal ·',
		Location = '',
		Visible = IsOpen,
		OnClose = Module.CloseWidget,
		Width = 1240, Height = 720,
	})
	root.Parent = ScreenGui

	local panels = buildPanels(scope)
	panels.Parent = content

	-- Tooltip sits at the ScreenGui root so it overlays the whole modal.
	local tooltip = buildTooltip(scope)
	tooltip.Parent = ScreenGui

	ContextActionService:BindAction('EnchantingEscape', function(_, inputState)
		if inputState == Enum.UserInputState.Begin and Module.IsWidgetOpen() then
			Module.CloseWidget()
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.Escape)

	local ZoneService = ReplicatedModules.Services.ZoneService
	ZoneService.ZoneEnter:Connect(function(character, zoneName)
		if character == LocalPlayer.Character and zoneName == "EnchantCircle" then
			Module.OpenWidget()
		end
	end)
	ZoneService.ZoneLeave:Connect(function(character, zoneName)
		if character == LocalPlayer.Character and zoneName == "EnchantCircle" then
			LevelLockOverlay.HideIfShowing(LevelGates.Systems.Enchant)
			Module.CloseWidget()
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/MusicWidget"><![CDATA[-- Music player pill (bottom-right).
-- Ported to Fusion 0.3. Zone-based playlist logic preserved from original.
--
-- Layout strategy (see .claude/skills/custom-roblox-ui/SKILL.md):
--   * Top-level pill: Scale-sized + UIAspectRatioConstraint(FitWithinMaxSize,
--     width-dominant) so the 260:54 pill keeps its shape on any screen aspect.
--   * Inside the pill: pixel offsets (UIPadding, row heights, bar height, ball
--     size). The pill's aspect is locked, so the inner pixel design is safe;
--     converting these to Scale would compound to invisibility (skill Pitfall 1).
--   * Progress bar: 4 px pixel-exact height, pinned to bottom of content area
--     via AnchorPoint(0, 1) + Position.fromScale(0, 1).
--   * Progress ball: 6x6 pixel, AnchorPoint(0.5, 0.5), Position.fromScale(alpha, 0.5).

local Players = game:GetService('Players')
local TweenService = game:GetService('TweenService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local doCleanup = Fusion.doCleanup
local peek = Fusion.peek

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local MusicData = LocalModules.Data.MusicData
local SettingsRegistry = LocalModules.Modules.SettingsRegistry
local PALETTE = HUDCommon.PALETTE

local ZoneService = ReplicatedModules.Services.ZoneService

local MUSIC_FADE_TI = TweenInfo.new(2, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)

local MusicSoundInstance = Instance.new('Sound')
MusicSoundInstance.Name = 'MusicBackground'
MusicSoundInstance.Looped = true
MusicSoundInstance.Parent = workspace

local CurrentSoundId = false
local CurrentSoundData = false
local ActiveRegionId = false

local SystemsContainer = {}

local function setProperties(target, props)
	for k, v in props do target[k] = v end
end

-- CamelCase → spaced. Splits at every capital that follows a lowercase
-- letter or digit (`forestBattle` → `forest Battle`, `boss1Theme` →
-- `boss1 Theme`), then handles acronym→Word transitions on a second pass
-- (`ABCBoss` → `ABC Boss`). The previous implementation prepended a space
-- before every capital and stripped position 1, which dropped the first
-- character of any string that didn't already start with a capital and
-- double-spaced strings that already contained spaces.
local function spaceTextByCapitals(text: string): string
	if not text or text == '' then return text or '' end
	local result = string.gsub(text, '([%l%d])(%u)', '%1 %2')
	result = string.gsub(result, '(%u)(%u%l)', '%1 %2')
	return result
end

local function formatTime(sec: number): string
	if sec ~= sec or sec < 0 then sec = 0 end
	return string.format('%02d:%02d', math.floor(sec / 60), math.floor(sec % 60))
end

-- // Module // --
local Module = { MusicSoundInstance = MusicSoundInstance }
Module.IsOpen = false

local RootScope = nil
local ScreenGui = nil
local SongTitle  = nil -- Value<string>
local SongIdTxt  = nil -- Value<string>
local Duration   = nil -- Value<string>   e.g. "01:23 / 03:45"
local BarAlpha   = nil -- Value<number>   0..1
-- Pill alpha — 0 = fully visible, 1 = max-faded. Driven by the toast
-- count: while toasts are on screen, the pill fades back so the
-- toast stack reads cleanly. Tweened in Start via TweenService on a
-- backing NumberValue so the fade is smooth, not a hard pop.
local PillAlpha  = nil -- Value<number>   0..1

function Module.IsWidgetOpen(): boolean
	return Module.IsOpen and ScreenGui ~= nil
end

function Module.GetRegionMusicList()
	local active = ZoneService.GetZonesPlayerIsWithin(LocalPlayer)
	if table.find(active, ActiveRegionId) then
		return MusicData.RegionSongs[ActiveRegionId]
	end
	local regionPlaylist = false
	for _, id in active do
		regionPlaylist = MusicData.RegionSongs[id]
		if regionPlaylist then ActiveRegionId = id; break end
	end
	if not regionPlaylist then
		ActiveRegionId = 'Default'
		regionPlaylist = MusicData.RegionSongs.Default
	end
	return regionPlaylist
end

-- Effective playback volume for the currently-loaded song. Combines the
-- per-track config volume with the user's master * music sliders so a
-- mid-song settings change can be reflected without a fade-out.
local function targetSongVolume(): number
	if not CurrentSoundData or not CurrentSoundData.Properties then return 0 end
	local base = CurrentSoundData.Properties.Volume or 0
	return base * SettingsRegistry.GetMusicMultiplier()
end

function Module.FadeSoundOut()
	local t = TweenService:Create(MusicSoundInstance, MUSIC_FADE_TI, { Volume = 0 })
	t:Play(); t.Completed:Wait()
	MusicSoundInstance:Stop()
	MusicSoundInstance.Volume = 0
end

function Module.FadeSoundIn()
	MusicSoundInstance:Play()
	TweenService:Create(MusicSoundInstance, MUSIC_FADE_TI, {
		Volume = targetSongVolume(),
	}):Play()
end

function Module.UpdateSongPlaylist()
	local songIds = Module.GetRegionMusicList()
	if table.find(songIds, CurrentSoundId) then return end

	if MusicSoundInstance.Volume > 0 then
		Module.FadeSoundOut()
	end

	if #songIds == 0 then return end

	local rng = Random.new()
	local chosen = songIds[rng:NextInteger(1, #songIds)]
	while CurrentSoundId == chosen and #songIds > 1 do
		chosen = songIds[rng:NextInteger(1, #songIds)]
		task.wait()
	end
	CurrentSoundId = chosen
	CurrentSoundData = MusicData.SongData[chosen]

	if SongTitle then
		SongTitle:set(spaceTextByCapitals(chosen))
		Duration:set('00:00 / 00:00')
		local id = CurrentSoundData.Properties.SoundId or ''
		local parts = string.split(id, 'rbxassetid://')
		SongIdTxt:set(parts[2] or id)
		BarAlpha:set(0)
	end

	setProperties(MusicSoundInstance, CurrentSoundData.Properties)
	Module.FadeSoundIn()
end

function Module.UpdateWidget() end

----------------------------------------------------------------------
-- Design dimensions (pixels on the 1920x1080 reference canvas).
-- Every Scale value in the file is derived from these constants.
----------------------------------------------------------------------
local DESIGN_SCREEN_W, DESIGN_SCREEN_H = 1920, 1080

-- Pill outer shell. Enlarged + spaced so the title + progress bar + meta
-- row all get breathing room instead of stacking on top of each other.
-- Pill bumped from 360×84 → 360×104 so the title + bar + meta rows
-- aren't crammed; the song title sits visibly above the bar instead of
-- overlapping the duration row.
local DESIGN_PILL_W, DESIGN_PILL_H = 360, 104
local DESIGN_PILL_PAD_X            = 16
local DESIGN_PILL_PAD_Y            = 10

-- Inside-pill atoms. Values are still expressed as PIXELS at the design
-- resolution (360×84 pill, 328×60 content area after padding), but every
-- UDim2 consuming them below divides by the content-area dimension to
-- produce a pure SCALE value — so nothing in the tree is raw offset.
local DESIGN_EYEBROW_H  = 12
local DESIGN_TITLE_H    = 22
local DESIGN_BAR_H      = 6
local DESIGN_BALL       = 10
local DESIGN_SONGID_W   = 90
local DESIGN_DURATION_W = 100
local DESIGN_META_H     = 14   -- height of song-id/duration meta rows
local DESIGN_TITLE_GAP  = 2    -- gap between eyebrow row and title row (smaller → title sits closer to eyebrow)
local DESIGN_BAR_GAP    = 4    -- gap between duration text and progress bar

-- Content area (after symmetric padding is applied by UIPadding). Every
-- inner Scale value is a pixel dimension divided by one of these.
local DESIGN_CONTENT_W = DESIGN_PILL_W - 2 * DESIGN_PILL_PAD_X  -- 328
local DESIGN_CONTENT_H = DESIGN_PILL_H - 2 * DESIGN_PILL_PAD_Y  -- 60

-- Screen-anchor insets for the pill's bottom-right corner.
local ANCHOR_INSET_X = 20 / DESIGN_SCREEN_W   -- 20 px from right edge at 1920
local ANCHOR_INSET_Y = 20 / DESIGN_SCREEN_H   -- 20 px from bottom edge at 1080

local function buildUI(scope)
	-- Wrap the pill in a CanvasGroup so a single GroupTransparency
	-- can fade the *whole* widget (pill background + stroke + every
	-- text label + the progress bar) in one binding. The toast
	-- subscriber in Start drives PillAlpha; with the CanvasGroup
	-- wrapping, all visible elements fade in lockstep — no per-child
	-- transparency wiring across the children tree.
	local canvas = scope:New('CanvasGroup') {
		Name = 'MusicCanvas',
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, 0, 1, 0),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		GroupTransparency = scope:Computed(function(use)
			return math.clamp(use(PillAlpha), 0, 1)
		end),
	}
	canvas.Parent = ScreenGui
	-- Top-level pill. Scale-sized from design px / screen px, then locked to
	-- its 260:54 aspect via UIAspectRatioConstraint(FitWithinMaxSize). The
	-- pill keeps its designed shape on 16:9, 32:9, or portrait.
	local root = HUDCommon.chiseledPanel(scope, {
		Name = 'MusicPill',
		Size = UDim2.fromScale(DESIGN_PILL_W / DESIGN_SCREEN_W, DESIGN_PILL_H / DESIGN_SCREEN_H),
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, 0, 1, 0) - UDim2.fromScale(ANCHOR_INSET_X, ANCHOR_INSET_Y),
		AccentColor = PALETTE.violet,
		-- Shape lock on the panel ROOT (not inside Children) so the pill
		-- itself stays 360:84 — previously the constraint was on the inner
		-- children wrapper, leaving the pill root free to stretch on wide
		-- screens which is what created the gap to the right of the content.
		AspectRatio = DESIGN_PILL_W / DESIGN_PILL_H,
		Children = {
			-- Padding in SCALE of the pill. The pill is aspect-locked so this
			-- gives a constant-proportion inset regardless of screen size.
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(DESIGN_PILL_PAD_Y / DESIGN_PILL_H, 0),
				PaddingBottom = UDim.new(DESIGN_PILL_PAD_Y / DESIGN_PILL_H, 0),
				PaddingLeft   = UDim.new(DESIGN_PILL_PAD_X / DESIGN_PILL_W, 0),
				PaddingRight  = UDim.new(DESIGN_PILL_PAD_X / DESIGN_PILL_W, 0),
			},

			-- Row 1: eyebrow "NOW PLAYING". Scale height = eyebrow_h / content_h.
			HUDCommon.eyebrowLabel(scope, {
				Text = '\u{266A} NOW PLAYING',
				Color = PALETTE.violet,
				Size = UDim2.fromScale(1, DESIGN_EYEBROW_H / DESIGN_CONTENT_H),
				TextSize = 11,
			}),

			-- Row 1-right: song id, anchored to eyebrow row (y=0).
			scope:New('TextLabel') {
				Name = 'SongId',
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.fromScale(1, 0),
				Size = UDim2.fromScale(
					DESIGN_SONGID_W / DESIGN_CONTENT_W,
					DESIGN_EYEBROW_H / DESIGN_CONTENT_H
				),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				TextSize = 10,
				TextColor3 = PALETTE.inkDim,
				Text = scope:Computed(function(use) return use(SongIdTxt) end),
				TextXAlignment = Enum.TextXAlignment.Right,
				TextYAlignment = Enum.TextYAlignment.Center,
			},

			-- Row 2: song title. Position Y = (eyebrow + gap) / content_h.
			-- TextSize dropped from 18 → 14 so the title doesn't dominate
			-- the pill; the larger pill height + smaller text + tighter
			-- title-gap shifts the eyebrow + id + title visually upward
			-- and gives the bar/meta row room to breathe at the bottom.
			scope:New('TextLabel') {
				Name = 'SongTitle',
				Position = UDim2.fromScale(
					0,
					(DESIGN_EYEBROW_H + DESIGN_TITLE_GAP) / DESIGN_CONTENT_H
				),
				Size = UDim2.fromScale(1, DESIGN_TITLE_H / DESIGN_CONTENT_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				TextSize = 14,
				TextColor3 = PALETTE.ink,
				Text = scope:Computed(function(use) return use(SongTitle) end),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
				TextTruncate = Enum.TextTruncate.AtEnd,
			},

			-- Row 3: duration, anchored bottom-right above the bar. Inset Y
			-- (bar_h + gap) / content_h — all scale, no offset pixels.
			scope:New('TextLabel') {
				Name = 'Duration',
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.fromScale(
					1,
					1 - (DESIGN_BAR_H + DESIGN_BAR_GAP) / DESIGN_CONTENT_H
				),
				Size = UDim2.fromScale(
					DESIGN_DURATION_W / DESIGN_CONTENT_W,
					DESIGN_META_H / DESIGN_CONTENT_H
				),
				AutomaticSize = Enum.AutomaticSize.None,
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				TextSize = 12,
				TextColor3 = PALETTE.violet,
				Text = scope:Computed(function(use) return use(Duration) end),
				TextXAlignment = Enum.TextXAlignment.Right,
				TextYAlignment = Enum.TextYAlignment.Center,
			},

			-- Progress bar track: scale both axes. Pinned to bottom of content.
			scope:New('Frame') {
				Name = 'Progress',
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.fromScale(0, 1),
				Size = UDim2.fromScale(1, DESIGN_BAR_H / DESIGN_CONTENT_H),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.3,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					-- Filled portion: width scales with alpha, full bar height.
					scope:New('Frame') {
						Name = 'Bar',
						Size = scope:Computed(function(use)
							return UDim2.fromScale(math.clamp(use(BarAlpha), 0, 1), 1)
						end),
						BackgroundColor3 = PALETTE.violet,
						BorderSizePixel = 0,
					},
					-- Progress ball: scale width, aspect-constrained to square.
					-- ScaleWithParentSize + Width dominant → width derived from
					-- parent's X (content width) and height forced to match.
					scope:New('Frame') {
						Name = 'Ball',
						AnchorPoint = Vector2.new(0.5, 0.5),
						Size = UDim2.fromScale(DESIGN_BALL / DESIGN_CONTENT_W, 0),
						Position = scope:Computed(function(use)
							return UDim2.fromScale(math.clamp(use(BarAlpha), 0, 1), 0.5)
						end),
						BackgroundColor3 = PALETTE.accentHot,
						BorderSizePixel = 0,
						[Fusion.Children] = {
							scope:New('UIAspectRatioConstraint') {
								AspectRatio = 1,
								AspectType = Enum.AspectType.ScaleWithParentSize,
								DominantAxis = Enum.DominantAxis.Width,
							},
							scope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
						},
					},
				},
			},
		},
	})
	root.Parent = canvas
end

function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true
	ScreenGui = HUDCommon.ensureScreenGui('HUD_Music', 4)
	RootScope = scoped(Fusion)

	SongTitle = RootScope:Value('')
	SongIdTxt = RootScope:Value('')
	Duration  = RootScope:Value('00:00 / 00:00')
	BarAlpha  = RootScope:Value(0)
	PillAlpha = RootScope:Value(0)

	buildUI(RootScope)

	-- Sync the freshly-built Fusion Values to whatever audio state
	-- already exists. The audio side (CurrentSoundId / MusicSoundInstance)
	-- is module-level and survives close/open cycles, but the UI Values
	-- live in RootScope and reset every open. Without this catch-up the
	-- pill renders empty whenever the widget is reopened (theme rebuild,
	-- visibility toggle, deferred-Start order) — UpdateSongPlaylist won't
	-- re-sync because its early-out skips when CurrentSoundId is already
	-- in the current zone's playlist.
	if typeof(CurrentSoundId) == 'string' and CurrentSoundData
		and CurrentSoundData.Properties then
		SongTitle:set(spaceTextByCapitals(CurrentSoundId))
		local id = CurrentSoundData.Properties.SoundId or ''
		local parts = string.split(id, 'rbxassetid://')
		SongIdTxt:set(parts[2] or id)
	end
end

function Module.CloseWidget()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
end

-- Target alpha when toasts are present. Tunable: 0.55 = pill fades
-- to 45% visible, soft enough to read toasts on top without fully
-- losing the music context. Lerp time tuned so the fade reads as a
-- responsive UI cue, not a sluggish animation.
local PILL_FADE_ALPHA = 0.55
local PILL_FADE_TIME  = 0.35

-- Drive PillAlpha toward `target` over PILL_FADE_TIME seconds. Cancels
-- any in-flight fade by tracking a generation counter on the local
-- module — a fresh fade bumps the counter; older fades early-exit on
-- mismatch. Without this, rapid toast-add → toast-clear sequences
-- would race two task.spawn loops driving the same Value.
local PillFadeGen = 0
local function fadePillTo(target: number)
	if not PillAlpha then return end
	PillFadeGen += 1
	local gen = PillFadeGen
	local from = peek(PillAlpha)
	local t0 = os.clock()
	task.spawn(function()
		while gen == PillFadeGen do
			local elapsed = os.clock() - t0
			local a = math.clamp(elapsed / PILL_FADE_TIME, 0, 1)
			-- Smoothstep so the fade eases in/out instead of a linear ramp.
			a = a * a * (3 - 2 * a)
			PillAlpha:set(from + (target - from) * a)
			if elapsed >= PILL_FADE_TIME then
				PillAlpha:set(target)
				return
			end
			task.wait()
		end
	end)
end

function Module.Start()
	task.spawn(function()
		while true do
			task.wait(1)
			if CurrentSoundData and Duration then
				local pos = MusicSoundInstance.TimePosition
				local len = MusicSoundInstance.TimeLength
				Duration:set(string.format('%s / %s', formatTime(pos), formatTime(len)))
				if len > 0 then
					BarAlpha:set(pos / len)
				end
			end
		end
	end)

	-- Toast-presence fade. ToastWidget exposes OnCountChanged via its
	-- module surface; we pull the live module from SystemsContainer
	-- (or its widget-namespace parent) so the connection survives a
	-- reload of either widget independently.
	local function getToastWidget()
		return SystemsContainer.ToastWidget
			or (SystemsContainer.ParentSystems and SystemsContainer.ParentSystems.Widgets
				and SystemsContainer.ParentSystems.Widgets.ToastWidget)
	end
	local function applyToastFade(count: number)
		fadePillTo(count > 0 and PILL_FADE_ALPHA or 0)
	end
	local toastWidget = getToastWidget()
	if toastWidget and toastWidget.OnCountChanged then
		toastWidget.OnCountChanged:Connect(applyToastFade)
		-- Catch-up: a toast may already be on screen at the moment
		-- this widget loads (race between Start orderings).
		applyToastFade(toastWidget.GetActiveCount and toastWidget.GetActiveCount() or 0)
	end

	ZoneService.ZoneEnter:Connect(Module.UpdateSongPlaylist)
	ZoneService.ZoneLeave:Connect(Module.UpdateSongPlaylist)
	MusicSoundInstance.Ended:Connect(function()
		MusicSoundInstance:Stop()
		Module.UpdateSongPlaylist()
	end)

	-- Re-multiply the live song's volume whenever the master/music sliders
	-- move. Skipped while the sound isn't playing (FadeSoundIn will pick up
	-- the latest multiplier on its own).
	SettingsRegistry.Changed:Connect(function(key)
		if key ~= 'MasterVolume' and key ~= 'MusicVolume' then return end
		if MusicSoundInstance.IsPlaying then
			MusicSoundInstance.Volume = targetSongVolume()
		end
	end)

	HUDCommon.BindLiveTheme(Module)

	-- Visibility toggle wired to SettingsRegistry.MusicWidgetEnabled.
	-- Open/close on flip; on initial load we honor the registry value.
	SettingsRegistry.Changed:Connect(function(key, value)
		if key ~= 'MusicWidgetEnabled' then return end
		if value then
			Module.OpenWidget()
		else
			Module.CloseWidget()
		end
	end)

	task.defer(Module.UpdateSongPlaylist)
	task.delay(3, function()
		if SettingsRegistry.MusicWidgetEnabled then
			Module.OpenWidget()
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/WaystonesWidget"><![CDATA[-- Waystone teleport panel. Ported to Fusion 0.3.
-- Visual: floor-category list on the left, waystone list on the right.
-- InteractableService + server teleport remote preserved from original.
--
-- Layout strategy (see .claude/skills/custom-roblox-ui/SKILL.md):
--   * Top-level modal: AnchorPoint(0.5, 0.5) + Position=fromScale(0.5, 0.5),
--     Scale-sized with UIAspectRatioConstraint(520/320, FitWithinMaxSize) so
--     the designed panel shape is preserved on ultrawide/portrait screens
--     rather than stretching (SKILL §2, §8).
--   * Wrapped in a CanvasGroup so we can fade the whole panel in/out via
--     GroupTransparency (SKILL §7).
--   * Title, close button, waystone rows use pixel offsets + DESIGN_*
--     constants (SKILL §8); no magic scale values.

local CollectionService = game:GetService('CollectionService')
local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local doCleanup = Fusion.doCleanup
local peek = Fusion.peek

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local CombatLog = LocalModules.Modules.CombatLog
local PALETTE = HUDCommon.PALETTE

local WaystonesData = ReplicatedModules.Data.Waystones
local InteractableService = ReplicatedModules.Services.InteractableService
local ReplicatedData = ReplicatedModules.Services.ReplicatedData

local RemoteService = ReplicatedModules.Services.RemoteService
local WaystonesEvent = RemoteService.GetRemote('WaystonesEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local ACTIVE_WAYSTONES_CACHE = {}
local ACTIVE_WAYSTONE_ID: string? = nil
local ACTIVE_WAYSTONE_MODEL: Model? = nil
local WAYSTONE_TELEPORT_DEBOUNCE = true

----------------------------------------------------------------------
-- Design dimensions (pixels on the 1920x1080 reference canvas).
-- Every Scale value in the file is derived from these constants.
----------------------------------------------------------------------
local DESIGN_SCREEN_W, DESIGN_SCREEN_H = 1920, 1080
local DESIGN_PANEL_W, DESIGN_PANEL_H   = 520, 320
local DESIGN_TITLE_H                   = 20
local DESIGN_PAD                       = 14
local DESIGN_CLOSE_BTN_W               = 28
local DESIGN_CLOSE_BTN_H               = 22
local DESIGN_CLOSE_INSET               = 10
local DESIGN_WAYSTONE_ROW_H            = 28
local DESIGN_LIST_GAP                  = 4
-- Left/right split of the content area (floors rail vs waystone list).
local DESIGN_LEFT_FRAC                 = 0.42
local DESIGN_COL_GAP                   = 8

-- // Module // --
local Module = {}
Module.IsOpen = false

local RootScope = nil
local ScreenGui = nil
local ActiveCategory = nil -- Value<string>
local DataVersion    = nil -- Value<number>  -- bumped to re-render lists
local PlayerFloor    = nil -- Value<string?>

function Module.IsWidgetOpen(): boolean
	return Module.IsOpen and ScreenGui ~= nil
end

function Module.ClearActiveWaystone()
	ACTIVE_WAYSTONE_ID = nil
	ACTIVE_WAYSTONE_MODEL = nil
end

function Module.IsWaystoneUnlocked(waystoneId: string): boolean
	local config = WaystonesData.WaystoneDisplays[waystoneId]
	if not config then return false end
	if config.AutoUnlock then return true end
	local data = ReplicatedData.GetData('PlayerData', false)
	if not data then return false end
	return table.find(data.Waystones or {}, waystoneId) ~= nil
end

function Module.IsCategoryUnlocked(category: string): boolean
	for waystoneId, display in WaystonesData.WaystoneDisplays do
		if display.Category == category and Module.IsWaystoneUnlocked(waystoneId) then
			return true
		end
	end
	return false
end

local function teleportTo(waystoneId: string)
	if not WAYSTONE_TELEPORT_DEBOUNCE then return end

	-- Combat log: prevent teleport if the player has been in combat in the
	-- last few seconds (took/dealt damage, started blocking, etc.). Stops
	-- the "fight then bail" pattern in PvP and dungeon escape.
	if CombatLog.IsInCombat() then
		print(string.format(
			'Cannot waystone-teleport while in combat (%.1fs left).',
			CombatLog.SecondsRemaining()
		))
		return
	end

	-- Cross-floor predict. Server enforces the canonical rule (cross-floor
	-- requires standing AT a major waystone — destination tier is
	-- irrelevant), so we only need a cheap "is this even cross-floor?"
	-- check before triggering the fade-to-black animation. The earlier
	-- predict compared `display.Floor` (NUMBER from config) against
	-- `LocalPlayer:GetAttribute('CurrentFloor')` (STRING name set by
	-- GameControllerServer) — those never match, so every same-floor
	-- teleport silently bailed with the spammed "(x2)" message.
	-- Read PlayerData.CurrentFloor instead — that field is the canonical
	-- floor NUMBER (line 205 of GameControllerServer.luau). Skip the
	-- predict entirely when we can't resolve a current floor or a
	-- destination floor; the server handles those edge cases.
	local display = WaystonesData.WaystoneDisplays[waystoneId]
	local data = ReplicatedData.GetData('PlayerData', false)
	local currentFloor = data and data.CurrentFloor
	if display and typeof(currentFloor) == 'number'
		and typeof(display.Floor) == 'number'
		and display.Floor ~= currentFloor then
		-- Cross-floor. We can't determine source-waystone-tier on the
		-- client cheaply (zone state is server-only), so let the server
		-- be the gatekeeper — it'll reject and the fade plays without
		-- a teleport. Worth the minor cosmetic cost to keep the predict
		-- correct (no false-positives on same-floor swaps) and the rule
		-- in one place (server).
	end

	WAYSTONE_TELEPORT_DEBOUNCE = false
	Module.CloseWidget()

	local fade = SystemsContainer.ParentSystems
		and SystemsContainer.ParentSystems.Miscellaneous
		and SystemsContainer.ParentSystems.Miscellaneous.FadeTest

	if fade then fade.FadeInBlack(1) end
	task.wait(1)
	WaystonesEvent:FireServer(waystoneId)
	task.wait(1)
	if fade then fade.FadeOutBlack(1) end

	task.delay(2, function()
		WAYSTONE_TELEPORT_DEBOUNCE = true
	end)
end

-- Build one floor-category button.
local function buildCategoryButton(scope, categoryName: string, categoryData)
	return scope:New('TextButton') {
		Name = categoryName,
		Size = UDim2.new(1, 0, 0, DESIGN_WAYSTONE_ROW_H),
		BackgroundColor3 = scope:Computed(function(use)
			return use(ActiveCategory) == categoryName and PALETTE.panel or PALETTE.bg1
		end),
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		LayoutOrder = categoryData.LayoutOrder or 0,
		FontFace = HUDCommon.FONT_BUTTON, TextSize = 12,
		TextColor3 = scope:Computed(function(use)
			return use(ActiveCategory) == categoryName and PALETTE.accent or PALETTE.ink
		end),
		Text = categoryData.Name,
		TextXAlignment = Enum.TextXAlignment.Left,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
			},
			scope:New('UIStroke') {
				Color = PALETTE.accent,
				Transparency = scope:Computed(function(use)
					return use(ActiveCategory) == categoryName and 0.4 or 0.85
				end),
				Thickness = 1,
			},
		},
		[Fusion.OnEvent 'Activated'] = function()
			ActiveCategory:set(categoryName)
		end,
	}
end

-- Build one waystone row.
local function buildWaystoneRow(scope, waystoneId: string, display)
	local color = scope:Computed(function(use)
		use(DataVersion); use(PlayerFloor)
		local unlocked = Module.IsWaystoneUnlocked(waystoneId)
		local onFloor = use(PlayerFloor) == display.Category
		local active = unlocked and (display.LargeWaystone or onFloor)
		if ACTIVE_WAYSTONE_ID == waystoneId then return PALETTE.gold end
		if active then return PALETTE.ink end
		return PALETTE.inkFaint
	end)

	return scope:New('TextButton') {
		Name = waystoneId,
		Size = UDim2.new(1, 0, 0, DESIGN_WAYSTONE_ROW_H),
		BackgroundColor3 = PALETTE.bg1,
		BackgroundTransparency = 0.4,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		LayoutOrder = display.LayoutOrder or 0,
		FontFace = HUDCommon.FONT_BUTTON, TextSize = 12,
		TextColor3 = color,
		Text = display.Name,
		TextXAlignment = Enum.TextXAlignment.Left,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
			},
			scope:New('UIStroke') {
				Color = PALETTE.accent, Transparency = 0.9, Thickness = 1,
			},
		},
		[Fusion.OnEvent 'Activated'] = function()
			local unlocked = Module.IsWaystoneUnlocked(waystoneId)
			local onFloor = peek(PlayerFloor) == display.Category
			local active = unlocked and (display.LargeWaystone or onFloor)
			if not active or ACTIVE_WAYSTONE_ID == waystoneId then
				return
			end
			teleportTo(waystoneId)
		end,
	}
end

local function buildUI(scope)
	-- Inner chiseled panel, filling the CanvasGroup.
	-- Title is positioned inside the panel (pixel inset from top-left).
	-- Close button is pixel-exact, anchored top-right with DESIGN_CLOSE_INSET.
	-- Content row sits below the title and holds the two ScrollingFrames.
	local inner = HUDCommon.chiseledPanel(scope, {
		Name = 'WaystoneFrame',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		AccentColor = PALETTE.accent,
		Children = {
			-- Title band: pixel height, top-left anchor, inset by DESIGN_PAD.
			scope:New('TextLabel') {
				Name = 'Title',
				AnchorPoint = Vector2.new(0, 0),
				Position = UDim2.fromOffset(DESIGN_PAD, DESIGN_PAD),
				Size = UDim2.new(1, -(DESIGN_PAD * 2 + DESIGN_CLOSE_BTN_W + DESIGN_CLOSE_INSET), 0, DESIGN_TITLE_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_BUTTON, TextSize = 18,
				TextColor3 = PALETTE.ink,
				Text = '\u{25C6} WAYSTONE NETWORK \u{25C6}',
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
			},

			-- Close button: top-right corner, pixel-exact (SKILL §1 idiom).
			scope:New('TextButton') {
				Name = 'CloseButton',
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -DESIGN_CLOSE_INSET, 0, DESIGN_CLOSE_INSET),
				Size = UDim2.fromOffset(DESIGN_CLOSE_BTN_W, DESIGN_CLOSE_BTN_H),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				FontFace = HUDCommon.FONT_BUTTON, TextSize = 14,
				TextColor3 = PALETTE.danger,
				Text = '\u{2715}',
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.danger, Transparency = 0.5 },
				},
				[Fusion.OnEvent 'Activated'] = function()
					Module.CloseWidget()
				end,
			},

			-- Content row: sits below the title band, inset by DESIGN_PAD on
			-- all sides. Hosts the floors rail + waystones list.
			scope:New('Frame') {
				Name = 'Content',
				AnchorPoint = Vector2.new(0, 0),
				Position = UDim2.fromOffset(DESIGN_PAD, DESIGN_PAD + DESIGN_TITLE_H + DESIGN_PAD),
				Size = UDim2.new(
					1, -(DESIGN_PAD * 2),
					1, -(DESIGN_PAD * 2 + DESIGN_TITLE_H + DESIGN_PAD)
				),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					-- Left: floors scroll (static config; built eagerly).
					(function()
						local children = {
							scope:New('UIListLayout') {
								Padding = UDim.new(0, DESIGN_LIST_GAP),
								SortOrder = Enum.SortOrder.LayoutOrder,
							},
						}
						for name, data in WaystonesData.DisplayCategories do
							table.insert(children, buildCategoryButton(scope, name, data))
						end
						return scope:New('ScrollingFrame') {
							Name = 'Floors',
							Size = UDim2.new(DESIGN_LEFT_FRAC, -DESIGN_COL_GAP / 2, 1, 0),
							BackgroundTransparency = 1,
							BorderSizePixel = 0,
							CanvasSize = UDim2.new(),
							AutomaticCanvasSize = Enum.AutomaticSize.Y,
							ScrollBarThickness = 2,
							ScrollBarImageColor3 = PALETTE.accent,
							[Fusion.Children] = children,
						}
					end)(),

					-- Right: selected-category waystones (static; visibility reactive).
					(function()
						local children = {
							scope:New('UIListLayout') {
								Padding = UDim.new(0, DESIGN_LIST_GAP),
								SortOrder = Enum.SortOrder.LayoutOrder,
							},
						}
						for id, display in WaystonesData.WaystoneDisplays do
							local visible = scope:Computed(function(use)
								return use(ActiveCategory) == display.Category
							end)
							table.insert(children, scope:New('Frame') {
								Name = id,
								Size = UDim2.new(1, 0, 0, DESIGN_WAYSTONE_ROW_H),
								BackgroundTransparency = 1,
								LayoutOrder = display.LayoutOrder or 0,
								Visible = visible,
								[Fusion.Children] = {
									buildWaystoneRow(scope, id, display),
								},
							})
						end
						return scope:New('ScrollingFrame') {
							Name = 'Selection',
							Size = UDim2.new(1 - DESIGN_LEFT_FRAC, -DESIGN_COL_GAP / 2, 1, 0),
							Position = UDim2.new(DESIGN_LEFT_FRAC, DESIGN_COL_GAP / 2, 0, 0),
							BackgroundTransparency = 1,
							BorderSizePixel = 0,
							CanvasSize = UDim2.new(),
							AutomaticCanvasSize = Enum.AutomaticSize.Y,
							ScrollBarThickness = 2,
							ScrollBarImageColor3 = PALETTE.accent,
							[Fusion.Children] = children,
						}
					end)(),
				},
			},
		},
	})

	-- Wrap in a CanvasGroup so the modal fades as a single layer and keeps
	-- its designed 520:320 aspect regardless of screen resolution.
	local root = scope:New('CanvasGroup') {
		Name = 'WaystonesRoot',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(DESIGN_PANEL_W / DESIGN_SCREEN_W, DESIGN_PANEL_H / DESIGN_SCREEN_H),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIAspectRatioConstraint') {
				AspectRatio = DESIGN_PANEL_W / DESIGN_PANEL_H,
				AspectType = Enum.AspectType.FitWithinMaxSize,
				DominantAxis = Enum.DominantAxis.Width,
			},
		},
	}
	inner.Parent = root
	root.Parent = ScreenGui
end

function Module.SetupWaystone(model: Instance)
	local waystoneId = model.Name
	if not waystoneId then
		warn(string.format('Waystone %s has no id!', model:GetFullName()))
		CollectionService:RemoveTag(model, WaystonesData.WaystonesTag)
		return
	end

	local interactable = InteractableService.RegisterInteractable({
		IID = '1',
		Object = model,
		Adornee = model:WaitForChild('Adornee'),
		Center = model:WaitForChild('Center'),
		ObjectText = 'Waystone',
		ActionText = 'Interact with the Waystone!',
		ShowBeamLine = true,
		ShowHighlight = false,
		IsInteractable = function()
			return Module.IsWaystoneUnlocked(waystoneId) and not Module.IsWidgetOpen()
		end,
	})
	ACTIVE_WAYSTONES_CACHE[model] = interactable

	interactable.InteractTriggered:Connect(function()
		ACTIVE_WAYSTONE_ID = waystoneId
		ACTIVE_WAYSTONE_MODEL = model
		Module.OpenWidget()
	end)
end

function Module.CleanupWaystone(model: Instance)
	if ACTIVE_WAYSTONES_CACHE[model] then
		InteractableService.UnRegisterInteractable(ACTIVE_WAYSTONES_CACHE[model])
		ACTIVE_WAYSTONES_CACHE[model] = nil
	end
end

function Module.OnWaystoneUnlocked(unlockedId: string)
	local display = WaystonesData.WaystoneDisplays[unlockedId]
	if not display then return end
	if DataVersion then DataVersion:set(peek(DataVersion) + 1) end
	local msg = string.format('You have discovered the waystone "%s"!', display.Name)
	local effects = SystemsContainer.ParentSystems
		and SystemsContainer.ParentSystems.Effects
	if effects and effects.UnlockedCinematic then
		effects.UnlockedCinematic.DisplayShortUnlock('Waystone Unlocked!', msg)
	end
end

function Module.UpdateWidget()
	if DataVersion then DataVersion:set(peek(DataVersion) + 1) end
	if PlayerFloor then
		PlayerFloor:set(LocalPlayer:GetAttribute('CurrentFloor'))
	end
	-- If current category still unlocked, leave it; otherwise pick first unlocked.
	if ActiveCategory then
		local current = peek(ActiveCategory)
		if not current or not Module.IsCategoryUnlocked(current) then
			for name, _ in WaystonesData.DisplayCategories do
				if Module.IsCategoryUnlocked(name) then
					ActiveCategory:set(name)
					break
				end
			end
		end
	end
end

function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true
	ScreenGui = HUDCommon.ensureScreenGui('HUD_Waystones', 8)
	RootScope = scoped(Fusion)

	ActiveCategory = RootScope:Value(LocalPlayer:GetAttribute('CurrentFloor') or 'Floor1')
	DataVersion    = RootScope:Value(0)
	PlayerFloor    = RootScope:Value(LocalPlayer:GetAttribute('CurrentFloor'))

	buildUI(RootScope)
	Module.UpdateWidget()
end

function Module.CloseWidget()
	Module.ClearActiveWaystone()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
end

function Module.Start()
	for _, waystone in CollectionService:GetTagged(WaystonesData.WaystonesTag) do
		task.defer(Module.SetupWaystone, waystone)
	end
	CollectionService:GetInstanceAddedSignal(WaystonesData.WaystonesTag):Connect(Module.SetupWaystone)
	CollectionService:GetInstanceRemovedSignal(WaystonesData.WaystonesTag):Connect(Module.CleanupWaystone)

	WaystonesEvent.OnClientEvent:Connect(Module.OnWaystoneUnlocked)

	ReplicatedData.OnUpdated:Connect(function(category, _)
		if category == 'PlayerData' and Module.IsWidgetOpen() then
			Module.UpdateWidget()
		end
	end)

	HUDCommon.BindLiveTheme(Module)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/MinimapWidget"><![CDATA[-- Top-right minimap panel. Initial chrome (rings, pulse, zone/clock labels)
-- ported from tmp/aincrad-ui/hud.jsx lines 167-182 (HudPlated minimap).
--
-- Renders live world-space markers (CollectionService-tagged entities like
-- AI / waystones / interactables, plus named workstation circles) projected
-- camera-relative onto the panel — camera-forward always points to the top.
--
-- Layout strategy (see .claude/skills/custom-roblox-ui/SKILL.md):
--   * Top-level Minimap frame: Scale-sized from design px / screen px + a
--     UIAspectRatioConstraint(1, FitWithinMaxSize) so it stays a perfect
--     square on 16:9, 32:9, and portrait screens.
--   * AnchorPoint (1, 0) + Position anchors to the top-right corner with a
--     scaled pixel inset.
--   * All inner atoms (rings, center dot, pulse ring, markers, labels) use
--     UDim2.fromOffset because the panel is aspect-locked and known size --
--     pixel geometry is authoritative inside it and does not compound scale.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local Lighting = game:GetService('Lighting')
local RunService = game:GetService('RunService')
local CollectionService = game:GetService('CollectionService')
local UserInputService = game:GetService('UserInputService')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local doCleanup = Fusion.doCleanup

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local SettingsRegistry = LocalModules.Modules.SettingsRegistry
local UISinkInputs = LocalModules.Utility.UISinkInputs
local PALETTE = HUDCommon.PALETTE

local WaystonesData = ReplicatedModules.Data.Waystones
local InteractableData = ReplicatedModules.Data.Interactable

local SystemsContainer = {}

local Module = {}
Module.IsOpen = false

local RootScope = nil
local ScreenGui = nil
local ZoneValue   = nil -- Value<string>
local ClockValue  = nil -- Value<string>
local PulseScale  = nil -- Value<number>  0..1 ease
local PanelFrame  = nil -- Frame   the minimap container; markers are direct children
-- UISinkInputs processor handle. Registered on OpenWidget, removed on
-- CloseWidget so wheel input only sinks while the panel is up. The
-- processor sinks scroll wheel events whose mouse position lands inside
-- the minimap panel — prevents the wheel from leaking through to camera
-- zoom while the player is interacting with the map.
local SinkProcessorId: string? = nil
-- Map zoom multiplier. 1.0 = standard radius (MAP_WORLD_RADIUS studs);
-- 5.0 = 5× world area visible (more zoomed out). Adjusted by scroll wheel
-- when the cursor is over the minimap. `refreshMarkers` reads it on each
-- 10 Hz tick to recompute marker positions.
local Zoom = nil  -- Value<number>  0.25 .. 5.0
-- Min lowered to 0.25× so players can zoom in tight on the panel for
-- close-quarters navigation (rooftops, dense interiors). 5.0 stays as
-- a wide-survey ceiling.
local ZOOM_MIN  = 0.25
local ZOOM_MAX  = 5.0
local ZOOM_STEP = 0.25
-- Tracked entity tags rendered as live minimap blips. Each entry is an
-- in-flight Frame keyed by the world Instance so we can recycle / move
-- them rather than recreating each frame. Frames are parented under the
-- minimap panel so they paint above the rings and clip to its bounds.
local MarkerInstances: {[Instance]: Frame} = {}
local MARKER_TAGS: {{tag: string, color: Color3, size: number}} = {}
-- Named workspace lookups for fixed workstations. These aren't surfaced
-- via CollectionService; they're individual parts/models named in the
-- world (matched via workspace:FindFirstChild). Populated in OpenWidget
-- so PALETTE references stay live across theme swaps.
local STATION_MARKERS: {{name: string, color: Color3, size: number}} = {}

----------------------------------------------------------------------
-- Design dimensions (pixels on the 1920x1080 reference canvas).
-- All Scale values in this file are derived from these constants.
----------------------------------------------------------------------
local DESIGN_SCREEN_W, DESIGN_SCREEN_H = 1920, 1080

-- Panel itself: bumped from 200 → 240 square so zone/clock labels and
-- the ring cluster have more room to breathe.
local DESIGN_PANEL_W, DESIGN_PANEL_H = 240, 240

-- Top-right anchor insets (JSX: top:56, right:20).
local DESIGN_INSET_RIGHT = 20
local DESIGN_INSET_TOP   = 56

-- Center of the ring cluster, offset a little down from geometric center
-- to leave room for the top eyebrow label. Scaled to the new panel size.
local DESIGN_CENTER_X = DESIGN_PANEL_W / 2
local DESIGN_CENTER_Y = DESIGN_PANEL_H / 2 + 10

-- Ring diameters (JSX radii 30, 50, 70, 90) scaled proportionally with panel.
local DESIGN_RING_SIZES = { 72, 120, 168, 216 }

-- Center player marker (JSX r="3" -> 6px diameter).
local DESIGN_CENTER_DOT = 6

-- Pulse ring (JSX r = 6 + sin(t*3)*2 -> diameter varies 8..16; we map
-- PulseScale 0..1 onto that range via base + amplitude).
local DESIGN_PULSE_BASE      = 10
local DESIGN_PULSE_AMPLITUDE = 8

-- Triangle-ish markers (JSX polygons span ~8x8 pixels).
local DESIGN_MARKER = 6

-- World-radius covered by the outer ring (studs). Anything beyond this
-- distance is either clipped to the outer ring or hidden depending on the
-- entity type (waystones clip; transient mobs hide). Tweak in concert with
-- DESIGN_RING_SIZES — the outermost ring (216 px) maps to this radius.
local MAP_WORLD_RADIUS = 220
local DESIGN_OUTER_RING_PX = 216

-- Zone eyebrow label (top-left inside panel). JSX: top:6, left:8, fontSize:9.
local DESIGN_ZONE_W        = 160
local DESIGN_ZONE_H        = 12
local DESIGN_ZONE_INSET_X  = 8
local DESIGN_ZONE_INSET_Y  = 6

-- Clock readout (bottom-right inside panel). JSX: bottom:6, right:8, fontSize:9.
local DESIGN_CLOCK_W       = 40
local DESIGN_CLOCK_H       = 12
local DESIGN_CLOCK_INSET_X = 8
local DESIGN_CLOCK_INSET_Y = 6

-- Top-right anchor in screen-scale.
local ANCHOR_X_SCALE = 1 - DESIGN_INSET_RIGHT / DESIGN_SCREEN_W
local ANCHOR_Y_SCALE = DESIGN_INSET_TOP / DESIGN_SCREEN_H

function Module.IsWidgetOpen(): boolean
	return Module.IsOpen and ScreenGui ~= nil
end

----------------------------------------------------------------------
-- Concentric ring: a pixel-sized square circle outline, centered inside
-- the panel at the designed SVG center (100, 110) in 200x200 space.
----------------------------------------------------------------------
local function ring(scope, diameter: number, transparency: number)
	return scope:New('Frame') {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(
			DESIGN_CENTER_X / DESIGN_PANEL_W,
			DESIGN_CENTER_Y / DESIGN_PANEL_H
		),
		Size = UDim2.fromOffset(diameter, diameter),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
			scope:New('UIStroke') {
				Color = PALETTE.accent,
				Transparency = transparency,
				Thickness = 1,
			},
		},
	}
end

local function buildMinimap(scope)
	-- Pixel-exact center dot (player position), anchored to SVG center.
	local centerDot = scope:New('Frame') {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(
			DESIGN_CENTER_X / DESIGN_PANEL_W,
			DESIGN_CENTER_Y / DESIGN_PANEL_H
		),
		Size = UDim2.fromOffset(DESIGN_CENTER_DOT, DESIGN_CENTER_DOT),
		BackgroundColor3 = PALETTE.accent,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
		},
	}

	-- Pulsing outer ring around the player marker.
	local pulseRing = scope:New('Frame') {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(
			DESIGN_CENTER_X / DESIGN_PANEL_W,
			DESIGN_CENTER_Y / DESIGN_PANEL_H
		),
		Size = scope:Computed(function(use)
			local s = use(PulseScale) or 0
			local d = DESIGN_PULSE_BASE + s * DESIGN_PULSE_AMPLITUDE
			return UDim2.fromOffset(d, d)
		end),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
			scope:New('UIStroke') {
				Color = PALETTE.accent,
				Transparency = scope:Computed(function(use)
					return 0.1 + (use(PulseScale) or 0) * 0.6
				end),
				Thickness = 1,
			},
		},
	}

	-- Top-level square panel. Scale-sized from design px / screen px, then
	-- locked to 1:1 aspect via UIAspectRatioConstraint(FitWithinMaxSize).
	-- This stays a true square on every aspect ratio.
	local panel = scope:New('Frame') {
		Name = 'Minimap',
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(ANCHOR_X_SCALE, ANCHOR_Y_SCALE),
		Size = UDim2.fromScale(DESIGN_PANEL_W / DESIGN_SCREEN_W, DESIGN_PANEL_H / DESIGN_SCREEN_H),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		ClipsDescendants = true, -- markers projected to the edge of the panel
		Parent = ScreenGui,
		[Fusion.Children] = {
			scope:New('UIAspectRatioConstraint') {
				AspectRatio = DESIGN_PANEL_W / DESIGN_PANEL_H, -- 1:1
				AspectType = Enum.AspectType.FitWithinMaxSize,
				DominantAxis = Enum.DominantAxis.Width,
			},
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.72, Thickness = 1 },

			ring(scope, DESIGN_RING_SIZES[1], 0.85),
			ring(scope, DESIGN_RING_SIZES[2], 0.85),
			ring(scope, DESIGN_RING_SIZES[3], 0.85),
			ring(scope, DESIGN_RING_SIZES[4], 0.85),

			pulseRing,
			centerDot,

			-- Zone eyebrow (top-left inside panel). Pixel offset size + pixel
			-- inset from the top-left corner.
			scope:New('TextLabel') {
				Name = 'ZoneLabel',
				AnchorPoint = Vector2.new(0, 0),
				Position = UDim2.fromOffset(DESIGN_ZONE_INSET_X, DESIGN_ZONE_INSET_Y),
				Size = UDim2.fromOffset(DESIGN_ZONE_W, DESIGN_ZONE_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				TextSize = 10,
				TextColor3 = PALETTE.accent,
				Text = scope:Computed(function(use)
					return string.format('\u{25C6} %s', tostring(use(ZoneValue) or ''))
				end),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
			},

			-- Clock readout (bottom-right inside panel). Pixel offset size +
			-- pixel inset from the bottom-right corner.
			scope:New('TextLabel') {
				Name = 'ClockText',
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -DESIGN_CLOCK_INSET_X, 1, -DESIGN_CLOCK_INSET_Y),
				Size = UDim2.fromOffset(DESIGN_CLOCK_W, DESIGN_CLOCK_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				TextSize = 10,
				TextColor3 = PALETTE.inkDim,
				Text = scope:Computed(function(use) return tostring(use(ClockValue) or '') end),
				TextXAlignment = Enum.TextXAlignment.Right,
				TextYAlignment = Enum.TextYAlignment.Bottom,
			},

			-- Zoom readout (bottom-LEFT inside panel). Bound reactively to
			-- Zoom so scrolling updates the displayed multiplier instantly,
			-- ahead of the next 10 Hz marker refresh tick.
			scope:New('TextLabel') {
				Name = 'ZoomText',
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.new(0, DESIGN_CLOCK_INSET_X, 1, -DESIGN_CLOCK_INSET_Y),
				Size = UDim2.fromOffset(DESIGN_CLOCK_W, DESIGN_CLOCK_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				TextSize = 10,
				TextColor3 = PALETTE.inkDim,
				Text = scope:Computed(function(use)
					return string.format('x%.1f', use(Zoom) or 1)
				end),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Bottom,
			},
		},
	}

	-- Mouse-wheel zoom. Frame-bound `panel.InputChanged` (NOT
	-- UserInputService.InputChanged) so the handler fires from the
	-- hit-test pipeline — independent of UIS's `gameProcessedEvent`,
	-- which gets set when UISinkInputs sinks the wheel via CAS. The
	-- frame-bound path is also self-gating: the input only delivers
	-- when the cursor is actually over the panel, so we don't need a
	-- separate hovered flag.
	panel.InputChanged:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseWheel then return end
		if not Zoom then return end
		local current = Fusion.peek(Zoom) or 1
		local delta = input.Position.Z
		-- Scroll FORWARD = zoom IN (lower value, smaller radius, more
		-- detail); scroll BACKWARD = zoom OUT (higher value, wider area).
		local next_ = current - delta * ZOOM_STEP
		next_ = math.clamp(next_, ZOOM_MIN, ZOOM_MAX)
		if next_ ~= current then
			Zoom:set(next_)
		end
	end)

	return panel
end

function Module.UpdateWidget()
	if not Module.IsWidgetOpen() then return end
	local floor = LocalPlayer:GetAttribute('CurrentFloor')
	ZoneValue:set(floor and string.format('FL %s', tostring(floor)) or 'LABYRINTH')
	ClockValue:set(string.sub(Lighting.TimeOfDay or '00:00:00', 1, 5))
end

-- Project a world position to minimap-pixel coords (relative to the panel
-- top-left). Returns x, y, isInside. The minimap is *camera-up* — entries
-- in front of the camera appear toward the top, regardless of where the
-- player is facing in world space. `cameraYaw` is `atan2(LookVector.X,
-- -LookVector.Z)` so 0 means default camera (looking -Z) and the rotation
-- formula below resolves to the previous north-up behavior.
local function projectWorldToMinimap(
	worldPos: Vector3, playerPos: Vector3, cameraYaw: number, zoom: number
): (number, number, boolean)
	local dx = worldPos.X - playerPos.X
	local dz = worldPos.Z - playerPos.Z

	-- 2D rotation by -cameraYaw so camera-forward maps to minimap "up"
	-- (i.e. -Y in screen pixels). Verified against the four cardinal
	-- camera orientations: at yaw=0 the formula reduces to (mx, mz) =
	-- (dx, dz), preserving the north-up baseline.
	local cosT, sinT = math.cos(cameraYaw), math.sin(cameraYaw)
	local mx =  dx * cosT + dz * sinT
	local mz = -dx * sinT + dz * cosT

	-- Effective world radius scales with zoom — at zoom=1.0 the outer
	-- ring covers MAP_WORLD_RADIUS studs (the design baseline); at
	-- zoom=5.0 it covers 5× that, giving a wider survey at the cost
	-- of marker resolution.
	local effectiveRadius = MAP_WORLD_RADIUS * zoom
	local dist = math.sqrt(mx * mx + mz * mz)
	-- Clamp to the outer ring; entities past the effective radius sit
	-- on the ring edge so the player still sees a heading indicator.
	local clampedDist = math.min(dist, effectiveRadius)
	local scale = (DESIGN_OUTER_RING_PX / 2) / effectiveRadius
	local px = DESIGN_CENTER_X + mx * (clampedDist / math.max(dist, 0.0001)) * scale
	local py = DESIGN_CENTER_Y + mz * (clampedDist / math.max(dist, 0.0001)) * scale
	return px, py, dist <= effectiveRadius
end

-- Resolve an instance's world position. Models -> primary part / pivot;
-- BaseParts -> Position. Returns nil if the entity has no usable position.
local function getInstancePosition(inst: Instance): Vector3?
	if inst:IsA('Model') then
		local pp = inst.PrimaryPart
		if pp then return pp.Position end
		local hrp = inst:FindFirstChild('HumanoidRootPart')
		if hrp and hrp:IsA('BasePart') then return hrp.Position end
		local ok, cf = pcall(inst.GetPivot, inst)
		if ok and cf then return cf.Position end
	elseif inst:IsA('BasePart') then
		return inst.Position
	end
	return nil
end

local function ensureMarker(inst: Instance, color: Color3, size: number): Frame?
	if not PanelFrame then return nil end
	local existing = MarkerInstances[inst]
	if existing and existing.Parent then return existing end
	local marker = Instance.new('Frame')
	marker.Name = 'Marker_' .. inst.Name
	marker.AnchorPoint = Vector2.new(0.5, 0.5)
	marker.Size = UDim2.fromOffset(size, size)
	marker.BackgroundColor3 = color
	marker.BorderSizePixel = 0
	marker.BackgroundTransparency = 0.1
	-- Square markers; UICorner makes them appear as soft dots.
	local corner = Instance.new('UICorner')
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = marker
	local stroke = Instance.new('UIStroke')
	stroke.Color = color
	stroke.Transparency = 0.3
	stroke.Thickness = 1
	stroke.Parent = marker
	marker.Parent = PanelFrame
	MarkerInstances[inst] = marker
	return marker
end

local function clearMarker(inst: Instance)
	local m = MarkerInstances[inst]
	if m then m:Destroy(); MarkerInstances[inst] = nil end
end

local function refreshMarkers()
	if not Module.IsWidgetOpen() then return end
	local character = LocalPlayer.Character
	local hrp = character and character:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not hrp then return end
	local playerPos = hrp.Position

	-- Camera yaw: angle of the camera's forward direction relative to
	-- world -Z (Roblox's "default camera looks -Z" convention). The
	-- projection rotates marker offsets by -yaw so camera-forward always
	-- maps to the top of the minimap.
	local camera = workspace.CurrentCamera
	local cameraYaw = 0
	if camera then
		local lookVec = camera.CFrame.LookVector
		cameraYaw = math.atan2(lookVec.X, -lookVec.Z)
	end

	-- Build the union of currently-tracked instances; remove any markers
	-- whose source disappeared (untagged, destroyed, or workstation
	-- removed from workspace).
	local seen: {[Instance]: true} = {}

	-- Snapshot zoom once per refresh so all markers in this tick use the
	-- same effective radius (avoids visual desync if the player scrolls
	-- mid-iteration).
	local currentZoom = (Zoom and Fusion.peek(Zoom)) or 1.0

	local function placeMarker(inst: Instance, color: Color3, size: number, maxDistance: number?)
		if inst == character then return end -- skip the local player; centerDot covers them
		local pos = getInstancePosition(inst)
		if not pos then return end
		-- Per-tag distance cap. Compares 2D (XZ) so a mob on a different
		-- floor at the same horizontal distance still flicks off when the
		-- player walks away — matches the projection's XZ-only flatten.
		if maxDistance then
			local dx = pos.X - playerPos.X
			local dz = pos.Z - playerPos.Z
			if (dx * dx + dz * dz) > (maxDistance * maxDistance) then
				-- Out of range — don't mark and don't claim a `seen` slot,
				-- so the cleanup loop at the end of refreshMarkers tears
				-- down any existing marker for this instance.
				return
			end
		end
		seen[inst] = true
		local m = ensureMarker(inst, color, size)
		if not m then return end
		local px, py, _inside = projectWorldToMinimap(pos, playerPos, cameraYaw, currentZoom)
		-- Position uses scale (px / panel_w) so the marker positions
		-- correctly even if the panel scales on different aspect ratios.
		m.Position = UDim2.fromScale(px / DESIGN_PANEL_W, py / DESIGN_PANEL_H)
	end

	for _, entry in MARKER_TAGS do
		for _, inst in CollectionService:GetTagged(entry.tag) do
			-- Filter to live workspace descendants only — tagged instances
			-- can also live in ServerStorage / ReplicatedStorage templates,
			-- and we don't want phantom markers for those off-screen copies.
			if inst:IsDescendantOf(workspace) then
				placeMarker(inst, entry.color, entry.size, entry.maxDistance)
			end
		end
	end

	-- Named workstation circles (workspace direct children). FindFirstChild
	-- is a hash lookup, cheap to call at the 10 Hz refresh cadence.
	for _, entry in STATION_MARKERS do
		local inst = workspace:FindFirstChild(entry.name)
		if inst then
			placeMarker(inst, entry.color, entry.size)
		end
	end

	for inst, _ in MarkerInstances do
		if not seen[inst] or not inst.Parent then
			clearMarker(inst)
		end
	end
end

function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true
	ScreenGui = HUDCommon.ensureScreenGui('HUD_Minimap', 4)
	RootScope = scoped(Fusion)

	ZoneValue  = RootScope:Value('LABYRINTH')
	ClockValue = RootScope:Value('00:00')
	PulseScale = RootScope:Value(0)
	-- Zoom persists across widget close/reopen by being module-scoped, but
	-- bound to RootScope so the reactive bindings clean up on widget tear-
	-- down. Re-init at default 1.0 each open is intentional — keeps the
	-- map predictable when the player toggles it via settings.
	Zoom = RootScope:Value(1.0)

	-- Marker spec — populated here (not at module scope) so PALETTE
	-- references stay live across theme swaps. Sizes are pixel-on-design;
	-- the panel is aspect-locked so they don't compound scale.
	-- `maxDistance` clips the marker when the source is further than N
	-- studs from the player (in 3D, ignores Y). nil → render whenever
	-- inside the zoom-derived viewport. Enemies get a 500-stud cap so a
	-- distant mob that's just out of engagement range stops cluttering
	-- the map; navigation markers (waystones, interactables, players)
	-- stay visible at any distance the zoom permits.
	MARKER_TAGS = {
		{ tag = 'PLAYER_CHARACTER', color = PALETTE.success, size = 6 },
		{ tag = 'AICharacter',      color = PALETTE.danger,  size = 6, maxDistance = 500 },
		{ tag = InteractableData.InteractableTag, color = PALETTE.gold, size = 5 },
		{ tag = WaystonesData.WaystonesTag,       color = PALETTE.violet, size = 7 },
	}

	-- Workstation circles — looked up by name in workspace. ZoneService
	-- already keys on these names (see EnchantingWidget / ForgeWidget /
	-- GemSocketWidget), so the minimap sources them from the same world
	-- instances the zone-enter logic uses.
	STATION_MARKERS = {
		{ name = 'EnchantCircle',   color = PALETTE.violet, size = 7 },
		{ name = 'ForgeCircle',     color = PALETTE.gold,   size = 7 },
		{ name = 'GemSocketCircle', color = PALETTE.accent, size = 7 },
	}

	PanelFrame = buildMinimap(RootScope)
	Module.UpdateWidget()

	-- Sink scroll wheel while mouse is over the minimap panel. The
	-- frame-bound `panel.InputChanged` handler above still applies the
	-- zoom delta (hit-test pipeline, independent of CAS sink). This
	-- registration just stops the wheel from leaking past the minimap
	-- to camera zoom / other CAS consumers.
	SinkProcessorId = UISinkInputs.AddProcessorCallback({
		Name = 'minimap-wheel',
		-- Only the wheel — UISinkInputs refcounts inputs and only binds
		-- what at least one processor declares interest in. Mouse1 /
		-- Mouse2 stay completely unbound at the CAS level when no
		-- processor needs them, so they pass through untouched to other
		-- consumers (Tab keybind chrome, weapon swap, etc.).
		Inputs = { Enum.UserInputType.MouseWheel },
		Filter = function(_state, obj)
			if not PanelFrame or not PanelFrame.Parent then return false end
			-- Hit-test against the panel's screen rect.
			local mouse = UserInputService:GetMouseLocation()
			local pos, size = PanelFrame.AbsolutePosition, PanelFrame.AbsoluteSize
			return mouse.X >= pos.X and mouse.X <= pos.X + size.X
				and mouse.Y >= pos.Y and mouse.Y <= pos.Y + size.Y
		end,
		Sink = function() return true end,
	})
end

function Module.CloseWidget()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	for inst in MarkerInstances do clearMarker(inst) end
	PanelFrame = nil
	if SinkProcessorId then
		UISinkInputs.RemoveProcessor(SinkProcessorId)
		SinkProcessorId = nil
	end
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
end

function Module.Start()
	task.spawn(function()
		local start = os.clock()
		while true do
			RunService.Heartbeat:Wait()
			if PulseScale then
				local t = (os.clock() - start) * 2
				local v = (math.sin(t) + 1) * 0.5
				PulseScale:set(v)
			end
		end
	end)

	task.spawn(function()
		while true do
			Module.UpdateWidget()
			task.wait(1)
		end
	end)

	-- Marker projection at ~10 Hz — much cheaper than 60 Hz, and mob/
	-- player positions don't need every frame to read correctly on a
	-- minimap. Waystones and workstations are static so they're only
	-- repositioned when the player moves.
	task.spawn(function()
		while true do
			task.wait(0.1)
			refreshMarkers()
		end
	end)

	LocalPlayer:GetAttributeChangedSignal('CurrentFloor'):Connect(Module.UpdateWidget)

	HUDCommon.BindLiveTheme(Module)

	-- Visibility toggle wired to SettingsRegistry.MinimapEnabled.
	SettingsRegistry.Changed:Connect(function(key, value)
		if key ~= 'MinimapEnabled' then return end
		if value then
			Module.OpenWidget()
		else
			Module.CloseWidget()
		end
	end)

	task.defer(function()
		if SettingsRegistry.MinimapEnabled then
			Module.OpenWidget()
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/OnscreenButtons"><![CDATA[-- Left-side hex button cluster (opens Tab sub-tabs).
-- Fusion-driven replacement for the GameInterface.LeftHexButtons template.

local Debris = game:GetService('Debris')
local Players = game:GetService('Players')
local TweenService = game:GetService('TweenService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local doCleanup = Fusion.doCleanup

local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')
local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local SettingsRegistry = LocalModules.Modules.SettingsRegistry
local PALETTE = HUDCommon.PALETTE

local SystemsContainer = {}

-- Button spec: tab name keys the TabWidget topbar button by Name.
local BUTTONS = {
	{ id = 'Character', glyph = 'C', tab = 'Character', label = 'STATS' },
	{ id = 'Inventory', glyph = 'I', tab = 'Inventory', label = 'BAG'   },
	{ id = 'Skills',    glyph = 'K', tab = 'Skills',    label = 'SKILL' },
	{ id = 'Social',    glyph = 'S', tab = 'Social',    label = 'PARTY' },
}

local TI = TweenInfo.new(0.08, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)

-- Design reference sizes (px on a 1920x1080 canvas). Aspect constraints use
-- these to preserve hex button proportions + stack geometry on any screen.
local DESIGN_SCREEN_W       = 1920
local DESIGN_SCREEN_H       = 1080
local DESIGN_BTN            = 80         -- hex button is square 80x80 (bigger)
local DESIGN_BTN_GAP        = 32         -- gap between buttons (more breathing room)
local DESIGN_LABEL_H        = 12         -- "STATS"/"BAG" chip under each button
local DESIGN_BTN_CORNER_PX  = 6          -- button corner radius
local DESIGN_STACK_W        = DESIGN_BTN -- column width
local DESIGN_STACK_H        = #BUTTONS * DESIGN_BTN + (#BUTTONS - 1) * DESIGN_BTN_GAP
local DESIGN_LEFT_PAD_PX    = 24         -- inset from screen's left edge
local ANCHOR_X_SCALE        = DESIGN_LEFT_PAD_PX / DESIGN_SCREEN_W

-- // Module // --
local Module = {}
Module.IsOpen = false

local RootScope = nil
local ScreenGui = nil

function Module.IsWidgetOpen(): boolean
	return Module.IsOpen and ScreenGui ~= nil
end

function Module.OpenTargetTabByName(tabName: string)
	local tabWidget = SystemsContainer.TabWidget
	if not tabWidget then return end
	tabWidget.OpenWidget()
	if tabWidget.SelectTopbarTabByName then
		tabWidget.SelectTopbarTabByName(tabName)
	end
end

local function playUIPop()
	local sfx = ReplicatedAssets.Sounds.Local.UIPop:Clone()
	sfx.Volume = 0.1
	sfx.Parent = workspace
	sfx:Play()
	Debris:AddItem(sfx, 1)
end

local function buildHex(scope, spec)
	local uiScale = Instance.new('UIScale')

	local button = scope:New('TextButton') {
		Name = spec.id,
		-- Width = 100% of stack column; aspect ratio forces height = width (square).
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.None,
		BackgroundColor3 = PALETTE.panel,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = '',
		[Fusion.Children] = {
			-- Lock button to 1:1 square regardless of stack column proportions.
			scope:New('UIAspectRatioConstraint') {
				AspectRatio = 1,
				AspectType = Enum.AspectType.ScaleWithParentSize,
				DominantAxis = Enum.DominantAxis.Width,
			},
			scope:New('UICorner') { CornerRadius = UDim.new(0, DESIGN_BTN_CORNER_PX) },
			scope:New('UIStroke') {
				Color = PALETTE.accent, Transparency = 0.4, Thickness = 1,
			},
			-- Glyph fills the full button interior.
			scope:New('TextLabel') {
				Name = 'Glyph',
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY, TextSize = 22,
				TextColor3 = PALETTE.accent, Text = spec.glyph,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
			-- "STATS"/"BAG" chip below the button: anchored to top-center of
			-- its rect which sits below the button (Position Y = 1). Height is
			-- a fraction of the button height so it scales in lockstep.
			scope:New('TextLabel') {
				Name = 'KeybindLabel',
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.fromScale(0.5, 1),
				Size = UDim2.fromScale(1, DESIGN_LABEL_H / DESIGN_BTN),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO, TextSize = 9,
				TextColor3 = PALETTE.inkDim, Text = spec.label,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
		},

		[Fusion.OnEvent 'MouseEnter'] = function()
			local tabWidget = SystemsContainer.TabWidget
			if tabWidget and tabWidget.IsWidgetOpen() then return end
			playUIPop()
			TweenService:Create(uiScale, TI, { Scale = 1.125 }):Play()
		end,
		[Fusion.OnEvent 'MouseLeave'] = function()
			TweenService:Create(uiScale, TI, { Scale = 1 }):Play()
		end,
		[Fusion.OnEvent 'Activated'] = function()
			local tabWidget = SystemsContainer.TabWidget
			if tabWidget and tabWidget.IsWidgetOpen() then return end
			Module.OpenTargetTabByName(spec.tab)
		end,
	}
	uiScale.Parent = button
	return button
end

local function buildUI(scope)
	-- Root stack: Scale-sized on both axes + UIAspectRatioConstraint keeps the
	-- tall, narrow column proportioned correctly. AnchorPoint (0, 0.5) +
	-- Position Y 0.5 vertically centers it without offset math.
	local root = scope:New('Frame') {
		Name = 'LeftHexButtons',
		AnchorPoint = Vector2.new(0, 0.5),
		-- Anchored (0, 0.5) + Y=0.6 shifts the cluster below the screen's
		-- vertical midline so it sits clear of the vitals block + minimap row.
		Position = UDim2.fromScale(ANCHOR_X_SCALE, 0.6),
		Size = UDim2.fromScale(DESIGN_STACK_W / DESIGN_SCREEN_W, DESIGN_STACK_H / DESIGN_SCREEN_H),
		BackgroundTransparency = 1,
		Parent = ScreenGui,
		[Fusion.Children] = {
			scope:New('UIAspectRatioConstraint') {
				AspectRatio = DESIGN_STACK_W / DESIGN_STACK_H, -- ~0.186
				AspectType = Enum.AspectType.FitWithinMaxSize,
				DominantAxis = Enum.DominantAxis.Height,
			},
			-- UIGridLayout as a vertical single-column stack. Quirk: to get ONE
			-- column you need FillDirection=Horizontal + FillDirectionMaxCells=1
			-- ("max 1 cell per row, wrap to next row") — the intuitive
			-- FillDirection=Vertical/MaxCells=1 actually means "max 1 cell per
			-- column", which produces a horizontal row instead.
			scope:New('UIGridLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				FillDirectionMaxCells = 1,
				CellSize = UDim2.fromScale(1, DESIGN_BTN / DESIGN_STACK_H),
				CellPadding = UDim2.fromScale(0, DESIGN_BTN_GAP / DESIGN_STACK_H),
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				VerticalAlignment = Enum.VerticalAlignment.Top,
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
		},
	}

	for index, spec in BUTTONS do
		local btn = buildHex(scope, spec)
		btn.LayoutOrder = index
		btn.Parent = root
	end
end

function Module.UpdateWidget() end

function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true
	ScreenGui = HUDCommon.ensureScreenGui('HUD_LeftHex', 5)
	RootScope = scoped(Fusion)
	buildUI(RootScope)
end

function Module.CloseWidget()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
end

function Module.Start()
	HUDCommon.BindLiveTheme(Module)

	-- Visibility toggle wired to SettingsRegistry.OnscreenButtonsEnabled.
	-- Per the user's parenthetical, this same setting also controls the
	-- Hotbar's Q/W/R/D/F clusters; HotbarWidget consults the registry
	-- directly so we don't reach across modules from here.
	SettingsRegistry.Changed:Connect(function(key, value)
		if key ~= 'OnscreenButtonsEnabled' then return end
		if value then
			Module.OpenWidget()
		else
			Module.CloseWidget()
		end
	end)

	task.defer(function()
		if SettingsRegistry.OnscreenButtonsEnabled then
			Module.OpenWidget()
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/ForgeWidget"><![CDATA[-- Phase 4 — Blackiron Forge workstation.
-- Tinker-Construct-style weapon assembly: Blueprint + per-slot Materials + Modifiers.
-- Visual reference: tmp/aincrad-ui/forge.jsx.
-- No server integration yet — commits will fire a TODO remote when wired.
--
-- Layout strategy (see .claude/skills/custom-roblox-ui/SKILL.md §2,3,4,8,10):
--   * Root frame fills its TabWidget/workstation content parent via
--     fromScale(1, 1); this is a SUB-panel, not a top-level HUD element —
--     no screen-wide aspect constraint, no anchor math.
--   * All atoms declared as DESIGN_* pixel constants placed via
--     UDim2.fromOffset or UDim2.new(1, -fixed, 0, fixed) so they never
--     depend on nested Scale multiplication.
--   * Three-column layout: left (260px) + center (flex-fills remainder via
--     Scale 1 + negative offset) + right (300px), mirroring forge.jsx's
--     `gridTemplateColumns: '260px 1fr 300px'`.
--   * Left + right columns use pixel widths + full scale height; center
--     uses `UDim2.new(1, -(L+R), 1, 0)` — the canonical "fill remaining"
--     idiom documented in SKILL.md §1.
--   * Blueprint grid + material palette + available-mods grid use
--     UIGridLayout with half-width pixel-adjusted cells and bounded
--     FillDirectionMaxCells so tiles never squash.
--   * Parts list + applied-mods list use UIListLayout vertical + pixel
--     row heights with AutomaticSize.Y on the containing wrapper.
--   * Stats row uses UIGridLayout with scale-share columns + pixel gap.
--   * Commit button + preview button sit in a horizontal UIListLayout;
--     preview is pixel-width, commit flex-fills.

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ContextActionService = game:GetService('ContextActionService')
local Players = game:GetService('Players')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local peek = Fusion.peek

-- Artisan catalog imports (Stage A) + commit remote (Stage B). The local
-- MATERIALS / BLUEPRINTS / MODIFIERS adapter tables built below preserve
-- the lowercase-field shape this widget was written against; the catalog
-- modules use CapsCase so we re-shape at module load.
local MaterialsConfig  = ReplicatedModules.Data.Materials
local BlueprintsConfig = ReplicatedModules.Data.Blueprints
local ModifiersConfig  = ReplicatedModules.Data.Modifiers
local LevelGates       = ReplicatedModules.Data.LevelGates
local ReplicatedData   = ReplicatedModules.Services.ReplicatedData
local RemoteService    = ReplicatedModules.Services.RemoteService
local ForgeShared      = ReplicatedModules.Services.ForgeShared
local ForgeEvent       = RemoteService.GetRemote('ForgeEvent', 'RemoteEvent', false)

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local LevelLockOverlay = LocalModules.Modules.LevelLockOverlay
local LevelGatesClient = LocalModules.Modules.LevelGatesClient
-- Subscribed in Start to the 'Blueprints' / 'Modifiers' replication
-- signals so this widget's convenience caches refresh when the
-- per-player bundle lands. See refreshBlueprintCache + RegistryVersion.
local ConfigReplicationClient = LocalModules.Modules.ConfigReplicationClient
local PALETTE = HUDCommon.PALETTE

local SystemsContainer = {}

-- // Catalogs (ported from forge.jsx) // --

-- // Adapter shapes — re-projection of the catalog modules to the
-- lowercase-field names this widget code was originally written
-- against. Build once at module load; widgets continue to read
-- MATERIALS / MATERIAL_INDEX / BLUEPRINTS / BLUEPRINT_INDEX / MODIFIERS
-- / MODIFIER_INDEX as before. //
type Material = { id: string, name: string, color: Color3, dmg: number, spd: number, wgt: number, dur: number, trait: string }
local MATERIALS: {Material} = {}
local MATERIAL_INDEX: {[string]: Material} = {}
do
	for _, m in MaterialsConfig.Materials do
		local entry = {
			id = m.Id, name = m.Name, color = m.Color,
			dmg = m.Damage, spd = m.Speed, wgt = m.Weight, dur = m.Durability,
			trait = m.Trait,
		}
		table.insert(MATERIALS, entry)
		MATERIAL_INDEX[m.Id] = entry
	end
	-- Stable iteration order in UI by ascending damage.
	table.sort(MATERIALS, function(a, b) return a.dmg < b.dmg end)
end

type Blueprint = { id: string, name: string, slots: {{key: string, label: string, position: {x: number, y: number}?}} }
local BLUEPRINTS: {Blueprint} = {}
local BLUEPRINT_INDEX: {[string]: Blueprint} = {}

-- Post-migration: BlueprintsConfig.Blueprints is an empty client shell
-- at module load, populated by ConfigReplicationClient as the player's
-- bundle arrives. Build the convenience caches via a function we can
-- re-run when replication lands. Initial call covers the
-- already-bootstrapped case (rare — admin or rejoin); the
-- ConfigReplicationClient.GetSignal('Blueprints') wire-up in Start
-- handles the normal late-arrival case.
local function refreshBlueprintCache()
	table.clear(BLUEPRINTS)
	table.clear(BLUEPRINT_INDEX)
	for _, bp in BlueprintsConfig.Blueprints do
		local slots = {}
		for _, s in bp.Slots do
			table.insert(slots, {
				key = s.key, label = s.Label,
				position = s.Position,  -- {x, y} or nil → fallback to staircase
			})
		end
		local entry = { id = bp.Id, name = bp.Name, slots = slots }
		table.insert(BLUEPRINTS, entry)
		BLUEPRINT_INDEX[bp.Id] = entry
	end
	table.sort(BLUEPRINTS, function(a, b) return a.id < b.id end)
end
refreshBlueprintCache()

type Modifier = { id: string, name: string, color: Color3, effect: string, cost: number, stack: number }
local MODIFIERS: {Modifier} = {}
local MODIFIER_INDEX: {[string]: Modifier} = {}

-- Same pattern as refreshBlueprintCache — Modifiers is also a
-- migrated empty-shell at module load, populated late.
local function refreshModifierCache()
	table.clear(MODIFIERS)
	table.clear(MODIFIER_INDEX)
	for _, mo in ModifiersConfig.Modifiers do
		local entry = {
			id = mo.Id, name = mo.Name, color = mo.Color,
			effect = mo.Effect, cost = mo.Cost, stack = mo.MaxStack,
		}
		table.insert(MODIFIERS, entry)
		MODIFIER_INDEX[mo.Id] = entry
	end
	table.sort(MODIFIERS, function(a, b) return a.id < b.id end)
end
refreshModifierCache()

-- MaxModifierSlots is a constant declared in the shell (NOT spoiler
-- content; it's the slot-budget cap the forge enforces) so it's
-- available at module load regardless of replication state.
local MOD_SLOTS_MAX = ModifiersConfig.MaxModifierSlots

