		<Source path="ServerScriptService/CmdrSetup/Commands/inventory/EquipItemServer"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))
local ServerCore = require(ServerStorage:WaitForChild('Core'))

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ItemsConfig = ServerModules.Data.Items  -- migrated to per-player config replication; server reads canonical.

return function(_context, target: Player, itemId: string, slot: number)
	if not ItemsConfig.Items[itemId] then
		return string.format("No item config registered for '%s'.", itemId)
	end
	slot = math.max(1, math.floor(slot or 1))

	-- Find an existing UUID for this itemId in the player's inventory; if
	-- none exist, mint one via GiveQuantityOfItemIdToPlayer first so the
	-- equip path always has a UUID to bind.
	local Inventory = ServerCore.PlayerInventoryServer
	local existing = Inventory.GetItemUUIDsOfItemId(target, itemId)
	local uuid: string? = (typeof(existing) == 'table') and existing[1] or nil
	if not uuid then
		local minted = Inventory.GiveQuantityOfItemIdToPlayer(target, itemId, 1)
		uuid = (typeof(minted) == 'table') and minted[1] or nil
	end
	if not uuid then
		return string.format("Failed to mint a UUID for %s on %s.", itemId, target.Name)
	end

	Inventory.AttemptPlayerEquipItemOfUUID(target, uuid, slot)
	return string.format("Equipped %s to %s in slot %d (uuid=%s).", itemId, target.Name, slot, uuid)
end
]]></Source>
