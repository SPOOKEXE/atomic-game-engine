	Aliases = { 'giveaura', 'unlockaura' },
	Description = 'Unlock an aura on a player; optionally auto-equip if a slot is free.',
	Group = 'Admin',
	Args = {
		{ Type = 'player',  Name = 'target',     Description = 'Target player.' },
		{ Type = 'string',  Name = 'auraId',     Description = "Aura id from Data/Auras.luau (e.g. 'character_runic')." },
