return {
	Name = "KillNearbyMobs",
	Aliases = { "killmobs", "kmobs" },
	Description = "Kill every AI mob within `radius` studs of a player.",
	Group = "Admin",
	Args = {
		{ Type = "player", Name = "target", Description = "Player whose position is the origin." },
		{ Type = "number", Name = "radius", Description = "Search radius in studs (default 50).",
		  Default = 50, Optional = true },
