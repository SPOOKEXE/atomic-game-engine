		<Source path="ServerScriptService/CmdrSetup/Commands/attributes/SetAttributeXPServer"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local AttributesConfig = require(ReplicatedStorage:WaitForChild('Modules')).Data.Attributes

return function(_context, target: Player, attributeId: string, amount: number)
	if not AttributesConfig.GetConfigFromId(attributeId) then
		return string.format("No attribute config registered for '%s'.", attributeId)
	end
	local data = ServerCore.SavesManagerServer.GetPlayerSelectedSaveData(target)
	if not data then
		return string.format('No save data loaded for %s.', target.Name)
	end
	if typeof(data.Attributes) ~= 'table' then data.Attributes = {} end
	local xp = math.max(0, math.floor(amount))
	local existing = data.Attributes[attributeId]
	-- Coerce bare-number legacy shape to {Level, Experience} since the XP
	-- field can only live on the table shape.
	local level = 0
	if typeof(existing) == 'table' and tonumber(existing.Level) then
		level = existing.Level
	elseif typeof(existing) == 'number' then
		level = existing
	end
	data.Attributes[attributeId] = { Level = level, Experience = xp }
	return string.format("Set %s.%s XP to %d (Lv %d).", target.Name, attributeId, xp, level)
end
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/attributes/SetAttributeLevelServer"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local AttributesConfig = require(ReplicatedStorage:WaitForChild('Modules')).Data.Attributes

return function(_context, target: Player, attributeId: string, level: number)
	local cfg = AttributesConfig.GetConfigFromId(attributeId)
	if not cfg then
		return string.format("No attribute config registered for '%s'.", attributeId)
	end
	local data = ServerCore.SavesManagerServer.GetPlayerSelectedSaveData(target)
	if not data then
		return string.format('No save data loaded for %s.', target.Name)
	end
	if typeof(data.Attributes) ~= 'table' then data.Attributes = {} end
	local clamped = math.clamp(math.floor(level), 0, cfg.MaxLevel)
	-- Canonicalize to {Level, Experience}. Preserve any in-flight XP so
	-- partial-bar resets don't clobber player progress when the admin
	-- is just nudging a level number.
	local existing = data.Attributes[attributeId]
	local keptXP = (typeof(existing) == 'table' and tonumber(existing.Experience)) or 0
	data.Attributes[attributeId] = { Level = clamped, Experience = keptXP }
	return string.format("Set %s.%s to Lv %d (Xp %d).", target.Name, attributeId, clamped, keptXP)
end
]]></Source>
