		<Source path="src/ServerScriptService/CmdrSetup/Commands/artisan/GiveMaterialServer.luau"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))
local ServerCore = require(ServerStorage:WaitForChild('Core'))

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ItemsConfig = ServerModules.Data.Items  -- migrated to per-player config replication; server reads canonical.
local MaterialsConfig = require(ReplicatedStorage:WaitForChild('Modules')).Data.Materials

return function(_context, target: Player, materialId: string, quantity: number)
	if not MaterialsConfig.Materials[materialId] then
		return string.format("No forge material with id '%s'.", materialId)
	end
	-- Resolve materialId → canonical inventory item via the
	-- Items.GetItemIdsByForgeMaterialId helper. Picks the
	-- lowest-rarity match so the cmdr grant is deterministic.
	local candidateIds = ItemsConfig.GetItemIdsByForgeMaterialId(materialId)
	local pick = candidateIds[1]
	if not pick then
		return string.format("No inventory item is wired to ForgeMaterialId='%s'.", materialId)
	end
	quantity = math.max(1, math.floor(quantity or 1))
	ServerCore.PlayerInventoryServer.GiveQuantityOfItemIdToPlayer(target, pick, quantity)
	return string.format("Gave %s x%d (material '%s') to %s.", pick, quantity, materialId, target.Name)
end
]]></Source>
