		<Source path="src/ServerScriptService/CmdrSetup/Commands/premium/SetPremiumServer.luau"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local PremiumConfig = ReplicatedModules.Data.PremiumConfig

return function(_context, target: Player, passKey: string, enabled: boolean)
	if PremiumConfig.GAMEPASSES[passKey] == nil then
		local known: { string } = {}
		for k in PremiumConfig.GAMEPASSES do known[#known + 1] = k end
		table.sort(known)
		return string.format("Unknown pass key %q. Known: %s", passKey, table.concat(known, ', '))
	end
	-- Save-side flag: replicates so the client UI (slot caps, badges)
	-- updates without a refresh. Convention: `<PassKey>Pass` boolean.
	local Saves = ServerCore.SavesManagerServer
	if not Saves or not Saves.GetPlayerSelectedSaveData then
		return 'SavesManagerServer unavailable.'
	end
	local data = Saves.GetPlayerSelectedSaveData(target)
	if not data then return string.format('%s has no save selected.', target.Name) end
	if typeof(data.Premium) ~= 'table' then data.Premium = {} end
	data.Premium[passKey .. 'Pass'] = (enabled == true)
	return string.format('%s.%sPass = %s', target.Name, passKey, tostring(enabled))
end
]]></Source>
		<Source path="src/ServerScriptService/CmdrSetup/Commands/quests/GiveQuest.luau"><![CDATA[--!strict
return {
