		<Source path="src/ServerScriptService/CmdrSetup/Commands/cinematic/VfxServer.luau"><![CDATA[local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local CinematicShared  = ReplicatedModules.Services.CinematicShared
local CinematicPresets = ReplicatedModules.Data.CinematicPresets

local ServerStorage = game:GetService('ServerStorage')
local ServerCore    = require(ServerStorage:WaitForChild('Core'))

return function(context, presetName)
	local p = CinematicPresets.VFX[presetName]
	if not p then
		return string.format('Unknown VFX preset %q. Try: %s', tostring(presetName),
			table.concat(CinematicPresets.ListVFX(), ', '))
	end
	local CinematicServer = ServerCore.CinematicServer
	if not CinematicServer or not CinematicServer.FireCueForPlayer then
		return 'CinematicServer module unavailable.'
	end
	local player = context.Executor
	-- Server can't resolve the local character's instance path the
	-- way the client widget can — instead we anchor 'world' at the
	-- character's HRP position. Cinematic VFX cue handles either
	-- anchor mode at runtime.
	local args: { [string]: any } = {
		TemplateName = p.Template, Duration = p.Duration, Anchor = 'world',
	}
	local char = player.Character
	local hrp = char and char:FindFirstChild('HumanoidRootPart')
	if hrp then
		args.Position = (hrp :: BasePart).Position
	else
		args.Position = Vector3.new(0, 5, 0)
	end
	CinematicServer.FireCueForPlayer(player, CinematicShared.CueKind.PlayVFX, args)
	return string.format('Fired VFX %q.', presetName)
end
]]></Source>
