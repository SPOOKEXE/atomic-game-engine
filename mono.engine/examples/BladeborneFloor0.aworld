local ServerCore = require(ServerStorage:WaitForChild('Core'))

return function(_context, target: Player, auraId: string)
	local AurasServer = ServerCore.AurasServer
	if not AurasServer or not AurasServer.AttemptRevokeAura then
		return 'AurasServer module unavailable.'
	end
	local ok = AurasServer.AttemptRevokeAura(target, auraId)
