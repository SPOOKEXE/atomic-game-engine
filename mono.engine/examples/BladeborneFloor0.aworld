		<Source path="ReplicatedStorage/Modules/Data/LODSettings"><![CDATA[--[==[
	LODa1 - lower poly, render further
	LODa2 - higher poly, render closer

	TreeLOD - trees
	FoliageLOD - bushes/flowers

	PlayerEquipment - client-sided equipment rendering?
	PlayerCharacter - individual player characters
]==]

--[==[
	Buildings:
	- interior renderer (interior of building detail)
	- exterior renderer (building details, entrance, basic interior if there)
]==]

local Module = {}

-- level-of-detail tags
Module.LODTags = {'LODa1', 'LODa2', 'FoliageLOD', 'TreeLOD', 'PlayerEquipment', 'PlayerCharacter'}

-- interior-rendering tags
Module.InteriorTags = {'TownRegionLOD'}

-- tags that are ALWAYS visible on the server, LOD = exterior shell
Module.ServerEnabled = {'PlayerCharacter'}

-- tags that are ALWAYS visible on the client, LOD = exterior shell
Module.ClientEnabled = {}

-- high velocity threshold
Module.HighVelocityThreshold = 1_000

-- when in high velocity, only render these LOD tags
Module.HighVelocityTagWhitelist = {'PlayerCharacter'}

-- tags that have billboard entities enabled
Module.BillboardEnabledTags = {'TreeLOD'}

-- render distances for main tags
Module.LODRenderDistances = {
	Default = 512,

}

-- render distances for billboards
Module.BillboardRenderDistances = {
	Default = 1280,

}

-- maximum bounds of the quad-tree (divisble by 2)
Module.MaximumQuadTreeBounds = 131_072

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/Dialogue"><![CDATA[--[[
	ability to:
	- cutscene
	- audio/visual/camera effect
	- run quest event (Talk/Interact)
	- viewport & icon image
	- rich text
	- dialogue actions (DelaySeconds, MultiOption, StartNewDialogueId)
	- cinematic cues per line (camera pan, shake, sfx, vfx, label) —
	  authored via the optional `cues` arg on BuildDialogueDisplay
	  (5th positional). Cues share the same shape as Cinematics.luau
	  (CinematicShared.CueKind + Args). DialogueWidget walks them at
	  line-show time and dispatches via CinematicClient.PlayCue, so
	  inline dramatic beats don't need to be authored as standalone
	  cinematics. See DialogueCues.* helpers below.
]]

-- // Internal // --
local function BuildDialogueDisplay( textData, iconData, cutsceneId, visualEffectsArray, cues, autoAdvance )
	return {
		Text = textData,
		Icon = iconData,
		cutsceneId = cutsceneId,
		visualEffectsArray = visualEffectsArray,
		Cues = cues,
		-- Optional seconds-to-auto-advance. When set, DialogueWidget
		-- schedules a timer that advances on the FIRST option after
		-- this many seconds. Cancelled if the user clicks an option
		-- or the dialogue closes early.
		AutoAdvance = autoAdvance,
	}
end

-- Convenience constructors for common cinematic cue shapes used inside
-- dialogue. Each returns a single cue table; compose into a `cues` array
-- on a node's Display via BuildDialogueDisplay's 5th argument.
local DialogueCues = {}

function DialogueCues.CameraTo(at: number, instancePath: string?, position: CFrame?, lerp: number?)
	if instancePath then
		return { At = at, Kind = 'CameraTo', Args = {
			Anchor = 'instance', InstancePath = instancePath, Lerp = lerp or 0.6,
		}}
	end
	return { At = at, Kind = 'CameraTo', Args = {
		Anchor = 'world', Position = position, Lerp = lerp or 0.6,
	}}
end

function DialogueCues.Shake(at: number, magnitude: number, duration: number)
	return { At = at, Kind = 'CameraShake', Args = {
		Magnitude = magnitude, Duration = duration, FadeIn = 0.05, FadeOut = duration * 0.5,
	}}
end

function DialogueCues.SFX(at: number, sound: string | number, pitch: number?)
	return { At = at, Kind = 'PlaySFX', Args = { Sound = sound, Pitch = pitch }}
end

function DialogueCues.Reset(at: number)
	return { At = at, Kind = 'CameraReset', Args = {} }
end

local function BuildDialogueTextData( TitleText, TitleCol, DescText, DescCol )
	TitleCol = TitleCol or Color3.new(1,1,1)
	DescCol = DescCol or Color3.new(1,1,1)
	return { Title = { Text = TitleText, TextColor3 = TitleCol }, Description = { Text = DescText, TextColor3 = DescCol } }
end

local function BuildOptionDisplayData( Text, TextColor3 )
	TextColor3 = TextColor3 or Color3.new(1,1,1)
	return { Label = { Text = Text, TextColor3 = TextColor3 } }
end

-- // Dialogue Builder // --
local DialogueBuilder = {}

function DialogueBuilder.MultiOption( optionDisplayData, ... )
	return { Type = 'MultiOption', Display = optionDisplayData, Options = { ... }, }
end

function DialogueBuilder.YesNoOption( displayData, yesDialogue, noDialogue )
	return DialogueBuilder.MultiOption( displayData, {
		Display = BuildOptionDisplayData('Yes'),
		Options = yesDialogue,
	}, {
		Display = BuildOptionDisplayData('No'),
		Options = noDialogue,
	})
end

function DialogueBuilder.MultipleActions( actionsArray, delayPeriod )
	return { Type = "Action", Actions = actionsArray, Delay = delayPeriod }
end

function DialogueBuilder.SingleAction( action, delayPeriod )
	return DialogueBuilder.MultipleActions( {action}, delayPeriod )
end

function DialogueBuilder.ConditionalCheck( conditionFunction, ifTrue, ifFalse )
	return { Type = "Conditional", Condition = conditionFunction, True = ifTrue, False = ifFalse }
end

function DialogueBuilder.ExitDialogue()
	return { Type = "Exit" }
end

function DialogueBuilder.BuildExitButton()
	return {
		Display = BuildOptionDisplayData('Exit'),
		Options = DialogueBuilder.ExitDialogue(),
	}
end

-- Two calling conventions, picked by the type of the first arg:
--   (titleStr, descriptionStr, afterNode) -- builds a default Display
--      from raw strings (no cues / no icon overrides).
--   (displayTable, afterNode)             -- uses the caller's prebuilt
--      Display (output of BuildDialogueDisplay) so authors can attach
--      per-line cues / icon / cutscene without re-wrapping.
-- Both produce a MultiOption with a single '...' continue button that
-- advances to `afterNode`.
function DialogueBuilder.DisplayTextContent( titleOrDisplay, descriptionOrAfter, after )
	local display, nextNode
	if typeof(titleOrDisplay) == 'table' then
		display, nextNode = titleOrDisplay, descriptionOrAfter
	else
		display = BuildDialogueDisplay(
			BuildDialogueTextData(titleOrDisplay, false, descriptionOrAfter, false),
			"rbxassetid://-1", false, false
		)
		nextNode = after
	end
	-- Defensive unwrap: when authors mistakenly pass `BuildExitButton()`
	-- (an option-entry: `{Display, Options=ExitDialogue()}`) instead of
	-- `ExitDialogue()` itself, fold the entry's Options up into the
	-- nextNode slot. Without this, the Continue button advances into a
	-- "node" that's actually shape `{Display, Options}` — DialogueWidget
	-- then iterates that pseudo-node's Options (which is the Exit
	-- table `{Type='Exit'}`) as if it were an option array, and the
	-- string key `'Type'` crashes the option-button's `%d` format.
	if typeof(nextNode) == 'table'
		and nextNode.Display ~= nil and nextNode.Options ~= nil
		and nextNode.Type == nil then
		nextNode = nextNode.Options
	end
	return DialogueBuilder.MultiOption(display, {
		Display = BuildOptionDisplayData('Continue'),
		Options = nextNode,
	})
end

-- // Module // --
local Module = {}

Module.DialogueBuilder = DialogueBuilder
Module.DialogueCues = DialogueCues

Module.DialogueEnums = {
	OpenDialogue = 1,
	CloseDialogue = 2,

	StartedDialogue = 3,
	SteppedDialogue = 4,
	EndedDialogue = 5,
}

Module.Dialogue = {

	TestDialogue1 = {
		Tree = DialogueBuilder.YesNoOption(
			BuildDialogueDisplay(
				BuildDialogueTextData("Yes-No", false, "Yes for action, no to close", false),
				"rbxassetid://-1",
				false,
				false
			),
			DialogueBuilder.SingleAction( "START_QUEST:TestQuestLine2", 0 ),
			DialogueBuilder.ExitDialogue()
		),
	},

	-- // Onboarding Tutor //
	-- The starter NPC at spawn. Conversation explains the trapped-in-
	-- game premise + the Floor-100 quest, then on exit fires the
	-- 'tutor_intro_complete' DialogueAction that OnboardingServer
	-- consumes to advance the player past the meet_tutor step.
	-- Per-line cinematic cues lean on subtle shake + soft sfx so the
	-- conversation reads as story-weighted.
	Tutor_Onboarding = {
		Tree = DialogueBuilder.DisplayTextContent(
			BuildDialogueDisplay(
				BuildDialogueTextData(
					'The Tutor',
					Color3.fromRGB(126, 200, 255),
					"You're awake. Good. Listen — you're inside Bladeborne now. The way out runs through Floor 100.",
					Color3.fromRGB(220, 220, 230)
				),
				'rbxassetid://-1',
				false,
				false,
				{
					DialogueCues.Shake(0.0, 0.10, 0.40),
					DialogueCues.SFX(0.05, 'rbxassetid://9114015882', 0.85),
				}
			),
			DialogueBuilder.DisplayTextContent(
				BuildDialogueDisplay(
					BuildDialogueTextData(
						'The Tutor',
						false,
						"A hundred floors. A hundred bosses. The last one keeps the gate. Beat it and the gate opens. That's the contract.",
						false
					),
					'rbxassetid://-1', false, false,
					{ DialogueCues.Shake(0.0, 0.08, 0.30) }
				),
				DialogueBuilder.DisplayTextContent(
					BuildDialogueDisplay(
						BuildDialogueTextData(
							'The Tutor',
							false,
							"Practice with what you have. Forge real weapons. Take a companion. The first floor's the easiest — don't waste it.",
							false
						),
						'rbxassetid://-1', false, false,
						{ DialogueCues.Shake(0.0, 0.06, 0.25) }
					),
					DialogueBuilder.MultiOption(
						BuildDialogueDisplay(
							BuildDialogueTextData(
								'The Tutor',
								false,
								"Go on. Door's that way.",
								false
							),
							'rbxassetid://-1', false, false
						),
						{
							Display = BuildOptionDisplayData("I'll be back."),
							-- Single-action: tells OnboardingServer to advance
							-- past the 'meet_tutor' step.
							Options = DialogueBuilder.SingleAction('tutor_intro_complete', 0),
						}
					)
				)
			)
		),
	},

	-- Tag-driven test NPC. Spawns when a model in workspace is
	-- tagged 'DialogueNPC' with attribute DialogueId='TestNPC_Greeting'
	-- (see ServerStorage/Core/DialogueNPCServer). Tree exercises every
	-- node type:
	--   * MultiOption with three branches
	--   * Conditional gate on player level (Level >= 3 unlocks an option)
	--   * Action node (DialogueAction → server)
	--   * Per-line cinematic cues (camera shot + shake + sfx)
	-- Designed for the F4 test widget's "TestNPC_Greeting" button so
	-- you can step through every branch without touching server code.
	TestNPC_Greeting = {
		Tree = DialogueBuilder.MultiOption(
			BuildDialogueDisplay(
				BuildDialogueTextData(
					'Cinematic Tester',
					Color3.fromRGB(220, 220, 230),
					'Pick a beat to test. Each path exercises a different cinematic feature.',
					Color3.fromRGB(180, 180, 195)
				),
				'rbxassetid://-1',
				false,
				false,
				{
					-- On line-show: subtle shake + soft over-shoulder lock.
					-- Cues fire at-most-once per node visit (see DialogueWidget).
					DialogueCues.Shake(0.0, 0.10, 0.45),
					DialogueCues.SFX(0.0, 'rbxassetid://9114015882', 0.85),
				}
			),
			-- Branch 1 — chained scene with shake + camera moves.
			{
				Display = BuildOptionDisplayData('Show me the heavy shake'),
				Options = DialogueBuilder.DisplayTextContent(
					BuildDialogueDisplay(
						BuildDialogueTextData(
							'Cinematic Tester',
							false,
							'Hold on to your head — heavy shake incoming.',
							false
						),
						'rbxassetid://-1',
						false,
						false,
						{
							DialogueCues.Shake(0.0, 0.55, 0.50),
							DialogueCues.SFX(0.05, 'rbxassetid://9114015882', 0.6),
						}
					),
					DialogueBuilder.BuildExitButton()
				),
			},
			-- Branch 2 — conditional gate. Players under level 3 hit a
			-- block-message; level-3+ players get an action that fires
			-- the 'cinematic_test_action' string to the server.
			{
				Display = BuildOptionDisplayData('Run the test action (Level 3+)'),
				Options = DialogueBuilder.ConditionalCheck(
					function(_LocalPlayer, PlayerData)
						return PlayerData and (PlayerData.Level or 1) >= 3
					end,
					DialogueBuilder.SingleAction('cinematic_test_action', 0),
					DialogueBuilder.DisplayTextContent(
						BuildDialogueDisplay(
							BuildDialogueTextData(
								'Cinematic Tester',
								false,
								'Need to be at least Level 3 to fire that action.',
								false
							),
							'rbxassetid://-1', false, false,
							{ DialogueCues.Shake(0.0, 0.20, 0.30) }
						),
						DialogueBuilder.BuildExitButton()
					)
				),
			},
			-- Branch 3 — straight exit, no fanfare.
			{
				Display = BuildOptionDisplayData('Goodbye'),
				Options = DialogueBuilder.ExitDialogue(),
			}
		),
	},

	TestDialogue2 = {
		Tree = DialogueBuilder.ConditionalCheck(
			function(LocalPlayer, PlayerData, dialogueId)
				return table.find( PlayerData.CompletedQuests, dialogueId)
			end,
			DialogueBuilder.DisplayTextContent(
				'Billy',
				'You have already completed my tasks!',
				DialogueBuilder.ExitDialogue()
			),
			DialogueBuilder.ConditionalCheck(
				function(LocalPlayer, PlayerData, dialogueId)
					return PlayerData.ActiveQuests[ dialogueId ]
				end,
				DialogueBuilder.DisplayTextContent(
					BuildDialogueDisplay(
						BuildDialogueTextData( "Billy", false, "Ya haven't completed the tasks yet.", false ),
						"rbxassetid://-1",
						false,
						false
					),
					DialogueBuilder.BuildExitButton()
				), -- they are currently busy with the quest
				DialogueBuilder.YesNoOption(
					BuildDialogueDisplay(
						BuildDialogueTextData( "Billy", false, "Start the level 3 quest?", false ),
						"rbxassetid://-1",
						false,
						false
					),
					DialogueBuilder.ConditionalCheck(
						function(LocalPlayer, PlayerData)
							return PlayerData and PlayerData.Level >= 3
						end,
						DialogueBuilder.SingleAction( "start_billy_quest", 0 ),
						DialogueBuilder.MultiOption(
							BuildDialogueDisplay(
								BuildDialogueTextData( "Billy", false, "You must be level 3 at minimum.", false ),
								"rbxassetid://-1",
								false,
								false
							),
							DialogueBuilder.BuildExitButton()
						)
					),
					DialogueBuilder.ExitDialogue()
				) -- they have not started the quest
			)
		),
	},

}

function Module.GetDialogueFromId( dialogueId )
	return Module.Dialogue[ dialogueId ]
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/SaveSlotConfig"><![CDATA[
local Module = {}

Module.MaxSaveSlots = 3

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/Items"><![CDATA[-- // Items — CLIENT-SIDE SHELL //
--
-- Authored data lives at ServerStorage/Modules/Data/Items.luau. This
-- file's `Module.Items` table starts EMPTY and is populated at runtime
-- by ConfigReplicationClient as the server pushes rows for items the
-- player owns (or, for whitelisted admins, the full registry on join).
-- Inventory widgets, hotbar, equipment renderer, etc. continue to call
-- `Module.Items[id]` and `Module.GetConfigFromId(id)` verbatim — the
-- shell returns nil for unowned items, which existing call sites
-- already handle (those paths predate the migration; they treat
-- "unknown id" as "skip / hide").
--
-- The TYPES and CONSTANT TABLES (EquipmentSlotEnums, ItemCategory,
-- ItemTags, ItemSourceLabels, StandardEquipSlots, etc.) intentionally
-- LIVE here, populated. They aren't spoiler content — they describe
-- shapes / enumerate slots — and many widgets read them directly to
-- render UI. Helpers (HasTag, GetEffectiveRarity, GetItemCategories,
-- etc.) operate on a passed-in cfg arg so they work regardless of
-- which side owns the data.
--
-- See ROADMAP.md §"Empty client shell" for the full pattern.

local StatusEffectsConfig = require(script.Parent:WaitForChild('StatusEffects'))
export type EffectDisplay = StatusEffectsConfig.EffectDisplay
export type Effect = StatusEffectsConfig.Effect

local RaritiesConfig = require(script.Parent:WaitForChild('Rarities'))
export type RarityNames = RaritiesConfig.RarityNames

local CompositionalConfig = require(script.Parent:WaitForChild('Compositional'))
export type ForgeCompositionConfig = CompositionalConfig.ForgeCompositionConfig
export type EnchantCompositionConfig = CompositionalConfig.EnchantCompositionConfig
export type SocketingCompositionConfig = CompositionalConfig.SocketingCompositionConfig
export type ItemCompositionConfig = CompositionalConfig.ItemCompositionConfig

export type EquipmentSlotsLabels =
	"Hand" |
	"Head" |
	"Chest" |
	"Legs" |
	"Boots" |
	"Bracelet" |
	"Neck" |
	"LeftEar" |
	"RightEar" |
	"Finger" |
	"Curio"

export type NumberRangeValues = {Min: number, Max: number}

export type DamageValues = {
	Percent: NumberRangeValues,
	Value: NumberRangeValues,
}

export type InflictEffects = {
	Effects: {Effect},
	Chance: NumberRangeValues,
}

export type EquipmentSlotConfig = {
	Slot: number,
	IndexMax: number, -- max extra index for hands/fingers/ears
	AllowMultiEquip: boolean, -- allow multi-equip in other slots
	MaxMultiEquip: number,
}

export type EquipmentUsageConfig = {
	Operation: number,
	Damage: DamageValues,
	Inflicts: {InflictEffects},
}

-- Per-hand-index offsets. Keyed by the equip sub-index that
-- `EquipmentSlotConfig.IndexMax` establishes — `[1]` is the only
-- meaningful slot for single-instance equipment (Head, Chest, …),
-- while dual-wield items carry `[1]` (left) and `[2]` (right). The
-- artist authors each side directly so the renderer doesn't have to
-- guess at a mirror.
export type HandIndexedOffsets = {[number]: CFrame}

-- Per-socket spec for socketable equipment. `Color` is one of the
-- ColorClass values from Gems.luau ('red' / 'blue' / 'green' / 'gold' /
-- 'purple' / 'white' / 'black') OR 'any' for color-agnostic sockets.
-- The socket order in this list = socket index in
-- Composition.Socketing.Slots (1-based).
export type ItemSocketSpec = {
	Color: string,
}

export type ItemEquipmentConfig = {
	EquipSlots: {EquipmentSlotConfig},
	--
	StandardOffset: CFrame,
	BackOffsets: HandIndexedOffsets,
	HandOffsets: HandIndexedOffsets,
	--
	WeaponUsage: EquipmentUsageConfig?,
	ToolUsage: EquipmentUsageConfig?,
	--
	Model: string,
	-- Optional socket list — items with Sockets set are gem-socketable.
	-- See GemSocketShared.GetSocketColors for the runtime read path.
	Sockets: {ItemSocketSpec}?,
}

export type ItemConsumeActivateConfigBase = {
	Effects: {Effect},
	Inflicts: {InflictEffects},
	Consumes: boolean,
	ConsumeQuantity: number,
	MinimumQuantity: number,
	Cooldown: number,
}

export type ItemConsumptionConfig = ItemConsumeActivateConfigBase & {
}

export type ItemActivationConfig = ItemConsumeActivateConfigBase & {
}

export type ItemDisplayConfig = {
	Title: {Text: string, TextColor3: Color3?},
	Description: {Text: string, TextColor3: Color3?},
	Icon: {Image: string, ImageColor3: Color3?}?,
	Viewport: {ImageColor3: Color3?, CFrame: CFrame?}?,
}

-- Companion candy items carry this block instead of (or alongside)
-- regular consumption data. `XPAmount` is added to the equipped
-- companion's XP when the candy is used.
export type CompanionCandyData = {
	XPAmount: number,
}

-- Attribute-XP scroll payload. ConsumptionServer reads this when an
-- item with Type='AttributeScroll' is consumed: AttributeId picks the
-- target stat (Strength / Agility / etc., must match a key in
-- Data/Attributes.luau), Amount is the XP grant.
-- Single-target shape — kept for legacy single-attribute scrolls.
export type AttributeXPData = {
	AttributeId: string,
	Amount: number,
}

-- Experience-scroll payload — multi-target variant. Use when a scroll
-- grants XP to MULTIPLE attributes at once ("Greater Insight Scroll:
-- +20 Insight, +10 Focus"). ConsumptionServer iterates `Grants` and
-- routes each entry through AttributeServer.IncrementAttributeExperience.
-- Grants is intentionally an array (not a dict) so the same attribute
-- could be listed twice with different amounts if a designer wants
-- compounding effects — the consumer applies each entry verbatim.
-- Item config also supports the legacy single-target `AttributeXPData`;
-- consumers prefer `ExperienceScrollData` when both are present.
export type ExperienceScrollGrant = {
	AttributeId: string,
	Amount: number,
}
export type ExperienceScrollData = {
	Grants: { ExperienceScrollGrant },
}

-- // Artisan input metadata — see ARTISAN.md §5 //
-- These three fields point an inventory item into the matching artisan
-- catalog (Materials / Gems / Enchants). Multiple ItemConfigs CAN share
-- the same target id (e.g. CrudeIronBar + RefinedIronBar both →
-- ForgeMaterialId='iron') with different per-item metadata to express
-- yield/quality variants. Authors may use the shorthand string field
-- (`ForgeMaterialId = 'iron'`) for the simple case OR the longhand
-- table (`ForgeMaterial = { Id = 'iron', UnitsPerStack = 5 }`) when they
-- need extra metadata. `GetForgeMaterial` / `GetGem` / `GetEnchantInput`
-- below normalize both forms into the longhand shape so callers never
-- branch on which field was used.

export type ForgeMaterialMetadata = {
	Id: string,                     -- → Materials.Materials[id]
	UnitsPerStack: number?,         -- default 1; smelted bars could be 5
}

export type GemMetadata = {
	Id: string,                     -- → Gems.Gems[id] (cut baked into id)
}

export type EnchantInputMetadata = {
	Id: string,                     -- → Enchants.Enchants[id]
	Level: number?,                 -- nil = "any level up to MaxLevel"
	Charges: number?,               -- default 1; rare scrolls could grant multiple applies
}

export type BaseItemConfig = {
	-- Optional category tag for items that fall outside the standard
	-- equipment/consumable/etc. composition. Currently used for
	-- 'CompanionCandy'; may be extended for other category-specific
	-- items (key items, recipe pages, etc.).
	Type: string?,

	-- Optional semantic tag list. Each entry is a value from
	-- `Module.ItemTags`. Tags drive UI eligibility (hotbar accepts
	-- only Skill/Food/Potion; the inventory tab filters by Weapon/
	-- Equipment/Accessory) WITHOUT changing the underlying data shape.
	-- Items can carry multiple tags — a battle-buff scroll could be
	-- {AttributeScroll, Potion}.
	Tags: { number }?,

	-- Optional source list — author-declared "where can the player
	-- get this from?". Each entry is a `Module.ItemSources` value.
	-- Surfaced as text in the inventory detail's "CAN BE OBTAINED
	-- FROM" row. Multi-source items list every origin.
	Sources: { number }?,

	Rarity: number,
	MaxQuantity: number,

	EquipmentData: ItemEquipmentConfig?, -- can be 'equipped'
	ConsumptionData: ItemConsumptionConfig?, -- can be 'consumed'
	ActivationData: ItemActivationConfig?, -- can be 'activated'
	Composition: ItemCompositionConfig?, -- extra metadata

	-- Companion candy payload. Read by CompanionsServer.UseCompanionCandy.
	CandyData: CompanionCandyData?,

	-- Attribute-XP scroll payload. Read by ConsumptionServer when
	-- Type='AttributeScroll' (one scroll → +Amount XP toward the
	-- specified attribute). Independent of CompanionCandy so an item
	-- could conceivably carry both, though no current scroll does.
	AttributeXPData: AttributeXPData?,

	-- Experience-scroll metadata. Set this on items tagged with
	-- ItemTags.ExperienceScroll so ConsumptionServer can grant XP to
	-- every listed attribute in one consume. Multi-target — a single
	-- legendary scroll can roll +50 Strength, +50 Vitality at once.
	ExperienceScrollData: ExperienceScrollData?,

	-- // Artisan input pointers. Set EITHER the *Id shorthand OR the
	-- corresponding longhand table; never both. //
	ForgeMaterialId: string?,
	ForgeMaterial: ForgeMaterialMetadata?,
	GemId: string?,
	Gem: GemMetadata?,
	EnchantInputData: EnchantInputMetadata?,

	Display: ItemDisplayConfig,
}

-- Per-hand back offsets for sheathed weapons. The two CFrames are
-- mirrored across the body's X axis (yaw sign flipped) so two
-- sheathed swords sit symmetrically on either side of the spine.
-- Tune each entry independently if a specific weapon needs an
-- asymmetric mount (e.g. a quiver vs. a sword sharing a back).
local DEFAULT_BACK_OFFSETS = {
	[1] = CFrame.new(0, 0, 0.5) * CFrame.Angles(math.rad(-90), math.rad(-45), 0) * CFrame.new(0, 0, 2),
	[2] = CFrame.new(0, 0, 0.5) * CFrame.Angles(math.rad(-90), math.rad( 45), 0) * CFrame.new(0, 0, 2),
}

local WHITE_COLOR = Color3.new(1,1,1)

local function SetProperties<T>(parent: T, properties: {[string]: any}?): T
	if properties then
		for k, v in properties do
			parent[k] = v
		end
	end
	return parent
end

local function BasicColorDisplay(name: string, description: string, color: Color3?): ItemDisplayConfig
	return {
		Title = {Text = name, TextColor3 = color},
		Description = {Text = description, TextColor3 = color},
		Icon = nil,
		Viewport = nil,
	}
end

local function BasicIconDisplay(name: string, description: string, color: Color3, image: string, imageColor: Color3?): ItemDisplayConfig
	return {
		Title = {Text = name, TextColor3 = color},
		Description = {Text = description, TextColor3 = color},
		Icon = {Image = image, ImageColor3 = imageColor},
		Viewport = nil,
	}
end

local function BasicViewportDisplay(name: string, description: string, color: Color3, viewportCFrame: CFrame?, viewportColor: Color3?): ItemDisplayConfig
	return {
		Title = {Text = name, TextColor3 = color},
		Description = {Text = description, TextColor3 = color},
		Icon = nil,
		Viewport = {ImageColor3 = viewportColor, CFrame = viewportCFrame},
	}
end

local function StandardViewportDisplay(name: string, description: string)
	return BasicViewportDisplay(name, description, WHITE_COLOR, CFrame.identity, WHITE_COLOR)
end

local function FastDefineItem(properties: BaseItemConfig?): BaseItemConfig
	return SetProperties({
		Rarity = RaritiesConfig.RarityEnums.Common,
		MaxQuantity = 1,

		EquipmentData = nil,
		ConsumptionData = nil,
		ActivationData = nil,
		Composition = nil,

		Display = BasicColorDisplay('null', 'null', WHITE_COLOR),
	}, properties)
end

local Module = {}

Module.EquipmentSlotEnums = {
	Hand = 1,
	Head = 2,
	Chest = 3,
	Legs = 4,
	Boots = 5,
	--
	Bracelet = 10,
	Neck = 11,
	Ear = 12,
	Finger = 13,
	--
	Curio = 99,
}

-- General-purpose item categories. An item can belong to multiple buckets
-- simultaneously (a pickaxe is both Weapon + Tool; a charm could be both
-- Activatable + Consumable), so `GetItemCategories` returns an array.
-- These are derived from the cfg's composition tables — there's no stored
-- `Categories` field on items, so the enum and the cfg shape can never drift.
Module.ItemCategory = {
	Weapon        = 1, -- EquipmentData.WeaponUsage present
	Tool          = 2, -- EquipmentData.ToolUsage present
	Equipment     = 3, -- EquipmentData with armor slot (Head/Chest/Legs/Boots)
	Accessory     = 4, -- EquipmentData with jewelry slot (Bracelet/Neck/Ear/Finger/Curio)
	Consumable    = 5, -- ConsumptionData present
	Activatable   = 6, -- ActivationData present
	Material      = 7, -- forge / craft input (ForgeMaterialId set), or generic fallback
	Gem           = 8, -- gem socket input (GemId set)
	EnchantScroll = 9, -- enchant input (EnchantInputData set)
}

----------------------------------------------------------------------
-- Item tags. Author-supplied semantic labels per item, separate from
-- the data-shape-derived `ItemCategory`. Where ItemCategory answers
-- "what data does this item carry?", Tags answer "what is this item
-- *for*?". A consumable with `ConsumptionData` could be Food OR Potion;
-- the data shape is identical, the *intent* differs — and UI surfaces
-- like the hotbar (only skills/food/potions allowed) need the intent
-- to filter correctly.
--
-- Multi-tag is supported: a torch could be {Tool, Equipment}; a
-- battle-buff scroll could be {Potion, AttributeScroll}. Authors set
-- `Tags = { Module.ItemTags.X, ... }` on item entries; HasTag helps
-- consumers query.
--
-- IDs are grouped by domain (combat 1-9, consumable 10-19, crafting
-- 20-29, special 30-39) so adding a new tag in one domain doesn't
-- shift ids in another. Save files that store tag ids stay valid.
----------------------------------------------------------------------
----------------------------------------------------------------------
-- Item sources. Author-tagged origin labels — answers "where can I
-- get this?". Surfaced in the inventory detail's "CAN BE OBTAINED
-- FROM" row so the player knows whether to grind a mob, head to the
-- shop, or craft. An item can list multiple sources (a sword that
-- drops AND can be crafted carries both).
----------------------------------------------------------------------
Module.ItemSources = {
	Crafted    = 1,   -- crafting recipe output
	Drop       = 2,   -- mob drop
	Shop       = 3,   -- bought from a vendor
	Quest      = 4,   -- quest reward
	Treasure   = 5,   -- chest / world discovery
	Forge      = 6,   -- forge output (different from generic Crafted)
	Starter    = 7,   -- given on first join / new save
	Event      = 8,   -- limited-time event reward
	Boss       = 9,   -- boss-specific drop (separate from generic Drop)
}

-- Display labels for the source enum. Used by the inventory detail
-- "CAN BE OBTAINED FROM" row + any future filter chip surfaces.
Module.ItemSourceLabels = {
	[Module.ItemSources.Crafted]  = 'Crafted',
	[Module.ItemSources.Drop]     = 'Monster Drop',
	[Module.ItemSources.Shop]     = 'Shop',
	[Module.ItemSources.Quest]    = 'Quest Reward',
	[Module.ItemSources.Treasure] = 'Treasure',
	[Module.ItemSources.Forge]    = 'Forge',
	[Module.ItemSources.Starter]  = 'Starter Pack',
	[Module.ItemSources.Event]    = 'Event Reward',
	[Module.ItemSources.Boss]     = 'Boss Drop',
}

Module.ItemTags = {
	-- // Combat / equippable.
	Weapon          = 1,
	Tool            = 2,
	Equipment       = 3,  -- armor body slots
	Accessory       = 4,  -- jewelry / curio
	-- // Consumable.
	Food             = 10,
	Potion           = 11,
	AttributeScroll  = 12,
	Candy            = 13,
	-- Multi-target experience scroll (uses ExperienceScrollData on the
	-- cfg). AttributeScroll above remains for the legacy single-target
	-- shape (AttributeXPData). Two tags so a UI surface can filter
	-- between "single-stat scroll" and "multi-stat scroll" if desired.
	ExperienceScroll = 14,
	-- // Crafting.
	Material        = 20,
	Gem             = 21,
	EnchantScroll   = 22,
	-- // Special.
	Quest           = 30,  -- can't be sold / dropped
	Cosmetic        = 31,  -- visual-only
}

-- True when the item's `Tags` array contains the given tag id. Returns
-- false on missing/invalid configs and on configs that omit the Tags
-- field (no tags = no tag matches).
function Module.HasTag(itemConfig: any, tagId: number): boolean
	if typeof(itemConfig) ~= 'table' then return false end
	local tags = itemConfig.Tags
	if typeof(tags) ~= 'table' then return false end
	for _, t in tags do
		if t == tagId then return true end
	end
	return false
end

-- Slot enums that classify as "jewelry" rather than armor. Lookup table
-- so `GetItemCategories` doesn't repeat a chain of `or`s for each call.
local ACCESSORY_SLOT_LOOKUP = {
	[Module.EquipmentSlotEnums.Bracelet] = true,
	[Module.EquipmentSlotEnums.Neck]     = true,
	[Module.EquipmentSlotEnums.Ear]      = true,
	[Module.EquipmentSlotEnums.Finger]   = true,
	[Module.EquipmentSlotEnums.Curio]    = true,
}

-- Per-hand-index hand offsets. Index 1 is the LEFT hand, 2 is the
-- RIGHT hand. The two CFrames are mirrored: same translation
-- magnitude, opposite Z-rotation sign so the grip orientation faces
-- the same body-relative direction on both sides.
Module.StandardHandOffsets = {
	Sword = {
		[1] = CFrame.Angles(0, 0, math.rad( 90)) * CFrame.new(0.18, 0, 0),
		[2] = CFrame.Angles(0, 0, math.rad(-90)) * CFrame.new(0.18, 0, 0),
	},
}

Module.StandardEquipSlots = {
	Hands = {
		Slot = Module.EquipmentSlotEnums.Hand,
		IndexMax = 2, -- 1 = left, 2 = right
		AllowMultiEquip = true,
		MaxMultiEquip = 2,
	},
}

Module.WeaponUsageOperations = {
	Longsword = 1,
}

-- Empty at boot — populated by ConfigReplicationClient (category 'Items').
Module.Items = {} :: {[string]: BaseItemConfig}


function Module.GetConfigFromId(id: string): BaseItemConfig
	return Module.Items[id]
end

-- Effective rarity for a stack. Forged stacks may carry a per-stack
-- RarityOverride baked at forge time (Composition.Forged.RarityOverride),
-- which beats the cfg's static Rarity. Future systems (enchant tiers,
-- ascended drops) can layer their own overrides on the stack root and
-- this helper picks the highest available.
--
-- All rarity-aware UI sites (inventory tooltip, hotbar slot color,
-- equipment renderer cards) call into this so the override surfaces
-- consistently. cfg-only paths (bulk catalog browsers, missing-stack
-- previews) keep using cfg.Rarity directly.
function Module.GetEffectiveRarity(itemConfig: BaseItemConfig?, stack: any?): number
	local base = itemConfig and itemConfig.Rarity or 1
	if typeof(stack) ~= 'table' then return base end
	-- Direct stack-root override (e.g. ascended loot drop).
	if typeof(stack.Rarity) == 'number' then return stack.Rarity end
	-- Forge override.
	if typeof(stack.Composition) == 'table' then
		local forged = stack.Composition.Forged
		if forged and typeof(forged.RarityOverride) == 'number' then
			return forged.RarityOverride
		end
	end
	return base
end

-- Returns every category bucket the item belongs to, as an array of
-- `Module.ItemCategory` enum numbers. Order is stable: Weapon → Tool →
-- Equipment/Accessory → Consumable → Activatable → Material. The array
-- is freshly allocated on each call; cache it at the call site if it
-- ever shows up in a profile.
function Module.GetItemCategories(itemConfig: BaseItemConfig?): {number}
	local cats = {}
	if not itemConfig then
		table.insert(cats, Module.ItemCategory.Material)
		return cats
	end
	local equip = itemConfig.EquipmentData
	if equip then
		if equip.WeaponUsage then table.insert(cats, Module.ItemCategory.Weapon) end
		if equip.ToolUsage   then table.insert(cats, Module.ItemCategory.Tool)   end
		-- An item that's neither a weapon nor a tool but has equip slots
		-- is wearable; classify by primary slot to split armor vs jewelry.
		if not equip.WeaponUsage and not equip.ToolUsage then
			local firstSlot = equip.EquipSlots and equip.EquipSlots[1]
			local slotEnum = firstSlot and firstSlot.Slot
			if slotEnum and ACCESSORY_SLOT_LOOKUP[slotEnum] then
				table.insert(cats, Module.ItemCategory.Accessory)
			else
				table.insert(cats, Module.ItemCategory.Equipment)
			end
		end
	end
	if itemConfig.ConsumptionData then table.insert(cats, Module.ItemCategory.Consumable)  end
	if itemConfig.ActivationData  then table.insert(cats, Module.ItemCategory.Activatable) end
	-- Artisan input categories. Gem / EnchantScroll are pure metadata
	-- pointers — they layer cleanly on top of any other category.
	if itemConfig.GemId or itemConfig.Gem then
		table.insert(cats, Module.ItemCategory.Gem)
	end
	if itemConfig.EnchantInputData then
		table.insert(cats, Module.ItemCategory.EnchantScroll)
	end
	-- Material is mutually exclusive with the equippable / consumable /
	-- activatable buckets: an item that already classifies as one of
	-- those is NOT additionally a material, even if it has a forge
	-- pointer. Otherwise a "consumable scroll with a forge tag" would
	-- show up in BOTH the consumables tab AND the materials tab —
	-- visually duplicative and not what the player expects.
	local isAlreadyEquipOrConsume = false
	for _, c in cats do
		if c == Module.ItemCategory.Weapon
			or c == Module.ItemCategory.Tool
			or c == Module.ItemCategory.Equipment
			or c == Module.ItemCategory.Accessory
			or c == Module.ItemCategory.Consumable
			or c == Module.ItemCategory.Activatable
		then isAlreadyEquipOrConsume = true; break end
	end
	if not isAlreadyEquipOrConsume
		and (itemConfig.ForgeMaterialId or itemConfig.ForgeMaterial) then
		table.insert(cats, Module.ItemCategory.Material)
	end
	-- Final fallback: nothing matched — treat as a material so the item
	-- still appears in the inventory somewhere. Anything legitimately
	-- equippable would have already taken its bucket above.
	if #cats == 0 then table.insert(cats, Module.ItemCategory.Material) end
	return cats
end

-- // Artisan input resolvers — see ARTISAN.md §6 //
-- Both shorthand (Id-only string field) and longhand (full metadata
-- table field) are supported on ItemConfig. These helpers normalize
-- both forms into the longhand shape with default fields filled in,
-- so call sites never have to branch on which field was used.
-- Returns nil if the item isn't a forge / gem / enchant input at all.

function Module.GetForgeMaterial(itemConfig: BaseItemConfig?): ForgeMaterialMetadata?
	if not itemConfig then return nil end
	if itemConfig.ForgeMaterial then
		local m = itemConfig.ForgeMaterial
		return { Id = m.Id, UnitsPerStack = m.UnitsPerStack or 1 }
	end
	if typeof(itemConfig.ForgeMaterialId) == 'string' then
		return { Id = itemConfig.ForgeMaterialId, UnitsPerStack = 1 }
	end
	return nil
end

function Module.GetGem(itemConfig: BaseItemConfig?): GemMetadata?
	if not itemConfig then return nil end
	if itemConfig.Gem then return { Id = itemConfig.Gem.Id } end
	if typeof(itemConfig.GemId) == 'string' then return { Id = itemConfig.GemId } end
	return nil
end

function Module.GetEnchantInput(itemConfig: BaseItemConfig?): EnchantInputMetadata?
	if not itemConfig then return nil end
	local e = itemConfig.EnchantInputData
	if not e or typeof(e.Id) ~= 'string' then return nil end
	return { Id = e.Id, Level = e.Level, Charges = e.Charges or 1 }
end

-- Convenience: walk Module.Items to find every item config whose
-- ForgeMaterialId resolves to the given material id. Used by the cmdr
-- /give_material command to pick a canonical inventory item to grant.
-- Returns the lowest-rarity match first (deterministic ordering).
function Module.GetItemIdsByForgeMaterialId(materialId: string): {string}
	local matches = {}
	for itemId, cfg in Module.Items do
		local fm = Module.GetForgeMaterial(cfg)
		if fm and fm.Id == materialId then
			table.insert(matches, { Id = itemId, Rarity = cfg.Rarity or 1 })
		end
	end
	table.sort(matches, function(a, b) return a.Rarity < b.Rarity end)
	local out = {}
	for _, m in matches do table.insert(out, m.Id) end
	return out
end

-- Single-membership convenience check. Cheaper to call when you only
-- care about one bucket — avoids walking the array at the call site.
function Module.HasItemCategory(itemConfig: BaseItemConfig?, category: number): boolean
	if not itemConfig then
		return category == Module.ItemCategory.Material
	end
	local equip = itemConfig.EquipmentData
	if category == Module.ItemCategory.Weapon then
		return equip ~= nil and equip.WeaponUsage ~= nil
	elseif category == Module.ItemCategory.Tool then
		return equip ~= nil and equip.ToolUsage ~= nil
	elseif category == Module.ItemCategory.Equipment or category == Module.ItemCategory.Accessory then
		if not equip or equip.WeaponUsage or equip.ToolUsage then return false end
		local firstSlot = equip.EquipSlots and equip.EquipSlots[1]
		local slotEnum = firstSlot and firstSlot.Slot
		local isAccessory = slotEnum ~= nil and ACCESSORY_SLOT_LOOKUP[slotEnum] == true
		return (category == Module.ItemCategory.Accessory) == isAccessory
	elseif category == Module.ItemCategory.Consumable then
		return itemConfig.ConsumptionData ~= nil
	elseif category == Module.ItemCategory.Activatable then
		return itemConfig.ActivationData ~= nil
	elseif category == Module.ItemCategory.Material then
		return Module.GetForgeMaterial(itemConfig) ~= nil
			or (equip == nil
				and itemConfig.ConsumptionData == nil
				and itemConfig.ActivationData == nil
				and Module.GetGem(itemConfig) == nil
				and Module.GetEnchantInput(itemConfig) == nil)
	elseif category == Module.ItemCategory.Gem then
		return Module.GetGem(itemConfig) ~= nil
	elseif category == Module.ItemCategory.EnchantScroll then
		return Module.GetEnchantInput(itemConfig) ~= nil
	end
	return false
end

function Module.FindInventoryItemOfUUID(inventory, uuid: string): ({}?, string?)
	for itemId, uuidDict in inventory do
		if uuidDict[uuid] then
			return uuidDict[uuid], itemId
		end
	end
	return nil, nil
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/Mounts"><![CDATA[-- // Mounts — CLIENT-SIDE SHELL //
--
-- Authored data lives at ServerStorage/Modules/Data/Mounts.luau.
-- This file's `Module.Mounts` table starts EMPTY and is populated at
-- runtime by MountsConfigReplicationClient as the server pushes rows
-- the player has earned (owned mounts + transitive deps), or — for
-- whitelisted admin UserIds — the full registry on join.
--
-- // Reading contract //
-- Callers must tolerate `Module.Mounts[id] == nil` for a player who
-- doesn't own the mount yet. Treat absent ids as "not currently
-- visible to this player" and render nothing rather than erroring
-- (e.g. the Mounts tab hides un-replicated entries; the hotbar's
-- mount slot greys out if the equipped mount's config isn't replicated
-- yet — though in practice the bootstrap pass populates owned mounts
-- before the first frame the widget can open).
--
-- The type exports below are STILL valid — they describe the shape of
-- a mount config row, which the server-side authored copy still
-- conforms to and the replicator pushes verbatim. Type-checked code
-- that asserts `mountCfg :: MountConfig` continues to compile.
--
-- See ROADMAP.md §"Empty client shell" for the full pattern.
--
-- Mount kinds:
--   'land'   — runs on the ground; humanoid WalkSpeed boost.
--   'hover'  — floats above the ground at HoverHeight, walks normally.
--             No flight controls — Space/Ctrl don't ascend/descend; the
--             rider is just "elevated" while moving with WSAD. Reads as
--             "magic carpet" / "hoverboard" in feel.
--   'flight' — true flight rig: humanoid.PlatformStand + BodyVelocity,
--             Space/Ctrl ascend/descend with FlightCeiling cap.
export type MountKind = 'land' | 'hover' | 'flight'

export type MountStats = {
	Speed: number,                  -- forward studs/sec while mounted
	Acceleration: number,           -- studs/sec² ramp
	TurnRate: number,               -- rad/sec yaw
	JumpPower: number?,             -- land/hover mounts; nil = use base humanoid
	HoverHeight: number?,           -- hover only: studs above ground (humanoid HipHeight)
	FlightCeiling: number?,         -- max height above ground in studs (flight only)
	FlightAscentRate: number?,      -- studs/sec when ascending (flight only)
	FlightDescentRate: number?,     -- studs/sec when descending or no input (flight only)
	DismountOnDamage: boolean,
}

export type MountAnimations = {
	Idle: string?,
	Walk: string?,
	Run: string?,
	Jump: string?,
	Land: string?,
	Hover: string?,                 -- flight only
	Glide: string?,                 -- flight only
	RiderIdle: string?,             -- player rider animation while seated
	RiderRun: string?,
}

export type MountSoundEffects = {
	Mount: { Sound: string, Volume: number? }?,
	Dismount: { Sound: string, Volume: number? }?,
	Footstep: { Sound: string, Volume: number? }?,
	WingFlap: { Sound: string, Volume: number? }?,
}

export type MountConfig = {
	Display: {
		Name: string,
		Description: string,
		Icon: string?,
	},
	Kind: MountKind,
	Model: string,                  -- AssetsShared.Mounts.<Model>
	SeatOffset: CFrame,             -- where the rider sits relative to the model
	Stats: MountStats,
	Animations: MountAnimations,
	SFX: MountSoundEffects,
	Tint: Color3?,                  -- procedural placeholder tint for the mount's breed color
	UnlockSource: 'quest' | 'shop' | 'achievement' | 'event' | 'starter',
}

-- Backwards-compat alias: older code may refer to MountsConfig (singular
-- key). Both names point at the same shape.
export type MountsConfig = MountConfig

local Module = {}

-- Empty at boot — populated by MountsConfigReplicationClient.
Module.Mounts = {} :: { [string]: MountConfig }

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/CombatConfig"><![CDATA[
-- // Module // --
local Module = {}

Module.CombatConfig = {
	ATTACK_DURATION = 0.6, -- how many seconds to allow hits to register
	CUTOFF_TIME = 0.6, -- how many seconds max inbetween each press for combo (if over the time, starts cooldown period)
	MAX_DISTANCE_CUTOFF = 9,
	Damage = 10,

	BLOCK_MAX_HITS = 5,
	BLOCK_COOLDOWN = 1.5,
	-- Short post-block delay BEFORE the player can attack again. The
	-- block cooldown still runs for the full BLOCK_COOLDOWN seconds —
	-- you can't re-block until that drains — but attacks free up much
	-- sooner (0.1 s) so a block-cancel into a swing feels responsive.
	-- Tuned so a player who block-cancels gets a frame of swing-window
	-- rather than the full re-block lockout the old "shared cooldown"
	-- model imposed.
	BLOCK_TO_ATTACK_DELAY = 0.1,
	-- WalkSpeed (studs/sec) applied to the character while blocking.
	-- Default is 16; we drop to 8 so the player can reposition mid-
	-- block but can't kite an enemy by holding F + WASD. Restored
	-- to the cached pre-block value on EndCharacterBlock.
	BLOCK_WALK_SPEED = 8,

	ROLL_COOLDOWN = 3,
	ROLL_DISTANCE = 25,
	ROLL_DURATION = 0.35,

	-- Dodge — Nier-style short evade with i-frame window. Distinct from
	-- ROLL_* so future systems can split the two (roll = dedicated
	-- traversal mechanic, dodge = combat evade).
	DODGE_COOLDOWN = 1.2,            -- seconds between dodges
	DODGE_DURATION = 0.35,           -- total locomotion override window
	DODGE_IFRAME_WINDOW = 0.25,      -- i-frame portion of the window
	DODGE_DISTANCE = 14,             -- studs covered

	-- Combo system. See NIER_COMBAT.md for the design + CombatMovesets.luau
	-- for the registry.
	--
	-- COMBO_BUFFER is the heart of the chain feel: an input arriving this
	-- many seconds BEFORE a move's cancel point is queued and replayed at
	-- the cancel point instead of being dropped. Without it, a player
	-- mashing at the natural rhythm loses roughly one press in three,
	-- which reads as the game ignoring input.
	COMBO_BUFFER       = 0.18,       -- input-buffer window ahead of a cancel point (s)
	COMBO_MAX_LENGTH   = 4,          -- inputs in a chain before forced reset
	-- Input-to-input window before the chain resets to a fresh single
	-- letter. Must exceed the slowest authored move's total duration or
	-- heavy classes could never reach their own second step.
	COMBO_RESET_WINDOW = 1.5,

	-- Perfect dodge counter. PERFECT_DODGE_WINDOW is the overlap window
	-- between a player's dodge and a nearby enemy's active swing/attacking
	-- state — within this many seconds = perfect dodge. The COUNTER_WINDOW
	-- is how long the bonus state persists; COUNTER_DAMAGE_MULT is the
	-- multiplier applied to the player's next swing(s) during the window.
	PERFECT_DODGE_WINDOW = 0.10,
	COUNTER_WINDOW       = 1.5,
	COUNTER_DAMAGE_MULT  = 1.5,
	-- Search radius for "is there an enemy currently swinging at me?"
	-- when resolving perfect dodge. Studs.
	PERFECT_DODGE_DETECT_RADIUS = 12,

	ATTACK_TRACK_RADIUS = 16,        -- semi-auto target search radius on attack input
	ATTACK_TRACK_CONE_DOT = 0.15,    -- forward cone; locked targets bypass this
	ATTACK_TRACK_CLOSE_RANGE = 5,    -- close targets can be slightly off-axis

	-- Air juggle. The first slice is intentionally simple: later combo-chain
	-- hits and heavy inputs lift PvE targets, and the attacker follows upward a
	-- little so the chain keeps contact.
	AIR_JUGGLE_START_CHAIN = 5,
	AIR_JUGGLE_LIFT = 8,
	AIR_JUGGLE_HEAVY_LIFT = 12,
	AIR_JUGGLE_DURATION = 0.18,
	AIR_JUGGLE_STATE_DURATION = 0.75,
	AIR_JUGGLE_HOVER_DURATION = 0.55,
	AIR_JUGGLE_AIR_HIT_HOVER_DURATION = 0.65,
	AIR_JUGGLE_ATTACKER_FOLLOW = 0.45,
	AIR_JUGGLE_ATTACKER_MAX_LIFT = 5,
	AIR_JUGGLE_SLAM_CHAIN = 10,
	AIR_JUGGLE_SLAM_VELOCITY = 38,
	AIR_JUGGLE_SLAM_DURATION = 0.28,
	AIR_JUGGLE_SLAM_LOCKOUT = 2,
	AIR_JUGGLE_SLAM_ATTACK_COOLDOWN = 2,

	-- Pod-style companion auto-attack (Stage F). Interval between pulses
	-- and per-shot damage scalar. Damage formula:
	--   shotDamage = companion.Level * POD_DAMAGE_PER_LEVEL
	-- which gives small per-shot but meaningful DPS over a long fight.
	POD_ATTACK_INTERVAL    = 0.3,
	POD_ATTACK_RANGE       = 8,   -- studs; melee-radius pod, not a sniper
	POD_DAMAGE_PER_LEVEL   = 2,

	-- PvP scalars. Multiplied / capped against PvE values when a swing
	-- resolves between two players. See NIER_COMBAT.md.
	PvP_COMBO_CAP          = 2,         -- max chain length in PvP
	PvP_FINISHER_ENABLED   = false,     -- finishers disabled in PvP
	PvP_RESONANCE_MULT     = 0.5,       -- gem resonance halved
	PvP_COUNTER_MULT       = 1.25,      -- perfect-dodge counter scalar in PvP
	PvP_AIR_JUGGLE_MULT    = 0.35,      -- PvP CC movement is shorter/capped
	PvP_MAX_JUGGLE         = 1,         -- air hits allowed against a player

	----------------------------------------------------------------
	-- Poise / stagger.
	--
	-- Poise decouples "did this hit land" from "did this hit stagger".
	-- Without it every connect hard-stuns, which is what made trading
	-- with a mob a stun-lock in either direction. A combatant absorbs
	-- PoiseDamage until the pool empties, staggers once, then the pool
	-- regenerates after POISE_REGEN_DELAY of not being hit.
	--
	-- Archetype defaults are applied by CombatStateServer from the
	-- model's `PoiseArchetype` attribute; mobs can override with an
	-- explicit `MaxPoise` attribute.
	----------------------------------------------------------------
	POISE_REGEN_DELAY      = 2.0,   -- seconds without a hit before regen starts
	POISE_REGEN_RATE       = 30,    -- poise per second once regen begins
	POISE_ARCHETYPES = {
		-- MaxPoise, stagger duration on break, whether launch is allowed
		Fodder = { MaxPoise = 25,  StaggerDuration = 0.55, Launchable = true,  MaxJuggle = 3 },
		Medium = { MaxPoise = 60,  StaggerDuration = 0.45, Launchable = true,  MaxJuggle = 2 },
		Elite  = { MaxPoise = 140, StaggerDuration = 0.35, Launchable = false, MaxJuggle = 0 },
		Boss   = { MaxPoise = 320, StaggerDuration = 0.30, Launchable = false, MaxJuggle = 0 },
		Player = { MaxPoise = 90,  StaggerDuration = 0.30, Launchable = true,  MaxJuggle = 1 },
	},
	POISE_DEFAULT_ARCHETYPE = 'Fodder',

	----------------------------------------------------------------
	-- Attack motion: nothing is displaced horizontally, by anyone.
	--
	-- Attacks do not close distance and hits do not push their victim
	-- back, so there is no step-in tuning and no knockback tuning here
	-- any more. A swing turns the caster toward its target and plays on
	-- the spot; the victim keeps its footing and its position. A class's
	-- ability to reach an enemy is entirely CombatMovesets `Reach` +
	-- `HitboxSize`, and covering ground is the player's job.
	--
	-- The forced motion that remains is vertical (launch / hover /
	-- air-follow / slam, tuned below). Keeping the horizontal plane empty
	-- is what makes the vertical work authorable: a launcher describes a
	-- lift and nothing else is competing for the same body.
	----------------------------------------------------------------
	-- WalkSpeed applied to the attacker for the length of their own
	-- swing. NOT zero: the character is never frozen in place. Attacking
	-- commits you to a direction and slows you to a shuffle, but you keep
	-- enough control to adjust a step, which is what stops a committed
	-- swing feeling like a cutscene.
	--
	-- Restored to the speed cached before the swing, not to a hardcoded
	-- 16 — a mount, a booster or a debuff may own the real value.
	ATTACK_WALK_SPEED = 5,
	-- How fast the attacker turns toward the target when a swing starts,
	-- as an exponential rate (higher = snappier). Applied client-side
	-- over the wind-up; see CombatMotionClient.
	ATTACK_TURN_RATE = 14,

	----------------------------------------------------------------
	-- Poise-break and crowd-control durations, split PvE / PvP.
	-- PvP values sit at the 35-50% band NIER_COMBAT.md specifies.
	----------------------------------------------------------------
	STAGGER_PVP_SCALE       = 0.45,
	KNOCKDOWN_DURATION      = 0.9,
	KNOCKDOWN_PVP_DURATION  = 0.5,
	-- Getup invulnerability after a hard knockdown. Without this a
	-- knockdown into a fresh launcher is an infinite loop.
	GETUP_IFRAMES           = 0.9,
	GETUP_IFRAMES_PVP       = 1.1,

	----------------------------------------------------------------
	-- Juggle decay. Each successive air hit lifts less than the last,
	-- so a juggle terminates on its own even before the count cap.
	----------------------------------------------------------------
	AIR_JUGGLE_DECAY        = 0.7,
	-- Maximum drift the attacker's air-follow will cover chasing a
	-- juggled victim horizontally.
	AIR_FOLLOW_MAX_DRIFT    = 12,

	----------------------------------------------------------------
	-- Perfect evade. The window is now measured against real server
	-- hitbox activity rather than a proximity scan: a dodge counts as
	-- perfect when its i-frames overlap an active enemy hitbox that
	-- would otherwise have connected.
	----------------------------------------------------------------
	PERFECT_DODGE_OVERLAP_GRACE = 0.12, -- extra leniency around the active window (s)

	----------------------------------------------------------------
	-- Server-side remote budget. Per-action minimum intervals plus a
	-- stricter allowance for malformed payloads, per NIER_COMBAT.md's
	-- anti-exploit section.
	----------------------------------------------------------------
	RATE_MIN_ATTACK_INTERVAL = 0.04,
	RATE_MIN_DODGE_INTERVAL  = 0.12,
	RATE_MIN_GUARD_INTERVAL  = 0.10,
	RATE_MALFORMED_BUDGET    = 12,   -- malformed payloads before denial logging escalates
	RATE_MALFORMED_WINDOW    = 10,   -- rolling window for the above (s)

	-- Maximum drift between the client's reported origin and the server's
	-- own view of the character before the hint is discarded.
	MAX_ORIGIN_DRIFT = 5,
}

Module.StunDurations = {
	NPC = 0.8,
	Player = 0.4,
	LastComboHit = 0.8,
	BlockBreak = 1.4,
}

-- default animations if none specified per-weapon
Module.Defaults = {
	Stunned = 'rbxassetid://111802956280579',
	KnockedDown = 'rbxassetid://122191447461183',

	ToSheatheLeft = 'rbxassetid://99815494080346', -- unequip
	UnSheatheLeft = 'rbxassetid://140385807835124', -- equip

	ToSheatheRight = 'rbxassetid://122699356986057', -- unequip
	UnSheatheRight = 'rbxassetid://107077981323776', -- equip

	Blocking = 'rbxassetid://111658160229445',
	BlockBreak = 'rbxassetid://140386892607780',
}

-- SFX for weapon draw/sheathe. `Volume` is the *base* config volume; the
-- effective playback volume is `Volume × SettingsRegistry.SFXVolume ×
-- SettingsRegistry.MasterVolume` (applied inside playCombatSFX so the
-- user's audio sliders take effect).
--
-- `SoundId` is resolved by SoundService.ResolveSoundToInstance, which
-- accepts: an `rbxassetid://N` URI (creates a fresh Sound), a direct
-- child name in AssetsShared.Sounds, or a slash-separated nested path
-- (e.g. 'Game/sheathe' → AssetsShared.Sounds.Game.sheathe). Path lookup
-- preserves any spatial properties (RollOff, MaxDistance, etc.) authored
-- on the source Sound instance.
Module.SoundEffects = {
	UnSheathe = { SoundId = 'Game/unsheathe', Volume = 0.5 },
	ToSheathe = { SoundId = 'Game/sheathe',   Volume = 0.5 },
	Block     = { SoundId = 'rbxassetid://4773909987', Volume = 0.6 },
}

-- Per-weapon-class animation registry. Each class declares its own
-- slots so the look matches the per-class move timings in
-- CombatMovesets.luau. The legacy LeftHand/RightHand/DualHand arrays
-- remain as a per-class fallback for lookups when a per-key slot is
-- missing.
--
-- IMPORTANT: this registry is COSMETIC. Nothing here participates in
-- gameplay timing, hit detection or state. A class with no entry, an
-- unresolvable asset id, or an animation that never finishes loading
-- produces a silent visual gap and a fully functional swing. See
-- CombatAnimationClient for the nil-safe resolution layer.
--
-- Asset IDs default to the existing light-attack asset until designers
-- author per-class mocaps. Each class points at its own copy so
-- swapping in new IDs per class is a single-file edit.
local _DEFAULT_LIGHT = 'rbxassetid://130197342886283'
local function classDefaults(): { [string]: any }
	-- Build a fresh table per class so editing one class's slots
	-- doesn't accidentally mutate another's registry. (Lua tables
	-- are passed by reference; sharing a single seed table would
	-- couple the classes.)
	return {
		LeftHand  = { _DEFAULT_LIGHT },
		RightHand = { _DEFAULT_LIGHT },
		DualHand  = { _DEFAULT_LIGHT },

		-- Ground chain. These four are the light string and they are what
		-- a player sees most, so they are the ones most worth making
		-- distinct — the character no longer travels during a swing, so
		-- the animation is now the ONLY thing distinguishing hit 1 from
		-- hit 3. Any root motion baked into the clip is welcome here:
		-- nothing else is driving the character horizontally to fight it.
		L1     = _DEFAULT_LIGHT, -- opener
		L2     = _DEFAULT_LIGHT, -- second, ideally mirrored from L1
		L3     = _DEFAULT_LIGHT, -- third
		L_FIN  = _DEFAULT_LIGHT, -- light finisher, biggest of the four
		H1     = _DEFAULT_LIGHT, -- heavy; sell the weight in the clip
		H2     = _DEFAULT_LIGHT, -- heavy follow-up

		-- Vertical. These two are the uprise/slam pair, and they are the
		-- reason the horizontal axis was cleared: the character is being
		-- moved straight up (H_LAUNCH) or straight down (A_SLAM) by
		-- CombatMotionServer while these play, so an upward-swinging clip
		-- and a downward-spiking clip now read exactly as intended
		-- instead of being smeared sideways by a step-in.
		H_LAUNCH = _DEFAULT_LIGHT, -- ground launcher: swing UP
		A_SLAM   = _DEFAULT_LIGHT, -- air finisher: spike DOWN

		-- Air chain (Context = Air). Plays while hovering.
		A_L1   = _DEFAULT_LIGHT,

		-- Perfect-evade counter (Context = DodgeCounter).
		C_L1   = _DEFAULT_LIGHT,
		C_H1   = _DEFAULT_LIGHT,
	}
end

Module.AttackSets = {
	-- Generic fallback used by the animation loader when the active
	-- class's set is missing entirely. Empty arrays so the legacy
	-- round-robin returns nil and pickAnimByEntry falls back cleanly.
	Default = {
		LeftHand = {},
		RightHand = {},
		DualHand = {},
	},

	-- Per-class sets. Class names match CombatMovesets.Classes keys.
	Sword       = classDefaults(),
	Longsword   = classDefaults(),
	Greatsword  = classDefaults(),
	Dagger      = classDefaults(),
	DualDagger  = classDefaults(),
	Spear       = classDefaults(),
	Mace        = classDefaults(),
	Hammer      = classDefaults(),
}

Module.AnimationSets = {

	-- DEFAULT
	Default = {
		Stunned = Module.Defaults.Stunned,
		KnockedDown = Module.Defaults.KnockedDown,

		ToSheatheLeft = Module.Defaults.ToSheatheLeft,
		UnSheatheLeft = Module.Defaults.UnSheatheLeft,

		ToSheatheRight= Module.Defaults.ToSheatheRight,
		UnSheatheRight= Module.Defaults.UnSheatheRight,

		Blocking = Module.Defaults.Blocking,
		BlockBroken = Module.Defaults.BlockBreak,

		Attacking = Module.AttackSets.Default, -- attack for both single and dual wield
	},

	-- SWORD
	Sword = {
		Stunned = Module.Defaults.Stunned,
		KnockedDown = Module.Defaults.KnockedDown,

		ToSheatheLeft = Module.Defaults.ToSheatheLeft,
		UnSheatheLeft = Module.Defaults.UnSheatheLeft,

		ToSheatheRight= Module.Defaults.ToSheatheRight,
		UnSheatheRight= Module.Defaults.UnSheatheRight,

		Blocking = Module.Defaults.Blocking,
		BlockBroken = Module.Defaults.BlockBreak,

		Attacking = Module.AttackSets.Sword, -- attack for both single and dual wield
	},
}

--[[

	Dual Wield
	- Daggers

	One Handed (right)
	- Shortsword
	- Longsword
	- Mace
	- Hammer
	- Waraxe
]]

Module.Emotes = {
	Sleep = 'rbxassetid://-1',
}

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/Mobs"><![CDATA[
export type Animations = {
	Idle: string,
	Walk: string,
	[string]: string,
}

export type MobConfig = {
	HasOverheadInfo: boolean,
	HasCrystalCrystal: boolean,
	IsInvulnerable: boolean,
	RewardLootOnDeath: boolean,

	WalkSpeed: number,

	MaxTrackRange: number,

	MaxAttackRange: number,
	AttackDashSpeed: number,
	AttackDamage: number,
	FactionId: string?,

	Animations: Animations,
}

local function SetProperties(parent, properties)
	for i, v in properties do
		parent[i] = v
	end
	return parent
end

-- default mob properties
local function BuildDefault(properties): MobConfig
	return SetProperties({
		HasOverheadInfo = true,
		HasCrystalCrystal = true,
		IsInvulnerable = false,

		Animations = nil,

		RewardLootOnDeath = true,
		FactionId = nil,
	}, properties)
end

-- // Module // --
local Module = {}

-- customize mob properties
Module.Mobs = {
	-- Baseline melee enemy. These values drive the shared combat runtime
	-- exactly as a player's equipped weapon does — the mob resolves the
	-- default weapon class's moveset and runs the same combo grammar.
	Generic = BuildDefault({
		MaxTrackRange = 50,
		MaxAttackRange = 7,
		-- Where pursuit parks. Sitting slightly inside attack range
		-- stops the mob walking into the player and shoving them.
		PreferredRange = 5,
		AttackDamage = 10,
		AttackInterval = 1,
		-- Probability of evading when a hostile hitbox is genuinely live
		-- and overlapping this mob. Not a timer: see TryEvadeIncoming.
		DodgeChance = 0.15,
		-- Poise archetype governs how much punishment it absorbs before
		-- staggering, and whether it can be launched at all.
		PoiseArchetype = 'Fodder',
	}),

	-- Attack-dummy class. Stationary swing-on-tick — no target tracking,
	-- no wander, no movement. Used by SetupTestDummies to drive the
	-- workspace.Attacking / LeftAttacker / RightAttacker / DualAttacker
	-- rigs. SwingInterval governs the period between swings; the
	-- ForceBlockBreak boolean attribute on the model (set per-rig in
	-- SetupTestDummies) overrides the BT's default swing args.
	AttackDummy = BuildDefault({
		SwingInterval = 1.0,
		-- The BT routes through the shared combat runtime, so a dummy
		-- swings with the same moveset, reach and combo grammar a player
		-- would get from the same weapon. It walks an L, L, H pattern,
		-- meaning the third beat is the class's launcher — parking a
		-- character in front is enough to see the full chain.
		--
		-- No movement: the dummy faces wherever it was placed in Studio.
		PoiseArchetype = 'Fodder',
	}),

	Boar = BuildDefault({
		WalkSpeed = 14,

		MaxTrackRange = 36,

		MaxAttackRange = 24,
		AttackDashSpeed = 36,
		AttackDamage = 10,

		Animations = {
			Idle = 'rbxassetid://15145743300',
			Walk = 'rbxassetid://15145746545',

			ChargeRun = 'rbxassetid://15145755732'
		},
	}),

	-- BossBoar — phased boss variant. Same model + animations as Boar
	-- but ~10× HP, BossId set so EnemyServer routes it through
	-- BossServer for phase tracking, and HasOverheadInfo=false because
	-- BossHealthbarWidget owns the visual surface for bosses.
	-- The Boss config (Data/Bosses.luau:boss_boar) drives every
	-- attack pattern — recipes from Data/CombatSkills.luau drive
	-- the actual telegraph + damage path.
	BossBoar = BuildDefault({
		HasOverheadInfo = false,
		HasCrystalCrystal = false,
		BossId = 'boss_boar',

		WalkSpeed = 14,
		MaxTrackRange = 60,
		MaxAttackRange = 28,
		AttackDashSpeed = 38,
		AttackDamage = 14,    -- baseline; per-recipe damage overrides

		-- BossBoar shares the Boar's animation rig — the procedural
		-- size/health bumps come from BossBoar.luau on init.
		Animations = {
			Idle = 'rbxassetid://15145743300',
			Walk = 'rbxassetid://15145746545',
			ChargeRun = 'rbxassetid://15145755732',
		},
	}),
} :: {[string]: MobConfig}

return Module
]]></Source>
