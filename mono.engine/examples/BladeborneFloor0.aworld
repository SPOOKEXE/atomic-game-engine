		<Source path="src/ServerScriptService/CmdrSetup/Commands/world/SetWeatherServer.luau"><![CDATA[local ReplicatedStorage = game:GetService('ReplicatedStorage')

-- LightingTracker reads `Thunderstorm` (boolean) for the active weather
-- state and `WeatherLocked` (boolean) to decide whether the random
-- ambient flipper is allowed to mutate it. SetWeather writes both so
-- a manual override sticks until cleared via `auto`.
return function(_context, kind: string)
	local k = string.lower(tostring(kind or ''))
	if k == 'clear' or k == 'sunny' then
		ReplicatedStorage:SetAttribute('Thunderstorm', false)
		ReplicatedStorage:SetAttribute('WeatherLocked', true)
		return 'Weather → CLEAR (locked).'
	elseif k == 'thunderstorm' or k == 'storm' or k == 'rain' then
		ReplicatedStorage:SetAttribute('Thunderstorm', true)
		ReplicatedStorage:SetAttribute('WeatherLocked', true)
		return 'Weather → THUNDERSTORM (locked).'
	elseif k == 'auto' or k == 'reset' or k == 'unlock' then
		ReplicatedStorage:SetAttribute('WeatherLocked', false)
		return 'Weather → AUTO (ambient randomizer resumed).'
	end
	return string.format("Unknown weather kind '%s'. Use 'clear' | 'thunderstorm' | 'auto'.",
		tostring(kind))
end
]]></Source>
		<Source path="src/ServerScriptService/CmdrSetup/Hooks/resethook.luau"><![CDATA[
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CmdrConfig = require(ReplicatedStorage:WaitForChild('CmdrConfig'))

return function(registry)
	registry:RegisterHook("BeforeRun", function(context)
		local plr = context.Executor
		if not plr then
			return "No executor."
		end
		local group = context.Group
		if group == "Admin" and not CmdrConfig.IsPlayerAdmin(plr) then
			return string.format("No permission for '%s'.", tostring(context.Name or "command"))
		end
		return nil
	end)
end
]]></Source>
