-- Extra palette entries specific to the social tab. `HOSTILE` clashes with
-- `PALETTE.danger` intentionally (same color, different semantics); kept
-- separate so a future redesign tweaking duel-UI colors doesn't spill into
-- every damage indicator in the game.
local HOSTILE   = Color3.fromRGB(255, 93, 109)
local ONLINE    = Color3.fromRGB(106, 227, 168)
local GUILD_RED = Color3.fromRGB(255, 93, 120)

----------------------------------------------------------------------
-- Shared helpers
----------------------------------------------------------------------

-- Small round-ish icon button used in friend / nearby rows for whisper /
-- trade / duel / invite actions. Nothing is wired — click logs a stub.
local function actionIconButton(scope, glyph: string, tooltip: string)
	return scope:New('TextButton') {
		Size = UDim2.fromOffset(28, 28),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		FontFace = HUDCommon.FONT_UI,
		Text = glyph,
		TextSize = 13,
		TextColor3 = PALETTE.ink,
		[Fusion.OnEvent('Activated')] = function()
			warn(string.format('[Social] %s (stub)', tooltip))
		end,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.7, Thickness = 1 },
		},
	}
end

----------------------------------------------------------------------
-- Sub-panels
----------------------------------------------------------------------

local function buildFriendsPanel(scope)
	local header = scope:New('Frame') {
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			Utils.eyebrow(scope, '◆ FRIENDS · 6 ONLINE', { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 14) }),
			scope:New('TextLabel') {
				Position = UDim2.fromOffset(0, 18),
				Size = UDim2.new(1, -100, 0, 28),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = "Your Party's Trace",
				TextSize = 22,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextButton') {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, 0, 0, 22),
				Size = UDim2.fromOffset(80, 24),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				FontFace = HUDCommon.FONT_MONO,
				Text = '+ ADD',
				TextSize = 11,
				TextColor3 = PALETTE.accent,
				[Fusion.OnEvent('Activated')] = function() warn('[Social] add friend (stub)') end,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
				},
			},
		},
	}

	local rows = {}
	for i, f in PLACEHOLDER_FRIENDS do
		local dimTrans = f.on and 0 or 0.45
		local borderTrans = f.on and 0.6 or 0.82
		local statusColor = f.on and ONLINE or PALETTE.inkFaint
		local avatar = scope:New('Frame') {
			Size = UDim2.fromOffset(40, 40),
			BackgroundColor3 = PALETTE.bg0,
			BorderSizePixel = 0,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = PALETTE.accent, Transparency = borderTrans, Thickness = 1 },
				scope:New('TextLabel') {
					Size = UDim2.fromScale(1, 1),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_DISPLAY,
					Text = string.sub(f.n, 1, 1),
					TextSize = 16,
					TextColor3 = f.on and PALETTE.accent or PALETTE.ink,
				},
				f.on and scope:New('Frame') {
					AnchorPoint = Vector2.new(1, 1),
					Position = UDim2.new(1, 2, 1, 2),
					Size = UDim2.fromOffset(8, 8),
					BackgroundColor3 = ONLINE,
					BorderSizePixel = 0,
				} or nil,
			},
		}

		local info = scope:New('Frame') {
			Size = UDim2.new(1, -280, 1, 0),
			Position = UDim2.fromOffset(52, 0),
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				scope:New('TextLabel') {
					Size = UDim2.new(1, 0, 0, 18),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_DISPLAY,
					Text = string.format('%s  <font color="#7ec8ff" size="11">LV %d</font>', f.n, f.lv),
					RichText = true,
					TextSize = 15,
					TextColor3 = PALETTE.ink,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('TextLabel') {
					Position = UDim2.fromOffset(0, 20),
					Size = UDim2.new(1, 0, 0, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_UI,
					Text = f.cl,
					TextSize = 11,
					TextColor3 = PALETTE.inkDim,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
			},
		}

		local status = scope:New('TextLabel') {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -110, 0.5, 0),
			Size = UDim2.fromOffset(140, 14),
			BackgroundTransparency = 1,
			FontFace = HUDCommon.FONT_MONO,
			Text = string.upper(f.s),
			TextSize = 11,
			TextColor3 = statusColor,
			TextXAlignment = Enum.TextXAlignment.Right,
		}

		local actions = scope:New('Frame') {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.fromOffset(100, 30),
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				scope:New('UIListLayout') {
					FillDirection = Enum.FillDirection.Horizontal,
					Padding = UDim.new(0, 4),
					SortOrder = Enum.SortOrder.LayoutOrder,
					VerticalAlignment = Enum.VerticalAlignment.Center,
				},
				actionIconButton(scope, '✉', 'whisper ' .. f.n),
				actionIconButton(scope, '+', 'invite ' .. f.n),
				actionIconButton(scope, '⇆', 'trade ' .. f.n),
			},
		}

		table.insert(rows, scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 56),
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = dimTrans + 0.1,
			BorderSizePixel = 0,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = PALETTE.accent, Transparency = borderTrans, Thickness = 1 },
				scope:New('UIPadding') {
					PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
					PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
				},
				avatar, info, status, actions,
			},
		})
	end

	local listScroll = scope:New('ScrollingFrame') {
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 1, -60),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = PALETTE.accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				Padding = UDim.new(0, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			table.unpack(rows),
		},
	}

	return scope:New('Frame') {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			header, listScroll,
		},
	}
end

local function buildGuildPanel(scope)
	-- Banner: emblem + name + member-count + 4-cell mini stat grid
	local bannerStats = {}
	for i, pair in PLACEHOLDER_GUILD_STATS do
		table.insert(bannerStats, scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(0.5, -4, 0, 34),
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = 0.2,
			BorderSizePixel = 0,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.75, Thickness = 1 },
				scope:New('UIPadding') {
					PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
					PaddingTop = UDim.new(0, 3), PaddingBottom = UDim.new(0, 3),
				},
				scope:New('TextLabel') {
					Size = UDim2.new(1, 0, 0, 10),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = pair[1],
					TextSize = 9,
					TextColor3 = PALETTE.inkFaint,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('TextLabel') {
					Position = UDim2.fromOffset(0, 12),
					Size = UDim2.new(1, 0, 0, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = pair[2],
					TextSize = 12,
					TextColor3 = PALETTE.accent,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
			},
		})
	end

	local banner = scope:New('Frame') {
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 110),
		BackgroundColor3 = Color3.fromRGB(26, 10, 16),
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = GUILD_RED, Transparency = 0.2, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 14),
				PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16),
			},
			scope:New('TextLabel') {
				Size = UDim2.fromOffset(64, 82),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = '✜',
				TextSize = 32,
				TextColor3 = GUILD_RED,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = GUILD_RED, Transparency = 0.1, Thickness = 1 },
				},
			},
			scope:New('Frame') {
				Position = UDim2.fromOffset(80, 0),
				Size = UDim2.new(1, -320, 1, 0),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					Utils.eyebrow(scope, '◆ GUILD · CLEARER', { Size = UDim2.new(1, 0, 0, 12), Color = GUILD_RED }),
					scope:New('TextLabel') {
						Position = UDim2.fromOffset(0, 14),
						Size = UDim2.new(1, 0, 0, 32),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_DISPLAY,
						Text = 'Knights of the Blood',
						TextSize = 24,
						TextColor3 = PALETTE.ink,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					scope:New('TextLabel') {
						Position = UDim2.fromOffset(0, 50),
						Size = UDim2.new(1, 0, 0, 14),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_UI,
						Text = 'Led by Heathcliff · 42 members · founded Fl·14',
						TextSize = 12,
						TextColor3 = PALETTE.inkDim,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
				},
			},
			scope:New('Frame') {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, 0, 0, 0),
				Size = UDim2.fromOffset(220, 82),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIGridLayout') {
						CellSize = UDim2.new(0.5, -4, 0, 34),
						CellPadding = UDim2.fromOffset(8, 6),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					table.unpack(bannerStats),
				},
			},
		},
	}

	-- Perks row — 4 accent-bordered cards side-by-side.
	local perkCards = {}
	for i, p in PLACEHOLDER_GUILD_PERKS do
		table.insert(perkCards, scope:New('Frame') {
			LayoutOrder = i,
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = 0.1,
			BorderSizePixel = 0,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.65, Thickness = 1 },
				scope:New('UIPadding') {
					PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
					PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
				},
				scope:New('TextLabel') {
					Size = UDim2.new(1, 0, 0, 10),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO, Text = '◆ PERK', TextSize = 9,
					TextColor3 = PALETTE.inkFaint, TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('TextLabel') {
					Position = UDim2.fromOffset(0, 13),
					Size = UDim2.new(1, 0, 0, 18),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_DISPLAY, Text = p[1], TextSize = 14,
					TextColor3 = PALETTE.accent, TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('TextLabel') {
					Position = UDim2.fromOffset(0, 34),
					Size = UDim2.new(1, 0, 0, 12),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO, Text = p[2], TextSize = 11,
					TextColor3 = ONLINE, TextXAlignment = Enum.TextXAlignment.Left,
				},
			},
		})
	end

	local perksSection = scope:New('Frame') {
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 0, 82),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			Utils.eyebrow(scope, '◆ ACTIVE PERKS', { Size = UDim2.new(1, 0, 0, 12) }),
			scope:New('Frame') {
				Position = UDim2.fromOffset(0, 16),
				Size = UDim2.new(1, 0, 1, -16),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIGridLayout') {
						CellSize = UDim2.new(0.25, -5, 1, 0),
						CellPadding = UDim2.fromOffset(6, 0),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					table.unpack(perkCards),
				},
			},
		},
	}

	-- Roster grid — 2-col member cards with rank + level.
	local rosterCards = {}
	for i, r in PLACEHOLDER_GUILD_ROSTER do
		table.insert(rosterCards, scope:New('Frame') {
			LayoutOrder = i,
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = 0.15,
			BorderSizePixel = 0,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.82, Thickness = 1 },
				scope:New('UIPadding') { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
					PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) },
				scope:New('Frame') {
					Size = UDim2.fromOffset(32, 32),
					BackgroundColor3 = PALETTE.bg0,
					BorderSizePixel = 0,
					[Fusion.Children] = {
						scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.5, Thickness = 1 },
						scope:New('TextLabel') {
							Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
							FontFace = HUDCommon.FONT_DISPLAY, Text = string.sub(r[1], 1, 1), TextSize = 13,
							TextColor3 = PALETTE.accent,
						},
					},
				},
				scope:New('TextLabel') {
					Position = UDim2.fromOffset(40, 2),
					Size = UDim2.new(1, -40, 0, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_UI,
					Text = string.format('%s  <font color="#7ec8ff" size="10">LV%s</font>', r[1], r[3]),
					RichText = true,
					TextSize = 12,
					TextColor3 = PALETTE.ink,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('TextLabel') {
					Position = UDim2.fromOffset(40, 18),
					Size = UDim2.new(1, -40, 0, 11),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = string.upper(r[2]),
					TextSize = 10,
					TextColor3 = PALETTE.inkFaint,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
			},
		})
	end

	local rosterSection = scope:New('Frame') {
		LayoutOrder = 3,
		Size = UDim2.new(1, 0, 0, 130),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			Utils.eyebrow(scope, '◆ ROSTER · ONLINE', { Size = UDim2.new(1, 0, 0, 12) }),
			scope:New('Frame') {
				Position = UDim2.fromOffset(0, 16),
				Size = UDim2.new(1, 0, 1, -16),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIGridLayout') {
						CellSize = UDim2.new(0.5, -4, 0, 46),
						CellPadding = UDim2.fromOffset(6, 6),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					table.unpack(rosterCards),
				},
			},
		},
	}

	return scope:New('ScrollingFrame') {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = PALETTE.accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				Padding = UDim.new(0, 14),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			banner, perksSection, rosterSection,
		},
	}
end

local function buildNearbyPanel(scope)
	local header = scope:New('Frame') {
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 48),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			Utils.eyebrow(scope, '◆ NEARBY · 11 PLAYERS · 240M RADIUS', { Size = UDim2.new(1, 0, 0, 12) }),
			scope:New('TextLabel') {
				Position = UDim2.fromOffset(0, 16),
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY, Text = 'Within Sight',
				TextSize = 22, TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
		},
	}

	local rows = {}
	for i, p in PLACEHOLDER_NEARBY do
		local tone = p.hostile and HOSTILE or PALETTE.accent
		local barColor = p.hostile and HOSTILE or ONLINE
		table.insert(rows, scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 34),
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = 0.15,
			BorderSizePixel = 0,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = tone, Transparency = 0.7, Thickness = 1 },
				scope:New('UIPadding') { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) },
				scope:New('UIListLayout') {
					FillDirection = Enum.FillDirection.Horizontal,
					Padding = UDim.new(0, 8),
					VerticalAlignment = Enum.VerticalAlignment.Center,
					SortOrder = Enum.SortOrder.LayoutOrder,
				},
				scope:New('TextLabel') {
					LayoutOrder = 1,
					Size = UDim2.fromOffset(52, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO, Text = p.a, TextSize = 12,
					TextColor3 = tone, TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('TextLabel') {
					LayoutOrder = 2,
					Size = UDim2.fromOffset(44, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO, Text = p.d, TextSize = 12,
					TextColor3 = PALETTE.ink, TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('TextLabel') {
					LayoutOrder = 3,
					Size = UDim2.fromOffset(36, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO, Text = 'LV' .. tostring(p.lv), TextSize = 10,
					TextColor3 = tone, TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('TextLabel') {
					LayoutOrder = 4,
					Size = UDim2.new(1, -320, 0, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_UI,
					Text = p.n .. (p.hostile and ' · HOSTILE' or ''),
					TextSize = 13,
					TextColor3 = p.hostile and HOSTILE or PALETTE.ink,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('Frame') {
					LayoutOrder = 5,
					Size = UDim2.fromOffset(80, 14),
					BackgroundTransparency = 1,
					[Fusion.Children] = {
						HUDCommon.smoothBar(scope, { Value = p.h, Max = 100, Color = barColor, Height = 4 }),
					},
				},
				scope:New('Frame') {
					LayoutOrder = 6,
					Size = UDim2.fromOffset(96, 26),
					BackgroundTransparency = 1,
					[Fusion.Children] = {
						scope:New('UIListLayout') {
							FillDirection = Enum.FillDirection.Horizontal,
							Padding = UDim.new(0, 3),
							VerticalAlignment = Enum.VerticalAlignment.Center,
							SortOrder = Enum.SortOrder.LayoutOrder,
						},
						actionIconButton(scope, '⇆', 'trade ' .. p.n),
						actionIconButton(scope, '⚔', 'duel ' .. p.n),
						actionIconButton(scope, '+', 'invite ' .. p.n),
					},
				},
			},
		})
	end

	local listScroll = scope:New('ScrollingFrame') {
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 1, -56),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = PALETTE.accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				Padding = UDim.new(0, 4),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			table.unpack(rows),
		},
	}

	return scope:New('Frame') {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			header, listScroll,
		},
	}
end

local function buildRecentPanel(scope)
	local rows = {}
	for i, p in PLACEHOLDER_RECENT do
		table.insert(rows, scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 52),
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = 0.15,
			BorderSizePixel = 0,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.72, Thickness = 1 },
				scope:New('UIPadding') {
					PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
					PaddingTop = UDim.new(0, 7), PaddingBottom = UDim.new(0, 7),
				},
				scope:New('Frame') {
					Size = UDim2.fromOffset(38, 38),
					BackgroundColor3 = PALETTE.bg0,
					BorderSizePixel = 0,
					[Fusion.Children] = {
						scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.5, Thickness = 1 },
						scope:New('TextLabel') {
							Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
							FontFace = HUDCommon.FONT_DISPLAY, Text = string.sub(p.n, 1, 1), TextSize = 14,
							TextColor3 = PALETTE.accent,
						},
					},
				},
				scope:New('Frame') {
					Position = UDim2.fromOffset(50, 0),
					Size = UDim2.new(1, -280, 1, 0),
					BackgroundTransparency = 1,
					[Fusion.Children] = {
						scope:New('TextLabel') {
							Size = UDim2.new(1, 0, 0, 16),
							BackgroundTransparency = 1,
							FontFace = HUDCommon.FONT_UI, Text = p.n, TextSize = 13,
							TextColor3 = PALETTE.ink, TextXAlignment = Enum.TextXAlignment.Left,
						},
						scope:New('TextLabel') {
							Position = UDim2.fromOffset(0, 18),
							Size = UDim2.new(1, 0, 0, 14),
							BackgroundTransparency = 1,
							FontFace = HUDCommon.FONT_UI, Text = p.ctx, TextSize = 11,
							TextColor3 = PALETTE.inkDim, TextXAlignment = Enum.TextXAlignment.Left,
						},
					},
				},
				scope:New('TextLabel') {
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -180, 0.5, 0),
					Size = UDim2.fromOffset(120, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO, Text = string.upper(p.ago), TextSize = 10,
					TextColor3 = PALETTE.inkFaint, TextXAlignment = Enum.TextXAlignment.Right,
				},
				scope:New('TextLabel') {
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -100, 0.5, 0),
					Size = UDim2.fromOffset(70, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = string.format('%d mutual', p.mutual),
					TextSize = 10,
					TextColor3 = PALETTE.inkDim,
					TextXAlignment = Enum.TextXAlignment.Right,
				},
				scope:New('TextButton') {
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, 0, 0.5, 0),
					Size = UDim2.fromOffset(82, 24),
					BackgroundTransparency = 1,
					AutoButtonColor = false,
					FontFace = HUDCommon.FONT_MONO, Text = '+ FRIEND', TextSize = 10,
					TextColor3 = PALETTE.accent,
					[Fusion.OnEvent('Activated')] = function()
						warn('[Social] add friend ' .. p.n .. ' (stub)')
					end,
					[Fusion.Children] = {
						scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.5, Thickness = 1 },
					},
				},
			},
		})
	end

	local listScroll = scope:New('ScrollingFrame') {
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 1, -56),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = PALETTE.accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				Padding = UDim.new(0, 4),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			table.unpack(rows),
		},
	}

	return scope:New('Frame') {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:New('Frame') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 48),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					Utils.eyebrow(scope, '◆ RECENT ENCOUNTERS', { Size = UDim2.new(1, 0, 0, 12) }),
					scope:New('TextLabel') {
						Position = UDim2.fromOffset(0, 16),
						Size = UDim2.new(1, 0, 0, 28),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_DISPLAY, Text = 'Who You Crossed',
						TextSize = 22, TextColor3 = PALETTE.ink,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
				},
			},
			listScroll,
		},
	}
end

local function buildRosterPanel(scope)
	-- 6-col grid of synthetic "Player_###" cards — purely decorative until
	-- the actual floor roster system lands. 36 cells fills the viewport on
	-- design screen sizes without needing scroll.
	local cells = {}
	for i = 1, 36 do
		local lv = 60 + ((i - 1) % 20)
		local cls = ROSTER_CLASSES[((i - 1) % #ROSTER_CLASSES) + 1]
		table.insert(cells, scope:New('Frame') {
			LayoutOrder = i,
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = 0.15,
			BorderSizePixel = 0,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.82, Thickness = 1 },
				scope:New('UIPadding') {
					PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
					PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
				},
				scope:New('TextLabel') {
					Size = UDim2.new(1, 0, 0, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_UI,
					Text = string.format('Player_%03d', i),
					TextSize = 12,
					TextColor3 = PALETTE.ink,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('TextLabel') {
					AnchorPoint = Vector2.new(0, 1),
					Position = UDim2.new(0, 0, 1, 0),
					Size = UDim2.new(0.5, 0, 0, 12),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = 'LV' .. tostring(lv),
					TextSize = 10,
					TextColor3 = PALETTE.accent,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('TextLabel') {
					AnchorPoint = Vector2.new(1, 1),
					Position = UDim2.new(1, 0, 1, 0),
					Size = UDim2.new(0.5, 0, 0, 12),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO, Text = cls, TextSize = 9,
					TextColor3 = PALETTE.inkFaint, TextXAlignment = Enum.TextXAlignment.Right,
				},
			},
		})
	end

	local gridScroll = scope:New('ScrollingFrame') {
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 1, -56),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = PALETTE.accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		[Fusion.Children] = {
			scope:New('UIGridLayout') {
				CellSize = UDim2.new(1/6, -4, 0, 46),
				CellPadding = UDim2.fromOffset(4, 4),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			table.unpack(cells),
		},
	}

	return scope:New('Frame') {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:New('Frame') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 48),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					Utils.eyebrow(scope, '◆ FLOOR ROSTER · FL 74', { Size = UDim2.new(1, 0, 0, 12) }),
					scope:New('TextLabel') {
						Position = UDim2.fromOffset(0, 16),
						Size = UDim2.new(1, 0, 0, 28),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_DISPLAY, Text = 'Every Soul Above the Fog',
						TextSize = 22, TextColor3 = PALETTE.ink,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
				},
			},
			gridScroll,
		},
	}
end

----------------------------------------------------------------------
-- Tab shell
----------------------------------------------------------------------

function Module.Build(ctx)
	local scope = ctx.scope

	local SelectedSub = scope:Value('friends')

	-- Social submenu rows — RailButton with a numeric count chip. The count
	-- is static (baked into SOCIAL_SUBS), so we pass it as a plain number and
	-- RailButton's chip-text binding renders it once.
	local subButtons = {}
	for i, sub in SOCIAL_SUBS do
		local isActive = scope:Computed(function(use) return use(SelectedSub) == sub.id end)
		local button = Components.RailButton(scope, {
			isActive = isActive,
			glyph    = sub.glyph,
			label    = sub.name,
			chip     = { text = sub.count },
			height   = 34,
			-- Shape-lock + scale: submenu column width LEFT_COL_PX, height 34
			-- → button + scaled internals track the panel.
			aspectRatio = LEFT_COL_PX / 34,
			onActivate = function() SelectedSub:set(sub.id) end,
		})
		button.LayoutOrder = i
		table.insert(subButtons, button)
	end

	local leftColumn = scope:New('Frame') {
		LayoutOrder = 1,
		Size = UDim2.fromScale(LEFT_COL_PX / DESIGN_W, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder },
			Utils.eyebrow(scope, '◆ SOCIAL', {
				LayoutOrder = 0,
				Size = UDim2.new(1, -28, 0, 16),
				Position = UDim2.fromOffset(14, 0),
			}),
			table.unpack(subButtons),
		},
	}

	-- Per-sub content panels, each wrapped in a Frame whose Visible is reactive.
	-- The registry form (id+build pairs) lets us add/remove sub-panels from
	-- one list instead of scattered Visible comparisons in the render tree.
	local panelBuilders = {
		{ id = 'friends', build = buildFriendsPanel },
		{ id = 'guild',   build = buildGuildPanel   },
		{ id = 'nearby',  build = buildNearbyPanel  },
		{ id = 'recent',  build = buildRecentPanel  },
		{ id = 'roster',  build = buildRosterPanel  },
	}
	local panelWrappers = {}
	for _, entry in panelBuilders do
		local id = entry.id
		local inner = entry.build(scope)
		inner.Size = UDim2.fromScale(1, 1)
		table.insert(panelWrappers, scope:New('Frame') {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Visible = scope:Computed(function(use) return use(SelectedSub) == id end),
			[Fusion.Children] = { inner },
		})
	end

	local rightColumn = scope:New('Frame') {
		LayoutOrder = 2,
		Size = UDim2.fromScale((DESIGN_W - RIGHT_INSET_PX) / DESIGN_W, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
			},
			table.unpack(panelWrappers),
		},
	}

	return scope:New('Frame') {
		Name = 'SocialTab',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(20 / OUTER_H, 0),
				PaddingBottom = UDim.new(20 / OUTER_H, 0),
				PaddingLeft   = UDim.new(0, 0),
				PaddingRight  = UDim.new(20 / OUTER_W, 0),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(COL_GAP_PX / DESIGN_W, 0),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			leftColumn, rightColumn,
		},
	}
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/TabWidget/InventoryTab"><![CDATA[-- // TabWidget/InventoryTab.luau //
-- Two-column inventory browser.
--   left  — category-filter row + live search TextBox, grid of weapon/item
--           slots rendered as viewport previews, slot-header count line.
--   right — detail pane: hero card (rarity glow + item viewport), title,
--           type line, sub-tabs (OVERVIEW / FORGE / GEMS / ENCHANTS),
--           per-page content, action bar (EQUIP/UNEQUIP), and a floating
--           cursor-tracking tooltip for the FORGE page.
--
-- Reference: tmp/aincrad-ui/tabs.jsx InventoryDetail.
-- Data sources:
--   * PlayerData.Inventory — map of itemId → { uuid → stack } entries
--   * PlayerData.Equipped  — slot map used to badge equipped stacks
--   * ItemsConfig.Items / .FindInventoryItemOfUUID
--   * Rarities.RarityColors / .RarityValues
--
-- Cross-module deps: `ctx.DataVersion` drives every Computed so updates from
-- the manager's ReplicatedData listener propagate to every reactive binding.
--
-- Per-tab state (lives inside Build() — NOT module scope):
--   * SelectedInventoryUUID        — UUID of the item the user clicked
--   * SelectedInventoryCategory    — 'weapons' | 'equipment' | 'accessories'
--                                    + secondary embedded tabs (mounts /
--                                    companions / auras)
--   * SelectedInventoryDetailTab   — 'overview' | 'forge' | 'gems' | 'enchants'
--   * InventoryFilterText          — live search box value
-- Keeping these as locals inside Build() means the inventory tab can be
-- rebuilt/torn down without leaking state globally.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local GuiService = game:GetService('GuiService')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local peek   = Fusion.peek
local ItemsConfig = ReplicatedModules.Data.Items
local Rarities = ReplicatedModules.Data.Rarities
local CombatUtility = ReplicatedModules.Utility.CombatUtility
local RemoteService = ReplicatedModules.Services.RemoteService

-- Shared remote that drives ConsumptionServer.UseItem. Wired here so the
-- USE button in the action bar can fire-and-forget; the server resolves
-- the uuid → itemId, type-dispatches (CompanionCandy, Potion, etc.),
-- decrements stack, and runs the side-effect.
local ItemUseEvent = RemoteService.GetRemote('ItemUseEvent', 'RemoteEvent', false)
-- PlayerInventoryServer's equip/unequip toggle. Fire with (uuid, slotIndex)
-- where slotIndex is 1 (left) or 2 (right) for hand-slot weapons; the
-- server walks the slot config and routes to AttemptPlayerEquipItemOfUUID
-- or AttemptPlayerUnequipItemOfUUID depending on whether the uuid is
-- already equipped. Validation lives entirely server-side.
local InventoryEvent = RemoteService.GetRemote('InventoryEvent', 'RemoteEvent', false)

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local ViewportUtility = LocalModules.Utility.Viewport
local PALETTE = HUDCommon.PALETTE

local Utils = require(script.Parent.utils)

-- Mount/Companion/Aura sibling tabs are embedded into this tab as
-- categories on the rail. They expose a ctx.embedded flag we set when
-- calling Build so they skip their own outer 24/32 padding (would
-- otherwise compound with InventoryTab's own padding).
local MountsTab     = require(script.Parent:WaitForChild('MountsTab'))
local CompanionsTab = require(script.Parent:WaitForChild('CompanionsTab'))
local AurasTab      = require(script.Parent:WaitForChild('AurasTab'))

local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')

local Module = {}

-- 1394×648 outer canvas, 1330×600 inner after 32/24 UIPadding. Right detail
-- pane is anchored to the right edge; the left column leaves IMPLICIT_GAP_PX
-- between them (no UIListLayout at the root).
local OUTER_W, OUTER_H   = 1394, 648
local DESIGN_W, DESIGN_H = 1330, 600
local RIGHT_COL_PX       = 340
local IMPLICIT_GAP_PX    = 20

----------------------------------------------------------------------
-- Module-scope constants + pure helpers
-- (Nothing here reads Fusion state; safe to live outside Build())
----------------------------------------------------------------------

-- Primary categories: focused on equippables only — weapons / armor
-- (Equipment slot tag) / accessories (jewelry/curio tag). Consumables
-- are managed via the Equip tab's hotbar surface; materials via the
-- Crafting / Forge surfaces. The inventory tab is the equipment-
-- inspection lens, not a catch-all bag.
local INVENTORY_PRIMARY_CATEGORIES = {
	{ id = 'weapons',     label = 'WEAPONS',     glyph = '⚔' },
	{ id = 'equipment',   label = 'EQUIPMENT',   glyph = '⛨' },
	{ id = 'accessories', label = 'ACCESSORIES', glyph = '◈' },
}

-- Secondary categories: embedded sibling tabs surfaced as their own row.
-- Selecting one swaps the items grid + detail pane for the embedded tab's
-- content (see EMBEDDED_CATEGORIES + the embed block in Module.Build).
local INVENTORY_SECONDARY_CATEGORIES = {
	{ id = 'mounts',     label = 'MOUNTS',       glyph = '☗' },
	{ id = 'companions', label = 'COMPANIONS',   glyph = '✦' },
	{ id = 'auras',      label = 'AURAS',        glyph = '✺' },
}

-- Set lookup for the categories that aren't normal inventory items —
-- they swap out the right pane with an embedded tab.
local EMBEDDED_CATEGORIES = {
	mounts = true, companions = true, auras = true,
}

-- Detail-pane sub-tabs (the in-pane navigation row). Data-driven so the
-- visibility Computeds for each sub-page can key off string ids.
local DETAIL_SUBTABS = { 'overview', 'forge', 'gems', 'enchants' }
local DETAIL_SUBTAB_LABELS = {
	overview = 'OVERVIEW',
	forge    = 'FORGE',
	gems     = 'GEMS',
	enchants = 'ENCHANTS',
}

-- Placeholder tables — replaced by real item.cfg reads once those schemas exist.
-- (MOCK_MODIFIERS removed in Stage E; modifier chips now read live from
-- Composition.Forged.Modifiers + StatSnapshot.BonusTraits.)

local FORGE_COMPONENTS = {
	{ key = 'blade1',  label = 'PRIMARY BLADE',   material = 'Voidglass',  tint = Color3.fromRGB(200, 157, 255), bonus = '+120 DMG', tooltip = 'Phase · +10% crit · edge phases through light armor.' },
	{ key = 'blade2',  label = 'SECONDARY BLADE', material = 'Moonsteel',  tint = Color3.fromRGB(180, 200, 255), bonus = '+84 DMG',  tooltip = 'Lunar · regen 2/s while sheathed during Night cycle.' },
	{ key = 'bind1',   label = 'PRIMARY BINDING', material = 'Dragonbone', tint = Color3.fromRGB(255, 198, 112), bonus = '+8% vs Boss', tooltip = 'Dense inlay — increases damage against bosses by 8%.' },
	{ key = 'bind2',   label = 'SECONDARY BIND',  material = 'Starsilk',   tint = Color3.fromRGB(224, 234, 255), bonus = '+AGI',    tooltip = 'Swift · reduces weapon weight; every swing is quicker.' },
	{ key = 'handle',  label = 'HANDLE',          material = 'Iron',       tint = Color3.fromRGB(176, 180, 188), bonus = '— DUR',   tooltip = 'Standard-issue iron grip. Durable, unremarkable.' },
}

-- Map an ItemsConfig entry → inventory tab buckets. Tag-driven first
-- (the new explicit Tags array on item configs); falls back to the
-- data-shape derived ItemCategory for items not yet tagged. Items that
-- don't classify as Weapon / Equipment / Accessory don't surface in
-- the inventory tab at all (consumables / materials live elsewhere).
local function bucketsForItem(itemConfig): {[string]: true}
	local buckets: {[string]: true} = {}
	if ItemsConfig.HasTag(itemConfig, ItemsConfig.ItemTags.Weapon) then
		buckets.weapons = true
	end
	if ItemsConfig.HasTag(itemConfig, ItemsConfig.ItemTags.Equipment) then
		buckets.equipment = true
	end
	if ItemsConfig.HasTag(itemConfig, ItemsConfig.ItemTags.Accessory) then
		buckets.accessories = true
	end
	-- Fallback: derive from data shape for untagged items so legacy
	-- entries don't disappear silently. Tools fold into none of the
	-- three (the user excluded tools per the design ask).
	if next(buckets) == nil then
		for _, cat in ItemsConfig.GetItemCategories(itemConfig) do
			if cat == ItemsConfig.ItemCategory.Weapon then
				buckets.weapons = true
			elseif cat == ItemsConfig.ItemCategory.Equipment then
				buckets.equipment = true
			elseif cat == ItemsConfig.ItemCategory.Accessory then
				buckets.accessories = true
			end
		end
	end
	return buckets
end

-- Spin up a model inside a ViewportFrame using ViewportUtility. No Fusion
-- reactivity here — caller is responsible for invoking it at the right time
-- (on selection-change, via an Observer).
local function setupViewportModel(viewport: ViewportFrame, itemConfig)
	if not itemConfig or not itemConfig.Display or not itemConfig.Display.Viewport then return end
	-- New schema: model name lives under EquipmentData (or could be
	-- absent for non-equippable items). Fall back to bare itemConfig
	-- in case future composition shapes carry a top-level model.
	local modelName = (itemConfig.EquipmentData and itemConfig.EquipmentData.Model) or itemConfig.Model
	if not modelName then return end
	-- Today every item with a viewport uses a weapon model; widen this
	-- once gear/consumable folders land alongside `AssetsShared.Weapons`.
	local sourceFolder = ReplicatedAssets:FindFirstChild('Weapons')
	local model = sourceFolder and sourceFolder:FindFirstChild(modelName) :: Model?
	if not model then return end

	local _, size = model:GetBoundingBox()
	-- 1.4× the longest bounding-box axis keeps the model away from the
	-- frame edges; the 3/4 angle below trades a tiny bit of edge clearance
	-- for a more readable silhouette than the previous straight-on shot.
	local distance = math.max(size.X, size.Y, size.Z, 1) * 1.4

	-- Default viewport CFrame: identity rotates the model 30° around Y for
	-- a 3/4 view so swords/tools read as 3D objects rather than thin lines.
	-- Per-item Display.Viewport.CFrame still wins if the config sets one
	-- explicitly — we only substitute when the caller hasn't picked an angle.
	local configCF = itemConfig.Display.Viewport.CFrame
	local modelCFrame = (configCF and configCF ~= CFrame.identity)
		and configCF
		or CFrame.Angles(0, math.rad(-30), 0) * CFrame.Angles(math.rad(-12), 0, 0)

	-- Slightly elevated camera (Y = distance * 0.25) so we look down at the
	-- model rather than horizontally — gives the asset more presence inside
	-- the small inventory slot.
	local cameraPos = Vector3.new(0, distance * 0.25, distance)
	local cameraCFrame = CFrame.lookAt(cameraPos, modelCFrame.Position)

	ViewportUtility.SetupModelViewport(viewport, model, cameraCFrame, modelCFrame)
end

----------------------------------------------------------------------
-- Build(ctx)
----------------------------------------------------------------------

function Module.Build(ctx)
	local scope = ctx.scope
	local DataVersion = ctx.DataVersion

	-- // Per-tab state // — local to this Build() invocation.
	local SelectedInventoryUUID       = scope:Value(nil)
	local SelectedInventoryCategory   = scope:Value('weapons')
	local SelectedInventoryDetailTab  = scope:Value('overview')
	local InventoryFilterText         = scope:Value('')

	-- // Inventory queries //
	--
	-- `computeInventoryEntries(use, opts)` and `countEntriesByCategory(use)`
	-- are closed over DataVersion so callers only need to hand `use`. Both
	-- assume they're being called INSIDE a Computed that owns `use`.
	local function computeInventoryEntries(use, opts): {any}
		use(DataVersion)
		local data = Utils.getPlayerData()
		if not data or not data.Inventory then return {} end
		local filterCat  = opts and opts.filterCat  or nil
		local filterText = opts and opts.filterText or ''
		filterText = string.lower(filterText or '')
		local hasTextFilter = filterText ~= ''

		-- Set of UUIDs equipped anywhere — lets the slot render an "E" badge.
		-- Reads BOTH `uuid` (canonical, written by PlayerInventoryServer)
		-- and `UUID` (legacy capitalization). The previous code checked
		-- only the legacy form, so the badge never appeared on saves
		-- written by the new flow — same bug masked the equip-toggle UI.
		local equippedSet = {}
		if data.Equipped then
			for _, slotEntry in data.Equipped do
				if typeof(slotEntry) == 'table' then
					local uuid = slotEntry.uuid or slotEntry.UUID
					if uuid then equippedSet[uuid] = true end
				end
			end
		end

		local entries = {}
		local counter = 0
		for itemId, uuidcache in data.Inventory do
			local itemConfig = ItemsConfig.Items[itemId]
			if not itemConfig then continue end
			if filterCat and not bucketsForItem(itemConfig)[filterCat] then continue end
			-- Text filter — case-insensitive substring on display-title OR item-id.
			if hasTextFilter then
				local title = (itemConfig.Display and itemConfig.Display.Title and itemConfig.Display.Title.Text) or itemId
				local haystack = string.lower(tostring(title)) .. ' ' .. string.lower(itemId)
				if string.find(haystack, filterText, 1, true) == nil then continue end
			end
			for uuid, stack in uuidcache do
				counter += 1
				table.insert(entries, {
					uuid = uuid, itemId = itemId, itemConfig = itemConfig,
					stack = stack,
					qtyText = (stack.Quantity and stack.Quantity > 1) and string.format('x%d', stack.Quantity) or '',
					equipped = equippedSet[uuid] == true,
					order = counter,
				})
			end
		end
		return entries
	end

	local function countEntriesByCategory(use): {[string]: number}
		use(DataVersion)
		local data = Utils.getPlayerData()
		local counts = {
			weapons = 0, gear = 0, consum = 0, mats = 0,
			mounts = 0, companions = 0, auras = 0,
		}
		if not data then return counts end
		if typeof(data.Inventory) == 'table' then
			for itemId, uuidcache in data.Inventory do
				local cfg = ItemsConfig.Items[itemId]
				if not cfg then continue end
				-- Multi-bucket: each stack is counted once per bucket it
				-- belongs to. Sum of counts can exceed total stacks — that's
				-- intentional, since the slot-header count tracks "items
				-- reachable from this tab," not a partition of the inventory.
				local buckets = bucketsForItem(cfg)
				for _ in uuidcache do
					for bucket in buckets do
						counts[bucket] = (counts[bucket] or 0) + 1
					end
				end
			end
		end
		-- Embedded categories — count owned entries off the per-system
		-- Owned tables. Same shape across mounts/companions/auras so the
		-- counter is one helper.
		local function countOwned(tbl: any): number
			if typeof(tbl) ~= 'table' then return 0 end
			local n = 0
			for _ in tbl do n += 1 end
			return n
		end
		if typeof(data.Mounts)     == 'table' then counts.mounts     = countOwned(data.Mounts.Owned) end
		if typeof(data.Companions) == 'table' then counts.companions = countOwned(data.Companions.Owned) end
		if typeof(data.Auras)      == 'table' then counts.auras      = countOwned(data.Auras.Owned) end
		return counts
	end

	----------------------------------------------------------------------
	-- Slot renderer — one ViewportFrame per inventory entry.
	----------------------------------------------------------------------
	local function buildInventorySlot(slotScope, entry)
		local uuid = entry.uuid
		local itemConfig = entry.itemConfig
		-- Effective rarity respects forge-level overrides — a high-tier
		-- moonsteel sword forged by a master smith renders with the
		-- legendary palette even though CraftedLongsword's cfg.Rarity is
		-- still Uncommon.
		local effRarity = ItemsConfig.GetEffectiveRarity(itemConfig, entry.stack)
		local rarityColor = Rarities.RarityColors[effRarity] or PALETTE.ink

		local isSelected = slotScope:Computed(function(use)
			return use(SelectedInventoryUUID) == uuid
		end)

		local slot = slotScope:New('TextButton') {
			Name = uuid,
			Size = UDim2.fromScale(1, 0),
			AutoButtonColor = false,
			Text = '',
			BackgroundColor3 = slotScope:Computed(function(use)
				return use(isSelected) and PALETTE.accent or PALETTE.bg0
			end),
			BackgroundTransparency = slotScope:Computed(function(use)
				return use(isSelected) and 0.6 or 0.2
			end),
			BorderSizePixel = 0,
			LayoutOrder = entry.order,
			[Fusion.OnEvent('Activated')] = function()
				-- Clicking the currently-selected slot deselects (toggle).
				if peek(SelectedInventoryUUID) == uuid then
					SelectedInventoryUUID:set(nil)
				else
					SelectedInventoryUUID:set(uuid)
				end
			end,
			[Fusion.Children] = {
				slotScope:New('UIAspectRatioConstraint') { AspectRatio = 1 },
				slotScope:New('UIStroke') {
					Color = slotScope:Computed(function(use)
						return use(isSelected) and PALETTE.accent or rarityColor
					end),
					Transparency = slotScope:Computed(function(use)
						return use(isSelected) and 0 or 0.5
					end),
					Thickness = 1,
				},
				slotScope:New('ViewportFrame') {
					Name = 'Viewport',
					Size = UDim2.fromScale(1, 1),
					BackgroundTransparency = 1,
					Visible = itemConfig.Display and itemConfig.Display.Viewport ~= nil,
				},
				slotScope:New('TextLabel') {
					Name = 'Quantity',
					AnchorPoint = Vector2.new(1, 1),
					Position = UDim2.new(1, -4, 1, -2),
					Size = UDim2.fromOffset(40, 12),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = entry.qtyText,
					TextSize = 11,
					TextColor3 = PALETTE.ink,
					TextXAlignment = Enum.TextXAlignment.Right,
				},
				-- Equipped indicator — gold ★ in the top-left corner so
				-- equipped items are scannable at a glance across a
				-- crowded grid. Replaces the prior small 'E' badge.
				slotScope:New('TextLabel') {
					Name = 'Equipped',
					Position = UDim2.fromOffset(4, 2),
					Size = UDim2.fromOffset(14, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_DISPLAY,
					Text = entry.equipped and '\u{2605}' or '',  -- ★
					TextScaled = true,
					TextColor3 = PALETTE.gold,
					TextStrokeTransparency = 0.4,
					TextStrokeColor3 = PALETTE.bg0,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				-- Tier tag top-right.
				slotScope:New('TextLabel') {
					Name = 'Tier',
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, -4, 0, 2),
					Size = UDim2.fromOffset(28, 10),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = string.format('T%d', effRarity),
					TextSize = 9,
					TextColor3 = rarityColor,
					TextTransparency = 0.4,
					TextXAlignment = Enum.TextXAlignment.Right,
				},
			},
		}

		-- Populate viewport after parent/renderer resolves the ViewportFrame child
		task.defer(function()
			local vp = slot:FindFirstChild('Viewport')
			if vp and vp:IsA('ViewportFrame') then
				setupViewportModel(vp, itemConfig)
			end
		end)

		return slot
	end

	----------------------------------------------------------------------
	-- Category button (WEAPONS / ARMOR & GEAR / CONSUMABLE / MATERIALS)
	----------------------------------------------------------------------
	local function buildCategoryButton(btnScope, cat)
		local isActive = btnScope:Computed(function(use)
			return use(SelectedInventoryCategory) == cat.id
		end)
		local count = btnScope:Computed(function(use)
			local counts = countEntriesByCategory(use)
			return counts[cat.id] or 0
		end)
		return btnScope:New('TextButton') {
			Name = cat.id,
			AutoButtonColor = false,
			Text = '',
			Size = UDim2.fromOffset(0, 32),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = btnScope:Computed(function(use)
				return use(isActive) and PALETTE.accent or Color3.new(0, 0, 0)
			end),
			BackgroundTransparency = btnScope:Computed(function(use)
				return use(isActive) and 0.85 or 0.35
			end),
			BorderSizePixel = 0,
			[Fusion.OnEvent('Activated')] = function()
				SelectedInventoryCategory:set(cat.id)
				SelectedInventoryUUID:set(nil)
			end,
			[Fusion.Children] = {
				btnScope:New('UIStroke') {
					Color = PALETTE.accent,
					Transparency = btnScope:Computed(function(use) return use(isActive) and 0 or 0.7 end),
					Thickness = 1,
				},
				btnScope:New('UIPadding') {
					PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
					PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
				},
				btnScope:New('UIListLayout') {
					FillDirection = Enum.FillDirection.Horizontal,
					Padding = UDim.new(0, 8),
					VerticalAlignment = Enum.VerticalAlignment.Center,
					SortOrder = Enum.SortOrder.LayoutOrder,
				},
				btnScope:New('TextLabel') {
					LayoutOrder = 1,
					Size = UDim2.fromOffset(14, 20),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_DISPLAY, Text = cat.glyph, TextSize = 14,
					TextColor3 = btnScope:Computed(function(use)
						return use(isActive) and PALETTE.accent or PALETTE.ink
					end),
				},
				btnScope:New('TextLabel') {
					LayoutOrder = 2,
					Size = UDim2.fromOffset(0, 20),
					AutomaticSize = Enum.AutomaticSize.X,
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_UI, Text = cat.label, TextSize = 12,
					TextColor3 = btnScope:Computed(function(use)
						return use(isActive) and PALETTE.accent or PALETTE.ink
					end),
				},
				btnScope:New('TextLabel') {
					LayoutOrder = 3,
					Size = UDim2.fromOffset(24, 20),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = btnScope:Computed(function(use) return tostring(use(count)) end),
					TextSize = 10,
					TextColor3 = PALETTE.inkFaint,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
			},
		}
	end

	----------------------------------------------------------------------
	-- Detail pane — huge (hero card, sub-tabs, 4 sub-pages, floating tooltip,
	-- action bar). Kept as a single function because every part references
	-- the same `detailNode` Computed.
	----------------------------------------------------------------------
	local function buildInventoryDetail(detScope)
		local detailNode = detScope:Computed(function(use)
			use(DataVersion)
			local uuid = use(SelectedInventoryUUID)
			if not uuid then return nil end
			local data = Utils.getPlayerData()
			if not data then return nil end
			local stack, itemId = ItemsConfig.FindInventoryItemOfUUID(data.Inventory, uuid)
			if not stack or not itemId then return nil end
			local cfg = ItemsConfig.Items[itemId]
			if not cfg then return nil end
			-- Effective rarity — picks up forge override when set so the
			-- detail pane title block reads 'LEGENDARY' on a high-skill
			-- moonsteel craft instead of the base item's static tier.
			local effRarity = ItemsConfig.GetEffectiveRarity(cfg, stack)
			local rarityName = Rarities.RarityValues[effRarity] or 'Common'
			local rarityColor = Rarities.RarityColors[effRarity] or PALETTE.ink
			return {
				cfg = cfg, stack = stack, itemId = itemId,
				rarityName = rarityName, rarityColor = rarityColor,
			}
		end)

		local titleText = detScope:Computed(function(use)
			local n = use(detailNode)
			if not n then return 'No item selected' end
			return (n.cfg.Display and n.cfg.Display.Title and n.cfg.Display.Title.Text) or n.itemId
		end)
		local rarityText = detScope:Computed(function(use)
			local n = use(detailNode)
			return n and string.upper(n.rarityName) or ''
		end)
		local rarityColorV = detScope:Computed(function(use)
			local n = use(detailNode)
			return n and n.rarityColor or PALETTE.ink
		end)
		-- For CompanionCandy items, append a runtime-resolved line that
		-- names the player's currently-equipped companion. Falls back to
		-- "Equip a companion to feed candy." when no companion is set.
		-- The static config description ("...applies to your equipped
		-- companion.") still shows for context.
		local CompanionsShared = ReplicatedModules.Services.CompanionsShared
		local CompanionsConfig = ReplicatedModules.Data.Companions
		local descText = detScope:Computed(function(use)
			local n = use(detailNode)
			if not n then return '' end
			local base = (n.cfg.Display and n.cfg.Display.Description and n.cfg.Display.Description.Text) or ''
			if n.cfg.Type == 'CompanionCandy' then
				use(DataVersion)
				local data = Utils.getPlayerData()
				local equipped = CompanionsShared and CompanionsShared.GetEquippedId(data) or nil
				local cfg = equipped and CompanionsConfig and CompanionsConfig.Companions[equipped] or nil
				local companionName = cfg and cfg.Display.Name or equipped
				if companionName then
					base = base .. string.format(
						'\n\n→ Will be fed to: %s', tostring(companionName))
				else
					base = base .. '\n\n→ Equip a companion to feed candy.'
				end
			end
			return base
		end)

		-- Stats as 2-col cards. Reference: tabs.jsx InventoryDetail stat grid.
		local statList = detScope:New('Frame') {
			LayoutOrder = 20,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				detScope:New('UIGridLayout') {
					CellSize = UDim2.new(0.5, -3, 0, 36),
					CellPadding = UDim2.fromOffset(6, 6),
					SortOrder = Enum.SortOrder.LayoutOrder,
					HorizontalAlignment = Enum.HorizontalAlignment.Left,
				},
				detScope:ForPairs(
					detScope:Computed(function(use)
						local n = use(detailNode)
						-- Schema migration: derive a Stats-shaped table
						-- from the new EquipmentData/WeaponUsage fields
						-- so this loop stays unchanged.
						-- Pass the stack through so SummarizeWeaponStats can
						-- substitute Composition.Forged.StatSnapshot.Damage
						-- (Stage D) and add Enchants/Resonance rows when set.
						local stats = n and CombatUtility.SummarizeWeaponStats(n.cfg, n.stack) or {}
						local out = {}
						local idx = 0
						for statName, statValue in stats do
							idx += 1
							table.insert(out, { order = idx, name = statName, value = tostring(statValue) })
						end
						return out
					end),
					function(use, innerScope, idx, entry)
						return idx, innerScope:New('Frame') {
							LayoutOrder = entry.order,
							BackgroundColor3 = Color3.new(0, 0, 0),
							BackgroundTransparency = 0.35,
							BorderSizePixel = 0,
							[Fusion.Children] = {
								innerScope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.8, Thickness = 1 },
								innerScope:New('UIPadding') {
									PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
									PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
								},
								innerScope:New('TextLabel') {
									Size = UDim2.new(1, 0, 0, 10),
									BackgroundTransparency = 1,
									FontFace = HUDCommon.FONT_MONO,
									Text = string.upper(entry.name), TextSize = 9,
									TextColor3 = PALETTE.inkFaint,
									TextXAlignment = Enum.TextXAlignment.Left,
								},
								innerScope:New('TextLabel') {
									Position = UDim2.fromOffset(0, 12),
									Size = UDim2.new(1, 0, 0, 16),
									BackgroundTransparency = 1,
									FontFace = HUDCommon.FONT_MONO,
									Text = entry.value, TextSize = 14,
									TextColor3 = PALETTE.accent,
									TextXAlignment = Enum.TextXAlignment.Left,
								},
							},
						}
					end
				),
			},
		}

		-- Derived: which sub-slot index (1=left, 2=right, ...) the
		-- selected item is currently in, or nil if not equipped.
		-- Reads BOTH `uuid` and `UUID` for legacy save compatibility.
		local equippedSlotIndex = detScope:Computed(function(use)
			use(DataVersion)
			local uuid = use(SelectedInventoryUUID)
			if not uuid then return nil end
			local data = Utils.getPlayerData()
			if not data or not data.Equipped then return nil end
			for _, slotEntry in data.Equipped do
				if typeof(slotEntry) == 'table' then
					local entryUuid = slotEntry.uuid or slotEntry.UUID
					if entryUuid == uuid then
						return slotEntry.slot or 1
					end
				end
			end
			return nil
		end)
		local isEquipped = detScope:Computed(function(use)
			return use(equippedSlotIndex) ~= nil
		end)

		-- Weapon-shape predicates. Used to gate the L/R two-button row
		-- (only shown for hand-slot weapons) and the dual-wield label.
		local isHandWeapon = detScope:Computed(function(use)
			local n = use(detailNode); if not n then return false end
			local equip = n.cfg.EquipmentData
			local first = equip and equip.EquipSlots and equip.EquipSlots[1]
			return (first and first.IndexMax and first.IndexMax > 1) and true or false
		end)
		local supportsDualWield = detScope:Computed(function(use)
			local n = use(detailNode); if not n then return false end
			local equip = n.cfg.EquipmentData
			local first = equip and equip.EquipSlots and equip.EquipSlots[1]
			return (first and first.AllowMultiEquip == true and (first.MaxMultiEquip or 0) > 1) and true or false
		end)
		-- Whether ANY currently-equipped weapon is non-dual-wield. The
		-- label warns the player that equipping a new weapon will
		-- auto-unequip the existing one(s) — matches the server-side
		-- eviction rule in PlayerInventoryServer.
		local hasNonDualEquipped = detScope:Computed(function(use)
			use(DataVersion)
			local data = Utils.getPlayerData()
			local eq = (data and data.Equipped) or {}
			for _, slotKey in { '1_Weapon', '2_Weapon' } do
				local entry = eq[slotKey]
				if typeof(entry) == 'table' then
					local cfgId = entry.itemId or entry.ItemId
					local cfg = cfgId and ItemsConfig.Items[cfgId]
					local first = cfg and cfg.EquipmentData and cfg.EquipmentData.EquipSlots
						and cfg.EquipmentData.EquipSlots[1]
					local isDual = first and first.AllowMultiEquip == true and (first.MaxMultiEquip or 0) > 1
					if not isDual then return true end
				end
			end
			return false
		end)

		-- Hotbar accepts only Food / Potion items (per design: skills +
		-- potions + food). The server-side gate in
		-- ClientPersistenceServer.SetHotbarSlot enforces the same rule;
		-- this is the matching client-side predicate so the SET HOTBAR
		-- SLOT button only shows where it'd actually succeed.
		local canBindToHotbar = detScope:Computed(function(use)
			local n = use(detailNode); if not n then return false end
			local cfg = n.cfg
			return ItemsConfig.HasTag(cfg, ItemsConfig.ItemTags.Food)
				or ItemsConfig.HasTag(cfg, ItemsConfig.ItemTags.Potion)
		end)

		-- Whether the selected item is consumable (USE button visible).
		-- The new schema marks consumables via ConsumptionData; ActivationData
		-- (companion candies, return stones, future activatables) routes
		-- through the same UseItem path.
		local canUse = detScope:Computed(function(use)
			local n = use(detailNode); if not n then return false end
			if n.cfg.ConsumptionData then return true end
			if n.cfg.ActivationData  then return true end
			return false
		end)

		-- Whether the selected item can be equipped — only items with
		-- EquipmentData show the EQUIP button. Pure materials, pure
		-- consumables, candies, etc. all hide it. Resolves the
		-- "materials are non-equippable" requirement at the UI layer
		-- (the server would reject the remote anyway, but hiding the
		-- button is the right UX).
		local canEquip = detScope:Computed(function(use)
			local n = use(detailNode); if not n then return false end
			return n.cfg.EquipmentData ~= nil
		end)

		-- Action bar — vertical stack:
		--   Row 1 (button row): EQUIP/UNEQUIP variants, USE, SET HOTBAR SLOT.
		--     For hand-slot weapons: EQUIP LEFT + EQUIP RIGHT (two buttons,
		--     each flips to UNEQUIP X when this uuid sits in that slot,
		--     and HIDES the opposite button when this uuid is equipped on
		--     one side — clicking the visible one unequips, freeing the
		--     opposite to re-appear).
		--     For non-weapon equippables: a single EQUIP/UNEQUIP button.
		--   Row 2 (label): "Supports dual-wield" / "Single-wield only" +
		--     a warning when an existing equipped weapon would be evicted.
		--     Visible only for hand-slot weapons (no value for armor).
		local function makeEquipButton(layoutOrder, slotIndex: number, sideLabel: string)
			-- Per-side button. `slotIndex` is 1 (left) or 2 (right). The
			-- button is visible when the item is a hand-slot weapon AND
			-- the OPPOSITE side doesn't currently hold this uuid.
			return detScope:New('TextButton') {
				LayoutOrder = layoutOrder,
				AutoButtonColor = false,
				BackgroundColor3 = PALETTE.accent,
				BackgroundTransparency = 0.78,
				BorderSizePixel = 0,
				Size = detScope:Computed(function(use)
					return use(canBindToHotbar)
						and UDim2.new(0.325, -3, 1, 0)  -- (0.65 - hotbarBtn)/2
						or UDim2.new(0.5, -3, 1, 0)
				end),
				Visible = detScope:Computed(function(use)
					if not use(isHandWeapon) then return false end
					-- Hide this side when the OTHER side holds this uuid.
					local cur = use(equippedSlotIndex)
					return cur ~= (slotIndex == 1 and 2 or 1)
				end),
				Text = '',
				[Fusion.OnEvent('Activated')] = function()
					local uuid = peek(SelectedInventoryUUID); if not uuid then return end
					-- Always fire with this side's slotIndex. Server's
					-- IsPlayerItemEquipped check routes to unequip when
					-- the uuid is already in any slot — same toggle
					-- semantics as before.
					InventoryEvent:FireServer(uuid, slotIndex)
				end,
				[Fusion.Children] = {
					detScope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0, Thickness = 1 },
					detScope:New('TextLabel') {
						Size = UDim2.fromScale(1, 1),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_UI,
						Text = detScope:Computed(function(use)
							local cur = use(equippedSlotIndex)
							if cur == slotIndex then
								return 'UNEQUIP ' .. sideLabel
							end
							return 'EQUIP ' .. sideLabel
						end),
						TextSize = 12,
						TextColor3 = PALETTE.accent,
					},
				},
			}
		end

		-- Single EQUIP/UNEQUIP for non-hand-weapon equippables. Same
		-- shape as the prior single-button version, just gated on
		-- `not isHandWeapon` so it doesn't double up with the L/R row.
		local singleEquipButton = detScope:New('TextButton') {
			LayoutOrder = 0,
			AutoButtonColor = false,
			BackgroundColor3 = PALETTE.accent,
			BackgroundTransparency = 0.78,
			BorderSizePixel = 0,
			Visible = detScope:Computed(function(use)
				return use(canEquip) and not use(isHandWeapon)
			end),
			Size = detScope:Computed(function(use)
				return use(canBindToHotbar)
					and UDim2.new(0.65, -3, 1, 0)
					or UDim2.fromScale(1, 1)
			end),
			Text = '',
			[Fusion.OnEvent('Activated')] = function()
				local uuid = peek(SelectedInventoryUUID); if not uuid then return end
				InventoryEvent:FireServer(uuid, 1)
			end,
			[Fusion.Children] = {
				detScope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0, Thickness = 1 },
				detScope:New('TextLabel') {
					Size = UDim2.fromScale(1, 1),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_UI,
					Text = detScope:Computed(function(use)
						return use(isEquipped) and 'UNEQUIP' or 'EQUIP'
					end),
					TextSize = 12,
					TextColor3 = PALETTE.accent,
				},
			},
		}

		-- Dual-wield support label. Reads the selected item's spec +
		-- whether anything currently equipped will block multi-equip.
		local dualLabelText = detScope:Computed(function(use)
			if not use(isHandWeapon) then return '' end
			if not use(supportsDualWield) then
				return 'This weapon does NOT support dual-wield · equipping it will unequip your current weapon(s)'
			end
			if use(hasNonDualEquipped) then
				return 'Supports dual-wield · existing non-dual weapon(s) will be unequipped on equip'
			end
			return 'Supports dual-wield · can be held in either or both hands'
		end)
		local dualLabelColor = detScope:Computed(function(use)
			if use(supportsDualWield) and not use(hasNonDualEquipped) then
				return PALETTE.accent
			end
			return PALETTE.gold
		end)

		local actionBar = detScope:New('Frame') {
			LayoutOrder = 90,
			Size = UDim2.new(1, 0, 0, 56),
			BackgroundTransparency = 1,
			Visible = detScope:Computed(function(use) return use(detailNode) ~= nil end),
			[Fusion.Children] = {
				detScope:New('UIListLayout') {
					FillDirection = Enum.FillDirection.Vertical,
					Padding = UDim.new(0, 4),
					SortOrder = Enum.SortOrder.LayoutOrder,
				},
				-- // Row 1: button row. //
				detScope:New('Frame') {
					LayoutOrder = 1,
					Size = UDim2.new(1, 0, 0, 36),
					BackgroundTransparency = 1,
					[Fusion.Children] = {
						detScope:New('UIListLayout') {
							FillDirection = Enum.FillDirection.Horizontal,
							Padding = UDim.new(0, 6),
							SortOrder = Enum.SortOrder.LayoutOrder,
						},
						singleEquipButton,
						makeEquipButton(1, 1, 'LEFT'),
						makeEquipButton(2, 2, 'RIGHT'),
						-- USE — fires ItemUseEvent for consumable items.
						detScope:New('TextButton') {
							LayoutOrder = 3,
							AutoButtonColor = false,
							BackgroundColor3 = PALETTE.gold,
							BackgroundTransparency = 0.78,
							BorderSizePixel = 0,
							Size = UDim2.new(0.35, -3, 1, 0),
							Text = '',
							Visible = canUse,
							[Fusion.OnEvent('Activated')] = function()
								local uuid = peek(SelectedInventoryUUID); if not uuid then return end
								ItemUseEvent:FireServer(uuid)
							end,
							[Fusion.Children] = {
								detScope:New('UIStroke') { Color = PALETTE.gold, Transparency = 0, Thickness = 1 },
								detScope:New('TextLabel') {
									Size = UDim2.fromScale(1, 1),
									BackgroundTransparency = 1,
									FontFace = HUDCommon.FONT_UI,
									Text = 'USE',
									TextSize = 12,
									TextColor3 = PALETTE.gold,
								},
							},
						},
						-- SET HOTBAR SLOT.
						detScope:New('TextButton') {
							LayoutOrder = 4,
							AutoButtonColor = false,
							BackgroundColor3 = PALETTE.bg0,
							BackgroundTransparency = 0.4,
							BorderSizePixel = 0,
							Size = UDim2.new(0.35, -3, 1, 0),
							Text = '',
							Visible = canBindToHotbar,
							[Fusion.OnEvent('Activated')] = function()
								local n = peek(detailNode); if not n then return end
								local uuid = peek(SelectedInventoryUUID); if not uuid then return end
								local HotbarWidget = require(LocalPlayer:WaitForChild('PlayerScripts')
									:WaitForChild('Core'):WaitForChild('Widgets'):WaitForChild('HotbarWidget'))
								HotbarWidget.OpenSlotPicker(function(slotId)
									HotbarWidget.SetSlot(slotId, { type = 'item', uuid = uuid })
								end)
							end,
							[Fusion.Children] = {
								detScope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
								detScope:New('TextLabel') {
									Size = UDim2.fromScale(1, 1),
									BackgroundTransparency = 1,
									FontFace = HUDCommon.FONT_MONO,
									Text = 'SET HOTBAR SLOT',
									TextSize = 11,
									TextColor3 = PALETTE.accent,
								},
							},
						},
					},
				},
				-- // Row 2: dual-wield support label. //
				detScope:New('TextLabel') {
					LayoutOrder = 2,
					Size = UDim2.new(1, 0, 0, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = dualLabelText,
					TextSize = 10,
					TextColor3 = dualLabelColor,
					TextXAlignment = Enum.TextXAlignment.Left,
					Visible = isHandWeapon,
					TextWrapped = true,
				},
			},
		}

		-- Hero card — 140px region with rarity radial glow + ViewportFrame.
		-- LayoutOrder = 1 sits below the sub-tab row (0).
		local heroCard = detScope:New('Frame') {
			LayoutOrder = 1,
			Size = UDim2.new(1, 0, 0, 140),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
			[Fusion.Children] = {
				detScope:New('UIStroke') {
					Color = rarityColorV, Transparency = 0.5, Thickness = 1,
				},
				detScope:New('UIGradient') {
					Color = ColorSequence.new({
						ColorSequenceKeypoint.new(0, Color3.new(0, 0, 0)),
						ColorSequenceKeypoint.new(0.5, Color3.new(0.08, 0.08, 0.12)),
						ColorSequenceKeypoint.new(1, Color3.new(0, 0, 0)),
					}),
					Transparency = NumberSequence.new(0.4),
					Rotation = 90,
				},
				detScope:New('ViewportFrame') {
					Name = 'HeroViewport',
					Size = UDim2.fromScale(1, 1),
					BackgroundTransparency = 1,
					Visible = detScope:Computed(function(use) return use(detailNode) ~= nil end),
				},
				-- Eyebrow top-left: ◆ RARITY
				detScope:New('TextLabel') {
					Position = UDim2.fromOffset(10, 8),
					Size = UDim2.fromOffset(140, 10),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = detScope:Computed(function(use)
						local r = use(rarityText)
						return r ~= '' and ('◆ ' .. r) or ''
					end),
					TextSize = 9,
					TextColor3 = rarityColorV,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				-- Tier mono top-right
				detScope:New('TextLabel') {
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, -10, 0, 8),
					Size = UDim2.fromOffset(80, 10),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = detScope:Computed(function(use)
						local n = use(detailNode)
						if not n then return '' end
						return string.format('T%d', ItemsConfig.GetEffectiveRarity(n.cfg, n.stack))
					end),
					TextSize = 9,
					TextColor3 = rarityColorV,
					TextXAlignment = Enum.TextXAlignment.Right,
				},
				HUDCommon.cornerTick(detScope, 'tl', PALETTE.accent),
				HUDCommon.cornerTick(detScope, 'br', PALETTE.accent),
			},
		}

		-- Re-render the hero viewport whenever the selection changes.
		-- ClearViewport (vs ClearAllChildren) keeps the Camera around — we
		-- still reset the cached "Current" attribute so SetupModelViewport
		-- doesn't short-circuit on a stale match after the model is gone.
		detScope:Observer(detailNode):onChange(function()
			local vp = heroCard:FindFirstChild('HeroViewport') :: ViewportFrame?
			if not vp then return end
			ViewportUtility.ClearViewport(vp)
			vp:SetAttribute('Current', nil)
			local node = Fusion.peek(detailNode)
			if not node then return end
			setupViewportModel(vp, node.cfg)
		end)

		-- // Sub-tab row //
		local subTabButtons = {}
		for i, tabId in DETAIL_SUBTABS do
			local isActive = detScope:Computed(function(use)
				return use(SelectedInventoryDetailTab) == tabId
			end)
			table.insert(subTabButtons, detScope:New('TextButton') {
				Name = 'SubTab_' .. tabId,
				LayoutOrder = i,
				AutoButtonColor = false,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.new(0.25, 0, 1, 0),
				Text = '',
				[Fusion.OnEvent('Activated')] = function()
					SelectedInventoryDetailTab:set(tabId)
				end,
				[Fusion.Children] = {
					detScope:New('TextLabel') {
						Size = UDim2.fromScale(1, 1),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = DETAIL_SUBTAB_LABELS[tabId],
						TextSize = 11,
						TextColor3 = detScope:Computed(function(use)
							return use(isActive) and PALETTE.accent or PALETTE.inkDim
						end),
					},
					-- Underline stripe (visible when active).
					detScope:New('Frame') {
						AnchorPoint = Vector2.new(0.5, 1),
						Position = UDim2.fromScale(0.5, 1),
						Size = UDim2.new(0.7, 0, 0, 2),
						BackgroundColor3 = PALETTE.accent,
						BorderSizePixel = 0,
						Visible = isActive,
					},
				},
			})
		end

		-- Nested-frame split so the bottom accent border doesn't get swept
		-- into the UIListLayout's horizontal flow (a 100%-wide border would
		-- push every tab off-screen to the right — see phase-1 bug fix).
		local tabButtonStrip = detScope:New('Frame') {
			Name = 'TabButtonStrip',
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				detScope:New('UIListLayout') {
					FillDirection = Enum.FillDirection.Horizontal,
					SortOrder = Enum.SortOrder.LayoutOrder,
					HorizontalAlignment = Enum.HorizontalAlignment.Left,
					VerticalAlignment = Enum.VerticalAlignment.Center,
				},
				table.unpack(subTabButtons),
			},
		}
		local subTabRow = detScope:New('Frame') {
			LayoutOrder = 0,
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				tabButtonStrip,
				detScope:New('Frame') {
					Name = 'BottomBorder',
					AnchorPoint = Vector2.new(0, 1),
					Position = UDim2.fromScale(0, 1),
					Size = UDim2.new(1, 0, 0, 1),
					BackgroundColor3 = PALETTE.accent,
					BackgroundTransparency = 0.78,
					BorderSizePixel = 0,
					ZIndex = 0,
				},
			},
		}

		-- // Modifiers chip row (OVERVIEW page) //
		-- Reads live from Composition.Forged.Modifiers when present;
		-- otherwise falls back to BonusTraits from the StatSnapshot
		-- (material trait flags). Empty when neither is set.
		local ModifiersConfig = ReplicatedModules.Data.Modifiers
		local modifierChipsRow = detScope:ForPairs(
			detScope:Computed(function(use)
				local n = use(detailNode)
				if not n or not n.stack or not n.stack.Composition then return {} end
				local forged = n.stack.Composition.Forged
				if not forged then return {} end
				local out = {}
				if typeof(forged.Modifiers) == 'table' then
					for i, m in forged.Modifiers do
						local cfg = ModifiersConfig.Modifiers[m.id]
						if cfg then
							table.insert(out, {
								order = i,
								label = string.format('%s ×%d', cfg.Name, m.level or 1),
								color = cfg.Color,
							})
						end
					end
				end
				if typeof(forged.StatSnapshot) == 'table'
					and typeof(forged.StatSnapshot.BonusTraits) == 'table' then
					for j, trait in forged.StatSnapshot.BonusTraits do
						table.insert(out, {
							order = 100 + j,  -- traits sort after modifiers
							label = trait,
							color = PALETTE.violet,
						})
					end
				end
				return out
			end),
			function(_use, innerScope, idx, chip)
				return idx, innerScope:New('Frame') {
					LayoutOrder = chip.order,
					Size = UDim2.fromOffset(0, 22),
					AutomaticSize = Enum.AutomaticSize.X,
					BackgroundColor3 = PALETTE.bg0,
					BackgroundTransparency = 0.2,
					BorderSizePixel = 0,
					[Fusion.Children] = {
						innerScope:New('UIStroke') { Color = chip.color, Transparency = 0.6, Thickness = 1 },
						innerScope:New('UIPadding') {
							PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
						},
						innerScope:New('TextLabel') {
							Size = UDim2.fromScale(0, 1),
							AutomaticSize = Enum.AutomaticSize.X,
							BackgroundTransparency = 1,
							FontFace = HUDCommon.FONT_UI,
							Text = chip.label,
							TextSize = 11,
							TextColor3 = PALETTE.ink,
						},
					},
				}
			end
		)
		local modifierRow = detScope:New('Frame') {
			Name = 'Modifiers',
			LayoutOrder = 30,
			Size = UDim2.new(1, 0, 0, 44),
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				detScope:New('UIListLayout') {
					FillDirection = Enum.FillDirection.Vertical,
					Padding = UDim.new(0, 4),
					SortOrder = Enum.SortOrder.LayoutOrder,
				},
				detScope:New('TextLabel') {
					LayoutOrder = 1,
					Size = UDim2.new(1, 0, 0, 12),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = '◆ MODIFIERS',
					TextSize = 10,
					TextColor3 = PALETTE.accent,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				detScope:New('Frame') {
					LayoutOrder = 2,
					Size = UDim2.new(1, 0, 0, 24),
					BackgroundTransparency = 1,
					[Fusion.Children] = {
						detScope:New('UIListLayout') {
							FillDirection = Enum.FillDirection.Horizontal,
							Padding = UDim.new(0, 6),
							SortOrder = Enum.SortOrder.LayoutOrder,
						},
						modifierChipsRow,
					},
				},
			},
		}

		-- // OVERVIEW page //
		local overviewPage = detScope:New('Frame') {
			Name = 'OverviewPage',
			LayoutOrder = 10,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Visible = detScope:Computed(function(use)
				return use(SelectedInventoryDetailTab) == 'overview'
					and use(detailNode) ~= nil
			end),
			[Fusion.Children] = {
				detScope:New('UIListLayout') {
					Padding = UDim.new(0, 8),
					SortOrder = Enum.SortOrder.LayoutOrder,
				},
				-- Flavor description (italicized-ish via the display font).
				detScope:New('TextLabel') {
					LayoutOrder = 10,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_DISPLAY,
					Text = descText,
					TextSize = 13,
					TextColor3 = PALETTE.inkDim,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextYAlignment = Enum.TextYAlignment.Top,
					TextWrapped = true,
				},
				(function() statList.LayoutOrder = 20; return statList end)(),
				modifierRow,
				-- "CAN BE OBTAINED FROM" row. Hidden when the cfg has no
				-- Sources tagged so non-authored items don't show an
				-- empty section. Reads `cfg.Sources` (array of
				-- ItemSources enum values), maps each to its display
				-- label, and joins with a middle-dot separator.
				detScope:New('Frame') {
					LayoutOrder = 30,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					BackgroundTransparency = 1,
					Visible = detScope:Computed(function(use)
						local n = use(detailNode); if not n then return false end
						local sources = n.cfg.Sources
						return typeof(sources) == 'table' and #sources > 0
					end),
					[Fusion.Children] = {
						detScope:New('UIListLayout') {
							FillDirection = Enum.FillDirection.Vertical,
							Padding = UDim.new(0, 2),
							SortOrder = Enum.SortOrder.LayoutOrder,
						},
						detScope:New('TextLabel') {
							LayoutOrder = 1,
							Size = UDim2.new(1, 0, 0, 12),
							BackgroundTransparency = 1,
							FontFace = HUDCommon.FONT_MONO,
							Text = '\u{25C6} CAN BE OBTAINED FROM',
							TextSize = 10,
							TextColor3 = PALETTE.accent,
							TextXAlignment = Enum.TextXAlignment.Left,
						},
						detScope:New('TextLabel') {
							LayoutOrder = 2,
							Size = UDim2.new(1, 0, 0, 0),
							AutomaticSize = Enum.AutomaticSize.Y,
							BackgroundTransparency = 1,
							FontFace = HUDCommon.FONT_UI,
							TextSize = 12,
							TextColor3 = PALETTE.inkDim,
							TextXAlignment = Enum.TextXAlignment.Left,
							TextYAlignment = Enum.TextYAlignment.Top,
							TextWrapped = true,
							Text = detScope:Computed(function(use)
								local n = use(detailNode); if not n then return '' end
								local sources = n.cfg.Sources
								if typeof(sources) ~= 'table' then return '' end
								local labels = {}
								for _, srcId in sources do
									local label = ItemsConfig.ItemSourceLabels[srcId]
									if label then labels[#labels + 1] = label end
								end
								return table.concat(labels, ' \u{B7} ')  -- · separator
							end),
						},
					},
				},
			},
		}

		-- // FORGE page — components list + floating cursor-tracking tooltip //
		local HoveredComponent = detScope:Value(nil)
		local hoveredLabelText = detScope:Computed(function(use)
			local k = use(HoveredComponent)
			if not k then return 'Hover a part to see its effect.' end
			for _, c in FORGE_COMPONENTS do
				if c.key == k then return c.tooltip end
			end
			return ''
		end)
		local HoverMousePos = detScope:Value(Vector2.zero)

		local componentRows = {}
		for i, comp in FORGE_COMPONENTS do
			table.insert(componentRows, detScope:New('TextButton') {
				Name = 'Comp_' .. comp.key,
				LayoutOrder = i,
				Size = UDim2.new(1, 0, 0, 44),
				AutoButtonColor = false,
				Text = '',
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.25,
				BorderSizePixel = 0,
				[Fusion.OnEvent('MouseEnter')] = function()
					HoveredComponent:set(comp.key)
				end,
				[Fusion.OnEvent('MouseMoved')] = function(x: number, y: number)
					HoverMousePos:set(Vector2.new(x, y))
				end,
				[Fusion.OnEvent('MouseLeave')] = function()
					if Fusion.peek(HoveredComponent) == comp.key then
						HoveredComponent:set(nil)
					end
				end,
				[Fusion.Children] = {
					detScope:New('UIStroke') { Color = comp.tint, Transparency = 0.55, Thickness = 1 },
					detScope:New('UIPadding') {
						PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
						PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
					},
					-- Material swatch (pixel square, tinted by material).
					detScope:New('Frame') {
						AnchorPoint = Vector2.new(0, 0.5),
						Position = UDim2.fromScale(0, 0.5),
						Size = UDim2.fromOffset(22, 22),
						BackgroundColor3 = comp.tint,
						BorderSizePixel = 0,
						[Fusion.Children] = {
							detScope:New('UIStroke') { Color = comp.tint, Transparency = 0.1, Thickness = 1 },
						},
					},
					detScope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0),
						Position = UDim2.fromOffset(32, 2),
						Size = UDim2.new(1, -112, 0, 10),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = comp.label, TextSize = 9,
						TextColor3 = PALETTE.inkFaint,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					detScope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0),
						Position = UDim2.fromOffset(32, 14),
						Size = UDim2.new(1, -112, 0, 14),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_UI,
						Text = comp.material, TextSize = 13,
						TextColor3 = comp.tint,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					-- Bonus stat, right-aligned.
					detScope:New('TextLabel') {
						AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.new(1, 0, 0.5, 0),
						Size = UDim2.fromOffset(96, 16),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = comp.bonus, TextSize = 11,
						TextColor3 = PALETTE.accent,
						TextXAlignment = Enum.TextXAlignment.Right,
					},
				},
			})
		end

		local forgeBackBtn = detScope:New('TextButton') {
			LayoutOrder = 1,
			Size = UDim2.new(1, 0, 0, 28),
			AutoButtonColor = false,
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = 0.4,
			BorderSizePixel = 0,
			FontFace = HUDCommon.FONT_MONO,
			Text = '◂  BACK TO OVERVIEW',
			TextSize = 11,
			TextColor3 = PALETTE.inkDim,
			TextXAlignment = Enum.TextXAlignment.Left,
			[Fusion.OnEvent('Activated')] = function()
				SelectedInventoryDetailTab:set('overview')
			end,
			[Fusion.Children] = {
				detScope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.78, Thickness = 1 },
				detScope:New('UIPadding') {
					PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
				},
			},
		}
		local forgeEyebrow = detScope:New('TextLabel') {
			LayoutOrder = 2,
			Size = UDim2.new(1, 0, 0, 14),
			BackgroundTransparency = 1,
			FontFace = HUDCommon.FONT_MONO,
			Text = '◆ FORGE COMPONENTS',
			TextSize = 10,
			TextColor3 = PALETTE.accent,
			TextXAlignment = Enum.TextXAlignment.Left,
		}
		local forgeComponentsScroll = detScope:New('ScrollingFrame') {
			Name = 'ForgeComponentsScroll',
			LayoutOrder = 3,
			Size = UDim2.new(1, 0, 1, -54),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			CanvasSize = UDim2.fromScale(0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = PALETTE.accent,
			ElasticBehavior = Enum.ElasticBehavior.Never,
			[Fusion.Children] = {
				detScope:New('UIListLayout') {
					Padding = UDim.new(0, 4),
					SortOrder = Enum.SortOrder.LayoutOrder,
				},
				detScope:New('UIPadding') { PaddingRight = UDim.new(0, 6) },
				table.unpack(componentRows),
			},
		}

		local forgePage = detScope:New('Frame') {
			Name = 'ForgePage',
			LayoutOrder = 10,
			Size = UDim2.new(1, 0, 1, -240),
			BackgroundTransparency = 1,
			Visible = detScope:Computed(function(use)
				return use(SelectedInventoryDetailTab) == 'forge'
					and use(detailNode) ~= nil
			end),
			[Fusion.Children] = {
				detScope:New('UIListLayout') {
					Padding = UDim.new(0, 6),
					SortOrder = Enum.SortOrder.LayoutOrder,
				},
				forgeBackBtn,
				forgeEyebrow,
				forgeComponentsScroll,
			},
		}

		-- GEMS / ENCHANTS — live Composition views (Stage E of ARTISAN.md).
		-- Read-only: editing happens at the workstation widgets. Falls
		-- back to a "no <system> applied yet" hint when the selected
		-- item has no Composition.<sub-table>.

		-- Lazy catalog requires (placed inline so they're scoped to this
		-- builder rather than module-load time — keeps the upper file
		-- imports clean).
		local EnchantsConfig = ReplicatedModules.Data.Enchants
		local GemsConfig     = ReplicatedModules.Data.Gems
		local EnchantShared  = ReplicatedModules.Services.EnchantShared

		-- Builds a list of {label, valueText} rows for a Composition
		-- sub-system. Returns nil when the sub-table is missing —
		-- caller renders an empty-state hint.
		local function getEnchantRows(node)
			if not node or not node.stack or not node.stack.Composition then return nil end
			local entries = (node.stack.Composition.Enchants and node.stack.Composition.Enchants.Entries) or {}
			if #entries == 0 then return {} end
			local rows = {}
			for _, e in entries do
				local cfg = EnchantsConfig.Enchants[e.Id]
				local name = (cfg and cfg.Name) or e.Id
				local desc = EnchantShared.FormatDescription(e.Id, e.Level or 1)
				table.insert(rows, {
					label = string.format('%s · LV %d', name, e.Level or 1),
					value = desc,
					color = (cfg and cfg.Color) or PALETTE.accent,
				})
			end
			return rows
		end

		local function getSocketRows(node)
			if not node or not node.stack or not node.stack.Composition then return nil end
			local socketing = node.stack.Composition.Socketing
			if not socketing or typeof(socketing.Slots) ~= 'table' then return {} end
			local rows = {}
			for i, slot in socketing.Slots do
				local label = string.format('Socket %d (%s)', i, tostring(slot.Color or 'any'))
				local valueText = '— empty —'
				local valueColor = PALETTE.inkFaint
				if slot.GemUuid then
					-- Resolve gem name via inventory + catalog. Mirrors
					-- the GemSocketServer.makeGemLookup path on the client.
					local data = Utils.getPlayerData()
					local gemStack, gemItemId = data and ItemsConfig.FindInventoryItemOfUUID(data.Inventory or {}, slot.GemUuid)
					if gemItemId then
						local cfg = ItemsConfig.Items[gemItemId]
						local meta = ItemsConfig.GetGem(cfg)
						local gemCfg = meta and GemsConfig.Gems[meta.Id]
						if gemCfg then
							valueText = gemCfg.Name
							valueColor = gemCfg.Color
						end
					end
				end
				table.insert(rows, { label = label, value = valueText, color = valueColor })
			end
			-- Resonance row at the end.
			if socketing.ResonanceBonus and socketing.ResonanceBonus.Active then
				local rb = socketing.ResonanceBonus
				table.insert(rows, {
					label = 'RESONANCE',
					value = string.format('%s ×%.2f', tostring(rb.Active), rb.Multiplier or 1),
					color = PALETTE.gold,
				})
			end
			return rows
		end

		-- Generic "list of label/value rows OR empty-state hint" page.
		-- Both gems and enchants share this shape — passing a different
		-- row provider + empty-state hint per page.
		local function buildCompositionPage(pageId, emptyHint, rowsProvider)
			return detScope:New('Frame') {
				Name = pageId .. 'Page',
				LayoutOrder = 10,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				Visible = detScope:Computed(function(use)
					return use(SelectedInventoryDetailTab) == pageId
						and use(detailNode) ~= nil
				end),
				[Fusion.Children] = {
					detScope:New('UIListLayout') {
						Padding = UDim.new(0, 4),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					detScope:ForPairs(
						detScope:Computed(function(use)
							local n = use(detailNode)
							local rows = rowsProvider(n)
							if rows == nil then return {} end
							if #rows == 0 then
								return { { order = 1, label = '', value = emptyHint, color = PALETTE.inkFaint } }
							end
							for i, r in rows do r.order = i end
							return rows
						end),
						function(_use, innerScope, idx, row)
							return idx, innerScope:New('Frame') {
								LayoutOrder = row.order,
								Size = UDim2.new(1, 0, 0, 32),
								BackgroundColor3 = Color3.new(0, 0, 0),
								BackgroundTransparency = 0.4,
								BorderSizePixel = 0,
								[Fusion.Children] = {
									innerScope:New('UIStroke') { Color = row.color, Transparency = 0.55, Thickness = 1 },
									innerScope:New('UIPadding') {
										PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
									},
									innerScope:New('TextLabel') {
										Size = UDim2.new(0.45, 0, 1, 0),
										BackgroundTransparency = 1,
										FontFace = HUDCommon.FONT_MONO,
										Text = row.label, TextSize = 11,
										TextColor3 = PALETTE.inkFaint,
										TextXAlignment = Enum.TextXAlignment.Left,
									},
									innerScope:New('TextLabel') {
										AnchorPoint = Vector2.new(1, 0),
										Position = UDim2.new(1, 0, 0, 0),
										Size = UDim2.new(0.55, 0, 1, 0),
										BackgroundTransparency = 1,
										FontFace = HUDCommon.FONT_UI,
										Text = row.value, TextSize = 12,
										TextColor3 = row.color,
										TextXAlignment = Enum.TextXAlignment.Right,
										TextTruncate = Enum.TextTruncate.AtEnd,
									},
								},
							}
						end
					),
				},
			}
		end

		local gemsPage     = buildCompositionPage('gems',     '◆ No gems socketed.',  getSocketRows)
		local enchantsPage = buildCompositionPage('enchants', '◆ No enchants applied.', getEnchantRows)

		-- Action bar hides when on the FORGE sub-tab (which has its own back
		-- button). `Hydrate` layers this visibility on top of the existing
		-- "hide when no selection" binding inside `actionBar`.
		local actionBarVisible = detScope:Computed(function(use)
			if use(detailNode) == nil then return false end
			if use(SelectedInventoryDetailTab) == 'forge' then return false end
			-- Hide the strip entirely when no action button is visible
			-- (pure material, no use/equip/hotbar affordance) — otherwise
			-- a 36 px empty bar shows.
			return use(canEquip) or use(canUse) or use(canBindToHotbar)
		end)
		detScope:Hydrate(actionBar) { Visible = actionBarVisible }

		-- // Floating tooltip //
		-- Parented to the panel ROOT (outside the children UIListLayout), so
		-- its explicit Position is honored. Subtracts GuiInset from mouse Y
		-- because MouseMoved delivers inset-INCLUDED coords while
		-- AbsolutePosition (with IgnoreGuiInset=true) is inset-EXCLUDED —
		-- without the subtraction the tooltip would float ~36 px below the
		-- cursor on desktop.
		local tooltipFrame
		tooltipFrame = detScope:New('Frame') {
			Name = 'ForgeTooltip',
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = 0.1,
			BorderSizePixel = 0,
			ZIndex = 50,
			AnchorPoint = Vector2.new(0, 0),
			Position = detScope:Computed(function(use)
				local mouse = use(HoverMousePos)
				local parentAbs = tooltipFrame
					and tooltipFrame.Parent
					and (tooltipFrame.Parent :: GuiObject).AbsolutePosition
					or Vector2.zero
				local topbarInset = GuiService:GetGuiInset()
				local x = mouse.X - parentAbs.X - topbarInset.X + 4
				local y = mouse.Y - parentAbs.Y - topbarInset.Y + 30
				return UDim2.fromOffset(math.floor(x), math.floor(y))
			end),
			Size = UDim2.fromOffset(220, 60),
			AutomaticSize = Enum.AutomaticSize.Y,
			Visible = detScope:Computed(function(use)
				return use(HoveredComponent) ~= nil
			end),
			[Fusion.Children] = {
				detScope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
				detScope:New('UIPadding') {
					PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
					PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
				},
				detScope:New('TextLabel') {
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_UI,
					Text = hoveredLabelText,
					TextSize = 12,
					TextColor3 = PALETTE.ink,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextYAlignment = Enum.TextYAlignment.Top,
					TextWrapped = true,
				},
			},
		}

		local panel = HUDCommon.chiseledPanel(detScope, {
			Name = 'Detail',
			Size = UDim2.fromScale(1, 1),
			AccentColor = PALETTE.accent,
			Children = {
				detScope:New('UIPadding') {
					PaddingTop    = UDim.new(0, 16),
					PaddingBottom = UDim.new(0, 16),
					PaddingLeft   = UDim.new(0, 16),
					PaddingRight  = UDim.new(0, 16),
				},
				detScope:New('UIListLayout') {
					Padding = UDim.new(0, 8),
					SortOrder = Enum.SortOrder.LayoutOrder,
				},
				heroCard,
				detScope:New('TextLabel') {
					Name = 'Title',
					LayoutOrder = 1,
					Size = UDim2.new(1, 0, 0, 28),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_DISPLAY,
					Text = titleText,
					TextSize = 22,
					TextColor3 = rarityColorV,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
				},
				detScope:New('TextLabel') {
					Name = 'TypeLine',
					LayoutOrder = 2,
					Size = UDim2.new(1, 0, 0, 12),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = detScope:Computed(function(use)
						local n = use(detailNode)
						if not n then return '' end
						-- Schema migration: derive type label from the
						-- presence of EquipmentData / ConsumptionData /
						-- ActivationData (the flat `Type` field is gone).
						local t = CombatUtility.GetItemTypeLabel(n.cfg)
						return string.upper(tostring(t)) .. ' · ' .. string.upper(n.rarityName or '')
					end),
					TextSize = 10,
					TextColor3 = PALETTE.inkFaint,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				-- Sub-tabs only render when an item is selected.
				(function()
					detScope:Hydrate(subTabRow) {
						Visible = detScope:Computed(function(use)
							return use(detailNode) ~= nil
						end),
					}
					return subTabRow
				end)(),
				overviewPage,
				forgePage,
				gemsPage,
				enchantsPage,
				(function() actionBar.LayoutOrder = 90; return actionBar end)(),
			},
		})

		-- Parent the floating tooltip to the panel ROOT (outside the inner
		-- children wrapper where UIListLayout would override its Position).
		tooltipFrame.Parent = panel

		return panel
	end

	----------------------------------------------------------------------
	-- Tab shell
	----------------------------------------------------------------------

	-- Two category rows: primary (item buckets) and secondary (embedded
	-- mount/companion/aura tabs). Both flow horizontally inside their own
	-- UIListLayout-driven frame so each fills the leftColumn's width.
	local function buildCategoryRowFrame(categories)
		return scope:New('Frame') {
			Size = UDim2.new(1, 0, 0, 32),
			BackgroundTransparency = 1,
			[Fusion.Children] = (function()
				local kids = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Horizontal,
						Padding = UDim.new(0, 4),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
				}
				for i, cat in categories do
					local btn = buildCategoryButton(scope, cat)
					btn.LayoutOrder = i
					table.insert(kids, btn)
				end
				return kids
			end)(),
		}
	end
	local primaryCategoryRow   = buildCategoryRowFrame(INVENTORY_PRIMARY_CATEGORIES)
	local secondaryCategoryRow = buildCategoryRowFrame(INVENTORY_SECONDARY_CATEGORIES)

	-- Filter row — full-width TextBox that fills the leftColumn (same
	-- width as gridScroll below). Sits between the category rows and
	-- the slot-header count line. Hidden when an embedded category is
	-- active since each embedded tab has its own filter chips.
	local filterRow = scope:New('TextBox') {
		Name = 'FilterBox',
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.4,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		FontFace = HUDCommon.FONT_MONO,
		PlaceholderText = '⌕  filter inventory...',
		PlaceholderColor3 = PALETTE.inkFaint,
		Text = '',
		TextSize = 12,
		TextColor3 = PALETTE.ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		[Fusion.OnChange('Text')] = function(newText: string)
			InventoryFilterText:set(newText or '')
		end,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.6, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 10),
			},
		},
	}

	local slotHeader = scope:New('TextLabel') {
		Size = UDim2.new(1, 0, 0, 14),
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_MONO,
		Text = scope:Computed(function(use)
			local cat = use(SelectedInventoryCategory)
			local counts = countEntriesByCategory(use)
			local catLabel = 'INVENTORY'
			-- Scan both rows (primary item buckets + secondary embedded
			-- categories) so the header still shows the right label when
			-- the user is on a mounts/companions/auras tab.
			for _, c in INVENTORY_PRIMARY_CATEGORIES do
				if c.id == cat then catLabel = c.label; break end
			end
			for _, c in INVENTORY_SECONDARY_CATEGORIES do
				if c.id == cat then catLabel = c.label; break end
			end
			-- Inventory is unlimited — show a "SLOTS USED" count.
			local n = counts[cat] or 0
			return string.format('◆ %s · %d SLOT%s USED', catLabel, n, n == 1 and '' or 'S')
		end),
		TextSize = 10,
		TextColor3 = PALETTE.accent,
		TextXAlignment = Enum.TextXAlignment.Left,
	}

	-- gridScroll height accounting (everything in leftColumn above it):
	--   primary cat row (32) + gap (10)
	--   secondary cat row (32) + gap (10)
	--   filter row (32) + gap (10)
	--   slot header (14) + gap (10)
	--   = 150 px. Express as a constant so adding/removing a row above
	--   only requires updating one line.
	local GRID_TOP_INSET = 32 + 10 + 32 + 10 + 32 + 10 + 14 + 10  -- = 150
	local gridScroll = scope:New('ScrollingFrame') {
		Name = 'Grid',
		Size = UDim2.new(1, 0, 1, -GRID_TOP_INSET),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.fromScale(0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = PALETTE.accent,
		LayoutOrder = 5,
		[Fusion.Children] = {
			scope:New('UIGridLayout') {
				CellSize = UDim2.fromOffset(64, 64),
				CellPadding = UDim2.fromOffset(4, 4),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:ForPairs(
				scope:Computed(function(use)
					return computeInventoryEntries(use, {
						filterCat  = use(SelectedInventoryCategory),
						filterText = use(InventoryFilterText),
					})
				end),
				function(use, innerScope, idx, entry)
					return entry.uuid, buildInventorySlot(innerScope, entry)
				end
			),
		},
	}

	-- Visible-gate the items-grid + detail pane on whether the
	-- selected category is a normal inventory bucket. When the player
	-- selects MOUNTS / COMPANIONS / AURAS, the items grid + detail
	-- pane hide and the embedded tab takes over the area below the
	-- category row.
	local isItemCategory = scope:Computed(function(use)
		return not EMBEDDED_CATEGORIES[use(SelectedInventoryCategory)]
	end)
	local isMountsCategory = scope:Computed(function(use)
		return use(SelectedInventoryCategory) == 'mounts'
	end)
	local isCompanionsCategory = scope:Computed(function(use)
		return use(SelectedInventoryCategory) == 'companions'
	end)
	local isAurasCategory = scope:Computed(function(use)
		return use(SelectedInventoryCategory) == 'auras'
	end)

	-- Both category rows always render (the user always has access to
	-- switch). The filter row, slotHeader, and gridScroll all hide when
	-- an embedded category is active — embedded tabs own their own
	-- filter chips + content area.
	scope:Hydrate(filterRow)  { Visible = isItemCategory }
	scope:Hydrate(slotHeader) { Visible = isItemCategory }
	scope:Hydrate(gridScroll) { Visible = isItemCategory }

	local leftColumn = scope:New('Frame') {
		Name = 'Left',
		Size = UDim2.fromScale((DESIGN_W - RIGHT_COL_PX - IMPLICIT_GAP_PX) / DESIGN_W, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder },
			(function() primaryCategoryRow.LayoutOrder   = 1; return primaryCategoryRow   end)(),
			(function() secondaryCategoryRow.LayoutOrder = 2; return secondaryCategoryRow end)(),
			(function() filterRow.LayoutOrder            = 3; return filterRow            end)(),
			(function() slotHeader.LayoutOrder           = 4; return slotHeader           end)(),
			gridScroll,
		},
	}

	-- ctx.embedded = true suppresses each tab's outer padding so it doesn't
	-- compound with InventoryTab's.
	local embedCtx = setmetatable({ embedded = true }, { __index = ctx })
	local mountsContent     = MountsTab.Build(embedCtx)
	local companionsContent = CompanionsTab.Build(embedCtx)
	local aurasContent      = AurasTab.Build(embedCtx)

	-- Embed sits below both category rows: 32 + 10 + 32 + 10 = 84 px inset.
	local EMBED_TOP_INSET  = 32 + 10 + 32 + 10
	local embedTopScale    = EMBED_TOP_INSET / DESIGN_H
	local embedHeightScale = 1 - embedTopScale
	local embedCenterY     = embedTopScale + embedHeightScale / 2
	local function wrapEmbed(frame, visibleBinding)
		frame.Name = 'EmbeddedTab'
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.Position = UDim2.fromScale(0.5, embedCenterY)
		frame.Size = UDim2.fromScale(1, embedHeightScale)
		scope:Hydrate(frame) { Visible = visibleBinding }
		return frame
	end

	return scope:New('Frame') {
		Name = 'InventoryTab',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(24 / OUTER_H, 0),
				PaddingBottom = UDim.new(24 / OUTER_H, 0),
				PaddingLeft   = UDim.new(32 / OUTER_W, 0),
				PaddingRight  = UDim.new(32 / OUTER_W, 0),
			},
			leftColumn,
			-- Right detail pane only visible when on an item category.
			scope:New('Frame') {
				Name = 'Right',
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, 0, 0, 0),
				Size = UDim2.fromScale(RIGHT_COL_PX / DESIGN_W, 1),
				BackgroundTransparency = 1,
				Visible = isItemCategory,
				[Fusion.Children] = { buildInventoryDetail(scope) },
			},
			-- Embedded mount/companion/aura overlay panes.
			wrapEmbed(mountsContent,     isMountsCategory),
			wrapEmbed(companionsContent, isCompanionsCategory),
			wrapEmbed(aurasContent,      isAurasCategory),
		},
	}
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/TabWidget/AttributesTab"><![CDATA[-- // TabWidget/AttributesTab.luau //
-- Grid of every attribute defined in `ReplicatedModules.Data.Attributes`.
-- Each card shows the attribute name, the player's current level / max,
-- the bonus that level grants (via `cfg.GetBonus`), and the XP required
-- for the NEXT level (via `cfg.GetExpForLevel`).
--
-- Data sources:
--   * AttributesConfig.Attributes — `{[id] = AttributeData}`. Drives the
--     full set of cards (the config is the canonical roster — players
--     just have *progress* on this set; they don't gain or lose entries).
--   * PlayerData.Attributes — `{[id] = level}` (per AttributeServer.luau
--     write path). Drives the level / progress readouts. Missing entries
--     are treated as level 0.
--
-- Layout: ScrollingFrame with AutomaticCanvasSize.Y, UIGridLayout cells.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local GuiService = game:GetService('GuiService')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local AttributesConfig = ReplicatedModules.Data.Attributes

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local Utils = require(script.Parent.utils)

local Module = {}

----------------------------------------------------------------------
-- Cell renderer — one card per attribute id.
-- Each cell is reactive: the level / bonus / next-level XP rows are
-- Computeds keyed off `ctx.DataVersion`, so server-driven attribute
-- changes propagate without a tab rebuild.
----------------------------------------------------------------------
local function buildAttributeCard(scope, ctx, attrId: string, attrCfg, hover)
	local DataVersion = ctx.DataVersion
	local HoveredAttributeId = hover.HoveredAttributeId
	local HoverMousePos      = hover.HoverMousePos

	-- Read this attribute's level out of PlayerData on every DataVersion
	-- bump. AttributeServer writes `saveData.Attributes[id] = {Level, Experience}`,
	-- but the old point-spend path could store a bare number — handle both
	-- shapes so a schema in flight doesn't crash the renderer.
	local levelComputed = scope:Computed(function(use)
		use(DataVersion)
		local data = Utils.getPlayerData()
		local entry = data and data.Attributes and data.Attributes[attrId]
		if typeof(entry) == 'number' then return entry end
		if typeof(entry) == 'table' and tonumber(entry.Level) then return entry.Level end
		return 0
	end)

	-- Per-level XP and progress toward the *next* level. The XP-only path
	-- is now the canonical one — read entry.Experience for the bar fill.
	local xpComputed = scope:Computed(function(use)
		use(DataVersion)
		local data = Utils.getPlayerData()
		local entry = data and data.Attributes and data.Attributes[attrId]
		if typeof(entry) == 'table' and tonumber(entry.Experience) then
			return entry.Experience
		end
		return 0
	end)

	local levelText = scope:Computed(function(use)
		return string.format('LV %d / %d', use(levelComputed), attrCfg.MaxLevel or 0)
	end)

	local bonusText = scope:Computed(function(use)
		local lvl = use(levelComputed)
		if typeof(attrCfg.GetBonus) ~= 'function' then return '—' end
		local ok, bonus = pcall(attrCfg.GetBonus, lvl)
		if not ok or bonus == nil then return '—' end
		return string.format('+%s', tostring(bonus))
	end)

	-- Progress fraction for the bar = XP toward the *next* level, since
	-- attributes now grow purely by XP (no point-spend). At max level the
	-- bar is full.
	local progressFrac = scope:Computed(function(use)
		local lvl = use(levelComputed)
		local xp  = use(xpComputed)
		local maxLvl = attrCfg.MaxLevel or 0
		if lvl >= maxLvl then return 1 end
		if typeof(attrCfg.GetExpForLevel) ~= 'function' then return 0 end
		local ok, required = pcall(attrCfg.GetExpForLevel, lvl + 1)
		if not ok or typeof(required) ~= 'number' or required <= 0 then return 0 end
		return math.clamp(xp / required, 0, 1)
	end)

	return scope:New('Frame') {
		Name = 'Attribute_' .. attrId,
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		-- Hover wiring — populates the panel-level HoveredAttributeId so
		-- the shared floating tooltip resolves which description to show.
		-- MouseLeave guards against stale state by only clearing when the
		-- current hover is still us (otherwise a fast diagonal swipe over
		-- another card could leave the tooltip stuck on this one).
		[Fusion.OnEvent('MouseEnter')] = function()
			HoveredAttributeId:set(attrId)
		end,
		[Fusion.OnEvent('MouseMoved')] = function(x: number, y: number)
			HoverMousePos:set(Vector2.new(x, y))
		end,
		[Fusion.OnEvent('MouseLeave')] = function()
			if Fusion.peek(HoveredAttributeId) == attrId then
				HoveredAttributeId:set(nil)
			end
		end,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.6, Thickness = 1 },
			-- Padding in scale so the card breathes proportionally inside
			-- whatever cell the UIGridLayout hands it. The horizontal pad is
			-- a touch larger than the vertical pad — matches the visual
			-- feel of the InventoryTab card baseline. Y total budget:
			-- 0.06 + 0.24 + 0.03 + 0.14 + 0.03 + 0.05 + 0.03 + 0.14 + 0.03
			-- + 0.14 + 0.06 = 0.95 — leaves 5% headroom inside the cell.
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(0.06, 0), PaddingBottom = UDim.new(0.06, 0),
				PaddingLeft   = UDim.new(0.05, 0), PaddingRight  = UDim.new(0.05, 0),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0.03, 0),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- Display name (display font). Promoted to LayoutOrder 1 — the
			-- "◆ ATTRIBUTE" eyebrow is gone (the Attributes tab title above
			-- the grid already says what these are), so the name leads each
			-- card. TextScaled so the name fills the row at any scale.
			scope:New('TextLabel') {
				LayoutOrder = 1,
				Size = UDim2.fromScale(1, 0.24),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_BUTTON,
				Text = attrId,
				TextScaled = true,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
			},
			-- Level row (mono).
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.fromScale(1, 0.14),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = levelText,
				TextScaled = true,
				TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			-- Progress bar.
			scope:New('Frame') {
				LayoutOrder = 3,
				Size = UDim2.fromScale(1, 0.05),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.35,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.7, Thickness = 1 },
					scope:New('Frame') {
						Name = 'Fill',
						Size = scope:Computed(function(use)
							return UDim2.fromScale(use(progressFrac), 1)
						end),
						BackgroundColor3 = PALETTE.accent,
						BorderSizePixel = 0,
					},
				},
			},
			-- Bonus row.
			scope:New('Frame') {
				LayoutOrder = 4,
				Size = UDim2.fromScale(1, 0.14),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0),
						Position = UDim2.fromScale(0, 0),
						Size = UDim2.fromScale(0.5, 1),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = '◆ BONUS',
						TextScaled = true,
						TextColor3 = PALETTE.inkFaint,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					scope:New('TextLabel') {
						AnchorPoint = Vector2.new(1, 0),
						Position = UDim2.fromScale(1, 0),
						Size = UDim2.fromScale(0.5, 1),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = bonusText,
						TextScaled = true,
						TextColor3 = PALETTE.ink,
						TextXAlignment = Enum.TextXAlignment.Right,
					},
				},
			},
			-- Progress row — promoted directly under Bonus now that the
			-- "NEXT LEVEL · NN XP" row is gone. The threshold it conveyed
			-- was already encoded in this row's "current / required XP"
			-- readout, so the row was redundant.
			scope:New('Frame') {
				LayoutOrder = 5,
				Size = UDim2.fromScale(1, 0.14),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0),
						Position = UDim2.fromScale(0, 0),
						Size = UDim2.fromScale(0.5, 1),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = '◆ PROGRESS',
						TextScaled = true,
						TextColor3 = PALETTE.inkFaint,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					scope:New('TextLabel') {
						AnchorPoint = Vector2.new(1, 0),
						Position = UDim2.fromScale(1, 0),
						Size = UDim2.fromScale(0.5, 1),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = scope:Computed(function(use)
							local lvl = use(levelComputed)
							if lvl >= (attrCfg.MaxLevel or 0) then return 'MAX' end
							local xp = use(xpComputed)
							if typeof(attrCfg.GetExpForLevel) ~= 'function' then
								return tostring(xp)
							end
							local ok, required = pcall(attrCfg.GetExpForLevel, lvl + 1)
							if not ok or typeof(required) ~= 'number' then
								return tostring(xp)
							end
							return string.format('%d / %d XP', xp, required)
						end),
						TextScaled = true,
						TextColor3 = PALETTE.ink,
						TextXAlignment = Enum.TextXAlignment.Right,
					},
				},
			},
		},
	}
end

----------------------------------------------------------------------
-- Build(ctx)
----------------------------------------------------------------------
function Module.Build(ctx)
	local scope = ctx.scope
	local DataVersion = ctx.DataVersion

	-- // Tooltip state //
	-- Single shared tooltip — every card writes to these values on hover.
	-- HoveredAttributeId resolves which description the tooltip displays;
	-- HoverMousePos drives its cursor-tracking position. Same pattern as
	-- the InventoryTab forge tooltip (see TabWidget/InventoryTab.luau).
	local HoveredAttributeId = scope:Value(nil :: string?)
	local HoverMousePos      = scope:Value(Vector2.zero)
	local hoverCtx = { HoveredAttributeId = HoveredAttributeId, HoverMousePos = HoverMousePos }

	-- Sort attribute ids alphabetically — `pairs()` order over the config
	-- dict isn't stable, and the user wants a predictable list.
	local sortedIds: {string} = {}
	for id in AttributesConfig.Attributes do
		table.insert(sortedIds, id)
	end
	table.sort(sortedIds)

	-- Build cards once at construction time. The roster is fixed for the
	-- session (config is static), so we don't need a Computed here — just
	-- a vanilla array of children. The reactive bits are inside each card.
	local cards = {}
	for i, attrId in sortedIds do
		local card = buildAttributeCard(scope, ctx, attrId, AttributesConfig.Attributes[attrId], hoverCtx)
		card.LayoutOrder = i
		table.insert(cards, card)
	end

	-- Eyebrow + count line, mirrors the convention used by InventoryTab.
	local headerLine = scope:New('TextLabel') {
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 14),
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_MONO,
		Text = scope:Computed(function(use)
			use(DataVersion)
			local data = Utils.getPlayerData()
			local owned = 0
			if data and typeof(data.Attributes) == 'table' then
				for _ in data.Attributes do owned += 1 end
			end
			return string.format(
				'◆ ATTRIBUTES · %d / %d UNLOCKED',
				owned, #sortedIds
			)
		end),
		TextSize = 11,
		TextColor3 = PALETTE.accent,
		TextXAlignment = Enum.TextXAlignment.Left,
	}

	-- Grid scroll. Fills remaining vertical space below the eyebrow +
	-- title (~64 px combined, mirrors SettingsTab's pattern) so the
	-- ScrollingFrame's frame is FIXED height — necessary for scrolling
	-- to engage when the canvas grows past the visible area. The
	-- previous AutomaticSize.Y on the frame let it grow with its
	-- content, which kept canvas == frame and meant scrolling never
	-- triggered no matter how many cards appeared.
	-- AutomaticCanvasSize.Y = the canvas auto-grows from the
	-- UIGridLayout's natural row count; UIGridLayout drives the wrap +
	-- cell footprint.
	local gridScroll = scope:New('ScrollingFrame') {
		LayoutOrder = 3,
		Size = UDim2.new(1, 0, 1, -64),   -- width fills, height fills below header + title
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.fromScale(0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = PALETTE.accent,
		ScrollBarImageTransparency = 0.4,
		ElasticBehavior = Enum.ElasticBehavior.Never,
		[Fusion.Children] = {
			scope:New('UIPadding') { PaddingRight = UDim.new(0, 6) },
			scope:New('UIGridLayout') {
				CellSize = UDim2.fromOffset(280, 150),
				CellPadding = UDim2.fromOffset(10, 10),
				HorizontalAlignment = Enum.HorizontalAlignment.Left,
				StartCorner = Enum.StartCorner.TopLeft,
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			table.unpack(cards),
		},
	}

	-- // Floating tooltip //
	-- Parented to the master ScreenGui (deferred until after Build returns
	-- — see below). Lives outside the tab's UIListLayout so the explicit
	-- AnchorPoint + Position drive freely. The master ScreenGui has
	-- IgnoreGuiInset = true and the parent container is full-screen at
	-- AbsolutePosition (0, 0), so the position math is just
	-- `mouse - GuiInset + offset` (no parentAbs subtraction).
	--
	-- Size is fixed-pixel so it stays consistent across every screen
	-- resolution; the UIAspectRatioConstraint locks the shape defensively
	-- in case the size is ever switched to Scale-based for HiDPI work.
	-- ZIndex 50 wins paint order under Sibling ZIndexBehavior.
	--
	-- Visibility is also gated on `tooltipFrame.Parent ~= nil`: until the
	-- deferred re-parenting completes the tooltip is detached, and we
	-- don't want to flash the prior parent's content. Once parented to
	-- the ScreenGui this never flips back to nil during the tab's life.
	-- Tooltip bumped from 280×92 → 320×112 so the larger title and body
	-- text don't get cramped or wrap awkwardly. Aspect ratio still locks
	-- the shape on every screen.
	local TOOLTIP_W, TOOLTIP_H = 320, 112
	local tooltipFrame
	tooltipFrame = scope:New('Frame') {
		Name = 'AttributeTooltip',
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		ZIndex = 50,
		AnchorPoint = Vector2.new(0, 0),
		Position = scope:Computed(function(use)
			local mouse = use(HoverMousePos)
			local topbarInset = GuiService:GetGuiInset()
			-- Cursor + small offset so the tooltip floats below-right of
			-- the pointer. Subtract topbar inset because MouseMoved
			-- delivers inset-included coords while the master ScreenGui
			-- (IgnoreGuiInset = true) is inset-excluded.
			local x = mouse.X - topbarInset.X + 14
			local y = mouse.Y - topbarInset.Y + 18
			return UDim2.fromOffset(math.floor(x), math.floor(y))
		end),
		Size = UDim2.fromOffset(TOOLTIP_W, TOOLTIP_H),
		Visible = scope:Computed(function(use)
			return use(HoveredAttributeId) ~= nil
		end),
		[Fusion.Children] = {
			scope:New('UIAspectRatioConstraint') {
				AspectRatio = TOOLTIP_W / TOOLTIP_H,
				AspectType = Enum.AspectType.FitWithinMaxSize,
				DominantAxis = Enum.DominantAxis.Width,
			},
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
				PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 4),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- Title row — the attribute id, in the display font, accent-tinted.
			scope:New('TextLabel') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 22),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_BUTTON,
				Text = scope:Computed(function(use)
					return tostring(use(HoveredAttributeId) or '')
				end),
				TextSize = 17,
				TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			-- Description body — wrapped to the fixed tooltip width.
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 1, -26),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = scope:Computed(function(use)
					local id = use(HoveredAttributeId)
					if not id then return '' end
					local cfg = AttributesConfig.Attributes[id]
					local desc = cfg and cfg.Description
					if typeof(desc) == 'string' and desc ~= '' then
						return desc
					end
					return 'No description available.'
				end),
				TextSize = 14,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
			},
		},
	}

	local root = scope:New('Frame') {
		Name = 'AttributesTab',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, 24), PaddingBottom = UDim.new(0, 24),
				PaddingLeft = UDim.new(0, 32), PaddingRight = UDim.new(0, 32),
			},
			scope:New('UIListLayout') {
				Padding = UDim.new(0, 10),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			headerLine,
			Utils.displayTitle(scope, { Text = 'Attributes', LayoutOrder = 2 }),
			gridScroll,
		},
	}

	-- Parent the tooltip to the master ScreenGui — NOT to the tab root —
	-- so it can move freely with the cursor across the entire screen
	-- regardless of the tab's content layout. Parenting under the tab
	-- root would also drag the tooltip into the root's UIListLayout flow
	-- (UIListLayout positions every child Frame regardless of explicit
	-- AnchorPoint/Position), pinning the tooltip to a single row slot.
	--
	-- Deferred because at this point in Build() the tab Frame has no
	-- parent yet — `init.luau` parents it to the panel content area only
	-- after this function returns. We poll briefly for the ScreenGui
	-- ancestor; once attached, the tooltip lives there for the tab's
	-- lifetime. Cleanup happens automatically when the Fusion scope is
	-- torn down (RootScope:doCleanup destroys every instance it owns).
	task.defer(function()
		local screenGui: Instance? = nil
		for _ = 1, 30 do  -- ~0.5s of frame waits, ample for init.luau parenting
			screenGui = root:FindFirstAncestorOfClass('ScreenGui')
			if screenGui then break end
			task.wait()
		end
		if screenGui then
			tooltipFrame.Parent = screenGui
		elseif root.Parent then
			-- Fall back to the tab root rather than leaving the tooltip
			-- orphaned — at least the description still surfaces, even
			-- if the position will be constrained by UIListLayout.
			tooltipFrame.Parent = root
		end
		-- Otherwise root has been destroyed (e.g. theme rebuild tore down the
		-- old TabWidget scope mid-poll) and Parent is locked at nil; bail
		-- silently. The tooltipFrame was already destroyed with the scope.
	end)

	return root
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/TabWidget/MountsTab"><![CDATA[-- // TabWidget/MountsTab.luau //
-- Mount browser. Two-column layout: left = grid of owned mounts (filterable
-- by Land/Flight), right = selected mount's stat readout + Equip/Dismount
-- button. Reads from PlayerData.Mounts via ReplicatedData.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local peek   = Fusion.peek

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local MountsShared = ReplicatedModules.Services.MountsShared
local MountsConfig = ReplicatedModules.Data.Mounts
local Utils = require(script.Parent.utils)

local Module = {}

-- 1394×648 outer canvas, 1330×600 inner after 32/24 UIPadding.
local OUTER_W, OUTER_H   = 1394, 648
local DESIGN_W, DESIGN_H = 1330, 600
local LEFT_COL_PX        = 320
local COL_GAP_PX         = 16

local KIND_LABELS = { all = 'All', land = 'Land', flight = 'Flight' }
local KINDS = { 'all', 'land', 'flight' }

local function getOwnedMountsList(saveData)
	local out = {}
	if typeof(saveData) ~= 'table' then return out end
	local owned = (saveData.Mounts and saveData.Mounts.OwnedMounts) or {}
	for mountId, _ in owned do
		local cfg = MountsConfig.Mounts[mountId]
		if cfg then
			table.insert(out, { id = mountId, cfg = cfg })
		end
	end
	table.sort(out, function(a, b)
		return (a.cfg.Display.Name or a.id) < (b.cfg.Display.Name or b.id)
	end)
	return out
end

function Module.Build(ctx)
	local scope = ctx.scope
	local DataVersion = ctx.DataVersion

	local SelectedMountId = scope:Value(nil :: string?)
	local KindFilter      = scope:Value('all')

	-- Left column: kind filter chips + owned grid.
	local kindChips = {}
	for i, kind in KINDS do
		local isActive = scope:Computed(function(use)
			return use(KindFilter) == kind
		end)
		table.insert(kindChips, scope:New('TextButton') {
			LayoutOrder = i,
			Size = UDim2.fromOffset(72, 26),
			BackgroundColor3 = scope:Computed(function(use)
				return use(isActive) and PALETTE.accent or PALETTE.bg0
			end),
			BackgroundTransparency = scope:Computed(function(use)
				return use(isActive) and 0.6 or 0.35
			end),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			FontFace = HUDCommon.FONT_MONO,
			Text = KIND_LABELS[kind],
			TextSize = 11,
			TextColor3 = scope:Computed(function(use)
				return use(isActive) and PALETTE.accentHot or PALETTE.ink
			end),
			[Fusion.OnEvent('Activated')] = function() KindFilter:set(kind) end,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.5, Thickness = 1 },
			},
		})
	end

	local mountsList = scope:ForPairs(
		scope:Computed(function(use)
			use(DataVersion)
			local data = Utils.getPlayerData()
			local list = getOwnedMountsList(data)
			local filter = use(KindFilter)
			local out = {}
			for _, entry in list do
				if filter == 'all' or entry.cfg.Kind == filter then
					table.insert(out, entry)
				end
			end
			return out
		end),
		function(use, innerScope, idx, entry)
			local isSelected = innerScope:Computed(function(use2)
				return use2(SelectedMountId) == entry.id
			end)
			return idx, innerScope:New('TextButton') {
				LayoutOrder = idx,
				Size = UDim2.new(1, 0, 0, 56),
				BackgroundColor3 = innerScope:Computed(function(use2)
					return use2(isSelected) and PALETTE.accent or PALETTE.bg0
				end),
				BackgroundTransparency = innerScope:Computed(function(use2)
					return use2(isSelected) and 0.6 or 0.4
				end),
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = '',
				[Fusion.OnEvent('Activated')] = function()
					SelectedMountId:set(entry.id)
				end,
				[Fusion.Children] = {
					innerScope:New('UIStroke') {
						Color = innerScope:Computed(function(use2)
							return use2(isSelected) and PALETTE.accentHot or PALETTE.accent
						end),
						Transparency = 0.55, Thickness = 1,
					},
					innerScope:New('UIPadding') {
						PaddingLeft  = UDim.new(0, 12),
						PaddingRight = UDim.new(0, 12),
					},
					innerScope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0.5),
						Position = UDim2.fromScale(0, 0.35),
						Size = UDim2.new(1, 0, 0, 18),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_DISPLAY,
						Text = entry.cfg.Display.Name or entry.id,
						TextSize = 16,
						TextColor3 = PALETTE.ink,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					innerScope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0.5),
						Position = UDim2.fromScale(0, 0.72),
						Size = UDim2.new(1, 0, 0, 14),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = string.upper(entry.cfg.Kind or '—'),
						TextSize = 11,
						TextColor3 = entry.cfg.Kind == 'flight' and PALETTE.violet or PALETTE.gold,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
				},
			}
		end
	)

	local leftColumn = scope:New('Frame') {
		Name = 'MountsLeft',
		LayoutOrder = 1,
		Size = UDim2.fromScale(LEFT_COL_PX / DESIGN_W, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			Utils.eyebrow(scope, '◆ MOUNTS', { LayoutOrder = 1 }),
			scope:New('Frame') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Horizontal,
						Padding = UDim.new(0, 6),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					table.unpack(kindChips),
				},
			},
			scope:New('ScrollingFrame') {
				LayoutOrder = 3,
				Size = UDim2.new(1, 0, 1, -76),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Active = true,
				ScrollingDirection = Enum.ScrollingDirection.Y,
				ScrollBarThickness = 4,
				ScrollBarImageColor3 = PALETTE.accent,
				CanvasSize = UDim2.fromOffset(0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ElasticBehavior = Enum.ElasticBehavior.Never,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding = UDim.new(0, 6),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					mountsList,
				},
			},
		},
	}

	-- Right column: selected mount detail + equip/dismount.
	local selectedCfg = scope:Computed(function(use)
		local id = use(SelectedMountId); if not id then return nil end
		return MountsConfig.Mounts[id]
	end)

	local equippedId = scope:Computed(function(use)
		use(DataVersion)
		local data = Utils.getPlayerData()
		return MountsShared.GetEquippedMountId(data)
	end)

	-- Equip/Unequip toggle text. Equip sets the active mount slot;
	-- Unequip clears it (server auto-dismounts if currently riding).
	-- Mount/Dismount is a separate button below.
	local equipButtonText = scope:Computed(function(use)
		local id = use(SelectedMountId); local eq = use(equippedId)
		if not id then return 'SELECT A MOUNT' end
		if eq == id then return 'UNEQUIP' end
		return 'EQUIP'
	end)

	-- Mount/Dismount lives on the hotbar (G key + on-screen button), not
	-- in this tab — the tab is for slot management. See HotbarWidget's
	-- mount utility button + MountsClient.AttemptToggleRide.

	local rightColumn = scope:New('Frame') {
		Name = 'MountsRight',
		LayoutOrder = 2,
		Size = UDim2.fromScale((DESIGN_W - LEFT_COL_PX - COL_GAP_PX) / DESIGN_W, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 10),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			Utils.eyebrow(scope, '◆ DETAIL', { LayoutOrder = 1 }),
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = scope:Computed(function(use)
					local cfg = use(selectedCfg)
					return cfg and (cfg.Display.Name or '—') or 'No mount selected'
				end),
				TextSize = 22,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				LayoutOrder = 3,
				Size = UDim2.new(1, 0, 0, 32),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = scope:Computed(function(use)
					local cfg = use(selectedCfg)
					return cfg and (cfg.Display.Description or '') or ''
				end),
				TextSize = 13,
				TextColor3 = PALETTE.inkDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
			},
			scope:New('TextLabel') {
				LayoutOrder = 4,
				Size = UDim2.new(1, 0, 0, 16),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					local cfg = use(selectedCfg); if not cfg then return '' end
					return string.format('SPEED %d · TURN %.1f · KIND %s',
						cfg.Stats.Speed, cfg.Stats.TurnRate, string.upper(cfg.Kind))
				end),
				TextSize = 11,
				TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextButton') {
				LayoutOrder = 5,
				Size = UDim2.new(0, 200, 0, 36),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.25,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				FontFace = HUDCommon.FONT_BUTTON,
				Text = equipButtonText,
				TextSize = 14,
				TextColor3 = PALETTE.ink,
				[Fusion.OnEvent('Activated')] = function()
					local Gameplay = require(LocalPlayer:WaitForChild('PlayerScripts')
						:WaitForChild('Core'):WaitForChild('Gameplay'))
					local MountsClient = Gameplay.MountsClient
					if not MountsClient then return end
					local id = peek(SelectedMountId); if not id then return end
					local eq = peek(equippedId)
					if eq == id then
						MountsClient.AttemptUnequip()
					else
						MountsClient.AttemptEquip(id)
					end
				end,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
				},
			},
		},
	}

	-- ctx.embedded suppresses the outer padding so this tab can be
	-- embedded inside another tab (InventoryTab) without compounding
	-- 24/32 padding on top of the host's existing 24/32.
	local children = {
		scope:New('UIListLayout') {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(COL_GAP_PX / DESIGN_W, 0),
			SortOrder = Enum.SortOrder.LayoutOrder,
		},
		leftColumn, rightColumn,
	}
	if not ctx.embedded then
		table.insert(children, 1, scope:New('UIPadding') {
			PaddingTop    = UDim.new(24 / OUTER_H, 0),
			PaddingBottom = UDim.new(24 / OUTER_H, 0),
			PaddingLeft   = UDim.new(32 / OUTER_W, 0),
			PaddingRight  = UDim.new(32 / OUTER_W, 0),
		})
	end
	return scope:New('Frame') {
		Name = 'MountsTab',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = children,
	}
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/TabWidget/CompanionsTab"><![CDATA[-- // TabWidget/CompanionsTab.luau //
-- Two-column companion panel:
--   left  — owned companions list (name, level, XP bar)
--   right — selected detail (name, element chip, XP bar with `XP / nextXP`,
--           benefits list, Equip/Unequip + Feed Candy buttons)

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local peek   = Fusion.peek

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local CompanionsShared = ReplicatedModules.Services.CompanionsShared
local CompanionsConfig = ReplicatedModules.Data.Companions
local Utils = require(script.Parent.utils)

local Module = {}

-- 1394×648 outer canvas, 1330×600 inner after 32/24 UIPadding.
local OUTER_W, OUTER_H   = 1394, 648
local DESIGN_W, DESIGN_H = 1330, 600
local LEFT_COL_PX        = 320
local COL_GAP_PX         = 16

local ELEMENT_COLORS = {
	fire    = Color3.fromRGB(255, 130, 90),
	water   = Color3.fromRGB(120, 200, 255),
	earth   = Color3.fromRGB(180, 230, 130),
	air     = Color3.fromRGB(220, 220, 240),
	arcane  = Color3.fromRGB(200, 140, 255),
}

local function listOwnedCompanions(saveData)
	local out = {}
	if typeof(saveData) ~= 'table' then return out end
	local owned = (saveData.Companions and saveData.Companions.Owned) or {}
	local i = 0
	for cid, entry in owned do
		local cfg = CompanionsConfig.Companions[cid]
		if cfg then
			i += 1
			table.insert(out, { order = i, id = cid, cfg = cfg, entry = entry })
		end
	end
	table.sort(out, function(a, b)
		return (a.cfg.Display.Name or a.id) < (b.cfg.Display.Name or b.id)
	end)
	return out
end

-- (Candy listing was a previous Companions-tab affordance — moved to the
-- Inventory tab's Use action. CompanionCandy items now flow through
-- ConsumptionServer.UseItem → CompanionsServer.UseCompanionCandy.)

function Module.Build(ctx)
	local scope = ctx.scope
	local DataVersion = ctx.DataVersion

	local SelectedId = scope:Value(nil :: string?)

	-- Left column: owned list.
	local listChildren = scope:ForPairs(
		scope:Computed(function(use)
			use(DataVersion)
			return listOwnedCompanions(Utils.getPlayerData())
		end),
		function(use, innerScope, _idx, entry)
			local isSelected = innerScope:Computed(function(use2)
				return use2(SelectedId) == entry.id
			end)
			-- Live "is this companion in an equipped slot?" lookup. Drives
			-- the gold ★ badge in the top-right of the row, mirroring the
			-- InventoryTab equipped-indicator pattern. Re-runs on every
			-- DataVersion bump so equip/unequip toggles the badge instantly.
			local isEquipped = innerScope:Computed(function(use2)
				use2(DataVersion)
				return CompanionsShared.IsCompanionEquipped(Utils.getPlayerData(), entry.id)
			end)
			local elementColor = ELEMENT_COLORS[entry.cfg.Element] or PALETTE.accent
			local lvl = (entry.entry and entry.entry.Level) or 1
			return entry.id, innerScope:New('TextButton') {
				LayoutOrder = entry.order,
				Size = UDim2.new(1, 0, 0, 56),
				BackgroundColor3 = innerScope:Computed(function(use2)
					return use2(isSelected) and elementColor or PALETTE.bg0
				end),
				BackgroundTransparency = innerScope:Computed(function(use2)
					return use2(isSelected) and 0.55 or 0.4
				end),
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = '',
				[Fusion.OnEvent('Activated')] = function() SelectedId:set(entry.id) end,
				[Fusion.Children] = {
					innerScope:New('UIStroke') {
						Color = innerScope:Computed(function(use2)
							return use2(isSelected) and PALETTE.accentHot or elementColor
						end),
						Transparency = 0.55, Thickness = 1,
					},
					innerScope:New('UIPadding') {
						PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
					},
					innerScope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0.5),
						Position = UDim2.fromScale(0, 0.32),
						Size = UDim2.new(1, 0, 0, 18),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_DISPLAY,
						Text = entry.cfg.Display.Name or entry.id,
						TextSize = 16,
						TextColor3 = PALETTE.ink,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					innerScope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0.5),
						Position = UDim2.fromScale(0, 0.74),
						Size = UDim2.new(1, 0, 0, 14),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = string.format('LVL %d · %s', lvl, string.upper(entry.cfg.Element)),
						TextSize = 11,
						TextColor3 = elementColor,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					-- Equipped indicator (gold ★) — same chrome as the
					-- InventoryTab slot badge. Visible only while this
					-- companion sits in an equipped slot; flips live on
					-- equip/unequip via the DataVersion-bumped Computed.
					innerScope:New('TextLabel') {
						Name = 'Equipped',
						AnchorPoint = Vector2.new(1, 0),
						Position = UDim2.new(1, -4, 0, 4),
						Size = UDim2.fromOffset(16, 16),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_DISPLAY,
						Text = innerScope:Computed(function(use2)
							return use2(isEquipped) and '\u{2605}' or ''
						end),
						TextScaled = true,
						TextColor3 = PALETTE.gold,
						TextStrokeColor3 = PALETTE.bg0,
						TextStrokeTransparency = 0.4,
						TextXAlignment = Enum.TextXAlignment.Right,
					},
				},
			}
		end
	)

	local leftColumn = scope:New('Frame') {
		LayoutOrder = 1,
		Size = UDim2.fromScale(LEFT_COL_PX / DESIGN_W, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- Eyebrow shows live "X/Y Equipped" so the player can read
			-- their slot count without diving into the detail pane.
			-- Bumps on DataVersion (PlayerData replication) so the
			-- count updates on equip/unequip and on cmdr changes to
			-- MaxEquipped.
			Utils.eyebrow(scope, scope:Computed(function(use)
				use(DataVersion)
				local data = Utils.getPlayerData()
				local count = CompanionsShared.GetEquippedCount(data)
				local maxEq = CompanionsShared.GetMaxEquipped(data)
				return string.format('\u{25C6} COMPANIONS — %d/%d EQUIPPED', count, maxEq)
			end), { LayoutOrder = 1 }),
			scope:New('ScrollingFrame') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 1, -36),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Active = true,
				ScrollBarThickness = 4,
				ScrollBarImageColor3 = PALETTE.accent,
				CanvasSize = UDim2.fromOffset(0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ElasticBehavior = Enum.ElasticBehavior.Never,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding = UDim.new(0, 6),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					listChildren,
				},
			},
		},
	}

	-- Right column derived state.
	local selectedEntry = scope:Computed(function(use)
		use(DataVersion)
		local id = use(SelectedId); if not id then return nil end
		local data = Utils.getPlayerData()
		local owned = (data and data.Companions and data.Companions.Owned) or {}
		local cfg = CompanionsConfig.Companions[id]
		if not cfg then return nil end
		return { id = id, cfg = cfg, entry = owned[id] }
	end)

	-- Single-id legacy lookup (kept for back-compat callers below) +
	-- a per-companion "is this equipped?" Computed driving the
	-- EQUIP/UNEQUIP toggle text on the right pane.
	local equippedId = scope:Computed(function(use)
		use(DataVersion)
		return CompanionsShared.GetEquippedId(Utils.getPlayerData())
	end)
	local selectedIsEquipped = scope:Computed(function(use)
		use(DataVersion)
		local sel = use(selectedEntry); if not sel then return false end
		return CompanionsShared.IsCompanionEquipped(Utils.getPlayerData(), sel.id)
	end)
	-- "Slots full" disables the EQUIP button — better UX than firing the
	-- TryEquip remote and watching it silently fail. UNEQUIP still works.
	local slotsFull = scope:Computed(function(use)
		use(DataVersion)
		local data = Utils.getPlayerData()
		return CompanionsShared.GetEquippedCount(data) >= CompanionsShared.GetMaxEquipped(data)
	end)

	-- Benefits list rendered as a Computed-driven Frame block.
	local benefitsBlock = scope:New('Frame') {
		LayoutOrder = 5,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 4),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:ForPairs(
				scope:Computed(function(use)
					local sel = use(selectedEntry)
					if not sel then return {} end
					local out = {}
					local lvl = (sel.entry and sel.entry.Level) or 1
					for i, b in sel.cfg.Benefits do
						table.insert(out, {
							order = i,
							atLevel = b.AtLevel,
							stat = b.Stat,
							bonus = b.Bonus,
							unlocked = lvl >= b.AtLevel,
						})
					end
					return out
				end),
				function(use, innerScope, _i, b)
					local color = b.unlocked and PALETTE.accent or PALETTE.inkFaint
					local label
					if typeof(b.bonus) == 'number' then
						label = string.format('Lv %d · %s +%.0f%%', b.atLevel, b.stat, b.bonus * 100)
					else
						label = string.format('Lv %d · %s · %s', b.atLevel, b.stat, tostring(b.bonus))
					end
					return b.order, innerScope:New('TextLabel') {
						LayoutOrder = b.order,
						Size = UDim2.new(1, 0, 0, 16),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = label,
						TextSize = 12,
						TextColor3 = color,
						TextXAlignment = Enum.TextXAlignment.Left,
					}
				end
			),
		},
	}

	-- Red "no companion equipped" warning. Visible only when nothing is
	-- equipped — points the player at the Equip flow + reminds them
	-- candy goes through Inventory → Use, not this tab any more.
	local noCompanionWarning = scope:New('TextLabel') {
		LayoutOrder = 7,
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_MONO,
		Text = 'No companion equipped — equip one to receive their benefits and to use Companion Candy from Inventory.',
		TextSize = 11,
		TextColor3 = Color3.fromRGB(220, 90, 100),
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Visible = scope:Computed(function(use)
			return use(equippedId) == nil
		end),
	}

	local rightColumn = scope:New('Frame') {
		LayoutOrder = 2,
		Size = UDim2.fromScale((DESIGN_W - LEFT_COL_PX - COL_GAP_PX) / DESIGN_W, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			Utils.eyebrow(scope, '◆ DETAIL', { LayoutOrder = 1 }),
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, 26),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = scope:Computed(function(use)
					local sel = use(selectedEntry)
					return sel and (sel.cfg.Display.Name or sel.id) or 'No companion selected'
				end),
				TextSize = 22,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				LayoutOrder = 3,
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = scope:Computed(function(use)
					local sel = use(selectedEntry)
					return sel and (sel.cfg.Display.Description or '') or ''
				end),
				TextSize = 13,
				TextColor3 = PALETTE.inkDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
			},
			scope:New('TextLabel') {
				LayoutOrder = 4,
				Size = UDim2.new(1, 0, 0, 16),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					local sel = use(selectedEntry)
					if not sel then return '' end
					local lvl = (sel.entry and sel.entry.Level) or 1
					local xp  = (sel.entry and sel.entry.XP) or 0
					local need = CompanionsShared.XPToNextLevel(sel.id, lvl)
					if need == 0 then
						return string.format('LVL %d · MAX', lvl)
					end
					return string.format('LVL %d · XP %d / %d', lvl, xp, need)
				end),
				TextSize = 12,
				TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			benefitsBlock,
			-- Buttons row.
			scope:New('Frame') {
				LayoutOrder = 6,
				Size = UDim2.new(1, 0, 0, 36),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Horizontal,
						Padding = UDim.new(0, 8),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					scope:New('TextButton') {
						LayoutOrder = 1,
						Size = UDim2.fromOffset(160, 36),
						BackgroundColor3 = PALETTE.bg0,
						-- Dim the button when slots are full AND the selected
						-- companion isn't already equipped — there's nothing
						-- it can do. Live UNEQUIP path stays opaque.
						BackgroundTransparency = scope:Computed(function(use)
							if use(selectedIsEquipped) then return 0.25 end
							return use(slotsFull) and 0.55 or 0.25
						end),
						BorderSizePixel = 0,
						AutoButtonColor = false,
						FontFace = HUDCommon.FONT_BUTTON,
						Text = scope:Computed(function(use)
							local sel = use(selectedEntry); if not sel then return 'EQUIP' end
							if use(selectedIsEquipped) then return 'UNEQUIP' end
							return use(slotsFull) and 'SLOTS FULL' or 'EQUIP'
						end),
						TextSize = 13,
						TextColor3 = PALETTE.ink,
						[Fusion.OnEvent('Activated')] = function()
							local sel = peek(selectedEntry); if not sel then return end
							local Gameplay = require(LocalPlayer:WaitForChild('PlayerScripts')
								:WaitForChild('Core'):WaitForChild('Gameplay'))
							local CompanionsClient = Gameplay.CompanionsClient
							if not CompanionsClient then return end
							-- Multi-equip: route by the live "is this equipped"
							-- check, not the legacy "first slot match". Pass
							-- the specific id to AttemptUnequip so multi-slot
							-- loadouts only drop THIS companion.
							if peek(selectedIsEquipped) then
								CompanionsClient.AttemptUnequip(sel.id)
							elseif not peek(slotsFull) then
								CompanionsClient.AttemptEquip(sel.id)
							end
						end,
						[Fusion.Children] = {
							scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
						},
					},
					-- DEBUG: Float / Walk toggle. Visible only when the
					-- selected companion's cfg has AllowWalkAndFloatBypass
					-- set (the four wisps + any future debug companions).
					-- Toggles the per-(player, companionId) preference;
					-- server validates the same flag before flipping.
					scope:New('TextButton') {
						LayoutOrder = 3,
						Size = UDim2.fromOffset(120, 36),
						BackgroundColor3 = PALETTE.bg0,
						BackgroundTransparency = 0.25,
						BorderSizePixel = 0,
						AutoButtonColor = false,
						Visible = scope:Computed(function(use)
							local sel = use(selectedEntry); if not sel then return false end
							return CompanionsShared.CanToggleMovementMode(sel.id)
						end),
						FontFace = HUDCommon.FONT_BUTTON,
						Text = scope:Computed(function(use)
							local sel = use(selectedEntry); if not sel then return '' end
							local data = Utils.getPlayerData()
							local mode = CompanionsShared.GetMovementMode(data, sel.id)
							return string.format('MODE · %s', string.upper(mode))
						end),
						TextSize = 11,
						TextColor3 = PALETTE.accent,
						[Fusion.OnEvent('Activated')] = function()
							local sel = peek(selectedEntry); if not sel then return end
							local Gameplay = require(LocalPlayer:WaitForChild('PlayerScripts')
								:WaitForChild('Core'):WaitForChild('Gameplay'))
							local CompanionsClient = Gameplay.CompanionsClient
							if not CompanionsClient then return end
							-- Two-state toggle on click. A "real" dropdown
							-- with multiple modes can replace this when a
							-- third mode (sit / hide) ships.
							local data = Utils.getPlayerData()
							local cur = CompanionsShared.GetMovementMode(data, sel.id)
							local next_ = (cur == 'walk') and 'float' or 'walk'
							CompanionsClient.SetMovementMode(sel.id, next_)
						end,
						[Fusion.Children] = {
							scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.55, Thickness = 1 },
						},
					},
				},
			},
			noCompanionWarning,
		},
	}

	-- ctx.embedded suppresses outer padding when this tab is embedded
	-- inside InventoryTab (already padded by the host).
	local children = {
		scope:New('UIListLayout') {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(COL_GAP_PX / DESIGN_W, 0),
			SortOrder = Enum.SortOrder.LayoutOrder,
		},
		leftColumn, rightColumn,
	}
	if not ctx.embedded then
		table.insert(children, 1, scope:New('UIPadding') {
			PaddingTop    = UDim.new(24 / OUTER_H, 0),
			PaddingBottom = UDim.new(24 / OUTER_H, 0),
			PaddingLeft   = UDim.new(32 / OUTER_W, 0),
			PaddingRight  = UDim.new(32 / OUTER_W, 0),
		})
	end
	return scope:New('Frame') {
		Name = 'CompanionsTab',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = children,
	}
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/TabWidget/CraftingTab"><![CDATA[-- // TabWidget/CraftingTab.luau //
-- Wizard101-style crafting panel.
--   left   — schools rail (Smithing/Tailoring/Alchemy/Cooking/Enchanting),
--            each row shows artisan rank + level + XP bar.
--   center — recipes for the active school, with locked rows greyed.
--   right  — selected recipe detail: output preview, reagent rows
--            ([icon] Iron Ore · 3 / 5 with red/green color), Craft button.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local peek   = Fusion.peek

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local CraftingShared = ReplicatedModules.Services.CraftingShared
local CraftingConfig = ReplicatedModules.Data.Crafting
local ItemsConfig    = ReplicatedModules.Data.Items
local RemoteService  = ReplicatedModules.Services.RemoteService

local Utils = require(script.Parent.utils)

local CraftingEvent = RemoteService.GetRemote('CraftingEvent', 'RemoteEvent', false)

local Module = {}

-- 1394×648 outer canvas, 1330×600 inner after 32/24 UIPadding. 3-col layout.
local OUTER_W, OUTER_H   = 1394, 648
local DESIGN_W, DESIGN_H = 1330, 600
local LEFT_COL_PX        = 260
local RIGHT_COL_PX       = 280
local COL_GAP_PX         = 16

local SCHOOL_ORDER = { 'Smithing', 'Tailoring', 'Alchemy', 'Cooking', 'Enchanting' }

local function listRecipesForSchool(schoolId: string)
	local out = {}
	for id, recipe in CraftingConfig.Recipes do
		if recipe.School == schoolId then
			table.insert(out, { id = id, recipe = recipe })
		end
	end
	table.sort(out, function(a, b)
		if a.recipe.RequiredLevel ~= b.recipe.RequiredLevel then
			return a.recipe.RequiredLevel < b.recipe.RequiredLevel
		end
		return a.id < b.id
	end)
	return out
end

local function itemDisplayName(itemId: string): string
	local cfg = ItemsConfig.Items[itemId]
	if cfg and cfg.Display and cfg.Display.Title and cfg.Display.Title.Text then
		return cfg.Display.Title.Text
	end
	return itemId
end

function Module.Build(ctx)
	local scope = ctx.scope
	local DataVersion = ctx.DataVersion

	local SelectedSchool = scope:Value('Smithing')
	local SelectedRecipe = scope:Value(nil :: string?)

	-- // LEFT — schools rail with rank + xp bar // --
	local schoolRows = {}
	for i, schoolId in SCHOOL_ORDER do
		local school = CraftingConfig.Schools[schoolId]
		if not school then continue end
		local isActive = scope:Computed(function(use)
			return use(SelectedSchool) == schoolId
		end)
		local rowText = scope:Computed(function(use)
			use(DataVersion)
			local data = Utils.getPlayerData()
			local lvl = CraftingShared.GetArtisanLevel(data, schoolId)
			local rank = CraftingShared.GetArtisanRank(lvl)
			return string.format('%s · %s · Lv %d', school.Display.Name, rank.Name, lvl)
		end)
		local xpFill = scope:Computed(function(use)
			use(DataVersion)
			local data = Utils.getPlayerData()
			local lvl = CraftingShared.GetArtisanLevel(data, schoolId)
			local xp  = CraftingShared.GetArtisanXP(data, schoolId)
			local need = CraftingShared.GetXPToNextLevel(schoolId, lvl)
			if need <= 0 then return 1 end
			return math.clamp(xp / need, 0, 1)
		end)
		local row = scope:New('TextButton') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 56),
			BackgroundColor3 = scope:Computed(function(use)
				return use(isActive) and school.Display.Color or PALETTE.bg0
			end),
			BackgroundTransparency = scope:Computed(function(use)
				return use(isActive) and 0.55 or 0.4
			end),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = '',
			[Fusion.OnEvent('Activated')] = function()
				SelectedSchool:set(schoolId)
				SelectedRecipe:set(nil)
			end,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = school.Display.Color, Transparency = 0.5, Thickness = 1 },
				scope:New('UIPadding') { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) },
				scope:New('TextLabel') {
					Size = UDim2.new(1, 0, 0, 18),
					Position = UDim2.fromOffset(0, 6),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_DISPLAY,
					Text = school.Display.Name,
					TextSize = 16,
					TextColor3 = PALETTE.ink,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('TextLabel') {
					Size = UDim2.new(1, 0, 0, 14),
					Position = UDim2.fromOffset(0, 26),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = rowText,
					TextSize = 11,
					TextColor3 = school.Display.Color,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				-- XP bar.
				scope:New('Frame') {
					AnchorPoint = Vector2.new(0, 1),
					Position = UDim2.new(0, 0, 1, -8),
					Size = UDim2.new(1, 0, 0, 4),
					BackgroundColor3 = PALETTE.bg0,
					BackgroundTransparency = 0.35,
					BorderSizePixel = 0,
					[Fusion.Children] = {
						scope:New('Frame') {
							Size = scope:Computed(function(use)
								return UDim2.fromScale(use(xpFill), 1)
							end),
							BackgroundColor3 = school.Display.Color,
							BorderSizePixel = 0,
						},
					},
				},
			},
		}
		table.insert(schoolRows, row)
	end

	local leftColumn = scope:New('Frame') {
		LayoutOrder = 1,
		Size = UDim2.fromScale(LEFT_COL_PX / DESIGN_W, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			Utils.eyebrow(scope, '◆ ARTISAN', { LayoutOrder = 1 }),
			table.unpack(schoolRows),
		},
	}

	-- // CENTER — recipes for active school // --
	-- Filtered through `IsRecipeUnlocked` so the player only sees
	-- recipes they've explicitly unlocked (via AutoUnlock seed,
	-- quest reward, drop, or the cmdr /unlockrecipe command). Recipes
	-- they don't own simply don't appear in the list at all.
	local recipeListChildren = scope:ForPairs(
		scope:Computed(function(use)
			use(DataVersion)
			local data = Utils.getPlayerData()
			local schoolId = use(SelectedSchool)
			local out = {}
			for _, entry in listRecipesForSchool(schoolId) do
				if not CraftingShared.IsRecipeUnlocked(data, entry.id) then continue end
				local lvl = CraftingShared.GetArtisanLevel(data, schoolId)
				entry.unlocked = lvl >= entry.recipe.RequiredLevel
				entry.canCraft, entry.reason = CraftingShared.CanCraft(data, entry.id, 1)
				table.insert(out, entry)
			end
			return out
		end),
		function(use, innerScope, idx, entry)
			local school = CraftingConfig.Schools[entry.recipe.School]
			local color = entry.unlocked and (school and school.Display.Color or PALETTE.accent) or PALETTE.inkFaint
			local isSelected = innerScope:Computed(function(use2)
				return use2(SelectedRecipe) == entry.id
			end)
			return entry.id, innerScope:New('TextButton') {
				LayoutOrder = idx,
				Size = UDim2.new(1, 0, 0, 40),
				BackgroundColor3 = innerScope:Computed(function(use2)
					if use2(isSelected) then return color end
					return PALETTE.bg0
				end),
				BackgroundTransparency = innerScope:Computed(function(use2)
					return use2(isSelected) and 0.55 or 0.4
				end),
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = '',
				[Fusion.OnEvent('Activated')] = function()
					SelectedRecipe:set(entry.id)
				end,
				[Fusion.Children] = {
					innerScope:New('UIStroke') { Color = color, Transparency = 0.55, Thickness = 1 },
					innerScope:New('UIPadding') { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) },
					innerScope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0.5),
						Position = UDim2.fromScale(0, 0.4),
						Size = UDim2.new(1, -60, 0, 16),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_UI,
						Text = entry.recipe.Display.Name,
						TextSize = 13,
						TextColor3 = entry.unlocked and PALETTE.ink or PALETTE.inkDim,
						TextXAlignment = Enum.TextXAlignment.Left,
						TextTruncate = Enum.TextTruncate.AtEnd,
					},
					innerScope:New('TextLabel') {
						AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.new(1, 0, 0.5, 0),
						Size = UDim2.fromOffset(60, 16),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = string.format('Lv %d', entry.recipe.RequiredLevel),
						TextSize = 11,
						TextColor3 = entry.unlocked and color or PALETTE.inkFaint,
						TextXAlignment = Enum.TextXAlignment.Right,
					},
				},
			}
		end
	)

	local centerColumn = scope:New('Frame') {
		LayoutOrder = 2,
		Size = UDim2.fromScale(RIGHT_COL_PX / DESIGN_W, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			Utils.eyebrow(scope, '◆ RECIPES', { LayoutOrder = 1 }),
			scope:New('ScrollingFrame') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 1, -28),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Active = true,
				ScrollBarThickness = 4,
				ScrollBarImageColor3 = PALETTE.accent,
				CanvasSize = UDim2.fromOffset(0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ElasticBehavior = Enum.ElasticBehavior.Never,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding = UDim.new(0, 4),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					recipeListChildren,
				},
			},
		},
	}

	-- // RIGHT — selected recipe detail // --
	local selectedRecipeData = scope:Computed(function(use)
		local id = use(SelectedRecipe); if not id then return nil end
		return CraftingConfig.Recipes[id]
	end)

	local reagentsBlock = scope:New('Frame') {
		LayoutOrder = 4,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 4),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:ForPairs(
				scope:Computed(function(use)
					use(DataVersion)
					local id = use(SelectedRecipe); if not id then return {} end
					local data = Utils.getPlayerData()
					local sat = CraftingShared.GetReagentSatisfaction(data, id)
					local recipe = CraftingConfig.Recipes[id]
					if not recipe then return {} end
					local out = {}
					for i, reagent in recipe.Reagents do
						local pair = sat[reagent.ItemId] or { have = 0, need = reagent.Quantity }
						table.insert(out, {
							order = i,
							itemId = reagent.ItemId,
							have = pair.have,
							need = pair.need,
							satisfied = pair.have >= pair.need,
						})
					end
					return out
				end),
				function(use, innerScope, _i, r)
					local color = r.satisfied and PALETTE.success or PALETTE.danger
					return r.itemId, innerScope:New('Frame') {
						LayoutOrder = r.order,
						Size = UDim2.new(1, 0, 0, 22),
						BackgroundTransparency = 1,
						[Fusion.Children] = {
							innerScope:New('TextLabel') {
								AnchorPoint = Vector2.new(0, 0.5),
								Position = UDim2.fromScale(0, 0.5),
								Size = UDim2.new(1, -80, 1, 0),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_UI,
								Text = string.format('\u{25C6} %s', itemDisplayName(r.itemId)),
								TextSize = 13,
								TextColor3 = PALETTE.ink,
								TextXAlignment = Enum.TextXAlignment.Left,
								TextTruncate = Enum.TextTruncate.AtEnd,
							},
							innerScope:New('TextLabel') {
								AnchorPoint = Vector2.new(1, 0.5),
								Position = UDim2.new(1, 0, 0.5, 0),
								Size = UDim2.fromOffset(80, 18),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_MONO,
								Text = string.format('%d / %d', r.have, r.need),
								TextSize = 12,
								TextColor3 = color,
								TextXAlignment = Enum.TextXAlignment.Right,
							},
						},
					}
				end
			),
		},
	}

	local craftability = scope:Computed(function(use)
		use(DataVersion)
		local id = use(SelectedRecipe); if not id then return false, '' end
		local data = Utils.getPlayerData()
		return CraftingShared.CanCraft(data, id, 1)
	end)

	local craftButton = scope:New('TextButton') {
		LayoutOrder = 5,
		Size = UDim2.new(0, 200, 0, 36),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		FontFace = HUDCommon.FONT_BUTTON,
		Text = scope:Computed(function(use)
			local ok = use(craftability)
			return ok and 'CRAFT' or 'UNAVAILABLE'
		end),
		TextSize = 14,
		TextColor3 = scope:Computed(function(use)
			local ok = use(craftability)
			return ok and PALETTE.success or PALETTE.inkFaint
		end),
		[Fusion.OnEvent('Activated')] = function()
			local id = peek(SelectedRecipe); if not id then return end
			local ok = peek(craftability); if not ok then return end
			CraftingEvent:FireServer(CraftingShared.CraftingActions.Craft, id, 1)
		end,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = scope:Computed(function(use)
					return use(craftability) and PALETTE.success or PALETTE.inkFaint
				end),
				Transparency = 0.4, Thickness = 1,
			},
		},
	}

	local rightColumn = scope:New('Frame') {
		LayoutOrder = 3,
		Size = UDim2.fromScale(
			(DESIGN_W - LEFT_COL_PX - RIGHT_COL_PX - 2 * COL_GAP_PX) / DESIGN_W,
			1
		),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			Utils.eyebrow(scope, '◆ DETAIL', { LayoutOrder = 1 }),
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, 26),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = scope:Computed(function(use)
					local r = use(selectedRecipeData)
					return r and r.Display.Name or 'No recipe selected'
				end),
				TextSize = 22,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				LayoutOrder = 3,
				Size = UDim2.new(1, 0, 0, 32),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = scope:Computed(function(use)
					local r = use(selectedRecipeData)
					if not r then return '' end
					return string.format('%s\n→ %s × %d (+%d %s XP)',
						r.Display.Description or '',
						itemDisplayName(r.Output.ItemId),
						r.Output.Quantity,
						r.XPGain,
						r.School)
				end),
				TextSize = 12,
				TextColor3 = PALETTE.inkDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
			},
			reagentsBlock,
			craftButton,
		},
	}

	return scope:New('Frame') {
		Name = 'CraftingTab',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(24 / OUTER_H, 0),
				PaddingBottom = UDim.new(24 / OUTER_H, 0),
				PaddingLeft   = UDim.new(32 / OUTER_W, 0),
				PaddingRight  = UDim.new(32 / OUTER_W, 0),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(COL_GAP_PX / DESIGN_W, 0),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			leftColumn, centerColumn, rightColumn,
		},
	}
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/TabWidget/AurasTab"><![CDATA[-- // TabWidget/AurasTab.luau //
-- Aura browser. Two columns: left = anchor filter + owned auras grid,
-- right = selected aura detail + equip/unequip on its anchor.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local peek   = Fusion.peek

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local AurasShared = ReplicatedModules.Services.AurasShared
local AurasConfig = ReplicatedModules.Data.Auras
local Utils = require(script.Parent.utils)

local Module = {}

-- 1394×648 outer canvas, 1330×600 inner after 32/24 UIPadding.
local OUTER_W, OUTER_H   = 1394, 648
local DESIGN_W, DESIGN_H = 1330, 600
local LEFT_COL_PX        = 320
local COL_GAP_PX         = 36

local ANCHORS = { 'all', 'character', 'sword', 'mount' }
local ANCHOR_LABELS = { all = 'All', character = 'Character', sword = 'Sword', mount = 'Mount' }

local function listOwnedAuras(saveData)
	local out = {}
	if typeof(saveData) ~= 'table' then return out end
	local owned = (saveData.Auras and saveData.Auras.Owned) or {}
	for id, _ in owned do
		local cfg = AurasConfig.Auras[id]
		if cfg then table.insert(out, { id = id, cfg = cfg }) end
	end
	table.sort(out, function(a, b)
		return (a.cfg.Display.Name or a.id) < (b.cfg.Display.Name or b.id)
	end)
	return out
end

function Module.Build(ctx)
	local scope = ctx.scope
	local DataVersion = ctx.DataVersion

	local SelectedId = scope:Value(nil :: string?)
	local AnchorFilter = scope:Value('all')

	local chips = {}
	for i, anchor in ANCHORS do
		local isActive = scope:Computed(function(use)
			return use(AnchorFilter) == anchor
		end)
		table.insert(chips, scope:New('TextButton') {
			LayoutOrder = i,
			Size = UDim2.fromOffset(80, 26),
			BackgroundColor3 = scope:Computed(function(use)
				return use(isActive) and PALETTE.accent or PALETTE.bg0
			end),
			BackgroundTransparency = scope:Computed(function(use)
				return use(isActive) and 0.6 or 0.35
			end),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			FontFace = HUDCommon.FONT_MONO,
			Text = ANCHOR_LABELS[anchor],
			TextSize = 11,
			TextColor3 = PALETTE.ink,
			[Fusion.OnEvent('Activated')] = function() AnchorFilter:set(anchor) end,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.5, Thickness = 1 },
			},
		})
	end

	local listChildren = scope:ForPairs(
		scope:Computed(function(use)
			use(DataVersion)
			local list = listOwnedAuras(Utils.getPlayerData())
			local f = use(AnchorFilter)
			local out = {}
			for _, e in list do
				if f == 'all' or e.cfg.Anchor == f then table.insert(out, e) end
			end
			return out
		end),
		function(use, innerScope, idx, entry)
			local isSelected = innerScope:Computed(function(use2)
				return use2(SelectedId) == entry.id
			end)
			return idx, innerScope:New('TextButton') {
				LayoutOrder = idx,
				Size = UDim2.new(1, 0, 0, 50),
				BackgroundColor3 = innerScope:Computed(function(use2)
					return use2(isSelected) and PALETTE.accent or PALETTE.bg0
				end),
				BackgroundTransparency = innerScope:Computed(function(use2)
					return use2(isSelected) and 0.6 or 0.4
				end),
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = '',
				[Fusion.OnEvent('Activated')] = function() SelectedId:set(entry.id) end,
				[Fusion.Children] = {
					innerScope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.55, Thickness = 1 },
					innerScope:New('UIPadding') { PaddingLeft = UDim.new(0, 12) },
					innerScope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0.5),
						Position = UDim2.fromScale(0, 0.32),
						Size = UDim2.new(1, 0, 0, 18),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_DISPLAY,
						Text = entry.cfg.Display.Name or entry.id,
						TextSize = 16, TextColor3 = PALETTE.ink,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					innerScope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0.5),
						Position = UDim2.fromScale(0, 0.74),
						Size = UDim2.new(1, 0, 0, 14),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = string.upper(entry.cfg.Anchor),
						TextSize = 11,
						TextColor3 = PALETTE.violet,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
				},
			}
		end
	)

	local equippedForAnchor = scope:Computed(function(use)
		use(DataVersion)
		local sel = use(SelectedId); if not sel then return nil end
		local cfg = AurasConfig.Auras[sel]; if not cfg then return nil end
		local data = Utils.getPlayerData()
		return AurasShared.GetEquippedForAnchor(data, cfg.Anchor)
	end)

	-- ctx.embedded suppresses outer padding when this tab is embedded
	-- inside InventoryTab (already padded by the host).
	local outerPadding = (not ctx.embedded) and scope:New('UIPadding') {
		PaddingTop    = UDim.new(24 / OUTER_H, 0),
		PaddingBottom = UDim.new(24 / OUTER_H, 0),
		PaddingLeft   = UDim.new(32 / OUTER_W, 0),
		PaddingRight  = UDim.new(32 / OUTER_W, 0),
	} or nil
	return scope:New('Frame') {
		Name = 'AurasTab',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			outerPadding,
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				-- Bumped 16 → 36 so the detail column sits noticeably
				-- inset from the left rail, giving the title + stats
				-- room to breathe instead of crowding the chip strip.
				Padding = UDim.new(COL_GAP_PX / DESIGN_W, 0),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:New('Frame') {
				LayoutOrder = 1,
				Size = UDim2.fromScale(LEFT_COL_PX / DESIGN_W, 1),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding = UDim.new(0, 8),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					Utils.eyebrow(scope, '◆ AURAS', { LayoutOrder = 1 }),
					scope:New('Frame') {
						LayoutOrder = 2,
						Size = UDim2.new(1, 0, 0, 28),
						BackgroundTransparency = 1,
						[Fusion.Children] = {
							scope:New('UIListLayout') {
								FillDirection = Enum.FillDirection.Horizontal,
								Padding = UDim.new(0, 6),
								SortOrder = Enum.SortOrder.LayoutOrder,
							},
							table.unpack(chips),
						},
					},
					scope:New('ScrollingFrame') {
						LayoutOrder = 3,
						Size = UDim2.new(1, 0, 1, -76),
						BackgroundTransparency = 1,
						BorderSizePixel = 0,
						Active = true,
						ScrollBarThickness = 4,
						ScrollBarImageColor3 = PALETTE.accent,
						AutomaticCanvasSize = Enum.AutomaticSize.Y,
						CanvasSize = UDim2.fromOffset(0, 0),
						ElasticBehavior = Enum.ElasticBehavior.Never,
						[Fusion.Children] = {
							scope:New('UIListLayout') {
								FillDirection = Enum.FillDirection.Vertical,
								Padding = UDim.new(0, 6),
								SortOrder = Enum.SortOrder.LayoutOrder,
							},
							listChildren,
						},
					},
				},
			},
			scope:New('Frame') {
				LayoutOrder = 2,
				Size = UDim2.fromScale((DESIGN_W - LEFT_COL_PX - COL_GAP_PX) / DESIGN_W, 1),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding = UDim.new(0, 10),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					Utils.eyebrow(scope, '◆ DETAIL', { LayoutOrder = 1 }),
					scope:New('TextLabel') {
						LayoutOrder = 2,
						Size = UDim2.new(1, 0, 0, 28),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_DISPLAY,
						Text = scope:Computed(function(use)
							local id = use(SelectedId); if not id then return 'No aura selected' end
							local cfg = AurasConfig.Auras[id]
							return cfg and (cfg.Display.Name or id) or '—'
						end),
						TextSize = 22,
						TextColor3 = PALETTE.ink,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					scope:New('TextLabel') {
						LayoutOrder = 3,
						Size = UDim2.new(1, 0, 0, 32),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_UI,
						Text = scope:Computed(function(use)
							local id = use(SelectedId); if not id then return '' end
							local cfg = AurasConfig.Auras[id]
							return cfg and cfg.Display.Description or ''
						end),
						TextSize = 13,
						TextColor3 = PALETTE.inkDim,
						TextXAlignment = Enum.TextXAlignment.Left,
						TextYAlignment = Enum.TextYAlignment.Top,
						TextWrapped = true,
					},
					scope:New('TextButton') {
						LayoutOrder = 4,
						Size = UDim2.fromOffset(200, 36),
						BackgroundColor3 = PALETTE.bg0,
						BackgroundTransparency = 0.25,
						BorderSizePixel = 0,
						AutoButtonColor = false,
						FontFace = HUDCommon.FONT_BUTTON,
						Text = scope:Computed(function(use)
							local id = use(SelectedId); if not id then return 'SELECT AN AURA' end
							return use(equippedForAnchor) == id and 'UNEQUIP' or 'EQUIP'
						end),
						TextSize = 14, TextColor3 = PALETTE.ink,
						[Fusion.OnEvent('Activated')] = function()
							local id = peek(SelectedId); if not id then return end
							local cfg = AurasConfig.Auras[id]; if not cfg then return end
							local Gameplay = require(LocalPlayer:WaitForChild('PlayerScripts')
								:WaitForChild('Core'):WaitForChild('Gameplay'))
							local AurasClient = Gameplay.AurasClient
							if not AurasClient then return end
							-- Server expects an aura ID, not the anchor string.
							-- (Multi-equip allows several auras per anchor, so
							-- the anchor alone wouldn't disambiguate which one
							-- to remove.) Pass the selected id directly.
							if peek(equippedForAnchor) == id then
								AurasClient.AttemptUnequip(id)
							else
								AurasClient.AttemptEquip(id)
							end
						end,
						[Fusion.Children] = {
							scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
						},
					},
				},
			},
		},
	}
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/TabWidget/inventoryGrid"><![CDATA[-- // TabWidget/inventoryGrid.luau //
--
-- Section-grouped scrolling tile grid used by both ToolbarTab (skills +
-- usables) and CharacterTab (equippables). Each section holds a list of
-- "entries" — uniform-shape descriptors of an item or skill the player
-- owns.
--
-- Entry shape (return value of each section's `Resolve(saveData)`):
--   {
--     Kind  : 'item' | 'skill',
--     Id    : string,         -- itemId for 'item', skillId for 'skill'
--     Uuid  : string?,        -- inventory uuid for items; nil for skills
--     Cfg   : any,            -- ItemsConfig or SkillsConfig entry
--     Label : string,         -- pre-resolved display name
--     Sub   : string?,        -- optional sublabel (e.g. quantity / cost)
--     Color : Color3?,        -- optional rarity/element accent
--     Glyph : string?,        -- icon glyph fallback when no viewport model
--   }
--
-- Section shape (passed to `build`):
--   {
--     Id      : string,                                 -- stable section key
--     Label   : string,                                 -- eyebrow text
--     Resolve : (saveData) -> { Entry }                 -- entries to render
--   }
--
-- Usage:
--   local grid = inventoryGrid.build(scope, {
--     DataVersion = ctx.DataVersion,
--     Sections    = {...},
--     OnEntryClick = function(entry) ... end,
--     OnEntryHover = function(entry?) ... end,   -- nil on leave
--   })
--   grid.Frame  -- parent into your column
--
-- The grid does NOT host its own tooltip frame — callers route hover events
-- to whatever tooltip surface they own (the tab usually has one already).

local Players = game:GetService('Players')
local UserInputService = game:GetService('UserInputService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local Utils = require(script.Parent:WaitForChild('utils'))

local Module = {}

----------------------------------------------------------------------
-- Tile constants. Square tiles in a fixed grid; the section frame's
-- AutomaticSize.Y handles overflow.
----------------------------------------------------------------------
local TILE_W = 64
local TILE_H = 64
local TILE_GAP = 6
local SECTION_GAP = 12

----------------------------------------------------------------------
-- Build a single entry tile. Press-and-hold gesture detection: a press
-- without movement fires `onClick`; a press + cursor movement past
-- `dragThreshold` pixels fires `onDragStart` (the drag controller in
-- the consumer takes over from there).
--
-- The connection lifetime is tied to the press cycle — moveConn /
-- endConn are connected on `InputBegan` and disconnected on either
-- drag-start or release. The `Destroying` cleanup catches the case
-- where the tile is destroyed mid-press (e.g. ForPairs rebuilds the
-- grid while the user is still holding the mouse button).
----------------------------------------------------------------------
local function buildTile(scope, entry, onClick, onHover, onDragStart, dragThreshold)
	local accent = entry.Color or PALETTE.accent
	dragThreshold = dragThreshold or 6

	local pressed = false
	local pressStart = Vector2.zero
	local dragHandled = false
	local moveConn: RBXScriptConnection?
	local endConn: RBXScriptConnection?

	local function cleanupPress()
		pressed = false
		if moveConn then moveConn:Disconnect(); moveConn = nil end
		if endConn then endConn:Disconnect(); endConn = nil end
	end

	local tile = scope:New('TextButton') {
		Name = entry.Kind .. '_' .. tostring(entry.Id),
		Size = UDim2.fromOffset(TILE_W, TILE_H),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = '',
		-- No `Activated` here — we drive click vs drag from raw input
		-- events so the press → release → click branch only fires when
		-- the cursor stayed put (mirrors the standard drag-vs-click
		-- gesture rule used by every desktop drag-and-drop UI).
		[Fusion.OnEvent('MouseEnter')] = function() if onHover then onHover(entry) end end,
		[Fusion.OnEvent('MouseLeave')] = function() if onHover then onHover(nil) end end,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = accent, Transparency = 0.55, Thickness = 1 },
			scope:New('UICorner') { CornerRadius = UDim.new(0, 4) },
			-- Glyph is a centered icon when no viewport ships. Keeps the
			-- per-tile cost low — TextLabel only, no Viewport.
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(0.7, 0.7),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = entry.Glyph or '◆',
				TextScaled = true,
				TextColor3 = accent,
			},
			-- Optional bottom-right sublabel (e.g. stack quantity, level).
			entry.Sub and scope:New('TextLabel') {
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -3, 1, -2),
				Size = UDim2.fromOffset(40, 12),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = entry.Sub,
				TextSize = 10,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Right,
				TextStrokeTransparency = 0.4,
				TextStrokeColor3 = PALETTE.bg0,
			} or nil,
		},
	}

	-- Press → click/drag dispatch. InputBegan on the tile starts a
	-- press cycle; the global InputChanged + InputEnded handlers
	-- decide which branch to fire.
	tile.InputBegan:Connect(function(input)
		if pressed then return end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		pressed = true
		pressStart = Vector2.new(input.Position.X, input.Position.Y)
		dragHandled = false

		moveConn = UserInputService.InputChanged:Connect(function(moveInput)
			if not pressed or dragHandled then return end
			if moveInput.UserInputType ~= Enum.UserInputType.MouseMovement
				and moveInput.UserInputType ~= Enum.UserInputType.Touch then return end
			local pos = Vector2.new(moveInput.Position.X, moveInput.Position.Y)
			if (pos - pressStart).Magnitude > dragThreshold then
				dragHandled = true
				if onDragStart then
					onDragStart(entry, moveInput.Position.X, moveInput.Position.Y)
				end
				cleanupPress()
			end
		end)

		endConn = UserInputService.InputEnded:Connect(function(endInput)
			if endInput.UserInputType ~= Enum.UserInputType.MouseButton1
				and endInput.UserInputType ~= Enum.UserInputType.Touch then return end
			-- Release without surpassing the drag threshold counts as a click.
			if pressed and not dragHandled and onClick then
				onClick(entry)
			end
			cleanupPress()
		end)
	end)
	tile.Destroying:Connect(cleanupPress)

	return tile
end

----------------------------------------------------------------------
-- Build the grid. Returns { Frame } so callers can parent the result.
----------------------------------------------------------------------
function Module.build(scope, props: {
	DataVersion: any,
	Sections: { { Id: string, Label: string, Resolve: (any) -> { any } } },
	OnEntryClick: (any) -> (),
	OnEntryHover: (any?) -> (),
	-- Optional drag-start hook: (entry, absX, absY) — fired when the
	-- cursor moves past `DragThreshold` pixels while the tile is held.
	OnEntryDragStart: ((any, number, number) -> ())?,
	DragThreshold: number?,
})
	-- Frame layout:
	--   ScrollingFrame (vertical scroll, content auto-sizes)
	--     UIListLayout (vertical, gap = SECTION_GAP)
	--     for each section:
	--       Section frame
	--         eyebrow label
	--         tile container (grid layout, auto-sized Y)
	local sectionFrames = {}
	for sectionIdx, section in props.Sections do
		-- Per-section tile container. ForPairs over a Computed pulls
		-- entries from the section's Resolve(saveData) function so the
		-- grid stays reactive as PlayerData ticks.
		local tilesFrame = scope:New('Frame') {
			Name = 'Tiles',
			LayoutOrder = 2,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				scope:New('UIGridLayout') {
					CellSize = UDim2.fromOffset(TILE_W, TILE_H),
					CellPadding = UDim2.fromOffset(TILE_GAP, TILE_GAP),
					SortOrder = Enum.SortOrder.LayoutOrder,
					HorizontalAlignment = Enum.HorizontalAlignment.Left,
					StartCorner = Enum.StartCorner.TopLeft,
					FillDirectionMaxCells = 0,  -- auto-fill rows by available width
				},
				scope:ForPairs(
					scope:Computed(function(use)
						use(props.DataVersion)
						local saveData = Utils.getPlayerData()
						local entries = section.Resolve(saveData) or {}
						return entries
					end),
					function(_use, innerScope, idx, entry)
						local key = entry.Kind .. ':' .. tostring(entry.Id) .. ':' .. tostring(entry.Uuid or idx)
						local tile = buildTile(innerScope, entry,
							props.OnEntryClick, props.OnEntryHover,
							props.OnEntryDragStart, props.DragThreshold)
						tile.LayoutOrder = idx
						return key, tile
					end
				),
			},
		}

		-- Empty-state hint for sections with no entries. ForPairs naturally
		-- collapses to zero children, leaving an awkward gap; a plain text
		-- label that fades when entries appear keeps the section readable.
		local emptyLabel = scope:New('TextLabel') {
			LayoutOrder = 3,
			Size = UDim2.new(1, 0, 0, 18),
			BackgroundTransparency = 1,
			FontFace = HUDCommon.FONT_MONO,
			Text = '— none —',
			TextSize = 10,
			TextColor3 = PALETTE.inkFaint,
			TextXAlignment = Enum.TextXAlignment.Left,
			Visible = scope:Computed(function(use)
				use(props.DataVersion)
				local saveData = Utils.getPlayerData()
				local entries = section.Resolve(saveData) or {}
				return #entries == 0
			end),
		}

		table.insert(sectionFrames, scope:New('Frame') {
			Name = 'Section_' .. section.Id,
			LayoutOrder = sectionIdx,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				scope:New('UIListLayout') {
					FillDirection = Enum.FillDirection.Vertical,
					Padding = UDim.new(0, 4),
					SortOrder = Enum.SortOrder.LayoutOrder,
				},
				Utils.eyebrow(scope, '\u{25C6} ' .. string.upper(section.Label), { LayoutOrder = 1 }),
				tilesFrame,
				emptyLabel,
			},
		})
	end

	local frame = scope:New('ScrollingFrame') {
		Name = 'InventoryGridScroll',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = true,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = PALETTE.accent,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		CanvasSize = UDim2.fromOffset(0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ElasticBehavior = Enum.ElasticBehavior.Never,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, SECTION_GAP),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- Pad the right edge so tiles don't crowd the scrollbar.
			scope:New('UIPadding') { PaddingRight = UDim.new(0, 8) },
			table.unpack(sectionFrames),
		},
	}

	return { Frame = frame }
end

----------------------------------------------------------------------
-- Shared section resolvers. Reading the live save struct + transforming
-- to Entry shape lives here so multiple tabs use the same predicate
-- definitions (a "skill is hotbar-eligible if not Passive" rule lives
-- ONCE).
----------------------------------------------------------------------
local ItemsConfig  = ReplicatedModules.Data.Items
local Rarities     = ReplicatedModules.Data.Rarities
local SkillsConfig = ReplicatedModules.Data.Skills
local SkillsShared = ReplicatedModules.Services.SkillsShared

-- Common item entry adapter. Walks the player's `data.Inventory` map,
-- runs the predicate per (itemId, cfg), and emits one entry per stack
-- (multiple uuids of the same itemId yield N entries — each binds
-- separately to the hotbar / equipment slot).
local function entriesFromInventory(saveData, predicate: (cfg: any) -> boolean): { any }
	local out = {}
	if typeof(saveData) ~= 'table' or typeof(saveData.Inventory) ~= 'table' then
		return out
	end
	for itemId, uuidcache in saveData.Inventory do
		local cfg = ItemsConfig.Items[itemId]
		if not cfg then continue end
		if not predicate(cfg) then continue end
		if typeof(uuidcache) ~= 'table' then continue end
		for uuid, stack in uuidcache do
			local label = (cfg.Display and cfg.Display.Title and cfg.Display.Title.Text) or itemId
			local rarity = (cfg and cfg.Rarity) or 1
			local color = Rarities.RarityColors[rarity] or PALETTE.accent
			local count = (typeof(stack) == 'table' and (stack.Quantity or stack.Count)) or 1
			table.insert(out, {
				Kind  = 'item',
				Id    = itemId,
				Uuid  = uuid,
				Cfg   = cfg,
				Label = label,
				Sub   = (count > 1) and ('×' .. tostring(count)) or nil,
				Color = color,
				Glyph = '\u{25C6}',  -- ◆
			})
		end
	end
	table.sort(out, function(a, b) return a.Label < b.Label end)
	return out
end

-- Active (non-passive) skills the player has unlocked. Returns one
-- entry per skill id; passives are filtered out so the toolbar grid
-- only shows things that can actually be cast from a slot.
function Module.SkillEntries(saveData): { any }
	local out = {}
	local unlocked = SkillsShared.GetUnlockedSkills(saveData)
	for skillId, _entry in unlocked do
		local cfg = SkillsConfig.Skills[skillId]
		if not cfg then continue end
		if cfg.Passive then continue end
		local label = (cfg.Display and cfg.Display.Name) or skillId
		table.insert(out, {
			Kind  = 'skill',
			Id    = skillId,
			Cfg   = cfg,
			Label = label,
			Color = PALETTE.violet,
			Glyph = '\u{2605}',  -- ★
		})
	end
	table.sort(out, function(a, b) return a.Label < b.Label end)
	return out
end

-- Tag-driven section resolvers. Each one walks `saveData.Inventory`
-- and emits Entry rows for items whose `Tags` array contains the
-- corresponding `Module.ItemTags.X`. Items without tags don't appear.
-- The data-shape predicates below (WeaponItemEntries etc.) prefer
-- tags but fall back to the EquipmentData shape so untagged legacy
-- items still render until they're explicitly tagged.
function Module.WeaponItemEntries(saveData): { any }
	return entriesFromInventory(saveData, function(cfg)
		if ItemsConfig.HasTag(cfg, ItemsConfig.ItemTags.Weapon) then return true end
		local equip = cfg.EquipmentData
		return equip ~= nil and equip.WeaponUsage ~= nil
	end)
end

function Module.ToolItemEntries(saveData): { any }
	return entriesFromInventory(saveData, function(cfg)
		if ItemsConfig.HasTag(cfg, ItemsConfig.ItemTags.Tool) then return true end
		local equip = cfg.EquipmentData
		return equip ~= nil and equip.ToolUsage ~= nil
	end)
end

-- Food / Potion are TAG-ONLY: an item must be explicitly tagged to
-- show up in the hotbar surface. Reusing data shape (ConsumptionData)
-- would auto-include AttributeScrolls / Candy / etc., which the
-- player intent doesn't include.
function Module.FoodItemEntries(saveData): { any }
	return entriesFromInventory(saveData, function(cfg)
		return ItemsConfig.HasTag(cfg, ItemsConfig.ItemTags.Food)
	end)
end

function Module.PotionItemEntries(saveData): { any }
	return entriesFromInventory(saveData, function(cfg)
		return ItemsConfig.HasTag(cfg, ItemsConfig.ItemTags.Potion)
	end)
end

-- Armor: tag-first, with EquipmentData shape as fallback.
local ARMOR_SLOT_LOOKUP = {
	[ItemsConfig.EquipmentSlotEnums.Head]  = true,
	[ItemsConfig.EquipmentSlotEnums.Chest] = true,
	[ItemsConfig.EquipmentSlotEnums.Legs]  = true,
	[ItemsConfig.EquipmentSlotEnums.Boots] = true,
}
function Module.ArmorItemEntries(saveData): { any }
	return entriesFromInventory(saveData, function(cfg)
		if ItemsConfig.HasTag(cfg, ItemsConfig.ItemTags.Equipment) then return true end
		local equip = cfg.EquipmentData
		if not equip or equip.WeaponUsage or equip.ToolUsage then return false end
		local first = equip.EquipSlots and equip.EquipSlots[1]
		local slotEnum = first and first.Slot
		return slotEnum ~= nil and ARMOR_SLOT_LOOKUP[slotEnum] == true
	end)
end

-- Accessory equipment (jewelry / curio). Tag-first with slot fallback.
local ACCESSORY_SLOT_LOOKUP = {
	[ItemsConfig.EquipmentSlotEnums.Bracelet] = true,
	[ItemsConfig.EquipmentSlotEnums.Neck]     = true,
	[ItemsConfig.EquipmentSlotEnums.Ear]      = true,
	[ItemsConfig.EquipmentSlotEnums.Finger]   = true,
	[ItemsConfig.EquipmentSlotEnums.Curio]    = true,
}
function Module.AccessoryItemEntries(saveData): { any }
	return entriesFromInventory(saveData, function(cfg)
		if ItemsConfig.HasTag(cfg, ItemsConfig.ItemTags.Accessory) then return true end
		local equip = cfg.EquipmentData
		if not equip or equip.WeaponUsage or equip.ToolUsage then return false end
		local first = equip.EquipSlots and equip.EquipSlots[1]
		local slotEnum = first and first.Slot
		return slotEnum ~= nil and ACCESSORY_SLOT_LOOKUP[slotEnum] == true
	end)
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/TabWidget/ToolbarTab"><![CDATA[-- // TabWidget/ToolbarTab.luau //
-- (Registered in the tab manager as "Equip".)
--
-- Sub-tabbed equip-management surface:
--   * Hotbar sub-tab    — top-pane hotbar mirror + bottom-pane inventory
--                         grid (skills, consumables, activatables, weapons,
--                         tools). Drag tiles onto hotbar slots OR click a
--                         tile then click a slot.
--   * Inventory sub-tab — left equip-slot column + right inventory grid
--                         (weapons, tools, armor, accessories). Drag tiles
--                         onto equip slots OR click to auto-equip.
--
-- Both sub-tabs share a single floating tooltip and a single drag
-- controller. Drop targets register themselves with the controller; the
-- controller hit-tests the cursor against every registered target on
-- mouse-up and routes the drop to whichever rect contains it.

local Players = game:GetService('Players')
local GuiService = game:GetService('GuiService')
local UserInputService = game:GetService('UserInputService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local peek   = Fusion.peek
local CombatUtility = ReplicatedModules.Utility.CombatUtility
local SkillsShared = ReplicatedModules.Services.SkillsShared
local ItemsConfig  = ReplicatedModules.Data.Items
local SkillsConfig = ReplicatedModules.Data.Skills
local Rarities     = ReplicatedModules.Data.Rarities
local RemoteService = ReplicatedModules.Services.RemoteService

local LocalPlayerScripts = LocalPlayer:WaitForChild('PlayerScripts')
local LocalModules = require(LocalPlayerScripts:WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local Utils = require(script.Parent:WaitForChild('utils'))
local InventoryGrid = require(script.Parent:WaitForChild('inventoryGrid'))

-- Server-side equip/unequip remote. Drag-drop onto an equip slot in the
-- Inventory sub-tab fires this; server walks AttemptPlayerEquipItemOfUUID
-- with full validation. Same remote the InventoryTab's EQUIP button uses.
local InventoryEvent = RemoteService.GetRemote('InventoryEvent', 'RemoteEvent', false)

local Module = {}

----------------------------------------------------------------------
-- Constants. Tab design canvas = 1394 × 648 (matches the aspect-lock
-- applied by TabWidget's mount loop). Outer paddings + inter-pane
-- gaps are expressed as fractions of the design canvas so the layout
-- stays proportional under the UIAspectRatioConstraint regardless of
-- screen aspect — same convention CharacterTab uses.
----------------------------------------------------------------------
local TAB_DESIGN_W = 1394
local TAB_DESIGN_H = 648
local OUTER_PAD_X  = 24    -- design-pixel side padding inside the tab
local OUTER_PAD_Y  = 16    -- design-pixel top/bottom padding
local PANE_GAP     = 8     -- gap between hotbar / inventory panes
local INNER_PAD_X  = 16    -- design-pixel inset inside each pane
local INNER_PAD_Y  = 12

-- Cell sizes match the on-screen hotbar's design language (square
-- strokes, font-mono keybind chip in top-left). Pixel-fixed; the
-- tab's aspect-lock keeps these proportional at the design canvas.
local HOTBAR_CELL = 48
local EQUIP_CELL  = 56  -- equip slots are slightly larger to fit the rarity stroke
local TOOLTIP_OFFSET = Vector2.new(20, 22)  -- slightly to the right + below cursor

-- Equip slot grid for the Inventory sub-tab. Keys match the save shape
-- produced by PlayerInventoryServer (`<index>_<token>`); each entry's
-- glyph + label populate the slot tile.
local EQUIP_SLOT_META = {
	['1_Weapon']   = { tag = 'L. HAND',  order = 1,  glyph = '\u{2694}' }, -- ⚔
	['2_Weapon']   = { tag = 'R. HAND',  order = 2,  glyph = '\u{2694}' },
	['1_Head']     = { tag = 'HEAD',     order = 3,  glyph = '\u{25CE}' }, -- ◎
	['1_Chest']    = { tag = 'CHEST',    order = 4,  glyph = '\u{26E8}' }, -- ⛨
	['1_Legs']     = { tag = 'LEGS',     order = 5,  glyph = '\u{26E8}' },
	['1_Boots']    = { tag = 'BOOTS',    order = 6,  glyph = '\u{25E2}' }, -- ◢
	['1_Bracelet'] = { tag = 'BRACELET', order = 7,  glyph = '\u{25C8}' }, -- ◈
	['1_Neck']     = { tag = 'NECK',     order = 8,  glyph = '\u{25C8}' },
	['1_Ear']      = { tag = 'EAR',      order = 9,  glyph = '\u{25C8}' },
	['1_Finger']   = { tag = 'RING',     order = 10, glyph = '\u{25C8}' },
	['1_Curio']    = { tag = 'CURIO',    order = 11, glyph = '\u{25C8}' },
}

----------------------------------------------------------------------
-- Drag controller. Single-instance per Build call; drop zones register
-- + unregister via the returned API. Owns:
--   * the ghost frame that follows the cursor while dragging
--   * the InputChanged listener that updates ghost position
--   * the InputEnded listener that hit-tests on mouse-up
----------------------------------------------------------------------
local function buildDragController(scope, rootFrame, onHover)
	local DragState = {
		active = false,
		entry = nil :: any,
		ghost = nil :: GuiObject?,
	}
	local DropTargets: { { frame: GuiObject, predicate: ((entry: any) -> boolean)?, onDrop: (entry: any) -> () } } = {}

	-- Ghost frame: a small floating tile rendered above everything else
	-- while a drag is in progress. Built lazily on drag-start so it
	-- doesn't live in the tree when no drag is active.
	local function makeGhost(entry)
		local ghost = Instance.new('Frame')
		ghost.Name = 'DragGhost'
		ghost.AnchorPoint = Vector2.new(0.5, 0.5)
		ghost.Size = UDim2.fromOffset(48, 48)
		ghost.BackgroundColor3 = PALETTE.bg0
		ghost.BackgroundTransparency = 0.1
		ghost.BorderSizePixel = 0
		ghost.ZIndex = 100
		ghost.Active = false  -- pass clicks through (don't intercept own InputEnded)

		local stroke = Instance.new('UIStroke')
		stroke.Color = entry.Color or PALETTE.gold
		stroke.Transparency = 0
		stroke.Thickness = 2
		stroke.Parent = ghost

		local corner = Instance.new('UICorner')
		corner.CornerRadius = UDim.new(0, 4)
		corner.Parent = ghost

		local icon = Instance.new('TextLabel')
		icon.AnchorPoint = Vector2.new(0.5, 0.5)
		icon.Position = UDim2.fromScale(0.5, 0.5)
		icon.Size = UDim2.fromScale(0.7, 0.7)
		icon.BackgroundTransparency = 1
		icon.FontFace = HUDCommon.FONT_DISPLAY
		icon.TextScaled = true
		icon.Text = entry.Glyph or '\u{25C6}'
		icon.TextColor3 = entry.Color or PALETTE.accent
		icon.Parent = ghost

		ghost.Parent = rootFrame
		return ghost
	end

	local function setGhostPosition(absX: number, absY: number)
		if not DragState.ghost then return end
		local parentAbs = rootFrame.AbsolutePosition
		local inset = GuiService:GetGuiInset()
		DragState.ghost.Position = UDim2.fromOffset(
			math.floor(absX - parentAbs.X - inset.X),
			math.floor(absY - parentAbs.Y - inset.Y))
	end

	local function pointInFrame(frame: GuiObject, x: number, y: number): boolean
		local p = frame.AbsolutePosition
		local s = frame.AbsoluteSize
		return x >= p.X and x <= p.X + s.X
			and y >= p.Y and y <= p.Y + s.Y
	end

	-- Drop targets in invisible sub-panes still report Absolute*
	-- coordinates from the layout pass, so a naive hit-test could
	-- accept a drop "through" the active pane onto a hidden slot
	-- behind it. Walk up the parent chain to confirm every ancestor
	-- is Visible; reject otherwise.
	local function isFullyVisible(inst: Instance?): boolean
		while inst and inst ~= game do
			if inst:IsA('GuiObject') and not inst.Visible then return false end
			inst = inst.Parent
		end
		return true
	end

	local function endDrag(absX: number?, absY: number?)
		if not DragState.active then return end
		local entry = DragState.entry
		DragState.active = false
		DragState.entry = nil
		if DragState.ghost then DragState.ghost:Destroy(); DragState.ghost = nil end
		if not entry or not absX or not absY then return end
		for _, dt in DropTargets do
			if not dt.frame.Parent then continue end
			if not isFullyVisible(dt.frame) then continue end
			if dt.predicate and not dt.predicate(entry) then continue end
			if pointInFrame(dt.frame, absX, absY) then
				dt.onDrop(entry)
				return
			end
		end
	end

	-- Wire global input listeners ONCE and tie their lifetime to the
	-- scope. The handlers exit early when no drag is active so cost
	-- stays minimal during normal use.
	local moveConn = UserInputService.InputChanged:Connect(function(input)
		if not DragState.active then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		setGhostPosition(input.Position.X, input.Position.Y)
	end)
	local endConn = UserInputService.InputEnded:Connect(function(input)
		if not DragState.active then return end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		endDrag(input.Position.X, input.Position.Y)
	end)
	table.insert(scope, function() moveConn:Disconnect(); endConn:Disconnect() end)

	-- Public drag API.
	local function startDrag(entry, absX, absY)
		if DragState.active then return end
		DragState.active = true
		DragState.entry = entry
		DragState.ghost = makeGhost(entry)
		setGhostPosition(absX, absY)
		-- Hide the tooltip while dragging — the ghost IS the cursor
		-- focus now and a stacked tooltip clutters the overlay.
		onHover(nil)
	end

	local function registerDropTarget(frame: GuiObject, onDrop: (entry: any) -> (), predicate: ((entry: any) -> boolean)?)
		table.insert(DropTargets, { frame = frame, onDrop = onDrop, predicate = predicate })
	end

	return {
		StartDrag = startDrag,
		RegisterDropTarget = registerDropTarget,
		IsDragging = function() return DragState.active end,
	}
end

----------------------------------------------------------------------
-- Tile builder for the inventory grid. Wraps the InventoryGrid's
-- click-only tile with a MouseButton1Down → drag-start hook so a
-- press-and-drag turns into a drag, while a press-and-release stays a
-- click. Threshold of ~6 pixels separates a click from a drag so a
-- jittery release still registers as click.
----------------------------------------------------------------------
local DRAG_THRESHOLD = 6

----------------------------------------------------------------------
-- Build a hotbar slot. Drop target = the slot itself; clicking writes
-- the staged entry, dragging onto it via the drag controller calls
-- HotbarWidget.SetSlot directly. Reads its current binding off live
-- PlayerData (DataVersion-driven Computed).
----------------------------------------------------------------------
local function buildHotbarSlot(scope, slotId: string, dataVersion, stagedEntry, onTooltip, drag)
	local HotbarWidget = require(LocalPlayerScripts:WaitForChild('Core'):WaitForChild('Widgets'):WaitForChild('HotbarWidget'))

	local slotInfo = scope:Computed(function(use)
		use(dataVersion)
		local data = Utils.getPlayerData()
		local binding = data and data.Hotbar and data.Hotbar[slotId]
		if typeof(binding) ~= 'table' then return nil end
		if binding.type == 'item' and binding.uuid then
			for itemId, uuidcache in (data.Inventory or {}) do
				local cfg = ItemsConfig.Items[itemId]
				if cfg and typeof(uuidcache) == 'table' and uuidcache[binding.uuid] then
					local label = (cfg.Display and cfg.Display.Title and cfg.Display.Title.Text) or itemId
					local rarity = cfg.Rarity or 1
					local color = Rarities.RarityColors[rarity] or PALETTE.accent
					return { kind = 'item', cfg = cfg, label = label, glyph = '\u{25C6}', color = color }
				end
			end
		elseif binding.type == 'skill' and binding.id then
			local cfg = SkillsConfig.Skills[binding.id]
			if cfg then
				return { kind = 'skill', cfg = cfg,
					label = (cfg.Display and cfg.Display.Name) or binding.id,
					glyph = '\u{2605}', color = PALETTE.violet }
			end
		end
		return nil
	end)

	local keybindText = scope:Computed(function(use)
		use(dataVersion)
		local kb = HotbarWidget.GetKeybindForSlot(slotId)
		return string.upper(kb or '')
	end)

	local btn = scope:New('TextButton') {
		Name = 'HotbarSlot_' .. slotId,
		Size = UDim2.fromOffset(HOTBAR_CELL, HOTBAR_CELL),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = '',
		[Fusion.OnEvent('Activated')] = function()
			-- Skip if a drag-end just resolved here (the drag handler
			-- already wrote the binding via the drop target below).
			if drag.IsDragging() then return end
			local entry = peek(stagedEntry)
			if entry then
				if entry.Kind == 'item' and entry.Uuid then
					HotbarWidget.SetSlot(slotId, { type = 'item', uuid = entry.Uuid })
				elseif entry.Kind == 'skill' and entry.Id then
					HotbarWidget.SetSlot(slotId, { type = 'skill', id = entry.Id })
				end
				stagedEntry:set(nil)
			else
				HotbarWidget.SetSlot(slotId, nil)
			end
		end,
		[Fusion.OnEvent('MouseEnter')] = function()
			local info = peek(slotInfo)
			if info then
				onTooltip({ Label = info.label, Sub = string.upper(info.kind), Cfg = info.cfg, Color = info.color })
			else
				onTooltip(nil)
			end
		end,
		[Fusion.OnEvent('MouseLeave')] = function() onTooltip(nil) end,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = scope:Computed(function(use)
					if use(stagedEntry) then return PALETTE.gold end
					local info = use(slotInfo)
					return (info and info.color) or PALETTE.accent
				end),
				Transparency = scope:Computed(function(use)
					return use(slotInfo) and 0.2 or 0.8
				end),
				Thickness = 1,
			},
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(0.7, 0.7),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				TextScaled = true,
				Text = scope:Computed(function(use)
					local info = use(slotInfo); return info and info.glyph or ''
				end),
				TextColor3 = scope:Computed(function(use)
					local info = use(slotInfo); return (info and info.color) or PALETTE.accent
				end),
			},
			scope:New('TextLabel') {
				Size = UDim2.fromOffset(14, 10),
				Position = UDim2.fromOffset(2, 2),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				TextSize = 9,
				TextColor3 = PALETTE.inkDim,
				Text = keybindText,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
			},
		},
	}

	-- Register as a drop target. Hotbar accepts both items and skills.
	drag.RegisterDropTarget(btn, function(entry)
		if entry.Kind == 'item' and entry.Uuid then
			HotbarWidget.SetSlot(slotId, { type = 'item', uuid = entry.Uuid })
		elseif entry.Kind == 'skill' and entry.Id then
			HotbarWidget.SetSlot(slotId, { type = 'skill', id = entry.Id })
		end
	end)

	return btn
end

local function buildHotbarMirror(scope, dataVersion, stagedEntry, onTooltip, drag)
	local rows = {}
	for r = 1, 2 do
		local cells = {}
		for c = 1, 12 do
			cells[#cells + 1] = buildHotbarSlot(scope, ('r%d_%d'):format(r, c),
				dataVersion, stagedEntry, onTooltip, drag)
		end
		rows[#rows + 1] = scope:New('Frame') {
			Name = 'Row_' .. r,
			LayoutOrder = r,
			Size = UDim2.new(1, 0, 0, HOTBAR_CELL),
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				scope:New('UIListLayout') {
					FillDirection = Enum.FillDirection.Horizontal,
					Padding = UDim.new(0, 4),
					SortOrder = Enum.SortOrder.LayoutOrder,
					HorizontalAlignment = Enum.HorizontalAlignment.Center,
				},
				table.unpack(cells),
			},
		}
	end
	return scope:New('Frame') {
		Name = 'HotbarMirror',
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
				VerticalAlignment = Enum.VerticalAlignment.Center,
			},
			table.unpack(rows),
		},
	}
end

----------------------------------------------------------------------
-- Equip slot tile (Inventory sub-tab). Drop target = the slot. The
-- predicate filters drops to items whose EquipSlots match the slot
-- token (so dragging a sword onto a Head slot is a no-op).
----------------------------------------------------------------------
local function tokenFromSlotKey(slotKey: string): (string?, number?)
	local index, token = string.match(slotKey, '^(%d+)_(.+)$')
	return token, tonumber(index)
end

-- Reverse map: token (e.g. 'Weapon') → EquipmentSlotEnums value.
local TOKEN_TO_SLOT_ENUM = {
	Weapon   = ItemsConfig.EquipmentSlotEnums.Hand,
	Head     = ItemsConfig.EquipmentSlotEnums.Head,
	Chest    = ItemsConfig.EquipmentSlotEnums.Chest,
	Legs     = ItemsConfig.EquipmentSlotEnums.Legs,
	Boots    = ItemsConfig.EquipmentSlotEnums.Boots,
	Bracelet = ItemsConfig.EquipmentSlotEnums.Bracelet,
	Neck     = ItemsConfig.EquipmentSlotEnums.Neck,
	Ear      = ItemsConfig.EquipmentSlotEnums.Ear,
	Finger   = ItemsConfig.EquipmentSlotEnums.Finger,
	Curio    = ItemsConfig.EquipmentSlotEnums.Curio,
}

local function buildEquipSlot(scope, slotKey: string, meta, dataVersion, onTooltip, drag)
	local token, slotIndex = tokenFromSlotKey(slotKey)
	local expectedEnum = token and TOKEN_TO_SLOT_ENUM[token]

	local slotInfo = scope:Computed(function(use)
		use(dataVersion)
		local data = Utils.getPlayerData()
		local equipped = (data and data.Equipped and data.Equipped[slotKey]) or nil
		if typeof(equipped) ~= 'table' then return nil end
		local itemId = equipped.itemId or equipped.ItemId
		if not itemId then return nil end
		local cfg = ItemsConfig.Items[itemId]
		if not cfg then return nil end
		return {
			cfg = cfg,
			itemId = itemId,
			uuid = equipped.uuid or equipped.UUID,
			label = (cfg.Display and cfg.Display.Title and cfg.Display.Title.Text) or itemId,
			color = Rarities.RarityColors[cfg.Rarity or 1] or PALETTE.accent,
		}
	end)

	local btn = scope:New('TextButton') {
		Name = 'EquipSlot_' .. slotKey,
		Size = UDim2.fromOffset(EQUIP_CELL, EQUIP_CELL),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = '',
		[Fusion.OnEvent('Activated')] = function()
			-- Click-on-equipped → unequip. Click-on-empty is a no-op.
			if drag.IsDragging() then return end
			local info = peek(slotInfo); if not info or not info.uuid then return end
			InventoryEvent:FireServer(info.uuid, slotIndex or 1)
		end,
		[Fusion.OnEvent('MouseEnter')] = function()
			local info = peek(slotInfo)
			if info then
				onTooltip({ Label = info.label, Sub = meta.tag, Cfg = info.cfg, Color = info.color })
			else
				onTooltip({ Label = meta.tag, Sub = 'EMPTY SLOT', Cfg = nil, Color = PALETTE.inkFaint })
			end
		end,
		[Fusion.OnEvent('MouseLeave')] = function() onTooltip(nil) end,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = scope:Computed(function(use)
					local info = use(slotInfo); return (info and info.color) or PALETTE.accent
				end),
				Transparency = scope:Computed(function(use)
					return use(slotInfo) and 0.2 or 0.7
				end),
				Thickness = 1,
			},
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(0.7, 0.6),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				TextScaled = true,
				Text = meta.glyph,
				TextColor3 = scope:Computed(function(use)
					local info = use(slotInfo); return (info and info.color) or PALETTE.inkFaint
				end),
			},
			-- Top-left tag label.
			scope:New('TextLabel') {
				Size = UDim2.fromOffset(EQUIP_CELL - 4, 10),
				Position = UDim2.fromOffset(2, 2),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				TextSize = 9,
				TextColor3 = PALETTE.inkDim,
				Text = meta.tag,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
			},
		},
	}

	-- Drop target: only items whose EquipmentData primary slot matches
	-- this slot's enum. Server still validates so a malformed predicate
	-- can't put bad state on the save.
	drag.RegisterDropTarget(btn, function(entry)
		if entry.Kind ~= 'item' or not entry.Uuid then return end
		InventoryEvent:FireServer(entry.Uuid, slotIndex or 1)
	end, function(entry)
		if entry.Kind ~= 'item' then return false end
		local cfg = entry.Cfg
		local equip = cfg and cfg.EquipmentData
		local first = equip and equip.EquipSlots and equip.EquipSlots[1]
		return first ~= nil and first.Slot == expectedEnum
	end)

	return btn
end

----------------------------------------------------------------------
-- Hover tooltip shared by both sub-tabs. Built with parent-relative
-- positioning + offset slightly to the right of the cursor.
----------------------------------------------------------------------
local function buildTooltip(scope, hoverState, mousePos)
	local visible = scope:Computed(function(use) return use(hoverState) ~= nil end)

	local bodyText = scope:Computed(function(use)
		local h = use(hoverState)
		if not h or not h.Cfg then return '' end
		local cfg = h.Cfg
		local parts = {}
		if cfg.Display and cfg.Display.Description and cfg.Display.Description.Text then
			parts[#parts + 1] = cfg.Display.Description.Text
		end
		if cfg.Cooldown and cfg.Cooldown > 0 then
			parts[#parts + 1] = string.format('Cooldown: %ss · Damage: %d (×%.2f)',
				tostring(cfg.Cooldown), (cfg.Damage and cfg.Damage.Base) or 0,
				(cfg.Damage and cfg.Damage.WeaponScale) or 1)
		end
		if cfg.EquipmentData or cfg.ConsumptionData or cfg.ActivationData then
			local stats = CombatUtility.SummarizeWeaponStats(cfg)
			for k, v in stats do parts[#parts + 1] = string.format('%s: %s', k, tostring(v)) end
		end
		return table.concat(parts, '\n')
	end)

	local frame
	frame = scope:New('Frame') {
		Name = 'EquipTooltip',
		AnchorPoint = Vector2.new(0, 0),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
		ZIndex = 50,
		Visible = visible,
		Position = scope:Computed(function(use)
			local m = use(mousePos)
			local parentAbs = (frame and frame.Parent
				and (frame.Parent :: GuiObject).AbsolutePosition)
				or Vector2.zero
			local inset = GuiService:GetGuiInset()
			-- Offset further right than the original (8 → 20) per
			-- request. 22 px down keeps the tooltip top below the
			-- cursor's lower edge.
			local x = math.floor(m.X - parentAbs.X - inset.X + TOOLTIP_OFFSET.X)
			local y = math.floor(m.Y - parentAbs.Y - inset.Y + TOOLTIP_OFFSET.Y)
			return UDim2.fromOffset(x, y)
		end),
		Size = UDim2.fromOffset(260, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = scope:Computed(function(use)
					local h = use(hoverState); return (h and h.Color) or PALETTE.accent
				end),
				Transparency = 0.3, Thickness = 1,
			},
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
				PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
			},
			scope:New('UIListLayout') { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder },
			scope:New('TextLabel') {
				LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 18),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = scope:Computed(function(use) local h = use(hoverState); return h and h.Label or '' end),
				TextSize = 16, TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 12),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use) local h = use(hoverState); return h and h.Sub or '' end),
				TextSize = 10, TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = bodyText,
				TextSize = 12, TextColor3 = PALETTE.inkDim,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
			},
		},
	}
	return frame
end

----------------------------------------------------------------------
-- Sub-tab selector. Two pill buttons at the top; clicking switches
-- which sub-pane is visible.
----------------------------------------------------------------------
local function buildSubtabBar(scope, currentSubtab)
	local function pill(id: string, label: string, order: number)
		local active = scope:Computed(function(use) return use(currentSubtab) == id end)
		return scope:New('TextButton') {
			LayoutOrder = order,
			Size = UDim2.fromOffset(140, 30),
			BackgroundColor3 = scope:Computed(function(use)
				return use(active) and PALETTE.accent or PALETTE.bg0
			end),
			BackgroundTransparency = scope:Computed(function(use)
				return use(active) and 0.5 or 0.3
			end),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			FontFace = HUDCommon.FONT_BUTTON,
			Text = label,
			TextSize = 13,
			TextColor3 = scope:Computed(function(use)
				return use(active) and PALETTE.ink or PALETTE.inkDim
			end),
			[Fusion.OnEvent('Activated')] = function() currentSubtab:set(id) end,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
			},
		}
	end
	return scope:New('Frame') {
		Name = 'SubtabBar',
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			pill('hotbar', 'HOTBAR', 1),
			pill('inventory', 'INVENTORY', 2),
		},
	}
end

----------------------------------------------------------------------
-- Build(ctx)
----------------------------------------------------------------------
function Module.Build(ctx)
	local scope = ctx.scope
	local DataVersion = ctx.DataVersion

	-- Shared state across both sub-tabs.
	local HoverState = scope:Value(nil :: any)
	local StagedEntry = scope:Value(nil :: any)
	local CurrentSubtab = scope:Value('hotbar')

	-- Mouse tracker for the tooltip.
	local mousePos = scope:Value(Vector2.zero)
	local moveConn = UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			mousePos:set(Vector2.new(input.Position.X, input.Position.Y))
		end
	end)
	table.insert(scope, function() if moveConn then moveConn:Disconnect() end end)

	-- Tab root — built up-front so the drag controller can parent its
	-- ghost frame inside it (covers the whole tab; rect computations
	-- become straightforward). Built via scope:New so cleanup cascades
	-- correctly when the scope is doCleanup'd by a theme rebuild.
	local rootFrame = scope:New('Frame') {
		Name = 'EquipTab',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
	}

	local drag = buildDragController(scope, rootFrame, function(state)
		HoverState:set(state)
	end)

	-- Inventory grid factory — used by both sub-tabs with different
	-- section configs. The OnEntryClick / OnEntryHover callbacks are
	-- shared (stage / hover); the OnEntryDragStart adapts to the
	-- single drag controller.
	local function makeGrid(sections)
		return InventoryGrid.build(scope, {
			DataVersion = DataVersion,
			Sections = sections,
			OnEntryClick = function(entry)
				-- Click-stage path. Same as before — staged entry placed
				-- on next click of a hotbar/equip slot.
				local current = peek(StagedEntry)
				if current
					and current.Kind == entry.Kind
					and current.Id == entry.Id
					and current.Uuid == entry.Uuid then
					-- Second click on same entry: clear the stage.
					StagedEntry:set(nil)
				else
					StagedEntry:set(entry)
				end
			end,
			OnEntryHover = function(entry)
				if entry then
					local sub
					if entry.Kind == 'skill' then
						sub = SkillsShared.IsPassiveSkill(entry.Id) and 'PASSIVE SKILL' or 'SKILL'
					else
						sub = 'ITEM'
					end
					HoverState:set({ Label = entry.Label, Sub = sub, Cfg = entry.Cfg, Color = entry.Color })
				else
					HoverState:set(nil)
				end
			end,
			OnEntryDragStart = function(entry, x, y)
				StagedEntry:set(nil)  -- stage state is mutually exclusive with drag
				drag.StartDrag(entry, x, y)
			end,
			DragThreshold = DRAG_THRESHOLD,
		})
	end

	----------------------------------------------------------------------
	-- HOTBAR sub-pane.
	----------------------------------------------------------------------
	-- Hotbar accepts only skills + food + potions per design. Filtering
	-- happens in the section resolvers (tag-driven for items, Passive
	-- filter for skills) so weapons / tools / candy / scrolls don't
	-- surface as bindable here. Bindings the player has to OTHER kinds
	-- (set elsewhere) still render on the hotbar mirror; the inventory
	-- grid below is just the source-side filter.
	local hotbarGrid = makeGrid({
		{ Id = 'skills',  Label = 'Skills',  Resolve = InventoryGrid.SkillEntries },
		{ Id = 'food',    Label = 'Food',    Resolve = InventoryGrid.FoodItemEntries },
		{ Id = 'potions', Label = 'Potions', Resolve = InventoryGrid.PotionItemEntries },
	})

	local hotbarPane = scope:New('Frame') {
		Name = 'HotbarPane',
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Visible = scope:Computed(function(use) return use(CurrentSubtab) == 'hotbar' end),
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(PANE_GAP / TAB_DESIGN_H, 0),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- Top pane: hotbar mirror. ~32% of the inner content area
			-- (gives the 2 hotbar rows breathing room above the grid).
			scope:New('Frame') {
				LayoutOrder = 1,
				Size = UDim2.fromScale(1, 0.32),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.4,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.7, Thickness = 1 },
					scope:New('UIPadding') {
						PaddingTop    = UDim.new(INNER_PAD_Y / TAB_DESIGN_H, 0),
						PaddingBottom = UDim.new(INNER_PAD_Y / TAB_DESIGN_H, 0),
						PaddingLeft   = UDim.new(INNER_PAD_X / TAB_DESIGN_W, 0),
						PaddingRight  = UDim.new(INNER_PAD_X / TAB_DESIGN_W, 0),
					},
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding = UDim.new(6 / TAB_DESIGN_H, 0),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					Utils.eyebrow(scope, '\u{25C6} HOTBAR — DROP OR CLICK TO BIND', { LayoutOrder = 1 }),
					scope:New('Frame') {
						LayoutOrder = 2,
						Size = UDim2.new(1, 0, 1, -16),
						BackgroundTransparency = 1,
						[Fusion.Children] = { buildHotbarMirror(scope, DataVersion, StagedEntry,
							function(s) HoverState:set(s) end, drag) },
					},
				},
			},
			-- Bottom pane: inventory grid. ~68% of the inner content
			-- area; both panes' Scale values sum to 1.0 so the parent
			-- list-layout's gap fills any rounding via its Padding entry.
			scope:New('Frame') {
				LayoutOrder = 2,
				Size = UDim2.fromScale(1, 0.68),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.4,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.7, Thickness = 1 },
					scope:New('UIPadding') {
						PaddingTop    = UDim.new(INNER_PAD_Y / TAB_DESIGN_H, 0),
						PaddingBottom = UDim.new(INNER_PAD_Y / TAB_DESIGN_H, 0),
						PaddingLeft   = UDim.new(INNER_PAD_X / TAB_DESIGN_W, 0),
						PaddingRight  = UDim.new(INNER_PAD_X / TAB_DESIGN_W, 0),
					},
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding = UDim.new(0, 6),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					scope:New('Frame') {
						LayoutOrder = 1,
						Size = UDim2.new(1, 0, 0, 16),
						BackgroundTransparency = 1,
						[Fusion.Children] = {
							Utils.eyebrow(scope, '\u{25C6} INVENTORY — DRAG OR CLICK A TILE', { LayoutOrder = 1 }),
							scope:New('TextLabel') {
								AnchorPoint = Vector2.new(1, 0),
								Position = UDim2.fromScale(1, 0),
								Size = UDim2.fromOffset(220, 16),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_MONO,
								TextSize = 10,
								TextColor3 = PALETTE.gold,
								TextXAlignment = Enum.TextXAlignment.Right,
								Text = scope:Computed(function(use)
									local s = use(StagedEntry)
									return s and string.format('STAGED: %s', tostring(s.Label)) or ''
								end),
							},
						},
					},
					scope:New('Frame') {
						LayoutOrder = 2,
						Size = UDim2.new(1, 0, 1, -22),
						BackgroundTransparency = 1,
						[Fusion.Children] = { hotbarGrid.Frame },
					},
				},
			},
		},
	}

	----------------------------------------------------------------------
	-- INVENTORY sub-pane: equip slots column + equippable inventory grid.
	----------------------------------------------------------------------
	local equipSlotEntries = {}
	for slotKey, meta in EQUIP_SLOT_META do
		local cell = buildEquipSlot(scope, slotKey, meta, DataVersion,
			function(s) HoverState:set(s) end, drag)
		cell.LayoutOrder = meta.order
		equipSlotEntries[#equipSlotEntries + 1] = cell
	end
	local equipSlotsFrame = scope:New('Frame') {
		Name = 'EquipSlots',
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIGridLayout') {
				CellSize = UDim2.fromOffset(EQUIP_CELL, EQUIP_CELL),
				CellPadding = UDim2.fromOffset(8, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
			},
			table.unpack(equipSlotEntries),
		},
	}

	local equipGrid = makeGrid({
		{ Id = 'weapons',     Label = 'Weapons',     Resolve = InventoryGrid.WeaponItemEntries },
		{ Id = 'tools',       Label = 'Tools',       Resolve = InventoryGrid.ToolItemEntries },
		{ Id = 'armor',       Label = 'Armor',       Resolve = InventoryGrid.ArmorItemEntries },
		{ Id = 'accessories', Label = 'Accessories', Resolve = InventoryGrid.AccessoryItemEntries },
	})

	-- Inventory sub-pane column widths expressed as design-canvas
	-- fractions (matches CharacterTab's column pattern). The rail width
	-- = 280 design pixels; gap = 12 design pixels; right column is the
	-- remaining scale. Pure-scale widths preserve aspect on resize.
	local INV_RAIL_PX = 280
	local INV_COL_GAP = 12
	local INV_RAIL_SCALE  = INV_RAIL_PX / TAB_DESIGN_W
	local INV_GAP_SCALE   = INV_COL_GAP / TAB_DESIGN_W
	local INV_RIGHT_SCALE = 1 - INV_RAIL_SCALE - INV_GAP_SCALE

	local inventoryPane = scope:New('Frame') {
		Name = 'InventoryPane',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = scope:Computed(function(use) return use(CurrentSubtab) == 'inventory' end),
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(INV_GAP_SCALE, 0),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- Left: equip slots column.
			scope:New('Frame') {
				LayoutOrder = 1,
				Size = UDim2.fromScale(INV_RAIL_SCALE, 1),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.4,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.7, Thickness = 1 },
					scope:New('UIPadding') {
						PaddingTop    = UDim.new(INNER_PAD_Y / TAB_DESIGN_H, 0),
						PaddingBottom = UDim.new(INNER_PAD_Y / TAB_DESIGN_H, 0),
						PaddingLeft   = UDim.new(INNER_PAD_X / TAB_DESIGN_W, 0),
						PaddingRight  = UDim.new(INNER_PAD_X / TAB_DESIGN_W, 0),
					},
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding = UDim.new(8 / TAB_DESIGN_H, 0),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					Utils.eyebrow(scope, '\u{25C6} EQUIPPED', { LayoutOrder = 1 }),
					scope:New('Frame') {
						LayoutOrder = 2,
						Size = UDim2.new(1, 0, 1, -22),
						BackgroundTransparency = 1,
						[Fusion.Children] = { equipSlotsFrame },
					},
				},
			},
			-- Right: inventory grid for equippables.
			scope:New('Frame') {
				LayoutOrder = 2,
				Size = UDim2.fromScale(INV_RIGHT_SCALE, 1),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.4,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.7, Thickness = 1 },
					scope:New('UIPadding') {
						PaddingTop    = UDim.new(INNER_PAD_Y / TAB_DESIGN_H, 0),
						PaddingBottom = UDim.new(INNER_PAD_Y / TAB_DESIGN_H, 0),
						PaddingLeft   = UDim.new(INNER_PAD_X / TAB_DESIGN_W, 0),
						PaddingRight  = UDim.new(INNER_PAD_X / TAB_DESIGN_W, 0),
					},
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding = UDim.new(0, 6),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					Utils.eyebrow(scope, '\u{25C6} INVENTORY — DRAG OR CLICK A TILE', { LayoutOrder = 1 }),
					scope:New('Frame') {
						LayoutOrder = 2,
						Size = UDim2.new(1, 0, 1, -22),
						BackgroundTransparency = 1,
						[Fusion.Children] = { equipGrid.Frame },
					},
				},
			},
		},
	}

	----------------------------------------------------------------------
	-- Assemble the tab.
	----------------------------------------------------------------------
	local subtabBar = buildSubtabBar(scope, CurrentSubtab)
	local tooltip = buildTooltip(scope, HoverState, mousePos)

	-- Wrapper: subtab bar + sub-panes. NOT inside the tab root's main
	-- layout — sibling of the tooltip + drag-ghost so layout lives in
	-- one place.
	-- panesWrapper wraps the subtab bar + active-pane host. Lives at
	-- fromScale(1,1) inside the aspect-locked tab root so its descendants
	-- stay proportional. Outer UIPadding + UIListLayout gap are expressed
	-- as design-canvas fractions (matches CharacterTab's pattern) so they
	-- scale with the tab on smaller screens instead of staying fixed in
	-- pixel space.
	local panesWrapper = scope:New('Frame') {
		Name = 'PanesWrapper',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(OUTER_PAD_Y / TAB_DESIGN_H, 0),
				PaddingBottom = UDim.new(OUTER_PAD_Y / TAB_DESIGN_H, 0),
				PaddingLeft   = UDim.new(OUTER_PAD_X / TAB_DESIGN_W, 0),
				PaddingRight  = UDim.new(OUTER_PAD_X / TAB_DESIGN_W, 0),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(PANE_GAP / TAB_DESIGN_H, 0),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			subtabBar,
			-- Active-pane host. Both panes are siblings; their Visible
			-- bindings track CurrentSubtab so only one shows at a time.
			-- Height fills whatever remains after the 36 px subtab bar
			-- + the layout's per-design gap.
			scope:New('Frame') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 1, -(36 + PANE_GAP)),
				BackgroundTransparency = 1,
				[Fusion.Children] = { hotbarPane, inventoryPane },
			},
		},
	}
	panesWrapper.Parent = rootFrame
	tooltip.Parent = rootFrame

	return rootFrame
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/TabWidget/AchievementsTab"><![CDATA[-- // TabWidget/AchievementsTab.luau //
-- Two-column achievements screen:
--   left  — category rail (PVE / PVP / Progression / Exploration / Crafting /
--           Social / Misc) with completion-count chips.
--   right — scrolling tile list for the selected category. Each tile shows
--           name, description, progress bar (or unlocked-state for
--           predicate achievements), reward chips, and a Claim button when
--           Completed && !Claimed.
--
-- Data sources:
--   * AchievementsConfig.Achievements — registry; drives display + goals +
--     rewards. Hidden achievements only appear once Completed.
--   * PlayerData.Achievements — server-owned per-id state:
--       { Progress, Completed, CompletedAt, Claimed, BadgeAwarded }.
--
-- Claim flow: tile's Claim button fires AchievementClaimEvent with
-- {Action='Claim', Id=<id>}; AchievementsServer validates state +
-- grants rewards. Server replies via AchievementEvent ('Claimed') which
-- ReplicatedData replication picks up — no local optimistic mutation.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local peek   = Fusion.peek
local AchievementsConfig = ReplicatedModules.Data.Achievements
local RemoteService = ReplicatedModules.Services.RemoteService

local AchievementClaimEvent = RemoteService.GetRemote('AchievementClaimEvent', 'RemoteEvent', false)

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local Utils = require(script.Parent.utils)
local Components = require(script.Parent.components)

local Module = {}

-- Category list — display order on the rail. Mirrors AchievementCategory
-- values; if the config grows new categories, add them here too (the
-- rail won't render them otherwise).
local CATEGORIES: {string} = {
	'PVE', 'PVP', 'Progression', 'Exploration', 'Crafting', 'Social', 'Misc',
}

-- Tier glow colors. Fed into the tile's left stripe so high-tier
-- achievements stand out at a glance.
local TIER_COLORS: {[string]: Color3} = {
	Bronze   = Color3.fromRGB(196, 134, 86),
	Silver   = Color3.fromRGB(196, 204, 220),
	Gold     = Color3.fromRGB(255, 215, 138),
	Platinum = Color3.fromRGB(180, 240, 255),
}

-- Tile design canvas. The tile is shape-locked to TILE_ASPECT (≈9:1) via a
-- UIAspectRatioConstraint, so every interior Position/Size is a pure-scale
-- fraction of these design dimensions instead of pixels — the layout then
-- holds at any resolution (custom-roblox-ui §8 / Pitfall 9). Edit the pixel
-- numbers here; the fractions downstream are all `<px> / TILE_CONTENT_*`.
local TILE_DESIGN_W  = 864
local TILE_DESIGN_H  = 96
local TILE_ASPECT    = TILE_DESIGN_W / TILE_DESIGN_H  -- = 9
-- Inset padding (pixels). Child scale Position/Size resolve against the
-- CONTENT box (tile minus this padding), not the full tile.
local TILE_PAD_L, TILE_PAD_R = 16, 12
local TILE_PAD_T, TILE_PAD_B = 10, 10
local TILE_CONTENT_W = TILE_DESIGN_W - TILE_PAD_L - TILE_PAD_R  -- 836
local TILE_CONTENT_H = TILE_DESIGN_H - TILE_PAD_T - TILE_PAD_B  -- 76

----------------------------------------------------------------------
-- Pure helpers — config + save → render data.
----------------------------------------------------------------------

-- Project the live save entry onto a render struct. Defaults handle
-- the "never seen" case where no entry yet exists.
local function readEntry(saveData, id: string)
	local entries = (saveData and saveData.Achievements) or {}
	local e = entries[id]
	if not e then
		return { Progress = 0, Completed = false, Claimed = false }
	end
	return {
		Progress = e.Progress or 0,
		Completed = e.Completed == true,
		Claimed = e.Claimed == true,
	}
end

-- Reward-chip projection. Matches the QuestsTab shape so we can share
-- the chip-row helper later if we factor it out.
local function rewardChipsFromConfig(rewards): { { name: string, color: Color3 } }
	local out = {}
	if not rewards then return out end
	if rewards.Currency and rewards.Currency > 0 then
		table.insert(out, { name = string.format('%d Cor', rewards.Currency), color = PALETTE.gold })
	end
	if rewards.Experience and rewards.Experience > 0 then
		table.insert(out, { name = string.format('%d XP', rewards.Experience), color = Color3.fromRGB(255, 198, 112) })
	end
	if typeof(rewards.Items) == 'table' then
		for itemId, qty in rewards.Items do
			table.insert(out, { name = string.format('%s × %d', tostring(itemId), tonumber(qty) or 1), color = PALETTE.accent })
		end
	end
	if typeof(rewards.Titles) == 'table' then
		for _, titleId in rewards.Titles do
			table.insert(out, { name = 'Title: ' .. tostring(titleId), color = Color3.fromRGB(200, 157, 255) })
		end
	end
	if typeof(rewards.Boosters) == 'table' then
		for _, b in rewards.Boosters do
			table.insert(out, { name = 'Booster: ' .. tostring(b.Id), color = Color3.fromRGB(140, 240, 200) })
		end
	end
	return out
end

----------------------------------------------------------------------
-- Atom: a single chip (label + outline). Reused for reward chips and
-- the Claim button (which is a chip with an Activated handler).
----------------------------------------------------------------------
local function chip(scope, props: { Text: string, Color: Color3, OnClick: (() -> ())? })
	-- AutoButtonColor only exists on TextButton/ImageButton — Fusion
	-- 0.3 errors with `cannotAssignProperty` if we set it on a TextLabel.
	-- Build the prop table conditionally so labels stay clean.
	local isButton = props.OnClick ~= nil
	local className = isButton and 'TextButton' or 'TextLabel'
	local instProps: {[any]: any} = {
		-- Y fills the (scale-sized) Rewards row so the chip scales with the
		-- tile; X auto-sizes to the text. TextScaled + vertical inner padding
		-- render ≈11 px in the row at design res while tracking resolution.
		-- Horizontal padding stays a fixed 8 px inset — AutomaticSize.X +
		-- scale padding would be circular (custom-roblox-ui Pitfall 1 territory).
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		FontFace = HUDCommon.FONT_MONO,
		Text = props.Text,
		TextScaled = true,
		TextColor3 = props.Color,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = props.Color, Transparency = 0.55, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
				PaddingTop = UDim.new(0.27, 0), PaddingBottom = UDim.new(0.27, 0),
			},
		},
	}
	if isButton then
		instProps.AutoButtonColor = false
	end
	local node = scope:New(className)(instProps)
	if props.OnClick then
		node.Activated:Connect(props.OnClick)
	end
	return node
end

----------------------------------------------------------------------
-- Tile builder. One per achievement. Reads progress/completed/claimed
-- through the cfg + save argument. The right-side action area shows
-- either the progress bar (in-flight), the "UNLOCKED" badge (Completed
-- but config has no rewards or already Claimed), or the Claim button.
----------------------------------------------------------------------
-- `selectedCategory` is the StateObject<string> for the active rail
-- selection. Tiles for non-matching categories render Visible=false so
-- the layout doesn't measure them. Combined with the hidden gate
-- inside this function in a single Computed (mutating Visible after
-- construction breaks Fusion's reactive binding).
local function buildTile(scope, ctx, cfg, selectedCategory)
	-- Per-tile reactive state. Recomputed via the Computed below when
	-- ctx.DataVersion bumps — no manual refresh wiring.
	local stripeColor = (cfg.Tier and TIER_COLORS[cfg.Tier]) or PALETTE.accent

	local stateComp = scope:Computed(function(use)
		use(ctx.DataVersion)  -- subscribe
		local saveData = Utils.getPlayerData()
		return readEntry(saveData, cfg.Id)
	end)

	-- Combined visibility gate: in active category AND (not hidden OR
	-- completed). Mutating Visible after construction breaks the Fusion
	-- binding, so the final boolean is computed in one pass.
	--
	-- Perf: non-hidden tiles' Visible only depends on `selectedCategory`
	-- — they DON'T need to subscribe to DataVersion. Subscribing all 18
	-- tiles to DataVersion produces 18 Computed re-runs every 0.25s
	-- (replication tick), which compounded with the resize layout pass
	-- visibly chugged. Branch by `cfg.Hidden` so only the secret tiles
	-- pay the per-tick cost.
	local visibilityComp
	if cfg.Hidden then
		visibilityComp = scope:Computed(function(use)
			if cfg.Category ~= use(selectedCategory) then return false end
			return use(stateComp).Completed
		end)
	else
		visibilityComp = scope:Computed(function(use)
			return cfg.Category == use(selectedCategory)
		end)
	end

	local progressFraction = scope:Computed(function(use)
		local s = use(stateComp)
		if s.Completed then return 1 end
		if not cfg.Goal or cfg.Goal <= 0 then return 0 end
		return math.clamp(s.Progress / cfg.Goal, 0, 1)
	end)

	local progressText = scope:Computed(function(use)
		local s = use(stateComp)
		if cfg.Goal and cfg.Goal > 0 then
			return string.format('%d / %d', math.min(s.Progress, cfg.Goal), cfg.Goal)
		end
		return s.Completed and 'UNLOCKED' or 'LOCKED'
	end)

	-- Claim button visibility. True only when achievement is Completed,
	-- not yet Claimed, AND there's something to claim.
	local hasRewards = cfg.Rewards ~= nil and (
		   (cfg.Rewards.Currency or 0) > 0
		or (cfg.Rewards.Experience or 0) > 0
		or (cfg.Rewards.Items and next(cfg.Rewards.Items) ~= nil)
		or (cfg.Rewards.Titles and #cfg.Rewards.Titles > 0)
		or (cfg.Rewards.Boosters and #cfg.Rewards.Boosters > 0)
	)
	local showClaim = scope:Computed(function(use)
		local s = use(stateComp)
		return s.Completed and (not s.Claimed) and hasRewards
	end)

	local statusText = scope:Computed(function(use)
		local s = use(stateComp)
		if s.Completed and s.Claimed then return 'CLAIMED' end
		if s.Completed then return hasRewards and 'READY TO CLAIM' or 'UNLOCKED' end
		return 'IN PROGRESS'
	end)

	local statusColor = scope:Computed(function(use)
		local s = use(stateComp)
		if s.Completed and s.Claimed then return PALETTE.inkFaint end
		if s.Completed then return PALETTE.success end
		return PALETTE.inkDim
	end)

	local rewardChildren: {any} = {
		scope:New('UIListLayout') {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 6),
		},
	}
	for _, c in rewardChipsFromConfig(cfg.Rewards) do
		table.insert(rewardChildren, chip(scope, { Text = c.name, Color = c.color }))
	end

	-- Tile is shape-locked to TILE_ASPECT (≈9:1) by the
	-- UIAspectRatioConstraint below, so it keeps its designed proportions at
	-- every resolution instead of going wide-and-thin on ultrawide / tall on
	-- narrow. Size carries the width-fill + a TILE_DESIGN_H height cap; with
	-- FitWithinMaxSize the constraint fits the largest 9:1 box inside those
	-- bounds. All interior Position/Size are pure-scale fractions of the
	-- design canvas (see TILE_* constants) — no fixed-pixel children.
	return scope:New('Frame') {
		Name = 'Tile_' .. cfg.Id,
		Size = UDim2.new(1, 0, 0, TILE_DESIGN_H),
		BackgroundColor3 = PALETTE.bg1,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		LayoutOrder = (cfg.Tier == 'Platinum' and 1) or (cfg.Tier == 'Gold' and 2)
		           or (cfg.Tier == 'Silver' and 3) or (cfg.Tier == 'Bronze' and 4) or 5,
		Visible = visibilityComp,
		[Fusion.Children] = {
			scope:New('UIAspectRatioConstraint') {
				AspectRatio = TILE_ASPECT,
				AspectType = Enum.AspectType.FitWithinMaxSize,
				DominantAxis = Enum.DominantAxis.Width,
			},
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.78, Thickness = 1 },
			-- Tier stripe down the tile's TRUE left edge. It's a direct child
			-- of the unpadded tile, so a pure-scale Position/Size reaches the
			-- real edge and spans full height — UIPadding can't pull it inward
			-- because the padding now lives on the inner 'Content' frame below.
			-- Width stays a 3px offset on purpose: a 3px bar expressed as scale
			-- rounds toward ~0 on a wide tile and disappears (custom-roblox-ui
			-- Pitfall 1).
			scope:New('Frame') {
				Name = 'TierStripe',
				Position = UDim2.fromScale(0, 0),
				Size = UDim2.new(0, 3, 1, 0),
				BackgroundColor3 = stripeColor,
				BorderSizePixel = 0,
			},

			-- Padded content layer. Pure-scale (1, 1) fill that carries the
			-- inset padding so the text / progress bar / rewards sit clear of
			-- the stripe. Everything except the border + stripe lives here.
			scope:New('Frame') {
				Name = 'Content',
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					scope:New('UIPadding') {
						PaddingTop = UDim.new(TILE_PAD_T / TILE_DESIGN_H, 0), PaddingBottom = UDim.new(TILE_PAD_B / TILE_DESIGN_H, 0),
						PaddingLeft = UDim.new(TILE_PAD_L / TILE_DESIGN_W, 0), PaddingRight = UDim.new(TILE_PAD_R / TILE_DESIGN_W, 0),
					},

					-- Header row: name (left 75%) + status pill (right 25%).
					-- Y positions/heights are scale fractions of TILE_CONTENT_H.
					scope:New('TextLabel') {
						Position = UDim2.fromScale(0, 0),
						Size = UDim2.new(0.75, 0, 20 / TILE_CONTENT_H, 0),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_DISPLAY,
						Text = cfg.Display.Name,
						-- TextScaled so the glyph tracks its (scale-sized) rect at
						-- every resolution instead of staying a fixed pixel size.
						-- The inner UIPadding trims TextScaled back to the design
						-- proportion (≈18 px in the 20 px rect) — the same
						-- TextScaled+padding idiom used in TabWidget/init.luau.
						TextScaled = true,
						TextColor3 = PALETTE.ink,
						TextXAlignment = Enum.TextXAlignment.Left,
						[Fusion.Children] = {
							scope:New('UIPadding') {
								PaddingTop = UDim.new(0.05, 0), PaddingBottom = UDim.new(0.05, 0),
							},
						},
					},
					scope:New('TextLabel') {
						Name = 'StatusPill',
						AnchorPoint = Vector2.new(1, 0),
						Position = UDim2.new(1, 0, 2 / TILE_CONTENT_H, 0),
						Size = UDim2.new(0.25, 0, 16 / TILE_CONTENT_H, 0),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = statusText,
						TextScaled = true,  -- ≈11 px in the 16 px rect
						TextColor3 = statusColor,
						TextXAlignment = Enum.TextXAlignment.Right,
						[Fusion.Children] = {
							scope:New('UIPadding') {
								PaddingTop = UDim.new(0.16, 0), PaddingBottom = UDim.new(0.16, 0),
							},
						},
					},

					-- Description (full width).
					scope:New('TextLabel') {
						Position = UDim2.fromScale(0, 24 / TILE_CONTENT_H),
						Size = UDim2.new(1, 0, 14 / TILE_CONTENT_H, 0),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_UI,
						Text = cfg.Display.Description,
						TextScaled = true,  -- ≈12 px in the 14 px rect
						TextColor3 = PALETTE.inkDim,
						TextXAlignment = Enum.TextXAlignment.Left,
						[Fusion.Children] = {
							scope:New('UIPadding') {
								PaddingTop = UDim.new(0.07, 0), PaddingBottom = UDim.new(0.07, 0),
							},
						},
					},

					-- Progress bar — left 78% (leaves a scale gutter for the
					-- progress text on the right).
					scope:New('Frame') {
						Name = 'ProgressTrack',
						Position = UDim2.fromScale(0, 46 / TILE_CONTENT_H),
						Size = UDim2.new(0.78, 0, 6 / TILE_CONTENT_H, 0),
						BackgroundColor3 = PALETTE.bg0,
						BorderSizePixel = 0,
						[Fusion.Children] = {
							scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.85, Thickness = 1 },
							scope:New('Frame') {
								Name = 'Fill',
								Size = scope:Computed(function(use)
									return UDim2.fromScale(use(progressFraction), 1)
								end),
								BackgroundColor3 = stripeColor,
								BorderSizePixel = 0,
							},
						},
					},
					scope:New('TextLabel') {
						AnchorPoint = Vector2.new(1, 0),
						Position = UDim2.new(1, 0, 44 / TILE_CONTENT_H, 0),
						Size = UDim2.new(0.20, 0, 12 / TILE_CONTENT_H, 0),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = progressText,
						TextScaled = true,  -- ≈10 px in the 12 px rect
						TextColor3 = PALETTE.inkDim,
						TextXAlignment = Enum.TextXAlignment.Right,
						[Fusion.Children] = {
							scope:New('UIPadding') {
								PaddingTop = UDim.new(0.083, 0), PaddingBottom = UDim.new(0.083, 0),
							},
						},
					},

					-- Reward chip row — left 78% (claim button takes the right gutter).
					scope:New('Frame') {
						Name = 'Rewards',
						Position = UDim2.fromScale(0, 60 / TILE_CONTENT_H),
						Size = UDim2.new(0.78, 0, 24 / TILE_CONTENT_H, 0),
						BackgroundTransparency = 1,
						[Fusion.Children] = rewardChildren,
					},

					-- Claim button — only mounted when Completed && !Claimed && hasRewards.
					scope:New('TextButton') {
						Name = 'ClaimButton',
						AnchorPoint = Vector2.new(1, 1),
						Position = UDim2.fromScale(1, 1),
						Size = UDim2.new(0.20, 0, 24 / TILE_CONTENT_H, 0),
						BackgroundColor3 = PALETTE.success,
						BackgroundTransparency = 0.15,
						BorderSizePixel = 0,
						FontFace = HUDCommon.FONT_BUTTON,
						Text = 'CLAIM',
						TextScaled = true,  -- ≈12 px in the 24 px button rect
						TextColor3 = PALETTE.bg0,
						AutoButtonColor = true,
						Visible = showClaim,
						[Fusion.Children] = {
							scope:New('UIStroke') { Color = PALETTE.success, Transparency = 0.4, Thickness = 1 },
							scope:New('UIPadding') {
								PaddingTop = UDim.new(0.25, 0), PaddingBottom = UDim.new(0.25, 0),
							},
						},
						[Fusion.OnEvent('Activated')] = function()
							AchievementClaimEvent:FireServer(AchievementsConfig.Actions.Claim, { Id = cfg.Id })
						end,
					},
				},
			},
		},
	}
end

----------------------------------------------------------------------
-- Tab build entry. Returns a Frame ready for the TabWidget shell.
----------------------------------------------------------------------
function Module.Build(ctx)
	-- TabWidget hands every tab a context with `.scope` + `.DataVersion`
	-- (see TabWidget/init.luau:tabContext). The scope is owned by the
	-- shell — instances we create here cascade-clean when the shell scope
	-- tears down on CloseWidget.
	local s = ctx.scope
	assert(s, 'AchievementsTab.Build expects ctx.scope (set by TabWidget).')

	-- Selected category — drives which tiles list is mounted on the right.
	local SelectedCategory = s:Value('PVE')

	-- Per-category accounting in one Computed pass — returns { count,
	-- hasClaimable }. Cheaper than two separate Computeds (single
	-- traversal of the registry) and the pair always changes together
	-- on the same DataVersion bump.
	local function categoryStats(category: string)
		return s:Computed(function(use)
			use(ctx.DataVersion)
			local saveData = Utils.getPlayerData()
			local total = 0
			local completed = 0
			local hasClaimable = false
			for _, cfg in AchievementsConfig.Achievements do
				if cfg.Category ~= category then continue end
				if cfg.Hidden then
					-- Hidden achievements don't contribute to the
					-- denominator until completed (would otherwise leak
					-- the existence of the secret).
					local e = readEntry(saveData, cfg.Id)
					if not e.Completed then continue end
				end
				total += 1
				local entry = readEntry(saveData, cfg.Id)
				if entry.Completed then
					completed += 1
					-- "Claimable" = completed but not yet claimed AND
					-- has at least one reward to grant. Hides the
					-- yellow flag for achievements with no rewards
					-- (their Claim button never appears either).
					if not entry.Claimed and cfg.Rewards ~= nil and (
						   (cfg.Rewards.Currency or 0) > 0
						or (cfg.Rewards.Experience or 0) > 0
						or (cfg.Rewards.Items and next(cfg.Rewards.Items) ~= nil)
						or (cfg.Rewards.Titles and #cfg.Rewards.Titles > 0)
						or (cfg.Rewards.Boosters and #cfg.Rewards.Boosters > 0)
					) then
						hasClaimable = true
					end
				end
			end
			return { count = string.format('%d / %d', completed, total), hasClaimable = hasClaimable }
		end)
	end

	-- Build the rail buttons. Bigger height + wider rail + a yellow-
	-- when-claimable label color so the player can see at a glance
	-- which categories have rewards waiting.
	local railChildren: {any} = {
		s:New('UIListLayout') {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
		},
	}
	for i, category in CATEGORIES do
		local isActive = s:Computed(function(use)
			return use(SelectedCategory) == category
		end)
		local stats = categoryStats(category)
		-- Per-category derivations: count text and the claimable flag
		-- both come from `stats` in a single pass. Two cheap Computeds
		-- below project the named field — no extra DataVersion subs.
		local countText = s:Computed(function(use) return use(stats).count end)
		local claimable = s:Computed(function(use) return use(stats).hasClaimable end)
		-- Label color: gold when claimable; otherwise active=accent or
		-- ink baseline. The default label-color logic in RailButton
		-- only fires when labelColor is nil, so we replicate the
		-- isActive-baseline branch here.
		local labelColor = s:Computed(function(use)
			if use(claimable) then return PALETTE.gold end
			return use(isActive) and PALETTE.accent or PALETTE.ink
		end)
		-- Same for the chip's count color so the X/Y readout matches
		-- the label state.
		local chipColor = s:Computed(function(use)
			if use(claimable) then return PALETTE.gold end
			return PALETTE.inkFaint
		end)
		table.insert(railChildren, Components.RailButton(s, {
			isActive = isActive,
			label = category,
			glyph = '◆',
			chip = { text = countText, color = chipColor, width = 64 },
			onActivate = function() SelectedCategory:set(category) end,
			height = 48,
			-- Shape-lock + scale: rail content width ≈ 0.22·1394 − 12 px padding
			-- ≈ 294 px, height 48 → aspect ≈ 6.14. Button + its scaled internals
			-- now grow with the panel instead of staying fixed-pixel.
			aspectRatio = 294 / 48,
			labelColor = labelColor,
			glyphColor = labelColor,
		}))
	end

	-- Build all tiles for all categories up-front; gate visibility by
	-- comparing each tile's category against SelectedCategory. Cheaper
	-- than rebuilding the children list on every category switch and
	-- the tile count is small (<200 even at long-term scale).
	local tileChildren: {any} = {
		s:New('UIListLayout') {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
		},
		s:New('UIPadding') {
			PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
			PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
		},
	}
	for _, cfg in AchievementsConfig.Achievements do
		table.insert(tileChildren, buildTile(s, ctx, cfg, SelectedCategory))
	end

	-- Outer shell. Both columns are scale-sized so the split survives
	-- the tab's aspect-locked design canvas at any screen resolution.
	-- Rail = 22% (wider; bigger buttons fit comfortably with chip),
	-- list = 76% with a 2% scale gutter via positioning. Rail sits
	-- flush against the left edge per design ask.
	return s:New('Frame') {
		Name = 'AchievementsTab',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			-- Left rail — wider + flush-left.
			s:New('Frame') {
				Name = 'CategoryRail',
				AnchorPoint = Vector2.new(0, 0),
				Position = UDim2.fromScale(0, 0),
				Size = UDim2.fromScale(0.22, 1),
				BackgroundColor3 = PALETTE.bg1,
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					s:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.82, Thickness = 1 },
					s:New('UIPadding') {
						PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 14),
						-- Smaller left pad so labels sit closer to the
						-- left edge ("move to the left").
						PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 8),
					},
					table.unpack(railChildren),
				},
			},
			-- Right scroll list.
			s:New('ScrollingFrame') {
				Name = 'AchievementList',
				Position = UDim2.fromScale(0.24, 0),
				Size = UDim2.fromScale(0.76, 1),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ScrollBarThickness = 4,
				ScrollBarImageColor3 = PALETTE.accent,
				ScrollBarImageTransparency = 0.5,
				CanvasSize = UDim2.fromScale(0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollingDirection = Enum.ScrollingDirection.Y,
				ElasticBehavior = Enum.ElasticBehavior.Never,
				[Fusion.Children] = tileChildren,
			},
		},
	}
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/TabWidget/BoostersTab"><![CDATA[-- // TabWidget/BoostersTab.luau //
-- Two-section booster screen:
--   top    — "Active" list. One row per active stack with a live MM:SS
--             countdown, ticked every second from a shared `now` Value.
--   bottom — "History" list. Aggregate row per booster id ever applied:
--             total active seconds + last-ended timestamp.
--
-- Layout note: all sizes use Scale so descendants proportionally fit
-- the TabWidget shell's aspect-locked 1394×648 design canvas. Mixing
-- `UDim2.new(1, -<px>, 1, 0)` with offset widths breaks at non-design
-- resolutions and forces UIListLayout reflows on every resize — both
-- visible as lag and "scale bugs".
--
-- Update strategy: instead of rebuilding the full child list on every
-- ReplicatedData tick (4×/s), we use `Fusion.ForPairs` keyed by uuid /
-- booster id. ForPairs caches per-key sub-scopes and only recreates
-- instances when a key is added/removed — saving 90%+ of the rebuild
-- cost while the same boosters stay active.

local Players = game:GetService('Players')
local RunService = game:GetService('RunService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local BoostersConfig = ReplicatedModules.Data.Boosters

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local Utils = require(script.Parent.utils)

local Module = {}

-- Pixel chrome heights (inside the aspect-locked tab — these stay
-- roughly stable since the design canvas itself is fixed). Widths use
-- Scale so the columns reflow with the tab.
local ACTIVE_ROW_H  = 64
local HISTORY_ROW_H = 36

----------------------------------------------------------------------
-- Pure helpers.
----------------------------------------------------------------------

local function formatRemaining(secondsRemaining: number, isPermanent: boolean): string
	if isPermanent then return '∞' end
	if secondsRemaining <= 0 then return '00:00' end
	local h = math.floor(secondsRemaining / 3600)
	local m = math.floor((secondsRemaining % 3600) / 60)
	local s = math.floor(secondsRemaining % 60)
	if h >= 99 then return '99:00:00+' end
	if h > 0 then return string.format('%02d:%02d:%02d', h, m, s) end
	return string.format('%02d:%02d', m, s)
end

local KIND_LABEL: {[string]: string} = {
	[BoostersConfig.Kinds.ExperienceMul]    = 'XP',
	[BoostersConfig.Kinds.CurrencyMul]      = 'Cor',
	[BoostersConfig.Kinds.LootQuantityMul]  = 'Loot',
	[BoostersConfig.Kinds.LootRarityBias]   = 'Rare',
	[BoostersConfig.Kinds.DamageOutMul]     = 'Dmg',
	[BoostersConfig.Kinds.DamageInMul]      = 'DR',
	[BoostersConfig.Kinds.WalkSpeedAdd]     = 'WS',
	[BoostersConfig.Kinds.SkillCdrMul]      = 'CDR',
	[BoostersConfig.Kinds.CritChanceAdd]    = 'Crit%',
	[BoostersConfig.Kinds.CritDamageMul]    = 'CritDmg',
	[BoostersConfig.Kinds.AttributeXpMul]   = 'Attr',
	[BoostersConfig.Kinds.CompanionXpMul]   = 'Pet',
	[BoostersConfig.Kinds.ReputationMul]    = 'Rep',
	[BoostersConfig.Kinds.BountyDecayMul]   = 'Bounty',
}

local function formatEffect(eff): string
	local label = KIND_LABEL[eff.Kind] or eff.Kind
	if BoostersConfig.IsAddKind(eff.Kind) then
		local sign = eff.Value >= 0 and '+' or ''
		return string.format('%s%s %s', sign, tostring(eff.Value), label)
	end
	local pct = math.floor((eff.Value - 1) * 100 + 0.5)
	if pct == 0 then return string.format('×%s %s', tostring(eff.Value), label) end
	local sign = pct > 0 and '+' or ''
	return string.format('%s%d%% %s', sign, pct, label)
end

----------------------------------------------------------------------
-- Live read of Active map keyed by uuid → { Id, EndsAt, Source }.
-- Returning the raw save table reference (when valid) is fine because
-- ForPairs only diffs the keys/values it sees — and the per-row scope
-- reads any sub-fields it needs reactively via `now`. We DON'T want
-- to clone here: a fresh table per Computed run would invalidate every
-- ForPairs sub-scope, defeating the cache.
----------------------------------------------------------------------
local function activeMap(saveData): {[string]: any}
	if not saveData or typeof(saveData.Boosters) ~= 'table' then return {} end
	local active = saveData.Boosters.Active
	if typeof(active) ~= 'table' then return {} end
	return active
end

local function historyMap(saveData): {[string]: any}
	if not saveData or typeof(saveData.Boosters) ~= 'table' then return {} end
	local h = saveData.Boosters.History
	if typeof(h) ~= 'table' then return {} end
	return h
end

----------------------------------------------------------------------
-- Atom: effect chip.
----------------------------------------------------------------------
local function chip(scope, props: { Text: string, Color: Color3 })
	return scope:New('TextLabel') {
		Size = UDim2.fromOffset(0, 20),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		FontFace = HUDCommon.FONT_MONO,
		Text = props.Text,
		TextSize = 11,
		TextColor3 = props.Color,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = props.Color, Transparency = 0.55, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
			},
		},
	}
end

----------------------------------------------------------------------
-- Active row builder. Called once per uuid via ForPairs — instances
-- persist across DataVersion bumps. The countdown re-reads `now` and
-- `entry.EndsAt` each second.
----------------------------------------------------------------------
local function buildActiveRow(rowScope, now, ctx, uuid: string)
	-- Read latest cfg + entry fresh inside Computeds so that:
	--   * if the active entry is removed, the row's parent ForPairs
	--     destroys this scope (we never see post-removal state)
	--   * if EndsAt changes (admin extension), the timer follows
	local liveData = rowScope:Computed(function(use)
		use(ctx.DataVersion)
		local saveData = Utils.getPlayerData()
		local map = activeMap(saveData)
		local entry = map[uuid]
		if not entry then return nil end
		local cfg = BoostersConfig.GetBoosterConfig(entry.Id)
		return cfg and { entry = entry, cfg = cfg } or nil
	end)

	local displayColorComp = rowScope:Computed(function(use)
		local d = use(liveData)
		if not d then return PALETTE.accent end
		return (d.cfg.Display and d.cfg.Display.Color) or PALETTE.accent
	end)

	local nameText = rowScope:Computed(function(use)
		local d = use(liveData); if not d then return '' end
		return d.cfg.Display.Name or ''
	end)

	local remainingText = rowScope:Computed(function(use)
		use(now)
		local d = use(liveData); if not d then return '' end
		local isPermanent = d.entry.EndsAt == 0
		local rem = isPermanent and 0 or (d.entry.EndsAt - os.time())
		return formatRemaining(rem, isPermanent)
	end)

	local progressFraction = rowScope:Computed(function(use)
		use(now)
		local d = use(liveData); if not d then return 0 end
		if d.entry.EndsAt == 0 or d.cfg.Duration == 0 then return 1 end
		local rem = d.entry.EndsAt - os.time()
		return math.clamp(rem / d.cfg.Duration, 0, 1)
	end)

	-- Effect chips render by walking cfg.Effects once at row build —
	-- the cfg doesn't mutate, so the chip set is fixed for this uuid's
	-- lifetime. Resolve cfg via the latest liveData snapshot. (If
	-- cfg disappears mid-build, the row is about to be destroyed by
	-- ForPairs anyway.)
	local saveDataNow = Utils.getPlayerData()
	local entryNow = activeMap(saveDataNow)[uuid]
	local cfgNow = entryNow and BoostersConfig.GetBoosterConfig(entryNow.Id)
	local effectChildren: {any} = {
		rowScope:New('UIListLayout') {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 6),
		},
	}
	if cfgNow then
		for _, eff in cfgNow.Effects do
			-- Each chip's color is bound to displayColorComp so a config
			-- swap (rare; e.g. dev edits) updates without rebuild.
			table.insert(effectChildren, rowScope:New('TextLabel') {
				Size = UDim2.fromOffset(0, 20),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
				FontFace = HUDCommon.FONT_MONO,
				Text = formatEffect(eff),
				TextSize = 11,
				TextColor3 = displayColorComp,
				[Fusion.Children] = {
					rowScope:New('UIStroke') {
						Color = displayColorComp,
						Transparency = 0.55, Thickness = 1,
					},
					rowScope:New('UIPadding') {
						PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
					},
				},
			})
		end
	end

	return rowScope:New('Frame') {
		Name = 'Active_' .. uuid,
		-- Width fills parent; height pixel-locked to the design canvas's
		-- chrome height. Tab's UIAspectRatioConstraint scales the canvas.
		Size = UDim2.new(1, 0, 0, ACTIVE_ROW_H),
		BackgroundColor3 = PALETTE.bg1,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			rowScope:New('UIStroke') {
				Color = displayColorComp, Transparency = 0.65, Thickness = 1,
			},
			-- Accent stripe (pixel-thin so it doesn't dominate at small sizes).
			rowScope:New('Frame') {
				Name = 'AccentStripe',
				Size = UDim2.new(0, 3, 1, 0),
				BackgroundColor3 = displayColorComp,
				BorderSizePixel = 0,
			},
			rowScope:New('UIPadding') {
				PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
				PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 12),
			},

			-- Top row: name (scale-width left side) + countdown (scale-width right).
			rowScope:New('TextLabel') {
				Size = UDim2.fromScale(0.7, 0.27),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = nameText,
				TextSize = 14,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextScaled = false,
			},
			rowScope:New('TextLabel') {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.fromScale(1, 0),
				Size = UDim2.fromScale(0.3, 0.27),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = remainingText,
				TextSize = 14,
				TextColor3 = displayColorComp,
				TextXAlignment = Enum.TextXAlignment.Right,
			},

			-- Effect chips — under the name row.
			rowScope:New('Frame') {
				AnchorPoint = Vector2.new(0, 0),
				Position = UDim2.fromScale(0, 0.32),
				Size = UDim2.fromScale(1, 0.4),
				BackgroundTransparency = 1,
				[Fusion.Children] = effectChildren,
			},

			-- Time bar pinned to the bottom edge.
			rowScope:New('Frame') {
				Name = 'TimeTrack',
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.fromScale(0, 1),
				Size = UDim2.new(1, 0, 0, 4),
				BackgroundColor3 = PALETTE.bg0,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					rowScope:New('UIStroke') {
						Color = displayColorComp, Transparency = 0.85, Thickness = 1,
					},
					rowScope:New('Frame') {
						Name = 'Fill',
						Size = rowScope:Computed(function(use)
							return UDim2.fromScale(use(progressFraction), 1)
						end),
						BackgroundColor3 = displayColorComp,
						BorderSizePixel = 0,
					},
				},
			},
		},
	}
end

----------------------------------------------------------------------
-- History row. Static; only its content text re-binds when the per-id
-- aggregate changes via the parent's DataVersion subscription.
----------------------------------------------------------------------
local function buildHistoryRow(rowScope, ctx, boosterId: string)
	local liveAgg = rowScope:Computed(function(use)
		use(ctx.DataVersion)
		local saveData = Utils.getPlayerData()
		local h = historyMap(saveData)[boosterId]
		local cfg = BoostersConfig.GetBoosterConfig(boosterId)
		return { cfg = cfg, hist = h or { TotalSeconds = 0, LastEndedAt = 0 } }
	end)

	local nameText = rowScope:Computed(function(use)
		local a = use(liveAgg)
		return (a.cfg and a.cfg.Display and a.cfg.Display.Name) or boosterId
	end)
	local timeText = rowScope:Computed(function(use)
		local total = use(liveAgg).hist.TotalSeconds or 0
		local hours = total / 3600
		if hours >= 1 then return string.format('%.1f h total', hours) end
		return string.format('%d min total', math.floor(total / 60))
	end)
	local lastText = rowScope:Computed(function(use)
		local last = use(liveAgg).hist.LastEndedAt or 0
		if last <= 0 then return 'Last: —' end
		return 'Last: ' .. os.date('%Y-%m-%d %H:%M', last)
	end)

	return rowScope:New('Frame') {
		Name = 'Hist_' .. boosterId,
		Size = UDim2.new(1, 0, 0, HISTORY_ROW_H),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.4,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			rowScope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.86, Thickness = 1 },
			rowScope:New('UIPadding') {
				PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
				PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
			},
			rowScope:New('TextLabel') {
				Size = UDim2.fromScale(0.5, 1),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = nameText,
				TextSize = 13,
				TextColor3 = PALETTE.inkDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
			rowScope:New('TextLabel') {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.fromScale(1, 0),
				Size = UDim2.fromScale(0.5, 0.5),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = timeText,
				TextSize = 11,
				TextColor3 = PALETTE.inkDim,
				TextXAlignment = Enum.TextXAlignment.Right,
			},
			rowScope:New('TextLabel') {
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.fromScale(1, 1),
				Size = UDim2.fromScale(0.5, 0.5),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = lastText,
				TextSize = 10,
				TextColor3 = PALETTE.inkFaint,
				TextXAlignment = Enum.TextXAlignment.Right,
			},
		},
	}
end

----------------------------------------------------------------------
-- Section header.
----------------------------------------------------------------------
local function sectionHeader(scope, label: string, countComp)
	return scope:New('Frame') {
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('TextLabel') {
				Size = UDim2.fromScale(0.7, 1),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = '◆ ' .. string.upper(label),
				TextSize = 11,
				TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.fromScale(1, 0),
				Size = UDim2.fromScale(0.3, 1),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = countComp,
				TextSize = 11,
				TextColor3 = PALETTE.inkFaint,
				TextXAlignment = Enum.TextXAlignment.Right,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
		},
	}
end

----------------------------------------------------------------------
-- Build entry.
----------------------------------------------------------------------
function Module.Build(ctx)
	local s = ctx.scope
	assert(s, 'BoostersTab.Build expects ctx.scope (set by TabWidget).')

	-- Local 1Hz countdown ticker. RunService.Heartbeat is 60Hz; we cap
	-- to 1Hz so the countdown's per-row Computed only re-runs once per
	-- visible second (clock format is second-resolution anyway).
	local now = s:Value(os.clock())
	local lastTick = os.clock()
	local conn = RunService.Heartbeat:Connect(function()
		local t = os.clock()
		if t - lastTick < 1 then return end
		lastTick = t
		now:set(t)
	end)
	-- Scope cleanup queue takes plain functions; they fire on doCleanup.
	table.insert(s :: any, function() conn:Disconnect() end)

	-- Active "key map" — the map ForPairs reads. We materialize this
	-- as { [uuid] = endsAt } so ForPairs's value-comparison is on a
	-- primitive (number) — the sub-scope only invalidates when EndsAt
	-- actually changes, not on every DataVersion bump that returns the
	-- same booster.
	local activeKeysMap = s:Computed(function(use)
		use(ctx.DataVersion)
		local saveData = Utils.getPlayerData()
		local out = {}
		for uuid, entry in activeMap(saveData) do
			out[uuid] = entry.EndsAt or 0
		end
		return out
	end)

	-- History "key map" — { [boosterId] = LastEndedAt }. Same primitive-
	-- value rationale as above.
	local historyKeysMap = s:Computed(function(use)
		use(ctx.DataVersion)
		local saveData = Utils.getPlayerData()
		local out = {}
		for boosterId, hist in historyMap(saveData) do
			out[boosterId] = hist.LastEndedAt or 0
		end
		return out
	end)

	local activeCount = s:Computed(function(use)
		local m = use(activeKeysMap)
		local n = 0
		for _ in m do n += 1 end
		return string.format('%d active', n)
	end)
	local historyCount = s:Computed(function(use)
		local m = use(historyKeysMap)
		local n = 0
		for _ in m do n += 1 end
		return string.format('%d ever', n)
	end)

	-- Empty-state labels (Visible-bound — no rebuild churn).
	local activeEmpty = s:Computed(function(use)
		for _ in use(activeKeysMap) do return false end
		return true
	end)
	local historyEmpty = s:Computed(function(use)
		for _ in use(historyKeysMap) do return false end
		return true
	end)

	return s:New('Frame') {
		Name = 'BoostersTab',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			s:New('UIPadding') {
				PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
				PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
			},
			s:New('UIListLayout') {
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 8),
			},

			-- ACTIVE.
			s:New('Frame') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 22),
				BackgroundTransparency = 1,
				[Fusion.Children] = { sectionHeader(s, 'Active boosters', activeCount) },
			},
			-- The active section auto-grows on Y. Empty state TextLabel is
			-- a sibling that's only Visible when no rows; the row container
			-- itself is also a sibling, hidden when empty.
			s:New('Frame') {
				LayoutOrder = 2,
				Name = 'ActiveSection',
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					s:New('UIListLayout') {
						SortOrder = Enum.SortOrder.LayoutOrder,
						Padding = UDim.new(0, 6),
					},
					s:New('TextLabel') {
						LayoutOrder = 0,
						Size = UDim2.new(1, 0, 0, 28),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_UI,
						Text = 'No active boosters.',
						TextSize = 13,
						TextColor3 = PALETTE.inkFaint,
						TextXAlignment = Enum.TextXAlignment.Left,
						Visible = activeEmpty,
					},
					s:ForPairs(activeKeysMap, function(use, innerScope, uuid, _endsAt)
						return uuid, buildActiveRow(innerScope, now, ctx, uuid)
					end),
				},
			},

			-- HISTORY.
			s:New('Frame') {
				LayoutOrder = 3,
				Size = UDim2.new(1, 0, 0, 22),
				BackgroundTransparency = 1,
				[Fusion.Children] = { sectionHeader(s, 'Booster inventory', historyCount) },
			},
			s:New('ScrollingFrame') {
				LayoutOrder = 4,
				Name = 'HistorySection',
				-- Width 100% of tab; height fills the remaining tab space
				-- via a flex remainder. Switching from
				-- `UDim2.new(1, 0, 1, -150)` to a scaled remainder removes
				-- the resolution-dependent layout break.
				Size = UDim2.fromScale(1, 0.55),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ScrollBarThickness = 4,
				ScrollBarImageColor3 = PALETTE.accent,
				ScrollBarImageTransparency = 0.5,
				CanvasSize = UDim2.fromScale(0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollingDirection = Enum.ScrollingDirection.Y,
				ElasticBehavior = Enum.ElasticBehavior.Never,
				[Fusion.Children] = {
					s:New('UIListLayout') {
						SortOrder = Enum.SortOrder.LayoutOrder,
						Padding = UDim.new(0, 4),
					},
					s:New('TextLabel') {
						LayoutOrder = 0,
						Size = UDim2.new(1, 0, 0, 24),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_UI,
						Text = 'Booster inventory is empty.',
						TextSize = 12,
						TextColor3 = PALETTE.inkFaint,
						TextXAlignment = Enum.TextXAlignment.Left,
						Visible = historyEmpty,
					},
					s:ForPairs(historyKeysMap, function(use, innerScope, boosterId, _lastEndedAt)
						return boosterId, buildHistoryRow(innerScope, ctx, boosterId)
					end),
				},
			},
		},
	}
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/TabWidget/LeaderboardTab"><![CDATA[-- // TabWidget/LeaderboardTab.luau //
-- Two-column leaderboard screen:
--   left  — category rail (Total Damage / PvP / Highest Level / …)
--   right — top-N rank list for the selected category
--
-- Data source: the public 'Leaderboard' ReplicatedData category,
-- written by LeaderboardServer once per CycleSec. The tab re-renders
-- whenever ReplicatedData.OnUpdated fires for that category (server
-- publish). DataVersion bumps on the TabWidget shell don't drive the
-- list — the leaderboard cycle is independent of per-player save
-- replication.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local LeaderboardConfig = ReplicatedModules.Data.LeaderboardConfig
local ReplicatedData = ReplicatedModules.Services.ReplicatedData

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local LeaderboardClient = LocalModules.Modules.LeaderboardClient
local PALETTE   = HUDCommon.PALETTE

local Components = require(script.Parent:WaitForChild('components'))

local Module = {}

----------------------------------------------------------------------
-- Helpers — value formatting per category. Most are integer counters;
-- PlayTime is rendered as Hh Mm rather than raw seconds for legibility.
----------------------------------------------------------------------
local function formatHMS(secs: number): string
	local h = math.floor(secs / 3600)
	local m = math.floor((secs % 3600) / 60)
	if h > 0 then return string.format('%dh %dm', h, m) end
	if m > 0 then return string.format('%dm', m) end
	return string.format('%ds', math.floor(secs))
end

local function formatNumber(n: number): string
	-- Compact for big numbers (12.3K, 4.5M) so the row chrome doesn't
	-- get pushed by a 9-digit gold count.
	if n >= 1e6 then return string.format('%.1fM', n / 1e6) end
	if n >= 1e4 then return string.format('%.1fK', n / 1e3) end
	return tostring(math.floor(n))
end

local function formatValue(categoryId: string, n: number): string
	if categoryId == 'PlayTime' then return formatHMS(n) end
	return formatNumber(n)
end

----------------------------------------------------------------------
-- Atom: a single leaderboard row. Rank pip + name + value. Highlights
-- the LocalPlayer's row in gold.
----------------------------------------------------------------------
local function buildRow(scope, rank: number, entry: any, categoryId: string)
	local isYou = entry.userId == LocalPlayer.UserId
	local nameText = entry.name and string.upper(entry.name) or string.format('#%d', entry.userId)
	-- Top-3 chrome: gold/silver/bronze rank pip; everyone else uses the
	-- plain rank number. Visual hierarchy without a separate atom.
	local rankColor = (rank == 1 and Color3.fromRGB(255, 215, 138))
		or (rank == 2 and Color3.fromRGB(196, 204, 220))
		or (rank == 3 and Color3.fromRGB(196, 134, 86))
		or PALETTE.inkFaint
	return scope:New('Frame') {
		Name = 'Row_' .. rank,
		Size = UDim2.new(1, 0, 0, 28),
		BackgroundColor3 = isYou and PALETTE.gold or PALETTE.bg1,
		BackgroundTransparency = isYou and 0.78 or 0.2,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = isYou and PALETTE.gold or PALETTE.accent,
				Transparency = isYou and 0.4 or 0.82, Thickness = 1,
			},
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
			},
			scope:New('TextLabel') {
				Size = UDim2.fromScale(0.10, 1),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = string.format('%02d', rank),
				TextSize = 13,
				TextColor3 = rankColor,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
			scope:New('TextLabel') {
				Position = UDim2.fromScale(0.12, 0),
				Size = UDim2.fromScale(0.58, 1),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = nameText,
				TextSize = 13,
				TextColor3 = isYou and PALETTE.gold or PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
				TextTruncate = Enum.TextTruncate.AtEnd,
			},
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.fromScale(1, 0),
				Size = UDim2.fromScale(0.30, 1),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = formatValue(categoryId, entry.value),
				TextSize = 13,
				TextColor3 = isYou and PALETTE.gold or PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Right,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
		},
	}
end

----------------------------------------------------------------------
-- Build entry. Returns the tab Frame for the TabWidget shell.
----------------------------------------------------------------------
function Module.Build(ctx)
	local s = ctx.scope
	assert(s, 'LeaderboardTab.Build expects ctx.scope')

	-- SnapshotVersion bumps every time ReplicatedData reports a
	-- 'Leaderboard' update — drives the right-side row list rebuild.
	-- Decoupled from ctx.DataVersion (which tracks PlayerData) so
	-- per-player saves don't trigger a leaderboard re-fetch.
	local SnapshotVersion = s:Value(0)
	local SelectedCategory = s:Value(LeaderboardConfig.Categories[1] and LeaderboardConfig.Categories[1].Id or '')

	-- Subscribe ReplicatedData updates. Cleanup registered with the
	-- scope so the connection drops on TabWidget tear-down (theme
	-- rebuild, widget close).
	local conn = ReplicatedData.OnUpdated:Connect(function(category)
		if category == LeaderboardConfig.PublicCategory then
			SnapshotVersion:set((Fusion.peek(SnapshotVersion) or 0) + 1)
		end
	end)
	table.insert(s :: any, function() conn:Disconnect() end)

	-- Rail buttons — one per category. Each button switches
	-- SelectedCategory. Active state styled by the shared RailButton
	-- component (active stripe + accent label).
	local railChildren: {any} = {
		s:New('UIListLayout') {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
		},
	}
	for _, def in LeaderboardConfig.Categories do
		local capturedDef = def
		local isActive = s:Computed(function(use)
			return use(SelectedCategory) == capturedDef.Id
		end)
		table.insert(railChildren, Components.RailButton(s, {
			isActive = isActive,
			label = capturedDef.Label,
			glyph = '◆',
			onActivate = function() SelectedCategory:set(capturedDef.Id) end,
			height = 38,
			-- Shape-lock + scale: rail content width ≈ 0.22·1394 − 12 px padding
			-- ≈ 294 px, height 38 → aspect ≈ 7.74. Button + scaled internals
			-- track the panel instead of staying fixed-pixel.
			aspectRatio = 294 / 38,
		}))
	end

	-- "Last updated" eyebrow — shows how stale the snapshot is so
	-- players know when to expect the next refresh.
	local updatedText = s:Computed(function(use)
		use(SnapshotVersion)
		local snap = LeaderboardClient.GetSnapshot()
		local t = (typeof(snap) == 'table' and tonumber(snap.Updated)) or 0
		if t == 0 then return '◆ AWAITING FIRST PUBLISH' end
		local delta = math.max(0, os.time() - t)
		if delta < 60 then return string.format('◆ UPDATED %ds AGO', delta) end
		return string.format('◆ UPDATED %dm AGO', math.floor(delta / 60))
	end)

	-- Right column entry rows. Rebuilds when either the snapshot
	-- changes or the selected category changes.
	local rowsChildren = s:Computed(function(use)
		local _ = use(SnapshotVersion)
		local catId = use(SelectedCategory)
		local entries = LeaderboardClient.GetCategoryEntries(catId)
		local children: {any} = {
			s:New('UIListLayout') {
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 4),
			},
		}
		if #entries == 0 then
			table.insert(children, s:New('TextLabel') {
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = 'Awaiting first publish — board fills on the next cycle.',
				TextSize = 13,
				TextColor3 = PALETTE.inkFaint,
				TextXAlignment = Enum.TextXAlignment.Left,
			})
		else
			for rank, entry in entries do
				table.insert(children, buildRow(s, rank, entry, catId))
			end
		end
		return children
	end)

	return s:New('Frame') {
		Name = 'LeaderboardTab',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			-- Left rail.
			s:New('Frame') {
				Name = 'CategoryRail',
				AnchorPoint = Vector2.new(0, 0),
				Position = UDim2.fromScale(0, 0),
				Size = UDim2.fromScale(0.22, 1),
				BackgroundColor3 = PALETTE.bg1,
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					s:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.82, Thickness = 1 },
					s:New('UIPadding') {
						PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 14),
						PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 8),
					},
					table.unpack(railChildren),
				},
			},
			-- Right list — header + rows.
			s:New('Frame') {
				Name = 'List',
				Position = UDim2.fromScale(0.24, 0),
				Size = UDim2.fromScale(0.76, 1),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					s:New('UIPadding') {
						PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
						PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
					},
					s:New('UIListLayout') {
						SortOrder = Enum.SortOrder.LayoutOrder,
						Padding = UDim.new(0, 6),
					},
					-- Eyebrow row: category label + updated-ago.
					s:New('Frame') {
						LayoutOrder = 1,
						Size = UDim2.new(1, 0, 0, 20),
						BackgroundTransparency = 1,
						[Fusion.Children] = {
							s:New('TextLabel') {
								Size = UDim2.fromScale(0.6, 1),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_DISPLAY,
								Text = s:Computed(function(use)
									local id = use(SelectedCategory)
									local def = LeaderboardConfig.GetCategory(id)
									return string.upper(def and def.Label or '')
								end),
								TextSize = 18,
								TextColor3 = PALETTE.ink,
								TextXAlignment = Enum.TextXAlignment.Left,
							},
							s:New('TextLabel') {
								AnchorPoint = Vector2.new(1, 0),
								Position = UDim2.fromScale(1, 0),
								Size = UDim2.fromScale(0.4, 1),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_MONO,
								Text = updatedText,
								TextSize = 11,
								TextColor3 = PALETTE.inkFaint,
								TextXAlignment = Enum.TextXAlignment.Right,
								TextYAlignment = Enum.TextYAlignment.Center,
							},
						},
					},
					-- Scrolling row list. Auto canvas Y grows with rows;
					-- each row is fixed-height so 25 entries fit without
					-- compression at the design canvas.
					s:New('ScrollingFrame') {
						LayoutOrder = 2,
						Size = UDim2.new(1, 0, 1, -28),
						BackgroundTransparency = 1,
						BorderSizePixel = 0,
						ScrollBarThickness = 4,
						ScrollBarImageColor3 = PALETTE.accent,
						ScrollBarImageTransparency = 0.5,
						CanvasSize = UDim2.fromScale(0, 0),
						AutomaticCanvasSize = Enum.AutomaticSize.Y,
						ScrollingDirection = Enum.ScrollingDirection.Y,
						ElasticBehavior = Enum.ElasticBehavior.Never,
						[Fusion.Children] = rowsChildren,
					},
				},
			},
		},
	}
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/CombatLogWidget"><![CDATA[-- Combat-log indicator pill (bottom-left corner).
--
-- Visible while CombatLog.IsInCombat() is true — mirrors the MusicWidget
-- pill shape (chiseled panel + UIAspectRatioConstraint + Scale-sized
-- corner anchor) so the HUD vocabulary stays consistent. The progress
-- bar drains the COMBAT_LOG_DURATION countdown; when it hits zero the
-- pill fades out via CanvasGroup transparency.
--
-- Why a separate widget (vs. baking into HotbarWidget):
--   * Independently positioned at a corner, not inside the hotbar cluster.
--   * Subscribes to CombatLog without coupling combat UI to hotbar state.
--   * Lives long enough across deaths/respawns that fade-in/out reads
--     coherently — Hotbar rebuilds its scope on respawn.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local RunService = game:GetService('RunService')
local TweenService = game:GetService('TweenService')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local doCleanup = Fusion.doCleanup

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local CombatLog = LocalModules.Modules.CombatLog
local PALETTE = HUDCommon.PALETTE

local SystemsContainer = {}

local Module = {}
Module.IsOpen = false

local RootScope = nil
local ScreenGui = nil
local InCombat   = nil -- Value<boolean>
local Remaining  = nil -- Value<number>   seconds left in the combat-log window
local DrainAlpha = nil -- Value<number>   1 = full bar, 0 = empty

----------------------------------------------------------------------
-- Design dimensions (pixels on a 1920×1080 reference canvas).
-- Mirrors MusicWidget; see that file for the design rationale (Scale-
-- sized pill + aspect-lock so the inner pixel design is stable).
----------------------------------------------------------------------
local DESIGN_SCREEN_W, DESIGN_SCREEN_H = 1920, 1080

local DESIGN_PILL_W, DESIGN_PILL_H = 280, 70
local DESIGN_PILL_PAD_X            = 14
local DESIGN_PILL_PAD_Y            = 10

local DESIGN_EYEBROW_H = 12
local DESIGN_TITLE_H   = 22
local DESIGN_BAR_H     = 6
local DESIGN_TIMER_W   = 70
local DESIGN_META_H    = 14
local DESIGN_TITLE_GAP = 4
local DESIGN_BAR_GAP   = 4

local DESIGN_CONTENT_W = DESIGN_PILL_W - 2 * DESIGN_PILL_PAD_X
local DESIGN_CONTENT_H = DESIGN_PILL_H - 2 * DESIGN_PILL_PAD_Y

-- Anchor BOTTOM-LEFT (vs MusicWidget's bottom-right) so the two pills
-- live on opposite corners and never overlap.
local ANCHOR_INSET_X = 20 / DESIGN_SCREEN_W
local ANCHOR_INSET_Y = 20 / DESIGN_SCREEN_H

function Module.IsWidgetOpen(): boolean
	return Module.IsOpen and ScreenGui ~= nil
end

local function buildUI(scope)
	-- CanvasGroup wrapper so we can fade the entire pill in/out by
	-- tweening GroupTransparency rather than per-descendant transparency.
	-- The Tween reads use(InCombat) so it animates automatically when
	-- combat state flips.
	local fadeAlpha = scope:Computed(function(use)
		return use(InCombat) and 0 or 1
	end)
	local tweenedAlpha = scope:Tween(
		fadeAlpha,
		TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	)

	local pill = HUDCommon.chiseledPanel(scope, {
		Name = 'CombatLogPill',
		Size = UDim2.fromScale(DESIGN_PILL_W / DESIGN_SCREEN_W, DESIGN_PILL_H / DESIGN_SCREEN_H),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(ANCHOR_INSET_X, 1 - ANCHOR_INSET_Y),
		AccentColor = PALETTE.danger,
		AspectRatio = DESIGN_PILL_W / DESIGN_PILL_H,
		Children = {
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(DESIGN_PILL_PAD_Y / DESIGN_PILL_H, 0),
				PaddingBottom = UDim.new(DESIGN_PILL_PAD_Y / DESIGN_PILL_H, 0),
				PaddingLeft   = UDim.new(DESIGN_PILL_PAD_X / DESIGN_PILL_W, 0),
				PaddingRight  = UDim.new(DESIGN_PILL_PAD_X / DESIGN_PILL_W, 0),
			},

			-- Eyebrow "⚔ IN COMBAT" — danger color so the player's eye
			-- catches the warning quickly. Same eyebrow vocabulary as
			-- the music pill's "♪ NOW PLAYING".
			HUDCommon.eyebrowLabel(scope, {
				Text = '\u{2694} IN COMBAT',
				Color = PALETTE.danger,
				Size = UDim2.fromScale(1, DESIGN_EYEBROW_H / DESIGN_CONTENT_H),
				TextSize = 11,
			}),

			-- Title row — descriptive sub-text. Static for now; this is
			-- a candidate slot for richer messaging later (e.g. "Hit by
			-- Boar", "PvP engagement"). Pulled from a Computed so any
			-- future state-driven text drops in cleanly.
			scope:New('TextLabel') {
				Name = 'Title',
				Position = UDim2.fromScale(0, (DESIGN_EYEBROW_H + DESIGN_TITLE_GAP) / DESIGN_CONTENT_H),
				Size = UDim2.fromScale(1, DESIGN_TITLE_H / DESIGN_CONTENT_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				TextSize = 16,
				TextColor3 = PALETTE.ink,
				Text = 'Cannot fast-travel',
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
				TextTruncate = Enum.TextTruncate.AtEnd,
			},

			-- Countdown readout, anchored bottom-right above the bar.
			-- "5.3s" style — 1-decimal formatting so the bar tick reads
			-- as a smooth number rather than a jumpy integer.
			scope:New('TextLabel') {
				Name = 'Timer',
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.fromScale(1, 1 - (DESIGN_BAR_H + DESIGN_BAR_GAP) / DESIGN_CONTENT_H),
				Size = UDim2.fromScale(DESIGN_TIMER_W / DESIGN_CONTENT_W, DESIGN_META_H / DESIGN_CONTENT_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				TextSize = 12,
				TextColor3 = PALETTE.danger,
				Text = scope:Computed(function(use)
					return string.format('%.1fs', math.max(0, use(Remaining) or 0))
				end),
				TextXAlignment = Enum.TextXAlignment.Right,
				TextYAlignment = Enum.TextYAlignment.Center,
			},

			-- Drain bar pinned to bottom of content area. Width tracks
			-- DrainAlpha (1 = fresh combat, 0 = window expired) so the
			-- bar visually retreats as combat-log expires.
			scope:New('Frame') {
				Name = 'Progress',
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.fromScale(0, 1),
				Size = UDim2.fromScale(1, DESIGN_BAR_H / DESIGN_CONTENT_H),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.3,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					scope:New('Frame') {
						Name = 'Bar',
						Size = scope:Computed(function(use)
							return UDim2.fromScale(math.clamp(use(DrainAlpha) or 0, 0, 1), 1)
						end),
						BackgroundColor3 = PALETTE.danger,
						BorderSizePixel = 0,
					},
				},
			},
		},
	})

	-- Wrap the pill in a CanvasGroup so the fade tween applies uniformly
	-- to every descendant in a single pass. Always Visible — the fade
	-- alone hides the pill (GroupTransparency=1 → fully invisible). The
	-- pill has no interactive children so we don't need to gate input.
	local root = scope:New('CanvasGroup') {
		Name = 'CombatLogRoot',
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(ANCHOR_INSET_X, 1 - ANCHOR_INSET_Y),
		Size = UDim2.fromScale(DESIGN_PILL_W / DESIGN_SCREEN_W, DESIGN_PILL_H / DESIGN_SCREEN_H),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		GroupTransparency = tweenedAlpha,
		[Fusion.Children] = {
			scope:New('UIAspectRatioConstraint') {
				AspectRatio = DESIGN_PILL_W / DESIGN_PILL_H,
				AspectType = Enum.AspectType.FitWithinMaxSize,
				DominantAxis = Enum.DominantAxis.Width,
			},
		},
	}
	-- Reparent the pill INTO the CanvasGroup; the chiseledPanel above
	-- carries its own pixel design so we just override its position to
	-- sit at (0,0) inside the wrapper and let the wrapper handle the
	-- screen-corner anchoring.
	pill.AnchorPoint = Vector2.new(0, 0)
	pill.Position = UDim2.fromScale(0, 0)
	pill.Size = UDim2.fromScale(1, 1)
	pill.Parent = root
	root.Parent = ScreenGui
end

function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true
	ScreenGui = HUDCommon.ensureScreenGui('HUD_CombatLog', 5)
	RootScope = scoped(Fusion)

	InCombat   = RootScope:Value(false)
	Remaining  = RootScope:Value(0)
	DrainAlpha = RootScope:Value(0)

	buildUI(RootScope)
end

function Module.CloseWidget()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
end

function Module.Start()
	-- Single Heartbeat watcher. CombatLog.IsInCombat is process-cheap
	-- (timestamp subtract) so polling at frame-rate is fine — no need
	-- for an event-driven Bump signal here.
	RunService.Heartbeat:Connect(function()
		if not Module.IsWidgetOpen() then return end
		local inCombat = CombatLog.IsInCombat()
		local remaining = CombatLog.SecondsRemaining()
		local total = CombatLog.COMBAT_LOG_DURATION
		InCombat:set(inCombat)
		Remaining:set(remaining)
		DrainAlpha:set(total > 0 and (remaining / total) or 0)
	end)

	HUDCommon.BindLiveTheme(Module)

	task.defer(Module.OpenWidget)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/ToastWidget"><![CDATA[-- Toast notifications widget. Stack of corner-anchored cards that
-- auto-dismiss after TOAST_LIFETIME seconds. Receives cues from
-- ToastServer over ToastEvent. Visual: chiseled-panel pill, rarity-tinted
-- accent stroke, eyebrow tag (ITEM / TITLE / AURA / LEVEL), title row.
--
-- Stack management: every toast lives in a `Toasts` array; the widget
-- rebuilds the stack frame each frame the array changes by bumping a
-- DataVersion-style Fusion Value. Toasts auto-fade out 0.4s before
-- removal so the stack appears to dissolve, not pop.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped    = Fusion.scoped
local doCleanup = Fusion.doCleanup
local peek      = Fusion.peek
local RemoteService = ReplicatedModules.Services.RemoteService

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

-- Cross-widget hook. Other HUD widgets (MusicWidget) want to fade
-- themselves when toasts are present so the toast stack reads
-- without competing UI noise. We expose a count + a signal-style
-- table of subscribers; this keeps the toast widget the single
-- source of truth without Fusion-crossing scopes.
local SignalLib = ReplicatedModules.Modules.Signal
local OnCountChangedSignal = SignalLib.New('ToastWidget_OnCountChanged')

local ToastEvent         = RemoteService.GetRemote('ToastEvent', 'RemoteEvent', false)
-- Outbound — fired when the player clicks a button on a buttoned
-- toast. Server-side ToastServer.Start dispatches the registered
-- handler keyed by toastId.
local ToastResponseEvent = RemoteService.GetRemote('ToastResponseEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}
Module.IsOpen = false

local RootScope = nil
local ScreenGui = nil
local ToastList = nil  -- Fusion Value<{Toast}>; Toast = { id, kind, title, subtitle, color, expiresAt, rarity? }

local TOAST_LIFETIME           = 4.5
local TOAST_LIFETIME_BUTTONED  = 12.0  -- buttoned toasts hang around longer for a click
local FADE_OUT = 0.4
local DESIGN_TOAST_W, DESIGN_TOAST_H = 280, 56
-- Heights for the two layout variants. Buttoned toasts append a button row;
-- the aspect constraint reads one of these depending on `toast.buttons`.
local DESIGN_TOAST_H_BUTTONED = 86   -- 56 + ROW_BTN_H(28) + ROW_GAP(2)
local DESIGN_SCREEN_W, DESIGN_SCREEN_H = 1920, 1080
-- Bottom-right inset (in design pixels) — the stack's bottom-right corner
-- sits this many px in from the viewport's bottom-right corner. Matches
-- the visual margin other corner-anchored widgets use (CombatLogWidget etc).
local STACK_INSET_PX = 16

-- Inner row heights — used by both the no-button and buttoned
-- variants so the layout stays predictable. Total no-button height:
-- pad-top(8) + eyebrow(12) + gap(2) + title(22) + gap(2) + subtitle(14)
-- + pad-bottom(8) ≈ 56px (matches DESIGN_TOAST_H).
local ROW_EYEBROW_H = 12
local ROW_TITLE_H   = 22
local ROW_SUB_H     = 14
local ROW_BTN_H     = 28
local ROW_GAP       = 2
local PAD_V         = 8
local PAD_H         = 12

local KIND_LABEL = {
	item      = '◆ ITEM',
	title     = '◆ TITLE',
	aura      = '◆ AURA',
	level     = '◆ LEVEL',
	attribute = '◆ ATTRIBUTE',
	request   = '◆ REQUEST',
	generic   = '◆ NOTICE',
}

local KIND_ACCENT = {
	item = function(p, rarity)
		local rarities = HUDCommon.RARITY
		local raritiesArr = { rarities.common, rarities.uncommon, rarities.rare,
		                     rarities.epic, rarities.legendary, rarities.mythic }
		return raritiesArr[rarity or 1] or p.accent
	end,
	title     = function(p) return p.violet end,
	aura      = function(p) return p.accent end,
	level     = function(p) return p.success end,
	-- Attribute — softer than full level-up; matches the subtler
	-- effect's cyan-tinged particle palette.
	attribute = function(p) return p.accent end,
	-- Requests draw the eye — gold reads as "action needed" without
	-- alarming like danger.
	request   = function(p) return p.gold end,
	generic   = function(p) return p.accent end,
}

function Module.IsWidgetOpen(): boolean
	return Module.IsOpen and ScreenGui ~= nil
end

-- Cross-widget API. Returns the live toast-stack count and the
-- signal that fires whenever it changes (push or auto-dismiss).
-- MusicWidget binds its pill transparency to this — see
-- MusicWidget.Start's Module.OnToastCountChanged hookup.
function Module.GetActiveCount(): number
	if not ToastList then return 0 end
	local current = peek(ToastList)
	return current and #current or 0
end
Module.OnCountChanged = OnCountChangedSignal

-- Internal: fire the signal exactly when the list mutates. Pulled out
-- so push/remove paths share one notification site.
local function notifyCount()
	OnCountChangedSignal:Fire(Module.GetActiveCount())
end

----------------------------------------------------------------------
-- Toast list mutation helpers.
----------------------------------------------------------------------
local _nextId = 0

-- Remove a toast from the list by local entry id. Used by both the
-- auto-dismiss timer and button clicks (buttoned toasts dismiss
-- immediately on click rather than waiting for the lifetime).
local function removeToast(localId: number)
	if not ToastList then return end
	local current = peek(ToastList) or {}
	local out = {}
	for _, t in current do
		if t.id ~= localId then table.insert(out, t) end
	end
	ToastList:set(out)
	notifyCount()
end

local function pushToast(kind: string, payload: any)
	if not ToastList then return end
	_nextId += 1
	local now = os.clock()
	-- Buttons + ToastId originate on the server (NotifyWithButtons).
	-- Empty/nil button list flips this to a regular auto-dismiss toast.
	local hasButtons = typeof(payload.Buttons) == 'table' and #payload.Buttons > 0
	local lifetime = hasButtons and TOAST_LIFETIME_BUTTONED or TOAST_LIFETIME
	local entry = {
		id        = _nextId,
		kind      = kind,
		title     = payload.Title or '',
		subtitle  = payload.Subtitle or '',
		color     = payload.Color,
		rarity    = payload.Rarity,
		buttons   = hasButtons and payload.Buttons or nil,
		serverId  = payload.ToastId,  -- echoed back when a button fires
		expiresAt = now + lifetime,
	}
	local list = peek(ToastList) or {}
	local copy = {}; for i, t in list do copy[i] = t end
	table.insert(copy, 1, entry)  -- newest on top
	-- Cap stack at 6 so a flood doesn't push the panel off-screen.
	while #copy > 6 do table.remove(copy) end
	ToastList:set(copy)
	notifyCount()

	task.delay(lifetime, function() removeToast(entry.id) end)
end

----------------------------------------------------------------------
-- UI build.
----------------------------------------------------------------------
-- Build one button inside a buttoned toast. Pixel-stretched within
-- the buttons row. On click: fires the inbound response remote with
-- the toast's serverId + this button's action string, then removes
-- the toast locally so the player gets immediate feedback. Transparencies
-- are constant — the parent CanvasGroup's GroupTransparency multiplies
-- the fade across every descendant uniformly.
local function buildToastButton(scope, toast, button)
	local fillColor = button.Color or PALETTE.bg1
	return scope:New('TextButton') {
		Name = 'Btn_' .. tostring(button.Action),
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = fillColor,
		BackgroundTransparency = 0.20,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		FontFace = HUDCommon.FONT_UI,
		Text = '  ' .. (button.Label or '?') .. '  ',
		TextSize = 13,
		TextColor3 = PALETTE.ink,
		[Fusion.OnEvent('Activated')] = function()
			-- ServerId can be nil if the server-side push didn't go
			-- through NotifyWithButtons — defensive bail keeps the
			-- click from firing a bogus response.
			if typeof(toast.serverId) == 'number' then
				ToastResponseEvent:FireServer(toast.serverId, button.Action)
			end
			removeToast(toast.id)
		end,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = PALETTE.accent,
				Transparency = 0.5,
				Thickness = 1,
			},
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
			},
		},
	}
end

-- Optional button row. Returns nil when the toast has no buttons —
-- callers filter nils out of the children list.
local function buildButtonRow(scope, toast)
	if not toast.buttons or #toast.buttons == 0 then return nil end
	local children: { any } = {
		scope:New('UIListLayout') {
			FillDirection      = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment  = Enum.VerticalAlignment.Center,
			Padding            = UDim.new(0, 6),
			SortOrder          = Enum.SortOrder.LayoutOrder,
		},
	}
	for i, btn in toast.buttons do
		local node = buildToastButton(scope, toast, btn)
		node.LayoutOrder = i
		children[#children + 1] = node
	end
	return scope:New('Frame') {
		Name = 'ButtonRow',
		LayoutOrder = 4,
		Size = UDim2.new(1, 0, 0, ROW_BTN_H),
		BackgroundTransparency = 1,
		[Fusion.Children] = children,
	}
end

local function buildToast(scope, toast)
	local accent = (KIND_ACCENT[toast.kind] or KIND_ACCENT.generic)(PALETTE, toast.rarity)
	if toast.color then accent = toast.color end
	local lifetime = toast.buttons and TOAST_LIFETIME_BUTTONED or TOAST_LIFETIME
	local hasButtons = toast.buttons and #toast.buttons > 0

	-- Fade is driven by a single Fusion `Value` flipped 0 → 1 at the start
	-- of the fade window, then `scope:Tween` smooths the transition. The
	-- tweened number is bound to a CanvasGroup.GroupTransparency on the
	-- outer wrapper so the entire toast (background + stroke + every text
	-- + button) fades as ONE rasterized layer — replaces the old per-
	-- property transparency Computeds that had to fan out to UIStroke,
	-- each TextLabel.TextTransparency, and the button's stroke alpha.
	local fadeTrigger = scope:Value(0)
	local groupAlpha = scope:Tween(
		fadeTrigger,
		TweenInfo.new(FADE_OUT, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	)

	-- Kick the fade at lifetime - FADE_OUT. Pure single :set — no manual
	-- per-frame lerp loop. If the toast is already removed (button click,
	-- stack overflow eviction) the Value is in a torn-down scope; check
	-- scope-life via the Fusion field rather than a stale upvalue.
	task.delay(lifetime - FADE_OUT, function()
		if fadeTrigger then fadeTrigger:set(1) end
	end)

	-- Children list: eyebrow + title + subtitle, then optional buttons.
	-- Every transparency below is a CONSTANT — the CanvasGroup wrapper
	-- multiplies its GroupTransparency over each descendant, so we only
	-- have to drive one tween (groupAlpha) to fade the whole card.
	local children: { any } = {
		scope:New('UIStroke') {
			Color = accent,
			Transparency = 0.4,
			Thickness = 1,
		},
		scope:New('UIPadding') {
			PaddingTop    = UDim.new(0, PAD_V), PaddingBottom = UDim.new(0, PAD_V),
			PaddingLeft   = UDim.new(0, PAD_H), PaddingRight  = UDim.new(0, PAD_H),
		},
		scope:New('UIListLayout') {
			FillDirection = Enum.FillDirection.Vertical,
			Padding       = UDim.new(0, ROW_GAP),
			SortOrder     = Enum.SortOrder.LayoutOrder,
		},
		-- Eyebrow.
		scope:New('TextLabel') {
			LayoutOrder = 1,
			Size = UDim2.new(1, 0, 0, ROW_EYEBROW_H),
			BackgroundTransparency = 1,
			FontFace = HUDCommon.FONT_MONO,
			Text = KIND_LABEL[toast.kind] or KIND_LABEL.generic,
			TextSize = 11,
			TextColor3 = accent,
			TextXAlignment = Enum.TextXAlignment.Left,
		},
		-- Title.
		scope:New('TextLabel') {
			LayoutOrder = 2,
			Size = UDim2.new(1, 0, 0, ROW_TITLE_H),
			BackgroundTransparency = 1,
			FontFace = HUDCommon.FONT_DISPLAY,
			Text = toast.title,
			TextSize = 18,
			TextColor3 = PALETTE.ink,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		},
		-- Subtitle.
		scope:New('TextLabel') {
			LayoutOrder = 3,
			Size = UDim2.new(1, 0, 0, ROW_SUB_H),
			BackgroundTransparency = 1,
			FontFace = HUDCommon.FONT_UI,
			Text = toast.subtitle,
			TextSize = 12,
			TextColor3 = PALETTE.inkDim,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		},
	}

	-- Optional button row appended last (LayoutOrder=4). The row no longer
	-- needs the `alpha` plumb — its descendants ride the CanvasGroup fade.
	local btnRow = buildButtonRow(scope, toast)
	if btnRow then children[#children + 1] = btnRow end

	-- Pixel-design height for this toast variant. Both axes are locked so
	-- the UIAspectRatioConstraint below has a stable shape to enforce —
	-- AutomaticSize.Y was dropped because it fights the aspect lock (the
	-- constraint would back-derive width from content height once
	-- AutomaticSize bumped the height).
	local designH = hasButtons and DESIGN_TOAST_H_BUTTONED or DESIGN_TOAST_H

	return scope:New('CanvasGroup') {
		Name = 'Toast_' .. tostring(toast.id),
		LayoutOrder = -toast.id,   -- newest on top
		Size = UDim2.fromScale(DESIGN_TOAST_W / DESIGN_SCREEN_W, designH / DESIGN_SCREEN_H),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		-- One tweened value drives the whole card's fade. Re-rasterization
		-- is cheap here — the texture is ~280×56 px (or ~280×86 for
		-- buttoned variants), well under the "don't wrap large panels"
		-- caution in the UI skill guide. We only animate GroupTransparency
		-- (never Size), so the off-screen texture is rasterized once and
		-- reused for the entire fade.
		GroupTransparency = groupAlpha,
		[Fusion.Children] = {
			-- Shape lock so the toast keeps its designed proportions on
			-- screens with different aspect ratios. FitWithinMaxSize +
			-- DominantAxis=Width: width comes from the fromScale above,
			-- height is forced to width / aspect.
			scope:New('UIAspectRatioConstraint') {
				AspectRatio = DESIGN_TOAST_W / designH,
				AspectType = Enum.AspectType.FitWithinMaxSize,
				DominantAxis = Enum.DominantAxis.Width,
			},
			table.unpack(children),
		},
	}
end

local function buildUI(scope)
	scope:New('Frame') {
		Name = 'ToastStack',
		-- Bottom-right anchored. Bottom-right corner of the stack sits
		-- STACK_INSET_PX in from the viewport's bottom-right corner. The
		-- stack height is 60% of viewport so the layout has room for the
		-- max-6 toast cap without overflowing. VerticalAlignment.Bottom
		-- + LayoutOrder = -toast.id (newest on top) means new toasts
		-- appear ABOVE existing toasts which stay anchored at the bottom
		-- edge — the standard "notifications pile up bottom-right" feel.
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -STACK_INSET_PX, 1, -STACK_INSET_PX),
		Size = UDim2.fromScale(DESIGN_TOAST_W / DESIGN_SCREEN_W, 0.6),
		BackgroundTransparency = 1,
		Parent = ScreenGui,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				HorizontalAlignment = Enum.HorizontalAlignment.Right,
				VerticalAlignment = Enum.VerticalAlignment.Bottom,
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:ForPairs(ToastList, function(_use, innerScope, idx, toast)
				return toast.id, buildToast(innerScope, toast)
			end),
		},
	}
end

function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true
	ScreenGui = HUDCommon.ensureScreenGui('HUD_Toasts', 30)
	RootScope = scoped(Fusion)
	ToastList = RootScope:Value({})
	buildUI(RootScope)
end

function Module.CloseWidget()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
end

function Module.Start()
	HUDCommon.BindLiveTheme(Module)

	ToastEvent.OnClientEvent:Connect(function(kind, payload)
		pushToast(kind, payload or {})
	end)

	task.defer(Module.OpenWidget)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/OnboardingWidget"><![CDATA[-- Onboarding overlay tooltip. Bottom-center pill that shows the current
-- step's title + body text, with a "Got it" button that fires a
-- MarkComplete event. Hidden when CurrentStep is nil (player completed
-- onboarding or hasn't started).

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped    = Fusion.scoped
local doCleanup = Fusion.doCleanup
local peek      = Fusion.peek
local RemoteService = ReplicatedModules.Services.RemoteService

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local OnboardingData = ReplicatedModules.Data.Onboarding
local Actions = OnboardingData.Actions

local OnboardingEvent = RemoteService.GetRemote('OnboardingEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}
Module.IsOpen = false

local RootScope = nil
local ScreenGui = nil
local CurrentStep = nil  -- Fusion Value<stepId | nil>

function Module.IsWidgetOpen(): boolean
	return Module.IsOpen and ScreenGui ~= nil
end

----------------------------------------------------------------------
-- Spotlight overlay. Four frames form an inverse cutout around the
-- highlight rect — together they darken the rest of the screen while
-- leaving the highlighted area visible. UDim2 fromScale so a 1080p +
-- 4K screen both render the right hole. Anchor selectors:
--
--   'screen_rect' — Position/Size from cfg directly.
--   'tab_chip'    — TODO: resolve via TabWidget. For now, falls back to
--                   no-highlight (skips the cutout) so the system stays
--                   non-blocking until that integration lands.
--   'world_part'  — projects InstancePath's world position to viewport
--                   each frame. Implemented inline below.
----------------------------------------------------------------------
local function buildSpotlightOverlay(scope, holeRect)
	-- holeRect is a Computed<UDim2 (pos), UDim2 (size), boolean (visible)>.
	-- Four darkening frames: top / bottom / left / right of the hole.
	-- BackgroundTransparency 0.4 reads as soft dim, not black-out.
	local DARK = 0.4
	local function panel(name, pos, size)
		return scope:New('Frame') {
			Name = name,
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = scope:Computed(function(use)
				return use(holeRect).visible and DARK or 1
			end),
			BorderSizePixel = 0,
			Position = pos, Size = size,
		}
	end
	-- Each side runs from screen edge to the corresponding edge of the
	-- hole rect. Positions / sizes derived from the hole's Pos+Size.
	return {
		-- TOP: from screen top to hole top.
		scope:New('Frame') {
			Name = 'SpotlightTop',
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = scope:Computed(function(use)
				return use(holeRect).visible and DARK or 1
			end),
			BorderSizePixel = 0,
			Position = UDim2.fromScale(0, 0),
			Size = scope:Computed(function(use)
				local r = use(holeRect)
				return UDim2.fromScale(1, math.max(0, r.pos.Y))
			end),
		},
		-- BOTTOM: from hole bottom to screen bottom.
		scope:New('Frame') {
			Name = 'SpotlightBottom',
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = scope:Computed(function(use)
				return use(holeRect).visible and DARK or 1
			end),
			BorderSizePixel = 0,
			Position = scope:Computed(function(use)
				local r = use(holeRect)
				return UDim2.fromScale(0, math.min(1, r.pos.Y + r.size.Y))
			end),
			Size = scope:Computed(function(use)
				local r = use(holeRect)
				return UDim2.fromScale(1, math.max(0, 1 - (r.pos.Y + r.size.Y)))
			end),
		},
		-- LEFT: between top + bottom panels, from screen left to hole left.
		scope:New('Frame') {
			Name = 'SpotlightLeft',
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = scope:Computed(function(use)
				return use(holeRect).visible and DARK or 1
			end),
			BorderSizePixel = 0,
			Position = scope:Computed(function(use)
				local r = use(holeRect)
				return UDim2.fromScale(0, r.pos.Y)
			end),
			Size = scope:Computed(function(use)
				local r = use(holeRect)
				return UDim2.fromScale(math.max(0, r.pos.X), r.size.Y)
			end),
		},
		-- RIGHT: between top + bottom panels, from hole right to screen right.
		scope:New('Frame') {
			Name = 'SpotlightRight',
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = scope:Computed(function(use)
				return use(holeRect).visible and DARK or 1
			end),
			BorderSizePixel = 0,
			Position = scope:Computed(function(use)
				local r = use(holeRect)
				return UDim2.fromScale(math.min(1, r.pos.X + r.size.X), r.pos.Y)
			end),
			Size = scope:Computed(function(use)
				local r = use(holeRect)
				return UDim2.fromScale(math.max(0, 1 - (r.pos.X + r.size.X)), r.size.Y)
			end),
		},
		-- Caption beneath the cutout (small mono label, accent-colored).
		scope:New('TextLabel') {
			Name = 'SpotlightCaption',
			AnchorPoint = Vector2.new(0.5, 0),
			Position = scope:Computed(function(use)
				local r = use(holeRect)
				return UDim2.fromScale(r.pos.X + r.size.X * 0.5, math.min(0.98, r.pos.Y + r.size.Y + 0.01))
			end),
			Size = UDim2.fromScale(0.4, 0.025),
			BackgroundTransparency = 1,
			FontFace = HUDCommon.FONT_MONO,
			TextSize = 12,
			TextColor3 = PALETTE.accent,
			TextTransparency = scope:Computed(function(use)
				return use(holeRect).visible and 0.1 or 1
			end),
			Text = scope:Computed(function(use) return use(holeRect).caption or '' end),
		},
	}
end

local function buildUI(scope)
	local stepData = scope:Computed(function(use)
		local id = use(CurrentStep); if not id then return nil end
		return OnboardingData.Steps[id]
	end)
	-- Compute the spotlight hole rect from the step's Highlight cfg.
	-- Returns { pos: Vector2, size: Vector2, visible: bool, caption: string? }
	-- in fromScale (0..1) units. Each render path resolves to that
	-- shape so the SpotlightOverlay branches are uniform.
	local holeRect = scope:Computed(function(use)
		local s = use(stepData)
		if not s or not s.Highlight then
			return { pos = Vector2.new(0, 0), size = Vector2.new(0, 0), visible = false }
		end
		local hl = s.Highlight
		if hl.Anchor == 'screen_rect' and hl.Position and hl.Size then
			return {
				pos = hl.Position, size = hl.Size,
				visible = true, caption = hl.Caption or s.Title,
			}
		elseif hl.Anchor == 'world_part' and hl.InstancePath then
			-- Resolve the part by path; project to viewport scale.
			-- Server-authored InstancePath strings travel through to
			-- here via the OnboardingData config; CinematicShared has
			-- the resolver but we inline a minimal one to avoid the
			-- import.
			local node: any = workspace
			for _, segment in string.split(hl.InstancePath, '.') do
				if segment == 'workspace' then continue end
				if not node then break end
				node = node:FindFirstChild(segment)
			end
			local part = (node and node:IsA('BasePart')) and node or nil
			local camera = workspace.CurrentCamera
			if not part or not camera then
				return { pos = Vector2.new(), size = Vector2.new(), visible = false }
			end
			local screen, onScreen = camera:WorldToViewportPoint(part.Position)
			if not onScreen or screen.Z <= 0 then
				return { pos = Vector2.new(), size = Vector2.new(), visible = false }
			end
			local viewport = camera.ViewportSize
			-- 80×80 px hole centered on the projected point — designers
			-- can tune by pulling these numbers off cfg if needed.
			local W, H = viewport.X, viewport.Y
			local boxW, boxH = 120 / W, 120 / H
			return {
				pos = Vector2.new(screen.X / W - boxW * 0.5, screen.Y / H - boxH * 0.5),
				size = Vector2.new(boxW, boxH),
				visible = true,
				caption = hl.Caption or s.Title,
			}
		end
		-- 'tab_chip' or unknown anchor: TODO when TabWidget integration lands.
		return { pos = Vector2.new(), size = Vector2.new(), visible = false }
	end)

	-- Spotlight cutout panels — rendered first so the panel below
	-- draws on top.
	for _, panel in buildSpotlightOverlay(scope, holeRect) do
		(panel :: any).Parent = ScreenGui
	end

	scope:New('Frame') {
		Name = 'OnboardingPanel',
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 0.85),
		Size = UDim2.fromScale(420 / 1920, 96 / 1080),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		Visible = scope:Computed(function(use) return use(stepData) ~= nil end),
		Parent = ScreenGui,
		[Fusion.Children] = {
			scope:New('UIAspectRatioConstraint') {
				AspectRatio = 420 / 96,
				AspectType = Enum.AspectType.FitWithinMaxSize,
				DominantAxis = Enum.DominantAxis.Width,
			},
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
				PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14),
			},
			scope:New('TextLabel') {
				Size = UDim2.new(1, 0, 0, 14),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = '◆ TUTORIAL',
				TextSize = 11,
				TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				Position = UDim2.new(0, 0, 0, 16),
				Size = UDim2.new(1, 0, 0, 22),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = scope:Computed(function(use) local s = use(stepData); return s and s.Title or '' end),
				TextSize = 18,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
			},
			scope:New('TextLabel') {
				Position = UDim2.new(0, 0, 0, 38),
				Size = UDim2.new(1, -100, 1, -38),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = scope:Computed(function(use) local s = use(stepData); return s and s.Body or '' end),
				TextSize = 13,
				TextColor3 = PALETTE.inkDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
			},
			scope:New('TextButton') {
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, 0, 1, 0),
				Size = UDim2.fromOffset(90, 28),
				BackgroundColor3 = PALETTE.bg1,
				BackgroundTransparency = 0.25,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				FontFace = HUDCommon.FONT_BUTTON,
				Text = 'GOT IT',
				TextSize = 12,
				TextColor3 = PALETTE.ink,
				[Fusion.OnEvent('Activated')] = function()
					local id = peek(CurrentStep); if not id then return end
					OnboardingEvent:FireServer(Actions.MarkComplete, id)
				end,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
				},
			},
		},
	}
end

function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true
	ScreenGui = HUDCommon.ensureScreenGui('HUD_Onboarding', 28)
	RootScope = scoped(Fusion)
	CurrentStep = RootScope:Value(nil)
	buildUI(RootScope)
end

function Module.CloseWidget()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
end

function Module.Start()
	HUDCommon.BindLiveTheme(Module)

	OnboardingEvent.OnClientEvent:Connect(function(action, ...)
		if action == Actions.StepChanged then
			local stepId = ...
			if CurrentStep then CurrentStep:set(stepId) end
		end
	end)

	task.defer(Module.OpenWidget)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/CinematicTestWidget"><![CDATA[-- CinematicTestWidget — F4 toggle. Buttons for every cinematic /
-- shake / VFX / camera-shot / dialogue id so the cinematic stack
-- can be exercised end-to-end without code changes.
--
-- Routing:
--   * Cinematics → fired via CinematicTestEvent → CinematicServer
--   * Shake / VFX → CinematicClient.PlayCue (client-direct; testing
--                   the cue surface, not the network path)
--   * Camera shots → CinematicCharacter against the first tagged
--                    'DialogueNPC' instance, falling back to the
--                    local character when no NPC is in scene.
--   * Dialogue → CinematicTestEvent → DialogueNPCServer
--
-- Studio: open by default in playtest. Live: opens only on F4 press
-- (the panel is hidden until pressed). The CinematicTestServer's
-- auth gate is what actually keeps the buttons inert in live for
-- non-admin players — the widget is just a UI surface.

local Players          = game:GetService('Players')
local UserInputService = game:GetService('UserInputService')
local CollectionService = game:GetService('CollectionService')

local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local Fusion    = ReplicatedModules.Libraries.Fusion
local scoped    = Fusion.scoped
local doCleanup = Fusion.doCleanup

local CinematicShared  = ReplicatedModules.Services.CinematicShared
local CinematicTestShared = ReplicatedModules.Services.CinematicTestShared
local CinematicPresets = ReplicatedModules.Data.CinematicPresets
local Cinematics       = ReplicatedModules.Data.Cinematics
local DialogueData     = ReplicatedModules.Data.Dialogue
local RemoteService    = ReplicatedModules.Services.RemoteService

local CinematicTestEvent = RemoteService.GetRemote('CinematicTestEvent', 'RemoteEvent', false)

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

-- Test-server action enum — the shared CinematicTestEvent protocol. Single
-- source of truth in Services.CinematicTestShared; both this widget and
-- CinematicTestServer reference it, so the two can't drift.
local TestActions = CinematicTestShared.Actions

local SystemsContainer = {}

local Module = {}
Module.IsOpen = false

local ScreenGui: ScreenGui? = nil
local RootScope = nil

-- Persistent toggle button — separate ScreenGui so it stays visible
-- whether the panel is open or closed. Built once in Start() and never
-- torn down; the panel's ScreenGui is what gets created/destroyed on
-- open/close. Sits above the hotbar (centered, just below midline-bottom).
local ToggleScreenGui: GuiObject? = nil
local ToggleScope = nil

-- Snap toggle state. Set once at scope-create; passed into shot
-- helpers so users can compare snap-cut vs lerp on the same preset.
local SnapState = nil  -- Fusion Value<boolean>

----------------------------------------------------------------------
-- Helpers — resolution of dependencies + target for shots.
----------------------------------------------------------------------
local function getCinematicClient()
	local c = SystemsContainer.CinematicClient
		or (SystemsContainer.ParentSystems and SystemsContainer.ParentSystems.Effects
			and SystemsContainer.ParentSystems.Effects.CinematicClient)
	return c
end

local function getCinematicCharacter()
	local c = SystemsContainer.CinematicCharacter
		or (SystemsContainer.ParentSystems and SystemsContainer.ParentSystems.Effects
			and SystemsContainer.ParentSystems.Effects.CinematicCharacter)
	return c
end

-- Pick a model to frame for shot tests. Preference order:
--   1. First model tagged 'DialogueNPC' (matches the NPC server's tag).
--   2. Local player's character.
local function getShotTarget(): Model?
	for _, inst in CollectionService:GetTagged('DialogueNPC') do
		if inst:IsA('Model') then return inst end
	end
	return LocalPlayer.Character
end

----------------------------------------------------------------------
-- Action handlers — what each button does. Pulled out of the render
-- so the layout stays focused on layout.
----------------------------------------------------------------------
local function playCinematic(id: string)
	CinematicTestEvent:FireServer(TestActions.PlayCinematic, id)
end

local function openDialogue(id: string)
	CinematicTestEvent:FireServer(TestActions.OpenDialogue, id)
end

-- New: skill-runtime / boss / telegraph debug fan-out. Each forwards
-- to CinematicTestServer with a single string payload (recipe id,
-- mob id, telegraph kind, phase index as string).
local function runRecipe(id: string)
	CinematicTestEvent:FireServer(TestActions.RunRecipe, id)
end
local function testTelegraph(kind: string)
	CinematicTestEvent:FireServer(TestActions.TestTelegraph, kind)
end
local function spawnMob(mobId: string)
	CinematicTestEvent:FireServer(TestActions.SpawnMob, mobId)
end
local function setBossPhase(idx: number)
	CinematicTestEvent:FireServer(TestActions.SetBossPhase, tostring(idx))
end

local function fireShake(presetName: string)
	local client = getCinematicClient()
	if not client then return end
	local p = CinematicPresets.ResolveShake(presetName)
	client.PlayCue(CinematicShared.CueKind.CameraShake, {
		Magnitude = p.Magnitude, Roughness = p.Roughness, Duration = p.Duration,
		FadeIn = p.FadeIn, FadeOut = p.FadeOut,
	})
end

local function fireVFX(presetName: string)
	print(string.format('[CinematicTestWidget] fireVFX preset=%s', tostring(presetName)))
	local client = getCinematicClient()
	if not client then
		warn('[CinematicTestWidget] fireVFX: CinematicClient not in SystemsContainer; cue dropped')
		return
	end
	local p = CinematicPresets.ResolveVFX(presetName)
	-- Test surface: always anchor to the local player's HRP regardless
	-- of the preset's DefaultAnchor — keeps the effect attached to the
	-- player so the tester sees it without chasing world coords.
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild('HumanoidRootPart')
	if not hrp then
		warn('[CinematicTestWidget] fireVFX: local character has no HumanoidRootPart yet; firing camera-anchored fallback')
	end
	local args: { [string]: any } = {
		TemplateName = p.Template,
		Duration     = p.Duration,
		Anchor       = 'instance',
		InstancePath = hrp and hrp:GetFullName() or nil,
	}
	client.PlayCue(CinematicShared.CueKind.PlayVFX, args)
end

local function fireShot(presetName: string, snap: boolean)
	local cinematic = getCinematicCharacter()
	if not cinematic then return end
	local target = getShotTarget()
	if not target then return end
	cinematic.SetShot(target, presetName, { Snap = snap, Hold = 2.5 })
end

local function fireCameraReset()
	local cinematic = getCinematicCharacter()
	if cinematic and cinematic.Reset then cinematic.Reset(); return end
	local client = getCinematicClient()
	if client then client.PlayCue(CinematicShared.CueKind.CameraReset, {}) end
end

----------------------------------------------------------------------
-- UI primitives — small, local. Not promoting to HUDCommon since
-- they're test-widget specific (chiseledPanel + eyebrowLabel are
-- the only shared atoms used).
----------------------------------------------------------------------
local function buttonRow(scope, label: string, onClick: () -> ())
	return scope:New('TextButton') {
		Name        = 'Btn_' .. label,
		Size        = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = PALETTE.bg1,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		FontFace    = HUDCommon.FONT_UI,
		TextSize    = 13,
		TextColor3  = PALETTE.ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text        = '  ' .. label,
		[Fusion.OnEvent('Activated')] = onClick,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = PALETTE.accent, Transparency = 0.75, Thickness = 1,
			},
		},
	}
end

local function sectionFrame(scope, title: string, buttons: { any })
	return scope:New('Frame') {
		Name = 'Section_' .. title,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding       = UDim.new(0, 4),
				SortOrder     = Enum.SortOrder.LayoutOrder,
			},
			HUDCommon.eyebrowLabel(scope, {
				Text = '\u{25C6} ' .. string.upper(title),
				Color = PALETTE.accent,
				Size = UDim2.new(1, 0, 0, 14),
				TextSize = 11,
				LayoutOrder = 0,
			}),
			scope:New('Frame') {
				Name = 'Buttons',
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding       = UDim.new(0, 3),
						SortOrder     = Enum.SortOrder.LayoutOrder,
					},
					table.unpack(buttons),
				},
			},
		},
	}
end

----------------------------------------------------------------------
-- Sections — built lazily so the preset tables are read at open-time
-- (a runtime preset add via Studio iteration is reflected on next
-- F4 toggle without restarting the place).
----------------------------------------------------------------------
local function cinematicButtons(scope)
	local btns = {}
	local ids = {}
	for id in Cinematics.Cinematics do ids[#ids + 1] = id end
	table.sort(ids)
	for i, id in ids do
		btns[#btns + 1] = scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			[Fusion.Children] = { buttonRow(scope, id, function() playCinematic(id) end) },
		}
	end
	return btns
end

local function shakeButtons(scope)
	local btns = {}
	for i, name in CinematicPresets.ListShakes() do
		btns[#btns + 1] = scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			[Fusion.Children] = { buttonRow(scope, name, function() fireShake(name) end) },
		}
	end
	return btns
end

local function vfxButtons(scope)
	local btns = {}
	for i, name in CinematicPresets.ListVFX() do
		btns[#btns + 1] = scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			[Fusion.Children] = { buttonRow(scope, name, function() fireVFX(name) end) },
		}
	end
	return btns
end

local function shotButtons(scope)
	local btns = {}
	for i, name in CinematicPresets.ListShots() do
		btns[#btns + 1] = scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				buttonRow(scope, name, function()
					fireShot(name, Fusion.peek(SnapState) == true)
				end),
			},
		}
	end
	-- Append a "RESET" + a Snap toggle row.
	btns[#btns + 1] = scope:New('Frame') {
		LayoutOrder = 100,
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			buttonRow(scope, 'reset camera', function() fireCameraReset() end),
		},
	}
	btns[#btns + 1] = scope:New('TextButton') {
		LayoutOrder = 101,
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = PALETTE.bg1,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		FontFace = HUDCommon.FONT_UI,
		TextSize = 13,
		TextColor3 = PALETTE.ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = scope:Computed(function(use)
			return string.format('  snap: %s', use(SnapState) and 'ON' or 'off')
		end),
		[Fusion.OnEvent('Activated')] = function()
			SnapState:set(not Fusion.peek(SnapState))
		end,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.gold, Transparency = 0.6, Thickness = 1 },
		},
	}
	return btns
end

local function dialogueButtons(scope)
	local btns = {}
	local ids = {}
	for id in DialogueData.Dialogue do ids[#ids + 1] = id end
	table.sort(ids)
	for i, id in ids do
		btns[#btns + 1] = scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			[Fusion.Children] = { buttonRow(scope, id, function() openDialogue(id) end) },
		}
	end
	return btns
end

----------------------------------------------------------------------
-- Skill-runtime debug sections. Lazy-required so an early-load order
-- where ReplicatedModules isn't ready doesn't hang the widget.
----------------------------------------------------------------------
local function tryGetCombatSkills()
	local ok, result = pcall(function()
		return require(game:GetService('ReplicatedStorage'):WaitForChild('Modules')).Data.CombatSkills
	end)
	return ok and result or nil
end

local function recipeButtons(scope)
	local CombatSkills = tryGetCombatSkills()
	local btns = {}
	if not CombatSkills or typeof(CombatSkills.Recipes) ~= 'table' then return btns end
	local ids = {}
	for id in CombatSkills.Recipes do ids[#ids + 1] = id end
	table.sort(ids)
	for i, id in ids do
		btns[#btns + 1] = scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			[Fusion.Children] = { buttonRow(scope, id, function() runRecipe(id) end) },
		}
	end
	return btns
end

local function telegraphButtons(scope)
	local btns = {}
	for i, kind in { 'circle', 'rect', 'cone' } do
		btns[#btns + 1] = scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			[Fusion.Children] = { buttonRow(scope, 'telegraph: ' .. kind,
				function() testTelegraph(kind) end) },
		}
	end
	return btns
end

local function mobSpawnButtons(scope)
	-- Hand-curated list — adding a new mob to Mobs.luau means adding
	-- one entry here. (Could be auto-generated from Mobs.Mobs but
	-- the F4 widget is for tightly-curated test entries, not every
	-- mob in the game.)
	local mobs = { 'Boar', 'BossBoar', 'Generic' }
	local btns = {}
	for i, mobId in mobs do
		btns[#btns + 1] = scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			[Fusion.Children] = { buttonRow(scope, 'spawn: ' .. mobId,
				function() spawnMob(mobId) end) },
		}
	end
	return btns
end

local function bossPhaseButtons(scope)
	local btns = {}
	for i = 1, 3 do
		local phase = i
		btns[#btns + 1] = scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			[Fusion.Children] = { buttonRow(scope, 'force phase ' .. phase,
				function() setBossPhase(phase) end) },
		}
	end
	return btns
end

----------------------------------------------------------------------
-- Boss healthbar test buttons. Cycles a few canned shapes (single bar,
-- two-phase, shielded boss) + a damage tick so the smooth fill tween is
-- visible. Closes via the explicit "close" row.
----------------------------------------------------------------------
local function getBossHealthbar()
	return SystemsContainer.BossHealthbarWidget
		or (SystemsContainer.ParentSystems and SystemsContainer.ParentSystems.Widgets
			and SystemsContainer.ParentSystems.Widgets.BossHealthbarWidget)
end

local TestBossPresets: { { name: string, label: string, run: () -> () } } = {
	{
		name = 'single', label = 'single bar (1000hp)',
		run = function()
			local bh = getBossHealthbar(); if not bh then return end
			bh.SetBoss('Test Boss', { { Id = 'main', MaxHP = 1000, CurrentHP = 1000 } })
		end,
	},
	{
		name = 'two_phase', label = 'two-phase (red/violet)',
		run = function()
			local bh = getBossHealthbar(); if not bh then return end
			bh.SetBoss('Twin-Phase Boss', {
				{ Id = 'p1', Name = 'Phase 1', MaxHP = 1500, CurrentHP = 1500,
					Color = Color3.fromRGB(220, 70, 80) },
				{ Id = 'p2', Name = 'Phase 2', MaxHP = 2400, CurrentHP = 2400,
					Color = Color3.fromRGB(180, 120, 240) },
			})
		end,
	},
	{
		name = 'shielded', label = 'shielded (shield + hp)',
		run = function()
			local bh = getBossHealthbar(); if not bh then return end
			bh.SetBoss('Shielded Boss', {
				{ Id = 'shield', Name = 'Shield', MaxHP = 600, CurrentHP = 600,
					Color = Color3.fromRGB(120, 180, 255) },
				{ Id = 'hp', Name = 'Health', MaxHP = 1800, CurrentHP = 1800,
					Color = Color3.fromRGB(220, 70, 80) },
			})
		end,
	},
	{
		name = 'tick_damage', label = 'tick: -150 hp on bar 1',
		-- Pokes UpdateBar on whichever boss is currently shown. Reads
		-- the live HP via a peek — fine for a debug ticker, even if
		-- it's not the cleanest pattern (production code should drive
		-- HP from authoritative server state).
		run = function()
			local bh = getBossHealthbar(); if not bh then return end
			-- Try common test ids in priority order. Whichever is live
			-- gets the tick; the others silently no-op via UpdateBar's
			-- missing-id guard.
			for _, id in { 'main', 'shield', 'hp', 'p1', 'p2' } do
				bh.UpdateBar(id, math.random(0, 2400))
			end
		end,
	},
	{
		name = 'remove_first', label = 'remove first bar',
		run = function()
			local bh = getBossHealthbar(); if not bh then return end
			-- Same brute-force approach as the tick: try the canonical
			-- first-bar ids; only one will match.
			for _, id in { 'shield', 'p1', 'main' } do
				bh.RemoveBar(id)
			end
		end,
	},
	{
		name = 'close', label = 'close',
		run = function()
			local bh = getBossHealthbar(); if not bh then return end
			bh.CloseWidget()
		end,
	},
}

local function bossHealthbarButtons(scope)
	local btns = {}
	for i, preset in TestBossPresets do
		btns[#btns + 1] = scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			[Fusion.Children] = { buttonRow(scope, preset.label, preset.run) },
		}
	end
	return btns
end

----------------------------------------------------------------------
-- Panel build. Right-side anchored, scrollable so a long preset list
-- doesn't push off the bottom of the screen.
----------------------------------------------------------------------
local function buildPanel(scope)
	local panel = HUDCommon.chiseledPanel(scope, {
		Name = 'CinematicTestPanel',
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(280, 600),
		AccentColor = PALETTE.gold,
		Children = {
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(0, 12),
				PaddingBottom = UDim.new(0, 12),
				PaddingLeft   = UDim.new(0, 10),
				PaddingRight  = UDim.new(0, 10),
			},
			scope:New('ScrollingFrame') {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ScrollBarThickness = 4,
				CanvasSize = UDim2.new(),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollBarImageColor3 = PALETTE.accent,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding       = UDim.new(0, 10),
						SortOrder     = Enum.SortOrder.LayoutOrder,
					},

					HUDCommon.eyebrowLabel(scope, {
						Text = 'CINEMATIC TEST', Color = PALETTE.gold,
						Size = UDim2.new(1, 0, 0, 16), TextSize = 12, LayoutOrder = 0,
					}),

					scope:New('Frame') {
						LayoutOrder = 1,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundTransparency = 1,
						[Fusion.Children] = { sectionFrame(scope, 'cinematics', cinematicButtons(scope)) },
					},
					scope:New('Frame') {
						LayoutOrder = 2,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundTransparency = 1,
						[Fusion.Children] = { sectionFrame(scope, 'shake', shakeButtons(scope)) },
					},
					scope:New('Frame') {
						LayoutOrder = 3,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundTransparency = 1,
						[Fusion.Children] = { sectionFrame(scope, 'vfx', vfxButtons(scope)) },
					},
					scope:New('Frame') {
						LayoutOrder = 4,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundTransparency = 1,
						[Fusion.Children] = { sectionFrame(scope, 'camera shots', shotButtons(scope)) },
					},
					scope:New('Frame') {
						LayoutOrder = 5,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundTransparency = 1,
						[Fusion.Children] = { sectionFrame(scope, 'dialogue', dialogueButtons(scope)) },
					},
					scope:New('Frame') {
						LayoutOrder = 6,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundTransparency = 1,
						[Fusion.Children] = { sectionFrame(scope, 'boss healthbar', bossHealthbarButtons(scope)) },
					},
					-- New: skill-runtime debug surfaces.
					scope:New('Frame') {
						LayoutOrder = 7,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundTransparency = 1,
						[Fusion.Children] = { sectionFrame(scope, 'telegraphs', telegraphButtons(scope)) },
					},
					scope:New('Frame') {
						LayoutOrder = 8,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundTransparency = 1,
						[Fusion.Children] = { sectionFrame(scope, 'recipes', recipeButtons(scope)) },
					},
					scope:New('Frame') {
						LayoutOrder = 9,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundTransparency = 1,
						[Fusion.Children] = { sectionFrame(scope, 'spawn mobs', mobSpawnButtons(scope)) },
					},
					scope:New('Frame') {
						LayoutOrder = 10,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundTransparency = 1,
						[Fusion.Children] = { sectionFrame(scope, 'boss phase', bossPhaseButtons(scope)) },
					},
				},
			},
		},
	})
	panel.Parent = ScreenGui
	return panel
end

----------------------------------------------------------------------
-- Public open / close.
----------------------------------------------------------------------
function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true
	ScreenGui = HUDCommon.ensureScreenGui('HUD_CinematicTest', 90)
	RootScope = scoped(Fusion)
	SnapState = RootScope:Value(false)
	buildPanel(RootScope)
end

function Module.CloseWidget()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
end

function Module.ToggleWidget()
	if Module.IsOpen then Module.CloseWidget() else Module.OpenWidget() end
end

-- Build the persistent purple toggle button. Bottom-center, just above
-- the hotbar (hotbar root sits at scale-Y 0.98; this button at 0.78 so
-- it clears the hotbar's tallest cluster). Click → ToggleWidget.
-- The button auto-hides whenever the inventory/menu TabWidget is open
-- (so it doesn't overlap the modal). Tab open state is polled on
-- Heartbeat — TabWidget exposes a function, not a Fusion Value, so
-- there's no observable to bind.
local function buildToggleButton()
	ToggleScreenGui = HUDCommon.ensureScreenGui('HUD_CinematicTestToggle', 89)
	ToggleScope = scoped(Fusion)
	local btn = ToggleScope:New('TextButton') {
		Name = 'CinematicTestToggle',
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 0.78),
		Size = UDim2.fromOffset(140, 28),
		BackgroundColor3 = PALETTE.violet,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		FontFace = HUDCommon.FONT_UI,
		TextSize = 13,
		TextColor3 = Color3.new(1, 1, 1),
		Text = 'Cinematic Test (F4)',
		Parent = ToggleScreenGui,
		[Fusion.OnEvent('Activated')] = function() Module.ToggleWidget() end,
		[Fusion.Children] = {
			ToggleScope:New('UICorner') { CornerRadius = UDim.new(0, 4) },
			ToggleScope:New('UIStroke') {
				Color = PALETTE.violet, Transparency = 0.2, Thickness = 1,
			},
		},
	}

	-- Hide whenever the TabWidget (inventory/menu) is open. Polled
	-- on a low-frequency loop (every 0.1s) — 10× per second is plenty
	-- for "is the menu open?". HUDCommon.ensureScreenGui returns a
	-- Frame parent (the shared HUD frame), not a real ScreenGui — so
	-- we toggle Visible on the BUTTON itself rather than reaching for
	-- a non-existent ScreenGui.Enabled property.
	task.spawn(function()
		while btn and btn.Parent do
			local TabWidget = SystemsContainer.TabWidget
				or (SystemsContainer.ParentSystems
					and SystemsContainer.ParentSystems.Widgets
					and SystemsContainer.ParentSystems.Widgets.TabWidget)
			local menuOpen = TabWidget and TabWidget.IsWidgetOpen and TabWidget.IsWidgetOpen() or false
			local desired = not menuOpen
			if btn.Visible ~= desired then btn.Visible = desired end
			task.wait(0.1)
		end
	end)

	return btn
end

function Module.Start()
	-- F4 toggles the panel; the on-screen purple button does the same.
	-- Panel starts closed regardless of Studio/live — open it explicitly
	-- via the button or F4.
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == Enum.KeyCode.F4 then Module.ToggleWidget() end
	end)
	buildToggleButton()
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/BossHealthbarWidget"><![CDATA[-- BossHealthbarWidget — top-center boss HP UI with multi-bar support.
--
-- A boss is described by an ordered list of *bars*; each bar is a
-- self-contained health container with its own MaxHP and live CurrentHP.
-- Use this for phase-based bosses (one bar per phase), shielded bosses
-- (an outer "shield" bar over an inner "health" bar), or any encounter
-- where a single fill bar can't capture the full HP shape.
--
-- Public API:
--   Module.SetBoss(displayName, bars)
--     Opens (or replaces) the panel for a boss. `bars` is an ordered
--     array of { Id = string, Name? = string, MaxHP = number,
--                CurrentHP = number, Color? = Color3 }.
--   Module.UpdateBar(barId, currentHP)
--     Tween a specific bar to `currentHP`. Smooth via HUDCommon.smoothBar.
--   Module.RemoveBar(barId)
--     Drops a bar (e.g. on phase end). When the last bar is removed,
--     the widget closes automatically.
--   Module.CloseWidget()
--     Hide and clear all state.
--
-- Layout strategy (see custom-roblox-ui SKILL.md):
--   * Top-level panel anchors top-center, lifted off the screen edge by
--     a Scale-converted pixel inset. Width is Scale-relative to the
--     design screen so the rail keeps its design proportions on every
--     aspect; height auto-grows with the bar count via AutomaticSize.Y.
--   * Each bar is its own Frame (the "container") so adding/removing
--     bars is a parent/destroy at the container level — no special
--     reflow logic. Container holds: optional sublabel + smoothBar fill
--     + numeric HP overlay text.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local doCleanup = Fusion.doCleanup
local peek = Fusion.peek

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE = HUDCommon.PALETTE

local SystemsContainer = {}

local Module = {}
Module.IsOpen = false

----------------------------------------------------------------------
-- Design dimensions (pixels). Every Scale value is derived from these.
----------------------------------------------------------------------
local DESIGN_SCREEN_W, DESIGN_SCREEN_H = 1920, 1080

local DESIGN_PANEL_W       = 720
local DESIGN_PANEL_PAD     = 14

local DESIGN_NAME_H        = 32   -- big boss name label
local DESIGN_BAR_H         = 18   -- per-bar fill height
local DESIGN_BAR_LABEL_H   = 12   -- optional per-bar sublabel ("Phase 1", etc.)
local DESIGN_BAR_GAP       = 6    -- vertical gap between bars
local DESIGN_ROW_GAP       = 8    -- gap between name and the bar stack

local DESIGN_TOP_INSET     = 36   -- distance from top of screen to panel top
local ANCHOR_Y_SCALE       = DESIGN_TOP_INSET / DESIGN_SCREEN_H

local DEFAULT_BAR_COLOR    = Color3.fromRGB(220, 70, 80)

----------------------------------------------------------------------
-- Per-open state. Built fresh by SetBoss and torn down by CloseWidget.
----------------------------------------------------------------------
local ScreenGui: ScreenGui? = nil
local RootScope = nil

local BossNameValue = nil   -- Value<string>
local BarConfigs    = nil   -- Value<{BarConfig}>; rebuilds bars on change
-- Per-bar live HP Values, keyed by Bar.Id. Mutated directly on UpdateBar
-- so the smoothBar tween reads off the existing Value (no full ForPairs
-- rebuild on every HP tick — we only rebuild when the bar list shape
-- changes via SetBoss / RemoveBar).
local BarHPValues: { [string]: any } = {}

export type BarConfig = {
	Id: string,
	Name: string?,
	MaxHP: number,
	CurrentHP: number,
	Color: Color3?,
}

----------------------------------------------------------------------
-- Build one bar container. Captures the bar's static config + binds the
-- smoothBar to the matching live HP Value. Returns the container Frame.
----------------------------------------------------------------------
local function buildBar(scope, bar: BarConfig)
	local hpValue = BarHPValues[bar.Id]
	local color = bar.Color or DEFAULT_BAR_COLOR
	local maxHP = bar.MaxHP

	-- Fill bar via HUDCommon.smoothBar. We pass the live Value as
	-- `Value` so it observes changes and tweens smoothly.
	local smoothBar = HUDCommon.smoothBar(scope, {
		Value = hpValue,
		Max   = maxHP,
		Color = color,
		Height = DESIGN_BAR_H,
		LayoutOrder = 1,
	})

	-- Numeric "current / max" overlay parented onto the smoothBar fill
	-- frame. ZIndex=5 puts it above the fill gradient so the text reads
	-- against either filled or unfilled background.
	scope:New('TextLabel') {
		Name = 'HPText',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_MONO,
		TextSize = 11,
		TextColor3 = PALETTE.ink,
		TextStrokeTransparency = 0.4,
		TextStrokeColor3 = PALETTE.bg0,
		Text = scope:Computed(function(use)
			local v = use(hpValue)
			return string.format('%d / %d', math.max(0, math.floor(v + 0.5)), maxHP)
		end),
		Parent = smoothBar,
		ZIndex = 5,
	}

	-- Optional sublabel above the bar (e.g. "Phase 1", "Shield").
	-- Layout-ordered before the bar so it stacks above; the container's
	-- vertical UIListLayout enforces the order.
	local children: { any } = {}
	if typeof(bar.Name) == 'string' and bar.Name ~= '' then
		children[#children + 1] = HUDCommon.eyebrowLabel(scope, {
			Text = string.upper(bar.Name),
			Color = color:Lerp(Color3.new(1, 1, 1), 0.25),
			Size = UDim2.new(1, 0, 0, DESIGN_BAR_LABEL_H),
			TextSize = 10,
			LayoutOrder = 0,
		})
	end
	children[#children + 1] = smoothBar

	return scope:New('Frame') {
		Name = 'BarContainer_' .. bar.Id,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 2),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			table.unpack(children),
		},
	}
end

----------------------------------------------------------------------
-- Build the panel. Top-center; AutoSize.Y so adding/removing bars
-- reflows naturally. Bars are produced via ForPairs over BarConfigs so
-- list-shape changes (SetBoss / RemoveBar) reactively rebuild the
-- container stack while bar HP updates flow through per-bar Values
-- without re-running the loop.
----------------------------------------------------------------------
local function buildPanel(scope)
	local panel = HUDCommon.chiseledPanel(scope, {
		Name = 'BossHealthbarPanel',
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, ANCHOR_Y_SCALE),
		Size = UDim2.fromScale(DESIGN_PANEL_W / DESIGN_SCREEN_W,
			(DESIGN_NAME_H + DESIGN_BAR_H + DESIGN_ROW_GAP) / DESIGN_SCREEN_H),
		AutomaticSize = Enum.AutomaticSize.Y,
		AccentColor = DEFAULT_BAR_COLOR,
		Children = {
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(0, DESIGN_PANEL_PAD),
				PaddingBottom = UDim.new(0, DESIGN_PANEL_PAD),
				PaddingLeft   = UDim.new(0, DESIGN_PANEL_PAD),
				PaddingRight  = UDim.new(0, DESIGN_PANEL_PAD),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, DESIGN_ROW_GAP),
				SortOrder = Enum.SortOrder.LayoutOrder,
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
			},

			-- Boss name. Centered, pixel-height; large display font.
			scope:New('TextLabel') {
				Name = 'BossName',
				LayoutOrder = 0,
				Size = UDim2.new(1, 0, 0, DESIGN_NAME_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				TextSize = 24,
				TextColor3 = PALETTE.ink,
				TextStrokeTransparency = 0.5,
				TextStrokeColor3 = PALETTE.bg0,
				Text = BossNameValue,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextYAlignment = Enum.TextYAlignment.Center,
			},

			-- Bar stack. AutoSize.Y so it absorbs the live count of bars.
			scope:New('Frame') {
				Name = 'BarStack',
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding = UDim.new(0, DESIGN_BAR_GAP),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					-- Reactive rebuild of bar containers when BarConfigs
					-- changes. Per-bar HP changes go through BarHPValues
					-- and don't re-run this processor.
					scope:ForPairs(BarConfigs, function(_use, innerScope, idx, bar)
						local container = buildBar(innerScope, bar)
						container.LayoutOrder = idx
						return bar.Id, container
					end),
				},
			},
		},
	})
	panel.Parent = ScreenGui
	return panel
end

----------------------------------------------------------------------
-- Public API.
----------------------------------------------------------------------
function Module.IsWidgetOpen(): boolean
	return Module.IsOpen
end

function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true
	ScreenGui = HUDCommon.ensureScreenGui('HUD_BossHealthbar', 35)
	RootScope = scoped(Fusion)
	BossNameValue = RootScope:Value('')
	BarConfigs = RootScope:Value({})
	BarHPValues = {}
	buildPanel(RootScope)
end

function Module.CloseWidget()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	BarHPValues = {}
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
	BossNameValue = nil
	BarConfigs = nil
end

-- Open or replace the boss panel. `bars` is a fresh ordered config list;
-- this clears any prior boss state and rebuilds from scratch. Pass a
-- single-element list for single-bar bosses, multi-element for phased.
function Module.SetBoss(displayName: string, bars: { BarConfig })
	if not Module.IsOpen then Module.OpenWidget() end
	-- Build fresh per-bar HP Values so each bar has its own observable
	-- channel. UpdateBar mutates these directly without rebuilding the
	-- bar list structurally.
	BarHPValues = {}
	for _, bar in bars do
		BarHPValues[bar.Id] = RootScope:Value(bar.CurrentHP)
	end
	BossNameValue:set(displayName)
	BarConfigs:set(bars)
end

-- Smooth-set a bar's current HP. Caps at 0 floor (negative HP rounds up
-- to 0 visually); the bar fill is clamped to [0, 1] inside smoothBar.
function Module.UpdateBar(barId: string, currentHP: number)
	local v = BarHPValues[barId]
	if v then v:set(math.max(0, currentHP)) end
end

-- Remove a bar from the stack. Closes the widget when the last bar is
-- gone — boss-encounter authors don't have to remember to close the
-- widget separately when the final phase ends.
function Module.RemoveBar(barId: string)
	if not BarConfigs then return end
	local list = peek(BarConfigs) or {}
	local out = {}
	for _, bar in list do
		if bar.Id ~= barId then table.insert(out, bar) end
	end
	BarHPValues[barId] = nil
	BarConfigs:set(out)
	if #out == 0 then Module.CloseWidget() end
end

-- Server-driven dispatcher. BossServer (and any future boss-controller
-- module) fires `BossHealthbarEvent` with `(action, payload)` to drive
-- the widget without holding a direct reference. The action enum + per-
-- action payload shapes live on Services.BossHealthbarShared.Actions.
local function tryGetEvent()
	local ok, RemoteService = pcall(function()
		return ReplicatedModules.Services.RemoteService
	end)
	if not ok or not RemoteService then return nil end
	return RemoteService.GetRemote('BossHealthbarEvent', 'RemoteEvent', false)
end

function Module.Start()
	local evt = tryGetEvent()
	if not evt then return end
	local Actions = ReplicatedModules.Services.BossHealthbarShared.Actions
	evt.OnClientEvent:Connect(function(action, payload)
		if action == Actions.SetBoss and typeof(payload) == 'table' then
			Module.SetBoss(payload.Name or '', payload.Bars or {})
		elseif action == Actions.UpdateBar and typeof(payload) == 'table' then
			Module.UpdateBar(payload.Id, payload.CurrentHP)
		elseif action == Actions.RemoveBar and typeof(payload) == 'table' then
			Module.RemoveBar(payload.Id)
		elseif action == Actions.Close then
			Module.CloseWidget()
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/CompassWidget"><![CDATA[-- CompassWidget — top-of-screen waypoint projection strip.
--
-- For every active waypoint (CollectionService 'Workstation' + each
-- UNLOCKED 'Waystones' from PlayerData.Waystones), projects its world
-- position onto a horizontal strip across the top of the HUD. The
-- strip is camera-relative: a waypoint dead-ahead sits at the center,
-- shifts left/right as the camera turns, and fades out near the edges
-- as it exits the visible angle range.
--
-- A marker centered under the strip's tick (within CENTER_ANGLE_DEG of
-- the camera-forward azimuth) reveals a tooltip pill below the strip
-- naming the waypoint — quick "what am I looking at" feedback without
-- forcing the player to open the map.
--
-- Visibility:
--   SettingsRegistry.CompassEnabled — Open/Close cycle on toggle. Same
--   pattern MinimapWidget uses (see SettingsTab row 'compass').
--
-- Source of truth:
--   * Workstations: CollectionService tag 'Workstation' +
--     `WorkstationKind` attribute → WaypointsData.Workstations[kind]
--     (label + icon + color, with WorkstationDefault as fallback).
--   * Waystones:    CollectionService tag WaystonesData.WaystonesTag
--     gated by PlayerData.Waystones membership +
--     WaystonesData.WaystoneDisplays for the friendly label.

local CollectionService = game:GetService('CollectionService')
local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local RunService = game:GetService('RunService')
local Workspace = game:GetService('Workspace')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local doCleanup = Fusion.doCleanup

local WaypointsData   = ReplicatedModules.Data.Waypoints
local WaystonesData   = ReplicatedModules.Data.Waystones
local SubstationsData = ReplicatedModules.Data.Substations
local ReplicatedData  = ReplicatedModules.Services.ReplicatedData

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local SettingsRegistry = LocalModules.Modules.SettingsRegistry
local PALETTE = HUDCommon.PALETTE

local SystemsContainer = {}

local Module = {}
Module.IsOpen = false

----------------------------------------------------------------------
-- Design dimensions. The compass mirrors the minimap's pattern: a
-- pixel-fixed inner panel positioned via Scale offsets so it sits in
-- the right spot on every screen size. The panel itself is small —
-- a strip — so we keep its inner geometry in pixels.
----------------------------------------------------------------------
local DESIGN_SCREEN_W = 1920
local DESIGN_STRIP_W  = 720    -- visible strip width (pixels at design res)
local DESIGN_STRIP_H  = 28
local DESIGN_TOP_INSET = 16    -- gap from the top of the viewport

-- Half-width of the angular slice rendered onto the strip. A waypoint
-- between -VISIBLE_HALF and +VISIBLE_HALF degrees of camera-forward
-- maps linearly across the strip. Outside that range the marker is
-- clipped (rendering is suppressed). 90° matches a "looking around"
-- field of awareness — what's in the player's general front hemisphere.
local VISIBLE_HALF_DEG = 90

-- Tooltip activates when a marker is within this many degrees of the
-- camera-forward axis (i.e. roughly under the central tick mark).
local CENTER_ANGLE_DEG = 6

-- Edge fade: markers fade in over this many degrees as they enter the
-- visible range, keeping pop-in subtle.
local EDGE_FADE_DEG    = 15

----------------------------------------------------------------------
-- Widget state.
----------------------------------------------------------------------
local ScreenGui: GuiObject?      = nil
local StripFrame: Frame?         = nil
local TooltipFrame: Frame?       = nil
local TooltipLabel: TextLabel?   = nil
local RootScope: any             = nil

-- One marker per waypoint. Each entry holds the rendered Frame plus
-- enough metadata to skip work when the underlying waypoint hasn't
-- moved. Keyed by the waypoint's world Model so tag-removal cleanup
-- can drop entries in O(1).
type MarkerEntry = {
	Frame: Frame,
	IconLabel: TextLabel,
	Name: string,
	Color: Color3,
	-- Attachment under the model's host BasePart, pinned to the
	-- pivot. We project from the attachment's WorldPosition so the
	-- compass marker tracks the model's true center even if the host
	-- part isn't centered on the model (waystone base plates, etc.).
	-- We also OWN this attachment — despawnMarker destroys it.
	Anchor: Attachment,
	Category: 'workstation' | 'waystone' | 'substation',
}
local Markers: { [Instance]: MarkerEntry } = {}

----------------------------------------------------------------------
-- Helpers.
----------------------------------------------------------------------

-- Pick the BasePart that hosts the compass-anchor Attachment. Same
-- fallback rule as WaypointsClient: PrimaryPart first, otherwise the
-- first BasePart descendant. Models with no BasePart anywhere can't
-- host an attachment, so they're rejected.
local function hostPartOf(model: Instance): BasePart?
	if model:IsA('BasePart') then return model end
	if model:IsA('Model') then
		if model.PrimaryPart then return model.PrimaryPart end
		for _, d in model:GetDescendants() do
			if d:IsA('BasePart') then return d end
		end
	end
	return nil
end

-- Anchor the projection at the model's geometric center via an
-- Attachment under the host BasePart. Each compass marker keeps its
-- own Attachment ('CompassAnchor') so it doesn't fight the
-- WaypointsClient's 'WaypointAnchor' attachment over the same name —
-- both can coexist on the same host part.
local function createPivotAttachment(model: Instance, host: BasePart): Attachment
	local existing = host:FindFirstChild('CompassAnchor')
	local att: Attachment
	if existing and existing:IsA('Attachment') then
		att = existing
	else
		att = Instance.new('Attachment')
		att.Name = 'CompassAnchor'
		att.Parent = host
	end
	att.WorldPosition = (model :: any):GetPivot().Position
	return att
end

local function isWaystoneUnlocked(waystoneId: string): boolean
	local data = ReplicatedData.GetData('PlayerData', false)
	if typeof(data) ~= 'table' or typeof(data.Waystones) ~= 'table' then
		return false
	end
	for _, id in data.Waystones do
		if id == waystoneId then return true end
	end
	return false
end

----------------------------------------------------------------------
-- Marker construction. One small TextLabel for the icon glyph, no
-- background (the strip's own bar provides the visual context). The
-- label sits inside an outer Frame so we can scale Position + alpha
-- independently from the icon's intrinsic size.
----------------------------------------------------------------------
local function buildMarker(scope: any, label: string, icon: string, color: Color3): (Frame, TextLabel)
	local frame = scope:New('Frame') {
		Name = 'CompassMarker',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(20, 20),
		BackgroundTransparency = 1,
		ZIndex = 4,
	}
	frame.Parent = StripFrame

	local iconLabel = scope:New('TextLabel') {
		Name = 'Icon',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_DISPLAY,
		Text = icon,
		TextScaled = true,
		TextColor3 = color,
		TextStrokeColor3 = Color3.new(0, 0, 0),
		TextStrokeTransparency = 0.4,
	}
	iconLabel.Parent = frame

	-- Hidden until projection lands in the visible range; refresh()
	-- flips Visible + writes Position each tick.
	frame.Visible = false
	-- Reserved-for-future: per-marker hover label could use this name.
	local _ = label
	return frame, iconLabel
end

----------------------------------------------------------------------
-- Spawn / despawn lifecycle. Mirrors WaypointsClient's signal hookups
-- so the compass appears/disappears in lockstep with the world markers
-- (PlayerData unlock for waystones, instance-added for workstations).
----------------------------------------------------------------------
local function spawnWorkstationMarker(model: Instance)
	if not StripFrame or not RootScope then return end
	if Markers[model] then return end
	local host = hostPartOf(model)
	if not host then return end
	local kind = model:GetAttribute('WorkstationKind')
	local cfg = (typeof(kind) == 'string' and WaypointsData.Workstations[kind])
		or WaypointsData.WorkstationDefault
	local frame, iconLabel = buildMarker(RootScope, cfg.Label, cfg.Icon, cfg.Color)
	local anchor = createPivotAttachment(model, host)
	Markers[model] = {
		Frame = frame, IconLabel = iconLabel,
		Name = cfg.Label, Color = cfg.Color,
		Anchor = anchor, Category = 'workstation',
	}
end

local function spawnSubstationMarker(model: Instance)
	if not StripFrame or not RootScope then return end
	if Markers[model] then return end
	local host = hostPartOf(model)
	if not host then return end
	local kind = model:GetAttribute(SubstationsData.AttributeKind)
	local cfg = (typeof(kind) == 'string' and SubstationsData.Kinds[kind])
		or SubstationsData.Default
	local frame, iconLabel = buildMarker(RootScope, cfg.Label, cfg.Icon, cfg.Color)
	local anchor = createPivotAttachment(model, host)
	Markers[model] = {
		Frame = frame, IconLabel = iconLabel,
		Name = cfg.Label, Color = cfg.Color,
		Anchor = anchor, Category = 'substation',
	}
end

local function spawnWaystoneMarker(model: Instance)
	if not StripFrame or not RootScope then return end
	if Markers[model] then return end
	-- Waystone id resolution mirrors WaypointsClient: attribute first,
	-- model name fallback against WaystoneDisplays. Skip if neither
	-- yields a known id (gameplay never wants to surface unknown data).
	local waystoneId: string? = model:GetAttribute('WaystoneId')
	if typeof(waystoneId) ~= 'string' or waystoneId == '' then
		if WaystonesData.WaystoneDisplays[model.Name] then
			waystoneId = model.Name
		else
			return
		end
	end
	if not isWaystoneUnlocked(waystoneId :: string) then return end
	local host = hostPartOf(model)
	if not host then return end
	local cfg = WaystonesData.WaystoneDisplays[waystoneId]
	local label = (cfg and cfg.Name) or waystoneId
	local style = WaypointsData.WaystoneStyle
	local frame, iconLabel = buildMarker(RootScope, label, style.Icon, style.Color)
	local anchor = createPivotAttachment(model, host)
	Markers[model] = {
		Frame = frame, IconLabel = iconLabel,
		Name = label, Color = style.Color,
		Anchor = anchor, Category = 'waystone',
	}
end

local function despawnMarker(model: Instance)
	local entry = Markers[model]
	if not entry then return end
	if entry.Frame then entry.Frame:Destroy() end
	-- Tear down the attachment we created. WaypointsClient owns its
	-- own 'WaypointAnchor' attachment under a different name, so this
	-- never deletes that one.
	if entry.Anchor then entry.Anchor:Destroy() end
	Markers[model] = nil
end

local function refreshWaystoneMarkers()
	-- Newly-unlocked waystones spawn; already-shown stay. Locked
	-- waystones never had a marker, so there's nothing to remove.
	for _, model in CollectionService:GetTagged(WaystonesData.WaystonesTag) do
		if not Markers[model] then
			spawnWaystoneMarker(model)
		end
	end
end

----------------------------------------------------------------------
-- Per-frame projection. For each marker, computes the signed yaw
-- between the camera-forward direction and the camera→waypoint
-- direction (projected onto the horizontal plane), maps it onto the
-- strip's [-0.5, +0.5] X-fraction, and updates Position + transparency.
--
-- Returns the marker entry whose absolute angle is smallest AND below
-- CENTER_ANGLE_DEG so the tooltip can name it. Nil if nothing is near
-- the center reticle.
----------------------------------------------------------------------
local function refresh(): MarkerEntry?
	if not StripFrame or not StripFrame.Visible then return nil end
	local camera = Workspace.CurrentCamera
	if not camera then return nil end

	local camCF = camera.CFrame
	local camPos = camCF.Position
	-- Camera forward / right on the horizontal plane. Y-flatten the
	-- look vector before normalizing so a steep pitch (looking up at
	-- the sky) doesn't swing the compass wildly — only yaw matters.
	local lookFlat = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
	if lookFlat.Magnitude < 1e-4 then return nil end
	lookFlat = lookFlat.Unit
	-- Right vector derived from a flat up cross with lookFlat. Stays
	-- horizontal regardless of camera roll.
	local rightFlat = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
	if rightFlat.Magnitude < 1e-4 then
		-- Degenerate (camera pointing straight up): fall back to a
		-- world-axis right so we don't divide by zero.
		rightFlat = Vector3.new(1, 0, 0)
	else
		rightFlat = rightFlat.Unit
	end

	local centeredEntry: MarkerEntry? = nil
	local centeredAbs = math.huge

	for model, entry in Markers do
		-- Defensive: tag-removed signals should have cleaned this up
		-- already, but a parent re-parented out of workspace can miss.
		if not entry.Anchor or not entry.Anchor.Parent then
			despawnMarker(model)
			continue
		end

		-- Attachments expose WorldPosition in absolute coordinates,
		-- so we don't have to compose the host part's CFrame ourselves.
		local toWp = entry.Anchor.WorldPosition - camPos
		local flat = Vector3.new(toWp.X, 0, toWp.Z)
		if flat.Magnitude < 1e-4 then
			entry.Frame.Visible = false
			continue
		end
		flat = flat.Unit

		-- Signed yaw via dot(forward) for the cosine and dot(right)
		-- for the sign. atan2(sin, cos) recovers the signed angle in
		-- radians, where positive = right-of-forward, negative = left.
		local cos = math.clamp(flat:Dot(lookFlat), -1, 1)
		local sin = math.clamp(flat:Dot(rightFlat), -1, 1)
		local rad = math.atan2(sin, cos)
		local deg = math.deg(rad)
		local absDeg = math.abs(deg)

		if absDeg > VISIBLE_HALF_DEG then
			entry.Frame.Visible = false
			continue
		end

		-- Strip mapping: -VISIBLE_HALF_DEG → 0.0 (left edge),
		-- 0° → 0.5 (center), +VISIBLE_HALF_DEG → 1.0 (right edge).
		local frac = 0.5 + (deg / (VISIBLE_HALF_DEG * 2))
		entry.Frame.Position = UDim2.new(frac, 0, 0.5, 0)

		-- Edge fade: full opacity through the inner ±(VISIBLE - FADE)
		-- range, then fades over the last EDGE_FADE_DEG before clipping.
		local fadeStart = VISIBLE_HALF_DEG - EDGE_FADE_DEG
		local alpha = 1
		if absDeg > fadeStart then
			alpha = 1 - ((absDeg - fadeStart) / EDGE_FADE_DEG)
			alpha = math.clamp(alpha, 0, 1)
		end
		entry.IconLabel.TextTransparency = 1 - alpha
		entry.IconLabel.TextStrokeTransparency = math.clamp(0.4 + (1 - alpha) * 0.6, 0, 1)
		entry.Frame.Visible = true

		-- Track the closest-to-center marker for tooltip selection.
		if absDeg < CENTER_ANGLE_DEG and absDeg < centeredAbs then
			centeredEntry = entry
			centeredAbs = absDeg
		end
	end

	return centeredEntry
end

----------------------------------------------------------------------
-- Strip + tooltip construction.
----------------------------------------------------------------------
local function buildStrip(scope: any): Frame
	-- Center tick — vertical line at strip middle marking "where the
	-- camera is looking." Helps the player parse the tooltip's
	-- "centered on" semantics at a glance.
	local centerTick = scope:New('Frame') {
		Name = 'CenterTick',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(2, 18),
		BackgroundColor3 = PALETTE.accent,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		ZIndex = 5,
	}

	-- Lateral fade gradient via UIGradient — markers near the edges
	-- visually dissolve into the strip background, reinforcing the
	-- edge-fade alpha applied in refresh().
	local gradient = scope:New('UIGradient') {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0,    Color3.new(0, 0, 0)),
			ColorSequenceKeypoint.new(0.08, PALETTE.bg0),
			ColorSequenceKeypoint.new(0.5,  PALETTE.bg0),
			ColorSequenceKeypoint.new(0.92, PALETTE.bg0),
			ColorSequenceKeypoint.new(1,    Color3.new(0, 0, 0)),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0,    1),
			NumberSequenceKeypoint.new(0.08, 0.5),
			NumberSequenceKeypoint.new(0.5,  0.4),
			NumberSequenceKeypoint.new(0.92, 0.5),
			NumberSequenceKeypoint.new(1,    1),
		}),
	}

	local strip = scope:New('Frame') {
		Name = 'CompassStrip',
		AnchorPoint = Vector2.new(0.5, 0),
		-- Top-center anchored, with the design top-inset converted to a
		-- fraction of the design canvas so the gap scales with screen
		-- height (matches the rest of the HUD's aspect-locked widgets).
		Position = UDim2.fromScale(0.5, DESIGN_TOP_INSET / 1080),
		-- Strip width as a fraction of design canvas width so we follow
		-- the aspect-lock convention used by other HUD widgets.
		Size = UDim2.new(DESIGN_STRIP_W / DESIGN_SCREEN_W, 0, 0, DESIGN_STRIP_H),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.4,
		BorderSizePixel = 0,
		ZIndex = 3,
		[Fusion.Children] = {
			gradient,
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.6, Thickness = 1 },
			centerTick,
		},
	}
	return strip
end

local function buildTooltip(scope: any): (Frame, TextLabel)
	local label
	local frame = scope:New('Frame') {
		Name = 'CompassTooltip',
		AnchorPoint = Vector2.new(0.5, 0),
		-- Sits directly under the strip with a small gap.
		Position = UDim2.fromScale(0.5, (DESIGN_TOP_INSET + DESIGN_STRIP_H + 4) / 1080),
		Size = UDim2.fromOffset(180, 22),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 6,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
			},
		},
	}
	label = scope:New('TextLabel') {
		Name = 'Label',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_UI,
		Text = '',
		TextSize = 12,
		TextColor3 = PALETTE.ink,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}
	label.Parent = frame
	return frame, label
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true
	ScreenGui = HUDCommon.ensureScreenGui('HUD_Compass', 5)
	RootScope = scoped(Fusion)

	StripFrame = buildStrip(RootScope)
	StripFrame.Parent = ScreenGui

	local tipFrame, tipLabel = buildTooltip(RootScope)
	tipFrame.Parent = ScreenGui
	TooltipFrame = tipFrame
	TooltipLabel = tipLabel

	-- Seed every currently-tagged waypoint. Subsequent additions go
	-- through the Start-time CollectionService listeners.
	for _, m in CollectionService:GetTagged('Workstation') do
		spawnWorkstationMarker(m)
	end
	for _, m in CollectionService:GetTagged(WaystonesData.WaystonesTag) do
		spawnWaystoneMarker(m)
	end
	for _, m in CollectionService:GetTagged(SubstationsData.Tag) do
		spawnSubstationMarker(m)
	end
end

function Module.CloseWidget()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	-- Drop every marker frame; they're parented under StripFrame so
	-- the parent destroy below would catch them, but explicit
	-- iteration also clears the Markers map.
	for inst in Markers do
		despawnMarker(inst)
	end
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
	StripFrame = nil
	TooltipFrame = nil
	TooltipLabel = nil
end

function Module.Start()
	-- Tag listeners — kept always-live so reopening the widget after a
	-- toggle reseeds Markers from the up-to-date tag set without
	-- re-walking from Start. Despawn handlers run regardless of
	-- Module.IsOpen so the Markers table stays accurate.
	CollectionService:GetInstanceAddedSignal('Workstation'):Connect(function(m)
		if Module.IsOpen then spawnWorkstationMarker(m) end
	end)
	CollectionService:GetInstanceRemovedSignal('Workstation'):Connect(despawnMarker)

	local WAYSTONE_TAG = WaystonesData.WaystonesTag
	CollectionService:GetInstanceAddedSignal(WAYSTONE_TAG):Connect(function(m)
		if Module.IsOpen then spawnWaystoneMarker(m) end
	end)
	CollectionService:GetInstanceRemovedSignal(WAYSTONE_TAG):Connect(despawnMarker)

	local SUBSTATION_TAG = SubstationsData.Tag
	CollectionService:GetInstanceAddedSignal(SUBSTATION_TAG):Connect(function(m)
		if Module.IsOpen then spawnSubstationMarker(m) end
	end)
	CollectionService:GetInstanceRemovedSignal(SUBSTATION_TAG):Connect(despawnMarker)

	-- Re-seed waystones when PlayerData replicates (newly unlocked).
	ReplicatedData.OnUpdated:Connect(function(category)
		if category == 'PlayerData' and Module.IsOpen then
			refreshWaystoneMarkers()
		end
	end)

	-- Per-frame projection. Heartbeat (post-physics) is appropriate —
	-- the camera's CFrame is settled by the time Heartbeat fires.
	-- Tooltip update cohabits the same step so the label tracks the
	-- centered marker without drift.
	RunService.Heartbeat:Connect(function()
		if not Module.IsOpen then return end
		local centered = refresh()
		if TooltipFrame and TooltipLabel then
			if centered then
				TooltipLabel.Text = centered.Name
				TooltipLabel.TextColor3 = centered.Color
				TooltipFrame.Visible = true
			else
				TooltipFrame.Visible = false
			end
		end
	end)

	-- Settings toggle + initial state.
	SettingsRegistry.Changed:Connect(function(key, value)
		if key ~= 'CompassEnabled' then return end
		if value then
			Module.OpenWidget()
		else
			Module.CloseWidget()
		end
	end)

	task.defer(function()
		if SettingsRegistry.CompassEnabled then
			Module.OpenWidget()
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/Widgets/JoinGameWelcomeWidget"><![CDATA[-- First-join welcome popup. A centered, backdrop-dimmed multi-page modal
-- shown once per save the first time a player joins. Pages walk through
-- the game premise, the early-game (≤ level 5) loop, and a quick UI tour
-- (page content lives in Data.Onboarding.WelcomePages). The final page's
-- button reads FINISH; clicking it fires 'FinishWelcome' to the server,
-- which sets the ONBOARDING_JOIN_GAME_1 flag so the popup never returns.
--
-- The server (OnboardingServer.TryStartJoinGame1) also auto-grants the
-- starter quest when it sends 'ShowWelcome', so the quest is already in
-- the player's log by the time they read the UI-tour page.
--
-- This is intentionally separate from OnboardingWidget (the step-by-step
-- tutorial tooltip): different lifecycle, different gate. They share only
-- the OnboardingEvent remote.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped    = Fusion.scoped
local doCleanup = Fusion.doCleanup
local peek      = Fusion.peek
local RemoteService = ReplicatedModules.Services.RemoteService

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local OnboardingData = ReplicatedModules.Data.Onboarding
local Actions = OnboardingData.Actions
local PAGES = OnboardingData.WelcomePages
local PAGE_COUNT = #PAGES

local OnboardingEvent = RemoteService.GetRemote('OnboardingEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}
Module.IsOpen = false

-- Design canvas. The panel is pixel-designed (every inner Size/Position is
-- a fixed offset), so per the UI skill §6.2 we stamp the whole panel with a
-- single resolution-driven UIScale rather than converting offsets to scale.
local DESIGN_H = 1080
-- Render the whole panel at ~2× its pixel design so the welcome modal
-- dominates the screen on first join. Applied on top of the resolution scale
-- (so it still adapts to viewport height); scales every inner offset uniformly.
local SIZE_MULT = 2

local RootScope = nil
local ScreenGui = nil
local CurrentPage = nil  -- Fusion Value<number> (1-based page index)
local ResScale = nil     -- Fusion Value<number>; UIScale multiplier vs DESIGN_H
local ResConn = nil      -- AbsoluteSize listener; disconnected in CloseWidget

function Module.IsWidgetOpen(): boolean
	return Module.IsOpen and ScreenGui ~= nil
end

----------------------------------------------------------------------
-- Footer: page progress dots + Back / Next(Finish) buttons.
----------------------------------------------------------------------
local function buildProgressDots(scope)
	local dots = {}
	for i = 1, PAGE_COUNT do
		dots[i] = scope:New('Frame') {
			Name = 'Dot' .. i,
			Size = UDim2.fromOffset(8, 8),
			BackgroundColor3 = scope:Computed(function(use)
				return use(CurrentPage) == i and PALETTE.accent or PALETTE.inkFaint
			end),
			BorderSizePixel = 0,
			[Fusion.Children] = {
				scope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
			},
		}
	end
	return scope:New('Frame') {
		Name = 'ProgressDots',
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(0, 8),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				Padding = UDim.new(0, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			table.unpack(dots),
		},
	}
end

local function buildButton(scope, props: { Text: any, Visible: any?, OnClick: () -> (), Accent: Color3? })
	local accent = props.Accent or PALETTE.accent
	return scope:New('TextButton') {
		Size = UDim2.fromOffset(110, 32),
		BackgroundColor3 = PALETTE.bg1,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Visible = props.Visible,
		FontFace = HUDCommon.FONT_BUTTON,
		Text = props.Text,
		TextSize = 13,
		TextColor3 = PALETTE.ink,
		[Fusion.OnEvent('Activated')] = props.OnClick,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = accent, Transparency = 0.4, Thickness = 1 },
		},
	}
end

----------------------------------------------------------------------
-- Modal.
----------------------------------------------------------------------
local function buildUI(scope)
	local pageData = scope:Computed(function(use)
		return PAGES[use(CurrentPage)]
	end)

	-- Dark fade: a full-screen dim behind the modal so the game darkens while
	-- the welcome popup is open. Scale-sized so it always covers the viewport.
	scope:New('Frame') {
		Name = 'DarkFade',
		Position = UDim2.fromScale(0, 0),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		Parent = ScreenGui,
	}

	-- Backdrop: swallows clicks so the player can't interact with the HUD
	-- behind the modal. A TextButton (not Frame) so it eats input; kept
	-- transparent because DarkFade above does the dimming.
	scope:New('TextButton') {
		Name = 'Backdrop',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Modal = true,
		Text = '',
		Parent = ScreenGui,
	}

	scope:New('Frame') {
		Name = 'WelcomePanel',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(540, 360),
		BackgroundColor3 = PALETTE.panel,
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
		Parent = ScreenGui,
		[Fusion.Children] = {
			-- Resolution stamp: scales the whole pixel-designed panel uniformly.
			scope:New('UIScale') { Scale = ResScale },
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.35, Thickness = 1 },
			HUDCommon.cornerTick(scope, 'tl', PALETTE.accent),
			HUDCommon.cornerTick(scope, 'br', PALETTE.accent),
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, 26), PaddingBottom = UDim.new(0, 20),
				PaddingLeft = UDim.new(0, 28), PaddingRight = UDim.new(0, 28),
			},

			-- Eyebrow kicker.
			scope:New('TextLabel') {
				Size = UDim2.new(1, 0, 0, 14),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					local p = use(pageData); return p and ('◆ ' .. p.Eyebrow) or ''
				end),
				TextSize = 12,
				TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},

			-- Title.
			scope:New('TextLabel') {
				Position = UDim2.new(0, 0, 0, 22),
				Size = UDim2.new(1, 0, 0, 30),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = scope:Computed(function(use)
					local p = use(pageData); return p and p.Title or ''
				end),
				TextSize = 24,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
			},

			-- Body copy.
			scope:New('TextLabel') {
				Position = UDim2.new(0, 0, 0, 64),
				Size = UDim2.new(1, 0, 1, -64 - 44),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = scope:Computed(function(use)
					local p = use(pageData); return p and p.Body or ''
				end),
				TextSize = 16,
				LineHeight = 1.15,
				TextColor3 = PALETTE.inkDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
			},

			-- Footer row: dots (left) + Back/Next (right).
			scope:New('Frame') {
				Name = 'Footer',
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.new(0, 0, 1, 0),
				Size = UDim2.new(1, 0, 0, 32),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					buildProgressDots(scope),
					scope:New('Frame') {
						Name = 'Buttons',
						AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.new(1, 0, 0.5, 0),
						Size = UDim2.fromOffset(0, 32),
						AutomaticSize = Enum.AutomaticSize.X,
						BackgroundTransparency = 1,
						[Fusion.Children] = {
							scope:New('UIListLayout') {
								FillDirection = Enum.FillDirection.Horizontal,
								VerticalAlignment = Enum.VerticalAlignment.Center,
								HorizontalAlignment = Enum.HorizontalAlignment.Right,
								Padding = UDim.new(0, 10),
								SortOrder = Enum.SortOrder.LayoutOrder,
							},
							buildButton(scope, {
								Text = '◀ BACK',
								Visible = scope:Computed(function(use) return use(CurrentPage) > 1 end),
								OnClick = function()
									local p = peek(CurrentPage)
									if p > 1 then CurrentPage:set(p - 1) end
								end,
							}),
							buildButton(scope, {
								Accent = PALETTE.accentHot,
								Text = scope:Computed(function(use)
									return use(CurrentPage) >= PAGE_COUNT and 'FINISH' or 'NEXT ▶'
								end),
								OnClick = function()
									local p = peek(CurrentPage)
									if p >= PAGE_COUNT then
										OnboardingEvent:FireServer(Actions.FinishWelcome)
										Module.CloseWidget()
									else
										CurrentPage:set(p + 1)
									end
								end,
							}),
						},
					},
				},
			},
		},
	}
end

function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true
	-- Display order above the rest of the HUD (OnboardingWidget tooltip = 28).
	ScreenGui = HUDCommon.ensureScreenGui('HUD_JoinGameWelcome', 30)
	RootScope = scoped(Fusion)
	CurrentPage = RootScope:Value(1)
	ResScale = RootScope:Value(1)

	-- Track the (full-screen container's) viewport height so the panel
	-- scales uniformly: clamped so it stays usable on tiny / huge screens.
	local function updateScale()
		if not ScreenGui or not ResScale then return end
		ResScale:set(SIZE_MULT * math.clamp(ScreenGui.AbsoluteSize.Y / DESIGN_H, 0.5, 2))
	end
	ResConn = ScreenGui:GetPropertyChangedSignal('AbsoluteSize'):Connect(updateScale)
	updateScale()

	buildUI(RootScope)
end

function Module.CloseWidget()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	if ResConn then ResConn:Disconnect(); ResConn = nil end
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
	CurrentPage = nil
	ResScale = nil
end

function Module.Start()
	HUDCommon.BindLiveTheme(Module)

	-- Server decides when the popup should appear (first join, flag unset).
	OnboardingEvent.OnClientEvent:Connect(function(action)
		if action == Actions.ShowWelcome then
			Module.OpenWidget()
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/World"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/World/FallingLeavesVFX"><![CDATA[local RunService = game:GetService('RunService')
local CollectionService = game:GetService('CollectionService')

local Players = game:GetService('Players')
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local QuadTreeModule = ReplicatedModules.Modules.QuadTree

local SystemsContainer = {}

local COLLECTION_TAGS = {'FallingLeaves'}
local TOTAL_ACTIVE_FALLING_LEAVES = 24

local ParticlesQuadTree = false
local ParticleRectBoundary = false
local LastUpdateTick = tick()
local LastPosition = nil

local ParticleCache = {}
local InstanceToPoint = {}

local CurrentCamera = workspace.CurrentCamera

local SystemsContainer = {}

local function GetPosition( item )
	return item:IsA("BasePart") and item.Position or item:GetPivot().Position
end

-- // Module // --
local Module = {}

function Module.AppendPoint( item, tag )
	local Pivot = GetPosition( item )

	local point = QuadTreeModule.Point.New({
		x = Pivot.x,
		y = Pivot.z,
		instance = item,
		tag = tag,
	})

	InstanceToPoint[ item ] = point
	ParticlesQuadTree:Insert(point)
end

function Module.RemovePoint( item, _ )
	local Point = InstanceToPoint[ item ]
	if not Point then
		return
	end
	InstanceToPoint[ item ] = nil
	ParticlesQuadTree:Remove( Point )
end

function Module.StepRender()
	local Pivot = CurrentCamera.CFrame.Position
	-- check if the camera has moved around
	if LastPosition and (Pivot - LastPosition).Magnitude < 5 then
		return
	end
	LastPosition = Pivot

	ParticleRectBoundary.x = Pivot.X
	ParticleRectBoundary.y = Pivot.Z

	local withinRender = ParticlesQuadTree:Query(ParticleRectBoundary, {})

	-- sort all points from closest to furthest
	table.sort(withinRender, function(a, b)
		local d1 = (Pivot - GetPosition( a.instance )).Magnitude
		local d2 = (Pivot - GetPosition( b.instance )).Magnitude
		return d1 < d2
	end)

	local currentSFXIndex = {}
	for _, tag in COLLECTION_TAGS do
		currentSFXIndex[tag] = 1
	end

	-- move sounds into nearby related tag instances
	for _, point in withinRender do
		if not currentSFXIndex[point.tag] then
			warn('unsupported tag; ' .. tostring(point.tag))
			continue
		end

		if currentSFXIndex[point.tag] > TOTAL_ACTIVE_FALLING_LEAVES then
			continue
		end

		local SoundIndex = currentSFXIndex[point.tag]
		local Sound = ParticleCache[point.tag][SoundIndex]

		local _, size = point.instance:GetBoundingBox()
		local offset = Vector3.new(0, size.Y / 2, 0)
		Sound:PivotTo(point.instance:GetPivot() + offset)
		Sound.Parent = workspace.Terrain

		currentSFXIndex[point.tag] += 1
	end

	-- move non-playing sounds back
	for tag, soundArray in ParticleCache do
		for index, particles in soundArray do
			if index > currentSFXIndex[tag] then
				particles.Parent = script
			end
		end
	end

end

function Module.Start()
	ParticleRectBoundary = QuadTreeModule.Rectangle.New({width = 256, height = 256})
	-- TODO: move to QuadTree Service
	ParticlesQuadTree = QuadTreeModule.QuadTree.New({
		boundary = QuadTreeModule.Rectangle.New({width = 10240, height = 10240}),
		capacity = 4,
	})

	for _, tag in COLLECTION_TAGS do
		for _, item in CollectionService:GetTagged(tag) do
			Module.AppendPoint(item, tag)
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(function(item)
			Module.AppendPoint(item, tag)
		end)
		CollectionService:GetInstanceRemovedSignal(tag):Connect(function(item)
			Module.RemovePoint(item, tag)
		end)
	end

	RunService.Heartbeat:Connect(function()
		if tick() < LastUpdateTick then
			return
		end
		-- check for update every 1 second
		LastUpdateTick = tick() + 1.5
		Module.StepRender()
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems

	-- create a cache table for the sounds below
	for _, tag in COLLECTION_TAGS do
		ParticleCache[tag] = { }
	end

	-- generate all the sound objects
	for _ = 1, TOTAL_ACTIVE_FALLING_LEAVES do
		local part = ReplicatedAssets.Particles.FallingLeaves:Clone()
		part.Parent = script
		table.insert(ParticleCache.FallingLeaves, part)
	end
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/World/RenderSystemClient"><![CDATA[
local HttpService = game:GetService('HttpService')
local CollectionService = game:GetService('CollectionService')

local Players = game:GetService('Players')
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local LODSettings = ReplicatedModules.Data.LODSettings
local ZoneService = ReplicatedModules.Services.ZoneService
local QuadTree = ReplicatedModules.Modules.QuadTree
local Maid = ReplicatedModules.Modules.Maid

local TEMPORARY_LOD_CONTAINER = ReplicatedStorage:WaitForChild('RenderLODCache')
local TEMPORARY_INTERIORS_CONTAINER = ReplicatedStorage:WaitForChild('RenderInteriorCache')

local ACTIVE_RENDERS_FOLDER = workspace:FindFirstChild('ACTIVE_RENDERS')
if not ACTIVE_RENDERS_FOLDER then
	ACTIVE_RENDERS_FOLDER = Instance.new('Folder')
	ACTIVE_RENDERS_FOLDER.Name = 'ACTIVE_RENDERS'
	ACTIVE_RENDERS_FOLDER.Parent = workspace
end

local CurrentCamera = workspace.CurrentCamera

local LOD_QUAD_TREES = {}

local LOD_TAG_BOUNDS = {} -- tag bounds
local LOD_TAG_BILLBOARD_BOUNDS = {} -- tag billboard bounds

local LOD_TAG_POINTS = {} -- all points in the rendering system
local LOD_ACTIVE_POINTS = {} -- points that are rendered
local LOD_BILLBOARD_ACTIVE_POINTS = {} -- points that have their billboards active

local LOD_INSTANCE_TO_BILLBOARDS = {} -- instance <-> billboard mapping

local INTERIOR_RENDER_DATA = {}

-- Module --
local Module = {}

function Module.GetBillboardForLODInstance(object : Instance, createIfMissing : boolean?) : BillboardGui?
	if LOD_INSTANCE_TO_BILLBOARDS[object] then
		return LOD_INSTANCE_TO_BILLBOARDS[object]
	end
	local TemplateBillboard = ReplicatedAssets.UI.Local.Renders:FindFirstChild( object.Name )
	if createIfMissing and TemplateBillboard then
		local BoundCF, BoundSize
		if object:IsA('Model') then
			BoundCF, BoundSize = object:GetBoundingBox()
		else
			BoundCF, BoundSize = object.CFrame, object.Size
		end
		local Attachment = Instance.new('Attachment')
		Attachment.Name = 'StylizedTreeBillboard'
		Attachment.WorldCFrame = BoundCF * CFrame.new(0, -BoundSize.Y / 2, 0)
		Attachment.Parent = workspace.Terrain
		local Billboard = TemplateBillboard:Clone()
		Billboard.Enabled = false
		Billboard.Adornee = Attachment
		Billboard.Parent = CurrentCamera
		LOD_INSTANCE_TO_BILLBOARDS[object] = Billboard
	end
	return LOD_INSTANCE_TO_BILLBOARDS[object] or nil
end

function Module.DestroyBillboardForLODInstance( object : Instance )
	local Billboard = LOD_INSTANCE_TO_BILLBOARDS[object]
	if Billboard then
		Billboard.Adornee:Destroy() -- attachment
		Billboard:Destroy() -- billboard
		LOD_INSTANCE_TO_BILLBOARDS[object] = nil
	end
end

function Module.SetupLOD()

	-- function to handle object setup
	local function SetupObject(object, tag)
		local success, err = pcall(function()
			object.Parent = TEMPORARY_LOD_CONTAINER
		end)
		if not success then
			warn(object:GetFullName())
			warn(err) -- bones, attachments will appear in the error
			return -- dont append to quad tree
		end
		-- get the bounds position/size
		local cframe, size = nil, nil
		if object:IsA('Model') then
			cframe, size = object:GetBoundingBox()
		elseif object:IsA('BasePart') then
			cframe, size = object.CFrame, object.Size
		end
		-- create the bounds
		local LOD_bounds = QuadTree.Rectangle.New({
			x = cframe.Position.X,
			y = cframe.Position.Z,
			width = size.X,
			height = size.Z,
			data = object,
		})
		-- add to the tag points
		table.insert(LOD_TAG_POINTS[tag], LOD_bounds)
		-- insert it into the quad tree
		LOD_QUAD_TREES[tag]:Insert(LOD_bounds)
	end

	-- function to reset the object
	local function ResetObject(object, tag)
		local success, err = pcall(function()
			object.Parent = TEMPORARY_LOD_CONTAINER
		end)
		if not success then
			warn(object:GetFullName())
			warn(err) -- bones, attachments will appear in the error
		end
		-- delete the object bounds
		for index, bounds in LOD_TAG_POINTS[tag] do
			if bounds.data == object then
				LOD_QUAD_TREES[tag]:Remove(bounds)
				table.remove(LOD_TAG_POINTS[tag], index)
				break
			end
		end
		-- delete the billboard if found
		Module.DestroyBillboardForLODInstance(object)
	end

	for _, LODTag in LODSettings.LODTags do
		if table.find(LODSettings.ClientEnabled, LODTag) then
			continue
		end

		-- generate the render distance bounds
		local RD = LODSettings.LODRenderDistances[LODTag] or LODSettings.LODRenderDistances.Default
		local LODBounds = QuadTree.Rectangle.New({
			x = 0,
			y = 0,
			width = RD,
			height = RD,
		})
		LOD_TAG_BOUNDS[LODTag] = LODBounds

		local BillboardRD = LODSettings.BillboardRenderDistances[LODTag] or LODSettings.BillboardRenderDistances.Default
		local LODBillboardBounds = QuadTree.Rectangle.New({
			x = 0,
			y = 0,
			width = BillboardRD,
			height = BillboardRD,
		})
		LOD_TAG_BILLBOARD_BOUNDS[LODTag] = LODBillboardBounds

		-- generate the tag quad tree
		local QuadTreeBounds = QuadTree.Rectangle.New({
			x = 0,
			y = 0,
			width = LODSettings.MaximumQuadTreeBounds,
			height = LODSettings.MaximumQuadTreeBounds,
		})
		-- TODO: move to QuadTree Service
		LOD_QUAD_TREES[LODTag] = QuadTree.QuadTree.New({boundary = QuadTreeBounds})

		-- array of render items
		LOD_TAG_POINTS[LODTag] = {}

		--print('Hiding LODTag:', LODTag)
		-- un-render the rest on the server
		for _, object in CollectionService:GetTagged(LODTag) do
			task.defer(SetupObject, object, LODTag)
		end
		-- unrender any newly tagged instances
		CollectionService:GetInstanceAddedSignal(LODTag):Connect(function(object)
			SetupObject(object, LODTag)
		end)
		-- reset untagged instances
		CollectionService:GetInstanceRemovedSignal(LODTag):Connect(function(object)
			ResetObject(object, LODTag)
		end)
	end

end

function Module.SetupInteriors()

	-- function to handle object setup
	local function SetupObject(object, tag)
		-- objects container
		local ObjectsContainer = object:FindFirstChild('Objects')
		if not ObjectsContainer then
			warn('Could not find "Objects" item in Interior: '..tostring(object:GetFullName()))
			return
		end
		-- zones container
		local ZonesContainer = object:FindFirstChild('Zones')
		if not ZonesContainer then
			warn('Could not find "Zones" item in Interior: '..object:GetFullName())
			return
		end
		-- setup interior params
		local InteriorData = { UUID = HttpService:GenerateGUID(false), Tag = tag, Objects = {}, Zones = {}, Maid = Maid.New(), }
		-- change the properties to the adjusted ones
		for _, zoneObject in ZonesContainer:GetChildren() do
			if zoneObject:IsA('BasePart') then
				zoneObject.CanCollide = false
				zoneObject.CanQuery = true
				zoneObject.CanTouch = false
				zoneObject.CastShadow = false
				zoneObject.Transparency = 1
				zoneObject.Massless = true
				table.insert(InteriorData.Zones, zoneObject)
			else
				warn('Unsupported Zone object in Zones container: '..object:GetFullName())
			end
		end

		InteriorData.Maid:Give(ZonesContainer.ChildAdded:Connect(function(item)
			if item:IsA('BasePart') and not table.find(InteriorData.Zones, item) then
				table.insert(InteriorData.Zones, item)
			end
		end))

		InteriorData.Maid:Give(ZonesContainer.ChildRemoved:Connect(function(item)
			if item:IsA('BasePart') and table.find(InteriorData.Zones, item) then
				table.remove(InteriorData.Zones, table.find(InteriorData.Zones, item))
			end
		end))

		ZoneService.RegisterZone(InteriorData.UUID, InteriorData.Zones)

		-- iterate each ObjectValue or Instance under the Objects container.
		local function onObjectReferenceAdded(objectReference)
			local renderItem = objectReference
			if objectReference:IsA('ObjectValue') then
				renderItem = objectReference.Value
			end
			if not renderItem then
				warn('ObjectValue has no reference: '..objectReference:GetFullName())
				return
			end
			table.insert(InteriorData.Objects, renderItem)
			local success, err = pcall(function()
				renderItem.Parent = TEMPORARY_INTERIORS_CONTAINER
			end)
			if not success then
				warn(renderItem:GetFullName())
				warn(err) -- bones, attachments will appear in the error
			end
		end

		for _, objectReference in ObjectsContainer:GetChildren() do
			onObjectReferenceAdded(objectReference)
		end
		InteriorData.Maid:Give(ObjectsContainer.ChildAdded:Connect(onObjectReferenceAdded))

		InteriorData.Maid:Give(ZonesContainer.ChildRemoved:Connect(function(item)
			if item:IsA('BasePart') and table.find(InteriorData.Zones, item) then
				table.remove(InteriorData.Zones, table.find(InteriorData.Zones, item))
			end
		end))

		-- cache interior data
		INTERIOR_RENDER_DATA[object] = InteriorData
	end

	-- function to reset the object
	local function ResetObject(object, _)
		-- check if the data exists
		local data = INTERIOR_RENDER_DATA[object]
		if not data then
			return
		end
		-- reset all the objects and unregister the zone parts
		for _, renderItem in INTERIOR_RENDER_DATA[object].Objects do
			renderItem.Parent = ACTIVE_RENDERS_FOLDER
		end
		INTERIOR_RENDER_DATA[object] = nil
		-- unregister the zone parts
		ZoneService.UnRegisterZoneParts(data.Zones)
	end

	for _, InteriorTag in LODSettings.InteriorTags do
		if table.find(LODSettings.ClientEnabled, InteriorTag) then
			continue
		end
		--print('Hiding InteriorTag:', InteriorTag)
		-- un-render the interior objects
		for _, object in CollectionService:GetTagged(InteriorTag) do
			task.defer(SetupObject, object, InteriorTag)
		end
		-- unrender any newly tagged instances
		CollectionService:GetInstanceAddedSignal(InteriorTag):Connect(function(object)
			SetupObject(object, InteriorTag)
		end)
		-- reset untagged instances
		CollectionService:GetInstanceRemovedSignal(InteriorTag):Connect(function(object)
			ResetObject(object, InteriorTag)
		end)
	end

end

function Module.UpdateLODs()
	-- move all render bounds to the current position
	local Position = LocalPlayer.Character and LocalPlayer.Character:GetPivot().Position or CurrentCamera.CFrame.Position
	local Velocity = LocalPlayer.Character and LocalPlayer.Character.PrimaryPart and LocalPlayer.Character.PrimaryPart.AssemblyLinearVelocity

	-- query all quad-trees for nearby points
	local nearby_points = {}
	local nearby_billboards = {}

	-- iterate each quad tree
	for LODTag, tree in LOD_QUAD_TREES do
		-- ignore any non-whitelisted high-velocity
		-- rendering tags when higher than the velocity threshold
		if Velocity and Velocity.Magnitude > LODSettings.HighVelocityThreshold then
			if not table.find(LODSettings.HighVelocityTagWhitelist, LODTag) then
				continue
			end
		end

		-- normal render distance
		local bounds = LOD_TAG_BOUNDS[LODTag]
		bounds.x = Position.X
		bounds.y = Position.Z
		local points = tree:Query(bounds, {})
		if #points > 0 then
			table.move(points, 1, #points, #nearby_points+1, nearby_points)
		end

		-- check if tag is whitelisted for billboards
		if not table.find(LODSettings.BillboardEnabledTags, LODTag) then
			continue
		end

		-- billboard render distance
		local boundsBB = LOD_TAG_BILLBOARD_BOUNDS[LODTag]
		boundsBB.x = Position.X
		boundsBB.y = Position.Z
		local bbpoints = tree:Query(boundsBB, {})
		if #bbpoints > 0 then
			table.move(bbpoints, 1, #bbpoints, #nearby_billboards+1, nearby_billboards)
		end
	end

	-- print(#nearby_billboards)

	-- un-render objects that are no longer nearby
	local index = 1
	while index <= #LOD_ACTIVE_POINTS do
		local bounds = LOD_ACTIVE_POINTS[index]
		if table.find(nearby_points, bounds) then
			index += 1
		else
			table.remove(LOD_ACTIVE_POINTS, index)
			bounds.data.Parent = TEMPORARY_LOD_CONTAINER
			if index % 100 == 0 then
				task.wait()
			end
		end
	end

	-- destroy billboards that are no longer nearby
	index = 1
	while index <= #LOD_BILLBOARD_ACTIVE_POINTS do
		local bounds = LOD_BILLBOARD_ACTIVE_POINTS[index]
		if table.find(nearby_points, bounds) or not table.find(nearby_billboards, bounds) then
			table.remove(LOD_BILLBOARD_ACTIVE_POINTS, index)
			Module.DestroyBillboardForLODInstance(bounds.data)
		else
			index += 1
		end
	end

	-- render any new objects that are not rendering already
	for _, bounds in nearby_points do
		if not table.find(LOD_ACTIVE_POINTS, bounds) then
			table.insert(LOD_ACTIVE_POINTS, bounds)
			bounds.data.Parent = ACTIVE_RENDERS_FOLDER
			if index % 100 == 0 then
				task.wait()
			end
		end
	end

	-- render any new billboards that can be rendered
	for _, bounds in nearby_billboards do
		-- skip any loaded renders
		if table.find(LOD_ACTIVE_POINTS, bounds) then
			continue
		end
		-- if it is not rendering, render it
		if not table.find(LOD_BILLBOARD_ACTIVE_POINTS, bounds) then
			table.insert(LOD_BILLBOARD_ACTIVE_POINTS, bounds)
			local billboard = Module.GetBillboardForLODInstance(bounds.data, true)
			if billboard then
				billboard.Enabled = true
			end
		end
	end

end

function Module.UpdateInteriors(targetZone : string?)
	local withinZones : {string} = ZoneService.GetZonesPlayerIsWithin(LocalPlayer)
	for _, interiorData in INTERIOR_RENDER_DATA do
		if targetZone and targetZone ~= interiorData.UUID then
			continue -- not the target zone if specified
		end
		if table.find(withinZones, interiorData.UUID) then
			-- load if not already loaded
			for index, object in interiorData.Objects do
				if object.Parent == TEMPORARY_INTERIORS_CONTAINER then
					object.Parent = ACTIVE_RENDERS_FOLDER
					if index % 100 == 0 then
						task.wait()
					end
				end
			end
		else
			-- unload if not already unloaded
			for index, object in interiorData.Objects do
				if object.Parent ~= TEMPORARY_INTERIORS_CONTAINER then
					object.Parent = TEMPORARY_INTERIORS_CONTAINER
					if index % 100 == 0 then
						task.wait()
					end
				end
			end
		end
	end
end

function Module.CharacterAdded(character : Model)
	if not character then
		return
	end

	local Humanoid : Humanoid = character:WaitForChild('Humanoid', 5)
	if not Humanoid then
		return
	end

end

function Module.Init()
	Module.SetupLOD()
	Module.SetupInteriors()

	ZoneService.ZoneEnter:Connect(function(character : Model, zone : string)
		--print('Enter Zone:', zone)
		Module.UpdateInteriors(zone)
	end)

	ZoneService.ZoneLeave:Connect(function(character : Model, zone : string)
		--print('Leave Zone:', zone)
		Module.UpdateInteriors(zone)
	end)
end

function Module.Start()
	Module.UpdateLODs()
	Module.UpdateInteriors()

	task.spawn(function()
		while true do
			task.wait(0.5)
			Module.UpdateLODs()
		end
	end)

	for _, player in Players:GetPlayers() do
		Module.CharacterAdded(player.Character)
		player.CharacterAdded:Connect(Module.CharacterAdded)
	end

	Players.PlayerAdded:Connect(function(player)
		Module.CharacterAdded(player.Character)
		player.CharacterAdded:Connect(Module.CharacterAdded)
	end)
end

return Module

]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/World/FootstepClient"><![CDATA[local RunService = game:GetService("RunService")

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')

local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))
local MaidClassModule = ReplicatedModules.Modules.Maid

local FootstepSoundsInstance = ReplicatedAssets.Sounds.FootstepSounds

local SystemsContainer = {}

local ActiveCharacterData = { }
local CharacterToPlayerCache = { }

-- // Module // --
local Module = {}

function Module.CleanupPlayerInstance( PlayerInstance )
	-- cleanup old character for this player
	if CharacterToPlayerCache[ PlayerInstance ] then
		Module.CleanupCharacter( CharacterToPlayerCache[ PlayerInstance ] )
	end
	CharacterToPlayerCache[ PlayerInstance ] = nil
end

function Module.CleanupCharacter( CharacterInstance )
	if ActiveCharacterData[ CharacterInstance ] then
		ActiveCharacterData[ CharacterInstance ].Maid:Cleanup()
	end
	ActiveCharacterData[ CharacterInstance ] = nil
end

function Module.StopSoundInstances( SoundInstances )
	for _, soundInstance in SoundInstances do
		soundInstance:Stop(0.15)
	end
end

function Module.UpdateCharacterMaterialSounds( CharacterData )
	-- if they are not walking, stop all sounds
	if not CharacterData.Walking then
		Module.StopSoundInstances( CharacterData.Sounds:GetChildren() )
		return
	end

	-- stop playing old material sound
	local CurrentMaterial = CharacterData.CurrentMaterial
	local LastMaterial = CharacterData.LastMaterial
	if LastMaterial and CurrentMaterial ~= LastMaterial then
		local LastMaterialSound = CharacterData.Sounds:FindFirstChild( LastMaterial )
		if LastMaterialSound then
			LastMaterialSound:Stop( 0.15 )
		end
	end
	CharacterData.LastMaterial = CurrentMaterial

	local CurrentMaterialSound = CurrentMaterial and CharacterData.Sounds:FindFirstChild( CurrentMaterial )
	if not CurrentMaterialSound then
		return
	end

	-- edit playback speed
	local PlaybackSpeed = CharacterData.CurrentSpeed / (CharacterData.Humanoid.WalkSpeed * 0.75)
	CurrentMaterialSound.PlaybackSpeed = PlaybackSpeed

	-- play new material sound if not already playing
	if not CurrentMaterialSound.IsPlaying then
		CurrentMaterialSound:Play( 0.15 )
	end
end

function Module.OnCharacterAdded( PlayerInstance, CharacterInstance )
	local Humanoid = CharacterInstance and CharacterInstance:WaitForChild('Humanoid', 5)
	if not Humanoid then
		return
	end

	local HumanoidRootPart = CharacterInstance:WaitForChild('HumanoidRootPart', 5)
	if not HumanoidRootPart then
		return
	end

	-- set the new character into the cache
	Module.CleanupPlayerInstance( PlayerInstance )
	CharacterToPlayerCache[ PlayerInstance ] = CharacterInstance

	-- character maid stuff
	local CharacterMaid = MaidClassModule.New()

	CharacterMaid:Give(Humanoid.Died:Connect(function()
		Module.CleanupCharacter( CharacterInstance )
	end))

	CharacterMaid:Give(Humanoid:GetPropertyChangedSignal("FloorMaterial"):Connect(function()
		ActiveCharacterData[ CharacterInstance ].CurrentMaterial = Humanoid.FloorMaterial.Name
	end))

	CharacterMaid:Give(Humanoid.Running:Connect(function(speed)
		-- must be a minumum speed to be walking
		ActiveCharacterData[ CharacterInstance ].CurrentSpeed = speed
		ActiveCharacterData[ CharacterInstance ].Walking = speed > (Humanoid.WalkSpeed / 2)
	end))

	local FootstepSoundClone = FootstepSoundsInstance:Clone()
	FootstepSoundClone.Parent = CharacterInstance

	ActiveCharacterData[ CharacterInstance ] = {
		Humanoid = Humanoid,
		Sounds = FootstepSoundClone,
		Walking = false,
		CurrentSpeed = 0,
		CurrentMaterial = false,
		LastMaterial = false,
		Maid = CharacterMaid,
	}

	-- disable normal character sounds
	for _, SoundInstance in HumanoidRootPart:GetChildren() do
		if SoundInstance:IsA("Sound") then
			SoundInstance.Volume = 0
		end
	end
end

function Module.OnPlayerAdded( PlayerInstance )
	task.defer(Module.OnCharacterAdded, PlayerInstance, PlayerInstance.Character)
	PlayerInstance.CharacterAdded:Connect(function( CharacterInstance )
		Module.OnCharacterAdded( PlayerInstance, CharacterInstance )
	end)
end

function Module.Start()
	Module.OnPlayerAdded( LocalPlayer )
	for _, PlayerInstance in Players:GetPlayers() do
		if PlayerInstance == LocalPlayer then
			continue
		end
		Module.OnPlayerAdded( PlayerInstance )
	end

	Players.PlayerAdded:Connect(Module.OnPlayerAdded)
	Players.PlayerRemoving:Connect(Module.CleanupPlayerInstance)

	RunService.Heartbeat:Connect(function(_)
		for CharacterInstance, CharacterData in ActiveCharacterData do
			if (not CharacterInstance.Parent) or CharacterInstance.Humanoid.Health <= 0 then
				Module.CleanupCharacter( CharacterInstance )
				continue
			end
			Module.UpdateCharacterMaterialSounds( CharacterData )
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/World/TreeRustleSFX"><![CDATA[local RunService = game:GetService('RunService')
local CollectionService = game:GetService('CollectionService')

local Players = game:GetService('Players')
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local PlantRustleSound = ReplicatedAssets.Sounds.Local.PlantRustleSFX
local TreeRustleSound = ReplicatedAssets.Sounds.Local.TreeRustleSFX

local QuadTreeModule = ReplicatedModules.Modules.QuadTree

local SystemsContainer = {}

local COLLECTION_TAGS = {'PLANT_RUSTLING', 'TREE_RUSTLING'}
local TOTAL_ACTIVE_SFX_SOUNDS = 10

local RustleSFXQuadTree = false
local SoundRectBoundary = false
local LastUpdateTick = tick()
local LastPosition = nil

local SoundsCache = {}
local InstanceToPoint = {}

local CurrentCamera = workspace.CurrentCamera

local function GetPosition( item )
	return item:IsA("BasePart") and item.Position or item:GetPivot().Position
end

-- // Module // --
local Module = {}

function Module.AppendSFXPoint( item, tag )
	local Pivot = GetPosition( item )

	local point = QuadTreeModule.Point.New({
		x = Pivot.x,
		y = Pivot.z,
		instance = item,
		tag = tag,
	})

	InstanceToPoint[ item ] = point
	RustleSFXQuadTree:Insert(point)
end

function Module.RemoveSFXPoint( item, _ )
	local Point = InstanceToPoint[ item ]
	if not Point then
		return
	end
	InstanceToPoint[ item ] = nil
	RustleSFXQuadTree:Remove( Point )
end

function Module.StepRender()
	local Pivot = CurrentCamera.CFrame.Position
	-- check if the camera has moved around
	if LastPosition and (Pivot - LastPosition).Magnitude < 5 then
		return
	end
	LastPosition = Pivot

	SoundRectBoundary.x = Pivot.X
	SoundRectBoundary.y = Pivot.Z

	local withinRender = RustleSFXQuadTree:Query(SoundRectBoundary, { })

	-- sort all points from closest to furthest
	table.sort(withinRender, function(a, b)
		local d1 = (Pivot - GetPosition( a.instance )).Magnitude
		local d2 = (Pivot - GetPosition( b.instance )).Magnitude
		return d1 < d2
	end)

	local currentSFXIndex = {}
	for _, tag in COLLECTION_TAGS do
		currentSFXIndex[tag] = 1
	end

	-- move sounds into nearby related tag instances
	for _, point in withinRender do
		if not currentSFXIndex[point.tag] then
			warn('unsupported tag; ' .. tostring(point.tag))
			continue
		end

		if currentSFXIndex[point.tag] > TOTAL_ACTIVE_SFX_SOUNDS then
			continue
		end

		local SoundIndex = currentSFXIndex[point.tag]
		local Sound = SoundsCache[point.tag][SoundIndex]
		Sound.Parent = point.instance
		Sound.Playing = true

		currentSFXIndex[point.tag] += 1
	end

	-- move non-playing sounds back
	for tag, soundArray in SoundsCache do
		for index, sound in soundArray do
			if index > currentSFXIndex[tag] then
				sound.Playing = false
				sound.Parent = script
			end
		end
	end

end

function Module.Start()
	SoundRectBoundary = QuadTreeModule.Rectangle.New({ width = 50, height = 50 })
	-- TODO: move to QuadTree Service
	RustleSFXQuadTree = QuadTreeModule.QuadTree.New({
		boundary = QuadTreeModule.Rectangle.New({width = 10240, height = 10240}),
		capacity = 4,
	})

	for _, tag in COLLECTION_TAGS do
		for _, item in CollectionService:GetTagged(tag) do
			Module.AppendSFXPoint( item, tag )
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(function(item)
			Module.AppendSFXPoint( item, tag )
		end)
		CollectionService:GetInstanceRemovedSignal(tag):Connect(function(item)
			Module.RemoveSFXPoint( item, tag )
		end)
	end

	RunService.Heartbeat:Connect(function()
		if tick() < LastUpdateTick then
			return
		end
		-- check for update every 1 second
		LastUpdateTick = tick() + 1.5
		Module.StepRender()
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems

	-- create a cache table for the sounds below
	for _, tag in COLLECTION_TAGS do
		SoundsCache[tag] = { }
	end

	-- generate all the sound objects
	for _ = 1, TOTAL_ACTIVE_SFX_SOUNDS do
		local SFX1 = PlantRustleSound:Clone()
		SFX1.Parent = script
		table.insert(SoundsCache.PLANT_RUSTLING, SFX1)
		local SFX2 = TreeRustleSound:Clone()
		SFX2.Parent = script
		table.insert(SoundsCache.TREE_RUSTLING, SFX2)
	end
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/World/TreeGenerator"><![CDATA[local CollectionService = game:GetService('CollectionService')

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedSharedAssets = ReplicatedStorage:WaitForChild('AssetsShared')
local ReplicatedGameAssets = ReplicatedStorage:WaitForChild('Assets')
local RenderLODCache = ReplicatedStorage:WaitForChild('RenderLODCache')

local SystemsContainer = {}

-- // Module // --
local Module = {}

function Module.GetRandomPointInRotatedRectangle(part : BasePart, rng : Random) : Vector3
	-- Get the part's size and rotation
	local size = part.Size
	-- Generate a random point in the local space of the part
	local randomX = rng:NextNumber() * size.X - size.X / 2
	local randomZ = rng:NextNumber() * size.Z - size.Z / 2
	local localPoint = Vector3.new(randomX, 0, randomZ)
	-- Transform the local point to world space
	return part.CFrame:PointToWorldSpace(localPoint)
end

function Module.GetWeightedChancePart(objects : {BasePart}, rng : Random) : BasePart
	local totalWeight : number = 0
	for _, object in objects do
		totalWeight += object.Size.Magnitude
	end
	local randomWeight : number = totalWeight * rng:NextNumber()
	local currentWeight : number = 0
	for _, object in objects do
		currentWeight += object.Size.Magnitude
		if currentWeight > randomWeight then
			return object
		end
	end
	return objects[#objects]
end

function Module.RaycastDownToGrassTerrain(position : Vector3) : Vector3?
	local raycastParams = RaycastParams.new()
	raycastParams.FilterDescendantsInstances = {workspace.Terrain}
	raycastParams.FilterType = Enum.RaycastFilterType.Include
	local raycastResult : RaycastResult? = workspace:Raycast(position, Vector3.new(0, -100, 0), raycastParams)
	if raycastResult then
		return raycastResult.Position
	end
	return nil
end

function Module.CheckIfSpaceIsTaken(position : Vector3, size : Vector3, overlap : OverlapParams) : boolean
	return #workspace:GetPartBoundsInBox(CFrame.new(position), size, overlap) == 0
end

function Module.Generate(seed : number, treeCount : number, bushCount : number, flowerCount : number)
	if not LocalPlayer.Character then
		LocalPlayer.CharacterAdded:Wait()
	end

	local VegetationSpawnArea = ReplicatedGameAssets:FindFirstChild('VegetationSpawnArea')
	if not VegetationSpawnArea then
		print('game has no VegetationSpawnArea in ReplicatedStorage.Assets')
		return
	end

	local overlap = OverlapParams.new()
	overlap.FilterDescendantsInstances = {workspace.Terrain}
	overlap.FilterType = Enum.RaycastFilterType.Exclude

	local rng = Random.new(seed)
	local objects = VegetationSpawnArea:GetChildren()

	print('Generating Trees: ', treeCount)
	for _ = 1, treeCount do
		-- tree
		local spawnPart = Module.GetWeightedChancePart(objects, rng)
		local spawnLocation = spawnPart and Module.GetRandomPointInRotatedRectangle(spawnPart, rng)
		local terrainSpawnLocation = spawnLocation and Module.RaycastDownToGrassTerrain(spawnLocation)
		if not terrainSpawnLocation then
			continue
		end
		local _, size = ReplicatedSharedAssets.Models.Vegetation.StylizedTree:GetBoundingBox()
		if Module.CheckIfSpaceIsTaken(terrainSpawnLocation, size, overlap) then
			continue
		end
		local object = ReplicatedSharedAssets.Models.Vegetation.StylizedTree:Clone()
		object:PivotTo(CFrame.new(terrainSpawnLocation) + Vector3.new(0, (size.Y / 2) - 0.2, 0))
		object.Parent = RenderLODCache.Landscape.StylizedTrees
		task.wait()
		CollectionService:AddTag(object, 'TreeLOD')
	end

	print('Generating Bushes: ', bushCount)
	for _ = 1, bushCount do
		local spawnPart = Module.GetWeightedChancePart(objects, rng)
		local spawnLocation = spawnPart and Module.GetRandomPointInRotatedRectangle(spawnPart, rng)
		local terrainSpawnLocation = spawnLocation and Module.RaycastDownToGrassTerrain(spawnLocation)
		if not terrainSpawnLocation then
			continue
		end
		local _, size = ReplicatedSharedAssets.Models.Vegetation.Bush:GetBoundingBox()
		if Module.CheckIfSpaceIsTaken(terrainSpawnLocation, size, overlap) then
			continue
		end
		local object = ReplicatedSharedAssets.Models.Vegetation.Bush:Clone()
		object:PivotTo(CFrame.new(terrainSpawnLocation) + Vector3.new(0, size.Y / 2, 0))
		object.Parent = RenderLODCache.Landscape.Bushes
		task.wait()
		CollectionService:AddTag(object, 'FoliageLOD')
	end

	print('Generating Flowers: ', flowerCount)
	for _ = 1, flowerCount do
		local spawnPart = Module.GetWeightedChancePart(objects, rng)
		local spawnLocation = spawnPart and Module.GetRandomPointInRotatedRectangle(spawnPart, rng)
		local terrainSpawnLocation = spawnLocation and Module.RaycastDownToGrassTerrain(spawnLocation)
		if not terrainSpawnLocation then
			continue
		end
		local _, size = ReplicatedSharedAssets.Models.Vegetation.FlowerPatch:GetBoundingBox()
		if Module.CheckIfSpaceIsTaken(terrainSpawnLocation, size, overlap) then
			continue
		end
		local object = ReplicatedSharedAssets.Models.Vegetation.FlowerPatch:Clone()
		object:PivotTo(CFrame.new(terrainSpawnLocation) + Vector3.new(0, size.Y / 2, 0))
		object.Parent = RenderLODCache.Landscape.Flowers
		task.wait()
		CollectionService:AddTag(object, 'FoliageLOD')
	end
end

function Module.Start()
	task.spawn(Module.Generate, 1, 12500, 12500, 12500)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/World/DeathEffectClient"><![CDATA[local CollectionService = game:GetService('CollectionService')
local Debris = game:GetService('Debris')
local TweenService = game:GetService('TweenService')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')

local TAG_NAME = "DEATH_EFFECT"

local SystemsContainer = {}

local function GetDescendantBaseParts( Parent )
	local Descendants = Parent:GetDescendants()
	table.insert(Descendants, Parent)
	return Descendants
end

-- // Module // --
local Module = {}

function Module.UndoDeathEffect( Character )
	Character:SetAttribute("DeathEffectTag", nil)

	local Descendants = GetDescendantBaseParts( Character )
	for _, descendant in Descendants do
		if descendant:IsA("BasePart") then
			local Transparency = (descendant.Name ~= "HumanoidRootPart") and 0 or 1
			descendant.Transparency = Transparency
		elseif descendant:IsA("ParticleEmitter") and descendant.Name == "DeathParticle" then
			descendant:Destroy()
		elseif descendant:IsA("Decal") then
			descendant.Transparency = descendant:GetAttribute("InitTransparency") or descendant.Transparency
		elseif descendant:IsA("BillboardGui") then
			descendant.Enabled = descendant:GetAttribute("InitEnabled") or descendant.Enabled
		end
	end
end

function Module.RunDeathEffect( Character )
	Character:SetAttribute("DeathEffectTag", true)

	local Descendants = GetDescendantBaseParts( Character )
	for _, descendant in Descendants do
		if descendant:IsA("BasePart") then
			if descendant.Transparency == 1 then
				continue
			end
			TweenService:Create( descendant, TweenInfo.new(1.25), { Transparency = 1 } ):Play()
			for _, Particle in ReplicatedAssets.Particles.DeathShatter:GetChildren() do
				local Item = Particle:Clone()
				Item.Parent = descendant
				Item:Emit(10)
				Debris:AddItem(Item, 10)
			end
		elseif descendant:IsA("Decal") then
			if not descendant:GetAttribute("InitTransparency") then
				descendant:SetAttribute("InitTransparency", descendant.Transparency )
			end
			descendant.Transparency = 1
		elseif descendant:IsA("BillboardGui") then
			if not descendant:GetAttribute("InitEnabled") then
				descendant:SetAttribute("InitEnabled", descendant.Enabled )
			end
			descendant.Enabled = false
		end
	end
end

function Module.Start()
	for _, Character in CollectionService:GetTagged(TAG_NAME) do
		task.defer(Module.RunDeathEffect, Character)
	end

	CollectionService:GetInstanceAddedSignal(TAG_NAME):Connect(Module.RunDeathEffect)
	CollectionService:GetInstanceRemovedSignal(TAG_NAME):Connect(Module.UndoDeathEffect)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/World/FirefliesClient"><![CDATA[
-- TODO: use quad-tree service to render only nearby fireflies on characters around the player

local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")

local COLLECTION_TAG = 'FIREFLIES_SURROUND'

local MAX_RANGE_AROUND_OBJECT = 9
local MIN_RANGE_AROUND_OBJECT = 3
local FIREFLY_SPEED = 0.7
local FIREFLY_MINIMUM_DURATION = 1
local MINIMUM_DELAY_BETWEEN_SPAWNS = 0.9

local LAST_FIREFLY_SPAWN = {} :: { [PVInstance] : number }

local SystemsContainer = {}

local baseFirefly = Instance.new('Part')
baseFirefly.Size = Vector3.new(0.05, 0.05, 0.05)
baseFirefly.Material = Enum.Material.Neon
baseFirefly.Color = Color3.fromRGB(255, 231, 18)
baseFirefly.Anchored = true
baseFirefly.CanCollide = false
baseFirefly.CanTouch = false
baseFirefly.CanQuery = false
baseFirefly.Transparency = 0
baseFirefly.TopSurface = Enum.SurfaceType.Smooth
baseFirefly.BottomSurface = Enum.SurfaceType.Smooth

-- // Module // --
local Module = {}

function Module.GetRandomOffsetFromPosition(position : Vector3) : Vector3
	local range = (MAX_RANGE_AROUND_OBJECT - MIN_RANGE_AROUND_OBJECT)
	local offset = Vector3.new(
		(math.random(0, range) + MIN_RANGE_AROUND_OBJECT) * (math.random(1, 2) == 1 and -1 or 1),
		math.random(-range, range),
		(math.random(0, range) + MIN_RANGE_AROUND_OBJECT) * (math.random(1, 2) == 1 and -1 or 1)
	)
	return position + offset
end

function Module.FirefliesUpdate()
	local now = time()
	for _, object : PVInstance in CollectionService:GetTagged(COLLECTION_TAG) do
		-- ignore non-pivotable items
		if not object:IsA('PVInstance') then
			continue
		end

		-- check for active data
		if LAST_FIREFLY_SPAWN[object] and (now - LAST_FIREFLY_SPAWN[object]) < MINIMUM_DELAY_BETWEEN_SPAWNS  then
			continue
		end
		LAST_FIREFLY_SPAWN[object] = now

		local objectPosition = object:GetPivot().Position
		local firflyStart : Vector3 = Module.GetRandomOffsetFromPosition(objectPosition)
		local firflyEnd : Vector3 = Module.GetRandomOffsetFromPosition(objectPosition)

		local firefly : Part = baseFirefly:Clone()
		firefly.Position = firflyStart
		firefly.Parent = workspace.Terrain

		local duration : number = (firflyEnd - firflyStart).Magnitude / FIREFLY_SPEED
		duration = math.max(duration, FIREFLY_MINIMUM_DURATION)
		TweenService:Create(firefly, TweenInfo.new(duration), {Position = firflyEnd}):Play()
		task.delay(duration - 0.5, function()
			TweenService:Create(firefly, TweenInfo.new(1), {Transparency = 1}):Play()
			task.wait(1)
			firefly:Destroy()
		end)
	end
end

function Module.ValidateTagInstance(object : Instance)
	-- only accept PVInstances in the tag (so we can use PivotTo/GetPivot)
	if not object:IsA('PVInstance') then
		CollectionService:RemoveTag(object, COLLECTION_TAG)
	end
end

function Module.OnObjectRemoved(object : Instance)
	LAST_FIREFLY_SPAWN[object] = nil
end

function Module.Start()

	for _, object in CollectionService:GetTagged(COLLECTION_TAG) do
		task.defer(Module.ValidateTagInstance, object)
	end
	CollectionService:GetInstanceAddedSignal(COLLECTION_TAG):Connect(Module.ValidateTagInstance)
	CollectionService:GetInstanceRemovedSignal(COLLECTION_TAG):Connect(Module.OnObjectRemoved)

	task.spawn(function()
		while true do
			task.wait(0.1)
			Module.FirefliesUpdate()
		end
	end)

end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="StarterPlayer/StarterPlayerScripts/Core/World/WindEffectClient"><![CDATA[
