		<Source path="ReplicatedStorage/Modules/Data/Quests"><![CDATA[
export type BaseQuestData = {
	SubQuestIndex: number,
	Contributions: {[string]: number},
	-- Is this in-flight quest currently surfaced in the on-screen tracker?
	-- Toggled via QuestServer's `RemoteJobs.ToggleTracked` job.
	is_tracked: boolean,
}

export type DataQuestContainer = {
	-- [questId]
	[string]: {
		-- [uuid]: QuestData
		[string]: BaseQuestData
	}
}

export type CompletedQuestsContainer = {[string]: number}

export type BasePlayerData = {
	Level: number,
	ActiveQuests: DataQuestContainer,
	CompletedQuests: CompletedQuestsContainer,
}

export type ViewportIcon = {}

export type DisplayConfig = {
	Title: {Text: string, TextColor3: Color3},
	Description: {Text: string, TextColor3: Color3},
	Icon: ViewportIcon | string | number,
}

export type ContributionsConfig = {
	[string]: {string} | {[string]: number},
}

export type SubQuestConfig = {
	Contributions: ContributionsConfig,
	Display: DisplayConfig,
}

export type RewardsConfigTable = {
	Currency: number?,
	Experience: number?,

	Items: {[string]: number}?,
	Skills: {string}?,
	Attributes: {string}?,
}

export type QuestConfigTable = {
	Requirements: {
		Repeatable: boolean,
		MinimumLevel: number,
	},
	SubQuests: {SubQuestConfig},
	Continuation: {string},
	Rewards: RewardsConfigTable
}

export type PlayerDataBase = {
	Quests: DataQuestContainer,
	ActiveQuests: {[string] : {string}}
}

local function CountDictionary(dict: {[any]: any}): number
	local count = 0
	for k, v in dict do
		count += 1
	end
	return count
end


local function CreateBaseDisplay(TitleText, Description, IconData)
	return {
		Title = { Text = TitleText, TextColor3 = Color3.new(1, 1, 1), },
		Description = { Text = Description, TextColor3 = Color3.new(1, 1, 1), },
		Icon = IconData, -- table = viewport data, string/number = icon image id
	}
end

local function CreateSubQuestData(contributions, display): SubQuestConfig
	return { Contributions = contributions, Display = display, }
end

-- // Module // --
local Module = {}

Module.ArrayContributions = {
	-- array of strings (npc names)
	Defeat = "1",
	-- array of strings (places to visit)
	Visit = "2",
	-- array of strings relating to objects
	Interact = "3",
	-- array of strings relating to NPCs
	Talk = "4",
}

Module.DictContributions = {
	-- dictionary, itemName = amount
	Collect = "5",
	-- dictionary, npcName = amount
	Subjugate = "6",
	-- dict, statName = reqAmount
	StatValues = "7",
}

Module.ContributionStringFormating = {
	Default = function(a, b)
		return tostring(a)..' - '..tostring(b)
	end,

	[Module.ArrayContributions.Defeat] = function(_, value)
		return string.format("Defeat [%s]", tostring(value))
	end,
	[Module.ArrayContributions.Visit] = function(_, value)
		return string.format("Visit [%s]", tostring(value))
	end,
	[Module.ArrayContributions.Interact] = function(_, value)
		return string.format("Interact with [%s]", tostring(value))
	end,
	[Module.ArrayContributions.Talk] = function(_, value)
		return string.format("Talk to [%s]", tostring(value))
	end,

	[Module.DictContributions.Collect] = function(id, value)
		return string.format("Collect %s of [%s]", tostring(value), tostring(id))
	end,
	[Module.DictContributions.Subjugate] = function(id, value)
		return string.format("Subjugate %s of [%s]", tostring(value), tostring(id))
	end,
	[Module.DictContributions.StatValues] = function(id, value)
		return string.format("Increase the stat [%s] to %s", tostring(id), tostring(value))
	end,
} :: {[string]: (string, any) -> string}

--[[
	NOTES:
	- npcs need to have the ability to spawn DURING and AFTER quests.
	- npcs can start quests when talked to
	- if the REQUIREMENTS function returns false, the corrosponding string or table of strings returned is the dialogue
	- all quests are made of subquests, those subquests are step-by-step objectives
	- somehow relate the sub-quest contributions to NPCs / items / etc.
]]
Module.Quests = {

	-- // Menu test fixtures //
	-- Each subquest carries a SYNTHETIC contribution target — an ID that
	-- nothing in the world ever fires `AppendQuestContributions` for. This
	-- matters because `IsSubQuestCompletedFromUUID` returns `true` for any
	-- subquest whose Contributions table is empty (the iteration just
	-- falls through). The first time the player crosses a zone boundary
	-- after joining, `CheckPlayerQuestStates` would walk the active quests
	-- and auto-advance every empty-contribution step in one go — rewarding
	-- and removing the fixture before the menu ever renders it.
	--
	-- Using fake `Interact` targets keeps the quest "stuck" at whatever
	-- `SubQuestIndex` the seeder wrote (see `TEST_QUESTS` in
	-- GameControllerServer.OnPlayerAdded). `IsValidSubQuestContribution`
	-- gates real game events to "the ID must appear in this subquest's
	-- config", so these synthetic IDs are inert across the whole game loop.
	--
	-- Repeatable so a hot-reload + RemoveQuestOfUUID + re-seed cycle isn't
	-- bounced by CanAcquireQuestOfId's "already completed once" check.
	MenuTestQuest_A = {
		Requirements = {
			Repeatable = true,
			MinimumLevel = 1,
		},
		SubQuests = {
			CreateSubQuestData(
				{ [Module.ArrayContributions.Interact] = { '__menu_test_a_step_1__' } },
				CreateBaseDisplay('First placeholder step',  '', 'rbxassetid://-1')
			),
			CreateSubQuestData(
				{ [Module.ArrayContributions.Interact] = { '__menu_test_a_step_2__' } },
				CreateBaseDisplay('Second placeholder step', '', 'rbxassetid://-1')
			),
			CreateSubQuestData(
				{ [Module.ArrayContributions.Interact] = { '__menu_test_a_step_3__' } },
				CreateBaseDisplay('Third placeholder step',  '', 'rbxassetid://-1')
			),
			CreateSubQuestData(
				{ [Module.ArrayContributions.Interact] = { '__menu_test_a_step_4__' } },
				CreateBaseDisplay('Fourth placeholder step', '', 'rbxassetid://-1')
			),
		},
		Continuation = {},
		Rewards = {
			Currency = 100,
			Experience = 50,
			Items = {},
			Skills = {},
		},
		Display = CreateBaseDisplay(
			'Menu Test Quest A',
			'Placeholder quest used to populate the quest menu during UI development.',
			'rbxassetid://-1'
		),
	},

	MenuTestQuest_B = {
		Requirements = {
			Repeatable = true,
			MinimumLevel = 1,
		},
		SubQuests = {
			CreateSubQuestData(
				{ [Module.ArrayContributions.Interact] = { '__menu_test_b_step_1__' } },
				CreateBaseDisplay('Single placeholder step', '', 'rbxassetid://-1')
			),
		},
		Continuation = {},
		Rewards = {
			Currency = 25,
			Experience = 10,
			Items = {},
			Skills = {},
		},
		Display = CreateBaseDisplay(
			'Menu Test Quest B',
			'Second placeholder for menu testing — single-step so the step counter stays hidden.',
			'rbxassetid://-1'
		),
	},

	TestQuestLine1 = {
		-- requirements to acquire this quest
		Requirements = {
			Repeatable = false,
			MinimumLevel = 1,
		},

		-- sub-quests
		SubQuests = {
			CreateSubQuestData(
				{
					[Module.ArrayContributions.Interact] = { 'Interact1' }
				},
				CreateBaseDisplay(
					'Interact with block number 1!',
					'',
					'rbxassetid://-1'
				)
			),
			CreateSubQuestData(
				{
					[Module.DictContributions.Subjugate] = { Rig = 2 },
					[Module.ArrayContributions.Visit] = { 'RegionPart2' },
				},
				CreateBaseDisplay(
					'Subjugate 1 Rig NPCs!',
					'',
					'rbxassetid://-1'
				)
			),
			CreateSubQuestData(
				{
					[Module.ArrayContributions.Talk] = { 'Interact2' }
				},
				CreateBaseDisplay(
					'Talk to the Interact2 NPC!',
					'',
					'rbxassetid://-1'
				)
			),
			CreateSubQuestData(
				{
					[Module.ArrayContributions.Visit] = { 'RegionPart2' }
				},
				CreateBaseDisplay(
					'Visit the region: "RegionPart2"!',
					'',
					'rbxassetid://-1'
				)
			),
			CreateSubQuestData(
				{
					[Module.ArrayContributions.Interact] = { 'FinishQuest' }
				},
				CreateBaseDisplay(
					'Interact with the finish quest block!',
					'',
					'rbxassetid://-1'
				)
			),
		},

		-- automatically start the(se) quest(s) after this one completes.
		Continuation = {'TestQuestLine2'},

		-- the rewards from the quest upon completion
		Rewards = {
			Currency = 5,
			Experience = 20,

			Items = { RedPotion = 5, WoodenSword = 1 },
			Skills = { 'Roll' },
		},

		-- ui display information
		Display = CreateBaseDisplay(
			'Test Quest Line 1',
			'Complete the longer questline for a simple reward!',
			'rbxassetid://-1'
		),
	},

	TestQuestLine2 = {
		-- requirements to acquire this quest
		Requirements = {
			Repeatable = false,
			MinimumLevel = 1,
		},

		-- sub-quests
		SubQuests = {
			CreateSubQuestData(
				{
					[Module.ArrayContributions.Talk] = { 'Interact4' }
				},
				CreateBaseDisplay(
					'Talk to the Interact4 NPC!',
					'',
					'rbxassetid://-1'
				)
			)
		},

		-- automatically start the(se) quest(s) after this one completes.
		Continuation = { },

		-- the rewards from the quest upon completion
		Rewards = {
			Currency = 5,
			Experience = 0,

			Items = { RedPotion = 5 },
			Skills = { },
		},

		-- ui display information
		Display = CreateBaseDisplay(
			'Test Quest Line 2',
			'Complete the short questline for a simple reward!',
			'rbxassetid://-1'
		),
	},

	--[[TrainerMockBattle = {
		-- requirements to acquire this quest
		Requirements = {
			Repeatable = false,
			MinimumLevel = 3,
		},

		-- sub-quests
		SubQuests = {
			CreateSubQuestData(
				{
					[Module.ArrayContributions.Visit] = {'MockBattleTrainer1'}
				},
				CreateBaseDisplay(
					'Find the trainer.',
					'Find the mock battle trainer in the training grounds.',
					'rbxassetid://-1'
				)
			),
			CreateSubQuestData(
				{
					[Module.ArrayContributions.Talk] = {'MockBattleTrainer1'}
				},
				CreateBaseDisplay(
					'Ask for a mock battle.',
					'Ask the trainer in the training grounds for a mock battle.',
					'rbxassetid://-1'
				)
			),
			CreateSubQuestData(
				{
					[Module.ArrayContributions.Defeat] = {'MockBattleTrainer1'}
				},
				CreateBaseDisplay(
					'Defeat the trainer.',
					'Defeat the trainer in a mock battle.',
					'rbxassetid://-1'
				)
			),
			CreateSubQuestData(
				{
					[Module.ArrayContributions.Talk] = {'MockBattleTrainer1'}
				},
				CreateBaseDisplay(
					'Talk to the trainer.',
					'Thank the trainer for the mock battle.',
					'rbxassetid://-1'
				)
			),
		},

		-- automatically start the(se) quest(s) after this one completes.
		Continuation = { },

		-- the rewards from the quest upon completion
		Rewards = {
			Currency = 1,
			Experience = 10,

			Items = { RedPotion = 1, WoodenSword = 1 },
			Skills = { 'Roll' },
		},

		-- ui display information
		Display = CreateBaseDisplay(
			'Mock Battle with the Trainer',
			'Defeat the mock battle trainer in the training grounds.',
			'rbxassetid://-1'
		),
	},]]

} :: {[string]: QuestConfigTable}

function Module.GetConfigFromId(questId: string): QuestConfigTable?
	return Module.Quests[questId]
end

function Module.FindQuestFromUUID(quests: DataQuestContainer, uuid: string): (BaseQuestData?, string?)
	for questId, uuidDict in quests do
		if uuidDict[uuid] then
			return uuidDict[uuid], questId
		end
	end
	return nil, nil
end

function Module.CountCompletedQuestId(questId: string, playerData: BasePlayerData): number
	return playerData.CompletedQuests[questId] or 0
end

function Module.CountActiveQuestId(questId: string, playerData: BasePlayerData): number
	local activeQuest = playerData.ActiveQuests[questId]
	return activeQuest and CountDictionary(activeQuest) or 0
end

function Module.IsValidSubQuestContribution(questId: string, subQuestIndex: number, contributionType: string, contributionId: string): (boolean, string)
	local questConfig = Module.GetConfigFromId(questId)
	if not questConfig then
		return false, string.format("Could not find quest of id %s", tostring(questId))
	end

	local subQuestConfig = questConfig.SubQuests[subQuestIndex]
	if not subQuestConfig then
		return false, string.format("Invalid sub-quest index passed, %s", tostring(subQuestIndex))
	end

	local categoryData = subQuestConfig.Contributions[contributionType]
	if not categoryData then
		return false, string.format("Cannot find subquest contribution category %s", tostring(contributionType))
	end

	if #categoryData == 0 then
		-- dictionary
		local value = categoryData[contributionId]
		return value ~= nil, value and "Dict found" or "Dict non-exist"
	end
	-- array
	local value = table.find(categoryData, contributionId)
	return value ~= nil, value and "Array found" or "Array non-exist"
end

function Module.IsSubQuestCompletedFromUUID(uuid: string, playerData: BasePlayerData): (boolean, string)
	local questData, questId = Module.FindQuestFromUUID(playerData.ActiveQuests, uuid)
	if not questId then
		return false, string.format("Could not find quest given uuid %s.", uuid)
	end

	if not questData then
		return false, string.format("No such quest of id %s in player data.", questId)
	end

	local questConfig: QuestConfigTable? = Module.GetConfigFromId(questId)
	if not questConfig then
		return false, string.format("Could not find quest config of id %s", questId)
	end

	local subQuestConfig: SubQuestConfig? = questConfig.SubQuests[questData.SubQuestIndex]
	if not subQuestConfig then
		return false, string.format("quest of id %s does not have a subindex %s", questId, tostring(questData.SubQuestIndex))
	end

	for contribType, contributions in subQuestConfig.Contributions do
		if #contributions == 0 then
			-- dictionary
			for contribId, requiredAmount in contributions do
				local contribArr = questData.Contributions[contribType]
				local currentAmount = contribArr and contribArr[contribId] or 0
				if currentAmount < requiredAmount then
					return false, string.format("Missing dictionary contribution %s, has %d need %d", contribId, currentAmount, requiredAmount)
				end
			end
		end
		-- array
		for _, contribId in contributions do
			local contribArr = questData.Contributions[contribType]
			if not contribArr or not table.find(contribArr, contribId) then
				return false, string.format("Missing array contribution %s", contribId)
			end
		end
	end

	return true, "Has requirements"
end

function Module.IsQuestOfUUIDCompleted(uuid: string, playerData: BasePlayerData): (boolean, string)
	local questData, questId = Module.FindQuestFromUUID(playerData.ActiveQuests, uuid)
	if not questData then
		return false, string.format("No such quest data in player data %s", uuid)
	end

	local questConfig = Module.GetConfigFromId(questId)
	if not questConfig then
		return false, string.format('Could not find quest of id %s', tostring(questId))
	end

	return questData.SubQuestIndex > #questConfig.SubQuests, "Found"
end

function Module.CanAcquireQuestOfId(questId: string, playerData: BasePlayerData): (boolean, string)
	local questConfig = Module.GetConfigFromId(questId)
	if not questConfig then
		return false, string.format('Could not find quest of id %s', tostring(questId))
	end

	if Module.CountActiveQuestId(questId, playerData) > 0 then
		return false, string.format('You are already doing this quest %s', questId)
	end

	if questConfig.Requirements then
		if not questConfig.Requirements.Repeatable and Module.CountCompletedQuestId(questId, playerData) > 0 then
			return false, string.format('You can only do this quest once %s', questId)
		end
		if questConfig.Requirements.MinimumLevel and playerData.Level < questConfig.Requirements.MinimumLevel then
			return false, string.format('You must be level %d to take this quest of id %s.', questConfig.Requirements.MinimumLevel, questId)
		end
	end

	return true, "Taken quest"
end

function Module.IsArrayTypeContrib(contributionId: string): boolean
	-- check if its a key
	if Module.ArrayContributions[contributionId] then
		return true
	end
	-- check if its a value
	for _, value in Module.ArrayContributions do
		if value == contributionId then
			return true
		end
	end
	return false
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/Leveling"><![CDATA[
local Module = {}

-- GRAPH 1
-- = 25 + FLOOR.MATH((100 * $A1) * (POWER(MAX($A1-1, 0), 1.2) / MAX($A1 * 1.2, 1))) + FLOOR.MATH(2500 * FLOOR.MATH(A1-1)/50)

Module.MaxLevel = 50
function Module.GetExperienceToLevel(level : number) : number
	return 25 + math.floor((100 * level) * (math.pow(math.max(level-1, 0), 1.2) / math.max(level * 1.2, 1))) + math.floor(2500 * math.floor(level-1)/50)
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/Types"><![CDATA[
export type BanData = {
	Moderator: string,
	Reason: string,
	Timestamp: number,
	Duration: number,
}

export type ProfileBans = {
	Active: BanData?,
	History: {BanData},
}

export type RaceIndexes = number

export type EquippedSlotIndexes = string
export type EquippedSlotData = string
export type BaubleSlotIndexes = string
export type BaubleSlotData = string

export type StorageIndexes = string

export type InventoryItemMetaData = {
	gems: any?,
	enchants: any?,
	modifiers: any?,
	transmog: any?,
	cosmetics: any?,
	tags: any?,
}
export type InventoryIndexes = string
export type InventoryData = {}

export type MountIndexes = string
export type MountData = {}

export type CompanionIndexes = string
export type CompanionData = {}

export type BoosterIndexes = string
export type BoosterData = {}

export type TitleIndexes = string
export type TitleData = {}

export type AttributeIndexes = string
export type AttributeData = {}

export type SkillIndexes = string
export type SkillData = {}

export type QuestIndexes = string
export type ActiveQuestData = {}
export type CompletedQuestData = {}

export type DiscoveriesIndexes = string

export type AchievementIndexes = string
export type AchievementData = {
	Timestamp: number,
}

export type PurchaseData = {
	Id: number,
	Timestamp: number,
	Price: number,
	Currency: string
}
export type PurchasesData = {
	TotalSpent: number,
	Purchases: {PurchaseData},
}

export type AnalyticEvent = {
	Timestamp: number,
	Id: string,
	Values: {any},
}
export type AnalyticsData = {
	TimePlayed: number,
	PvEKills: {[string]: number},
	PvEDeaths: {[string]: number},
	PvPKills: {[string]: number},
	PvPDeaths: {[string]: number},
	Events: {AnalyticEvent},
}

export type ProgressionSuperIndex = string
export type ProgressionSubIndex = string
export type ProgressionData = {Timestamp: number,}

export type ProfileSaveData = {
	-- data
	Version: number,
	CurrentFloor: number,

	-- stats
	Race: RaceIndexes,
	Level: number,
	Experience: number,
	Currency: number,
	Reputation: number,
	Bounty: number,

	-- resource = { [itemId]: {[uuid]: data} }
	Inventory: {[InventoryIndexes]: {[string]: InventoryData}},
	Mounts: {[MountIndexes]: {[string]: MountData}},
	Companions: {[CompanionIndexes]: {[string]: CompanionData}},
	Consumables: {[BoosterIndexes]: {[string]: BoosterData}},
	Storages: {[StorageIndexes]: {[InventoryIndexes]: {[string]: InventoryData}}},

	Discoveries: {[DiscoveriesIndexes]: boolean},

	Equipped: {[EquippedSlotIndexes]: EquippedSlotData},
	EquippedLoadouts: {[string]: {[EquippedSlotIndexes]: EquippedSlotData}},
	BaseCustomizations: {[string]: string},

	Titles: {[TitleIndexes]: TitleData},
	Attributes: {[AttributeIndexes]: AttributeData},
	Skills: {[SkillIndexes]: SkillData},

	ActiveQuests: {[QuestIndexes]: ActiveQuestData},
	CompletedQuests: {[QuestIndexes]: CompletedQuestData},

	Achievements: {[AchievementIndexes]: AchievementData},
	Progression: {[ProgressionSuperIndex]: {[ProgressionSubIndex]: ProgressionData}},

	Guild: {Id: string?,},

	-- misc
	Analytics: AnalyticsData,
	Purchases: PurchasesData,
}

export type ProfileData = {
	Banned: ProfileBans,

	Saves: {ProfileSaveData},
	DeletedSaves: {ProfileSaveData},
}

export type ReplicatedData = {}

return true
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/Waystones"><![CDATA[
export type DisplayCategoryConfig = {
	[string]: {Name: string, LayoutOrder: number},
}

export type WaystoneRequirement = {
	-- Item-cost requirements: must consume N of the listed item to unlock.
	-- Used for hardcore-tier waystones gated behind Waystone Pieces.
	RequiredItems: { { ItemId: string, Quantity: number } }?,
	-- Minimum player level (or other future numeric gates).
	MinLevel: number?,
}

export type WaystoneDisplayConfig = {
	Name: string,
	Category: string,
	LayoutOrder: number,
	AutoUnlock: boolean,
	Floor: number,
	LargeWaystone: boolean,
	-- Optional unlock gates. If absent (or AutoUnlock = true), the
	-- waystone unlocks freely on first contact. When present, the
	-- WaystonesServer requires the listed items + level before
	-- granting the unlock; items are consumed on unlock.
	Requirements: WaystoneRequirement?,
}

local Module = {}

Module.WaystonesTag = 'Waystones'

Module.DisplayCategories = {
	Floor0 = {
		Name = 'Floor 0',
		LayoutOrder = 1,
	},
	Floor1 = {
		Name = 'Floor 1',
		LayoutOrder = 2,
	},
} :: {[string]: DisplayCategoryConfig}

Module.WaystoneDisplays = {
	-- floor 0
	F0_World = {
		Name = 'World Start',
		Category = 'Floor0',
		LayoutOrder = 1,
		AutoUnlock = true,
		Floor = 0,
		LargeWaystone = true,
	},
	F0_Wild1 = {
		Name = 'Wild',
		Category = 'Floor0',
		LayoutOrder = 2,
		AutoUnlock = false,
