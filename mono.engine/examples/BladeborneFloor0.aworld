		<Source path="ServerStorage/Modules/Data/Items"><![CDATA[-- // Items — SERVER-AUTHORITATIVE COPY //
--
-- Canonical authored registry. The matching file at
-- ReplicatedStorage/Modules/Data/Items.luau is a SHELL — same types,
-- helpers, and constant tables (EquipmentSlotEnums, ItemCategory,
-- ItemTags, etc.) but the `Module.Items` registry itself is empty
-- at boot. The shell is populated at runtime by ConfigReplicationClient
-- as the player gains items (or, for whitelisted admins, the full
-- registry on join).
--
-- All server code reads `ServerModules.Data.Items` (this file). All
-- client code reads `ServerModules.Data.Items` (the shell). The
-- types and constant tables intentionally live in BOTH copies — they're
-- not spoiler content (they describe shape and enumerate slots/categories,
-- not authored content) and many client widgets read the enums directly.
-- See ROADMAP.md.

-- // Sibling-config requires //
-- Post-migration `script.Parent` is ServerStorage/Modules/Data, which
-- only holds migrated registries (Items / Mounts / Companions / etc.).
-- The still-public StatusEffects / Rarities / Compositional configs
-- live under ReplicatedStorage/Modules/Data — point the requires
-- there explicitly so this file's load doesn't hang on a missing
-- WaitForChild. When those modules eventually migrate (Phase 3+),
-- they'll need their own dual-mode setup, but their CLIENT-shell
-- copies will still satisfy these reads (the shells preserve types
-- and constant enums even after migration).
local _ReplicatedStorageForData = game:GetService('ReplicatedStorage')
local _SharedDataFolder = _ReplicatedStorageForData:WaitForChild('Modules'):WaitForChild('Data')

local StatusEffectsConfig = require(_SharedDataFolder:WaitForChild('StatusEffects'))
export type EffectDisplay = StatusEffectsConfig.EffectDisplay
export type Effect = StatusEffectsConfig.Effect

local RaritiesConfig = require(_SharedDataFolder:WaitForChild('Rarities'))
export type RarityNames = RaritiesConfig.RarityNames

local CompositionalConfig = require(_SharedDataFolder:WaitForChild('Compositional'))
export type ForgeCompositionConfig = CompositionalConfig.ForgeCompositionConfig
export type EnchantCompositionConfig = CompositionalConfig.EnchantCompositionConfig
export type SocketingCompositionConfig = CompositionalConfig.SocketingCompositionConfig
export type ItemCompositionConfig = CompositionalConfig.ItemCompositionConfig

export type EquipmentSlotsLabels =
	"Hand" |
	"Head" |
	"Chest" |
	"Legs" |
	"Boots" |
	"Bracelet" |
	"Neck" |
	"LeftEar" |
	"RightEar" |
	"Finger" |
	"Curio"

export type NumberRangeValues = {Min: number, Max: number}

export type DamageValues = {
	Percent: NumberRangeValues,
	Value: NumberRangeValues,
}

export type InflictEffects = {
	Effects: {Effect},
	Chance: NumberRangeValues,
}

export type EquipmentSlotConfig = {
	Slot: number,
	IndexMax: number, -- max extra index for hands/fingers/ears
	AllowMultiEquip: boolean, -- allow multi-equip in other slots
	MaxMultiEquip: number,
}

export type EquipmentUsageConfig = {
	Operation: number,
	Damage: DamageValues,
	Inflicts: {InflictEffects},
}

-- Per-hand-index offsets. Keyed by the equip sub-index that
-- `EquipmentSlotConfig.IndexMax` establishes — `[1]` is the only
-- meaningful slot for single-instance equipment (Head, Chest, …),
-- while dual-wield items carry `[1]` (left) and `[2]` (right). The
-- artist authors each side directly so the renderer doesn't have to
-- guess at a mirror.
export type HandIndexedOffsets = {[number]: CFrame}

-- Per-socket spec for socketable equipment. `Color` is one of the
-- ColorClass values from Gems.luau ('red' / 'blue' / 'green' / 'gold' /
-- 'purple' / 'white' / 'black') OR 'any' for color-agnostic sockets.
-- The socket order in this list = socket index in
-- Composition.Socketing.Slots (1-based).
export type ItemSocketSpec = {
	Color: string,
}

export type ItemEquipmentConfig = {
	EquipSlots: {EquipmentSlotConfig},
	--
	StandardOffset: CFrame,
	BackOffsets: HandIndexedOffsets,
	HandOffsets: HandIndexedOffsets,
	--
	WeaponUsage: EquipmentUsageConfig?,
	ToolUsage: EquipmentUsageConfig?,
	--
	Model: string,
	-- Optional socket list — items with Sockets set are gem-socketable.
	-- See GemSocketShared.GetSocketColors for the runtime read path.
	Sockets: {ItemSocketSpec}?,
}

export type ItemConsumeActivateConfigBase = {
	Effects: {Effect},
	Inflicts: {InflictEffects},
	Consumes: boolean,
	ConsumeQuantity: number,
	MinimumQuantity: number,
	Cooldown: number,
}

export type ItemConsumptionConfig = ItemConsumeActivateConfigBase & {
}

export type ItemActivationConfig = ItemConsumeActivateConfigBase & {
}

export type ItemDisplayConfig = {
	Title: {Text: string, TextColor3: Color3?},
	Description: {Text: string, TextColor3: Color3?},
	Icon: {Image: string, ImageColor3: Color3?}?,
	Viewport: {ImageColor3: Color3?, CFrame: CFrame?}?,
}

-- Companion candy items carry this block instead of (or alongside)
-- regular consumption data. `XPAmount` is added to the equipped
-- companion's XP when the candy is used.
export type CompanionCandyData = {
	XPAmount: number,
}

-- Attribute-XP scroll payload. ConsumptionServer reads this when an
-- item with Type='AttributeScroll' is consumed: AttributeId picks the
-- target stat (Strength / Agility / etc., must match a key in
-- Data/Attributes.luau), Amount is the XP grant.
-- Single-target shape — kept for legacy single-attribute scrolls.
export type AttributeXPData = {
	AttributeId: string,
	Amount: number,
}

-- Experience-scroll payload — multi-target variant. Use when a scroll
-- grants XP to MULTIPLE attributes at once ("Greater Insight Scroll:
-- +20 Insight, +10 Focus"). ConsumptionServer iterates `Grants` and
-- routes each entry through AttributeServer.IncrementAttributeExperience.
-- Grants is intentionally an array (not a dict) so the same attribute
-- could be listed twice with different amounts if a designer wants
-- compounding effects — the consumer applies each entry verbatim.
-- Item config also supports the legacy single-target `AttributeXPData`;
-- consumers prefer `ExperienceScrollData` when both are present.
export type ExperienceScrollGrant = {
	AttributeId: string,
	Amount: number,
}
export type ExperienceScrollData = {
	Grants: { ExperienceScrollGrant },
}

-- // Artisan input metadata — see ARTISAN.md §5 //
-- These three fields point an inventory item into the matching artisan
-- catalog (Materials / Gems / Enchants). Multiple ItemConfigs CAN share
-- the same target id (e.g. CrudeIronBar + RefinedIronBar both →
-- ForgeMaterialId='iron') with different per-item metadata to express
-- yield/quality variants. Authors may use the shorthand string field
-- (`ForgeMaterialId = 'iron'`) for the simple case OR the longhand
-- table (`ForgeMaterial = { Id = 'iron', UnitsPerStack = 5 }`) when they
-- need extra metadata. `GetForgeMaterial` / `GetGem` / `GetEnchantInput`
-- below normalize both forms into the longhand shape so callers never
-- branch on which field was used.

export type ForgeMaterialMetadata = {
	Id: string,                     -- → Materials.Materials[id]
	UnitsPerStack: number?,         -- default 1; smelted bars could be 5
}

export type GemMetadata = {
	Id: string,                     -- → Gems.Gems[id] (cut baked into id)
}

export type EnchantInputMetadata = {
	Id: string,                     -- → Enchants.Enchants[id]
	Level: number?,                 -- nil = "any level up to MaxLevel"
	Charges: number?,               -- default 1; rare scrolls could grant multiple applies
}

export type BaseItemConfig = {
	-- Optional category tag for items that fall outside the standard
	-- equipment/consumable/etc. composition. Currently used for
	-- 'CompanionCandy'; may be extended for other category-specific
	-- items (key items, recipe pages, etc.).
	Type: string?,

	-- Optional semantic tag list. Each entry is a value from
	-- `Module.ItemTags`. Tags drive UI eligibility (hotbar accepts
	-- only Skill/Food/Potion; the inventory tab filters by Weapon/
	-- Equipment/Accessory) WITHOUT changing the underlying data shape.
	-- Items can carry multiple tags — a battle-buff scroll could be
	-- {AttributeScroll, Potion}.
	Tags: { number }?,

	-- Optional source list — author-declared "where can the player
	-- get this from?". Each entry is a `Module.ItemSources` value.
	-- Surfaced as text in the inventory detail's "CAN BE OBTAINED
	-- FROM" row. Multi-source items list every origin.
	Sources: { number }?,

	Rarity: number,
	MaxQuantity: number,

	EquipmentData: ItemEquipmentConfig?, -- can be 'equipped'
	ConsumptionData: ItemConsumptionConfig?, -- can be 'consumed'
	ActivationData: ItemActivationConfig?, -- can be 'activated'
	Composition: ItemCompositionConfig?, -- extra metadata

	-- Companion candy payload. Read by CompanionsServer.UseCompanionCandy.
	CandyData: CompanionCandyData?,

	-- Attribute-XP scroll payload. Read by ConsumptionServer when
	-- Type='AttributeScroll' (one scroll → +Amount XP toward the
	-- specified attribute). Independent of CompanionCandy so an item
	-- could conceivably carry both, though no current scroll does.
	AttributeXPData: AttributeXPData?,

	-- Experience-scroll metadata. Set this on items tagged with
	-- ItemTags.ExperienceScroll so ConsumptionServer can grant XP to
	-- every listed attribute in one consume. Multi-target — a single
	-- legendary scroll can roll +50 Strength, +50 Vitality at once.
	ExperienceScrollData: ExperienceScrollData?,

	-- // Artisan input pointers. Set EITHER the *Id shorthand OR the
	-- corresponding longhand table; never both. //
	ForgeMaterialId: string?,
	ForgeMaterial: ForgeMaterialMetadata?,
	GemId: string?,
	Gem: GemMetadata?,
	EnchantInputData: EnchantInputMetadata?,

	Display: ItemDisplayConfig,
}

-- Per-hand back offsets for sheathed weapons. The two CFrames are
-- mirrored across the body's X axis (yaw sign flipped) so two
-- sheathed swords sit symmetrically on either side of the spine.
-- Tune each entry independently if a specific weapon needs an
-- asymmetric mount (e.g. a quiver vs. a sword sharing a back).
local DEFAULT_BACK_OFFSETS = {
	[1] = CFrame.new(0, 0, 0.5) * CFrame.Angles(math.rad(-90), math.rad(-45), 0) * CFrame.new(0, 0, 2),
	[2] = CFrame.new(0, 0, 0.5) * CFrame.Angles(math.rad(-90), math.rad( 45), 0) * CFrame.new(0, 0, 2),
}

local WHITE_COLOR = Color3.new(1,1,1)

local function SetProperties<T>(parent: T, properties: {[string]: any}?): T
	if properties then
		for k, v in properties do
			parent[k] = v
		end
	end
	return parent
end

local function BasicColorDisplay(name: string, description: string, color: Color3?): ItemDisplayConfig
	return {
		Title = {Text = name, TextColor3 = color},
		Description = {Text = description, TextColor3 = color},
		Icon = nil,
		Viewport = nil,
	}
end

local function BasicIconDisplay(name: string, description: string, color: Color3, image: string, imageColor: Color3?): ItemDisplayConfig
	return {
		Title = {Text = name, TextColor3 = color},
		Description = {Text = description, TextColor3 = color},
		Icon = {Image = image, ImageColor3 = imageColor},
		Viewport = nil,
	}
end

local function BasicViewportDisplay(name: string, description: string, color: Color3, viewportCFrame: CFrame?, viewportColor: Color3?): ItemDisplayConfig
	return {
		Title = {Text = name, TextColor3 = color},
		Description = {Text = description, TextColor3 = color},
		Icon = nil,
		Viewport = {ImageColor3 = viewportColor, CFrame = viewportCFrame},
	}
end

local function StandardViewportDisplay(name: string, description: string)
	return BasicViewportDisplay(name, description, WHITE_COLOR, CFrame.identity, WHITE_COLOR)
end

local function FastDefineItem(properties: BaseItemConfig?): BaseItemConfig
	return SetProperties({
		Rarity = RaritiesConfig.RarityEnums.Common,
		MaxQuantity = 1,

		EquipmentData = nil,
		ConsumptionData = nil,
		ActivationData = nil,
		Composition = nil,

		Display = BasicColorDisplay('null', 'null', WHITE_COLOR),
	}, properties)
end

local Module = {}

Module.EquipmentSlotEnums = {
	Hand = 1,
	Head = 2,
	Chest = 3,
	Legs = 4,
	Boots = 5,
	--
	Bracelet = 10,
	Neck = 11,
	Ear = 12,
	Finger = 13,
	--
	Curio = 99,
}

-- General-purpose item categories. An item can belong to multiple buckets
-- simultaneously (a pickaxe is both Weapon + Tool; a charm could be both
-- Activatable + Consumable), so `GetItemCategories` returns an array.
-- These are derived from the cfg's composition tables — there's no stored
-- `Categories` field on items, so the enum and the cfg shape can never drift.
Module.ItemCategory = {
	Weapon        = 1, -- EquipmentData.WeaponUsage present
	Tool          = 2, -- EquipmentData.ToolUsage present
	Equipment     = 3, -- EquipmentData with armor slot (Head/Chest/Legs/Boots)
	Accessory     = 4, -- EquipmentData with jewelry slot (Bracelet/Neck/Ear/Finger/Curio)
	Consumable    = 5, -- ConsumptionData present
	Activatable   = 6, -- ActivationData present
	Material      = 7, -- forge / craft input (ForgeMaterialId set), or generic fallback
	Gem           = 8, -- gem socket input (GemId set)
	EnchantScroll = 9, -- enchant input (EnchantInputData set)
}

----------------------------------------------------------------------
-- Item tags. Author-supplied semantic labels per item, separate from
-- the data-shape-derived `ItemCategory`. Where ItemCategory answers
-- "what data does this item carry?", Tags answer "what is this item
-- *for*?". A consumable with `ConsumptionData` could be Food OR Potion;
-- the data shape is identical, the *intent* differs — and UI surfaces
-- like the hotbar (only skills/food/potions allowed) need the intent
-- to filter correctly.
--
-- Multi-tag is supported: a torch could be {Tool, Equipment}; a
-- battle-buff scroll could be {Potion, AttributeScroll}. Authors set
-- `Tags = { Module.ItemTags.X, ... }` on item entries; HasTag helps
-- consumers query.
--
-- IDs are grouped by domain (combat 1-9, consumable 10-19, crafting
-- 20-29, special 30-39) so adding a new tag in one domain doesn't
-- shift ids in another. Save files that store tag ids stay valid.
----------------------------------------------------------------------
----------------------------------------------------------------------
-- Item sources. Author-tagged origin labels — answers "where can I
-- get this?". Surfaced in the inventory detail's "CAN BE OBTAINED
-- FROM" row so the player knows whether to grind a mob, head to the
-- shop, or craft. An item can list multiple sources (a sword that
-- drops AND can be crafted carries both).
----------------------------------------------------------------------
Module.ItemSources = {
	Crafted    = 1,   -- crafting recipe output
	Drop       = 2,   -- mob drop
	Shop       = 3,   -- bought from a vendor
	Quest      = 4,   -- quest reward
	Treasure   = 5,   -- chest / world discovery
	Forge      = 6,   -- forge output (different from generic Crafted)
	Starter    = 7,   -- given on first join / new save
	Event      = 8,   -- limited-time event reward
	Boss       = 9,   -- boss-specific drop (separate from generic Drop)
}

-- Display labels for the source enum. Used by the inventory detail
-- "CAN BE OBTAINED FROM" row + any future filter chip surfaces.
Module.ItemSourceLabels = {
	[Module.ItemSources.Crafted]  = 'Crafted',
	[Module.ItemSources.Drop]     = 'Monster Drop',
	[Module.ItemSources.Shop]     = 'Shop',
	[Module.ItemSources.Quest]    = 'Quest Reward',
	[Module.ItemSources.Treasure] = 'Treasure',
	[Module.ItemSources.Forge]    = 'Forge',
	[Module.ItemSources.Starter]  = 'Starter Pack',
	[Module.ItemSources.Event]    = 'Event Reward',
	[Module.ItemSources.Boss]     = 'Boss Drop',
}

Module.ItemTags = {
	-- // Combat / equippable.
	Weapon          = 1,
	Tool            = 2,
	Equipment       = 3,  -- armor body slots
	Accessory       = 4,  -- jewelry / curio
	-- // Consumable.
	Food             = 10,
	Potion           = 11,
	AttributeScroll  = 12,
	Candy            = 13,
	-- Multi-target experience scroll (uses ExperienceScrollData on the
	-- cfg). AttributeScroll above remains for the legacy single-target
	-- shape (AttributeXPData). Two tags so a UI surface can filter
	-- between "single-stat scroll" and "multi-stat scroll" if desired.
	ExperienceScroll = 14,
	-- // Crafting.
	Material        = 20,
	Gem             = 21,
	EnchantScroll   = 22,
	-- // Special.
	Quest           = 30,  -- can't be sold / dropped
	Cosmetic        = 31,  -- visual-only
}

-- True when the item's `Tags` array contains the given tag id. Returns
-- false on missing/invalid configs and on configs that omit the Tags
-- field (no tags = no tag matches).
function Module.HasTag(itemConfig: any, tagId: number): boolean
	if typeof(itemConfig) ~= 'table' then return false end
	local tags = itemConfig.Tags
	if typeof(tags) ~= 'table' then return false end
	for _, t in tags do
		if t == tagId then return true end
	end
	return false
end

-- Slot enums that classify as "jewelry" rather than armor. Lookup table
-- so `GetItemCategories` doesn't repeat a chain of `or`s for each call.
local ACCESSORY_SLOT_LOOKUP = {
	[Module.EquipmentSlotEnums.Bracelet] = true,
	[Module.EquipmentSlotEnums.Neck]     = true,
	[Module.EquipmentSlotEnums.Ear]      = true,
	[Module.EquipmentSlotEnums.Finger]   = true,
	[Module.EquipmentSlotEnums.Curio]    = true,
}

-- Per-hand-index hand offsets. Index 1 is the LEFT hand, 2 is the
-- RIGHT hand. The two CFrames are mirrored: same translation
-- magnitude, opposite Z-rotation sign so the grip orientation faces
-- the same body-relative direction on both sides.
Module.StandardHandOffsets = {
	Sword = {
		[1] = CFrame.Angles(0, 0, math.rad( 90)) * CFrame.new(0.18, 0, 0),
		[2] = CFrame.Angles(0, 0, math.rad(-90)) * CFrame.new(0.18, 0, 0),
	},
}

Module.StandardEquipSlots = {
	Hands = {
		Slot = Module.EquipmentSlotEnums.Hand,
		IndexMax = 2, -- 1 = left, 2 = right
		AllowMultiEquip = true,
		MaxMultiEquip = 2,
	},
}

Module.WeaponUsageOperations = {
	Longsword = 1,
}

Module.Items = {

	WoodenSword = FastDefineItem({
		Rarity = RaritiesConfig.RarityEnums.Common,
		MaxQuantity = 1,
		Tags = { Module.ItemTags.Weapon },

		EquipmentData = {
			EquipSlots = {Module.StandardEquipSlots.Hands},
			-- WeaponClass selects the per-class combo + animation
