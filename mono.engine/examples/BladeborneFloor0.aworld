		<Source path="src/ServerScriptService/CmdrSetup/Commands/player/SetDifficultyServer.luau"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local DifficultyConfig = require(ReplicatedStorage:WaitForChild('Modules')).Data.Difficulty

return function(_context, target: Player, kind: string)
	local lower = string.lower(tostring(kind or ''))
	if not DifficultyConfig.IsValidId(lower) then
		return string.format(
			"Unknown difficulty '%s'. Use 'normal' | 'hard' | 'death'.", tostring(kind))
	end
	local Saves = ServerCore.SavesManagerServer
	if not Saves or not Saves.GetPlayerSelectedSaveData then
		return 'SavesManagerServer unavailable.'
	end
	local data = Saves.GetPlayerSelectedSaveData(target)
	if not data then
		return string.format("No save data for %s.", target.Name)
	end
	-- Persist on the save struct. ReplicatedData replicates the field on
	-- the next flush; OnscreenWidget.UpdateWidget reads it on the next
	-- OnUpdated tick and the badge swaps. Existing wired multipliers
	-- (HP cap, incoming damage, XP) re-resolve at their next call site —
	-- HP scales on the NEXT respawn (no in-place re-scale to avoid an HP
	-- discontinuity on the player's bar), damage + XP take effect
	-- immediately because they re-read on every event.
	data.Difficulty = lower
	local cfg = DifficultyConfig.GetConfigById(lower)
	return string.format('Set difficulty to %s for %s.',
		cfg and cfg.name or lower, target.Name)
end
]]></Source>
