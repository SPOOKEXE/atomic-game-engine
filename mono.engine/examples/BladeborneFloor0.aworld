	-- // CHARACTER — gilded, gold particle halo //
	aura_gilded = aura({
		Anchor = 'character',
		Display = { Name = 'Gilded Aura', Description = 'A regal golden shimmer crowns the wearer.' },
		Rarity = 4,
		VFX = {
			Light = { Color = Color3.fromRGB(255, 200, 90), Brightness = 1.4, Range = 8 },
		},
		Procedural = {
			Particle = {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0,    Color3.fromRGB(255, 225, 150)),
					ColorSequenceKeypoint.new(0.5,  Color3.fromRGB(255, 200, 90)),
					ColorSequenceKeypoint.new(1,    Color3.fromRGB(180, 130, 40)),
				}),
				Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.5),
					NumberSequenceKeypoint.new(1, 0.05),
				}),
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.1),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Rate = 14,
				Lifetime = NumberRange.new(0.7, 1.0),
				Speed = NumberRange.new(0.5, 1.5),
				SpreadAngle = Vector2.new(180, 180),
				Acceleration = Vector3.new(0, 1.4, 0),
				LightEmission = 0.7,
			},
			Light = { Color = Color3.fromRGB(255, 200, 90), Brightness = 1.4, Range = 8 },
		},
	}),

	-- // CHARACTER — radiant, yellow particle halo //
	aura_radiant = aura({
		Anchor = 'character',
		Display = { Name = 'Radiant Aura', Description = 'A bright yellow radiance beams from the wearer.' },
		Rarity = 3,
		VFX = {
			Light = { Color = Color3.fromRGB(245, 230, 90), Brightness = 1.4, Range = 8 },
		},
		Procedural = {
			Particle = {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0,    Color3.fromRGB(255, 245, 160)),
					ColorSequenceKeypoint.new(0.5,  Color3.fromRGB(245, 230, 90)),
					ColorSequenceKeypoint.new(1,    Color3.fromRGB(170, 155, 45)),
				}),
				Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.5),
					NumberSequenceKeypoint.new(1, 0.05),
				}),
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.1),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Rate = 14,
				Lifetime = NumberRange.new(0.7, 1.0),
				Speed = NumberRange.new(0.5, 1.5),
				SpreadAngle = Vector2.new(180, 180),
				Acceleration = Vector3.new(0, 1.4, 0),
				LightEmission = 0.7,
			},
			Light = { Color = Color3.fromRGB(245, 230, 90), Brightness = 1.4, Range = 8 },
		},
	}),

	-- // CHARACTER — amethyst, purple particle halo //
	aura_amethyst = aura({
		Anchor = 'character',
		Display = { Name = 'Amethyst Aura', Description = 'A mystic purple haze coils around the wearer.' },
		Rarity = 3,
		VFX = {
			Light = { Color = Color3.fromRGB(180, 100, 230), Brightness = 1.4, Range = 8 },
		},
		Procedural = {
			Particle = {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0,    Color3.fromRGB(210, 155, 245)),
					ColorSequenceKeypoint.new(0.5,  Color3.fromRGB(180, 100, 230)),
					ColorSequenceKeypoint.new(1,    Color3.fromRGB(110, 55, 145)),
				}),
				Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.5),
					NumberSequenceKeypoint.new(1, 0.05),
				}),
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.1),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Rate = 14,
				Lifetime = NumberRange.new(0.7, 1.0),
				Speed = NumberRange.new(0.5, 1.5),
				SpreadAngle = Vector2.new(180, 180),
				Acceleration = Vector3.new(0, 1.4, 0),
				LightEmission = 0.7,
			},
			Light = { Color = Color3.fromRGB(180, 100, 230), Brightness = 1.4, Range = 8 },
		},
	}),

	-- // CHARACTER — obsidian, black particle halo //
	aura_obsidian = aura({
		Anchor = 'character',
		Display = { Name = 'Obsidian Aura', Description = 'A dark, smoldering shroud of shadow clings to the wearer.' },
		Rarity = 4,
		VFX = {
			Light = { Color = Color3.fromRGB(40, 40, 50), Brightness = 1.4, Range = 8 },
		},
		Procedural = {
			Particle = {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0,    Color3.fromRGB(90, 90, 105)),
					ColorSequenceKeypoint.new(0.5,  Color3.fromRGB(40, 40, 50)),
					ColorSequenceKeypoint.new(1,    Color3.fromRGB(15, 15, 22)),
				}),
				Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.5),
					NumberSequenceKeypoint.new(1, 0.05),
				}),
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.1),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Rate = 14,
				Lifetime = NumberRange.new(0.7, 1.0),
				Speed = NumberRange.new(0.5, 1.5),
				SpreadAngle = Vector2.new(180, 180),
				Acceleration = Vector3.new(0, 1.4, 0),
				LightEmission = 0.7,
			},
			Light = { Color = Color3.fromRGB(40, 40, 50), Brightness = 1.4, Range = 8 },
		},
	}),

	-- // CHARACTER — pristine, white particle halo //
	aura_pristine = aura({
		Anchor = 'character',
		Display = { Name = 'Pristine Aura', Description = 'A pure, holy white light envelops the wearer.' },
		Rarity = 4,
		VFX = {
			Light = { Color = Color3.fromRGB(235, 240, 255), Brightness = 1.4, Range = 8 },
		},
		Procedural = {
			Particle = {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0,    Color3.fromRGB(255, 255, 255)),
					ColorSequenceKeypoint.new(0.5,  Color3.fromRGB(235, 240, 255)),
					ColorSequenceKeypoint.new(1,    Color3.fromRGB(170, 180, 205)),
				}),
				Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.5),
					NumberSequenceKeypoint.new(1, 0.05),
				}),
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.1),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Rate = 14,
				Lifetime = NumberRange.new(0.7, 1.0),
				Speed = NumberRange.new(0.5, 1.5),
				SpreadAngle = Vector2.new(180, 180),
				Acceleration = Vector3.new(0, 1.4, 0),
				LightEmission = 0.7,
			},
			Light = { Color = Color3.fromRGB(235, 240, 255), Brightness = 1.4, Range = 8 },
		},
	}),

} :: { [string]: AuraConfig }

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/Titles"><![CDATA[-- Title configs. Each title has a Display + an optional UnlockCheck
-- function that returns true when the player qualifies. Server runs the
-- pass periodically (and on join) to grant qualifying titles.
--
-- Developer / Owner UserIds: hardcoded here for now. Move to a private
-- ServerStorage data file later if you want to keep them out of the
-- shared module.

-- Gradient spec — any field optional except Color.
export type TitleGradient = {
	Color: ColorSequence,
	Rotation: number?,
	Offset: Vector2?,
	Transparency: NumberSequence?,
}

-- Effect spec — either a string id resolved against the
-- TitleEffects registry (RainbowSweep / BreathingPulse / ShimmerColors
-- / GhostWobble) or an inline TitleEffect table for a one-off effect.
-- See ReplicatedStorage/Modules/Data/TitleEffects.luau for the contract.
export type TitleEffectSpec = string | { [string]: any }

export type TitleConfig = {
	Id: string,
	Display: { Name: string, Description: string, Color: Color3? },
	-- Optional UIGradient applied to the title text — for tier titles
	-- that want a multi-stop sweep (rainbow, gold-to-amber, etc.).
	-- Renderer creates the UIGradient instance on Apply, destroys on
	-- Clear, so swapping titles doesn't leak gradients.
	Gradient: TitleGradient?,
	-- Optional runtime effect — driven by RunService.Heartbeat each
	-- frame. Use string ids for built-ins (e.g. 'RainbowSweep') or
	-- pass an inline { Init, OnHeartbeat, Cleanup } table for
	-- bespoke effects.
	Effect: TitleEffectSpec?,
	-- Returns true if the player should unlock this title now. Called
	-- from TitlesServer; receives the live save struct so quest /
	-- analytics conditions can be authored cleanly.
	UnlockCheck: ((player: Player, saveData: any) -> boolean)?,
	-- Whether the title is publicly visible to others when equipped.
	-- Reserved for a future selectedTitle replication path.
	Public: boolean?,
}

local Module = {}

----------------------------------------------------------------------
-- TitleEvent remote protocol. The first arg of every fire is one of
-- these action discriminators. Both the client (CharacterTab FireServer)
-- and TitlesServer (OnServerEvent / FireClient) reference these constants
-- rather than the raw strings, so a rename is a single-site change and a
-- typo is a nil-index — not a silently dead branch.
----------------------------------------------------------------------
export type TitleAction =
	  'SetActive'
	| 'Unlocked'

Module.TitleActions = {
	SetActive = 'SetActive', -- C→S: equip a title (titleId) or nil to clear
	Unlocked  = 'Unlocked',  -- S→C: a title was just unlocked (titleId)
} :: { [string]: TitleAction }

----------------------------------------------------------------------
-- Owner / developer UserId allowlists. Plain arrays so call sites can
-- `table.find(Module.OwnerIds, player.UserId)` without re-implementing
-- the lookup. Keep stable so saves stay valid across alpha → live.
----------------------------------------------------------------------
Module.OwnerIds = {
	1041213550,
}
Module.DeveloperIds = {
	1041213550,
}

local function isOwner(player: Player): boolean
	return table.find(Module.OwnerIds, player.UserId) ~= nil
end

local function isDeveloper(player: Player): boolean
	return table.find(Module.DeveloperIds, player.UserId) ~= nil
end

----------------------------------------------------------------------
-- Helper exports — TitlesServer (and other systems) can read these
-- to gate dev-only features without re-implementing the check.
----------------------------------------------------------------------
Module.IsOwner = isOwner
Module.IsDeveloper = isDeveloper

----------------------------------------------------------------------
-- Registry.
----------------------------------------------------------------------
Module.Titles = {

	alpha_tester = {
		Id = 'alpha_tester',
		Display = {
			Name = 'Alpha Tester',
			Description = 'Played the game during the alpha test phase.',
			Color = Color3.fromRGB(180, 157, 255),
		},
		Public = true,
		-- Auto-grant during the alpha window. Once the alpha ends, set
		-- a hard cutoff timestamp here so latecomers can't claim it.
		-- For now, every player who joins the game during alpha gets
		-- the title.
		UnlockCheck = function(_player, _saveData)
			return true
		end,
	},

	developer = {
		Id = 'developer',
		Display = {
			Name = 'Developer',
			Description = 'A member of the Bladeborne development team.',
			Color = Color3.fromRGB(126, 200, 255),
		},
		Public = true,
		UnlockCheck = function(player, _saveData)
			return isDeveloper(player) or isOwner(player)
		end,
	},

	owner = {
		Id = 'owner',
		Display = {
			Name = 'Owner',
			Description = 'The game owner.',
			Color = Color3.fromRGB(255, 215, 138),
		},
		-- Owner gets a gold shimmer sweep — gradient from amber to
		-- pale-gold to amber, rotated continuously by the
		-- RainbowSweep effect for a flag-flapping look. Authors who
		-- want a static gradient drop the Effect field; the renderer
		-- builds the UIGradient regardless.
		Gradient = {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0,    Color3.fromRGB(220, 170, 80)),
				ColorSequenceKeypoint.new(0.5,  Color3.fromRGB(255, 240, 180)),
				ColorSequenceKeypoint.new(1,    Color3.fromRGB(220, 170, 80)),
			}),
			Rotation = 30,
		},
		Effect = 'RainbowSweep',
		Public = true,
		UnlockCheck = function(player, _saveData)
			return isOwner(player)
		end,
	},

	-- Demo titles — show off the gradient + effect surface end-to-end.
	-- Granted by no UnlockCheck (i.e. never unlocked through normal
	-- play); use the cmdr GiveTitle command (or the dev save tab) to
	-- award them in-test.
	rainbow_demo = {
		Id = 'rainbow_demo',
		Display = {
			Name = 'Spectrum',
			Description = 'A demo title with a rotating rainbow gradient.',
			Color = Color3.fromRGB(255, 255, 255),
		},
		Gradient = {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0,    Color3.fromRGB(255, 90, 90)),
				ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 200, 80)),
				ColorSequenceKeypoint.new(0.5,  Color3.fromRGB(120, 240, 140)),
				ColorSequenceKeypoint.new(0.75, Color3.fromRGB(120, 180, 255)),
				ColorSequenceKeypoint.new(1,    Color3.fromRGB(220, 130, 255)),
			}),
			Rotation = 0,
		},
		Effect = 'RainbowSweep',
	},

	cursed_demo = {
		Id = 'cursed_demo',
		Display = {
			Name = 'Cursed',
			Description = 'Demo title with a wobble + breathing pulse.',
			Color = Color3.fromRGB(170, 80, 200),
		},
		-- Inline effect — composes built-ins by hand-crafting the
		-- table. Authors reach for this when they need bespoke state
		-- not covered by the registry.
		Effect = {
			Init = function(label, _gradient)
				return { base = label.TextColor3, t = 0 }
			end,
			OnHeartbeat = function(state, label, _gradient, elapsed, _dt)
				if not state then return end
				-- Pulse the brightness of the base color ±25% over a
				-- 1.5s sine cycle. Multiplies channel-wise.
				local pulse = 0.75 + 0.25 * math.sin(elapsed * math.pi * 2 / 1.5)
				label.TextColor3 = Color3.new(
					math.clamp(state.base.R * pulse, 0, 1),
					math.clamp(state.base.G * pulse, 0, 1),
					math.clamp(state.base.B * pulse, 0, 1)
				)
			end,
			Cleanup = function(state, label, _gradient)
				if state and state.base then label.TextColor3 = state.base end
			end,
		},
	},

	shimmer_demo = {
		Id = 'shimmer_demo',
		Display = {
			Name = 'Shimmer',
			Description = 'Demo title with the built-in shimmer effect.',
			Color = Color3.fromRGB(255, 220, 130),
		},
		Effect = 'ShimmerColors',
	},

} :: { [string]: TitleConfig }

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/Onboarding"><![CDATA[-- Onboarding step configs. Each step has an id, a one-line cue, and an
-- optional CompletionCheck function (so a step can auto-complete when
-- the player performs the expected action — e.g. opens inventory).
-- The OnboardingServer iterates these in StepOrder; the client renders
-- the active step as an overlay tooltip + optional spotlight cutout.
--
-- Storyline arc — the trapped-in-game premise:
--   You wake at spawn with no memory; the Tutor explains you have been
--   pulled into Bladeborne and will only return home by reaching
--   Floor 100 and defeating its boss. Onboarding walks you through the
--   essential controls (movement, combat, inventory, map / waystones)
--   and ends with the long-running quest entry.
--
-- StepOrder advances strictly in array order. The Tutor NPC dialogue
-- + cinematic camera live on the OnboardingServer side; per-step
-- highlights drive the tutorial overlay's spotlight.

export type HighlightAnchor =
	  'screen_rect'   -- Position/Size in fromScale (top-left) on the screen
	| 'world_part'    -- TODO: project a workspace BasePart's bounds
	| 'tab_chip'      -- Anchored to a specific tab chip via TabId

export type OnboardingHighlight = {
	Anchor: HighlightAnchor,
	-- For 'screen_rect': fromScale Vector2 anchor (top-left) + Size in fromScale.
	-- For 'tab_chip': TabId is the rail id — OnboardingClient resolves at render.
	-- For 'world_part': InstancePath strings via CinematicShared.ResolveInstancePath.
	Position: Vector2?,
	Size: Vector2?,
	TabId: string?,
	InstancePath: string?,
	-- Optional caption shown below the cutout (≤ 80 chars). Defaults to
	-- the step's Title when nil.
	Caption: string?,
}

export type OnboardingStep = {
	Id: string,
	Title: string,
	Body: string,
	-- Returns true when the step should be considered complete. Server
	-- runs the check periodically; can also be tripped externally by
	-- gameplay code calling OnboardingServer.AdvanceIfStep(player, id).
	CompletionCheck: ((player: Player, saveData: any) -> boolean)?,
	-- Optional spotlight cutout — OnboardingWidget darkens the screen
	-- and "punches" a hole here so the player's eye lands on the
	-- right UI element. nil = no overlay (text-only tooltip).
	Highlight: OnboardingHighlight?,
	-- Whether the player can dismiss this step manually via the GOT IT
	-- button. Story / cinematic steps disable this so the player can't
	-- skip the premise. Defaults to true.
	AllowDismiss: boolean?,
}

local Module = {}

----------------------------------------------------------------------
-- OnboardingEvent remote protocol. The first arg of every fire is one of
-- these action discriminators. Both the server (FireClient/OnServerEvent)
-- and the client widgets (OnClientEvent/FireServer) reference these
-- constants rather than the raw strings, so a rename is a single-site
-- change and a typo is a nil-index — not a silently dead branch.
----------------------------------------------------------------------
export type OnboardingAction =
	  'ShowWelcome'
	| 'FinishWelcome'
	| 'StepChanged'
	| 'MarkComplete'

Module.Actions = {
	ShowWelcome   = 'ShowWelcome',    -- S→C: open the first-join welcome modal
	FinishWelcome = 'FinishWelcome',  -- C→S: player clicked FINISH; sets JoinGame1
	StepChanged   = 'StepChanged',    -- S→C: tutorial advanced to a new step
	MarkComplete  = 'MarkComplete',   -- C→S: player dismissed the active step
} :: { [string]: OnboardingAction }

----------------------------------------------------------------------
-- Welcome popup pages. Rendered as a centered multi-page modal by
-- JoinGameWelcomeWidget on a player's first join (before the
-- FFlags.JoinGame1 flag is set — see Data.FFlags). The final page's
-- button reads FINISH and sets that flag.
--   1. General game premise.
--   2. Early-game (≤ level 5) gameplay loop.
--   3. UI orientation.
----------------------------------------------------------------------
export type WelcomePage = {
	Eyebrow: string,   -- small mono uppercase kicker
	Title: string,
	Body: string,
}

Module.WelcomePages = {
	{
		Eyebrow = 'WELCOME TO BLADEBORNE',
		Title = 'You are trapped in the game',
		Body = "You've been pulled into Bladeborne with no way out but forward. The only path home is to climb to Floor 100 and defeat its keeper. Gather allies, sharpen your blade, and survive.",
	},
	{
		Eyebrow = 'YOUR FIRST FEW LEVELS',
		Title = 'Levels 1–5: find your feet',
		Body = "Stay near the spawn town while you're under level 5 — the early enemies here are forgiving. Left-click to swing, hold guard to block, and dash with LeftCtrl. Defeat enemies and complete your first quest to earn XP, level up, and unlock new abilities.",
	},
	{
		Eyebrow = 'GETTING AROUND THE UI',
		Title = 'Know your HUD',
		Body = "Press [Tab] to open your menu — inventory, skills, and travel all live there. Your hotbar sits bottom-center for weapons and abilities. Tracked quests show top-right, and the minimap helps you navigate. A starter quest has been added to your log.",
	},
} :: { WelcomePage }

----------------------------------------------------------------------
-- Step order. First entry plays after the intro cinematic; subsequent
-- entries play once the previous step's CompletionCheck succeeds.
----------------------------------------------------------------------
Module.StepOrder = {
	'wake_up',
	'meet_tutor',
	'learn_movement',
	'learn_combat',
	'learn_inventory',
	'learn_map',
	'finished',
}

Module.Steps = {

	-- // Storyline: the player wakes at spawn //
	wake_up = {
		Id = 'wake_up',
		Title = 'Where am I?',
		Body = 'You wake at the edge of a strange town. A figure approaches. Speak with them.',
		AllowDismiss = false,
		-- No highlight — the player should look around the world, not
		-- the UI. The Tutor walks toward them and triggers the next step.
	},

	meet_tutor = {
		Id = 'meet_tutor',
		Title = 'The Tutor',
		Body = 'You are inside Bladeborne. To return home, reach Floor 100 and defeat its keeper. Press [E] to talk to the Tutor.',
		AllowDismiss = false,
		-- Highlights the Tutor NPC via instance path so the spotlight
		-- lands on the world. OnboardingClient projects the world
		-- position to screen each frame.
		Highlight = {
			Anchor = 'world_part',
			InstancePath = 'workspace.NPCs.Tutor.HumanoidRootPart',
			Caption = 'Walk up and press E',
		},
	},

	learn_movement = {
		Id = 'learn_movement',
		Title = 'Move',
		Body = 'WASD walks. Spacebar jumps. Hold LeftCtrl for the dash. Try them now.',
	},

	learn_combat = {
		Id = 'learn_combat',
		Title = 'Combat',
		Body = 'Left-click to swing. Press R to lock onto a target. F holds your guard.',
		Highlight = {
			Anchor = 'screen_rect',
			-- Cluster around the bottom-center hotbar so the player
			-- sees the Attack hint visualized in context.
			Position = Vector2.new(0.30, 0.85),
			Size = Vector2.new(0.40, 0.10),
			Caption = 'Hotbar — equip a weapon, then click',
		},
	},

	learn_inventory = {
		Id = 'learn_inventory',
		Title = 'Inventory',
		Body = 'Press [Tab] to open the menu. Inventory shows what you carry; right-click to use or equip.',
		Highlight = {
			Anchor = 'tab_chip',
			TabId = 'Inventory',
			Caption = 'Click the Inventory rail entry',
		},
	},

	learn_map = {
		Id = 'learn_map',
		Title = 'Travel',
		Body = 'Open the Travel tab to view waystones. Walk to a waystone marker on the world to unlock it.',
		Highlight = {
			Anchor = 'tab_chip',
			TabId = 'Travel',
			Caption = 'Travel tab',
		},
	},

	finished = {
		Id = 'finished',
		Title = 'Floor 1 awaits',
		Body = "You're ready. The path to Floor 100 is long — find allies, level your skills, forge real weapons. Good luck.",
	},

} :: { [string]: OnboardingStep }

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/Skills"><![CDATA[-- Skill configs. Three starter sword skills hooked to the skill tree.
-- Mirrors the Combat data/server/client structure: this file is pure
-- config, SkillsShared owns predicates + the action enum, SkillsServer
-- owns auth + damage application, SkillsClient owns input + VFX.
--
-- Each skill carries:
--   * metadata (display, school, prereqs)
--   * timing (windup → active → recovery)
--   * hitbox (size + forward offset, applied during the active window)
--   * damage (base + scale-with-weapon multiplier; values are pre-mult)
--   * animation + VFX + SFX (rbxassetid stubs; art layer drops in later)
--   * cooldown
-- Skills are ground-only by design — no skill applies upward velocity or
-- expects an airborne target (matches the Nier-style ground-combat goal).

export type Hitbox = {
	Size: Vector3,
	ForwardOffset: number,
	Hits: number,                  -- how many distinct hit pulses fire
	HitInterval: number,           -- seconds between pulses
	-- True (default) → each pulse can damage the same humanoid again
	-- (the existing N-hit slash design). False → the cast keeps a
	-- per-cast HitCache so each humanoid is damaged at most once
	-- across all pulses; useful for cleave-style skills where the
	-- pulses exist to widen the active window, not to multi-hit.
	-- Defaulted in the skill() factory so existing skills keep their
	-- current behavior without touching every config entry.
	MultiHit: boolean?,
}

export type SkillAnimations = {
	Cast: string?,                 -- main animation while skill is active
	Loop: string?,                 -- optional loop during long active windows
}

export type SkillVFX = {
	Slash: string?,                -- AssetsShared.VFX.Skills.<name>
	Impact: string?,
	Trail: string?,
}

export type SkillSFX = {
	Cast: { Sound: string, Volume: number? }?,
	Hit: { Sound: string, Volume: number? }?,
}

-- Passive skill effect — per-level bonus on a named stat. Stat + Kind
-- are enum NUMBERS (Module.StatNameEnum / Module.StatEffectKindEnum,
-- defined below) — every consumer reads the same enum table so a typo
-- in a stat name fails at lookup-time instead of silently producing a
-- 0 bonus. A single passive can carry MULTIPLE effects (e.g. "+2%
-- attack AND +10 max HP per level") by listing them as an array of
-- PassiveEffect on the cfg's `PerLevelEffects` field.
--
-- Kind dispatch:
--   StatEffectKindEnum.Percent  → multiplicative; Bonus is per-level
--                                 multiplier (0.02 = +2%).
--   StatEffectKindEnum.Value    → flat additive; Bonus is per-level
--                                 raw magnitude.
--   StatEffectKindEnum.Compute  → custom evaluator. Effect must supply
--                                 a `Compute(level)` function returning
--                                 (percent, value). Use sparingly — for
--                                 conditional / non-linear bonuses.
export type PassiveEffect = {
	Stat: number,                  -- StatNameEnum value
	Kind: number,                  -- StatEffectKindEnum value
	Bonus: number?,                -- per-level magnitude (Percent / Value)
	Compute: ((level: number) -> (number, number))?,  -- (percent, value); Compute kind only
}

-- // Skill-tree graph //
-- Tree-layout fields live ON each SkillConfig (Depends / TabCategory /
-- HexagonColor below). The radial hex SkillsTab UI groups skills by
-- TabCategory into one tree per tab; SkillTreeLayout.resolve consumes
-- the synthesized {Nodes = {[id] = {depends = …}}} structure that
-- Module.Trees builds at the bottom of this file. Keeping tree metadata
-- on the skill itself (instead of in a parallel Trees table) means a
-- new skill is fully self-describing — set TabCategory and the rail tab
-- picks it up; set Depends and the tree's edges resolve automatically.
--
-- Depends vs Prereqs:
--   * Prereqs is the UNLOCK CHAIN — what the server checks before
--     allowing AttemptUnlockSkill to grant the skill. Read by
--     SkillsServer / SkillsShared.
--   * Depends is the DISPLAY GRAPH for the radial tree — defaults to
--     Prereqs (auto-filled in the skill() factory), but can be overridden
--     when the visual graph should diverge (e.g. extra grouping edges).
export type SkillConfig = {
	Id: string,
	Display: { Name: string, Description: string, Icon: string? },
	-- School + tree links so the SkillsTab can group skills under their
	-- discipline and gate by prereqs.
	School: string,                -- 'Sword' | 'Martial' | etc.
	Prereqs: { string },           -- skill ids that must be unlocked first
	-- // Skill-tree layout fields (consumed by SkillsTab + SkillTreeLayout) //
	-- Defaults to a copy of Prereqs (filled by the skill() factory). Override
	-- when the visual tree should diverge from the unlock chain.
	Depends: { string },
	-- Which rail tab this skill renders under in the SkillsTab UI. Matches
	-- a SKILL_SCHOOLS.id ('dual', 'one', 'katana', 'martial', 'search',
	-- 'hide'). Skills without a TabCategory don't render in any tree
	-- (still functionally usable, just hidden from the tree UI).
	TabCategory: string?,
	-- Optional override for the hex tile's stroke + icon accent. When nil
	-- the tile uses the palette accent color.
	HexagonColor: Color3?,
	-- SkillPoint cost charged by SkillsServer.AttemptUnlockSkill on first
	-- unlock AND on each passive level-up. Defaults to 1 (set in the
	-- skill() factory). Bump for high-impact / passive nodes whose flat
	-- per-level bonus accumulates value beyond a single active skill.
	UnlockCost: number?,
	RequiredLevel: number,
	-- Attribute investment gate: attribute-id → minimum Level. Checked by
	-- SkillsServer.AttemptUnlockSkill on first unlock (alongside Prereqs +
	-- RequiredLevel) and surfaced in the Skill Tree detail panel. Used to
	-- gate finishers / ULTs behind attribute investment rather than raw
	-- character level. nil = no attribute gate.
	RequiredAttributes: { [string]: number }?,
	-- Timing windows. WindupTime → ActiveTime → RecoveryTime; total skill
	-- duration is the sum. UsingSkill state is set for the whole window.
	WindupTime: number,
	ActiveTime: number,
	RecoveryTime: number,
	Cooldown: number,
	Hitbox: Hitbox,
	Damage: { Base: number, WeaponScale: number },
	Animations: SkillAnimations,
	VFX: SkillVFX,
	SFX: SkillSFX,
	-- If true, the player is locked to the ground for the whole window.
	-- Default true. Skills authored as airborne would set this false.
	GroundLock: boolean,
	-- // Passive skill fields //
	-- Passive skills are not "cast" — they apply permanent bonuses while
	-- unlocked. Each level above 1 is a separate SkillPoint purchase
	-- (handled by SkillsServer.AttemptUnlockSkill which doubles as a
	-- level-up path for passives). Active skills omit all three fields.
	Passive: boolean?,                -- true → not castable; bonus-only
	MaxLevel: number?,                -- cap for passive level-up purchases
	-- Array so a single passive can grant multiple bonuses per level
	-- (e.g. +2% attack AND +5 flat damage). Each entry's Kind chooses
	-- percent vs value math; Stat is the consumer-side lookup key.
	PerLevelEffects: { PassiveEffect }?,
}

local Module = {}

----------------------------------------------------------------------
-- Stat-name enum. Every passive effect's `Stat` is one of these
-- numeric ids; consumers compare against `SkillsConfig.StatNameEnum.X`
-- rather than string-typing the stat name. Adding a stat means:
--   1. Pick an unused number in this table.
--   2. Wire the consumer (DamageModule for combat stats, AttributeServer
--      for attribute layers, etc.) to read passive bonuses for that id.
--   3. Reference it from new PassiveEffect entries.
-- Numbering grouped by domain so adding a new attribute / resist
-- doesn't shift existing ids.
----------------------------------------------------------------------
Module.StatNameEnum = {
	-- // Combat-pipeline stats (DamageModule reads these).
	Attack  = 1,
	Defense = 2,
	Health  = 3,
	-- // Attributes — mirror Data/Attributes.luau ids.
	Strength  = 10,
	Agility   = 11,
	Vitality  = 12,
	Endurance = 13,
	Toughness = 14,
	Focus     = 15,
	Resolve   = 16,
	Luck      = 17,
	Insight   = 18,
	Charisma  = 19,
	-- // Elemental resists (placeholder; CHARACTER_RESISTS in CharacterTab).
	FireResist   = 30,
	FrostResist  = 31,
	ShockResist  = 32,
	PoisonResist = 33,
	ArcaneResist = 34,
}

----------------------------------------------------------------------
-- Effect-kind enum. Drives the math in SkillsShared.GetPassiveBonus.
-- Compute is an escape hatch for non-linear bonuses (e.g. "scale with
-- HP percent") — the effect carries a Compute function that returns
-- (percent, value) given the current passive level.
----------------------------------------------------------------------
Module.StatEffectKindEnum = {
	Percent = 1,
	Value   = 2,
	Compute = 3,
}

local function skill(props: any): SkillConfig
	local base = {
		School = 'Sword',
		Prereqs = {},
		-- TabCategory defaults to 'dual' since every starter skill is a
		-- sword art shown under the Active rail. Override per-skill when
		-- authoring martial / hiding / etc. trees.
		TabCategory = 'dual',
		HexagonColor = nil,
		UnlockCost = 1,
		RequiredLevel = 1,
		WindupTime = 0.15,
		ActiveTime = 0.45,
		RecoveryTime = 0.25,
		Cooldown = 4.0,
		Hitbox = { Size = Vector3.new(6, 5, 6), ForwardOffset = 4, Hits = 1, HitInterval = 0, MultiHit = true },
		Damage = { Base = 18, WeaponScale = 1.2 },
		Animations = { Cast = 'rbxassetid://0' },
		VFX = {},
		SFX = { Cast = { Sound = 'rbxassetid://0', Volume = 0.5 } },
		GroundLock = true,
		Display = { Name = 'Skill', Description = '', Icon = nil },
	} :: any
	for k, v in props do base[k] = v end
	-- Depends defaults to a copy of Prereqs so authors only have to set
	-- one list. Pass an explicit Depends to decouple the visual graph
	-- from the unlock chain.
	if base.Depends == nil then
		base.Depends = table.clone(base.Prereqs or {})
	end
	return base :: SkillConfig
end

----------------------------------------------------------------------
-- Starter skills. Tier-progression via prereqs:
--   great_slash  → double_cross_slash → quad_cross_slash
----------------------------------------------------------------------
Module.Skills = {

	great_slash = skill({
		Id = 'great_slash',
		Display = {
			Name = 'Great Slash',
			Description = 'A heavy single arc that cleaves the air in front of you.',
		},
		School = 'Sword',
		TabCategory = 'dual',
		HexagonColor = Color3.fromRGB(126, 200, 255),    -- ice-blue accent (default)
		Prereqs = {},
		RequiredLevel = 1,
		WindupTime = 0.20,
		ActiveTime = 0.35,
		RecoveryTime = 0.30,
		Cooldown = 4.0,
		Hitbox = { Size = Vector3.new(7, 5, 7), ForwardOffset = 4.5, Hits = 1, HitInterval = 0 },
		Damage = { Base = 28, WeaponScale = 1.3 },
	}),

	double_cross_slash = skill({
		Id = 'double_cross_slash',
		Display = {
			Name = 'Double Cross Slash',
			Description = 'Two diagonal cuts that form a cross. Hits twice.',
		},
		School = 'Sword',
		TabCategory = 'dual',
		HexagonColor = Color3.fromRGB(180, 220, 255),    -- brighter blue (mid-tier)
		Prereqs = { 'great_slash' },
		RequiredLevel = 1,
		WindupTime = 0.12,
		ActiveTime = 0.50,
		RecoveryTime = 0.30,
		Cooldown = 6.0,
		-- Two pulses, ~0.18s apart so the two slashes feel distinct.
		Hitbox = { Size = Vector3.new(6, 5, 6), ForwardOffset = 4, Hits = 2, HitInterval = 0.18 },
		Damage = { Base = 18, WeaponScale = 1.1 },
	}),

	quad_cross_slash = skill({
		Id = 'quad_cross_slash',
		Display = {
			Name = 'Quad Cross Slash',
			Description = 'A flurry of four cross-cuts. High commitment, high reward.',
		},
		School = 'Sword',
		TabCategory = 'dual',
		HexagonColor = Color3.fromRGB(245, 200, 80),     -- gold — ULT/finisher tile
		Prereqs = { 'double_cross_slash' },
		RequiredLevel = 1,
		-- ULT finisher — gated behind Strength investment, not char level.
		RequiredAttributes = { Strength = 3 },
		WindupTime = 0.10,
		ActiveTime = 0.85,
		RecoveryTime = 0.45,
		Cooldown = 12.0,
		-- Four pulses, ~0.18s apart. Total skill duration ~1.4s — long
		-- recovery means you're committed; can be cancelled by dodge.
		Hitbox = { Size = Vector3.new(6, 5, 6), ForwardOffset = 4, Hits = 4, HitInterval = 0.18 },
		Damage = { Base = 14, WeaponScale = 1.0 },
	}),

	-- // Passive skills //
	-- Defender / Attacker — flat percentage bonuses on Defense / Attack.
	-- 5 levels each, 2% per level. Each level above 1 is a separate
	-- SkillPoint purchase (handled by SkillsServer.AttemptUnlockSkill
	-- which routes to a level-up branch when the skill is already owned
	-- and Passive=true). Hitbox/Damage/timing fields are ignored at
	-- runtime but kept on the cfg so SkillConfig stays a single shape.
	passive_defender = skill({
		Id = 'passive_defender',
		Display = {
			Name = 'Defender',
			Description = 'Reduce incoming damage by 2% per level (max 5).',
		},
		School = 'Sword',
		TabCategory = 'passives',
		HexagonColor = Color3.fromRGB(150, 220, 170),    -- green — defensive passive
		-- Passives charge 2 SP per purchase (initial unlock + each level-up)
		-- since each rank is a permanent stat bonus. Maxing this passive
		-- costs 2 × 5 = 10 SP total, weighed against ~3-4 active skills.
		UnlockCost = 2,
		Prereqs = {},
		RequiredLevel = 1,
		Cooldown = 0,
		Passive = true,
		MaxLevel = 5,
		PerLevelEffects = {
			{ Stat = Module.StatNameEnum.Defense, Kind = Module.StatEffectKindEnum.Percent, Bonus = 0.02 },
		},
	}),

	passive_attacker = skill({
		Id = 'passive_attacker',
		Display = {
			Name = 'Attacker',
			Description = 'Increase outgoing damage by 2% per level (max 5).',
		},
		TabCategory = 'passives',
		HexagonColor = Color3.fromRGB(240, 130, 130),    -- red — offensive passive
		-- 3 SP per purchase: outgoing damage compounds with weapon stats,
		-- so each rank is worth marginally more than the defensive passive.
		-- Maxing costs 3 × 5 = 15 SP — a meaningful long-term investment.
		UnlockCost = 3,
		School = 'Sword',
		Prereqs = {},
		RequiredLevel = 1,
		Cooldown = 0,
		Passive = true,
		MaxLevel = 5,
		PerLevelEffects = {
			{ Stat = Module.StatNameEnum.Attack, Kind = Module.StatEffectKindEnum.Percent, Bonus = 0.02 },
		},
	}),

	----------------------------------------------------------------------
	-- // Flash branch — stab-based, precision/speed style //
	-- quick_slash → flash_slash → flash_strike → lightning_strike (ULT)
	-- Hitbox is intentionally THIN and LONG (Vector3 X≈3, Z≈8-10) so
	-- thrusts only catch enemies directly in front of the player —
	-- contrast with the wide arcs of the heavy branch. HitInterval
	-- shrinks as the chain progresses so the high-tier finishers FEEL
	-- faster despite landing more pulses.
	----------------------------------------------------------------------
	quick_slash = skill({
		Id = 'quick_slash',
		Display = {
			Name = 'Quick Slash',
			Description = 'A single fast stab. Low damage but lightning recovery.',
		},
		School = 'Sword',
		TabCategory = 'dual',
		HexagonColor = Color3.fromRGB(140, 230, 240),    -- cyan (flash style)
		Prereqs = {},
		RequiredLevel = 1,
		WindupTime = 0.08,
		ActiveTime = 0.20,
		RecoveryTime = 0.18,
		Cooldown = 2.5,
		Hitbox = { Size = Vector3.new(3, 5, 8), ForwardOffset = 5, Hits = 1, HitInterval = 0 },
		Damage = { Base = 10, WeaponScale = 0.9 },
	}),

	flash_slash = skill({
		Id = 'flash_slash',
		Display = {
			Name = 'Flash Slash',
			Description = 'A harder, deeper thrust. Significantly more damage than Quick Slash.',
		},
		School = 'Sword',
		TabCategory = 'dual',
		HexagonColor = Color3.fromRGB(100, 220, 240),    -- brighter cyan
		Prereqs = { 'quick_slash' },
		RequiredLevel = 1,
		WindupTime = 0.10,
		ActiveTime = 0.25,
		RecoveryTime = 0.22,
		Cooldown = 4.0,
		Hitbox = { Size = Vector3.new(3, 5, 9), ForwardOffset = 5, Hits = 1, HitInterval = 0 },
		Damage = { Base = 22, WeaponScale = 1.15 },
	}),

	flash_strike = skill({
		Id = 'flash_strike',
		Display = {
			Name = 'Flash Strike',
			Description = 'Two consecutive thrusts in a flash. Moderate per-hit damage.',
		},
		School = 'Sword',
		TabCategory = 'dual',
		HexagonColor = Color3.fromRGB(180, 240, 255),    -- pale cyan
		Prereqs = { 'flash_slash' },
		RequiredLevel = 1,
		WindupTime = 0.10,
		ActiveTime = 0.40,
		RecoveryTime = 0.28,
		Cooldown = 6.0,
		Hitbox = { Size = Vector3.new(3, 5, 9), ForwardOffset = 5, Hits = 2, HitInterval = 0.18 },
		Damage = { Base = 16, WeaponScale = 1.0 },
	}),

	lightning_strike = skill({
		Id = 'lightning_strike',
		Display = {
			Name = 'Lightning Strike',
			Description = 'Three blistering thrusts in rapid succession. The flash-branch finisher.',
		},
		School = 'Sword',
		TabCategory = 'dual',
		HexagonColor = Color3.fromRGB(245, 200, 80),     -- gold — ULT/finisher tile
		Prereqs = { 'flash_strike' },
		RequiredLevel = 1,
		-- ULT finisher — gated behind Agility investment.
		RequiredAttributes = { Agility = 3 },
		WindupTime = 0.08,
		ActiveTime = 0.55,
		RecoveryTime = 0.40,
		Cooldown = 12.0,
		Hitbox = { Size = Vector3.new(3, 5, 10), ForwardOffset = 5.5, Hits = 3, HitInterval = 0.14 },
		Damage = { Base = 20, WeaponScale = 1.2 },
	}),

	----------------------------------------------------------------------
	-- // Heavy branch — large-swing / cleave style //
	-- heavy_chop → wide_cleave → whirlwind_slash → earthshatter (ULT)
	-- Hitboxes are WIDE (Vector3 X≈9-14, Z≈5-14) and damage-per-pulse
	-- is high. wide_cleave + earthshatter set MultiHit = false so a
	-- single enemy eats one big hit per cast (the wide hitbox is for
	-- group coverage, not stacked single-target damage).
	----------------------------------------------------------------------
	heavy_chop = skill({
		Id = 'heavy_chop',
		Display = {
			Name = 'Heavy Chop',
			Description = 'A vertical overhead chop. Slow windup, punishing damage.',
		},
		School = 'Sword',
		TabCategory = 'dual',
		HexagonColor = Color3.fromRGB(255, 175, 90),     -- amber/orange (heavy style)
		Prereqs = {},
		RequiredLevel = 1,
		WindupTime = 0.30,
		ActiveTime = 0.30,
		RecoveryTime = 0.40,
		Cooldown = 5.0,
		Hitbox = { Size = Vector3.new(5, 5, 6), ForwardOffset = 4, Hits = 1, HitInterval = 0 },
		Damage = { Base = 32, WeaponScale = 1.4 },
	}),

	wide_cleave = skill({
		Id = 'wide_cleave',
		Display = {
			Name = 'Wide Cleave',
			Description = 'A sweeping horizontal cut. Hits everything in a broad frontal arc.',
		},
		School = 'Sword',
		TabCategory = 'dual',
		HexagonColor = Color3.fromRGB(255, 155, 70),
		Prereqs = { 'heavy_chop' },
		RequiredLevel = 1,
		WindupTime = 0.25,
		ActiveTime = 0.40,
		RecoveryTime = 0.45,
		Cooldown = 7.0,
		-- One pulse, MultiHit = false so each humanoid eats it exactly once
		-- across the wide hitbox — the width is for group coverage, not
		-- multi-tap damage.
		Hitbox = { Size = Vector3.new(11, 5, 5), ForwardOffset = 4, Hits = 1, HitInterval = 0, MultiHit = false },
		Damage = { Base = 26, WeaponScale = 1.25 },
	}),

	whirlwind_slash = skill({
		Id = 'whirlwind_slash',
		Display = {
			Name = 'Whirlwind Slash',
			Description = 'Spin in place, hitting enemies all around you in a 360° sweep.',
		},
		School = 'Sword',
		TabCategory = 'dual',
		HexagonColor = Color3.fromRGB(255, 130, 60),
		Prereqs = { 'wide_cleave' },
		RequiredLevel = 1,
		RequiredAttributes = { Strength = 2 },
		WindupTime = 0.20,
		ActiveTime = 0.70,
		RecoveryTime = 0.45,
		Cooldown = 10.0,
		-- Player-centered hitbox (ForwardOffset = 0) approximates the
		-- 360° spin — three pulses spaced 0.20s apart simulate the
		-- rotational sweep catching enemies as they enter the radius.
		Hitbox = { Size = Vector3.new(10, 5, 10), ForwardOffset = 0, Hits = 3, HitInterval = 0.20 },
		Damage = { Base = 18, WeaponScale = 1.05 },
	}),

	earthshatter = skill({
		Id = 'earthshatter',
		Display = {
			Name = 'Earthshatter',
			Description = 'Slam the ground; a shockwave erupts in a wide ring. The heavy-branch finisher.',
		},
		School = 'Sword',
		TabCategory = 'dual',
		HexagonColor = Color3.fromRGB(245, 200, 80),     -- gold — ULT/finisher tile
		Prereqs = { 'whirlwind_slash' },
		RequiredLevel = 1,
		-- ULT finisher — gated behind Strength + Vitality investment.
		RequiredAttributes = { Strength = 3, Vitality = 2 },
		WindupTime = 0.45,
		ActiveTime = 0.60,
		RecoveryTime = 0.55,
		Cooldown = 18.0,
		-- Massive AOE; MultiHit = false so each enemy in the ring takes
		-- one heavy hit (rather than getting clipped repeatedly by the
		-- single long active window).
		Hitbox = { Size = Vector3.new(14, 5, 14), ForwardOffset = 2, Hits = 1, HitInterval = 0, MultiHit = false },
		Damage = { Base = 55, WeaponScale = 1.5 },
	}),

} :: { [string]: SkillConfig }

----------------------------------------------------------------------
-- Skill-tree graphs, keyed by TabCategory (i.e. SKILL_SCHOOLS rail id
-- in SkillsTab). Auto-built from each skill's TabCategory + Depends so
-- there's no parallel hand-maintained tree table. Skills with no
-- TabCategory are skipped (functional but hidden from the tree UI).
-- Read by SkillTreeLayout.resolve in SkillsTab to compute hex-grid
-- positions. To inject grouping-only edges without changing unlock
-- logic, set Depends = {…extra…} on the skill cfg directly.
--
-- The `depends` field on the synthesized TreeNode is a snapshot of the
-- skill's Depends list — Module.Trees is rebuilt only at module load,
-- so live edits to Skills.X.Depends won't propagate without a re-require.
----------------------------------------------------------------------
Module.Trees = {} :: { [string]: { Nodes: { [string]: { depends: { string } } } } }
do
	for id, cfg in Module.Skills do
		local cat = cfg.TabCategory
		if cat == nil then continue end
		local tree = Module.Trees[cat]
		if not tree then
			tree = { Nodes = {} }
			Module.Trees[cat] = tree
		end
		tree.Nodes[id] = { depends = table.clone(cfg.Depends or cfg.Prereqs or {}) }
	end
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/Materials"><![CDATA[-- Forge material catalog. Definitions = registry — see ARTISAN.md §4.
-- The table literal IS the registry; ItemConfig.ForgeMaterialId references
-- entries here. Multiple inventory items can share the same material id
-- (e.g. CrudeIronBar + RefinedIronBar both → 'iron') with different
-- UnitsPerStack on the ItemConfig side.

export type Material = {
	Id: string,
	Name: string,
	Color: Color3,
	-- Stat contributions per material unit. Forge stat math composites
	-- these via per-slot weight (ForgeShared.ComputeStats walks the
	-- blueprint's slots and sums weighted contributions).
	Damage: number,
	Speed: number,
	Weight: number,
	Durability: number,
	-- Trait token surfaced on tooltips + stored in StatSnapshot.BonusTraits.
	-- Non-mechanical in v1 (cosmetic / informational); future passes can
	-- map traits to combat-side effects.
	Trait: string,
	-- Minimum Smithing artisan level needed to use this material.
	-- ForgeShared.CanForgeWeapon refuses commits whose materials list
	-- includes any with RequiredLevel > player's Smithing level.
	-- Tier ladder is rough damage tiers; designers retune as needed.
	RequiredLevel: number,
	-- Tier (1..6) drives the dynamic rarity ladder of forged items
	-- via ForgeShared.ComputeForgedRarity. Cosmetically aligns with
	-- the Rarities enum (Common = 1 … Mythic = 6).
	Tier: number,
}

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

local Module = {}

Module.Materials = {
	iron       = { Id='iron',       Name='Iron',       Color=rgb(176,180,188), Damage=80,  Speed=1.0, Weight=1.2, Durability=1.0, Trait='—',                  RequiredLevel=1,  Tier=1 },
	steel      = { Id='steel',      Name='Steel',      Color=rgb(224,228,236), Damage=120, Speed=1.1, Weight=1.0, Durability=1.3, Trait='Heavy',              RequiredLevel=8,  Tier=2 },
	obsidian   = { Id='obsidian',   Name='Obsidian',   Color=rgb(58,42,72),    Damage=160, Speed=0.9, Weight=0.8, Durability=0.7, Trait='Brittle · crit',     RequiredLevel=15, Tier=2 },
	moonsteel  = { Id='moonsteel',  Name='Moonsteel',  Color=rgb(180,200,255), Damage=210, Speed=1.2, Weight=0.7, Durability=1.5, Trait='Lunar · regen',      RequiredLevel=22, Tier=3 },
	emberite   = { Id='emberite',   Name='Emberite',   Color=rgb(255,128,64),  Damage=240, Speed=1.1, Weight=0.9, Durability=1.1, Trait='Pyromantic',         RequiredLevel=30, Tier=3 },
	voidglass  = { Id='voidglass',  Name='Voidglass',  Color=rgb(200,157,255), Damage=280, Speed=1.3, Weight=0.6, Durability=0.9, Trait='Phase · +10% crit',  RequiredLevel=45, Tier=4 },
	dragonbone = { Id='dragonbone', Name='Dragonbone', Color=rgb(255,198,112), Damage=340, Speed=1.0, Weight=1.1, Durability=1.8, Trait='+8% DMG vs boss',    RequiredLevel=65, Tier=5 },
	starsilk   = { Id='starsilk',   Name='Starsilk',   Color=rgb(224,234,255), Damage=40,  Speed=1.6, Weight=0.3, Durability=1.2, Trait='Swift · +AGI',       RequiredLevel=80, Tier=6 },
} :: { [string]: Material }

-- Derived index: ascending damage for catalog browsers / UI sorting.
-- Compiled once at module load; cheap (small N).
Module.MaterialsByDamage = {}
do
	for _, m in Module.Materials do
		table.insert(Module.MaterialsByDamage, m)
	end
	table.sort(Module.MaterialsByDamage, function(a, b) return a.Damage < b.Damage end)
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/Blueprints"><![CDATA[-- // Blueprints — CLIENT-SIDE SHELL //
--
-- Authored data lives at ServerStorage/Modules/Data/Blueprints.luau.
-- This file's `Module.Blueprints` table starts EMPTY and is populated
-- at runtime by ConfigReplicationClient as the server pushes rows for
-- blueprints the player has unlocked (or, for whitelisted admins, the
-- full registry on join). The Forge widget hides un-replicated rows.
--
-- // Reading contract //
-- Callers must tolerate `Module.Blueprints[id] == nil` for blueprints
-- not yet unlocked. Treat absent ids as "not currently visible to
-- this player" — render nothing rather than erroring.
--
-- See ROADMAP.md §"Empty client shell" for the full pattern.
--
-- A Blueprint declares the per-slot structure of a craftable weapon.
-- Each slot has a `key` (matched in Composition.Forged.Parts) and a
-- player-facing `Label`. Weapon-class is implicit from `Id` for now;
-- when render-side model-swapping lands the blueprint will gain a
-- ResultingItemId pointer for the minted weapon's ItemConfig.
--
-- BLADEBORNE is a sword-only game. Ranged blueprints (bow, crossbow)
-- and magic blueprints (staff, wand) are intentionally absent — the
-- combat loop is melee + parry + dodge, not projectile or cast.

-- Per-slot grid position for the forge template visualization
-- (Tinkers-Construct-style diagonal weapon-shape preview). Uses (col, row)
-- with TOP-LEFT origin so a sword's blade sits at the top-right of the
-- grid and the handle sits at the bottom-left. Optional: when nil, the
-- ForgeWidget falls back to a simple staircase using the slot's array
-- index.
export type GridPosition = { x: number, y: number }

export type BlueprintSlot = {
	key: string,
	Label: string,
	-- Diagonal weapon-shape coordinate. Origin top-left. The whole
	-- pattern is normalized client-side so authors only need to worry
	-- about RELATIVE placement, not absolute pixel positions.
	Position: GridPosition?,
}

export type Blueprint = {
	Id: string,
	Name: string,
	Slots: { BlueprintSlot },
	-- ItemId minted by ForgeServer.AttemptForgeWeapon when this blueprint
	-- is committed (TargetItemId path). The minted item carries the per-
	-- craft Composition.Forged.StatSnapshot via PlayerInventoryServer.
	-- GiveQuantityOfItemIdToPlayer + the server's compose step.
	ResultingItemId: string,
}

local Module = {}

-- Empty at boot — populated by ConfigReplicationClient (category 'Blueprints').
Module.Blueprints = {} :: { [string]: Blueprint }

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/Modifiers"><![CDATA[-- // Modifiers — CLIENT-SIDE SHELL //
--
-- Authored data lives at ServerStorage/Modules/Data/Modifiers.luau.
-- This file's `Module.Modifiers` table starts EMPTY at boot. The shell
-- is populated by ItemsConfigReplicationServer's piggy-back pass —
-- when items bundle, any Modifier ids referenced via the player's
-- forged stacks (Composition.Forged.Modifiers) are pushed alongside.
-- ForgeServer also pushes individual Modifier rows on each forge
-- commit. See ROADMAP.md §"Empty client shell."
--
-- Reading: callers (ForgeWidget, InventoryTab tooltips) call
-- `Module.Modifiers[id]` and tolerate nil — un-replicated mod ids
-- render as a generic chip rather than erroring.
--
-- The TYPES + the `MaxModifierSlots` constant intentionally LIVE here
-- (populated). They aren't spoiler content — modifier-slot budget is
-- a UI authority that the forge widget reads to enforce the cost cap.
--
-- Forge modifier catalog — see ARTISAN.md §4.
-- Modifiers are slottable bonuses applied on top of a forged weapon's
-- base material stats. Each modifier has a `Cost` (modifier slots
-- consumed) and a `MaxStack` (how many times it can be applied to a
-- single weapon).
--
-- Two payload channels:
--   * `StatDelta` — flat / percent contributions baked into the
--     forge StatSnapshot (combat reads via composition multipliers).
--     Authors set fields they want to bump; nil = no change.
--   * `OnHit` — per-strike inflict reference. When the weapon lands a
--     hit, CombatUtility walks ComputeActiveModifiers(stack) and rolls
--     each OnHit's Chance to inflict the named effect. PerStackPotency
--     scales the potency by stack count so an Ember×3 ember-mod hits
--     harder than Ember×1.

export type ModifierStatDelta = {
	-- Flat damage added per stack.
	Damage: number?,
	-- Percent multipliers (1.0-baseline, 0.10 = +10%).
	SpeedPct: number?,
	CritPct: number?,
	DurabilityPct: number?,
	-- Bonus tag surfaced on tooltip; non-mechanical.
	TraitTag: string?,
}

export type ModifierOnHit = {
	-- Effect id from Data/Effects.luau registry.
	EffectId: string,
	-- 0..1 chance per swing per stack. Total per-swing chance is
	-- 1 - (1 - Chance) ^ stackCount when applied across stacks.
	Chance: number,
	-- Optional duration / potency overrides; nil = effect cfg defaults.
	Duration: number?,
	Potency: number?,
	-- Per-stack potency add. When set, the runtime infliction's
	-- Potency = (Potency or default) + (PerStackPotency × stackCount).
	-- Useful for Ember (each stack burns harder), Onyx-bleed, etc.
	PerStackPotency: number?,
}

export type Modifier = {
	Id: string,
	Name: string,
	Color: Color3,
	Effect: string,                 -- player-facing effect description
	Cost: number,                   -- modifier slots consumed per stack
	MaxStack: number,               -- max times this can be stacked on one weapon
	-- New optional fields. Existing entries keep working with nil here;
	-- CombatUtility / ForgeShared early-return on missing fields.
	StatDelta: ModifierStatDelta?,
	OnHit: ModifierOnHit?,
}

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

local Module = {}

-- Total modifier-slot budget per weapon. Forge UI / server enforces
-- that the sum of (cost × stacks-applied) stays ≤ this number.
Module.MaxModifierSlots = 12

-- Empty at boot — populated by ConfigReplicationClient (category 'Modifiers').
-- See Items piggy-back: ItemsConfigReplicationServer pushes both 'Items'
-- and 'Modifiers' bundles together when forged stacks come into view.
Module.Modifiers = {} :: { [string]: Modifier }


return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/Enchants"><![CDATA[-- Enchant catalog — see ARTISAN.md §4.
-- Each enchant has a tier (rarity-equivalent for the UI), a school
-- (filter group), a per-level cost array, and optional Conflict /
-- Prereq lists for cross-enchant rules.
--
-- Conflict semantics: if any enchant in `Conflict` is applied to the
-- same item, this enchant cannot be applied (and vice versa).
-- Prereq semantics: this enchant requires `Prereq.Id` to already be
-- on the item at level ≥ `Prereq.Level`.

export type EnchantPrereq = { Id: string, Level: number }

export type Enchant = {
	Id: string,
	Name: string,
	Tier: string,                   -- 'common' | 'uncommon' | 'rare' | 'epic' | 'mythic'
	School: string,                 -- 'Edge' | 'Faith' | 'Ward' | 'Pyre' | ...
	MaxLevel: number,
	Cost: { number },               -- Cost[level] = cost in enchant currency at that level
	Color: Color3,
	-- Format string for the player-facing effect line; descMult is the
	-- per-level scalar substituted into the format. e.g. '+%d%% melee
	-- DMG.' with descMult = 8 → '+24% melee DMG.' at level 3.
	DescriptionFormat: string,
	DescriptionMultiplier: number,
	Conflict: { string }?,          -- enchant ids that exclude this one
	Prereq: EnchantPrereq?,         -- required enchant + level on the same item
	-- Required Enchanting artisan level. Gates higher-tier enchants
	-- behind Enchanting progression — without this, a Lv 1 player
	-- could mythic-enchant a starter sword. Defaults via the
	-- Tier→RequiredLevel ladder when unset (TIER_LEVEL_GATE below).
	RequiredLevel: number?,
}

-- Default Enchanting-school level requirements per tier. Used as
-- fallback when an enchant cfg doesn't carry an explicit
-- RequiredLevel — keeps the catalog terse while still gating.
local TIER_LEVEL_GATE = {
	common   = 1,
	uncommon = 10,
	rare     = 20,
	epic     = 40,
	mythic   = 70,
}

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

local Module = {}

Module.Enchants = {
	-- // Common //
	sharpness = {
		Id='sharpness', Name='Sharpness', Tier='common', School='Edge',
		MaxLevel=5, Cost={5,12,22,36,54}, Color=rgb(126,200,255),
		DescriptionFormat='+%d%% melee DMG.', DescriptionMultiplier=8,
		Conflict={'smite'},
	},
	smite = {
		Id='smite', Name='Smite', Tier='common', School='Faith',
		MaxLevel=5, Cost={5,12,22,36,54}, Color=rgb(255,216,112),
		DescriptionFormat='+%d%% DMG vs Undead.', DescriptionMultiplier=12,
		Conflict={'sharpness'},
	},
	unbreaking = {
		Id='unbreaking', Name='Unbreaking', Tier='common', School='Ward',
		MaxLevel=3, Cost={8,16,28}, Color=rgb(180,228,255),
		DescriptionFormat='+%d%% effective DUR.', DescriptionMultiplier=30,
	},
	-- // Uncommon //
	fire_aspect = {
		Id='fire_aspect', Name='Fire Aspect', Tier='uncommon', School='Pyre',
		MaxLevel=3, Cost={14,26,40}, Color=rgb(255,128,64),
		DescriptionFormat='Ignite on hit (%ds).', DescriptionMultiplier=2,
	},
	frost = {
		Id='frost', Name='Frost Aspect', Tier='uncommon', School='Frost',
		MaxLevel=3, Cost={14,26,40}, Color=rgb(80,128,255),
		DescriptionFormat='On hit: slow %d%% (3s).', DescriptionMultiplier=15,
	},
	looting = {
		Id='looting', Name='Looting', Tier='uncommon', School='Wyrd',
		MaxLevel=3, Cost={18,32,48}, Color=rgb(106,227,168),
		DescriptionFormat='+%d%% rare drop chance.', DescriptionMultiplier=15,
	},
	-- // Rare //
	keen_edge = {
		Id='keen_edge', Name='Keen Edge', Tier='rare', School='Edge',
		MaxLevel=5, Cost={22,38,58,82,110}, Color=rgb(200,157,255),
		DescriptionFormat='+%d%% CRIT chance.', DescriptionMultiplier=5,
	},
	vorpal = {
		Id='vorpal', Name='Vorpal', Tier='rare', School='Edge',
		MaxLevel=3, Cost={40,72,108}, Color=rgb(200,157,255),
		DescriptionFormat='Ignore %d%% armor.', DescriptionMultiplier=8,
		Prereq={Id='sharpness', Level=3},
	},
	lifesteal = {
		Id='lifesteal', Name='Siphon', Tier='rare', School='Bone',
		MaxLevel=4, Cost={34,60,90,128}, Color=rgb(255,109,144),
		DescriptionFormat='Heal %d%% of DMG dealt.', DescriptionMultiplier=2,
	},
	-- // Epic //
	bleed = {
		Id='bleed', Name='Bleed', Tier='epic', School='Bone',
		MaxLevel=5, Cost={60,90,130,180,240}, Color=rgb(200,157,255),
		DescriptionFormat='Bleed: %d DMG/s (4s).', DescriptionMultiplier=60,
		Prereq={Id='lifesteal', Level=2},
	},
	executioner = {
		Id='executioner', Name='Executioner', Tier='epic', School='Bone',
		MaxLevel=3, Cost={80,140,220}, Color=rgb(255,93,109),
		DescriptionFormat='+%d%% DMG below 30%% HP.', DescriptionMultiplier=20,
	},
	-- // Mythic //
	starforge = {
		Id='starforge', Name='Starforge', Tier='mythic', School='Astra',
		MaxLevel=1, Cost={400}, Color=rgb(255,208,96),
		DescriptionFormat='Every 16th strike: meteor (%d dmg).',
		DescriptionMultiplier=4000,
		Prereq={Id='keen_edge', Level=5},
	},
} :: { [string]: Enchant }

-- Tier color palette (for UI badge tints). Kept here so the catalog +
-- tier visuals stay co-located.
Module.TierColors = {
	common   = rgb(154,166,184),
	uncommon = rgb(106,227,168),
	rare     = rgb(126,200,255),
	epic     = rgb(200,157,255),
	mythic   = rgb(255,198,112),
}

-- Re-export the Tier→RequiredLevel ladder so EnchantShared can read
-- it without re-deriving the table. Authors override per-enchant via
-- the explicit RequiredLevel field on a cfg entry.
Module.TierLevelGate = TIER_LEVEL_GATE

-- Map Tier name → numeric (1..6) so essence-cost / rarity-essence
-- routing can match against the same enum the rest of the project
-- uses. mythic intentionally maps to 6 so it aligns with the Rarities
-- enum's mythic = 6 entry.
Module.TierEnum = {
	common = 1, uncommon = 2, rare = 3, epic = 4, mythic = 6,
}

function Module.GetRequiredLevel(enchantId: string): number
	local cfg = Module.Enchants[enchantId]
	if not cfg then return 1 end
	if cfg.RequiredLevel then return cfg.RequiredLevel end
	return TIER_LEVEL_GATE[cfg.Tier] or 1
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/Gems"><![CDATA[-- Gem catalog — see ARTISAN.md §4.
-- Each entry is a fully-specified (gem, cut) combination — the cut is
-- baked into the Id rather than a separate field on the inventory item.
-- This keeps stat math flat (no runtime composition of gem × cut), and
-- makes the catalog browser show every available gem variant at a
-- glance.
--
-- ItemConfig.GemId points to entries here.

export type Gem = {
	Id: string,                     -- e.g. 'ruby_pristine'
	Name: string,                   -- player-facing
	Cut: string,                    -- 'chipped' / 'flawed' / 'standard' / 'flawless' / 'pristine'
	Rarity: string,                 -- 'common' / 'uncommon' / 'rare' / 'epic' / 'mythic'
	Color: Color3,
	-- Color taxonomy for socket-color matching + resonance detection.
	-- Distinct from Color3 (which is the visual tint).
	ColorClass: string,             -- 'red' / 'blue' / 'green' / 'gold' / 'purple' / 'white' / 'black'
	Shape: string,                  -- catalog flavor; not gameplay-effective in v1
	-- Player-facing stat description. Numerical effects are encoded in
	-- the gem's StatBonus formula (added in Stage D combat integration).
	Stat: string,
	-- Required Gemcutting artisan level to socket this gem. Falls
	-- through to the Rarity→Level ladder below when unset.
	RequiredLevel: number?,
}

-- Default Gemcutting level requirements per gem rarity. Same ladder
-- shape Enchants uses; tuned slightly later (gems are post-forge,
-- so the average player engages with them after hitting moderate
-- artisan levels).
local RARITY_LEVEL_GATE = {
	common   = 1,
	uncommon = 8,
	rare     = 18,
	epic     = 35,
	mythic   = 60,
}

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

local Module = {}

Module.Gems = {
	ruby_pristine = {
		Id='ruby_pristine', Name='Ruby of Ruin', Cut='pristine', Rarity='epic',
		Color=rgb(255,80,104), ColorClass='red', Shape='octagon',
		Stat='+12% Fire DMG · ignite stacks x2',
	},
	sapphire_flawless = {
		Id='sapphire_flawless', Name='Sapphire Tear', Cut='flawless', Rarity='rare',
		Color=rgb(80,128,255), ColorClass='blue', Shape='pear',
		Stat='+80 Mana on crit',
	},
	emerald_flawless = {
		Id='emerald_flawless', Name='Emerald Shard', Cut='flawless', Rarity='rare',
		Color=rgb(80,224,128), ColorClass='green', Shape='marquise',
		Stat='+3% lifesteal',
	},
	topaz_standard = {
		Id='topaz_standard', Name='Topaz Spark', Cut='standard', Rarity='uncommon',
		Color=rgb(255,192,64), ColorClass='gold', Shape='square',
		Stat='+8% rare drop',
	},
	amethyst_standard = {
		Id='amethyst_standard', Name='Amethyst Whisper', Cut='standard', Rarity='uncommon',
		Color=rgb(176,112,224), ColorClass='purple', Shape='oval',
		Stat='+12% MP regen',
	},
	onyx_pristine = {
		Id='onyx_pristine', Name='Onyx of Night', Cut='pristine', Rarity='epic',
		Color=rgb(96,64,112), ColorClass='black', Shape='octagon',
		Stat='+6% lifesteal at night',
	},
	diamond_flawless = {
		Id='diamond_flawless', Name='Diamond, Flawless', Cut='flawless', Rarity='mythic',
		Color=rgb(224,234,255), ColorClass='white', Shape='octagon',
		Stat='+14% all stats',
	},
	pearl_standard = {
		Id='pearl_standard', Name='Tide Pearl', Cut='standard', Rarity='rare',
		Color=rgb(240,232,208), ColorClass='white', Shape='oval',
		Stat='+30 max HP per socket',
	},
	jet_flawed = {
		Id='jet_flawed', Name='Jet of the Abyss', Cut='flawed', Rarity='rare',
		Color=rgb(48,48,160), ColorClass='blue', Shape='square',
		Stat='+5% void DMG',
	},
	opal_pristine = {
		Id='opal_pristine', Name='Wandering Opal', Cut='pristine', Rarity='epic',
		Color=rgb(128,224,192), ColorClass='green', Shape='pear',
		Stat='random elemental +20% DMG',
	},
} :: { [string]: Gem }

-- Cut multipliers — applied to gem stat formulas in Stage D integration.
-- chipped < flawed < standard < flawless < pristine.
Module.CutMultiplier = {
	chipped  = 0.4,
	flawed   = 0.7,
	standard = 1.0,
	flawless = 1.3,
	pristine = 1.6,
}

-- Color classes — used by socket matching. Sockets declare a Color
-- requirement; gems whose ColorClass matches (or socket = 'any') fit.
Module.ColorClasses = {
	red    = rgb(255,80,104),
	blue   = rgb(80,128,255),
	green  = rgb(80,224,128),
	gold   = rgb(255,192,64),
	purple = rgb(176,112,224),
	white  = rgb(224,234,255),
	black  = rgb(96,64,112),
}

Module.RarityLevelGate = RARITY_LEVEL_GATE

function Module.GetRequiredLevel(gemId: string): number
	local cfg = Module.Gems[gemId]
	if not cfg then return 1 end
	if cfg.RequiredLevel then return cfg.RequiredLevel end
	return RARITY_LEVEL_GATE[cfg.Rarity] or 1
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/TitleEffects"><![CDATA[-- TitleEffects — named registry of runtime title effects. A title
-- author references one by name (or assigns an inline table) on the
-- title's Effect field. The renderer's apply step calls Init once,
-- then drives OnHeartbeat each frame with the elapsed time and the
-- author's state, and Cleanup once when the title is cleared.
--
-- Each effect entry has the shape:
--   {
--     Init: ((label: TextLabel, gradient: UIGradient?) -> any)?,
--     OnHeartbeat: ((state, label, gradient, elapsed: number, dt: number) -> ())?,
--     Cleanup: ((state, label, gradient) -> ())?,
--   }
--
-- The state returned by Init is opaque to the renderer — authors
-- store whatever per-instance bookkeeping they need (initial color,
-- offset accumulators, etc.). Init may return nil; OnHeartbeat is
-- called regardless.
--
-- Effects are CLIENT-ONLY visual flair. Author authoritative state
-- (unlock, equip) on the server; render flair here.

local Module = {}

----------------------------------------------------------------------
-- Effect type alias.
----------------------------------------------------------------------
export type TitleEffect = {
	Init: ((label: TextLabel, gradient: UIGradient?) -> any)?,
	OnHeartbeat: ((state: any, label: TextLabel, gradient: UIGradient?, elapsed: number, dt: number) -> ())?,
	Cleanup: ((state: any, label: TextLabel, gradient: UIGradient?) -> ())?,
}

----------------------------------------------------------------------
-- Built-in effects.
----------------------------------------------------------------------

-- Rotates a UIGradient slowly so a multi-stop gradient sweeps across
-- the title text. Requires the title's Gradient field to be set;
-- without a UIGradient, this no-ops.
Module.RainbowSweep = {
	Init = function(_label, gradient)
		-- State holds the rotation offset and a per-effect speed override
		-- so the same effect can be reused with different feels.
		return { rotation = (gradient and gradient.Rotation) or 0, speed = 90 }
	end,
	OnHeartbeat = function(state, _label, gradient, _elapsed, dt)
		if not gradient then return end
		state.rotation = (state.rotation + state.speed * dt) % 360
		gradient.Rotation = state.rotation
	end,
} :: TitleEffect

-- Slow scale-pulse on the label's UIScale. Adds one if missing so
-- inline use against a vanilla TextLabel works without setup.
Module.BreathingPulse = {
	Init = function(label, _gradient)
		local scale = label:FindFirstChildOfClass('UIScale')
		if not scale then
			scale = Instance.new('UIScale')
			scale.Name = 'BreathingPulseScale'
			scale.Parent = label
		end
		return { scale = scale, base = scale.Scale, amp = 0.06, freq = 1.2, owned = true }
	end,
	OnHeartbeat = function(state, _label, _gradient, elapsed, _dt)
		if not state or not state.scale then return end
		state.scale.Scale = state.base + math.sin(elapsed * state.freq * math.pi * 2) * state.amp
	end,
	Cleanup = function(state, _label, _gradient)
		-- Only destroy the UIScale if WE created it. A label that
		-- already had a UIScale shouldn't lose it on title clear.
		if state and state.owned and state.scale and state.scale.Parent then
			state.scale:Destroy()
		end
	end,
} :: TitleEffect

-- Subtle hue shift via TextColor3 lerp through a 3-color palette.
-- Useful for gold-tier titles that want a "shimmer" without a full
-- gradient — gradients require a UIGradient instance, this works on
-- a vanilla label.
Module.ShimmerColors = {
	Init = function(label, _gradient)
		return {
			baseColor = label.TextColor3,
			palette = {
				Color3.fromRGB(255, 220, 130),
				Color3.fromRGB(255, 245, 200),
				Color3.fromRGB(220, 180, 90),
			},
		}
	end,
	OnHeartbeat = function(state, label, _gradient, elapsed, _dt)
		if not state then return end
		-- Lerp through the palette over a 3-second period.
		local n = #state.palette
		local t = (elapsed % 3) / 3 * n
		local i = math.floor(t)
		local frac = t - i
		local a = state.palette[(i % n) + 1]
		local b = state.palette[((i + 1) % n) + 1]
		label.TextColor3 = a:Lerp(b, frac)
	end,
	Cleanup = function(state, label, _gradient)
		if state and state.baseColor then
			label.TextColor3 = state.baseColor
		end
	end,
} :: TitleEffect

-- Wobble — gentle horizontal jitter via Position offset. Useful for
-- "haunted" / "cursed" tier titles. Requires the label to be inside
-- a parent that allows the absolute Position write (i.e. not under
-- a UIListLayout that snaps it back). The effect saves/restores the
-- original Position on cleanup.
Module.GhostWobble = {
	Init = function(label, _gradient)
		return { basePos = label.Position }
	end,
	OnHeartbeat = function(state, label, _gradient, elapsed, _dt)
		if not state then return end
		local dx = math.sin(elapsed * 6) * 1.5  -- pixels
		label.Position = state.basePos + UDim2.fromOffset(dx, 0)
	end,
	Cleanup = function(state, label, _gradient)
		if state and state.basePos then
			label.Position = state.basePos
		end
	end,
} :: TitleEffect

----------------------------------------------------------------------
-- Resolve helper. Accepts either a string id (registry lookup) or an
-- inline TitleEffect table — returns the effect or nil. Authors use
-- the string form for built-ins, the inline form for one-off custom
-- effects authored alongside the title in Data/Titles.luau.
----------------------------------------------------------------------
function Module.Resolve(effectOrId: any): TitleEffect?
	if effectOrId == nil then return nil end
	if typeof(effectOrId) == 'string' then
		return Module[effectOrId]
	end
	if typeof(effectOrId) == 'table' then
		return effectOrId :: TitleEffect
	end
	return nil
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/CombatActions"><![CDATA[-- CombatActions — shared combat action constants and intent payload types.
--
-- This is the whole CombatEvent wire contract. Every combat message, in
-- both directions, uses one of the named discriminators below plus a
-- single table payload.
--
-- The previous numeric enum and its positional-argument payloads are
-- gone. That shape had two problems worth recording so they are not
-- reintroduced: argument order was load-bearing across two files (a
-- thirteen-argument FireServer whose slots were documented only in a
-- comment), and it carried client-measured animation timings that the
-- server read and then ignored — a field that looked authoritative,
-- was not, and invited someone to start trusting it.

local Module = {}

Module.Version = 2

Module.Actions = {
	-- Client -> Server. Every request carries a CommandId so replies can
	-- be correlated and replayed commands rejected.
	RequestLightAttack = 'RequestLightAttack',
	RequestHeavyAttack = 'RequestHeavyAttack',
	RequestSkill = 'RequestSkill',
	RequestDodge = 'RequestDodge',
	RequestGuardStart = 'RequestGuardStart',
	RequestGuardEnd = 'RequestGuardEnd',
	RequestWeaponToggle = 'RequestWeaponToggle',
	RequestDroneFire = 'RequestDroneFire',
	RequestDroneProgram = 'RequestDroneProgram',

	-- Server -> owning client.
	ActionAccepted = 'ActionAccepted',
	ActionRejected = 'ActionRejected',
	PerfectDodge = 'PerfectDodge',

	-- Server -> all clients. Cosmetic and reconciliation cues only; none
	-- of these carry authority, and a client that drops every one of
	-- them still experiences correct gameplay.
	ActionStarted = 'ActionStarted',
	ActionCancelled = 'ActionCancelled',
	HitConfirmed = 'HitConfirmed',
	StatusApplied = 'StatusApplied',
	StateChanged = 'StateChanged',
	GuardBlocked = 'GuardBlocked',
	GuardBroken = 'GuardBroken',
	WeaponToggled = 'WeaponToggled',
}

Module.InputKinds = {
	Light = 'L',
	Heavy = 'H',
	Dodge = 'Dodge',
	Skill = 'Skill',
	Drone = 'Drone',
}

Module.Contexts = {
	Ground = 'Ground',
	Air = 'Air',
	DodgeCounter = 'DodgeCounter',
	Dash = 'Dash',
}

export type CombatAction =
	'RequestLightAttack'
	| 'RequestHeavyAttack'
	| 'RequestSkill'
	| 'RequestDodge'
	| 'RequestGuardStart'
	| 'RequestGuardEnd'
	| 'RequestWeaponToggle'
	| 'RequestDroneFire'
	| 'RequestDroneProgram'
	| 'ActionAccepted'
	| 'ActionRejected'
	| 'ActionStarted'
	| 'ActionCancelled'
	| 'HitConfirmed'
	| 'StatusApplied'
	| 'StateChanged'
	| 'PerfectDodge'
	| 'GuardBlocked'
	| 'GuardBroken'
	| 'WeaponToggled'

export type CombatInputKind = 'L' | 'H' | 'Dodge' | 'Skill' | 'Drone'
export type CombatContext = 'Ground' | 'Air' | 'DodgeCounter' | 'Dash'

-- The client -> server payload. Every field is a HINT except CommandId
-- and the action discriminator itself: the server re-derives the weapon
-- class, the combo context, the real chain, the target and every timing
-- from its own state.
--
-- Note what is absent and must stay absent: no damage, no hit list, no
-- active/recovery durations, no status application, no resulting
-- position for anyone. If a field like that ever appears here, the
-- server has started trusting the client.
export type CombatIntent = {
	CommandId: number,
	InputKind: CombatInputKind?,
	-- The chain the client BELIEVES it is on. Compared against the
	-- server's tracked chain; a mismatch downgrades the swing rather
	-- than rejecting it, so honest desync is survivable.
	ComboKey: string?,
	SkillId: string?,
	ClientTime: number?,
	Origin: Vector3?,
	Look: Vector3?,
	Direction: Vector3?,
	AimPoint: Vector3?,
	TargetInstance: Instance?,
}

export type CombatStartResult = {
	Accepted: boolean,
	Reason: string,
	ServerActionId: string?,
	ServerTime: number,
	MoveId: string?,
	StateUntil: number?,
}

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/CinematicPresets"><![CDATA[-- CinematicPresets — named bundles of args for cue-kinds that
-- cinematic authors reach for repeatedly. Three groups:
--
--   Shake       — magnitude / roughness / duration / fades
--   CameraShot  — relative CFrame offsets for "shot composition"
--                 (over-shoulder, low-hero, wide-establishing, …)
--   VFX         — template name + duration + default anchor
--
-- Authors compose cinematics by preset *name* (e.g. 'heavy',
-- 'over_shoulder', 'slash_burst'); the builder API in
-- Services/CinematicBuilder resolves names to cue args. Keeps
-- Cinematics.luau readable + lets us re-tune one preset and have
-- every cinematic that referenced it pick up the change.
--
-- Adding a preset: drop an entry into the right table below. Use
-- ResolveShake / ResolveShot / ResolveVFX to look one up at
-- runtime; missing names log a warn and return a safe default.

local CinematicShared = require(script.Parent.Parent.Services.CinematicShared)

local Module = {}

----------------------------------------------------------------------
-- Shake presets. Magnitude / Roughness / Duration with optional
-- FadeIn / FadeOut. Tuned so 'subtle' is barely-perceptible head
-- nudge and 'earthquake' is a 1.2s cinematic-grade rumble.
----------------------------------------------------------------------
export type ShakePreset = {
	Magnitude: number,
	Roughness: number,
	Duration: number,
	FadeIn: number?,
	FadeOut: number?,
}

Module.Shakes = ({
	-- Head-nudge. Use under dialogue lines, breathing camera, etc.
	subtle    = { Magnitude = 0.08, Roughness = 6, Duration = 0.30, FadeIn = 0.05, FadeOut = 0.20 },
	-- Default per-hit weight. Combat connect feedback.
	soft      = { Magnitude = 0.20, Roughness = 5, Duration = 0.30, FadeIn = 0.04, FadeOut = 0.20 },
	medium    = { Magnitude = 0.35, Roughness = 5, Duration = 0.45, FadeIn = 0.05, FadeOut = 0.30 },
	-- Heavy hit / counter / parry land.
	heavy     = { Magnitude = 0.55, Roughness = 6, Duration = 0.50, FadeIn = 0.04, FadeOut = 0.35 },
	-- Crunchy attack-connect "hit-stop" feel.
	hit       = { Magnitude = 0.45, Roughness = 8, Duration = 0.18, FadeIn = 0.01, FadeOut = 0.10 },
	-- Finisher / boss-stagger. Bigger, slightly slower roughness.
	finisher  = { Magnitude = 0.85, Roughness = 5, Duration = 0.65, FadeIn = 0.05, FadeOut = 0.40 },
	-- Big slow rumble — explosions, environmental beats.
	explosion = { Magnitude = 1.10, Roughness = 4, Duration = 0.85, FadeIn = 0.10, FadeOut = 0.50 },
	-- Earthquake / boss spawn / world-event scale.
	earthquake = { Magnitude = 1.40, Roughness = 3, Duration = 1.20, FadeIn = 0.20, FadeOut = 0.60 },
}) :: { [string]: ShakePreset }

local DEFAULT_SHAKE: ShakePreset = Module.Shakes.medium

function Module.ResolveShake(name: string): ShakePreset
	local p = Module.Shakes[name]
	if not p then
		warn(string.format('CinematicPresets.ResolveShake: unknown shake %q (defaulting to medium)', tostring(name)))
		return DEFAULT_SHAKE
	end
	return p
end

----------------------------------------------------------------------
-- Camera shot presets. Stored as a CFrame OFFSET applied relative
-- to the subject's pivot — the builder expands these into CameraTo
-- cue args by passing them through as `Offset` on instance-anchored
-- CameraTo. Lerp time is per-preset so an "establishing" shot eases
-- in slowly while a "snap_close" cuts hard.
----------------------------------------------------------------------
export type CameraShotPreset = {
	Offset: CFrame,
	Lerp: number,
}

local function shot(offset: CFrame, lerp: number): CameraShotPreset
	return { Offset = offset, Lerp = lerp }
end

Module.CameraShots = ({
	-- Behind-shoulder, slight tilt down. Standard dialogue / quest pose.
	over_shoulder      = shot(CFrame.new(2.5, 2, 6) * CFrame.Angles(math.rad(-8), 0, 0), 0.6),
	-- Tight close-up — front-facing, eyes-level.
	closeup            = shot(CFrame.new(0, 1.5, 4),                                       0.5),
	-- Hero low-angle — looking up at the subject. Boss intros.
	low_hero           = shot(CFrame.new(0, -1, 7) * CFrame.Angles(math.rad(12), 0, 0),    0.8),
	-- Wide establishing — pulled back + slight crane-down feel.
	wide_establishing  = shot(CFrame.new(0, 8, 18) * CFrame.Angles(math.rad(-15), 0, 0),   1.2),
	-- Profile — side view, useful for two-character framings.
	profile_left       = shot(CFrame.new(-7, 1.5, 3) * CFrame.Angles(0, math.rad(70), 0),  0.7),
	profile_right      = shot(CFrame.new(7, 1.5, 3) * CFrame.Angles(0, math.rad(-70), 0),  0.7),
	-- Snap-cut close — for stingers / camera-pop on dramatic beats.
	snap_close         = shot(CFrame.new(0, 1.5, 3.5),                                     0.15),
}) :: { [string]: CameraShotPreset }

local DEFAULT_SHOT: CameraShotPreset = Module.CameraShots.over_shoulder

function Module.ResolveShot(name: string): CameraShotPreset
	local p = Module.CameraShots[name]
	if not p then
		warn(string.format('CinematicPresets.ResolveShot: unknown shot %q (defaulting to over_shoulder)', tostring(name)))
		return DEFAULT_SHOT
	end
	return p
end

----------------------------------------------------------------------
-- VFX presets. Maps a preset name to a TemplateName under
-- ReplicatedStorage.AssetsShared.VFX and a default duration. The
-- runtime VFX cue (CinematicShared.CueKind.PlayVFX) silently no-ops
-- when the template is missing, so it's safe to author presets that
-- reference assets that haven't been added to the project yet.
----------------------------------------------------------------------
export type VFXPreset = {
	Template: string,
	Duration: number,
	-- Suggested anchor mode when the preset is fired without one.
	-- 'world' positions at args.Position; 'instance' tracks args.InstancePath.
	DefaultAnchor: 'world' | 'instance',
}

Module.VFX = ({
	slash_burst   = { Template = 'SlashBurst',  Duration = 1.2, DefaultAnchor = 'instance' },
	hit_spark     = { Template = 'HitSpark',    Duration = 0.6, DefaultAnchor = 'instance' },
	dust_poof     = { Template = 'DustPoof',    Duration = 1.5, DefaultAnchor = 'world' },
	smoke_pillar  = { Template = 'SmokePillar', Duration = 4.0, DefaultAnchor = 'world' },
	rune_circle   = { Template = 'RuneCircle',  Duration = 3.0, DefaultAnchor = 'world' },
	-- Screen-attached flash — anchors at the player's HRP for a
	-- camera-relative pop. Used for thunderclap / counter cue beats.
	screen_flash  = { Template = 'ScreenFlash', Duration = 0.35, DefaultAnchor = 'world' },
}) :: { [string]: VFXPreset }

local DEFAULT_VFX: VFXPreset = { Template = '__missing__', Duration = 1.0, DefaultAnchor = 'world' }

function Module.ResolveVFX(name: string): VFXPreset
	local p = Module.VFX[name]
	if not p then
		warn(string.format('CinematicPresets.ResolveVFX: unknown vfx %q', tostring(name)))
		return DEFAULT_VFX
	end
	return p
end

----------------------------------------------------------------------
-- Listing helpers — used by the test widget + Cmdr autocomplete to
-- enumerate available presets without snooping the table directly.
----------------------------------------------------------------------
local function namesOf(t): { string }
	local names = {}
	for k in t do names[#names + 1] = k end
	table.sort(names)
	return names
end

function Module.ListShakes(): { string }    return namesOf(Module.Shakes)      end
function Module.ListShots(): { string }     return namesOf(Module.CameraShots) end
function Module.ListVFX(): { string }       return namesOf(Module.VFX)         end

-- Re-export the shared cue-kind enum so callers don't have to require
-- both modules just to read CueKind.<X> when authoring presets.
Module.CueKind = CinematicShared.CueKind

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/PremiumConfig"><![CDATA[-- Premium config — gamepass ids and the per-feature benefit they
-- unlock. Single source of truth for both the server's
-- UserOwnsGamePassAsync gate AND the client's UI badges.
--
-- Usage:
--   local PremiumConfig = ReplicatedModules.Data.PremiumConfig
--   PremiumConfig.GAMEPASSES.AuraSlots         → number (Roblox gamepass id)
--   PremiumConfig.GetMaxAuraSlots(hasPass)     → number (1 or 3)
--
-- Server-side: prefer SystemsContainer.PremiumServer.GetMaxAuraSlots(player).
-- Client-side: prefer reading replicated PlayerData.Premium booleans and
-- using the helpers below.

local Module = {}

----------------------------------------------------------------------
-- Gamepass id registry. Replace the placeholder zeros with the real
-- gamepass ids once published. Until then the server's
-- UserOwnsGamePassAsync call returns false (Roblox treats id 0 as
-- "not a gamepass") so every player is treated as default-tier.
----------------------------------------------------------------------
Module.GAMEPASSES = {
	-- Increases the player's aura-slot cap from 1 → 3. Three is the
	-- design max so multi-anchor (character + sword + mount) is the
	-- gamepass headline; lower counts are intentionally not offered.
	AuraSlots = 0,
	-- Increases the player's companion-slot cap from 1 → 3. Mirrors
	-- AuraSlots: free tier ships with the headline cap so the system
	-- is fully usable; gamepass design will retarget once a real
	-- cap-extending benefit ships.
	CompanionSlots = 0,
}

----------------------------------------------------------------------
-- Aura slots benefit. Default cap is 1 (one aura equipped at a time);
-- gamepass cap is 3 (the original anchor-trio reach goal).
----------------------------------------------------------------------
-- Default cap raised to 3 (the design max) so a fresh player can equip
-- one aura per anchor (character + sword + mount) without the gamepass.
-- The gamepass design will need re-targeting once a real cap-extending
-- benefit ships; for now it's a no-op since the placeholder pass id is 0.
Module.AuraSlots = {
	Default       = 3,
	WithGamepass  = 3,
	-- Display string surfaced in the gamepass purchase prompt /
	-- inventory UI. Kept in this config so swapping copy doesn't
	-- require touching server code.
	GamepassName  = 'Aura Slot Pack',
}

function Module.GetMaxAuraSlots(hasGamepass: boolean): number
	return hasGamepass and Module.AuraSlots.WithGamepass or Module.AuraSlots.Default
end

----------------------------------------------------------------------
-- Companion slots benefit. Mirrors AuraSlots: 3-slot default so the
-- system is fully usable without the gamepass; the pass exists as a
-- placeholder to retarget once a true cap-extending benefit ships.
----------------------------------------------------------------------
Module.CompanionSlots = {
	Default       = 3,
	WithGamepass  = 3,
	GamepassName  = 'Companion Slot Pack',
}

function Module.GetMaxCompanionSlots(hasGamepass: boolean): number
	return hasGamepass and Module.CompanionSlots.WithGamepass or Module.CompanionSlots.Default
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/StatusEffects"><![CDATA[-- StatusEffects registry. Status / DoT / armor-debuff / movement
-- debuff definitions, all in one place. Authors reference effects by
-- id from weapons (`WeaponUsage.Inflicts`), forge modifiers
-- (`Modifier.OnHit`), skills, and consumables.
--
-- Design split:
--   * THIS FILE — pure config (id, display, category, defaults,
--                 stacking semantics).
--   * StatusEffectsRuntime — server module that owns timers,
--                            attribute mutations, DoT ticks. Reads
--                            cfg here at apply time; one handler per
--                            Category.
--
-- Stacking semantics (`Stacking` enum):
--   * 'replace' — newer apply replaces an active stack of the same id
--                 (refreshes Duration, may overwrite Potency).
--   * 'refresh' — newer apply only refreshes Duration; keeps the
--                 highest-Potency stack.
--   * 'stack'   — additive Potency up to MaxStack; new Duration is the
--                 max of incoming + remaining.
-- Defaults to 'refresh'.

export type EffectDisplay = {
	Title: { Text: string, TextColor3: Color3? },
	Description: { Text: string, TextColor3: Color3? },
	Icon: { Image: string, ImageColor3: Color3? }?,
	Viewport: { ImageColor3: Color3?, CFrame: CFrame? }?,
}

-- Reference shape — used by `WeaponUsage.Inflicts[*].Effects`,
-- `Modifier.OnHit`, and skill / consumable cfgs. Carries an optional
-- per-application Duration / Potency override; nil falls back to the
-- registry default for the named effect.
export type Effect = {
	Id: string,
	Duration: number?,
	Potency: number?,
}

export type EffectCategory =
	'dot'           -- Damage-over-time (burn / poison / bleed)
	| 'armor_flat'  -- Reduce armor by N units (crumbling)
	| 'armor_pct'   -- Reduce armor by N% (pierced)
	| 'cc'          -- Crowd control (paralysis / stun)
	| 'movement'    -- Movement debuff (slow)
	| 'damage_amp'  -- Outgoing/incoming damage multiplier
	| 'buff'        -- Generic positive effect
	| 'misc'

export type EffectStacking = 'replace' | 'refresh' | 'stack'

export type BaseEffectConfig = {
	Id: string,
	Display: EffectDisplay,
	Category: EffectCategory,
	-- Default per-apply duration (seconds). Override by passing
	-- Duration on the Effect reference at apply time.
	DefaultDuration: number,
	-- Default potency (interpretation depends on Category):
	--   dot         → damage per tick
	--   armor_flat  → flat armor reduction in points
	--   armor_pct   → fractional armor reduction (0.20 = -20%)
	--   cc          → unused (binary state)
	--   movement    → fractional walk-speed multiplier (0.40 = 60% slow)
	--   damage_amp  → fractional outgoing/incoming multiplier
	DefaultPotency: number,
	-- DoT-only: seconds between ticks. Ignored for non-DoT categories.
	TickInterval: number?,
	Stacking: EffectStacking,
	MaxStack: number,
	-- Color used by status-icon UI tinting.
	Color: Color3,
}

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

local function display(title: string, desc: string, color: Color3): EffectDisplay
	return {
		Title = { Text = title, TextColor3 = color },
		Description = { Text = desc, TextColor3 = color },
		Icon = { Image = 'rbxassetid://-1', ImageColor3 = color },
	}
end

local Module = {}

----------------------------------------------------------------------
-- Registry. Designers append entries here; runtime reads via
-- GetEffectFromId. Keep the table flat — categories are queries on
-- the Category field, not separate sub-tables.
----------------------------------------------------------------------
Module.StatusEffects = {

	-- // Damage-over-time //
	burn = {
		Id = 'burn',
		Display = display('Burn', 'Burning. Takes fire damage every second.', rgb(255, 130, 60)),
		Category = 'dot',
		DefaultDuration = 4.0,
		DefaultPotency = 4,
		TickInterval = 1.0,
		Stacking = 'refresh',
		MaxStack = 3,
		Color = rgb(255, 130, 60),
	},
	poison = {
		Id = 'poison',
		Display = display('Poisoned', 'Poison eats away at your health.', rgb(120, 220, 90)),
		Category = 'dot',
		DefaultDuration = 6.0,
		DefaultPotency = 3,
		TickInterval = 1.0,
		Stacking = 'stack',
		MaxStack = 5,
		Color = rgb(120, 220, 90),
	},
	bleed = {
		Id = 'bleed',
		Display = display('Bleeding', 'Bleeding. Each tick scales with movement.', rgb(220, 60, 80)),
		Category = 'dot',
		DefaultDuration = 5.0,
		DefaultPotency = 5,
		TickInterval = 0.8,
		Stacking = 'stack',
		MaxStack = 5,
		Color = rgb(220, 60, 80),
	},

	-- // Armor debuffs //
	-- Two complementary patterns: flat reduction ("crumbling" — chips
	-- off armor by the unit) vs percent reduction ("pierced" — strike
	-- went through). Both stack but cap at the target's full armor.
	crumbling = {
		Id = 'crumbling',
		Display = display('Crumbling', 'Armor breaking apart. Reduced by a flat amount.', rgb(180, 150, 100)),
		Category = 'armor_flat',
		DefaultDuration = 8.0,
		DefaultPotency = 4,
		Stacking = 'stack',
		MaxStack = 5,
		Color = rgb(180, 150, 100),
	},
	pierced = {
		Id = 'pierced',
		Display = display('Pierced', 'Armor punctured. Reduced by a percentage.', rgb(200, 80, 80)),
		Category = 'armor_pct',
		DefaultDuration = 6.0,
		DefaultPotency = 0.20,    -- -20% armor per stack
		Stacking = 'stack',
		MaxStack = 3,
		Color = rgb(200, 80, 80),
	},

	-- // Crowd control //
	paralysed = {
		Id = 'paralysed',
		Display = display('Paralysed', "Can't move. Watch the next swing land.", rgb(255, 230, 100)),
		Category = 'cc',
		DefaultDuration = 1.5,
		DefaultPotency = 1,
		Stacking = 'replace',
		MaxStack = 1,
		Color = rgb(255, 230, 100),
	},
	stunned_fx = {
		-- Visually-distinct stun fx; CombatShared.SetCharacterStunned
		-- already drives the gameplay-state attribute. This entry exists
		-- so non-combat sources (e.g. boss skill) can request a stun
		-- via the Effects pipeline without reaching into CombatShared.
		Id = 'stunned_fx',
		Display = display('Stunned', 'Briefly stunned.', rgb(220, 180, 140)),
		Category = 'cc',
		DefaultDuration = 1.0,
		DefaultPotency = 1,
		Stacking = 'replace',
		MaxStack = 1,
		Color = rgb(220, 180, 140),
	},

	-- // Movement debuffs //
	slow = {
		Id = 'slow',
		Display = display('Slowed', 'Movement reduced.', rgb(120, 180, 220)),
		Category = 'movement',
		DefaultDuration = 4.0,
		DefaultPotency = 0.40,    -- 1 - 0.40 = 60% walk speed
		Stacking = 'refresh',
		MaxStack = 1,
		Color = rgb(120, 180, 220),
	},
	chilled = {
		Id = 'chilled',
		Display = display('Chilled', 'Cold-stiffened. Lighter slow than direct ice.', rgb(180, 220, 255)),
		Category = 'movement',
		DefaultDuration = 3.0,
		DefaultPotency = 0.20,
		Stacking = 'refresh',
		MaxStack = 1,
		Color = rgb(180, 220, 255),
	},

	-- // Damage amplification //
	exposed = {
		Id = 'exposed',
		Display = display('Exposed', 'Takes 15% more damage from all sources.', rgb(255, 180, 80)),
		Category = 'damage_amp',
		DefaultDuration = 5.0,
		DefaultPotency = 0.15,
		Stacking = 'refresh',
		MaxStack = 1,
		Color = rgb(255, 180, 80),
	},

	-- // Buffs //
	regen = {
		Id = 'regen',
		Display = display('Regenerating', 'HP recovers over time.', rgb(120, 220, 140)),
		Category = 'dot',          -- positive DoT — handler routes by Potency sign
		DefaultDuration = 6.0,
		DefaultPotency = -3,        -- negative damage = healing
		TickInterval = 1.0,
		Stacking = 'refresh',
		MaxStack = 1,
		Color = rgb(120, 220, 140),
	},

} :: { [string]: BaseEffectConfig }

----------------------------------------------------------------------
-- Legacy id aliases.
--
-- These used to be full duplicate ENTRIES in the registry above, each
-- carrying its own copy of the tuning numbers. The comment on the
-- duplicate claimed it resolved "via the alias map below", but no such
-- map existed — so the two configs were independent, and tuning `burn`
-- would silently leave `Burn` on the old values.
--
-- Real indirection instead: one set of numbers, and the old id keeps
-- resolving for any Studio-authored content that still references it.
----------------------------------------------------------------------
local ID_ALIASES: { [string]: string } = {
	Burn = 'burn',
}

----------------------------------------------------------------------
-- Lookup helpers.
----------------------------------------------------------------------
function Module.ResolveEffectId(id: string): string
	return ID_ALIASES[id] or id
end

function Module.GetEffectFromId(id: string): BaseEffectConfig?
	if typeof(id) ~= 'string' then return nil end
	return Module.StatusEffects[Module.ResolveEffectId(id)]
end

-- Returns the cfg with per-call overrides applied. Caller passes an
-- Effect reference (id + optional Duration / Potency). Useful when
-- the consumer wants the resolved final values without doing the
-- merge themselves.
function Module.ResolveEffect(effectRef: Effect): (BaseEffectConfig?, number, number)
	if not effectRef or typeof(effectRef.Id) ~= 'string' then return nil, 0, 0 end
	-- Routed through GetEffectFromId so legacy ids resolve here too;
	-- indexing the registry directly would bypass the alias map.
	local cfg = Module.GetEffectFromId(effectRef.Id)
	if not cfg then return nil, 0, 0 end
	local duration = effectRef.Duration or cfg.DefaultDuration
	local potency  = effectRef.Potency or cfg.DefaultPotency
	return cfg, duration, potency
end

-- Filter helper for status-bar UI / boss-mod logic that wants only
-- effects in a given category.
function Module.GetEffectsByCategory(category: EffectCategory): { BaseEffectConfig }
	local out: { BaseEffectConfig } = {}
	for _, cfg in Module.StatusEffects do
		if cfg.Category == category then out[#out + 1] = cfg end
	end
	return out
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/Substations"><![CDATA[-- Substations — secondary proximity gates for crafting recipes.
--
-- Substations are PARALLEL to Workstations:
--   * Workstation = primary node (Forge / CookingPot / AlchemyBench).
--                   Triggers a ProximityPrompt that opens the crafting
--                   widget; the player's "school" is the workstation
--                   they're at. Recipe `Workstation` field gates which
--                   primary node a recipe can be crafted from.
--   * Substation  = secondary AMBIENT node (Kiln / BrewingBarrel /
--                   MortarPestle / SmokingRack / etc.). No prompt; the
--                   player just stands near one and any recipe whose
--                   `RequiredSubstation` matches its kind unlocks for
--                   craft. A recipe can require BOTH a Workstation
--                   and a Substation (e.g. AlchemyBench + MortarPestle
--                   for refined potions).
--
-- Membership uses the ZoneService Structure system (tag StructurePart),
-- so a substation registers a Structure zone keyed by its kind name.
-- The SubstationServer owns the per-player "active substation kinds"
-- set, populated from ZoneService.StructureEnter/Leave.
--
-- Authoring (Studio):
--   1. Tag the substation Model with CollectionService 'Substation'.
--   2. Set Attribute 'SubstationKind' to one of the keys below.
--   3. (Optional) Attribute 'ProximityRadius' (number, studs) — radius
--      of the substation zone. Default 8 studs.
--
-- Add new kinds by appending an entry below; the SubstationDefault
-- fallback keeps unmapped kinds still rendering a waypoint and still
-- gating a recipe (the kind STRING is what matches at runtime).

export type SubstationKindConfig = {
	Label: string,                 -- player-friendly name (waypoint + UI)
	Icon:  string,                 -- single-char glyph
	Color: Color3,                 -- accent color for waypoint stroke / icon
	-- Optional one-liner used by future tooltip / detail UI to explain
	-- what the substation is for. UI may strip it; runtime ignores.
	Hint:  string?,
}

local Module = {}

----------------------------------------------------------------------
-- Substation kinds. Each entry's KEY is the string written to the
-- Substation model's `SubstationKind` attribute — which is also what
-- a Recipe lists in its `RequiredSubstation` field.
----------------------------------------------------------------------
Module.Kinds = {
	Kiln = {
		Label = 'Kiln',
		Icon  = '\u{2615}',  -- ☕ approximation; swap once we ship a glyph font
		Color = Color3.fromRGB(255, 132, 78),
		Hint  = 'Bakes clay & seals smithy hardening recipes.',
	},
	BrewingBarrel = {
		Label = 'Brewing Barrel',
		Icon  = '\u{1F375}',  -- 🍵 (BMP fallback below if needed)
		Color = Color3.fromRGB(186, 142, 96),
		Hint  = 'Aged ferments — required for spirits & long-cure tonics.',
	},
	MortarPestle = {
		Label = 'Mortar & Pestle',
		Icon  = '\u{2697}',   -- ⚗
		Color = Color3.fromRGB(190, 230, 200),
		Hint  = 'Grinds reagents fine enough for refined alchemy.',
	},
	SmokingRack = {
		Label = 'Smoking Rack',
		Icon  = '\u{2638}',   -- ☸ wheel-of-dharma stands in for smoke
		Color = Color3.fromRGB(165, 145, 130),
		Hint  = 'Cures meats and fish past raw cooking.',
	},
	GrindingWheel = {
		Label = 'Grinding Wheel',
		Icon  = '\u{2699}',   -- ⚙
		Color = Color3.fromRGB(180, 195, 215),
		Hint  = 'Sharpens & polishes. Smithy edge recipes need one nearby.',
	},
} :: { [string]: SubstationKindConfig }

-- Generic fallback for substation models whose `SubstationKind`
-- isn't registered above. Surface as "Workbench" with a neutral
-- glyph so the world still teaches the player a node exists, even
-- if the data hasn't been wired yet.
Module.Default = {
	Label = 'Substation',
	Icon  = '\u{25C6}',     -- ◆
	Color = Color3.fromRGB(200, 200, 220),
	Hint  = nil,
} :: SubstationKindConfig

-- Tag + attribute conventions, exported so server / client / waypoint
-- code reads the same constants. Edit here, not at the call sites.
Module.Tag = 'Substation'
Module.AttributeKind = 'SubstationKind'
Module.AttributeRadius = 'ProximityRadius'
Module.DefaultRadius = 8

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/DifficultyScaling"><![CDATA[-- Per-floor mob difficulty scaling. Single source of truth for how mob
-- HP and outbound damage scale as the player progresses through floors.
-- EnemyServer.InitializeMob reads this registry on every spawn and
-- applies the multipliers to the live Humanoid + a `DamageMul` model
-- attribute that the NPC swing path multiplies into outgoing damage.
--
-- Authoring conventions:
--   * Floors are integers (0-indexed). 0 is the starter floor; higher
--     floors crank up tougher mobs.
--   * HealthMul scales Humanoid.MaxHealth (and the new Health on spawn).
--   * DamageMul scales every NPCCombatServer / Boar-style outbound
--     damage hit. Player-side incoming-damage mitigation (Toughness,
--     defender passives) still applies after the scale, so a 2× damage
--     mob doesn't bypass the player's defenses.
--   * Multipliers default to 1.0 (no scaling) when a floor isn't listed.
--   * To opt a specific mob OUT of scaling, set
--     `Mobs.<mobId>.IgnoreDifficulty = true` on the mob config — useful
--     for invulnerable cinematic NPCs and dummy targets that shouldn't
--     change with floor.
--
-- Resolving the floor for a spawned mob:
--   1. Model attribute `Floor` on the mob model (set by mob spawners /
--      Studio placement) — explicit, wins over everything.
--   2. Floor inferred from the model's ancestor (any ancestor with a
--      `Floor` attribute is treated as the mob's floor).
--   3. Default floor 0 → Multiplier 1.0 baseline.

local Module = {}

----------------------------------------------------------------------
-- Per-floor curves. Health scales faster than damage so mobs feel
-- spongier the deeper a player descends, but a single Floor-1 hit
-- isn't an instant death from a Floor-50 mob (which would be
-- frustrating in the cross-floor lobby cases).
--
-- These are starting numbers — tune live by tweaking this table; no
-- runtime restart needed (registry is required once but the call site
-- reads it on each spawn).
----------------------------------------------------------------------
Module.PerFloor = {
	[0]   = { HealthMul = 1.00, DamageMul = 1.00 },
	[1]   = { HealthMul = 1.10, DamageMul = 1.05 },
	[2]   = { HealthMul = 1.25, DamageMul = 1.10 },
	[3]   = { HealthMul = 1.45, DamageMul = 1.18 },
	[4]   = { HealthMul = 1.70, DamageMul = 1.28 },
	[5]   = { HealthMul = 2.00, DamageMul = 1.40 },
	[10]  = { HealthMul = 3.50, DamageMul = 1.90 },
	[20]  = { HealthMul = 6.00, DamageMul = 2.60 },
	[50]  = { HealthMul = 14.0, DamageMul = 4.50 },
	[100] = { HealthMul = 30.0, DamageMul = 8.00 },
} :: { [number]: { HealthMul: number, DamageMul: number } }

----------------------------------------------------------------------
-- Resolver. Walks the configured floors in descending order and picks
-- the highest one ≤ floor — i.e. floor 7 with rows at 5 and 10 picks
-- 5's multipliers. This avoids the per-floor authoring grind: only
-- tune the breakpoints you care about.
----------------------------------------------------------------------
function Module.GetFloorMultipliers(floor: number): { HealthMul: number, DamageMul: number }
	if typeof(floor) ~= 'number' then
		return { HealthMul = 1.0, DamageMul = 1.0 }
	end
	-- Exact match first — cheaper than the descending walk for the
	-- common case of a configured floor.
	local exact = Module.PerFloor[floor]
	if exact then return exact end
	-- Find highest configured floor ≤ floor.
	local bestFloor: number? = nil
	for f in Module.PerFloor do
		if f <= floor and (bestFloor == nil or f > bestFloor) then
			bestFloor = f
		end
	end
	if bestFloor == nil then
		return { HealthMul = 1.0, DamageMul = 1.0 }
	end
	return Module.PerFloor[bestFloor]
end

----------------------------------------------------------------------
-- Floor lookup helper. Reads the mob model's `Floor` attribute, then
-- walks ancestors looking for the same attribute. Returns 0 (the
-- baseline / no-scaling floor) when no attribute is found anywhere
-- in the lineage. Server-only callers can pass any Instance.
----------------------------------------------------------------------
function Module.ResolveFloorForInstance(instance: Instance): number
	if not instance then return 0 end
	local cur: Instance? = instance
	while cur do
		local v = cur:GetAttribute('Floor')
		if typeof(v) == 'number' then return v end
		cur = cur.Parent
	end
	return 0
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/Difficulty"><![CDATA[-- Difficulty registry. Mirrors menu/src/.../Difficulty.luau with the same
-- ids, names, accent colors, blurbs, and human-readable effect lists so
-- the menu's selection screen and the in-game systems agree on the
-- canonical set. Server stores a per-save `Difficulty = 'normal' | 'hard'
-- | 'death'` (lowercase id) on PlayerData; runtime consumers look up
-- numeric multipliers via `Module.GetMultipliers(id)`.
--
-- Numeric multipliers (added here on top of the menu shape) are the
-- runtime hooks. Wired sites:
--   * HealthMul        → GameControllerServer.OnCharacterAdded
--   * IncomingDamageMul → DamageModule.DamageHumanoid (player victims)
--   * ExperienceMul    → DataEditServer.GiveExperienceToPlayer
-- Permadeath + auction / trading / party gates listed in `effects` are
-- intentionally NOT wired — those features aren't implemented yet, and
-- the field is kept for menu copy-and-paste so the eventual hook reads
-- the same config the menu surfaced.

local Module = {}

Module.Indexes = {
	Normal = 1,
	Hard   = 2,
	Death  = 3,
}

export type DifficultyMultipliers = {
	-- 1.0 = unchanged. Multiplied into Humanoid.MaxHealth at character spawn.
	HealthMul: number,
	-- 1.0 = unchanged. Multiplied into incoming damage AFTER passive
	-- mitigations so a player on HARD takes 10% more damage than NORMAL.
	IncomingDamageMul: number,
	-- 1.0 = unchanged. Multiplied into amount in
	-- DataEditServer.GiveExperienceToPlayer (after Insight bonus).
	ExperienceMul: number,
	-- Reserved — Luck system not yet implemented; field kept for the eventual
	-- LootTableServer hook so the config doesn't need a second pass later.
	LuckMul: number,
}

export type DifficultyConfig = {
	id: string,
	name: string,
	index: number,
	accent: Color3,
	blurb: string,
	effects: {string},
	Multipliers: DifficultyMultipliers,
}

Module.Configs = {
	[1] = {
		id = 'normal',
		name = 'Normal',
		index = 1,
		accent = Color3.fromRGB(126, 200, 255),
		blurb = 'Standard balance',
		effects = {
			'Standard',
		},
		Multipliers = {
			HealthMul = 1.0, IncomingDamageMul = 1.0,
			ExperienceMul = 1.0, LuckMul = 1.0,
		},
	},
	[2] = {
		id = 'hard',
		name = 'Hard',
		index = 2,
		accent = Color3.fromRGB(255, 183, 90),
		blurb = '+10% EXP · -10% Def / HP',
		effects = {
			'+10% Experience',
			'+10% Luck',
			'-10% Defense',
			'-10% Health',
			'No auction house',
			'No trading',
			'No partying with Normal players',
		},
		Multipliers = {
			HealthMul = 0.90, IncomingDamageMul = 1.10,
			ExperienceMul = 1.10, LuckMul = 1.10,
		},
	},
	[3] = {
		id = 'death',
		name = 'Death',
		index = 3,
		accent = Color3.fromRGB(255, 93, 109),
		blurb = 'Permadeath · +25% EXP · -25% All',
		effects = {
			'Permadeath',
			'+25% Experience',
			'+25% Luck',
			'-25% Defense',
			'-25% Health',
			'No auction house',
			'No trading',
			'No partying at all',
			'Solo dungeons',
		},
		Multipliers = {
			HealthMul = 0.75, IncomingDamageMul = 1.25,
			ExperienceMul = 1.25, LuckMul = 1.25,
		},
	},
} :: {[number]: DifficultyConfig}

----------------------------------------------------------------------
-- Lookups. By-id is the runtime workhorse — `data.Difficulty` is the
-- string id; consumers grab the config + multipliers off it.
----------------------------------------------------------------------
local IdToConfig: { [string]: DifficultyConfig } = {}
for _, cfg in Module.Configs do
	IdToConfig[cfg.id] = cfg
end

function Module.IsValidIndex(index: number?): boolean
	return typeof(index) == 'number' and Module.Configs[index] ~= nil
end

function Module.IsValidId(id: any): boolean
	return typeof(id) == 'string' and IdToConfig[id] ~= nil
end

function Module.GetConfigByIndex(index: number): DifficultyConfig?
	return Module.Configs[index]
end

function Module.GetConfigById(id: string): DifficultyConfig?
	return IdToConfig[id]
end

function Module.GetOrderedConfigs(): {DifficultyConfig}
	return { Module.Configs[1], Module.Configs[2], Module.Configs[3] }
end

-- Resolve multipliers for an id with a defensive fallback. Unknown /
-- missing ids resolve to NORMAL so a corrupt save can't accidentally
-- buff or nerf the player into oblivion.
local NORMAL_MULTIPLIERS: DifficultyMultipliers = Module.Configs[1].Multipliers
function Module.GetMultipliers(id: string?): DifficultyMultipliers
	if typeof(id) ~= 'string' then return NORMAL_MULTIPLIERS end
	local cfg = IdToConfig[id]
	if not cfg then return NORMAL_MULTIPLIERS end
	return cfg.Multipliers
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/Boosters"><![CDATA[-- Boosters registry. Timed (or permanent) buffs that layer multipliers
-- and additive bonuses across the game's economy / combat / movement
-- systems. Each booster declares one or more `Effects`; servers query
-- the active stack for a given Kind via BoostersServer.GetMultiplier
-- (for *_mul kinds) or .GetAddend (for *_add kinds).
--
-- Stacking semantics (per design call):
--   * Add-kinds (walk_speed_add, crit_chance_add) always sum.
--   * Mul-kinds split by Value:
--       Buffs (Value >= 1) → SUM of values, additively.
--                            One 2× XP = 2×. Two 2× = 4×. Four 2× = 8×.
--                            (Mixed: one 2× + one 3× = 5×.)
--       Nerfs (Value <  1) → PRODUCT of values.
--                            One 0.8× damage taken = 0.8×.
--                            Two 0.8× = 0.64× (correct reduction stacking).
-- Without the split, two 0.8× damage-reduction stacks would sum to
-- 1.6× and amplify damage instead of reducing it.

-- Local SetProperties — inlined rather than required from Utility.Table
-- because data modules are loaded as part of `Modules` registration, and
-- requiring the Modules tree from inside a Data module triggers a
-- recursive-require error. Items.luau follows the same pattern.
local function SetProperties<T>(parent: T, properties: {[string]: any}?): T
	if properties then
		for k, v in properties do
			(parent :: any)[k] = v
		end
	end
	return parent
end

export type BoosterEffectKind =
	  'experience_mul'
	| 'currency_mul'
	| 'loot_quantity_mul'
	| 'loot_rarity_bias'
	| 'damage_out_mul'
	| 'damage_in_mul'
	| 'walk_speed_add'
	| 'skill_cdr_mul'
	| 'crit_chance_add'
	| 'crit_damage_mul'
	| 'attribute_xp_mul'
	| 'companion_xp_mul'
	| 'reputation_mul'
	| 'bounty_decay_mul'

export type BoosterEffect = {
	Kind  : BoosterEffectKind,
	Value : number,
}

export type BoosterStacking =
	  'add'        -- per-design default: stacks add (see header)
	| 'replace'   -- only the highest-Value stack of this id wins
	| 'unique'    -- block re-application while one is active

export type BoosterSource = 'Reward' | 'Purchase' | 'Quest' | 'Admin' | 'Achievement'

export type BoosterDisplay = {
	Name        : string,
	Description : string,
	Icon        : (string | number)?,
	Color       : Color3?,
}

export type BoosterConfig = {
	Id        : string,
	Display   : BoosterDisplay,
	-- Seconds of effect duration. 0 → permanent (until manually removed).
	Duration  : number,
	Effects   : {BoosterEffect},
	Stacking  : BoosterStacking?,
	-- Per-id stack cap. Default 5 — generous enough that players can
	-- combine event boosters with reward boosters without hitting the
	-- ceiling, but bounded so a buggy grant loop can't run away.
	MaxStacks : number?,
	Source    : BoosterSource?,
}

local function BoosterData(properties): BoosterConfig
	return SetProperties({
		Id        = 'null',
		Display   = { Name = 'Null', Description = '', Color = Color3.new(1, 1, 1) },
		Duration  = 0,
		Effects   = {},
		Stacking  = 'add',
		MaxStacks = 5,
		Source    = 'Reward',
	}, properties)
end

local Module = {}

-- // Effect kind enum — string constants so call sites do
-- BoostersConfig.Kinds.ExperienceMul rather than typo-prone literals.
Module.Kinds = {
	ExperienceMul    = 'experience_mul',
	CurrencyMul      = 'currency_mul',
	LootQuantityMul  = 'loot_quantity_mul',
	LootRarityBias   = 'loot_rarity_bias',
	DamageOutMul     = 'damage_out_mul',
	DamageInMul      = 'damage_in_mul',
	WalkSpeedAdd     = 'walk_speed_add',
	SkillCdrMul      = 'skill_cdr_mul',
	CritChanceAdd    = 'crit_chance_add',
	CritDamageMul    = 'crit_damage_mul',
	AttributeXpMul   = 'attribute_xp_mul',
	CompanionXpMul   = 'companion_xp_mul',
	ReputationMul    = 'reputation_mul',
	BountyDecayMul   = 'bounty_decay_mul',
}

-- Classification helper: callers of GetMultiplier / GetAddend pick the
-- right query function based on whether the kind is mul-style or
-- add-style. Keeps the math in one place.
Module.AddKinds = {
	[Module.Kinds.WalkSpeedAdd]   = true,
	[Module.Kinds.CritChanceAdd]  = true,
}

function Module.IsAddKind(kind: BoosterEffectKind): boolean
	return Module.AddKinds[kind] == true
end

-- // Registry. // --
-- Sample boosters cover every supported Kind so QA can sanity-check
-- each plug-point without authoring a new config.
Module.Boosters = {
	xp_2x_30m = BoosterData({
		Id      = 'xp_2x_30m',
		Display = { Name = '2× Experience (30 min)',
		            Description = 'Doubles all experience gained for 30 minutes.',
		            Color = Color3.fromRGB(255, 198, 112) },
		Duration = 30 * 60,
		Effects  = { { Kind = Module.Kinds.ExperienceMul, Value = 2 } },
	}),
	gold_2x_30m = BoosterData({
		Id      = 'gold_2x_30m',
		Display = { Name = '2× Gold (30 min)',
		            Description = 'Doubles all currency gained for 30 minutes.',
		            Color = Color3.fromRGB(255, 215, 138) },
		Duration = 30 * 60,
		Effects  = { { Kind = Module.Kinds.CurrencyMul, Value = 2 } },
	}),
	loot_drop_15m = BoosterData({
		Id      = 'loot_drop_15m',
		Display = { Name = '+50% Loot Quantity (15 min)',
		            Description = 'Drops 50% more items from kills for 15 minutes.',
		            Color = Color3.fromRGB(126, 200, 255) },
		Duration = 15 * 60,
		Effects  = { { Kind = Module.Kinds.LootQuantityMul, Value = 1.5 } },
	}),
	rare_finder_30m = BoosterData({
		Id      = 'rare_finder_30m',
		Display = { Name = 'Rarefinder (30 min)',
		            Description = 'Biases loot rolls toward higher rarities.',
		            Color = Color3.fromRGB(200, 157, 255) },
		Duration = 30 * 60,
		Effects  = { { Kind = Module.Kinds.LootRarityBias, Value = 1.25 } },
	}),
	berserker_5m = BoosterData({
		Id      = 'berserker_5m',
		Display = { Name = "Berserker's Edge (5 min)",
		            Description = '+25% outgoing damage for 5 minutes.',
		            Color = Color3.fromRGB(255, 140, 120) },
		Duration = 5 * 60,
		Effects  = { { Kind = Module.Kinds.DamageOutMul, Value = 1.25 } },
	}),
	ironskin_5m = BoosterData({
		Id      = 'ironskin_5m',
		Display = { Name = 'Ironskin (5 min)',
		            Description = '−20% incoming damage for 5 minutes.',
		            Color = Color3.fromRGB(180, 200, 220) },
		Duration = 5 * 60,
		Effects  = { { Kind = Module.Kinds.DamageInMul, Value = 0.80 } },
	}),
	swiftfoot_10m = BoosterData({
		Id      = 'swiftfoot_10m',
		Display = { Name = 'Swiftfoot (10 min)',
		            Description = '+4 walk speed for 10 minutes.',
		            Color = Color3.fromRGB(140, 240, 200) },
		Duration = 10 * 60,
		Effects  = { { Kind = Module.Kinds.WalkSpeedAdd, Value = 4 } },
	}),
	cooldown_10m = BoosterData({
		Id      = 'cooldown_10m',
		Display = { Name = 'Quickwit (10 min)',
		            Description = '−15% skill cooldowns for 10 minutes.',
		            Color = Color3.fromRGB(160, 220, 255) },
		Duration = 10 * 60,
		Effects  = { { Kind = Module.Kinds.SkillCdrMul, Value = 0.85 } },
	}),
	crit_blessing_15m = BoosterData({
		Id      = 'crit_blessing_15m',
		Display = { Name = "Crit Blessing (15 min)",
		            Description = '+10% crit chance and +25% crit damage.',
		            Color = Color3.fromRGB(255, 175, 80) },
		Duration = 15 * 60,
		Effects  = {
			{ Kind = Module.Kinds.CritChanceAdd, Value = 0.10 },
			{ Kind = Module.Kinds.CritDamageMul, Value = 1.25 },
		},
	}),
	attr_xp_2x_30m = BoosterData({
		Id      = 'attr_xp_2x_30m',
		Display = { Name = '2× Attribute XP (30 min)',
		            Description = 'Doubles attribute XP for 30 minutes.',
		            Color = Color3.fromRGB(255, 220, 160) },
		Duration = 30 * 60,
		Effects  = { { Kind = Module.Kinds.AttributeXpMul, Value = 2 } },
	}),
	companion_xp_2x_30m = BoosterData({
		Id      = 'companion_xp_2x_30m',
		Display = { Name = '2× Companion XP (30 min)',
		            Description = 'Doubles companion XP for 30 minutes.',
		            Color = Color3.fromRGB(180, 255, 200) },
		Duration = 30 * 60,
		Effects  = { { Kind = Module.Kinds.CompanionXpMul, Value = 2 } },
	}),
	rep_2x_30m = BoosterData({
		Id      = 'rep_2x_30m',
		Display = { Name = '2× Reputation (30 min)',
		            Description = 'Doubles reputation gained for 30 minutes.',
		            Color = Color3.fromRGB(255, 230, 110) },
		Duration = 30 * 60,
		Effects  = { { Kind = Module.Kinds.ReputationMul, Value = 2 } },
	}),
	bounty_cooldown_10m = BoosterData({
		Id      = 'bounty_cooldown_10m',
		Display = { Name = 'Lay Low (10 min)',
		            Description = 'Bounty decays 50% faster for 10 minutes.',
		            Color = Color3.fromRGB(220, 180, 220) },
		Duration = 10 * 60,
		Effects  = { { Kind = Module.Kinds.BountyDecayMul, Value = 1.5 } },
	}),
} :: { [string]: BoosterConfig }

-- // Standard Boosters. // --
-- Generated grid of the three most common economy buffs at two
-- magnitudes (+10% / +25%) and three durations (1m / 5m / 10m).
-- Built from a spec list so the 18 entries stay consistent; each
-- inserted value is a full BoosterData({...}) matching BoosterConfig.
do
	local stdKinds = {
		{ slug = 'exp',     kind = Module.Kinds.ExperienceMul,  noun = 'Experience',   color = Color3.fromRGB(255, 198, 112) },
		{ slug = 'gold',    kind = Module.Kinds.CurrencyMul,    noun = 'Gold',         color = Color3.fromRGB(255, 215, 138) },
		{ slug = 'attrxp',  kind = Module.Kinds.AttributeXpMul, noun = 'Attribute XP', color = Color3.fromRGB(255, 220, 160) },
	}
	local stdMagnitudes = {
		{ pct = 10, value = 1.10 },
		{ pct = 25, value = 1.25 },
	}
	local stdDurations = {
		{ tag = '1m',  label = '1 min',  seconds = 60 },
		{ tag = '5m',  label = '5 min',  seconds = 300 },
		{ tag = '10m', label = '10 min', seconds = 600 },
	}

	for _, k in stdKinds do
		for _, mag in stdMagnitudes do
			for _, dur in stdDurations do
				local id = string.format('std_%s_%d_%s', k.slug, mag.pct, dur.tag)
				Module.Boosters[id] = BoosterData({
					Id      = id,
					Display = {
						Name        = string.format('+%d%% %s (%s)', mag.pct, k.noun, dur.label),
						Description = string.format('+%d%% %s gain for %s.', mag.pct, k.noun, dur.label),
						Color       = k.color,
					},
					Duration = dur.seconds,
					Effects  = { { Kind = k.kind, Value = mag.value } },
				})
			end
		end
	end
end

function Module.GetBoosterConfig(boosterId: string): BoosterConfig?
	return Module.Boosters[boosterId]
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/Achievements"><![CDATA[-- Achievements registry. Each entry is one of two shapes:
--
--   * Counter   — Goal + Trigger: server calls
--                 AchievementsServer.IncrementProgress(player, trigger, amount)
--                 from the gameplay event site (PvE kill, quest done, etc.)
--                 and any matching achievements have their `Progress` bumped;
--                 once Progress >= Goal, the achievement is marked Completed.
--
--   * Predicate — UnlockCheck(player, save) → boolean: AchievementsServer.RunUnlockPass
--                 walks every achievement and grants matches. Use this for
--                 conditions that can't be expressed as a counter (e.g. "have
--                 a level-50 character AND own a mount AND beat floor 5").
--
-- Rewards are NOT auto-granted on completion (per design choice). Player
-- must press Claim in the Achievements tab; AchievementsServer.ClaimRewards
-- is the server-authoritative mutation that awards the rewards and (if
-- BadgeId is set) the linked Roblox badge. BadgeService is rate-limited
-- and idempotent-unfriendly — wrap awards in pcall, gate on
-- UserHasBadgeAsync, and persist `BadgeAwarded = true` so we never retry
-- successfully-awarded badges.

-- Local SetProperties — inlined rather than required from Utility.Table
-- because data modules are loaded as part of `Modules` registration, and
-- requiring the Modules tree from inside a Data module triggers a
-- recursive-require error. Items.luau follows the same pattern.
local function SetProperties<T>(parent: T, properties: {[string]: any}?): T
	if properties then
		for k, v in properties do
			(parent :: any)[k] = v
		end
	end
	return parent
end

export type AchievementCategory =
	  'PVE'
	| 'PVP'
	| 'Progression'
	| 'Exploration'
	| 'Social'
	| 'Crafting'
	| 'Misc'

export type AchievementTier = 'Bronze' | 'Silver' | 'Gold' | 'Platinum'

export type AchievementDisplay = {
	Name        : string,
	Description : string,
	Icon        : (string | number)?,
	Color       : Color3?,
}

-- Reward bundle. Mirrors QuestsConfig.RewardsConfigTable so the Quests
-- and Achievements UIs can share the same reward-chip helpers if we
-- decide to factor them out later.
export type AchievementRewards = {
	Currency    : number?,
	Experience  : number?,
	Items       : {[string]: number}?,
	Titles      : {string}?,
	-- List of booster ids to grant. Optional Duration override per-entry
	-- if you want a 60-minute version of a 30-minute config without
	-- authoring a new BoosterConfig. Falls back to BoosterConfig.Duration.
	Boosters    : {{Id: string, Duration: number?}}?,
}

export type AchievementConfig = {
	Id            : string,
	Category      : AchievementCategory,
	Tier          : AchievementTier?,
	Display       : AchievementDisplay,

	-- Counter form: combine with Trigger.
	Goal          : number?,
	Trigger       : string?,

	-- Predicate form. `RunUnlockPass` runs this for every achievement
	-- on player join + after gameplay event hooks, and grants any that
	-- evaluate true. Mutually exclusive with Goal+Trigger (in practice
	-- — nothing prevents both, but only Goal+Trigger drives progress).
	UnlockCheck   : ((player: Player, saveData: any) -> boolean)?,

	-- Optional rewards (manual claim — not auto-granted on completion).
	Rewards       : AchievementRewards?,

	-- Hidden achievements don't appear in the UI list until completed.
	Hidden        : boolean?,

	-- Other achievement ids that must be Completed before this one is
	-- considered for progress / completion. Lets us model chains
	-- ("Slayer I → II → III") without re-declaring the count from zero.
	Prerequisites : {string}?,

	-- Roblox Badge link. If set, AchievementsServer.ClaimRewards calls
	-- BadgeService:UserHasBadgeAsync first and only AwardBadgeAsync's
	-- when the player doesn't already hold it. Saved BadgeAwarded flag
	-- persists across rejoins so a successful award is never retried.
	BadgeId       : number?,
}

local function AchievementData(properties): AchievementConfig
	return SetProperties({
		Id            = 'null',
		Category      = 'Misc',
		Display       = { Name = 'Null', Description = '', Color = Color3.new(1, 1, 1) },
		Goal          = nil,
		Trigger       = nil,
		UnlockCheck   = nil,
		Rewards       = nil,
		Hidden        = false,
		Prerequisites = nil,
		BadgeId       = nil,
	}, properties)
end

local Module = {}

----------------------------------------------------------------------
-- Trigger keys. Call sites use Module.Triggers.PvEKill rather than
-- the literal string so renames stay grep-able and typos break loudly.
----------------------------------------------------------------------
Module.Triggers = {
	PvEKill         = 'pve_kill',          -- arg: enemy killed (any NPC)
	PvEBossKill     = 'pve_boss_kill',     -- arg: boss subset of PvEKill
	PvPKill         = 'pvp_kill',          -- arg: another player killed
	PvPDeath        = 'pvp_death',         -- arg: died to another player
	LevelUp         = 'level_up',          -- arg: 1 per level gained
	QuestComplete   = 'quest_complete',    -- arg: 1 per quest completed
	WaystoneUnlock  = 'waystone_unlock',   -- arg: 1 per waystone
	DiscoveryFound  = 'discovery_found',   -- arg: 1 per discovery found
	ItemCrafted     = 'item_crafted',      -- arg: 1 per craft
	ItemEnchanted   = 'item_enchanted',    -- arg: 1 per enchant
	GemSocketed     = 'gem_socketed',      -- arg: 1 per gem socketed
	CurrencyEarned  = 'currency_earned',   -- arg: amount of currency earned
	DamageDealt     = 'damage_dealt',      -- arg: damage points dealt
	DamageTaken     = 'damage_taken',      -- arg: damage points taken
	FloorCleared    = 'floor_cleared',     -- arg: 1 per floor clear
	GuildJoined     = 'guild_joined',      -- arg: 1 (one-shot)
	PartyJoined     = 'party_joined',      -- arg: 1 per party join
}

----------------------------------------------------------------------
-- Achievement remote action discriminators. AchievementClaimEvent
-- carries Claim (C→S, AchievementsTab → AchievementsServer); the S→C
-- pushes (Completed / Progress / Claimed) ride AchievementEvent. Both
-- sides reference these constants so a rename is a single-site change
-- and a typo is a nil-index — not a silently dead branch.
----------------------------------------------------------------------
export type AchievementAction =
	  'Claim'
	| 'Completed'
	| 'Progress'
	| 'Claimed'

Module.Actions = {
	Claim     = 'Claim',     -- C→S: request reward grant for { Id }
	Completed = 'Completed', -- S→C: an achievement just completed ({ Id })
	Progress  = 'Progress',  -- S→C: incremental progress push
	Claimed   = 'Claimed',   -- S→C: reward grant confirmed ({ Id })
} :: { [string]: AchievementAction }

-- Helper: validate a trigger string against the registry. Server uses
-- this to refuse bad calls in dev (DefinitionWarnings).
function Module.IsValidTrigger(trigger: string): boolean
	for _, t in Module.Triggers do
		if t == trigger then return true end
	end
	return false
end

----------------------------------------------------------------------
-- Registry. Authoritative achievement set. Group additions by Category
-- so the file stays scannable as it grows.
----------------------------------------------------------------------
Module.Achievements = {

	-- // PVE //
	first_blood = AchievementData({
		Id = 'first_blood',
		Category = 'PVE',
		Tier = 'Bronze',
		Display = { Name = 'First Blood', Description = 'Defeat your first enemy.' },
		Goal = 1, Trigger = Module.Triggers.PvEKill,
		Rewards = { Currency = 50 },
	}),
	slayer_i = AchievementData({
		Id = 'slayer_i',
		Category = 'PVE',
		Tier = 'Bronze',
		Display = { Name = 'Slayer I', Description = 'Defeat 50 enemies.' },
		Goal = 50, Trigger = Module.Triggers.PvEKill,
		Rewards = { Currency = 250, Experience = 500 },
	}),
	slayer_ii = AchievementData({
		Id = 'slayer_ii',
		Category = 'PVE',
		Tier = 'Silver',
		Display = { Name = 'Slayer II', Description = 'Defeat 500 enemies.' },
		Goal = 500, Trigger = Module.Triggers.PvEKill,
		Prerequisites = { 'slayer_i' },
		Rewards = { Currency = 1500, Experience = 3000,
		            Boosters = { { Id = 'xp_2x_30m' } } },
	}),
	slayer_iii = AchievementData({
		Id = 'slayer_iii',
		Category = 'PVE',
		Tier = 'Gold',
		Display = { Name = 'Slayer III', Description = 'Defeat 5,000 enemies.' },
		Goal = 5000, Trigger = Module.Triggers.PvEKill,
		Prerequisites = { 'slayer_ii' },
		Rewards = { Currency = 10000, Titles = { 'slayer' } },
	}),
	boss_hunter = AchievementData({
		Id = 'boss_hunter',
		Category = 'PVE',
		Tier = 'Gold',
		Display = { Name = 'Boss Hunter', Description = 'Defeat 25 bosses.' },
		Goal = 25, Trigger = Module.Triggers.PvEBossKill,
		Rewards = { Currency = 5000, Experience = 10000 },
	}),

	-- // PVP //
	first_kill_pvp = AchievementData({
		Id = 'first_kill_pvp',
		Category = 'PVP',
		Tier = 'Bronze',
		Display = { Name = 'Drawn Steel', Description = 'Defeat another player in PvP.' },
		Goal = 1, Trigger = Module.Triggers.PvPKill,
		Rewards = { Currency = 250, Boosters = { { Id = 'berserker_5m' } } },
	}),
	duelist = AchievementData({
		Id = 'duelist',
		Category = 'PVP',
		Tier = 'Silver',
		Display = { Name = 'Duelist', Description = 'Defeat 25 players in PvP.' },
		Goal = 25, Trigger = Module.Triggers.PvPKill,
		Prerequisites = { 'first_kill_pvp' },
		Rewards = { Currency = 2500, Experience = 5000 },
	}),
	bladelord = AchievementData({
		Id = 'bladelord',
		Category = 'PVP',
		Tier = 'Gold',
		Display = { Name = 'Bladelord', Description = 'Defeat 250 players in PvP.' },
		Goal = 250, Trigger = Module.Triggers.PvPKill,
		Prerequisites = { 'duelist' },
		Rewards = { Currency = 15000, Titles = { 'bladelord' } },
	}),

	-- // PROGRESSION //
	level_10 = AchievementData({
		Id = 'level_10',
		Category = 'Progression',
		Tier = 'Bronze',
		Display = { Name = 'Adventurer', Description = 'Reach level 10.' },
		UnlockCheck = function(_, save) return (save.Level or 1) >= 10 end,
		Rewards = { Currency = 500, Boosters = { { Id = 'xp_2x_30m' } } },
	}),
	level_25 = AchievementData({
		Id = 'level_25',
		Category = 'Progression',
		Tier = 'Silver',
		Display = { Name = 'Veteran', Description = 'Reach level 25.' },
		UnlockCheck = function(_, save) return (save.Level or 1) >= 25 end,
		Rewards = { Currency = 2500, Experience = 5000 },
	}),
	level_max = AchievementData({
		Id = 'level_max',
		Category = 'Progression',
		Tier = 'Platinum',
		Display = { Name = 'Bladeborne', Description = 'Reach the level cap.' },
		UnlockCheck = function(_, save)
			-- Cheap cap import would create a require cycle; reading the
			-- save's Level against a hard 50 (current MaxLevel) is fine
			-- here — bump if the cap moves.
			return (save.Level or 1) >= 50
		end,
		Rewards = { Currency = 25000, Titles = { 'bladeborne' } },
	}),
	rich_i = AchievementData({
		Id = 'rich_i',
		Category = 'Progression',
		Tier = 'Bronze',
		Display = { Name = 'Coin Purse', Description = 'Earn 10,000 currency total.' },
		Goal = 10000, Trigger = Module.Triggers.CurrencyEarned,
		Rewards = { Currency = 1000 },
	}),

	-- // EXPLORATION //
	first_waystone = AchievementData({
		Id = 'first_waystone',
		Category = 'Exploration',
		Tier = 'Bronze',
		Display = { Name = 'Far Traveler', Description = 'Unlock your first waystone.' },
		Goal = 1, Trigger = Module.Triggers.WaystoneUnlock,
		Rewards = { Currency = 100 },
	}),
	cartographer = AchievementData({
		Id = 'cartographer',
		Category = 'Exploration',
		Tier = 'Silver',
		Display = { Name = 'Cartographer', Description = 'Unlock 10 waystones.' },
		Goal = 10, Trigger = Module.Triggers.WaystoneUnlock,
		Rewards = { Currency = 1000, Boosters = { { Id = 'rare_finder_30m' } } },
	}),
	pathfinder = AchievementData({
		Id = 'pathfinder',
		Category = 'Exploration',
		Tier = 'Gold',
		Display = { Name = 'Pathfinder', Description = 'Find 25 hidden discoveries.' },
		Goal = 25, Trigger = Module.Triggers.DiscoveryFound,
		Rewards = { Currency = 5000, Titles = { 'pathfinder' } },
	}),

	-- // CRAFTING //
	smith_i = AchievementData({
		Id = 'smith_i',
		Category = 'Crafting',
		Tier = 'Bronze',
		Display = { Name = "Smith's Apprentice", Description = 'Craft 10 items.' },
		Goal = 10, Trigger = Module.Triggers.ItemCrafted,
		Rewards = { Currency = 250 },
	}),
	enchanter = AchievementData({
		Id = 'enchanter',
		Category = 'Crafting',
		Tier = 'Silver',
		Display = { Name = 'Enchanter', Description = 'Apply 25 enchantments.' },
		Goal = 25, Trigger = Module.Triggers.ItemEnchanted,
		Rewards = { Currency = 2000 },
	}),

	-- // SOCIAL //
	guild_joined = AchievementData({
		Id = 'guild_joined',
		Category = 'Social',
		Tier = 'Bronze',
		Display = { Name = 'Brothers in Arms', Description = 'Join a guild.' },
		Goal = 1, Trigger = Module.Triggers.GuildJoined,
		Rewards = { Currency = 250 },
	}),

	-- // MISC (hidden / ToS / dev). //
	founder = AchievementData({
		Id = 'founder',
		Category = 'Misc',
		Tier = 'Platinum',
		Display = { Name = 'Founder',
		            Description = 'Played during the alpha period.' },
		Hidden = false,
		UnlockCheck = function(_, _) return true end,
		Rewards = { Titles = { 'alpha_tester' } },
	}),

} :: { [string]: AchievementConfig }

function Module.GetAchievementConfig(id: string): AchievementConfig?
	return Module.Achievements[id]
end

-- All achievements grouped by category. Cached on first call so the UI
-- can iterate stably (Lua pairs ordering is undefined but consistent
-- per-process, which is good enough for sectioned listing).
local CATEGORY_CACHE: {[AchievementCategory]: {AchievementConfig}}? = nil
function Module.GetAchievementsByCategory(): {[AchievementCategory]: {AchievementConfig}}
	if CATEGORY_CACHE then return CATEGORY_CACHE end
	local out: {[AchievementCategory]: {AchievementConfig}} = {}
	for _, cfg in Module.Achievements do
		out[cfg.Category] = out[cfg.Category] or {}
		table.insert(out[cfg.Category], cfg)
	end
	CATEGORY_CACHE = out
	return out
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/LevelGates"><![CDATA[-- LevelGates — single source of truth for per-system minimum-level gates.
--
-- Five gated systems, in escalating order of complexity:
--   * Skills   → level 5    (cast skills from the hotbar / skill tree)
--   * Crafting → level 7    (CraftingServer.AttemptCraft)
--   * Forge    → level 10   (ForgeWidget + ForgeServer.AttemptForgeWeapon)
--   * Gems     → level 15   (GemSocketWidget + GemSocketServer)
--   * Enchant  → level 20   (EnchantingWidget + EnchantServer)
--
-- Both sides (client UI gate + server use-validation) read this module
-- so a level requirement is one-line authored. The server is
-- authoritative — clients can only suppress UI; the server check is
-- what actually refuses the action.
--
-- Two bypass mechanisms, ORed inside CanUseSystem:
--   * Per-player flag `saveData.Flags.LevelGateBypass` (boolean,
--     default false). Persists on the save. Cmdr `SetLevelGateBypass
--     <player> <bool>`. Replicated through the standard PlayerData
--     path so the client honors it the same frame.
--   * Server-wide global flag — owned by `LevelGatesServer.GlobalBypass`,
--     in-memory only (resets on server start). Cmdr
--     `SetGlobalLevelGateBypass <bool>`. Replicated to clients via the
--     public 'ServerFlags' category. Callers pass it as the optional
--     `globalBypass` arg to CanUseSystem; this shared module is
--     intentionally context-free and doesn't require either client or
--     server state directly.

local Module = {}

----------------------------------------------------------------------
-- System enum. String constants so call sites read clearly:
--   LevelGates.Systems.Forge instead of literals like 'forge'.
----------------------------------------------------------------------
Module.Systems = {
	Skills   = 'skills',
	Crafting = 'crafting',
	Forge    = 'forge',
	Gems     = 'gems',
	Enchant  = 'enchant',
}

----------------------------------------------------------------------
-- Required level per system. Treated as `>=` — at the gate level
-- the action is allowed. Edit here to retune progression pacing.
----------------------------------------------------------------------
Module.RequiredLevels = {
	[Module.Systems.Skills]   = 5,
	[Module.Systems.Crafting] = 7,
	[Module.Systems.Forge]    = 10,
	[Module.Systems.Gems]     = 15,
	[Module.Systems.Enchant]  = 20,
}

----------------------------------------------------------------------
-- Player-facing display labels. Used by the level-lock overlay and
-- the toast surfaced when server-side gates refuse an action.
----------------------------------------------------------------------
Module.DisplayLabels = {
	[Module.Systems.Skills]   = 'Skills',
	[Module.Systems.Crafting] = 'Crafting',
	[Module.Systems.Forge]    = 'Forge',
	[Module.Systems.Gems]     = 'Gem Socketing',
	[Module.Systems.Enchant]  = 'Enchanting',
}

----------------------------------------------------------------------
-- Pure predicates.
----------------------------------------------------------------------
function Module.GetRequiredLevel(systemId: string): number
	return Module.RequiredLevels[systemId] or 1
end

function Module.GetDisplayLabel(systemId: string): string
	return Module.DisplayLabels[systemId] or systemId
end

-- Read the per-save bypass for `systemId`. Honors three shapes the
-- LevelGateBypass field can take, in order of preference:
--   * Table (current) — `{ all = bool, [systemId] = bool, ... }`. Either
--     the master `all` or the system-specific key being true grants bypass.
--   * Boolean (legacy) — `true` treated as `all = true` so old admin
--     writes still take effect until upgraded.
--   * Anything else / nil — treated as no bypass.
--
-- Top-level `saveData.LevelGateBypass` (older-still legacy from before
-- the Flags sub-table) is intentionally NOT read — a wiped admin grant
-- in that location must not silently re-grant after a structural
-- migration; this is the safe failure mode.
function Module.IsBypassed(saveData: any, systemId: string?): boolean
	if typeof(saveData) ~= 'table' then return false end
	local flags = saveData.Flags
	if typeof(flags) ~= 'table' then return false end
	local bypass = flags.LevelGateBypass
	if typeof(bypass) == 'boolean' then return bypass end  -- legacy
	if typeof(bypass) ~= 'table' then return false end
	if bypass.all == true then return true end
	if systemId ~= nil and bypass[systemId] == true then return true end
	return false
end

-- Predicate: is the global-bypass payload either the master `all`
-- flag or the system-specific key set? Accepts:
--   * Boolean — legacy "all" master.
--   * Table   — `{ all = bool, [systemId] = bool, ... }`.
--   * nil / anything else — no bypass.
function Module.IsGlobalBypassed(globalBypass: any, systemId: string?): boolean
	if typeof(globalBypass) == 'boolean' then return globalBypass end
	if typeof(globalBypass) ~= 'table' then return false end
	if globalBypass.all == true then return true end
	if systemId ~= nil and globalBypass[systemId] == true then return true end
	return false
end

-- Authoritative gate check. Returns (allowed, reason).
--   * allowed = true and reason = '' on pass.
--   * allowed = false and reason = 'level_locked' otherwise.
--
-- Three escape hatches, ANY one of which grants access:
--   1. Per-player save flag (saveData.Flags.LevelGateBypass) — set via
--      Cmdr SetLevelGateBypass <player> <system> <bool>. Per-system
--      keys + an `all` master.
--   2. Server-wide global bypass (caller-supplied `globalBypass`) —
--      passed by the server as LevelGatesServer.GetGlobalBypass(), by
--      the client as LevelGatesClient.GetGlobalBypass(). Same shape
--      as the per-player table; same `all`+per-system semantics.
--      Boolean form still accepted as a legacy "all" master.
--   3. Player level >= system's required level.
--
-- `globalBypass` is optional; nil treated as "not globally bypassed".
function Module.CanUseSystem(saveData: any, systemId: string, globalBypass: any?): (boolean, string)
	if Module.IsGlobalBypassed(globalBypass, systemId) then return true, '' end
	if Module.IsBypassed(saveData, systemId) then return true, '' end
	local required = Module.GetRequiredLevel(systemId)
	local current = (typeof(saveData) == 'table' and tonumber(saveData.Level)) or 1
	if current >= required then return true, '' end
	return false, 'level_locked'
end

-- Pre-formatted "Requires level N (System)" string for toasts/UI.
function Module.FormatGateMessage(systemId: string): string
	return string.format('Requires level %d to use %s.',
		Module.GetRequiredLevel(systemId),
		Module.GetDisplayLabel(systemId))
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/CombatSkills"><![CDATA[-- CombatSkills — runtime recipe registry. Each entry is a
-- SkillRecipe consumed by SkillRuntimeServer.RunRecipe. Bosses /
-- mobs / player skills all reference recipes by Id, so a new attack
-- pattern is data-only — no server code changes unless it needs a
-- step kind that doesn't exist yet.
--
-- This file holds RUNTIME recipes (the actual "what happens when this
-- skill activates"). Player-skill UNLOCK metadata stays in
-- Data/Skills.luau; that side of the schema reads `RecipeId` to bind
-- a tree node to a recipe here. One recipe can be reused across
-- multiple unlock-skill entries (e.g. a "basic strike" recipe shared
-- by every weapon's first slot).

local Module = {}

-- // Recipe seed — one entry per step kind so each branch in the
-- // executor has a working example to cross-reference. Real recipes
-- // accumulate here as systems migrate (Boar dash, player skills,
-- // boss attack patterns).
Module.Recipes = {

	-- A standard melee swing — the runtime equivalent of the inline
	-- Generic.AttackNearbyTarget code. Used by basic mobs.
	melee_swing = {
		Id = 'melee_swing',
		Name = 'Melee Swing',
		TargetMode = 'hostiles',
		Steps = {
			{
				Kind = 'telegraph_hit',
				Telegraph = { Kind = 'Circle', Radius = 7 },
				Windup = 0.35,
				Damage = 12,
				Recovery = 0.3,
			},
		},
	},

	-- "Attack around" — heavy ground slam dealing damage in a 360°
	-- ring around the caster. Single circle telegraph, larger radius,
	-- longer windup so players can get out.
	ground_slam = {
		Id = 'ground_slam',
		Name = 'Ground Slam',
		TargetMode = 'hostiles',
		Steps = {
			{
				Kind = 'telegraph_hit',
				Telegraph = { Kind = 'Circle', Radius = 12 },
				Windup = 0.9,
				Damage = 22,
				Status = { Id = 'paralysed', Duration = 0.6 },
				Recovery = 0.7,
			},
		},
	},

	-- "Attacks at positions" — three slams at fixed offsets (left /
	-- right / center). Demonstrates PositionalHits with shared windup.
	tri_pillar = {
		Id = 'tri_pillar',
		Name = 'Triple Pillar',
		TargetMode = 'hostiles',
		Steps = {
			{
				Kind = 'positional_hits',
				Telegraph = { Kind = 'Circle', Radius = 4 },
				Offsets = {
					Vector3.new(-7, 0, 6),
					Vector3.new( 0, 0, 9),
					Vector3.new( 7, 0, 6),
				},
				Windup = 0.7,
				Damage = 16,
				Recovery = 0.5,
			},
		},
	},

	-- "Wave attack" — sweeping line in front of the caster that
	-- travels forward over TravelTime. Two-phase: telegraph the path,
	-- then resolve sub-hits as the wave moves through it.
	frost_wave = {
		Id = 'frost_wave',
		Name = 'Frost Wave',
		TargetMode = 'hostiles',
		Steps = {
			{
				Kind = 'wave',
				Width = 8,
				Length = 4,
				TravelDistance = 28,
				TravelTime = 0.8,
				Damage = 14,
				Status = { Id = 'chilled', Duration = 3 },
				Recovery = 0.5,
			},
		},
	},

	-- Status-only zone — ground frost that slows for a few seconds.
	-- No damage; uses StatusZone so the damage indicator path is
	-- skipped and the visual reads as "field," not "hit."
	chill_field = {
		Id = 'chill_field',
		Name = 'Chill Field',
		TargetMode = 'hostiles',
		Steps = {
			{
				Kind = 'status_zone',
				Telegraph = { Kind = 'Circle', Radius = 10 },
				Windup = 0.5,
				Status = { Id = 'chilled', Duration = 4, Potency = 0.4 },
				Recovery = 0.4,
			},
		},
	},

	-- Compound recipe: VFX cue → wait → cleave → wait → ground slam.
	-- Demonstrates step ordering for a multi-beat pattern.
	cleave_then_slam = {
		Id = 'cleave_then_slam',
		Name = 'Cleave then Slam',
		TargetMode = 'hostiles',
		Steps = {
			{ Kind = 'vfx', Cue = 'cleave_charge_glow', Duration = 0.3 },
			{ Kind = 'telegraph_hit',
			  Telegraph = { Kind = 'Cone', Radius = 14, Angle = math.pi * 0.4 },
			  Windup = 0.5, Damage = 18, Recovery = 0.2 },
			{ Kind = 'wait', Seconds = 0.25 },
			{ Kind = 'telegraph_hit',
			  Telegraph = { Kind = 'Circle', Radius = 9 },
			  Windup = 0.7, Damage = 24, Recovery = 0.6 },
		},
	},

	-- // BossBoar recipes // --

	-- Phase 1: charge — long forward rect, telegraphed for almost a
	-- full second, deals heavy damage. Slow + readable.
	boss_boar_charge = {
		Id = 'boss_boar_charge',
		Name = 'Boar Charge',
		TargetMode = 'hostiles',
		Steps = {
			{ Kind = 'animation', AnimationId = 'ChargeRun' },
			{ Kind = 'telegraph_hit',
			  Telegraph = { Kind = 'Rect', Size = Vector3.new(8, 0, 32) },
			  Windup = 0.9, Damage = 28, Recovery = 0.8 },
		},
	},

	-- Phase 2: stomp — close-range AOE around the boar with a small
	-- paralysis on hit. Forces players to back off.
	boss_boar_stomp = {
		Id = 'boss_boar_stomp',
		Name = 'Boar Stomp',
		TargetMode = 'hostiles',
		Steps = {
			{ Kind = 'telegraph_hit',
			  Telegraph = { Kind = 'Circle', Radius = 14 },
			  Windup = 0.7, Damage = 22,
			  Status = { Id = 'paralysed', Duration = 0.4 },
			  Recovery = 0.6 },
		},
	},

	-- Phase 3: squeal — three-pillar burst at offset positions.
	-- Tests positional_hits with synchronized windup; players have to
	-- pick a safe gap and dodge into it.
	boss_boar_squeal = {
		Id = 'boss_boar_squeal',
		Name = 'Boar Squeal',
		TargetMode = 'hostiles',
		Steps = {
			{ Kind = 'vfx', Cue = 'cleave_charge_glow', Duration = 0.4 },
			{ Kind = 'positional_hits',
			  Telegraph = { Kind = 'Circle', Radius = 6 },
			  Offsets = {
			      Vector3.new(-10, 0,  10),
			      Vector3.new( 10, 0,  10),
			      Vector3.new(  0, 0,  18),
			  },
			  Windup = 0.9, Damage = 18, Recovery = 0.6 },
		},
	},

	-- Stampede — the boar's signature ground-smash. Wide circular AOE
	-- with the `stampede_smash` particle cue (dust ring + ground
	-- shake) firing on contact. Heavy windup so it telegraphs clearly,
	-- and the recovery is long enough that a kited boar pays for
	-- mis-timing the stamp. Damage is the highest of the boar's
	-- single-hit attacks — landing this should hurt.
	boss_boar_stampede = {
		Id = 'boss_boar_stampede',
		Name = 'Stampede',
		TargetMode = 'hostiles',
		Steps = {
			-- Tell — paw at the ground, kicks up a small puff. Gives
			-- the player ~0.35 s of "something's coming" before the
			-- big telegraph rectangle appears.
			{ Kind = 'vfx', Cue = 'stampede_smash_tell', Duration = 0.35 },
			{ Kind = 'wait', Seconds = 0.25 },

			-- The smash itself. Circle telegraph, big radius, paired
			-- with the visual dust-ring burst at impact (cue fires in
			-- parallel; the telegraph_hit step yields on its own
			-- windup so the cue lands roughly at the same instant
			-- the bar hits 100%).
			{ Kind = 'vfx', Cue = 'stampede_smash', Duration = 0.6 },
			{ Kind = 'telegraph_hit',
			  Telegraph = { Kind = 'Circle', Radius = 16 },
			  Windup = 0.9, Damage = 32,
			  Status = { Id = 'paralysed', Duration = 0.5 },
			  Recovery = 0.9 },
		},
	},

	-- Gore — close-range tusk swipe. Cone, short windup, lower damage
	-- than the stomp/stampede but cheap to throw out so the boar can
	-- punish a player who tries to hug it. Pool entry is range-gated
	-- (MaxRange ≈ tusk reach) so it only triggers when the player is
	-- already in tusk range.
	boss_boar_gore = {
		Id = 'boss_boar_gore',
		Name = 'Gore',
		TargetMode = 'hostiles',
		Steps = {
			{ Kind = 'telegraph_hit',
			  Telegraph = { Kind = 'Cone', Radius = 10 },
			  Windup = 0.30, Damage = 16, Recovery = 0.35 },
		},
	},

	-- Double-tap — two quick stomps in succession. Tests the player's
	-- patience to dodge twice; the first stomp pushes them out of
	-- melee range and the second catches the dodge-back. Damage is
	-- per-hit, so eating both is punishing.
	boss_boar_double_tap = {
		Id = 'boss_boar_double_tap',
		Name = 'Double Tap',
		TargetMode = 'hostiles',
		Steps = {
			{ Kind = 'telegraph_hit',
			  Telegraph = { Kind = 'Circle', Radius = 11 },
			  Windup = 0.45, Damage = 14, Recovery = 0.15 },
			{ Kind = 'telegraph_hit',
			  Telegraph = { Kind = 'Circle', Radius = 11 },
			  Windup = 0.40, Damage = 16, Recovery = 0.45 },
		},
	},

	-- Paw-the-ground — non-damaging windup tell. Used as a phase-3
	-- "berserk roar" enter recipe. The tell cue + a brief wait is
	-- intentionally pure flavor; lets the player register that the
	-- boar's escalating before the next attack lands.
	boss_boar_paw_tell = {
		Id = 'boss_boar_paw_tell',
		Name = 'Paw Ground',
		TargetMode = 'self',
		Steps = {
			{ Kind = 'vfx', Cue = 'stampede_smash_tell', Duration = 0.5 },
			{ Kind = 'wait', Seconds = 0.45 },
		},
	},

	-- Boss intro — short label + camera ping. Plays once when the
	-- boss spawns / the player approaches.
	boss_boar_intro = {
		Id = 'boss_boar_intro',
		Name = 'Boss Boar Intro',
		TargetMode = 'self',
		Steps = {
			{ Kind = 'vfx', Cue = 'cleave_charge_glow', Duration = 1.0 },
			{ Kind = 'wait', Seconds = 1.0 },
		},
	},

	-- Boss death — burst + brief slow-mo (slot for cinematic cue).
	boss_boar_death = {
		Id = 'boss_boar_death',
		Name = 'Boss Boar Death',
		TargetMode = 'self',
		Steps = {
			{ Kind = 'vfx', Cue = 'cleave_charge_glow', Duration = 1.5 },
		},
	},

	-- Phase 2 enter — quick burst when the boss crosses the 2/3 HP gate.
	boss_boar_phase2_enter = {
		Id = 'boss_boar_phase2_enter',
		Name = 'BossBoar P2 Enter',
		TargetMode = 'self',
		Steps = {
			{ Kind = 'vfx', Cue = 'cleave_charge_glow', Duration = 0.5 },
			{ Kind = 'wait', Seconds = 0.5 },
		},
	},

	-- Phase 3 enter — same primitive at higher intensity.
	boss_boar_phase3_enter = {
		Id = 'boss_boar_phase3_enter',
		Name = 'BossBoar P3 Enter',
		TargetMode = 'self',
		Steps = {
			{ Kind = 'vfx', Cue = 'cleave_charge_glow', Duration = 0.7 },
			{ Kind = 'wait', Seconds = 0.7 },
		},
	},
} :: { [string]: any }

function Module.GetRecipe(id: string)
	return Module.Recipes[id]
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/LeaderboardConfig"><![CDATA[-- LeaderboardConfig — per-category leaderboard authoring. Each
-- category has:
--   * Id        — stable identifier (used as ReplicatedData sub-key
--                 + DataStore key suffix). Never rename.
--   * Label     — display string.
--   * StoreKey  — OrderedDataStore name (typically 'LB_' + Id). Studio
--                 suffix appended at runtime so test data stays out of
--                 prod boards.
--   * Extract   — function(saveData) -> number. Pulls the score for
--                 this category out of saveData. Sum-style stats
--                 (e.g. total bosses defeated) live in saveData.Statistics
--                 as Map values; the extractor sums them. Non-stat
--                 fields (like character Level) read directly from
--                 saveData.
--
-- Reference design (modeled on a Knit/Replica-based service):
--   * Commit window: every CycleSec, walk every on-server player and
--     SetAsync their current value into each category store. Writes
--     are spread over CommitWindowSec to stay inside Roblox's per-
--     minute SetAsync budget.
--   * Pull: GetSortedAsync(top MaxEntries) for each category and
--     publish into a public 'Leaderboard' ReplicatedData category.
--   * Studio segmentation via STORE_SUFFIX so test data never bleeds
--     into the live boards.

-- Sibling-relative require: data modules are loaded as part of
-- `Modules` registration, and requiring the Modules tree from inside
-- a Data module triggers a recursive-require error. Reach into the
-- StatisticsConfig sibling directly. Same pattern Items.luau /
-- Boosters.luau / Achievements.luau use.
local StatisticsConfig = require(script.Parent:WaitForChild('StatisticsConfig'))

local Module = {}

----------------------------------------------------------------------
-- Constants. Tuned for a typical session — a 300s cycle (5 min) gives
-- enough room for the commit window + leaves the second half of the
-- cycle for the OrderedDataStore reads + Replica publish without the
-- write/read budgets stomping on each other.
----------------------------------------------------------------------
Module.CycleSec        = 300
Module.CommitWindowSec = 120
Module.MaxEntries      = 25

-- Public ReplicatedData category. Server publishes the merged board
-- snapshot; clients read non-yielding via LeaderboardClient.
Module.PublicCategory  = 'Leaderboard'

----------------------------------------------------------------------
-- Helpers — sum every value in a Statistics Map, or default to 0 when
-- the entry is missing or wrong-shaped.
----------------------------------------------------------------------
local function statValue(saveData: any, statId: number): number
	if typeof(saveData) ~= 'table' then return 0 end
	if typeof(saveData.Statistics) ~= 'table' then return 0 end
	local v = saveData.Statistics[tostring(statId)]
	return tonumber(v) or 0
end

local function statMapSum(saveData: any, statId: number): number
	if typeof(saveData) ~= 'table' then return 0 end
	if typeof(saveData.Statistics) ~= 'table' then return 0 end
	local m = saveData.Statistics[tostring(statId)]
	if typeof(m) ~= 'table' then return 0 end
	local total = 0
	for _, v in m do
		total += tonumber(v) or 0
	end
	return total
end

local IDS = StatisticsConfig.StatisticIds

----------------------------------------------------------------------
-- Category registry. Display order = array order. Adding a new
-- category here AND deploying once is enough — the server module's
-- store-acquisition pass picks them up on boot.
----------------------------------------------------------------------
-- PartName drives the in-world SurfaceGui binding: the
-- LeaderboardSurfaceClient looks up tagged ('Leaderboards') BaseParts /
-- Models by their .Name and matches it against this field. Kept
-- distinct from `Id` so designers can name a tagged model for clarity
-- ('TotalDamageBoard') without colliding with the shorter replica id.
--
-- Format hint for the UI:
--   * 'integer'  — comma-grouped count (default).
--   * 'duration' — H:MM (PlayTime + similar).
--   * 'gold'     — 'G' suffix (for currency-flavored counters).
Module.Categories = {
	{
		Id       = 'TotalDamage',
		Label    = 'Total Damage Dealt',
		StoreKey = 'LB_TotalDamage',
		PartName = 'TotalDamageBoard',
		Format   = 'integer',
		Extract  = function(saveData) return statValue(saveData, IDS.DamageDealtTotal) end,
	},
	{
		Id       = 'PvPDamage',
		Label    = 'PvP Damage Dealt',
		StoreKey = 'LB_PvPDamage',
		PartName = 'PvPDamageBoard',
		Format   = 'integer',
		Extract  = function(saveData) return statValue(saveData, IDS.DamageDealtPvP) end,
	},
	{
		Id       = 'PvEDamage',
		Label    = 'PvE Damage Dealt',
		StoreKey = 'LB_PvEDamage',
		PartName = 'PvEDamageBoard',
		Format   = 'integer',
		Extract  = function(saveData) return statValue(saveData, IDS.DamageDealtPvE) end,
	},
	{
		Id       = 'HighestLevel',
		Label    = 'Highest Level',
		StoreKey = 'LB_HighestLevel',
		PartName = 'HighestLevelBoard',
		Format   = 'integer',
		Extract  = function(saveData)
			-- Save struct's Level field is the source of truth. Newer
			-- saves keep it nil-safe.
			if typeof(saveData) ~= 'table' then return 0 end
			return tonumber(saveData.Level) or 1
		end,
	},
	{
		Id       = 'LevelExperience',
		Label    = 'Level XP Earned',
		StoreKey = 'LB_LevelExperience',
		PartName = 'LevelExperienceBoard',
		Format   = 'integer',
		Extract  = function(saveData) return statValue(saveData, IDS.LevelExperienceTotal) end,
	},
	{
		Id       = 'BossesDefeated',
		Label    = 'Bosses Defeated',
		StoreKey = 'LB_BossesDefeated',
		PartName = 'BossesDefeatedBoard',
		Format   = 'integer',
		Extract  = function(saveData) return statMapSum(saveData, IDS.BossesDefeated) end,
	},
	{
		Id       = 'QuestsCompleted',
		Label    = 'Quests Completed',
		StoreKey = 'LB_QuestsCompleted',
		PartName = 'QuestsCompletedBoard',
		Format   = 'integer',
		Extract  = function(saveData) return statValue(saveData, IDS.QuestsCompleted) end,
	},
	{
		Id       = 'GoldEarned',
		Label    = 'Gold Earned',
		StoreKey = 'LB_GoldEarned',
		PartName = 'GoldEarnedBoard',
		Format   = 'gold',
		Extract  = function(saveData) return statValue(saveData, IDS.GoldEarned) end,
	},
	{
		Id       = 'PlayTime',
		Label    = 'Total Play Time',
		StoreKey = 'LB_PlayTime',
		PartName = 'PlayTimeBoard',
		Format   = 'duration',
		Extract  = function(saveData) return statValue(saveData, IDS.PlayTimeTotal) end,
	},
	{
		Id       = 'KillStreak',
		Label    = 'Best Kill Streak',
		StoreKey = 'LB_KillStreak',
		PartName = 'KillStreakBoard',
		Format   = 'integer',
		Extract  = function(saveData) return statValue(saveData, IDS.KillStreakRecord) end,
	},
	{
		Id       = 'HighestHit',
		Label    = 'Highest Single Hit',
		StoreKey = 'LB_HighestHit',
		PartName = 'HighestHitBoard',
		Format   = 'integer',
		Extract  = function(saveData) return statValue(saveData, IDS.HighestSingleHit) end,
	},
	{
		Id       = 'ItemsCrafted',
		Label    = 'Items Crafted',
		StoreKey = 'LB_ItemsCrafted',
		PartName = 'ItemsCraftedBoard',
		Format   = 'integer',
		Extract  = function(saveData) return statMapSum(saveData, IDS.ItemsCrafted) end,
	},
}

-- Look up by PartName (used by LeaderboardSurfaceClient). Tiny linear
-- scan; simpler than maintaining a side map. Matches:
--   1. Exact PartName (e.g. 'TotalDamageBoard').
--   2. Bare Id (e.g. 'TotalDamage') — designers commonly name parts
--      after the id directly without the 'Board' suffix.
--   3. Bare Id with 'Board' suffix stripped (in case PartName includes it).
-- Order matters: PartName wins over Id so a category that has both
-- patterns assigned can disambiguate.
function Module.GetCategoryByPartName(name: string)
	for _, def in Module.Categories do
		if def.PartName == name then return def end
	end
	for _, def in Module.Categories do
		if def.Id == name then return def end
	end
	return nil
end

function Module.GetCategory(id: string)
	for _, cat in Module.Categories do
		if cat.Id == id then return cat end
	end
	return nil
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/StatisticsConfig"><![CDATA[-- StatisticsConfig — single source of truth for the per-player game-
-- statistics catalog. Numeric ids are stable across versions; the
-- Info table maps each id to display metadata + storage kind.
--
-- Save shape: data.Statistics is a sparse map keyed by the STRINGIFIED
-- id (so JSON serialization is deterministic). Each value is one of:
--   * number  — Counter / Record / Timestamp.
--   * { [string] = number } — Map (per-key counter; e.g. per-boss kills,
--     per-item crafted, per-zone visit count).
-- Stats with no observations stay absent — the StatisticsServer's
-- read path treats missing as 0 / empty map.

local Module = {}

----------------------------------------------------------------------
-- Storage kinds. Drives the Increment / IncrementMap / SetMax / Set
-- branches in StatisticsServer.
----------------------------------------------------------------------
Module.Kinds = {
	-- A monotonically-increasing counter. Increment by `amount`.
	Counter   = 'counter',
	-- A record-style counter that only ever moves UP. SetMax(value)
	-- replaces the stored value if `value` is greater. Used for
	-- highest-single-hit, longest-life, kill-streak record, etc.
	Record    = 'record',
	-- A nested per-key counter. IncrementMap(key, amount) bumps
	-- map[key]. Used for per-boss / per-item / per-zone tallies.
	Map       = 'map',
	-- A single timestamp (epoch seconds). Set(value) overwrites.
	-- Combined with Set-if-empty for first-join semantics.
	Timestamp = 'timestamp',
}

----------------------------------------------------------------------
-- Statistic ids. NEVER renumber existing entries — new stats get the
-- next free id; deleted stats leave their id reserved (commented).
-- Server / save struct read by id, not name; renumbering would silently
-- corrupt every existing player's history.
----------------------------------------------------------------------
Module.StatisticIds = {
	-- // Damage dealt //
	DamageDealtTotal  = 0,
	DamageDealtPvE    = 1,
	DamageDealtPvP    = 2,
	DamageDealtMelee  = 3,
	DamageDealtRanged = 4,
	DamageDealtMagic  = 5,

	-- // Damage taken / mitigated //
	DamageTaken    = 6,
	DamageBlocked  = 7,
	DamageParried  = 8,
	DamageDodged   = 9,
	-- Records.
	HighestSingleHit = 10,
	HighestCrit      = 11,

	-- // Deaths / kill streak //
	DeathsTotal       = 12,
	DeathsPvE         = 13,
	DeathsPvP         = 14,
	LongestLifeSeconds = 15,  -- Record
	KillStreakRecord   = 16,  -- Record
	CurrentKillStreak  = 17,  -- Counter (live; resets on death)

	-- // Bosses (Map: bossId → defeats) //
	BossesDefeated = 18,

	-- // Items (Maps: itemId → count) //
	ItemsCrafted   = 19,
	ItemsConsumed  = 20,
	ItemsBought    = 21,
	ItemsSold      = 22,
	ItemsDropped   = 23,

	-- // Currency //
	GoldEarned = 24,
	GoldSpent  = 25,

	-- // Forge / enchant / upgrade events //
	EnchantmentsApplied = 26,
	UpgradesApplied     = 27,

	-- // XP //
	LevelExperienceTotal = 28,
	-- Map: attributeId → total XP earned.
	AttributeExperience  = 29,

	-- // Quests //
	QuestsCompleted = 30,
	QuestsAbandoned = 31,

	-- // Movement //
	DistanceTraveledFoot  = 32,  -- studs walked / run on foot
	DistanceTraveledMount = 33,  -- studs while mounted
	JumpsTotal            = 34,
	DashesTotal           = 35,
	RollsTotal            = 36,

	-- // Zones (Maps: zoneId → count / seconds) //
	ZonesVisitedCount = 37,
	ZoneTimeSeconds   = 38,

	-- // Gathering (Maps: type → count) //
	ChestsOpened     = 39,
	ResourcesGathered = 40,

	-- // Sessions / time //
	PlayTimeTotal     = 41,  -- accumulated seconds across all sessions
	LongestSession    = 42,  -- Record
	SessionsPlayed    = 43,
	FirstJoinDate     = 44,  -- Timestamp (epoch)
	LastJoinDate      = 45,  -- Timestamp (epoch)

	-- // Social //
	TradesCompleted   = 46,
	PartiesJoined     = 47,
	ChatMessagesSent  = 48,
}

----------------------------------------------------------------------
-- Display metadata + storage kind, keyed by id. Add new entries when
-- you add new ids above. Missing entries are tolerated by the server
-- (defaults to Counter) but the stats menu won't surface them with a
-- nice label.
----------------------------------------------------------------------
local function info(label: string, kind: string, group: string)
	return { Label = label, Kind = kind, Group = group }
end

local IDS = Module.StatisticIds
local K = Module.Kinds

Module.Info = {
	[IDS.DamageDealtTotal]  = info('Damage Dealt (Total)',  K.Counter, 'Combat'),
	[IDS.DamageDealtPvE]    = info('Damage Dealt vs Enemies', K.Counter, 'Combat'),
	[IDS.DamageDealtPvP]    = info('Damage Dealt vs Players', K.Counter, 'Combat'),
	[IDS.DamageDealtMelee]  = info('Damage Dealt — Melee',  K.Counter, 'Combat'),
	[IDS.DamageDealtRanged] = info('Damage Dealt — Ranged', K.Counter, 'Combat'),
	[IDS.DamageDealtMagic]  = info('Damage Dealt — Magic',  K.Counter, 'Combat'),

	[IDS.DamageTaken]    = info('Damage Taken',    K.Counter, 'Combat'),
	[IDS.DamageBlocked]  = info('Damage Blocked',  K.Counter, 'Combat'),
	[IDS.DamageParried]  = info('Damage Parried',  K.Counter, 'Combat'),
	[IDS.DamageDodged]   = info('Damage Dodged',   K.Counter, 'Combat'),
	[IDS.HighestSingleHit] = info('Highest Single Hit', K.Record, 'Combat'),
	[IDS.HighestCrit]      = info('Highest Crit',       K.Record, 'Combat'),

	[IDS.DeathsTotal]        = info('Deaths',                K.Counter, 'Combat'),
	[IDS.DeathsPvE]          = info('Deaths vs Enemies',     K.Counter, 'Combat'),
	[IDS.DeathsPvP]          = info('Deaths vs Players',     K.Counter, 'Combat'),
	[IDS.LongestLifeSeconds] = info('Longest Life (Seconds)',K.Record,  'Combat'),
	[IDS.KillStreakRecord]   = info('Best Kill Streak',      K.Record,  'Combat'),
	[IDS.CurrentKillStreak]  = info('Current Kill Streak',   K.Counter, 'Combat'),

	[IDS.BossesDefeated] = info('Bosses Defeated', K.Map, 'Combat'),

	[IDS.ItemsCrafted]  = info('Items Crafted',  K.Map, 'Items'),
	[IDS.ItemsConsumed] = info('Items Consumed', K.Map, 'Items'),
	[IDS.ItemsBought]   = info('Items Bought',   K.Map, 'Items'),
	[IDS.ItemsSold]     = info('Items Sold',     K.Map, 'Items'),
	[IDS.ItemsDropped]  = info('Items Dropped',  K.Map, 'Items'),

	[IDS.GoldEarned] = info('Gold Earned', K.Counter, 'Economy'),
	[IDS.GoldSpent]  = info('Gold Spent',  K.Counter, 'Economy'),

	[IDS.EnchantmentsApplied] = info('Enchantments Applied', K.Counter, 'Crafting'),
	[IDS.UpgradesApplied]     = info('Upgrades Applied',     K.Counter, 'Crafting'),

	[IDS.LevelExperienceTotal] = info('Level XP Earned',     K.Counter, 'Progression'),
	[IDS.AttributeExperience]  = info('Attribute XP Earned', K.Map,     'Progression'),

	[IDS.QuestsCompleted] = info('Quests Completed', K.Counter, 'Quests'),
	[IDS.QuestsAbandoned] = info('Quests Abandoned', K.Counter, 'Quests'),

	[IDS.DistanceTraveledFoot]  = info('Distance — On Foot', K.Counter, 'Movement'),
	[IDS.DistanceTraveledMount] = info('Distance — Mounted', K.Counter, 'Movement'),
	[IDS.JumpsTotal]  = info('Jumps',  K.Counter, 'Movement'),
	[IDS.DashesTotal] = info('Dashes', K.Counter, 'Movement'),
	[IDS.RollsTotal]  = info('Rolls',  K.Counter, 'Movement'),

	[IDS.ZonesVisitedCount] = info('Zones Visited',     K.Map, 'World'),
	[IDS.ZoneTimeSeconds]   = info('Zone Time (Seconds)', K.Map, 'World'),

	[IDS.ChestsOpened]      = info('Chests Opened',      K.Map, 'Gathering'),
	[IDS.ResourcesGathered] = info('Resources Gathered', K.Map, 'Gathering'),

	[IDS.PlayTimeTotal]  = info('Total Play Time (Seconds)', K.Counter,   'Sessions'),
	[IDS.LongestSession] = info('Longest Session (Seconds)', K.Record,    'Sessions'),
	[IDS.SessionsPlayed] = info('Sessions Played',           K.Counter,   'Sessions'),
	[IDS.FirstJoinDate]  = info('First Joined',              K.Timestamp, 'Sessions'),
	[IDS.LastJoinDate]   = info('Last Joined',               K.Timestamp, 'Sessions'),

	[IDS.TradesCompleted]  = info('Trades Completed', K.Counter, 'Social'),
	[IDS.PartiesJoined]    = info('Parties Joined',   K.Counter, 'Social'),
	[IDS.ChatMessagesSent] = info('Chat Messages Sent', K.Counter, 'Social'),
}

----------------------------------------------------------------------
-- Helpers.
----------------------------------------------------------------------
function Module.GetKind(statId: number): string
	local i = Module.Info[statId]
	return (i and i.Kind) or Module.Kinds.Counter
end

function Module.GetLabel(statId: number): string
	local i = Module.Info[statId]
	return (i and i.Label) or string.format('Stat #%d', statId)
end

function Module.GetGroup(statId: number): string
	local i = Module.Info[statId]
	return (i and i.Group) or 'Other'
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/FFlags"><![CDATA[-- Feature-flag (FFlag) definitions. FFlags are one-shot, per-save named
-- switches tracking "this milestone happened once" state — persisted under
-- data.FFlags and read/written through FFlagsServer (GetFFlags / SetFFlag).
--
-- This is intentionally separate from the step-by-step onboarding tutorial
-- (Data.Onboarding): that config drives an ordered, resumable flow; these
-- are independent booleans (or small values) that any system can gate on.
--
-- Reference the Flags constants below rather than the raw id strings so a
-- rename is a single-site change.

local Module = {}

----------------------------------------------------------------------
-- Canonical flag ids.
----------------------------------------------------------------------
Module.Flags = {
	-- First-time welcome modal. Set when the player clicks FINISH on the
	-- JoinGameWelcomeWidget; while unset the popup is (re)offered on join.
	JoinGame1 = 'ONBOARDING_JOIN_GAME_1',
}

----------------------------------------------------------------------
-- Flag-adjacent config.
----------------------------------------------------------------------
-- Quest auto-granted alongside the JoinGame1 welcome popup. Designers can
-- repoint this at the real starter quest line once it lands; today it
-- grants the existing intro-tier quest. Granting is idempotent server-side
-- (skipped if the player already holds the quest).
Module.JoinGame1QuestId = 'TestQuestLine1'

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/CombatStates"><![CDATA[-- CombatStates — shared combat state and character-attribute constants.
--
-- CharacterStates still stores these as Roblox attributes. This module only
-- names the contract so future server, client, and recipe code do not retype
-- state strings across files.

local Module = {}

Module.Version = 1

Module.States = {
	Idle = 'Idle',
	Windup = 'Windup',
	Active = 'Active',
	Recovery = 'Recovery',
	Dodge = 'Dodge',
	Guard = 'Guard',
	ParryCounter = 'ParryCounter',
	Stunned = 'Stunned',
	Lifted = 'Lifted',
	Dragged = 'Dragged',
	Airborne = 'Airborne',
	Knockdown = 'Knockdown',
	Dead = 'Dead',
}

Module.Attributes = {
	CombatState = 'CombatState',
	CombatStateUntil = 'CombatStateUntil',
	CurrentMoveId = 'CurrentMoveId',
	CurrentActionId = 'CurrentActionId',

	Attacking = 'Attacking',
	Dodging = 'Dodging',
	IFrames = 'IFrames',
	UsingSkill = 'UsingSkill',
	Blocking = 'Blocking',
	BlockingCount = 'BlockingCount',
	Stunned = 'Stunned',
	KnockedDown = 'KnockedDown',
	Lifted = 'Lifted',
	Dragged = 'Dragged',
	Airborne = 'Airborne',
	JuggleCount = 'JuggleCount',
	Poise = 'Poise',

	SwordDrawn = 'SwordDrawn',
	SwordDrawing = 'SwordDrawing',
	Dashing = 'Dashing',
	AttackCooldown = 'AttackCooldown',
	DashCooldown = 'DashCooldown',
	PerfectDodgeCounter = 'PerfectDodgeCounter',
	BlockCooldownUntil = 'BlockCooldownUntil',
	PostBlockAttackUntil = 'PostBlockAttackUntil',
	DodgeCooldownUntil = 'DodgeCooldownUntil',
	HasWeaponEquipped = 'HasWeaponEquipped',
}

Module.HardCrowdControlAttributes = {
	Module.Attributes.Stunned,
	Module.Attributes.KnockedDown,
	Module.Attributes.Lifted,
	Module.Attributes.Dragged,
}

export type CombatState =
	'Idle'
	| 'Windup'
	| 'Active'
	| 'Recovery'
	| 'Dodge'
	| 'Guard'
	| 'ParryCounter'
	| 'Stunned'
	| 'Lifted'
	| 'Dragged'
	| 'Airborne'
	| 'Knockdown'
	| 'Dead'

export type CombatStateAttribute =
	'CombatState'
	| 'CombatStateUntil'
	| 'CurrentMoveId'
	| 'CurrentActionId'
	| 'Attacking'
	| 'Dodging'
	| 'IFrames'
	| 'UsingSkill'
	| 'Blocking'
	| 'BlockingCount'
	| 'Stunned'
	| 'KnockedDown'
	| 'Lifted'
	| 'Dragged'
	| 'Airborne'
	| 'JuggleCount'
	| 'Poise'
	| 'SwordDrawn'
	| 'SwordDrawing'
	| 'Dashing'
	| 'AttackCooldown'
	| 'DashCooldown'
	| 'PerfectDodgeCounter'
	| 'BlockCooldownUntil'
	| 'PostBlockAttackUntil'
	| 'DodgeCooldownUntil'
	| 'HasWeaponEquipped'

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/CombatFactions"><![CDATA[-- CombatFactions — shared faction and target-filter rules for combat.
--
-- This is a small pure contract around tags/attributes. Server runtimes use
-- it before damage/status/motion so players, NPCs, and future companions do
-- not each re-invent hostile-target checks.

local CollectionService = game:GetService('CollectionService')
local Players = game:GetService('Players')

local Module = {}

Module.Version = 1

Module.Tags = {
	PlayerCharacter = 'PLAYER_CHARACTER',
	AICharacter = 'AICharacter',
}

Module.Attributes = {
	FactionId = 'CombatFactionId',
	LegacyFactionId = 'FactionId',
	AllowFriendlyFire = 'AllowFriendlyFire',
	-- Explicit "never a valid combat target" marker. Needed because an
	-- UNREGISTERED model is now hittable (see CanHit); protection has to
	-- be declared rather than inferred from the absence of a tag.
	NoCombatTarget = 'NoCombatTarget',
}

Module.Factions = {
	Players = 'Players',
	NPCs = 'NPCs',
	Neutral = 'Neutral',
}

Module.TargetModes = {
	Hostiles = 'hostiles',
	All = 'all',
	Self = 'self',
	Players = 'players',
	NPCs = 'npcs',
}

export type CombatTargetMode = 'hostiles' | 'all' | 'self' | 'players' | 'npcs'

export type HitContext = {
	TargetMode: CombatTargetMode?,
	AllowSelf: boolean?,
	AllowFriendlyFire: boolean?,
}

local function getStringAttribute(instance: Instance, attributeName: string): string?
	local value = instance:GetAttribute(attributeName)
	if typeof(value) == 'string' and #value > 0 then
		return value
	end
	return nil
end

-- True when the model actually DECLARES a faction, as opposed to falling
-- through to the Neutral default. GetFactionId cannot express the
-- difference on its own, and the difference is load-bearing: a declared
-- Neutral is a protected bystander, an undeclared one is just unknown.
local function hasExplicitFaction(model: Instance): boolean
	return getStringAttribute(model, Module.Attributes.FactionId) ~= nil
		or getStringAttribute(model, Module.Attributes.LegacyFactionId) ~= nil
end

-- A player's character is a combatant whether or not the tag has landed.
--
-- The PLAYER_CHARACTER tag is written by GameControllerServer only AFTER
-- its `while (not Data)` save-load wait resolves, and is stripped again
-- on death. Every hit now runs through CanHit, which fails closed on
-- IsCombatant — so keying combat identity solely on that tag makes a
-- player's swings land on nothing during the window before it appears.
-- Players:GetPlayerFromCharacter is true the instant the character
-- exists, on both client and server, so it is the reliable signal and
-- the tag is the fallback (rigs that mimic a player without a Player).
function Module.IsPlayerCombatant(model: Instance?): boolean
	if model == nil then
		return false
	end
	if Players:GetPlayerFromCharacter(model) ~= nil then
		return true
	end
	return CollectionService:HasTag(model, Module.Tags.PlayerCharacter)
end

function Module.IsNpcCombatant(model: Instance?): boolean
	return model ~= nil and CollectionService:HasTag(model, Module.Tags.AICharacter)
end

function Module.IsCombatant(model: Instance?): boolean
	return Module.IsPlayerCombatant(model) or Module.IsNpcCombatant(model)
end

function Module.GetFactionId(model: Instance?): string
	if not model then
		return Module.Factions.Neutral
	end

	local explicitFaction = getStringAttribute(model, Module.Attributes.FactionId)
		or getStringAttribute(model, Module.Attributes.LegacyFactionId)
	if explicitFaction then
		return explicitFaction
	end

	if Module.IsPlayerCombatant(model) then
		return Module.Factions.Players
	end

	-- NPCs default to a shared faction. Set CombatFactionId/FactionId on
	-- a model or Mobs config when two NPC groups should fight each other.
	if Module.IsNpcCombatant(model) then
		return Module.Factions.NPCs
	end

	return Module.Factions.Neutral
end

function Module.GetCandidateTagsForTargetMode(caster: Instance?, targetMode: CombatTargetMode?): { string }
	if targetMode == Module.TargetModes.Self then
		return {}
	end
	if targetMode == Module.TargetModes.Players then
		return { Module.Tags.PlayerCharacter }
	end
	if targetMode == Module.TargetModes.NPCs then
		return { Module.Tags.AICharacter }
	end
	if targetMode == Module.TargetModes.All then
		return { Module.Tags.PlayerCharacter, Module.Tags.AICharacter }
	end

	-- Hostiles: players can hit NPCs by default; NPCs can hit players and
	-- other NPCs, with same-faction filtering handled by CanHit.
	if Module.IsPlayerCombatant(caster) then
		return { Module.Tags.AICharacter, Module.Tags.PlayerCharacter }
	end
	return { Module.Tags.PlayerCharacter, Module.Tags.AICharacter }
end

function Module.CanHit(attacker: Instance?, target: Instance?, context: HitContext?): (boolean, string)
	if not attacker or not target then
		return false, 'MissingCombatant'
	end
	-- The ATTACKER must be a registered combatant. This one stays strict:
	-- it is what stops an arbitrary rig from becoming a damage source.
	if not Module.IsCombatant(attacker) then
		return false, 'AttackerNotCombatant'
	end

	-- The TARGET deliberately does NOT have to be registered.
	--
	-- Requiring it made every unregistered humanoid an invulnerable prop:
	-- a Studio rig, a freshly cloned NPC that has not reached
	-- EnemyServer.InitializeMob yet, anything authored ahead of code. The
	-- liveness check below ("does it have a Humanoid with health") is the
	-- real question; registration decides which RULES apply, not whether
	-- the thing exists. Protection is opt-in via NoCombatTarget or an
	-- explicit Neutral faction, both handled further down.

	context = context or {}
	local targetMode = context.TargetMode
	if attacker == target then
		if context.AllowSelf or targetMode == Module.TargetModes.Self then
			return true, ''
		end
		return false, 'SelfTarget'
	end

	local humanoid = target:FindFirstChildOfClass('Humanoid')
	if not humanoid or humanoid.Health <= 0 then
		return false, 'TargetDead'
	end

	-- Explicit opt-out for scenery characters, cutscene actors and quest
	-- givers that must never be swingable.
	if target:GetAttribute(Module.Attributes.NoCombatTarget) == true then
		return false, 'TargetProtected'
	end

	if targetMode == Module.TargetModes.Players and not Module.IsPlayerCombatant(target) then
		return false, 'TargetNotPlayer'
	end
	if targetMode == Module.TargetModes.NPCs and not Module.IsNpcCombatant(target) then
		return false, 'TargetNotNpc'
	end

	if context.AllowFriendlyFire
		or targetMode == Module.TargetModes.All
		or target:GetAttribute(Module.Attributes.AllowFriendlyFire) == true then
		return true, ''
	end

	local attackerFaction = Module.GetFactionId(attacker)
	local targetFaction = Module.GetFactionId(target)

	if attackerFaction == targetFaction then
		return false, 'SameFaction'
	end
	-- A DECLARED Neutral is a protected bystander. An undeclared one is
	-- just an unregistered model, and blocking those is what made plain
	-- rigs unkillable — so only the declaration protects.
	if targetFaction == Module.Factions.Neutral and hasExplicitFaction(target) then
		return false, 'NeutralFaction'
	end
	-- An attacker with no faction of its own cannot be hostile to
	-- anything; it has nothing to be hostile relative to.
	if attackerFaction == Module.Factions.Neutral then
		return false, 'NeutralFaction'
	end

	return true, ''
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/CombatMovesets"><![CDATA[-- // CombatMovesets.luau //
-- Single authority for standard-attack move recipes. Replaces the old
-- CombatCombos.luau registry and absorbs its per-class tuning.
--
-- See NIER_COMBAT.md for the design.
--
-- A "move" is everything the server needs to run one swing WITHOUT
-- consulting an animation:
--
--   * timings      Windup / Active / Recovery, in seconds
--   * cancel       when the move may be interrupted, per input kind
--   * hitboxes     server-space boxes with their own active sub-windows
--   * damage       DamageMult + PoiseDamage
--   * motion       whether the CASTER holds altitude (air chains only;
--                  attacks never move the caster horizontally)
--   * on-hit       launch / slam applied to the VICTIM (never a
--                  horizontal shove — see CombatMotionServer)
--
-- `Anim` is a cosmetic slot name only. Nothing in this file's gameplay
-- contract depends on an animation existing, loading, or reporting a
-- length. If every AttackSet asset id were deleted, combat would still
-- swing, hit, launch and slam on exactly these numbers.
--
-- Lookup shape (see CombosShared for the resolver):
--     class   = ResolveActiveClass(lightClass, heavyClass)
--     context = Ground | Air | DodgeCounter        -- caster state
--     key     = 'L' | 'LL' | 'LLL' | 'LLLL' | 'H' | 'LH' | 'LLH' | ...
--     move    = CombatMovesets.ResolveMove(class, context, key)
--
-- Classes only need to author their Ground chain. Air and DodgeCounter
-- entries are DERIVED from the class profile when unauthored, so adding
-- a new weapon class never requires filling a 3-context matrix by hand.

local Module = {}

Module.Version = 1

-- Class used when an item declares no `WeaponClass` in its EquipmentData.
Module.DefaultClass = 'Sword'

----------------------------------------------------------------------
-- Contexts. The caster's situation at the moment the input resolves,
-- picked server-side from authoritative state (never from the client).
----------------------------------------------------------------------
Module.Contexts = {
	Ground = 'Ground',
	Air = 'Air',
	DodgeCounter = 'DodgeCounter',
}

----------------------------------------------------------------------
-- Caster motion modes, executed by CombatMotionServer.
--   None      the caster is not moved at all — every ground attack
--   Hover     hold altitude for the length of the swing (air chains)
--
-- There is no horizontal mode. Attacks do not step in, close distance
-- or lunge; a swing turns the caster to face its target and plays on
-- the spot. Impact is sold by the move's AnimationSlot, not by shoving
-- the character around, and leaving the horizontal axis empty is what
-- lets a launcher or a slam describe purely a lift.
--
-- If a move needs to cover ground, that is a DASH — a separate verb the
-- player inputs, not something an attack does to them.
----------------------------------------------------------------------
Module.MotionModes = {
	None = 'None',
	Hover = 'Hover',
}

----------------------------------------------------------------------
-- Cancel windows.
--
-- Expressed as a FRACTION of the move's total duration. A move may be
-- cancelled into input X once `elapsed >= Total * CancelFrom[X]`.
--
-- Values below 1.0 that fall inside the active window make a move
-- "dodge-cancelable mid-swing", which is the NieR verb: you can always
-- bail out of a committed attack. Light/heavy cancel points sit inside
-- recovery so chains feel continuous instead of waiting out the full
-- animation tail.
--
-- CombatConfig.COMBO_BUFFER lets an input that arrives slightly BEFORE
-- the cancel point queue rather than drop.
----------------------------------------------------------------------
local DEFAULT_CANCEL_FROM = {
	Ground = { L = 0.58, H = 0.62, Dodge = 0.22 },
	Air = { L = 0.52, H = 0.58, Dodge = 0.20 },
	DodgeCounter = { L = 0.60, H = 0.64, Dodge = 0.18 },
}

----------------------------------------------------------------------
-- Per-class physical profile. Governs reach, swing volume and weight.
-- These are the values a designer changes to make a class "feel"
-- different independent of the per-step damage numbers.
--
--   Reach              forward offset of the hitbox from the caster HRP
--   HitboxSize         swing volume (studs)
--   MaxTargets         cap on humanoids damaged by one hitbox window
--   PoiseDamage        default stagger pressure per landed hit
--
-- Since attacks no longer close distance, REACH is the only thing that
-- decides whether a swing connects — a class's range is now entirely
-- `Reach` plus the depth of its `HitboxSize`, and nothing moves the
-- caster to make up a shortfall. Sword reaches 3.5 with a 5-deep box,
-- so it covers roughly 1 to 6 studs of root-to-root gap; Spear reaches
-- 5.0 with an 8-deep box for roughly 1 to 9.
----------------------------------------------------------------------
Module.ClassProfiles = {
	Sword = {
		Wield = 'OneHand',
		Reach = 3.5,
		HitboxSize = Vector3.new(5, 5, 5),
		MaxTargets = 5,
		PoiseDamage = 18,
	},
	Longsword = {
		Wield = 'OneHand',
		Reach = 3.9,
		HitboxSize = Vector3.new(5.5, 5, 5.5),
		MaxTargets = 5,
		PoiseDamage = 20,
	},
	Greatsword = {
		Wield = 'TwoHand',
		Reach = 4.2,
		HitboxSize = Vector3.new(7, 5.5, 6),
		MaxTargets = 8,
		PoiseDamage = 34,
	},
	Dagger = {
		Wield = 'OneHand',
		Reach = 3.0,
		HitboxSize = Vector3.new(4.5, 5, 4.5),
		MaxTargets = 3,
		PoiseDamage = 10,
	},
	DualDagger = {
		Wield = 'DualWield',
		Reach = 3.0,
		HitboxSize = Vector3.new(4.8, 5, 4.8),
		MaxTargets = 4,
		PoiseDamage = 12,
	},
	Spear = {
		Wield = 'TwoHand',
		-- Long, narrow thrust volume: reaches further than any other
		-- class but sweeps a thinner arc.
		Reach = 5.0,
		HitboxSize = Vector3.new(4.5, 5, 8),
		MaxTargets = 6,
		PoiseDamage = 22,
	},
	Mace = {
		Wield = 'OneHand',
		Reach = 3.5,
		HitboxSize = Vector3.new(5.5, 5, 5),
		MaxTargets = 5,
		PoiseDamage = 30,
	},
	Hammer = {
		Wield = 'TwoHand',
		Reach = 4.5,
		HitboxSize = Vector3.new(7.5, 6, 6.5),
		MaxTargets = 8,
		PoiseDamage = 40,
	},
}

-- Profile used when a class has no entry above. Keeps combat swinging
-- for content authored ahead of code.
Module.FallbackProfile = {
	Wield = 'OneHand',
	Reach = 3.5,
	HitboxSize = Vector3.new(5, 5, 5),
	MaxTargets = 5,
	PoiseDamage = 18,
}

----------------------------------------------------------------------
-- Launch / slam specs shared by launcher moves. Scaled per class by
-- `LaunchScale` on the entry.
----------------------------------------------------------------------
Module.DefaultLaunch = {
	Lift = 12,          -- studs of controlled rise
	Duration = 0.18,    -- rise time before the hover takes over
	HoverDuration = 0.55,
	JuggleAdd = 1,
	MaxJuggle = 3,      -- PvE cap before a slam is forced
	PvPScale = 0.35,
	PvPMaxJuggle = 1,
}

Module.DefaultSlam = {
	Velocity = 38,
	Duration = 0.28,
	Lockout = 2,        -- attacker cannot re-launch this victim for N s
	DamageMult = 1.35,
	KnockdownDuration = 0.9,
	PvPKnockdownDuration = 0.5,
	GetupIFrames = 0.9,
}

----------------------------------------------------------------------
-- Per-class Ground chains.
--
-- Numbers migrated verbatim from the previous CombatCombos.luau so the
-- feel of every already-tuned class is preserved through the runtime
-- swap. New fields (IsLauncher / PoiseMult / Motion) are additive.
--
-- Field reference (all optional except the timings):
--   Anim          cosmetic animation slot; never affects gameplay
--   DamageMult    multiplier on rolled base damage
--   PoiseMult     scales the class profile's PoiseDamage for this step
--   IsFinisher    terminates the chain and unlocks finisher-only VFX
--   IsLauncher    lifts the victim into the Air context
--   LaunchScale   multiplier over DefaultLaunch.Lift
--   Windup/Active/Recovery   authoritative gameplay timings, seconds
--   Motion        override the context's default caster motion
--   CancelFrom    override the context's default cancel fractions
----------------------------------------------------------------------
Module.Classes = {

	Sword = {
		Ground = {
			L    = { Anim = 'L1',    DamageMult = 1.00, IsFinisher = false,
			         Windup = 0.05, Active = 0.15, Recovery = 0.20 },
			LL   = { Anim = 'L2',    DamageMult = 1.05, IsFinisher = false,
			         Windup = 0.05, Active = 0.15, Recovery = 0.18 },
			LLL  = { Anim = 'L3',    DamageMult = 1.10, IsFinisher = false,
			         Windup = 0.05, Active = 0.15, Recovery = 0.16 },
			LLLL = { Anim = 'L_FIN', DamageMult = 1.50, IsFinisher = true,
			         PoiseMult = 1.6,
			         Windup = 0.10, Active = 0.20, Recovery = 0.30 },
			H    = { Anim = 'H1',    DamageMult = 1.35, IsFinisher = false,
			         PoiseMult = 1.4,
			         Windup = 0.14, Active = 0.18, Recovery = 0.34 },
			LH   = { Anim = 'H2',    DamageMult = 1.55, IsFinisher = false,
			         PoiseMult = 1.5,
			         Windup = 0.12, Active = 0.20, Recovery = 0.36 },
			-- Launcher. Ends the ground chain by popping the victim up;
			-- follow-ups resolve in the Air context.
			LLH  = { Anim = 'H_LAUNCH', DamageMult = 1.45, IsFinisher = true,
			         IsLauncher = true, LaunchScale = 1.0, PoiseMult = 1.8,
			         Windup = 0.16, Active = 0.20, Recovery = 0.42 },
		},
	},

	Greatsword = {
		Ground = {
			L    = { Anim = 'L1',    DamageMult = 1.20, IsFinisher = false,
			         Windup = 0.10, Active = 0.20, Recovery = 0.32 },
			LL   = { Anim = 'L2',    DamageMult = 1.30, IsFinisher = false,
			         Windup = 0.10, Active = 0.20, Recovery = 0.30 },
			LLL  = { Anim = 'L3',    DamageMult = 1.40, IsFinisher = false,
			         Windup = 0.12, Active = 0.22, Recovery = 0.30 },
			LLLL = { Anim = 'L_FIN', DamageMult = 1.80, IsFinisher = true,
			         PoiseMult = 1.6,
			         Windup = 0.18, Active = 0.25, Recovery = 0.40 },
			H    = { Anim = 'H1',    DamageMult = 1.60, IsFinisher = false,
			         PoiseMult = 1.5,
			         Windup = 0.22, Active = 0.24, Recovery = 0.44 },
			LH   = { Anim = 'H2',    DamageMult = 1.80, IsFinisher = false,
			         PoiseMult = 1.6,
			         Windup = 0.20, Active = 0.26, Recovery = 0.46 },
			LLH  = { Anim = 'H_LAUNCH', DamageMult = 1.70, IsFinisher = true,
			         IsLauncher = true, LaunchScale = 0.85, PoiseMult = 2.0,
			         Windup = 0.26, Active = 0.24, Recovery = 0.52 },
		},
	},

	Longsword = {
		Ground = {
			L    = { Anim = 'L1',    DamageMult = 1.05, IsFinisher = false,
			         Windup = 0.06, Active = 0.16, Recovery = 0.22 },
			LL   = { Anim = 'L2',    DamageMult = 1.12, IsFinisher = false,
			         Windup = 0.06, Active = 0.16, Recovery = 0.20 },
			LLL  = { Anim = 'L3',    DamageMult = 1.20, IsFinisher = false,
			         Windup = 0.06, Active = 0.16, Recovery = 0.18 },
			LLLL = { Anim = 'L_FIN', DamageMult = 1.60, IsFinisher = true,
			         PoiseMult = 1.6,
			         Windup = 0.12, Active = 0.22, Recovery = 0.32 },
			H    = { Anim = 'H1',    DamageMult = 1.42, IsFinisher = false,
			         PoiseMult = 1.4,
			         Windup = 0.16, Active = 0.19, Recovery = 0.36 },
			LH   = { Anim = 'H2',    DamageMult = 1.62, IsFinisher = false,
			         PoiseMult = 1.5,
			         Windup = 0.14, Active = 0.21, Recovery = 0.38 },
			LLH  = { Anim = 'H_LAUNCH', DamageMult = 1.52, IsFinisher = true,
			         IsLauncher = true, LaunchScale = 0.95, PoiseMult = 1.8,
			         Windup = 0.18, Active = 0.21, Recovery = 0.44 },
		},
	},

	Dagger = {
		Ground = {
			L    = { Anim = 'L1',    DamageMult = 0.85, IsFinisher = false,
			         Windup = 0.03, Active = 0.10, Recovery = 0.14 },
			LL   = { Anim = 'L2',    DamageMult = 0.90, IsFinisher = false,
			         Windup = 0.03, Active = 0.10, Recovery = 0.13 },
			LLL  = { Anim = 'L3',    DamageMult = 0.95, IsFinisher = false,
			         Windup = 0.03, Active = 0.10, Recovery = 0.12 },
			LLLL = { Anim = 'L_FIN', DamageMult = 1.30, IsFinisher = true,
			         PoiseMult = 1.5,
			         Windup = 0.05, Active = 0.15, Recovery = 0.22 },
			H    = { Anim = 'H1',    DamageMult = 1.15, IsFinisher = false,
			         PoiseMult = 1.4,
			         Windup = 0.08, Active = 0.12, Recovery = 0.24 },
			LH   = { Anim = 'H2',    DamageMult = 1.28, IsFinisher = false,
			         PoiseMult = 1.5,
			         Windup = 0.07, Active = 0.13, Recovery = 0.26 },
			LLH  = { Anim = 'H_LAUNCH', DamageMult = 1.22, IsFinisher = true,
			         IsLauncher = true, LaunchScale = 1.15, PoiseMult = 1.7,
			         Windup = 0.09, Active = 0.14, Recovery = 0.30 },
		},
	},

	DualDagger = {
		Ground = {
			L    = { Anim = 'L1',    DamageMult = 0.85, IsFinisher = false,
			         Windup = 0.03, Active = 0.10, Recovery = 0.12 },
			LL   = { Anim = 'L2',    DamageMult = 1.00, IsFinisher = false,
