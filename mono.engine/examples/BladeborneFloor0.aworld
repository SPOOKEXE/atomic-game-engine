local ROSTER_CLASSES = { 'Ktn', 'Rpr', 'Axe', 'Bow', 'Mcr', 'Swd' }

-- Extra palette entries specific to the social tab. `HOSTILE` clashes with
-- `PALETTE.danger` intentionally (same color, different semantics); kept
-- separate so a future redesign tweaking duel-UI colors doesn't spill into
-- every damage indicator in the game.
local HOSTILE   = Color3.fromRGB(255, 93, 109)
local ONLINE    = Color3.fromRGB(106, 227, 168)
local GUILD_RED = Color3.fromRGB(255, 93, 120)

----------------------------------------------------------------------
-- Shared helpers
----------------------------------------------------------------------

-- Small round-ish icon button used in friend / nearby rows for whisper /
-- trade / duel / invite actions. Nothing is wired — click logs a stub.
local function actionIconButton(scope, glyph: string, tooltip: string)
	return scope:New('TextButton') {
		Size = UDim2.fromOffset(28, 28),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		FontFace = HUDCommon.FONT_UI,
		Text = glyph,
		TextSize = 13,
		TextColor3 = PALETTE.ink,
		[Fusion.OnEvent('Activated')] = function()
			warn(string.format('[Social] %s (stub)', tooltip))
		end,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.7, Thickness = 1 },
		},
	}
end

----------------------------------------------------------------------
-- Sub-panels
----------------------------------------------------------------------

local function buildFriendsPanel(scope)
	local header = scope:New('Frame') {
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			Utils.eyebrow(scope, '◆ FRIENDS · 6 ONLINE', { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 14) }),
			scope:New('TextLabel') {
				Position = UDim2.fromOffset(0, 18),
				Size = UDim2.new(1, -100, 0, 28),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = "Your Party's Trace",
				TextSize = 22,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextButton') {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, 0, 0, 22),
				Size = UDim2.fromOffset(80, 24),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				FontFace = HUDCommon.FONT_MONO,
				Text = '+ ADD',
				TextSize = 11,
				TextColor3 = PALETTE.accent,
				[Fusion.OnEvent('Activated')] = function() warn('[Social] add friend (stub)') end,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
				},
			},
		},
	}

	local rows = {}
	for i, f in PLACEHOLDER_FRIENDS do
		local dimTrans = f.on and 0 or 0.45
		local borderTrans = f.on and 0.6 or 0.82
		local statusColor = f.on and ONLINE or PALETTE.inkFaint
		local avatar = scope:New('Frame') {
			Size = UDim2.fromOffset(40, 40),
			BackgroundColor3 = PALETTE.bg0,
			BorderSizePixel = 0,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = PALETTE.accent, Transparency = borderTrans, Thickness = 1 },
				scope:New('TextLabel') {
					Size = UDim2.fromScale(1, 1),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_DISPLAY,
					Text = string.sub(f.n, 1, 1),
					TextSize = 16,
					TextColor3 = f.on and PALETTE.accent or PALETTE.ink,
				},
				f.on and scope:New('Frame') {
					AnchorPoint = Vector2.new(1, 1),
					Position = UDim2.new(1, 2, 1, 2),
					Size = UDim2.fromOffset(8, 8),
					BackgroundColor3 = ONLINE,
					BorderSizePixel = 0,
				} or nil,
			},
		}

		local info = scope:New('Frame') {
			Size = UDim2.new(1, -280, 1, 0),
			Position = UDim2.fromOffset(52, 0),
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				scope:New('TextLabel') {
					Size = UDim2.new(1, 0, 0, 18),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_DISPLAY,
					Text = string.format('%s  <font color="#7ec8ff" size="11">LV %d</font>', f.n, f.lv),
					RichText = true,
					TextSize = 15,
					TextColor3 = PALETTE.ink,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('TextLabel') {
					Position = UDim2.fromOffset(0, 20),
					Size = UDim2.new(1, 0, 0, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_UI,
					Text = f.cl,
					TextSize = 11,
					TextColor3 = PALETTE.inkDim,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
			},
		}

		local status = scope:New('TextLabel') {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -110, 0.5, 0),
			Size = UDim2.fromOffset(140, 14),
			BackgroundTransparency = 1,
			FontFace = HUDCommon.FONT_MONO,
			Text = string.upper(f.s),
			TextSize = 11,
			TextColor3 = statusColor,
			TextXAlignment = Enum.TextXAlignment.Right,
		}

		local actions = scope:New('Frame') {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.fromOffset(100, 30),
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				scope:New('UIListLayout') {
					FillDirection = Enum.FillDirection.Horizontal,
					Padding = UDim.new(0, 4),
					SortOrder = Enum.SortOrder.LayoutOrder,
					VerticalAlignment = Enum.VerticalAlignment.Center,
				},
				actionIconButton(scope, '✉', 'whisper ' .. f.n),
				actionIconButton(scope, '+', 'invite ' .. f.n),
				actionIconButton(scope, '⇆', 'trade ' .. f.n),
			},
		}

		table.insert(rows, scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 56),
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = dimTrans + 0.1,
			BorderSizePixel = 0,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = PALETTE.accent, Transparency = borderTrans, Thickness = 1 },
				scope:New('UIPadding') {
					PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
					PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
				},
				avatar, info, status, actions,
			},
		})
	end

	local listScroll = scope:New('ScrollingFrame') {
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 1, -60),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = PALETTE.accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				Padding = UDim.new(0, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			table.unpack(rows),
		},
	}

	return scope:New('Frame') {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			header, listScroll,
		},
	}
end

local function buildGuildPanel(scope)
	-- Banner: emblem + name + member-count + 4-cell mini stat grid
	local bannerStats = {}
	for i, pair in PLACEHOLDER_GUILD_STATS do
		table.insert(bannerStats, scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(0.5, -4, 0, 34),
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = 0.2,
			BorderSizePixel = 0,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.75, Thickness = 1 },
				scope:New('UIPadding') {
					PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
					PaddingTop = UDim.new(0, 3), PaddingBottom = UDim.new(0, 3),
				},
				scope:New('TextLabel') {
					Size = UDim2.new(1, 0, 0, 10),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = pair[1],
					TextSize = 9,
					TextColor3 = PALETTE.inkFaint,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('TextLabel') {
					Position = UDim2.fromOffset(0, 12),
					Size = UDim2.new(1, 0, 0, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = pair[2],
					TextSize = 12,
					TextColor3 = PALETTE.accent,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
			},
		})
	end

	local banner = scope:New('Frame') {
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 110),
		BackgroundColor3 = Color3.fromRGB(26, 10, 16),
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = GUILD_RED, Transparency = 0.2, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 14),
				PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16),
			},
			scope:New('TextLabel') {
				Size = UDim2.fromOffset(64, 82),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = '✜',
				TextSize = 32,
				TextColor3 = GUILD_RED,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = GUILD_RED, Transparency = 0.1, Thickness = 1 },
				},
			},
			scope:New('Frame') {
				Position = UDim2.fromOffset(80, 0),
				Size = UDim2.new(1, -320, 1, 0),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					Utils.eyebrow(scope, '◆ GUILD · CLEARER', { Size = UDim2.new(1, 0, 0, 12), Color = GUILD_RED }),
					scope:New('TextLabel') {
						Position = UDim2.fromOffset(0, 14),
						Size = UDim2.new(1, 0, 0, 32),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_DISPLAY,
						Text = 'Knights of the Blood',
						TextSize = 24,
						TextColor3 = PALETTE.ink,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					scope:New('TextLabel') {
						Position = UDim2.fromOffset(0, 50),
						Size = UDim2.new(1, 0, 0, 14),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_UI,
						Text = 'Led by Heathcliff · 42 members · founded Fl·14',
						TextSize = 12,
						TextColor3 = PALETTE.inkDim,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
				},
			},
			scope:New('Frame') {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, 0, 0, 0),
				Size = UDim2.fromOffset(220, 82),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIGridLayout') {
						CellSize = UDim2.new(0.5, -4, 0, 34),
						CellPadding = UDim2.fromOffset(8, 6),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					table.unpack(bannerStats),
				},
			},
		},
	}

	-- Perks row — 4 accent-bordered cards side-by-side.
	local perkCards = {}
	for i, p in PLACEHOLDER_GUILD_PERKS do
		table.insert(perkCards, scope:New('Frame') {
			LayoutOrder = i,
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = 0.1,
			BorderSizePixel = 0,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.65, Thickness = 1 },
				scope:New('UIPadding') {
					PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
					PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
				},
				scope:New('TextLabel') {
					Size = UDim2.new(1, 0, 0, 10),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO, Text = '◆ PERK', TextSize = 9,
					TextColor3 = PALETTE.inkFaint, TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('TextLabel') {
					Position = UDim2.fromOffset(0, 13),
					Size = UDim2.new(1, 0, 0, 18),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_DISPLAY, Text = p[1], TextSize = 14,
					TextColor3 = PALETTE.accent, TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('TextLabel') {
					Position = UDim2.fromOffset(0, 34),
					Size = UDim2.new(1, 0, 0, 12),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO, Text = p[2], TextSize = 11,
					TextColor3 = ONLINE, TextXAlignment = Enum.TextXAlignment.Left,
				},
			},
		})
	end

	local perksSection = scope:New('Frame') {
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 0, 82),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			Utils.eyebrow(scope, '◆ ACTIVE PERKS', { Size = UDim2.new(1, 0, 0, 12) }),
			scope:New('Frame') {
				Position = UDim2.fromOffset(0, 16),
				Size = UDim2.new(1, 0, 1, -16),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIGridLayout') {
						CellSize = UDim2.new(0.25, -5, 1, 0),
						CellPadding = UDim2.fromOffset(6, 0),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					table.unpack(perkCards),
				},
			},
		},
	}

	-- Roster grid — 2-col member cards with rank + level.
	local rosterCards = {}
	for i, r in PLACEHOLDER_GUILD_ROSTER do
		table.insert(rosterCards, scope:New('Frame') {
			LayoutOrder = i,
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = 0.15,
			BorderSizePixel = 0,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.82, Thickness = 1 },
				scope:New('UIPadding') { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
					PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) },
				scope:New('Frame') {
					Size = UDim2.fromOffset(32, 32),
					BackgroundColor3 = PALETTE.bg0,
					BorderSizePixel = 0,
					[Fusion.Children] = {
						scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.5, Thickness = 1 },
						scope:New('TextLabel') {
							Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
							FontFace = HUDCommon.FONT_DISPLAY, Text = string.sub(r[1], 1, 1), TextSize = 13,
							TextColor3 = PALETTE.accent,
						},
					},
				},
				scope:New('TextLabel') {
					Position = UDim2.fromOffset(40, 2),
					Size = UDim2.new(1, -40, 0, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_UI,
					Text = string.format('%s  <font color="#7ec8ff" size="10">LV%s</font>', r[1], r[3]),
					RichText = true,
					TextSize = 12,
					TextColor3 = PALETTE.ink,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('TextLabel') {
					Position = UDim2.fromOffset(40, 18),
					Size = UDim2.new(1, -40, 0, 11),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = string.upper(r[2]),
					TextSize = 10,
					TextColor3 = PALETTE.inkFaint,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
			},
		})
	end

	local rosterSection = scope:New('Frame') {
		LayoutOrder = 3,
		Size = UDim2.new(1, 0, 0, 130),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			Utils.eyebrow(scope, '◆ ROSTER · ONLINE', { Size = UDim2.new(1, 0, 0, 12) }),
			scope:New('Frame') {
				Position = UDim2.fromOffset(0, 16),
				Size = UDim2.new(1, 0, 1, -16),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIGridLayout') {
						CellSize = UDim2.new(0.5, -4, 0, 46),
						CellPadding = UDim2.fromOffset(6, 6),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					table.unpack(rosterCards),
				},
			},
		},
	}

	return scope:New('ScrollingFrame') {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = PALETTE.accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				Padding = UDim.new(0, 14),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			banner, perksSection, rosterSection,
		},
	}
end

local function buildNearbyPanel(scope)
	local header = scope:New('Frame') {
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 48),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			Utils.eyebrow(scope, '◆ NEARBY · 11 PLAYERS · 240M RADIUS', { Size = UDim2.new(1, 0, 0, 12) }),
			scope:New('TextLabel') {
				Position = UDim2.fromOffset(0, 16),
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY, Text = 'Within Sight',
				TextSize = 22, TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
		},
	}

	local rows = {}
	for i, p in PLACEHOLDER_NEARBY do
		local tone = p.hostile and HOSTILE or PALETTE.accent
		local barColor = p.hostile and HOSTILE or ONLINE
		table.insert(rows, scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 34),
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = 0.15,
			BorderSizePixel = 0,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = tone, Transparency = 0.7, Thickness = 1 },
				scope:New('UIPadding') { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) },
				scope:New('UIListLayout') {
					FillDirection = Enum.FillDirection.Horizontal,
					Padding = UDim.new(0, 8),
					VerticalAlignment = Enum.VerticalAlignment.Center,
					SortOrder = Enum.SortOrder.LayoutOrder,
				},
				scope:New('TextLabel') {
					LayoutOrder = 1,
					Size = UDim2.fromOffset(52, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO, Text = p.a, TextSize = 12,
					TextColor3 = tone, TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('TextLabel') {
					LayoutOrder = 2,
					Size = UDim2.fromOffset(44, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO, Text = p.d, TextSize = 12,
					TextColor3 = PALETTE.ink, TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('TextLabel') {
					LayoutOrder = 3,
					Size = UDim2.fromOffset(36, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO, Text = 'LV' .. tostring(p.lv), TextSize = 10,
					TextColor3 = tone, TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('TextLabel') {
					LayoutOrder = 4,
					Size = UDim2.new(1, -320, 0, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_UI,
					Text = p.n .. (p.hostile and ' · HOSTILE' or ''),
					TextSize = 13,
					TextColor3 = p.hostile and HOSTILE or PALETTE.ink,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('Frame') {
					LayoutOrder = 5,
					Size = UDim2.fromOffset(80, 14),
					BackgroundTransparency = 1,
					[Fusion.Children] = {
						HUDCommon.smoothBar(scope, { Value = p.h, Max = 100, Color = barColor, Height = 4 }),
					},
				},
				scope:New('Frame') {
					LayoutOrder = 6,
					Size = UDim2.fromOffset(96, 26),
					BackgroundTransparency = 1,
					[Fusion.Children] = {
						scope:New('UIListLayout') {
							FillDirection = Enum.FillDirection.Horizontal,
							Padding = UDim.new(0, 3),
							VerticalAlignment = Enum.VerticalAlignment.Center,
							SortOrder = Enum.SortOrder.LayoutOrder,
						},
						actionIconButton(scope, '⇆', 'trade ' .. p.n),
						actionIconButton(scope, '⚔', 'duel ' .. p.n),
						actionIconButton(scope, '+', 'invite ' .. p.n),
					},
				},
			},
		})
	end

	local listScroll = scope:New('ScrollingFrame') {
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 1, -56),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = PALETTE.accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				Padding = UDim.new(0, 4),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			table.unpack(rows),
		},
	}

	return scope:New('Frame') {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			header, listScroll,
		},
	}
end

local function buildRecentPanel(scope)
	local rows = {}
	for i, p in PLACEHOLDER_RECENT do
		table.insert(rows, scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 52),
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = 0.15,
			BorderSizePixel = 0,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.72, Thickness = 1 },
				scope:New('UIPadding') {
					PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
					PaddingTop = UDim.new(0, 7), PaddingBottom = UDim.new(0, 7),
				},
				scope:New('Frame') {
					Size = UDim2.fromOffset(38, 38),
					BackgroundColor3 = PALETTE.bg0,
					BorderSizePixel = 0,
					[Fusion.Children] = {
						scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.5, Thickness = 1 },
						scope:New('TextLabel') {
							Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
							FontFace = HUDCommon.FONT_DISPLAY, Text = string.sub(p.n, 1, 1), TextSize = 14,
							TextColor3 = PALETTE.accent,
						},
					},
				},
				scope:New('Frame') {
					Position = UDim2.fromOffset(50, 0),
					Size = UDim2.new(1, -280, 1, 0),
					BackgroundTransparency = 1,
					[Fusion.Children] = {
						scope:New('TextLabel') {
							Size = UDim2.new(1, 0, 0, 16),
							BackgroundTransparency = 1,
							FontFace = HUDCommon.FONT_UI, Text = p.n, TextSize = 13,
							TextColor3 = PALETTE.ink, TextXAlignment = Enum.TextXAlignment.Left,
						},
						scope:New('TextLabel') {
							Position = UDim2.fromOffset(0, 18),
							Size = UDim2.new(1, 0, 0, 14),
							BackgroundTransparency = 1,
							FontFace = HUDCommon.FONT_UI, Text = p.ctx, TextSize = 11,
							TextColor3 = PALETTE.inkDim, TextXAlignment = Enum.TextXAlignment.Left,
						},
					},
				},
				scope:New('TextLabel') {
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -180, 0.5, 0),
					Size = UDim2.fromOffset(120, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO, Text = string.upper(p.ago), TextSize = 10,
					TextColor3 = PALETTE.inkFaint, TextXAlignment = Enum.TextXAlignment.Right,
				},
				scope:New('TextLabel') {
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -100, 0.5, 0),
					Size = UDim2.fromOffset(70, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = string.format('%d mutual', p.mutual),
					TextSize = 10,
					TextColor3 = PALETTE.inkDim,
					TextXAlignment = Enum.TextXAlignment.Right,
				},
				scope:New('TextButton') {
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, 0, 0.5, 0),
					Size = UDim2.fromOffset(82, 24),
					BackgroundTransparency = 1,
					AutoButtonColor = false,
					FontFace = HUDCommon.FONT_MONO, Text = '+ FRIEND', TextSize = 10,
					TextColor3 = PALETTE.accent,
					[Fusion.OnEvent('Activated')] = function()
						warn('[Social] add friend ' .. p.n .. ' (stub)')
					end,
					[Fusion.Children] = {
						scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.5, Thickness = 1 },
					},
				},
			},
		})
	end

	local listScroll = scope:New('ScrollingFrame') {
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 1, -56),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = PALETTE.accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				Padding = UDim.new(0, 4),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			table.unpack(rows),
		},
	}

	return scope:New('Frame') {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:New('Frame') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 48),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					Utils.eyebrow(scope, '◆ RECENT ENCOUNTERS', { Size = UDim2.new(1, 0, 0, 12) }),
					scope:New('TextLabel') {
						Position = UDim2.fromOffset(0, 16),
						Size = UDim2.new(1, 0, 0, 28),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_DISPLAY, Text = 'Who You Crossed',
						TextSize = 22, TextColor3 = PALETTE.ink,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
				},
			},
			listScroll,
		},
	}
end

local function buildRosterPanel(scope)
	-- 6-col grid of synthetic "Player_###" cards — purely decorative until
	-- the actual floor roster system lands. 36 cells fills the viewport on
	-- design screen sizes without needing scroll.
	local cells = {}
	for i = 1, 36 do
		local lv = 60 + ((i - 1) % 20)
		local cls = ROSTER_CLASSES[((i - 1) % #ROSTER_CLASSES) + 1]
		table.insert(cells, scope:New('Frame') {
			LayoutOrder = i,
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = 0.15,
			BorderSizePixel = 0,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.82, Thickness = 1 },
				scope:New('UIPadding') {
					PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
					PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
				},
				scope:New('TextLabel') {
					Size = UDim2.new(1, 0, 0, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_UI,
					Text = string.format('Player_%03d', i),
					TextSize = 12,
					TextColor3 = PALETTE.ink,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('TextLabel') {
					AnchorPoint = Vector2.new(0, 1),
					Position = UDim2.new(0, 0, 1, 0),
					Size = UDim2.new(0.5, 0, 0, 12),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = 'LV' .. tostring(lv),
					TextSize = 10,
					TextColor3 = PALETTE.accent,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('TextLabel') {
					AnchorPoint = Vector2.new(1, 1),
					Position = UDim2.new(1, 0, 1, 0),
					Size = UDim2.new(0.5, 0, 0, 12),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO, Text = cls, TextSize = 9,
					TextColor3 = PALETTE.inkFaint, TextXAlignment = Enum.TextXAlignment.Right,
				},
			},
		})
	end

	local gridScroll = scope:New('ScrollingFrame') {
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 1, -56),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = PALETTE.accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		[Fusion.Children] = {
			scope:New('UIGridLayout') {
				CellSize = UDim2.new(1/6, -4, 0, 46),
				CellPadding = UDim2.fromOffset(4, 4),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			table.unpack(cells),
		},
	}

	return scope:New('Frame') {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:New('Frame') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 48),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					Utils.eyebrow(scope, '◆ FLOOR ROSTER · FL 74', { Size = UDim2.new(1, 0, 0, 12) }),
					scope:New('TextLabel') {
						Position = UDim2.fromOffset(0, 16),
						Size = UDim2.new(1, 0, 0, 28),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_DISPLAY, Text = 'Every Soul Above the Fog',
						TextSize = 22, TextColor3 = PALETTE.ink,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
				},
			},
			gridScroll,
		},
	}
end

----------------------------------------------------------------------
-- Tab shell
----------------------------------------------------------------------

function Module.Build(ctx)
	local scope = ctx.scope

	local SelectedSub = scope:Value('friends')

	-- Social submenu rows — RailButton with a numeric count chip. The count
	-- is static (baked into SOCIAL_SUBS), so we pass it as a plain number and
	-- RailButton's chip-text binding renders it once.
	local subButtons = {}
	for i, sub in SOCIAL_SUBS do
		local isActive = scope:Computed(function(use) return use(SelectedSub) == sub.id end)
		local button = Components.RailButton(scope, {
			isActive = isActive,
			glyph    = sub.glyph,
			label    = sub.name,
			chip     = { text = sub.count },
			height   = 34,
			-- Shape-lock + scale: submenu column width LEFT_COL_PX, height 34
			-- → button + scaled internals track the panel.
			aspectRatio = LEFT_COL_PX / 34,
			onActivate = function() SelectedSub:set(sub.id) end,
		})
		button.LayoutOrder = i
		table.insert(subButtons, button)
	end

	local leftColumn = scope:New('Frame') {
		LayoutOrder = 1,
		Size = UDim2.fromScale(LEFT_COL_PX / DESIGN_W, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder },
			Utils.eyebrow(scope, '◆ SOCIAL', {
				LayoutOrder = 0,
				Size = UDim2.new(1, -28, 0, 16),
				Position = UDim2.fromOffset(14, 0),
			}),
			table.unpack(subButtons),
		},
	}

	-- Per-sub content panels, each wrapped in a Frame whose Visible is reactive.
	-- The registry form (id+build pairs) lets us add/remove sub-panels from
	-- one list instead of scattered Visible comparisons in the render tree.
	local panelBuilders = {
		{ id = 'friends', build = buildFriendsPanel },
		{ id = 'guild',   build = buildGuildPanel   },
		{ id = 'nearby',  build = buildNearbyPanel  },
		{ id = 'recent',  build = buildRecentPanel  },
		{ id = 'roster',  build = buildRosterPanel  },
	}
	local panelWrappers = {}
	for _, entry in panelBuilders do
		local id = entry.id
		local inner = entry.build(scope)
		inner.Size = UDim2.fromScale(1, 1)
		table.insert(panelWrappers, scope:New('Frame') {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Visible = scope:Computed(function(use) return use(SelectedSub) == id end),
			[Fusion.Children] = { inner },
		})
	end

	local rightColumn = scope:New('Frame') {
		LayoutOrder = 2,
		Size = UDim2.fromScale((DESIGN_W - RIGHT_INSET_PX) / DESIGN_W, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
			},
			table.unpack(panelWrappers),
		},
	}

	return scope:New('Frame') {
		Name = 'SocialTab',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(20 / OUTER_H, 0),
				PaddingBottom = UDim.new(20 / OUTER_H, 0),
				PaddingLeft   = UDim.new(0, 0),
				PaddingRight  = UDim.new(20 / OUTER_W, 0),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(COL_GAP_PX / DESIGN_W, 0),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			leftColumn, rightColumn,
		},
	}
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/TabWidget/ToolbarTab.luau"><![CDATA[-- // TabWidget/ToolbarTab.luau //
-- (Registered in the tab manager as "Equip".)
--
-- Sub-tabbed equip-management surface:
--   * Hotbar sub-tab    — top-pane hotbar mirror + bottom-pane inventory
--                         grid (skills, consumables, activatables, weapons,
--                         tools). Drag tiles onto hotbar slots OR click a
--                         tile then click a slot.
--   * Inventory sub-tab — left equip-slot column + right inventory grid
--                         (weapons, tools, armor, accessories). Drag tiles
--                         onto equip slots OR click to auto-equip.
--
-- Both sub-tabs share a single floating tooltip and a single drag
-- controller. Drop targets register themselves with the controller; the
-- controller hit-tests the cursor against every registered target on
-- mouse-up and routes the drop to whichever rect contains it.

local Players = game:GetService('Players')
local GuiService = game:GetService('GuiService')
local UserInputService = game:GetService('UserInputService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local peek   = Fusion.peek
local CombatUtility = ReplicatedModules.Utility.CombatUtility
local SkillsShared = ReplicatedModules.Services.SkillsShared
local ItemsConfig  = ReplicatedModules.Data.Items
local SkillsConfig = ReplicatedModules.Data.Skills
local Rarities     = ReplicatedModules.Data.Rarities
local RemoteService = ReplicatedModules.Services.RemoteService

local LocalPlayerScripts = LocalPlayer:WaitForChild('PlayerScripts')
local LocalModules = require(LocalPlayerScripts:WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local Utils = require(script.Parent:WaitForChild('utils'))
local InventoryGrid = require(script.Parent:WaitForChild('inventoryGrid'))

-- Server-side equip/unequip remote. Drag-drop onto an equip slot in the
-- Inventory sub-tab fires this; server walks AttemptPlayerEquipItemOfUUID
-- with full validation. Same remote the InventoryTab's EQUIP button uses.
local InventoryEvent = RemoteService.GetRemote('InventoryEvent', 'RemoteEvent', false)

local Module = {}

----------------------------------------------------------------------
-- Constants. Tab design canvas = 1394 × 648 (matches the aspect-lock
-- applied by TabWidget's mount loop). Outer paddings + inter-pane
-- gaps are expressed as fractions of the design canvas so the layout
-- stays proportional under the UIAspectRatioConstraint regardless of
-- screen aspect — same convention CharacterTab uses.
----------------------------------------------------------------------
local TAB_DESIGN_W = 1394
local TAB_DESIGN_H = 648
local OUTER_PAD_X  = 24    -- design-pixel side padding inside the tab
local OUTER_PAD_Y  = 16    -- design-pixel top/bottom padding
local PANE_GAP     = 8     -- gap between hotbar / inventory panes
local INNER_PAD_X  = 16    -- design-pixel inset inside each pane
local INNER_PAD_Y  = 12

-- Cell sizes match the on-screen hotbar's design language (square
-- strokes, font-mono keybind chip in top-left). Pixel-fixed; the
-- tab's aspect-lock keeps these proportional at the design canvas.
local HOTBAR_CELL = 48
local EQUIP_CELL  = 56  -- equip slots are slightly larger to fit the rarity stroke
local TOOLTIP_OFFSET = Vector2.new(20, 22)  -- slightly to the right + below cursor

-- Equip slot grid for the Inventory sub-tab. Keys match the save shape
-- produced by PlayerInventoryServer (`<index>_<token>`); each entry's
-- glyph + label populate the slot tile.
local EQUIP_SLOT_META = {
	['1_Weapon']   = { tag = 'L. HAND',  order = 1,  glyph = '\u{2694}' }, -- ⚔
	['2_Weapon']   = { tag = 'R. HAND',  order = 2,  glyph = '\u{2694}' },
	['1_Head']     = { tag = 'HEAD',     order = 3,  glyph = '\u{25CE}' }, -- ◎
	['1_Chest']    = { tag = 'CHEST',    order = 4,  glyph = '\u{26E8}' }, -- ⛨
	['1_Legs']     = { tag = 'LEGS',     order = 5,  glyph = '\u{26E8}' },
	['1_Boots']    = { tag = 'BOOTS',    order = 6,  glyph = '\u{25E2}' }, -- ◢
	['1_Bracelet'] = { tag = 'BRACELET', order = 7,  glyph = '\u{25C8}' }, -- ◈
	['1_Neck']     = { tag = 'NECK',     order = 8,  glyph = '\u{25C8}' },
	['1_Ear']      = { tag = 'EAR',      order = 9,  glyph = '\u{25C8}' },
	['1_Finger']   = { tag = 'RING',     order = 10, glyph = '\u{25C8}' },
	['1_Curio']    = { tag = 'CURIO',    order = 11, glyph = '\u{25C8}' },
}

----------------------------------------------------------------------
-- Drag controller. Single-instance per Build call; drop zones register
-- + unregister via the returned API. Owns:
--   * the ghost frame that follows the cursor while dragging
--   * the InputChanged listener that updates ghost position
--   * the InputEnded listener that hit-tests on mouse-up
----------------------------------------------------------------------
local function buildDragController(scope, rootFrame, onHover)
	local DragState = {
		active = false,
		entry = nil :: any,
		ghost = nil :: GuiObject?,
	}
	local DropTargets: { { frame: GuiObject, predicate: ((entry: any) -> boolean)?, onDrop: (entry: any) -> () } } = {}

	-- Ghost frame: a small floating tile rendered above everything else
	-- while a drag is in progress. Built lazily on drag-start so it
	-- doesn't live in the tree when no drag is active.
	local function makeGhost(entry)
		local ghost = Instance.new('Frame')
		ghost.Name = 'DragGhost'
		ghost.AnchorPoint = Vector2.new(0.5, 0.5)
		ghost.Size = UDim2.fromOffset(48, 48)
		ghost.BackgroundColor3 = PALETTE.bg0
		ghost.BackgroundTransparency = 0.1
		ghost.BorderSizePixel = 0
		ghost.ZIndex = 100
		ghost.Active = false  -- pass clicks through (don't intercept own InputEnded)

		local stroke = Instance.new('UIStroke')
		stroke.Color = entry.Color or PALETTE.gold
		stroke.Transparency = 0
		stroke.Thickness = 2
		stroke.Parent = ghost

		local corner = Instance.new('UICorner')
		corner.CornerRadius = UDim.new(0, 4)
		corner.Parent = ghost

		local icon = Instance.new('TextLabel')
		icon.AnchorPoint = Vector2.new(0.5, 0.5)
		icon.Position = UDim2.fromScale(0.5, 0.5)
		icon.Size = UDim2.fromScale(0.7, 0.7)
		icon.BackgroundTransparency = 1
		icon.FontFace = HUDCommon.FONT_DISPLAY
		icon.TextScaled = true
		icon.Text = entry.Glyph or '\u{25C6}'
		icon.TextColor3 = entry.Color or PALETTE.accent
		icon.Parent = ghost

		ghost.Parent = rootFrame
		return ghost
	end

	local function setGhostPosition(absX: number, absY: number)
		if not DragState.ghost then return end
		local parentAbs = rootFrame.AbsolutePosition
		local inset = GuiService:GetGuiInset()
		DragState.ghost.Position = UDim2.fromOffset(
			math.floor(absX - parentAbs.X - inset.X),
			math.floor(absY - parentAbs.Y - inset.Y))
	end

	local function pointInFrame(frame: GuiObject, x: number, y: number): boolean
		local p = frame.AbsolutePosition
		local s = frame.AbsoluteSize
		return x >= p.X and x <= p.X + s.X
			and y >= p.Y and y <= p.Y + s.Y
	end

	-- Drop targets in invisible sub-panes still report Absolute*
	-- coordinates from the layout pass, so a naive hit-test could
	-- accept a drop "through" the active pane onto a hidden slot
	-- behind it. Walk up the parent chain to confirm every ancestor
	-- is Visible; reject otherwise.
	local function isFullyVisible(inst: Instance?): boolean
		while inst and inst ~= game do
			if inst:IsA('GuiObject') and not inst.Visible then return false end
			inst = inst.Parent
		end
		return true
	end

	local function endDrag(absX: number?, absY: number?)
		if not DragState.active then return end
		local entry = DragState.entry
		DragState.active = false
		DragState.entry = nil
		if DragState.ghost then DragState.ghost:Destroy(); DragState.ghost = nil end
		if not entry or not absX or not absY then return end
		for _, dt in DropTargets do
			if not dt.frame.Parent then continue end
			if not isFullyVisible(dt.frame) then continue end
			if dt.predicate and not dt.predicate(entry) then continue end
			if pointInFrame(dt.frame, absX, absY) then
				dt.onDrop(entry)
				return
			end
		end
	end

	-- Wire global input listeners ONCE and tie their lifetime to the
	-- scope. The handlers exit early when no drag is active so cost
	-- stays minimal during normal use.
	local moveConn = UserInputService.InputChanged:Connect(function(input)
		if not DragState.active then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		setGhostPosition(input.Position.X, input.Position.Y)
	end)
	local endConn = UserInputService.InputEnded:Connect(function(input)
		if not DragState.active then return end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		endDrag(input.Position.X, input.Position.Y)
	end)
	table.insert(scope, function() moveConn:Disconnect(); endConn:Disconnect() end)

	-- Public drag API.
	local function startDrag(entry, absX, absY)
		if DragState.active then return end
		DragState.active = true
		DragState.entry = entry
		DragState.ghost = makeGhost(entry)
		setGhostPosition(absX, absY)
		-- Hide the tooltip while dragging — the ghost IS the cursor
		-- focus now and a stacked tooltip clutters the overlay.
		onHover(nil)
	end

	local function registerDropTarget(frame: GuiObject, onDrop: (entry: any) -> (), predicate: ((entry: any) -> boolean)?)
		table.insert(DropTargets, { frame = frame, onDrop = onDrop, predicate = predicate })
	end

	return {
		StartDrag = startDrag,
		RegisterDropTarget = registerDropTarget,
		IsDragging = function() return DragState.active end,
	}
end

----------------------------------------------------------------------
-- Tile builder for the inventory grid. Wraps the InventoryGrid's
-- click-only tile with a MouseButton1Down → drag-start hook so a
-- press-and-drag turns into a drag, while a press-and-release stays a
-- click. Threshold of ~6 pixels separates a click from a drag so a
-- jittery release still registers as click.
----------------------------------------------------------------------
local DRAG_THRESHOLD = 6

----------------------------------------------------------------------
-- Build a hotbar slot. Drop target = the slot itself; clicking writes
-- the staged entry, dragging onto it via the drag controller calls
-- HotbarWidget.SetSlot directly. Reads its current binding off live
-- PlayerData (DataVersion-driven Computed).
----------------------------------------------------------------------
local function buildHotbarSlot(scope, slotId: string, dataVersion, stagedEntry, onTooltip, drag)
	local HotbarWidget = require(LocalPlayerScripts:WaitForChild('Core'):WaitForChild('Widgets'):WaitForChild('HotbarWidget'))

	local slotInfo = scope:Computed(function(use)
		use(dataVersion)
		local data = Utils.getPlayerData()
		local binding = data and data.Hotbar and data.Hotbar[slotId]
		if typeof(binding) ~= 'table' then return nil end
		if binding.type == 'item' and binding.uuid then
			for itemId, uuidcache in (data.Inventory or {}) do
				local cfg = ItemsConfig.Items[itemId]
				if cfg and typeof(uuidcache) == 'table' and uuidcache[binding.uuid] then
					local label = (cfg.Display and cfg.Display.Title and cfg.Display.Title.Text) or itemId
					local rarity = cfg.Rarity or 1
					local color = Rarities.RarityColors[rarity] or PALETTE.accent
					return { kind = 'item', cfg = cfg, label = label, glyph = '\u{25C6}', color = color }
				end
			end
		elseif binding.type == 'skill' and binding.id then
			local cfg = SkillsConfig.Skills[binding.id]
			if cfg then
				return { kind = 'skill', cfg = cfg,
					label = (cfg.Display and cfg.Display.Name) or binding.id,
					glyph = '\u{2605}', color = PALETTE.violet }
			end
		end
		return nil
	end)

	local keybindText = scope:Computed(function(use)
		use(dataVersion)
		local kb = HotbarWidget.GetKeybindForSlot(slotId)
		return string.upper(kb or '')
	end)

	local btn = scope:New('TextButton') {
		Name = 'HotbarSlot_' .. slotId,
		Size = UDim2.fromOffset(HOTBAR_CELL, HOTBAR_CELL),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = '',
		[Fusion.OnEvent('Activated')] = function()
			-- Skip if a drag-end just resolved here (the drag handler
			-- already wrote the binding via the drop target below).
			if drag.IsDragging() then return end
			local entry = peek(stagedEntry)
			if entry then
				if entry.Kind == 'item' and entry.Uuid then
					HotbarWidget.SetSlot(slotId, { type = 'item', uuid = entry.Uuid })
				elseif entry.Kind == 'skill' and entry.Id then
					HotbarWidget.SetSlot(slotId, { type = 'skill', id = entry.Id })
				end
				stagedEntry:set(nil)
			else
				HotbarWidget.SetSlot(slotId, nil)
			end
		end,
		[Fusion.OnEvent('MouseEnter')] = function()
			local info = peek(slotInfo)
			if info then
				onTooltip({ Label = info.label, Sub = string.upper(info.kind), Cfg = info.cfg, Color = info.color })
			else
				onTooltip(nil)
			end
		end,
		[Fusion.OnEvent('MouseLeave')] = function() onTooltip(nil) end,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = scope:Computed(function(use)
					if use(stagedEntry) then return PALETTE.gold end
					local info = use(slotInfo)
					return (info and info.color) or PALETTE.accent
				end),
				Transparency = scope:Computed(function(use)
					return use(slotInfo) and 0.2 or 0.8
				end),
				Thickness = 1,
			},
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(0.7, 0.7),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				TextScaled = true,
				Text = scope:Computed(function(use)
					local info = use(slotInfo); return info and info.glyph or ''
				end),
				TextColor3 = scope:Computed(function(use)
					local info = use(slotInfo); return (info and info.color) or PALETTE.accent
				end),
			},
			scope:New('TextLabel') {
				Size = UDim2.fromOffset(14, 10),
				Position = UDim2.fromOffset(2, 2),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				TextSize = 9,
				TextColor3 = PALETTE.inkDim,
				Text = keybindText,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
			},
		},
	}

	-- Register as a drop target. Hotbar accepts both items and skills.
	drag.RegisterDropTarget(btn, function(entry)
		if entry.Kind == 'item' and entry.Uuid then
			HotbarWidget.SetSlot(slotId, { type = 'item', uuid = entry.Uuid })
		elseif entry.Kind == 'skill' and entry.Id then
			HotbarWidget.SetSlot(slotId, { type = 'skill', id = entry.Id })
		end
	end)

	return btn
end

local function buildHotbarMirror(scope, dataVersion, stagedEntry, onTooltip, drag)
	local rows = {}
	for r = 1, 2 do
		local cells = {}
		for c = 1, 12 do
			cells[#cells + 1] = buildHotbarSlot(scope, ('r%d_%d'):format(r, c),
				dataVersion, stagedEntry, onTooltip, drag)
		end
		rows[#rows + 1] = scope:New('Frame') {
			Name = 'Row_' .. r,
			LayoutOrder = r,
			Size = UDim2.new(1, 0, 0, HOTBAR_CELL),
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				scope:New('UIListLayout') {
					FillDirection = Enum.FillDirection.Horizontal,
					Padding = UDim.new(0, 4),
					SortOrder = Enum.SortOrder.LayoutOrder,
					HorizontalAlignment = Enum.HorizontalAlignment.Center,
				},
				table.unpack(cells),
			},
		}
	end
	return scope:New('Frame') {
		Name = 'HotbarMirror',
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
				VerticalAlignment = Enum.VerticalAlignment.Center,
			},
			table.unpack(rows),
		},
	}
end

----------------------------------------------------------------------
-- Equip slot tile (Inventory sub-tab). Drop target = the slot. The
-- predicate filters drops to items whose EquipSlots match the slot
-- token (so dragging a sword onto a Head slot is a no-op).
----------------------------------------------------------------------
local function tokenFromSlotKey(slotKey: string): (string?, number?)
	local index, token = string.match(slotKey, '^(%d+)_(.+)$')
	return token, tonumber(index)
end

-- Reverse map: token (e.g. 'Weapon') → EquipmentSlotEnums value.
local TOKEN_TO_SLOT_ENUM = {
	Weapon   = ItemsConfig.EquipmentSlotEnums.Hand,
	Head     = ItemsConfig.EquipmentSlotEnums.Head,
	Chest    = ItemsConfig.EquipmentSlotEnums.Chest,
	Legs     = ItemsConfig.EquipmentSlotEnums.Legs,
	Boots    = ItemsConfig.EquipmentSlotEnums.Boots,
	Bracelet = ItemsConfig.EquipmentSlotEnums.Bracelet,
	Neck     = ItemsConfig.EquipmentSlotEnums.Neck,
	Ear      = ItemsConfig.EquipmentSlotEnums.Ear,
	Finger   = ItemsConfig.EquipmentSlotEnums.Finger,
	Curio    = ItemsConfig.EquipmentSlotEnums.Curio,
}

local function buildEquipSlot(scope, slotKey: string, meta, dataVersion, onTooltip, drag)
	local token, slotIndex = tokenFromSlotKey(slotKey)
	local expectedEnum = token and TOKEN_TO_SLOT_ENUM[token]

	local slotInfo = scope:Computed(function(use)
		use(dataVersion)
		local data = Utils.getPlayerData()
		local equipped = (data and data.Equipped and data.Equipped[slotKey]) or nil
		if typeof(equipped) ~= 'table' then return nil end
		local itemId = equipped.itemId or equipped.ItemId
		if not itemId then return nil end
		local cfg = ItemsConfig.Items[itemId]
		if not cfg then return nil end
		return {
			cfg = cfg,
			itemId = itemId,
			uuid = equipped.uuid or equipped.UUID,
			label = (cfg.Display and cfg.Display.Title and cfg.Display.Title.Text) or itemId,
			color = Rarities.RarityColors[cfg.Rarity or 1] or PALETTE.accent,
		}
	end)

	local btn = scope:New('TextButton') {
		Name = 'EquipSlot_' .. slotKey,
		Size = UDim2.fromOffset(EQUIP_CELL, EQUIP_CELL),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = '',
		[Fusion.OnEvent('Activated')] = function()
			-- Click-on-equipped → unequip. Click-on-empty is a no-op.
			if drag.IsDragging() then return end
			local info = peek(slotInfo); if not info or not info.uuid then return end
			InventoryEvent:FireServer(info.uuid, slotIndex or 1)
		end,
		[Fusion.OnEvent('MouseEnter')] = function()
			local info = peek(slotInfo)
			if info then
				onTooltip({ Label = info.label, Sub = meta.tag, Cfg = info.cfg, Color = info.color })
			else
				onTooltip({ Label = meta.tag, Sub = 'EMPTY SLOT', Cfg = nil, Color = PALETTE.inkFaint })
			end
		end,
		[Fusion.OnEvent('MouseLeave')] = function() onTooltip(nil) end,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = scope:Computed(function(use)
					local info = use(slotInfo); return (info and info.color) or PALETTE.accent
				end),
				Transparency = scope:Computed(function(use)
					return use(slotInfo) and 0.2 or 0.7
				end),
				Thickness = 1,
			},
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(0.7, 0.6),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				TextScaled = true,
				Text = meta.glyph,
				TextColor3 = scope:Computed(function(use)
					local info = use(slotInfo); return (info and info.color) or PALETTE.inkFaint
				end),
			},
			-- Top-left tag label.
			scope:New('TextLabel') {
				Size = UDim2.fromOffset(EQUIP_CELL - 4, 10),
				Position = UDim2.fromOffset(2, 2),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				TextSize = 9,
				TextColor3 = PALETTE.inkDim,
				Text = meta.tag,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
			},
		},
	}

	-- Drop target: only items whose EquipmentData primary slot matches
	-- this slot's enum. Server still validates so a malformed predicate
	-- can't put bad state on the save.
	drag.RegisterDropTarget(btn, function(entry)
		if entry.Kind ~= 'item' or not entry.Uuid then return end
		InventoryEvent:FireServer(entry.Uuid, slotIndex or 1)
	end, function(entry)
		if entry.Kind ~= 'item' then return false end
		local cfg = entry.Cfg
		local equip = cfg and cfg.EquipmentData
		local first = equip and equip.EquipSlots and equip.EquipSlots[1]
		return first ~= nil and first.Slot == expectedEnum
	end)

	return btn
end

----------------------------------------------------------------------
-- Hover tooltip shared by both sub-tabs. Built with parent-relative
-- positioning + offset slightly to the right of the cursor.
----------------------------------------------------------------------
local function buildTooltip(scope, hoverState, mousePos)
	local visible = scope:Computed(function(use) return use(hoverState) ~= nil end)

	local bodyText = scope:Computed(function(use)
		local h = use(hoverState)
		if not h or not h.Cfg then return '' end
		local cfg = h.Cfg
		local parts = {}
		if cfg.Display and cfg.Display.Description and cfg.Display.Description.Text then
			parts[#parts + 1] = cfg.Display.Description.Text
		end
		if cfg.Cooldown and cfg.Cooldown > 0 then
			parts[#parts + 1] = string.format('Cooldown: %ss · Damage: %d (×%.2f)',
				tostring(cfg.Cooldown), (cfg.Damage and cfg.Damage.Base) or 0,
				(cfg.Damage and cfg.Damage.WeaponScale) or 1)
		end
		if cfg.EquipmentData or cfg.ConsumptionData or cfg.ActivationData then
			local stats = CombatUtility.SummarizeWeaponStats(cfg)
			for k, v in stats do parts[#parts + 1] = string.format('%s: %s', k, tostring(v)) end
		end
		return table.concat(parts, '\n')
	end)

	local frame
	frame = scope:New('Frame') {
		Name = 'EquipTooltip',
		AnchorPoint = Vector2.new(0, 0),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
		ZIndex = 50,
		Visible = visible,
		Position = scope:Computed(function(use)
			local m = use(mousePos)
			local parentAbs = (frame and frame.Parent
				and (frame.Parent :: GuiObject).AbsolutePosition)
				or Vector2.zero
			local inset = GuiService:GetGuiInset()
			-- Offset further right than the original (8 → 20) per
			-- request. 22 px down keeps the tooltip top below the
			-- cursor's lower edge.
			local x = math.floor(m.X - parentAbs.X - inset.X + TOOLTIP_OFFSET.X)
			local y = math.floor(m.Y - parentAbs.Y - inset.Y + TOOLTIP_OFFSET.Y)
			return UDim2.fromOffset(x, y)
		end),
		Size = UDim2.fromOffset(260, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = scope:Computed(function(use)
					local h = use(hoverState); return (h and h.Color) or PALETTE.accent
				end),
				Transparency = 0.3, Thickness = 1,
			},
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
				PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
			},
			scope:New('UIListLayout') { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder },
			scope:New('TextLabel') {
				LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 18),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = scope:Computed(function(use) local h = use(hoverState); return h and h.Label or '' end),
				TextSize = 16, TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 12),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use) local h = use(hoverState); return h and h.Sub or '' end),
				TextSize = 10, TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = bodyText,
				TextSize = 12, TextColor3 = PALETTE.inkDim,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
			},
		},
	}
	return frame
end

----------------------------------------------------------------------
-- Sub-tab selector. Two pill buttons at the top; clicking switches
-- which sub-pane is visible.
----------------------------------------------------------------------
local function buildSubtabBar(scope, currentSubtab)
	local function pill(id: string, label: string, order: number)
		local active = scope:Computed(function(use) return use(currentSubtab) == id end)
		return scope:New('TextButton') {
			LayoutOrder = order,
			Size = UDim2.fromOffset(140, 30),
			BackgroundColor3 = scope:Computed(function(use)
				return use(active) and PALETTE.accent or PALETTE.bg0
			end),
			BackgroundTransparency = scope:Computed(function(use)
				return use(active) and 0.5 or 0.3
			end),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			FontFace = HUDCommon.FONT_BUTTON,
			Text = label,
			TextSize = 13,
			TextColor3 = scope:Computed(function(use)
				return use(active) and PALETTE.ink or PALETTE.inkDim
			end),
			[Fusion.OnEvent('Activated')] = function() currentSubtab:set(id) end,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
			},
		}
	end
	return scope:New('Frame') {
		Name = 'SubtabBar',
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			pill('hotbar', 'HOTBAR', 1),
			pill('inventory', 'INVENTORY', 2),
		},
	}
end

----------------------------------------------------------------------
-- Build(ctx)
----------------------------------------------------------------------
function Module.Build(ctx)
	local scope = ctx.scope
	local DataVersion = ctx.DataVersion

	-- Shared state across both sub-tabs.
	local HoverState = scope:Value(nil :: any)
	local StagedEntry = scope:Value(nil :: any)
	local CurrentSubtab = scope:Value('hotbar')

	-- Mouse tracker for the tooltip.
	local mousePos = scope:Value(Vector2.zero)
	local moveConn = UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			mousePos:set(Vector2.new(input.Position.X, input.Position.Y))
		end
	end)
	table.insert(scope, function() if moveConn then moveConn:Disconnect() end end)

	-- Tab root — built up-front so the drag controller can parent its
	-- ghost frame inside it (covers the whole tab; rect computations
	-- become straightforward). Built via scope:New so cleanup cascades
	-- correctly when the scope is doCleanup'd by a theme rebuild.
	local rootFrame = scope:New('Frame') {
		Name = 'EquipTab',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
	}

	local drag = buildDragController(scope, rootFrame, function(state)
		HoverState:set(state)
	end)

	-- Inventory grid factory — used by both sub-tabs with different
	-- section configs. The OnEntryClick / OnEntryHover callbacks are
	-- shared (stage / hover); the OnEntryDragStart adapts to the
	-- single drag controller.
	local function makeGrid(sections)
		return InventoryGrid.build(scope, {
			DataVersion = DataVersion,
			Sections = sections,
			OnEntryClick = function(entry)
				-- Click-stage path. Same as before — staged entry placed
				-- on next click of a hotbar/equip slot.
				local current = peek(StagedEntry)
				if current
					and current.Kind == entry.Kind
					and current.Id == entry.Id
					and current.Uuid == entry.Uuid then
					-- Second click on same entry: clear the stage.
					StagedEntry:set(nil)
				else
					StagedEntry:set(entry)
				end
			end,
			OnEntryHover = function(entry)
				if entry then
					local sub
					if entry.Kind == 'skill' then
						sub = SkillsShared.IsPassiveSkill(entry.Id) and 'PASSIVE SKILL' or 'SKILL'
					else
						sub = 'ITEM'
					end
					HoverState:set({ Label = entry.Label, Sub = sub, Cfg = entry.Cfg, Color = entry.Color })
				else
					HoverState:set(nil)
				end
			end,
			OnEntryDragStart = function(entry, x, y)
				StagedEntry:set(nil)  -- stage state is mutually exclusive with drag
				drag.StartDrag(entry, x, y)
			end,
			DragThreshold = DRAG_THRESHOLD,
		})
	end

	----------------------------------------------------------------------
	-- HOTBAR sub-pane.
	----------------------------------------------------------------------
	-- Hotbar accepts only skills + food + potions per design. Filtering
	-- happens in the section resolvers (tag-driven for items, Passive
	-- filter for skills) so weapons / tools / candy / scrolls don't
	-- surface as bindable here. Bindings the player has to OTHER kinds
	-- (set elsewhere) still render on the hotbar mirror; the inventory
	-- grid below is just the source-side filter.
	local hotbarGrid = makeGrid({
		{ Id = 'skills',  Label = 'Skills',  Resolve = InventoryGrid.SkillEntries },
		{ Id = 'food',    Label = 'Food',    Resolve = InventoryGrid.FoodItemEntries },
		{ Id = 'potions', Label = 'Potions', Resolve = InventoryGrid.PotionItemEntries },
	})

	local hotbarPane = scope:New('Frame') {
		Name = 'HotbarPane',
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Visible = scope:Computed(function(use) return use(CurrentSubtab) == 'hotbar' end),
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(PANE_GAP / TAB_DESIGN_H, 0),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- Top pane: hotbar mirror. ~32% of the inner content area
			-- (gives the 2 hotbar rows breathing room above the grid).
			scope:New('Frame') {
				LayoutOrder = 1,
				Size = UDim2.fromScale(1, 0.32),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.4,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.7, Thickness = 1 },
					scope:New('UIPadding') {
						PaddingTop    = UDim.new(INNER_PAD_Y / TAB_DESIGN_H, 0),
						PaddingBottom = UDim.new(INNER_PAD_Y / TAB_DESIGN_H, 0),
						PaddingLeft   = UDim.new(INNER_PAD_X / TAB_DESIGN_W, 0),
						PaddingRight  = UDim.new(INNER_PAD_X / TAB_DESIGN_W, 0),
					},
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding = UDim.new(6 / TAB_DESIGN_H, 0),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					Utils.eyebrow(scope, '\u{25C6} HOTBAR — DROP OR CLICK TO BIND', { LayoutOrder = 1 }),
					scope:New('Frame') {
						LayoutOrder = 2,
						Size = UDim2.new(1, 0, 1, -16),
						BackgroundTransparency = 1,
						[Fusion.Children] = { buildHotbarMirror(scope, DataVersion, StagedEntry,
							function(s) HoverState:set(s) end, drag) },
					},
				},
			},
			-- Bottom pane: inventory grid. ~68% of the inner content
			-- area; both panes' Scale values sum to 1.0 so the parent
			-- list-layout's gap fills any rounding via its Padding entry.
			scope:New('Frame') {
				LayoutOrder = 2,
				Size = UDim2.fromScale(1, 0.68),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.4,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.7, Thickness = 1 },
					scope:New('UIPadding') {
						PaddingTop    = UDim.new(INNER_PAD_Y / TAB_DESIGN_H, 0),
						PaddingBottom = UDim.new(INNER_PAD_Y / TAB_DESIGN_H, 0),
						PaddingLeft   = UDim.new(INNER_PAD_X / TAB_DESIGN_W, 0),
						PaddingRight  = UDim.new(INNER_PAD_X / TAB_DESIGN_W, 0),
					},
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding = UDim.new(0, 6),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					scope:New('Frame') {
						LayoutOrder = 1,
						Size = UDim2.new(1, 0, 0, 16),
						BackgroundTransparency = 1,
						[Fusion.Children] = {
							Utils.eyebrow(scope, '\u{25C6} INVENTORY — DRAG OR CLICK A TILE', { LayoutOrder = 1 }),
							scope:New('TextLabel') {
								AnchorPoint = Vector2.new(1, 0),
								Position = UDim2.fromScale(1, 0),
								Size = UDim2.fromOffset(220, 16),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_MONO,
								TextSize = 10,
								TextColor3 = PALETTE.gold,
								TextXAlignment = Enum.TextXAlignment.Right,
								Text = scope:Computed(function(use)
									local s = use(StagedEntry)
									return s and string.format('STAGED: %s', tostring(s.Label)) or ''
								end),
							},
						},
					},
					scope:New('Frame') {
						LayoutOrder = 2,
						Size = UDim2.new(1, 0, 1, -22),
						BackgroundTransparency = 1,
						[Fusion.Children] = { hotbarGrid.Frame },
					},
				},
			},
		},
	}

	----------------------------------------------------------------------
	-- INVENTORY sub-pane: equip slots column + equippable inventory grid.
	----------------------------------------------------------------------
	local equipSlotEntries = {}
	for slotKey, meta in EQUIP_SLOT_META do
		local cell = buildEquipSlot(scope, slotKey, meta, DataVersion,
			function(s) HoverState:set(s) end, drag)
		cell.LayoutOrder = meta.order
		equipSlotEntries[#equipSlotEntries + 1] = cell
	end
	local equipSlotsFrame = scope:New('Frame') {
		Name = 'EquipSlots',
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIGridLayout') {
				CellSize = UDim2.fromOffset(EQUIP_CELL, EQUIP_CELL),
				CellPadding = UDim2.fromOffset(8, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
			},
			table.unpack(equipSlotEntries),
		},
	}

	local equipGrid = makeGrid({
		{ Id = 'weapons',     Label = 'Weapons',     Resolve = InventoryGrid.WeaponItemEntries },
		{ Id = 'tools',       Label = 'Tools',       Resolve = InventoryGrid.ToolItemEntries },
		{ Id = 'armor',       Label = 'Armor',       Resolve = InventoryGrid.ArmorItemEntries },
		{ Id = 'accessories', Label = 'Accessories', Resolve = InventoryGrid.AccessoryItemEntries },
	})

	-- Inventory sub-pane column widths expressed as design-canvas
	-- fractions (matches CharacterTab's column pattern). The rail width
	-- = 280 design pixels; gap = 12 design pixels; right column is the
	-- remaining scale. Pure-scale widths preserve aspect on resize.
	local INV_RAIL_PX = 280
	local INV_COL_GAP = 12
	local INV_RAIL_SCALE  = INV_RAIL_PX / TAB_DESIGN_W
	local INV_GAP_SCALE   = INV_COL_GAP / TAB_DESIGN_W
	local INV_RIGHT_SCALE = 1 - INV_RAIL_SCALE - INV_GAP_SCALE

	local inventoryPane = scope:New('Frame') {
		Name = 'InventoryPane',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = scope:Computed(function(use) return use(CurrentSubtab) == 'inventory' end),
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(INV_GAP_SCALE, 0),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- Left: equip slots column.
			scope:New('Frame') {
				LayoutOrder = 1,
				Size = UDim2.fromScale(INV_RAIL_SCALE, 1),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.4,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.7, Thickness = 1 },
					scope:New('UIPadding') {
						PaddingTop    = UDim.new(INNER_PAD_Y / TAB_DESIGN_H, 0),
						PaddingBottom = UDim.new(INNER_PAD_Y / TAB_DESIGN_H, 0),
						PaddingLeft   = UDim.new(INNER_PAD_X / TAB_DESIGN_W, 0),
						PaddingRight  = UDim.new(INNER_PAD_X / TAB_DESIGN_W, 0),
					},
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding = UDim.new(8 / TAB_DESIGN_H, 0),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					Utils.eyebrow(scope, '\u{25C6} EQUIPPED', { LayoutOrder = 1 }),
					scope:New('Frame') {
						LayoutOrder = 2,
						Size = UDim2.new(1, 0, 1, -22),
						BackgroundTransparency = 1,
						[Fusion.Children] = { equipSlotsFrame },
					},
				},
			},
			-- Right: inventory grid for equippables.
			scope:New('Frame') {
				LayoutOrder = 2,
				Size = UDim2.fromScale(INV_RIGHT_SCALE, 1),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.4,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.7, Thickness = 1 },
					scope:New('UIPadding') {
						PaddingTop    = UDim.new(INNER_PAD_Y / TAB_DESIGN_H, 0),
						PaddingBottom = UDim.new(INNER_PAD_Y / TAB_DESIGN_H, 0),
						PaddingLeft   = UDim.new(INNER_PAD_X / TAB_DESIGN_W, 0),
						PaddingRight  = UDim.new(INNER_PAD_X / TAB_DESIGN_W, 0),
					},
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding = UDim.new(0, 6),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					Utils.eyebrow(scope, '\u{25C6} INVENTORY — DRAG OR CLICK A TILE', { LayoutOrder = 1 }),
					scope:New('Frame') {
						LayoutOrder = 2,
						Size = UDim2.new(1, 0, 1, -22),
						BackgroundTransparency = 1,
						[Fusion.Children] = { equipGrid.Frame },
					},
				},
			},
		},
	}

	----------------------------------------------------------------------
	-- Assemble the tab.
	----------------------------------------------------------------------
	local subtabBar = buildSubtabBar(scope, CurrentSubtab)
	local tooltip = buildTooltip(scope, HoverState, mousePos)

	-- Wrapper: subtab bar + sub-panes. NOT inside the tab root's main
	-- layout — sibling of the tooltip + drag-ghost so layout lives in
	-- one place.
	-- panesWrapper wraps the subtab bar + active-pane host. Lives at
	-- fromScale(1,1) inside the aspect-locked tab root so its descendants
	-- stay proportional. Outer UIPadding + UIListLayout gap are expressed
	-- as design-canvas fractions (matches CharacterTab's pattern) so they
	-- scale with the tab on smaller screens instead of staying fixed in
	-- pixel space.
	local panesWrapper = scope:New('Frame') {
		Name = 'PanesWrapper',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(OUTER_PAD_Y / TAB_DESIGN_H, 0),
				PaddingBottom = UDim.new(OUTER_PAD_Y / TAB_DESIGN_H, 0),
				PaddingLeft   = UDim.new(OUTER_PAD_X / TAB_DESIGN_W, 0),
				PaddingRight  = UDim.new(OUTER_PAD_X / TAB_DESIGN_W, 0),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(PANE_GAP / TAB_DESIGN_H, 0),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			subtabBar,
			-- Active-pane host. Both panes are siblings; their Visible
			-- bindings track CurrentSubtab so only one shows at a time.
			-- Height fills whatever remains after the 36 px subtab bar
			-- + the layout's per-design gap.
			scope:New('Frame') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 1, -(36 + PANE_GAP)),
				BackgroundTransparency = 1,
				[Fusion.Children] = { hotbarPane, inventoryPane },
			},
		},
	}
	panesWrapper.Parent = rootFrame
	tooltip.Parent = rootFrame

	return rootFrame
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/TabWidget/components.luau"><![CDATA[-- // TabWidget/components.luau //
-- Reusable composite components (React-style "smart" widgets) with their
-- own Fusion reactivity baked in.
--
-- Design contract:
--   * Every component here takes `(scope, props)` and returns a GuiObject.
--   * `props.isActive` (or equivalent) is expected to be a Fusion StateObject
--     so active-state styling binds reactively; a plain boolean is fine too
--     for static callers.
--   * Components don't own their own scope lifetime — they use the scope the
--     caller passes in, so cleanup cascades naturally from the caller's tab.
--
-- Component catalogue:
--   * RailButton — vertical nav button with left active stripe + optional
--     glyph + label + optional right-aligned chip. Covers three variants:
--       - main tab rail     (glyph='◆', label, no chip, scale stripe)
--       - social submenu    (glyph='◆', label, numeric count chip, scale stripe)
--       - schools column    (no glyph, label, string rank chip, pixel stripe)
--
-- Planned additions (not yet implemented):
--   * CategoryPill    — horizontal bordered chip with icon + label + count
--   * StatValueCard   — eyebrow above a big mono number
--   * ChipRow         — wraps text entries as small accent-bordered pills

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local Module = {}

-- Chip props consumed by RailButton's optional right-aligned badge.
--   text  : string | Fusion.StateObject<any>    — rendered via tostring()
--   color : Color3 | Fusion.StateObject<Color3>? — text color; Fusion binds
--                                                   StateObjects reactively.
--                                                   Default PALETTE.inkFaint.
--   font  : Enum.Font?                           — default FONT_MONO
--   width : number?                              — pixel width, default 40
export type ChipProps = {
	text  : any,
	color : any?,
	font  : Enum.Font?,
	width : number?,
}

-- Resolve a value that might be a Fusion StateObject OR a plain value.
-- Components use this to accept both "static" and "reactive" chip inputs
-- without branching downstream — if it's a StateObject, scope:Computed
-- re-evaluates on change; if not, the Computed just returns the constant.
local function bindText(scope, value)
	-- Cheap structural check: Fusion StateObjects are tables with an
	-- internal `_value`/`_computeCallback` field. Wrapping in a Computed
	-- handles both cases uniformly.
	return scope:Computed(function(use)
		if typeof(value) == 'table' and typeof((value :: any).get) == 'function' then
			return tostring(use(value))
		end
		return tostring(value)
	end)
end

----------------------------------------------------------------------
-- RailButton — vertical-list nav button with a stripe + glyph + label +
--              chip.
----------------------------------------------------------------------
-- Structure (two-frame split):
--   TextButton (no padding, no list layout)
--     ├── ActiveStripe  (UDim-sized, pinned left, visible when active)
--     └── Content Frame (UIPadding + UIListLayout horizontal + children)
-- The split keeps the stripe at the button's TRUE left edge — if the
-- stripe shared the content frame it'd get pushed inward by UIPadding
-- and swept into the horizontal flow by UIListLayout.
--
-- Props:
--   isActive   : Fusion.StateObject<boolean>   (required)
--   label      : string                         (required)
--   glyph      : string?                        (optional; nil = no leading glyph)
--   chip       : ChipProps?                     (optional right-aligned chip)
--   onActivate : () -> ()                       (required)
--   height     : number?                        (default 38 px)
--   stripe     : UDim?                          (default UDim.new(0.05, 0) = 5% scale wide;
--                                                pass UDim.new(0, 2) for a 2-px pixel stripe)
--   labelColor : Color3 | StateObject<Color3>?  (overrides the default
--                                                 isActive→accent/ink scheme. Lets the
--                                                 caller paint the label e.g. gold when
--                                                 the row has a claimable reward in it.)
--   glyphColor : Color3 | StateObject<Color3>?  (same override for the optional glyph.)
--   aspectRatio: number?                        (when set, the button is shape-locked
--                                                 to this width/height via a
--                                                 UIAspectRatioConstraint and ALL its
--                                                 internals — paddings, gutters, glyph/
--                                                 chip rects, and text (TextScaled) —
--                                                 become pure-scale fractions of the
--                                                 design canvas height*aspectRatio × height.
--                                                 The button then scales with resolution
--                                                 instead of staying a fixed pixel height.
--                                                 Pass railContentWidthPx / heightPx.
--                                                 Omit it for the legacy fixed-pixel
--                                                 behaviour. See custom-roblox-ui §2/§8.)
function Module.RailButton(scope, props: {
	isActive   : any,
	label      : string,
	glyph      : string?,
	chip       : ChipProps?,
	onActivate : () -> (),
	height     : number?,
	stripe     : UDim?,
	labelColor : any?,
	glyphColor : any?,
	aspectRatio: number?,
})
	local isActive = props.isActive
	local height   = props.height or 38
	local stripe   = props.stripe or UDim.new(0.05, 0)
	local chip     = props.chip
	local hasGlyph = props.glyph ~= nil and props.glyph ~= ''

	-- Scale mode: when an aspectRatio is given the whole button is a scaled
	-- design canvas of (height * aspectRatio) × height px. Every interior px
	-- becomes a fraction of that canvas so it scales as one unit; text uses
	-- TextScaled trimmed back to its design size with inner padding (the same
	-- TextScaled+padding idiom as TabWidget/init.luau). Without aspectRatio we
	-- keep the legacy fixed-pixel layout untouched.
	local scaleMode = props.aspectRatio ~= nil
	local designW   = scaleMode and (height * (props.aspectRatio :: number)) or 0

	-- Design text sizes (px). Used as literal TextSize in pixel mode, or as the
	-- TextScaled target proportion (via vertical inner padding) in scale mode.
	local GLYPH_TS, LABEL_TS, CHIP_TS = 14, 13, 10

	-- px → horizontal scale (fraction of design width). Identity (offset) in
	-- pixel mode.
	local function ux(px: number): UDim
		return scaleMode and UDim.new(px / designW, 0) or UDim.new(0, px)
	end
	-- A child rect from design px (w, h). Scale fractions in scale mode.
	local function sz(w: number, h: number): UDim2
		return scaleMode and UDim2.fromScale(w / designW, h / height) or UDim2.fromOffset(w, h)
	end
	-- Vertical inner-padding node that trims TextScaled to `ts` px within a
	-- `rectPx`-tall rect. Returns nil in pixel mode (TextSize handles sizing).
	local function trim(ts: number, rectPx: number)
		if not scaleMode then return nil end
		local f = math.clamp((1 - ts / rectPx) / 2, 0, 0.45)
		return scope:New('UIPadding') {
			PaddingTop = UDim.new(f, 0), PaddingBottom = UDim.new(f, 0),
		}
	end

	-- Dynamic gutter widths so the label always gets the right remainder.
	-- Glyph takes 16 + 12 px (icon + gap); chip takes (chip.width + 8 px gap).
	-- The label's Size.X.Offset = negative sum so it flexes to fill.
	local chipWidth = (chip and chip.width) or 40
	local labelOffsetX = 0
	if hasGlyph then labelOffsetX += 16 + 12 end
	if chip     then labelOffsetX += chipWidth + 8 end
	-- Label fills the remainder; in scale mode the negative px offset becomes a
	-- subtracted scale fraction of the design width.
	local labelSize = scaleMode
		and UDim2.new(1 - labelOffsetX / designW, 0, 1, 0)
		or  UDim2.new(1, -labelOffsetX, 1, 0)

	local glyphTrim = trim(GLYPH_TS, 16)
	local labelTrim = trim(LABEL_TS, height)
	local chipTrim  = trim(CHIP_TS, 14)

	local contentChildren: {any} = {
		scope:New('UIPadding') {
			PaddingLeft  = ux(24),
			PaddingRight = ux(chip and 12 or 20),
		},
		scope:New('UIListLayout') {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = ux(12),
			SortOrder = Enum.SortOrder.LayoutOrder,
		},
	}

	if hasGlyph then
		table.insert(contentChildren, scope:New('TextLabel') {
			LayoutOrder = 1,
			Size = sz(16, 16),
			BackgroundTransparency = 1,
			FontFace = HUDCommon.FONT_MONO,
			Text = props.glyph,
			TextScaled = scaleMode or nil,
			TextSize = (not scaleMode) and GLYPH_TS or nil,
			TextColor3 = scope:Computed(function(use)
				-- Glyph color override wins. Otherwise default to the
				-- isActive-derived accent / inkDim. Reusing bindText
				-- handles both StateObject and plain-Color3 inputs.
				if props.glyphColor ~= nil then
					return (typeof(props.glyphColor) == 'table' and typeof((props.glyphColor :: any).get) == 'function')
						and use(props.glyphColor :: any) or props.glyphColor
				end
				return use(isActive) and PALETTE.accent or PALETTE.inkDim
			end),
			[Fusion.Children] = glyphTrim and { glyphTrim } or nil,
		})
	end

	table.insert(contentChildren, scope:New('TextLabel') {
		LayoutOrder = 2,
		-- Label flexes to fill remaining width after the optional glyph + chip.
		Size = labelSize,
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_BUTTON,
		Text = string.upper(props.label),
		TextScaled = scaleMode or nil,
		TextSize = (not scaleMode) and LABEL_TS or nil,
		TextColor3 = scope:Computed(function(use)
			-- Caller-provided labelColor overrides the default scheme.
			-- Used by AchievementsTab to flag categories that have a
			-- claimable reward sitting unclaimed. Falls back to the
			-- standard isActive→accent/ink for non-overriding callers.
			if props.labelColor ~= nil then
				return (typeof(props.labelColor) == 'table' and typeof((props.labelColor :: any).get) == 'function')
					and use(props.labelColor :: any) or props.labelColor
			end
			return use(isActive) and PALETTE.accent or PALETTE.ink
		end),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		-- TextScaled shrinks to fit, so truncation only applies in pixel mode.
		TextTruncate = (not scaleMode) and Enum.TextTruncate.AtEnd or nil,
		[Fusion.Children] = labelTrim and { labelTrim } or nil,
	})

	if chip then
		table.insert(contentChildren, scope:New('TextLabel') {
			LayoutOrder = 3,
			Size = sz(chipWidth, 14),
			BackgroundTransparency = 1,
			FontFace = chip.font or HUDCommon.FONT_MONO,
			Text = bindText(scope, chip.text),
			TextScaled = scaleMode or nil,
			TextSize = (not scaleMode) and CHIP_TS or nil,
			TextColor3 = chip.color or PALETTE.inkFaint,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextYAlignment = Enum.TextYAlignment.Center,
			[Fusion.Children] = chipTrim and { chipTrim } or nil,
		})
	end

	local contentFrame = scope:New('Frame') {
		Name = 'Content',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = contentChildren,
	}

	-- In scale mode the button fills the rail width and the aspect constraint
	-- derives its height (width / aspectRatio) — so it scales with the rail
	-- rather than capping at a fixed pixel height. Size.Y = 1 is just a
	-- generous max bound (FitWithinMaxSize, Width-dominant → width always wins).
	local buttonChildren: {any} = {
		-- Active stripe — parented directly to the button (not the
		-- padded Content frame) so AnchorPoint + Position land at the
		-- button's true left edge. Size uses UDim so callers can supply
		-- either scale (UDim.new(0.1, 0)) or pixel (UDim.new(0, 2)).
		scope:New('Frame') {
			Name = 'ActiveStripe',
			AnchorPoint = Vector2.new(0, 0),
			Position = UDim2.fromScale(0, 0),
			Size = UDim2.new(stripe.Scale, stripe.Offset, 1, 0),
			BackgroundColor3 = PALETTE.accent,
			BorderSizePixel = 0,
			Visible = isActive,
		},
		contentFrame,
	}
	if scaleMode then
		table.insert(buttonChildren, 1, scope:New('UIAspectRatioConstraint') {
			AspectRatio = props.aspectRatio,
			AspectType = Enum.AspectType.FitWithinMaxSize,
			DominantAxis = Enum.DominantAxis.Width,
		})
	end

	return scope:New('TextButton') {
		Size = scaleMode and UDim2.new(1, 0, 1, 0) or UDim2.new(1, 0, 0, height),
		BackgroundColor3 = PALETTE.accent,
		BackgroundTransparency = scope:Computed(function(use)
			return use(isActive) and 0.85 or 1
		end),
		BorderSizePixel = 0,
		AutoButtonColor = false,
		FontFace = HUDCommon.FONT_BUTTON,
		Text = '',
		[Fusion.OnEvent('Activated')] = props.onActivate,
		[Fusion.Children] = buttonChildren,
	}
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/TabWidget/inventoryGrid.luau"><![CDATA[-- // TabWidget/inventoryGrid.luau //
--
-- Section-grouped scrolling tile grid used by both ToolbarTab (skills +
-- usables) and CharacterTab (equippables). Each section holds a list of
-- "entries" — uniform-shape descriptors of an item or skill the player
-- owns.
--
-- Entry shape (return value of each section's `Resolve(saveData)`):
--   {
--     Kind  : 'item' | 'skill',
--     Id    : string,         -- itemId for 'item', skillId for 'skill'
--     Uuid  : string?,        -- inventory uuid for items; nil for skills
--     Cfg   : any,            -- ItemsConfig or SkillsConfig entry
--     Label : string,         -- pre-resolved display name
--     Sub   : string?,        -- optional sublabel (e.g. quantity / cost)
--     Color : Color3?,        -- optional rarity/element accent
--     Glyph : string?,        -- icon glyph fallback when no viewport model
--   }
--
-- Section shape (passed to `build`):
--   {
--     Id      : string,                                 -- stable section key
--     Label   : string,                                 -- eyebrow text
--     Resolve : (saveData) -> { Entry }                 -- entries to render
--   }
--
-- Usage:
--   local grid = inventoryGrid.build(scope, {
--     DataVersion = ctx.DataVersion,
--     Sections    = {...},
--     OnEntryClick = function(entry) ... end,
--     OnEntryHover = function(entry?) ... end,   -- nil on leave
--   })
--   grid.Frame  -- parent into your column
--
-- The grid does NOT host its own tooltip frame — callers route hover events
-- to whatever tooltip surface they own (the tab usually has one already).

local Players = game:GetService('Players')
local UserInputService = game:GetService('UserInputService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local Utils = require(script.Parent:WaitForChild('utils'))

local Module = {}

----------------------------------------------------------------------
-- Tile constants. Square tiles in a fixed grid; the section frame's
-- AutomaticSize.Y handles overflow.
----------------------------------------------------------------------
local TILE_W = 64
local TILE_H = 64
local TILE_GAP = 6
local SECTION_GAP = 12

----------------------------------------------------------------------
-- Build a single entry tile. Press-and-hold gesture detection: a press
-- without movement fires `onClick`; a press + cursor movement past
-- `dragThreshold` pixels fires `onDragStart` (the drag controller in
-- the consumer takes over from there).
--
-- The connection lifetime is tied to the press cycle — moveConn /
-- endConn are connected on `InputBegan` and disconnected on either
-- drag-start or release. The `Destroying` cleanup catches the case
-- where the tile is destroyed mid-press (e.g. ForPairs rebuilds the
-- grid while the user is still holding the mouse button).
----------------------------------------------------------------------
local function buildTile(scope, entry, onClick, onHover, onDragStart, dragThreshold)
	local accent = entry.Color or PALETTE.accent
	dragThreshold = dragThreshold or 6

	local pressed = false
	local pressStart = Vector2.zero
	local dragHandled = false
	local moveConn: RBXScriptConnection?
	local endConn: RBXScriptConnection?

	local function cleanupPress()
		pressed = false
		if moveConn then moveConn:Disconnect(); moveConn = nil end
		if endConn then endConn:Disconnect(); endConn = nil end
	end

	local tile = scope:New('TextButton') {
		Name = entry.Kind .. '_' .. tostring(entry.Id),
		Size = UDim2.fromOffset(TILE_W, TILE_H),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = '',
		-- No `Activated` here — we drive click vs drag from raw input
		-- events so the press → release → click branch only fires when
		-- the cursor stayed put (mirrors the standard drag-vs-click
		-- gesture rule used by every desktop drag-and-drop UI).
		[Fusion.OnEvent('MouseEnter')] = function() if onHover then onHover(entry) end end,
		[Fusion.OnEvent('MouseLeave')] = function() if onHover then onHover(nil) end end,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = accent, Transparency = 0.55, Thickness = 1 },
			scope:New('UICorner') { CornerRadius = UDim.new(0, 4) },
			-- Glyph is a centered icon when no viewport ships. Keeps the
			-- per-tile cost low — TextLabel only, no Viewport.
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(0.7, 0.7),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = entry.Glyph or '◆',
				TextScaled = true,
				TextColor3 = accent,
			},
			-- Optional bottom-right sublabel (e.g. stack quantity, level).
			entry.Sub and scope:New('TextLabel') {
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -3, 1, -2),
				Size = UDim2.fromOffset(40, 12),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = entry.Sub,
				TextSize = 10,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Right,
				TextStrokeTransparency = 0.4,
				TextStrokeColor3 = PALETTE.bg0,
			} or nil,
		},
	}

	-- Press → click/drag dispatch. InputBegan on the tile starts a
	-- press cycle; the global InputChanged + InputEnded handlers
	-- decide which branch to fire.
	tile.InputBegan:Connect(function(input)
		if pressed then return end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		pressed = true
		pressStart = Vector2.new(input.Position.X, input.Position.Y)
		dragHandled = false

		moveConn = UserInputService.InputChanged:Connect(function(moveInput)
			if not pressed or dragHandled then return end
			if moveInput.UserInputType ~= Enum.UserInputType.MouseMovement
				and moveInput.UserInputType ~= Enum.UserInputType.Touch then return end
			local pos = Vector2.new(moveInput.Position.X, moveInput.Position.Y)
			if (pos - pressStart).Magnitude > dragThreshold then
				dragHandled = true
				if onDragStart then
					onDragStart(entry, moveInput.Position.X, moveInput.Position.Y)
				end
				cleanupPress()
			end
		end)

		endConn = UserInputService.InputEnded:Connect(function(endInput)
			if endInput.UserInputType ~= Enum.UserInputType.MouseButton1
				and endInput.UserInputType ~= Enum.UserInputType.Touch then return end
			-- Release without surpassing the drag threshold counts as a click.
			if pressed and not dragHandled and onClick then
				onClick(entry)
			end
			cleanupPress()
		end)
	end)
	tile.Destroying:Connect(cleanupPress)

	return tile
end

----------------------------------------------------------------------
-- Build the grid. Returns { Frame } so callers can parent the result.
----------------------------------------------------------------------
function Module.build(scope, props: {
	DataVersion: any,
	Sections: { { Id: string, Label: string, Resolve: (any) -> { any } } },
	OnEntryClick: (any) -> (),
	OnEntryHover: (any?) -> (),
	-- Optional drag-start hook: (entry, absX, absY) — fired when the
	-- cursor moves past `DragThreshold` pixels while the tile is held.
	OnEntryDragStart: ((any, number, number) -> ())?,
	DragThreshold: number?,
})
	-- Frame layout:
	--   ScrollingFrame (vertical scroll, content auto-sizes)
	--     UIListLayout (vertical, gap = SECTION_GAP)
	--     for each section:
	--       Section frame
	--         eyebrow label
	--         tile container (grid layout, auto-sized Y)
	local sectionFrames = {}
	for sectionIdx, section in props.Sections do
		-- Per-section tile container. ForPairs over a Computed pulls
		-- entries from the section's Resolve(saveData) function so the
		-- grid stays reactive as PlayerData ticks.
		local tilesFrame = scope:New('Frame') {
			Name = 'Tiles',
			LayoutOrder = 2,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				scope:New('UIGridLayout') {
					CellSize = UDim2.fromOffset(TILE_W, TILE_H),
					CellPadding = UDim2.fromOffset(TILE_GAP, TILE_GAP),
					SortOrder = Enum.SortOrder.LayoutOrder,
					HorizontalAlignment = Enum.HorizontalAlignment.Left,
					StartCorner = Enum.StartCorner.TopLeft,
					FillDirectionMaxCells = 0,  -- auto-fill rows by available width
				},
				scope:ForPairs(
					scope:Computed(function(use)
						use(props.DataVersion)
						local saveData = Utils.getPlayerData()
						local entries = section.Resolve(saveData) or {}
						return entries
					end),
					function(_use, innerScope, idx, entry)
						local key = entry.Kind .. ':' .. tostring(entry.Id) .. ':' .. tostring(entry.Uuid or idx)
						local tile = buildTile(innerScope, entry,
							props.OnEntryClick, props.OnEntryHover,
							props.OnEntryDragStart, props.DragThreshold)
						tile.LayoutOrder = idx
						return key, tile
					end
				),
			},
		}

		-- Empty-state hint for sections with no entries. ForPairs naturally
		-- collapses to zero children, leaving an awkward gap; a plain text
		-- label that fades when entries appear keeps the section readable.
		local emptyLabel = scope:New('TextLabel') {
			LayoutOrder = 3,
			Size = UDim2.new(1, 0, 0, 18),
			BackgroundTransparency = 1,
			FontFace = HUDCommon.FONT_MONO,
			Text = '— none —',
			TextSize = 10,
			TextColor3 = PALETTE.inkFaint,
			TextXAlignment = Enum.TextXAlignment.Left,
			Visible = scope:Computed(function(use)
				use(props.DataVersion)
				local saveData = Utils.getPlayerData()
				local entries = section.Resolve(saveData) or {}
				return #entries == 0
			end),
		}

		table.insert(sectionFrames, scope:New('Frame') {
			Name = 'Section_' .. section.Id,
			LayoutOrder = sectionIdx,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				scope:New('UIListLayout') {
					FillDirection = Enum.FillDirection.Vertical,
					Padding = UDim.new(0, 4),
					SortOrder = Enum.SortOrder.LayoutOrder,
				},
				Utils.eyebrow(scope, '\u{25C6} ' .. string.upper(section.Label), { LayoutOrder = 1 }),
				tilesFrame,
				emptyLabel,
			},
		})
	end

	local frame = scope:New('ScrollingFrame') {
		Name = 'InventoryGridScroll',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = true,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = PALETTE.accent,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		CanvasSize = UDim2.fromOffset(0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ElasticBehavior = Enum.ElasticBehavior.Never,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, SECTION_GAP),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- Pad the right edge so tiles don't crowd the scrollbar.
			scope:New('UIPadding') { PaddingRight = UDim.new(0, 8) },
			table.unpack(sectionFrames),
		},
	}

	return { Frame = frame }
end

----------------------------------------------------------------------
-- Shared section resolvers. Reading the live save struct + transforming
-- to Entry shape lives here so multiple tabs use the same predicate
-- definitions (a "skill is hotbar-eligible if not Passive" rule lives
-- ONCE).
----------------------------------------------------------------------
local ItemsConfig  = ReplicatedModules.Data.Items
local Rarities     = ReplicatedModules.Data.Rarities
local SkillsConfig = ReplicatedModules.Data.Skills
local SkillsShared = ReplicatedModules.Services.SkillsShared

-- Common item entry adapter. Walks the player's `data.Inventory` map,
-- runs the predicate per (itemId, cfg), and emits one entry per stack
-- (multiple uuids of the same itemId yield N entries — each binds
-- separately to the hotbar / equipment slot).
local function entriesFromInventory(saveData, predicate: (cfg: any) -> boolean): { any }
	local out = {}
	if typeof(saveData) ~= 'table' or typeof(saveData.Inventory) ~= 'table' then
		return out
	end
	for itemId, uuidcache in saveData.Inventory do
		local cfg = ItemsConfig.Items[itemId]
		if not cfg then continue end
		if not predicate(cfg) then continue end
		if typeof(uuidcache) ~= 'table' then continue end
		for uuid, stack in uuidcache do
			local label = (cfg.Display and cfg.Display.Title and cfg.Display.Title.Text) or itemId
			local rarity = (cfg and cfg.Rarity) or 1
			local color = Rarities.RarityColors[rarity] or PALETTE.accent
			local count = (typeof(stack) == 'table' and (stack.Quantity or stack.Count)) or 1
			table.insert(out, {
				Kind  = 'item',
				Id    = itemId,
				Uuid  = uuid,
				Cfg   = cfg,
				Label = label,
				Sub   = (count > 1) and ('×' .. tostring(count)) or nil,
				Color = color,
				Glyph = '\u{25C6}',  -- ◆
			})
		end
	end
	table.sort(out, function(a, b) return a.Label < b.Label end)
	return out
end

-- Active (non-passive) skills the player has unlocked. Returns one
-- entry per skill id; passives are filtered out so the toolbar grid
-- only shows things that can actually be cast from a slot.
function Module.SkillEntries(saveData): { any }
	local out = {}
	local unlocked = SkillsShared.GetUnlockedSkills(saveData)
	for skillId, _entry in unlocked do
		local cfg = SkillsConfig.Skills[skillId]
		if not cfg then continue end
		if cfg.Passive then continue end
		local label = (cfg.Display and cfg.Display.Name) or skillId
		table.insert(out, {
			Kind  = 'skill',
			Id    = skillId,
			Cfg   = cfg,
			Label = label,
			Color = PALETTE.violet,
			Glyph = '\u{2605}',  -- ★
		})
	end
	table.sort(out, function(a, b) return a.Label < b.Label end)
	return out
end

-- Tag-driven section resolvers. Each one walks `saveData.Inventory`
-- and emits Entry rows for items whose `Tags` array contains the
-- corresponding `Module.ItemTags.X`. Items without tags don't appear.
-- The data-shape predicates below (WeaponItemEntries etc.) prefer
-- tags but fall back to the EquipmentData shape so untagged legacy
-- items still render until they're explicitly tagged.
function Module.WeaponItemEntries(saveData): { any }
	return entriesFromInventory(saveData, function(cfg)
		if ItemsConfig.HasTag(cfg, ItemsConfig.ItemTags.Weapon) then return true end
		local equip = cfg.EquipmentData
		return equip ~= nil and equip.WeaponUsage ~= nil
	end)
end

function Module.ToolItemEntries(saveData): { any }
	return entriesFromInventory(saveData, function(cfg)
		if ItemsConfig.HasTag(cfg, ItemsConfig.ItemTags.Tool) then return true end
		local equip = cfg.EquipmentData
		return equip ~= nil and equip.ToolUsage ~= nil
	end)
end

-- Food / Potion are TAG-ONLY: an item must be explicitly tagged to
-- show up in the hotbar surface. Reusing data shape (ConsumptionData)
-- would auto-include AttributeScrolls / Candy / etc., which the
-- player intent doesn't include.
function Module.FoodItemEntries(saveData): { any }
	return entriesFromInventory(saveData, function(cfg)
		return ItemsConfig.HasTag(cfg, ItemsConfig.ItemTags.Food)
	end)
end

function Module.PotionItemEntries(saveData): { any }
	return entriesFromInventory(saveData, function(cfg)
		return ItemsConfig.HasTag(cfg, ItemsConfig.ItemTags.Potion)
	end)
end

-- Armor: tag-first, with EquipmentData shape as fallback.
local ARMOR_SLOT_LOOKUP = {
	[ItemsConfig.EquipmentSlotEnums.Head]  = true,
	[ItemsConfig.EquipmentSlotEnums.Chest] = true,
	[ItemsConfig.EquipmentSlotEnums.Legs]  = true,
	[ItemsConfig.EquipmentSlotEnums.Boots] = true,
}
function Module.ArmorItemEntries(saveData): { any }
	return entriesFromInventory(saveData, function(cfg)
		if ItemsConfig.HasTag(cfg, ItemsConfig.ItemTags.Equipment) then return true end
		local equip = cfg.EquipmentData
		if not equip or equip.WeaponUsage or equip.ToolUsage then return false end
		local first = equip.EquipSlots and equip.EquipSlots[1]
		local slotEnum = first and first.Slot
		return slotEnum ~= nil and ARMOR_SLOT_LOOKUP[slotEnum] == true
	end)
end

-- Accessory equipment (jewelry / curio). Tag-first with slot fallback.
local ACCESSORY_SLOT_LOOKUP = {
	[ItemsConfig.EquipmentSlotEnums.Bracelet] = true,
	[ItemsConfig.EquipmentSlotEnums.Neck]     = true,
	[ItemsConfig.EquipmentSlotEnums.Ear]      = true,
	[ItemsConfig.EquipmentSlotEnums.Finger]   = true,
	[ItemsConfig.EquipmentSlotEnums.Curio]    = true,
}
function Module.AccessoryItemEntries(saveData): { any }
	return entriesFromInventory(saveData, function(cfg)
		if ItemsConfig.HasTag(cfg, ItemsConfig.ItemTags.Accessory) then return true end
		local equip = cfg.EquipmentData
		if not equip or equip.WeaponUsage or equip.ToolUsage then return false end
		local first = equip.EquipSlots and equip.EquipSlots[1]
		local slotEnum = first and first.Slot
		return slotEnum ~= nil and ACCESSORY_SLOT_LOOKUP[slotEnum] == true
	end)
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/TabWidget/states.luau"><![CDATA[-- // TabWidget/states.luau //
-- Cross-tab Fusion Values, created by the manager during Start() and shared
-- with every tab module via the TabContext table passed to `Tab.Build(ctx)`.
--
-- Per-tab state (e.g. Inventory's selected UUID, the filter text, detail
-- sub-tab id) stays INSIDE the tab module that owns it. Anything in here is
-- genuinely read by two or more tabs or by the shell.
--
-- Design note: this module doesn't require Fusion at the top level; instead
-- it exports a single `create(scope)` factory. That keeps the module free of
-- side-effects at require time and ties every Value's lifetime to the scope
-- the caller hands in (the manager's RootScope), so `doCleanup(scope)` tears
-- everything down in one go.

local Module = {}

export type Values = {
	IsOpen      : any, -- Fusion.Value<boolean>
	CurrentTab  : any, -- Fusion.Value<string>    — active top-level tab id
	DataVersion : any, -- Fusion.Value<number>    — bumped on ReplicatedData update so Computed re-evals
	PingValue   : any, -- Fusion.Value<string>    — "42ms" display
	ClockValue  : any, -- Fusion.Value<string>    — "14:22" display
}

function Module.create(scope): Values
	return {
		IsOpen      = scope:Value(false),
		CurrentTab  = scope:Value('Character'),
		DataVersion = scope:Value(0),
		PingValue   = scope:Value('0ms'),
		ClockValue  = scope:Value('00:00'),
	}
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/TabWidget/utils.luau"><![CDATA[-- // TabWidget/utils.luau //
-- Stateless presentation helpers + the PlayerData accessor shared across
-- tabs. Nothing here reads or writes Fusion state directly — every helper
-- takes the scope as the first argument so instances are owned by whichever
-- tab's scope called in.
--
-- If a helper needs to react to cross-tab state (e.g. `DataVersion`), don't
-- add it here — instead let the tab module do the Computed binding against
-- `ctx.DataVersion` and pass plain values into these helpers.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local peek   = Fusion.peek
local ReplicatedData = ReplicatedModules.Services.ReplicatedData

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local Module = {}

-- // Data access // --
-- Single source of truth for "grab the current PlayerData blob" — tabs call
-- this inside Computeds with `use(ctx.DataVersion)` above it so the compute
-- re-runs whenever the data version ticks.
function Module.getPlayerData()
	return ReplicatedData.GetData('PlayerData', false)
end

-- Small helper used by the ReplicatedData listener to kick Computeds. Kept
-- here so the manager and tabs share the same bump semantics.
function Module.bumpDataVersion(DataVersion)
	if DataVersion then
		DataVersion:set(peek(DataVersion) + 1)
	end
end

-- // Presentation primitives // --

-- Mono uppercase eyebrow label ("◆ ACTIVE QUEST" style).
function Module.eyebrow(scope, text: string, props)
	props = props or {}
	return scope:New('TextLabel') {
		Size = props.Size or UDim2.new(1, 0, 0, 12),
		Position = props.Position,
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_MONO,
		Text = text,
		TextSize = 10,
		TextColor3 = props.Color or PALETTE.accent,
		TextXAlignment = props.XAlign or Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		LayoutOrder = props.LayoutOrder or 0,
	}
end

-- Display-font title row. Default height 28 px / text size 22.
function Module.displayTitle(scope, props)
	return scope:New('TextLabel') {
		Size = props.Size or UDim2.new(1, 0, 0, 28),
		Position = props.Position,
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_DISPLAY,
		Text = props.Text,
		TextSize = props.TextSize or 22,
		TextColor3 = props.Color or PALETTE.ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = props.LayoutOrder or 0,
	}
end

-- 2-up stat card: small key eyebrow above a mono numeric value. Width is
-- half the parent minus a 3 px gap, so two per row tile cleanly.
function Module.statCard(scope, key: string, value: string, delta: string?)
	return scope:New('Frame') {
		Size = UDim2.new(0.5, -3, 0, 40),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.78, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
				PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
			},
			scope:New('TextLabel') {
				Size = UDim2.new(1, 0, 0, 10),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = string.upper(key),
				TextSize = 9,
				TextColor3 = PALETTE.inkFaint,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				Position = UDim2.fromOffset(0, 14),
				Size = UDim2.new(1, 0, 0, 18),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = value .. (delta and (' ' .. delta) or ''),
				TextSize = 14,
				TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
		},
	}
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/ToastWidget.luau"><![CDATA[-- Toast notifications widget. Stack of corner-anchored cards that
-- auto-dismiss after TOAST_LIFETIME seconds. Receives cues from
-- ToastServer over ToastEvent. Visual: chiseled-panel pill, rarity-tinted
-- accent stroke, eyebrow tag (ITEM / TITLE / AURA / LEVEL), title row.
--
-- Stack management: every toast lives in a `Toasts` array; the widget
-- rebuilds the stack frame each frame the array changes by bumping a
-- DataVersion-style Fusion Value. Toasts auto-fade out 0.4s before
-- removal so the stack appears to dissolve, not pop.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped    = Fusion.scoped
local doCleanup = Fusion.doCleanup
local peek      = Fusion.peek
local RemoteService = ReplicatedModules.Services.RemoteService

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

-- Cross-widget hook. Other HUD widgets (MusicWidget) want to fade
-- themselves when toasts are present so the toast stack reads
-- without competing UI noise. We expose a count + a signal-style
-- table of subscribers; this keeps the toast widget the single
-- source of truth without Fusion-crossing scopes.
local SignalLib = ReplicatedModules.Modules.Signal
local OnCountChangedSignal = SignalLib.New('ToastWidget_OnCountChanged')

local ToastEvent         = RemoteService.GetRemote('ToastEvent', 'RemoteEvent', false)
-- Outbound — fired when the player clicks a button on a buttoned
-- toast. Server-side ToastServer.Start dispatches the registered
-- handler keyed by toastId.
local ToastResponseEvent = RemoteService.GetRemote('ToastResponseEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}
Module.IsOpen = false

local RootScope = nil
local ScreenGui = nil
local ToastList = nil  -- Fusion Value<{Toast}>; Toast = { id, kind, title, subtitle, color, expiresAt, rarity? }

local TOAST_LIFETIME           = 4.5
local TOAST_LIFETIME_BUTTONED  = 12.0  -- buttoned toasts hang around longer for a click
local FADE_OUT = 0.4
local DESIGN_TOAST_W, DESIGN_TOAST_H = 280, 56
-- Heights for the two layout variants. Buttoned toasts append a button row;
-- the aspect constraint reads one of these depending on `toast.buttons`.
local DESIGN_TOAST_H_BUTTONED = 86   -- 56 + ROW_BTN_H(28) + ROW_GAP(2)
local DESIGN_SCREEN_W, DESIGN_SCREEN_H = 1920, 1080
-- Bottom-right inset (in design pixels) — the stack's bottom-right corner
-- sits this many px in from the viewport's bottom-right corner. Matches
-- the visual margin other corner-anchored widgets use (CombatLogWidget etc).
local STACK_INSET_PX = 16

-- Inner row heights — used by both the no-button and buttoned
-- variants so the layout stays predictable. Total no-button height:
-- pad-top(8) + eyebrow(12) + gap(2) + title(22) + gap(2) + subtitle(14)
-- + pad-bottom(8) ≈ 56px (matches DESIGN_TOAST_H).
local ROW_EYEBROW_H = 12
local ROW_TITLE_H   = 22
local ROW_SUB_H     = 14
local ROW_BTN_H     = 28
local ROW_GAP       = 2
local PAD_V         = 8
local PAD_H         = 12

local KIND_LABEL = {
	item      = '◆ ITEM',
	title     = '◆ TITLE',
	aura      = '◆ AURA',
	level     = '◆ LEVEL',
	attribute = '◆ ATTRIBUTE',
	request   = '◆ REQUEST',
	generic   = '◆ NOTICE',
}

local KIND_ACCENT = {
	item = function(p, rarity)
		local rarities = HUDCommon.RARITY
		local raritiesArr = { rarities.common, rarities.uncommon, rarities.rare,
		                     rarities.epic, rarities.legendary, rarities.mythic }
		return raritiesArr[rarity or 1] or p.accent
	end,
	title     = function(p) return p.violet end,
	aura      = function(p) return p.accent end,
	level     = function(p) return p.success end,
	-- Attribute — softer than full level-up; matches the subtler
	-- effect's cyan-tinged particle palette.
	attribute = function(p) return p.accent end,
	-- Requests draw the eye — gold reads as "action needed" without
	-- alarming like danger.
	request   = function(p) return p.gold end,
	generic   = function(p) return p.accent end,
}

function Module.IsWidgetOpen(): boolean
	return Module.IsOpen and ScreenGui ~= nil
end

-- Cross-widget API. Returns the live toast-stack count and the
-- signal that fires whenever it changes (push or auto-dismiss).
-- MusicWidget binds its pill transparency to this — see
-- MusicWidget.Start's Module.OnToastCountChanged hookup.
function Module.GetActiveCount(): number
	if not ToastList then return 0 end
	local current = peek(ToastList)
	return current and #current or 0
end
Module.OnCountChanged = OnCountChangedSignal

-- Internal: fire the signal exactly when the list mutates. Pulled out
-- so push/remove paths share one notification site.
local function notifyCount()
	OnCountChangedSignal:Fire(Module.GetActiveCount())
end

----------------------------------------------------------------------
-- Toast list mutation helpers.
----------------------------------------------------------------------
local _nextId = 0

-- Remove a toast from the list by local entry id. Used by both the
-- auto-dismiss timer and button clicks (buttoned toasts dismiss
-- immediately on click rather than waiting for the lifetime).
local function removeToast(localId: number)
	if not ToastList then return end
	local current = peek(ToastList) or {}
	local out = {}
	for _, t in current do
		if t.id ~= localId then table.insert(out, t) end
	end
	ToastList:set(out)
	notifyCount()
end

local function pushToast(kind: string, payload: any)
	if not ToastList then return end
	_nextId += 1
	local now = os.clock()
	-- Buttons + ToastId originate on the server (NotifyWithButtons).
	-- Empty/nil button list flips this to a regular auto-dismiss toast.
	local hasButtons = typeof(payload.Buttons) == 'table' and #payload.Buttons > 0
	local lifetime = hasButtons and TOAST_LIFETIME_BUTTONED or TOAST_LIFETIME
	local entry = {
		id        = _nextId,
		kind      = kind,
		title     = payload.Title or '',
		subtitle  = payload.Subtitle or '',
		color     = payload.Color,
		rarity    = payload.Rarity,
		buttons   = hasButtons and payload.Buttons or nil,
		serverId  = payload.ToastId,  -- echoed back when a button fires
		expiresAt = now + lifetime,
	}
	local list = peek(ToastList) or {}
	local copy = {}; for i, t in list do copy[i] = t end
	table.insert(copy, 1, entry)  -- newest on top
	-- Cap stack at 6 so a flood doesn't push the panel off-screen.
	while #copy > 6 do table.remove(copy) end
	ToastList:set(copy)
	notifyCount()

	task.delay(lifetime, function() removeToast(entry.id) end)
end

----------------------------------------------------------------------
-- UI build.
----------------------------------------------------------------------
-- Build one button inside a buttoned toast. Pixel-stretched within
-- the buttons row. On click: fires the inbound response remote with
-- the toast's serverId + this button's action string, then removes
-- the toast locally so the player gets immediate feedback. Transparencies
-- are constant — the parent CanvasGroup's GroupTransparency multiplies
-- the fade across every descendant uniformly.
local function buildToastButton(scope, toast, button)
	local fillColor = button.Color or PALETTE.bg1
	return scope:New('TextButton') {
		Name = 'Btn_' .. tostring(button.Action),
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = fillColor,
		BackgroundTransparency = 0.20,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		FontFace = HUDCommon.FONT_UI,
		Text = '  ' .. (button.Label or '?') .. '  ',
		TextSize = 13,
		TextColor3 = PALETTE.ink,
		[Fusion.OnEvent('Activated')] = function()
			-- ServerId can be nil if the server-side push didn't go
			-- through NotifyWithButtons — defensive bail keeps the
			-- click from firing a bogus response.
			if typeof(toast.serverId) == 'number' then
				ToastResponseEvent:FireServer(toast.serverId, button.Action)
			end
			removeToast(toast.id)
		end,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = PALETTE.accent,
				Transparency = 0.5,
				Thickness = 1,
			},
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
			},
		},
	}
end

-- Optional button row. Returns nil when the toast has no buttons —
-- callers filter nils out of the children list.
local function buildButtonRow(scope, toast)
	if not toast.buttons or #toast.buttons == 0 then return nil end
	local children: { any } = {
		scope:New('UIListLayout') {
			FillDirection      = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment  = Enum.VerticalAlignment.Center,
			Padding            = UDim.new(0, 6),
			SortOrder          = Enum.SortOrder.LayoutOrder,
		},
	}
	for i, btn in toast.buttons do
		local node = buildToastButton(scope, toast, btn)
		node.LayoutOrder = i
		children[#children + 1] = node
	end
	return scope:New('Frame') {
		Name = 'ButtonRow',
		LayoutOrder = 4,
		Size = UDim2.new(1, 0, 0, ROW_BTN_H),
		BackgroundTransparency = 1,
		[Fusion.Children] = children,
	}
end

local function buildToast(scope, toast)
	local accent = (KIND_ACCENT[toast.kind] or KIND_ACCENT.generic)(PALETTE, toast.rarity)
	if toast.color then accent = toast.color end
	local lifetime = toast.buttons and TOAST_LIFETIME_BUTTONED or TOAST_LIFETIME
	local hasButtons = toast.buttons and #toast.buttons > 0

	-- Fade is driven by a single Fusion `Value` flipped 0 → 1 at the start
	-- of the fade window, then `scope:Tween` smooths the transition. The
	-- tweened number is bound to a CanvasGroup.GroupTransparency on the
	-- outer wrapper so the entire toast (background + stroke + every text
	-- + button) fades as ONE rasterized layer — replaces the old per-
	-- property transparency Computeds that had to fan out to UIStroke,
	-- each TextLabel.TextTransparency, and the button's stroke alpha.
	local fadeTrigger = scope:Value(0)
	local groupAlpha = scope:Tween(
		fadeTrigger,
		TweenInfo.new(FADE_OUT, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	)

	-- Kick the fade at lifetime - FADE_OUT. Pure single :set — no manual
	-- per-frame lerp loop. If the toast is already removed (button click,
	-- stack overflow eviction) the Value is in a torn-down scope; check
	-- scope-life via the Fusion field rather than a stale upvalue.
	task.delay(lifetime - FADE_OUT, function()
		if fadeTrigger then fadeTrigger:set(1) end
	end)

	-- Children list: eyebrow + title + subtitle, then optional buttons.
	-- Every transparency below is a CONSTANT — the CanvasGroup wrapper
	-- multiplies its GroupTransparency over each descendant, so we only
	-- have to drive one tween (groupAlpha) to fade the whole card.
	local children: { any } = {
		scope:New('UIStroke') {
			Color = accent,
			Transparency = 0.4,
			Thickness = 1,
		},
		scope:New('UIPadding') {
			PaddingTop    = UDim.new(0, PAD_V), PaddingBottom = UDim.new(0, PAD_V),
			PaddingLeft   = UDim.new(0, PAD_H), PaddingRight  = UDim.new(0, PAD_H),
		},
		scope:New('UIListLayout') {
			FillDirection = Enum.FillDirection.Vertical,
			Padding       = UDim.new(0, ROW_GAP),
			SortOrder     = Enum.SortOrder.LayoutOrder,
		},
		-- Eyebrow.
		scope:New('TextLabel') {
			LayoutOrder = 1,
			Size = UDim2.new(1, 0, 0, ROW_EYEBROW_H),
			BackgroundTransparency = 1,
			FontFace = HUDCommon.FONT_MONO,
			Text = KIND_LABEL[toast.kind] or KIND_LABEL.generic,
			TextSize = 11,
			TextColor3 = accent,
			TextXAlignment = Enum.TextXAlignment.Left,
		},
		-- Title.
		scope:New('TextLabel') {
			LayoutOrder = 2,
			Size = UDim2.new(1, 0, 0, ROW_TITLE_H),
			BackgroundTransparency = 1,
			FontFace = HUDCommon.FONT_DISPLAY,
			Text = toast.title,
			TextSize = 18,
			TextColor3 = PALETTE.ink,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		},
		-- Subtitle.
		scope:New('TextLabel') {
			LayoutOrder = 3,
			Size = UDim2.new(1, 0, 0, ROW_SUB_H),
			BackgroundTransparency = 1,
			FontFace = HUDCommon.FONT_UI,
			Text = toast.subtitle,
			TextSize = 12,
			TextColor3 = PALETTE.inkDim,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		},
	}

	-- Optional button row appended last (LayoutOrder=4). The row no longer
	-- needs the `alpha` plumb — its descendants ride the CanvasGroup fade.
	local btnRow = buildButtonRow(scope, toast)
	if btnRow then children[#children + 1] = btnRow end

	-- Pixel-design height for this toast variant. Both axes are locked so
	-- the UIAspectRatioConstraint below has a stable shape to enforce —
	-- AutomaticSize.Y was dropped because it fights the aspect lock (the
	-- constraint would back-derive width from content height once
	-- AutomaticSize bumped the height).
	local designH = hasButtons and DESIGN_TOAST_H_BUTTONED or DESIGN_TOAST_H

	return scope:New('CanvasGroup') {
		Name = 'Toast_' .. tostring(toast.id),
		LayoutOrder = -toast.id,   -- newest on top
		Size = UDim2.fromScale(DESIGN_TOAST_W / DESIGN_SCREEN_W, designH / DESIGN_SCREEN_H),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		-- One tweened value drives the whole card's fade. Re-rasterization
		-- is cheap here — the texture is ~280×56 px (or ~280×86 for
		-- buttoned variants), well under the "don't wrap large panels"
		-- caution in the UI skill guide. We only animate GroupTransparency
		-- (never Size), so the off-screen texture is rasterized once and
		-- reused for the entire fade.
		GroupTransparency = groupAlpha,
		[Fusion.Children] = {
			-- Shape lock so the toast keeps its designed proportions on
			-- screens with different aspect ratios. FitWithinMaxSize +
			-- DominantAxis=Width: width comes from the fromScale above,
			-- height is forced to width / aspect.
			scope:New('UIAspectRatioConstraint') {
				AspectRatio = DESIGN_TOAST_W / designH,
				AspectType = Enum.AspectType.FitWithinMaxSize,
				DominantAxis = Enum.DominantAxis.Width,
			},
			table.unpack(children),
		},
	}
end

local function buildUI(scope)
	scope:New('Frame') {
		Name = 'ToastStack',
		-- Bottom-right anchored. Bottom-right corner of the stack sits
		-- STACK_INSET_PX in from the viewport's bottom-right corner. The
		-- stack height is 60% of viewport so the layout has room for the
		-- max-6 toast cap without overflowing. VerticalAlignment.Bottom
		-- + LayoutOrder = -toast.id (newest on top) means new toasts
		-- appear ABOVE existing toasts which stay anchored at the bottom
		-- edge — the standard "notifications pile up bottom-right" feel.
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -STACK_INSET_PX, 1, -STACK_INSET_PX),
		Size = UDim2.fromScale(DESIGN_TOAST_W / DESIGN_SCREEN_W, 0.6),
		BackgroundTransparency = 1,
		Parent = ScreenGui,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				HorizontalAlignment = Enum.HorizontalAlignment.Right,
				VerticalAlignment = Enum.VerticalAlignment.Bottom,
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:ForPairs(ToastList, function(_use, innerScope, idx, toast)
				return toast.id, buildToast(innerScope, toast)
			end),
		},
	}
end

function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true
	ScreenGui = HUDCommon.ensureScreenGui('HUD_Toasts', 30)
	RootScope = scoped(Fusion)
	ToastList = RootScope:Value({})
	buildUI(RootScope)
end

function Module.CloseWidget()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
end

function Module.Start()
	HUDCommon.BindLiveTheme(Module)

	ToastEvent.OnClientEvent:Connect(function(kind, payload)
		pushToast(kind, payload or {})
	end)

	task.defer(Module.OpenWidget)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/TopRightQuestsWidget.luau"><![CDATA[-- Top-right active quest rail.
-- Visual reference: tmp/aincrad-ui/hud.jsx (HudPlated quest tracker, right:20 top:280 width:220).
--
-- Layout strategy (see .claude/skills/custom-roblox-ui/SKILL.md -- sections 2, 3, 8, 10):
--   * Rail is a variable-length list of QuestCards, so the top-level frame uses a
--     pixel-exact width + AutomaticSize.Y. Cards stack vertically via UIListLayout.
--     Rail anchors top-right (AnchorPoint(1, 0)) with a scaled pixel inset. Using
--     AutomaticSize on the Y axis is cleaner than UIAspectRatioConstraint here
--     because the quest count is variable.
--   * Each QuestCard is pixel-exact width (matching rail) + AutomaticSize.Y so the
--     body text can wrap and grow without stretching.
--   * Because cards are pixel-width, every inner label uses pixel offsets; no
--     magic scale numbers anywhere inside the cards.
--   * Reactive quest list via scope:ForPairs over a Computed that reads
--     ReplicatedData.PlayerData.ActiveQuests. Data version is bumped whenever
--     PlayerData changes (see Module.Start) to re-run the computation.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local doCleanup = Fusion.doCleanup
local peek = Fusion.peek

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE = HUDCommon.PALETTE
local ReplicatedData = ReplicatedModules.Services.ReplicatedData

-- Optional Quests config -- exists in game/src/ReplicatedStorage/Modules/Data/Quests.lua.
local QuestsConfig = nil
do
	local ok, mod = pcall(function()
		return ReplicatedModules.Data.Quests
	end)
	if ok then QuestsConfig = mod end
end

local SystemsContainer = {}

-- // Module // --
local Module = {}
Module.IsOpen = false

local RootScope = nil
local ScreenGui = nil
local DataVersion = nil -- Value<number> bumped on PlayerData update to refresh ForPairs

----------------------------------------------------------------------
-- Design dimensions (pixels on the 1920x1080 reference canvas).
-- Every scale value in this file is derived from these constants.
----------------------------------------------------------------------
local DESIGN_SCREEN_W, DESIGN_SCREEN_H = 1920, 1080

-- Rail (outer): anchors top-right with pixel insets. JSX: right:20, top:280.
local DESIGN_INSET_RIGHT = 20
-- Rail sits below the minimap (top:56, height:240) + 24 px gap.
local DESIGN_INSET_TOP   = 320

-- Cards are pixel-exact width; rail matches. JSX width:220.
local DESIGN_CARD_W = 260

-- Padding between stacked quest cards.
local DESIGN_CARD_GAP = 8

-- QuestCard internals (JSX: padding:10; eyebrow fontSize 9, title 14, body 11).
local DESIGN_CARD_PAD       = 10                        -- symmetric inner padding
local DESIGN_CARD_INNER_W   = DESIGN_CARD_W - 2 * DESIGN_CARD_PAD -- 200 usable width

-- Vertical row heights within a card. Title + body + objective all opt
-- into AutomaticSize.Y growth so longer subquest titles or descriptions
-- expand the card downward instead of getting truncated mid-word.
local DESIGN_EYEBROW_H      = 12   -- "◆ ACTIVE QUEST" eyebrow line
local DESIGN_TITLE_H        = 22   -- quest display name (min height; wraps)
local DESIGN_BODY_MIN_H     = 36   -- quest description (wraps, AutomaticSize.Y grows)
local DESIGN_OBJECTIVE_H    = 18   -- objective row (min height; wraps when long)

-- Internal row gap between eyebrow/title/body/objective.
local DESIGN_ROW_GAP        = 6

-- Objective row: right-aligned meta readout width (e.g. "480m").
local DESIGN_META_W         = 58

-- Top-right screen anchor in scale.
local ANCHOR_X_SCALE = 1 - DESIGN_INSET_RIGHT / DESIGN_SCREEN_W
local ANCHOR_Y_SCALE = DESIGN_INSET_TOP / DESIGN_SCREEN_H

function Module.IsWidgetOpen(): boolean
	return Module.IsOpen and ScreenGui ~= nil
end

----------------------------------------------------------------------
-- Derive the list of *tracked* active quests from PlayerData.
-- Returns an ordered array of { order, questId, uuid, state } entries.
--
-- Schema: `data.ActiveQuests[questId][uuid] = BaseQuestData`. One questId
-- can have multiple in-flight uuids (repeatable quests), so we flatten
-- the nested dict and surface one rail card per *tracked* uuid. Untracked
-- uuids are intentionally excluded — the on-screen rail is the player's
-- focused-quest readout, not the full quest log. The full list lives in
-- the QuestsTab menu.
----------------------------------------------------------------------
local function collectTrackedQuests()
	local data = ReplicatedData.GetData('PlayerData', false)
	local out = {}
	if not data or typeof(data.ActiveQuests) ~= 'table' then return out end

	local idx = 0
	for questId, uuidDict in data.ActiveQuests do
		if typeof(uuidDict) ~= 'table' then continue end
		for uuid, questState in uuidDict do
			if typeof(questState) ~= 'table' or questState.is_tracked ~= true then continue end
			idx += 1
			table.insert(out, {
				order   = idx,
				questId = questId,
				uuid    = uuid,
				state   = questState,
			})
		end
	end
	return out
end

----------------------------------------------------------------------
-- Resolve config-derived display strings for a quest.
-- Pulls title/description from `cfg.Display`, and resolves the *current*
-- objective from `cfg.SubQuests[state.SubQuestIndex].Display.Title.Text`.
-- Meta column shows "step / total" so the player can see progression at
-- a glance without opening the full quest log.
----------------------------------------------------------------------
local function getQuestDisplay(questId: string, questState: any)
	local cfg = QuestsConfig and QuestsConfig.Quests and QuestsConfig.Quests[questId] or nil

	local title = tostring(questId)
	local body  = ''
	if cfg and cfg.Display then
		title = (cfg.Display.Title and cfg.Display.Title.Text) or title
		body  = (cfg.Display.Description and cfg.Display.Description.Text) or body
	end

	local subIdx = (typeof(questState) == 'table' and tonumber(questState.SubQuestIndex)) or 1
	local total  = (cfg and cfg.SubQuests and #cfg.SubQuests) or 0

	local objectiveText = 'Objective'
	if cfg and cfg.SubQuests and cfg.SubQuests[subIdx] then
		local sq = cfg.SubQuests[subIdx]
		local stepTitle = sq.Display and sq.Display.Title and sq.Display.Title.Text
		if stepTitle and stepTitle ~= '' then
			objectiveText = stepTitle
		end
	end
	local objective = string.format('\u{25C6} %s', objectiveText)

	-- Meta column: only render a step counter when the quest actually has
	-- multiple steps (single-step quests would just say "1 / 1", noisy).
	local meta = ''
	if total > 1 then
		meta = string.format('%d / %d', math.clamp(subIdx, 1, total), total)
	end

	return title, body, objective, meta
end

----------------------------------------------------------------------
-- Build one quest card: pixel-exact width, AutomaticSize.Y.
-- All inner labels are pixel-offset sized.
----------------------------------------------------------------------
local function buildQuestCard(scope, entry)
	local title, body, objective, meta = getQuestDisplay(entry.questId, entry.state)

	return scope:New('Frame') {
		Name = 'QuestCard_' .. tostring(entry.questId),
		LayoutOrder = entry.order,
		-- Pixel-exact width, height grows with content (body may wrap).
		-- Card fills rail width (scale) + auto-grows vertically.
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.7, Thickness = 1 },
			-- Horizontal padding in SCALE of card width so it shrinks with the
			-- card. Vertical padding stays pixel (AutomaticSize.Y + scale-Y
			-- padding would feedback-loop).
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(0, DESIGN_CARD_PAD),
				PaddingBottom = UDim.new(0, DESIGN_CARD_PAD),
				PaddingLeft   = UDim.new(DESIGN_CARD_PAD / DESIGN_CARD_W, 0),
				PaddingRight  = UDim.new(DESIGN_CARD_PAD / DESIGN_CARD_W, 0),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				SortOrder = Enum.SortOrder.LayoutOrder,
				HorizontalAlignment = Enum.HorizontalAlignment.Left,
				Padding = UDim.new(0, DESIGN_ROW_GAP),
			},

			-- Eyebrow "◆ ACTIVE QUEST". Full content width (scale), pixel height.
			HUDCommon.eyebrowLabel(scope, {
				Text = '\u{25C6} TRACKED QUEST',
				Size = UDim2.new(1, 0, 0, DESIGN_EYEBROW_H),
				LayoutOrder = 0,
			}),

			-- Quest title (display font). Wraps + auto-grows so long names
			-- aren't truncated mid-word; min height set by DESIGN_TITLE_H.
			scope:New('TextLabel') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, DESIGN_TITLE_H),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY, TextSize = 15,
				TextColor3 = PALETTE.ink,
				Text = title,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
			},

			-- Body description -- wraps; AutomaticSize.Y on the card absorbs growth.
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, DESIGN_BODY_MIN_H),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI, TextSize = 12,
				TextColor3 = PALETTE.inkDim,
				TextTransparency = 0.25,
				Text = body,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
			},

			-- Objective row: left-aligned objective text (wraps) + right-
			-- aligned meta readout pinned to the top-right corner so the
			-- step counter doesn't drift down when the objective wraps.
			scope:New('Frame') {
				LayoutOrder = 3,
				Size = UDim2.new(1, 0, 0, DESIGN_OBJECTIVE_H),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0),
						Position = UDim2.fromScale(0, 0),
						-- Fill remaining row width after the meta column: scale 1
						-- minus pixel offset for the pinned meta label + gap.
						Size = UDim2.new(1, -(DESIGN_META_W + DESIGN_ROW_GAP), 0, DESIGN_OBJECTIVE_H),
						AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_UI, TextSize = 12,
						TextColor3 = PALETTE.ink,
						Text = objective,
						TextXAlignment = Enum.TextXAlignment.Left,
						TextYAlignment = Enum.TextYAlignment.Top,
						TextWrapped = true,
					},
					scope:New('TextLabel') {
						AnchorPoint = Vector2.new(1, 0),
						Position = UDim2.fromScale(1, 0),
						Size = UDim2.fromOffset(DESIGN_META_W, DESIGN_OBJECTIVE_H),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO, TextSize = 10,
						TextColor3 = PALETTE.accent,
						Text = meta,
						TextXAlignment = Enum.TextXAlignment.Right,
					},
				},
			},
		},
	}
end

----------------------------------------------------------------------
-- Build the empty-state placeholder card (no active quests).
----------------------------------------------------------------------
local function buildEmptyCard(scope)
	return scope:New('Frame') {
		Name = 'QuestCard_Empty',
		LayoutOrder = 0,
		-- Card fills rail width (scale) + auto-grows vertically.
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.7, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(0, DESIGN_CARD_PAD),
				PaddingBottom = UDim.new(0, DESIGN_CARD_PAD),
				PaddingLeft   = UDim.new(DESIGN_CARD_PAD / DESIGN_CARD_W, 0),
				PaddingRight  = UDim.new(DESIGN_CARD_PAD / DESIGN_CARD_W, 0),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				SortOrder = Enum.SortOrder.LayoutOrder,
				HorizontalAlignment = Enum.HorizontalAlignment.Left,
				Padding = UDim.new(0, DESIGN_ROW_GAP),
			},
			HUDCommon.eyebrowLabel(scope, {
				Text = '\u{25C6} NO TRACKED QUEST',
				Size = UDim2.new(1, 0, 0, DESIGN_EYEBROW_H),
				LayoutOrder = 0,
			}),
			scope:New('TextLabel') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, DESIGN_BODY_MIN_H),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI, TextSize = 11,
				TextColor3 = PALETTE.inkDim,
				TextTransparency = 0.25,
				Text = 'Track a quest from the quest log to surface its current objective here.',
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
			},
		},
	}
end

----------------------------------------------------------------------
-- Build the rail and parent to the ScreenGui.
----------------------------------------------------------------------
local function buildUI(scope)
	local rail = scope:New('Frame') {
		Name = 'TopRightQuestsRail',
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(ANCHOR_X_SCALE, ANCHOR_Y_SCALE),
		-- Scale width = card width as a fraction of the reference screen.
		-- Height grows with the card stack (AutomaticSize.Y).
		Size = UDim2.fromScale(DESIGN_CARD_W / DESIGN_SCREEN_W, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				SortOrder = Enum.SortOrder.LayoutOrder,
				HorizontalAlignment = Enum.HorizontalAlignment.Right,
				Padding = UDim.new(0, DESIGN_CARD_GAP),
			},
			scope:ForPairs(
				scope:Computed(function(use)
					use(DataVersion)
					local quests = collectTrackedQuests()
					if #quests == 0 then
						-- Sentinel entry triggers the empty-state card.
						return { { order = 0, questId = '__empty__', state = nil } }
					end
					return quests
				end),
				function(use, innerScope, _idx, entry)
					if entry.questId == '__empty__' then
						return entry.questId, buildEmptyCard(innerScope)
					end
					-- Multiple tracked uuids of the same questId could collide
					-- on a questId-only key, so pair them with the uuid.
					local key = entry.questId .. '@' .. tostring(entry.uuid)
					return key, buildQuestCard(innerScope, entry)
				end
			),
		},
	}
	rail.Parent = ScreenGui
end

function Module.UpdateWidget()
	if not Module.IsWidgetOpen() then return end
	if DataVersion then DataVersion:set((peek(DataVersion) or 0) + 1) end
end

function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true
	ScreenGui = HUDCommon.ensureScreenGui('HUD_Quests', 5)
	RootScope = scoped(Fusion)

	DataVersion = RootScope:Value(0)

	buildUI(RootScope)
	Module.UpdateWidget()
end

function Module.CloseWidget()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
end

function Module.Start()
	ReplicatedData.OnUpdated:Connect(function(category, _)
		if category == 'PlayerData' then
			Module.UpdateWidget()
		end
	end)

	HUDCommon.BindLiveTheme(Module)

	task.defer(Module.OpenWidget)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/WaystonesWidget.luau"><![CDATA[-- Waystone teleport panel. Ported to Fusion 0.3.
-- Visual: floor-category list on the left, waystone list on the right.
-- InteractableService + server teleport remote preserved from original.
--
-- Layout strategy (see .claude/skills/custom-roblox-ui/SKILL.md):
--   * Top-level modal: AnchorPoint(0.5, 0.5) + Position=fromScale(0.5, 0.5),
--     Scale-sized with UIAspectRatioConstraint(520/320, FitWithinMaxSize) so
--     the designed panel shape is preserved on ultrawide/portrait screens
--     rather than stretching (SKILL §2, §8).
--   * Wrapped in a CanvasGroup so we can fade the whole panel in/out via
--     GroupTransparency (SKILL §7).
--   * Title, close button, waystone rows use pixel offsets + DESIGN_*
--     constants (SKILL §8); no magic scale values.

local CollectionService = game:GetService('CollectionService')
local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local doCleanup = Fusion.doCleanup
local peek = Fusion.peek

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local CombatLog = LocalModules.Modules.CombatLog
local PALETTE = HUDCommon.PALETTE

local WaystonesData = ReplicatedModules.Data.Waystones
local InteractableService = ReplicatedModules.Services.InteractableService
local ReplicatedData = ReplicatedModules.Services.ReplicatedData

local RemoteService = ReplicatedModules.Services.RemoteService
local WaystonesEvent = RemoteService.GetRemote('WaystonesEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local ACTIVE_WAYSTONES_CACHE = {}
local ACTIVE_WAYSTONE_ID: string? = nil
local ACTIVE_WAYSTONE_MODEL: Model? = nil
local WAYSTONE_TELEPORT_DEBOUNCE = true

----------------------------------------------------------------------
-- Design dimensions (pixels on the 1920x1080 reference canvas).
-- Every Scale value in the file is derived from these constants.
----------------------------------------------------------------------
local DESIGN_SCREEN_W, DESIGN_SCREEN_H = 1920, 1080
local DESIGN_PANEL_W, DESIGN_PANEL_H   = 520, 320
local DESIGN_TITLE_H                   = 20
local DESIGN_PAD                       = 14
local DESIGN_CLOSE_BTN_W               = 28
local DESIGN_CLOSE_BTN_H               = 22
local DESIGN_CLOSE_INSET               = 10
local DESIGN_WAYSTONE_ROW_H            = 28
local DESIGN_LIST_GAP                  = 4
-- Left/right split of the content area (floors rail vs waystone list).
local DESIGN_LEFT_FRAC                 = 0.42
local DESIGN_COL_GAP                   = 8

-- // Module // --
local Module = {}
Module.IsOpen = false

local RootScope = nil
local ScreenGui = nil
local ActiveCategory = nil -- Value<string>
local DataVersion    = nil -- Value<number>  -- bumped to re-render lists
local PlayerFloor    = nil -- Value<string?>

function Module.IsWidgetOpen(): boolean
	return Module.IsOpen and ScreenGui ~= nil
end

function Module.ClearActiveWaystone()
	ACTIVE_WAYSTONE_ID = nil
	ACTIVE_WAYSTONE_MODEL = nil
end

function Module.IsWaystoneUnlocked(waystoneId: string): boolean
	local config = WaystonesData.WaystoneDisplays[waystoneId]
	if not config then return false end
	if config.AutoUnlock then return true end
	local data = ReplicatedData.GetData('PlayerData', false)
	if not data then return false end
	return table.find(data.Waystones or {}, waystoneId) ~= nil
end

function Module.IsCategoryUnlocked(category: string): boolean
	for waystoneId, display in WaystonesData.WaystoneDisplays do
		if display.Category == category and Module.IsWaystoneUnlocked(waystoneId) then
			return true
		end
	end
	return false
end

local function teleportTo(waystoneId: string)
	if not WAYSTONE_TELEPORT_DEBOUNCE then return end

	-- Combat log: prevent teleport if the player has been in combat in the
	-- last few seconds (took/dealt damage, started blocking, etc.). Stops
	-- the "fight then bail" pattern in PvP and dungeon escape.
	if CombatLog.IsInCombat() then
		print(string.format(
			'Cannot waystone-teleport while in combat (%.1fs left).',
			CombatLog.SecondsRemaining()
		))
		return
	end

	-- Cross-floor predict. Server enforces the canonical rule (cross-floor
	-- requires standing AT a major waystone — destination tier is
	-- irrelevant), so we only need a cheap "is this even cross-floor?"
	-- check before triggering the fade-to-black animation. The earlier
	-- predict compared `display.Floor` (NUMBER from config) against
	-- `LocalPlayer:GetAttribute('CurrentFloor')` (STRING name set by
	-- GameControllerServer) — those never match, so every same-floor
	-- teleport silently bailed with the spammed "(x2)" message.
	-- Read PlayerData.CurrentFloor instead — that field is the canonical
	-- floor NUMBER (line 205 of GameControllerServer.luau). Skip the
	-- predict entirely when we can't resolve a current floor or a
	-- destination floor; the server handles those edge cases.
	local display = WaystonesData.WaystoneDisplays[waystoneId]
	local data = ReplicatedData.GetData('PlayerData', false)
	local currentFloor = data and data.CurrentFloor
	if display and typeof(currentFloor) == 'number'
		and typeof(display.Floor) == 'number'
		and display.Floor ~= currentFloor then
		-- Cross-floor. We can't determine source-waystone-tier on the
		-- client cheaply (zone state is server-only), so let the server
		-- be the gatekeeper — it'll reject and the fade plays without
		-- a teleport. Worth the minor cosmetic cost to keep the predict
		-- correct (no false-positives on same-floor swaps) and the rule
		-- in one place (server).
	end

	WAYSTONE_TELEPORT_DEBOUNCE = false
	Module.CloseWidget()

	local fade = SystemsContainer.ParentSystems
		and SystemsContainer.ParentSystems.Miscellaneous
		and SystemsContainer.ParentSystems.Miscellaneous.FadeTest

	if fade then fade.FadeInBlack(1) end
	task.wait(1)
	WaystonesEvent:FireServer(waystoneId)
	task.wait(1)
	if fade then fade.FadeOutBlack(1) end

	task.delay(2, function()
		WAYSTONE_TELEPORT_DEBOUNCE = true
	end)
end

-- Build one floor-category button.
local function buildCategoryButton(scope, categoryName: string, categoryData)
	return scope:New('TextButton') {
		Name = categoryName,
		Size = UDim2.new(1, 0, 0, DESIGN_WAYSTONE_ROW_H),
		BackgroundColor3 = scope:Computed(function(use)
			return use(ActiveCategory) == categoryName and PALETTE.panel or PALETTE.bg1
		end),
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		LayoutOrder = categoryData.LayoutOrder or 0,
		FontFace = HUDCommon.FONT_BUTTON, TextSize = 12,
		TextColor3 = scope:Computed(function(use)
			return use(ActiveCategory) == categoryName and PALETTE.accent or PALETTE.ink
		end),
		Text = categoryData.Name,
		TextXAlignment = Enum.TextXAlignment.Left,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
			},
			scope:New('UIStroke') {
				Color = PALETTE.accent,
				Transparency = scope:Computed(function(use)
					return use(ActiveCategory) == categoryName and 0.4 or 0.85
				end),
				Thickness = 1,
			},
		},
		[Fusion.OnEvent 'Activated'] = function()
			ActiveCategory:set(categoryName)
		end,
	}
end

-- Build one waystone row.
local function buildWaystoneRow(scope, waystoneId: string, display)
	local color = scope:Computed(function(use)
		use(DataVersion); use(PlayerFloor)
		local unlocked = Module.IsWaystoneUnlocked(waystoneId)
		local onFloor = use(PlayerFloor) == display.Category
		local active = unlocked and (display.LargeWaystone or onFloor)
		if ACTIVE_WAYSTONE_ID == waystoneId then return PALETTE.gold end
		if active then return PALETTE.ink end
		return PALETTE.inkFaint
	end)

	return scope:New('TextButton') {
		Name = waystoneId,
		Size = UDim2.new(1, 0, 0, DESIGN_WAYSTONE_ROW_H),
		BackgroundColor3 = PALETTE.bg1,
		BackgroundTransparency = 0.4,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		LayoutOrder = display.LayoutOrder or 0,
		FontFace = HUDCommon.FONT_BUTTON, TextSize = 12,
		TextColor3 = color,
		Text = display.Name,
		TextXAlignment = Enum.TextXAlignment.Left,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
			},
			scope:New('UIStroke') {
				Color = PALETTE.accent, Transparency = 0.9, Thickness = 1,
			},
		},
		[Fusion.OnEvent 'Activated'] = function()
			local unlocked = Module.IsWaystoneUnlocked(waystoneId)
			local onFloor = peek(PlayerFloor) == display.Category
			local active = unlocked and (display.LargeWaystone or onFloor)
			if not active or ACTIVE_WAYSTONE_ID == waystoneId then
				return
			end
			teleportTo(waystoneId)
		end,
	}
end

local function buildUI(scope)
	-- Inner chiseled panel, filling the CanvasGroup.
	-- Title is positioned inside the panel (pixel inset from top-left).
	-- Close button is pixel-exact, anchored top-right with DESIGN_CLOSE_INSET.
	-- Content row sits below the title and holds the two ScrollingFrames.
	local inner = HUDCommon.chiseledPanel(scope, {
		Name = 'WaystoneFrame',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		AccentColor = PALETTE.accent,
		Children = {
			-- Title band: pixel height, top-left anchor, inset by DESIGN_PAD.
			scope:New('TextLabel') {
				Name = 'Title',
				AnchorPoint = Vector2.new(0, 0),
				Position = UDim2.fromOffset(DESIGN_PAD, DESIGN_PAD),
				Size = UDim2.new(1, -(DESIGN_PAD * 2 + DESIGN_CLOSE_BTN_W + DESIGN_CLOSE_INSET), 0, DESIGN_TITLE_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_BUTTON, TextSize = 18,
				TextColor3 = PALETTE.ink,
				Text = '\u{25C6} WAYSTONE NETWORK \u{25C6}',
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
			},

			-- Close button: top-right corner, pixel-exact (SKILL §1 idiom).
			scope:New('TextButton') {
				Name = 'CloseButton',
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -DESIGN_CLOSE_INSET, 0, DESIGN_CLOSE_INSET),
				Size = UDim2.fromOffset(DESIGN_CLOSE_BTN_W, DESIGN_CLOSE_BTN_H),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				FontFace = HUDCommon.FONT_BUTTON, TextSize = 14,
				TextColor3 = PALETTE.danger,
				Text = '\u{2715}',
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.danger, Transparency = 0.5 },
				},
				[Fusion.OnEvent 'Activated'] = function()
					Module.CloseWidget()
				end,
			},

			-- Content row: sits below the title band, inset by DESIGN_PAD on
			-- all sides. Hosts the floors rail + waystones list.
			scope:New('Frame') {
				Name = 'Content',
				AnchorPoint = Vector2.new(0, 0),
				Position = UDim2.fromOffset(DESIGN_PAD, DESIGN_PAD + DESIGN_TITLE_H + DESIGN_PAD),
				Size = UDim2.new(
					1, -(DESIGN_PAD * 2),
					1, -(DESIGN_PAD * 2 + DESIGN_TITLE_H + DESIGN_PAD)
				),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					-- Left: floors scroll (static config; built eagerly).
					(function()
						local children = {
							scope:New('UIListLayout') {
								Padding = UDim.new(0, DESIGN_LIST_GAP),
								SortOrder = Enum.SortOrder.LayoutOrder,
							},
						}
						for name, data in WaystonesData.DisplayCategories do
							table.insert(children, buildCategoryButton(scope, name, data))
						end
						return scope:New('ScrollingFrame') {
							Name = 'Floors',
							Size = UDim2.new(DESIGN_LEFT_FRAC, -DESIGN_COL_GAP / 2, 1, 0),
							BackgroundTransparency = 1,
							BorderSizePixel = 0,
							CanvasSize = UDim2.new(),
							AutomaticCanvasSize = Enum.AutomaticSize.Y,
							ScrollBarThickness = 2,
							ScrollBarImageColor3 = PALETTE.accent,
							[Fusion.Children] = children,
						}
					end)(),

					-- Right: selected-category waystones (static; visibility reactive).
					(function()
						local children = {
							scope:New('UIListLayout') {
								Padding = UDim.new(0, DESIGN_LIST_GAP),
								SortOrder = Enum.SortOrder.LayoutOrder,
							},
						}
						for id, display in WaystonesData.WaystoneDisplays do
							local visible = scope:Computed(function(use)
								return use(ActiveCategory) == display.Category
							end)
							table.insert(children, scope:New('Frame') {
								Name = id,
								Size = UDim2.new(1, 0, 0, DESIGN_WAYSTONE_ROW_H),
								BackgroundTransparency = 1,
								LayoutOrder = display.LayoutOrder or 0,
								Visible = visible,
								[Fusion.Children] = {
									buildWaystoneRow(scope, id, display),
								},
							})
						end
						return scope:New('ScrollingFrame') {
							Name = 'Selection',
							Size = UDim2.new(1 - DESIGN_LEFT_FRAC, -DESIGN_COL_GAP / 2, 1, 0),
							Position = UDim2.new(DESIGN_LEFT_FRAC, DESIGN_COL_GAP / 2, 0, 0),
							BackgroundTransparency = 1,
							BorderSizePixel = 0,
							CanvasSize = UDim2.new(),
							AutomaticCanvasSize = Enum.AutomaticSize.Y,
							ScrollBarThickness = 2,
							ScrollBarImageColor3 = PALETTE.accent,
							[Fusion.Children] = children,
						}
					end)(),
				},
			},
		},
	})

	-- Wrap in a CanvasGroup so the modal fades as a single layer and keeps
	-- its designed 520:320 aspect regardless of screen resolution.
	local root = scope:New('CanvasGroup') {
		Name = 'WaystonesRoot',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(DESIGN_PANEL_W / DESIGN_SCREEN_W, DESIGN_PANEL_H / DESIGN_SCREEN_H),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIAspectRatioConstraint') {
				AspectRatio = DESIGN_PANEL_W / DESIGN_PANEL_H,
				AspectType = Enum.AspectType.FitWithinMaxSize,
				DominantAxis = Enum.DominantAxis.Width,
			},
		},
	}
	inner.Parent = root
	root.Parent = ScreenGui
end

function Module.SetupWaystone(model: Instance)
	local waystoneId = model.Name
	if not waystoneId then
		warn(string.format('Waystone %s has no id!', model:GetFullName()))
		CollectionService:RemoveTag(model, WaystonesData.WaystonesTag)
		return
	end

	local interactable = InteractableService.RegisterInteractable({
		IID = '1',
		Object = model,
		Adornee = model:WaitForChild('Adornee'),
		Center = model:WaitForChild('Center'),
		ObjectText = 'Waystone',
		ActionText = 'Interact with the Waystone!',
		ShowBeamLine = true,
		ShowHighlight = false,
		IsInteractable = function()
			return Module.IsWaystoneUnlocked(waystoneId) and not Module.IsWidgetOpen()
		end,
	})
	ACTIVE_WAYSTONES_CACHE[model] = interactable

	interactable.InteractTriggered:Connect(function()
		ACTIVE_WAYSTONE_ID = waystoneId
		ACTIVE_WAYSTONE_MODEL = model
		Module.OpenWidget()
	end)
end

function Module.CleanupWaystone(model: Instance)
	if ACTIVE_WAYSTONES_CACHE[model] then
		InteractableService.UnRegisterInteractable(ACTIVE_WAYSTONES_CACHE[model])
		ACTIVE_WAYSTONES_CACHE[model] = nil
	end
end

function Module.OnWaystoneUnlocked(unlockedId: string)
	local display = WaystonesData.WaystoneDisplays[unlockedId]
	if not display then return end
	if DataVersion then DataVersion:set(peek(DataVersion) + 1) end
	local msg = string.format('You have discovered the waystone "%s"!', display.Name)
	local effects = SystemsContainer.ParentSystems
		and SystemsContainer.ParentSystems.Effects
	if effects and effects.UnlockedCinematic then
		effects.UnlockedCinematic.DisplayShortUnlock('Waystone Unlocked!', msg)
	end
end

function Module.UpdateWidget()
	if DataVersion then DataVersion:set(peek(DataVersion) + 1) end
	if PlayerFloor then
		PlayerFloor:set(LocalPlayer:GetAttribute('CurrentFloor'))
	end
	-- If current category still unlocked, leave it; otherwise pick first unlocked.
	if ActiveCategory then
		local current = peek(ActiveCategory)
		if not current or not Module.IsCategoryUnlocked(current) then
			for name, _ in WaystonesData.DisplayCategories do
				if Module.IsCategoryUnlocked(name) then
					ActiveCategory:set(name)
					break
				end
			end
		end
	end
end

function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true
	ScreenGui = HUDCommon.ensureScreenGui('HUD_Waystones', 8)
	RootScope = scoped(Fusion)

	ActiveCategory = RootScope:Value(LocalPlayer:GetAttribute('CurrentFloor') or 'Floor1')
	DataVersion    = RootScope:Value(0)
	PlayerFloor    = RootScope:Value(LocalPlayer:GetAttribute('CurrentFloor'))

	buildUI(RootScope)
	Module.UpdateWidget()
end

function Module.CloseWidget()
	Module.ClearActiveWaystone()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
end

function Module.Start()
	for _, waystone in CollectionService:GetTagged(WaystonesData.WaystonesTag) do
		task.defer(Module.SetupWaystone, waystone)
	end
	CollectionService:GetInstanceAddedSignal(WaystonesData.WaystonesTag):Connect(Module.SetupWaystone)
	CollectionService:GetInstanceRemovedSignal(WaystonesData.WaystonesTag):Connect(Module.CleanupWaystone)

	WaystonesEvent.OnClientEvent:Connect(Module.OnWaystoneUnlocked)

	ReplicatedData.OnUpdated:Connect(function(category, _)
		if category == 'PlayerData' and Module.IsWidgetOpen() then
			Module.UpdateWidget()
		end
	end)

	HUDCommon.BindLiveTheme(Module)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/World/init.luau"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="src/StarterPlayerScripts/Core/World/DeathEffectClient.luau"><![CDATA[local CollectionService = game:GetService('CollectionService')
local Debris = game:GetService('Debris')
local TweenService = game:GetService('TweenService')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')

local TAG_NAME = "DEATH_EFFECT"

local SystemsContainer = {}

local function GetDescendantBaseParts( Parent )
	local Descendants = Parent:GetDescendants()
	table.insert(Descendants, Parent)
	return Descendants
end

-- // Module // --
local Module = {}

function Module.UndoDeathEffect( Character )
	Character:SetAttribute("DeathEffectTag", nil)

	local Descendants = GetDescendantBaseParts( Character )
	for _, descendant in Descendants do
		if descendant:IsA("BasePart") then
			local Transparency = (descendant.Name ~= "HumanoidRootPart") and 0 or 1
			descendant.Transparency = Transparency
		elseif descendant:IsA("ParticleEmitter") and descendant.Name == "DeathParticle" then
			descendant:Destroy()
		elseif descendant:IsA("Decal") then
			descendant.Transparency = descendant:GetAttribute("InitTransparency") or descendant.Transparency
		elseif descendant:IsA("BillboardGui") then
			descendant.Enabled = descendant:GetAttribute("InitEnabled") or descendant.Enabled
		end
	end
end

function Module.RunDeathEffect( Character )
	Character:SetAttribute("DeathEffectTag", true)

	local Descendants = GetDescendantBaseParts( Character )
	for _, descendant in Descendants do
		if descendant:IsA("BasePart") then
			if descendant.Transparency == 1 then
				continue
			end
			TweenService:Create( descendant, TweenInfo.new(1.25), { Transparency = 1 } ):Play()
			for _, Particle in ReplicatedAssets.Particles.DeathShatter:GetChildren() do
				local Item = Particle:Clone()
				Item.Parent = descendant
				Item:Emit(10)
				Debris:AddItem(Item, 10)
			end
		elseif descendant:IsA("Decal") then
			if not descendant:GetAttribute("InitTransparency") then
				descendant:SetAttribute("InitTransparency", descendant.Transparency )
			end
			descendant.Transparency = 1
		elseif descendant:IsA("BillboardGui") then
			if not descendant:GetAttribute("InitEnabled") then
				descendant:SetAttribute("InitEnabled", descendant.Enabled )
			end
			descendant.Enabled = false
		end
	end
end

function Module.Start()
	for _, Character in CollectionService:GetTagged(TAG_NAME) do
		task.defer(Module.RunDeathEffect, Character)
	end

	CollectionService:GetInstanceAddedSignal(TAG_NAME):Connect(Module.RunDeathEffect)
	CollectionService:GetInstanceRemovedSignal(TAG_NAME):Connect(Module.UndoDeathEffect)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module]]></Source>
		<Source path="src/StarterPlayerScripts/Core/World/FallingLeavesVFX.luau"><![CDATA[local RunService = game:GetService('RunService')
local CollectionService = game:GetService('CollectionService')

local Players = game:GetService('Players')
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local QuadTreeModule = ReplicatedModules.Modules.QuadTree

local SystemsContainer = {}

local COLLECTION_TAGS = {'FallingLeaves'}
local TOTAL_ACTIVE_FALLING_LEAVES = 24

local ParticlesQuadTree = false
local ParticleRectBoundary = false
local LastUpdateTick = tick()
local LastPosition = nil

local ParticleCache = {}
local InstanceToPoint = {}

local CurrentCamera = workspace.CurrentCamera

local SystemsContainer = {}

local function GetPosition( item )
	return item:IsA("BasePart") and item.Position or item:GetPivot().Position
end

-- // Module // --
local Module = {}

function Module.AppendPoint( item, tag )
	local Pivot = GetPosition( item )

	local point = QuadTreeModule.Point.New({
		x = Pivot.x,
		y = Pivot.z,
		instance = item,
		tag = tag,
	})

	InstanceToPoint[ item ] = point
	ParticlesQuadTree:Insert(point)
end

function Module.RemovePoint( item, _ )
	local Point = InstanceToPoint[ item ]
	if not Point then
		return
	end
	InstanceToPoint[ item ] = nil
	ParticlesQuadTree:Remove( Point )
end

function Module.StepRender()
	local Pivot = CurrentCamera.CFrame.Position
	-- check if the camera has moved around
	if LastPosition and (Pivot - LastPosition).Magnitude < 5 then
		return
	end
	LastPosition = Pivot

	ParticleRectBoundary.x = Pivot.X
	ParticleRectBoundary.y = Pivot.Z

	local withinRender = ParticlesQuadTree:Query(ParticleRectBoundary, {})

	-- sort all points from closest to furthest
	table.sort(withinRender, function(a, b)
		local d1 = (Pivot - GetPosition( a.instance )).Magnitude
		local d2 = (Pivot - GetPosition( b.instance )).Magnitude
		return d1 < d2
	end)

	local currentSFXIndex = {}
	for _, tag in COLLECTION_TAGS do
		currentSFXIndex[tag] = 1
	end

	-- move sounds into nearby related tag instances
	for _, point in withinRender do
		if not currentSFXIndex[point.tag] then
			warn('unsupported tag; ' .. tostring(point.tag))
			continue
		end

		if currentSFXIndex[point.tag] > TOTAL_ACTIVE_FALLING_LEAVES then
			continue
		end

		local SoundIndex = currentSFXIndex[point.tag]
		local Sound = ParticleCache[point.tag][SoundIndex]

		local _, size = point.instance:GetBoundingBox()
		local offset = Vector3.new(0, size.Y / 2, 0)
		Sound:PivotTo(point.instance:GetPivot() + offset)
		Sound.Parent = workspace.Terrain

		currentSFXIndex[point.tag] += 1
	end

	-- move non-playing sounds back
	for tag, soundArray in ParticleCache do
		for index, particles in soundArray do
			if index > currentSFXIndex[tag] then
				particles.Parent = script
			end
		end
	end

end

function Module.Start()
	ParticleRectBoundary = QuadTreeModule.Rectangle.New({width = 256, height = 256})
	-- TODO: move to QuadTree Service
	ParticlesQuadTree = QuadTreeModule.QuadTree.New({
		boundary = QuadTreeModule.Rectangle.New({width = 10240, height = 10240}),
		capacity = 4,
	})

	for _, tag in COLLECTION_TAGS do
		for _, item in CollectionService:GetTagged(tag) do
			Module.AppendPoint(item, tag)
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(function(item)
			Module.AppendPoint(item, tag)
		end)
		CollectionService:GetInstanceRemovedSignal(tag):Connect(function(item)
			Module.RemovePoint(item, tag)
		end)
	end

	RunService.Heartbeat:Connect(function()
		if tick() < LastUpdateTick then
			return
		end
		-- check for update every 1 second
		LastUpdateTick = tick() + 1.5
		Module.StepRender()
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems

	-- create a cache table for the sounds below
	for _, tag in COLLECTION_TAGS do
		ParticleCache[tag] = { }
	end

	-- generate all the sound objects
	for _ = 1, TOTAL_ACTIVE_FALLING_LEAVES do
		local part = ReplicatedAssets.Particles.FallingLeaves:Clone()
		part.Parent = script
		table.insert(ParticleCache.FallingLeaves, part)
	end
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/World/FirefliesClient.luau"><![CDATA[
-- TODO: use quad-tree service to render only nearby fireflies on characters around the player

local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")

local COLLECTION_TAG = 'FIREFLIES_SURROUND'

local MAX_RANGE_AROUND_OBJECT = 9
local MIN_RANGE_AROUND_OBJECT = 3
local FIREFLY_SPEED = 0.7
local FIREFLY_MINIMUM_DURATION = 1
local MINIMUM_DELAY_BETWEEN_SPAWNS = 0.9

local LAST_FIREFLY_SPAWN = {} :: { [PVInstance] : number }

local SystemsContainer = {}

local baseFirefly = Instance.new('Part')
baseFirefly.Size = Vector3.new(0.05, 0.05, 0.05)
baseFirefly.Material = Enum.Material.Neon
baseFirefly.Color = Color3.fromRGB(255, 231, 18)
baseFirefly.Anchored = true
baseFirefly.CanCollide = false
baseFirefly.CanTouch = false
baseFirefly.CanQuery = false
baseFirefly.Transparency = 0
baseFirefly.TopSurface = Enum.SurfaceType.Smooth
baseFirefly.BottomSurface = Enum.SurfaceType.Smooth

-- // Module // --
local Module = {}

function Module.GetRandomOffsetFromPosition(position : Vector3) : Vector3
	local range = (MAX_RANGE_AROUND_OBJECT - MIN_RANGE_AROUND_OBJECT)
	local offset = Vector3.new(
		(math.random(0, range) + MIN_RANGE_AROUND_OBJECT) * (math.random(1, 2) == 1 and -1 or 1),
		math.random(-range, range),
		(math.random(0, range) + MIN_RANGE_AROUND_OBJECT) * (math.random(1, 2) == 1 and -1 or 1)
	)
	return position + offset
end

function Module.FirefliesUpdate()
	local now = time()
	for _, object : PVInstance in CollectionService:GetTagged(COLLECTION_TAG) do
		-- ignore non-pivotable items
		if not object:IsA('PVInstance') then
			continue
		end

		-- check for active data
		if LAST_FIREFLY_SPAWN[object] and (now - LAST_FIREFLY_SPAWN[object]) < MINIMUM_DELAY_BETWEEN_SPAWNS  then
			continue
		end
		LAST_FIREFLY_SPAWN[object] = now

		local objectPosition = object:GetPivot().Position
		local firflyStart : Vector3 = Module.GetRandomOffsetFromPosition(objectPosition)
		local firflyEnd : Vector3 = Module.GetRandomOffsetFromPosition(objectPosition)

		local firefly : Part = baseFirefly:Clone()
		firefly.Position = firflyStart
		firefly.Parent = workspace.Terrain

		local duration : number = (firflyEnd - firflyStart).Magnitude / FIREFLY_SPEED
		duration = math.max(duration, FIREFLY_MINIMUM_DURATION)
		TweenService:Create(firefly, TweenInfo.new(duration), {Position = firflyEnd}):Play()
		task.delay(duration - 0.5, function()
			TweenService:Create(firefly, TweenInfo.new(1), {Transparency = 1}):Play()
			task.wait(1)
			firefly:Destroy()
		end)
	end
end

function Module.ValidateTagInstance(object : Instance)
	-- only accept PVInstances in the tag (so we can use PivotTo/GetPivot)
	if not object:IsA('PVInstance') then
		CollectionService:RemoveTag(object, COLLECTION_TAG)
	end
end

function Module.OnObjectRemoved(object : Instance)
	LAST_FIREFLY_SPAWN[object] = nil
end

function Module.Start()

	for _, object in CollectionService:GetTagged(COLLECTION_TAG) do
		task.defer(Module.ValidateTagInstance, object)
	end
	CollectionService:GetInstanceAddedSignal(COLLECTION_TAG):Connect(Module.ValidateTagInstance)
	CollectionService:GetInstanceRemovedSignal(COLLECTION_TAG):Connect(Module.OnObjectRemoved)

	task.spawn(function()
		while true do
			task.wait(0.1)
			Module.FirefliesUpdate()
		end
	end)

end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/World/FootstepClient.luau"><![CDATA[local RunService = game:GetService("RunService")

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')

local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))
local MaidClassModule = ReplicatedModules.Modules.Maid

local FootstepSoundsInstance = ReplicatedAssets.Sounds.FootstepSounds

local SystemsContainer = {}

local ActiveCharacterData = { }
local CharacterToPlayerCache = { }

-- // Module // --
local Module = {}

function Module.CleanupPlayerInstance( PlayerInstance )
	-- cleanup old character for this player
	if CharacterToPlayerCache[ PlayerInstance ] then
		Module.CleanupCharacter( CharacterToPlayerCache[ PlayerInstance ] )
	end
	CharacterToPlayerCache[ PlayerInstance ] = nil
end

function Module.CleanupCharacter( CharacterInstance )
	if ActiveCharacterData[ CharacterInstance ] then
		ActiveCharacterData[ CharacterInstance ].Maid:Cleanup()
	end
	ActiveCharacterData[ CharacterInstance ] = nil
end

function Module.StopSoundInstances( SoundInstances )
	for _, soundInstance in SoundInstances do
		soundInstance:Stop(0.15)
	end
end

function Module.UpdateCharacterMaterialSounds( CharacterData )
	-- if they are not walking, stop all sounds
	if not CharacterData.Walking then
		Module.StopSoundInstances( CharacterData.Sounds:GetChildren() )
		return
	end

	-- stop playing old material sound
	local CurrentMaterial = CharacterData.CurrentMaterial
	local LastMaterial = CharacterData.LastMaterial
	if LastMaterial and CurrentMaterial ~= LastMaterial then
		local LastMaterialSound = CharacterData.Sounds:FindFirstChild( LastMaterial )
		if LastMaterialSound then
			LastMaterialSound:Stop( 0.15 )
		end
	end
	CharacterData.LastMaterial = CurrentMaterial

	local CurrentMaterialSound = CurrentMaterial and CharacterData.Sounds:FindFirstChild( CurrentMaterial )
	if not CurrentMaterialSound then
		return
	end

	-- edit playback speed
	local PlaybackSpeed = CharacterData.CurrentSpeed / (CharacterData.Humanoid.WalkSpeed * 0.75)
	CurrentMaterialSound.PlaybackSpeed = PlaybackSpeed

	-- play new material sound if not already playing
	if not CurrentMaterialSound.IsPlaying then
		CurrentMaterialSound:Play( 0.15 )
	end
end

function Module.OnCharacterAdded( PlayerInstance, CharacterInstance )
	local Humanoid = CharacterInstance and CharacterInstance:WaitForChild('Humanoid', 5)
	if not Humanoid then
		return
	end

	local HumanoidRootPart = CharacterInstance:WaitForChild('HumanoidRootPart', 5)
	if not HumanoidRootPart then
		return
	end

	-- set the new character into the cache
	Module.CleanupPlayerInstance( PlayerInstance )
	CharacterToPlayerCache[ PlayerInstance ] = CharacterInstance

	-- character maid stuff
	local CharacterMaid = MaidClassModule.New()

	CharacterMaid:Give(Humanoid.Died:Connect(function()
		Module.CleanupCharacter( CharacterInstance )
	end))

	CharacterMaid:Give(Humanoid:GetPropertyChangedSignal("FloorMaterial"):Connect(function()
		ActiveCharacterData[ CharacterInstance ].CurrentMaterial = Humanoid.FloorMaterial.Name
	end))

	CharacterMaid:Give(Humanoid.Running:Connect(function(speed)
		-- must be a minumum speed to be walking
		ActiveCharacterData[ CharacterInstance ].CurrentSpeed = speed
		ActiveCharacterData[ CharacterInstance ].Walking = speed > (Humanoid.WalkSpeed / 2)
	end))

	local FootstepSoundClone = FootstepSoundsInstance:Clone()
	FootstepSoundClone.Parent = CharacterInstance

	ActiveCharacterData[ CharacterInstance ] = {
		Humanoid = Humanoid,
		Sounds = FootstepSoundClone,
		Walking = false,
		CurrentSpeed = 0,
		CurrentMaterial = false,
		LastMaterial = false,
		Maid = CharacterMaid,
	}

	-- disable normal character sounds
	for _, SoundInstance in HumanoidRootPart:GetChildren() do
		if SoundInstance:IsA("Sound") then
			SoundInstance.Volume = 0
		end
	end
end

function Module.OnPlayerAdded( PlayerInstance )
	task.defer(Module.OnCharacterAdded, PlayerInstance, PlayerInstance.Character)
	PlayerInstance.CharacterAdded:Connect(function( CharacterInstance )
		Module.OnCharacterAdded( PlayerInstance, CharacterInstance )
	end)
end

function Module.Start()
	Module.OnPlayerAdded( LocalPlayer )
	for _, PlayerInstance in Players:GetPlayers() do
		if PlayerInstance == LocalPlayer then
			continue
		end
		Module.OnPlayerAdded( PlayerInstance )
	end

	Players.PlayerAdded:Connect(Module.OnPlayerAdded)
	Players.PlayerRemoving:Connect(Module.CleanupPlayerInstance)

	RunService.Heartbeat:Connect(function(_)
		for CharacterInstance, CharacterData in ActiveCharacterData do
			if (not CharacterInstance.Parent) or CharacterInstance.Humanoid.Health <= 0 then
				Module.CleanupCharacter( CharacterInstance )
				continue
			end
			Module.UpdateCharacterMaterialSounds( CharacterData )
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/World/LightingClient.luau"><![CDATA[
local RunService = game:GetService('RunService')
local TweenService = game:GetService('TweenService')
local Lighting = game:GetService('Lighting')

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer


local LocalModules = require(LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("Modules"))
local LightingDataModule = LocalModules.Data.LightingData
local RainModule = LocalModules.Modules.Rain

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')

local RainSFX = ReplicatedAssets.Sounds.Local.RainLoopSFX
local ThunderSFX = ReplicatedAssets.Sounds.Local.ThunderSFX

local CurrentTimeValue = Instance.new('NumberValue')
CurrentTimeValue.Name = 'TimeValue'
CurrentTimeValue.Value = (LightingDataModule.Timestamps.Morning[1] + ReplicatedStorage:GetAttribute('SyncingTimeValue') or 0) % 24
CurrentTimeValue.Parent = script

local CurrentWeatherValue = Instance.new('StringValue')
CurrentWeatherValue.Name = 'CurrentWeather'
CurrentWeatherValue.Parent = script

local RainEnabledValue = Instance.new('BoolValue')
RainEnabledValue.Name = 'RainEnabled'
RainEnabledValue.Value = false
RainEnabledValue.Parent = script

local DAYNIGHT_CYCLE_TIME_SCALE = 0.05
local RainDropletTweenInfo = TweenInfo.new(2, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)
local MaxRainVolume = RainSFX.Volume
local MaxThunderVolume = ThunderSFX.Volume

local SystemsContainer = {}

local IsCurrentlyAThunderstorm = false
local IsBusy = false
local HasSetConstantValue = false
local ActiveWeatherCondition = 'Clear'
local CurrentPropertyNumber = 0
local NextThunderTime = time()

local CURRENT_LIGHTING_PRESET = LightingDataModule.LightingPresets.Default

local function LerpNumber( v0 : number, v1 : number, delta : number )
	return v0 + delta * (v1 - v0);
end

local function DeepCopy( parent )
	local clonedTable = {}
	if typeof(parent) == "table" then
		for k,v in parent do
			clonedTable[DeepCopy(k)] = DeepCopy(v)
		end
	else
		clonedTable = parent
	end
	return clonedTable
end

--[[
	local function SetProperties( Parent, Properties )
		if typeof(Properties) == 'table' then
			for propName, propValue in Properties do
				Parent[propName] = propValue
			end
		end
		return Parent
	end
]]

local function InterpolateProperties( CurrentProperties, NextProperties, delta )
	local Interpolated = { }
	for propName, propValue in CurrentProperties do
		if not NextProperties[propName] then
			continue
		end
		-- print( typeof(propValue), propValue, NextProperties[propName], delta )
		if typeof(propValue) == 'number' then
			Interpolated[propName] = LerpNumber( propValue, NextProperties[propName], delta )
		elseif typeof(propValue) == 'Color3' then
			Interpolated[propName] = propValue:Lerp( NextProperties[propName], delta )
		elseif typeof(propValue) == 'boolean' or typeof(propValue) == 'string' then
			if delta < 0.5 then
				Interpolated[propName] = propValue
			else
				Interpolated[propName] = NextProperties[propValue]
			end
		else
			Interpolated[propName] = NextProperties[propValue]
		end
	end
	return Interpolated
end

local function InterpolateWeatherProperties( CurrentData, NextData, delta )
	local TransitionedData = {
		Properties = InterpolateProperties( CurrentData.Properties, NextData.Properties, delta ),
		Effects = { },
	}
	for effectName, effectProps in CurrentData.Effects do
		local NextEffectProperties = NextData.Effects[effectName]
		if NextEffectProperties then
			TransitionedData.Effects[effectName] = InterpolateProperties( effectProps, NextEffectProperties, delta )
		end
	end
	for effectName, otherProps in NextData.Effects do
		if not TransitionedData.Effects[effectName] then
			TransitionedData.Effects[effectName] = otherProps
		end
	end
	return TransitionedData
end

--[[
	-- TODO: add patches to make sure classes exist
	local function ApplyPropertiesToLighting( Properties )
		SetProperties( Lighting, Properties.Properties )
		for className, propValues in Properties.Effects do
			local targetInstance = Lighting:FindFirstChildWhichIsA( className )
			if not targetInstance then
				targetInstance = Instance.new(className)
				targetInstance.Name = 'EFFECT_'..className
				pcall(function()
					targetInstance.Enabled = true
				end)
				targetInstance.Parent = Lighting
			end
			SetProperties( targetInstance, propValues )
		end
	end
]]

local function TweenProperties( parent, properties, duration )
	properties = DeepCopy(properties)
	for propName, propValue in properties do
		if typeof(propValue) == 'string' then
			properties[propName] = nil
			task.delay(duration / 2, function()
				parent[propName] = propValue
			end)
		end
	end
	local tween = TweenService:Create( parent, TweenInfo.new(duration), properties )
	tween:Play()
	return tween
end

-- // Module // --
local Module = {}

function Module.SetMasterVolume( multiplier : number )
	multiplier = (multiplier or 0.5)
	RainSFX.Volume = MaxRainVolume * multiplier
	ThunderSFX.Volume = MaxThunderVolume * multiplier
end

function Module.ToggleRain( enabled : boolean )
	if enabled then
		RainSFX:Play()
		RainModule:Enable(RainDropletTweenInfo)
	else
		RainSFX:Stop()
		RainModule:Disable()
	end
end

function Module.GetDayNightTimeProperties( timeValue : number )
	if timeValue >= LightingDataModule.Timestamps.Morning[1] and timeValue < LightingDataModule.Timestamps.Morning[2] then
		-- night -> morning
		local min, max = unpack( LightingDataModule.Timestamps.Morning )
		local timeDelta : number = (timeValue - min) / (max - min)
		return 1, false, InterpolateWeatherProperties( CURRENT_LIGHTING_PRESET.Night, CURRENT_LIGHTING_PRESET.Morning, timeDelta )
	elseif timeValue >= LightingDataModule.Timestamps.Morning[2] and timeValue < LightingDataModule.Timestamps.Day[1] then
		-- morning
		return 2, true, CURRENT_LIGHTING_PRESET.Morning
	elseif timeValue >= LightingDataModule.Timestamps.Day[1] and timeValue < LightingDataModule.Timestamps.Day[2] then
		-- morning -> day
		local min, max = unpack( LightingDataModule.Timestamps.Day )
		local timeDelta : number = (timeValue - min) / (max - min)
		return 3, false, InterpolateWeatherProperties( CURRENT_LIGHTING_PRESET.Morning, CURRENT_LIGHTING_PRESET.Day, timeDelta )
	elseif timeValue >= LightingDataModule.Timestamps.Day[2] and timeValue < LightingDataModule.Timestamps.Afternoon[1] then
		-- day
		return 4, true, CURRENT_LIGHTING_PRESET.Day
	elseif timeValue >= LightingDataModule.Timestamps.Afternoon[1] and timeValue < LightingDataModule.Timestamps.Afternoon[2] then
		-- day -> afternoon
		local min, max = unpack( LightingDataModule.Timestamps.Afternoon )
		local timeDelta : number = (timeValue - min) / (max - min)
		return 5, false, InterpolateWeatherProperties( CURRENT_LIGHTING_PRESET.Day, CURRENT_LIGHTING_PRESET.Afternoon, timeDelta )
	elseif timeValue >= LightingDataModule.Timestamps.Afternoon[2] and timeValue < LightingDataModule.Timestamps.Night[1] then
		-- afternoon
		return 6, true, CURRENT_LIGHTING_PRESET.Afternoon
	elseif timeValue >= LightingDataModule.Timestamps.Night[1] and timeValue < LightingDataModule.Timestamps.Night[2] then
		-- afternoon -> night
		local min, max = unpack( LightingDataModule.Timestamps.Night )
		local timeDelta : number = (timeValue - min) / (max - min)
		return 7, false, InterpolateWeatherProperties( CURRENT_LIGHTING_PRESET.Afternoon, CURRENT_LIGHTING_PRESET.Night, timeDelta )
	elseif timeValue >= LightingDataModule.Timestamps.Night[2] or timeValue < LightingDataModule.Timestamps.Morning[1] then
		-- night
		return 8, true, CURRENT_LIGHTING_PRESET.Night
	else
		print('TIME IS NOT SUPPORTED:' , timeValue)
	end
end

function Module.UpdateTimeAndWeather()
	if CurrentTimeValue.Value > 24 then
		CurrentTimeValue.Value = 0
	elseif CurrentTimeValue.Value < 0 then
		CurrentTimeValue.Value = 24
	end
	Lighting.ClockTime = CurrentTimeValue.Value

	-- thunderstorm lighting
	if IsCurrentlyAThunderstorm then
		if time() > NextThunderTime and Random.new():NextInteger(1, CURRENT_LIGHTING_PRESET.Thunderstorm.ThunderChance or 1000) == 1 then
			NextThunderTime = time() + 10 -- prevents thunder spam
			local Atmosphere = Lighting:FindFirstChildWhichIsA('Atmosphere')
			if Atmosphere then
				local BaseColor = CURRENT_LIGHTING_PRESET.Thunderstorm.Effects.Atmosphere.Color
				TweenProperties( Atmosphere, { Color = BaseColor:Lerp( Color3.new(1,1,1), 0.5 )  }, 0.1 )
				task.delay(0.1, function()
					ThunderSFX:Play()
					if ActiveWeatherCondition == 'Thunderstorm' then
						TweenProperties( Atmosphere, { Color = BaseColor }, 0.2 )
					end
				end)
			end
		end

		if ActiveWeatherCondition == 'Thunderstorm' then
			return
		end
		ActiveWeatherCondition = 'Thunderstorm'
		IsBusy = false
		-- TODO: update lighting to thunderstorm
		TweenProperties( Lighting, CURRENT_LIGHTING_PRESET.Thunderstorm.Properties, 3 )
		for effectName, effectProperties in CURRENT_LIGHTING_PRESET.Thunderstorm.Effects do
			local targetInstance = Lighting:FindFirstChildWhichIsA( effectName )
			if not targetInstance then
				continue
			end
			TweenProperties( targetInstance, effectProperties, 3 )
		end
		return
	end

	-- day/night lighting
	local Number, IsInterpolating, CurrentTimeLightingProperties = Module.GetDayNightTimeProperties( CurrentTimeValue.Value )
	if ActiveWeatherCondition == 'Thunderstorm' then
		ActiveWeatherCondition = 'Clear'
		IsBusy = true
		--[[
			TODO: tween all effects and stuff
			to the current time interpolation value
			(or target constant value) then set
			IsBusy to false on tween finished
		]]
		TweenProperties( Lighting, CurrentTimeLightingProperties.Properties, 3 )
		for effectName, effectProperties in CurrentTimeLightingProperties.Effects do
			local targetInstance = Lighting:FindFirstChildWhichIsA( effectName )
			if not targetInstance then
				continue
			end
			TweenProperties( targetInstance, effectProperties, 3 )
		end
	elseif not IsBusy then
		--[[
			TODO: tween lighting properties
			(check if its a interpolating or constant value)
		]]
		if IsInterpolating or (not HasSetConstantValue) or CurrentPropertyNumber ~= Number then
			CurrentPropertyNumber = Number
			local Duration = IsInterpolating and 0.5 or 1.25
			TweenProperties( Lighting, CurrentTimeLightingProperties.Properties, Duration )
			for effectName, effectProperties in CurrentTimeLightingProperties.Effects do
				local targetInstance = Lighting:FindFirstChildWhichIsA( effectName )
				if not targetInstance then
					continue
				end
				TweenProperties( targetInstance, effectProperties, Duration )
			end
		end
		HasSetConstantValue = IsInterpolating
	end

end

function Module.Start()
	-- task.spawn(Module.SetMasterLightingTheme, 'Realism') -- TODO: make a client setting
	-- task.spawn(Module.SetMasterVolume, 1) -- TODO: change to stored client settings
	task.spawn(Module.ToggleRain, RainEnabledValue.Value)
	task.spawn(Module.UpdateTimeAndWeather)

	RainEnabledValue.Changed:Connect(Module.ToggleRain)
	CurrentTimeValue.Changed:Connect(Module.UpdateTimeAndWeather)

	IsCurrentlyAThunderstorm = ReplicatedStorage:GetAttribute('Thunderstorm') == true
	ReplicatedStorage:GetAttributeChangedSignal('Thunderstorm'):Connect(function()
		IsCurrentlyAThunderstorm = ReplicatedStorage:GetAttribute('Thunderstorm') == true
		Module.ToggleRain( IsCurrentlyAThunderstorm )
	end)

	RunService.Heartbeat:Connect(function(dt)
		CurrentTimeValue.Value += (DAYNIGHT_CYCLE_TIME_SCALE * dt)
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/World/RenderSystemClient.luau"><![CDATA[
local HttpService = game:GetService('HttpService')
local CollectionService = game:GetService('CollectionService')

local Players = game:GetService('Players')
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local LODSettings = ReplicatedModules.Data.LODSettings
local ZoneService = ReplicatedModules.Services.ZoneService
local QuadTree = ReplicatedModules.Modules.QuadTree
local Maid = ReplicatedModules.Modules.Maid

local TEMPORARY_LOD_CONTAINER = ReplicatedStorage:WaitForChild('RenderLODCache')
local TEMPORARY_INTERIORS_CONTAINER = ReplicatedStorage:WaitForChild('RenderInteriorCache')

local ACTIVE_RENDERS_FOLDER = workspace:FindFirstChild('ACTIVE_RENDERS')
if not ACTIVE_RENDERS_FOLDER then
	ACTIVE_RENDERS_FOLDER = Instance.new('Folder')
	ACTIVE_RENDERS_FOLDER.Name = 'ACTIVE_RENDERS'
	ACTIVE_RENDERS_FOLDER.Parent = workspace
end

local CurrentCamera = workspace.CurrentCamera

local LOD_QUAD_TREES = {}

local LOD_TAG_BOUNDS = {} -- tag bounds
local LOD_TAG_BILLBOARD_BOUNDS = {} -- tag billboard bounds

local LOD_TAG_POINTS = {} -- all points in the rendering system
local LOD_ACTIVE_POINTS = {} -- points that are rendered
local LOD_BILLBOARD_ACTIVE_POINTS = {} -- points that have their billboards active

local LOD_INSTANCE_TO_BILLBOARDS = {} -- instance <-> billboard mapping

local INTERIOR_RENDER_DATA = {}

-- Module --
local Module = {}

function Module.GetBillboardForLODInstance(object : Instance, createIfMissing : boolean?) : BillboardGui?
	if LOD_INSTANCE_TO_BILLBOARDS[object] then
		return LOD_INSTANCE_TO_BILLBOARDS[object]
	end
	local TemplateBillboard = ReplicatedAssets.UI.Local.Renders:FindFirstChild( object.Name )
	if createIfMissing and TemplateBillboard then
		local BoundCF, BoundSize
		if object:IsA('Model') then
			BoundCF, BoundSize = object:GetBoundingBox()
		else
			BoundCF, BoundSize = object.CFrame, object.Size
		end
		local Attachment = Instance.new('Attachment')
		Attachment.Name = 'StylizedTreeBillboard'
		Attachment.WorldCFrame = BoundCF * CFrame.new(0, -BoundSize.Y / 2, 0)
		Attachment.Parent = workspace.Terrain
		local Billboard = TemplateBillboard:Clone()
		Billboard.Enabled = false
		Billboard.Adornee = Attachment
		Billboard.Parent = CurrentCamera
		LOD_INSTANCE_TO_BILLBOARDS[object] = Billboard
	end
	return LOD_INSTANCE_TO_BILLBOARDS[object] or nil
end

function Module.DestroyBillboardForLODInstance( object : Instance )
	local Billboard = LOD_INSTANCE_TO_BILLBOARDS[object]
	if Billboard then
		Billboard.Adornee:Destroy() -- attachment
		Billboard:Destroy() -- billboard
		LOD_INSTANCE_TO_BILLBOARDS[object] = nil
	end
end

function Module.SetupLOD()

	-- function to handle object setup
	local function SetupObject(object, tag)
		local success, err = pcall(function()
			object.Parent = TEMPORARY_LOD_CONTAINER
		end)
		if not success then
			warn(object:GetFullName())
			warn(err) -- bones, attachments will appear in the error
			return -- dont append to quad tree
		end
		-- get the bounds position/size
		local cframe, size = nil, nil
		if object:IsA('Model') then
			cframe, size = object:GetBoundingBox()
		elseif object:IsA('BasePart') then
			cframe, size = object.CFrame, object.Size
		end
		-- create the bounds
		local LOD_bounds = QuadTree.Rectangle.New({
			x = cframe.Position.X,
			y = cframe.Position.Z,
			width = size.X,
			height = size.Z,
			data = object,
		})
		-- add to the tag points
		table.insert(LOD_TAG_POINTS[tag], LOD_bounds)
		-- insert it into the quad tree
		LOD_QUAD_TREES[tag]:Insert(LOD_bounds)
	end

	-- function to reset the object
	local function ResetObject(object, tag)
		local success, err = pcall(function()
			object.Parent = TEMPORARY_LOD_CONTAINER
		end)
		if not success then
			warn(object:GetFullName())
			warn(err) -- bones, attachments will appear in the error
		end
		-- delete the object bounds
		for index, bounds in LOD_TAG_POINTS[tag] do
			if bounds.data == object then
				LOD_QUAD_TREES[tag]:Remove(bounds)
				table.remove(LOD_TAG_POINTS[tag], index)
				break
			end
		end
		-- delete the billboard if found
		Module.DestroyBillboardForLODInstance(object)
	end

	for _, LODTag in LODSettings.LODTags do
		if table.find(LODSettings.ClientEnabled, LODTag) then
			continue
		end

		-- generate the render distance bounds
		local RD = LODSettings.LODRenderDistances[LODTag] or LODSettings.LODRenderDistances.Default
		local LODBounds = QuadTree.Rectangle.New({
			x = 0,
			y = 0,
			width = RD,
			height = RD,
		})
		LOD_TAG_BOUNDS[LODTag] = LODBounds

		local BillboardRD = LODSettings.BillboardRenderDistances[LODTag] or LODSettings.BillboardRenderDistances.Default
		local LODBillboardBounds = QuadTree.Rectangle.New({
			x = 0,
			y = 0,
			width = BillboardRD,
			height = BillboardRD,
		})
		LOD_TAG_BILLBOARD_BOUNDS[LODTag] = LODBillboardBounds

		-- generate the tag quad tree
		local QuadTreeBounds = QuadTree.Rectangle.New({
			x = 0,
			y = 0,
			width = LODSettings.MaximumQuadTreeBounds,
			height = LODSettings.MaximumQuadTreeBounds,
		})
		-- TODO: move to QuadTree Service
		LOD_QUAD_TREES[LODTag] = QuadTree.QuadTree.New({boundary = QuadTreeBounds})

		-- array of render items
		LOD_TAG_POINTS[LODTag] = {}

		--print('Hiding LODTag:', LODTag)
		-- un-render the rest on the server
		for _, object in CollectionService:GetTagged(LODTag) do
			task.defer(SetupObject, object, LODTag)
		end
		-- unrender any newly tagged instances
		CollectionService:GetInstanceAddedSignal(LODTag):Connect(function(object)
			SetupObject(object, LODTag)
		end)
		-- reset untagged instances
		CollectionService:GetInstanceRemovedSignal(LODTag):Connect(function(object)
			ResetObject(object, LODTag)
		end)
	end

end

function Module.SetupInteriors()

	-- function to handle object setup
	local function SetupObject(object, tag)
		-- objects container
		local ObjectsContainer = object:FindFirstChild('Objects')
		if not ObjectsContainer then
			warn('Could not find "Objects" item in Interior: '..tostring(object:GetFullName()))
			return
		end
		-- zones container
		local ZonesContainer = object:FindFirstChild('Zones')
		if not ZonesContainer then
			warn('Could not find "Zones" item in Interior: '..object:GetFullName())
			return
		end
		-- setup interior params
		local InteriorData = { UUID = HttpService:GenerateGUID(false), Tag = tag, Objects = {}, Zones = {}, Maid = Maid.New(), }
		-- change the properties to the adjusted ones
		for _, zoneObject in ZonesContainer:GetChildren() do
			if zoneObject:IsA('BasePart') then
				zoneObject.CanCollide = false
				zoneObject.CanQuery = true
				zoneObject.CanTouch = false
				zoneObject.CastShadow = false
				zoneObject.Transparency = 1
				zoneObject.Massless = true
				table.insert(InteriorData.Zones, zoneObject)
			else
				warn('Unsupported Zone object in Zones container: '..object:GetFullName())
			end
		end

		InteriorData.Maid:Give(ZonesContainer.ChildAdded:Connect(function(item)
			if item:IsA('BasePart') and not table.find(InteriorData.Zones, item) then
				table.insert(InteriorData.Zones, item)
			end
		end))

		InteriorData.Maid:Give(ZonesContainer.ChildRemoved:Connect(function(item)
			if item:IsA('BasePart') and table.find(InteriorData.Zones, item) then
				table.remove(InteriorData.Zones, table.find(InteriorData.Zones, item))
			end
		end))

		ZoneService.RegisterZone(InteriorData.UUID, InteriorData.Zones)

		-- iterate each ObjectValue or Instance under the Objects container.
		local function onObjectReferenceAdded(objectReference)
			local renderItem = objectReference
			if objectReference:IsA('ObjectValue') then
				renderItem = objectReference.Value
			end
			if not renderItem then
				warn('ObjectValue has no reference: '..objectReference:GetFullName())
				return
			end
			table.insert(InteriorData.Objects, renderItem)
			local success, err = pcall(function()
				renderItem.Parent = TEMPORARY_INTERIORS_CONTAINER
			end)
			if not success then
				warn(renderItem:GetFullName())
				warn(err) -- bones, attachments will appear in the error
			end
		end

		for _, objectReference in ObjectsContainer:GetChildren() do
			onObjectReferenceAdded(objectReference)
		end
		InteriorData.Maid:Give(ObjectsContainer.ChildAdded:Connect(onObjectReferenceAdded))

		InteriorData.Maid:Give(ZonesContainer.ChildRemoved:Connect(function(item)
			if item:IsA('BasePart') and table.find(InteriorData.Zones, item) then
				table.remove(InteriorData.Zones, table.find(InteriorData.Zones, item))
			end
		end))

		-- cache interior data
		INTERIOR_RENDER_DATA[object] = InteriorData
	end

	-- function to reset the object
	local function ResetObject(object, _)
		-- check if the data exists
		local data = INTERIOR_RENDER_DATA[object]
		if not data then
			return
		end
		-- reset all the objects and unregister the zone parts
		for _, renderItem in INTERIOR_RENDER_DATA[object].Objects do
			renderItem.Parent = ACTIVE_RENDERS_FOLDER
		end
		INTERIOR_RENDER_DATA[object] = nil
		-- unregister the zone parts
		ZoneService.UnRegisterZoneParts(data.Zones)
	end

	for _, InteriorTag in LODSettings.InteriorTags do
		if table.find(LODSettings.ClientEnabled, InteriorTag) then
			continue
		end
		--print('Hiding InteriorTag:', InteriorTag)
		-- un-render the interior objects
		for _, object in CollectionService:GetTagged(InteriorTag) do
			task.defer(SetupObject, object, InteriorTag)
		end
		-- unrender any newly tagged instances
		CollectionService:GetInstanceAddedSignal(InteriorTag):Connect(function(object)
			SetupObject(object, InteriorTag)
		end)
		-- reset untagged instances
		CollectionService:GetInstanceRemovedSignal(InteriorTag):Connect(function(object)
			ResetObject(object, InteriorTag)
		end)
	end

end

function Module.UpdateLODs()
	-- move all render bounds to the current position
	local Position = LocalPlayer.Character and LocalPlayer.Character:GetPivot().Position or CurrentCamera.CFrame.Position
	local Velocity = LocalPlayer.Character and LocalPlayer.Character.PrimaryPart and LocalPlayer.Character.PrimaryPart.AssemblyLinearVelocity

	-- query all quad-trees for nearby points
	local nearby_points = {}
	local nearby_billboards = {}

	-- iterate each quad tree
	for LODTag, tree in LOD_QUAD_TREES do
		-- ignore any non-whitelisted high-velocity
		-- rendering tags when higher than the velocity threshold
		if Velocity and Velocity.Magnitude > LODSettings.HighVelocityThreshold then
			if not table.find(LODSettings.HighVelocityTagWhitelist, LODTag) then
				continue
			end
		end

		-- normal render distance
		local bounds = LOD_TAG_BOUNDS[LODTag]
		bounds.x = Position.X
		bounds.y = Position.Z
		local points = tree:Query(bounds, {})
		if #points > 0 then
			table.move(points, 1, #points, #nearby_points+1, nearby_points)
		end

		-- check if tag is whitelisted for billboards
		if not table.find(LODSettings.BillboardEnabledTags, LODTag) then
			continue
		end

		-- billboard render distance
		local boundsBB = LOD_TAG_BILLBOARD_BOUNDS[LODTag]
		boundsBB.x = Position.X
		boundsBB.y = Position.Z
		local bbpoints = tree:Query(boundsBB, {})
		if #bbpoints > 0 then
			table.move(bbpoints, 1, #bbpoints, #nearby_billboards+1, nearby_billboards)
		end
	end

	-- print(#nearby_billboards)

	-- un-render objects that are no longer nearby
	local index = 1
	while index <= #LOD_ACTIVE_POINTS do
		local bounds = LOD_ACTIVE_POINTS[index]
		if table.find(nearby_points, bounds) then
			index += 1
		else
			table.remove(LOD_ACTIVE_POINTS, index)
			bounds.data.Parent = TEMPORARY_LOD_CONTAINER
			if index % 100 == 0 then
				task.wait()
			end
		end
	end

	-- destroy billboards that are no longer nearby
	index = 1
	while index <= #LOD_BILLBOARD_ACTIVE_POINTS do
		local bounds = LOD_BILLBOARD_ACTIVE_POINTS[index]
		if table.find(nearby_points, bounds) or not table.find(nearby_billboards, bounds) then
			table.remove(LOD_BILLBOARD_ACTIVE_POINTS, index)
			Module.DestroyBillboardForLODInstance(bounds.data)
		else
			index += 1
		end
	end

	-- render any new objects that are not rendering already
	for _, bounds in nearby_points do
		if not table.find(LOD_ACTIVE_POINTS, bounds) then
			table.insert(LOD_ACTIVE_POINTS, bounds)
			bounds.data.Parent = ACTIVE_RENDERS_FOLDER
			if index % 100 == 0 then
				task.wait()
			end
		end
	end

	-- render any new billboards that can be rendered
	for _, bounds in nearby_billboards do
		-- skip any loaded renders
		if table.find(LOD_ACTIVE_POINTS, bounds) then
			continue
		end
		-- if it is not rendering, render it
		if not table.find(LOD_BILLBOARD_ACTIVE_POINTS, bounds) then
			table.insert(LOD_BILLBOARD_ACTIVE_POINTS, bounds)
			local billboard = Module.GetBillboardForLODInstance(bounds.data, true)
			if billboard then
				billboard.Enabled = true
			end
		end
	end

end

function Module.UpdateInteriors(targetZone : string?)
	local withinZones : {string} = ZoneService.GetZonesPlayerIsWithin(LocalPlayer)
	for _, interiorData in INTERIOR_RENDER_DATA do
		if targetZone and targetZone ~= interiorData.UUID then
			continue -- not the target zone if specified
		end
		if table.find(withinZones, interiorData.UUID) then
			-- load if not already loaded
			for index, object in interiorData.Objects do
				if object.Parent == TEMPORARY_INTERIORS_CONTAINER then
					object.Parent = ACTIVE_RENDERS_FOLDER
					if index % 100 == 0 then
						task.wait()
					end
				end
			end
		else
			-- unload if not already unloaded
			for index, object in interiorData.Objects do
				if object.Parent ~= TEMPORARY_INTERIORS_CONTAINER then
					object.Parent = TEMPORARY_INTERIORS_CONTAINER
					if index % 100 == 0 then
						task.wait()
					end
				end
			end
		end
	end
end

function Module.CharacterAdded(character : Model)
	if not character then
		return
	end

	local Humanoid : Humanoid = character:WaitForChild('Humanoid', 5)
	if not Humanoid then
		return
	end

end

function Module.Init()
	Module.SetupLOD()
	Module.SetupInteriors()

	ZoneService.ZoneEnter:Connect(function(character : Model, zone : string)
		--print('Enter Zone:', zone)
		Module.UpdateInteriors(zone)
	end)

	ZoneService.ZoneLeave:Connect(function(character : Model, zone : string)
		--print('Leave Zone:', zone)
		Module.UpdateInteriors(zone)
	end)
end

function Module.Start()
	Module.UpdateLODs()
	Module.UpdateInteriors()

	task.spawn(function()
		while true do
			task.wait(0.5)
			Module.UpdateLODs()
		end
	end)

	for _, player in Players:GetPlayers() do
		Module.CharacterAdded(player.Character)
		player.CharacterAdded:Connect(Module.CharacterAdded)
	end

	Players.PlayerAdded:Connect(function(player)
		Module.CharacterAdded(player.Character)
		player.CharacterAdded:Connect(Module.CharacterAdded)
	end)
end

return Module

]]></Source>
		<Source path="src/StarterPlayerScripts/Core/World/TreeGenerator.luau"><![CDATA[local CollectionService = game:GetService('CollectionService')

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedSharedAssets = ReplicatedStorage:WaitForChild('AssetsShared')
local ReplicatedGameAssets = ReplicatedStorage:WaitForChild('Assets')
local RenderLODCache = ReplicatedStorage:WaitForChild('RenderLODCache')

local SystemsContainer = {}

-- // Module // --
local Module = {}

function Module.GetRandomPointInRotatedRectangle(part : BasePart, rng : Random) : Vector3
	-- Get the part's size and rotation
	local size = part.Size
	-- Generate a random point in the local space of the part
	local randomX = rng:NextNumber() * size.X - size.X / 2
	local randomZ = rng:NextNumber() * size.Z - size.Z / 2
	local localPoint = Vector3.new(randomX, 0, randomZ)
	-- Transform the local point to world space
	return part.CFrame:PointToWorldSpace(localPoint)
end

function Module.GetWeightedChancePart(objects : {BasePart}, rng : Random) : BasePart
	local totalWeight : number = 0
	for _, object in objects do
		totalWeight += object.Size.Magnitude
	end
	local randomWeight : number = totalWeight * rng:NextNumber()
	local currentWeight : number = 0
	for _, object in objects do
		currentWeight += object.Size.Magnitude
		if currentWeight > randomWeight then
			return object
		end
	end
	return objects[#objects]
end

function Module.RaycastDownToGrassTerrain(position : Vector3) : Vector3?
	local raycastParams = RaycastParams.new()
	raycastParams.FilterDescendantsInstances = {workspace.Terrain}
	raycastParams.FilterType = Enum.RaycastFilterType.Include
	local raycastResult : RaycastResult? = workspace:Raycast(position, Vector3.new(0, -100, 0), raycastParams)
	if raycastResult then
		return raycastResult.Position
	end
	return nil
end

function Module.CheckIfSpaceIsTaken(position : Vector3, size : Vector3, overlap : OverlapParams) : boolean
	return #workspace:GetPartBoundsInBox(CFrame.new(position), size, overlap) == 0
end

function Module.Generate(seed : number, treeCount : number, bushCount : number, flowerCount : number)
	if not LocalPlayer.Character then
		LocalPlayer.CharacterAdded:Wait()
	end

	local VegetationSpawnArea = ReplicatedGameAssets:FindFirstChild('VegetationSpawnArea')
	if not VegetationSpawnArea then
		print('game has no VegetationSpawnArea in ReplicatedStorage.Assets')
		return
	end

	local overlap = OverlapParams.new()
	overlap.FilterDescendantsInstances = {workspace.Terrain}
	overlap.FilterType = Enum.RaycastFilterType.Exclude

	local rng = Random.new(seed)
	local objects = VegetationSpawnArea:GetChildren()

	print('Generating Trees: ', treeCount)
	for _ = 1, treeCount do
		-- tree
		local spawnPart = Module.GetWeightedChancePart(objects, rng)
		local spawnLocation = spawnPart and Module.GetRandomPointInRotatedRectangle(spawnPart, rng)
		local terrainSpawnLocation = spawnLocation and Module.RaycastDownToGrassTerrain(spawnLocation)
		if not terrainSpawnLocation then
			continue
		end
		local _, size = ReplicatedSharedAssets.Models.Vegetation.StylizedTree:GetBoundingBox()
		if Module.CheckIfSpaceIsTaken(terrainSpawnLocation, size, overlap) then
			continue
		end
		local object = ReplicatedSharedAssets.Models.Vegetation.StylizedTree:Clone()
		object:PivotTo(CFrame.new(terrainSpawnLocation) + Vector3.new(0, (size.Y / 2) - 0.2, 0))
		object.Parent = RenderLODCache.Landscape.StylizedTrees
		task.wait()
		CollectionService:AddTag(object, 'TreeLOD')
	end

	print('Generating Bushes: ', bushCount)
	for _ = 1, bushCount do
		local spawnPart = Module.GetWeightedChancePart(objects, rng)
		local spawnLocation = spawnPart and Module.GetRandomPointInRotatedRectangle(spawnPart, rng)
		local terrainSpawnLocation = spawnLocation and Module.RaycastDownToGrassTerrain(spawnLocation)
		if not terrainSpawnLocation then
			continue
		end
		local _, size = ReplicatedSharedAssets.Models.Vegetation.Bush:GetBoundingBox()
		if Module.CheckIfSpaceIsTaken(terrainSpawnLocation, size, overlap) then
			continue
		end
		local object = ReplicatedSharedAssets.Models.Vegetation.Bush:Clone()
		object:PivotTo(CFrame.new(terrainSpawnLocation) + Vector3.new(0, size.Y / 2, 0))
		object.Parent = RenderLODCache.Landscape.Bushes
		task.wait()
		CollectionService:AddTag(object, 'FoliageLOD')
	end

	print('Generating Flowers: ', flowerCount)
	for _ = 1, flowerCount do
		local spawnPart = Module.GetWeightedChancePart(objects, rng)
		local spawnLocation = spawnPart and Module.GetRandomPointInRotatedRectangle(spawnPart, rng)
		local terrainSpawnLocation = spawnLocation and Module.RaycastDownToGrassTerrain(spawnLocation)
		if not terrainSpawnLocation then
			continue
		end
		local _, size = ReplicatedSharedAssets.Models.Vegetation.FlowerPatch:GetBoundingBox()
		if Module.CheckIfSpaceIsTaken(terrainSpawnLocation, size, overlap) then
			continue
		end
		local object = ReplicatedSharedAssets.Models.Vegetation.FlowerPatch:Clone()
		object:PivotTo(CFrame.new(terrainSpawnLocation) + Vector3.new(0, size.Y / 2, 0))
		object.Parent = RenderLODCache.Landscape.Flowers
		task.wait()
		CollectionService:AddTag(object, 'FoliageLOD')
	end
end

function Module.Start()
	task.spawn(Module.Generate, 1, 12500, 12500, 12500)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/World/TreeRustleSFX.luau"><![CDATA[local RunService = game:GetService('RunService')
local CollectionService = game:GetService('CollectionService')

local Players = game:GetService('Players')
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local PlantRustleSound = ReplicatedAssets.Sounds.Local.PlantRustleSFX
local TreeRustleSound = ReplicatedAssets.Sounds.Local.TreeRustleSFX

local QuadTreeModule = ReplicatedModules.Modules.QuadTree

local SystemsContainer = {}

local COLLECTION_TAGS = {'PLANT_RUSTLING', 'TREE_RUSTLING'}
local TOTAL_ACTIVE_SFX_SOUNDS = 10

local RustleSFXQuadTree = false
local SoundRectBoundary = false
local LastUpdateTick = tick()
local LastPosition = nil

local SoundsCache = {}
local InstanceToPoint = {}

local CurrentCamera = workspace.CurrentCamera

local function GetPosition( item )
	return item:IsA("BasePart") and item.Position or item:GetPivot().Position
end

-- // Module // --
local Module = {}

function Module.AppendSFXPoint( item, tag )
	local Pivot = GetPosition( item )

	local point = QuadTreeModule.Point.New({
		x = Pivot.x,
		y = Pivot.z,
		instance = item,
		tag = tag,
	})

	InstanceToPoint[ item ] = point
	RustleSFXQuadTree:Insert(point)
end

function Module.RemoveSFXPoint( item, _ )
	local Point = InstanceToPoint[ item ]
	if not Point then
		return
	end
	InstanceToPoint[ item ] = nil
	RustleSFXQuadTree:Remove( Point )
end

function Module.StepRender()
	local Pivot = CurrentCamera.CFrame.Position
	-- check if the camera has moved around
	if LastPosition and (Pivot - LastPosition).Magnitude < 5 then
		return
	end
	LastPosition = Pivot

	SoundRectBoundary.x = Pivot.X
	SoundRectBoundary.y = Pivot.Z

	local withinRender = RustleSFXQuadTree:Query(SoundRectBoundary, { })

	-- sort all points from closest to furthest
	table.sort(withinRender, function(a, b)
		local d1 = (Pivot - GetPosition( a.instance )).Magnitude
		local d2 = (Pivot - GetPosition( b.instance )).Magnitude
		return d1 < d2
	end)

	local currentSFXIndex = {}
	for _, tag in COLLECTION_TAGS do
		currentSFXIndex[tag] = 1
	end

	-- move sounds into nearby related tag instances
	for _, point in withinRender do
		if not currentSFXIndex[point.tag] then
			warn('unsupported tag; ' .. tostring(point.tag))
			continue
		end

		if currentSFXIndex[point.tag] > TOTAL_ACTIVE_SFX_SOUNDS then
			continue
		end

		local SoundIndex = currentSFXIndex[point.tag]
		local Sound = SoundsCache[point.tag][SoundIndex]
		Sound.Parent = point.instance
		Sound.Playing = true

		currentSFXIndex[point.tag] += 1
	end

	-- move non-playing sounds back
	for tag, soundArray in SoundsCache do
		for index, sound in soundArray do
			if index > currentSFXIndex[tag] then
				sound.Playing = false
				sound.Parent = script
			end
		end
	end

end

function Module.Start()
	SoundRectBoundary = QuadTreeModule.Rectangle.New({ width = 50, height = 50 })
	-- TODO: move to QuadTree Service
	RustleSFXQuadTree = QuadTreeModule.QuadTree.New({
		boundary = QuadTreeModule.Rectangle.New({width = 10240, height = 10240}),
		capacity = 4,
	})

	for _, tag in COLLECTION_TAGS do
		for _, item in CollectionService:GetTagged(tag) do
			Module.AppendSFXPoint( item, tag )
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(function(item)
			Module.AppendSFXPoint( item, tag )
		end)
		CollectionService:GetInstanceRemovedSignal(tag):Connect(function(item)
			Module.RemoveSFXPoint( item, tag )
		end)
	end

	RunService.Heartbeat:Connect(function()
		if tick() < LastUpdateTick then
			return
		end
		-- check for update every 1 second
		LastUpdateTick = tick() + 1.5
		Module.StepRender()
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems

	-- create a cache table for the sounds below
	for _, tag in COLLECTION_TAGS do
		SoundsCache[tag] = { }
	end

	-- generate all the sound objects
	for _ = 1, TOTAL_ACTIVE_SFX_SOUNDS do
		local SFX1 = PlantRustleSound:Clone()
		SFX1.Parent = script
		table.insert(SoundsCache.PLANT_RUSTLING, SFX1)
		local SFX2 = TreeRustleSound:Clone()
		SFX2.Parent = script
		table.insert(SoundsCache.TREE_RUSTLING, SFX2)
	end
end

return Module
]]></Source>
