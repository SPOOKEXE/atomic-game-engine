return {
	Name = "GiveTestPack",
	Aliases = { "givetestpack", "testpack" },
	Description = "Give a player 5 of every item, 20 of every Material item. Skips items already at max stack.",
	Group = "Admin",
	Args = {
		{ Type = "player", Name = "target", Description = "Player to receive the test pack." },
	},
}
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/inventory/GiveTestPackServer"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))
local ServerCore = require(ServerStorage:WaitForChild('Core'))

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ItemsConfig = ServerModules.Data.Items  -- migrated to per-player config replication; server reads canonical.

-- Test pack: bulk-grant every itemId in the registry so an admin can
-- exercise inventory/forge/gem/enchant flows without hand-rolling
-- /giveitem N times. Materials get 20 (forge recipes consume 5-15 per
-- output), everything else gets 5 (enough to test stacking, hotbar
-- bind, equip swap). Each give goes through the same pipeline as the
-- /giveitem command so MaxQuantity caps + uuid generation are honored.
local DEFAULT_QTY  = 5
local MATERIAL_QTY = 20

return function(_context, target: Player)
	local Inventory = ServerCore.PlayerInventoryServer
	if not Inventory or not Inventory.GiveQuantityOfItemIdToPlayer then
		return 'PlayerInventoryServer.GiveQuantityOfItemIdToPlayer unavailable.'
	end

	local givenItems   = 0
	local givenMaterials = 0
	local skipped = 0

	for itemId, cfg in ItemsConfig.Items do
		-- Decide quantity: anything classified as a Material (forge input,
		-- generic stack) gets 20; everything else gets 5.
		local cats = ItemsConfig.GetItemCategories(cfg)
		local isMaterial = false
		for _, c in cats do
			if c == ItemsConfig.ItemCategory.Material then isMaterial = true; break end
		end
		local qty = isMaterial and MATERIAL_QTY or DEFAULT_QTY

		local uuids = Inventory.GiveQuantityOfItemIdToPlayer(target, itemId, qty)
		local granted = (typeof(uuids) == 'table') and #uuids or 0
		if granted > 0 then
			if isMaterial then
				givenMaterials = givenMaterials + granted
			else
				givenItems = givenItems + granted
			end
		else
			-- Inventory rejected (stack-cap reached, etc.). Not fatal —
			-- partial coverage is fine for a test pack.
			skipped = skipped + 1
		end
	end

	return string.format(
		'Test pack delivered to %s: %d items + %d materials (%d entries skipped at cap).',
		target.Name, givenItems, givenMaterials, skipped)
end
]]></Source>
