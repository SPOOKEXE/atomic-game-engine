	-- // CHARACTER — verdant, green particle halo //
	aura_verdant = aura({
		Anchor = 'character',
		Display = { Name = 'Verdant Aura', Description = 'A lush green glow of living growth surrounds the wearer.' },
		Rarity = 2,
		VFX = {
			Light = { Color = Color3.fromRGB(90, 210, 110), Brightness = 1.4, Range = 8 },
		},
		Procedural = {
			Particle = {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0,    Color3.fromRGB(150, 240, 165)),
					ColorSequenceKeypoint.new(0.5,  Color3.fromRGB(90, 210, 110)),
					ColorSequenceKeypoint.new(1,    Color3.fromRGB(45, 130, 65)),
				}),
				Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.5),
					NumberSequenceKeypoint.new(1, 0.05),
				}),
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.1),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Rate = 14,
				Lifetime = NumberRange.new(0.7, 1.0),
				Speed = NumberRange.new(0.5, 1.5),
				SpreadAngle = Vector2.new(180, 180),
				Acceleration = Vector3.new(0, 1.4, 0),
				LightEmission = 0.7,
			},
			Light = { Color = Color3.fromRGB(90, 210, 110), Brightness = 1.4, Range = 8 },
		},
	}),

	-- // CHARACTER — azure, blue particle halo //
	aura_azure = aura({
		Anchor = 'character',
		Display = { Name = 'Azure Aura', Description = 'A cool azure radiance flows around the wearer.' },
		Rarity = 2,
		VFX = {
			Light = { Color = Color3.fromRGB(80, 150, 255), Brightness = 1.4, Range = 8 },
		},
		Procedural = {
			Particle = {
				Color = ColorSequence.new({
