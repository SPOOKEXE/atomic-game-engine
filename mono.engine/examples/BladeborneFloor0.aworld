local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local LocalModules = require(LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("Modules"))

local WindShakeModule = LocalModules.Services.WindShake
local WindLinesModule = LocalModules.Services.WindLines

local SystemsContainer = {}

-- // Module // --
local Module = {}

function Module.Start()

	local WIND_DIRECTION = Vector3.new(1,0,0.3)
	local WIND_SPEED = 20
	local WIND_POWER = 0.5
	WindShakeModule:SetDefaultSettings({
		WindSpeed = WIND_SPEED;
		WindDirection = WIND_DIRECTION;
		WindPower = WIND_POWER;
	})

	--WindShakeModule:MatchWorkspaceWind()

	WindShakeModule:Initi()

	local WindLines = WindLinesModule.new({Time = 0.7, Range = 100})
	WindLines:Startt()

end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
