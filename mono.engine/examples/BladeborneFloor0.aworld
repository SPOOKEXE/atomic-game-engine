		<Source path="src/ServerScriptService/CmdrSetup/Commands/attributes/ResetAttributesServer.luau"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

return function(_context, target: Player)
	local data = ServerCore.SavesManagerServer.GetPlayerSelectedSaveData(target)
	if not data then
		return string.format('No save data loaded for %s.', target.Name)
	end
	-- Replace the whole map. ReplicatedData.SetData is not needed here —
	-- the next coalesced flush from any AttributeServer write will pick
	-- this up, and AttributesTab reads the live struct each render.
	data.Attributes = {}
	return string.format('Wiped all attributes for %s.', target.Name)
end
]]></Source>
