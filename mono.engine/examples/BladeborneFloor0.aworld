		"id in Mobs.Mobs; the spawn template is sourced from " ..
		"ServerStorage/EnemyTemplates if the mob has been spawned at " ..
		"least once during this server session, otherwise from any " ..
		"existing tagged AICharacter with a matching AIClass attribute.",
	Group = 'Admin',
	Args = {
		{ Type = 'string',  Name = 'mobId',
		  Description = "Mob class id (e.g. 'Boar', 'BossBoar', 'Generic')." },
