		<Source path="src/ServerScriptService/CmdrSetup/Commands/debug/SetBossPhaseServer.luau"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

return function(_context, phaseIndex: number)
	local BossServer = ServerCore.BossServer
	if not BossServer or not BossServer.ForceSetPhase then
		return 'BossServer unavailable.'
	end
	local idx = math.floor(tonumber(phaseIndex) or 1)
	local active = BossServer.GetActiveBossModels()
	if #active == 0 then return 'No active bosses.' end
	local n = 0
	for _, model in active do
		if BossServer.ForceSetPhase(model, idx) then n += 1 end
	end
	return string.format("Forced %d boss(es) to phase %d.", n, idx)
end
]]></Source>
