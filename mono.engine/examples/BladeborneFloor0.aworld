	Description = 'Force-toggle a premium gamepass flag for testing slot-cap UI.',
	Group = 'Admin',
	Args = {
		{ Type = 'player',  Name = 'target',  Description = 'Target player.' },
		{ Type = 'string',  Name = 'passKey', Description = "Pass key from PremiumConfig.GAMEPASSES (e.g. 'AuraSlots')." },
