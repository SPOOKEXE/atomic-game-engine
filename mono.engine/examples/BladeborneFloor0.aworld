		<Source path="src/ServerScriptService/CmdrSetup/Commands/travel/TeleportFloorServer.luau"><![CDATA[local ServerStorage = game:GetService("ServerStorage")
local ServerCore = require(ServerStorage:WaitForChild('Core'))

return function(_context, target: Player, floorNumber: number)
	local saveIndex = ServerCore.SavesManagerServer.GetSelectedSaveIndex(target)
	if not saveIndex then
		return string.format("%s has no selected save index — can't teleport.", target.Name)
	end
	local ok = ServerCore.TeleportServer.TeleportToFloor(target, saveIndex, math.floor(floorNumber))
	if not ok then
		return string.format("TeleportToFloor(%d) returned false for %s.", floorNumber, target.Name)
	end
	return string.format("Teleporting %s to floor %d (save %d).", target.Name, floorNumber, saveIndex)
end
]]></Source>
