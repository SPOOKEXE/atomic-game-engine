		<Source path="src/ServerScriptService/CmdrSetup/Commands/player/GiveSkillPointsServer.luau"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

return function(_context, target: Player, amount: number)
	local data = ServerCore.SavesManagerServer.GetPlayerSelectedSaveData(target)
	if not data then
		return string.format('No save data loaded for %s.', target.Name)
	end
	local current = tonumber(data.SkillPoints) or 0
	data.SkillPoints = math.max(0, math.floor(current + amount))
	return string.format('Adjusted %s SkillPoints by %+d (now %d).',
		target.Name, math.floor(amount), data.SkillPoints)
end
]]></Source>
