		<Source path="ServerScriptService/CmdrSetup/Commands/gems/UnsocketGemServer"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

return function(_context, target: Player, itemUuid: string, slotIndex: number)
	local Gem = ServerCore.GemSocketServer
	if not Gem or not Gem.AttemptUnsocketGem then return 'GemSocketServer unavailable.' end
	local ok = Gem.AttemptUnsocketGem(target, itemUuid, slotIndex)
	if not ok then return 'Unsocket rejected (slot empty / no Gem Essence / unknown uuid).' end
	return string.format('Unsocketed gem from slot %d (1 Gem Essence consumed).', slotIndex)
end
