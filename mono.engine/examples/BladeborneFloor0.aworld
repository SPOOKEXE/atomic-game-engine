	-- // Enchant scrolls // — Type='EnchantScroll' is classified via
	-- EnchantInputData presence. Each scroll is single-use (Charges=1)
	-- and encodes a specific enchant + level. Dropped by enemies, found
	-- in chests, sold by enchant vendors.
	SharpnessScrollI = FastDefineItem({
		Type = 'EnchantScroll', Rarity = RaritiesConfig.RarityEnums.Common, MaxQuantity = 99,
		EnchantInputData = { Id = 'sharpness', Level = 1, Charges = 1 },
		Display = BasicColorDisplay('Sharpness Scroll I', 'Inscribes Sharpness Lv 1. +8% melee DMG.', Color3.fromRGB(126,200,255)),
	}),
	SharpnessScrollIII = FastDefineItem({
		Type = 'EnchantScroll', Rarity = RaritiesConfig.RarityEnums.Uncommon, MaxQuantity = 99,
		EnchantInputData = { Id = 'sharpness', Level = 3, Charges = 1 },
		Display = BasicColorDisplay('Sharpness Scroll III', 'Inscribes Sharpness Lv 3. +24% melee DMG.', Color3.fromRGB(126,200,255)),
	}),
	UnbreakingScrollII = FastDefineItem({
		Type = 'EnchantScroll', Rarity = RaritiesConfig.RarityEnums.Uncommon, MaxQuantity = 99,
		EnchantInputData = { Id = 'unbreaking', Level = 2, Charges = 1 },
		Display = BasicColorDisplay('Unbreaking Scroll II', 'Inscribes Unbreaking Lv 2. +60% effective DUR.', Color3.fromRGB(180,228,255)),
	}),
	FireAspectScrollI = FastDefineItem({
		Type = 'EnchantScroll', Rarity = RaritiesConfig.RarityEnums.Uncommon, MaxQuantity = 99,
		EnchantInputData = { Id = 'fire_aspect', Level = 1, Charges = 1 },
		Display = BasicColorDisplay('Fire Aspect Scroll I', 'Inscribes Fire Aspect Lv 1. Ignite on hit.', Color3.fromRGB(255,128,64)),
	}),
	KeenEdgeScrollII = FastDefineItem({
		Type = 'EnchantScroll', Rarity = RaritiesConfig.RarityEnums.Rare, MaxQuantity = 99,
		EnchantInputData = { Id = 'keen_edge', Level = 2, Charges = 1 },
		Display = BasicColorDisplay('Keen Edge Scroll II', 'Inscribes Keen Edge Lv 2. +10% CRIT.', Color3.fromRGB(200,157,255)),
	}),

	-- // Forged sword family // — minted by ForgeServer when a player
	-- commits a Greatsword / Longsword / Dagger blueprint. Sockets
	-- declared up-front so GemSocketServer can lazy-init the slots
	-- struct. Stat values are placeholders: forged stacks override
	-- via Composition.Forged.StatSnapshot which CombatUtility honors.
	-- BLADEBORNE is sword-only by design; ranged + magic weapon types
	-- are intentionally absent.
	CraftedGreatsword = FastDefineItem({
		Rarity = RaritiesConfig.RarityEnums.Uncommon, MaxQuantity = 1,
		EquipmentData = {
			EquipSlots = {{Slot = 1, IndexMax = 2, AllowMultiEquip = true, MaxMultiEquip = 2}},
			WeaponClass = 'Greatsword',
			StandardOffset = CFrame.new(),
			BackOffsets = {[1] = CFrame.new()}, HandOffsets = {[1] = CFrame.new()},
			WeaponUsage = { Operation = 1, Damage = { Value = { Min = 80, Max = 120 } }, Inflicts = {} },
			Model = 'WoodenSword',  -- TODO: greatsword model when art lands
			Sockets = { { Color = 'red' }, { Color = 'any' }, { Color = 'blue' } },
		},
		Display = BasicColorDisplay('Crafted Greatsword', 'A two-handed forged blade.', Color3.fromRGB(126,200,255)),
	}),
	CraftedLongsword = FastDefineItem({
		Rarity = RaritiesConfig.RarityEnums.Uncommon, MaxQuantity = 1,
		EquipmentData = {
			EquipSlots = {{Slot = 1, IndexMax = 2, AllowMultiEquip = true, MaxMultiEquip = 2}},
			WeaponClass = 'Longsword',
			StandardOffset = CFrame.new(),
			BackOffsets = {[1] = CFrame.new()}, HandOffsets = {[1] = CFrame.new()},
			WeaponUsage = { Operation = 1, Damage = { Value = { Min = 60, Max = 90 } }, Inflicts = {} },
			Model = 'WoodenSword',
			Sockets = { { Color = 'any' }, { Color = 'any' } },
		},
		Display = BasicColorDisplay('Crafted Longsword', 'A balanced one-handed forged blade.', Color3.fromRGB(126,200,255)),
	}),
	CraftedDagger = FastDefineItem({
		Rarity = RaritiesConfig.RarityEnums.Uncommon, MaxQuantity = 1,
		Tags = { Module.ItemTags.Weapon },
		EquipmentData = {
			EquipSlots = {{Slot = 1, IndexMax = 2, AllowMultiEquip = true, MaxMultiEquip = 2}},
			WeaponClass = 'Dagger',
			StandardOffset = CFrame.new(),
			BackOffsets = {[1] = CFrame.new()}, HandOffsets = {[1] = CFrame.new()},
			WeaponUsage = { Operation = 1, Damage = { Value = { Min = 30, Max = 50 } }, Inflicts = {} },
			Model = 'WoodenSword',
			Sockets = { { Color = 'any' } },
		},
		Display = BasicColorDisplay('Crafted Dagger', 'Quick, light, deadly.', Color3.fromRGB(126,200,255)),
	}),

} :: {[string]: BaseItemConfig}

function Module.GetConfigFromId(id: string): BaseItemConfig
	return Module.Items[id]
end

-- Effective rarity for a stack. Forged stacks may carry a per-stack
-- RarityOverride baked at forge time (Composition.Forged.RarityOverride),
-- which beats the cfg's static Rarity. Future systems (enchant tiers,
-- ascended drops) can layer their own overrides on the stack root and
-- this helper picks the highest available.
--
-- All rarity-aware UI sites (inventory tooltip, hotbar slot color,
-- equipment renderer cards) call into this so the override surfaces
-- consistently. cfg-only paths (bulk catalog browsers, missing-stack
-- previews) keep using cfg.Rarity directly.
function Module.GetEffectiveRarity(itemConfig: BaseItemConfig?, stack: any?): number
	local base = itemConfig and itemConfig.Rarity or 1
	if typeof(stack) ~= 'table' then return base end
	-- Direct stack-root override (e.g. ascended loot drop).
	if typeof(stack.Rarity) == 'number' then return stack.Rarity end
	-- Forge override.
	if typeof(stack.Composition) == 'table' then
		local forged = stack.Composition.Forged
		if forged and typeof(forged.RarityOverride) == 'number' then
			return forged.RarityOverride
		end
	end
	return base
end

-- Returns every category bucket the item belongs to, as an array of
-- `Module.ItemCategory` enum numbers. Order is stable: Weapon → Tool →
-- Equipment/Accessory → Consumable → Activatable → Material. The array
-- is freshly allocated on each call; cache it at the call site if it
-- ever shows up in a profile.
function Module.GetItemCategories(itemConfig: BaseItemConfig?): {number}
	local cats = {}
	if not itemConfig then
		table.insert(cats, Module.ItemCategory.Material)
		return cats
	end
	local equip = itemConfig.EquipmentData
	if equip then
		if equip.WeaponUsage then table.insert(cats, Module.ItemCategory.Weapon) end
		if equip.ToolUsage   then table.insert(cats, Module.ItemCategory.Tool)   end
		-- An item that's neither a weapon nor a tool but has equip slots
		-- is wearable; classify by primary slot to split armor vs jewelry.
		if not equip.WeaponUsage and not equip.ToolUsage then
			local firstSlot = equip.EquipSlots and equip.EquipSlots[1]
			local slotEnum = firstSlot and firstSlot.Slot
			if slotEnum and ACCESSORY_SLOT_LOOKUP[slotEnum] then
				table.insert(cats, Module.ItemCategory.Accessory)
			else
				table.insert(cats, Module.ItemCategory.Equipment)
			end
		end
	end
	if itemConfig.ConsumptionData then table.insert(cats, Module.ItemCategory.Consumable)  end
	if itemConfig.ActivationData  then table.insert(cats, Module.ItemCategory.Activatable) end
	-- Artisan input categories. Gem / EnchantScroll are pure metadata
	-- pointers — they layer cleanly on top of any other category.
	if itemConfig.GemId or itemConfig.Gem then
		table.insert(cats, Module.ItemCategory.Gem)
	end
	if itemConfig.EnchantInputData then
		table.insert(cats, Module.ItemCategory.EnchantScroll)
	end
	-- Material is mutually exclusive with the equippable / consumable /
	-- activatable buckets: an item that already classifies as one of
	-- those is NOT additionally a material, even if it has a forge
	-- pointer. Otherwise a "consumable scroll with a forge tag" would
	-- show up in BOTH the consumables tab AND the materials tab —
	-- visually duplicative and not what the player expects.
	local isAlreadyEquipOrConsume = false
	for _, c in cats do
		if c == Module.ItemCategory.Weapon
			or c == Module.ItemCategory.Tool
			or c == Module.ItemCategory.Equipment
			or c == Module.ItemCategory.Accessory
			or c == Module.ItemCategory.Consumable
			or c == Module.ItemCategory.Activatable
		then isAlreadyEquipOrConsume = true; break end
	end
	if not isAlreadyEquipOrConsume
		and (itemConfig.ForgeMaterialId or itemConfig.ForgeMaterial) then
		table.insert(cats, Module.ItemCategory.Material)
	end
	-- Final fallback: nothing matched — treat as a material so the item
	-- still appears in the inventory somewhere. Anything legitimately
	-- equippable would have already taken its bucket above.
	if #cats == 0 then table.insert(cats, Module.ItemCategory.Material) end
	return cats
end

-- // Artisan input resolvers — see ARTISAN.md §6 //
-- Both shorthand (Id-only string field) and longhand (full metadata
-- table field) are supported on ItemConfig. These helpers normalize
-- both forms into the longhand shape with default fields filled in,
-- so call sites never have to branch on which field was used.
-- Returns nil if the item isn't a forge / gem / enchant input at all.

function Module.GetForgeMaterial(itemConfig: BaseItemConfig?): ForgeMaterialMetadata?
	if not itemConfig then return nil end
	if itemConfig.ForgeMaterial then
		local m = itemConfig.ForgeMaterial
		return { Id = m.Id, UnitsPerStack = m.UnitsPerStack or 1 }
	end
	if typeof(itemConfig.ForgeMaterialId) == 'string' then
		return { Id = itemConfig.ForgeMaterialId, UnitsPerStack = 1 }
	end
	return nil
end

function Module.GetGem(itemConfig: BaseItemConfig?): GemMetadata?
	if not itemConfig then return nil end
	if itemConfig.Gem then return { Id = itemConfig.Gem.Id } end
	if typeof(itemConfig.GemId) == 'string' then return { Id = itemConfig.GemId } end
	return nil
end

function Module.GetEnchantInput(itemConfig: BaseItemConfig?): EnchantInputMetadata?
	if not itemConfig then return nil end
	local e = itemConfig.EnchantInputData
	if not e or typeof(e.Id) ~= 'string' then return nil end
	return { Id = e.Id, Level = e.Level, Charges = e.Charges or 1 }
end

-- Convenience: walk Module.Items to find every item config whose
-- ForgeMaterialId resolves to the given material id. Used by the cmdr
-- /give_material command to pick a canonical inventory item to grant.
-- Returns the lowest-rarity match first (deterministic ordering).
function Module.GetItemIdsByForgeMaterialId(materialId: string): {string}
	local matches = {}
	for itemId, cfg in Module.Items do
		local fm = Module.GetForgeMaterial(cfg)
		if fm and fm.Id == materialId then
			table.insert(matches, { Id = itemId, Rarity = cfg.Rarity or 1 })
		end
	end
	table.sort(matches, function(a, b) return a.Rarity < b.Rarity end)
	local out = {}
	for _, m in matches do table.insert(out, m.Id) end
	return out
end

-- Single-membership convenience check. Cheaper to call when you only
-- care about one bucket — avoids walking the array at the call site.
function Module.HasItemCategory(itemConfig: BaseItemConfig?, category: number): boolean
	if not itemConfig then
		return category == Module.ItemCategory.Material
	end
	local equip = itemConfig.EquipmentData
	if category == Module.ItemCategory.Weapon then
		return equip ~= nil and equip.WeaponUsage ~= nil
	elseif category == Module.ItemCategory.Tool then
		return equip ~= nil and equip.ToolUsage ~= nil
	elseif category == Module.ItemCategory.Equipment or category == Module.ItemCategory.Accessory then
		if not equip or equip.WeaponUsage or equip.ToolUsage then return false end
		local firstSlot = equip.EquipSlots and equip.EquipSlots[1]
		local slotEnum = firstSlot and firstSlot.Slot
		local isAccessory = slotEnum ~= nil and ACCESSORY_SLOT_LOOKUP[slotEnum] == true
		return (category == Module.ItemCategory.Accessory) == isAccessory
	elseif category == Module.ItemCategory.Consumable then
		return itemConfig.ConsumptionData ~= nil
	elseif category == Module.ItemCategory.Activatable then
		return itemConfig.ActivationData ~= nil
	elseif category == Module.ItemCategory.Material then
		return Module.GetForgeMaterial(itemConfig) ~= nil
			or (equip == nil
				and itemConfig.ConsumptionData == nil
				and itemConfig.ActivationData == nil
				and Module.GetGem(itemConfig) == nil
				and Module.GetEnchantInput(itemConfig) == nil)
	elseif category == Module.ItemCategory.Gem then
		return Module.GetGem(itemConfig) ~= nil
	elseif category == Module.ItemCategory.EnchantScroll then
		return Module.GetEnchantInput(itemConfig) ~= nil
	end
	return false
end

function Module.FindInventoryItemOfUUID(inventory, uuid: string): ({}?, string?)
	for itemId, uuidDict in inventory do
		if uuidDict[uuid] then
			return uuidDict[uuid], itemId
		end
	end
	return nil, nil
end

return Module
]]></Source>
		<Source path="src/ServerStorage/Modules/Data/LootTables.luau"><![CDATA[
local function ResolveRNGRange( Value, RNG )
	RNG = RNG or Random.new()
	return typeof(Value) == "table" and RNG:NextInteger(unpack(Value)) or Value
end

local function ArrayCopyTo( destination, ... )
	for _, source in {...} do
		for _, item in source do
			if not table.find(destination, item) then
				table.insert(destination, source)
			end
		end
	end
end

-- // Module // --
local Module = {}

Module.ItemLootTables = {
	CommonRedPotion = {
		{ ID = 'RedPotion', Quantity = { 1, 2 }, Weight = 3 },
		{ ID = 'RedPotion', Quantity = { 1, 3 }, Weight = 1 },
	},

	BundleRedPotion = {
		{ ID = 'RedPotion', Quantity = { 1, 3 }, Weight = 50 },
		{ ID = 'RedPotion', Quantity = { 2, 7 }, Weight = 25 },
		{ ID = 'RedPotion', Quantity = { 6, 12 }, Weight = 5 },
	},
}

Module.MobLootTables = {

	Boar_Floor1 = {
		Currency = { 1, 10 },
		Experience = { 3, 7 },

		Items = { }, -- set items with 100% chance
		WeightedItems = Module.ItemLootTables.CommonRedPotion, -- weighted item drop

		Attributes = false,  -- set attributes with 100% chance
		WeightedAttributes = false, -- weighted item drop

		Skills = false, -- set skills with 100% chance
		WeightedSkills = false, -- weighted item drop

		Quests = false,  -- set quests with 100% chance
		WeightedQuests = false, -- weighted item drop

		Callbacks = false, -- set function callbacks with 100% chance
		WeightedCallbacks = false, -- weighted callback functions

		-- Multi-drop rolls. Each entry is an independent roll that fires
		-- with its own Chance, then picks weighted from Pool. Lets a mob
		-- drop several items per kill instead of one.
		MultiDrops = {
			-- 25% chance at a Waystone Piece.
			{
				Chance = 0.25,
				Pool = {
					{ ItemId = 'WaystonePieceCommon', Weight = 80, Quantity = 1 },
					{ ItemId = 'WaystonePieceRare',   Weight = 20, Quantity = 1 },
				},
			},
			-- Boar butchery — feeds the cooking + tailoring chains.
			{
				Chance = 0.85,
				Pool = {
					{ ItemId = 'RawBoarMeat', Weight = 60, Quantity = { 1, 2 } },
					{ ItemId = 'BoarFur',     Weight = 25, Quantity = 1 },
					{ ItemId = 'BoarHide',    Weight = 15, Quantity = 1 },
				},
			},
		},
	},

}

----------------------------------------------------------------------
-- Boss tables. Bosses fire many independent rolls per kill so a single
-- defeat can yield gear + materials + a candy + (occasionally) an aura.
-- Aura drops use the prefix 'aura:<auraId>' so LootTableServer routes
-- them to AurasServer.AttemptUnlockAura instead of the inventory.
----------------------------------------------------------------------
Module.BossLootTables = {

	Boss_Floor1 = {
		Currency = { 50, 120 },
		Experience = { 80, 150 },

		MultiDrops = {
			-- Guaranteed drop: gear or a Waystone Piece pair.
			{
				GuaranteeOne = true,
				Pool = {
					{ ItemId = 'WoodenSword',  Weight = 70, Quantity = 1 },
					{ ItemId = 'WaystonePieceCommon', Weight = 30, Quantity = { 1, 2 } },
				},
			},
			-- 25% rare-tier roll.
			{
				Chance = 0.25,
				Pool = {
					{ ItemId = 'WaystonePieceRare', Weight = 80, Quantity = 1 },
					{ ItemId = 'companion_candy_minor', Weight = 20, Quantity = { 1, 2 } },
				},
			},
			-- 5% candy upgrade.
			{
				Chance = 0.05,
				Pool = {
					{ ItemId = 'companion_candy_major', Weight = 100, Quantity = 1 },
				},
			},
			-- 1% legendary roll: candies, auras, or rare waystone pieces.
			{
				Chance = 0.01,
				Pool = {
					{ ItemId = 'companion_candy_legendary', Weight = 50, Quantity = 1 },
					{ ItemId = 'WaystonePieceLegendary',     Weight = 30, Quantity = 1 },
					{ ItemId = 'aura:character_glow_amber',  Weight = 10, Quantity = 1 },
					{ ItemId = 'aura:sword_glow_void',        Weight = 5,  Quantity = 1 },
					{ ItemId = 'aura:mount_glow_storm',       Weight = 5,  Quantity = 1 },
				},
			},
		},
	},

}

-- sorting method for weights
for _, Data in Module.ItemLootTables do
	table.sort(Data, function(A, B)
		return A.Weight > B.Weight
	end)
end

function Module.ResolvePoolWeightedMatrix( PresetPool, TotalWeight )
	if not TotalWeight then
		TotalWeight = 0
		for _, itemData in PresetPool do
			TotalWeight += itemData.Weight
		end
	end

	local Rand = Random.new():NextInteger(1, TotalWeight)
	local Adder = 0
	for _, itemData in PresetPool do
		Adder += itemData.Weight
		if Adder >= Rand then
			return itemData
		end
	end
	return PresetPool[1]
end

-- Pure helper that resolves a single DropRoll into a list of awards.
-- Each award is { ItemId = string, Quantity = int }. Callers (LootTableServer)
-- iterate the awards and route by prefix: 'aura:*' goes to AurasServer,
-- everything else goes to PlayerInventoryServer.
--
-- `luckMul` (optional, default 1.0) scales the per-roll Chance check —
-- a player on a difficulty with LuckMul = 1.25 sees 25% better odds on
-- every probabilistic drop. Capped at 1.0 so a luck stack can't exceed
-- 100% drop rate (which would defeat the point of weighted pools).
-- GuaranteeOne rolls bypass the chance gate entirely so luck has no
-- effect on always-fires drops — also intentional, no infinite-stack
-- exploit through duplicate guaranteed rolls.
-- `rarityLookup` (optional) takes an itemId and returns its Rarity (number,
-- 1 = lowest). When provided alongside `rarityBias > 1`, each Pool entry's
-- effective weight is multiplied by `rarityBias ^ (rarity - 1)` — so a
-- bias of 1.25 doubles a Rarity-4 item's selection weight relative to
-- Rarity-1 in the same pool. Caller injects the lookup so this data
-- module stays decoupled from Items config.
function Module.ResolveDropRoll( DropRoll, RNG, luckMul, rarityBias, rarityLookup )
	RNG = RNG or Random.new()
	luckMul = (typeof(luckMul) == 'number' and luckMul > 0) and luckMul or 1
	rarityBias = (typeof(rarityBias) == 'number' and rarityBias > 0) and rarityBias or 1
	local awards = {}
	if not DropRoll or typeof(DropRoll.Pool) ~= 'table' or #DropRoll.Pool == 0 then
		return awards
	end
	local repeats = DropRoll.Repeat or 1
	for _ = 1, repeats do
		local fires = DropRoll.GuaranteeOne == true
		if not fires then
			local chance = math.min(1, (DropRoll.Chance or 1) * luckMul)
			fires = RNG:NextNumber() < chance
		end
		if fires then
			-- Pool is a list of { ItemId, Weight, Quantity }; pick one
			-- weighted, resolve quantity range. With rarityBias > 1 +
			-- a rarityLookup, each entry's weight is scaled before the
			-- pick — biases toward rarer items in the same pool.
			local effectiveWeights: {number} = {}
			local totalWeight = 0
			for i, entry in DropRoll.Pool do
				local w = entry.Weight or 1
				if rarityBias > 1 and rarityLookup then
					local rarity = rarityLookup(entry.ItemId) or 1
					if rarity > 1 then
						w = w * (rarityBias ^ (rarity - 1))
					end
				end
				effectiveWeights[i] = w
				totalWeight += w
			end
			local pick = RNG:NextNumber() * math.max(0.0001, totalWeight)
			local adder = 0
			local chosen = DropRoll.Pool[1]
			for i, entry in DropRoll.Pool do
				adder += effectiveWeights[i]
				if adder >= pick then chosen = entry; break end
			end
			local quantity = ResolveRNGRange(chosen.Quantity or 1, RNG)
			table.insert(awards, { ItemId = chosen.ItemId, Quantity = quantity })
		end
	end
	return awards
end

-- Walk a loot table's MultiDrops and return all award entries. Used by
-- LootTableServer to fan out per-roll awards into inventory + auras.
-- `luckMul` (optional) is forwarded into every per-drop chance roll.
function Module.ResolveMultiDrops( LootTable, luckMul, rarityBias, rarityLookup )
	local out = {}
	if typeof(LootTable.MultiDrops) ~= 'table' then return out end
	local RNG = Random.new()
	for _, dropRoll in LootTable.MultiDrops do
		for _, award in Module.ResolveDropRoll(dropRoll, RNG, luckMul, rarityBias, rarityLookup) do
			table.insert(out, award)
		end
	end
	return out
end

function Module.ResolveLootTableGeneric( LootTable )
	local RNG = Random.new()

	local LootRewards = {
		Currency = ResolveRNGRange( LootTable.Currency, RNG ),
		Experience = ResolveRNGRange( LootTable.Experience, RNG ),

		Items = { },
		Attributes = { },
		Skills = { },
		Quests = { },
		Dialogue = { },

		Callbacks = { },
	}

	if LootTable.Items then
		ArrayCopyTo( LootRewards.Items, LootTable.Items )
	end

	-- weighted items
	local ItemData = LootTable.WeightedItems and Module.ResolvePoolWeightedMatrix( LootTable.WeightedItems, false )
	if ItemData then
		local Amount = ItemData.Quantity
		Amount = Amount and ResolveRNGRange(Amount, RNG) or 1
		if not LootRewards.Items[ItemData.ID] then
			LootRewards.Items[ItemData.ID] = 0
		end
		LootRewards.Items[ItemData.ID] += Amount
	end

	if LootTable.Attributes then
		ArrayCopyTo( LootRewards.Attributes, LootTable.Attributes )
	end
	if LootTable.WeightedAttributes then
		-- TODO: implement
		warn('LootTable - WEIGHTED ATTRIBUTES loot not implemented')
	end

	if LootTable.Skills then
		ArrayCopyTo( LootRewards.Skills, LootTable.Skills )
	end
	if LootTable.WeightedSkills then
		-- TODO: implement
		warn('LootTable - WEIGHTED SKILLS loot not implemented')
	end

	if LootTable.Quests then
		ArrayCopyTo( LootRewards.Quests, LootTable.Quests )
	end
	if LootTable.WeightedQuests then
		-- TODO: implement
		warn('LootTable - WEIGHTED QUESTS loot not implemented')
	end

	if LootTable.Dialogue then
		ArrayCopyTo( LootRewards.Dialogue, LootTable.Dialogue )
	end
	if LootTable.WeightedDialogue then
		-- TODO: implement
		warn('LootTable - WEIGHTED DIALOGUE loot not implemented')
	end

	if LootTable.Callbacks then
		ArrayCopyTo( LootRewards.Dialogue, LootTable.Dialogue )
	end
	if LootTable.WeightedDialogue then
		-- TODO: implement
		warn('LootTable - WEIGHTED CALLBACK loot not implemented')
	end

	return LootRewards
end

return Module
]]></Source>
		<Source path="src/ServerStorage/Modules/Data/Modifiers.luau"><![CDATA[-- // Modifiers — SERVER-AUTHORITATIVE COPY //
--
-- Canonical authored registry. The matching file at
-- ReplicatedStorage/Modules/Data/Modifiers.luau is a SHELL (types +
-- MaxModifierSlots constant + empty Module.Modifiers). The shell is
-- populated piggy-back by ItemsConfigReplicationServer — when an
-- item bundle pushes, the server walks Composition.Forged.Modifiers
-- on each owned stack and pushes the relevant Modifier configs in a
-- companion bundle. ForgeServer also pushes individual Modifier rows
-- on each AttemptForgeWeapon commit. See ROADMAP.md.
--
-- Forge modifier catalog — see ARTISAN.md §4.
-- Modifiers are slottable bonuses applied on top of a forged weapon's
-- base material stats. Each modifier has a `Cost` (modifier slots
-- consumed) and a `MaxStack` (how many times it can be applied to a
-- single weapon).
--
-- Two payload channels:
--   * `StatDelta` — flat / percent contributions baked into the
--     forge StatSnapshot (combat reads via composition multipliers).
--     Authors set fields they want to bump; nil = no change.
--   * `OnHit` — per-strike inflict reference. When the weapon lands a
--     hit, CombatUtility walks ComputeActiveModifiers(stack) and rolls
--     each OnHit's Chance to inflict the named effect. PerStackPotency
--     scales the potency by stack count so an Ember×3 ember-mod hits
--     harder than Ember×1.

export type ModifierStatDelta = {
	-- Flat damage added per stack.
	Damage: number?,
	-- Percent multipliers (1.0-baseline, 0.10 = +10%).
	SpeedPct: number?,
	CritPct: number?,
	DurabilityPct: number?,
	-- Bonus tag surfaced on tooltip; non-mechanical.
	TraitTag: string?,
}

export type ModifierOnHit = {
	-- Effect id from Data/Effects.luau registry.
	EffectId: string,
	-- 0..1 chance per swing per stack. Total per-swing chance is
	-- 1 - (1 - Chance) ^ stackCount when applied across stacks.
	Chance: number,
	-- Optional duration / potency overrides; nil = effect cfg defaults.
	Duration: number?,
	Potency: number?,
	-- Per-stack potency add. When set, the runtime infliction's
	-- Potency = (Potency or default) + (PerStackPotency × stackCount).
	-- Useful for Ember (each stack burns harder), Onyx-bleed, etc.
	PerStackPotency: number?,
}

export type Modifier = {
	Id: string,
	Name: string,
	Color: Color3,
	Effect: string,                 -- player-facing effect description
	Cost: number,                   -- modifier slots consumed per stack
	MaxStack: number,               -- max times this can be stacked on one weapon
	-- New optional fields. Existing entries keep working with nil here;
	-- CombatUtility / ForgeShared early-return on missing fields.
	StatDelta: ModifierStatDelta?,
	OnHit: ModifierOnHit?,
}

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

local Module = {}

-- Total modifier-slot budget per weapon. Forge UI / server enforces
-- that the sum of (cost × stacks-applied) stays ≤ this number.
Module.MaxModifierSlots = 12

Module.Modifiers = {
	haste   = {
		Id='haste', Name='Haste', Color=rgb(106,227,168),
		Effect='+12% SPD', Cost=2, MaxStack=3,
		StatDelta = { SpeedPct = 0.12 },
	},
	sharp   = {
		Id='sharp', Name='Sharp', Color=rgb(126,200,255),
		Effect='+24 DMG', Cost=1, MaxStack=5,
		StatDelta = { Damage = 24 },
	},
	arc     = {
		Id='arc', Name='Arc', Color=rgb(255,109,144),
		Effect='+15% CRIT', Cost=3, MaxStack=2,
		StatDelta = { CritPct = 0.15 },
	},
	diamond = {
		Id='diamond', Name='Diamond', Color=rgb(180,228,255),
		Effect='+DUR 1000', Cost=5, MaxStack=1,
		StatDelta = { DurabilityPct = 10.0 },
	},
	ember   = {
		Id='ember', Name='Ember', Color=rgb(255,198,112),
		Effect='+40 FIRE · 25% chance to ignite on hit', Cost=2, MaxStack=3,
		StatDelta = { Damage = 8 },
		OnHit = {
			EffectId = 'burn', Chance = 0.25, Duration = 4.0,
			Potency = 4, PerStackPotency = 2,
		},
	},
	silk    = {
		Id='silk', Name='Silk', Color=rgb(224,234,255),
		Effect='+5% DROP', Cost=4, MaxStack=1,
		StatDelta = { TraitTag = 'Lucky' },
	},
	lunar   = {
		Id='lunar', Name='Lunar', Color=rgb(180,200,255),
		Effect='Heals on hit (Lunar regen)', Cost=3, MaxStack=2,
		OnHit = {
			-- Self-cast handled at the call site via SourceCharacter
			-- routing — combat code applies regen to the *attacker*
			-- when the modifier flag SelfTarget is set. Modeled via
			-- negative-potency dot in Effects.luau (heals over time).
			EffectId = 'regen', Chance = 0.30, Duration = 4.0,
			Potency = -3, PerStackPotency = -1,
		},
	},
	quartz  = {
		Id='quartz', Name='Quartz', Color=rgb(200,157,255),
		Effect='PHASE · 35% chance to crumble armor', Cost=6, MaxStack=1,
		StatDelta = { CritPct = 0.05 },
		OnHit = {
			EffectId = 'crumbling', Chance = 0.35, Duration = 8.0,
			Potency = 4, PerStackPotency = 0,
		},
	},
	-- New modifiers — give the OnHit pipeline more variety so
	-- designers can test the full effects spread without piling
	-- everything onto Ember.
	venom = {
		Id='venom', Name='Venom', Color=rgb(120,220,90),
		Effect='Poisons on hit', Cost=3, MaxStack=3,
		OnHit = {
			EffectId = 'poison', Chance = 0.40, Duration = 6.0,
			Potency = 3, PerStackPotency = 1,
		},
	},
	pierce = {
		Id='pierce', Name='Pierce', Color=rgb(200,80,80),
		Effect='Punctures armor on hit', Cost=4, MaxStack=2,
		StatDelta = { Damage = 6 },
		OnHit = {
			EffectId = 'pierced', Chance = 0.50, Duration = 6.0,
			Potency = 0.20, PerStackPotency = 0,
		},
	},
	frostbite = {
		Id='frostbite', Name='Frostbite', Color=rgb(180,220,255),
		Effect='Slows on hit', Cost=2, MaxStack=2,
		OnHit = {
			EffectId = 'chilled', Chance = 0.45, Duration = 3.0,
			Potency = 0.20, PerStackPotency = 0,
		},
	},
	stagger = {
		Id='stagger', Name='Stagger', Color=rgb(255,230,100),
		Effect='Rare paralysis on hit', Cost=5, MaxStack=1,
		OnHit = {
			EffectId = 'paralysed', Chance = 0.10, Duration = 1.2,
			Potency = 1, PerStackPotency = 0,
		},
	},
} :: { [string]: Modifier }

return Module
]]></Source>
		<Source path="src/ServerStorage/Modules/Data/Mounts.luau"><![CDATA[-- // Mounts — SERVER-AUTHORITATIVE COPY //
--
-- This is the canonical authored registry. The matching file at
-- ReplicatedStorage/Modules/Data/Mounts.luau is an EMPTY SHELL that
-- gets populated at runtime by MountsConfigReplicationClient as the
-- player earns mounts (or, for admins, gets the full registry on
-- join). All server code reads `ServerModules.Data.Mounts` (this
-- file). All client code reads `ReplicatedModules.Data.Mounts` (the
-- shell). See ROADMAP.md for the full pattern.
--
-- Mount configs. Land/flight kinds, with anim/model/sfx blocks reserved
-- for the visual layer that's added later. Stats live here too — speed,
-- acceleration, flight ceiling, dismount-on-damage flag.
--
-- The Model field is a name under ReplicatedStorage.AssetsShared.Mounts.
-- Animations are rbxassetid strings keyed by state. SFX entries are
-- {Sound, Volume} pairs resolved through SoundService.

-- Mount kinds:
--   'land'   — runs on the ground; humanoid WalkSpeed boost.
--   'hover'  — floats above the ground at HoverHeight, walks normally.
--             No flight controls — Space/Ctrl don't ascend/descend; the
--             rider is just "elevated" while moving with WSAD. Reads as
--             "magic carpet" / "hoverboard" in feel.
--   'flight' — true flight rig: humanoid.PlatformStand + BodyVelocity,
--             Space/Ctrl ascend/descend with FlightCeiling cap.
export type MountKind = 'land' | 'hover' | 'flight'

export type MountStats = {
	Speed: number,                  -- forward studs/sec while mounted
	Acceleration: number,           -- studs/sec² ramp
	TurnRate: number,               -- rad/sec yaw
	JumpPower: number?,             -- land/hover mounts; nil = use base humanoid
	HoverHeight: number?,           -- hover only: studs above ground (humanoid HipHeight)
	FlightCeiling: number?,         -- max height above ground in studs (flight only)
	FlightAscentRate: number?,      -- studs/sec when ascending (flight only)
	FlightDescentRate: number?,     -- studs/sec when descending or no input (flight only)
	DismountOnDamage: boolean,
}

export type MountAnimations = {
	Idle: string?,
	Walk: string?,
	Run: string?,
	Jump: string?,
	Land: string?,
	Hover: string?,                 -- flight only
	Glide: string?,                 -- flight only
	RiderIdle: string?,             -- player rider animation while seated
	RiderRun: string?,
}

export type MountSoundEffects = {
	Mount: { Sound: string, Volume: number? }?,
	Dismount: { Sound: string, Volume: number? }?,
	Footstep: { Sound: string, Volume: number? }?,
	WingFlap: { Sound: string, Volume: number? }?,
}

export type MountConfig = {
	Display: {
		Name: string,
		Description: string,
		Icon: string?,
	},
	Kind: MountKind,
	Model: string,                  -- AssetsShared.Mounts.<Model>
	SeatOffset: CFrame,             -- where the rider sits relative to the model
	Stats: MountStats,
	Animations: MountAnimations,
	SFX: MountSoundEffects,
	Tint: Color3?,                  -- procedural placeholder tint for the mount's breed color
	UnlockSource: 'quest' | 'shop' | 'achievement' | 'event' | 'starter',
}

-- Backwards-compat alias: older code may refer to MountsConfig (singular
-- key). Both names point at the same shape.
export type MountsConfig = MountConfig

local Module = {}

----------------------------------------------------------------------
-- Default land/flight templates so per-mount entries only override
-- fields that differ.
----------------------------------------------------------------------
local function landMount(props: any): MountConfig
	local base = {
		Kind = 'land',
		Model = 'GenericLandMount',
		SeatOffset = CFrame.new(0, 3, 0),
		Stats = {
			Speed = 28,
			Acceleration = 80,
			TurnRate = 4.0,
			JumpPower = 50,
			DismountOnDamage = true,
		},
		Animations = {
			Idle = 'rbxassetid://0',
			Walk = 'rbxassetid://0',
			Run = 'rbxassetid://0',
			RiderIdle = 'rbxassetid://0',
			RiderRun = 'rbxassetid://0',
		},
		SFX = {
			Mount = { Sound = 'rbxassetid://0', Volume = 0.5 },
			Dismount = { Sound = 'rbxassetid://0', Volume = 0.5 },
			Footstep = { Sound = 'rbxassetid://0', Volume = 0.4 },
		},
		UnlockSource = 'starter',
		Display = { Name = 'Mount', Description = '', Icon = nil },
	} :: any
	for k, v in props do base[k] = v end
	return base :: MountConfig
end

local function hoverMount(props: any): MountConfig
	local base = {
		Kind = 'hover',
		Model = 'GenericHoverMount',
		SeatOffset = CFrame.new(0, 2.5, 0),
		Stats = {
			Speed = 32,
			Acceleration = 90,
			TurnRate = 4.0,
			JumpPower = 50,
			HoverHeight = 6,
			DismountOnDamage = true,
		},
		Animations = {
			Idle = 'rbxassetid://0',
			RiderIdle = 'rbxassetid://0',
			RiderRun = 'rbxassetid://0',
		},
		SFX = {
			Mount = { Sound = 'rbxassetid://0', Volume = 0.5 },
			Dismount = { Sound = 'rbxassetid://0', Volume = 0.5 },
		},
		UnlockSource = 'starter',
		Display = { Name = 'Hover Mount', Description = '', Icon = nil },
	} :: any
	for k, v in props do base[k] = v end
	return base :: MountConfig
end

-- Cloud breed: a hover-kind mount themed as a skiff of compressed mist.
-- Mirrors hoverMount's structure but stamps cloud-breed defaults (the
-- cloud_hopper stat block) and carries a Tint for the procedural
-- placeholder's breed color. Pass Tint + Display + Stats overrides.
local function cloudMount(props: any): MountConfig
	local base = {
		Kind = 'hover',
		Model = 'CloudHopper',
		SeatOffset = CFrame.new(0, 2.5, 0),
		Stats = {
			Speed = 34,
			Acceleration = 95,
			TurnRate = 4.5,
			JumpPower = 60,
			HoverHeight = 6,
			DismountOnDamage = true,
		},
		Animations = {
			Idle = 'rbxassetid://0',
			RiderIdle = 'rbxassetid://0',
			RiderRun = 'rbxassetid://0',
		},
		SFX = {
			Mount = { Sound = 'rbxassetid://0', Volume = 0.5 },
			Dismount = { Sound = 'rbxassetid://0', Volume = 0.5 },
		},
		UnlockSource = 'shop',
		Display = { Name = 'Cloud', Description = '', Icon = nil },
	} :: any
	for k, v in props do base[k] = v end
	return base :: MountConfig
end

local function flightMount(props: any): MountConfig
	local base = {
		Kind = 'flight',
		Model = 'GenericFlightMount',
		SeatOffset = CFrame.new(0, 3, 0),
		Stats = {
			Speed = 36,
			Acceleration = 60,
			TurnRate = 3.2,
			FlightCeiling = 220,
			FlightAscentRate = 28,
			FlightDescentRate = 22,
			DismountOnDamage = true,
		},
		Animations = {
			Hover = 'rbxassetid://0',
			Glide = 'rbxassetid://0',
			RiderIdle = 'rbxassetid://0',
		},
		SFX = {
			Mount = { Sound = 'rbxassetid://0', Volume = 0.55 },
			Dismount = { Sound = 'rbxassetid://0', Volume = 0.55 },
			WingFlap = { Sound = 'rbxassetid://0', Volume = 0.35 },
		},
		UnlockSource = 'quest',
		Display = { Name = 'Mount', Description = '', Icon = nil },
	} :: any
	for k, v in props do base[k] = v end
	return base :: MountConfig
end

----------------------------------------------------------------------
-- Registry.
----------------------------------------------------------------------
Module.Mounts = {

	shadow_steed = landMount({
		Display = {
			Name = 'Shadow Steed',
			Description = 'A swift midnight courser.',
		},
		Model = 'ShadowSteed',
		Stats = {
			Speed = 32, Acceleration = 90, TurnRate = 4.5,
			JumpPower = 55, DismountOnDamage = true,
		},
		UnlockSource = 'starter',
	}),

	-- Starter hover mount. Floats above the ground via humanoid HipHeight;
	-- no real flight controls — the rider just walks at altitude. Visually
	-- reads as a "magic carpet". Auto-unlocked alongside the shadow steed.
	cloud_hopper = hoverMount({
		Display = {
			Name = 'Cloud Hopper',
			Description = 'A skiff of compressed mist that drifts above the floor.',
		},
		Model = 'CloudHopper',
		Stats = {
			Speed = 34, Acceleration = 95, TurnRate = 4.5,
			JumpPower = 60, HoverHeight = 6, DismountOnDamage = true,
		},
		UnlockSource = 'starter',
	}),

	-- Colored cloud breeds. Same hover feel as the cloud_hopper; each one
	-- carries a Tint so the procedural placeholder reads in its breed color.
	cloud_crimson = cloudMount({
		Display = {
			Name = 'Crimson Cloud',
			Description = 'A thunderhead stained the red of a dying sun.',
		},
		Model = 'CloudHopper',
		Tint = Color3.fromRGB(220, 60, 60),
		UnlockSource = 'shop',
	}),

	cloud_verdant = cloudMount({
		Display = {
			Name = 'Verdant Cloud',
			Description = 'A mist threaded with the green of spring meadows.',
		},
		Model = 'CloudHopper',
		Tint = Color3.fromRGB(90, 210, 110),
		UnlockSource = 'shop',
	}),

	cloud_azure = cloudMount({
		Display = {
			Name = 'Azure Cloud',
			Description = 'A clear-sky wisp the blue of open ocean.',
		},
		Model = 'CloudHopper',
		Tint = Color3.fromRGB(80, 150, 255),
		UnlockSource = 'shop',
	}),

	cloud_gilded = cloudMount({
		Display = {
			Name = 'Gilded Cloud',
			Description = 'A sunrise drift edged in warm amber gold.',
		},
		Model = 'CloudHopper',
		Tint = Color3.fromRGB(255, 200, 90),
		UnlockSource = 'shop',
	}),

	cloud_radiant = cloudMount({
		Display = {
			Name = 'Radiant Cloud',
			Description = 'A noon-bright haze that glows soft yellow.',
		},
		Model = 'CloudHopper',
		Tint = Color3.fromRGB(245, 230, 90),
		UnlockSource = 'shop',
	}),

	cloud_amethyst = cloudMount({
		Display = {
			Name = 'Amethyst Cloud',
			Description = 'A dusk vapor shot through with violet light.',
		},
		Model = 'CloudHopper',
		Tint = Color3.fromRGB(180, 100, 230),
		UnlockSource = 'shop',
	}),

	cloud_obsidian = cloudMount({
		Display = {
			Name = 'Obsidian Cloud',
			Description = 'A storm-dark slab of near-black mist.',
		},
		Model = 'CloudHopper',
		Tint = Color3.fromRGB(40, 40, 50),
		UnlockSource = 'shop',
	}),

	cloud_pristine = cloudMount({
		Display = {
			Name = 'Pristine Cloud',
			Description = 'A spotless white wisp of the high, cold air.',
		},
		Model = 'CloudHopper',
		Tint = Color3.fromRGB(235, 240, 255),
		UnlockSource = 'shop',
	}),

	storm_wyvern = flightMount({
		Display = {
			Name = 'Storm Wyvern',
			Description = 'A flight-capable beast of distant peaks.',
		},
		Model = 'StormWyvern',
		Stats = {
			Speed = 40, Acceleration = 70, TurnRate = 3.0,
			FlightCeiling = 280, FlightAscentRate = 32, FlightDescentRate = 24,
			DismountOnDamage = true,
		},
		UnlockSource = 'quest',
	}),

} :: { [string]: MountConfig }

return Module
]]></Source>
		<Source path="src/ServerStorage/Modules/Libraries/init.luau"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="src/ServerStorage/Modules/Libraries/ComponentBehaviorTree.luau"><![CDATA[local HttpService = game:GetService("HttpService")

--[[
	Scripted by @SPOOKEXE
	Nov 2024
]]

local function DeepCopy(value : any) : any
	if typeof(value) == "table" then
		local clonedTable = {}
		for k,v in value do
			clonedTable[DeepCopy(k)] = DeepCopy(v)
		end
		return clonedTable
	end
	return value
end

local NodeType = {
	Action = 0,
	MultiAction = 1,
	ConditionTrueFalse = 2,
	ConditionSwitch = 3,
	ConditionWhileTrue = 4,
	RandomSwitch = 5,
	Delay = 6,
	PassToBehaviorTree = 7
}

export type BaseSequenceItem = {
	uid : string,
	currentNodeId : string?,
	nodeFrontier : {string},

	conditionParams : {any},
	functionParams : {any},
	data : {}?,

	cycleToRoot : boolean,
	busy : boolean,
	completed : boolean,
	error : string?
}

export type AbstractNode = {
	uid : string,
	nodeType : number,
	nodeArguments : {any},

	parentIDs : {string},
	childIDs : {string},
}

-- this one is for behavior trees that have been resolved.
export type BaseBehaviorNode = AbstractNode & {
	nextNode : string?
}

-- this one is for behavior trees that have not been resolved
export type RawBehaviorNode = AbstractNode & {
	nextNode : RawBehaviorNode | string | nil
}

export type BaseBehaviorTree = {
	uid : string,
	nodes : {BaseBehaviorNode},
	rootNode : BaseBehaviorNode?,

	m_idToNode : {[string] : BaseBehaviorNode},
	m_idToForward : {[string] : {BaseBehaviorNode}},
	m_sequencers : {BaseSequenceItem},
	debug : boolean,

	new : () -> BaseBehaviorTree,
	append_sequencer : (BaseBehaviorTree, BaseSequenceItem) -> nil,
	extend_sequencers : (BaseBehaviorTree, {BaseSequenceItem}) -> nil,
	remove_sequencer : (BaseBehaviorTree, BaseSequenceItem) -> nil,
	remove_sequencers : (BaseBehaviorTree, {BaseSequenceItem}) -> nil,
	await_sequencer_completion : (BaseBehaviorTree, BaseSequenceItem) -> nil,

	internal_parse_node : (BaseBehaviorTree, BaseBehaviorNode, BaseSequenceItem) -> nil,
	internal_update_sequencer : (BaseBehaviorTree, BaseSequenceItem) -> nil,

	update_sequencers : (BaseBehaviorTree) -> nil,
	update_graph : (BaseBehaviorTree) -> nil,
	find_root_node : (BaseBehaviorTree) -> BaseBehaviorNode?,
}

export type BehaviorTreeResolver = {
	trees : {BaseBehaviorTree},
	auto_updating : boolean,

	new : () -> BehaviorTreeResolver,
	append_tree : (BehaviorTreeResolver, BaseBehaviorTree) -> nil,
	extend_trees : (BehaviorTreeResolver, {BaseBehaviorTree}) -> nil,
	pop_tree : (BehaviorTreeResolver, BaseBehaviorTree) -> nil,
	start_runtimes : (BehaviorTreeResolver) -> nil,
	stop_runtimes : (BehaviorTreeResolver) -> nil,
}

export type BehaviorTreeFactory = {
	_define_heirarchy : (RawBehaviorNode, RawBehaviorNode?, {}?) -> {string},
	_nested_to_array : (RawBehaviorNode) -> {BaseBehaviorNode},

	build_from_nested : (string, RawBehaviorNode, boolean) -> BaseBehaviorTree,
}

local NodeFactory = {
	action = function(callback : (...any?) -> any?, nextNode : RawBehaviorNode | string) : RawBehaviorNode
		return {
			uid=HttpService:GenerateGUID(false),
			nodeType=NodeType.Action,
			nodeArguments={callback},
			parentIDs={},
			childIDs = {},
			nextNode=nextNode,
		}
	end,

	multi_action = function(callbacks : {(...any?) -> any?}, nextNode : RawBehaviorNode | string) : RawBehaviorNode
		return {
			uid=HttpService:GenerateGUID(false),
			nodeType=NodeType.MultiAction,
			nodeArguments=callbacks,
			parentIDs={},
			childIDs = {},
			nextNode=nextNode,
		}
	end,

	delay = function(delay : number, nextNode : RawBehaviorNode | string) : RawBehaviorNode
		return {
			uid=HttpService:GenerateGUID(false),
			nodeType=NodeType.Delay,
			nodeArguments={delay},
			parentIDs={},
			childIDs = {},
			nextNode=nextNode,
		}
	end,

	while_condition_callback = function(condition : (...any?) -> boolean, callback : (...any?) -> any?, nextNode : RawBehaviorNode | string) : RawBehaviorNode
		return {
			uid=HttpService:GenerateGUID(false),
			nodeType=NodeType.ConditionWhileTrue,
			nodeArguments={condition, callback},
			parentIDs={},
			childIDs = {},
			nextNode=nextNode,
		}
	end,

	condition_true_false = function(condition : (...any?) -> boolean, ifTrueBranch : (...any?) -> any?, ifFalseBranch : (...any?) -> any?, nextNode : RawBehaviorNode | string) : RawBehaviorNode
		return {
			uid=HttpService:GenerateGUID(false),
			nodeType=NodeType.ConditionTrueFalse,
			nodeArguments={condition, ifTrueBranch, ifFalseBranch},
			parentIDs={},
			childIDs = {},
			nextNode=nextNode,
		}
	end,

	condition_switch = function(condition : (...any?) -> boolean, branches : {(...any?) -> any?}, nextNode : RawBehaviorNode | string) : RawBehaviorNode
		return {
			uid=HttpService:GenerateGUID(false),
			nodeType=NodeType.ConditionSwitch,
			nodeArguments={condition, branches},
			parentIDs={},
			childIDs = {},
			nextNode=nextNode,
		}
	end,

	random_switch_node = function(branches : {(...any?) -> any?}, nextNode : RawBehaviorNode | string) : RawBehaviorNode
		return {
			uid=HttpService:GenerateGUID(false),
			nodeType=NodeType.RandomSwitch,
			nodeArguments=branches,
			parentIDs={},
			childIDs = {},
			nextNode=nextNode,
		}
	end,

	pass_to_behavior_tree = function(mutator : ((...any?) -> any?)?, target_bt : BaseBehaviorTree) : RawBehaviorNode
		return {
			uid=HttpService:GenerateGUID(false),
			nodeType=NodeType.PassToBehaviorTree,
			nodeArguments={mutator, target_bt},
			parentIDs={},
			childIDs = {},
			nextNode=nil,
		}
	end,
}

local BehaviorTree = {} :: BaseBehaviorTree
BehaviorTree.__index = BehaviorTree

function BehaviorTree.new(nodes : {BaseBehaviorNode}, debug : boolean) : BaseBehaviorTree
	local self = setmetatable({
		uid = HttpService:GenerateGUID(false),
		nodes = nodes,
		rootNode = nil,

		m_idToNode = {},
		m_idToForward = {},
		m_sequencers = {},
		debug = debug,
	}, BehaviorTree) :: BaseBehaviorTree

	self:update_graph()
	self:find_root_node()

	return self
end

function BehaviorTree:create_sequence_item() : BaseSequenceItem
	return {
		uid = HttpService:GenerateGUID(false),
		currentNodeId = nil,
		nodeFrontier = {},

		conditionParams = {},
		functionParams = {},
		data = nil,

		cycleToRoot = false,
		busy = false,
		completed = false,
		error = nil,
	}
end

function BehaviorTree:append_sequencer(sequencer : BaseSequenceItem)
	assert(self.rootNode, "No root node has been found.")
	if not table.find(self.m_sequencers, sequencer) then
		-- make the sequencer visit the root again
		local index = table.find(sequencer.nodeFrontier, self.rootNode.uid)
		if index then
			table.remove(sequencer.nodeFrontier, index)
		end
		table.insert(sequencer.nodeFrontier, 1, self.rootNode.uid)
		-- add sequencer to the behavior tree
		table.insert(self.m_sequencers, sequencer)
	end
end

function BehaviorTree:extend_sequencers(sequencers : {BaseSequenceItem})
	for _, object in sequencers do
		-- make the sequencer visit root again
		if table.find(object.nodeFrontier, self.rootNode.uid) then
			object.nodeFrontier.remove(self.rootNode.uid)
		end
		table.insert(object.nodeFrontier, 1, self.rootNode.uid)
		-- add sequencers that are not in there already
		if not table.find(self.m_sequencers, object) then
			table.insert(self.m_sequencers, object)
		end
	end
end

function BehaviorTree:remove_sequencer(sequencer : BaseSequenceItem)
	local index = table.find(self.m_sequencers, sequencer)
	if index then
		table.remove(self.m_sequencers, index)
	end
end

function BehaviorTree:remove_sequencers(sequencers : {BaseSequenceItem})
	for _, object in sequencers do
		local index = table.find(self.m_sequencers, object)
		if index then
			table.remove(self.m_sequencers, index)
		end
	end
end

function BehaviorTree:await_sequencer_completion(sequencer : BaseSequenceItem)
	while not sequencer.completed do
		task.wait()
	end
end

function BehaviorTree:parse_multi_type(sequencer : BaseSequenceItem, value : any)
	if self.debug then
		print(value)
	end
	if typeof(value) == 'function' then
		value(self, sequencer, table.unpack(sequencer.functionParams))
	elseif typeof(value) == 'string' then
		local next_node = self.m_idToNode[value]
		if not next_node then
			error(string.format('Could not find behavior node of id: %s', tostring(value)))
		end
		self:internal_parse_node(next_node, sequencer)
	else
		error(string.format('Unsupported node value: (%s) %s', typeof(value), tostring(value)))
	end
end

function BehaviorTree:internal_parse_node(node : BaseBehaviorNode, sequencer : BaseSequenceItem)
	if self.debug then
		print(sequencer.uid, node.nodeType)
	end

	if node.nodeType == NodeType.Action then
		node.nodeArguments[1](self, sequencer, table.unpack(sequencer.functionParams))
	elseif node.nodeType == NodeType.MultiAction then
		for action in node.nodeArguments do
			action(self, sequencer, table.unpack(sequencer.functionParams))
		end
	elseif node.nodeType == NodeType.Delay then
		task.wait(node.nodeArguments[1])
	elseif node.nodeType == NodeType.RandomSwitch then
		self:parse_multi_type(sequencer, node.nodeArguments[math.random(#node.nodeArguments)])
	elseif node.nodeType == NodeType.ConditionSwitch then
		local index = node.nodeArguments[1](self, sequencer, table.unpack(sequencer.conditionParams))
		assert(typeof(index) == 'number', 'The conditional switch did not return a number!')
		assert(index >= 1 and index <= #node.nodeArguments[2], string.format("The conditional switch did not return a number between 1 and %s", tostring(#node.nodeArguments[2])))
		self:parse_multi_type(sequencer, node.nodeArguments[2][index])
	elseif node.nodeType == NodeType.ConditionTrueFalse then
		local result = node.nodeArguments[1](self, sequencer, table.unpack(sequencer.conditionParams))
		if result then
			self:parse_multi_type( sequencer, node.nodeArguments[2] )
		else
			self:parse_multi_type( sequencer, node.nodeArguments[3] )
		end
	elseif node.nodeType == NodeType.ConditionWhileTrue then
		while node.nodeArguments[1](self, sequencer, table.unpack(sequencer.conditionParams)) do
			node.nodeArguments[2](self, sequencer, table.unpack(sequencer.functionParams))
			task.wait()
		end
	elseif node.nodeType == NodeType.PassToBehaviorTree then
		if node.nodeArguments[1] then
			node.nodeArguments[1](self, sequencer)
		end
		self:remove_sequencer(sequencer)
		local bt : BaseBehaviorTree? = node.nodeArguments[2]
		assert(bt, "The target behavior tree does not exist - cannot pass the sequence item on.")
		bt:append_sequencer(sequencer)
	end
end

function BehaviorTree:internal_update_sequencer(sequencer : BaseSequenceItem)
	-- find next node
	local currentId = nil
	if #sequencer.nodeFrontier ~= 0 then
		currentId = table.remove(sequencer.nodeFrontier, 1)
	end
	-- if no node, check if we cycle root
	if not currentId and sequencer.cycleToRoot then
		currentId = self.rootNode.uid
	end
	-- check if completed
	local currentNode = self.m_idToNode[currentId]
	if not currentId or not currentNode then
		-- print('No next node - popping sequencer and returning!')
		sequencer.completed = true
		self:remove_sequencer(sequencer)
		return
	end
	-- check if nextNode has been appended
	if currentNode.nextNode then
		table.insert(sequencer.nodeFrontier, 1, currentNode.nextNode)
	end
	-- parse the node
	local success, err = pcall(function()
		self:internal_parse_node(currentNode, sequencer)
	end)
	-- check for error
	if not success then
		print('An exception has occured trying to update a sequencer item!')
		print('=================================')
		print(err)
		print('=================================')
		print('Sequencer item has been removed from the behavior tree.')
		sequencer.error = err
		self:remove_sequencer( sequencer )
	end
	-- finish
	if self.debug then
		print('finished')
	end
	sequencer.busy = false
end

function BehaviorTree:update_sequencers()
	if #self.m_sequencers == 0 then
		return
	end
	for _, sequencer in self.m_sequencers do
		if sequencer.completed then
			continue
		end
		if sequencer.busy then
			continue
		end
		sequencer.busy = true
		task.defer(BehaviorTree.internal_update_sequencer, self, sequencer)
	end
end

function BehaviorTree:update_graph()
	self.m_idToNode = {}
	for _, node in self.nodes do
		self.m_idToNode[node.uid] = node
	end
	self.m_idToForward = {}
	for _, node in self.nodes do
		local frontier = {}
		for argument in node.nodeArguments do
			if typeof(argument) == 'table' and argument.uid then
				table.insert(frontier, argument.uid)
			elseif typeof(argument) == 'string' then
				if self.m_idToNode[argument] then
					table.insert(frontier, argument)
				end
			end
		end
		if node.nextNode then
			table.insert(frontier, node.nextNode)
		end
		self.m_idToForward[node.uid] = frontier
	end
end

function BehaviorTree:find_root_node() : BaseBehaviorNode?
	local root_node = nil
	for _, node in self.nodes do
		if #node.parentIDs == 0 then
			root_node = node
		end
	end
	self.rootNode = root_node
	return root_node
end

local BehaviorTreeResolver = {}
BehaviorTreeResolver.__index = BehaviorTreeResolver

function BehaviorTreeResolver.new()
	return setmetatable({
		trees = {},
		auto_update = false,
	}, BehaviorTreeResolver)
end

function BehaviorTreeResolver:append_tree(tree : BaseBehaviorTree)
	if not table.find(self.trees, tree) then
		table.insert(self.trees, tree)
	end
end

function BehaviorTreeResolver:extend_trees(trees : {BaseBehaviorTree})
	for _, tree in trees do
		if not table.find(self.trees, tree) then
			table.insert(self.trees, tree)
		end
	end
end

function BehaviorTreeResolver:remove_tree(tree : BaseBehaviorTree)
	local index = table.find(self.trees, tree)
	if index then
		table.remove(self.trees, index)
	end
end

function BehaviorTreeResolver:update_trees()
	for _, tree in self.trees do
		tree:update_sequencers()
	end
end

function BehaviorTreeResolver:start_runtime()
	if self.auto_update then
		return
	end
	self.auto_update = true

	task.spawn(function()
		while self.auto_update do
			self:update_trees()
			task.wait()
		end
	end)
end

function BehaviorTreeResolver:stop_runtime()
	self.auto_update = false
end

local BehaviorTreeFactory = {} :: BehaviorTreeFactory

function BehaviorTreeFactory._define_heirarchy(node : RawBehaviorNode, parent : RawBehaviorNode?, cache : {string}?): any
	if cache == nil then
		cache = {}
	end
	if (not node) or typeof(node) == "function" then
		return cache
	end
	-- parent child node
	if parent and not table.find(parent.childIDs, node.uid) then
		table.insert(parent.childIDs, node.uid)
	end
	-- skip repeats
	if table.find(cache, node.uid) then
		return cache
	end
	table.insert(cache, node.uid)
	-- setup node ids
	if parent and not table.find(node.parentIDs, parent.uid) then
		table.insert(node.parentIDs, parent.uid)
	end
	-- iterate over node arguments
	for _, object in node.nodeArguments do
		if typeof(object) == 'table' and object.uid then
			BehaviorTreeFactory._define_heirarchy(object, node, cache)
		end
	end
	-- nextNode parse
	if not node.nextNode then
		return cache
	end
	local nextNode : RawBehaviorNode? | string? = node.nextNode
	if typeof(nextNode) ~= "table" then
		return cache
	end
	if not table.find(nextNode.parentIDs, nextNode.uid) then
		table.insert(nextNode.parentIDs, nextNode.uid)
	end
	if not table.find(nextNode.childIDs, nextNode.uid) then
		table.insert(nextNode.childIDs, nextNode.uid)
	end
	BehaviorTreeFactory._define_heirarchy(nextNode, node.nextNode, cache)
	return cache
end

function BehaviorTreeFactory._nested_to_array(root : RawBehaviorNode) : {BaseBehaviorNode}
	local node_array = {}
	local once_array = {}

	local function recursive(node : RawBehaviorNode)
		if table.find(once_array, node.uid) then
			return
		end
		table.insert(once_array, node.uid)
		-- node.nodeArguments
		for index, argument in node.nodeArguments do
			if typeof(argument) == 'table' and argument.uid then
				if table.find(node_array, argument) then
					continue
				end
				table.insert(node_array, argument)
				node.nodeArguments[index] = argument.uid
				recursive(argument)
			end
		end
		-- node.nextNode
		if typeof(node.nextNode) == 'table' and node.nextNode.uid then
			if not table.find(node_array, node.nextNode) then
				table.insert(node_array, node.nextNode)
				local next_node = node.nextNode
				node.nextNode = next_node.uid
				recursive(next_node)
			end
		end
		-- append node as well
		if not table.find(node_array, node) then
			table.insert(node_array, node)
		end
	end

	recursive(root)
	return node_array
end

function BehaviorTreeFactory.build_from_nested(root : RawBehaviorNode, debug : boolean) : BaseBehaviorTree
	BehaviorTreeFactory._define_heirarchy( root, nil, {} )
	local node_array = BehaviorTreeFactory._nested_to_array( root )
	return BehaviorTree.new(node_array, debug)
end

local Module = {}

Module.NodeType = NodeType
Module.NodeFactory = NodeFactory
Module.BehaviorTree = BehaviorTree
Module.BehaviorTreeResolver = BehaviorTreeResolver
Module.BehaviorTreeFactory = BehaviorTreeFactory

return Module
]]></Source>
		<Source path="src/ServerStorage/Modules/Libraries/ProfileService.luau"><![CDATA[-- local Madwork = _G.Madwork
--[[
{Madwork}

-[ProfileService]---------------------------------------
	(STANDALONE VERSION)
	DataStore profiles - universal session-locked savable table API
	
	Official documentation:
		https://madstudioroblox.github.io/ProfileService/

	DevForum discussion:
		https://devforum.roblox.com/t/ProfileService/667805
	
	WARNINGS FOR "Profile.Data" VALUES:
	 	! Do not create numeric tables with gaps - attempting to replicate such tables will result in an error;
		! Do not create mixed tables (some values indexed by number and others by string key), as only
		     the data indexed by number will be replicated.
		! Do not index tables by anything other than numbers and strings.
		! Do not reference Roblox Instances
		! Do not reference userdata (Vector3, Color3, CFrame...) - Serialize userdata before referencing
		! Do not reference functions
		
	WARNING: Calling ProfileStore:LoadProfileAsync() with a "profile_key" which wasn't released in the SAME SESSION will result
		in an error! If you want to "ProfileStore:LoadProfileAsync()" instead of using the already loaded profile, :Release()
		the old Profile object.
		
	Members:
	
		ProfileService.ServiceLocked         [bool]
		
		ProfileService.IssueSignal           [ScriptSignal] (error_message, profile_store_name, profile_key)
		ProfileService.CorruptionSignal      [ScriptSignal] (profile_store_name, profile_key)
		ProfileService.CriticalStateSignal   [ScriptSignal] (is_critical_state)
	
	Functions:
	
		ProfileService.GetProfileStore(profile_store_index, profile_template) --> [ProfileStore]
			profile_store_index   [string] -- DataStore name
			OR
			profile_store_index   [table]: -- Allows the developer to define more GlobalDataStore variables
				{
					Name = "StoreName", -- [string] -- DataStore name
					-- Optional arguments:
					Scope = "StoreScope", -- [string] -- DataStore scope
				}
			profile_template      [table] -- Profiles will default to given table (hard-copy) when no data was saved previously

		ProfileService.IsLive() --> [bool] -- (CAN YIELD!!!)
			-- Returns true if ProfileService is connected to live Roblox DataStores
				
	Members [ProfileStore]:
	
		ProfileStore.Mock   [ProfileStore] -- Reflection of ProfileStore methods, but the methods will use a mock DataStore
		
	Methods [ProfileStore]:
	
		ProfileStore:LoadProfileAsync(profile_key, not_released_handler) --> [Profile] or nil -- not_released_handler(place_id, game_job_id)
			profile_key            [string] -- DataStore key
			not_released_handler   nil or []: -- Defaults to "ForceLoad"
				[string] "ForceLoad" -- Force loads profile on first call
				OR
				[string] "Steal" -- Steals the profile ignoring it's session lock
				OR
				[function] (place_id, game_job_id) --> [string] "Repeat", "Cancel", "ForceLoad" or "Steal"
					place_id      [number] or nil
					game_job_id   [string] or nil

				-- not_released_handler [function] will be triggered in cases where the profile is not released by a session. This
				--	function may yield for as long as desirable and must return one of three string values:

						["Repeat"] - ProfileService will repeat the profile loading proccess and may trigger the release handler again
						["Cancel"] - ProfileStore:LoadProfileAsync() will immediately return nil
						["ForceLoad"] - ProfileService will repeat the profile loading call, but will return Profile object afterwards
							and release the profile for another session that has loaded the profile
						["Steal"] - The profile will usually be loaded immediately, ignoring an existing remote session lock and applying
							a session lock for this session.

		ProfileStore:GlobalUpdateProfileAsync(profile_key, update_handler) --> [GlobalUpdates] or nil
			-- Returns GlobalUpdates object if update was successful, otherwise returns nil
			profile_key      [string] -- DataStore key
			update_handler   [function] (global_updates [GlobalUpdates])
			
		ProfileStore:ViewProfileAsync(profile_key, version) --> [Profile] or nil
			-- Reads profile without requesting a session lock; Data will not be saved and profile doesn't need to be released
			profile_key   [string] -- DataStore key
			version       nil or [string] -- DataStore key version

		ProfileStore:ProfileVersionQuery(profile_key, sort_direction, min_date, max_date) --> [ProfileVersionQuery]
			profile_key      [string]
			sort_direction   nil or [Enum.SortDirection]
			min_date         nil or [DateTime]
			max_date         nil or [DateTime]
			
		ProfileStore:WipeProfileAsync(profile_key) --> is_wipe_successful [bool]
			-- Completely wipes out profile data from the DataStore / mock DataStore with no way to recover it.
						
		* Parameter description for "ProfileStore:GlobalUpdateProfileAsync()":
		
			profile_key      [string] -- DataStore key
			update_handler   [function] (GlobalUpdates) -- This function gains access to GlobalUpdates object methods
				(update_handler can't yield)

	Methods [ProfileVersionQuery]:

		ProfileVersionQuery:NextAsync() --> [Profile] or nil -- (Yields)
			-- Returned profile has the same rules as profile returned by :ViewProfileAsync()
		
	Members [Profile]:
	
		Profile.Data              [table] -- Writable table that gets saved automatically and once the profile is released
		Profile.MetaData          [table] (Read-only) -- Information about this profile
		
			Profile.MetaData.ProfileCreateTime   [number] (Read-only) -- os.time() timestamp of profile creation
			Profile.MetaData.SessionLoadCount    [number] (Read-only) -- Amount of times the profile was loaded
			Profile.MetaData.ActiveSession       [table] (Read-only) {place_id, game_job_id} / nil -- Set to a session link if a
				game session is currently having this profile loaded; nil if released
			Profile.MetaData.MetaTags            [table] {["tag_name"] = tag_value, ...} -- Saved and auto-saved just like Profile.Data
			Profile.MetaData.MetaTagsLatest      [table] (Read-only) -- Latest version of MetaData.MetaTags that was definetly saved to DataStore
				(You can use Profile.MetaData.MetaTagsLatest for product purchase save confirmation, but create a system to clear old tags after
				they pile up)

		Profile.MetaTagsUpdated   [ScriptSignal] (meta_tags_latest) -- Fires after every auto-save, after
			--	Profile.MetaData.MetaTagsLatest has been updated with the version that's guaranteed to be saved;
			--  .MetaTagsUpdated will fire regardless of whether .MetaTagsLatest changed after update;
			--	.MetaTagsUpdated may fire after the Profile is released - changes to Profile.Data are not saved
			--	after release.

		Profile.RobloxMetaData    [table] -- Writable table that gets saved automatically and once the profile is released
		Profile.UserIds           [table] -- (Read-only) -- {user_id [number], ...} -- User ids associated with this profile

		Profile.KeyInfo           [DataStoreKeyInfo]
		Profile.KeyInfoUpdated    [ScriptSignal] (key_info [DataStoreKeyInfo])
		
		Profile.GlobalUpdates     [GlobalUpdates]
		
	Methods [Profile]:
	
		-- SAFE METHODS - Will not error after profile expires:
		Profile:IsActive() --> [bool] -- Returns true while the profile is active and can be written to
			
		Profile:GetMetaTag(tag_name) --> value [any]
			tag_name   [string]
		
		Profile:Reconcile() -- Fills in missing (nil) [string_key] = [value] pairs to the Profile.Data structure
		
		Profile:ListenToRelease(listener) --> [ScriptConnection] (place_id / nil, game_job_id / nil)
			-- WARNING: Profiles can be released externally if another session force-loads
			--	this profile - use :ListenToRelease() to handle player leaving cleanup.
			
		Profile:Release() -- Call after the session has finished working with this profile
			e.g., after the player leaves (Profile object will become expired) (Does not yield)

		Profile:ListenToHopReady(listener) --> [ScriptConnection] () -- Passed listener will be executed after the releasing UpdateAsync call finishes;
			--	Wrap universe teleport requests with this method AFTER releasing the profile to improve session lock sharing between universe places;
			--  :ListenToHopReady() will usually call the listener in around a second, but may ocassionally take up to 7 seconds when a release happens
			--	next to an auto-update in regular usage scenarios.

		Profile:AddUserId(user_id) -- Associates user_id with profile (GDPR compliance)
			user_id   [number]

		Profile:RemoveUserId(user_id) -- Unassociates user_id with profile (safe function)
			user_id   [number]

		Profile:Identify() --> [string] -- Returns a string containing DataStore name, scope and key; Used for debug;
			-- Example return: "[Store:"GameData";Scope:"Live";Key:"Player_2312310"]"
		
		Profile:SetMetaTag(tag_name, value) -- Equivalent of Profile.MetaData.MetaTags[tag_name] = value
			tag_name   [string]
			value      [any]
		
		Profile:Save() -- Call to quickly progress global update state or to speed up save validation processes (Does not yield)

		-- VIEW-MODE ONLY:

		Profile:ClearGlobalUpdates() -- Clears all global updates data from a profile payload

		Profile:OverwriteAsync() -- (Yields) Saves the profile payload to the DataStore and removes the session lock
		
	Methods [GlobalUpdates]:
	
	-- ALWAYS PUBLIC:
		GlobalUpdates:GetActiveUpdates() --> [table] {{update_id, update_data [table]}, ...}
		GlobalUpdates:GetLockedUpdates() --> [table] {{update_id, update_data [table]}, ...}
		
	-- ONLY WHEN FROM "Profile.GlobalUpdates":
		GlobalUpdates:ListenToNewActiveUpdate(listener) --> [ScriptConnection] (update_id, update_data)
			update_data   [table]
		GlobalUpdates:ListenToNewLockedUpdate(listener) --> [ScriptConnection] (update_id, update_data)
			update_data   [table]
		GlobalUpdates:LockActiveUpdate(update_id)  -- WARNING: will error after profile expires
		GlobalUpdates:ClearLockedUpdate(update_id) -- WARNING: will error after profile expires
		
	-- EXPOSED TO "update_handler" DURING ProfileStore:GlobalUpdateProfileAsync() CALL
		GlobalUpdates:AddActiveUpdate(update_data)
			update_data   [table]
		GlobalUpdates:ChangeActiveUpdate(update_id, update_data)
			update_data   [table]
		GlobalUpdates:ClearActiveUpdate(update_id)
		
--]]

local SETTINGS = {

	AutoSaveProfiles = 30, -- Seconds (This value may vary - ProfileService will split the auto save load evenly in the given time)
	RobloxWriteCooldown = 7, -- Seconds between successive DataStore calls for the same key
	ForceLoadMaxSteps = 8, -- Steps taken before ForceLoad request steals the active session for a profile
	AssumeDeadSessionLock = 30 * 60, -- (seconds) If a profile hasn't been updated for 30 minutes, assume the session lock is dead
		-- As of writing, os.time() is not completely reliable, so we can only assume session locks are dead after a significant amount of time.
	
	IssueCountForCriticalState = 5, -- Issues to collect to announce critical state
	IssueLast = 120, -- Seconds
	CriticalStateLast = 120, -- Seconds
	
	MetaTagsUpdatedValues = { -- Technical stuff - do not alter
		ProfileCreateTime = true,
		SessionLoadCount = true,
		ActiveSession = true,
		ForceLoadSession = true,
		LastUpdate = true,
	},
	
}

local Madwork -- Standalone Madwork reference for portable version of ProfileService
do

	local MadworkScriptSignal = {}

	local FreeRunnerThread = nil
	
	local function AcquireRunnerThreadAndCallEventHandler(fn, ...)
		local acquired_runner_thread = FreeRunnerThread
		FreeRunnerThread = nil
		fn(...)
		FreeRunnerThread = acquired_runner_thread
	end
	
	local function RunEventHandlerInFreeThread(...)
		AcquireRunnerThreadAndCallEventHandler(...)
		while true do
			AcquireRunnerThreadAndCallEventHandler(coroutine.yield())
		end
	end
	
	-- ScriptConnection object:

	local ScriptConnection = {
		--[[
			_listener = listener,
			_script_signal = script_signal,
			_disconnect_listener = disconnect_listener,
			_disconnect_param = disconnect_param,
			
			_next = next_script_connection,
			_is_connected = is_connected,
		--]]
	}
	ScriptConnection.__index = ScriptConnection

	function ScriptConnection:Disconnect()

		if self._is_connected == false then
			return
		end

		self._is_connected = false
		self._script_signal._listener_count -= 1

		if self._script_signal._head == self then
			self._script_signal._head = self._next
		else
			local prev = self._script_signal._head
			while prev ~= nil and prev._next ~= self do
				prev = prev._next
			end
			if prev ~= nil then
				prev._next = self._next
			end
		end

		if self._disconnect_listener ~= nil then
			if not FreeRunnerThread then
				FreeRunnerThread = coroutine.create(RunEventHandlerInFreeThread)
			end
			task.spawn(FreeRunnerThread, self._disconnect_listener, self._disconnect_param)
			self._disconnect_listener = nil
		end

	end
	
	-- ScriptSignal object:

	local ScriptSignal = {
		--[[
			_head = nil,
			_listener_count = 0,
		--]]
	}
	ScriptSignal.__index = ScriptSignal

	function ScriptSignal:Connect(listener, disconnect_listener, disconnect_param) --> [ScriptConnection]

		local script_connection = {
			_listener = listener,
			_script_signal = self,
			_disconnect_listener = disconnect_listener,
			_disconnect_param = disconnect_param,

			_next = self._head,
			_is_connected = true,
		}
		setmetatable(script_connection, ScriptConnection)

		self._head = script_connection
		self._listener_count += 1

		return script_connection

	end

	function ScriptSignal:GetListenerCount() --> [number]
		return self._listener_count
	end

	function ScriptSignal:Fire(...)
		local item = self._head
		while item ~= nil do
			if item._is_connected == true then
				if not FreeRunnerThread then
					FreeRunnerThread = coroutine.create(RunEventHandlerInFreeThread)
				end
				task.spawn(FreeRunnerThread, item._listener, ...)
			end
			item = item._next
		end
	end

	function ScriptSignal:FireUntil(continue_callback, ...)
		local item = self._head
		while item ~= nil do
			if item._is_connected == true then
				item._listener(...)
				if continue_callback() ~= true then
					return
				end
			end
			item = item._next
		end
	end

	function MadworkScriptSignal.NewScriptSignal() --> [ScriptSignal]
		return {
			_head = nil,
			_listener_count = 0,
			Connect = ScriptSignal.Connect,
			GetListenerCount = ScriptSignal.GetListenerCount,
			Fire = ScriptSignal.Fire,
			FireUntil = ScriptSignal.FireUntil,
		}
	end

	-- Madwork framework namespace:
	
	Madwork = {
		NewScriptSignal = MadworkScriptSignal.NewScriptSignal,
		ConnectToOnClose = function(task, run_in_studio_mode)
			if game:GetService("RunService"):IsStudio() == false or run_in_studio_mode == true then
				game:BindToClose(task)
			end
		end,
	}

end

----- Service Table -----

local ProfileService = {

	ServiceLocked = false, -- Set to true once the server is shutting down

	IssueSignal = Madwork.NewScriptSignal(), -- (error_message, profile_store_name, profile_key) -- Fired when a DataStore API call throws an error
	CorruptionSignal = Madwork.NewScriptSignal(), -- (profile_store_name, profile_key) -- Fired when DataStore key returns a value that has
	-- all or some of it's profile components set to invalid data types. E.g., accidentally setting Profile.Data to a noon table value

	CriticalState = false, -- Set to true while DataStore service is throwing too many errors
	CriticalStateSignal = Madwork.NewScriptSignal(), -- (is_critical_state) -- Fired when CriticalState is set to true
	-- (You may alert players with this, or set up analytics)

	ServiceIssueCount = 0,

	_active_profile_stores = {}, -- {profile_store, ...}

	_auto_save_list = {}, -- {profile, ...} -- loaded profile table which will be circularly auto-saved

	_issue_queue = {}, -- [table] {issue_time, ...}
	_critical_state_start = 0, -- [number] 0 = no critical state / os.clock() = critical state start

	-- Debug:
	_mock_data_store = {},
	_user_mock_data_store = {},

	_use_mock_data_store = false,

}

--[[
	Saved profile structure:
	
	DataStoreProfile = {
		Data = {},
		MetaData = {
			ProfileCreateTime = 0,
			SessionLoadCount = 0,
			ActiveSession = {place_id, game_job_id} / nil,
			ForceLoadSession = {place_id, game_job_id} / nil,
			MetaTags = {},
			LastUpdate = 0, -- os.time()
		},
		RobloxMetaData = {},
		UserIds = {},
		GlobalUpdates = {
			update_index,
			{
				{update_id, version_id, update_locked, update_data},
				...
			}
		},
	}
	
	OR
	
	DataStoreProfile = {
		GlobalUpdates = {
			update_index,
			{
				{update_id, version_id, update_locked, update_data},
				...
			}
		},
	}
--]]

----- Private Variables -----

local ActiveProfileStores = ProfileService._active_profile_stores
local AutoSaveList = ProfileService._auto_save_list
local IssueQueue = ProfileService._issue_queue

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local PlaceId = game.PlaceId
local JobId = game.JobId

local AutoSaveIndex = 1 -- Next profile to auto save
local LastAutoSave = os.clock()

local LoadIndex = 0

local ActiveProfileLoadJobs = 0 -- Number of active threads that are loading in profiles
local ActiveProfileSaveJobs = 0 -- Number of active threads that are saving profiles

local CriticalStateStart = 0 -- os.clock()

local IsStudio = RunService:IsStudio()
local IsLiveCheckActive = false

local UseMockDataStore = false
local MockDataStore = ProfileService._mock_data_store -- Mock data store used when API access is disabled

local UserMockDataStore = ProfileService._user_mock_data_store -- Separate mock data store accessed via ProfileStore.Mock
local UseMockTag = {}

local CustomWriteQueue = {
	--[[
		[store] = {
			[key] = {
				LastWrite = os.clock(),
				Queue = {callback, ...},
				CleanupJob = nil,
			},
			...
		},
		...
	--]]
}

----- Utils -----

local function DeepCopyTable(t)
	local copy = {}
	for key, value in pairs(t) do
		if type(value) == "table" then
			copy[key] = DeepCopyTable(value)
		else
			copy[key] = value
		end
	end
	return copy
end

local function ReconcileTable(target, template)
	for k, v in pairs(template) do
		if type(k) == "string" then -- Only string keys will be reconciled
			if target[k] == nil then
				if type(v) == "table" then
					target[k] = DeepCopyTable(v)
				else
					target[k] = v
				end
			elseif type(target[k]) == "table" and type(v) == "table" then
				ReconcileTable(target[k], v)
			end
		end
	end
end

----- Private functions -----

local function IdentifyProfile(store_name, store_scope, key)
	return string.format(
		"[Store:\"%s\";%sKey:\"%s\"]",
		store_name,
		store_scope ~= nil and string.format("Scope:\"%s\";", store_scope) or "",
		key
	)
end

local function CustomWriteQueueCleanup(store, key)
	if CustomWriteQueue[store] ~= nil then
		CustomWriteQueue[store][key] = nil
		if next(CustomWriteQueue[store]) == nil then
			CustomWriteQueue[store] = nil
		end
	end
end

local function CustomWriteQueueMarkForCleanup(store, key)
	if CustomWriteQueue[store] ~= nil then
		if CustomWriteQueue[store][key] ~= nil then

			local queue_data = CustomWriteQueue[store][key]
			local queue = queue_data.Queue

			if queue_data.CleanupJob == nil then

				queue_data.CleanupJob = RunService.Heartbeat:Connect(function()
					if os.clock() - queue_data.LastWrite > SETTINGS.RobloxWriteCooldown and #queue == 0 then
						queue_data.CleanupJob:Disconnect()
						CustomWriteQueueCleanup(store, key)
					end
				end)

			end

		elseif next(CustomWriteQueue[store]) == nil then
			CustomWriteQueue[store] = nil
		end
	end
end

local function CustomWriteQueueAsync(callback, store, key) --> ... -- Passed return from callback

	if CustomWriteQueue[store] == nil then
		CustomWriteQueue[store] = {}
	end
	if CustomWriteQueue[store][key] == nil then
		CustomWriteQueue[store][key] = {LastWrite = 0, Queue = {}, CleanupJob = nil}
	end

	local queue_data = CustomWriteQueue[store][key]
	local queue = queue_data.Queue

	-- Cleanup job:

	if queue_data.CleanupJob ~= nil then
		queue_data.CleanupJob:Disconnect()
		queue_data.CleanupJob = nil
	end

	-- Queue logic:

	if os.clock() - queue_data.LastWrite > SETTINGS.RobloxWriteCooldown and #queue == 0 then
		queue_data.LastWrite = os.clock()
		return callback()
	else
		table.insert(queue, callback)
		while true do
			if os.clock() - queue_data.LastWrite > SETTINGS.RobloxWriteCooldown and queue[1] == callback then
				table.remove(queue, 1)
				queue_data.LastWrite = os.clock()
				return callback()
			end
			task.wait()
		end
	end

end

local function IsCustomWriteQueueEmptyFor(store, key) --> is_empty [bool]
	local lookup = CustomWriteQueue[store]
	if lookup ~= nil then
		lookup = lookup[key]
		return lookup == nil or #lookup.Queue == 0
	end
	return true
end

local function WaitForLiveAccessCheck() -- This function was created to prevent the ProfileService module yielding execution when required
	while IsLiveCheckActive == true do
		task.wait()
	end
end

local function WaitForPendingProfileStore(profile_store)
	while profile_store._is_pending == true do
		task.wait()
	end
end

local function RegisterIssue(error_message, store_name, store_scope, profile_key) -- Called when a DataStore API call errors
	warn("[ProfileService]: DataStore API error " .. IdentifyProfile(store_name, store_scope, profile_key) .. " - \"" .. tostring(error_message) .. "\"")
	table.insert(IssueQueue, os.clock()) -- Adding issue time to queue
	ProfileService.IssueSignal:Fire(tostring(error_message), store_name, profile_key)
end

local function RegisterCorruption(store_name, store_scope, profile_key) -- Called when a corrupted profile is loaded
	warn("[ProfileService]: Resolved profile corruption " .. IdentifyProfile(store_name, store_scope, profile_key))
	ProfileService.CorruptionSignal:Fire(store_name, profile_key)
end

local function NewMockDataStoreKeyInfo(params)

	local version_id_string = tostring(params.VersionId or 0)
	local meta_data = params.MetaData or {}
	local user_ids = params.UserIds or {}

	return {
		CreatedTime = params.CreatedTime,
		UpdatedTime = params.UpdatedTime,
		Version = string.rep("0", 16) .. "."
			.. string.rep("0", 10 - string.len(version_id_string)) .. version_id_string
			.. "." .. string.rep("0", 16) .. "." .. "01",

		GetMetadata = function()
			return DeepCopyTable(meta_data)
		end,

		GetUserIds = function()
			return DeepCopyTable(user_ids)
		end,
	}

end

local function MockUpdateAsync(mock_data_store, profile_store_name, key, transform_function, is_get_call) --> loaded_data, key_info

	local profile_store = mock_data_store[profile_store_name]

	if profile_store == nil then
		profile_store = {}
		mock_data_store[profile_store_name] = profile_store
	end

	local epoch_time = math.floor(os.time() * 1000)
	local mock_entry = profile_store[key]
	local mock_entry_was_nil = false

	if mock_entry == nil then
		mock_entry_was_nil = true
		if is_get_call ~= true then
			mock_entry = {
				Data = nil,
				CreatedTime = epoch_time,
				UpdatedTime = epoch_time,
				VersionId = 0,
				UserIds = {},
				MetaData = {},
			}
			profile_store[key] = mock_entry
		end
	end

	local mock_key_info = mock_entry_was_nil == false and NewMockDataStoreKeyInfo(mock_entry) or nil

	local transform, user_ids, roblox_meta_data = transform_function(mock_entry and mock_entry.Data, mock_key_info)

	if transform == nil then
		return nil
	else
		if mock_entry ~= nil and is_get_call ~= true then
			mock_entry.Data = transform
			mock_entry.UserIds = DeepCopyTable(user_ids or {})
			mock_entry.MetaData = DeepCopyTable(roblox_meta_data or {})
			mock_entry.VersionId += 1
			mock_entry.UpdatedTime = epoch_time
		end

		return DeepCopyTable(transform), mock_entry ~= nil and NewMockDataStoreKeyInfo(mock_entry) or nil
	end

end

local function IsThisSession(session_tag)
	return session_tag[1] == PlaceId and session_tag[2] == JobId
end

--[[
update_settings = {
	ExistingProfileHandle = function(latest_data),
	MissingProfileHandle = function(latest_data),
	EditProfile = function(lastest_data),
}
--]]
local function StandardProfileUpdateAsyncDataStore(profile_store, profile_key, update_settings, is_user_mock, is_get_call, version) --> loaded_data, key_info
	local loaded_data, key_info
	local success, error_message = pcall(function()
		local transform_function = function(latest_data)

			local missing_profile = false
			local data_corrupted = false
			local global_updates_data = {0, {}}

			if latest_data == nil then
				missing_profile = true
			elseif type(latest_data) ~= "table" then
				missing_profile = true
				data_corrupted = true
			end

			if type(latest_data) == "table" then
				-- Case #1: Profile was loaded
				if type(latest_data.Data) == "table"
					and type(latest_data.MetaData) == "table"
					and type(latest_data.GlobalUpdates) == "table" then

					latest_data.WasCorrupted = false -- Must be set to false if set previously
					global_updates_data = latest_data.GlobalUpdates
					if update_settings.ExistingProfileHandle ~= nil then
						update_settings.ExistingProfileHandle(latest_data)
					end
					-- Case #2: Profile was not loaded but GlobalUpdate data exists
				elseif latest_data.Data == nil
					and latest_data.MetaData == nil
					and type(latest_data.GlobalUpdates) == "table" then

					latest_data.WasCorrupted = false -- Must be set to false if set previously
					global_updates_data = latest_data.GlobalUpdates or global_updates_data
					missing_profile = true
				else
					missing_profile = true
					data_corrupted = true
				end
			end

			-- Case #3: Profile was not created or corrupted and no GlobalUpdate data exists
			if missing_profile == true then
				latest_data = {
					-- Data = nil,
					-- MetaData = nil,
					GlobalUpdates = global_updates_data,
				}
				if update_settings.MissingProfileHandle ~= nil then
					update_settings.MissingProfileHandle(latest_data)
				end
			end

			-- Editing profile:
			if update_settings.EditProfile ~= nil then
				update_settings.EditProfile(latest_data)
			end

			-- Data corruption handling (Silently override with empty profile) (Also run Case #1)
			if data_corrupted == true then
				latest_data.WasCorrupted = true -- Temporary tag that will be removed on first save
			end

			return latest_data, latest_data.UserIds, latest_data.RobloxMetaData
		end
		if is_user_mock == true then -- Used when the profile is accessed through ProfileStore.Mock
			loaded_data, key_info = MockUpdateAsync(UserMockDataStore, profile_store._profile_store_lookup, profile_key, transform_function, is_get_call)
			task.wait() -- Simulate API call yield
		elseif UseMockDataStore == true then -- Used when API access is disabled
			loaded_data, key_info = MockUpdateAsync(MockDataStore, profile_store._profile_store_lookup, profile_key, transform_function, is_get_call)
			task.wait() -- Simulate API call yield
		else
			loaded_data, key_info = CustomWriteQueueAsync(
				function() -- Callback
					if is_get_call == true then
						local get_data, get_key_info
						if version ~= nil then
							local success, error_message = pcall(function()
								get_data, get_key_info = profile_store._global_data_store:GetVersionAsync(profile_key, version)
							end)
							if success == false and type(error_message) == "string" and string.find(error_message, "not valid") ~= nil then
								warn("[ProfileService]: Passed version argument is not valid; Traceback:\n" .. debug.traceback())
							end
						else
							get_data, get_key_info = profile_store._global_data_store:GetAsync(profile_key)
						end
						get_data = transform_function(get_data)
						return get_data, get_key_info
					else
						return profile_store._global_data_store:UpdateAsync(profile_key, transform_function)
					end
				end,
				profile_store._profile_store_lookup, -- Store
				profile_key -- Key
			)
		end
	end)
	if success == true and type(loaded_data) == "table" then
		-- Corruption handling:
		if loaded_data.WasCorrupted == true and is_get_call ~= true then
			RegisterCorruption(
				profile_store._profile_store_name,
				profile_store._profile_store_scope,
				profile_key
			)
		end
		-- Return loaded_data:
		return loaded_data, key_info
	else
		RegisterIssue(
			(error_message ~= nil) and error_message or "Undefined error",
			profile_store._profile_store_name,
			profile_store._profile_store_scope,
			profile_key
		)
		-- Return nothing:
		return nil
	end
end

local function RemoveProfileFromAutoSave(profile)
	local auto_save_index = table.find(AutoSaveList, profile)
	if auto_save_index ~= nil then
		table.remove(AutoSaveList, auto_save_index)
		if auto_save_index < AutoSaveIndex then
			AutoSaveIndex = AutoSaveIndex - 1 -- Table contents were moved left before AutoSaveIndex so move AutoSaveIndex left as well
		end
		if AutoSaveList[AutoSaveIndex] == nil then -- AutoSaveIndex was at the end of the AutoSaveList - reset to 1
			AutoSaveIndex = 1
		end
	end
end

local function AddProfileToAutoSave(profile) -- Notice: Makes sure this profile isn't auto-saved too soon
	-- Add at AutoSaveIndex and move AutoSaveIndex right:
	table.insert(AutoSaveList, AutoSaveIndex, profile)
	if #AutoSaveList > 1 then
		AutoSaveIndex = AutoSaveIndex + 1
	elseif #AutoSaveList == 1 then
		-- First profile created - make sure it doesn't get immediately auto saved:
		LastAutoSave = os.clock()
	end
end

local function ReleaseProfileInternally(profile)
	-- 1) Remove profile object from ProfileService references: --
	-- Clear reference in ProfileStore:
	local profile_store = profile._profile_store
	local loaded_profiles = profile._is_user_mock == true and profile_store._mock_loaded_profiles or profile_store._loaded_profiles
	loaded_profiles[profile._profile_key] = nil
	if next(profile_store._loaded_profiles) == nil and next(profile_store._mock_loaded_profiles) == nil then -- ProfileStore has turned inactive
		local index = table.find(ActiveProfileStores, profile_store)
		if index ~= nil then
			table.remove(ActiveProfileStores, index)
		end
	end
	-- Clear auto update reference:
	RemoveProfileFromAutoSave(profile)
	-- 2) Trigger release listeners: --
	local place_id
	local game_job_id
	local active_session = profile.MetaData.ActiveSession
	if active_session ~= nil then
		place_id = active_session[1]
		game_job_id = active_session[2]
	end
	profile._release_listeners:Fire(place_id, game_job_id)
end

local function CheckForNewGlobalUpdates(profile, old_global_updates_data, new_global_updates_data)
	local global_updates_object = profile.GlobalUpdates -- [GlobalUpdates]
	local pending_update_lock = global_updates_object._pending_update_lock -- {update_id, ...}
	local pending_update_clear = global_updates_object._pending_update_clear -- {update_id, ...}
	-- "old_" or "new_" global_updates_data = {update_index, {{update_id, version_id, update_locked, update_data}, ...}}
	for _, new_global_update in ipairs(new_global_updates_data[2]) do
		-- Find old global update with the same update_id:
		local old_global_update
		for _, global_update in ipairs(old_global_updates_data[2]) do
			if global_update[1] == new_global_update[1] then
				old_global_update = global_update
				break
			end
		end
		-- A global update is new when it didn't exist before or its version_id or update_locked state changed:
		local is_new = false
		if old_global_update == nil or new_global_update[2] > old_global_update[2] or new_global_update[3] ~= old_global_update[3] then
			is_new = true
		end
		if is_new == true then
			-- Active global updates:
			if new_global_update[3] == false then
				-- Check if update is not pending to be locked: (Preventing firing new active update listeners more than necessary)
				local is_pending_lock = false
				for _, update_id in ipairs(pending_update_lock) do
					if new_global_update[1] == update_id then
						is_pending_lock = true
						break
					end
				end
				if is_pending_lock == false then
					-- Trigger new active update listeners:
					global_updates_object._new_active_update_listeners:Fire(new_global_update[1], new_global_update[4])
				end
			end
			-- Locked global updates:
			if new_global_update[3] == true then
				-- Check if update is not pending to be cleared: (Preventing firing new locked update listeners after marking a locked update for clearing)
				local is_pending_clear = false
				for _, update_id in ipairs(pending_update_clear) do
					if new_global_update[1] == update_id then
						is_pending_clear = true
						break
					end
				end
				if is_pending_clear == false then
					-- Trigger new locked update listeners:

					global_updates_object._new_locked_update_listeners:FireUntil(
						function()
							-- Check if listener marked the update to be cleared:
							-- Normally there should be only one listener per profile for new locked global updates, but
							-- in case several listeners are connected we will not trigger more listeners after one listener
							-- marks the locked global update to be cleared.
							return table.find(pending_update_clear, new_global_update[1]) == nil
						end,
						new_global_update[1], new_global_update[4]
					)

				end
			end
		end
	end
end

local function SaveProfileAsync(profile, release_from_session, is_overwriting)
	if type(profile.Data) ~= "table" then
		RegisterCorruption(
			profile._profile_store._profile_store_name,
			profile._profile_store._profile_store_scope,
			profile._profile_key
		)
		error("[ProfileService]: PROFILE DATA CORRUPTED DURING RUNTIME! Profile: " .. profile:Identify())
	end
	if release_from_session == true and is_overwriting ~= true then
		ReleaseProfileInternally(profile)
	end
	ActiveProfileSaveJobs = ActiveProfileSaveJobs + 1
	local last_session_load_count = profile.MetaData.SessionLoadCount
	-- Compare "SessionLoadCount" when writing to profile to prevent a rare case of repeat last save when the profile is loaded on the same server again
	local repeat_save_flag = true -- Released Profile save calls have to repeat until they succeed
	while repeat_save_flag == true do
		if release_from_session ~= true then
			repeat_save_flag = false
		end
		local loaded_data, key_info = StandardProfileUpdateAsyncDataStore(
			profile._profile_store,
			profile._profile_key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = nil,
				EditProfile = function(latest_data)

					local session_owns_profile = false
					local force_load_pending = false

					if is_overwriting ~= true then
						-- 1) Check if this session still owns the profile: --
						local active_session = latest_data.MetaData.ActiveSession
						local force_load_session = latest_data.MetaData.ForceLoadSession
						local session_load_count = latest_data.MetaData.SessionLoadCount

						if type(active_session) == "table" then
							session_owns_profile = IsThisSession(active_session) and session_load_count == last_session_load_count
						end
						if type(force_load_session) == "table" then
							force_load_pending = not IsThisSession(force_load_session)
						end
					else
						session_owns_profile = true
					end

					if session_owns_profile == true then -- We may only edit the profile if this session has ownership of the profile

						if is_overwriting ~= true then
							-- 2) Manage global updates: --
							local latest_global_updates_data = latest_data.GlobalUpdates -- {update_index, {{update_id, version_id, update_locked, update_data}, ...}}
							local latest_global_updates_list = latest_global_updates_data[2]

							local global_updates_object = profile.GlobalUpdates -- [GlobalUpdates]
							local pending_update_lock = global_updates_object._pending_update_lock -- {update_id, ...}
							local pending_update_clear = global_updates_object._pending_update_clear -- {update_id, ...}
							-- Active update locking:
							for i = 1, #latest_global_updates_list do
								for _, lock_id in ipairs(pending_update_lock) do
									if latest_global_updates_list[i][1] == lock_id then
										latest_global_updates_list[i][3] = true
										break
									end
								end
							end
							-- Locked update clearing:
							for _, clear_id in ipairs(pending_update_clear) do
								for i = 1, #latest_global_updates_list do
									if latest_global_updates_list[i][1] == clear_id and latest_global_updates_list[i][3] == true then
										table.remove(latest_global_updates_list, i)
										break
									end
								end
							end
						end

						-- 3) Save profile data: --
						latest_data.Data = profile.Data
						latest_data.RobloxMetaData = profile.RobloxMetaData
						latest_data.UserIds = profile.UserIds

						if is_overwriting ~= true then
							latest_data.MetaData.MetaTags = profile.MetaData.MetaTags -- MetaData.MetaTags is the only actively savable component of MetaData
							latest_data.MetaData.LastUpdate = os.time()
							if release_from_session == true or force_load_pending == true then
								latest_data.MetaData.ActiveSession = nil
							end
						else
							latest_data.MetaData = profile.MetaData
							latest_data.MetaData.ActiveSession = nil
							latest_data.MetaData.ForceLoadSession = nil
							latest_data.GlobalUpdates = profile.GlobalUpdates._updates_latest
						end

					end
				end,
			},
			profile._is_user_mock
		)
		if loaded_data ~= nil and key_info ~= nil then
			if is_overwriting == true then
				break
			end
			repeat_save_flag = false
			-- 4) Set latest data in profile: --
			-- Updating DataStoreKeyInfo:
			profile.KeyInfo = key_info
			-- Setting global updates:
			local global_updates_object = profile.GlobalUpdates -- [GlobalUpdates]
			local old_global_updates_data = global_updates_object._updates_latest
			local new_global_updates_data = loaded_data.GlobalUpdates
			global_updates_object._updates_latest = new_global_updates_data
			-- Setting MetaData:
			local session_meta_data = profile.MetaData
			local latest_meta_data = loaded_data.MetaData
			for key in pairs(SETTINGS.MetaTagsUpdatedValues) do
				session_meta_data[key] = latest_meta_data[key]
			end
			session_meta_data.MetaTagsLatest = latest_meta_data.MetaTags
			-- 5) Check if session still owns the profile: --
			local active_session = loaded_data.MetaData.ActiveSession
			local session_load_count = loaded_data.MetaData.SessionLoadCount
			local session_owns_profile = false
			if type(active_session) == "table" then
				session_owns_profile = IsThisSession(active_session) and session_load_count == last_session_load_count
			end
			local is_active = profile:IsActive()
			if session_owns_profile == true then
				-- 6) Check for new global updates: --
				if is_active == true then -- Profile could've been released before the saving thread finished
					CheckForNewGlobalUpdates(profile, old_global_updates_data, new_global_updates_data)
				end
			else
				-- Session no longer owns the profile:
				-- 7) Release profile if it hasn't been released yet: --
				if is_active == true then
					ReleaseProfileInternally(profile)
				end
				-- Cleanup reference in custom write queue:
				CustomWriteQueueMarkForCleanup(profile._profile_store._profile_store_lookup, profile._profile_key)
				-- Hop ready listeners:
				if profile._hop_ready == false then
					profile._hop_ready = true
					profile._hop_ready_listeners:Fire()
				end
			end
			-- Signaling MetaTagsUpdated listeners after a possible external profile release was handled:
			profile.MetaTagsUpdated:Fire(profile.MetaData.MetaTagsLatest)
			-- Signaling KeyInfoUpdated listeners:
			profile.KeyInfoUpdated:Fire(key_info)
		elseif repeat_save_flag == true then
			task.wait() -- Prevent infinite loop in case DataStore API does not yield
		end
	end
	ActiveProfileSaveJobs = ActiveProfileSaveJobs - 1
end

----- Public functions -----

-- GlobalUpdates object:

local GlobalUpdates = {
	--[[
		_updates_latest = {}, -- [table] {update_index, {{update_id, version_id, update_locked, update_data}, ...}}
		_pending_update_lock = {update_id, ...} / nil, -- [table / nil]
		_pending_update_clear = {update_id, ...} / nil, -- [table / nil]
		
		_new_active_update_listeners = [ScriptSignal] / nil, -- [table / nil]
		_new_locked_update_listeners = [ScriptSignal] / nil, -- [table / nil]
		
		_profile = Profile / nil, -- [Profile / nil]
		
		_update_handler_mode = true / nil, -- [bool / nil]
	--]]
}
GlobalUpdates.__index = GlobalUpdates

-- ALWAYS PUBLIC:
function GlobalUpdates:GetActiveUpdates() --> [table] {{update_id, update_data}, ...}
	local query_list = {}
	for _, global_update in ipairs(self._updates_latest[2]) do
		if global_update[3] == false then
			local is_pending_lock = false
			if self._pending_update_lock ~= nil then
				for _, update_id in ipairs(self._pending_update_lock) do
					if global_update[1] == update_id then
						is_pending_lock = true -- Exclude global updates pending to be locked
						break
					end
				end
			end
			if is_pending_lock == false then
				table.insert(query_list, {global_update[1], global_update[4]})
			end
		end
	end
	return query_list
end

function GlobalUpdates:GetLockedUpdates() --> [table] {{update_id, update_data}, ...}
	local query_list = {}
	for _, global_update in ipairs(self._updates_latest[2]) do
		if global_update[3] == true then
			local is_pending_clear = false
			if self._pending_update_clear ~= nil then
				for _, update_id in ipairs(self._pending_update_clear) do
					if global_update[1] == update_id then
						is_pending_clear = true -- Exclude global updates pending to be cleared
						break
					end
				end
			end
			if is_pending_clear == false then
				table.insert(query_list, {global_update[1], global_update[4]})
			end
		end
	end
	return query_list
end

-- ONLY WHEN FROM "Profile.GlobalUpdates":
function GlobalUpdates:ListenToNewActiveUpdate(listener) --> [ScriptConnection] listener(update_id, update_data)
	if type(listener) ~= "function" then
		error("[ProfileService]: Only a function can be set as listener in GlobalUpdates:ListenToNewActiveUpdate()")
	end
	local profile = self._profile
	if self._update_handler_mode == true then
		error("[ProfileService]: Can't listen to new global updates in ProfileStore:GlobalUpdateProfileAsync()")
	elseif self._new_active_update_listeners == nil then
		error("[ProfileService]: Can't listen to new global updates in view mode")
	elseif profile:IsActive() == false then -- Check if profile is expired
		return { -- Do not connect listener if the profile is expired
			Disconnect = function() end,
		}
	end
	-- Connect listener:
	return self._new_active_update_listeners:Connect(listener)
end

function GlobalUpdates:ListenToNewLockedUpdate(listener) --> [ScriptConnection] listener(update_id, update_data)
	if type(listener) ~= "function" then
		error("[ProfileService]: Only a function can be set as listener in GlobalUpdates:ListenToNewLockedUpdate()")
	end
	local profile = self._profile
	if self._update_handler_mode == true then
		error("[ProfileService]: Can't listen to new global updates in ProfileStore:GlobalUpdateProfileAsync()")
	elseif self._new_locked_update_listeners == nil then
		error("[ProfileService]: Can't listen to new global updates in view mode")
	elseif profile:IsActive() == false then -- Check if profile is expired
		return { -- Do not connect listener if the profile is expired
			Disconnect = function() end,
		}
	end
	-- Connect listener:
	return self._new_locked_update_listeners:Connect(listener)
end

function GlobalUpdates:LockActiveUpdate(update_id)
	if type(update_id) ~= "number" then
		error("[ProfileService]: Invalid update_id")
	end
	local profile = self._profile
	if self._update_handler_mode == true then
		error("[ProfileService]: Can't lock active global updates in ProfileStore:GlobalUpdateProfileAsync()")
	elseif self._pending_update_lock == nil then
		error("[ProfileService]: Can't lock active global updates in view mode")
	elseif profile:IsActive() == false then -- Check if profile is expired
		error("[ProfileService]: PROFILE EXPIRED - Can't lock active global updates")
	end
	-- Check if global update exists with given update_id
	local global_update_exists = nil
	for _, global_update in ipairs(self._updates_latest[2]) do
		if global_update[1] == update_id then
			global_update_exists = global_update
			break
		end
	end
	if global_update_exists ~= nil then
		local is_pending_lock = false
		for _, lock_update_id in ipairs(self._pending_update_lock) do
			if update_id == lock_update_id then
				is_pending_lock = true -- Exclude global updates pending to be locked
				break
			end
		end
		if is_pending_lock == false and global_update_exists[3] == false then -- Avoid id duplicates in _pending_update_lock
			table.insert(self._pending_update_lock, update_id)
		end
	else
		error("[ProfileService]: Passed non-existant update_id")
	end
end

function GlobalUpdates:ClearLockedUpdate(update_id)
	if type(update_id) ~= "number" then
		error("[ProfileService]: Invalid update_id")
	end
	local profile = self._profile
	if self._update_handler_mode == true then
		error("[ProfileService]: Can't clear locked global updates in ProfileStore:GlobalUpdateProfileAsync()")
	elseif self._pending_update_clear == nil then
		error("[ProfileService]: Can't clear locked global updates in view mode")
	elseif profile:IsActive() == false then -- Check if profile is expired
		error("[ProfileService]: PROFILE EXPIRED - Can't clear locked global updates")
	end
	-- Check if global update exists with given update_id
	local global_update_exists = nil
	for _, global_update in ipairs(self._updates_latest[2]) do
		if global_update[1] == update_id then
			global_update_exists = global_update
			break
		end
	end
	if global_update_exists ~= nil then
		local is_pending_clear = false
		for _, clear_update_id in ipairs(self._pending_update_clear) do
			if update_id == clear_update_id then
				is_pending_clear = true -- Exclude global updates pending to be cleared
				break
			end
		end
		if is_pending_clear == false and global_update_exists[3] == true then -- Avoid id duplicates in _pending_update_clear
			table.insert(self._pending_update_clear, update_id)
		end
	else
		error("[ProfileService]: Passed non-existant update_id")
	end
end

-- EXPOSED TO "update_handler" DURING ProfileStore:GlobalUpdateProfileAsync() CALL
function GlobalUpdates:AddActiveUpdate(update_data)
	if type(update_data) ~= "table" then
		error("[ProfileService]: Invalid update_data")
	end
	if self._new_active_update_listeners ~= nil then
		error("[ProfileService]: Can't add active global updates in loaded Profile; Use ProfileStore:GlobalUpdateProfileAsync()")
	elseif self._update_handler_mode ~= true then
		error("[ProfileService]: Can't add active global updates in view mode; Use ProfileStore:GlobalUpdateProfileAsync()")
	end
	-- self._updates_latest = {}, -- [table] {update_index, {{update_id, version_id, update_locked, update_data}, ...}}
	local updates_latest = self._updates_latest
	local update_index = updates_latest[1] + 1 -- Incrementing global update index
	updates_latest[1] = update_index
	-- Add new active global update:
	table.insert(updates_latest[2], {update_index, 1, false, update_data})
end

function GlobalUpdates:ChangeActiveUpdate(update_id, update_data)
	if type(update_id) ~= "number" then
		error("[ProfileService]: Invalid update_id")
	end
	if type(update_data) ~= "table" then
		error("[ProfileService]: Invalid update_data")
	end
	if self._new_active_update_listeners ~= nil then
		error("[ProfileService]: Can't change active global updates in loaded Profile; Use ProfileStore:GlobalUpdateProfileAsync()")
	elseif self._update_handler_mode ~= true then
		error("[ProfileService]: Can't change active global updates in view mode; Use ProfileStore:GlobalUpdateProfileAsync()")
	end
	-- self._updates_latest = {}, -- [table] {update_index, {{update_id, version_id, update_locked, update_data}, ...}}
	local updates_latest = self._updates_latest
	local get_global_update = nil
	for _, global_update in ipairs(updates_latest[2]) do
		if update_id == global_update[1] then
			get_global_update = global_update
			break
		end
	end
	if get_global_update ~= nil then
		if get_global_update[3] == true then
			error("[ProfileService]: Can't change locked global update")
		end
		get_global_update[2] = get_global_update[2] + 1 -- Increment version id
		get_global_update[4] = update_data -- Set new global update data
	else
		error("[ProfileService]: Passed non-existant update_id")
	end
end

function GlobalUpdates:ClearActiveUpdate(update_id)
	if type(update_id) ~= "number" then
		error("[ProfileService]: Invalid update_id argument")
	end
	if self._new_active_update_listeners ~= nil then
		error("[ProfileService]: Can't clear active global updates in loaded Profile; Use ProfileStore:GlobalUpdateProfileAsync()")
	elseif self._update_handler_mode ~= true then
		error("[ProfileService]: Can't clear active global updates in view mode; Use ProfileStore:GlobalUpdateProfileAsync()")
	end
	-- self._updates_latest = {}, -- [table] {update_index, {{update_id, version_id, update_locked, update_data}, ...}}
	local updates_latest = self._updates_latest
	local get_global_update_index = nil
	local get_global_update = nil
	for index, global_update in ipairs(updates_latest[2]) do
		if update_id == global_update[1] then
			get_global_update_index = index
			get_global_update = global_update
			break
		end
	end
	if get_global_update ~= nil then
		if get_global_update[3] == true then
			error("[ProfileService]: Can't clear locked global update")
		end
		table.remove(updates_latest[2], get_global_update_index) -- Remove active global update
	else
		error("[ProfileService]: Passed non-existant update_id")
	end
end

-- Profile object:

local Profile = {
	--[[
		Data = {}, -- [table] -- Loaded once after ProfileStore:LoadProfileAsync() finishes
		MetaData = {}, -- [table] -- Updated with every auto-save
		GlobalUpdates = GlobalUpdates, -- [GlobalUpdates]
		
		_profile_store = ProfileStore, -- [ProfileStore]
		_profile_key = "", -- [string]
		
		_release_listeners = [ScriptSignal] / nil, -- [table / nil]
		_hop_ready_listeners = [ScriptSignal] / nil, -- [table / nil]
		_hop_ready = false,
		
		_view_mode = true / nil, -- [bool] or nil
		
		_load_timestamp = os.clock(),
		
		_is_user_mock = false, -- ProfileStore.Mock
		_mock_key_info = {},
	--]]
}
Profile.__index = Profile

function Profile:IsActive() --> [bool]
	local loaded_profiles = self._is_user_mock == true and self._profile_store._mock_loaded_profiles or self._profile_store._loaded_profiles
	return loaded_profiles[self._profile_key] == self
end

function Profile:GetMetaTag(tag_name) --> value
	local meta_data = self.MetaData
	if meta_data == nil then
		return nil
		-- error("[ProfileService]: This Profile hasn't been loaded before - MetaData not available")
	end
	return self.MetaData.MetaTags[tag_name]
end

function Profile:SetMetaTag(tag_name, value)
	if type(tag_name) ~= "string" then
		error("[ProfileService]: tag_name must be a string")
	elseif string.len(tag_name) == 0 then
		error("[ProfileService]: Invalid tag_name")
	end
	self.MetaData.MetaTags[tag_name] = value
end

function Profile:Reconcile()
	ReconcileTable(self.Data, self._profile_store._profile_template)
end

function Profile:ListenToRelease(listener) --> [ScriptConnection] (place_id / nil, game_job_id / nil)
	if type(listener) ~= "function" then
		error("[ProfileService]: Only a function can be set as listener in Profile:ListenToRelease()")
	end
	if self._view_mode == true then
		return {Disconnect = function() end}
	end
	if self:IsActive() == false then
		-- Call release listener immediately if profile is expired
		local place_id
		local game_job_id
		local active_session = self.MetaData.ActiveSession
		if active_session ~= nil then
			place_id = active_session[1]
			game_job_id = active_session[2]
		end
		listener(place_id, game_job_id)
		return {Disconnect = function() end}
	else
		return self._release_listeners:Connect(listener)
	end
end

function Profile:Save()
	if self._view_mode == true then
		error("[ProfileService]: Can't save Profile in view mode - Should you be calling :OverwriteAsync() instead?")
	end
	if self:IsActive() == false then
		warn("[ProfileService]: Attempted saving an inactive profile "
			.. self:Identify() .. "; Traceback:\n" .. debug.traceback())
		return
	end
	-- Reject save request if a save is already pending in the queue - this will prevent the user from
	--	unecessary API request spam which we could not meaningfully execute anyways!
	if IsCustomWriteQueueEmptyFor(self._profile_store._profile_store_lookup, self._profile_key) == true then
		-- We don't want auto save to trigger too soon after manual saving - this will reset the auto save timer:
		RemoveProfileFromAutoSave(self)
		AddProfileToAutoSave(self)
		-- Call save function in a new thread:
		task.spawn(SaveProfileAsync, self)
	end
end

function Profile:Release()
	if self._view_mode == true then
		return
	end
	if self:IsActive() == true then
		task.spawn(SaveProfileAsync, self, true) -- Call save function in a new thread with release_from_session = true
	end
end

function Profile:ListenToHopReady(listener) --> [ScriptConnection] ()
	if type(listener) ~= "function" then
		error("[ProfileService]: Only a function can be set as listener in Profile:ListenToHopReady()")
	end
	if self._view_mode == true then
		return {Disconnect = function() end}
	end
	if self._hop_ready == true then
		task.spawn(listener)
		return {Disconnect = function() end}
	else
		return self._hop_ready_listeners:Connect(listener)
	end
end

function Profile:AddUserId(user_id) -- Associates user_id with profile (GDPR compliance)

	if type(user_id) ~= "number" or user_id % 1 ~= 0 then
		warn("[ProfileService]: Invalid UserId argument for :AddUserId() ("
			.. tostring(user_id) .. "); Traceback:\n" .. debug.traceback())
		return
	end

	if user_id < 0 and self._is_user_mock ~= true and UseMockDataStore ~= true then
		return -- Avoid giving real Roblox APIs negative UserId's
	end

	if table.find(self.UserIds, user_id) == nil then
		table.insert(self.UserIds, user_id)
	end
	
end

function Profile:RemoveUserId(user_id) -- Unassociates user_id with profile (safe function)

	if type(user_id) ~= "number" or user_id % 1 ~= 0 then
		warn("[ProfileService]: Invalid UserId argument for :RemoveUserId() ("
			.. tostring(user_id) .. "); Traceback:\n" .. debug.traceback())
		return
	end
	
	local index = table.find(self.UserIds, user_id)

	if index ~= nil then
		table.remove(self.UserIds, index)
	end

end

function Profile:Identify() --> [string]
	return IdentifyProfile(
		self._profile_store._profile_store_name,
		self._profile_store._profile_store_scope,
		self._profile_key
	)
end

function Profile:ClearGlobalUpdates() -- Clears all global updates data from a profile payload

	if self._view_mode ~= true then
		error("[ProfileService]: :ClearGlobalUpdates() can only be used in view mode")
	end

	local global_updates_object = {
		_updates_latest = {0, {}},
		_profile = self,
	}
	setmetatable(global_updates_object, GlobalUpdates)

	self.GlobalUpdates = global_updates_object

end

function Profile:OverwriteAsync() -- Saves the profile to the DataStore and removes the session lock

	if self._view_mode ~= true then
		error("[ProfileService]: :OverwriteAsync() can only be used in view mode")
	end

	SaveProfileAsync(self, nil, true)

end

-- ProfileVersionQuery object:

local ProfileVersionQuery = {
	--[[
		_profile_store = profile_store,
		_profile_key = profile_key,
		_sort_direction = sort_direction,
		_min_date = min_date,
		_max_date = max_date,

		_query_pages = pages, -- [DataStoreVersionPages]
		_query_index = index, -- [number]
		_query_failure = false,

		_is_query_yielded = false,
		_query_queue = {},
	--]]
}
ProfileVersionQuery.__index = ProfileVersionQuery

function ProfileVersionQuery:_MoveQueue()
	while #self._query_queue > 0 do
		local queue_entry = table.remove(self._query_queue, 1)
		task.spawn(queue_entry)
		if self._is_query_yielded == true then
			break
		end
	end
end

function ProfileVersionQuery:NextAsync(_is_stacking) --> [Profile] or nil

	if self._profile_store == nil then
		return nil
	end

	local profile
	local is_finished = false

	local function query_job()

		if self._query_failure == true then
			is_finished = true
			return
		end

		-- First "next" call loads version pages:

		if self._query_pages == nil then

			self._is_query_yielded = true
			task.spawn(function()
				profile = self:NextAsync(true)
				is_finished = true
			end)
			
			local list_success, error_message = pcall(function()
				self._query_pages = self._profile_store._global_data_store:ListVersionsAsync(
					self._profile_key,
					self._sort_direction,
					self._min_date,
					self._max_date
				)
				self._query_index = 0
			end)

			if list_success == false or self._query_pages == nil then
				warn("[ProfileService]: Version query fail - " .. tostring(error_message))
				self._query_failure = true
			end

			self._is_query_yielded = false
			self:_MoveQueue()

			return

		end

		local current_page = self._query_pages:GetCurrentPage()
		local next_item = current_page[self._query_index + 1]

		-- No more entries:
		
		if self._query_pages.IsFinished == true and next_item == nil then
			is_finished = true
			return
		end

		-- Load next page when this page is over:

		if next_item == nil then

			self._is_query_yielded = true
			task.spawn(function()
				profile = self:NextAsync(true)
				is_finished = true
			end)

			local success = pcall(function()
				self._query_pages:AdvanceToNextPageAsync()
				self._query_index = 0
			end)

			if success == false or #self._query_pages:GetCurrentPage() == 0 then
				self._query_failure = true
			end

			self._is_query_yielded = false
			self:_MoveQueue()

			return

		end

		-- Next page item:

		self._query_index += 1
		profile = self._profile_store:ViewProfileAsync(self._profile_key, next_item.Version)
		is_finished = true

	end

	if self._is_query_yielded == false then
		query_job()
	else
		if _is_stacking == true then
			table.insert(self._query_queue, 1, query_job)
		else
			table.insert(self._query_queue, query_job)
		end
	end

	while is_finished == false do
		task.wait()
	end

	return profile

end

-- ProfileStore object:

local ProfileStore = {
	--[[
		Mock = {},
	
		_profile_store_name = "", -- [string] -- DataStore name
		_profile_store_scope = nil, -- [string] or [nil] -- DataStore scope
		_profile_store_lookup = "", -- [string] -- _profile_store_name .. "\0" .. (_profile_store_scope or "")
		
		_profile_template = {}, -- [table]
		_global_data_store = global_data_store, -- [GlobalDataStore] -- Object returned by DataStoreService:GetDataStore(_profile_store_name)
		
		_loaded_profiles = {[profile_key] = Profile, ...},
		_profile_load_jobs = {[profile_key] = {load_id, loaded_data}, ...},
		
		_mock_loaded_profiles = {[profile_key] = Profile, ...},
		_mock_profile_load_jobs = {[profile_key] = {load_id, loaded_data}, ...},
	--]]
}
ProfileStore.__index = ProfileStore

function ProfileStore:LoadProfileAsync(profile_key, not_released_handler, _use_mock) --> [Profile / nil] not_released_handler(place_id, game_job_id)

	not_released_handler = not_released_handler or "ForceLoad"

	if self._profile_template == nil then
		error("[ProfileService]: Profile template not set - ProfileStore:LoadProfileAsync() locked for this ProfileStore")
	end
	if type(profile_key) ~= "string" then
		error("[ProfileService]: profile_key must be a string")
	elseif string.len(profile_key) == 0 then
		error("[ProfileService]: Invalid profile_key")
	end
	if type(not_released_handler) ~= "function" and not_released_handler ~= "ForceLoad" and not_released_handler ~= "Steal" then
		error("[ProfileService]: Invalid not_released_handler")
	end

	if ProfileService.ServiceLocked == true then
		return nil
	end

	WaitForPendingProfileStore(self)

	local is_user_mock = _use_mock == UseMockTag

	-- Check if profile with profile_key isn't already loaded in this session:
	for _, profile_store in ipairs(ActiveProfileStores) do
		if profile_store._profile_store_lookup == self._profile_store_lookup then
			local loaded_profiles = is_user_mock == true and profile_store._mock_loaded_profiles or profile_store._loaded_profiles
			if loaded_profiles[profile_key] ~= nil then
				error("[ProfileService]: Profile " .. IdentifyProfile(self._profile_store_name, self._profile_store_scope, profile_key) .. " is already loaded in this session")
				-- Are you using Profile:Release() properly?
			end
		end
	end

	ActiveProfileLoadJobs = ActiveProfileLoadJobs + 1
	local force_load = not_released_handler == "ForceLoad"
	local force_load_steps = 0
	local request_force_load = force_load -- First step of ForceLoad
	local steal_session = false -- Second step of ForceLoad
	local aggressive_steal = not_released_handler == "Steal" -- Developer invoked steal
	while ProfileService.ServiceLocked == false do
		-- Load profile:
		-- SPECIAL CASE - If LoadProfileAsync is called for the same key before another LoadProfileAsync finishes,
		-- yoink the DataStore return for the new call. The older call will return nil. This would prevent very rare
		-- game breaking errors where a player rejoins the server super fast.
		local profile_load_jobs = is_user_mock == true and self._mock_profile_load_jobs or self._profile_load_jobs
		local loaded_data, key_info
		local load_id = LoadIndex + 1
		LoadIndex = load_id
		local profile_load_job = profile_load_jobs[profile_key] -- {load_id, {loaded_data, key_info} or nil}
		if profile_load_job ~= nil then
			profile_load_job[1] = load_id -- Yoink load job
			while profile_load_job[2] == nil do -- Wait for job to finish
				task.wait()
			end
			if profile_load_job[1] == load_id then -- Load job hasn't been double-yoinked
				loaded_data, key_info = table.unpack(profile_load_job[2])
				profile_load_jobs[profile_key] = nil
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil
			end
		else
			profile_load_job = {load_id, nil}
			profile_load_jobs[profile_key] = profile_load_job
			profile_load_job[2] = table.pack(StandardProfileUpdateAsyncDataStore(
				self,
				profile_key,
				{
					ExistingProfileHandle = function(latest_data)
						if ProfileService.ServiceLocked == false then
							local active_session = latest_data.MetaData.ActiveSession
							local force_load_session = latest_data.MetaData.ForceLoadSession
							-- IsThisSession(active_session)
							if active_session == nil then
								latest_data.MetaData.ActiveSession = {PlaceId, JobId}
								latest_data.MetaData.ForceLoadSession = nil
							elseif type(active_session) == "table" then
								if IsThisSession(active_session) == false then
									local last_update = latest_data.MetaData.LastUpdate
									if last_update ~= nil then
										if os.time() - last_update > SETTINGS.AssumeDeadSessionLock then
											latest_data.MetaData.ActiveSession = {PlaceId, JobId}
											latest_data.MetaData.ForceLoadSession = nil
											return
										end
									end
									if steal_session == true or aggressive_steal == true then
										local force_load_uninterrupted = false
										if force_load_session ~= nil then
											force_load_uninterrupted = IsThisSession(force_load_session)
										end
										if force_load_uninterrupted == true or aggressive_steal == true then
											latest_data.MetaData.ActiveSession = {PlaceId, JobId}
											latest_data.MetaData.ForceLoadSession = nil
										end
									elseif request_force_load == true then
										latest_data.MetaData.ForceLoadSession = {PlaceId, JobId}
									end
								else
									latest_data.MetaData.ForceLoadSession = nil
								end
							end
						end
					end,
					MissingProfileHandle = function(latest_data)
						latest_data.Data = DeepCopyTable(self._profile_template)
						latest_data.MetaData = {
							ProfileCreateTime = os.time(),
							SessionLoadCount = 0,
							ActiveSession = {PlaceId, JobId},
							ForceLoadSession = nil,
							MetaTags = {},
						}
					end,
					EditProfile = function(latest_data)
						if ProfileService.ServiceLocked == false then
							local active_session = latest_data.MetaData.ActiveSession
							if active_session ~= nil and IsThisSession(active_session) == true then
								latest_data.MetaData.SessionLoadCount = latest_data.MetaData.SessionLoadCount + 1
								latest_data.MetaData.LastUpdate = os.time()
							end
						end
					end,
				},
				is_user_mock
			))
			if profile_load_job[1] == load_id then -- Load job hasn't been yoinked
				loaded_data, key_info = table.unpack(profile_load_job[2])
				profile_load_jobs[profile_key] = nil
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil -- Load job yoinked
			end
		end
		-- Handle load_data:
		if loaded_data ~= nil and key_info ~= nil then
			local active_session = loaded_data.MetaData.ActiveSession
			if type(active_session) == "table" then
				if IsThisSession(active_session) == true then
					-- Special component in MetaTags:
					loaded_data.MetaData.MetaTagsLatest = DeepCopyTable(loaded_data.MetaData.MetaTags)
					-- Case #1: Profile is now taken by this session:
					-- Create Profile object:
					local global_updates_object = {
						_updates_latest = loaded_data.GlobalUpdates,
						_pending_update_lock = {},
						_pending_update_clear = {},

						_new_active_update_listeners = Madwork.NewScriptSignal(),
						_new_locked_update_listeners = Madwork.NewScriptSignal(),

						_profile = nil,
					}
					setmetatable(global_updates_object, GlobalUpdates)
					local profile = {
						Data = loaded_data.Data,
						MetaData = loaded_data.MetaData,
						MetaTagsUpdated = Madwork.NewScriptSignal(),

						RobloxMetaData = loaded_data.RobloxMetaData or {},
						UserIds = loaded_data.UserIds or {},
						KeyInfo = key_info,
						KeyInfoUpdated = Madwork.NewScriptSignal(),

						GlobalUpdates = global_updates_object,

						_profile_store = self,
						_profile_key = profile_key,

						_release_listeners = Madwork.NewScriptSignal(),
						_hop_ready_listeners = Madwork.NewScriptSignal(),
						_hop_ready = false,

						_load_timestamp = os.clock(),

						_is_user_mock = is_user_mock,
					}
					setmetatable(profile, Profile)
					global_updates_object._profile = profile
					-- Referencing Profile object in ProfileStore:
					if next(self._loaded_profiles) == nil and next(self._mock_loaded_profiles) == nil then -- ProfileStore object was inactive
						table.insert(ActiveProfileStores, self)
					end
					if is_user_mock == true then
						self._mock_loaded_profiles[profile_key] = profile
					else
						self._loaded_profiles[profile_key] = profile
					end
					-- Adding profile to AutoSaveList;
					AddProfileToAutoSave(profile)
					-- Special case - finished loading profile, but session is shutting down:
					if ProfileService.ServiceLocked == true then
						SaveProfileAsync(profile, true) -- Release profile and yield until the DataStore call is finished
						profile = nil -- nil will be returned by this call
					end
					-- Return Profile object:
					ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
					return profile
				else
					-- Case #2: Profile is taken by some other session:
					if force_load == true then
						local force_load_session = loaded_data.MetaData.ForceLoadSession
						local force_load_uninterrupted = false
						if force_load_session ~= nil then
							force_load_uninterrupted = IsThisSession(force_load_session)
						end
						if force_load_uninterrupted == true then
							if request_force_load == false then
								force_load_steps = force_load_steps + 1
								if force_load_steps == SETTINGS.ForceLoadMaxSteps then
									steal_session = true
								end
							end
							task.wait() -- Overload prevention
						else
							-- Another session tried to force load this profile:
							ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
							return nil
						end
						request_force_load = false -- Only request a force load once
					elseif aggressive_steal == true then
						task.wait() -- Overload prevention
					else
						local handler_result = not_released_handler(active_session[1], active_session[2])
						if handler_result == "Repeat" then
							task.wait() -- Overload prevention
						elseif handler_result == "Cancel" then
							ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
							return nil
						elseif handler_result == "ForceLoad" then
							force_load = true
							request_force_load = true
							task.wait() -- Overload prevention
						elseif handler_result == "Steal" then
							aggressive_steal = true
							task.wait() -- Overload prevention
						else
							error(
								"[ProfileService]: Invalid return from not_released_handler (\"" .. tostring(handler_result) .. "\")(" .. type(handler_result) .. ");" ..
									"\n" .. IdentifyProfile(self._profile_store_name, self._profile_store_scope, profile_key) ..
									" Traceback:\n" .. debug.traceback()
							)
						end
					end
				end
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil -- In this scenario it is likely the ProfileService.ServiceLocked flag was raised
			end
		else
			task.wait() -- Overload prevention
		end
	end
	ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
	return nil -- If loop breaks return nothing
end

function ProfileStore:GlobalUpdateProfileAsync(profile_key, update_handler, _use_mock) --> [GlobalUpdates / nil] (update_handler(GlobalUpdates))
	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error("[ProfileService]: Invalid profile_key")
	end
	if type(update_handler) ~= "function" then
		error("[ProfileService]: Invalid update_handler")
	end

	if ProfileService.ServiceLocked == true then
		return nil
	end

	WaitForPendingProfileStore(self)

	while ProfileService.ServiceLocked == false do
		-- Updating profile:
		local loaded_data = StandardProfileUpdateAsyncDataStore(
			self,
			profile_key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = nil,
				EditProfile = function(latest_data)
					-- Running update_handler:
					local global_updates_object = {
						_updates_latest = latest_data.GlobalUpdates,
						_update_handler_mode = true,
					}
					setmetatable(global_updates_object, GlobalUpdates)
					update_handler(global_updates_object)
				end,
			},
			_use_mock == UseMockTag
		)
		CustomWriteQueueMarkForCleanup(self._profile_store_lookup, profile_key)
		-- Handling loaded_data:
		if loaded_data ~= nil then
			-- Return GlobalUpdates object (Update successful):
			local global_updates_object = {
				_updates_latest = loaded_data.GlobalUpdates,
			}
			setmetatable(global_updates_object, GlobalUpdates)
			return global_updates_object
		else
			task.wait() -- Overload prevention
		end
	end
	return nil -- Return nothing (Update unsuccessful)
end

function ProfileStore:ViewProfileAsync(profile_key, version, _use_mock) --> [Profile / nil]
	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error("[ProfileService]: Invalid profile_key")
	end

	if ProfileService.ServiceLocked == true then
		return nil
	end

	WaitForPendingProfileStore(self)

	if version ~= nil and (_use_mock == UseMockTag or UseMockDataStore == true) then
		return nil -- No version support in mock mode
	end

	while ProfileService.ServiceLocked == false do
		-- Load profile:
		local loaded_data, key_info = StandardProfileUpdateAsyncDataStore(
			self,
			profile_key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = function(latest_data)
					latest_data.Data = DeepCopyTable(self._profile_template)
					latest_data.MetaData = {
						ProfileCreateTime = os.time(),
						SessionLoadCount = 0,
						ActiveSession = nil,
						ForceLoadSession = nil,
						MetaTags = {},
					}
				end,
				EditProfile = nil,
			},
			_use_mock == UseMockTag,
			true, -- Use :GetAsync()
			version -- DataStore key version
		)
		CustomWriteQueueMarkForCleanup(self._profile_store_lookup, profile_key)
		-- Handle load_data:
		if loaded_data ~= nil then
			if key_info == nil then
				return nil -- Load was successful, but the key was empty - return no profile object
			end
			-- Create Profile object:
			local global_updates_object = {
				_updates_latest = loaded_data.GlobalUpdates, -- {0, {}}
				_profile = nil,
			}
			setmetatable(global_updates_object, GlobalUpdates)
			local profile = {
				Data = loaded_data.Data,
				MetaData = loaded_data.MetaData,
				MetaTagsUpdated = Madwork.NewScriptSignal(),

				RobloxMetaData = loaded_data.RobloxMetaData or {},
				UserIds = loaded_data.UserIds or {},
				KeyInfo = key_info,
				KeyInfoUpdated = Madwork.NewScriptSignal(),

				GlobalUpdates = global_updates_object,

				_profile_store = self,
				_profile_key = profile_key,

				_view_mode = true,

				_load_timestamp = os.clock(),
			}
			setmetatable(profile, Profile)
			global_updates_object._profile = profile
			-- Returning Profile object:
			return profile
		else
			task.wait() -- Overload prevention
		end
	end
	return nil -- If loop breaks return nothing
end

function ProfileStore:ProfileVersionQuery(profile_key, sort_direction, min_date, max_date, _use_mock) --> [ProfileVersionQuery]
	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error("[ProfileService]: Invalid profile_key")
	end

	if ProfileService.ServiceLocked == true then
		return setmetatable({}, ProfileVersionQuery) -- Silently fail :Next() requests
	end

	WaitForPendingProfileStore(self)

	if _use_mock == UseMockTag or UseMockDataStore == true then
		error("[ProfileService]: :ProfileVersionQuery() is not supported in mock mode")
	end

	-- Type check:
	if sort_direction ~= nil and (typeof(sort_direction) ~= "EnumItem"
		or sort_direction.EnumType ~= Enum.SortDirection) then
		error("[ProfileService]: Invalid sort_direction (" .. tostring(sort_direction) .. ")")
	end

	if min_date ~= nil and typeof(min_date) ~= "DateTime" and typeof(min_date) ~= "number" then
		error("[ProfileService]: Invalid min_date (" .. tostring(min_date) .. ")")
	end

	if max_date ~= nil and typeof(max_date) ~= "DateTime" and typeof(max_date) ~= "number" then
		error("[ProfileService]: Invalid max_date (" .. tostring(max_date) .. ")")
	end

	min_date = typeof(min_date) == "DateTime" and min_date.UnixTimestampMillis or min_date
	max_date = typeof(max_date) == "DateTime" and max_date.UnixTimestampMillis or max_date

	local profile_version_query = {
		_profile_store = self,
		_profile_key = profile_key,
		_sort_direction = sort_direction,
		_min_date = min_date,
		_max_date = max_date,

		_query_pages = nil,
		_query_index = 0,
		_query_failure = false,

		_is_query_yielded = false,
		_query_queue = {},
	}
	setmetatable(profile_version_query, ProfileVersionQuery)

	return profile_version_query

end

function ProfileStore:WipeProfileAsync(profile_key, _use_mock) --> is_wipe_successful [bool]
	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error("[ProfileService]: Invalid profile_key")
	end

	if ProfileService.ServiceLocked == true then
		return false
	end

	WaitForPendingProfileStore(self)

	local wipe_status = false

	if _use_mock == UseMockTag then -- Used when the profile is accessed through ProfileStore.Mock
		local mock_data_store = UserMockDataStore[self._profile_store_lookup]
		if mock_data_store ~= nil then
			mock_data_store[profile_key] = nil
		end
		wipe_status = true
		task.wait() -- Simulate API call yield
	elseif UseMockDataStore == true then -- Used when API access is disabled
		local mock_data_store = MockDataStore[self._profile_store_lookup]
		if mock_data_store ~= nil then
			mock_data_store[profile_key] = nil
		end
		wipe_status = true
		task.wait() -- Simulate API call yield
	else
		wipe_status = pcall(function()
			self._global_data_store:RemoveAsync(profile_key)
		end)
	end

	CustomWriteQueueMarkForCleanup(self._profile_store_lookup, profile_key)

	return wipe_status
end

-- New ProfileStore:

function ProfileService.GetProfileStore(profile_store_index, profile_template) --> [ProfileStore]

	local profile_store_name
	local profile_store_scope = nil

	-- Parsing profile_store_index:
	if type(profile_store_index) == "string" then
		-- profile_store_index as string:
		profile_store_name = profile_store_index
	elseif type(profile_store_index) == "table" then
		-- profile_store_index as table:
		profile_store_name = profile_store_index.Name
		profile_store_scope = profile_store_index.Scope
	else
		error("[ProfileService]: Invalid or missing profile_store_index")
	end

	-- Type checking:
	if profile_store_name == nil or type(profile_store_name) ~= "string" then
		error("[ProfileService]: Missing or invalid \"Name\" parameter")
	elseif string.len(profile_store_name) == 0 then
		error("[ProfileService]: ProfileStore name cannot be an empty string")
	end

	if profile_store_scope ~= nil and (type(profile_store_scope) ~= "string" or string.len(profile_store_scope) == 0) then
		error("[ProfileService]: Invalid \"Scope\" parameter")
	end

	if type(profile_template) ~= "table" then
		error("[ProfileService]: Invalid profile_template")
	end

	local profile_store
	profile_store = {
		Mock = {
			LoadProfileAsync = function(_, profile_key, not_released_handler)
				return profile_store:LoadProfileAsync(profile_key, not_released_handler, UseMockTag)
			end,
			GlobalUpdateProfileAsync = function(_, profile_key, update_handler)
				return profile_store:GlobalUpdateProfileAsync(profile_key, update_handler, UseMockTag)
			end,
			ViewProfileAsync = function(_, profile_key, version)
				return profile_store:ViewProfileAsync(profile_key, version, UseMockTag)
			end,
			FindProfileVersionAsync = function(_, profile_key, sort_direction, min_date, max_date)
				return profile_store:FindProfileVersionAsync(profile_key, sort_direction, min_date, max_date, UseMockTag)
			end,
			WipeProfileAsync = function(_, profile_key)
				return profile_store:WipeProfileAsync(profile_key, UseMockTag)
			end
		},

		_profile_store_name = profile_store_name,
		_profile_store_scope = profile_store_scope,
		_profile_store_lookup = profile_store_name .. "\0" .. (profile_store_scope or ""),

		_profile_template = profile_template,
		_global_data_store = nil,
		_loaded_profiles = {},
		_profile_load_jobs = {},
		_mock_loaded_profiles = {},
		_mock_profile_load_jobs = {},
		_is_pending = false,
	}
	setmetatable(profile_store, ProfileStore)

	if IsLiveCheckActive == true then
		profile_store._is_pending = true
		task.spawn(function()
			WaitForLiveAccessCheck()
			if UseMockDataStore == false then
				profile_store._global_data_store = DataStoreService:GetDataStore(profile_store_name, profile_store_scope)
			end
			profile_store._is_pending = false
		end)
	else
		if UseMockDataStore == false then
			profile_store._global_data_store = DataStoreService:GetDataStore(profile_store_name, profile_store_scope)
		end
	end

	return profile_store
end

function ProfileService.IsLive() --> [bool] -- (CAN YIELD!!!)

	WaitForLiveAccessCheck()

	return UseMockDataStore == false

end

----- Initialize -----

if IsStudio == true then
	IsLiveCheckActive = true
	task.spawn(function()
		local status, message = pcall(function()
			-- This will error if current instance has no Studio API access:
			DataStoreService:GetDataStore("____PS"):SetAsync("____PS", os.time())
		end)
		local no_internet_access = status == false and string.find(message, "ConnectFail", 1, true) ~= nil
		if no_internet_access == true then
			warn("[ProfileService]: No internet access - check your network connection")
		end
		if status == false and
			(string.find(message, "403", 1, true) ~= nil or -- Cannot write to DataStore from studio if API access is not enabled
				string.find(message, "must publish", 1, true) ~= nil or -- Game must be published to access live keys
				no_internet_access == true) then -- No internet access

			UseMockDataStore = true
			ProfileService._use_mock_data_store = true
			print("[ProfileService]: Roblox API services unavailable - data will not be saved")
		else
			print("[ProfileService]: Roblox API services available - data will be saved")
		end
		IsLiveCheckActive = false
	end)
end

----- Connections -----

-- Auto saving and issue queue managing:
RunService.Heartbeat:Connect(function()
	-- 1) Auto saving: --
	local auto_save_list_length = #AutoSaveList
	if auto_save_list_length > 0 then
		local auto_save_index_speed = SETTINGS.AutoSaveProfiles / auto_save_list_length
		local os_clock = os.clock()
		while os_clock - LastAutoSave > auto_save_index_speed do
			LastAutoSave = LastAutoSave + auto_save_index_speed
			local profile = AutoSaveList[AutoSaveIndex]
			if os_clock - profile._load_timestamp < SETTINGS.AutoSaveProfiles then
				-- This profile is freshly loaded - auto-saving immediately after loading will cause a warning in the log:
				profile = nil
				for _ = 1, auto_save_list_length - 1 do
					-- Move auto save index to the right:
					AutoSaveIndex = AutoSaveIndex + 1
					if AutoSaveIndex > auto_save_list_length then
						AutoSaveIndex = 1
					end
					profile = AutoSaveList[AutoSaveIndex]
					if os_clock - profile._load_timestamp >= SETTINGS.AutoSaveProfiles then
						break
					else
						profile = nil
					end
				end
			end
			-- Move auto save index to the right:
			AutoSaveIndex = AutoSaveIndex + 1
			if AutoSaveIndex > auto_save_list_length then
				AutoSaveIndex = 1
			end
			-- Perform save call:
			if profile ~= nil then
				task.spawn(SaveProfileAsync, profile) -- Auto save profile in new thread
			end
		end
	end
	-- 2) Issue queue: --
	-- Critical state handling:
	if ProfileService.CriticalState == false then
		if #IssueQueue >= SETTINGS.IssueCountForCriticalState then
			ProfileService.CriticalState = true
			ProfileService.CriticalStateSignal:Fire(true)
			CriticalStateStart = os.clock()
			warn("[ProfileService]: Entered critical state")
		end
	else
		if #IssueQueue >= SETTINGS.IssueCountForCriticalState then
			CriticalStateStart = os.clock()
		elseif os.clock() - CriticalStateStart > SETTINGS.CriticalStateLast then
			ProfileService.CriticalState = false
			ProfileService.CriticalStateSignal:Fire(false)
			warn("[ProfileService]: Critical state ended")
		end
	end
	-- Issue queue:
	while true do
		local issue_time = IssueQueue[1]
		if issue_time == nil then
			break
		elseif os.clock() - issue_time > SETTINGS.IssueLast then
			table.remove(IssueQueue, 1)
		else
			break
		end
	end
end)

-- Release all loaded profiles when the server is shutting down:
task.spawn(function()
	WaitForLiveAccessCheck()
	Madwork.ConnectToOnClose(
		function()
			ProfileService.ServiceLocked = true
			-- 1) Release all active profiles: --
			-- Clone AutoSaveList to a new table because AutoSaveList changes when profiles are released:
			local on_close_save_job_count = 0
			local active_profiles = {}
			for index, profile in ipairs(AutoSaveList) do
				active_profiles[index] = profile
			end
			-- Release the profiles; Releasing profiles can trigger listeners that release other profiles, so check active state:
			for _, profile in ipairs(active_profiles) do
				if profile:IsActive() == true then
					on_close_save_job_count = on_close_save_job_count + 1
					task.spawn(function() -- Save profile on new thread
						SaveProfileAsync(profile, true)
						on_close_save_job_count = on_close_save_job_count - 1
					end)
				end
			end
			-- 2) Yield until all active profile jobs are finished: --
			while on_close_save_job_count > 0 or ActiveProfileLoadJobs > 0 or ActiveProfileSaveJobs > 0 do
				task.wait()
			end
			return -- We're done!
		end,
		UseMockDataStore == false -- Always run this OnClose task if using Roblox API services
	)
end)

return ProfileService]]></Source>
		<Source path="src/ServerStorage/Modules/Modules/init.luau"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="src/ServerStorage/Modules/Modules/AgroModule.luau"><![CDATA[
local Players = game:GetService('Players')

-- // Module // --
local Module = { AgroCache = {} }

function Module.GetAgroedPlayers( mobId )
	local currentCache = Module.AgroCache[mobId]

	-- update cache for any players that left
	local index = 1
	while index <= #currentCache do
		local mobData = currentCache[index]
		if (not mobData.Agro[1]) or (not mobData.Agro[1]:IsDescendantOf(Players)) then
			table.remove(currentCache, index)
		else
			index += 1
		end
	end

	-- sort by most agro to least agro
	table.sort(currentCache.Agro, function(a, b)
		return (a > b)
	end)

	return currentCache
end

function Module.IncrementPlayerAgro( mobId, playerInstance, amount : number? )
	amount = amount or 1

	if not Module.AgroCache[mobId] then
		Module.AgroCache[mobId] = { AgroTick = tick(), Agro = { } }
	end

	local mobData = Module.AgroCache[mobId]
	mobData.AgroTick = tick()

	local currentAgro = mobData.Agro[ playerInstance ] or 0
	mobData.Agro[ playerInstance ] = currentAgro + amount
end

function Module.FindMostAgroedPlayer( mobId ) -- sugar
	return Module.GetAgroedPlayers( mobId )[1]
end

function Module.ResetMobAgro( mobId )
	if Module.AgroCache[mobId] then
		Module.AgroCache[mobId].Agro = {}
		Module.AgroCache[mobId].AgroTick = tick()
	end
end

return Module
]]></Source>
		<Source path="src/ServerStorage/Modules/Modules/CombatModule.luau"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local CharacterStatesModule = ReplicatedModules.Services.CharacterStates

-- // Module // --
local Module = {}

function Module.StunCharacter( character, customDuration )
	customDuration = customDuration or 1.5
	CharacterStatesModule.SetStateTemporary( character, 'Stunned', customDuration, true )
end

function Module.KnockdownCharacter( character, customDuration )
	customDuration = customDuration or 1.5
	CharacterStatesModule.SetStateTemporary( character, 'KnockedDown', customDuration, true )
	Module.StunCharacter( character, customDuration )
end

return Module
]]></Source>
		<Source path="src/ServerStorage/Modules/Modules/DamageModule.luau"><![CDATA[local CollectionService = game:GetService('CollectionService')
local Players = game:GetService('Players')
local ServerStorage = game:GetService('ServerStorage')

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local RemoteService = ReplicatedModules.Services.RemoteService
local DamageIndicatorEvent = RemoteService.GetRemote('DamageIndicatorEvent', 'RemoteEvent', false)

-- Hoisted out of DamageHumanoid: the previous lazy
-- `require(...:WaitForChild('Core'):WaitForChild('AttributeServer'))`
-- ran on every single damage event (twice — two WaitForChild calls).
-- WaitForChild on a present child is cheap but not free; under sustained
-- combat (boar dash, AoE, etc.) the per-tick allocations add up. The
-- module is loaded once at first hit instead.
local AttributeServer = require(ServerStorage:WaitForChild('Core'):WaitForChild('AttributeServer'))

-- Saves accessor + SkillsShared for passive bonuses. Required at top so
-- DamageHumanoid doesn't WaitForChild on every hit. SavesManagerServer
-- exports GetPlayerSelectedSaveData which the passive accessors read
-- to total bonuses across unlocked skills. SkillsConfig is required
-- for the StatNameEnum so this module compares against the enum value
-- rather than string-typing the stat name.
local SavesManagerServer = require(ServerStorage:WaitForChild('Core'):WaitForChild('SavesManagerServer'))
local BoostersServer = require(ServerStorage:WaitForChild('Core'):WaitForChild('BoostersServer'))
local StatisticsServer = require(ServerStorage:WaitForChild('Core'):WaitForChild('StatisticsServer'))
local StatisticsConfig = ReplicatedModules.Data.StatisticsConfig
local SkillsShared = ReplicatedModules.Services.SkillsShared
local SkillsConfig = ReplicatedModules.Data.Skills
local DifficultyConfig = ReplicatedModules.Data.Difficulty
local BoostersConfig = ReplicatedModules.Data.Boosters
local CombatUtility = ReplicatedModules.Utility.CombatUtility

local INVULNERABILITY_TAG = 'INVULNERABILITY'

-- MicroProfiler scope wrapper. Labels a region for a Studio capture and
-- costs nothing when no capture is running. These used to also emit an
-- os.clock() benchmark `print` per call — on a path that runs for every
-- hit of every swing, that Output flush was itself the lag it was
-- measuring. The scopes stayed; the prints did not.
local function _profileCall(label: string, fn: () -> ...any): ...any
	debug.profilebegin(label)
	local results = table.pack(fn())
	-- Defensive: if `fn` yielded, the engine already popped our scope
	-- and profileend would raise "No active profile annotation".
	pcall(debug.profileend)
	return table.unpack(results, 1, results.n)
end

-- // Module // --
local Module = {}

function Module.TagHumanoid( Humanoid, Value )
	assert( Value, 'Cannot tag humanoid will nil value.' )
	local ObjValue = Humanoid:FindFirstChild( tostring(Value) )

	if ObjValue and ObjValue:GetAttribute('Expiry') and time() > ObjValue:GetAttribute('Expiry') then
		ObjValue:Destroy()
		ObjValue = nil
	end

	if not ObjValue then
		ObjValue = Instance.new('ObjectValue')
		ObjValue.Name = tostring(Value)
		ObjValue.Value = Value
		ObjValue.Parent = Humanoid
	end
	return ObjValue
end

function Module.TagHumanoidTemporary( Humanoid, Value, Duration )
	local ObjValue = Module.TagHumanoid( Humanoid, Value )
	ObjValue:SetAttribute('Expiry', time() + Duration)
end

--[[
	function Module.GetHumanoidTagOwners( Humanoid )
		local TagOwners = { }
		for _, ObjValue in Humanoid:GetChildren() do
			if ObjValue:IsA("ObjectValue") then
				table.insert( TagOwners, ObjValue.Value )
			end
		end
		return TagOwners
	end
]]

function Module.GetHumanoidTags( Humanoid ) : {[Player] : {Damage : number, Expiry : number}}
	local TagValues = { }
	for _, ObjValue in Humanoid:GetChildren() do
		if ObjValue:IsA("ObjectValue") then
			TagValues[ObjValue.Value] = ObjValue:GetAttributes()
		end
	end
	return TagValues
end

-- `indicatorBuffer` (optional, 4th arg): a flat alternating
-- {humanoid, damage, humanoid, damage, ...} array. When provided,
-- DamageHumanoid pushes its (Humanoid, Damage) pair into the buffer
-- instead of immediately calling DamageIndicatorEvent:FireAllClients.
-- The caller is responsible for flushing via FireBatchedDamageIndicators
-- once their swing/pulse is done — collapses N broadcasts per swing
-- into 1. Single-hit callers (status ticks, companion shots) leave
-- the buffer nil and keep the original per-hit fire-and-forget path.
function Module.DamageHumanoid( Humanoid, Damage, DamageOwner, indicatorBuffer )
	return _profileCall('DamageModule.DamageHumanoid', function()
	local character = Humanoid.Parent
	if character and CollectionService:HasTag(character, INVULNERABILITY_TAG) then
		return 0
	end
	-- Dodge i-frames: if the character has an active 'IFrames'
	-- temporary state (set by CombatServer.AttemptDodge),
	-- silently absorb the hit. Surface a "MISS" indicator instead so
	-- the attacker still gets visual feedback.
	if character and character:GetAttribute('IFrames') then
		if indicatorBuffer then
			indicatorBuffer[#indicatorBuffer + 1] = Humanoid
			indicatorBuffer[#indicatorBuffer + 1] = 0
		else
			DamageIndicatorEvent:FireAllClients( Humanoid, 0 )
		end
		return 0
	end

	-- Resolve victim/attacker player handles once. Either may be nil:
	-- victim=nil means the target is an NPC; attackerPlayer=nil means
	-- the source is an NPC (or world hazard). The XP-grant branches
	-- below skip whichever isn't a real Player so PvP doesn't grant
	-- combat-stat XP on either side.
	local victim = character and Players:GetPlayerFromCharacter(character)
	local attackerPlayer = nil
	if typeof(DamageOwner) == 'Instance' then
		if DamageOwner:IsA('Player') then
			attackerPlayer = DamageOwner
		else
			attackerPlayer = Players:GetPlayerFromCharacter(DamageOwner)
		end
	end

	-- PvP gate. When attacker AND victim are both real Players AND the
	-- victim has AllowPvP=false in their persisted Settings, drop the
	-- hit silently with a MISS indicator so the attacker still gets
	-- visual feedback (matches the i-frames path above). PvE damage
	-- (mob → player, player → mob) is unaffected. Self-damage is also
	-- allowed through — `attackerPlayer == victim` is rare but not a
	-- PvP scenario.
	if attackerPlayer and victim and attackerPlayer ~= victim then
		local victimSave = SavesManagerServer.GetPlayerSelectedSaveData(victim)
		local allow = victimSave and typeof(victimSave.Settings) == 'table'
			and victimSave.Settings.AllowPvP == true
		if not allow then
			if indicatorBuffer then
				indicatorBuffer[#indicatorBuffer + 1] = Humanoid
				indicatorBuffer[#indicatorBuffer + 1] = 0
			else
				DamageIndicatorEvent:FireAllClients( Humanoid, 0 )
			end
			return 0
		end
	end

	-- Attacker-side passive (e.g. 'Attacker' skill, +2%/level outgoing).
	-- Applied first so the defender's bonus reads the post-buff number.
	-- Value/percent shape: damage = damage * (1 + percent) + value.
	debug.profilebegin('DamageModule.Passives')
	if attackerPlayer and Damage > 0 then
		local attackerSave = SavesManagerServer.GetPlayerSelectedSaveData(attackerPlayer)
		if attackerSave then
			Damage = SkillsShared.ApplyPassiveBonusToDamage(attackerSave, SkillsConfig.StatNameEnum.Attack, Damage)
		end
	end

	-- Booster: outgoing damage multiplier on the attacker. Applied
	-- after passives so the booster compounds with skill bonuses, and
	-- BEFORE defender mitigation so it represents pre-defense raw
	-- damage. Skipped when attacker is an NPC (boosters are
	-- player-only).
	if attackerPlayer and Damage > 0 then
		local outMul = BoostersServer.GetMultiplier(attackerPlayer, BoostersConfig.Kinds.DamageOutMul)
		if outMul ~= 1 then
			Damage = Damage * outMul
		end
	end

	-- Booster: crit roll. Chance comes from the additive crit_chance_add
	-- stack (e.g. 0.10 = +10%); on hit, damage scales by the
	-- crit_damage_mul stack (e.g. 1.25 = +25%). Player-only — NPCs
	-- don't roll crits. Future hooks: AttributeServer.GetPlayerBonus
	-- ('Crit') and Companions Crit can sum into chanceAdd alongside.
	if attackerPlayer and Damage > 0 then
		local chanceAdd = BoostersServer.GetAddend(attackerPlayer, BoostersConfig.Kinds.CritChanceAdd)
		if chanceAdd > 0 then
			-- Cap at 1.0 so a hypothetical run with many stacked Crit
			-- Blessings can't roll above 100%. NextNumber returns [0,1).
			local rolled = math.random()
			if rolled < math.min(1, chanceAdd) then
				local critDmg = BoostersServer.GetMultiplier(attackerPlayer, BoostersConfig.Kinds.CritDamageMul)
				-- Default crit damage multiplier when only crit-chance
				-- is buffed (no crit_damage_mul booster active) is 1.5×
				-- — a sensible "you crit but no extra damage booster"
				-- baseline. GetMultiplier returns 1 when no stack of
				-- the kind is active, so we bump it to 1.5 here.
				if critDmg == 1 then critDmg = 1.5 end
				Damage = Damage * critDmg
			end
		end
	end

	-- Status-effect armor. Written by StatusEffectsRuntime's armor_pct /
	-- armor_flat appliers, which sum every active stack into these two
	-- attributes and subtract their own contribution on expiry.
	--
	-- Read off `character` rather than `victim` on purpose: status
	-- effects apply to NPCs as well as players, so gating this on a
	-- Player handle would silently make every armor buff a player-only
	-- mechanic. Runs alongside Toughness because both are the same kind
	-- of thing — flat/percent mitigation before the passive layer.
	if character and Damage > 0 then
		local armorPct = character:GetAttribute('Effect_ArmorPctSum')
		if typeof(armorPct) == 'number' and armorPct > 0 then
			-- Already clamped to 0.95 at write time; clamped again here so
			-- a hand-set attribute can't produce negative damage.
			Damage = Damage * (1 - math.clamp(armorPct, 0, 0.95))
		end

		local armorFlat = character:GetAttribute('Effect_ArmorFlat')
		if typeof(armorFlat) == 'number' and armorFlat > 0 then
			-- Capped at half the incoming hit, matching Toughness. Without
			-- the cap, stacking armor buffs reaches total immunity to
			-- small hits, which is the failure mode NIER_COMBAT.md warns
			-- about for stacked defensive modifiers.
			Damage = math.max(0, Damage - math.min(armorFlat, Damage * 0.5))
		end
	end

	-- Toughness bonus: flat damage reduction, capped at 50% of incoming
	-- damage so a maxed Toughness build can't make the player invincible
	-- against weak hits. Resolved per-hit (not at spawn) so respec /
	-- buffs / debuffs propagate immediately.
	if victim then
		local toughness = AttributeServer.GetPlayerBonus(victim, 'Toughness')
		if toughness > 0 then
			local reduction = math.min(toughness, Damage * 0.5)
			Damage = math.max(0, Damage - reduction)
		end
	end

	-- Defender-side passive (e.g. 'Defender' skill, -2%/level incoming).
	-- Reads the same percent/value shape; defense Stat is canonically
	-- expressed as a damage REDUCTION fraction, so we apply it as
	-- `(1 - percent)` rather than `(1 + percent)`. Flat 'value' is
	-- subtracted, floored at 0.
	if victim and Damage > 0 then
		local victimSave = SavesManagerServer.GetPlayerSelectedSaveData(victim)
		if victimSave then
			local def = SkillsShared.GetPassiveBonus(victimSave, SkillsConfig.StatNameEnum.Defense)
			-- Cap percent at 0.95 so a hypothetical maxed-defense build
			-- can't make the player completely immune to damage.
			local pct = math.clamp(def.percent, 0, 0.95)
			Damage = math.max(0, Damage * (1 - pct) - def.value)
		end
	end

	-- Difficulty incoming-damage scale. Applied to player victims AFTER
	-- their passive mitigation so HARD's +10% damage represents what the
	-- player actually feels post-mitigation. NPC victims pass through —
	-- difficulty is a player-facing setting, mob HP scaling lives in the
	-- per-floor DifficultyScaling registry instead.
	if victim and Damage > 0 then
		local victimSave = SavesManagerServer.GetPlayerSelectedSaveData(victim)
		if victimSave and victimSave.Difficulty then
			local incMul = DifficultyConfig.GetMultipliers(victimSave.Difficulty).IncomingDamageMul
			if incMul ~= 1 then
				Damage = Damage * incMul
			end
		end
	end

	-- Booster: incoming damage multiplier on the victim. Applied AFTER
	-- difficulty so it stacks on the post-difficulty number (so
	-- "Ironskin 0.8×" gives the player a 20% reduction on the actually-
	-- delivered damage, not on the pre-difficulty baseline). Nerf-style
	-- values (< 1) stack multiplicatively in BoostersServer to avoid
	-- the additive-amplifier bug.
	if victim and Damage > 0 then
		local inMul = BoostersServer.GetMultiplier(victim, BoostersConfig.Kinds.DamageInMul)
		if inMul ~= 1 then
			Damage = Damage * inMul
		end
	end

	-- Status-effect damage amplification (the `exposed` debuff). Written
	-- by StatusEffectsRuntime's damage_amp applier as a summed fraction.
	--
	-- Deliberately LAST, after every mitigation layer. "Exposed" reads to
	-- a player as "this target now takes more damage", and applying it
	-- before mitigation would let armor and passives eat most of it —
	-- a +30% debuff that delivers +8% is worse than no debuff at all,
	-- because it teaches players the effect does nothing. Applied here,
	-- +30% means +30% of the damage actually dealt.
	--
	-- Read off `character`, not `victim`: exposing a mob is the primary
	-- use case, and gating on a Player handle would have made this
	-- work only in PvP.
	if character and Damage > 0 then
		local amp = character:GetAttribute('Effect_DamageAmpSum')
		if typeof(amp) == 'number' and amp > 0 then
			Damage = Damage * (1 + amp)
		end
	end
	debug.profileend()

	debug.profilebegin('DamageModule.ApplyAndBroadcast')
	-- Round on the way IN so Health lands on a clean value, and again on
	-- the delta below. Both are needed: Health is a float32, so the
	-- subtraction reintroduces error even from an already-clean input.
	Damage = CombatUtility.RoundCombatNumber(Damage)
	local healthBefore = Humanoid.Health
	Humanoid:TakeDamage( Damage )
	Damage = CombatUtility.RoundCombatNumber(math.max(0, healthBefore - Humanoid.Health))

	-- Only grant credit, XP, and on-hit followups for health actually removed.
	-- ForceFields, dead humanoids, and overkill therefore report the truth.
	if attackerPlayer and not victim and Damage > 0 then
		AttributeServer.IncrementAttributeExperience(
			attackerPlayer, 'Strength', math.floor(Damage))
	end
	if victim and not attackerPlayer and Damage > 0 then
		AttributeServer.IncrementAttributeExperience(
			victim, 'Vitality', math.floor(Damage))
	end
	if Damage > 0 and typeof(DamageOwner) == "Instance" then
		local tagInstance = Module.TagHumanoid( Humanoid, DamageOwner )
		local currentDamage = tagInstance:GetAttribute('Damage') or 0
		-- Rounded per accumulation: this total drives loot attribution and
		-- gets printed on kill, so unrounded addition would let the dust
		-- compound across a whole fight.
		tagInstance:SetAttribute('Damage', CombatUtility.RoundCombatNumber(currentDamage + Damage))
	end

	-- // Statistics fan-out //
	-- Bumps DamageDealt* on the attacker AND DamageTaken on the victim
	-- (they're the same hit, two perspectives). Done AFTER TakeDamage
	-- so a hit that's reduced to 0 by IFrames / blocking still records
	-- the post-mitigation damage, not the raw incoming. The hit-amount
	-- highest-single-hit record reads the same post-mitigation number
	-- so two players have a consistent number to compare.
	local IDS = StatisticsConfig.StatisticIds
	local floored = math.floor(Damage + 0.5)
	if floored > 0 then
		if attackerPlayer then
			StatisticsServer.Increment(attackerPlayer, IDS.DamageDealtTotal, floored)
			-- PvP vs PvE split keyed off whether the victim is a real Player.
			if victim then
				StatisticsServer.Increment(attackerPlayer, IDS.DamageDealtPvP, floored)
			else
				StatisticsServer.Increment(attackerPlayer, IDS.DamageDealtPvE, floored)
			end
			StatisticsServer.SetMax(attackerPlayer, IDS.HighestSingleHit, floored)
		end
		if victim then
			StatisticsServer.Increment(victim, IDS.DamageTaken, floored)
		end
	end
	if indicatorBuffer then
		-- Defer the broadcast — caller batches into one FireAllClients via
		-- FireBatchedDamageIndicators after the swing's HitLoop completes.
		indicatorBuffer[#indicatorBuffer + 1] = Humanoid
		indicatorBuffer[#indicatorBuffer + 1] = Damage
	else
		DamageIndicatorEvent:FireAllClients( Humanoid, Damage )
	end
	debug.profileend()
	return Damage
	end)
end

-- Flush a buffer collected across a multi-hit swing/pulse into a single
-- FireAllClients broadcast. Buffer is the flat alternating
-- {humanoid, damage, humanoid, damage, ...} array DamageHumanoid pushes
-- into when given a non-nil 4th arg. Empty / nil buffers no-op so the
-- caller doesn't have to gate on length itself.
function Module.FireBatchedDamageIndicators( indicatorBuffer )
	if not indicatorBuffer or #indicatorBuffer == 0 then return end
	DamageIndicatorEvent:FireAllClients( indicatorBuffer )
end

function Module.DamageCharacter( Character, Damage, DamageOwner )
	local Humanoid = Character:FindFirstChildWhichIsA('Humanoid')
	if not Humanoid then
		return
	end

	if CollectionService:HasTag( Character, INVULNERABILITY_TAG ) then
		-- TODO: display invulnerability above head
		return
	end

	Module.DamageHumanoid( Humanoid, Damage, DamageOwner )
end

function Module.IsHumanoidInCombat( Humanoid )
	local Tags = Module.GetHumanoidTags( Humanoid )
	for _, Attributes in Tags do
		if Attributes['Expiry'] and time() < Attributes['Expiry'] then
			return true
		end
	end
	return false
end

function Module.IsCharacterInCombat( Character )
	local Humanoid = Character:FindFirstChildWhichIsA('Humanoid')
	if not Humanoid then
		return false
	end
	return Module.IsHumanoidInCombat( Humanoid )
end

return Module
]]></Source>
		<Source path="src/ServerStorage/Modules/Services/init.luau"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="src/ServerStorage/Modules/Utility/init.luau"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="src/StarterPlayerScripts/CmdrClient.client.luau"><![CDATA[
local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local CmdrConfig = require(ReplicatedStorage:WaitForChild('CmdrConfig'))
local CmdrClient = require(ReplicatedStorage:WaitForChild('CmdrClient'))

if CmdrConfig.IsPlayerAdmin(Players.LocalPlayer) then
	CmdrClient:SetActivationKeys({ Enum.KeyCode.F2 })
end
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/init.luau"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Effects/init.luau"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Effects/AttributeLevelUpClient.luau"><![CDATA[-- Attribute level-up client. Renders a *subtler* version of the
-- character level-up — small particle puff at the HRP, a softer
-- chime, and no onscreen overlay (the toast carries the textual
-- feedback). Triggered when AttributeServer.CheckAttributeLeveling
-- promotes any attribute (Strength → 5, Vitality → 3, etc.).
--
-- Why two effects instead of reusing LevelUpClient: attribute
-- level-ups happen far more often than character level-ups (every
-- few hits during sustained combat once XP grants stack). A full
-- LevelUp pop on every Strength tick would be obnoxious — this
-- effect is intentionally short, single-burst, and quiet.

local Players = game:GetService('Players')
local Debris  = game:GetService('Debris')
local TweenService = game:GetService('TweenService')

local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local RemoteService = ReplicatedModules.Services.RemoteService
local SoundService  = ReplicatedModules.Services.SoundService

local AttributeLevelUpEvent = RemoteService.GetRemote('AttributeLevelUpEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

-- Subtler than the full level-up chime. Lower volume + slightly
-- detuned playback so it reads as a "tick" rather than a "fanfare."
local ATTR_SOUND_ID     = 'rbxassetid://9114015882'
local ATTR_SOUND_VOLUME = 0.35
local ATTR_SOUND_PITCH  = 1.4

----------------------------------------------------------------------
-- Particle puff. Single short burst at the local player's HRP. ~10
-- particles, white/cyan-tinged, fast cleanup so back-to-back ticks
-- don't pile up emitters.
----------------------------------------------------------------------
local function spawnPuff(hrp: BasePart)
	local att = Instance.new('Attachment')
	att.Name = 'AttrLevelUpEmit'
	-- Float slightly above shoulder so the puff isn't lost in the
	-- character's torso-clipping radius.
	att.CFrame = CFrame.new(0, 1, 0)
	att.Parent = hrp

	local emitter = Instance.new('ParticleEmitter')
	emitter.Texture = 'rbxasset://textures/particles/sparkles_main.dds'
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.4, 0.7)
	emitter.Speed = NumberRange.new(3, 6)
	emitter.SpreadAngle = Vector2.new(60, 60)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-90, 90)
	emitter.Acceleration = Vector3.new(0, 1.5, 0)  -- gentle rise, not the gravity-heavy LevelUp drop
	emitter.LightEmission = 0.5
	emitter.Color = ColorSequence.new(Color3.fromRGB(220, 240, 255), Color3.fromRGB(180, 220, 255))
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(0.6, 0.5),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 0.05),
	})
	emitter.Drag = 1.0
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Parent = att

	emitter:Emit(10)
	-- 0.9s lifetime cap > particle Lifetime max, so the longest-lived
	-- particle finishes before the emitter detaches.
	Debris:AddItem(att, 0.9)
end

----------------------------------------------------------------------
-- Optional aura ring — much smaller than the character level-up's
-- 14-stud expanding cylinder. Just a quick 3-stud halo to mark the
-- moment without dominating the screen.
----------------------------------------------------------------------
local function spawnHalo(hrp: BasePart)
	local ring = Instance.new('Part')
	ring.Name = 'AttrLevelUpHalo'
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.1, 1, 1)
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(190, 220, 255)
	ring.CFrame = hrp.CFrame * CFrame.new(0, -2.6, 0) * CFrame.Angles(0, 0, math.rad(90))
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Transparency = 0.5
	ring.Parent = workspace.Terrain

	TweenService:Create(ring, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.1, 6, 6),
		Transparency = 1,
	}):Play()
	Debris:AddItem(ring, 0.5)
end

----------------------------------------------------------------------
-- Public entry — fired by the remote listener.
----------------------------------------------------------------------
function Module.PlayAttributeLevelUp(_attributeId: string, _newLevel: number, _levelsGained: number?)
	local character = LocalPlayer.Character
	local hrp = character and character:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not hrp then return end

	spawnPuff(hrp)
	spawnHalo(hrp)

	-- Quiet positional sound. SoundService helper handles the
	-- terrain-attachment + auto-debris pattern.
	if SoundService and SoundService.PlaySoundAtPosition then
		SoundService.PlaySoundAtPosition(ATTR_SOUND_ID, hrp.Position, ATTR_SOUND_PITCH)
	else
		local sound = Instance.new('Sound')
		sound.SoundId = ATTR_SOUND_ID
		sound.Volume  = ATTR_SOUND_VOLUME
		sound.PlaybackSpeed = ATTR_SOUND_PITCH
		sound.RollOffMode = Enum.RollOffMode.InverseTapered
		sound.Parent = hrp
		sound:Play()
		Debris:AddItem(sound, 2)
	end
end

function Module.Start()
	AttributeLevelUpEvent.OnClientEvent:Connect(function(attributeId, newLevel, levelsGained)
		Module.PlayAttributeLevelUp(attributeId, newLevel, levelsGained)
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Effects/CinematicCharacter.luau"><![CDATA[-- CinematicCharacter — high-level runtime shot API. Picks a camera
-- shot preset (over-shoulder, low-hero, etc.) and frames it against
-- a Model reference at runtime. Wrapper over CinematicClient.PlayCue
-- so the camera FSM stays the only owner of camera state.
--
-- Usage (from any client-side gameplay code):
--   local Cinematic = SystemsContainer.CinematicCharacter
--   Cinematic.OverTheShoulderSwitch(npcModel)
--   Cinematic.LowHero(bossModel, { Lerp = 0.3, ExtraCFrame = CFrame.new(0, 0.5, 0) })
--   Cinematic.SnapClose(npcModel, { Hold = 2.5 })  -- auto-reset after 2.5s
--   Cinematic.Reset()
--
-- Options (`opts` table, all fields optional):
--   Lerp        : number  — override preset's Lerp (lower = snappier)
--   Snap        : boolean — bypass lerp; effectively-instant cut
--   ExtraCFrame : CFrame  — composed onto preset.Offset (translate +
--                            rotate the framing without authoring a
--                            new preset)
--   LockMovement: boolean — disable WASD while shot active
--   LockHUD     : boolean — fade HUD while shot active
--   Hold        : number  — auto-reset after this many seconds
--   OnReset     : ()->()  — called when the auto-reset fires (or
--                            manual Reset() interrupts the hold)
--
-- All shot helpers route through SetShot, so adding a new preset
-- in CinematicPresets.CameraShots makes it available immediately
-- via SetShot(model, '<presetName>', opts) without code changes.

local Players = game:GetService('Players')

local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CinematicShared  = ReplicatedModules.Services.CinematicShared
local CinematicPresets = ReplicatedModules.Data.CinematicPresets

-- Sibling controllers populated via Init.
local SystemsContainer = {}

-- Snap "lerp" — small enough that one frame's `dt / Lerp` >= 1 so
-- CinematicClient's smoothstep clamps to the destination. Not zero
-- (would div-by-zero); not large (would feel laggy).
local SNAP_LERP_SECONDS = 1e-3

local Module = {}

----------------------------------------------------------------------
-- Active-shot bookkeeping. Tracks the current hold-timer so a fresh
-- shot cancels any pending auto-reset from a previous one. Generation
-- counter prevents a stale task.delay from resetting the camera mid-
-- new-shot.
----------------------------------------------------------------------
local ActiveGeneration = 0
local ActiveOnReset: (() -> ())? = nil

local function bumpGeneration(): number
	ActiveGeneration += 1
	return ActiveGeneration
end

----------------------------------------------------------------------
-- Cue dispatch helper. Resolves dependencies once per call so this
-- module survives a cinematic-controller reload at runtime (Studio
-- iteration). Returns the live CinematicClient or nil.
----------------------------------------------------------------------
local function getClient()
	-- SystemsContainer is the framework-injected sibling map. The
	-- ParentSystems walk handles cases where CinematicCharacter ends
	-- up in a different namespace folder than CinematicClient.
	local client = SystemsContainer.CinematicClient
	if client then return client end
	if SystemsContainer.ParentSystems then
		local effects = SystemsContainer.ParentSystems.Effects
		if effects and effects.CinematicClient then
			return effects.CinematicClient
		end
	end
	return nil
end

----------------------------------------------------------------------
-- Resolve a Model + shot preset into a world-space CameraTo cue
-- argument. Builder-style internal: keeps SetShot's body short and
-- the offset composition order (preset → extra) consistent.
----------------------------------------------------------------------
local function buildCameraToArgs(model: Model, presetName: string, opts: { [string]: any }?): { [string]: any }?
	if not model or not model:IsA('Model') then return nil end
	local pivot = model:GetPivot()
	local shot = CinematicPresets.ResolveShot(presetName)
	-- ExtraCFrame is composed *after* the preset offset so authors
	-- can think of it as "additional framing relative to the shot's
	-- viewpoint." e.g. `ExtraCFrame = CFrame.new(0, 0.5, 0)` raises
	-- the camera 0.5 studs above whatever the preset chose.
	local offset = shot.Offset
	if opts and typeof(opts.ExtraCFrame) == 'CFrame' then
		offset = offset * opts.ExtraCFrame
	end
	local lerp = (opts and opts.Lerp) or shot.Lerp
	if opts and opts.Snap == true then
		lerp = SNAP_LERP_SECONDS
	end
	return {
		Anchor   = 'world',
		Position = pivot * offset,
		Lerp     = math.max(SNAP_LERP_SECONDS, lerp),
	}
end

----------------------------------------------------------------------
-- Public API.
----------------------------------------------------------------------

-- Generic shot-set. Every named helper below is a thin call into
-- this; SetShot can also reach presets the helpers don't wrap.
function Module.SetShot(model: Model, presetName: string, opts: { [string]: any }?)
	local client = getClient()
	if not client then
		warn('CinematicCharacter.SetShot: CinematicClient unavailable')
		return
	end

	local args = buildCameraToArgs(model, presetName, opts)
	if not args then return end

	-- Cancel any in-flight auto-reset before starting a new shot.
	-- The previous OnReset (if any) is called so cleanup hooks
	-- (locking, UI fades) get notified that the shot is being
	-- replaced rather than naturally ending.
	if ActiveOnReset then
		local prev = ActiveOnReset
		ActiveOnReset = nil
		task.spawn(prev)
	end
	local generation = bumpGeneration()

	client.PlayCue(CinematicShared.CueKind.CameraTo, args)

	-- Locks. Apply when set; the matching restore runs on Reset() or
	-- when the auto-reset fires below.
	if opts and (opts.LockMovement == true or opts.LockHUD == true) then
		client.ApplyLocks(opts.LockMovement == true, opts.LockHUD == true)
	end

	if opts and typeof(opts.Hold) == 'number' and opts.Hold > 0 then
		ActiveOnReset = opts.OnReset
		task.delay(opts.Hold, function()
			-- Bail if a newer shot superseded this one; cancellation
			-- is silent because SetShot already invoked the prior
			-- OnReset.
			if generation ~= ActiveGeneration then return end
			Module.Reset()
		end)
	else
		ActiveOnReset = opts and opts.OnReset or nil
	end
end

-- Reset the camera to the default Roblox-controlled mode. Releases
-- locks and invokes the active OnReset hook (if any). Idempotent —
-- calling Reset on an already-default camera is a cheap no-op.
function Module.Reset()
	local client = getClient()
	if not client then return end
	bumpGeneration()
	client.PlayCue(CinematicShared.CueKind.CameraReset, {})
	client.ApplyLocks(false, false)
	if ActiveOnReset then
		local cb = ActiveOnReset
		ActiveOnReset = nil
		task.spawn(cb)
	end
end

----------------------------------------------------------------------
-- Named shot helpers. Each one is the single line a gameplay
-- programmer wants to write — `Cinematic.OverTheShoulderSwitch(npc)`
-- reads at the call-site without a string-typed second arg.
----------------------------------------------------------------------
function Module.OverTheShoulderSwitch(model: Model, opts: { [string]: any }?)
	Module.SetShot(model, 'over_shoulder', opts)
end

function Module.Closeup(model: Model, opts: { [string]: any }?)
	Module.SetShot(model, 'closeup', opts)
end

function Module.LowHero(model: Model, opts: { [string]: any }?)
	Module.SetShot(model, 'low_hero', opts)
end

function Module.WideEstablishing(model: Model, opts: { [string]: any }?)
	Module.SetShot(model, 'wide_establishing', opts)
end

function Module.ProfileLeft(model: Model, opts: { [string]: any }?)
	Module.SetShot(model, 'profile_left', opts)
end

function Module.ProfileRight(model: Model, opts: { [string]: any }?)
	Module.SetShot(model, 'profile_right', opts)
end

function Module.SnapClose(model: Model, opts: { [string]: any }?)
	-- snap_close preset already has a tight Lerp; merging Snap=true
	-- via the opts pipe forces the SNAP_LERP_SECONDS path so the cut
	-- is always 1-frame regardless of the preset's authored value.
	local merged: { [string]: any } = { Snap = true }
	if opts then
		for k, v in opts do merged[k] = v end
		-- Allow caller to opt out of Snap via opts.Snap=false.
		if opts.Snap == false then merged.Snap = false end
	end
	Module.SetShot(model, 'snap_close', merged)
end

----------------------------------------------------------------------
-- Self-target helpers. Useful for player-perspective beats — frame
-- *the local player* with one of the named shots without needing
-- to fetch their character every call.
----------------------------------------------------------------------
local function localCharacter(): Model?
	return LocalPlayer.Character
end

function Module.SelfShot(presetName: string, opts: { [string]: any }?)
	local char = localCharacter()
	if not char then return end
	Module.SetShot(char, presetName, opts)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

function Module.Start()
	-- No bound input or render loop here — this module is purely
	-- API. Reset on local player respawn so a death mid-shot doesn't
	-- leave the camera stuck pointing at the previous body.
	LocalPlayer.CharacterAdded:Connect(function()
		Module.Reset()
	end)
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Effects/CinematicClient.luau"><![CDATA[-- Cinematic client — owns the camera state machine and per-cue rendering.
-- Receives cue cues over CinematicEvent and dispatches by Kind. The camera
-- has two orthogonal channels:
--   * BASE mode (Default | Tracking | Orbiting | LerpTo)
--   * SHAKE channel (additive perlin offset on top of base)
--
-- A `CameraTo`/`CameraTrack` switches the base mode; `CameraShake` writes
-- shake parameters that decay over `Duration`. RenderStepped composes both
-- into the final camera.CFrame.
--
-- Public API used by other systems (Dialogue, Cinematic, etc.):
--   Module.PlayCue(kind, args)        — direct dispatch (e.g. dialogue lines
--                                       embed cues without a full cinematic)

local UserInputService = game:GetService('UserInputService')
local RunService       = game:GetService('RunService')
local Players          = game:GetService('Players')
local Debris           = game:GetService('Debris')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local CinematicShared = ReplicatedModules.Services.CinematicShared
local SoundService    = ReplicatedModules.Services.SoundService
local RemoteService   = ReplicatedModules.Services.RemoteService

local CinematicEvent = RemoteService.GetRemote('CinematicEvent', 'RemoteEvent', false)

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Camera state.
----------------------------------------------------------------------
local CameraMode: 'Default' | 'LerpTo' | 'Track' | 'Orbit' = 'Default'
local CameraTarget: CFrame? = nil               -- LerpTo destination
local CameraLerpAlpha = 0                        -- 0..1 progress toward CameraTarget
local CameraLerpSpeed = 1.0                      -- per-second
local CameraTrackInstance: Instance? = nil
local CameraOrbitParams = { Radius = 16, Speed = 1, Pitch = -0.3 }
local CameraOrbitT = 0

-- Shake channel.
local Shake = {
	Active = false,
	Magnitude = 0, Roughness = 5, Duration = 0,
	StartTime = 0, FadeIn = 0, FadeOut = 0,
}

-- Lock state — driven by Begin/End cinematic events.
local MovementLocked = false
local HUDLocked = false
local SkipKeyCode: Enum.KeyCode? = nil
local ActiveCinematicId: string? = nil

----------------------------------------------------------------------
-- Per-cue dispatch.
----------------------------------------------------------------------
local DispatchTable = {} :: { [string]: (args: { [string]: any }) -> () }

DispatchTable[CinematicShared.CueKind.CameraTo] = function(args)
	local lerp = args.Lerp or 0.6
	local target: CFrame? = nil
	if args.Anchor == 'instance' and args.InstancePath then
		local inst = CinematicShared.ResolveInstancePath(args.InstancePath)
		if inst then
			-- PVInstance is the abstract base for Model + BasePart, both
			-- of which have :GetPivot(). Testing for the method via
			-- `:GetPivot and ...` is invalid Luau (method-call syntax
			-- can't reference without invoking), so use IsA gates.
			local offset = args.Offset or CFrame.new(0, 4, 8)
			if inst:IsA('PVInstance') then
				target = (inst :: PVInstance):GetPivot() * offset
			end
		end
	elseif args.Anchor == 'world' and args.Position then
		target = args.Position
	end
	if not target then return end
	CameraMode = 'LerpTo'
	CameraTarget = target
	CameraLerpAlpha = 0
	CameraLerpSpeed = math.max(0.05, lerp)
	CameraTrackInstance = nil
end

DispatchTable[CinematicShared.CueKind.CameraTrack] = function(args)
	local inst = args.InstancePath and CinematicShared.ResolveInstancePath(args.InstancePath)
	if not inst then return end
	CameraMode = 'Track'
	CameraTrackInstance = inst
	CameraOrbitParams.Radius = args.OrbitRadius or 16
	CameraOrbitParams.Speed  = args.OrbitSpeed or 0
	CameraOrbitParams.Pitch  = args.Pitch or -0.3
	CameraOrbitT = 0
	CameraMode = 'Orbit'
end

DispatchTable[CinematicShared.CueKind.CameraShake] = function(args)
	Shake.Active   = true
	Shake.Magnitude = args.Magnitude or 0.4
	Shake.Roughness = args.Roughness or 4
	Shake.Duration  = args.Duration or 0.4
	Shake.FadeIn    = args.FadeIn or 0.05
	Shake.FadeOut   = args.FadeOut or 0.2
	Shake.StartTime = os.clock()
end

DispatchTable[CinematicShared.CueKind.CameraReset] = function()
	CameraMode = 'Default'
	CameraTarget = nil
	CameraTrackInstance = nil
	local cam = workspace.CurrentCamera
	if cam then cam.CameraType = Enum.CameraType.Custom end
end

DispatchTable[CinematicShared.CueKind.PlaySFX] = function(args)
	if not args.Sound then return end
	local pos = args.Position
	if typeof(pos) ~= 'Vector3' then
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild('HumanoidRootPart')
		pos = hrp and (hrp :: BasePart).Position or workspace.CurrentCamera.CFrame.Position
	end
	SoundService.PlaySoundAtPosition(args.Sound, pos, args.Pitch)
end

-- Build a procedural placeholder ParticleEmitter so test surfaces produce
-- something visible even when the authored template is missing from
-- ReplicatedStorage.AssetsShared.VFX. Each preset name picks a hue so the
-- tester can tell `slash_burst` apart from `dust_poof` at a glance — purely
-- a debug affordance; once real assets land, this branch never runs.
local FALLBACK_VFX_COLORS: { [string]: Color3 } = {
	SlashBurst   = Color3.fromRGB(255, 230, 140),
	HitSpark     = Color3.fromRGB(255, 170,  80),
	DustPoof     = Color3.fromRGB(180, 160, 120),
	SmokePillar  = Color3.fromRGB(120, 120, 140),
	RuneCircle   = Color3.fromRGB(160, 120, 255),
	ScreenFlash  = Color3.fromRGB(255, 255, 255),
}
local function buildFallbackEmitter(templateName: string?, parent: Attachment)
	local emitter = Instance.new('ParticleEmitter')
	emitter.Name = 'FallbackVFX'
	local color = (templateName and FALLBACK_VFX_COLORS[templateName])
		or Color3.fromRGB(255, 200, 240)  -- magenta-pink: "missing asset" tint
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 0.7
	emitter.LightInfluence = 0
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.4),
		NumberSequenceKeypoint.new(0.5, 1.6),
		NumberSequenceKeypoint.new(1, 0.2),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime = NumberRange.new(0.5, 1.0)
	emitter.Rate = 0  -- one-shot only — Emit() below
	emitter.Speed = NumberRange.new(8, 14)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-180, 180)
	emitter.Texture = 'rbxasset://textures/particles/sparkles_main.dds'
	emitter.Parent = parent
	emitter:Emit(45)
	return emitter
end

DispatchTable[CinematicShared.CueKind.PlayVFX] = function(args)
	print(string.format('[CinematicClient] PlayVFX cue: template=%s anchor=%s instancePath=%s',
		tostring(args.TemplateName), tostring(args.Anchor), tostring(args.InstancePath)))

	local templateRoot = ReplicatedStorage:FindFirstChild('AssetsShared')
	templateRoot = templateRoot and templateRoot:FindFirstChild('VFX')
	local template = templateRoot and args.TemplateName and templateRoot:FindFirstChild(args.TemplateName, true)

	-- Resolve spawn position. Priority:
	--   1. Resolved instance path (when Anchor='instance')
	--   2. Explicit Position arg (when Anchor='world')
	--   3. Local player's HumanoidRootPart (the test surface always lands here)
	--   4. Camera CFrame (last-resort fallback for headless contexts)
	local pivot: CFrame
	local pivotSource: string
	if args.Anchor == 'instance' and args.InstancePath then
		local inst = CinematicShared.ResolveInstancePath(args.InstancePath)
		if inst and (inst :: any):IsA('BasePart') then
			pivot = (inst :: BasePart).CFrame
			pivotSource = 'instance(BasePart):' .. args.InstancePath
		elseif inst and inst:IsA('Model') then
			pivot = (inst :: Model):GetPivot()
			pivotSource = 'instance(Model):' .. args.InstancePath
		end
	end
	if not pivot and args.Position then
		pivot = typeof(args.Position) == 'CFrame' and args.Position or CFrame.new(args.Position)
		pivotSource = 'arg.Position'
	end
	if not pivot then
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild('HumanoidRootPart')
		if hrp and hrp:IsA('BasePart') then
			pivot = (hrp :: BasePart).CFrame
			pivotSource = 'localPlayer.HRP'
		end
	end
	if not pivot then
		pivot = workspace.CurrentCamera and workspace.CurrentCamera.CFrame or CFrame.new()
		pivotSource = 'camera'
	end

	-- Always create an Attachment in workspace.Terrain at the resolved pivot.
	-- ParticleEmitters / Beams / Trails / PointLights need a BasePart-or-
	-- Attachment parent to actually emit, so a free-floating Terrain
	-- Attachment is the most universal mount point. Author intent ("move
	-- attachments to move particles") is now natural — clone is reparented
	-- under this anchor.
	local anchor = Instance.new('Attachment')
	anchor.Name = 'CinematicVFX_' .. tostring(args.TemplateName or 'unknown')
	anchor.Parent = workspace.Terrain
	anchor.WorldCFrame = pivot
	Debris:AddItem(anchor, args.Duration or 3)

	print(string.format('[CinematicClient] VFX anchor at %s pivotSource=%s pos=(%.1f, %.1f, %.1f)',
		anchor:GetFullName(), pivotSource, pivot.Position.X, pivot.Position.Y, pivot.Position.Z))

	if not template then
		-- No authored template — spawn the procedural placeholder so the
		-- tester sees *something* and the AssetsShared.VFX missing-folder
		-- case is visually obvious.
		warn(string.format(
			'[CinematicClient] no VFX template %q under ReplicatedStorage.AssetsShared.VFX — using procedural fallback. Author the template to silence this warning.',
			tostring(args.TemplateName)))
		buildFallbackEmitter(args.TemplateName, anchor)
		return
	end

	print(string.format('[CinematicClient] VFX template found: %s (class=%s)',
		template:GetFullName(), template.ClassName))

	-- Reparent the clone under the anchor. For Attachment-typed templates,
	-- hoist their children into our anchor (Roblox doesn't allow nesting
	-- Attachments — children must be on a BasePart-or-Attachment parent,
	-- and our anchor IS the attachment). For everything else, parent the
	-- clone directly under the anchor; particle/light/etc. classes accept
	-- Attachments as parents and emit from the attachment's world position.
	local clone = template:Clone()
	if clone:IsA('Attachment') then
		for _, child in clone:GetChildren() do
			child.Parent = anchor
		end
		clone:Destroy()
	elseif clone:IsA('Model') then
		-- Models can't parent under an Attachment. Pivot it to the anchor's
		-- world position and parent to Terrain so it cleans up alongside
		-- the anchor (Debris on the anchor only kills the anchor — give
		-- the model its own Debris timer).
		clone:PivotTo(pivot)
		clone.Parent = workspace.Terrain
		Debris:AddItem(clone, args.Duration or 3)
	elseif clone:IsA('BasePart') then
		clone.CFrame = pivot
		clone.Parent = workspace.Terrain
		Debris:AddItem(clone, args.Duration or 3)
	else
		-- ParticleEmitter / Beam / Trail / PointLight / Sound / etc.
		-- Parent under the attachment so they emit at the anchor.
		clone.Parent = anchor
		-- One-shot emitter classes need an explicit Emit() to fire when
		-- their Rate is 0 (which is the typical authored shape). Best-
		-- effort — pcall protects against classes without :Emit().
		if clone:IsA('ParticleEmitter') then
			pcall(function() (clone :: ParticleEmitter):Emit(50) end)
		end
	end
end

DispatchTable[CinematicShared.CueKind.ShowLabel] = function(args)
	local CinematicLabels = SystemsContainer.CinematicLabels
		or (SystemsContainer.ParentSystems and SystemsContainer.ParentSystems.Effects
		    and SystemsContainer.ParentSystems.Effects.CinematicLabels)
	if not CinematicLabels then return end
	-- Use the high-level CinematicTopWhite / CinematicBottomWhite helpers,
	-- not AppendCinematic directly — AppendCinematic's first arg is a
	-- CinematicFrame ref (TopFrame / BottomFrame), not a title string.
	if args.Anchor == 'top' or args.Anchor == nil then
		if CinematicLabels.CinematicTopWhite then
			CinematicLabels.CinematicTopWhite(args.Title or '', args.Subtitle or '')
		end
	else
		if CinematicLabels.CinematicBottomWhite then
			CinematicLabels.CinematicBottomWhite(args.Title or '', args.Subtitle or '')
		end
	end
end

DispatchTable[CinematicShared.CueKind.HideLabel] = function()
	-- CinematicLabels has its own auto-fade; explicit hide is a hint, not a hard requirement.
end

DispatchTable[CinematicShared.CueKind.WaitFor] = function() end

DispatchTable[CinematicShared.CueKind.StartDialogue] = function(args)
	local Dialogue = SystemsContainer.DialogueWidget
		or (SystemsContainer.ParentSystems and SystemsContainer.ParentSystems.Widgets
		    and SystemsContainer.ParentSystems.Widgets.DialogueWidget)
	if Dialogue and Dialogue.RequestStart then
		Dialogue.RequestStart(args.DialogueId, args.NPCInstancePath)
	end
end

----------------------------------------------------------------------
-- Public direct-dispatch entry point (used by DialogueClient etc.)
----------------------------------------------------------------------
function Module.PlayCue(kind: string, args: { [string]: any }?)
	local fn = DispatchTable[kind]
	if not fn then
		warn(string.format('[CinematicClient] PlayCue: no dispatcher for kind %q', tostring(kind)))
		return
	end
	fn(args or {})
end

-- Forward declarations so the public API below can refer to the
-- locks helper before its definition (it lives near the other
-- private functions, and Lua local-function ordering matters for
-- closures captured at module-load time).
local applyLocks

-- Public lock-toggle. CinematicCharacter (runtime shot API) drives
-- locks for hold-style shots without needing to author a full
-- cinematic envelope.
function Module.ApplyLocks(lockMovement: boolean, lockHUD: boolean)
	applyLocks(lockMovement, lockHUD)
end

----------------------------------------------------------------------
-- HUD/movement lock.
----------------------------------------------------------------------
local PlayerControls
local function getControls()
	if PlayerControls then return PlayerControls end
	local ok, mod = pcall(function()
		return require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('PlayerModule'))
	end)
	if ok and mod and mod.GetControls then
		PlayerControls = mod:GetControls()
	end
	return PlayerControls
end

function applyLocks(lockMovement: boolean, lockHUD: boolean)
	MovementLocked = lockMovement
	HUDLocked = lockHUD
	local controls = getControls()
	if controls then
		if lockMovement then controls:Disable() else controls:Enable() end
	end
	-- HUD fade — best-effort; if HUDCommon doesn't expose a master fade,
	-- this no-ops and the HUD stays visible. (Adding a master fade is a
	-- future polish; the cinematic itself still works.)
	if typeof(HUDCommon.SetHUDLocked) == 'function' then
		HUDCommon.SetHUDLocked(lockHUD)
	end
end

----------------------------------------------------------------------
-- RenderStepped composition.
----------------------------------------------------------------------
local function computeShakeOffset(now: number): CFrame
	if not Shake.Active then return CFrame.identity end
	local elapsed = now - Shake.StartTime
	if elapsed >= Shake.Duration then
		Shake.Active = false
		return CFrame.identity
	end
	local env = 1
	if elapsed < Shake.FadeIn then env = elapsed / math.max(Shake.FadeIn, 1e-3)
	elseif elapsed > (Shake.Duration - Shake.FadeOut) then
		env = math.max(0, (Shake.Duration - elapsed) / math.max(Shake.FadeOut, 1e-3))
	end
	-- Perlin sampled at three offset axes so X/Y/Z move independently.
	local r = Shake.Roughness
	local n = function(seed) return (math.noise(elapsed * r, seed) * 2) end
	local m = Shake.Magnitude * env
	return CFrame.new(n(0) * m, n(0.37) * m, n(0.91) * m)
		* CFrame.Angles(n(1.3) * m * 0.05, n(2.1) * m * 0.05, n(2.9) * m * 0.05)
end

local function step(dt: number)
	local cam = workspace.CurrentCamera
	if not cam then return end

	local now = os.clock()
	local shakeOffset = computeShakeOffset(now)

	if CameraMode == 'LerpTo' and CameraTarget then
		cam.CameraType = Enum.CameraType.Scriptable
		CameraLerpAlpha = math.min(1, CameraLerpAlpha + dt / CameraLerpSpeed)
		local t = CameraLerpAlpha * CameraLerpAlpha * (3 - 2 * CameraLerpAlpha)  -- smoothstep
		cam.CFrame = cam.CFrame:Lerp(CameraTarget, t) * shakeOffset
	elseif CameraMode == 'Orbit' and CameraTrackInstance then
		cam.CameraType = Enum.CameraType.Scriptable
		CameraOrbitT = CameraOrbitT + dt * CameraOrbitParams.Speed
		local target: CFrame
		if CameraTrackInstance:IsA('BasePart') then
			target = CameraTrackInstance.CFrame
		elseif CameraTrackInstance:IsA('Model') then
			target = (CameraTrackInstance :: Model):GetPivot()
		else
			target = cam.CFrame
		end
		local r = CameraOrbitParams.Radius
		local p = CameraOrbitParams.Pitch
		local x = math.cos(CameraOrbitT) * r
		local z = math.sin(CameraOrbitT) * r
		local eye = target.Position + Vector3.new(x, math.sin(p) * r, z)
		cam.CFrame = CFrame.lookAt(eye, target.Position) * shakeOffset
	elseif Shake.Active and CameraMode == 'Default' then
		-- Default camera + additive shake. Re-target every frame to avoid
		-- drifting away from where Roblox's default camera "wants" to be.
		cam.CFrame = cam.CFrame * shakeOffset
	end
end

----------------------------------------------------------------------
-- Module lifecycle.
----------------------------------------------------------------------
function Module.Start()
	RunService.RenderStepped:Connect(step)

	CinematicEvent.OnClientEvent:Connect(function(action, ...)
		if action == CinematicShared.CinematicActions.Begin then
			local cinematicId, blob = ...
			ActiveCinematicId = cinematicId
			-- SkipKeyCode arrives as the EnumItem's numeric .Value (e.g. 27
			-- for Escape). Reconstruct via CinematicShared.EnumItemFromValue —
			-- Enum.KeyCode is name-indexable only, so Enum.KeyCode[27] errors.
			SkipKeyCode = blob and blob.SkipKeyCode
				and CinematicShared.EnumItemFromValue(Enum.KeyCode, blob.SkipKeyCode)
				or nil
			applyLocks((blob and blob.LockMovement) == true, (blob and blob.LockHUD) == true)
		elseif action == CinematicShared.CinematicActions.Cue then
			local _cueIdx, kind, args = ...
			Module.PlayCue(kind, args)
		elseif action == CinematicShared.CinematicActions.End then
			ActiveCinematicId = nil
			SkipKeyCode = nil
			-- Restore camera + locks.
			DispatchTable[CinematicShared.CueKind.CameraReset]({})
			applyLocks(false, false)
		end
	end)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if SkipKeyCode and input.KeyCode == SkipKeyCode and ActiveCinematicId then
			CinematicEvent:FireServer(CinematicShared.CinematicActions.Skip)
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Effects/CinematicLabels.luau"><![CDATA[-- Full-screen cinematic title/description bars (top + bottom).
-- Fusion-generated ScreenGui replaces the legacy GameInterface.CinematicTop/Bottom template.
-- Public API preserved: CinematicTopWhite, CinematicBottomWhite, AppendCinematic.
--
-- Layout strategy (see .claude/skills/custom-roblox-ui/SKILL.md §8):
-- The block is a top-level HUD element, so it's Scale-sized + aspect-
-- locked (FitWithinMaxSize) — keeps its 6:1 design shape on every aspect.
-- Children fill the locked parent via scale-1 width + pixel-height rows
-- (skill §3 "stack of pixel-exact atoms").

local DESIGN_SCREEN_W, DESIGN_SCREEN_H = 1920, 1080
local DESIGN_BLOCK_W, DESIGN_BLOCK_H   = 720, 120
local DESIGN_DIVIDER_W = 180

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local TweenService = game:GetService('TweenService')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local doCleanup = Fusion.doCleanup

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE = HUDCommon.PALETTE

local SystemsContainer = {}

local CinematicsQueue = {}

local TI = TweenInfo.new(1)

-- Fusion-built refs (built once during Start).
local RootScope = nil
local ScreenGui = nil

type CinematicFrame = {
	Frame: Frame,
	Title: TextLabel,
	Description: TextLabel,
	Divider: Frame,
}

local TopFrame: CinematicFrame = nil :: any
local BottomFrame: CinematicFrame = nil :: any

local function buildCinematicBlock(scope, anchor: 'top' | 'bottom'): CinematicFrame
	local position = anchor == 'top'
		and UDim2.new(0.5, 0, 0.18, 0)
		or  UDim2.new(0.5, 0, 0.82, 0)

	local title: TextLabel
	local description: TextLabel
	local divider: Frame

	local frame = scope:New('Frame') {
		Name = anchor == 'top' and 'CinematicTop' or 'CinematicBottom',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position,
		-- Scale + aspect-lock: the block keeps its 720:120 (6:1) shape
		-- on every screen, instead of staying 720 px on a 1080p monitor
		-- and looking tiny on a 4K monitor. UIScale at the master HUD
		-- still applies on top per the "On-screen buttons"-style
		-- toggle, but the base size now scales with the screen too.
		Size = UDim2.fromScale(DESIGN_BLOCK_W / DESIGN_SCREEN_W, DESIGN_BLOCK_H / DESIGN_SCREEN_H),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = ScreenGui,
		[Fusion.Children] = {
			scope:New('UIAspectRatioConstraint') {
				AspectRatio = DESIGN_BLOCK_W / DESIGN_BLOCK_H,
				AspectType = Enum.AspectType.FitWithinMaxSize,
				DominantAxis = Enum.DominantAxis.Width,
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				Padding = UDim.new(0, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
		},
	}

	title = scope:New('TextLabel') {
		Name = 'Title', LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_DISPLAY,
		TextSize = 34,
		TextColor3 = PALETTE.ink,
		TextTransparency = 1,
		Text = '',
		TextStrokeTransparency = 0.4,
		TextStrokeColor3 = PALETTE.bg0,
		Parent = frame,
	}

	divider = scope:New('Frame') {
		Name = 'Divider', LayoutOrder = 2,
		-- Scale-width within the now-aspect-locked block; pixel height
		-- stays (1-px hairline is a pixel-designed atom per skill §8).
		Size = UDim2.new(DESIGN_DIVIDER_W / DESIGN_BLOCK_W, 0, 0, 1),
		BackgroundColor3 = PALETTE.accent,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = frame,
	}

	description = scope:New('TextLabel') {
		Name = 'Description', LayoutOrder = 3,
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_UI,
		TextSize = 14,
		TextColor3 = PALETTE.inkDim,
		TextTransparency = 1,
		Text = '',
		Parent = frame,
	}

	return {
		Frame = frame,
		Title = title,
		Description = description,
		Divider = divider,
	}
end

local function applyProps(instance, props)
	for k, v in props do instance[k] = v end
end

-- // Module // --
local Module = {}

function Module.RunCinematicLabel(targetFrame: CinematicFrame, titleProps, descriptionProps, holdDuration)
	local frame = targetFrame.Frame
	frame.Visible = true

	applyProps(targetFrame.Title, titleProps)
	applyProps(targetFrame.Description, descriptionProps)

	TweenService:Create(targetFrame.Description, TI, { TextTransparency = 0 }):Play()
	TweenService:Create(targetFrame.Divider, TI, { BackgroundTransparency = 0 }):Play()
	local tween = TweenService:Create(targetFrame.Title, TI, { TextTransparency = 0 })
	tween:Play()
	if tween.PlaybackState ~= Enum.PlaybackState.Completed then
		tween.Completed:Wait()
	end

	task.wait(holdDuration)

	TweenService:Create(targetFrame.Description, TI, { TextTransparency = 1 }):Play()
	TweenService:Create(targetFrame.Divider, TI, { BackgroundTransparency = 1 }):Play()
	tween = TweenService:Create(targetFrame.Title, TI, { TextTransparency = 1 })
	tween:Play()
	if tween.PlaybackState ~= Enum.PlaybackState.Completed then
		tween.Completed:Wait()
	end

	frame.Visible = false
end

function Module.AppendCinematic(
	frame: CinematicFrame, titleText, titleColor, descriptionText, descriptionColor,
	textDuration, priority
): RBXScriptSignal
	local event = Instance.new('BindableEvent')
	table.insert(CinematicsQueue, {
		Frame = frame,
		Title = { Text = titleText, TextColor3 = titleColor },
		Description = { Text = descriptionText, TextColor3 = descriptionColor },
		Duration = textDuration,
		Priority = priority,
		_OnPlayEvent = event,
	})
	return event.Event
end

function Module.CinematicTopWhite(titleText, descriptionText, priority)
	return Module.AppendCinematic(
		TopFrame, titleText, Color3.new(1, 1, 1), descriptionText, Color3.new(1, 1, 1), 2, priority
	)
end

function Module.CinematicBottomWhite(titleText, descriptionText, priority)
	return Module.AppendCinematic(
		BottomFrame, titleText, Color3.new(1, 1, 1), descriptionText, Color3.new(1, 1, 1), 2, priority
	)
end

function Module.OnUpdate()
	table.sort(CinematicsQueue, function(a, b)
		return (a.Priority or 0) < (b.Priority or 0)
	end)

	while #CinematicsQueue > 0 do
		task.wait()
		local data = table.remove(CinematicsQueue, 1)
		if data._OnPlayEvent then
			data._OnPlayEvent:Fire()
		end
		Module.RunCinematicLabel(data.Frame, data.Title, data.Description, data.Duration)
	end
end

function Module.Start()
	ScreenGui = HUDCommon.ensureScreenGui('HUD_Cinematic', 10)
	RootScope = scoped(Fusion)

	TopFrame    = buildCinematicBlock(RootScope, 'top')
	BottomFrame = buildCinematicBlock(RootScope, 'bottom')

	task.defer(function()
		while true do
			Module.OnUpdate()
			task.wait(0.25)
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Effects/DamageIndicator.luau"><![CDATA[local TweenService = game:GetService('TweenService')

local Players = game:GetService('Players')
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local RemoteService = ReplicatedModules.Services.RemoteService
local DamageIndicatorEvent = RemoteService.GetRemote('DamageIndicatorEvent', 'RemoteEvent', false)
local CombatUtility = ReplicatedModules.Utility.CombatUtility

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE = HUDCommon.PALETTE

local SystemsContainer = {}

-- Reference: hud.jsx DmgNumber — crit => gold + larger, heal => success, plain => white.
-- The current server signature only sends (Humanoid, Damage), so crit/kind aren't inferable
-- here. Flag a crit heuristically when the damage is large (>= 50) to approximate the
-- visual pop from the mockup without changing the remote contract.
local function styleForDamage(damage: number): (Color3, number, boolean)
	local isCrit = damage >= 50
	if isCrit then
		return PALETTE.gold, 34, true
	end
	return PALETTE.ink, 22, false
end

-- // Module // --
local Module = {}

function Module.OnDamageIndicator( Humanoid, Damage )

	-- Batched form: server collapsed N hits per swing into one FireAllClients
	-- carrying a flat {humanoid, damage, humanoid, damage, ...} array. Detect
	-- by typeof — single-hit callers (status ticks, companion shots) still send
	-- (Humanoid, Damage) and land in the legacy path below.
	if typeof(Humanoid) == 'table' then
		local buffer = Humanoid
		for i = 1, #buffer, 2 do
			local h = buffer[i]
			local d = buffer[i + 1]
			if typeof(h) == 'Instance' and typeof(d) == 'number' then
				Module.OnDamageIndicator(h, d)
			end
		end
		return
	end

	local Position = Humanoid.Parent:GetPivot().Position

	local Att = Instance.new('Attachment')
	Att.Name = Humanoid:GetFullName()
	Att.WorldCFrame = CFrame.new( Position )
	Att.Parent = workspace.Terrain

	local color, textSize, isCrit = styleForDamage(Damage)

	local billboard = Instance.new('BillboardGui')
	billboard.Name = 'DamageIndicator'
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.Size = UDim2.fromScale(3, 1)
	billboard.MaxDistance = 160
	billboard.Enabled = true

	local label = Instance.new('TextLabel')
	label.Name = 'Label'
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.FontFace = HUDCommon.FONT_DISPLAY
	label.TextSize = textSize
	label.TextColor3 = color
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0.2
	-- Formatted rather than tostring()'d. DamageModule already rounds, but
	-- this remote is also fired directly by status ticks, skills and world
	-- hazards, and a raw tostring on an unrounded float32 delta renders as
	-- '13.699999809265137' across the screen.
	local damageText = CombatUtility.FormatCombatNumber(Damage)
	label.Text = isCrit and (damageText .. '!') or damageText
	label.Parent = billboard

	billboard.Parent = Att

	task.delay(1.5, function()
		for alpha = 1, 0, -0.05 do
			billboard.Size = UDim2.fromScale( 3 * alpha, alpha )
			Att.WorldCFrame *= CFrame.new(0, 0.05, 0)
			task.wait()
		end
		Att:Destroy()
	end)

end

function Module.Start()

	DamageIndicatorEvent.OnClientEvent:Connect(Module.OnDamageIndicator)

end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Effects/EnemyTelegraphClient.luau"><![CDATA[-- EnemyTelegraphClient — renders the "red outline + progress bar" for
-- enemy attack windups. Subscribes to EnemyTelegraphEvent (Show / Hide
-- actions) and builds an anchored, non-collidable ground plane part
-- with a SurfaceGui showing a horizontal progress bar that fills over
-- the windup duration.
--
-- Visual design (World Zero / Dungeon Heroes feel):
--   * Translucent red FILL covering the full hit volume.
--   * Brighter red OUTLINE so the edge of the danger zone reads at a
--     glance even when the fill blends with the terrain.
--   * Progress bar pinned at the top of the volume's SurfaceGui,
--     filling from 0 → 1 over Duration. When it reaches 1.0 the damage
--     applies and the telegraph despawns (or earlier if Hide is fired).
--
-- Shape primitives (matches the Kind enum on the server):
--   * Circle — a flat thin Part disc-shaped via UICorner on the
--               SurfaceGui (full-circle corner radius). Sized by Radius.
--   * Rect   — flat Part with X = width, Z = length. The Origin
--               CFrame's LookVector aligns the Z axis with the
--               attacker's facing.
--   * Cone   — same primitive as Rect, sized by `Radius * 2`-wide ×
--               `Radius`-deep, with a triangular UI mask cut into the
--               SurfaceGui. Reasonable approximation; future polish
--               can switch to a custom mesh.
--
-- The Part lives under a single dedicated folder under workspace
-- (workspace.EnemyTelegraphFX) so it can be cleared en-masse on
-- session end / level transitions without scanning workspace.

local Players = game:GetService('Players')
local RunService = game:GetService('RunService')
local Debris = game:GetService('Debris')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local RemoteService = ReplicatedModules.Services.RemoteService
local EnemyTelegraph = ReplicatedModules.Services.EnemyTelegraph

local TelegraphEvent = RemoteService.GetRemote('EnemyTelegraphEvent', 'RemoteEvent', false)

local Module = {}

-- Active telegraphs by id → { part, fillFrame, startedAt, duration }.
-- Heartbeat ticks the fill width per active entry; on duration-elapsed
-- the entry self-cleans up (in addition to the explicit Hide path).
local Active: { [string]: any } = {}

local function getFolder(): Folder
	local existing = workspace:FindFirstChild('EnemyTelegraphFX')
	if existing and existing:IsA('Folder') then return existing end
	local f = Instance.new('Folder')
	f.Name = 'EnemyTelegraphFX'
	f.Parent = workspace
	return f
end

----------------------------------------------------------------------
-- Build helpers per shape.
----------------------------------------------------------------------
local function buildPlanePart(): Part
	local part = Instance.new('Part')
	-- Thin disc/box hugging the ground. Flat enough that the player's
	-- feet don't visibly intersect, opaque enough to read.
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CastShadow = false
	part.Transparency = 1  -- visual is on the SurfaceGui, not the part
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	return part
end

local function buildSurfaceGui(part: Part, color: Color3, isCircle: boolean): SurfaceGui
	local sg = Instance.new('SurfaceGui')
	sg.Face = Enum.NormalId.Top
	sg.AlwaysOnTop = true  -- read through foliage / decals
	sg.LightInfluence = 0
	sg.Brightness = 1.5
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 32
	sg.Parent = part

	-- Fill — translucent red.
	local fill = Instance.new('Frame')
	fill.Name = 'Fill'
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = color
	fill.BackgroundTransparency = 0.55
	fill.BorderSizePixel = 0
	fill.Parent = sg

	-- Outline — UIStroke for the edge.
	local stroke = Instance.new('UIStroke')
	stroke.Color = color
	stroke.Thickness = 4
	stroke.Transparency = 0
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = fill

	if isCircle then
		-- Round the fill into a disc. UICorner with a 50% radius on a
		-- square SurfaceGui draws a circle. (We make the part's X = Z
		-- = diameter to keep the fill square.)
		local corner = Instance.new('UICorner')
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = fill
	end

	return sg
end

local function buildProgressBar(parent: SurfaceGui, color: Color3): Frame
	-- World-space progress bar. Same SurfaceGui plane as the fill so
	-- it reads as part of the danger-zone decal rather than screen UI.
	--
	-- Track placement: y position 1 + negative-Y Size — the
	-- "anchor-top, push-to-bottom, grow-upward" trick. The track
	-- sits at the BOTTOM edge of the SurfaceGui (relative to local
	-- coords) and extends 10% of the surface height UPWARD from
	-- there. From above the part this reads as the bar being on
	-- the OPPOSITE edge from the previous top-edge placement; flips
	-- the bar's apparent direction from bottom-to-top to top-to-bottom.
	local barTrack = Instance.new('Frame')
	barTrack.Name = 'BarTrack'
	barTrack.AnchorPoint = Vector2.new(0.5, 0)
	barTrack.Position = UDim2.fromScale(0.5, 1)
	barTrack.Size = UDim2.new(0.85, 0, -0.10, 0)
	barTrack.BackgroundColor3 = Color3.new(0, 0, 0)
	barTrack.BackgroundTransparency = 0.4
	barTrack.BorderSizePixel = 0
	barTrack.ZIndex = 2
	barTrack.Parent = parent

	local trackStroke = Instance.new('UIStroke')
	trackStroke.Color = color
	trackStroke.Thickness = 2
	trackStroke.Transparency = 0.2
	trackStroke.Parent = barTrack

	local fill = Instance.new('Frame')
	fill.Name = 'BarFill'
	fill.Size = UDim2.fromScale(-0, 1)  -- starts at 0; ticked by Heartbeat
	fill.Position = UDim2.fromScale(1, 0)
	fill.BackgroundColor3 = color
	fill.BackgroundTransparency = 0
	fill.BorderSizePixel = 0
	fill.ZIndex = 3
	fill.Parent = barTrack

	return fill
end

----------------------------------------------------------------------
-- Show.
----------------------------------------------------------------------
local function show(payload)
	if typeof(payload) ~= 'table' or typeof(payload.Id) ~= 'string' then return end
	-- Replace any prior telegraph with the same id (rare; defensive).
	if Active[payload.Id] then
		Active[payload.Id].part:Destroy()
		Active[payload.Id] = nil
	end

	local kind = payload.Kind or EnemyTelegraph.Kinds.Circle
	local color = payload.Color or EnemyTelegraph.Defaults.Color
	local barColor = EnemyTelegraph.Defaults.BarColor
	local origin = payload.Origin
	if typeof(origin) ~= 'CFrame' then return end
	local duration = math.max(0.05, tonumber(payload.Duration) or 0.5)

	local part = buildPlanePart()
	part.Color = color

	-- Shape sizing.
	local thickness = 0.2  -- thin disc / pad
	if kind == EnemyTelegraph.Kinds.Circle then
		local radius = math.max(0.5, tonumber(payload.Radius) or 4)
		part.Size = Vector3.new(radius * 2, thickness, radius * 2)
	elseif kind == EnemyTelegraph.Kinds.Rect then
		local size = payload.Size or Vector3.new(4, thickness, 8)
		part.Size = Vector3.new(math.max(0.5, size.X), thickness, math.max(0.5, size.Z))
	elseif kind == EnemyTelegraph.Kinds.Cone then
		-- Approximated as a Rect (radius wide × radius deep with the
		-- attacker at one end). Polishing pass can swap in a fan mesh.
		local radius = math.max(0.5, tonumber(payload.Radius) or 6)
		part.Size = Vector3.new(radius * 1.6, thickness, radius)
	else
		-- Unknown kind; skip silently.
		part:Destroy()
		return
	end

	-- Flatten the origin's facing onto the horizontal plane. The server
	-- typically passes the attacker's `model:GetPivot()` directly —
	-- which can carry pitch/roll on uneven terrain or for ragdolled
	-- models. EnemyTelegraph.HorizontalForward projects + normalizes
	-- with a deterministic fallback for vertical-only pivots.
	local horizLook = EnemyTelegraph.HorizontalForward(origin)
	-- Position: origin's X / Z; Y dropped to foot-level so the disc
	-- sits just above terrain rather than at the model's pivot height
	-- (which is usually mid-torso for humanoid mobs).
	local groundY = origin.Position.Y - 2.5
	local alignedCF = CFrame.new(origin.Position.X, groundY, origin.Position.Z)
		* CFrame.Angles(0, math.atan2(horizLook.X, horizLook.Z), 0)

	-- For Rect/Cone, push the part center forward along the horizontal
	-- LookVector by HALF the part's depth — so the attacker's pivot
	-- sits at the NEAR edge and the visible zone extends forward by
	-- the full depth. (Original geometry: pushing by 0.5*Size centers
	-- the front edge on the pivot, so a Rect of Size.Z=24 with a
	-- pivot at the boar's HRP shows a 24-stud-deep zone *in front*
	-- of the boar.) The server's effectiveOrigin matches this offset
	-- 1:1 so visible == hit.
	if kind == EnemyTelegraph.Kinds.Rect or kind == EnemyTelegraph.Kinds.Cone then
		alignedCF = EnemyTelegraph.ForwardOffset(alignedCF, part.Size.Z * -0.5)
	end
	part.CFrame = alignedCF

	local isCircle = (kind == EnemyTelegraph.Kinds.Circle)
	local sg = buildSurfaceGui(part, color, isCircle)
	local barFill = buildProgressBar(sg, barColor)

	part.Parent = getFolder()

	Active[payload.Id] = {
		part = part,
		barFill = barFill,
		startedAt = os.clock(),
		duration = duration,
	}

	-- Failsafe: if the server forgot to Hide and our Heartbeat falls
	-- behind, Debris cleans up at duration + 0.5s padding.
	Debris:AddItem(part, duration + 0.5)
end

----------------------------------------------------------------------
-- Hide.
----------------------------------------------------------------------
local function hide(payload)
	if typeof(payload) ~= 'table' or typeof(payload.Id) ~= 'string' then return end
	local entry = Active[payload.Id]
	if not entry then return end
	if entry.part then entry.part:Destroy() end
	Active[payload.Id] = nil
end

----------------------------------------------------------------------
-- Heartbeat: tick the bar fill across active telegraphs. Cheap O(N)
-- where N is the active telegraph count (typically 1-3 — number of
-- nearby AI mid-windup).
----------------------------------------------------------------------
local function tickBars()
	local now = os.clock()
	for id, entry in Active do
		if not entry.part or not entry.part.Parent then
			Active[id] = nil
			continue
		end
		local elapsed = now - entry.startedAt
		local frac = math.clamp(elapsed / entry.duration, 0, 1)
		entry.barFill.Size = UDim2.fromScale(-frac, 1)
		if frac >= 1 then
			-- Telegraph completed naturally; clean up. Server may also
			-- send Hide on the same frame — Hide's defensive lookup
			-- handles the already-removed case.
			entry.part:Destroy()
			Active[id] = nil
		end
	end
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	TelegraphEvent.OnClientEvent:Connect(function(action, payload)
		if action == EnemyTelegraph.Actions.Show then
			show(payload)
		elseif action == EnemyTelegraph.Actions.Hide then
			hide(payload)
		end
	end)
	RunService.Heartbeat:Connect(tickBars)
end

function Module.Init() end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Effects/LeaderboardSurfaceClient.luau"><![CDATA[-- LeaderboardSurfaceClient — in-world leaderboard SurfaceGuis.
--
-- Discovery:
--   * Primary: every direct child of `workspace.Leaderboards` (the
--     folder pattern the level layout uses today). Each child's
--     *Name* selects the category via LeaderboardConfig.PartName.
--   * Secondary: every instance with the CollectionService tag
--     'Leaderboards' (matches the reference design; lets a level
--     designer drop a board outside the folder if needed).
--   Both paths feed the same `onTaggedAdded` binder; the _bindings
--   map de-dupes a single instance discovered via both routes.
--
-- Per board:
--   1. Resolve the adornee BasePart (Model → PrimaryPart → first
--      descendant BasePart).
--   2. Destroy any LineHandleAdornments under the part — Studio-only
--      level-design visualizers.
--   3. Build a SurfaceGui with header + scrollable row list +
--      "Updated Xs ago" footer. MaxEntries rows pre-allocated; the
--      refresh just toggles `Visible` and reassigns text on each
--      replicated diff.
--
-- Data source: the public 'Leaderboard' ReplicatedData category
-- (single SetData on the server's Start; mutated in place per cycle).
-- We subscribe to ReplicatedData.OnUpdated and re-render on each
-- publish — independent of PlayerData replication ticks.
--
-- Streaming-aware: bindings are keyed by the *tagged/folder-child*
-- instance (not the resolved BasePart) so a Model streaming in/out
-- fires Add/Remove with the same reference and the binding balances
-- cleanly.

local CollectionService = game:GetService('CollectionService')
local Players = game:GetService('Players')
local Workspace = game:GetService('Workspace')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local ReplicatedData    = ReplicatedModules.Services.ReplicatedData
local LeaderboardConfig = ReplicatedModules.Data.LeaderboardConfig

local LocalPlayer = Players.LocalPlayer
local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon

local TAG               = 'Leaderboards'
local FOLDER_NAME       = 'Leaderboards'
local DEFAULT_FACE      = Enum.NormalId.Front
local SURFACE_GUI_NAME  = 'LeaderboardSurface'
local UPDATED_TICK_SEC  = 30  -- "Updated Xs ago" footer refresh cadence

local Module = {}

----------------------------------------------------------------------
-- Format helpers — value display per category Format. Keep in lockstep
-- with LeaderboardConfig.Categories[*].Format. Pure presentation; the
-- replica payload is always raw integers.
----------------------------------------------------------------------
local function commaFormat(n: number): string
	-- Roblox Lua has no built-in comma-grouping. Reverse → group every
	-- three → reverse back.
	local s = tostring(math.floor(math.abs(n)))
	local rev = s:reverse()
	local grouped = rev:gsub('(%d%d%d)', '%1,')
	local out = grouped:reverse()
	if out:sub(1, 1) == ',' then out = out:sub(2) end
	if n < 0 then out = '-' .. out end
	return out
end

local function formatDuration(secs: number): string
	local total = math.floor(secs)
	local hours = math.floor(total / 3600)
	local minutes = math.floor((total % 3600) / 60)
	return string.format('%d:%02d', hours, minutes)
end

local function formatValue(value: number, format: string?): string
	if format == 'duration' then return formatDuration(value) end
	if format == 'gold'     then return commaFormat(value) .. ' G' end
	return commaFormat(value)
end

----------------------------------------------------------------------
-- Per-binding bookkeeping. Keyed by the tagged Instance so a Model
-- removal cleans up the SurfaceGui (previously a model-keyed entry
-- could leak when only the part was tracked).
----------------------------------------------------------------------
type EntryRow = { userId: number, value: number, name: string? }
-- Per-binding paint refs. Stash every instance whose color we want to
-- live-update on theme change so `repaintBinding` is a flat property
-- write per ref (no tree walk). Atom strokes are tracked by category
-- accent (header / divider / scrollbar / row strokes share the same
-- value) so a single PALETTE.accent reassignment covers the lot.
type Binding = {
	Tagged           : Instance,
	Part             : BasePart,
	Category         : any,
	Gui              : SurfaceGui,
	Rows             : { Frame },
	HeaderLabel      : TextLabel,
	UpdatedLabel     : TextLabel,
	BackgroundFrame  : Frame,
	Divider          : Frame,
	ListFrame        : ScrollingFrame,
	OuterStroke      : UIStroke,
	CornerTicks      : { Frame },
}

local _bindings: { [Instance]: Binding } = {}
local _replicaConn: RBXScriptConnection? = nil

----------------------------------------------------------------------
-- Adornee resolution. Tag may sit on a BasePart OR a Model; for the
-- model case we prefer PrimaryPart, fall back to the first descendant
-- BasePart so designers don't have to wire PrimaryPart.
----------------------------------------------------------------------
local function resolveAdorneePart(inst: Instance): BasePart?
	if inst:IsA('BasePart') then return inst :: BasePart end
	if inst:IsA('Model') then
		local pp = (inst :: Model).PrimaryPart
		if pp then return pp end
		for _, child in inst:GetDescendants() do
			if child:IsA('BasePart') then return child :: BasePart end
		end
	end
	return nil
end

local function resolveFace(part: BasePart): Enum.NormalId
	-- Designers can override per-part with a 'LeaderboardFace' string
	-- attribute (e.g. "Top", "Back"); otherwise default to Front.
	local override = part:GetAttribute('LeaderboardFace')
	if typeof(override) == 'string' then
		local ok, enumItem = pcall(function()
			return (Enum.NormalId :: any)[override]
		end)
		if ok and typeof(enumItem) == 'EnumItem' then
			return enumItem :: Enum.NormalId
		end
	end
	return DEFAULT_FACE
end

local function clearLineHandleAdornments(part: BasePart)
	-- Descendants, not just children: level design sometimes nests a
	-- Folder/Attachment under the part to organize visualizers.
	for _, desc in part:GetDescendants() do
		if desc:IsA('LineHandleAdornment') then desc:Destroy() end
	end
end

----------------------------------------------------------------------
-- Corner-tick atom. Mirrors HUDCommon.cornerTick — the L-shaped
-- accent slash in the corners of every chiseledPanel — so the
-- SurfaceGui visually inherits the widget chrome. We can't call
-- HUDCommon.cornerTick directly because that builds Fusion-scoped
-- nodes; SurfaceGui plates use plain Instance.new for the build
-- side but feed colors from the live palette so theme swaps land.
----------------------------------------------------------------------
local function buildCornerTick(corner: string): Frame
	local size = UDim2.fromOffset(14, 14)
	local pos
	local anchor = Vector2.new(0, 0)
	if corner == 'tl' then
		pos = UDim2.new(0, 4, 0, 4)
	elseif corner == 'tr' then
		pos = UDim2.new(1, -4, 0, 4); anchor = Vector2.new(1, 0)
	elseif corner == 'bl' then
		pos = UDim2.new(0, 4, 1, -4); anchor = Vector2.new(0, 1)
	else  -- 'br'
		pos = UDim2.new(1, -4, 1, -4); anchor = Vector2.new(1, 1)
	end
	local tick = Instance.new('Frame')
	tick.Name = 'CornerTick_' .. corner
	tick.AnchorPoint = anchor
	tick.Position = pos
	tick.Size = size
	tick.BackgroundTransparency = 1
	tick.BorderSizePixel = 0

	-- L-shape via two thin Frames (horizontal + vertical bars). Color
	-- assigned at build time from the live palette; repainted on theme
	-- change.
	local h = Instance.new('Frame')
	h.Name = 'H'
	h.Size = UDim2.new(1, 0, 0, 2)
	h.BackgroundColor3 = HUDCommon.PALETTE.accent
	h.BorderSizePixel = 0
	h.Parent = tick
	local v = Instance.new('Frame')
	v.Name = 'V'
	v.Size = UDim2.new(0, 2, 1, 0)
	v.BackgroundColor3 = HUDCommon.PALETTE.accent
	v.BorderSizePixel = 0
	v.Parent = tick

	return tick
end

----------------------------------------------------------------------
-- Row template. Pre-allocated (`buildSurfaceGui` builds MaxEntries of
-- these and toggles `Visible` on refresh) so the per-cycle diff
-- doesn't churn instances.
--
-- Colors pulled from HUDCommon.PALETTE; row chrome reuses widget
-- tokens so a theme switch on the tab menu propagates to the in-world
-- board on the same `OnPaletteChanged` tick (see Module.Start).
----------------------------------------------------------------------
local function buildRow(index: number): Frame
	local row = Instance.new('Frame')
	row.Name = 'Row_' .. tostring(index)
	row.BackgroundColor3 = HUDCommon.PALETTE.bg1
	-- Alternate-row tinting reads at a glance even on a small SurfaceGui.
	row.BackgroundTransparency = (index % 2 == 0) and 0.55 or 0.78
	row.BorderSizePixel = 0
	row.Size = UDim2.new(1, 0, 0, 36)
	row.LayoutOrder = index
	row.Visible = false

	-- Subtle accent stroke on every row — same line weight the
	-- chiseledPanel atoms use so the rows feel like sub-panels.
	local stroke = Instance.new('UIStroke')
	stroke.Color = HUDCommon.PALETTE.accent
	stroke.Transparency = 0.85
	stroke.Thickness = 1
	stroke.Parent = row

	local rank = Instance.new('TextLabel')
	rank.Name = 'Rank'
	rank.BackgroundTransparency = 1
	rank.Size = UDim2.fromScale(0.12, 1)
	rank.Position = UDim2.fromScale(0, 0)
	rank.FontFace = HUDCommon.FONT_MONO
	rank.TextColor3 = HUDCommon.PALETTE.gold
	rank.TextScaled = true
	rank.TextXAlignment = Enum.TextXAlignment.Center
	rank.Text = string.format('%02d', index)
	rank.Parent = row

	local nameLabel = Instance.new('TextLabel')
	nameLabel.Name = 'PlayerName'
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.fromScale(0.58, 1)
	nameLabel.Position = UDim2.fromScale(0.13, 0)
	nameLabel.FontFace = HUDCommon.FONT_UI
	nameLabel.TextColor3 = HUDCommon.PALETTE.ink
	nameLabel.TextScaled = true
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.Text = ''
	nameLabel.Parent = row

	local valueLabel = Instance.new('TextLabel')
	valueLabel.Name = 'Value'
	valueLabel.BackgroundTransparency = 1
	valueLabel.Size = UDim2.fromScale(0.28, 1)
	valueLabel.Position = UDim2.fromScale(0.72, 0)
	valueLabel.FontFace = HUDCommon.FONT_MONO
	valueLabel.TextColor3 = HUDCommon.PALETTE.accent
	valueLabel.TextScaled = true
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right
	valueLabel.Text = ''
	valueLabel.Parent = row

	local pad = Instance.new('UIPadding')
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.Parent = row

	return row
end

----------------------------------------------------------------------
-- SurfaceGui builder. One Frame per binding; the `Rows` array is
-- recycled across refreshes (just toggle Visible + reassign Text).
----------------------------------------------------------------------
local function buildSurfaceGui(tagged: Instance, part: BasePart, category: any): Binding
	local gui = Instance.new('SurfaceGui')
	gui.Name = SURFACE_GUI_NAME
	gui.Face = resolveFace(part)
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 50
	gui.LightInfluence = 0
	gui.Brightness = 1.5
	gui.AlwaysOnTop = false
	gui.ClipsDescendants = true
	gui.Adornee = part
	gui.ResetOnSpawn = false

	-- Chiseled-panel chrome via background + outer stroke + corner
	-- ticks. Mirrors HUDCommon.chiseledPanel's visual: a panel-tinted
	-- backdrop, an accent UIStroke, and four L-tick atoms in the
	-- corners. Lets the in-world board feel cohesive with the tab
	-- widgets even though it's a SurfaceGui (can't share the Fusion
	-- builder directly).
	local bg = Instance.new('Frame')
	bg.Name = 'Background'
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = HUDCommon.PALETTE.panel
	bg.BackgroundTransparency = 0.12
	bg.BorderSizePixel = 0
	bg.Parent = gui

	local outerStroke = Instance.new('UIStroke')
	outerStroke.Color = HUDCommon.PALETTE.accent
	outerStroke.Transparency = 0.55
	outerStroke.Thickness = 2
	outerStroke.Parent = bg

	-- Corner ticks pinned to the panel edges. TL+BR matches the
	-- chiseledPanel default; we add TR+BL too because the surface
	-- board reads as a more formal monument than the in-tab panels.
	local cornerTicks: { Frame } = {}
	for _, corner in { 'tl', 'tr', 'bl', 'br' } do
		local tick = buildCornerTick(corner)
		tick.Parent = bg
		table.insert(cornerTicks, tick)
	end

	local header = Instance.new('TextLabel')
	header.Name = 'Header'
	header.BackgroundTransparency = 1
	header.Size = UDim2.fromScale(1, 0.12)
	header.Position = UDim2.fromScale(0, 0)
	header.FontFace = HUDCommon.FONT_DISPLAY
	header.TextColor3 = HUDCommon.PALETTE.gold
	header.TextScaled = true
	header.Text = string.upper(category.Label)
	header.Parent = bg

	-- Inner UIPadding shrinks the TextScaled glyph height (10% total —
	-- 5% top + 5% bottom) so the header doesn't dominate the panel.
	-- Same technique used on the LevelLockOverlay title; TextScaled
	-- fills the rect, padding the rect down is the standard scale-down.
	local headerPad = Instance.new('UIPadding')
	headerPad.PaddingTop    = UDim.new(0.05, 0)
	headerPad.PaddingBottom = UDim.new(0.05, 0)
	headerPad.Parent = header

	local divider = Instance.new('Frame')
	divider.Name = 'Divider'
	divider.Size = UDim2.new(0.92, 0, 0, 2)
	divider.Position = UDim2.fromScale(0.04, 0.13)
	divider.BackgroundColor3 = HUDCommon.PALETTE.accent
	divider.BackgroundTransparency = 0.35
	divider.BorderSizePixel = 0
	divider.Parent = bg

	local list = Instance.new('ScrollingFrame')
	list.Name = 'List'
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.Size = UDim2.fromScale(1, 0.82)
	list.Position = UDim2.fromScale(0, 0.14)
	list.CanvasSize = UDim2.fromScale(0, 0)
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.ScrollBarThickness = 4
	list.ScrollBarImageColor3 = HUDCommon.PALETTE.accent
	list.ScrollBarImageTransparency = 0.4
	list.ElasticBehavior = Enum.ElasticBehavior.Never
	list.Parent = bg

	local listPad = Instance.new('UIPadding')
	listPad.PaddingLeft = UDim.new(0, 8)
	listPad.PaddingRight = UDim.new(0, 8)
	listPad.Parent = list

	local layout = Instance.new('UIListLayout')
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 2)
	layout.Parent = list

	local rows: { Frame } = {}
	for i = 1, LeaderboardConfig.MaxEntries do
		local row = buildRow(i)
		row.Parent = list
		table.insert(rows, row)
	end

	local updated = Instance.new('TextLabel')
	updated.Name = 'Updated'
	updated.BackgroundTransparency = 1
	updated.Size = UDim2.fromScale(1, 0.04)
	updated.Position = UDim2.fromScale(0, 0.96)
	updated.FontFace = HUDCommon.FONT_MONO
	updated.TextColor3 = HUDCommon.PALETTE.inkFaint
	updated.TextScaled = true
	updated.Text = ''
	updated.Parent = bg

	gui.Parent = part

	return {
		Tagged          = tagged,
		Part            = part,
		Category        = category,
		Gui             = gui,
		Rows            = rows,
		HeaderLabel     = header,
		UpdatedLabel    = updated,
		BackgroundFrame = bg,
		Divider         = divider,
		ListFrame       = list,
		OuterStroke     = outerStroke,
		CornerTicks     = cornerTicks,
	}
end

----------------------------------------------------------------------
-- Refresh. Reads the current snapshot from ReplicatedData; each row
-- is either populated (Visible=true with name+value) or hidden. The
-- LocalPlayer's row gets a subtle gold tint so they can pick
-- themselves out at a glance.
----------------------------------------------------------------------
local function applyEntries(binding: Binding, entries: { EntryRow })
	local format = binding.Category.Format
	local localUserId = Players.LocalPlayer and Players.LocalPlayer.UserId
	for i, row in binding.Rows do
		local entry = entries[i]
		if entry then
			local nameChild = row:FindFirstChild('PlayerName') :: TextLabel?
			local valueChild = row:FindFirstChild('Value') :: TextLabel?
			local isYou = entry.userId == localUserId
			if nameChild then
				nameChild.Text = entry.name or ('User ' .. tostring(entry.userId))
				-- Highlight the local player's row in gold; everyone
				-- else stays at the default `ink`. Repainted on theme
				-- change via repaintBinding.
				nameChild.TextColor3 = isYou and HUDCommon.PALETTE.gold or HUDCommon.PALETTE.ink
			end
			if valueChild then
				valueChild.Text = formatValue(entry.value, format)
				-- Value column accents to gold on the local row so
				-- the entire row visually pops together.
				valueChild.TextColor3 = isYou and HUDCommon.PALETTE.gold or HUDCommon.PALETTE.accent
			end
			row.Visible = true
		else
			row.Visible = false
		end
	end
end

----------------------------------------------------------------------
-- Re-tint a binding from the live palette. Called on every
-- HUDCommon.OnPaletteChanged signal — the SurfaceGui isn't part of
-- the master HUD ScreenGui so HUDCommon.ApplyTheme's walk-and-tween
-- pass doesn't reach it; we have to repaint manually.
--
-- Cheap: ~20 property writes per binding, the bindings count is tiny
-- (one per board in the world). Skips disabled / streamed-out parts
-- via the Gui.Parent guard.
----------------------------------------------------------------------
-- Forward-declare refresh helpers so repaintAll can call refreshAll
-- — the actual definitions live below, beneath repaintBinding.
local refreshBinding: (Binding) -> ()
local refreshAll: () -> ()

local function repaintBinding(binding: Binding)
	local PAL = HUDCommon.PALETTE
	if not binding.Gui or not binding.Gui.Parent then return end
	binding.BackgroundFrame.BackgroundColor3 = PAL.panel
	binding.OuterStroke.Color    = PAL.accent
	binding.HeaderLabel.TextColor3 = PAL.gold
	binding.Divider.BackgroundColor3 = PAL.accent
	binding.ListFrame.ScrollBarImageColor3 = PAL.accent
	binding.UpdatedLabel.TextColor3 = PAL.inkFaint
	for _, tick in binding.CornerTicks do
		local h = tick:FindFirstChild('H') :: Frame?
		local v = tick:FindFirstChild('V') :: Frame?
		if h then h.BackgroundColor3 = PAL.accent end
		if v then v.BackgroundColor3 = PAL.accent end
	end
	-- Rows: alternating bg + per-row stroke. Re-walking applyEntries'
	-- per-row text-color decisions (local-player gold, others ink)
	-- from here would require knowing the live entries — easier to
	-- defer to the next refresh which happens on every server publish
	-- + the periodic repainter. Just refresh the structural colors
	-- here.
	local localUserId = Players.LocalPlayer and Players.LocalPlayer.UserId
	for _, row in binding.Rows do
		row.BackgroundColor3 = PAL.bg1
		local stroke = row:FindFirstChildOfClass('UIStroke')
		if stroke then stroke.Color = PAL.accent end
		local rank = row:FindFirstChild('Rank') :: TextLabel?
		if rank then rank.TextColor3 = PAL.gold end
		-- Re-derive name/value text color from the row's current name
		-- (the userId isn't stored on the row, so we read it back via
		-- the in-replica Entries list at the next applyEntries call).
		-- Reset to neutral defaults here — the next refresh will tint
		-- the local player's row gold again.
		local name = row:FindFirstChild('PlayerName') :: TextLabel?
		if name then name.TextColor3 = PAL.ink end
		local value = row:FindFirstChild('Value') :: TextLabel?
		if value then value.TextColor3 = PAL.accent end
	end
end

local function repaintAll()
	for _, binding in _bindings do repaintBinding(binding) end
	-- After repaint, refresh entries so the local-player gold tint
	-- lands on the right row again. refreshAll re-reads the snapshot
	-- and re-runs applyEntries; cheap (no DataStore round trip).
	refreshAll()
end

local function applyUpdated(binding: Binding, updated: number?)
	if typeof(updated) ~= 'number' or updated <= 0 then
		binding.UpdatedLabel.Text = 'Awaiting first update...'
		return
	end
	local secondsAgo = math.max(0, os.time() - updated)
	if secondsAgo < 60 then
		binding.UpdatedLabel.Text = string.format('Updated %ds ago', secondsAgo)
	else
		binding.UpdatedLabel.Text = string.format('Updated %dm ago', math.floor(secondsAgo / 60))
	end
end

function refreshBinding(binding: Binding)
	local snap = ReplicatedData.GetData(LeaderboardConfig.PublicCategory, false)
	if typeof(snap) ~= 'table' then
		applyEntries(binding, {})
		applyUpdated(binding, nil)
		return
	end
	local categoryData = snap[binding.Category.Id]
	local entries = (typeof(categoryData) == 'table' and categoryData.Entries) or {}
	applyEntries(binding, entries)
	applyUpdated(binding, snap.Updated)
end

function refreshAll()
	for _, binding in _bindings do refreshBinding(binding) end
end

----------------------------------------------------------------------
-- Tag-add / tag-remove handlers. Streaming-driven adds and removes
-- fire with the same Instance reference, so the _bindings map
-- balances cleanly across stream cycles.
----------------------------------------------------------------------
local function onTaggedAdded(inst: Instance)
	if _bindings[inst] then return end

	local part = resolveAdorneePart(inst)
	if not part then
		warn(string.format(
			"[LeaderboardSurfaceClient] tagged %q (%s) has no usable BasePart — skipping",
			inst:GetFullName(), inst.ClassName))
		return
	end

	-- Match the tagged-instance Name first, fall back to the resolved
	-- BasePart's name. Designers can either name the Model (e.g.
	-- 'TotalDamageBoard' on a decoration model) or name the part
	-- itself.
	local category = LeaderboardConfig.GetCategoryByPartName(inst.Name)
	if not category and part ~= inst then
		category = LeaderboardConfig.GetCategoryByPartName(part.Name)
	end
	if not category then
		warn(string.format(
			"[LeaderboardSurfaceClient] tagged %q has no matching PartName in LeaderboardConfig.",
			inst.Name))
		return
	end

	clearLineHandleAdornments(part)

	-- A previous session of this controller (or a designer-placed
	-- placeholder) may have left a SurfaceGui under the part. Replace
	-- it cleanly.
	local existing = part:FindFirstChild(SURFACE_GUI_NAME)
	if existing then existing:Destroy() end

	local binding = buildSurfaceGui(inst, part, category)
	_bindings[inst] = binding
	refreshBinding(binding)
end

local function onTaggedRemoved(inst: Instance)
	local binding = _bindings[inst]
	if not binding then return end
	_bindings[inst] = nil
	-- Streaming may have already destroyed the part + its descendants
	-- (including our SurfaceGui). Guard with a Parent check so we
	-- don't double-Destroy a collected instance.
	if binding.Gui and binding.Gui.Parent then
		binding.Gui:Destroy()
	end
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	-- Discovery path 1: CollectionService tag 'Leaderboards'.
	for _, inst in CollectionService:GetTagged(TAG) do
		onTaggedAdded(inst)
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(onTaggedAdded)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(onTaggedRemoved)

	-- Discovery path 2: every direct child of workspace.Leaderboards.
	-- Matches the level layout currently in use (parts grouped under
	-- a folder rather than tagged). The same binder handles both
	-- paths; _bindings de-dupes if a single instance is discovered
	-- via both. Folder may not exist yet (place still loading) —
	-- watch ChildAdded on workspace too so a deferred Leaderboards
	-- folder still hooks up.
	local function bindFolder(folder: Instance)
		for _, child in folder:GetChildren() do
			onTaggedAdded(child)
		end
		folder.ChildAdded:Connect(onTaggedAdded)
		folder.ChildRemoved:Connect(onTaggedRemoved)
	end
	local existing = Workspace:FindFirstChild(FOLDER_NAME)
	if existing then
		bindFolder(existing)
	else
		Workspace.ChildAdded:Connect(function(child)
			if child.Name == FOLDER_NAME then bindFolder(child) end
		end)
	end

	-- Subscribe to the public 'Leaderboard' category. Each server
	-- publish (once per CycleSec) re-renders all visible boards.
	-- Decoupled from PlayerData ticks so per-player save replication
	-- doesn't trigger redundant rebuilds.
	_replicaConn = ReplicatedData.OnUpdated:Connect(function(category)
		if category == LeaderboardConfig.PublicCategory then
			refreshAll()
		end
	end)

	-- Live-theme: HUDCommon fires OnPaletteChanged AFTER its in-place
	-- palette mutation. The master ScreenGui's walk-and-tween repaint
	-- doesn't reach our SurfaceGui (it's parented under workspace
	-- BaseParts, not under HUDCommon's master GUI), so we explicitly
	-- repaint each binding from the new palette and re-run a full
	-- entry refresh (which restores the local-player gold tint).
	if HUDCommon.OnPaletteChanged and HUDCommon.OnPaletteChanged.Connect then
		HUDCommon.OnPaletteChanged:Connect(repaintAll)
	end

	-- Re-sticker the "Updated Xs ago" footer every 30s so the elapsed
	-- text stays honest between server pulls (UPDATED_TICK_SEC <
	-- CycleSec / 4 so the footer never lies by more than a quarter
	-- of a cycle).
	task.spawn(function()
		while true do
			task.wait(UPDATED_TICK_SEC)
			local snap = ReplicatedData.GetData(LeaderboardConfig.PublicCategory, false)
			local updated = (typeof(snap) == 'table' and snap.Updated) or nil
			for _, binding in _bindings do
				applyUpdated(binding, updated)
			end
		end
	end)
end

function Module.Init() end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Effects/LevelUpClient.luau"><![CDATA[-- Level-up client. Plays the full level-up beat for the local player
-- and a reduced version for other players. Three layers:
--
--   1. World VFX  — expanding ring + point light + particle burst at
--                   the leveling player's HRP (everyone sees these)
--   2. Audio     — golden chime SFX positional at the HRP
--   3. Onscreen  — big "LEVEL UP" overlay with the new level (only
--                  shown to the leveling player; locked to camera)
--
-- The particle emitter is built procedurally from a small spec table
-- so we don't depend on art assets that may not be in the project
-- yet — designers can replace SpawnLevelUpParticles with a clone of
-- a real AssetsShared template once art lands.

local Players      = game:GetService('Players')
local Debris       = game:GetService('Debris')
local TweenService = game:GetService('TweenService')
local RunService   = game:GetService('RunService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion        = ReplicatedModules.Libraries.Fusion
local scoped        = Fusion.scoped
local doCleanup     = Fusion.doCleanup

local RemoteService = ReplicatedModules.Services.RemoteService
local SoundService  = ReplicatedModules.Services.SoundService

local LevelUpEvent = RemoteService.GetRemote('LevelUpEvent', 'RemoteEvent', false)

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local SystemsContainer = {}

local Module = {}

-- Default sound. Designers swap this constant when the dedicated
-- level-up chime asset is finalized; a TestSound id is fine for
-- placeholder play-through. Pitch + volume are tuned to feel "warm
-- chime" rather than "trumpet blast".
local LEVELUP_SOUND_ID = 'rbxassetid://9114015882'
local LEVELUP_SOUND_VOLUME = 0.8
local LEVELUP_SOUND_PITCH  = 1.0

----------------------------------------------------------------------
-- Particle burst — procedural so it works without bundled assets.
-- Emits ~30 sparkles over a 0.4s window from an attachment at the
-- character's HRP, then auto-cleans the attachment via Debris.
----------------------------------------------------------------------
local function spawnLevelUpParticles(hrp: BasePart)
	local att = Instance.new('Attachment')
	att.Name = 'LevelUpEmit'
	att.Parent = hrp

	local emitter = Instance.new('ParticleEmitter')
	-- Default texture — Roblox's built-in twinkle. Swap for an
	-- AssetsShared.VFX.LevelUp asset when art is ready.
	emitter.Texture = 'rbxasset://textures/particles/sparkles_main.dds'
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.6, 1.0)
	emitter.Speed = NumberRange.new(8, 14)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-180, 180)
	emitter.Acceleration = Vector3.new(0, -10, 0)
	emitter.LightEmission = 0.7
	emitter.LightInfluence = 0
	emitter.Color = ColorSequence.new(Color3.fromRGB(255, 220, 130), Color3.fromRGB(255, 240, 180))
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(0.7, 0.4),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.6),
		NumberSequenceKeypoint.new(0.5, 0.9),
		NumberSequenceKeypoint.new(1, 0.2),
	})
	emitter.Drag = 1.5
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Parent = att

	-- Two bursts: a big ground-anchored pop, then a smaller follow-up
	-- so the burst doesn't visually flatline after one frame.
	emitter:Emit(28)
	task.delay(0.18, function()
		if emitter.Parent then emitter:Emit(14) end
	end)

	Debris:AddItem(att, 1.4)
end

----------------------------------------------------------------------
-- Onscreen overlay — Fusion-managed big "LEVEL UP" pop. Locked to
-- a per-event scope so a fresh level-up mid-fade tears down the
-- previous overlay cleanly. Local player only.
----------------------------------------------------------------------
local OverlayScope = nil
local OverlayGui: ScreenGui? = nil

local function tearDownOverlay()
	if OverlayScope then doCleanup(OverlayScope); OverlayScope = nil end
	if OverlayGui then OverlayGui:Destroy(); OverlayGui = nil end
end

local function showLocalOverlay(newLevel: number, levelsGained: number?)
	tearDownOverlay()
	OverlayGui = HUDCommon.ensureScreenGui('HUD_LevelUpOverlay', 80)
	OverlayScope = scoped(Fusion)
	local scope = OverlayScope

	-- Animation state. `progress` runs 0 → 1 across the full overlay
	-- lifetime; the labels' transparency / scale Computed off it.
	local progress = scope:Value(0)

	-- Driver loop. Heartbeat-driven Computed-friendly timeline; we
	-- don't tween Fusion Values via TweenService directly because
	-- Fusion Values aren't Instance properties. Manual lerp keeps the
	-- math local + readable.
	local IN_TIME, HOLD_TIME, OUT_TIME = 0.35, 1.0, 0.6
	local TOTAL = IN_TIME + HOLD_TIME + OUT_TIME

	scope:New('Frame') {
		Name = 'LevelUpOverlay',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.fromOffset(640, 180),
		BackgroundTransparency = 1,
		Parent = OverlayGui,
		[Fusion.Children] = {
			-- Big "LEVEL UP" word.
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.fromScale(0.5, 0),
				Size = UDim2.fromScale(1, 0.55),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = 'LEVEL UP',
				TextScaled = true,
				TextColor3 = PALETTE.gold,
				TextStrokeColor3 = Color3.new(0, 0, 0),
				TextStrokeTransparency = 0.2,
				TextTransparency = scope:Computed(function(use)
					local p = use(progress)
					if p < IN_TIME / TOTAL then
						return 1 - (p / (IN_TIME / TOTAL))
					elseif p > 1 - (OUT_TIME / TOTAL) then
						return (p - (1 - OUT_TIME / TOTAL)) / (OUT_TIME / TOTAL)
					end
					return 0
				end),
				[Fusion.Children] = {
					scope:New('UIScale') {
						-- Scale pulse: pop up to 1.05× during hold, settle.
						Scale = scope:Computed(function(use)
							local p = use(progress)
							if p < IN_TIME / TOTAL then
								local t = p / (IN_TIME / TOTAL)
								return 0.7 + 0.4 * t  -- 0.7 → 1.1
							elseif p < (IN_TIME + 0.2) / TOTAL then
								local t = (p - IN_TIME / TOTAL) / (0.2 / TOTAL)
								return 1.1 - 0.05 * t  -- 1.1 → 1.05
							end
							return 1.05
						end),
					},
				},
			},
			-- New level number ('Lv. 12' or 'Lv. 12 (+2)' if multi-up)
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.fromScale(0.5, 1),
				Size = UDim2.fromScale(1, 0.4),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = (levelsGained and levelsGained > 1)
					and string.format('Lv. %d (+%d)', newLevel, levelsGained)
					or  string.format('Lv. %d', newLevel),
				TextScaled = true,
				TextColor3 = PALETTE.ink,
				TextStrokeColor3 = Color3.new(0, 0, 0),
				TextStrokeTransparency = 0.4,
				TextTransparency = scope:Computed(function(use)
					-- Sub-label slightly delayed in / lingering out.
					local p = use(progress)
					local subIn = IN_TIME / TOTAL + 0.05
					if p < subIn then
						return math.max(0, 1 - p / subIn)
					elseif p > 1 - (OUT_TIME * 0.8) / TOTAL then
						return (p - (1 - OUT_TIME * 0.8 / TOTAL)) / (OUT_TIME * 0.8 / TOTAL)
					end
					return 0
				end),
			},
		},
	}

	-- Drive the timeline. Heartbeat tick advances progress until
	-- TOTAL elapses, then teardown. Cancellation: tearDownOverlay
	-- destroys OverlayScope, which sets `progress` to nil; we read
	-- through a local capture so the loop bails on next iteration.
	local localProgress = progress
	local startedAt = os.clock()
	local conn
	conn = RunService.Heartbeat:Connect(function()
		local elapsed = os.clock() - startedAt
		if elapsed >= TOTAL then
			conn:Disconnect()
			-- Defensive — only tear down if we're still the active
			-- overlay (a fresh level-up mid-tween already torn us down).
			if localProgress == progress then
				tearDownOverlay()
			end
			return
		end
		if localProgress == progress then
			localProgress:set(elapsed / TOTAL)
		else
			-- Superseded by a fresh level-up; stop driving.
			conn:Disconnect()
		end
	end)
end

----------------------------------------------------------------------
-- World VFX — runs for every observer (the leveling player + any
-- nearby player). Particle/ring/light layered for a cohesive pop.
----------------------------------------------------------------------
local function runWorldVFX(player: Player)
	local character = player.Character
	local hrp = character and character:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not hrp then return end

	-- Expanding cylinder ring of light at the character's feet.
	local ring = Instance.new('Part')
	ring.Name = 'LevelUpRing'
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.2, 1, 1)
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(255, 220, 130)
	ring.CFrame = hrp.CFrame * CFrame.new(0, -2.8, 0) * CFrame.Angles(0, 0, math.rad(90))
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Transparency = 0.2
	ring.Parent = workspace.Terrain

	local growth = TweenService:Create(ring, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.2, 14, 14),
		Transparency = 1,
	})
	growth:Play()
	Debris:AddItem(ring, 0.7)

	-- Aura point light flash.
	local light = Instance.new('PointLight')
	light.Color = Color3.fromRGB(255, 220, 130)
	light.Brightness = 4
	light.Range = 14
	light.Parent = hrp
	task.delay(0.4, function() if light.Parent then light:Destroy() end end)

	-- Particle burst.
	spawnLevelUpParticles(hrp)

	-- Audio — positional so distant level-ups feel placed in space.
	if SoundService and SoundService.PlaySoundAtPosition then
		local pos = hrp.Position
		SoundService.PlaySoundAtPosition(LEVELUP_SOUND_ID, pos, LEVELUP_SOUND_PITCH)
	else
		-- Fallback: spawn a one-shot sound parented to terrain.
		local sound = Instance.new('Sound')
		sound.SoundId = LEVELUP_SOUND_ID
		sound.Volume  = LEVELUP_SOUND_VOLUME
		sound.PlaybackSpeed = LEVELUP_SOUND_PITCH
		sound.RollOffMode = Enum.RollOffMode.InverseTapered
		sound.Parent = hrp
		sound:Play()
		Debris:AddItem(sound, 3)
	end
end

----------------------------------------------------------------------
-- Public entry — called from Module.Start's remote listener AND
-- exposed for cmdr / debug paths to fire a synthetic level-up.
----------------------------------------------------------------------
function Module.PlayLevelUp(player: Player, newLevel: number, levelsGained: number?)
	runWorldVFX(player)

	if player == LocalPlayer then
		showLocalOverlay(newLevel, levelsGained)

		-- Camera shake — only for the local rider, via cinematic client.
		local CinematicClient = SystemsContainer.CinematicClient
			or (SystemsContainer.ParentSystems and SystemsContainer.ParentSystems.Effects
				and SystemsContainer.ParentSystems.Effects.CinematicClient)
		if CinematicClient and CinematicClient.PlayCue then
			CinematicClient.PlayCue('CameraShake', {
				Magnitude = 0.4, Roughness = 5, Duration = 0.4, FadeIn = 0.05, FadeOut = 0.25,
			})
		end
	end
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	LevelUpEvent.OnClientEvent:Connect(function(player, newLevel, levelsGained)
		Module.PlayLevelUp(player, newLevel, levelsGained)
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Effects/RegionCinematics.luau"><![CDATA[
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedSharedAssets = ReplicatedStorage:WaitForChild('AssetsShared')
local ReplicatedGameAssets = ReplicatedStorage:WaitForChild('Assets')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local ZoneService = ReplicatedModules.Services.ZoneService

local SystemsContainer = {}

local WHITELISTED_CINEMATIC_REGIONS = {'TestRegion1', 'TestRegion2', 'Town Of Beginnings'}

-- // Module // --
local Module = {}

Module.ActiveRegions = { }
Module.CinematicQueue = { Entered = {}, Left = {}, }

function Module.OnRegionsEntered()
	for _, regionName in ZoneService.GetZonesPlayerIsWithin(LocalPlayer) do
		if not table.find(WHITELISTED_CINEMATIC_REGIONS, regionName) then
			continue
		end
		if not table.find(Module.ActiveRegions, regionName) then
			table.insert(Module.CinematicQueue.Entered, regionName)
			table.insert(Module.ActiveRegions, regionName)
		end
	end
end

function Module.OnRegionsLeft()
	local function ArrayRemoveAll( array, value )
		local index = 1
		while index <= #array do
			if array[index] == value then
				table.remove(array, index)
			else
				index += 1
			end
		end
	end

	local index = 1
	while index <= #Module.ActiveRegions do
		local regionName = Module.ActiveRegions[index]
		if table.find(ZoneService.GetZonesPlayerIsWithin(LocalPlayer), regionName) then
			index += 1
		else
			ArrayRemoveAll( Module.CinematicQueue.Entered, regionName )
			-- table.insert( Module.CinematicQueue.Left, regionName )
			table.remove( Module.ActiveRegions, index )
		end
	end
end

function Module.UpdateCinematic()
	if #Module.CinematicQueue.Entered > 0 then
		local EnteredValues = Module.CinematicQueue.Entered
		Module.CinematicQueue.Entered = { }
		if #EnteredValues == 1 then
			SystemsContainer.CinematicLabels.CinematicTopWhite( "You have entered the region:", EnteredValues[1], 1 )
		else
			SystemsContainer.CinematicLabels.CinematicTopWhite( "You have entered the following regions:", table.concat(EnteredValues, " "), 1 )
		end
	elseif #Module.CinematicQueue.Left > 0 then
		local LeftValues = Module.CinematicQueue.Left
		Module.CinematicQueue.Left = { }
		if #Module.CinematicQueue.Left == 1 then
			SystemsContainer.CinematicLabels.CinematicTopWhite( "You have left the region:", LeftValues[1], 1 )
		else
			SystemsContainer.CinematicLabels.CinematicTopWhite( "You have left the following regions:", table.concat(LeftValues, " "), 1 )
		end
	end
end

function Module.Start()
	local RegionParts = ReplicatedGameAssets:FindFirstChild("Regions")
	if RegionParts then
		RegionParts.Parent = workspace
	else
		print("There is no Regions folder/model in ReplicatedStorage.Assets.")
	end

	ZoneService.ZoneEnter:Connect(function()
		Module.OnRegionsEntered()
	end)

	ZoneService.ZoneLeave:Connect(function()
		Module.OnRegionsLeft()
	end)

	task.spawn(function()
		while true do
			task.wait(0.2)
			Module.UpdateCinematic()
		end
	end)

end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Effects/SkillVfxClient.luau"><![CDATA[-- SkillVfxClient — receives visual-only cue dispatches from
-- SkillRuntimeServer's `vfx` step kind and renders them locally.
--
-- "Visual only" means: NO damage, NO status, NO logic. Just
-- particles, lighting flashes, screen shake, audio one-shots — all
-- the polish that makes a cleave actually feel like a cleave.
--
-- This module is a small registry mapping `Cue` ids to render
-- functions. Cues are looked up by id; unknown cues warn and skip.
-- Adding a new cue is one entry in CueDispatch — typical body is a
-- ParticleEmitter:Emit() against a temp Attachment, or a tween on
-- workspace lighting.
--
-- Pair with the server side: SkillRuntimeServer fires
-- `SkillVfxEvent:FireAllClients({ Cue, OriginCFrame, Duration?, Args? })`
-- whenever a recipe hits a `vfx` step.

local Debris = game:GetService('Debris')
local TweenService = game:GetService('TweenService')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local RemoteService = ReplicatedModules.Services.RemoteService
local SkillVfxEvent = RemoteService.GetRemote('SkillVfxEvent', 'RemoteEvent', false)

local Module = {}

----------------------------------------------------------------------
-- Cue registry. Each entry is `function(args)` where args carries
-- whatever the server sent (OriginCFrame is the most common). Keep
-- entries lightweight — heavy effects (full particle systems) should
-- live as templates in ReplicatedStorage and be cloned here, not
-- constructed inline per-cue.
----------------------------------------------------------------------
local CueDispatch: { [string]: (any) -> () } = {}

----------------------------------------------------------------------
-- Built-in stub cue: a brief PointLight pulse at the origin. Useful
-- as a "the system is wired" smoke test until art-side cues land.
----------------------------------------------------------------------
CueDispatch.cleave_charge_glow = function(args)
	local origin = args.OriginCFrame
	if typeof(origin) ~= 'CFrame' then return end
	local part = Instance.new('Part')
	part.Anchored = true; part.CanCollide = false; part.CanTouch = false
	part.CanQuery = false; part.CastShadow = false; part.Massless = true
	part.Size = Vector3.new(1, 1, 1)
	part.Transparency = 1
	part.CFrame = origin
	part.Parent = workspace

	local light = Instance.new('PointLight')
	light.Brightness = 4
	light.Range = 18
	light.Color = Color3.fromRGB(232, 60, 78)
	light.Parent = part

	local duration = math.max(0.15, tonumber(args.Duration) or 0.3)
	TweenService:Create(light, TweenInfo.new(duration), { Brightness = 0 }):Play()
	Debris:AddItem(part, duration + 0.1)
end

----------------------------------------------------------------------
-- Helpers — built inline rather than templated so this file stays
-- self-contained for a small number of cues. If/when the cue list
-- grows past ~6 entries, factor these into a templates folder under
-- ReplicatedStorage/Effects/.
----------------------------------------------------------------------
local function makeAnchorPart(originCF: CFrame): Part
	local part = Instance.new('Part')
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Massless = true
	part.Size = Vector3.new(1, 1, 1)
	part.Transparency = 1
	-- Drop the anchor onto the ground plane (the origin's CFrame is
	-- the caster's pivot — usually mid-torso). Subtracting 2.5 studs
	-- on Y matches the EnemyTelegraphClient's groundY offset so the
	-- particles puff at the same height as the red telegraph plane.
	part.CFrame = originCF - Vector3.new(0, 2.5, 0)
	part.Parent = workspace
	return part
end

local function makeDustEmitter(parent: Instance, intensity: number): ParticleEmitter
	-- Tan/brown puff. `smoke_main` is a built-in studio asset — no
	-- upload needed. The numbers are tuned for "ground impact dust":
	-- low lifetime, fast initial speed, downward gravity so the
	-- cloud spreads outward and settles, transparency ramp so the
	-- edge of the cloud feathers out instead of cutting hard.
	local emitter = Instance.new('ParticleEmitter')
	emitter.Texture = 'rbxasset://textures/particles/smoke_main.dds'
	emitter.Color = ColorSequence.new(Color3.fromRGB(160, 120, 86))
	emitter.LightEmission = 0
	emitter.LightInfluence = 1
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0,    1.5 * intensity),
		NumberSequenceKeypoint.new(0.4,  3.5 * intensity),
		NumberSequenceKeypoint.new(1,    5.0 * intensity),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0,   0.25),
		NumberSequenceKeypoint.new(0.4, 0.45),
		NumberSequenceKeypoint.new(1,   1.00),
	})
	emitter.Lifetime = NumberRange.new(0.55, 1.10)
	emitter.Rate = 0  -- burst-only, never streams
	emitter.Speed = NumberRange.new(8 * intensity, 16 * intensity)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Acceleration = Vector3.new(0, -10, 0)
	emitter.VelocityInheritance = 0
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-90, 90)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Drag = 4
	emitter.Parent = parent
	return emitter
end

----------------------------------------------------------------------
-- stampede_smash — the impact burst on the BossBoar's Stampede skill.
-- Two-layer effect:
--   * Outer dust ring: thick brown puff radiating outward from the
--     impact point (the "kick of dirt" beat).
--   * Inner light flash: brief amber flash that reads as ground
--     impact even at distance / through foliage.
-- Designed to read at the same instant the Stampede telegraph fills,
-- so the skill plays as one beat ("BAM + dust") rather than two.
----------------------------------------------------------------------
CueDispatch.stampede_smash = function(args)
	local origin = args.OriginCFrame
	if typeof(origin) ~= 'CFrame' then return end
	local part = makeAnchorPart(origin)

	-- Outer dust burst. Heavy intensity matched to the ~16-stud AOE
	-- of the Stampede recipe so the dust visually fills the danger zone.
	local outer = makeDustEmitter(part, 1.2)
	outer:Emit(28)

	-- Inner punch — same emitter tuned tighter, fewer particles, faster
	-- lifetime. Reads as the "core" of the impact while the outer puff
	-- billows around it.
	local inner = makeDustEmitter(part, 0.45)
	inner.Lifetime = NumberRange.new(0.20, 0.40)
	inner.Speed = NumberRange.new(2, 5)
	inner:Emit(18)

	-- Amber ground flash for "felt" impact at distance.
	local light = Instance.new('PointLight')
	light.Brightness = 6
	light.Range = 22
	light.Color = Color3.fromRGB(255, 200, 120)
	light.Parent = part
	TweenService:Create(light, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Brightness = 0 }):Play()

	-- Cleanup — emitters keep rendering existing particles after the
	-- anchor part is gone (they're queued in the renderer), so we can
	-- destroy the part as soon as both emitters are done emitting +
	-- max lifetime has elapsed. 1.5 s covers the longest outer-puff
	-- lifetime with margin.
	Debris:AddItem(part, 1.5)
end

----------------------------------------------------------------------
-- stampede_smash_tell — pre-stampede windup. Tiny dust puff at the
-- boar's feet to read as "pawing the ground." Identical emitter to
-- the smash, but fewer particles and shorter lifetime so it doesn't
-- compete visually with the main impact half a beat later.
----------------------------------------------------------------------
CueDispatch.stampede_smash_tell = function(args)
	local origin = args.OriginCFrame
	if typeof(origin) ~= 'CFrame' then return end
	local part = makeAnchorPart(origin)
	local emitter = makeDustEmitter(part, 0.35)
	emitter.Lifetime = NumberRange.new(0.30, 0.60)
	emitter.Speed = NumberRange.new(3, 6)
	emitter:Emit(8)
	Debris:AddItem(part, 0.9)
end

----------------------------------------------------------------------
-- Public registration API — game-specific cues register from their
-- own modules so this file stays a dispatcher, not a content dump.
----------------------------------------------------------------------
function Module.RegisterCue(cueId: string, fn: (any) -> ())
	CueDispatch[cueId] = fn
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	SkillVfxEvent.OnClientEvent:Connect(function(payload)
		if typeof(payload) ~= 'table' or typeof(payload.Cue) ~= 'string' then return end
		local fn = CueDispatch[payload.Cue]
		if not fn then
			-- Quiet dev-time warn; production should silently skip
			-- unknown cues so a missing client patch doesn't error-spam.
			warn(string.format('[SkillVfxClient] unknown cue %q', payload.Cue))
			return
		end
		local ok, err = pcall(fn, payload)
		if not ok then warn('[SkillVfxClient] cue error:', err) end
	end)
end

function Module.Init() end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Effects/UnlockedCinematic.luau"><![CDATA[
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local DiscoveryData = ReplicatedModules.Data.Discovery

local RemoteService = ReplicatedModules.Services.RemoteService
local DiscoveryEvent = RemoteService.GetRemote('DiscoveryEvent', 'RemoteEvent', false)

local SystemsContainer = {}

-- // Module // --
local Module = {}

function Module.DisplayAchievement(title : string, description : string, duration : number, sound : Instance?)
	local OnPlaySignal = SystemsContainer.CinematicLabels.CinematicTopWhite(title, description, duration)
	if not sound then
		return
	end

	OnPlaySignal:Once(function()
		local Sound : Sound = sound:Clone()
		Sound.Parent = LocalPlayer:WaitForChild("PlayerGui")
		Sound:Play()
		Sound.DidLoop:Once(function()
			Sound:Destroy()
		end)
	end)
end

function Module.DisplayMilestoneAchievement(title : string, description : string)
	Module.DisplayAchievement(title, description, 7, ReplicatedAssets.Sounds.Local.MilestoneAchievement)
end

function Module.DisplayShortUnlock(title : string, description : string)
	Module.DisplayAchievement(title, description, 4, ReplicatedAssets.Sounds.Local.ProgressionAchievement)
end

function Module.Start()

	DiscoveryEvent.OnClientEvent:Connect(function(zoneName : string)
		local display_info = DiscoveryData.DiscoveryDisplayInfo[zoneName]
		if display_info then
			Module.DisplayShortUnlock('Discovery', string.format('You have discovered the region %s!', display_info.Name))
		end
	end)

end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Gameplay/init.luau"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Gameplay/AurasClient.luau"><![CDATA[-- Auras client. Renders the equipped aura visual on the appropriate
-- anchor (character HRP / equipped sword / mount model). Per-player so
-- every client sees every player's auras.
--
-- Visual fallback: if AssetsShared.VFX.Auras.<Particle> doesn't exist,
-- spawns a PointLight + a tiny placeholder Attachment with no particles.
-- Real VFX templates drop in later.

local Players = game:GetService('Players')
local RunService = game:GetService('RunService')
local CollectionService = game:GetService('CollectionService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local AurasShared = ReplicatedModules.Services.AurasShared
local AurasConfig = ReplicatedModules.Data.Auras
local SoundService = ReplicatedModules.Services.SoundService
local RemoteService = ReplicatedModules.Services.RemoteService

local AuraEvent = RemoteService.GetRemote('AuraEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Active aura render state. One Render per (player, auraId). Each
-- render fans out into N attachments — one per anchor part:
--   * 'character' → every body part of the rig (head, torso, limbs)
--   * 'sword'     → every equipped weapon Tool's Handle
--   * 'mount'     → the active mount's primary part (single)
-- A single aura therefore owns N attachments, N×particles, and (when
-- spec'd) N×beams + N×lights. The Runtime hook (Setup/Step/Cleanup)
-- runs ONCE per render with the full attachment list — authors that
-- want per-part behavior iterate the list themselves.
----------------------------------------------------------------------
type Render = {
	auraId: string,
	anchor: string,
	-- One Attachment per resolved anchor part, in matching order.
	attachments: { Attachment },
	-- End-attachments parallel `attachments` for beam visuals.
	endAttachments: { Attachment },
	lights: { PointLight },
	particles: { ParticleEmitter },
	beams: { Beam },
	loopSound: Sound?,
	-- Runtime state returned by the optional Setup hook.
	runtimeState: any?,
	-- Heartbeat connection driving the optional Step hook.
	stepConn: RBXScriptConnection?,
	-- Cleanup callback (typed copy from cfg.Runtime so despawn doesn't
	-- need to re-look up the cfg if the aura was revoked mid-spawn).
	cleanup: ((state: any) -> ())?,
}
local Active: { [Player]: { [string]: Render } } = {}

-- Default texture for procedurally-built particles. Roblox's built-in
-- sparkles asset reads as a generic glow without bundling extra art.
local DEFAULT_PARTICLE_TEXTURE = 'rbxasset://textures/particles/sparkles_main.dds'
-- Default beam texture — neutral white-edged streak. Same goal as
-- the particle default: visible without dependencies.
local DEFAULT_BEAM_TEXTURE = 'rbxasset://textures/particles/sparkles_main.dds'

----------------------------------------------------------------------
-- Anchor resolution. Returns a LIST of BaseParts so a single aura can
-- visually span multiple targets:
--   * 'character' → every BasePart in the rig (head, torso, limbs).
--                   Particles emit from each, so a character glow now
--                   wreathes the WHOLE rig instead of just HRP.
--   * 'sword'     → every equipped weapon's Handle (both hands when
--                   dual-wielding).
--   * 'mount'     → the active mount's primary part (still one).
-- An empty list means the anchor isn't available yet (no character,
-- nothing equipped, not riding); the step() retry loop re-spawns the
-- aura when parts become available.
----------------------------------------------------------------------
local function findAnchorParts(player: Player, anchor: string): { BasePart }
	local character = player.Character
	if not character then return {} end
	local out: { BasePart } = {}

	if anchor == 'character' then
		-- Whole rig — every BasePart descendant of the character. Skips
		-- any tool Handles (those belong to the 'sword' anchor) so a
		-- character aura doesn't double-stack on equipped weapons.
		for _, descendant in character:GetDescendants() do
			if descendant:IsA('BasePart') and not descendant:FindFirstAncestorOfClass('Tool') then
				out[#out + 1] = descendant :: BasePart
			end
		end
		return out

	elseif anchor == 'sword' then
		-- Bladeborne weapons aren't Tools — they're Models cloned by
		-- EquipmentRendererClient and parented under the character.
		-- Each equipped weapon model is tagged 'EquippedWeapon' on
		-- spawn (see EquipmentRendererClient.EquipFunctions.Weapon),
		-- so iterating the tag set + filtering to descendants of THIS
		-- character finds every actively-held weapon (1-handed, dual,
		-- or whatever the future expands to). Returns the model's
		-- PrimaryPart — that's the BasePart particles/beams attach to.
		for _, weaponModel in CollectionService:GetTagged('EquippedWeapon') do
			if not weaponModel:IsA('Model') then continue end
			if not weaponModel:IsDescendantOf(character) then continue end
			local primary = weaponModel.PrimaryPart
			if primary and primary:IsA('BasePart') then
				out[#out + 1] = primary :: BasePart
			end
		end
		-- Legacy fallback (Tool-based weapons + name-keyed parts) for
		-- code that hasn't migrated to the tag yet.
		if #out == 0 then
			for _, child in character:GetChildren() do
				if child:IsA('Tool') then
					local handle = child:FindFirstChild('Handle')
					if handle and handle:IsA('BasePart') then
						out[#out + 1] = handle :: BasePart
					end
				end
			end
		end
		if #out == 0 then
			local fallback = character:FindFirstChild('Blade', true)
				or character:FindFirstChild('WeaponHandle', true)
			if fallback and fallback:IsA('BasePart') then
				out[#out + 1] = fallback :: BasePart
			end
		end
		return out

	elseif anchor == 'mount' then
		-- The MountsClient welds the mount primary to the rider's HRP
		-- but parents the Weld under the MOUNT, not the HRP.
		-- BasePart:GetJoints() walks every joint involving this part
		-- regardless of where the joint instance is parented; that's
		-- what finds the mount.
		local hrp = character:FindFirstChild('HumanoidRootPart') :: BasePart?
		if not hrp then return {} end
		for _, joint in hrp:GetJoints() do
			if joint:IsA('Weld') then
				local other = (joint.Part0 == hrp) and joint.Part1 or joint.Part0
				if other and other:IsA('BasePart') and other:IsDescendantOf(workspace) then
					out[#out + 1] = other :: BasePart
					break  -- single primary
				end
			end
		end
		return out
	end
	return out
end

----------------------------------------------------------------------
-- Spawn / despawn.
----------------------------------------------------------------------
local function despawn(player: Player, auraId: string)
	local byId = Active[player]; if not byId then return end
	local r = byId[auraId]; if not r then return end
	-- Step connection first so the runtime stops touching state we're
	-- about to destroy.
	if r.stepConn then r.stepConn:Disconnect() end
	-- Cleanup hook before tearing down attachments — the runtime might
	-- still be reading them, and Roblox would error on dead refs.
	if r.cleanup and r.runtimeState ~= nil then
		local ok, err = pcall(r.cleanup, r.runtimeState)
		if not ok then warn('AurasClient: aura cleanup errored: ', err) end
	end
	if r.loopSound then r.loopSound:Stop(); r.loopSound:Destroy() end
	-- Beams can live across two attachments — destroy explicitly so
	-- one attachment outliving the other for a frame doesn't leak.
	for _, beam in r.beams do if beam.Parent then beam:Destroy() end end
	for _, endAttach in r.endAttachments do
		if endAttach.Parent then endAttach:Destroy() end
	end
	for _, attach in r.attachments do
		if attach.Parent then attach:Destroy() end
	end
	byId[auraId] = nil
end

----------------------------------------------------------------------
-- Procedural builders. Translate the Procedural{Particle,Beam,Light}
-- table into Roblox instances. Authors can ship visuals without
-- dropping any AssetsShared.VFX.Auras templates; the procedural
-- layer always renders, and a template (when present) layers on top.
----------------------------------------------------------------------
local function buildProceduralParticle(spec: any, parent: Attachment): ParticleEmitter
	local pe = Instance.new('ParticleEmitter')
	pe.Texture = spec.Texture or DEFAULT_PARTICLE_TEXTURE
	-- Sensible defaults; spec values override when present.
	pe.Color = spec.Color or ColorSequence.new(Color3.new(1, 1, 1))
	pe.Size  = spec.Size  or NumberSequence.new(0.4, 0.05)
	pe.Transparency = spec.Transparency or NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	pe.Rate = spec.Rate or 12
	pe.Lifetime = spec.Lifetime or NumberRange.new(0.7, 1.0)
	pe.Speed = spec.Speed or NumberRange.new(1, 2)
	pe.SpreadAngle = spec.SpreadAngle or Vector2.new(180, 180)
	pe.Acceleration = spec.Acceleration or Vector3.new(0, 1, 0)
	pe.Drag = spec.Drag or 0
	pe.LightEmission = spec.LightEmission or 0.5
	pe.LightInfluence = 0
	pe.Parent = parent
	return pe
end

local function buildProceduralBeam(spec: any, attach0: Attachment, parent: BasePart): (Beam, Attachment)
	-- Beam needs two attachments; the second is offset by EndOffset
	-- from the first (in the parent BasePart's local space).
	local endAttach = Instance.new('Attachment')
	endAttach.Name = 'AuraBeamEnd'
	endAttach.CFrame = attach0.CFrame + (spec.EndOffset or Vector3.new(0, 4, 0))
	endAttach.Parent = parent

	local beam = Instance.new('Beam')
	beam.Attachment0 = attach0
	beam.Attachment1 = endAttach
	beam.Color = spec.Color or ColorSequence.new(Color3.new(1, 1, 1))
	beam.Width0 = spec.Width0 or 0.4
	beam.Width1 = spec.Width1 or 0.05
	beam.Transparency = spec.Transparency or NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 0.7),
	})
	beam.Texture = spec.Texture or DEFAULT_BEAM_TEXTURE
	beam.TextureLength = spec.TextureLength or 1.0
	beam.TextureSpeed = spec.TextureSpeed or 1.0
	beam.FaceCamera = spec.FaceCamera == true
	beam.LightEmission = 0.5
	beam.LightInfluence = 0
	beam.Parent = attach0
	return beam, endAttach
end

local function spawn(player: Player, auraId: string)
	despawn(player, auraId)
	local cfg = AurasConfig.Auras[auraId]
	if not cfg then return end
	local anchor = cfg.Anchor

	Active[player] = Active[player] or {}
	local r: Render = {
		auraId = auraId, anchor = anchor,
		attachments = {}, endAttachments = {}, lights = {}, particles = {}, beams = {},
	}
	Active[player][auraId] = r

	-- Resolve the anchor parts. Empty list = anchor not yet available
	-- (no character / no equipped weapon / not riding); the step() loop
	-- retries every Heartbeat until parts appear.
	local parts = findAnchorParts(player, anchor)
	if #parts == 0 then return end

	-- Asset template lookup. Same template applied per-part so a
	-- character aura with a `TemplateName` clones once per body part.
	local templateName = (cfg.Procedural and cfg.Procedural.TemplateName)
		or (cfg.VFX and cfg.VFX.Particle)
	local templateRoot = ReplicatedStorage:FindFirstChild('AssetsShared')
	templateRoot = templateRoot and templateRoot:FindFirstChild('VFX')
	templateRoot = templateRoot and templateRoot:FindFirstChild('Auras')
	local template = templateName and templateRoot and templateRoot:FindFirstChild(templateName)

	for _, part in parts do
		local attach = Instance.new('Attachment')
		-- Encode aura id + part name so the explorer reads cleanly:
		--   AuraAttach_character_glow_amber_RightUpperArm
		attach.Name = 'AuraAttach_' .. auraId .. '_' .. part.Name
		attach.Parent = part
		table.insert(r.attachments, attach)

		-- Per-part: clone the asset template (if any).
		local perPartEndAttach: Attachment? = nil
		if template then
			for _, child in template:GetDescendants() do
				if child:IsA('ParticleEmitter') then
					local pe = child:Clone()
					pe.Parent = attach
					table.insert(r.particles, pe)
				elseif child:IsA('Beam') then
					local beam = child:Clone()
					beam.Attachment0 = attach
					if not beam.Attachment1 then
						local endAttach = Instance.new('Attachment')
						endAttach.Name = 'AuraTemplateBeamEnd_' .. part.Name
						endAttach.CFrame = CFrame.new(0, 4, 0)
						endAttach.Parent = part
						beam.Attachment1 = endAttach
						perPartEndAttach = endAttach
					end
					beam.Parent = attach
					table.insert(r.beams, beam)
				end
			end
		end

		-- Per-part: procedural layer. ALWAYS runs — the procedural
		-- definition is the "art-missing" fallback that authors lean on.
		if cfg.Procedural and cfg.Procedural.Particle then
			local pe = buildProceduralParticle(cfg.Procedural.Particle, attach)
			table.insert(r.particles, pe)
		end
		if cfg.Procedural and cfg.Procedural.Beam and not perPartEndAttach then
			local beam, endAttach = buildProceduralBeam(cfg.Procedural.Beam, attach, part)
			perPartEndAttach = endAttach
			table.insert(r.beams, beam)
		end
		if perPartEndAttach then
			table.insert(r.endAttachments, perPartEndAttach)
		end

		local lightSpec = (cfg.Procedural and cfg.Procedural.Light) or (cfg.VFX and cfg.VFX.Light)
		if lightSpec then
			local light = Instance.new('PointLight')
			light.Color = lightSpec.Color or Color3.fromRGB(255, 220, 120)
			light.Brightness = lightSpec.Brightness or 1
			light.Range = lightSpec.Range or 6
			light.Parent = attach
			table.insert(r.lights, light)
		end
	end

	-- Looping SFX — single instance on the first attachment (the
	-- expected use is "ambient hum follows the player"; one source is
	-- plenty even with multi-anchor renders).
	local primaryAttach = r.attachments[1]
	if primaryAttach and cfg.SFX and cfg.SFX.Loop and cfg.SFX.Loop.Sound then
		local sound = Instance.new('Sound')
		sound.SoundId = cfg.SFX.Loop.Sound
		sound.Volume = cfg.SFX.Loop.Volume or 0.3
		sound.Looped = true
		sound.Parent = primaryAttach
		sound:Play()
		r.loopSound = sound
	end
	if cfg.SFX and cfg.SFX.Equip and cfg.SFX.Equip.Sound then
		SoundService.PlaySoundAtPosition(cfg.SFX.Equip.Sound, parts[1].Position)
	end

	-- Runtime hook (Setup → state, Step → tick, Cleanup → teardown).
	-- Setup gets the live attachment list so it can append per-part
	-- visuals or reposition things mid-flight. Step runs on Heartbeat
	-- if defined; Cleanup runs on despawn.
	local rt = cfg.Runtime
	if rt and rt.Setup then
		local ctx: AurasConfig.AuraRuntimeContext = {
			Player = player,
			AnchorParts = parts,
			Attachments = r.attachments,
		}
		local ok, state = pcall(rt.Setup, ctx)
		if ok then
			r.runtimeState = state
			r.cleanup = rt.Cleanup
			if rt.Step then
				r.stepConn = RunService.Heartbeat:Connect(function(dt)
					if not r.runtimeState then return end
					local stepOk, stepErr = pcall(rt.Step, r.runtimeState, dt)
					if not stepOk then
						warn('AurasClient: aura Step errored, disconnecting: ', stepErr)
						if r.stepConn then r.stepConn:Disconnect(); r.stepConn = nil end
					end
				end)
			end
		else
			warn('AurasClient: aura Setup errored: ', state)
		end
	end
end

----------------------------------------------------------------------
-- Re-attach loop. Anchors aren't always available at Spawn time
-- (mount might still be spawning, weapon might be sheathed); the loop
-- looks for unattached aura entries every tick and attaches them.
----------------------------------------------------------------------
local function step(_dt: number)
	for player, byId in Active do
		for auraId, r in byId do
			-- Re-spawn when no attachments are live OR the first
			-- attachment's parent is gone (character respawn /
			-- equipped weapon unequipped / mount despawned).
			local needsRespawn = (#r.attachments == 0)
				or (r.attachments[1] and not r.attachments[1].Parent)
			if not needsRespawn then
				-- Anchor part-list shape change: e.g. the player just
				-- equipped a second weapon, or the mount swapped to a
				-- new model. Cheap re-resolve + count comparison —
				-- O(parts_per_anchor) per render, per frame.
				local parts = findAnchorParts(player, r.anchor)
				if #parts ~= #r.attachments then needsRespawn = true end
			end
			if needsRespawn then
				spawn(player, auraId)
			end
		end
	end
end

----------------------------------------------------------------------
-- Slot state. Updated by SlotsChanged cue from the server. Other UI
-- widgets read these via Module.GetSlotState() — currently unused
-- by AurasClient itself, but exposed so a future AurasTab can
-- render `currentEquipped / maxSlots` without re-deriving.
----------------------------------------------------------------------
local SlotCurrent = 0
local SlotMax     = 1

function Module.GetSlotState(): (number, number)
	return SlotCurrent, SlotMax
end

----------------------------------------------------------------------
-- Public client API.
----------------------------------------------------------------------
function Module.AttemptEquip(auraId: string)
	AuraEvent:FireServer(AurasShared.AuraActions.TryEquip, auraId)
end

function Module.AttemptUnequip(auraId: string)
	-- Signature change: was anchor-keyed (TryUnequip 'character').
	-- The new server expects an aura id — UI passes the equipped id
	-- it wants to remove. Anchor-only unequip is no longer meaningful
	-- because multi-equip stacks several auras on the same anchor.
	AuraEvent:FireServer(AurasShared.AuraActions.TryUnequip, auraId)
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	RunService.Heartbeat:Connect(step)

	AuraEvent.OnClientEvent:Connect(function(action, ...)
		if action == AurasShared.AuraActions.Spawn then
			local player, auraId = ...
			spawn(player, auraId)
		elseif action == AurasShared.AuraActions.Despawn then
			local player, auraId = ...
			despawn(player, auraId)
		elseif action == AurasShared.AuraActions.SlotsChanged then
			local current, max = ...
			SlotCurrent = current or 0
			SlotMax     = max or 1
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		local byId = Active[player]
		if byId then
			for auraId in byId do despawn(player, auraId) end
		end
		Active[player] = nil
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Gameplay/CameraModeClient.luau"><![CDATA[-- // CameraModeClient.luau //
-- Three-mode camera / shift-lock cycle. Press Shift to advance:
--
--   Free            — standard Roblox camera. Mouse free, character
--                     auto-rotates with WASD movement.
--   CameraShiftLock — mouse locked to screen center (camera drag is
--                     wheel-only) but the character still auto-rotates
--                     with WASD. Useful for aiming the camera without
--                     forcing the character to face camera-forward.
--   CharacterShiftLock — standard Roblox shift lock: mouse locked AND
--                        the character continuously rotates to face
--                        the camera's flat-look direction. Default
--                        Roblox feel.
--
-- Roblox's built-in DevEnableMouseLock is left disabled (set in
-- Module.Start) — we drive the lock state ourselves so the cycle is
-- tri-state, not just on/off.
--
-- TargetLockClient takes precedence: while a target is locked, that
-- module owns the camera (Scriptable) + character orientation. Our
-- per-frame humanoid rotation skips the rotate step in that case so
-- both systems don't fight.

local Players              = game:GetService('Players')
local UserInputService      = game:GetService('UserInputService')
local RunService            = game:GetService('RunService')
local ContextActionService  = game:GetService('ContextActionService')

local LocalPlayer = Players.LocalPlayer

local Module = {}

-- Mode enum. Strings (not numeric) so error messages + telemetry
-- read clearly without an enum-name lookup.
local MODES = { 'Free', 'CameraShiftLock', 'CharacterShiftLock' }
local CurrentMode: string = 'Free'

-- External-lock guard. While true, CycleMode + Shift-key are no-ops
-- and the active mode is forced to Free. TargetLockClient flips this
-- on lock/clear so the player can't enter shift-lock while target-
-- locked (the lock-on system owns character rotation in that state).
local ExternalLockActive: boolean = false
-- Mode the player was in BEFORE the external lock engaged. Restored
-- on release so target-lock toggle doesn't permanently kick players
-- out of their preferred shift-lock setting.
local ModeBeforeExternalLock: string? = nil

-- RenderStep slot used by the character-shift-lock rotation pass.
-- Bound at `Camera + 1` priority so it runs AFTER the default camera
-- finalizes its CFrame each frame (same idiom as TargetLockClient).
local CHAR_ROTATE_RENDER_NAME = 'CameraModeCharacterRotate'
local CHAR_ROTATE_PRIORITY    = Enum.RenderPriority.Camera.Value + 1

-- Optional: small over-the-shoulder camera offset for character
-- shift-lock so the player can see what they're aiming at without
-- the camera being centered behind the head. 0 to disable.
local SHIFT_LOCK_CAMERA_OFFSET = Vector3.new(1.5, 0, 0)

-- CAS priority used to suppress Roblox's built-in MouseLockSwitchAction
-- (LeftAlt / RightAlt / `;`). PlayerModule binds it at the default
-- priority (2000); ContextActionPriority.High = 4000 reliably sinks
-- before that handler fires. Without this, pressing Alt with swords
-- drawn flips Humanoid.AutoRotate / CameraOffset under us — the
-- character visually freezes while the camera reframes.
local MOUSELOCK_SINK_NAME     = 'CameraMode_SinkMouseLockKeys'
local MOUSELOCK_SINK_PRIORITY = Enum.ContextActionPriority.High.Value

----------------------------------------------------------------------
-- Helpers.
----------------------------------------------------------------------

-- Returns true when TargetLockClient is currently driving the camera
-- via its Scriptable override. We yield character rotation to it
-- because lock-on-driven character orient is its responsibility.
local function isTargetLockActive(): boolean
	local camera = workspace.CurrentCamera
	if not camera then return false end
	return camera.CameraType == Enum.CameraType.Scriptable
end

-- Read the local player's humanoid; returns nil while the character
-- is mid-respawn.
local function getHumanoid(): Humanoid?
	local character = LocalPlayer.Character
	return character and (character:FindFirstChildOfClass('Humanoid'))
end

----------------------------------------------------------------------
-- Per-frame character rotation for CharacterShiftLock. Rotates the
-- humanoid's HRP toward the camera's XZ-flat look so movement input
-- is camera-relative AND the character visually faces forward.
-- Skipped when target-lock is active — that system owns rotation.
----------------------------------------------------------------------
local function characterRotateStep(_dt: number)
	if CurrentMode ~= 'CharacterShiftLock' then return end
	if isTargetLockActive() then return end
	local humanoid = getHumanoid()
	if not humanoid then return end
	local hrp = humanoid.RootPart
	if not hrp then return end
	local camera = workspace.CurrentCamera
	if not camera then return end

	local lookXZ = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
	if lookXZ.Magnitude < 0.01 then return end
	-- Set HRP CFrame to the camera-aligned look. AutoRotate=false (set
	-- when entering this mode) prevents Humanoid's MoveDirection-driven
	-- rotation from fighting us each frame.
	hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + lookXZ.Unit)
end

----------------------------------------------------------------------
-- Mode application. Idempotent — applies the current mode's settings
-- to MouseBehavior + Humanoid.AutoRotate + the optional CameraOffset.
-- Re-runnable on character spawn so a respawn doesn't drop the mode.
----------------------------------------------------------------------
local function applyMode()
	local humanoid = getHumanoid()

	if CurrentMode == 'Free' then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		if humanoid then
			humanoid.AutoRotate = true
			humanoid.CameraOffset = Vector3.zero
		end

	elseif CurrentMode == 'CameraShiftLock' then
		-- Lock the mouse to screen center but leave the character
		-- alone. Camera drags follow mouse delta naturally; character
		-- rotates to its WASD movement direction (not the camera's).
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		if humanoid then
			humanoid.AutoRotate = true
			humanoid.CameraOffset = Vector3.zero
		end

	elseif CurrentMode == 'CharacterShiftLock' then
		-- Mouse locked + per-frame humanoid rotation toward camera.
		-- AutoRotate=false stops Humanoid's MoveDirection rotation
		-- from spinning the character on every WASD press.
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		if humanoid then
			humanoid.AutoRotate = false
			humanoid.CameraOffset = SHIFT_LOCK_CAMERA_OFFSET
		end
	end
end

----------------------------------------------------------------------
-- Public API.
----------------------------------------------------------------------

function Module.GetMode(): string
	return CurrentMode
end

-- Set the camera mode explicitly. Useful for cmdr / settings hooks
-- that want to bypass the cycle order.
function Module.SetMode(mode: string)
	for _, valid in MODES do
		if valid == mode then
			CurrentMode = mode
			applyMode()
			return
		end
	end
end

-- Cycle Free → CameraShiftLock → CharacterShiftLock → Free.
function Module.CycleMode()
	-- Suppressed while another system owns the camera/character
	-- (e.g. TargetLockClient is target-locked). Cycling during that
	-- window would let the player enter shift-lock under the lock-on
	-- system's per-frame humanoid rotation pass — they'd fight.
	if ExternalLockActive then return end
	for i, mode in MODES do
		if mode == CurrentMode then
			CurrentMode = MODES[(i % #MODES) + 1]
			applyMode()
			return
		end
	end
	-- Defensive: unknown current mode → reset to Free.
	CurrentMode = 'Free'
	applyMode()
end

-- External lock toggle. While locked, the cycle is no-op and the
-- mode is forced to Free; releasing restores whatever the player had
-- selected before the lock engaged. Idempotent — re-locking while
-- already locked stashes the same prior mode.
function Module.SetExternalLock(locked: boolean)
	if locked == ExternalLockActive then return end
	ExternalLockActive = locked
	if locked then
		ModeBeforeExternalLock = CurrentMode
		CurrentMode = 'Free'
		applyMode()
	else
		-- Restore prior mode if we have one stashed; otherwise stay
		-- in Free (the lock entered with no prior mode known).
		if ModeBeforeExternalLock then
			CurrentMode = ModeBeforeExternalLock
			ModeBeforeExternalLock = nil
		end
		applyMode()
	end
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------

function Module.Start()
	-- DevEnableMouseLock is studio-only (the runtime rejects script
	-- writes with "Insufficient permissions"). The user disables it
	-- manually in Game Settings → Avatar → Mouse Lock so our
	-- tri-state cycle isn't fighting Roblox's built-in shift-lock
	-- toggle on the same key. Setup note in CAMERA_NIER_NOTES, not
	-- enforced here.

	-- Belt-and-suspenders: even when DevEnableMouseLock is left ON
	-- (forgotten in Game Settings, fresh place file, etc.), sink the
	-- keys PlayerModule.MouseLockController binds to the built-in
	-- MouseLockSwitchAction so the toggle never reaches that handler.
	-- Without this, pressing Alt with weapons drawn flips
	-- Humanoid.AutoRotate / CameraOffset out from under combat
	-- animations and the character reads as frozen mid-stride.
	ContextActionService:BindActionAtPriority(
		MOUSELOCK_SINK_NAME,
		function() return Enum.ContextActionResult.Sink end,
		false,
		MOUSELOCK_SINK_PRIORITY,
		Enum.KeyCode.LeftAlt,
		Enum.KeyCode.RightAlt,
		Enum.KeyCode.Semicolon
	)

	-- Shift cycles. Both Left and Right Shift → same handler so
	-- either physical shift key works. Filtered against `processed`
	-- so cmdr / chat / UI text inputs don't trigger a cycle.
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		if input.KeyCode == Enum.KeyCode.LeftShift
			or input.KeyCode == Enum.KeyCode.RightShift then
			Module.CycleMode()
		end
	end)

	-- Re-apply on character spawn — Humanoid is fresh each respawn,
	-- so AutoRotate / CameraOffset would otherwise reset to defaults
	-- and drop the mode silently.
	LocalPlayer.CharacterAdded:Connect(function()
		-- Wait one frame for the Humanoid to be parented.
		task.defer(applyMode)
	end)

	-- Per-frame character rotation for CharacterShiftLock. The
	-- callback no-ops when not in that mode — bound once and left
	-- alone for the session.
	RunService:BindToRenderStep(CHAR_ROTATE_RENDER_NAME, CHAR_ROTATE_PRIORITY, characterRotateStep)

	-- Apply current mode (Free) once on startup so MouseBehavior is
	-- in a known state if the player joined while their previous
	-- session left it locked.
	applyMode()
end

function Module.Init(_otherSystems) end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Gameplay/CharacterCosmeticsClient.luau"><![CDATA[

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local ReplicatedData = ReplicatedModules.Services.ReplicatedData
local CharacterModelModule = ReplicatedModules.Utility.Character

local SystemsContainer = {}

-- // Module // --
local Module = {}

function Module.UpdatePlayerCosmetics()
	local playerCosmetics = ReplicatedData.GetData('PlayerCosmetics')
	if not playerCosmetics then
		return
	end

	for playerName, cosmeticData in playerCosmetics do
		local Character = workspace:FindFirstChild( playerName )
		if not Character then
			continue
		end

		local rootPart = Character:FindFirstChild('HumanoidRootPart')
		if rootPart and not rootPart:FindFirstChildWhichIsA('Light') then
			local bodyLight = Instance.new('PointLight')
			bodyLight.Range = 32
			bodyLight.Shadows = false
			bodyLight.Brightness = 0.05
			bodyLight.Parent = rootPart
		end

		CharacterModelModule.ClearBaseCustomizations( Character )
		CharacterModelModule.ApplyBaseCustomizations( Character, cosmeticData )
	end
end

function Module.UpdateWorkspaceCharacter( Character )
	local playerCosmetics = ReplicatedData.GetData('PlayerCosmetics')
	if not playerCosmetics then
		return
	end

	local cosmeticData = playerCosmetics[ Character.Name ]
	if not cosmeticData then
		return
	end

	CharacterModelModule.ClearBaseCustomizations( Character )
	CharacterModelModule.ApplyBaseCustomizations( Character, cosmeticData )
end

function Module.Start()
	ReplicatedData.OnUpdated:Connect(function(category, _)
		if category == 'PlayerCosmetics' then
			Module.UpdatePlayerCosmetics()
		end
	end)

	for _, Character in workspace:GetChildren() do
		if Character:IsA('Model') and Character:FindFirstChildWhichIsA('Humanoid') then
			task.spawn( Module.UpdateWorkspaceCharacter, Character )
		end
	end

	workspace.ChildAdded:Connect(function(Character)
		task.wait()
		if Character:IsA('Model') and Character:FindFirstChildWhichIsA('Humanoid') then
			task.spawn( Module.UpdateWorkspaceCharacter, Character )
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Gameplay/CombatAnimationClient.luau"><![CDATA[-- // CombatAnimationClient.luau //
-- The only place combat touches an AnimationTrack.
--
-- See NIER_COMBAT.md for the design.
--
-- THIS MODULE IS ALLOWED TO FAIL. Every function here is a cosmetic
-- side effect with no return value the rest of combat consults. If an
-- asset id is wrong, an animation never replicates, `LoadAnimation`
-- throws, or a whole AttackSet is missing, the player sees a character
-- that swings without flourish — and every hitbox, timing, state
-- transition, launch and slam still resolves exactly as authored.
--
-- That property used to be untrue in a subtle way. The old client read
-- `track.Length` off loaded animations, fed it into a timing resolver,
-- and shipped the result to the server as the swing's active/recovery
-- window. The server ignored those numbers, so the visible swing and
-- the real hit window silently disagreed by however much the animation
-- differed from the authored duration — and only when the asset had
-- finished loading, making it a race. Animation length is no longer
-- read anywhere. The one remaining use of duration is the OPPOSITE
-- direction: we scale playback speed to fit the authored window, so the
-- visual matches gameplay rather than the other way round.

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CombatConfigModule = ReplicatedModules.Data.CombatConfig
local AnimationService = ReplicatedModules.Services.AnimationService

local Module = {}

-- Per-class loaded slot dictionaries, rebuilt on respawn.
local SlotTracksByClass: { [string]: { [string]: AnimationTrack } } = {}
-- Legacy per-hand arrays, kept as a round-robin fallback for classes
-- whose per-slot entries have not been authored yet.
local HandTracksByClass: { [string]: { [string]: { AnimationTrack } } } = {}
local StateTracks: { [string]: AnimationTrack } = {}
local ActiveAnimator: Animator? = nil

----------------------------------------------------------------------
-- Loading. Nothing below may throw into a caller.
----------------------------------------------------------------------
local function safeLoad(animator: Animator, value: any): AnimationTrack?
	if typeof(value) ~= 'string' and typeof(value) ~= 'number' then return nil end
	local ok, track = pcall(function()
		local resolved = AnimationService.ResolveAnimationValue(value)
		if not resolved then return nil end
		return animator:LoadAnimation(resolved)
	end)
	if not ok then return nil end
	return track
end

-- Loads one weapon class's set on demand. Returns two tables, either of
-- which may legitimately be empty.
local function ensureClassLoaded(weaponClass: string)
	if SlotTracksByClass[weaponClass] then return end

	local slots: { [string]: AnimationTrack } = {}
	local hands: { [string]: { AnimationTrack } } = {}
	SlotTracksByClass[weaponClass] = slots
	HandTracksByClass[weaponClass] = hands

	local animator = ActiveAnimator
	if not animator then return end

	local set = CombatConfigModule.AttackSets[weaponClass]
		or CombatConfigModule.AttackSets.Default
		or {}

	for key, value in set do
		if typeof(value) == 'table' then
			-- Hand arrays (LeftHand / RightHand / DualHand). The shared
			-- dictionary loader skips nested tables entirely, which is
			-- why the previous hand fallback silently resolved to nil
			-- for every class — handled explicitly here instead.
			local tracks = {}
			for _, entry in value do
				local track = safeLoad(animator, entry)
				if track then tracks[#tracks + 1] = track end
			end
			hands[key] = tracks
		else
			local track = safeLoad(animator, value)
			if track then slots[key] = track end
		end
	end
end

----------------------------------------------------------------------
-- Playback.
----------------------------------------------------------------------

-- Round-robin fallback so an unauthored slot still shows SOMETHING
-- class-appropriate rather than a frozen character.
local function pickFallback(weaponClass: string, wieldType: string, step: number): AnimationTrack?
	local hands = HandTracksByClass[weaponClass]
	local tracks = hands and hands[wieldType]
	if not tracks or #tracks == 0 then return nil end
	return tracks[((step - 1) % #tracks) + 1]
end

-- Plays the animation for a move. `move` is the authored recipe; the
-- only field read from it is the cosmetic slot name plus the total
-- duration used to fit playback speed.
--
-- `speedBonus` is the caller's stat-derived multiplier (Strength swing
-- speed). It is applied to PLAYBACK ONLY and never travels back into
-- gameplay timing.
function Module.PlayMoveAnimation(weaponClass: string, move: any, wieldType: string, step: number, speedBonus: number?)
	if typeof(weaponClass) ~= 'string' or typeof(move) ~= 'table' then return end
	ensureClassLoaded(weaponClass)

	local slots = SlotTracksByClass[weaponClass]
	local track = (slots and move.AnimationSlot) and slots[move.AnimationSlot] or nil
	if not track then
		track = pickFallback(weaponClass, wieldType or 'RightHand', step or 1)
	end
	if not track then return end

	local speed = speedBonus or 1
	-- Fit the clip into the authored window. `Length` is 0 until the
	-- asset finishes replicating, in which case we simply play at
	-- natural speed — a slightly mistimed visual, never a wrong hitbox.
	local ok, length = pcall(function() return track.Length end)
	if ok and typeof(length) == 'number' and length > 0 and (move.Total or 0) > 0 then
		speed *= (length / move.Total)
	end

	pcall(function()
		track:Play(0.1, 1, speed)
	end)
end

function Module.StopAttackAnimations(fadeTime: number?)
	for _, slots in SlotTracksByClass do
		for _, track in slots do
			pcall(function()
				if track.IsPlaying then track:Stop(fadeTime or 0.08) end
			end)
		end
	end
	for _, hands in HandTracksByClass do
		for _, tracks in hands do
			for _, track in tracks do
				pcall(function()
					if track.IsPlaying then track:Stop(fadeTime or 0.08) end
				end)
			end
		end
	end
end

----------------------------------------------------------------------
-- State animations (stunned, knocked down, guarding, sheathe).
--
-- These are driven from replicated ATTRIBUTES rather than from local
-- prediction, so what the player sees always agrees with the state the
-- server believes they are in.
----------------------------------------------------------------------
function Module.PlayState(name: string, fadeTime: number?)
	local track = StateTracks[name]
	if not track then return end
	pcall(function()
		if not track.IsPlaying then track:Play(fadeTime or 0.1) end
	end)
end

function Module.StopState(name: string, fadeTime: number?)
	local track = StateTracks[name]
	if not track then return end
	pcall(function()
		if track.IsPlaying then track:Stop(fadeTime or 0.1) end
	end)
end

function Module.PlayStateOnce(name: string, speed: number?)
	local track = StateTracks[name]
	if not track then return end
	pcall(function()
		track:Play(0.1, 1, speed or 1)
	end)
end

function Module.HasState(name: string): boolean
	return StateTracks[name] ~= nil
end

----------------------------------------------------------------------
-- Character lifecycle.
----------------------------------------------------------------------
function Module.BindCharacter(character: Model)
	table.clear(SlotTracksByClass)
	table.clear(HandTracksByClass)
	table.clear(StateTracks)
	ActiveAnimator = nil

	local humanoid = character:FindFirstChildWhichIsA('Humanoid')
	if not humanoid then return end

	local animator = humanoid:FindFirstChildWhichIsA('Animator')
	if not animator then
		animator = Instance.new('Animator')
		animator.Parent = humanoid
	end
	ActiveAnimator = animator

	local set = CombatConfigModule.AnimationSets.Default or {}
	for key, value in set do
		if typeof(value) ~= 'table' then
			local track = safeLoad(animator, value)
			if track then StateTracks[key] = track end
		end
	end
end

function Module.UnbindCharacter()
	table.clear(SlotTracksByClass)
	table.clear(HandTracksByClass)
	table.clear(StateTracks)
	ActiveAnimator = nil
end

function Module.Init(_otherSystems) end
function Module.Start() end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Gameplay/CombatClient.luau"><![CDATA[-- // CombatClient.luau //
-- Combat client shell: wiring and remote dispatch.
--
-- See NIER_COMBAT.md for the design.
--
-- This module used to be 1189 lines holding input binding, combo
-- prediction, animation loading and length measurement, dodge direction
-- resolution, control locking, guard walk-speed handling and the remote
-- listener all at once. Those are now four focused modules:
--
--   CombatInputClient       bindings, input buffer, intent dispatch
--   CombatPredictionClient  local combo, cancel windows, reconciliation
--   CombatAnimationClient   every AnimationTrack, and nothing else
--   CombatMotionClient      control lock, guard speed, lock-on facing
--
-- What remains here is the seam: lifecycle wiring and the single
-- OnClientEvent dispatcher. Keeping the entry point at this name means
-- HotbarWidget and the settings tabs continue to reach combat where
-- they always have.

local Players = game:GetService('Players')
local Debris = game:GetService('Debris')

local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CombatConfigModule = ReplicatedModules.Data.CombatConfig
local CombatActions = ReplicatedModules.Data.CombatActions
local CombatShared = ReplicatedModules.Services.CombatShared
local SoundService = ReplicatedModules.Services.SoundService
local ReplicatedData = ReplicatedModules.Services.ReplicatedData

local RemoteService = ReplicatedModules.Services.RemoteService
local CombatEvent = RemoteService.GetRemote('CombatEvent', 'RemoteEvent', false)

local LocalSettingsRegistry =
	require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules')).Modules.SettingsRegistry

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Sub-module access. These are siblings in the Gameplay container; the
-- framework fills SystemsContainer during Init.
----------------------------------------------------------------------
local function inputClient() return SystemsContainer.CombatInputClient end
local function animationClient() return SystemsContainer.CombatAnimationClient end
local function predictionClient() return SystemsContainer.CombatPredictionClient end
local function motionClient() return SystemsContainer.CombatMotionClient end
local function perfectDodgeClient() return SystemsContainer.PerfectDodgeClient end

----------------------------------------------------------------------
-- Audio.
----------------------------------------------------------------------
local function playCombatSFX(character: Instance, configKey: string)
	local config = CombatConfigModule.SoundEffects and CombatConfigModule.SoundEffects[configKey]
	if not config then return end
	local root = character:FindFirstChild('HumanoidRootPart')
	local position = root and (root :: BasePart).Position or character:GetPivot().Position
	local sound, attachment = SoundService.CreateSoundAtPosition(config.SoundId, position)
	if not sound or not attachment then return end
	sound.Volume = config.Volume * LocalSettingsRegistry.GetSFXMultiplier()
	sound:Play()
	Debris:AddItem(attachment, sound.TimeLength + 0.5)
end

----------------------------------------------------------------------
-- Weapon draw. Public because HotbarWidget binds the same action.
----------------------------------------------------------------------
function Module.AttemptWeaponDrawnToggle()
	local character = LocalPlayer.Character
	if not character then return end
	local input = inputClient()
	if input then
		input.AttemptWeaponToggle()
	end
end

-- Plays the sheathe/unsheathe presentation. Driven by the server's
-- WeaponToggled broadcast rather than by the local press, so the
-- animation never disagrees with the authoritative drawn state.
local function onWeaponToggled(payload: any)
	if typeof(payload) ~= 'table' then return end
	local character = payload.Caster
	if character ~= LocalPlayer.Character then return end

	local Animation = animationClient()
	if not Animation then return end

	-- Agility sheathe-speed perk: +1% playback per level. Visual only.
	local data = ReplicatedData.GetData('PlayerData', false)
	local level = 0
	if data and typeof(data.Attributes) == 'table' then
		local entry = data.Attributes.Agility
		if typeof(entry) == 'number' then
			level = entry
		elseif typeof(entry) == 'table' and tonumber(entry.Level) then
			level = entry.Level
		end
	end
	local speed = 1 + level * 0.01

	local drawing = payload.Drawn == true
	local hasLeft = CombatShared.DoesCharacterHaveLeftWeapon(character)
	local hasRight = CombatShared.DoesCharacterHaveRightWeapon(character)

	if drawing then
		if hasLeft then Animation.PlayStateOnce('UnSheatheLeft', speed) end
		if hasRight then Animation.PlayStateOnce('UnSheatheRight', speed) end
		playCombatSFX(character, 'UnSheathe')
	else
		if hasLeft then Animation.PlayStateOnce('ToSheatheLeft', speed) end
		if hasRight then Animation.PlayStateOnce('ToSheatheRight', speed) end
		playCombatSFX(character, 'ToSheathe')
	end
end

----------------------------------------------------------------------
-- Remote dispatch.
--
-- Every message is (actionString, payloadTable). None of these carry
-- authority: a client that dropped all of them would still be playing
-- the same game, just without impact effects and with a combo string
-- that drifts until the next confirmation.
----------------------------------------------------------------------
local function onCombatEvent(action: string, payload: any)
	if typeof(action) ~= 'string' then return end
	local Actions = CombatActions.Actions

	if action == Actions.ActionStarted then
		local Prediction = predictionClient()
		if Prediction then Prediction.OnActionStarted(payload) end
		-- Turn toward the server's acquired target and apply the swing's
		-- movement penalty. Both are the local character's own job: its
		-- root is client-owned, so the server can neither rotate it nor
		-- hold it in place without replicating a stale transform back.
		local Motion = motionClient()
		if Motion and Motion.OnActionStarted then
			Motion.OnActionStarted(payload)
		end

	elseif action == Actions.ActionRejected then
		local Prediction = predictionClient()
		if Prediction then Prediction.OnActionRejected(payload) end

	elseif action == Actions.ActionCancelled then
		local Prediction = predictionClient()
		if Prediction then Prediction.OnActionCancelled(payload) end

	elseif action == Actions.HitConfirmed then
		-- Impact presentation. The finisher flourish is only rendered
		-- when the server itself flagged the hit as a finisher, so a
		-- forged combo claim cannot manufacture the VFX.
		if typeof(payload) == 'table' and payload.IsFinisher then
			local PerfectDodge = perfectDodgeClient()
			if PerfectDodge and PerfectDodge.OnFinisherHit then
				PerfectDodge.OnFinisherHit(payload.Caster, payload.Victims)
			end
		end

	elseif action == Actions.PerfectDodge then
		local PerfectDodge = perfectDodgeClient()
		if PerfectDodge and PerfectDodge.OnPerfectDodge and typeof(payload) == 'table' then
			PerfectDodge.OnPerfectDodge(payload.Caster)
		end

	elseif action == Actions.GuardBlocked then
		if typeof(payload) == 'table' then
			CombatShared.BlockedEffect(payload.Caster)
		end

	elseif action == Actions.GuardBroken then
		if typeof(payload) == 'table' then
			CombatShared.BlockBreakEffect(payload.Caster)
		end

	elseif action == Actions.WeaponToggled then
		onWeaponToggled(payload)
	end
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.OnCharacterAdded(character: Model)
	local Animation = animationClient()
	if Animation then Animation.BindCharacter(character) end

	local Motion = motionClient()
	if Motion then Motion.OnCharacterAdded(character) end

	local Input = inputClient()
	if Input then Input.OnCharacterAdded() end

	local Prediction = predictionClient()
	if Prediction then Prediction.ResetCombo() end
end

function Module.Start()
	local Input = inputClient()
	if Input then Input.BindInputs() end

	if LocalPlayer.Character then
		Module.OnCharacterAdded(LocalPlayer.Character)
	end
	LocalPlayer.CharacterAdded:Connect(Module.OnCharacterAdded)

	CombatEvent.OnClientEvent:Connect(onCombatEvent)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Gameplay/CombatInputClient.luau"><![CDATA[-- // CombatInputClient.luau //
-- Input binding, local input buffering, and intent dispatch.
--
-- See NIER_COMBAT.md for the design.
--
-- The buffer is the reason this is its own module. Previously an input
-- that arrived while a swing was still running was simply dropped: the
-- client fired anyway, the server refused it because the attack
-- cooldown covered the entire move, and the press vanished. At the
-- rhythm a player naturally mashes, that loses roughly one input in
-- three and reads as the game ignoring you.
--
-- Now an early input is HELD and replayed the instant the running move
-- reaches its authored cancel point. The server buffers on the same
-- rule against the same numbers, so a replayed input is accepted rather
-- than merely re-rejected. One input is held at a time — mashing five
-- times during a slow hammer swing queues one follow-up, not five.

local ContextActionService = game:GetService('ContextActionService')
local UserInputService = game:GetService('UserInputService')
local Players = game:GetService('Players')

local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CombatConfigModule = ReplicatedModules.Data.CombatConfig
local CombatActions = ReplicatedModules.Data.CombatActions
local CombatShared = ReplicatedModules.Services.CombatShared
local ReplicatedData = ReplicatedModules.Services.ReplicatedData

local RemoteService = ReplicatedModules.Services.RemoteService
local CombatEvent = RemoteService.GetRemote('CombatEvent', 'RemoteEvent', false)

local LocalSettingsRegistry =
	require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules')).Modules.SettingsRegistry

local SystemsContainer = {}

local Module = {}

local HeldKeys: { [Enum.KeyCode]: boolean } = {}
local BufferedAttack: any? = nil
local SwingStep = 0

-- Default keybinds. Players override these in the settings keybind tab;
-- PlayerData.ActionKeybinds[actionId] holds the override.
local DEFAULT_ACTION_KEYBINDS: { [string]: string } = {
	Block         = 'F',
	SheatheToggle = 'Q',
	Mount         = 'G',
	Heal          = 'H',
	Dash          = 'LeftControl',
	HeavyAttack   = 'T',
}

-- How long a directional dash mode waits for a WASD press before giving
-- up. Long enough to be usable, short enough not to feel like a stall.
local DASH_DIRECTIONAL_TIMEOUT = 0.5

local function getActionKeyCode(actionId: string): Enum.KeyCode?
	local data = ReplicatedData.GetData('PlayerData', false)
	local override = data and typeof(data.ActionKeybinds) == 'table' and data.ActionKeybinds[actionId]
	local name = (typeof(override) == 'string' and #override > 0)
		and override
		or DEFAULT_ACTION_KEYBINDS[actionId]
	if not name then return nil end
	local ok, keyCode = pcall(function() return (Enum.KeyCode :: any)[name] end)
	if not ok then return nil end
	return keyCode
end

----------------------------------------------------------------------
-- Direction helpers for dodge.
----------------------------------------------------------------------
local function getInputMovementDir(): Vector3
	local x, z = 0, 0
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then z -= 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then z += 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then x -= 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then x += 1 end
	if x == 0 and z == 0 then return Vector3.zero end
	return Vector3.new(x, 0, z).Unit
end

local function waitForDirectionalKey(timeout: number): Vector3?
	local resolved: Vector3? = nil
	local connection = UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		local x, z = 0, 0
		if input.KeyCode == Enum.KeyCode.W then z = -1
		elseif input.KeyCode == Enum.KeyCode.S then z = 1
		elseif input.KeyCode == Enum.KeyCode.A then x = -1
		elseif input.KeyCode == Enum.KeyCode.D then x = 1
		else return
		end
		resolved = Vector3.new(x, 0, z).Unit
	end)
	local deadline = os.clock() + timeout
	while resolved == nil and os.clock() < deadline do task.wait() end
	connection:Disconnect()
	return resolved
end

-- Map input-space (forward = -Z, right = +X) into world space using
-- either the camera's or the character's flattened basis.
local function inputDirToWorld(inputDir: Vector3, useCamera: boolean): Vector3
	local basis
	if useCamera then
		local camera = workspace.CurrentCamera
		if not camera then return inputDir end
		basis = camera.CFrame
	else
		local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild('HumanoidRootPart') :: BasePart?
		if not root then return inputDir end
		basis = root.CFrame
	end
	local forward = Vector3.new(basis.LookVector.X, 0, basis.LookVector.Z)
	forward = forward.Magnitude > 0 and forward.Unit or Vector3.new(0, 0, -1)
	local right = Vector3.new(-forward.Z, 0, forward.X)
	return (right * inputDir.X) + (forward * -inputDir.Z)
end

local function getLockedTarget(): Model?
	local TargetLockClient = SystemsContainer.TargetLockClient
	if not TargetLockClient or not TargetLockClient.GetLockedTarget then return nil end
	return TargetLockClient.GetLockedTarget()
end

-- Resolve the dodge direction from the player's chosen dash mode, with
-- a lock-on override: while locked, the dodge basis is target-relative
-- so forward closes, back retreats and the strafes circle. That is the
-- lock-on evade the whole camera mode exists to support.
local function resolveDodgeDirection(character: Model): Vector3?
	local lockedTarget = getLockedTarget()
	if lockedTarget then
		local root = character:FindFirstChild('HumanoidRootPart') :: BasePart?
		local targetRoot = lockedTarget:FindFirstChild('HumanoidRootPart') :: BasePart?
		if root and targetRoot then
			local forward = Vector3.new(
				targetRoot.Position.X - root.Position.X, 0,
				targetRoot.Position.Z - root.Position.Z)
			forward = forward.Magnitude > 0 and forward.Unit or Vector3.new(0, 0, -1)
			local right = Vector3.new(-forward.Z, 0, forward.X)
			local input = getInputMovementDir()
			if input.Magnitude > 0.1 then
				local direction = (right * input.X) + (forward * -input.Z)
				return direction.Magnitude > 0 and direction.Unit or forward
			end
			-- No stick input while locked: step toward the target.
			return forward
		end
	end

	local mode = LocalSettingsRegistry.DashMode or 'CameraDirection'

	if mode == 'CameraDirection' or mode == 'CharacterDirection' then
		local useCamera = mode == 'CameraDirection'
		local input = getInputMovementDir()
		if input.Magnitude > 0.1 then
			return inputDirToWorld(input, useCamera)
		end
		-- Idle: backstep relative to the chosen basis.
		local basis
		if useCamera then
			basis = workspace.CurrentCamera and workspace.CurrentCamera.CFrame
		else
			local root = character:FindFirstChild('HumanoidRootPart') :: BasePart?
			basis = root and root.CFrame
		end
		if not basis then return Vector3.new(0, 0, 1) end
		local forward = Vector3.new(basis.LookVector.X, 0, basis.LookVector.Z)
		return forward.Magnitude > 0 and -forward.Unit or Vector3.new(0, 0, 1)
	end

	if mode == 'CharacterDirectionalKey' or mode == 'CameraDirectionalKey' then
		local input = waitForDirectionalKey(DASH_DIRECTIONAL_TIMEOUT)
		if not input then return nil end
		return inputDirToWorld(input, mode == 'CameraDirectionalKey')
	end

	return nil
end

----------------------------------------------------------------------
-- Attack dispatch.
----------------------------------------------------------------------
local function sendAttack(inputKind: string, comboKey: string, target: Model?)
	CombatEvent:FireServer(
		inputKind == CombatActions.InputKinds.Heavy
			and CombatActions.Actions.RequestHeavyAttack
			or CombatActions.Actions.RequestLightAttack,
		{
			CommandId = SystemsContainer.CombatPredictionClient.AllocateCommandId(),
			InputKind = inputKind,
			ComboKey = comboKey,
			TargetInstance = target,
			ClientTime = workspace:GetServerTimeNow(),
		})
end

-- Snap to face a locked target on swing input, so a forward-facing
-- animation visually connects. Purely cosmetic: the server recomputes
-- the hitbox from its own view of the character.
local function orientTowardTarget(character: Model, target: Model)
	local root = character:FindFirstChild('HumanoidRootPart') :: BasePart?
	local targetRoot = target:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not root or not targetRoot then return end
	local from = root.Position
	local to = Vector3.new(targetRoot.Position.X, from.Y, targetRoot.Position.Z)
	if (to - from).Magnitude < 0.1 then return end
	character:PivotTo(CFrame.lookAt(from, to))
end

local function getStrengthSpeedBonus(): number
	local data = ReplicatedData.GetData('PlayerData', false)
	local level = 0
	if data and typeof(data.Attributes) == 'table' then
		local entry = data.Attributes.Strength
		if typeof(entry) == 'number' then
			level = entry
		elseif typeof(entry) == 'table' and tonumber(entry.Level) then
			level = entry.Level
		end
	end
	-- +1% playback speed per level. Visual only — the gameplay window is
	-- fixed by the move recipe, so a high-Strength player's swing looks
	-- crisper without actually having different active frames.
	return 1 + level * 0.01
end

local function wieldTypeName(character: Model): string
	local wieldType = CombatShared.GetWeaponWieldType(character)
	if wieldType == CombatShared.WEAPON_WIELD_TYPES.DUAL then return 'DualHand' end
	if wieldType == CombatShared.WEAPON_WIELD_TYPES.LEFT then return 'LeftHand' end
	return 'RightHand'
end

function Module.AttemptAttack(inputKind: string)
	local character = LocalPlayer.Character
	if not character then return end

	local Prediction = SystemsContainer.CombatPredictionClient
	local Animation = SystemsContainer.CombatAnimationClient

	-- Situational gate only. Whether an in-flight move can be chained
	-- into is a separate question, answered next.
	local canAttack, _reason = CombatShared.CanCharacterAttack(character)
	if not canAttack then return end

	local allowed, remaining = Prediction.CanChainNow(inputKind)
	if not allowed then
		local buffer = CombatConfigModule.CombatConfig.COMBO_BUFFER or 0.18
		if remaining > buffer * 2 then
			-- Far too early to be a chain attempt; treat as a stray press.
			return
		end
		-- Hold it and replay at the cancel point. Overwrites any previous
		-- queued input rather than stacking.
		local queued = { InputKind = inputKind }
		BufferedAttack = queued
		task.delay(remaining, function()
			if BufferedAttack ~= queued then return end
			BufferedAttack = nil
			Module.AttemptAttack(queued.InputKind)
		end)
		return
	end

	local target = getLockedTarget()
	if target then
		orientTowardTarget(character, target)
	end

	local comboKey, move, activeClass = Prediction.PredictAttack(character, inputKind)
	sendAttack(inputKind, comboKey, target)

	SwingStep += 1
	if Animation then
		Animation.PlayMoveAnimation(activeClass, move, wieldTypeName(character), SwingStep, getStrengthSpeedBonus())
	end
end

function Module.AttemptDodge()
	local character = LocalPlayer.Character
	if not character then return end

	local canDodge, _reason = CombatShared.CanCharacterDodge(character)
	if not canDodge then return end

	local direction = resolveDodgeDirection(character)
	if direction then
		direction = Vector3.new(direction.X, 0, direction.Z)
		direction = direction.Magnitude > 0 and direction.Unit or nil
	end

	-- A dodge is a hard combat-state break: drop any queued input so a
	-- buffered swing cannot fire out of the evade.
	BufferedAttack = nil
	SystemsContainer.CombatPredictionClient.ResetCombo()

	CombatEvent:FireServer(CombatActions.Actions.RequestDodge, {
		CommandId = SystemsContainer.CombatPredictionClient.AllocateCommandId(),
		Direction = direction,
		ClientTime = workspace:GetServerTimeNow(),
	})
end

function Module.AttemptGuardHold(keyCode: Enum.KeyCode)
	local character = LocalPlayer.Character
	if not character then return end
	local canGuard, _reason = CombatShared.CanCharacterStartBlock(character)
	if not canGuard then return end

	BufferedAttack = nil
	SystemsContainer.CombatPredictionClient.ResetCombo()
	CombatEvent:FireServer(CombatActions.Actions.RequestGuardStart, {})

	-- Hold-to-guard: wait for the guard to actually come up, then for
	-- either the key release or the guard breaking.
	task.spawn(function()
		while HeldKeys[keyCode] and not CombatShared.IsCharacterBlocking(character) do
			task.wait(0.05)
		end
		while HeldKeys[keyCode] and CombatShared.IsCharacterBlocking(character) do
			task.wait(0.05)
		end
		CombatEvent:FireServer(CombatActions.Actions.RequestGuardEnd, {})
	end)
end

function Module.AttemptWeaponToggle()
	local character = LocalPlayer.Character
	if not character then return end
	local light = CombatShared.DoesCharacterHaveLeftWeapon(character)
	local heavy = CombatShared.DoesCharacterHaveRightWeapon(character)
	if not light and not heavy then return end
	CombatEvent:FireServer(CombatActions.Actions.RequestWeaponToggle, {})
end

----------------------------------------------------------------------
-- Binding.
--
-- Keyboard actions go through UserInputService rather than
-- ContextActionService because players may rebind to any key, and CAS
-- needs its key list fixed at bind time. Resolving the action from the
-- LIVE keybind map at press time means a rebind takes effect instantly
-- with no re-binding pass.
----------------------------------------------------------------------
local function dispatchKey(keyCode: Enum.KeyCode): boolean
	local handlers: { [string]: (Enum.KeyCode) -> () } = {
		Block = function(key) Module.AttemptGuardHold(key) end,
		SheatheToggle = function() Module.AttemptWeaponToggle() end,
		Dash = function() Module.AttemptDodge() end,
		HeavyAttack = function() Module.AttemptAttack(CombatActions.InputKinds.Heavy) end,
		Mount = function()
			local MountsClient = SystemsContainer.MountsClient
			if MountsClient and MountsClient.IsMounted and MountsClient.IsMounted()
				and MountsClient.AttemptDismount then
				MountsClient.AttemptDismount()
			end
		end,
	}
	for actionId, handler in handlers do
		if getActionKeyCode(actionId) == keyCode then
			handler(keyCode)
			return true
		end
	end
	return false
end

function Module.BindInputs()
	ContextActionService:BindAction('CombatPrimaryAttack', function(actionName, inputState)
		if actionName ~= 'CombatPrimaryAttack' then
			return Enum.ContextActionResult.Pass
		end
		if inputState == Enum.UserInputState.Begin then
			-- Deferred so a long-running handler cannot stall the input
			-- pipeline for the rest of the frame.
			task.defer(Module.AttemptAttack, CombatActions.InputKinds.Light)
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.UserInputType.MouseButton1)
	ContextActionService:SetTitle('CombatPrimaryAttack', 'Attack')
	ContextActionService:SetImage('CombatPrimaryAttack', 'rbxassetid://7485051715')

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		HeldKeys[input.KeyCode] = true
		dispatchKey(input.KeyCode)
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		-- Cleared regardless of `processed`: releasing a key while a
		-- text box has focus still has to end a held guard, or the
		-- character stays locked in a block forever.
		HeldKeys[input.KeyCode] = nil
	end)
end

function Module.ReleaseInputs()
	ContextActionService:UnbindAction('CombatPrimaryAttack')
	table.clear(HeldKeys)
	BufferedAttack = nil
end

function Module.OnCharacterAdded()
	table.clear(HeldKeys)
	BufferedAttack = nil
	SwingStep = 0
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

function Module.Start() end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Gameplay/CombatMotionClient.luau"><![CDATA[-- // CombatMotionClient.luau //
-- Local movement responses to server-owned combat state.
--
-- See NIER_COMBAT.md for the design.
--
-- Two jobs:
--
--   1. Control lock during hard crowd control. While the server has us
--      stunned, knocked down, lifted or dragged, local input must stop
--      fighting the server's physics. Without this the client keeps
--      feeding walk input into a character the server is trying to
--      launch, and the result is a character that stutters mid-air.
--      Camera control is deliberately left alone — taking the camera
--      away during a knockdown is disorienting and buys nothing.
--
--   2. The guard and attack movement penalties, and the state
--      animations that follow from server-owned combat attributes.
--
--   3. Turning the character toward the target when a swing starts.
--      This lives on the client because it MUST: the local character's
--      HumanoidRootPart is client-owned, and a CFrame write from the
--      server replicates a transform captured half a round trip ago
--      back to a client that has already moved past it — which the
--      player sees as being snapped backwards on every attack. Only
--      the owner may write the transform, so the owner does the turn.
--
-- Everything here is driven from replicated ATTRIBUTES or from the
-- server's own ActionStarted broadcast, so the local character and
-- remote characters cannot disagree about who is stunned, and none of
-- it depends on an animation having loaded.

local Players = game:GetService('Players')
local RunService = game:GetService('RunService')

local LocalPlayer = Players.LocalPlayer

local PlayerModule = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('PlayerModule'))
local Controls = PlayerModule:GetControls()

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CombatConfigModule = ReplicatedModules.Data.CombatConfig
local CombatStatesData = ReplicatedModules.Data.CombatStates
local CombatShared = ReplicatedModules.Services.CombatShared
local CharacterStates = ReplicatedModules.Services.CharacterStates
local MaidClassModule = ReplicatedModules.Modules.Maid

local SystemsContainer = {}

local Module = {}

local CharacterMaid = MaidClassModule.New()
local ControlsDisabled = false

-- The character's WalkSpeed from BEFORE combat touched it. Captured
-- once, when the first modifier engages, and restored when the last one
-- clears. There is deliberately ONE cache for all combat modifiers:
-- with a cache per modifier, blocking during a swing would capture the
-- already-slowed attack speed as its "original" and restore the
-- character to 5 permanently.
local BaseWalkSpeed: number? = nil
-- os.clock() deadline for the attack movement penalty. Time-based
-- rather than attribute-based because the penalty spans the WHOLE swing
-- (windup through recovery), while the `Attacking` attribute is only
-- set for the active window.
local AttackSlowUntil = 0
local SpinConnection: RBXScriptConnection? = nil
local SpinRestoreAutoRotate: boolean? = nil

----------------------------------------------------------------------
-- Control lock.
----------------------------------------------------------------------
local function isHardCrowdControlled(character: Model): boolean
	for _, attribute in CombatStatesData.HardCrowdControlAttributes do
		if CharacterStates.GetStateTemporary(character, attribute) == true then
			return true
		end
	end
	return false
end

function Module.UpdateControls(character: Model)
	if not character then return end
	local shouldDisable = isHardCrowdControlled(character)
	-- Only touch the control module on an actual edge. Calling
	-- Enable()/Disable() every attribute change fights other systems
	-- (mounts, cinematics) that also own the controls.
	if shouldDisable == ControlsDisabled then return end
	ControlsDisabled = shouldDisable
	if shouldDisable then
		Controls:Disable()
	else
		Controls:Enable()
	end
end

----------------------------------------------------------------------
-- Combat movement penalties.
--
-- Guard and attack both slow the character rather than freezing it.
-- They resolve through ONE function against ONE cached base speed, and
-- the slowest active modifier wins, so overlapping states cannot leak a
-- modified speed into each other's "original" value.
----------------------------------------------------------------------
local function combatWalkSpeed(character: Model): number?
	local cfg = CombatConfigModule.CombatConfig
	local speed: number? = nil

	local function consider(value: number?)
		if not value then return end
		if speed == nil or value < speed then
			speed = value
		end
	end

	if CombatShared.IsCharacterBlocking(character) then
		consider(cfg.BLOCK_WALK_SPEED or 8)
	end
	if os.clock() < AttackSlowUntil then
		consider(cfg.ATTACK_WALK_SPEED or 5)
	end
	return speed
end

local function updateCombatMovement(character: Model)
	local humanoid = character:FindFirstChildOfClass('Humanoid')
	if not humanoid then return end

	local desired = combatWalkSpeed(character)
	if desired then
		-- Cache the LIVE speed, not a fixed default: a mount or buff may
		-- have set something other than 16, and restoring a hardcoded
		-- value would quietly strip it. Only the FIRST modifier to engage
		-- captures it.
		if BaseWalkSpeed == nil then
			BaseWalkSpeed = humanoid.WalkSpeed
		end
		humanoid.WalkSpeed = desired
	elseif BaseWalkSpeed ~= nil then
		humanoid.WalkSpeed = BaseWalkSpeed
		BaseWalkSpeed = nil
	end

	if CombatShared.IsCharacterBlocking(character) then
		CombatShared.SetupBlockingEffect(character)
	else
		CombatShared.ClearBlockingEffect(character)
	end
end

----------------------------------------------------------------------
-- Attack turn.
--
-- Spins the character toward the swing's target over the wind-up. This
-- is the ONLY thing an attack does to the local character's transform —
-- there is no step-in and no position lock; the player keeps walking,
-- just slowly.
--
-- Skipped entirely while a lock-on is active, because TargetLockClient
-- already writes HumanoidRootPart.CFrame every frame to face the locked
-- target and already owns Humanoid.AutoRotate. Two writers for one
-- transform is the wobble this whole module exists to avoid.
----------------------------------------------------------------------
local function stopSpin(character: Model?)
	if SpinConnection then
		SpinConnection:Disconnect()
		SpinConnection = nil
	end
	if SpinRestoreAutoRotate ~= nil then
		local humanoid = character and character:FindFirstChildOfClass('Humanoid')
		if humanoid then
			humanoid.AutoRotate = SpinRestoreAutoRotate
		end
		SpinRestoreAutoRotate = nil
	end
end

local function startSpin(character: Model, target: Model, duration: number)
	stopSpin(character)
	if duration <= 0 then return end

	local TargetLockClient = SystemsContainer.TargetLockClient
	if TargetLockClient and TargetLockClient.GetLockedTarget and TargetLockClient.GetLockedTarget() then
		return
	end

	local humanoid = character:FindFirstChildOfClass('Humanoid')
	local root = character:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not humanoid or not root then return end

	-- AutoRotate would turn the character toward its MoveDirection every
	-- frame, which fights the turn for exactly as long as the player is
	-- holding a key. Suspended for the wind-up and restored after, so
	-- normal movement facing resumes for the rest of the swing.
	SpinRestoreAutoRotate = humanoid.AutoRotate
	humanoid.AutoRotate = false

	local rate = CombatConfigModule.CombatConfig.ATTACK_TURN_RATE or 14
	local deadline = os.clock() + duration

	SpinConnection = RunService.RenderStepped:Connect(function(dt)
		local live = LocalPlayer.Character
		if live ~= character or not root.Parent or not target.Parent then
			stopSpin(character)
			return
		end
		-- Stand down the moment the server owns our physics; fighting a
		-- launch or a knockdown for a cosmetic turn is never worth it.
		if CombatShared.IsCharacterHardCrowdControlled(character) then
			stopSpin(character)
			return
		end

		local targetRoot = target:FindFirstChild('HumanoidRootPart') :: BasePart?
		if not targetRoot then
			stopSpin(character)
			return
		end

		-- Yaw only: the look point is forced to our own height so a
		-- target above or below never tips the character.
		local lookAt = Vector3.new(targetRoot.Position.X, root.Position.Y, targetRoot.Position.Z)
		if (lookAt - root.Position).Magnitude > 0.01 then
			local desired = CFrame.lookAt(root.Position, lookAt)
			-- Framerate-independent easing, and Lerp against a CFrame
			-- built at our own CURRENT position, so this rotates without
			-- ever translating the character.
			local alpha = 1 - math.exp(-rate * dt)
			root.CFrame = root.CFrame:Lerp(desired, alpha)
		end

		if os.clock() >= deadline then
			stopSpin(character)
		end
	end)
end

-- Called from CombatClient when the server confirms a swing started.
-- Ignored for every character but our own: remote players turn through
-- their own client's copy of this, replicated normally.
function Module.OnActionStarted(payload: any)
	if typeof(payload) ~= 'table' then return end
	local character = LocalPlayer.Character
	if not character or payload.Caster ~= character then return end

	local total = (payload.Windup or 0) + (payload.Active or 0) + (payload.Recovery or 0)
	if total > 0 then
		AttackSlowUntil = math.max(AttackSlowUntil, os.clock() + total)
		updateCombatMovement(character)
		-- Restore on expiry. Re-resolves rather than assuming, so a block
		-- that began during the swing keeps its own penalty.
		task.delay(total, function()
			local live = LocalPlayer.Character
			if live then
				updateCombatMovement(live)
			end
		end)
	end

	if typeof(payload.Target) == 'Instance' and payload.Target:IsA('Model') then
		startSpin(character, payload.Target, payload.Windup or 0.1)
	end
end

----------------------------------------------------------------------
-- Lock-on facing is NOT handled here.
--
-- TargetLockClient already owns it: it caches and clears
-- Humanoid.AutoRotate around the lock and rotates the character toward
-- the target inside its own camera step. Adding a second per-frame
-- writer for the same HumanoidRootPart CFrame would have the two
-- fighting each other on alternate frames.
--
-- The one thing that behaviour was missing — standing down while the
-- server owns the character's physics — was added to TargetLockClient's
-- step directly, via CombatShared.IsCharacterHardCrowdControlled.
----------------------------------------------------------------------

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.OnCharacterAdded(character: Model)
	CharacterMaid:Cleanup()
	stopSpin(nil)
	ControlsDisabled = false
	-- A fresh body starts from its own WalkSpeed. Carrying the previous
	-- character's cached base over would restore a dead rig's speed onto
	-- the new one.
	BaseWalkSpeed = nil
	AttackSlowUntil = 0
	Controls:Enable()

	local humanoid = character:WaitForChild('Humanoid', 5)
	if not humanoid then return end

	-- Wipe combat attributes inherited from a dying body through
	-- streaming or replication races.
	for _, attribute in {
		CombatStatesData.Attributes.Blocking,
		CombatStatesData.Attributes.BlockingCount,
		CombatStatesData.Attributes.Stunned,
		CombatStatesData.Attributes.KnockedDown,
		CombatStatesData.Attributes.Lifted,
		CombatStatesData.Attributes.Dragged,
		CombatStatesData.Attributes.Airborne,
		CombatStatesData.Attributes.Attacking,
	} do
		character:SetAttribute(attribute, nil)
	end

	local Animation = SystemsContainer.CombatAnimationClient

	local function bindStateAttribute(attribute: string, animationName: string?)
		CharacterMaid:Give(character:GetAttributeChangedSignal(attribute):Connect(function()
			Module.UpdateControls(character)
			if not animationName or not Animation then return end
			if character:GetAttribute(attribute) == true then
				Animation.PlayState(animationName)
			else
				Animation.StopState(animationName)
			end
		end))
	end

	bindStateAttribute(CombatStatesData.Attributes.Stunned, 'Stunned')
	bindStateAttribute(CombatStatesData.Attributes.KnockedDown, 'KnockedDown')
	bindStateAttribute(CombatStatesData.Attributes.Lifted, nil)
	bindStateAttribute(CombatStatesData.Attributes.Dragged, nil)

	CharacterMaid:Give(character:GetAttributeChangedSignal(CombatStatesData.Attributes.Blocking):Connect(function()
		updateCombatMovement(character)
		if not Animation then return end
		if CombatShared.IsCharacterBlocking(character) then
			Animation.PlayState('Blocking')
		else
			Animation.StopState('Blocking')
		end
	end))

	CharacterMaid:Give(humanoid.Died:Connect(function()
		stopSpin(character)
		ControlsDisabled = false
		BaseWalkSpeed = nil
		AttackSlowUntil = 0
		Controls:Enable()
		humanoid.AutoRotate = true
		CombatShared.ClearBlockingEffect(character)
	end))
end

function Module.Start()
	-- Safety net for the control lock AND the movement penalty. Both are
	-- driven by events — attribute signals and ActionStarted — and both
	-- would strand the character if an event were lost: controls stuck
	-- disabled, or WalkSpeed stuck at 5 because the swing that slowed it
	-- ended while the character was streamed out. A low-frequency
	-- reconcile makes either unrecoverable case merely brief.
	task.spawn(function()
		while true do
			task.wait(0.5)
			local character = LocalPlayer.Character
			if character then
				Module.UpdateControls(character)
				updateCombatMovement(character)
			end
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Gameplay/CombatPredictionClient.luau"><![CDATA[-- // CombatPredictionClient.luau //
-- Local combo prediction and server reconciliation.
--
-- See NIER_COMBAT.md for the design.
--
-- The client predicts exactly two things: which move its next input
-- will produce, and when that move becomes cancelable. Both are derived
-- from the SAME shared modules the server uses, so agreement is the
-- default and divergence is the exception rather than something we have
-- to actively keep in sync.
--
-- Everything else — whether the swing is allowed, what it hits, how
-- much it does, where anyone ends up — is the server's, and arrives
-- back as ActionStarted / ActionRejected.
--
-- Reconciliation policy: the server's combo string always wins, and it
-- wins silently. A rejected command rolls the local chain back to the
-- last server-confirmed state rather than clearing it, so one dropped
-- input costs the player one swing rather than their whole combo.

local Players = game:GetService('Players')
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CombatConfigModule = ReplicatedModules.Data.CombatConfig
local CombatShared = ReplicatedModules.Services.CombatShared
local CombosShared = ReplicatedModules.Services.CombosShared

local SystemsContainer = {}

local Module = {}

-- Monotonic per-session. The server keeps a high-water mark and rejects
-- anything at or below it, so these must never repeat or go backwards.
local NextCommandId = 0

local PredictedCombo: { string } = {}
local ConfirmedCombo: { string } = {}
local LastSentCommandId = 0
local LastConfirmedCommandId = 0

-- The move we believe is currently running, and when we started it.
-- Used purely to decide whether the next input can cancel into a chain
-- or has to be buffered.
local CurrentMove: any? = nil
local CurrentMoveStartedAt = 0
local LastInputAt = 0

local function copyCombo(combo: { string }): { string }
	local copy = {}
	for index, letter in combo do copy[index] = letter end
	return copy
end

function Module.AllocateCommandId(): number
	NextCommandId += 1
	LastSentCommandId = NextCommandId
	return NextCommandId
end

----------------------------------------------------------------------
-- Context + class resolution, mirroring the server's own resolution.
----------------------------------------------------------------------
function Module.ResolveActiveClass(character: Model): string
	local lightClass, heavyClass = CombatShared.GetActiveWeaponClasses(character)
	return CombosShared.ResolveActiveClass(lightClass, heavyClass)
end

function Module.ResolveContext(character: Model): string
	return CombosShared.ResolveContext(
		CombatShared.IsCharacterAirborne(character),
		CombatShared.IsPerfectCounterActive(character))
end

----------------------------------------------------------------------
-- Cancel windows.
--
-- Returns (allowed, secondsUntilAllowed). A caller that gets
-- allowed=false with a small remainder should buffer the input; the
-- server applies the same rule to the same move, so a buffered input
-- replayed at the cancel point is accepted rather than rejected.
----------------------------------------------------------------------
function Module.CanChainNow(inputKind: string): (boolean, number)
	if not CurrentMove then return true, 0 end

	local elapsed = os.clock() - CurrentMoveStartedAt
	-- A move whose whole timeline has elapsed is finished regardless of
	-- whether we ever heard back about it, so a dropped ActionStarted
	-- cannot wedge the local chain permanently.
	if elapsed >= (CurrentMove.Total or 0) then
		CurrentMove = nil
		return true, 0
	end

	local buffer = CombatConfigModule.CombatConfig.COMBO_BUFFER or 0.18
	return CombosShared.CanCancelInto(CurrentMove, elapsed, inputKind, buffer)
end

----------------------------------------------------------------------
-- Prediction.
--
-- Advances the local chain and returns the move we expect. The caller
-- sends the resolved key to the server as a CLAIM; the server compares
-- it against its own chain and downgrades the swing on mismatch rather
-- than rejecting, so a desynced client degrades gracefully.
----------------------------------------------------------------------
function Module.PredictAttack(character: Model, inputKind: string): (string, any, string)
	local cfg = CombatConfigModule.CombatConfig
	local activeClass = Module.ResolveActiveClass(character)
	local context = Module.ResolveContext(character)

	local currentTime = os.clock()
	if (currentTime - LastInputAt) > (cfg.COMBO_RESET_WINDOW or 1.5) then
		PredictedCombo = {}
	end
	LastInputAt = currentTime

	PredictedCombo = CombosShared.AppendInput(
		PredictedCombo, inputKind, cfg.COMBO_MAX_LENGTH or 4, activeClass, context)

	local key, move = CombosShared.ResolveComboKey(PredictedCombo, activeClass, context)

	CurrentMove = move
	CurrentMoveStartedAt = currentTime

	if move.IsFinisher then
		-- Mirror the server: the finisher fires on this key, and the
		-- NEXT press starts a fresh chain.
		PredictedCombo = {}
	end
	return key, move, activeClass
end

function Module.GetCurrentMove(): any?
	return CurrentMove
end

function Module.ResetCombo()
	PredictedCombo = {}
	ConfirmedCombo = {}
	CurrentMove = nil
	LastInputAt = 0
end

----------------------------------------------------------------------
-- Reconciliation.
----------------------------------------------------------------------

-- The server started an action for us. Adopt its combo string verbatim.
function Module.OnActionStarted(payload: any)
	if typeof(payload) ~= 'table' then return end
	if payload.Caster ~= LocalPlayer.Character then return end
	local commandId = payload.CommandId
	if typeof(commandId) ~= 'number' or commandId <= LastConfirmedCommandId then return end

	LastConfirmedCommandId = commandId

	if payload.IsFinisher then
		PredictedCombo = {}
	elseif typeof(payload.ComboKey) == 'string' then
		local adopted = {}
		for index = 1, #payload.ComboKey do
			adopted[index] = string.sub(payload.ComboKey, index, index)
		end
		PredictedCombo = adopted
	end
	ConfirmedCombo = copyCombo(PredictedCombo)
	LastInputAt = os.clock()

	-- Deliberately NOT re-anchoring the local move timeline here.
	--
	-- The payload carries Windup/Active/Recovery, and it is tempting to
	-- rebuild CurrentMove from them — but the payload has no CancelFrom
	-- fractions, so the rebuilt move would have no cancel points and the
	-- local chain would stall until its total duration elapsed.
	--
	-- It is also unnecessary. Both sides resolve the same recipe from
	-- CombatMovesets, so the durations already agree; the only
	-- difference is the start instant, and the client's is EARLIER than
	-- the server's by the trip time. That skew is in the safe direction:
	-- the client reaches its cancel point first and sends, and if the
	-- server is not there yet it buffers the input and replays it. The
	-- reverse skew would produce rejections.
end

-- The server refused a command. Roll back to the last confirmed chain
-- and drop the predicted animation.
function Module.OnActionRejected(payload: any)
	if typeof(payload) ~= 'table' then return end
	if payload.CommandId ~= LastSentCommandId then return end

	PredictedCombo = copyCombo(ConfirmedCombo)
	CurrentMove = nil
	LastInputAt = os.clock()

	local AnimationClient = SystemsContainer.CombatAnimationClient
	if AnimationClient then
		AnimationClient.StopAttackAnimations()
	end
end

-- The action was cancelled server-side (dodge, stun, death, or a chain
-- cancel into the next move). A chain cancel is immediately followed by
-- a new ActionStarted, so the combo is deliberately NOT cleared here —
-- only the local move timeline is released.
function Module.OnActionCancelled(payload: any)
	if typeof(payload) ~= 'table' then return end
	if payload.Caster ~= LocalPlayer.Character then return end

	CurrentMove = nil
	if payload.Reason ~= 'ChainCancel' then
		PredictedCombo = {}
		ConfirmedCombo = {}
		local AnimationClient = SystemsContainer.CombatAnimationClient
		if AnimationClient then
			AnimationClient.StopAttackAnimations()
		end
	end
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

function Module.Start() end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Gameplay/CompanionsClient.luau"><![CDATA[-- Companions client. Renders each player's equipped companion as a
-- hovering wisp / fairy / pet. Pure visual layer — server owns
-- ownership + level + bonuses + movement-mode preference.
--
-- ════════════════════════════════════════════════════════════════════
-- TODO — visual + behavioural extensions to land later. Each is its
-- own concern; pick whichever lands first as art / design lock in.
-- ════════════════════════════════════════════════════════════════════
--
--   1. ANIMATIONS
--      * Per-companion mocap loadouts (Idle / Float / Cheer / Hurt /
--        FollowRun) keyed by humanoid + Animator. Currently only the
--        single 'Idle' / 'Float' track ids exist on the cfg as
--        placeholders.
--      * State machine: Idle ⇄ Following ⇄ AlertedBySomethingNearby.
--        Drives which animation plays and how aggressively the
--        companion bobs / flickers.
--
--   2. EXPRESSIONS
--      * Procedural face-state mapping: Happy / Curious / Worried /
--        Battle. The wisp factory can paint a tiny eye-pair onto the
--        body via SurfaceGuis once art lands.
--      * Reactions to player events: enchant cast, level-up, low HP
--        (pulse + worried face).
--
--   3. INTERACTIONS
--      * Click-to-pet: prompt + small "happiness" buff (BondAura).
--      * Per-companion idle barks via SoundService at long intervals.
--      * Pickup nearby loot / harvested mats and float them to player.
--      * Bond-tied dialogue lines via DialogueWidget when the player
--        ALT-talks at the companion.
--
--   4. STATE TRANSITIONS
--      * Smooth despawn / respawn fades (alpha tween) instead of pop.
--      * Walk → Float swap with a blink VFX so the swap reads as
--        "deliberate" instead of "teleport-jank."
--
--   5. NETWORKING / REPLICATION
--      * Move per-frame model CFrame updates client-side only (current).
--        If observers ever need to see the SAME companion path the
--        rider sees, FireAllClients with a sub-second cadence.
--      * Server-authoritative attack pulses (PodShot already exists).
--
-- ════════════════════════════════════════════════════════════════════

local Players = game:GetService('Players')
local RunService = game:GetService('RunService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local CompanionsShared = ReplicatedModules.Services.CompanionsShared
local CompanionsConfig = ReplicatedModules.Data.Companions
local SoundService = ReplicatedModules.Services.SoundService
local RemoteService = ReplicatedModules.Services.RemoteService
local ReplicatedData = ReplicatedModules.Services.ReplicatedData

local CompanionEvent = RemoteService.GetRemote('CompanionEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Per-player active companion render state.
--
-- mode: live read of the player's MovementMode preference for THIS
--   companion. Updated on Spawn + on MovementChanged cues; keeps the
--   step() loop branch-free.
-- index/total: future-proofing for multi-equip — when one player has
--   N equipped companions, each gets a stable slot index in the
--   semi-circle. Today total is always 1 and index is 1.
-- currentPos: smoothed position used for the walk-mode follow lerp.
--   Float mode writes directly without smoothing.
----------------------------------------------------------------------
type RenderState = {
	companionId: string,
	model: Model?,
	cfg: any,
	t0: number,
	mode: string,         -- 'float' | 'walk'
	index: number,        -- 1..total
	total: number,
	-- Per-slot phase offset on the orbit, in radians. Computed once in
	-- reindexFor (and again whenever the slot count changes); read by
	-- targetForFloat as `cos(offset + t * OrbitSpeed)` / `sin(...)` to
	-- place the companion on its slot of the orbit circle. Stored on
	-- state so step() doesn't recompute slotAngle every frame, and so
	-- `spawn` can use it to position the model on its first frame
	-- (rather than gliding in from the player's origin).
	offset: number,
	currentPos: Vector3?,
	-- Set to true by spawn(); step() consumes it on the next frame to
	-- snap the model directly onto its target instead of lerping in
	-- from origin. See "Init for first position" comment in spawn().
	needsInit: boolean?,
}
-- Nested per-player → per-companionId render states. Multi-equip means
-- a single player can have N concurrent wisps; each gets its own
-- RenderState, indexed by companionId so spawn/despawn can target a
-- specific slot. (index, total) inside each state are recomputed
-- whenever the slot count changes so the orbit/walk arc spreads
-- correctly.
local Active: { [Player]: { [string]: RenderState } } = {}

-- Slot-angle helper hoisted up here so reindexFor can use it. The
-- target-composition functions further down also call it; the hoist
-- preserves a single source of truth.
--
-- Two cases:
--   * OPEN arc (arcAngle < 2π, e.g. walk-mode follow arc behind the
--     player) — use both endpoints. Spread index across [-arc/2, +arc/2]
--     with denominator (total - 1) so index 1 lands at -arc/2 and index
--     N at +arc/2.
--   * CLOSED arc (arcAngle ~= 2π, e.g. float-mode orbit around the
--     player) — exclude the endpoint, since +π and -π are the SAME
--     position on a circle. Use denominator `total` (not total-1) so
--     positions are evenly spaced and don't collide.
local TAU = math.pi * 2
local function slotAngle(index: number, total: number, arcAngle: number): number
	if total <= 1 then return 0 end
	if arcAngle >= TAU - 1e-3 then
		return (index - 1) / total * TAU
	end
	local t = (index - 1) / (total - 1)
	return -arcAngle * 0.5 + arcAngle * t
end

-- Walk every state for a player and renumber (index, total) based on
-- a deterministic alphabetical key order. Called after spawn/despawn
-- so the slot-angle math fans correctly.
local function reindexFor(player: Player)
	local byId = Active[player]; if not byId then return end
	local ids: { string } = {}
	for id in byId do ids[#ids + 1] = id end
	table.sort(ids)
	local total = #ids
	for i, id in ids do
		local s = byId[id]
		if s then
			s.index = i
			s.total = total
			-- Recompute orbit phase whenever the slot count changes.
			-- Float mode uses a closed (full-circle) arc so 3 slots
			-- become {0, 2π/3, 4π/3} — perfectly even spacing. The
			-- offset stays valid until total changes again.
			s.offset = slotAngle(i, total, TAU)
			-- Position-jump on slot reshuffle is jarring in walk mode —
			-- clear the smoothed position so the next step lerps fresh
			-- to the new arc anchor.
			s.currentPos = nil
		end
	end
end

local function getFirstStateFor(player: Player): RenderState?
	local byId = Active[player]; if not byId then return nil end
	for _, s in byId do return s end
	return nil
end

----------------------------------------------------------------------
-- Helpers — template lookup + procedural fallback. Wisps default to
-- procedural; templated companions render their authored model.
----------------------------------------------------------------------
local function templateFor(modelName: string): (Model | BasePart)?
	local assets = ReplicatedStorage:FindFirstChild('AssetsShared')
	local folder = assets and assets:FindFirstChild('Companions')
	local template = folder and folder:FindFirstChild(modelName)
	return template
end

-- Procedural wisp build. Color comes from the companion cfg's
-- ProceduralColor field (the four wisps each set a distinct hue).
-- Two-part rig: outer glow (Neon, low size) + inner core. Looks
-- decent without a single bundled asset.
local function buildProceduralWisp(cfg: any): Model
	local color = (cfg and cfg.ProceduralColor) or Color3.fromRGB(255, 220, 120)
	local model = Instance.new('Model')
	model.Name = 'Companion_' .. (cfg and cfg.Display.Name or 'Wisp')

	local core = Instance.new('Part')
	core.Name = 'Core'
	core.Shape = Enum.PartType.Ball
	core.Size = Vector3.new(0.45, 0.45, 0.45)
	core.Material = Enum.Material.Neon
	core.Color = color
	core.CanCollide = false; core.Anchored = true; core.CastShadow = false
	core.Parent = model
	model.PrimaryPart = core

	local glow = Instance.new('Part')
	glow.Name = 'Glow'
	glow.Shape = Enum.PartType.Ball
	glow.Size = Vector3.new(0.9, 0.9, 0.9)
	glow.Material = Enum.Material.ForceField
	glow.Color = color
	glow.Transparency = 0.55
	glow.CanCollide = false; glow.Anchored = true; glow.CastShadow = false
	glow.CFrame = core.CFrame
	-- Weld so the glow follows the core when we PivotTo the model.
	local weld = Instance.new('Weld')
	weld.Part0 = core; weld.Part1 = glow; weld.C0 = CFrame.new()
	weld.Parent = glow
	glow.Parent = model

	-- Point light inside the core so the wisp casts color on the
	-- world. Range is small to keep it subtle.
	local light = Instance.new('PointLight')
	light.Color = color
	light.Brightness = 1.6
	light.Range = 6
	light.Parent = core

	return model
end

local function fallbackFairy(cfg: any?): Model
	-- Wisps always go procedural; non-wisps get the legacy single-sphere
	-- look (matches the previous fallback shape). The procedural builder
	-- handles both — the difference is just that wisps explicitly carry
	-- ProceduralColor on cfg while older fairy entries don't.
	return buildProceduralWisp(cfg or {})
end

local function playSFX(entry: any?, position: Vector3?)
	if not entry or not entry.Sound then return end
	local pos = position or workspace.CurrentCamera.CFrame.Position
	SoundService.PlaySoundAtPosition(entry.Sound, pos)
end

----------------------------------------------------------------------
-- Spawn / despawn.
----------------------------------------------------------------------
local function despawn(player: Player, companionId: string?)
	local byId = Active[player]
	if not byId then return end
	-- nil id → unequip-all back-compat: tear down every slot. With an
	-- id supplied, only that slot's render state is destroyed and the
	-- remaining slots get re-indexed.
	if companionId == nil then
		for _, state in byId do
			if state.model then state.model:Destroy() end
		end
		Active[player] = nil
		return
	end
	local state = byId[companionId]
	if not state then return end
	if state.model then state.model:Destroy() end
	byId[companionId] = nil
	-- Empty map → drop the player entry so memory tracks the live set.
	if next(byId) == nil then
		Active[player] = nil
	else
		reindexFor(player)
	end
end

-- Resolve the current movement mode for (player, companionId). Reads
-- through the player's replicated PlayerData so the rider's local UI
-- and other clients all see the same mode.
local function resolveMode(player: Player, companionId: string): string
	-- Local player → fast path via ReplicatedData cache.
	if player == LocalPlayer then
		local data = ReplicatedData.GetData('PlayerData', false)
		if data then
			return CompanionsShared.GetMovementMode(data, companionId)
		end
	end
	-- Remote player → use cfg default. The MovementChanged cue
	-- updates the live state so the visual stays in sync without
	-- having to read another player's save.
	local cfg = CompanionsConfig.Companions[companionId]
	return (cfg and cfg.MovementMode) or 'float'
end

local function spawn(player: Player, companionId: string)
	-- Multi-equip aware: replace only the slot for THIS companionId. The
	-- other equipped companions stay live; reindexFor at the bottom
	-- spreads the arc/orbit math across the new slot count.
	despawn(player, companionId)
	local cfg = CompanionsConfig.Companions[companionId]
	if not cfg then return end
	local character = player.Character
	if not character then return end

	local template = templateFor(cfg.Model)
	local model: Model
	if template then
		if template:IsA('Model') then
			local clone = (template :: Model):Clone()
			for _, d in clone:GetDescendants() do
				if d:IsA('BasePart') then
					d.Anchored = true; d.CanCollide = false; d.CastShadow = false
				end
			end
			if not clone.PrimaryPart then
				for _, d in clone:GetDescendants() do
					if d:IsA('BasePart') then clone.PrimaryPart = d; break end
				end
			end
			model = clone
		else
			-- Single-part template — wrap in a Model for stable PivotTo.
			local part = (template :: BasePart):Clone()
			part.Anchored = true; part.CanCollide = false; part.CastShadow = false
			model = Instance.new('Model')
			part.Parent = model
			model.PrimaryPart = part
		end
	else
		model = fallbackFairy(cfg)
	end
	model.Parent = workspace.Terrain

	if not Active[player] then Active[player] = {} end
	Active[player][companionId] = {
		companionId = companionId,
		model = model,
		cfg = cfg,
		t0 = os.clock(),
		mode = resolveMode(player, companionId),
		-- Slot indices are placeholders; reindexFor sets the real
		-- (index, total) below across every active companion. `offset`
		-- defaults to 0 so the first frame (before reindex completes)
		-- still has a well-defined position.
		index = 1, total = 1, offset = 0,
		currentPos = nil,
	}
	reindexFor(player)

	-- "Init for first position" handled by step() on its first tick:
	-- when state.needsInit is true, step writes the target directly
	-- (no walk-mode lerp) so the companion lands ON its orbit slot
	-- rather than gliding in from world origin. Done as a flag
	-- because targetForFloat / targetForWalk are defined later in the
	-- file — calling them here would be a forward reference into a
	-- nil upvalue. Heartbeat fires within one frame of spawn so the
	-- delay is invisible.
	local state = Active[player][companionId]
	if state then state.needsInit = true end

	playSFX(cfg.SFX and cfg.SFX.Spawn, character:GetPivot().Position)
end

----------------------------------------------------------------------
-- Per-frame composition. Two paths share the same target-CFrame compose
-- but pick the target differently:
--
--   FLOAT — orbit + bob in a horizontal circle around the player's
--           head height. Multi-companion fans out via a per-index
--           orbit-phase offset so they don't pile on top of each other.
--
--   WALK  — semi-circle slot behind the player on the ground. Smoothed
--           via per-frame lerp (FollowRate) so the wisp drifts with
--           the rider rather than teleporting.
--
-- (slotAngle + TAU hoisted above reindexFor — see top-of-file
-- definition. Keeping the long header here for context on how the
-- math drives multi-companion arc spreading.)
----------------------------------------------------------------------

local function targetForFloat(player: Player, state: RenderState): Vector3?
	local character = player.Character
	local hrp = character and character:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not hrp then return nil end
	local cfg = state.cfg
	local hover = cfg.Hover
	-- Absolute time (NOT elapsed-since-spawn) so all companions in
	-- the orbit share a synchronized angular position — drift-free
	-- "perfect circle" spread instead of phase-misaligned slots that
	-- happen if each companion's clock starts at its own spawn moment.
	-- `state.offset` was computed in reindexFor (initially in spawn) so
	-- this read is O(1); no slotAngle call per frame.
	local t = os.clock()
	local orbit = state.offset + t * hover.OrbitSpeed
	local bob = math.sin(t * (hover.BobFrequency * 2 * math.pi)) * hover.BobAmplitude
	return hrp.Position + Vector3.new(
		math.cos(orbit) * hover.OrbitRadius,
		hover.Height + bob,
		math.sin(orbit) * hover.OrbitRadius
	)
end

local function targetForWalk(player: Player, state: RenderState): Vector3?
	local character = player.Character
	local hrp = character and character:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not hrp then return nil end
	local walkCfg = state.cfg.Walk
	-- Anchor in player-relative space:
	--   - back along -LookVector by BackDistance
	--   - +/- side along Right by ArcRadius * sin(angle)
	-- Then raycast down to find the ground and apply GroundOffset.
	local lookFlat = Vector3.new(hrp.CFrame.LookVector.X, 0, hrp.CFrame.LookVector.Z)
	if lookFlat.Magnitude < 0.01 then lookFlat = Vector3.zAxis end
	lookFlat = lookFlat.Unit
	local rightFlat = Vector3.new(-lookFlat.Z, 0, lookFlat.X)
	local angle = slotAngle(state.index, state.total, walkCfg.ArcAngle)
	-- Project the slot offset: depth = -cos(angle) * BackDistance (further
	-- back at center, less so at edges); side = sin(angle) * ArcRadius.
	local depth = -math.cos(angle) * walkCfg.BackDistance
	local side  = math.sin(angle) * walkCfg.ArcRadius
	local centerXZ = hrp.Position + lookFlat * depth + rightFlat * side
	-- Ground raycast.
	local rayOrigin = centerXZ + Vector3.new(0, 6, 0)
	local rayDir = Vector3.new(0, -50, 0)
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { character, state.model }
	local hit = workspace:Raycast(rayOrigin, rayDir, rayParams)
	local groundY = hit and hit.Position.Y or hrp.Position.Y - 3
	return Vector3.new(centerXZ.X, groundY + walkCfg.GroundOffset, centerXZ.Z)
end

local function step(dt: number)
	for player, byId in Active do
		for _, state in byId do
			if not state.model or not state.model.PrimaryPart then continue end
			local target: Vector3? = nil
			local lookAt: Vector3? = nil
			if state.mode == 'walk' then
				target = targetForWalk(player, state)
				-- Walking wisp faces the player to read as "tracking"
				-- (Pikmin-style). Float wisp does the same.
				local hrp = player.Character and player.Character:FindFirstChild('HumanoidRootPart') :: BasePart?
				lookAt = hrp and hrp.Position or nil
			else
				target = targetForFloat(player, state)
				local hrp = player.Character and player.Character:FindFirstChild('HumanoidRootPart') :: BasePart?
				lookAt = hrp and hrp.Position or nil
			end
			if not target then continue end

			-- Smoothed follow for walk; immediate write for float (its own
			-- math is already smooth from the bob/orbit sines).
			local pos: Vector3
			if state.needsInit then
				-- First-frame placement: snap to target regardless of
				-- mode so the companion appears on its orbit slot
				-- rather than gliding in from origin.
				pos = target
				state.currentPos = pos
				state.needsInit = nil
			elseif state.mode == 'walk' then
				local prev = state.currentPos or target
				local rate = state.cfg.Walk.FollowRate
				-- Frame-rate-independent lerp.
				local alpha = 1 - math.exp(-rate * dt)
				pos = prev:Lerp(target, alpha)
				state.currentPos = pos
			else
				pos = target
				state.currentPos = pos
			end

			local cf
			if lookAt then
				cf = CFrame.lookAt(pos, lookAt)
			else
				cf = CFrame.new(pos)
			end
			state.model:PivotTo(cf)
		end
	end
end

----------------------------------------------------------------------
-- Level-up flair: re-uses the cinematic label system as a toast.
----------------------------------------------------------------------
local function onLevelUp(companionId: string, newLevel: number)
	local CinematicLabels = SystemsContainer.CinematicLabels
		or (SystemsContainer.ParentSystems and SystemsContainer.ParentSystems.Effects
		    and SystemsContainer.ParentSystems.Effects.CinematicLabels)
	local cfg = CompanionsConfig.Companions[companionId]
	local name = cfg and cfg.Display.Name or companionId
	if CinematicLabels and CinematicLabels.AppendCinematic then
		CinematicLabels.AppendCinematic(
			'COMPANION · LEVEL UP',
			string.format('%s reached level %d', name, newLevel)
		)
	end
	playSFX(cfg and cfg.SFX and cfg.SFX.LevelUp, workspace.CurrentCamera.CFrame.Position)
end

----------------------------------------------------------------------
-- Public client API.
----------------------------------------------------------------------
function Module.AttemptEquip(companionId: string)
	CompanionEvent:FireServer(CompanionsShared.CompanionActions.TryEquip, companionId)
end

function Module.AttemptUnequip(companionId: string?)
	-- Multi-equip aware. With companionId set, server unequips that
	-- specific slot; nil triggers the back-compat "unequip all" path
	-- inside CompanionsServer.AttemptUnequipCompanion.
	CompanionEvent:FireServer(CompanionsShared.CompanionActions.TryUnequip, companionId)
end

function Module.UseCandy(candyItemId: string)
	CompanionEvent:FireServer(CompanionsShared.CompanionActions.UseCandy, candyItemId)
end

-- Toggle float ↔ walk for a companion (server-authoritative; the
-- request is rejected for companions whose cfg.AllowWalkAndFloatBypass
-- != true). UI dropdown calls this.
function Module.SetMovementMode(companionId: string, mode: string)
	if mode ~= 'float' and mode ~= 'walk' then return end
	CompanionEvent:FireServer(CompanionsShared.CompanionActions.SetMovementMode,
		companionId, mode)
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	RunService.Heartbeat:Connect(step)

	CompanionEvent.OnClientEvent:Connect(function(action, ...)
		if action == CompanionsShared.CompanionActions.Spawn then
			local player, companionId = ...
			spawn(player, companionId)
		elseif action == CompanionsShared.CompanionActions.Despawn then
			-- Multi-equip: server broadcasts the companionId being unequipped.
			-- Legacy callers (and the back-compat unequip-all path) send nil
			-- which collapses to "tear down all of this player's wisps".
			local player, companionId = ...
			despawn(player, companionId)
		elseif action == CompanionsShared.CompanionActions.LevelUp then
			local companionId, newLevel = ...
			onLevelUp(companionId, newLevel)
		elseif action == CompanionsShared.CompanionActions.MovementChanged then
			-- Live mode swap. Updates the matching companion slot's mode
			-- field so the next step() picks the right target. No
			-- despawn/respawn — keeps the visual fluid.
			local player, companionId, mode = ...
			local byId = Active[player]
			local state = byId and byId[companionId]
			if state then
				state.mode = mode
				-- Reset the smoothed position so the wisp doesn't dart
				-- from its float target to its walk target via a
				-- straight-line lerp through the player's head.
				state.currentPos = nil
			end
		elseif action == CompanionsShared.CompanionActions.PodShot then
			-- Pod auto-attack VFX: render a thin neon beam from the
			-- shooting companion's model to the target HRP. With multi-
			-- equip there are N companions per player; the server fires
			-- one cue per companion per tick, so we'd ideally key the
			-- shot to the SPECIFIC companion. The cue carries
			-- (player, target, damage) only — pick any active companion
			-- model as the beam origin. Round-robin by choosing the
			-- first state in the player's nested map; multi-shot bursts
			-- in the same tick will visually flicker across slots which
			-- reads correctly as "all my pods are firing".
			local player, target, _damage = ...
			local state = getFirstStateFor(player)
			if not state or not state.model or not state.model.PrimaryPart then return end
			if not target then return end
			local tHrp = (target :: any):FindFirstChild('HumanoidRootPart') :: BasePart?
			if not tHrp then return end
			local from = state.model.PrimaryPart.Position
			local to = tHrp.Position
			local part = Instance.new('Part')
			part.Anchored = true; part.CanCollide = false; part.CanTouch = false
			part.CanQuery = false; part.Massless = true; part.CastShadow = false
			part.Material = Enum.Material.Neon
			part.Color = state.cfg.ProceduralColor or Color3.fromRGB(255, 220, 120)
			part.Transparency = 0.2
			part.Size = Vector3.new(0.18, 0.18, (from - to).Magnitude)
			part.CFrame = CFrame.new((from + to) * 0.5, to)
			part.Parent = workspace.Terrain
			local TweenService = game:GetService('TweenService')
			local Debris = game:GetService('Debris')
			TweenService:Create(part, TweenInfo.new(0.18),
				{ Transparency = 1 }):Play()
			Debris:AddItem(part, 0.22)
		end
	end)

	Players.PlayerRemoving:Connect(function(player) despawn(player) end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Gameplay/EquipmentRendererClient.luau"><![CDATA[local Players = game:GetService('Players')
local CollectionService = game:GetService('CollectionService')
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local MaidClassModule = ReplicatedModules.Modules.Maid
local SignalClassModule = ReplicatedModules.Modules.Signal
local ItemConfigModule = ReplicatedModules.Data.Items
local AssetService = ReplicatedModules.Services.AssetService
local CharacterStatesService = ReplicatedModules.Services.CharacterStates
local CombatSharedModule = ReplicatedModules.Services.CombatShared
local TableUtility = ReplicatedModules.Utility.Table
local ModelsUtility = ReplicatedModules.Utility.Models
local CombatUtility = ReplicatedModules.Utility.CombatUtility

local RemoteService = ReplicatedModules.Services.RemoteService
local EquipmentRenderEvent = RemoteService.GetRemote('EquipmentRenderEvent', 'RemoteEvent', false)

local RemoteJobs = { BulkSet = 1, BulkRemove = 3, Cleanup = 4 }

local SystemsContainer = {}

local function GetTargetPlayerCharacter( characterName )
	return Players:FindFirstChild(characterName) and Players[characterName].Character
end

local function AccessorifyModel( Model )
	for _, BasePart in Model:GetChildren() do
		if BasePart:IsA("BasePart") then
			BasePart.Anchored = false
			BasePart.CanCollide = false
			BasePart.CanTouch = false
			BasePart.CanQuery = false
			BasePart.Massless = true
		end
	end
end

local function WeldToPrimaryPart(Model)
	local PrimaryPart = Model.PrimaryPart
	for _, object in Model:GetDescendants() do
		if object:IsA('BasePart') and object ~= PrimaryPart then
			local Weld = Instance.new('WeldConstraint')
			Weld.Part0 = object
			Weld.Part1 = PrimaryPart
			Weld.Parent = PrimaryPart
		end
	end
end

-- // Module // --
local Module = {}

Module.ActiveDataCache = {}
Module.ActiveInstanceCache = {}

Module.OnWeaponEquipped = SignalClassModule.New()
Module.OnWeaponUnequipped = SignalClassModule.New()

function Module.AdjustWeaponLocation(character : Model, model : Model, weaponID : string, handIndex : number)
	local itemConfig = ItemConfigModule.Items[ weaponID ]
	-- Post-migration the shell may not yet have this id (other players'
	-- equipped weapons aren't broadcast yet). Bail quietly — the
	-- weapon's parent Folder placeholder will be replaced when configs
	-- land, at which point a re-equip event will retrigger this path.
	if not itemConfig or not itemConfig.EquipmentData then return end
	local hasWeaponDrawn = CombatSharedModule.IsWeaponDrawn(character)

	local targetAttach = nil
	local offsetCFrame = nil

	-- Per-hand offsets keyed by `handIndex` (1 = left, 2 = right). The
	-- artist authors each side directly in `Items.luau`; the renderer
	-- doesn't try to mirror a single offset anymore. `[handIndex]`
	-- with a fallback to `[1]` keeps single-instance equipment (Head,
	-- Chest, …) working when only the primary entry is provided.
	local equipData = itemConfig.EquipmentData
	if hasWeaponDrawn then
		offsetCFrame = equipData.HandOffsets[handIndex] or equipData.HandOffsets[1]
		-- Different attach parts on each hand naturally mirror the
		-- weapon left↔right because R15's LeftHand and RightHand have
		-- opposite outward-pointing X axes. Use `GetSlotAttachName` to
		-- stay consistent with the Default-equipment branch instead of
		-- hardcoding the part name a second time.
		targetAttach = CombatUtility.GetSlotAttachName(ItemConfigModule.EquipmentSlotEnums.Hand, handIndex)
	else
		offsetCFrame = equipData.BackOffsets[handIndex] or equipData.BackOffsets[1]
		targetAttach = 'UpperTorso'
	end

	local attachInstance = character and character:FindFirstChild( targetAttach )
	if not attachInstance then
		print("Could not find the instance to attach weapon to: ", targetAttach)
		return
	end

	local oldWeld = model.PrimaryPart:FindFirstChildWhichIsA('WeldConstraint')
	if oldWeld then
		oldWeld:Destroy()
	end

	model:PivotTo(attachInstance.CFrame * offsetCFrame)
	ModelsUtility.WeldConstraint(model.PrimaryPart, attachInstance)
end

Module.EquipFunctions = {

	Default = function( character, itemID )
		local itemConfig = ItemConfigModule.GetConfigFromId(itemID)

		print(itemID, itemConfig)
		local equipData = itemConfig and itemConfig.EquipmentData
		if not equipData then
			print("Item is not equippable: ", itemID)
			return Instance.new('Folder')
		end

		local itemModel = AssetService.GetEquipmentByName( equipData.Model )
		if not itemModel then
			print("Could not find item model of id: ", itemID, equipData.Model )
			return Instance.new('Folder')
		end

		-- Resolve attach part from the item's primary EquipSlot enum
		-- (replaces the removed `EquipData.BodyPart` string).
		local primarySlotCfg = equipData.EquipSlots and equipData.EquipSlots[1]
		local attachName = primarySlotCfg and CombatUtility.GetSlotAttachName(primarySlotCfg.Slot, 2) or 'UpperTorso'
		local attachInstance = character and character:FindFirstChild( attachName )
		if not attachInstance then
			print("Could not find the instance to attach weapon to: ", attachName)
			return Instance.new('Folder')
		end

		itemModel = itemModel:Clone()
		AccessorifyModel( itemModel )
		itemModel:PivotTo(attachInstance.CFrame * equipData.StandardOffset)
		itemModel.Parent = character
		ModelsUtility.WeldConstraint(itemModel.PrimaryPart, attachInstance)
		WeldToPrimaryPart( itemModel )
		return itemModel
	end,

	Weapon = function( character, weaponID, handIndex ) : Instance
		local weaponConfig = ItemConfigModule.GetConfigFromId(weaponID)
		-- Post-migration: Items is replicated per-player. The LOCAL
		-- player's owned items are populated after BootstrapPlayer, but
		-- OTHER players' equipped weapons aren't in the local shell
		-- (no replication path pushes them yet). Rather than crash with
		-- "index nil with EquipmentData", render an empty folder; the
		-- weapon will pop in once the server-side broadcast for
		-- visible-equipped items lands. See ROADMAP.md for the
		-- broadcast-on-equip pattern (deferred follow-up).
		if not weaponConfig or not weaponConfig.EquipmentData then
			return Instance.new('Folder')
		end

		local weaponModel = ReplicatedAssets.Weapons:FindFirstChild( weaponConfig.EquipmentData.Model )
		if not weaponModel then
			print("Could not find weapon model of id: ", weaponID, weaponConfig.EquipmentData.Model )
			return Instance.new('Folder')
		end

		weaponModel = weaponModel:Clone()
		-- Tag every equipped weapon model so other systems (AurasClient
		-- 'sword' anchor; any future weapon-aware widget) can locate
		-- them via CollectionService without coupling to this module.
		-- Hand index attribute is set so consumers can distinguish L/R.
		CollectionService:AddTag(weaponModel, 'EquippedWeapon')
		weaponModel:SetAttribute('HandIndex', handIndex)
		AccessorifyModel( weaponModel )
		Module.AdjustWeaponLocation(character, weaponModel, weaponID, handIndex)
		WeldToPrimaryPart( weaponModel )
		weaponModel.Parent = character
		return weaponModel
	end,

}

function Module.CleanupCharacterVisuals(character : Model)
	if not Module.ActiveInstanceCache[character] then
		return
	end
	for _, object in Module.ActiveInstanceCache[character] do
		object:Destroy()
	end
	Module.ActiveInstanceCache[character] = nil
end

function Module.CleanupCharacterData(character : Model)
	if Module.ActiveDataCache[character] then
		Module.ActiveDataCache[character] = nil
	end
	Module.CleanupCharacterVisuals(character)
	Module.UpdateCharacterVisuals(character)
end

function Module.BulkSetCharacterVisuals(character : Model, slotData : { {slotId : string, data : {uuid : string, itemId : string}} })
	if not Module.ActiveDataCache[character] then
		Module.ActiveDataCache[character] = {}
	end
	for _, data in slotData do
		Module.ActiveDataCache[character][data.slotId] = data.data
	end
	Module.UpdateCharacterVisuals(character)
end

function Module.BulkRemoveCharacterVisuals(character : Model, slotIds : {string})
	if not Module.ActiveDataCache[character] then
		return
	end

	for _, slotId in slotIds do
		Module.ActiveDataCache[character][slotId] = nil
	end
	Module.UpdateCharacterVisuals(character)
end

function Module.UpdateCharacterVisuals(character : Model)
	if not Module.ActiveDataCache[character] then
		Module.CleanupCharacterVisuals(character)
		return
	end

	local DataContainer = character:FindFirstChild('RENDER_DATA')
	if not DataContainer then
		DataContainer = Instance.new('Folder')
		DataContainer.Name = 'RENDER_DATA'
		DataContainer.Parent = character
	end

	DataContainer:ClearAllChildren()
	TableUtility.TableToObject(Module.ActiveDataCache[character], DataContainer, {})

	if not Module.ActiveInstanceCache[character] then
		Module.ActiveInstanceCache[character] = {}
	end

	local ActiveUUIDs = {}

	for slotId, slotData in Module.ActiveDataCache[character] do
		-- equipping specifically a weapon
		if string.find(slotId, "Weapon") then
			table.insert(ActiveUUIDs, slotData.uuid)
			if Module.ActiveInstanceCache[character][slotData.uuid] then
				Module.ActiveInstanceCache[character][slotData.uuid]:Destroy()
			end
			Module.ActiveInstanceCache[character][slotData.uuid] = nil
			if character == LocalPlayer.Character then
				Module.OnWeaponEquipped:Fire(slotId, slotData.uuid, slotData.itemId)
			end
			local handIndex : number = string.find(slotId, "1_") and 1 or 2
			print(slotData.itemId, handIndex)
			Module.ActiveInstanceCache[character][slotData.uuid] = Module.EquipFunctions.Weapon(character, slotData.itemId, handIndex)
			continue
		end
		-- equipping anything else
		for uuid, itemData in slotData do
			table.insert(ActiveUUIDs, uuid)
			if Module.ActiveInstanceCache[character][uuid] then
				Module.ActiveInstanceCache[character][uuid]:Destroy()
			end
			Module.ActiveInstanceCache[character][uuid] = nil
			if character == LocalPlayer.Character then
				Module.OnWeaponEquipped:Fire(slotId, uuid, itemData.itemId)
			end
			Module.ActiveInstanceCache[character][uuid] = Module.EquipFunctions.Default(character, itemData.itemId)
		end
	end

	-- destroy any unequipped models
	for uuid, model in Module.ActiveInstanceCache[character] do
		if not table.find(ActiveUUIDs, uuid) then
			model:Destroy()
			Module.ActiveInstanceCache[character][uuid] = nil
		end
	end

end

function Module.ReloadCharacterVisuals(character : Model)
	task.wait()
	local Humanoid = character:FindFirstChildWhichIsA('Humanoid')
	if not Humanoid then
		return
	end
	CombatSharedModule.SetupCharacterAnimations(character, Humanoid)
	Module.UpdateCharacterVisuals(character)

	local connection = CharacterStatesService.StateChanged(character):Connect(function(stateName)
		if stateName == "SwordDrawn" then
			Module.UpdateCharacterVisuals(character)
		end
	end)

	Humanoid.Destroying:Wait()

	connection:Disconnect()
end

function Module.Start()

	EquipmentRenderEvent.OnClientEvent:Connect(function(job : number, ...)
		if job == RemoteJobs.BulkSet then
			Module.BulkSetCharacterVisuals(...)
		elseif job == RemoteJobs.Cleanup then
			Module.CleanupCharacterData(...)
		elseif job == RemoteJobs.BulkRemove then
			Module.BulkRemoveCharacterVisuals(...)
		end
	end)

	-- Roblox doesn't guarantee event ordering across different
	-- RemoteEvents. The server's broadcast of item configs (via
	-- ConfigReplicationEvent) and the equip render event (via
	-- EquipmentRenderEvent) can arrive in either order on the client.
	-- If BulkSet lands first, the renderer's defensive guards return
	-- empty Folders for items whose configs aren't yet in the shell.
	-- When the configs DO land, ConfigReplicationClient fires the
	-- 'Items' OnReplicated signal — re-render every active character
	-- so the placeholder Folders get replaced with the real visuals.
	local LocalModulesRoot = LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules')
	local LocalModules = require(LocalModulesRoot)
	local ConfigReplicationClient = LocalModules.Modules.ConfigReplicationClient
	local itemsSig = ConfigReplicationClient and ConfigReplicationClient.GetSignal
		and ConfigReplicationClient.GetSignal('Items')
	if itemsSig then
		itemsSig:Connect(function()
			-- Walk every cached character and refresh its visuals. The
			-- update is idempotent (placeholder Folders get destroyed
			-- and rebuilt; real models stay if their configs were
			-- already populated).
			for character in Module.ActiveDataCache do
				Module.UpdateCharacterVisuals(character)
			end
		end)
	end

	local function OnPlayerAdded( player : Player )
		if player.Character then
			task.spawn(Module.ReloadCharacterVisuals, player.Character)
		end

		local Maid = MaidClassModule.New()

		Maid:Give(player.CharacterAdded:Connect(Module.ReloadCharacterVisuals))
		Maid:Give(player:GetAttributeChangedSignal('SwordDrawing'):Connect(function()
			if not player.Character then
				return
			end
			Module.UpdateCharacterVisuals(player.Character)
		end))

		player.Destroying:Wait()

		Maid:Cleanup()
	end

	for _, player in Players:GetPlayers() do
		task.defer(OnPlayerAdded, player)
	end
	Players.PlayerAdded:Connect(OnPlayerAdded)

	EquipmentRenderEvent:FireServer()

	task.spawn(function()
		while true do
			task.wait(30)
			for character, _ in Module.ActiveDataCache do
				-- cleanup any dead characters / null references
				if character and character:IsDescendantOf(workspace) then
					continue
				end
				Module.CleanupCharacterData(character)
			end
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Gameplay/InteractionsClient.luau"><![CDATA[
export type InteractableBase = {
	-- unique identifier for this interactable
	UID : string | number,
	-- interactable-specific id
	IID : string,

	-- the interactable object
	Object : Instance,
	-- adornee
	Adornee : BasePart,
	-- where the distance is calculated from
	Center : BasePart,

	-- object text
	ObjectText : string?,
	-- action text
	ActionText : string?,

	-- keyboard keycode
	KeyboardCode : Enum.KeyCode?,
	-- gamepad keycode
	GamepadCode : Enum.KeyCode?,
	-- is touch enabled for this interactable
	TouchEnabled : boolean,

	-- is single-use interaction
	SingleUse : boolean,
	-- cooldown for interaction if not single use
	Cooldown : number,
	-- how long it lasts
	HoldDuration: number,
	-- max distance it can be interacted at (<32 studs)
	MaxInteractDistance : number,
	-- whether or not to include height in the distance calculation
	MaxDistanceIncludesHeight : boolean,
	-- requires line of sight
	RequiresLineOfSight : boolean,
	-- show beam line
	ShowBeamLine : boolean,
	-- show highlight
	ShowHighlight : boolean,

	-- custom whitelist function
	IsInteractable : ((InteractableBase, (Player | Model)?) -> boolean)?,

	-- events
	InteractHoldBegin : RBXScriptSignal,
	InteractHoldEnd : RBXScriptSignal,
	InteractTriggered : RBXScriptSignal,
	InteractShown : RBXScriptSignal,
	InteractHidden : RBXScriptSignal,
}

local CollectionService = game:GetService("CollectionService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")

local LocalPlayer = game:GetService('Players').LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild('PlayerGui')

local LocalModules = require(LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("Modules"))
local PlatformModule = LocalModules.Utility.Platform
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE = HUDCommon.PALETTE

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local InteractableData = ReplicatedModules.Data.Interactable
local InteractableService = ReplicatedModules.Services.InteractableService

local CurrentCamera = workspace.CurrentCamera

local SystemsContainer = {}

local interactionHighlight : Highlight = nil

local interactionAttachment0 : Attachment = nil
local interactionAttachment1 : Attachment = nil
local interactionBeam : Beam = nil

local interactionBillboardAttachment : Attachment = nil
local interactionTextBillboard : BillboardGui = nil
local interactionKeyBillboard : BillboardGui = nil

local activeInteractable : InteractableBase? = nil
local holdTimerStart : number? = nil
local holdDelta : number = 0
local activelyHolding : boolean = false

local function TweenSize(frame : Frame, endSize : UDim2, duration : number?)
	frame:TweenSize(endSize, Enum.EasingDirection.InOut, Enum.EasingStyle.Linear, duration or 0.5, true)
end

-- // Module // --
local Module = {}

function Module.InternalStartHold(interactable, inputObject)
	interactable.InteractHoldBegin:Fire()

	holdTimerStart = time()
	holdDelta = 0
	activelyHolding = true

	local finishTime = holdTimerStart + interactable.HoldDuration
	while UserInputService:IsKeyDown(inputObject.KeyCode) and interactable and activelyHolding do
		holdDelta = (time() - holdTimerStart) / (finishTime - holdTimerStart)
		holdDelta = math.clamp(holdDelta, 0, 1)
		if interactionTextBillboard then
			TweenSize(interactionTextBillboard.BarFrame.Bar, UDim2.fromScale(holdDelta, 1), 0.05)
		end
		if holdDelta == 1 then
			break
		end
		-- print(holdDelta)
		task.wait()
	end

	activelyHolding = false
	TweenSize(interactionTextBillboard.BarFrame.Bar, UDim2.fromScale(0, 1), 0)

	if holdDelta >= 1 then
		-- print('Interaction UI Button has been completed!')
		InteractableService.HadInteractedWith(interactable, LocalPlayer)
		interactable.InteractTriggered:Fire()
	end

	-- print('Interaction UI Button has been released.')
	interactable.InteractHoldEnd:Fire()
end

function Module.HandleKeybindPress(inputState : Enum.UserInputState, inputObject : InputObject) : Enum.ContextActionResult
	if not activeInteractable then
		return Enum.ContextActionResult.Pass
	end

	if activeInteractable.KeyboardCode ~= inputObject.KeyCode and activeInteractable.GamepadCode ~= inputObject.KeyCode then
		return Enum.ContextActionResult.Pass
	end

	if inputState ~= Enum.UserInputState.Begin then
		return
	end

	-- print(inputObject.KeyCode.Name, inputObject.UserInputType.Name)
	task.spawn(Module.InternalStartHold, activeInteractable, inputObject)

	return Enum.ContextActionResult.Sink
end

function Module.CleanupActiveInteractable()
	-- walked away, exit key hold loop early
	activelyHolding = false
	-- cleanup interaction if it was visible
	if activeInteractable then
		activeInteractable.InteractHidden:Fire()
		ContextActionService:UnbindAction('InteractBind')
		interactionHighlight.Adornee = nil
		interactionHighlight.Enabled = false
		interactionBeam.Enabled = false
		interactionKeyBillboard.Enabled = false
		interactionTextBillboard.Enabled = false
	end
	activeInteractable = nil
end

local HAS_WARNED_CHANGE_INTERACTIVE_DURING_HOLD = false -- NOTE: TEMPORARY

function Module.HeartbeatStep(_ : number)
	InteractableService.UpdateDynamicPoints()

	-- check for nearby interactables
	local characterPosition : Vector3? = LocalPlayer.Character and LocalPlayer.Character:GetPivot().Position
	local nearby : {any} = characterPosition and InteractableService.FindClosestInteractables(characterPosition, LocalPlayer)
	if (not nearby) or #nearby == 0 then
		if activelyHolding then
			warn('Walked away from interaction during hold.')
		end
		HAS_WARNED_CHANGE_INTERACTIVE_DURING_HOLD = false
		interactionKeyBillboard.Enabled = false
		interactionTextBillboard.Enabled = false
		Module.CleanupActiveInteractable()
		return
	end

	local interactable : InteractableBase = nearby[1]

	-- dont change our active interactable if we're busy interacting and its still nearby
	if activelyHolding and table.find(nearby, activeInteractable) then
		if interactable ~= activeInteractable and not HAS_WARNED_CHANGE_INTERACTIVE_DURING_HOLD then
			HAS_WARNED_CHANGE_INTERACTIVE_DURING_HOLD = true
			warn('Busy with current interaction - do not change active.')
		end
		return
	end

	HAS_WARNED_CHANGE_INTERACTIVE_DURING_HOLD = false

	-- we've moved away from the closest or we're not currently interacting with the nearby one
	-- first time setup for a new neary interactable
	if interactable ~= activeInteractable then
		if activeInteractable then
			if activelyHolding then
				warn('Walked away from interaction during hold.')
			end
			Module.CleanupActiveInteractable()
		end
		interactable.InteractShown:Fire()

		ContextActionService:BindAction('InteractBind', function(actionName, inputState, inputObject)
			if actionName == 'InteractBind' and interactable then
				return Module.HandleKeybindPress(inputState, inputObject)
			end
			return Enum.ContextActionResult.Pass
		end, false, interactable.KeyboardCode, interactable.GamepadCode)
	end

	activeInteractable = interactable

	local center_position : Vector3 = interactable.Center.Position

	-- update billboard ui to display keybind
	local platform = PlatformModule.GetPlatform() :: "Console" | "Desktop" | "Mobile"
	if platform == "Desktop" or platform == "Console" then
		interactionKeyBillboard.Frame.TButton.Visible = true
		-- Defensive resolve: the previous direct `.Name` access produced
		-- a glyph blob whenever KeyboardCode wasn't an EnumItem (e.g. an
		-- interactable registered with a string fallback or a stale
		-- value that survived an API change). Walk the typeof chain so a
		-- string passes through verbatim and a missing/unknown value
		-- defaults to the registry's default 'E' keybind.
		local kc = interactable.KeyboardCode
		local keyText = 'E'
		if typeof(kc) == 'EnumItem' then
			keyText = kc.Name
		elseif typeof(kc) == 'string' and kc ~= '' then
			keyText = kc
		end
		interactionKeyBillboard.Frame.TButton.Text = keyText
		interactionKeyBillboard.Frame.IButton.Visible = false
	elseif platform == "Mobile" then
		interactionKeyBillboard.Frame.TButton.Visible = false
		-- Note: assumes that the IButton is set to the mobile tap icon
		interactionKeyBillboard.Frame.IButton.Visible = true
	end

	-- update billboard ui to display interact text
	interactionTextBillboard.ActionText.Text = interactable.ActionText or ""
	interactionTextBillboard.ObjectText.Text = interactable.ObjectText or ""

	-- update beams
	if interactable.ShowBeamLine then
		interactionBeam.Enabled = true
		interactionAttachment0.WorldCFrame = CFrame.new(characterPosition)
		interactionAttachment1.WorldCFrame = CFrame.new(center_position)
	else
		interactionBeam.Enabled = false
	end

	-- update highlight
	if interactable.ShowHighlight then
		interactionHighlight.Enabled = true
		interactionHighlight.Adornee = interactable.Object
	else
		interactionHighlight.Enabled = false
		interactionHighlight.Adornee = nil
	end

	-- update billboards
	interactionBillboardAttachment.WorldCFrame = CFrame.new(center_position)
	TweenSize(interactionTextBillboard.BarFrame.Bar, UDim2.fromScale(0, 1), 0.7)
	interactionKeyBillboard.Enabled = true
	interactionTextBillboard.Enabled = true
end

function Module.RegisterPresetCallback(presetId : string, interactable : InteractableBase)
	-- TODO
end

function Module.RegisterPresetInteractable(object : Instance) : InteractableBase?
	-- TODO
end

function Module.UnRegisterPresetInteractable(object : Instance)
	-- TODO
end

function Module.SetupTestInteractable()
	-- custom test interaction
	local customObject = workspace:WaitForChild('TestInteractable')

	local interactable = InteractableService.RegisterInteractable({
		-- interactable-specific id
		IID = '1',

		-- the interactable object
		Object = customObject,
		-- adornee
		Adornee = customObject.Adornee,
		-- where the distance is calculated from
		Center = customObject.Center,

		-- object text
		ObjectText = 'Custom Interactor',
		-- action text
		ActionText = 'Press me for something cool!',

		-- show beam line
		ShowBeamLine = true,
		-- show highlight
		ShowHighlight = true,
	})

	print(interactable)

	interactable.InteractHoldBegin:Connect(function()
		print('Interaction key is now held!')
	end)

	interactable.InteractHoldEnd:Connect(function()
		print('Interaction key is now released!')
	end)

	interactable.InteractTriggered:Connect(function()
		print('Interaction has been triggered!')
	end)

	interactable.InteractShown:Connect(function()
		print('Interaction now visible!')
	end)

	interactable.InteractHidden:Connect(function()
		print('Interaction now hidden!')
	end)
end

function Module.Start()
	for _, object in CollectionService:GetTagged(InteractableData.InteractableTag) do
		task.defer(Module.RegisterPresetInteractable, object)
	end
	CollectionService:GetInstanceAddedSignal(InteractableData.InteractableTag):Connect(Module.RegisterPresetInteractable)
	CollectionService:GetInstanceRemovedSignal(InteractableData.InteractableTag):Connect(Module.UnRegisterPresetInteractable)

	-- prefer loop as RunService will not wait for the previous iteration to finish
	task.spawn(function()
		while true do
			local dt : number = task.wait()
			Module.HeartbeatStep(dt)
		end
	end)

	-- setup interaction billboard buttons
	interactionKeyBillboard.Frame.IButton.Activated:Connect(function()
		if not activeInteractable then
			return
		end
		local interactable = activeInteractable
		-- print('Interaction UI Button has been pressed.')
		interactable.InteractHoldBegin:Fire()
		while UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) or UserInputService:IsMouseButtonPressed(Enum.UserInputType.Touch) do
			task.wait()
		end
		-- print('Interaction UI Button has been released.')
		interactable.InteractHoldEnd:Fire()
	end)

	interactionKeyBillboard.Frame.TButton.Activated:Connect(function()
		if not activeInteractable then
			return
		end
		local interactable = activeInteractable
		-- print('Interaction UI Button has been pressed.')
		interactable.InteractHoldBegin:Fire()
		while UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) or UserInputService:IsMouseButtonPressed(Enum.UserInputType.Touch) do
			task.wait()
		end
		-- print('Interaction UI Button has been released.')
		interactable.InteractHoldEnd:Fire()
	end)

	if workspace:FindFirstChild('TestInteractable') then
		task.defer(Module.SetupTestInteractable)
	else
		print("No TestInteractable found in workspace, skipping.")
	end
end

-- Build the text+progress billboard (ObjectText · ActionText · BarFrame > Bar).
local function buildInteractTextBillboard(): BillboardGui
	local bb = Instance.new('BillboardGui')
	bb.Name = 'InteractTextBillboard'
	bb.ResetOnSpawn = false
	bb.Size = UDim2.fromOffset(220, 70)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 2.4, 0)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.ClipsDescendants = false
	bb.Enabled = false

	local object = Instance.new('TextLabel')
	object.Name = 'ObjectText'
	object.Size = UDim2.new(1, 0, 0, 16)
	object.BackgroundTransparency = 1
	object.FontFace = HUDCommon.FONT_MONO
	object.TextSize = 11
	object.TextColor3 = PALETTE.accent
	object.TextStrokeTransparency = 0.6
	object.TextStrokeColor3 = Color3.new(0, 0, 0)
	object.Text = ''
	object.Parent = bb

	local action = Instance.new('TextLabel')
	action.Name = 'ActionText'
	action.Position = UDim2.fromOffset(0, 18)
	action.Size = UDim2.new(1, 0, 0, 20)
	action.BackgroundTransparency = 1
	action.FontFace = HUDCommon.FONT_UI
	action.TextSize = 15
	action.TextColor3 = PALETTE.ink
	action.TextStrokeTransparency = 0.4
	action.TextStrokeColor3 = Color3.new(0, 0, 0)
	action.Text = ''
	action.Parent = bb

	local barFrame = Instance.new('Frame')
	barFrame.Name = 'BarFrame'
	barFrame.AnchorPoint = Vector2.new(0.5, 1)
	barFrame.Position = UDim2.new(0.5, 0, 1, -8)
	barFrame.Size = UDim2.new(1, -40, 0, 3)
	barFrame.BackgroundColor3 = PALETTE.bg0
	barFrame.BackgroundTransparency = 0.35
	barFrame.BorderSizePixel = 0
	barFrame.Parent = bb

	local barStroke = Instance.new('UIStroke')
	barStroke.Color = PALETTE.accent
	barStroke.Transparency = 0.6
	barStroke.Thickness = 1
	barStroke.Parent = barFrame

	local bar = Instance.new('Frame')
	bar.Name = 'Bar'
	bar.Size = UDim2.fromScale(0, 1)
	bar.BackgroundColor3 = PALETTE.accent
	bar.BorderSizePixel = 0
	bar.Parent = barFrame

	return bb
end

-- Build the keybind chip billboard (Frame > TButton | IButton).
local function buildInteractKeyBillboard(): BillboardGui
	local bb = Instance.new('BillboardGui')
	bb.ResetOnSpawn = false
	bb.Name = 'InteractKeyBillboard'
	bb.Size = UDim2.fromOffset(60, 60)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 0.2, 0)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Enabled = false
	bb.Active = true

	local frame = Instance.new('Frame')
	frame.Name = 'Frame'
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.fromOffset(30, 30)
	frame.BackgroundTransparency = 1
	frame.Parent = bb

	local function styleKeyChip(btn: TextButton)
		btn.Size = UDim2.fromScale(1, 1)
		btn.BackgroundColor3 = Color3.new(0, 0, 0)
		btn.BackgroundTransparency = 0.2
		btn.AutoButtonColor = false
		btn.BorderSizePixel = 0
		btn.FontFace = HUDCommon.FONT_MONO
		-- TextScaled fits the glyph to the chip's bounds — fixes the
		-- "blob" rendering at small billboard sizes AND lets multi-char
		-- keybinds like 'LeftControl' / 'LeftShift' shrink to fit
		-- instead of overflowing the 30×30 button. TextSize is kept as
		-- the upper bound (Roblox honors it as the cap when TextScaled
		-- is on).
		btn.TextScaled = true
		btn.TextSize = 14
		btn.TextColor3 = PALETTE.accent
		btn.TextStrokeTransparency = 0.5
		btn.TextStrokeColor3 = Color3.new(0, 0, 0)
		local stroke = Instance.new('UIStroke')
		stroke.Color = PALETTE.accent
		stroke.Thickness = 1.5
		stroke.Transparency = 0
		stroke.Parent = btn
	end

	local tButton = Instance.new('TextButton')
	tButton.Name = 'TButton'
	tButton.Text = 'F'
	tButton.Visible = false
	styleKeyChip(tButton)
	tButton.Parent = frame

	local iButton = Instance.new('TextButton')
	iButton.Name = 'IButton'
	iButton.Text = '◆'
	iButton.Visible = false
	styleKeyChip(iButton)
	iButton.Parent = frame

	return bb
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems

	-- highlight
	interactionHighlight = Instance.new('Highlight')
	interactionHighlight.Name = 'InteractionHighlight'
	interactionHighlight.FillColor = PALETTE.accent
	interactionHighlight.FillTransparency = 0.75
	interactionHighlight.OutlineColor = PALETTE.accent
	interactionHighlight.OutlineTransparency = 0.2
	interactionHighlight.Parent = CurrentCamera

	-- beam attachments
	interactionAttachment0 = Instance.new('Attachment')
	interactionAttachment0.Parent = workspace:WaitForChild('Terrain')
	interactionAttachment1 = Instance.new('Attachment')
	interactionAttachment1.Parent = workspace:WaitForChild('Terrain')

	-- beam
	interactionBeam = Instance.new('Beam')
	interactionBeam.Attachment0 = interactionAttachment0
	interactionBeam.Attachment1 = interactionAttachment1
	interactionBeam.Width0 = 0.075
	interactionBeam.Width1 = 0.075
	interactionBeam.FaceCamera = true
	interactionBeam.Segments = 1
	interactionBeam.Transparency = NumberSequence.new(0.8)
	interactionBeam.Color = ColorSequence.new(PALETTE.accent)
	interactionBeam.LightEmission = 1
	interactionBeam.LightInfluence = 0
	interactionBeam.Parent = interactionAttachment0

	-- billboard attachment
	interactionBillboardAttachment = Instance.new('Attachment')
	interactionBillboardAttachment.Parent = workspace:WaitForChild('Terrain')

	-- billboards — code-built to match tmp/aincrad-ui/hud.jsx WorldPrompt.
	interactionTextBillboard = buildInteractTextBillboard()
	interactionTextBillboard.Adornee = interactionBillboardAttachment
	interactionTextBillboard.BarFrame.Bar.Size = UDim2.fromScale(0, 1)
	interactionTextBillboard.Parent = PlayerGui
	interactionKeyBillboard = buildInteractKeyBillboard()
	interactionKeyBillboard.Adornee = interactionBillboardAttachment
	interactionKeyBillboard.Parent = PlayerGui
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Gameplay/MountsClient.luau"><![CDATA[-- Mounts client. Owns the visible mount Model, the weld/lock that keeps the
-- rider on the seat, locomotion replacement (land = WalkSpeed mod, flight =
-- velocity-driven rig), keybind for dismount, and per-frame camera tilt for
-- flight.
--
-- Public API:
--   Module.AttemptEquip(mountId)   — UI hook; sends TryEquip remote
--   Module.AttemptDismount()       — UI/keybind hook
--   Module.IsMounted() → boolean
--
-- Server replicates: data.Mounts.EquippedMount via ReplicatedData, and
-- per-spawn/despawn cues via MountEvent. We render local + other-player
-- mounts off the FireAllClients spawn cue.

local Players = game:GetService('Players')
local UserInputService = game:GetService('UserInputService')
local ContextActionService = game:GetService('ContextActionService')
local RunService = game:GetService('RunService')
local Debris = game:GetService('Debris')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local MountsShared = ReplicatedModules.Services.MountsShared
local MountsConfig = ReplicatedModules.Data.Mounts
local SoundService = ReplicatedModules.Services.SoundService
local RemoteService = ReplicatedModules.Services.RemoteService

local MountEvent = RemoteService.GetRemote('MountEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Per-rider state. Keyed by Player so other players' mounts also render
-- on this client. The local-player entry has extra fields for input
-- handling (flight controls, keybind hookup).
----------------------------------------------------------------------
type Rider = {
	mountId: string,
	model: Model?,
	cfg: any,
	connections: { RBXScriptConnection },
	-- Land + Hover share these (both use humanoid locomotion):
	originalWalkSpeed: number?,
	originalJumpPower: number?,
	originalHipHeight: number?,
	-- Flight only:
	bodyVelocity: BodyVelocity?,
	bodyGyro: BodyGyro?,
	-- Animation tracks:
	tracks: { [string]: AnimationTrack },
}

local Riders: { [Player]: Rider } = {}

----------------------------------------------------------------------
-- Helpers.
----------------------------------------------------------------------
local function findMountTemplate(modelName: string): Model?
	local assets = ReplicatedStorage:FindFirstChild('AssetsShared')
	local mounts = assets and assets:FindFirstChild('Mounts')
	local template = mounts and mounts:FindFirstChild(modelName)
	return template :: Model?
end

----------------------------------------------------------------------
-- Procedural placeholder. Built when the named template under
-- AssetsShared.Mounts.<Model> isn't present so flight rigs still
-- have a PrimaryPart to host BodyVelocity, and land riders have a
-- visible-but-blocky mount instead of an invisible "I'm just floating
-- around" experience. Per-mount tinting derives from the config Kind
-- so land mounts read brown / saddle-toned and flight mounts read
-- blue-grey.
----------------------------------------------------------------------
local function buildPlaceholderMount(cfg: any): Model
	local model = Instance.new('Model')
	model.Name = 'PlaceholderMount_' .. (cfg.Display and cfg.Display.Name or 'Mount')

	local kind = cfg.Kind or 'land'
	local bodyColor: Color3
	if typeof(cfg.Tint) == 'Color3' then
		-- Breed-specific tint (e.g. colored cloud mounts) wins over the
		-- generic Kind-based default.
		bodyColor = cfg.Tint
	elseif kind == 'flight' then
		bodyColor = Color3.fromRGB(120, 145, 180)
	elseif kind == 'hover' then
		-- Pale cloud-grey with a hint of cyan; reads as "wisp of mist".
		bodyColor = Color3.fromRGB(180, 200, 220)
	else
		bodyColor = Color3.fromRGB(120, 80, 50)
	end

	-- Body — primary part. Sized roughly so the player visibly sits on
	-- top via the cfg.SeatOffset, but small enough not to grief the
	-- room around them.
	local body = Instance.new('Part')
	body.Name = 'Body'
	if kind == 'flight' then
		body.Size = Vector3.new(4, 2.4, 6)
	elseif kind == 'hover' then
		-- Wide flat slab — magic-carpet silhouette.
		body.Size = Vector3.new(5, 0.5, 5)
	else
		body.Size = Vector3.new(3, 3, 5)
	end
	body.Color = bodyColor
	body.Material = Enum.Material.SmoothPlastic
	body.Anchored = false
	body.CanCollide = false
	body.Massless = true
	body.TopSurface = Enum.SurfaceType.Smooth
	body.BottomSurface = Enum.SurfaceType.Smooth
	body.Parent = model
	model.PrimaryPart = body

	-- Decorative head + (for flight) wings so the silhouette reads as
	-- something. All welded to the body so the BodyVelocity rig only
	-- needs to drive the body.
	local function attachDecor(part: BasePart, offset: CFrame)
		part.Massless = true
		part.CanCollide = false
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.Material = Enum.Material.SmoothPlastic
		part.Color = bodyColor:Lerp(Color3.new(1, 1, 1), 0.15)
		part.CFrame = body.CFrame * offset
		local weld = Instance.new('Weld')
		weld.Part0 = body
		weld.Part1 = part
		weld.C0 = offset
		weld.Parent = part
		part.Parent = model
	end

	-- Head decor on land/flight mounts only — a hover slab is faceless.
	if kind ~= 'hover' then
		local head = Instance.new('Part')
		head.Name = 'Head'
		head.Size = Vector3.new(1.4, 1.4, 1.6)
		attachDecor(head, CFrame.new(0, 0.7, -3))
	end

	if kind == 'flight' then
		-- Two thin wing slabs flanking the body. Welded so the BodyGyro
		-- yaw rotates the silhouette as the rider banks.
		local wingL = Instance.new('Part')
		wingL.Name = 'WingL'
		wingL.Size = Vector3.new(8, 0.3, 3)
		attachDecor(wingL, CFrame.new(-5, 0.5, 0))

		local wingR = Instance.new('Part')
		wingR.Name = 'WingR'
		wingR.Size = Vector3.new(8, 0.3, 3)
		attachDecor(wingR, CFrame.new(5, 0.5, 0))
	end

	return model
end

local function playSFX(entry: any?, position: Vector3?)
	if not entry or not entry.Sound then return end
	local pos = position or workspace.CurrentCamera.CFrame.Position
	SoundService.PlaySoundAtPosition(entry.Sound, pos)
end

local function isLocal(player: Player): boolean
	return player == LocalPlayer
end

----------------------------------------------------------------------
-- Spawn / despawn.
----------------------------------------------------------------------
local function despawnRider(player: Player, reason: string?)
	local rider = Riders[player]
	if not rider then return end
	for _, conn in rider.connections do
		conn:Disconnect()
	end
	if rider.bodyVelocity then rider.bodyVelocity:Destroy() end
	if rider.bodyGyro then rider.bodyGyro:Destroy() end
	for _, track in rider.tracks do
		if track then track:Stop() end
	end
	if rider.model then rider.model:Destroy() end

	-- Restore humanoid params (land/hover mounts stash original values).
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass('Humanoid')
	if humanoid then
		if rider.originalWalkSpeed then humanoid.WalkSpeed = rider.originalWalkSpeed end
		if rider.originalJumpPower then humanoid.JumpPower = rider.originalJumpPower end
		if rider.originalHipHeight then humanoid.HipHeight = rider.originalHipHeight end
		-- Flight rigs disable PlatformStand/AutoRotate; restore them so
		-- the rider can walk normally after dismount.
		if rider.cfg and rider.cfg.Kind == 'flight' then
			humanoid.PlatformStand = false
			humanoid.AutoRotate = true
		end
	end

	playSFX(rider.cfg.SFX and rider.cfg.SFX.Dismount,
		humanoid and (character :: Model):GetPivot().Position or nil)
	Riders[player] = nil

	if isLocal(player) then
		ContextActionService:UnbindAction('MountsClient_Dismount')
	end
end

local function attachAnimations(humanoid: Humanoid, animMap: any): { [string]: AnimationTrack }
	local out = {}
	if not humanoid then return out end
	local animator = humanoid:FindFirstChildOfClass('Animator')
		or humanoid:WaitForChild('Animator', 1)
	if not animator then return out end
	for stateName, assetId in animMap do
		if typeof(assetId) == 'string' and assetId ~= '' and assetId ~= 'rbxassetid://0' then
			local anim = Instance.new('Animation')
			anim.AnimationId = assetId
			local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
			if ok and track then out[stateName] = track end
			anim:Destroy()
		end
	end
	return out
end

local function spawnRider(player: Player, mountId: string)
	-- Already mounted? Despawn first to keep state clean.
	if Riders[player] then despawnRider(player, 'replace') end

	local cfg = MountsConfig.Mounts[mountId]
	if not cfg then return end
	local character = player.Character
	if not character then return end
	local hrp = character:FindFirstChild('HumanoidRootPart') :: BasePart?
	local humanoid = character:FindFirstChildOfClass('Humanoid')
	if not hrp or not humanoid then return end

	-- Resolve the visual model. Three paths:
	--   1. AssetsShared.Mounts.<Model> exists → clone it (the art-ready path).
	--   2. Asset missing AND it's a land mount → still render a placeholder
	--      so the rider has a visible animal under them.
	--   3. Asset missing AND it's a flight mount → MUST have a PrimaryPart
	--      to host BodyVelocity / BodyGyro; the placeholder provides that.
	-- The placeholder is built procedurally below; both kinds get one.
	local template = findMountTemplate(cfg.Model)
	local model: Model
	if template then
		model = template:Clone()
	else
		warn(string.format(
			"MountsClient: AssetsShared.Mounts.%s missing; using procedural placeholder.",
			tostring(cfg.Model)))
		model = buildPlaceholderMount(cfg)
	end

	-- Anchor the model to the rider via a Weld between the model's
	-- PrimaryPart (or first BasePart) and the rider's HRP. The
	-- SeatOffset CFrame is applied as the weld's C0/C1 so each
	-- mount's seat shape works without engine tuning.
	do
		local primary = model.PrimaryPart
		if not primary then
			for _, d in model:GetDescendants() do
				if d:IsA('BasePart') then primary = d; model.PrimaryPart = d; break end
			end
		end
		model:PivotTo(hrp.CFrame * cfg.SeatOffset:Inverse())
		model.Parent = workspace
		if primary then
			-- Anchor the mount and weld the rider so the rider's HRP
			-- stays glued to the seat. Anchored=true on the mount means
			-- the BodyVelocity (flight) drives the mount; the rider
			-- follows via the weld.
			primary.Anchored = (cfg.Kind == 'flight')
			local weld = Instance.new('Weld')
			weld.Part0 = primary
			weld.Part1 = hrp
			weld.C0 = cfg.SeatOffset
			weld.Parent = primary
		end
	end

	local rider: Rider = {
		mountId = mountId,
		model = model,
		cfg = cfg,
		connections = {},
		tracks = {},
		originalWalkSpeed = humanoid.WalkSpeed,
		originalJumpPower = humanoid.JumpPower,
		originalHipHeight = humanoid.HipHeight,
	}

	-- Land mount: humanoid speed/jump boost. Hover mount: same as land
	-- but lift the rider via humanoid.HipHeight so they appear to float
	-- (no actual flight controls — WSAD walks them around at altitude).
	-- Flight mount: full velocity-rig replaces normal locomotion.
	if cfg.Kind == 'land' then
		humanoid.WalkSpeed = cfg.Stats.Speed
		if cfg.Stats.JumpPower then humanoid.JumpPower = cfg.Stats.JumpPower end
	elseif cfg.Kind == 'hover' then
		humanoid.WalkSpeed = cfg.Stats.Speed
		if cfg.Stats.JumpPower then humanoid.JumpPower = cfg.Stats.JumpPower end
		-- HipHeight float — engine keeps the humanoid at this distance
		-- above the ground every physics step. Reads as "hovering" while
		-- still respecting collisions and walking input.
		humanoid.HipHeight = cfg.Stats.HoverHeight or 6
	elseif cfg.Kind == 'flight' then
		humanoid.PlatformStand = true
		humanoid.AutoRotate = false
		local primary = model and (model :: Model).PrimaryPart
		if primary then
			local bv = Instance.new('BodyVelocity')
			bv.MaxForce = Vector3.new(1, 1, 1) * 1e5
			bv.Velocity = Vector3.zero
			bv.Parent = primary
			rider.bodyVelocity = bv

			local bg = Instance.new('BodyGyro')
			bg.MaxTorque = Vector3.new(1, 1, 1) * 1e5
			bg.D = 800
			bg.P = 9000
			bg.CFrame = primary.CFrame
			bg.Parent = primary
			rider.bodyGyro = bg
		end
	end

	-- Animations (loaded lazily; anim ids of '0' or '' are skipped).
	rider.tracks = attachAnimations(humanoid, cfg.Animations or {})
	if rider.tracks.RiderIdle then rider.tracks.RiderIdle:Play(0.2) end
	if cfg.Kind == 'flight' and rider.tracks.Hover then rider.tracks.Hover:Play(0.2) end

	playSFX(cfg.SFX and cfg.SFX.Mount, hrp.Position)
	Riders[player] = rider

	-- Local rider only: keybinds + flight loop + camera tilt.
	if isLocal(player) then
		ContextActionService:BindAction(
			'MountsClient_Dismount',
			function(_, state)
				if state == Enum.UserInputState.Begin then
					Module.AttemptDismount()
				end
				return Enum.ContextActionResult.Pass
			end,
			false,
			Enum.KeyCode.LeftShift   -- dismount key
		)
		ContextActionService:SetTitle('MountsClient_Dismount', 'Dismount')

		-- Flight controls: W/S = pitch (ascend/descend), Heartbeat ticks
		-- BodyVelocity from current humanoid look + input.
		if cfg.Kind == 'flight' then
			local primary = model and (model :: Model).PrimaryPart
			local bv = rider.bodyVelocity
			local bg = rider.bodyGyro
			local connHb = RunService.Heartbeat:Connect(function(_dt)
				if not primary or not primary.Parent then return end
				if not bv or not bg then return end

				-- Forward intent from movement (humanoid.MoveDirection is
				-- the camera-relative WASD vector).
				local moveDir = humanoid.MoveDirection
				local cam = workspace.CurrentCamera and workspace.CurrentCamera.CFrame
				local lookFwd = cam and Vector3.new(cam.LookVector.X, 0, cam.LookVector.Z).Unit or Vector3.zAxis
				local horizontal = moveDir.Magnitude > 0
					and Vector3.new(moveDir.X, 0, moveDir.Z) * cfg.Stats.Speed
					or lookFwd * 0
				-- Ascend / descend with Space / LeftCtrl.
				local upDown = 0
				if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
					upDown = upDown + (cfg.Stats.FlightAscentRate or 28)
				end
				if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
					upDown = upDown - (cfg.Stats.FlightDescentRate or 22)
				end
				-- Ceiling clamp.
				local ceiling = cfg.Stats.FlightCeiling or math.huge
				if primary.Position.Y > ceiling and upDown > 0 then upDown = 0 end

				bv.Velocity = horizontal + Vector3.new(0, upDown, 0)
				if cam then bg.CFrame = cam - cam.Position + primary.Position end
			end)
			table.insert(rider.connections, connHb)
		end
	end
end

----------------------------------------------------------------------
-- Public client API.
----------------------------------------------------------------------
function Module.IsMounted(): boolean
	return Riders[LocalPlayer] ~= nil
end

-- Equip: set the active mount slot. Server hot-swaps visual when riding.
function Module.AttemptEquip(mountId: string)
	MountEvent:FireServer(MountsShared.MountActions.TryEquip, mountId)
end

-- Unequip: clear the active mount slot (auto-dismounts if riding).
function Module.AttemptUnequip()
	MountEvent:FireServer(MountsShared.MountActions.TryUnequip)
end

-- Mount: start riding the equipped mount. No-op if already riding.
function Module.AttemptMount()
	if Module.IsMounted() then return end
	MountEvent:FireServer(MountsShared.MountActions.TryMount)
end

-- Dismount: stop riding (preserves the equipped mount slot).
function Module.AttemptDismount()
	if not Module.IsMounted() then return end
	MountEvent:FireServer(MountsShared.MountActions.TryDismount)
end

-- Convenience for hotbar G key: dismount if riding, else mount.
function Module.AttemptToggleRide()
	if Module.IsMounted() then
		Module.AttemptDismount()
	else
		Module.AttemptMount()
	end
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	MountEvent.OnClientEvent:Connect(function(action, ...)
		if action == MountsShared.MountActions.Spawn then
			local player, mountId = ...
			spawnRider(player, mountId)
		elseif action == MountsShared.MountActions.Despawn then
			local player, reason = ...
			despawnRider(player, reason)
		elseif action == MountsShared.MountActions.Mounted
			or action == MountsShared.MountActions.Unmounted then
			-- Currently no extra client work — model already
			-- spawned/despawned via Spawn/Despawn cues. Reserved for
			-- future per-rider HUD changes (mount HP bar, etc.).
		end
	end)

	-- On respawn / leave, ensure no dangling riders persist.
	LocalPlayer.CharacterRemoving:Connect(function()
		if Riders[LocalPlayer] then despawnRider(LocalPlayer, 'death') end
	end)
	Players.PlayerRemoving:Connect(function(player)
		if Riders[player] then despawnRider(player, 'leave') end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Gameplay/MovementController.luau"><![CDATA[local CollectionService = game:GetService('CollectionService')

local LocalPlayer = game:GetService('Players').LocalPlayer

local PlayerModule = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('PlayerModule'))
local Controls = PlayerModule:GetControls()

local SystemsContainer = {}

-- // Module // --
local Module = {}

function Module.EnableMovement()
	Controls:Enable()
end

function Module.DisableMovement()
	Controls:Disable()
end

function Module.CheckMovementEnabled()
	local Items = CollectionService:GetTagged('MOVEMENT_DISABLE')
	local IsDisabled = table.find( Items, LocalPlayer.Character) or table.find( Items, LocalPlayer)
	if IsDisabled then
		Module.DisableMovement()
	else
		Module.EnableMovement()
	end
end

function Module.Start()
	task.defer(Module.CheckMovementEnabled)

	LocalPlayer.CharacterAdded:Connect(Module.CheckMovementEnabled)

	CollectionService:GetInstanceAddedSignal('MOVEMENT_DISABLE'):Connect(function(item)
		if LocalPlayer.Character == item or LocalPlayer == item then
			Module.CheckMovementEnabled()
		end
	end)

	CollectionService:GetInstanceRemovedSignal('MOVEMENT_DISABLE'):Connect(function(item)
		if (LocalPlayer.Character == item) or (LocalPlayer == item) then
			Module.CheckMovementEnabled()
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Gameplay/OverheadCrystal.luau"><![CDATA[local RunService = game:GetService('RunService')
local CollectionService = game:GetService('CollectionService')

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local MaidClassModule = ReplicatedModules.Modules.Maid

local COLLECTION_TAG = 'OVERHEAD_CRYSTAL'
local CharacterInstanceCache = {}

local SystemsContainer = {}

-- // Module // --
local Module = {}

function Module.OnCharacterInstanceAdded( CharacterInstance )
	local Humanoid = CharacterInstance:WaitForChild('Humanoid', 3)
	local Head = CharacterInstance:FindFirstChild('Head')
	if CharacterInstanceCache[ CharacterInstance ] or (not Humanoid) or (not Head) then
		return
	end

	local OverheadDiamond = ReplicatedAssets.Models.Misc.Diamond:Clone()
	OverheadDiamond.Parent = workspace.CurrentCamera

	local MaidInstance = MaidClassModule.New()

	MaidInstance:Give(Humanoid.Died:Connect(function()
		MaidInstance:Cleanup()
	end))

	MaidInstance:Give(Humanoid.Destroying:Connect(function()
		MaidInstance:Cleanup()
	end))

	MaidInstance:Give(RunService.Heartbeat:Connect(function(_)
		local Offset = CFrame.Angles( 0, (time() % 360) * 0.1, 0 )
		local CF = CFrame.new(Head.Position + Vector3.new(0, 1.75, 0)) * Offset
		OverheadDiamond:PivotTo(CF)
	end))

	MaidInstance:Give( OverheadDiamond )

	MaidInstance:Give(function()
		CharacterInstanceCache[ CharacterInstance ] = nil
	end)

	CharacterInstanceCache[ CharacterInstance ] = MaidInstance
end

function Module.OnCharacterInstanceRemoved( CharacterInstance )
	if CharacterInstanceCache[ CharacterInstance ] then
		CharacterInstanceCache[ CharacterInstance ]:Cleanup()
	end
end

function Module.Start()
	for _, CharacterInstance in CollectionService:GetTagged(COLLECTION_TAG) do
		task.defer(Module.OnCharacterInstanceAdded, CharacterInstance)
	end

	CollectionService:GetInstanceAddedSignal(COLLECTION_TAG):Connect(Module.OnCharacterInstanceAdded)
	CollectionService:GetInstanceRemovedSignal(COLLECTION_TAG):Connect(Module.OnCharacterInstanceRemoved)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Gameplay/OverheadInfo.luau"><![CDATA[local CollectionService = game:GetService('CollectionService')
local TweenService = game:GetService('TweenService')

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local MaidClassModule = ReplicatedModules.Modules.Maid

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local SettingsRegistry = LocalModules.Modules.SettingsRegistry
local PALETTE = HUDCommon.PALETTE

local TitlesConfig  = ReplicatedModules.Data.Titles
local TitleRenderer = ReplicatedModules.Utility.TitleRenderer
local CombatUtility = ReplicatedModules.Utility.CombatUtility

local SystemsContainer = {}

-- Per-label active-effect cleanup map. ApplyTitle calls into
-- TitleRenderer which returns a cleanup closure; we stash it here
-- keyed by the label so the next ApplyTitle call (or a label
-- destruction) can run the previous cleanup before re-applying.
-- Without this, gradients + Heartbeat connections leak per re-apply.
local TitleCleanups: { [TextLabel]: (() -> ())? } = {}

local CHARACTER_TAG_NAME = 'OVERHEAD_INFO'
local CharacterInstanceCache = { }
local updateTweenInfo = TweenInfo.new(0.5)

----------------------------------------------------------------------
-- Visibility classification.
--
-- Each tagged character belongs to one of three audiences (the player
-- can hide each independently via SettingsRegistry):
--   * 'own'     — LocalPlayer's own character.
--   * 'other'   — Some other player's character.
--   * 'enemy'   — NPC / world AI character (no associated Player).
--
-- The classification is done once per attach. The .Enabled property of
-- the BillboardGui is then driven by the relevant setting key, both at
-- attach time and via SettingsRegistry.Changed updates (cleaned up
-- through the per-character Maid).
----------------------------------------------------------------------
local function classifyCharacter(characterInstance: Instance): string
	local owner = Players:GetPlayerFromCharacter(characterInstance)
	if owner == LocalPlayer then return 'own' end
	if owner ~= nil then return 'other' end
	return 'enemy'
end

local function settingKeyForKind(kind: string): string
	if kind == 'own'   then return 'OverheadOwnEnabled'   end
	if kind == 'other' then return 'OverheadOthersEnabled' end
	return 'OverheadEnemiesEnabled'
end

local function isVisibleForKind(kind: string): boolean
	return SettingsRegistry[settingKeyForKind(kind)] ~= false
end

-- Reference: hud.jsx Nameplate — accent bar healthy, warn at 40%, danger at 20%.
-- Darker background tone per tier keeps the unfilled portion visible against the bar fill.
local HEALTH_BAR_SEQUENCES = {
	{
		0.4,
		Color3.fromRGB(30, 58, 44),   -- track tone (success)
		PALETTE.success,              -- fill (accent healthy)
	},
	{
		0.2,
		Color3.fromRGB(62, 48, 18),   -- track tone (gold)
		PALETTE.gold,                 -- fill (warning)
	},
	{
		0,
		Color3.fromRGB(70, 22, 28),   -- track tone (danger)
		PALETTE.danger,               -- fill (critical)
	},
}

-- Code-built nameplate. Preserves child paths used by Module.UpdateOverheadInfo
-- and the healthDelta/staminaDelta listeners:
--   Frame.NameLabel, Frame.LevelLabel, Frame.Health.Label,
--   Frame.Health.Bar.UIGradient, Frame.Stamina.Bar.UIGradient.
-- Plus the TitleLabel added above NameLabel:
--   Frame.TitleLabel  (Visible=false until ActiveTitle attribute is set).
--
-- Layout rewrite: BillboardGui is now sized in SCALE (5 × 1.5 studs) so the
-- nameplate shrinks/grows naturally with camera distance instead of being a
-- fixed-pixel overlay. Every inner frame/label uses UDim2.fromScale so the
-- whole plate keeps its proportions at any viewer zoom.
--
-- Vertical band layout (scale Y within the 5:1.5 billboard rect):
--   0.00 – 0.18   TitleLabel         (slim accent strip; hidden when no title)
--   0.20 – 0.42   NameLabel          (big, floats above the UI)
--   0.44 – 0.66   Pill + LevelLabel  (band; HP readout floats right of it)
--   0.70 – 0.80   Health bar
--   0.83 – 0.91   Stamina bar
local function buildNameplate(): BillboardGui
	local billboard = Instance.new('BillboardGui')
	billboard.Name = 'OverheadCharacter'
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	-- Scale size in studs, auto-scales with camera distance. Bumped to
	-- 5×1.5 to make room for the [TITLE] strip above the name without
	-- shrinking the existing bars/labels — extra height all goes into
	-- the new title band at the top.
	billboard.Size = UDim2.fromScale(5, 1.5)
	billboard.MaxDistance = 120

	local root = Instance.new('Frame')
	root.Name = 'Frame'
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.Parent = billboard

	-- TitleLabel — top band. Hidden until SetTitle is called (Visible=false
	-- by default so unowned/no-title characters keep the original look).
	-- TextScaled fills the 18%-height band; the label is monospace + accent
	-- color so it reads as a "tag" distinct from the display name below.
	local titleLabel = Instance.new('TextLabel')
	titleLabel.Name = 'TitleLabel'
	titleLabel.Visible = false
	titleLabel.AnchorPoint = Vector2.new(0.5, 0)
	titleLabel.Position = UDim2.fromScale(0.5, 0)
	titleLabel.Size = UDim2.fromScale(1, 0.18)
	titleLabel.BackgroundTransparency = 1
	titleLabel.FontFace = HUDCommon.FONT_MONO
	titleLabel.TextScaled = true
	titleLabel.TextColor3 = PALETTE.accent
	titleLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
	titleLabel.TextStrokeTransparency = 0.2
	titleLabel.TextXAlignment = Enum.TextXAlignment.Center
	titleLabel.TextYAlignment = Enum.TextYAlignment.Center
	titleLabel.TextTruncate = Enum.TextTruncate.AtEnd
	titleLabel.Text = ''
	titleLabel.Parent = root

	-- NameLabel — ABOVE the UI (top band, below title). TextScaled so it
	-- fills its band at any billboard size.
	local nameLabel = Instance.new('TextLabel')
	nameLabel.Name = 'NameLabel'
	nameLabel.AnchorPoint = Vector2.new(0.5, 0)
	nameLabel.Position = UDim2.fromScale(0.5, 0.20)
	nameLabel.Size = UDim2.fromScale(1, 0.22)
	nameLabel.BackgroundTransparency = 1
	nameLabel.FontFace = HUDCommon.FONT_DISPLAY
	nameLabel.TextScaled = true
	nameLabel.TextColor3 = PALETTE.ink
	nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
	nameLabel.TextStrokeTransparency = 0.2
	nameLabel.TextXAlignment = Enum.TextXAlignment.Center
	nameLabel.TextYAlignment = Enum.TextYAlignment.Center
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	nameLabel.Text = 'Unknown'
	nameLabel.Parent = root

	-- Pill band: translucent backing behind level + HP readout.
	local pill = Instance.new('Frame')
	pill.Name = 'Pill'
	pill.AnchorPoint = Vector2.new(0.5, 0)
	pill.Position = UDim2.fromScale(0.5, 0.44)
	pill.Size = UDim2.fromScale(0.92, 0.22)
	pill.BackgroundColor3 = Color3.new(0, 0, 0)
	pill.BackgroundTransparency = 0.35
	pill.BorderSizePixel = 0
	pill.Parent = root

	local pillStroke = Instance.new('UIStroke')
	pillStroke.Color = PALETTE.accent
	pillStroke.Transparency = 0.5
	pillStroke.Thickness = 1
	pillStroke.Parent = pill

	-- Level chip (left half of pill). Kept under `root` so the canonical
	-- path `Frame.LevelLabel` resolves (external callers depend on it).
	local levelLabel = Instance.new('TextLabel')
	levelLabel.Name = 'LevelLabel'
	levelLabel.AnchorPoint = Vector2.new(0, 0)
	levelLabel.Position = UDim2.fromScale(0.06, 0.46)
	levelLabel.Size = UDim2.fromScale(0.38, 0.18)
	levelLabel.BackgroundTransparency = 1
	levelLabel.FontFace = HUDCommon.FONT_MONO
	levelLabel.TextScaled = true
	levelLabel.TextColor3 = PALETTE.accent
	levelLabel.TextXAlignment = Enum.TextXAlignment.Left
	levelLabel.TextYAlignment = Enum.TextYAlignment.Center
	levelLabel.Text = 'Lvl: ???'
	levelLabel.Parent = root

	-- Health bar track beneath the pill.
	local health = Instance.new('Frame')
	health.Name = 'Health'
	health.AnchorPoint = Vector2.new(0.5, 0)
	health.Position = UDim2.fromScale(0.5, 0.70)
	health.Size = UDim2.fromScale(0.88, 0.10)
	health.BackgroundColor3 = HEALTH_BAR_SEQUENCES[1][2]
	health.BorderSizePixel = 0
	health.Parent = root

	local healthStroke = Instance.new('UIStroke')
	healthStroke.Color = PALETTE.accent
	healthStroke.Transparency = 0.6
	healthStroke.Thickness = 1
	healthStroke.Parent = health

	local healthBar = Instance.new('Frame')
	healthBar.Name = 'Bar'
	healthBar.Size = UDim2.fromScale(1, 1)
	healthBar.BackgroundColor3 = HEALTH_BAR_SEQUENCES[1][3]
	healthBar.BorderSizePixel = 0
	healthBar.Parent = health

	local healthGradient = Instance.new('UIGradient')
	healthGradient.Transparency = NumberSequence.new(0)
	healthGradient.Parent = healthBar

	-- HP readout. Kept parented under `health` so the canonical path
	-- `Frame.Health.Label` still resolves. Positioned in `health`-local
	-- scale space — since the bar frame is 0.10 tall in root-space, moving
	-- the label up ~2.5 bar-heights places it on the pill row above.
	local healthText = Instance.new('TextLabel')
	healthText.Name = 'Label'
	healthText.AnchorPoint = Vector2.new(1, 1)
	healthText.Position = UDim2.fromScale(1, -0.4)
	healthText.Size = UDim2.fromScale(0.55, 2.4)
	healthText.BackgroundTransparency = 1
	healthText.FontFace = HUDCommon.FONT_MONO
	healthText.TextScaled = true
	healthText.TextColor3 = PALETTE.ink
	healthText.TextStrokeTransparency = 0.4
	healthText.TextXAlignment = Enum.TextXAlignment.Right
	healthText.TextYAlignment = Enum.TextYAlignment.Center
	healthText.Text = '0 / 0'
	healthText.Parent = health

	-- Stamina bar: thinner, below health.
	local stamina = Instance.new('Frame')
	stamina.Name = 'Stamina'
	stamina.AnchorPoint = Vector2.new(0.5, 0)
	stamina.Position = UDim2.fromScale(0.5, 0.83)
	stamina.Size = UDim2.fromScale(0.88, 0.06)
	stamina.BackgroundColor3 = Color3.fromRGB(18, 30, 50)
	stamina.BorderSizePixel = 0
	stamina.Parent = root

	local staminaBar = Instance.new('Frame')
	staminaBar.Name = 'Bar'
	staminaBar.Size = UDim2.fromScale(1, 1)
	staminaBar.BackgroundColor3 = PALETTE.accent
	staminaBar.BackgroundTransparency = 0.15
	staminaBar.BorderSizePixel = 0
	staminaBar.Parent = stamina

	local staminaGradient = Instance.new('UIGradient')
	staminaGradient.Transparency = NumberSequence.new(0)
	staminaGradient.Parent = staminaBar

	return billboard
end

local function TweenOverheadOut( OverheadInstance )
	local ti = TweenInfo.new(1, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)

	local connections = {}
	local numberTween = Instance.new('NumberValue')
	numberTween.Value = 1

	local Tween = nil
	for _, Object in OverheadInstance:GetDescendants() do
		if Object:IsA("Frame") then
			Tween = TweenService:Create( Object, ti, { BackgroundTransparency = 1 } )
			Tween:Play()
		elseif Object:IsA("TextLabel") then
			Tween = TweenService:Create( Object, ti, { TextTransparency = 1 } )
			Tween:Play()
		elseif Object:IsA("ImageLabel") then
			Tween = TweenService:Create( Object, ti, { ImageTransparency = 1 } )
			Tween:Play()
		elseif Object:IsA("UIGradient") then
			table.insert(connections, numberTween.Changed:Connect(function()
				Object.Transparency = NumberSequence.new(numberTween.Value)
			end))
		end
	end

	if Tween and Tween.PlaybackState == Enum.PlaybackState.Playing then
		Tween.Completed:Wait()
		numberTween:Destroy()
		for _, item in connections do
			item:Disconnect()
		end
	end
end

-- // Module // --
local Module = {}

function Module.ApplyTitle(OverheadInstance, titleId)
	local titleLabel = OverheadInstance.Frame:FindFirstChild('TitleLabel')
	if not titleLabel then return end

	-- Always run any previous cleanup before re-applying — covers
	-- title swaps mid-session AND clears (titleId == nil/'') so
	-- gradient/effect resources don't survive a clear.
	local prev = TitleCleanups[titleLabel]
	if prev then prev() end
	TitleCleanups[titleLabel] = nil

	if typeof(titleId) ~= 'string' or titleId == '' then
		TitleRenderer.Clear(titleLabel)
		return
	end
	local cfg = TitlesConfig.Titles[titleId]
	if not cfg then
		TitleRenderer.Clear(titleLabel)
		return
	end

	-- Apply via the shared renderer. Returns the cleanup closure that
	-- destroys any UIGradient + disconnects Heartbeat-driven effects.
	-- Stash by label so the next ApplyTitle / clear path picks it up.
	local cleanup = TitleRenderer.Apply(titleLabel, cfg, {
		DefaultColor = PALETTE.accent,
	})
	TitleCleanups[titleLabel] = cleanup
	-- Auto-clear when the label gets destroyed externally (character
	-- despawn). Without this the TitleCleanups table would slowly
	-- accumulate stale entries each respawn — :Once means the connection
	-- is GC'd alongside the instance, no manual disconnect needed.
	titleLabel.Destroying:Once(function()
		local stash = TitleCleanups[titleLabel]
		if stash then stash() end
		TitleCleanups[titleLabel] = nil
	end)
end

function Module.UpdateOverheadInfo( Humanoid, OverheadInstance )
	-- health value
	-- Both sides formatted, not floored. MaxHealth is scaled per floor by
	-- EnemyServer's difficulty multipliers so it is not reliably whole,
	-- and flooring Health made the bar disagree with the damage numbers —
	-- 13.7 off 100 rendered as '86 / 100'.
	OverheadInstance.Frame.Health.Label.Text =
		CombatUtility.FormatCombatNumber(Humanoid.Health)
		.. ' / ' .. CombatUtility.FormatCombatNumber(Humanoid.MaxHealth)

	-- level value
	local Level = Humanoid.Parent:GetAttribute("Level")
	if Level then
		OverheadInstance.Frame.LevelLabel.Text = "Lvl: "..tostring(Level)
	else
		OverheadInstance.Frame.LevelLabel.Text = "???"
	end
end

function Module.OnCharacterInstanceAdded( CharacterInstance )
	local Humanoid = CharacterInstance:WaitForChild('Humanoid', 7) :: Humanoid
	local AdorneePart = CharacterInstance:WaitForChild('HumanoidRootPart', 7) or CharacterInstance.PrimaryPart
	if CharacterInstanceCache[ CharacterInstance ] or (not Humanoid) or (not AdorneePart) then
		return
	end

	print(CharacterInstance:GetFullName(), "OverheadInfo")

	local OverheadClone: BillboardGui = buildNameplate()
	-- Visibility is per-class (own / other player / enemy) and gated
	-- by SettingsRegistry. Initial Enabled reads the live setting; the
	-- Changed listener (set up below) flips it on subsequent toggles.
	local audienceKind = classifyCharacter(CharacterInstance)
	OverheadClone.Enabled = isVisibleForKind(audienceKind)
	OverheadClone.StudsOffset = Vector3.new(0, 5, 0)
	OverheadClone.Adornee = AdorneePart
	OverheadClone.Frame.NameLabel.Text = string.upper(CharacterInstance.Name)
	OverheadClone.Parent = CharacterInstance

	Humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	Humanoid.DisplayName = ""

	local MaidInstance = MaidClassModule.New()

	local healthDeltaValue = Instance.new('NumberValue')
	-- Track the active health tier so the BG/Bar color tween only fires
	-- when the tier ACTUALLY changes (healthy → warn → danger), not on
	-- every Changed frame as the deltaHealth tween animates. Previously
	-- every frame of the 0.5s health tween created two NEW Tween instances
	-- per nameplate — at 5 mobs being damaged that was ~30 frames × 5 ×
	-- 2 = 300 Tween allocations for one swing. The NumberSequence
	-- rebuild for the gradient still runs per frame (unavoidable for the
	-- bar to drain smoothly) but it's a single-instance reassignment.
	local healthHealthBar = OverheadClone.Frame.Health
	local healthBarFill = healthHealthBar.Bar
	local healthBarGradient = healthBarFill.UIGradient
	local activeTierIndex: number? = nil
	MaidInstance:Give(healthDeltaValue.Changed:Connect(function()
		local deltaHealth = math.clamp(healthDeltaValue.Value, 0.001, 0.998)
		-- Pick the matching tier by walking HEALTH_BAR_SEQUENCES (3 entries).
		-- Only re-tween the colors if the tier index changed since the
		-- last fire — avoids the per-frame Tween allocation storm.
		for i, sequenceData in HEALTH_BAR_SEQUENCES do
			if deltaHealth > sequenceData[1] then
				if activeTierIndex ~= i then
					activeTierIndex = i
					TweenService:Create(healthHealthBar, TweenInfo.new(0.5), { BackgroundColor3 = sequenceData[2] }):Play()
					TweenService:Create(healthBarFill, TweenInfo.new(0.5), { BackgroundColor3 = sequenceData[3] }):Play()
				end
				break
			end
		end
		healthBarGradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(deltaHealth, 0),
			NumberSequenceKeypoint.new(deltaHealth + 0.001, 1),
			NumberSequenceKeypoint.new(1, 1),
		})
	end))
	healthDeltaValue.Value = Humanoid.Health / Humanoid.MaxHealth
	MaidInstance:Give(healthDeltaValue)

	local staminaDeltaValue = Instance.new('NumberValue')
	MaidInstance:Give(staminaDeltaValue.Changed:Connect(function()
		local deltaStamina = math.clamp(staminaDeltaValue.Value, 0.01, 0.98)
		OverheadClone.Frame.Stamina.Bar.UIGradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(deltaStamina, 0),
			NumberSequenceKeypoint.new(deltaStamina + 0.01, 1),
			NumberSequenceKeypoint.new(1, 1),
		})
	end))
	staminaDeltaValue.Value = 0.5
	MaidInstance:Give(staminaDeltaValue)

	MaidInstance:Give(Humanoid.Died:Connect(function()
		MaidInstance:Cleanup()
	end))

	MaidInstance:Give(Humanoid.Destroying:Connect(function()
		MaidInstance:Cleanup()
	end))

	MaidInstance:Give(Humanoid.HealthChanged:Connect(function()
		TweenService:Create( healthDeltaValue, updateTweenInfo, { Value = Humanoid.Health / Humanoid.MaxHealth } ):Play()
		Module.UpdateOverheadInfo( Humanoid, OverheadClone )
	end))

	MaidInstance:Give(CharacterInstance:GetAttributeChangedSignal("Level"):Connect(function()
		Module.UpdateOverheadInfo( Humanoid, OverheadClone )
	end))

	-- Active title — server writes this attribute on the character (see
	-- TitlesServer.applyActiveTitleAttribute). Empty string / nil means
	-- "no title" so the row hides. Otherwise we render '[NAME]' in the
	-- title's configured Display.Color.
	local function refreshTitle()
		local titleId = CharacterInstance:GetAttribute('ActiveTitle')
		Module.ApplyTitle(OverheadClone, titleId)
	end
	MaidInstance:Give(CharacterInstance:GetAttributeChangedSignal('ActiveTitle'):Connect(refreshTitle))
	refreshTitle()

	-- Live toggle: when the player flips their nameplate-visibility
	-- setting for THIS audience class, flip the BillboardGui's Enabled.
	-- The Changed signal fires (key, value); we only react when the
	-- key matches our class (or when the bulk-load tick fires with
	-- key=nil, which means "re-read everything"). The connection is
	-- given to the maid so disposed characters don't keep listening.
	local relevantKey = settingKeyForKind(audienceKind)
	MaidInstance:Give(SettingsRegistry.Changed:Connect(function(key, _value)
		if key == nil or key == relevantKey then
			OverheadClone.Enabled = isVisibleForKind(audienceKind)
		end
	end))

	MaidInstance:Give(function()
		TweenOverheadOut( OverheadClone )
		OverheadClone:Destroy()
	end)

	MaidInstance:Give(function()
		CharacterInstanceCache[ CharacterInstance ] = nil
	end)

	CharacterInstanceCache[ CharacterInstance ] = MaidInstance
	Module.UpdateOverheadInfo( Humanoid, OverheadClone )
end

function Module.OnCharacterInstanceRemoved( CharacterInstance )
	if CharacterInstanceCache[ CharacterInstance ] then
		CharacterInstanceCache[ CharacterInstance ]:Cleanup()
	end
end

function Module.Start()
	for _, CharacterInstance in CollectionService:GetTagged(CHARACTER_TAG_NAME) do
		task.defer(Module.OnCharacterInstanceAdded, CharacterInstance)
	end

	CollectionService:GetInstanceAddedSignal(CHARACTER_TAG_NAME):Connect(Module.OnCharacterInstanceAdded)
	CollectionService:GetInstanceRemovedSignal(CHARACTER_TAG_NAME):Connect(Module.OnCharacterInstanceRemoved)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Gameplay/PerfectDodgeClient.luau"><![CDATA[-- Perfect dodge client — VFX + audio response to a server-detected
-- perfect dodge. The server fires CombatEvent with action
-- CombatActions.PerfectDodge; CombatClient's listener routes the call
-- here. We don't trust the client to detect perfect dodge on its own
-- — server is authoritative — so this module is purely visual.
--
-- Effects per perfect dodge (over CombatConfig.COUNTER_WINDOW seconds):
--   1. Time-slow: workspace.Gravity is dropped to GRAVITY_SLOW * normal,
--      then tweened back. Affects the whole world feel for the duration
--      so the player notices the pause.
--   2. Camera shake on the start: brief Humanoid CameraOffset jitter.
--   3. Blue ring expanding from the player at the perfect-dodge moment.
--   4. Optional audio cue (rbxassetid placeholder until designers spec).

local Players = game:GetService('Players')
local TweenService = game:GetService('TweenService')
local Debris = game:GetService('Debris')

local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CombatConfigModule = ReplicatedModules.Data.CombatConfig

-- MicroProfiler scope wrapper. Labels a region for a Studio capture and
-- costs nothing when no capture is running. These used to also emit an
-- os.clock() benchmark `print` per call — on a path that runs for every
-- hit of every swing, that Output flush was itself the lag it was
-- measuring. The scopes stayed; the prints did not.
local function _profileCall(label: string, fn: () -> ...any): ...any
	debug.profilebegin(label)
	local results = table.pack(fn())
	-- Defensive: if `fn` yielded, the engine already popped our scope
	-- and profileend would raise "No active profile annotation".
	pcall(debug.profileend)
	return table.unpack(results, 1, results.n)
end

local Module = {}

-- Multiplier on baseline gravity during the counter window. 0.4 is the
-- value called out in NIER_COMBAT.md; tweak in CombatConfig if it
-- becomes too distracting.
local GRAVITY_SLOW = 0.4

-- Track the in-flight tween so a second perfect dodge during a counter
-- window doesn't double-up gravity tweens (which would race + leave
-- gravity stuck low).
local activeGravityTween: Tween? = nil
local baselineGravity: number? = nil

-- Run the time-slow + restore for the COUNTER_WINDOW. Idempotent: if a
-- previous slow is still active, we extend (cancel old tween → start
-- fresh tween at current gravity → restore at end).
local function runTimeSlow()
	debug.profilebegin('PerfectDodgeClient.runTimeSlow')
	local cfg = CombatConfigModule.CombatConfig
	local window = cfg.COUNTER_WINDOW or 1.5
	if not baselineGravity then
		baselineGravity = workspace.Gravity
	end
	if activeGravityTween then
		activeGravityTween:Cancel()
		activeGravityTween = nil
	end
	-- Drop instantly, restore over `window` seconds. The drop is
	-- immediate so the slow-mo "hits" simultaneously with the player's
	-- on-screen blue ring.
	workspace.Gravity = (baselineGravity or 196.2) * GRAVITY_SLOW
	local restore = TweenService:Create(
		workspace, TweenInfo.new(window, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Gravity = baselineGravity or 196.2 })
	activeGravityTween = restore
	restore:Play()
	restore.Completed:Once(function()
		if activeGravityTween == restore then
			activeGravityTween = nil
		end
	end)
	debug.profileend()
end

-- Camera shake — brief CameraOffset jitter on the local Humanoid.
-- Cleans up by tween-back to zero; never modifies a non-zero baseline
-- (so other systems writing CameraOffset aren't trampled).
local function runCameraShake()
	debug.profilebegin('PerfectDodgeClient.runCameraShake')
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass('Humanoid')
	if not humanoid then
		debug.profileend()
		return
	end
	local original = humanoid.CameraOffset
	-- Three small kicks over 0.18s. Keeps the shake "punchy" without
	-- dragging out.
	for i = 1, 3 do
		task.delay(i * 0.06, function()
			if not humanoid or humanoid.Parent == nil then return end
			humanoid.CameraOffset = original + Vector3.new(
				(math.random() - 0.5) * 0.6,
				(math.random() - 0.5) * 0.4,
				(math.random() - 0.5) * 0.6)
		end)
	end
	task.delay(0.20, function()
		if humanoid and humanoid.Parent then
			TweenService:Create(humanoid, TweenInfo.new(0.15),
				{ CameraOffset = original }):Play()
		end
	end)
	debug.profileend()
end

-- Blue ring at the player's HRP. Expands + fades over RING_DURATION.
local function runBlueRing(character: Instance?)
	debug.profilebegin('PerfectDodgeClient.runBlueRing')
	character = character or LocalPlayer.Character
	if not character then
		debug.profileend()
		return
	end
	local hrp = (character :: any):FindFirstChild('HumanoidRootPart') :: BasePart?
	if not hrp then
		debug.profileend()
		return
	end
	local part = Instance.new('Part')
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.Material = Enum.Material.Neon
	part.Color = Color3.fromRGB(120, 200, 255)
	part.Transparency = 0.2
	part.Size = Vector3.new(2, 0.1, 2)
	part.Shape = Enum.PartType.Cylinder
	part.CFrame = hrp.CFrame * CFrame.Angles(0, 0, math.rad(90))
	part.Parent = workspace

	local tween = TweenService:Create(part,
		TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(0.1, 12, 12), Transparency = 1 })
	tween:Play()
	Debris:AddItem(part, 0.5)
	debug.profileend()
end

-- Public entry point. Called by CombatClient on server-fired
-- PerfectDodge cue. `character` is the local player's character at the
-- moment of the dodge; passed through so the ring renders on the right
-- HRP even if a respawn intervenes.
function Module.OnPerfectDodge(character: Instance?)
	_profileCall('PerfectDodgeClient.OnPerfectDodge', function()
		runTimeSlow()
		runCameraShake()
		runBlueRing(character)
	end)
end

local function spawnSlashArc(aHrp: BasePart, vHrp: BasePart)
	debug.profilebegin('PerfectDodgeClient.spawnSlashArc')
	local part = Instance.new('Part')
	part.Anchored = true; part.CanCollide = false; part.CanTouch = false; part.CanQuery = false
	part.Material = Enum.Material.Neon
	part.Color = Color3.fromRGB(255, 240, 200)
	part.Transparency = 0.3
	part.Size = Vector3.new(0.4, 0.4, (aHrp.Position - vHrp.Position).Magnitude)
	part.CFrame = CFrame.new((aHrp.Position + vHrp.Position) * 0.5,
		vHrp.Position) + Vector3.new(0, 1, 0)
	part.Parent = workspace
	TweenService:Create(part, TweenInfo.new(0.2),
		{ Transparency = 1, Size = part.Size + Vector3.new(0.1, 0.1, 0) }):Play()
	Debris:AddItem(part, 0.25)
	debug.profileend()
end

-- Renders a slash arc per victim from the attacker's HRP. `victims` may
-- be a single Model (legacy) or an array of Models (current server form
-- — one broadcast per swing carries every finisher victim). Only fires
-- when the local player is the attacker.
function Module.OnFinisherHit(attacker: Instance?, victims: any)
	_profileCall('PerfectDodgeClient.OnFinisherHit', function()
		if not attacker or attacker ~= LocalPlayer.Character then return end
		local aHrp = (attacker :: any):FindFirstChild('HumanoidRootPart') :: BasePart?
		if not aHrp then return end
		local list: { Instance }
		if typeof(victims) == 'table' then
			list = victims
		elseif typeof(victims) == 'Instance' then
			list = { victims }
		else
			return
		end
		for _, victim in list do
			local vHrp = (victim :: any):FindFirstChild('HumanoidRootPart') :: BasePart?
			if vHrp then
				spawnSlashArc(aHrp, vHrp)
			end
		end
	end)
end

function Module.Init(_otherSystems) end
function Module.Start() end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Gameplay/SkillsClient.luau"><![CDATA[-- Skills client. Owns:
--   * Input bindings (Z/X/C → first three unlocked skills, in unlock order)
--   * Predict-then-fire CanUseSkill check before sending the remote
--   * Animation playback + VFX/SFX cues for the local rider
--   * Hit-impact VFX cues for ALL clients (FireAllClients pulse)
--
-- Server is authoritative on damage; this module only renders.

local Players = game:GetService('Players')
local ContextActionService = game:GetService('ContextActionService')
local Debris = game:GetService('Debris')
local TweenService = game:GetService('TweenService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local SkillsShared = ReplicatedModules.Services.SkillsShared
local SkillsConfig = ReplicatedModules.Data.Skills
local SoundService = ReplicatedModules.Services.SoundService
local RemoteService = ReplicatedModules.Services.RemoteService
local ReplicatedData = ReplicatedModules.Services.ReplicatedData

local SkillEvent = RemoteService.GetRemote('SkillEvent', 'RemoteEvent', false)

-- Combat profiling instrumentation. Pairs `debug.profilebegin`/
-- `profileend` with an outer-side `os.clock()` benchmark print so
-- elapsed timing matches the MicroProfiler scope. _profileCall
-- handles early returns by routing through a closure.
local function _profileCall(label: string, fn: () -> ...any): ...any
	local t0 = os.clock()
	debug.profilebegin(label)
	local results = table.pack(fn())
	-- Defensive: if `fn` yielded (task.wait, etc.), the engine has already
	-- popped our profile scope, so calling profileend would error with
	-- "No active profile annotation". pcall swallows that — the os.clock
	-- benchmark below survives yields and is the canonical timing here.
	pcall(debug.profileend)
	print(string.format('[Profile][%s] %.3fms', label, (os.clock() - t0) * 1000))
	return table.unpack(results, 1, results.n)
end

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Active anim tracks per cast, keyed by character (Model). Player
-- characters AND NPC characters route through the same map — the
-- renderer doesn't care which kind of caster it is, just that there
-- is a character with a Humanoid + HRP to attach the cast to.
----------------------------------------------------------------------
local ActiveTracks: { [Model]: AnimationTrack? } = {}

local function loadAnimation(humanoid: Humanoid, assetId: string?): AnimationTrack?
	if not humanoid or typeof(assetId) ~= 'string' or assetId == '' or assetId == 'rbxassetid://0' then
		return nil
	end
	local animator = humanoid:FindFirstChildOfClass('Animator')
		or humanoid:WaitForChild('Animator', 1)
	if not animator then return nil end
	local anim = Instance.new('Animation')
	anim.AnimationId = assetId
	local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
	anim:Destroy()
	return ok and track or nil
end

local function playSFX(entry: any?, position: Vector3?)
	if not entry or not entry.Sound then return end
	local pos = position or workspace.CurrentCamera.CFrame.Position
	SoundService.PlaySoundAtPosition(entry.Sound, pos)
end

----------------------------------------------------------------------
-- Render: cast begin. Plays the cast animation + a placeholder slash
-- arc trail (a thin Neon ring that fades out), and the cast SFX.
-- Caster is a Model (player character or NPC character) — the cue
-- carries the character directly so the renderer is caster-agnostic.
----------------------------------------------------------------------
local function renderCastBegin(character: Model, skillId: string, totalDuration: number)
	return _profileCall('SkillsClient.renderCastBegin', function()
	local cfg = SkillsConfig.Skills[skillId]
	if not cfg then return end
	if not character or not character.Parent then return end
	local humanoid = character:FindFirstChildOfClass('Humanoid')
	local hrp = character:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not humanoid or not hrp then return end

	-- Animation.
	local track = loadAnimation(humanoid, cfg.Animations and cfg.Animations.Cast)
	if track then
		track:Play(0.05, 1, 1)
		ActiveTracks[character] = track
		task.delay(totalDuration + 0.1, function()
			if ActiveTracks[character] == track then
				track:Stop(0.1); ActiveTracks[character] = nil
			end
		end)
	else
		print(string.format('[SkillsClient] (stub anim) %s casting %s for %.2fs',
			character.Name, skillId, totalDuration))
	end

	-- Cast SFX.
	playSFX(cfg.SFX and cfg.SFX.Cast, hrp.Position)

	-- Placeholder slash arc — a thin Neon disc in front of the character
	-- that fades out over the active window. Real VFX templates drop in
	-- via cfg.VFX.Slash later (look up under AssetsShared.VFX.Skills).
	local arc = Instance.new('Part')
	arc.Name = 'SkillArcStub'
	arc.Anchored = true
	arc.CanCollide = false
	arc.CanTouch = false
	arc.CastShadow = false
	arc.Shape = Enum.PartType.Cylinder
	arc.Material = Enum.Material.Neon
	arc.Color = Color3.fromRGB(255, 240, 200)
	arc.Size = Vector3.new(0.2, cfg.Hitbox.Size.X, cfg.Hitbox.Size.Z)
	arc.CFrame = hrp.CFrame
		* CFrame.new(0, 0, -cfg.Hitbox.ForwardOffset)
		* CFrame.Angles(0, 0, math.rad(90))
	arc.Transparency = 0.4
	arc.Parent = workspace.Terrain

	TweenService:Create(arc,
		TweenInfo.new(cfg.ActiveTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Transparency = 1, Size = arc.Size + Vector3.new(0, 2, 2) }
	):Play()
	Debris:AddItem(arc, cfg.ActiveTime + 0.2)
	end)
end

local function renderCastHit(_character: Model, skillId: string, _hitIndex: number, hitPositions: { Vector3 })
	return _profileCall('SkillsClient.renderCastHit', function()
	local cfg = SkillsConfig.Skills[skillId]
	if not cfg then return end
	-- One impact flash per hit position. Tiny spherical glow.
	for _, pos in hitPositions do
		local impact = Instance.new('Part')
		impact.Anchored = true; impact.CanCollide = false; impact.CanTouch = false
		impact.CastShadow = false; impact.Shape = Enum.PartType.Ball
		impact.Material = Enum.Material.Neon
		impact.Color = Color3.fromRGB(255, 220, 130)
		impact.Size = Vector3.new(0.5, 0.5, 0.5)
		impact.Position = pos
		impact.Transparency = 0.2
		impact.Parent = workspace.Terrain
		TweenService:Create(impact,
			TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Transparency = 1, Size = Vector3.new(2.5, 2.5, 2.5) }
		):Play()
		Debris:AddItem(impact, 0.4)
	end
	playSFX(cfg.SFX and cfg.SFX.Hit, hitPositions[1])
	end)
end

local function renderCastEnd(character: Model, _skillId: string)
	return _profileCall('SkillsClient.renderCastEnd', function()
		local track = ActiveTracks[character]
		if track then track:Stop(0.15); ActiveTracks[character] = nil end
	end)
end

----------------------------------------------------------------------
-- Resolve the local player's first three unlocked skills for Z/X/C.
-- Order is the SkillsConfig order (great_slash → double_cross_slash →
-- quad_cross_slash) so the binding feels stable as the player progresses.
----------------------------------------------------------------------
local function getBoundSkillIds(): { string }
	local data = ReplicatedData.GetData('PlayerData', false)
	local out = {}
	-- Walk in canonical order so Z is always the most-basic unlocked
	-- skill, X the second, C the third.
	local order = { 'great_slash', 'double_cross_slash', 'quad_cross_slash' }
	for _, id in order do
		if SkillsShared.IsSkillUnlocked(data, id) then
			table.insert(out, id)
			if #out >= 3 then break end
		end
	end
	return out
end

----------------------------------------------------------------------
-- Public API used by the hotbar / skill tree.
----------------------------------------------------------------------
function Module.AttemptUseSkill(skillId: string)
	_profileCall('SkillsClient.AttemptUseSkill', function()
		local character = LocalPlayer.Character
		if not character then return end
		local data = ReplicatedData.GetData('PlayerData', false)
		local ok, reason = SkillsShared.CanUseSkill(character, data, skillId)
		if not ok then
			print('[SkillsClient] Cannot use:', skillId, '-', reason)
			return
		end
		local _t_send = os.clock()
		debug.profilebegin('SkillsClient.AttemptUseSkill.FireServer')
		SkillEvent:FireServer(SkillsShared.SkillActions.TryUseSkill, skillId)
		debug.profileend()
		print(string.format('[Profile][%s] %.3fms', 'SkillsClient.AttemptUseSkill.FireServer', (os.clock() - _t_send) * 1000))
	end)
end

function Module.GetBoundSkills(): { string }
	return getBoundSkillIds()
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	-- Bind Z/X/C to slot 1/2/3 of the player's unlocked-skills list.
	-- Slot lookup is dynamic so unlocking a new skill from the tree
	-- updates the bindings on next press without re-binding.
	local function handleSkillSlot(slotIndex: number)
		return function(_actionName, state, _input)
			if state ~= Enum.UserInputState.Begin then
				return Enum.ContextActionResult.Pass
			end
			local skills = getBoundSkillIds()
			local id = skills[slotIndex]
			if id then Module.AttemptUseSkill(id) end
			return Enum.ContextActionResult.Sink
		end
	end
	ContextActionService:BindAction('SkillsClient_Slot1', handleSkillSlot(1), false, Enum.KeyCode.Z)
	ContextActionService:BindAction('SkillsClient_Slot2', handleSkillSlot(2), false, Enum.KeyCode.X)
	ContextActionService:BindAction('SkillsClient_Slot3', handleSkillSlot(3), false, Enum.KeyCode.C)

	SkillEvent.OnClientEvent:Connect(function(action, ...)
		local _t_evt = os.clock()
		debug.profilebegin('SkillsClient.OnClientEvent')
		if action == SkillsShared.SkillActions.CastBegin then
			renderCastBegin(...)
		elseif action == SkillsShared.SkillActions.CastHit then
			renderCastHit(...)
		elseif action == SkillsShared.SkillActions.CastEnd then
			renderCastEnd(...)
		end
		debug.profileend()
		print(string.format('[Profile][%s] %.3fms', 'SkillsClient.OnClientEvent', (os.clock() - _t_evt) * 1000))
	end)

	-- Reap stale entries when characters get destroyed (player respawn,
	-- NPC death). The track itself disconnects when its parent goes
	-- away, but the table key would otherwise leak.
	Players.PlayerRemoving:Connect(function(player)
		local char = player.Character
		if char then ActiveTracks[char] = nil end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Gameplay/TargetLockClient.luau"><![CDATA[-- Target lock client. Hover an enemy + press R → set lock; R again
-- to clear. While locked, a small circle BillboardGui floats above
-- the target so the player can see who they're locked onto.
--
-- Server integration is deliberately deferred — this module exposes
-- `Module.GetLockedTarget()` so combat / dodge / camera systems can
-- query the locked target later, but doesn't yet drive any of them
-- on its own. The visible indicator + Get accessor is the v1 surface.

local Players = game:GetService('Players')
local UserInputService = game:GetService('UserInputService')
local CollectionService = game:GetService('CollectionService')
local RunService = game:GetService('RunService')

local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local CombatShared = ReplicatedModules.Services.CombatShared

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE = HUDCommon.PALETTE

local SystemsContainer = {}

local Module = {}

-- Currently-locked target (Model) or nil. Mutated by Toggle / clear.
local LockedTarget: Model? = nil
-- Cached AutoRotate state from BEFORE the lock engaged so we can
-- restore on clear. Roblox flips AutoRotate to true on respawn, so
-- this is read fresh per lock — never stale across deaths.
local PriorAutoRotate: boolean? = nil

-- Resolve CameraModeClient lazily so it can be loaded by the same
-- framework pass without requiring strict load order. SystemsContainer
-- is filled in via Module.Init.
local function getCameraModeClient()
	return SystemsContainer.CameraModeClient
		or (SystemsContainer.ParentSystems
			and SystemsContainer.ParentSystems.Gameplay
			and SystemsContainer.ParentSystems.Gameplay.CameraModeClient)
end
-- BillboardGui rendering the circle indicator. Re-parented to the
-- target when LockedTarget changes; destroyed on clear.
local LockGui: BillboardGui? = nil
-- Connections that auto-clear the lock when the target dies, leaves
-- workspace, or is destroyed. Walked + disconnected in clearLock so
-- a swap-lock (R on a different mob without first unlocking) doesn't
-- leak the previous target's listeners.
local TargetWatchConns: { RBXScriptConnection } = {}
local function disconnectTargetWatch()
	for _, conn in TargetWatchConns do
		conn:Disconnect()
	end
	table.clear(TargetWatchConns)
end

local LOCK_RAYCAST_MAX_DISTANCE = 120  -- studs from camera to target
-- Spherecast radius for the cursor pick. The previous raycast required
-- the cursor to land on a pixel of the enemy's mesh — even small enemies
-- or fast-moving targets would slip through. A 4-stud sphere catches
-- "I'm aiming roughly at them" without needing a pixel-perfect hover.
local LOCK_SHAPECAST_RADIUS = 4
-- Screen-space fallback radius (pixels). When the spherecast misses
-- entirely (target outside the swept volume but still on screen near
-- the crosshair), we project every AICharacter HRP to viewport space
-- and pick the candidate closest to the cursor within this radius.
-- 220 px is generous — about 12% of a 1920-wide viewport.
local LOCK_SCREEN_FALLBACK_RADIUS = 220

----------------------------------------------------------------------
-- Camera lock-on tunables. The camera holds a fixed offset behind
-- the player while continuously orienting toward the midpoint of the
-- (player → target) segment with a downward bias. Lerp keeps the
-- transition smooth; the player can briefly fight it via mouse but
-- cant fully escape until they unlock — Nier / Sekiro hard-lock feel.
----------------------------------------------------------------------
local CAMERA_DISTANCE     = 14      -- studs behind the player
local CAMERA_HEIGHT       = 5       -- studs above the player's HRP
local CAMERA_PITCH_DEG    = -8      -- looking down toward midpoint
local CAMERA_LERP_RATE    = 14      -- per-second smoothing rate (higher = snappier)
local CAMERA_TARGET_BIAS  = 0.5     -- 0=look at player, 1=look at target

-- RenderStepped connection driving the lock camera. Active only while
-- a target is locked; disconnected on clear so the default camera
-- regains control.
local CameraConn: RBXScriptConnection? = nil
-- The CameraType we replace on lock so we can restore on unlock.
-- Roblox's default is `Custom` — record per-lock in case the player
-- has changed it via a setting we don't own.
local PriorCameraType: Enum.CameraType? = nil
-- Render priority slot. Bind one above Camera so our override runs
-- AFTER the default camera writes its CFrame, ensuring our value is
-- the final word on the frame.
local CAMERA_RENDER_PRIORITY = Enum.RenderPriority.Camera.Value + 1
local CAMERA_RENDER_NAME = 'TargetLockCamera'

-- Build the BillboardGui indicator once. Returned object is parented
-- to the target HRP whenever a lock is set; reused so we don't spam-
-- create instances.
local function ensureLockGui(): BillboardGui
	if LockGui and LockGui.Parent then return LockGui end
	if LockGui then LockGui:Destroy() end
	local gui = Instance.new('BillboardGui')
	gui.Name = 'TargetLockIndicator'
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Size = UDim2.fromScale(2, 2)  -- 2x2 studs
	gui.MaxDistance = LOCK_RAYCAST_MAX_DISTANCE
	gui.StudsOffset = Vector3.new(0, 3, 0)  -- float above the head

	-- Outer ring: a circular Frame via UICorner(1, 0). Stroke gives the
	-- glowing edge; transparent fill so the player sees through to the
	-- target. ZIndex bumped so it paints over health bars below.
	local ring = Instance.new('Frame')
	ring.Name = 'Ring'
	ring.Size = UDim2.fromScale(1, 1)
	ring.BackgroundColor3 = PALETTE.accent
	ring.BackgroundTransparency = 0.85
	ring.BorderSizePixel = 0
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.Position = UDim2.fromScale(0.5, 0.5)
	ring.Parent = gui

	local corner = Instance.new('UICorner')
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = ring

	local stroke = Instance.new('UIStroke')
	stroke.Color = PALETTE.accent
	stroke.Thickness = 2
	stroke.Transparency = 0.1
	stroke.Parent = ring

	-- Crosshair dot in the center.
	local dot = Instance.new('Frame')
	dot.Size = UDim2.fromScale(0.18, 0.18)
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.fromScale(0.5, 0.5)
	dot.BackgroundColor3 = PALETTE.accent
	dot.BorderSizePixel = 0
	local dotCorner = Instance.new('UICorner')
	dotCorner.CornerRadius = UDim.new(1, 0)
	dotCorner.Parent = dot
	dot.Parent = ring

	LockGui = gui
	return gui
end

-- Is `model` a lock-eligible mob? Mobs only — PvP lock-on is
-- intentionally excluded. Centralized so every target-resolution
-- path (shapecast, ancestor walk, screen-space fallback) shares
-- the same eligibility contract.
--
-- The descendant-of-workspace check rejects targets that are still
-- referenced but parented to nil / a streaming-out folder; pairs
-- with the AncestryChanged auto-unlock in setLock so a despawn
-- mid-lock both stops the lock AND prevents re-acquisition during
-- the same toggle press.
local function isEligibleLockTarget(model: Model): boolean
	if not model or not model.Parent then return false end
	if not model:IsDescendantOf(workspace) then return false end
	if LocalPlayer.Character and model == LocalPlayer.Character then return false end
	return CollectionService:HasTag(model, 'AICharacter')
end

-- Resolve the lock-eligible Model that owns `hit` (an arbitrary part
-- the shapecast struck). Walks ancestors until it finds an eligible
-- Model or runs out of parents. The local player's character is
-- excluded by the cast filter so it never reaches this resolver.
local function resolveLockTargetFromHit(hit: Instance?): Model?
	local inst: Instance? = hit
	while inst and inst ~= workspace do
		if inst:IsA('Model') and isEligibleLockTarget(inst) then
			return inst
		end
		inst = inst.Parent
	end
	return nil
end

-- Read the player's current cursor target. Iteratively re-casts past
-- "skip" parts (named Hitbox or tagged Hitbox) so the lock-on doesn't
-- snap onto invisible combat hitboxes that float around or overlap
-- characters. Each iteration appends the hit part to the exclude list
-- and re-casts; bails after MAX_RECAST_DEPTH to avoid runaway loops.
local MAX_RECAST_DEPTH = 8
local function isSkipPart(inst: Instance?): boolean
	if not inst or not inst:IsA('BasePart') then return false end
	if inst.Name == 'Hitbox' then return true end
	if CollectionService:HasTag(inst, 'Hitbox') then return true end
	return false
end

-- Screen-space candidate scan. Walks every AICharacter-tagged model
-- and picks the one whose HRP, when projected to the viewport, sits
-- closest to the cursor — provided it's within
-- LOCK_SCREEN_FALLBACK_RADIUS pixels and on-screen. This is the
-- "I'm pointing roughly at them" fallback for when the spherecast
-- misses (e.g. camera is offset to the side, or the target is
-- partly occluded so the swept volume hits the obstruction first).
-- Mobs only — PvP characters are intentionally excluded by the
-- isEligibleLockTarget filter.
local function findClosestScreenCandidate(camera: Camera, mouse: Vector2): Model?
	local origin = camera.CFrame.Position
	local best: Model? = nil
	local bestDist = LOCK_SCREEN_FALLBACK_RADIUS

	-- The set is small in practice (one zone of mobs at a time), so a
	-- linear scan is fine — <1ms even at 100 candidates.
	for _, model in CollectionService:GetTagged('AICharacter') do
		if not model:IsA('Model') then continue end
		if not isEligibleLockTarget(model) then continue end
		local hrp = model:FindFirstChild('HumanoidRootPart') :: BasePart?
		if not hrp then continue end
		if (hrp.Position - origin).Magnitude > LOCK_RAYCAST_MAX_DISTANCE then continue end
		-- WorldToViewportPoint returns (Vector3 screen-coords, onScreen).
		-- The Z component of the screen vector is the depth; <= 0 means
		-- behind the camera, skip those.
		local screen, onScreen = camera:WorldToViewportPoint(hrp.Position)
		if not onScreen or screen.Z <= 0 then continue end
		local dx = screen.X - mouse.X
		local dy = screen.Y - mouse.Y
		local dist = math.sqrt(dx * dx + dy * dy)
		if dist < bestDist then
			best = model
			bestDist = dist
		end
	end
	return best
end

local function getCursorTarget(): Model?
	local mouse = UserInputService:GetMouseLocation()
	local camera = workspace.CurrentCamera
	if not camera then return nil end
	local ray = camera:ScreenPointToRay(mouse.X, mouse.Y, 1)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	-- Always exclude the local player's character; we'll grow this
	-- list with skip-parts as we re-cast past hitboxes.
	local excludes: { Instance } = { LocalPlayer.Character or Instance.new('Folder') }
	params.FilterDescendantsInstances = excludes

	-- Pass 1 — Spherecast along the cursor ray. The 4-stud radius
	-- swept volume catches small / lateral targets that a pixel-
	-- perfect ray would miss. We re-cast past skip-parts (named or
	-- tagged 'Hitbox') the same way the old raycast did.
	for _ = 1, MAX_RECAST_DEPTH do
		local result = workspace:Spherecast(ray.Origin, LOCK_SHAPECAST_RADIUS,
			ray.Direction * LOCK_RAYCAST_MAX_DISTANCE, params)
		if not result then break end
		local hit = result.Instance

		-- Skip parts: re-cast past them. Mutating the excludes table
		-- in place isn't enough — RaycastParams snapshots the list at
		-- assignment, so reassign each iteration.
		if isSkipPart(hit) then
			table.insert(excludes, hit)
			params.FilterDescendantsInstances = excludes
			continue
		end

		local target = resolveLockTargetFromHit(hit)
		if target then return target end
		-- Hit a non-eligible, non-skip part (a wall, a prop). Stop the
		-- recast loop and fall through to the screen-space fallback —
		-- a wall between cursor + enemy is still a lock-on candidate
		-- in the "aim roughly" model (Souls / Sekiro behavior).
		break
	end

	-- Pass 2 — screen-space fallback. Picks the closest on-screen
	-- candidate to the cursor when the swept ray didn't directly land
	-- on an eligible model.
	return findClosestScreenCandidate(camera, mouse)
end

----------------------------------------------------------------------
-- Camera tracking. Bind via RunService:BindToRenderStep so the
-- override runs at a deterministic priority slot relative to the
-- default camera scripts (which use the same priority bus).
----------------------------------------------------------------------
local function cameraStep(dt: number)
	local target = LockedTarget
	if not target or not target.Parent then return end
	local character = LocalPlayer.Character
	if not character then return end
	local hrp = character:FindFirstChild('HumanoidRootPart') :: BasePart?
	local tHrp = target:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not hrp or not tHrp then return end
	local camera = workspace.CurrentCamera
	if not camera then return end

	-- Vector from player to target (XZ flat). Camera sits OPPOSITE the
	-- target relative to the player: `desiredPos = playerPos - dir * dist`
	-- so the player is between camera and target, mid-frame.
	local dir = tHrp.Position - hrp.Position
	dir = Vector3.new(dir.X, 0, dir.Z)
	if dir.Magnitude < 0.5 then return end
	local fwd = dir.Unit

	local desiredPos = hrp.Position - fwd * CAMERA_DISTANCE + Vector3.new(0, CAMERA_HEIGHT, 0)
	-- Look-at point is biased between player and target so the player
	-- stays centered while the target frames into view.
	local lookPoint = hrp.Position:Lerp(tHrp.Position, CAMERA_TARGET_BIAS)
		+ Vector3.new(0, 1.5, 0)

	local desiredCF = CFrame.lookAt(desiredPos, lookPoint)
		* CFrame.Angles(math.rad(CAMERA_PITCH_DEG), 0, 0)

	-- Frame-rate-independent lerp. alpha = 1 - exp(-rate * dt) makes
	-- the smoothing the same wall-clock duration regardless of
	-- whether we're at 60fps or 120fps.
	local alpha = 1 - math.exp(-CAMERA_LERP_RATE * dt)
	camera.CFrame = camera.CFrame:Lerp(desiredCF, alpha)

	-- Continuous character rotation toward the target. AutoRotate=false
	-- (set in startCameraTracking) prevents Humanoid's MoveDirection
	-- pass from spinning the character on every WASD press. Movement
	-- stays camera-relative because Roblox PlayerModule computes
	-- WASD world-direction from the camera's basis regardless of the
	-- character's facing — so the player can press W to move toward
	-- the camera-forward (= toward target), strafe with A/D around
	-- the target, and the character visually follows.
	--
	-- Suppressed during hard crowd control. While the server owns this
	-- character's physics — launched, slammed, knocked down, dragged —
	-- writing HRP.CFrame every frame fights the server's motion
	-- constraint and the character visibly stutters mid-air. The lock
	-- resumes the instant the CC clears.
	if CombatShared.IsCharacterHardCrowdControlled(character) then return end
	hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + fwd)
end

local function startCameraTracking()
	if CameraConn then return end
	local camera = workspace.CurrentCamera
	if not camera then return end
	-- Switch to Scriptable so the default camera scripts release
	-- their CFrame writes; restore on unlock. Recording the prior
	-- type lets us cooperate with mounts / cinematic overrides that
	-- already changed CameraType.
	PriorCameraType = camera.CameraType
	camera.CameraType = Enum.CameraType.Scriptable

	-- Disable Humanoid.AutoRotate while locked so Roblox's MoveDirection
	-- rotation pass doesn't fight our per-frame "face the target" set
	-- on hrp.CFrame. Cache the prior value so a player who toggled
	-- AutoRotate elsewhere (e.g. mount system) gets it back on unlock.
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass('Humanoid')
	if humanoid then
		PriorAutoRotate = humanoid.AutoRotate
		humanoid.AutoRotate = false
	end

	-- Force-release shift-lock and prevent re-entry while target-locked.
	-- The CameraModeClient external-lock guard restores the player's
	-- prior shift-lock mode on unlock.
	local CameraModeClient = getCameraModeClient()
	if CameraModeClient and CameraModeClient.SetExternalLock then
		CameraModeClient.SetExternalLock(true)
	end

	-- BindToRenderStep instead of RenderStepped:Connect so we get a
	-- specific priority slot — runs AFTER the default camera (which
	-- itself binds at `Camera` priority) so any leftover writes from
	-- siblings that DIDN'T release control are overridden.
	RunService:BindToRenderStep(CAMERA_RENDER_NAME, CAMERA_RENDER_PRIORITY, cameraStep)
end

local function stopCameraTracking()
	if CameraConn then CameraConn:Disconnect(); CameraConn = nil end
	pcall(function() RunService:UnbindFromRenderStep(CAMERA_RENDER_NAME) end)
	-- Restore camera type. Falling back to Custom keeps the default
	-- camera scripts happy if the prior value was somehow nil.
	local camera = workspace.CurrentCamera
	if camera then
		camera.CameraType = PriorCameraType or Enum.CameraType.Custom
	end
	PriorCameraType = nil

	-- Restore Humanoid.AutoRotate. Default to true when the prior
	-- value is missing (lock engaged before character spawned, etc.)
	-- — the standard Roblox state.
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass('Humanoid')
	if humanoid then
		humanoid.AutoRotate = (PriorAutoRotate ~= false)
	end
	PriorAutoRotate = nil

	-- Release the CameraModeClient external lock so Shift cycling
	-- works again. CameraModeClient restores the prior shift-lock
	-- mode internally.
	local CameraModeClient = getCameraModeClient()
	if CameraModeClient and CameraModeClient.SetExternalLock then
		CameraModeClient.SetExternalLock(false)
	end
end

local function clearLock()
	LockedTarget = nil
	if LockGui then LockGui.Parent = nil end
	disconnectTargetWatch()
	stopCameraTracking()
end

local function setLock(target: Model)
	LockedTarget = target
	local hrp = target:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not hrp then clearLock(); return end
	local gui = ensureLockGui()
	gui.Adornee = hrp
	gui.Parent = hrp
	-- Drop any previous target's listeners before binding to this one,
	-- so a swap-lock doesn't leave a dead Died listener stuck around.
	disconnectTargetWatch()
	local function clearIfStillLocked()
		if LockedTarget == target then clearLock() end
	end
	-- Death → unlock. Standard Souls/Sekiro behavior.
	local humanoid = target:FindFirstChildOfClass('Humanoid')
	if humanoid then
		table.insert(TargetWatchConns, humanoid.Died:Connect(clearIfStillLocked))
	end
	-- Workspace eviction → unlock. AncestryChanged fires whenever the
	-- model's parent chain changes; we only care about the case where
	-- the target is no longer a descendant of workspace (despawn, mob
	-- streaming-out, server-initiated reparent). Without this listener
	-- a despawned target would freeze the camera lock until the player
	-- manually pressed R again.
	table.insert(TargetWatchConns, target.AncestryChanged:Connect(function()
		if not target:IsDescendantOf(workspace) then
			clearIfStillLocked()
		end
	end))
	-- Destroying → unlock. AncestryChanged fires before Destroy
	-- finalizes; this is a belt-and-suspenders catch for instances
	-- that go straight to Destroy without an intermediate parent flip.
	table.insert(TargetWatchConns, target.Destroying:Connect(clearIfStillLocked))
	-- Start the camera lock-on track. Idempotent — if the player
	-- swap-locks (R-on-different-target without unlocking first), the
	-- existing track stays active; only the LockedTarget pointer
	-- changes and the next cameraStep frame uses the new target.
	startCameraTracking()
end

----------------------------------------------------------------------
-- Public API.
----------------------------------------------------------------------

-- Returns the currently-locked target Model, or nil. Combat / camera
-- code can call this to bias targeting; for v1 nothing else does.
function Module.GetLockedTarget(): Model?
	if LockedTarget and LockedTarget.Parent then return LockedTarget end
	if LockedTarget then clearLock() end  -- target was destroyed / unparented
	return nil
end

-- Toggle: set the cursor target as locked, OR clear if it's already
-- the locked target, OR swap to a different cursor target. Bound to
-- the R key in Module.Start.
function Module.Toggle()
	local cursorTarget = getCursorTarget()
	if not cursorTarget then
		-- Empty cursor → if we already have a lock, clear it. R-to-
		-- unlock with cursor in empty space is a common UX in lock-on
		-- combat games (Sekiro, ER, MH).
		if LockedTarget then clearLock() end
		return
	end
	if LockedTarget == cursorTarget then
		clearLock()
	else
		setLock(cursorTarget)
	end
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------

function Module.Start()
	-- R-key toggle. Routed via UserInputService.InputBegan rather than
	-- ContextActionService so it doesn't compete with combat / camera
	-- bindings for sink priority.
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		if input.KeyCode == Enum.KeyCode.R then
			Module.Toggle()
		end
	end)

	-- Auto-clear lock on local-player respawn/death so the Scriptable
	-- camera doesn't stay sticky after a death — without this, the
	-- camera type stays Scriptable but cameraStep early-returns when
	-- the new character has no HRP yet, freezing the camera in place.
	local function bindCharacter(character: Model)
		local humanoid = character:FindFirstChildOfClass('Humanoid')
			or character:WaitForChild('Humanoid', 5)
		if not humanoid then return end
		humanoid.Died:Once(function() clearLock() end)
	end
	if LocalPlayer.Character then bindCharacter(LocalPlayer.Character) end
	LocalPlayer.CharacterAdded:Connect(function(character)
		-- New character → ensure any leftover lock is cleared so the
		-- camera type is restored before the next bind.
		clearLock()
		bindCharacter(character)
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Gameplay/WaypointsClient.luau"><![CDATA[-- WaypointsClient — world-space 3D waypoint markers.
--
-- Two categories:
--   * 'workstation' → tagged via CollectionService 'Workstation';
--                     kind read from WorkstationKind attribute.
--   * 'waystone'    → tagged via CollectionService 'Waystones';
--                     visibility gated by PlayerData.Waystones (only
--                     unlocked waystones get a marker).
--
-- Settings:
--   SettingsRegistry.WaypointsWorkstationsEnabled  → workstation markers visible
--   SettingsRegistry.WaypointsWaystonesEnabled     → unlocked-waystone markers visible
--
-- Each marker is a BillboardGui parented under a per-player Folder in
-- LocalPlayer.PlayerGui (so other players don't see this player's
-- markers). The BillboardGui's Adornee tracks the live model so the
-- marker follows the world part if it's ever moved.
--
-- Lifecycle:
--   * On Start: walk currently-tagged instances + listen for additions.
--   * On Setting changed: flip the .Enabled bool on every marker in
--     the affected category.
--   * On PlayerData replicated: refresh waystone markers (newly
--     unlocked → spawn; revoked → despawn).
--   * On Player removing or model removed: drop the BillboardGui.

local CollectionService = game:GetService('CollectionService')
local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local WaypointsData     = ReplicatedModules.Data.Waypoints
local WaystonesData     = ReplicatedModules.Data.Waystones
local SubstationsData   = ReplicatedModules.Data.Substations
local ReplicatedData    = ReplicatedModules.Services.ReplicatedData
local RemoteService     = ReplicatedModules.Services.RemoteService
-- WaystonesEvent fires on each fresh server-side unlock. Listening to
-- it (in addition to PlayerData replication) gives a tighter "marker
-- appears the moment the waystone is unlocked" feel without polling.
local WaystonesEvent = RemoteService.GetRemote('WaystonesEvent', 'RemoteEvent', false)

local LocalPlayerScripts = LocalPlayer:WaitForChild('PlayerScripts')
local LocalModules = require(LocalPlayerScripts:WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local SettingsRegistry = LocalModules.Modules.SettingsRegistry

local SystemsContainer = {}

local Module = {}

----------------------------------------------------------------------
-- Marker registry. Keyed by the world Model so add/remove signals can
-- reach the right BillboardGui in O(1).
----------------------------------------------------------------------
type Marker = {
	Category: string,         -- 'workstation' | 'waystone' | 'substation'
	WaystoneId: string?,      -- only for 'waystone' markers; matches save lookup
	Gui: BillboardGui,
	-- Attachment we created under the host part to anchor the
	-- BillboardGui at the model's pivot center. We own this instance,
	-- so despawnMarker is responsible for destroying it (otherwise
	-- orphaned attachments would accumulate in the world).
	Attachment: Attachment?,
}
local Markers: { [Instance]: Marker } = {}
local MarkerFolder: Folder? = nil

----------------------------------------------------------------------
-- Resolve the host BasePart for an Attachment. Attachments must
-- parent under a BasePart (Workspace itself rejects them), so we
-- pick the model's PrimaryPart, falling back to the first BasePart
-- descendant. Models with no BaseParts at all (decals only / lights)
-- can't anchor a marker — return nil.
----------------------------------------------------------------------
local function hostPartOf(model: Instance): BasePart?
	if model:IsA('BasePart') then return model end
	if model:IsA('Model') then
		if model.PrimaryPart then return model.PrimaryPart end
		for _, d in model:GetDescendants() do
			if d:IsA('BasePart') then return d end
		end
	end
	return nil
end

----------------------------------------------------------------------
-- Pivot-anchored attachment. Creates (or reuses) an Attachment under
-- `host`, with its WorldPosition pinned to the model's pivot. Using
-- an Attachment as the BillboardGui Adornee lets us point at the
-- model's TRUE center even when the host BasePart sits off-center
-- (waystone base plates, low workstation slabs, etc.) — without the
-- StudsOffset gymnastics the old code did.
--
-- Two callers + two semantics:
--   * Workstations float `floatY` studs above the pivot so the icon
--     reads above the model rather than over its center mass.
--   * Waystones anchor exactly at the pivot (floatY = 0) so the
--     stud-scaled marker frames the structure.
--
-- We re-use any existing Attachment named `WaypointAnchor` on the
-- host (re-tagging mid-session won't double-create), and store the
-- attachment in the Marker entry for cleanup on despawn.
----------------------------------------------------------------------
local function createPivotAttachment(model: Instance, host: BasePart, floatY: number): Attachment
	local existing = host:FindFirstChild('WaypointAnchor')
	local att: Attachment
	if existing and existing:IsA('Attachment') then
		att = existing
	else
		att = Instance.new('Attachment')
		att.Name = 'WaypointAnchor'
		att.Parent = host
	end
	-- Pivot is the gold-standard "center of the model." On a Model
	-- with PrimaryPart it returns the PrimaryPart CFrame; on a Model
	-- without one it returns the bounding-box center; on a BasePart
	-- it returns the part CFrame. WorldPosition is the world-space
	-- write that handles parenting math for us.
	local pivotPos = (model :: any):GetPivot().Position + Vector3.new(0, floatY, 0)
	att.WorldPosition = pivotPos
	return att
end

----------------------------------------------------------------------
-- BillboardGui builder. Icon-only — a single TextLabel with a black
-- text stroke for legibility against any background. No pill / no
-- label clutters the world; the player just sees a colored icon
-- floating over the target. AlwaysOnTop keeps it visible through walls.
--
-- Adornee is an Attachment positioned at the model's pivot, so
-- StudsOffset is always Vector3.zero — the attachment IS the anchor.
-- Any "float above the model" lift is baked into the attachment's
-- WorldPosition by createPivotAttachment(floatY).
--
-- Optional `sizing.Size` overrides:
--   Default fromOffset(56, 56) — pixel-sized.
--   Pass UDim2.fromScale(N, N) for stud-sized markers that grow /
--   shrink with camera distance (waystones use this).
----------------------------------------------------------------------
local BILLBOARD_SIZE_PX  = 56

type BillboardSizing = {
	Size: UDim2?,
}

local function buildBillboard(adornee: Attachment, kindCfg, label: string?, category: string, sizing: BillboardSizing?): BillboardGui
	sizing = sizing or {}
	-- `label` reserved for future tooltip/minimap integration — pass-through.
	local _ = label

	local bg = Instance.new('BillboardGui')
	bg.Name = 'Waypoint_' .. category
	bg.Adornee = adornee
	bg.AlwaysOnTop = true
	bg.LightInfluence = 0
	bg.Size = sizing.Size or UDim2.fromOffset(BILLBOARD_SIZE_PX, BILLBOARD_SIZE_PX)
	bg.StudsOffset = Vector3.zero
	bg.MaxDistance = 250

	local icon = Instance.new('TextLabel')
	icon.Name = 'Icon'
	icon.AnchorPoint = Vector2.new(0.5, 0.5)
	icon.Position = UDim2.fromScale(0.5, 0.5)
	icon.Size = UDim2.fromScale(1, 1)
	icon.BackgroundTransparency = 1
	icon.FontFace = HUDCommon.FONT_DISPLAY
	icon.Text = kindCfg.Icon
	icon.TextScaled = true
	icon.TextColor3 = kindCfg.Color
	icon.TextStrokeColor3 = Color3.new(0, 0, 0)
	icon.TextStrokeTransparency = 0.2
	icon.Parent = bg

	bg.Parent = MarkerFolder
	return bg
end

----------------------------------------------------------------------
-- Visibility refresh. Called whenever a setting flips or the unlocked
-- waystone set changes. Cheap walk over every live marker.
----------------------------------------------------------------------
local function getCategoryEnabled(category: string): boolean
	if category == 'workstation' then
		return SettingsRegistry.WaypointsWorkstationsEnabled ~= false
	elseif category == 'waystone' then
		return SettingsRegistry.WaypointsWaystonesEnabled ~= false
	elseif category == 'substation' then
		return SettingsRegistry.WaypointsSubstationsEnabled ~= false
	end
	return true
end

local function refreshVisibility()
	for _, marker in Markers do
		marker.Gui.Enabled = getCategoryEnabled(marker.Category)
	end
end

----------------------------------------------------------------------
-- Workstation markers. Fired on tag added; checks WorkstationKind and
-- spawns a marker. The CollectionService removed-signal cleanup at the
-- bottom handles teardown.
----------------------------------------------------------------------
local function spawnWorkstationMarker(model: Instance)
	if Markers[model] then return end
	local host = hostPartOf(model)
	if not host then return end
	local kind = model:GetAttribute('WorkstationKind')
	local cfg = (typeof(kind) == 'string' and WaypointsData.Workstations[kind])
		or WaypointsData.WorkstationDefault
	-- Workstations float a few studs above the pivot so the icon
	-- reads above the model rather than overlapping it. The lift is
	-- in world space (attachment.WorldPosition += Vy), not StudsOffset.
	local attachment = createPivotAttachment(model, host, 6)
	local bg = buildBillboard(attachment, cfg, cfg.Label, 'workstation')
	Markers[model] = { Category = 'workstation', Gui = bg, Attachment = attachment }
	bg.Enabled = getCategoryEnabled('workstation')
end

----------------------------------------------------------------------
-- Substation markers. Mirror the workstation pattern but read the
-- per-kind icon/color/label from SubstationsData (the same data the
-- SubstationServer / crafting gate uses) so the world icon matches
-- the gameplay metadata 1:1.
----------------------------------------------------------------------
local function spawnSubstationMarker(model: Instance)
	if Markers[model] then return end
	local host = hostPartOf(model)
	if not host then return end
	local kind = model:GetAttribute(SubstationsData.AttributeKind)
	local cfg = (typeof(kind) == 'string' and SubstationsData.Kinds[kind])
		or SubstationsData.Default
	-- Same 6-stud float as workstations — substations are visually
	-- workstation-class nodes, just gated by a different system.
	local attachment = createPivotAttachment(model, host, 6)
	local bg = buildBillboard(attachment, cfg, cfg.Label, 'substation')
	Markers[model] = { Category = 'substation', Gui = bg, Attachment = attachment }
	bg.Enabled = getCategoryEnabled('substation')
end

----------------------------------------------------------------------
-- Waystone markers. Two-stage gate: the model must be tagged AND its
-- WaystoneId must appear in PlayerData.Waystones. Subscribe to both
-- the tag added/removed signals AND the PlayerData replication so
-- markers spawn/despawn when the player unlocks a new waystone.
----------------------------------------------------------------------
local function isWaystoneUnlocked(waystoneId: string): boolean
	local data = ReplicatedData.GetData('PlayerData', false)
	if typeof(data) ~= 'table' or typeof(data.Waystones) ~= 'table' then
		return false
	end
	for _, id in data.Waystones do
		if id == waystoneId then return true end
	end
	return false
end

local function spawnWaystoneMarker(model: Instance)
	if Markers[model] then return end
	-- ID resolution priority:
	--   1. `WaystoneId` attribute (canonical — what WaystonesServer reads)
	--   2. Model `.Name` (fallback for scenes that haven't set the
	--      attribute; the convention is for the model name to match the
	--      `WaystoneDisplays` key, e.g. `F0_World`).
	-- The fallback is matched against `WaystoneDisplays` to ensure we
	-- only treat it as an id when it's a known waystone — otherwise an
	-- arbitrary model tagged with the Waystones tag (and lacking both
	-- an attribute AND a recognized name) is rejected.
	local waystoneId: string? = model:GetAttribute('WaystoneId')
	if typeof(waystoneId) ~= 'string' or waystoneId == '' then
		if WaystonesData.WaystoneDisplays[model.Name] then
			waystoneId = model.Name
		else
			warn(string.format(
				'[WaypointsClient] Tagged waystone %s has no WaystoneId attribute and its Name (%q) is not a known WaystoneDisplays key — skipped',
				model:GetFullName(), tostring(model.Name)))
			return
		end
	end
	if not isWaystoneUnlocked(waystoneId :: string) then
		-- Not an error — most waystones start locked. Silent so refresh
		-- ticks don't spam the Output panel.
		return
	end
	local host = hostPartOf(model)
	if not host then
		warn(string.format(
			'[WaypointsClient] Waystone %s has no BasePart to host an Attachment — skipped',
			model:GetFullName()))
		return
	end
	-- Resolve a friendly label from the Waystones data module so the
	-- marker reads "Town of Beginnings" instead of "F1_ToB".
	local cfg = WaystonesData.WaystoneDisplays[waystoneId]
	local label = (cfg and cfg.Name) or waystoneId

	-- Anchor the attachment at the model's true pivot center —
	-- :GetPivot() returns the geometric center for a Model, which is
	-- exactly what we want for the stud-scaled marker. No floatY: the
	-- 10×10 stud frame already encloses the structure.
	local attachment = createPivotAttachment(model, host, 0)
	local bg = buildBillboard(attachment, WaypointsData.WaystoneStyle, label, 'waystone', {
		-- Stud-scaled size: 10×10 studs in world space. Marker grows
		-- and shrinks with distance like a true world object instead
		-- of staying a fixed pixel size on screen.
		Size = UDim2.fromScale(10, 10),
	})
	Markers[model] = {
		Category = 'waystone', WaystoneId = waystoneId,
		Gui = bg, Attachment = attachment,
	}
	bg.Enabled = getCategoryEnabled('waystone')
	print(string.format('[WaypointsClient] Spawned waystone marker %q at %s',
		waystoneId, attachment:GetFullName()))
end

local function despawnMarker(model: Instance)
	local marker = Markers[model]
	if not marker then return end
	marker.Gui:Destroy()
	-- We created the attachment ourselves; tear it down with the
	-- marker so re-tagged models don't accumulate orphaned anchors.
	if marker.Attachment then
		marker.Attachment:Destroy()
	end
	Markers[model] = nil
end

-- Re-evaluate every tagged Waystone model when PlayerData changes.
-- Newly-unlocked → spawn; not-yet-unlocked stays absent.
local function refreshWaystoneMarkers()
	for _, model in CollectionService:GetTagged(WaystonesData.WaystonesTag) do
		if Markers[model] then
			-- Already shown — keep as-is. (We don't despawn on
			-- "no longer unlocked" because waystones unlock once
			-- and never revert in the current design.)
			continue
		end
		spawnWaystoneMarker(model)
	end
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.Start()
	-- Per-player folder so other clients' waypoints don't bleed into
	-- this player's view (BillboardGuis parented to PlayerGui are
	-- player-local by design; the folder keeps cleanup centralized).
	local playerGui = LocalPlayer:WaitForChild('PlayerGui')
	MarkerFolder = playerGui:FindFirstChild('Waypoints') :: Folder?
	if not MarkerFolder then
		MarkerFolder = Instance.new('Folder')
		MarkerFolder.Name = 'Waypoints'
		MarkerFolder.Parent = playerGui
	end

	-- Workstation tag — every existing instance + future additions.
	local WORKSTATION_TAG = 'Workstation'
	for _, m in CollectionService:GetTagged(WORKSTATION_TAG) do
		spawnWorkstationMarker(m)
	end
	CollectionService:GetInstanceAddedSignal(WORKSTATION_TAG):Connect(spawnWorkstationMarker)
	CollectionService:GetInstanceRemovedSignal(WORKSTATION_TAG):Connect(despawnMarker)

	-- Substation tag — same lifecycle as workstations, separate
	-- visibility category. The tag string lives on the Substations
	-- data module so server / client share one source of truth.
	local SUBSTATION_TAG = SubstationsData.Tag
	for _, m in CollectionService:GetTagged(SUBSTATION_TAG) do
		spawnSubstationMarker(m)
	end
	CollectionService:GetInstanceAddedSignal(SUBSTATION_TAG):Connect(spawnSubstationMarker)
	CollectionService:GetInstanceRemovedSignal(SUBSTATION_TAG):Connect(despawnMarker)

	-- Waystone tag — gate by save-data unlock check.
	local WAYSTONE_TAG = WaystonesData.WaystonesTag
	local taggedAtStart = CollectionService:GetTagged(WAYSTONE_TAG)
	print(string.format(
		'[WaypointsClient] Start: found %d tagged %q models in workspace',
		#taggedAtStart, WAYSTONE_TAG))
	for _, m in taggedAtStart do
		spawnWaystoneMarker(m)
	end
	CollectionService:GetInstanceAddedSignal(WAYSTONE_TAG):Connect(spawnWaystoneMarker)
	CollectionService:GetInstanceRemovedSignal(WAYSTONE_TAG):Connect(despawnMarker)

	-- PlayerData replication: re-check every tagged waystone so newly-
	-- unlocked ones spawn their marker.
	ReplicatedData.OnUpdated:Connect(function(category)
		if category == 'PlayerData' then
			refreshWaystoneMarkers()
		end
	end)
	-- Server-side unlock cue. Fires on each fresh unlock; refresh
	-- ensures the marker appears immediately even if PlayerData
	-- replication is throttled / batched.
	if WaystonesEvent then
		WaystonesEvent.OnClientEvent:Connect(function(_waystoneId)
			refreshWaystoneMarkers()
		end)
	end
	-- Initial refresh in case PlayerData replicated before Start ran
	-- (the race is a one-frame edge but cheap to defend).
	task.defer(refreshWaystoneMarkers)
	-- Belt-and-suspenders: a second deferred refresh ~1s in, after the
	-- usual server-side bootstrap window. Catches the case where
	-- ReplicatedData fired before our listener was wired.
	task.delay(1, refreshWaystoneMarkers)

	-- Settings: flip visibility per category when toggled.
	SettingsRegistry.Changed:Connect(function(key)
		if key == 'WaypointsWorkstationsEnabled'
			or key == 'WaypointsWaystonesEnabled'
			or key == 'WaypointsSubstationsEnabled'
		then
			refreshVisibility()
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Miscellaneous/init.luau"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Miscellaneous/DataDebug.luau"><![CDATA[
local LocalPlayer = game:GetService('Players').LocalPlayer

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedModules = require(ReplicatedStorage:WaitForChild("Modules"))

local ReplicatedData = ReplicatedModules.Services.ReplicatedData
local TableUtility = ReplicatedModules.Utility.Table

local SystemsContainer = {}

local DebugContainer = Instance.new('Folder')
DebugContainer.Name = 'DebugContainer'
DebugContainer.Parent = ReplicatedStorage

-- // Module // --
local Module = {}

function Module.OnDataUpdated( Category, Data )
	local DataContainer = DebugContainer:FindFirstChild( Category )
	if not DataContainer then
		DataContainer = Instance.new('Folder')
		DataContainer.Name = Category
		DataContainer.Parent = DebugContainer
	end

	DataContainer:ClearAllChildren()
	TableUtility.TableToObject(Data, DataContainer, {})
end

function Module.Start()
	for k, v in ReplicatedData.Replicated do
		task.spawn( Module.OnDataUpdated, k, v )
	end
	ReplicatedData.OnUpdated:Connect(function(Category, Data)
		Module.OnDataUpdated( Category, Data )
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Miscellaneous/FadeTest.luau"><![CDATA[-- Full-screen black fade overlay used during boot + waystone teleports.
-- Ported off the legacy GameInterface.Fade template to a self-owned ScreenGui.

local TweenService = game:GetService('TweenService')
local ReplicatedFirst = game:GetService('ReplicatedFirst')

local Players = game:GetService('Players')
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local ReplicatedData = ReplicatedModules.Services.ReplicatedData

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon

local SystemsContainer = {}

local FadeFrame: Frame = nil :: any

local function ensureFade()
	if FadeFrame and FadeFrame.Parent then return FadeFrame end
	local gui = HUDCommon.ensureScreenGui('HUD_Fade', 100)
	local frame = Instance.new('Frame')
	frame.Name = 'Fade'
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.new(0, 0, 0)
	frame.BackgroundTransparency = 0
	frame.BorderSizePixel = 0
	frame.ZIndex = 1000
	frame.Parent = gui
	FadeFrame = frame
	return frame
end

-- // Module // --
local Module = {}

function Module.FadeInBlack(duration: number?)
	local f = ensureFade()
	TweenService:Create(f, TweenInfo.new(duration or 1), { BackgroundTransparency = 0 }):Play()
end

function Module.FadeOutBlack(duration: number?)
	local f = ensureFade()
	TweenService:Create(f, TweenInfo.new(duration or 1), { BackgroundTransparency = 1 }):Play()
end

function Module.Start()
	task.spawn(function()
		local f = ensureFade()
		f.BackgroundTransparency = 0
		ReplicatedFirst:RemoveDefaultLoadingScreen()
		task.wait(3)
		ReplicatedData.GetData('PlayerData', true)
		Module.FadeOutBlack()
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Miscellaneous/RobloxStuffDisabler.luau"><![CDATA[
local StarterGui = game:GetService('StarterGui')

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local SystemsContainer = {}

-- // Module // --
local Module = {}

function Module.UpdateState()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Captures, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.SelfView, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, true)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true)
	StarterGui:SetCore("TopbarEnabled", false)
end

function Module.Start()
	if LocalPlayer.Character then
		task.spawn(function()
			LocalPlayer.Character:WaitForChild('Humanoid', 3)
			task.wait(1)
			Module.UpdateState()
		end)
	end
	LocalPlayer.CharacterAdded:Connect(Module.UpdateState)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Miscellaneous/SoftShutdown.luau"><![CDATA[local HttpService = game:GetService('HttpService')
local TweenService = game:GetService('TweenService')
local Lighting = game:GetService('Lighting')

local Players = game:GetService('Players')
local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')

local SoftShutdownUI = ReplicatedAssets.UI:FindFirstChild('SoftShutdown')
assert(SoftShutdownUI, 'SoftShutdown UI could not be found.')
local MaintenanceUI = ReplicatedAssets.UI:FindFirstChild('Maintenance')
assert(MaintenanceUI, 'Maintenance UI could not be found.')

local SystemsContainer = {}

local HasShutdown = false
local HasTimerStarted = false
local LastWidgetPrompt = false

local ReminderTimeValues = { 300, 600, 1800, 3600 } -- countdown 3m, 10m, 30m, 1hr

local function GetHrsMinSec(seconds)
	local hrs = math.floor(seconds / 360)
	seconds -= (hrs * 360)
	local minutes = math.floor(seconds / 60)
	seconds -= (minutes * 60)
	return hrs, minutes, math.floor(seconds)
end

local function FormatTimerSplice(seconds)
	local hrs, min, sec = GetHrsMinSec(seconds)
	local hrtxt = hrs>0 and hrs..'hr' or '0h'
	local mtxt = min>0 and min..'m' or '0m'
	local stxt = sec>0 and sec..'s' or '0s'
	return hrs>0 and hrtxt..' '..mtxt or mtxt..' '..stxt
end

-- // Module // --
local Module = {}

function Module.OnSoftShutdown()
	local PlayerGui = LocalPlayer:WaitForChild('PlayerGui')
	for _, UIInstance in PlayerGui:GetChildren() do
		UIInstance.Enabled = false
	end

	local Item = SoftShutdownUI:Clone()
	Item.Parent = PlayerGui

	local ResultSize = Item.ShutdownBlur.Size
	Item.ShutdownBlur.Size = 0
	Item.ShutdownBlur.Enabled = true
	TweenService:Create(Item.ShutdownBlur, TweenInfo.new(1), {Size = ResultSize}):Play()
	Item.ShutdownBlur.Parent = Lighting

	Item.Notification:Play()
	task.delay(0.5, function()
		Item.Piano:Play()
	end)

	Item.Enabled = true
end

function Module.CheckSoftShutdownState()
	if HasShutdown or not workspace:GetAttribute('SoftShutdownEnabled') then
		return
	end
	HasShutdown = true
	print('SoftShutdown has occured.')

	workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable

	local Sound = SystemsContainer.ParentSystems.Gameplay.MusicClient.MusicSoundInstance
	local Tween = TweenService:Create( Sound, TweenInfo.new(1.5), {Volume = 0} )
	Tween.Completed:Connect(function()
		Sound:Destroy()
	end)
	Tween:Play()

	Module.OnSoftShutdown()
end

local ActiveMaintenanceUI = false
local UUID = HttpService:GenerateGUID(false)

function Module.ForceMaintenancePrompt(message)
	if not ActiveMaintenanceUI then
		ActiveMaintenanceUI = MaintenanceUI:Clone()
		ActiveMaintenanceUI.Enabled = true
		ActiveMaintenanceUI.Notification:Play()
		ActiveMaintenanceUI.Parent = LocalPlayer.PlayerGui
	end
	ActiveMaintenanceUI.Frame.Description.Text = message
	UUID = HttpService:GenerateGUID(false)
end

function Module.TemporaryMaintenancePrompt(message)
	if not ActiveMaintenanceUI then
		ActiveMaintenanceUI = MaintenanceUI:Clone()
		ActiveMaintenanceUI.Enabled = true
		ActiveMaintenanceUI.Parent = LocalPlayer.PlayerGui
	end
	ActiveMaintenanceUI.Notification:Play()
	ActiveMaintenanceUI.Frame.Description.Text = message
	local ID = HttpService:GenerateGUID(false)
	UUID = ID
	task.delay(5, function()
		if UUID ~= ID then
			return
		end
		ActiveMaintenanceUI:Destroy()
		ActiveMaintenanceUI = nil
	end)
end

function Module.UpdateSoftShutdownTimer()
	local timeUntil = workspace:GetAttribute('TimedShutdownTime') - tick()
	local message = 'A soft shutdown will occur in '..FormatTimerSplice(timeUntil)

	if timeUntil < ReminderTimeValues[1] then
		Module.ForceMaintenancePrompt(message)
		return
	end

	for _, value in ReminderTimeValues do
		-- print( timeUntil, value, LastWidgetPrompt )
		if timeUntil < value then
			if value ~= LastWidgetPrompt then
				LastWidgetPrompt = value
				Module.TemporaryMaintenancePrompt(message)
			end
			break
		end
	end
end

function Module.CheckTimedSoftShutdownState()
	if not workspace:GetAttribute('TimedShutdownTime') or HasTimerStarted then
		return
	end
	HasTimerStarted = true

	task.spawn(function()
		while HasTimerStarted and workspace:GetAttribute('TimedShutdownTime') do
			task.wait(1)
			Module.UpdateSoftShutdownTimer()
		end
	end)
end

function Module.Start()
	task.defer(function()
		Module.CheckSoftShutdownState()
		Module.CheckTimedSoftShutdownState()
	end)

	workspace:GetAttributeChangedSignal('TimedShutdownTime'):Connect(Module.CheckTimedSoftShutdownState)
	workspace:GetAttributeChangedSignal('SoftShutdownEnabled'):Connect(Module.CheckSoftShutdownState)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/init.luau"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/BossHealthbarWidget.luau"><![CDATA[-- BossHealthbarWidget — top-center boss HP UI with multi-bar support.
--
-- A boss is described by an ordered list of *bars*; each bar is a
-- self-contained health container with its own MaxHP and live CurrentHP.
-- Use this for phase-based bosses (one bar per phase), shielded bosses
-- (an outer "shield" bar over an inner "health" bar), or any encounter
-- where a single fill bar can't capture the full HP shape.
--
-- Public API:
--   Module.SetBoss(displayName, bars)
--     Opens (or replaces) the panel for a boss. `bars` is an ordered
--     array of { Id = string, Name? = string, MaxHP = number,
--                CurrentHP = number, Color? = Color3 }.
--   Module.UpdateBar(barId, currentHP)
--     Tween a specific bar to `currentHP`. Smooth via HUDCommon.smoothBar.
--   Module.RemoveBar(barId)
--     Drops a bar (e.g. on phase end). When the last bar is removed,
--     the widget closes automatically.
--   Module.CloseWidget()
--     Hide and clear all state.
--
-- Layout strategy (see custom-roblox-ui SKILL.md):
--   * Top-level panel anchors top-center, lifted off the screen edge by
--     a Scale-converted pixel inset. Width is Scale-relative to the
--     design screen so the rail keeps its design proportions on every
--     aspect; height auto-grows with the bar count via AutomaticSize.Y.
--   * Each bar is its own Frame (the "container") so adding/removing
--     bars is a parent/destroy at the container level — no special
--     reflow logic. Container holds: optional sublabel + smoothBar fill
--     + numeric HP overlay text.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local doCleanup = Fusion.doCleanup
local peek = Fusion.peek

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE = HUDCommon.PALETTE

local SystemsContainer = {}

local Module = {}
Module.IsOpen = false

----------------------------------------------------------------------
-- Design dimensions (pixels). Every Scale value is derived from these.
----------------------------------------------------------------------
local DESIGN_SCREEN_W, DESIGN_SCREEN_H = 1920, 1080

local DESIGN_PANEL_W       = 720
local DESIGN_PANEL_PAD     = 14

local DESIGN_NAME_H        = 32   -- big boss name label
local DESIGN_BAR_H         = 18   -- per-bar fill height
local DESIGN_BAR_LABEL_H   = 12   -- optional per-bar sublabel ("Phase 1", etc.)
local DESIGN_BAR_GAP       = 6    -- vertical gap between bars
local DESIGN_ROW_GAP       = 8    -- gap between name and the bar stack

local DESIGN_TOP_INSET     = 36   -- distance from top of screen to panel top
local ANCHOR_Y_SCALE       = DESIGN_TOP_INSET / DESIGN_SCREEN_H

local DEFAULT_BAR_COLOR    = Color3.fromRGB(220, 70, 80)

----------------------------------------------------------------------
-- Per-open state. Built fresh by SetBoss and torn down by CloseWidget.
----------------------------------------------------------------------
local ScreenGui: ScreenGui? = nil
local RootScope = nil

local BossNameValue = nil   -- Value<string>
local BarConfigs    = nil   -- Value<{BarConfig}>; rebuilds bars on change
-- Per-bar live HP Values, keyed by Bar.Id. Mutated directly on UpdateBar
-- so the smoothBar tween reads off the existing Value (no full ForPairs
-- rebuild on every HP tick — we only rebuild when the bar list shape
-- changes via SetBoss / RemoveBar).
local BarHPValues: { [string]: any } = {}

export type BarConfig = {
	Id: string,
	Name: string?,
	MaxHP: number,
	CurrentHP: number,
	Color: Color3?,
}

----------------------------------------------------------------------
-- Build one bar container. Captures the bar's static config + binds the
-- smoothBar to the matching live HP Value. Returns the container Frame.
----------------------------------------------------------------------
local function buildBar(scope, bar: BarConfig)
	local hpValue = BarHPValues[bar.Id]
	local color = bar.Color or DEFAULT_BAR_COLOR
	local maxHP = bar.MaxHP

	-- Fill bar via HUDCommon.smoothBar. We pass the live Value as
	-- `Value` so it observes changes and tweens smoothly.
	local smoothBar = HUDCommon.smoothBar(scope, {
		Value = hpValue,
		Max   = maxHP,
		Color = color,
		Height = DESIGN_BAR_H,
		LayoutOrder = 1,
	})

	-- Numeric "current / max" overlay parented onto the smoothBar fill
	-- frame. ZIndex=5 puts it above the fill gradient so the text reads
	-- against either filled or unfilled background.
	scope:New('TextLabel') {
		Name = 'HPText',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_MONO,
		TextSize = 11,
		TextColor3 = PALETTE.ink,
		TextStrokeTransparency = 0.4,
		TextStrokeColor3 = PALETTE.bg0,
		Text = scope:Computed(function(use)
			local v = use(hpValue)
			return string.format('%d / %d', math.max(0, math.floor(v + 0.5)), maxHP)
		end),
		Parent = smoothBar,
		ZIndex = 5,
	}

	-- Optional sublabel above the bar (e.g. "Phase 1", "Shield").
	-- Layout-ordered before the bar so it stacks above; the container's
	-- vertical UIListLayout enforces the order.
	local children: { any } = {}
	if typeof(bar.Name) == 'string' and bar.Name ~= '' then
		children[#children + 1] = HUDCommon.eyebrowLabel(scope, {
			Text = string.upper(bar.Name),
			Color = color:Lerp(Color3.new(1, 1, 1), 0.25),
			Size = UDim2.new(1, 0, 0, DESIGN_BAR_LABEL_H),
			TextSize = 10,
			LayoutOrder = 0,
		})
	end
	children[#children + 1] = smoothBar

	return scope:New('Frame') {
		Name = 'BarContainer_' .. bar.Id,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 2),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			table.unpack(children),
		},
	}
end

----------------------------------------------------------------------
-- Build the panel. Top-center; AutoSize.Y so adding/removing bars
-- reflows naturally. Bars are produced via ForPairs over BarConfigs so
-- list-shape changes (SetBoss / RemoveBar) reactively rebuild the
-- container stack while bar HP updates flow through per-bar Values
-- without re-running the loop.
----------------------------------------------------------------------
local function buildPanel(scope)
	local panel = HUDCommon.chiseledPanel(scope, {
		Name = 'BossHealthbarPanel',
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, ANCHOR_Y_SCALE),
		Size = UDim2.fromScale(DESIGN_PANEL_W / DESIGN_SCREEN_W,
			(DESIGN_NAME_H + DESIGN_BAR_H + DESIGN_ROW_GAP) / DESIGN_SCREEN_H),
		AutomaticSize = Enum.AutomaticSize.Y,
		AccentColor = DEFAULT_BAR_COLOR,
		Children = {
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(0, DESIGN_PANEL_PAD),
				PaddingBottom = UDim.new(0, DESIGN_PANEL_PAD),
				PaddingLeft   = UDim.new(0, DESIGN_PANEL_PAD),
				PaddingRight  = UDim.new(0, DESIGN_PANEL_PAD),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, DESIGN_ROW_GAP),
				SortOrder = Enum.SortOrder.LayoutOrder,
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
			},

			-- Boss name. Centered, pixel-height; large display font.
			scope:New('TextLabel') {
				Name = 'BossName',
				LayoutOrder = 0,
				Size = UDim2.new(1, 0, 0, DESIGN_NAME_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				TextSize = 24,
				TextColor3 = PALETTE.ink,
				TextStrokeTransparency = 0.5,
				TextStrokeColor3 = PALETTE.bg0,
				Text = BossNameValue,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextYAlignment = Enum.TextYAlignment.Center,
			},

			-- Bar stack. AutoSize.Y so it absorbs the live count of bars.
			scope:New('Frame') {
				Name = 'BarStack',
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding = UDim.new(0, DESIGN_BAR_GAP),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					-- Reactive rebuild of bar containers when BarConfigs
					-- changes. Per-bar HP changes go through BarHPValues
					-- and don't re-run this processor.
					scope:ForPairs(BarConfigs, function(_use, innerScope, idx, bar)
						local container = buildBar(innerScope, bar)
						container.LayoutOrder = idx
						return bar.Id, container
					end),
				},
			},
		},
	})
	panel.Parent = ScreenGui
	return panel
end

----------------------------------------------------------------------
-- Public API.
----------------------------------------------------------------------
function Module.IsWidgetOpen(): boolean
	return Module.IsOpen
end

function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true
	ScreenGui = HUDCommon.ensureScreenGui('HUD_BossHealthbar', 35)
	RootScope = scoped(Fusion)
	BossNameValue = RootScope:Value('')
	BarConfigs = RootScope:Value({})
	BarHPValues = {}
	buildPanel(RootScope)
end

function Module.CloseWidget()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	BarHPValues = {}
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
	BossNameValue = nil
	BarConfigs = nil
end

-- Open or replace the boss panel. `bars` is a fresh ordered config list;
-- this clears any prior boss state and rebuilds from scratch. Pass a
-- single-element list for single-bar bosses, multi-element for phased.
function Module.SetBoss(displayName: string, bars: { BarConfig })
	if not Module.IsOpen then Module.OpenWidget() end
	-- Build fresh per-bar HP Values so each bar has its own observable
	-- channel. UpdateBar mutates these directly without rebuilding the
	-- bar list structurally.
	BarHPValues = {}
	for _, bar in bars do
		BarHPValues[bar.Id] = RootScope:Value(bar.CurrentHP)
	end
	BossNameValue:set(displayName)
	BarConfigs:set(bars)
end

-- Smooth-set a bar's current HP. Caps at 0 floor (negative HP rounds up
-- to 0 visually); the bar fill is clamped to [0, 1] inside smoothBar.
function Module.UpdateBar(barId: string, currentHP: number)
	local v = BarHPValues[barId]
	if v then v:set(math.max(0, currentHP)) end
end

-- Remove a bar from the stack. Closes the widget when the last bar is
-- gone — boss-encounter authors don't have to remember to close the
-- widget separately when the final phase ends.
function Module.RemoveBar(barId: string)
	if not BarConfigs then return end
	local list = peek(BarConfigs) or {}
	local out = {}
	for _, bar in list do
		if bar.Id ~= barId then table.insert(out, bar) end
	end
	BarHPValues[barId] = nil
	BarConfigs:set(out)
	if #out == 0 then Module.CloseWidget() end
end

-- Server-driven dispatcher. BossServer (and any future boss-controller
-- module) fires `BossHealthbarEvent` with `(action, payload)` to drive
-- the widget without holding a direct reference. The action enum + per-
-- action payload shapes live on Services.BossHealthbarShared.Actions.
local function tryGetEvent()
	local ok, RemoteService = pcall(function()
		return ReplicatedModules.Services.RemoteService
	end)
	if not ok or not RemoteService then return nil end
	return RemoteService.GetRemote('BossHealthbarEvent', 'RemoteEvent', false)
end

function Module.Start()
	local evt = tryGetEvent()
	if not evt then return end
	local Actions = ReplicatedModules.Services.BossHealthbarShared.Actions
	evt.OnClientEvent:Connect(function(action, payload)
		if action == Actions.SetBoss and typeof(payload) == 'table' then
			Module.SetBoss(payload.Name or '', payload.Bars or {})
		elseif action == Actions.UpdateBar and typeof(payload) == 'table' then
			Module.UpdateBar(payload.Id, payload.CurrentHP)
		elseif action == Actions.RemoveBar and typeof(payload) == 'table' then
			Module.RemoveBar(payload.Id)
		elseif action == Actions.Close then
			Module.CloseWidget()
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/CinematicTestWidget.luau"><![CDATA[-- CinematicTestWidget — F4 toggle. Buttons for every cinematic /
-- shake / VFX / camera-shot / dialogue id so the cinematic stack
-- can be exercised end-to-end without code changes.
--
-- Routing:
--   * Cinematics → fired via CinematicTestEvent → CinematicServer
--   * Shake / VFX → CinematicClient.PlayCue (client-direct; testing
--                   the cue surface, not the network path)
--   * Camera shots → CinematicCharacter against the first tagged
--                    'DialogueNPC' instance, falling back to the
--                    local character when no NPC is in scene.
--   * Dialogue → CinematicTestEvent → DialogueNPCServer
--
-- Studio: open by default in playtest. Live: opens only on F4 press
-- (the panel is hidden until pressed). The CinematicTestServer's
-- auth gate is what actually keeps the buttons inert in live for
-- non-admin players — the widget is just a UI surface.

local Players          = game:GetService('Players')
local UserInputService = game:GetService('UserInputService')
local CollectionService = game:GetService('CollectionService')

local LocalPlayer = Players.LocalPlayer

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))

local Fusion    = ReplicatedModules.Libraries.Fusion
local scoped    = Fusion.scoped
local doCleanup = Fusion.doCleanup

local CinematicShared  = ReplicatedModules.Services.CinematicShared
local CinematicTestShared = ReplicatedModules.Services.CinematicTestShared
local CinematicPresets = ReplicatedModules.Data.CinematicPresets
local Cinematics       = ReplicatedModules.Data.Cinematics
local DialogueData     = ReplicatedModules.Data.Dialogue
local RemoteService    = ReplicatedModules.Services.RemoteService

local CinematicTestEvent = RemoteService.GetRemote('CinematicTestEvent', 'RemoteEvent', false)

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

-- Test-server action enum — the shared CinematicTestEvent protocol. Single
-- source of truth in Services.CinematicTestShared; both this widget and
-- CinematicTestServer reference it, so the two can't drift.
local TestActions = CinematicTestShared.Actions

local SystemsContainer = {}

local Module = {}
Module.IsOpen = false

local ScreenGui: ScreenGui? = nil
local RootScope = nil

-- Persistent toggle button — separate ScreenGui so it stays visible
-- whether the panel is open or closed. Built once in Start() and never
-- torn down; the panel's ScreenGui is what gets created/destroyed on
-- open/close. Sits above the hotbar (centered, just below midline-bottom).
local ToggleScreenGui: GuiObject? = nil
local ToggleScope = nil

-- Snap toggle state. Set once at scope-create; passed into shot
-- helpers so users can compare snap-cut vs lerp on the same preset.
local SnapState = nil  -- Fusion Value<boolean>

----------------------------------------------------------------------
-- Helpers — resolution of dependencies + target for shots.
----------------------------------------------------------------------
local function getCinematicClient()
	local c = SystemsContainer.CinematicClient
		or (SystemsContainer.ParentSystems and SystemsContainer.ParentSystems.Effects
			and SystemsContainer.ParentSystems.Effects.CinematicClient)
	return c
end

local function getCinematicCharacter()
	local c = SystemsContainer.CinematicCharacter
		or (SystemsContainer.ParentSystems and SystemsContainer.ParentSystems.Effects
			and SystemsContainer.ParentSystems.Effects.CinematicCharacter)
	return c
end

-- Pick a model to frame for shot tests. Preference order:
--   1. First model tagged 'DialogueNPC' (matches the NPC server's tag).
--   2. Local player's character.
local function getShotTarget(): Model?
	for _, inst in CollectionService:GetTagged('DialogueNPC') do
		if inst:IsA('Model') then return inst end
	end
	return LocalPlayer.Character
end

----------------------------------------------------------------------
-- Action handlers — what each button does. Pulled out of the render
-- so the layout stays focused on layout.
----------------------------------------------------------------------
local function playCinematic(id: string)
	CinematicTestEvent:FireServer(TestActions.PlayCinematic, id)
end

local function openDialogue(id: string)
	CinematicTestEvent:FireServer(TestActions.OpenDialogue, id)
end

-- New: skill-runtime / boss / telegraph debug fan-out. Each forwards
-- to CinematicTestServer with a single string payload (recipe id,
-- mob id, telegraph kind, phase index as string).
local function runRecipe(id: string)
	CinematicTestEvent:FireServer(TestActions.RunRecipe, id)
end
local function testTelegraph(kind: string)
	CinematicTestEvent:FireServer(TestActions.TestTelegraph, kind)
end
local function spawnMob(mobId: string)
	CinematicTestEvent:FireServer(TestActions.SpawnMob, mobId)
end
local function setBossPhase(idx: number)
	CinematicTestEvent:FireServer(TestActions.SetBossPhase, tostring(idx))
end

local function fireShake(presetName: string)
	local client = getCinematicClient()
	if not client then return end
	local p = CinematicPresets.ResolveShake(presetName)
	client.PlayCue(CinematicShared.CueKind.CameraShake, {
		Magnitude = p.Magnitude, Roughness = p.Roughness, Duration = p.Duration,
		FadeIn = p.FadeIn, FadeOut = p.FadeOut,
	})
end

local function fireVFX(presetName: string)
	print(string.format('[CinematicTestWidget] fireVFX preset=%s', tostring(presetName)))
	local client = getCinematicClient()
	if not client then
		warn('[CinematicTestWidget] fireVFX: CinematicClient not in SystemsContainer; cue dropped')
		return
	end
	local p = CinematicPresets.ResolveVFX(presetName)
	-- Test surface: always anchor to the local player's HRP regardless
	-- of the preset's DefaultAnchor — keeps the effect attached to the
	-- player so the tester sees it without chasing world coords.
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild('HumanoidRootPart')
	if not hrp then
		warn('[CinematicTestWidget] fireVFX: local character has no HumanoidRootPart yet; firing camera-anchored fallback')
	end
	local args: { [string]: any } = {
		TemplateName = p.Template,
		Duration     = p.Duration,
		Anchor       = 'instance',
		InstancePath = hrp and hrp:GetFullName() or nil,
	}
	client.PlayCue(CinematicShared.CueKind.PlayVFX, args)
end

local function fireShot(presetName: string, snap: boolean)
	local cinematic = getCinematicCharacter()
	if not cinematic then return end
	local target = getShotTarget()
	if not target then return end
	cinematic.SetShot(target, presetName, { Snap = snap, Hold = 2.5 })
end

local function fireCameraReset()
	local cinematic = getCinematicCharacter()
	if cinematic and cinematic.Reset then cinematic.Reset(); return end
	local client = getCinematicClient()
	if client then client.PlayCue(CinematicShared.CueKind.CameraReset, {}) end
end

----------------------------------------------------------------------
-- UI primitives — small, local. Not promoting to HUDCommon since
-- they're test-widget specific (chiseledPanel + eyebrowLabel are
-- the only shared atoms used).
----------------------------------------------------------------------
local function buttonRow(scope, label: string, onClick: () -> ())
	return scope:New('TextButton') {
		Name        = 'Btn_' .. label,
		Size        = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = PALETTE.bg1,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		FontFace    = HUDCommon.FONT_UI,
		TextSize    = 13,
		TextColor3  = PALETTE.ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text        = '  ' .. label,
		[Fusion.OnEvent('Activated')] = onClick,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = PALETTE.accent, Transparency = 0.75, Thickness = 1,
			},
		},
	}
end

local function sectionFrame(scope, title: string, buttons: { any })
	return scope:New('Frame') {
		Name = 'Section_' .. title,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding       = UDim.new(0, 4),
				SortOrder     = Enum.SortOrder.LayoutOrder,
			},
			HUDCommon.eyebrowLabel(scope, {
				Text = '\u{25C6} ' .. string.upper(title),
				Color = PALETTE.accent,
				Size = UDim2.new(1, 0, 0, 14),
				TextSize = 11,
				LayoutOrder = 0,
			}),
			scope:New('Frame') {
				Name = 'Buttons',
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding       = UDim.new(0, 3),
						SortOrder     = Enum.SortOrder.LayoutOrder,
					},
					table.unpack(buttons),
				},
			},
		},
	}
end

----------------------------------------------------------------------
-- Sections — built lazily so the preset tables are read at open-time
-- (a runtime preset add via Studio iteration is reflected on next
-- F4 toggle without restarting the place).
----------------------------------------------------------------------
local function cinematicButtons(scope)
	local btns = {}
	local ids = {}
	for id in Cinematics.Cinematics do ids[#ids + 1] = id end
	table.sort(ids)
	for i, id in ids do
		btns[#btns + 1] = scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			[Fusion.Children] = { buttonRow(scope, id, function() playCinematic(id) end) },
		}
	end
	return btns
end

local function shakeButtons(scope)
	local btns = {}
	for i, name in CinematicPresets.ListShakes() do
		btns[#btns + 1] = scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			[Fusion.Children] = { buttonRow(scope, name, function() fireShake(name) end) },
		}
	end
	return btns
end

local function vfxButtons(scope)
	local btns = {}
	for i, name in CinematicPresets.ListVFX() do
		btns[#btns + 1] = scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			[Fusion.Children] = { buttonRow(scope, name, function() fireVFX(name) end) },
		}
	end
	return btns
end

local function shotButtons(scope)
	local btns = {}
	for i, name in CinematicPresets.ListShots() do
		btns[#btns + 1] = scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				buttonRow(scope, name, function()
					fireShot(name, Fusion.peek(SnapState) == true)
				end),
			},
		}
	end
	-- Append a "RESET" + a Snap toggle row.
	btns[#btns + 1] = scope:New('Frame') {
		LayoutOrder = 100,
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			buttonRow(scope, 'reset camera', function() fireCameraReset() end),
		},
	}
	btns[#btns + 1] = scope:New('TextButton') {
		LayoutOrder = 101,
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = PALETTE.bg1,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		FontFace = HUDCommon.FONT_UI,
		TextSize = 13,
		TextColor3 = PALETTE.ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = scope:Computed(function(use)
			return string.format('  snap: %s', use(SnapState) and 'ON' or 'off')
		end),
		[Fusion.OnEvent('Activated')] = function()
			SnapState:set(not Fusion.peek(SnapState))
		end,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.gold, Transparency = 0.6, Thickness = 1 },
		},
	}
	return btns
end

local function dialogueButtons(scope)
	local btns = {}
	local ids = {}
	for id in DialogueData.Dialogue do ids[#ids + 1] = id end
	table.sort(ids)
	for i, id in ids do
		btns[#btns + 1] = scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			[Fusion.Children] = { buttonRow(scope, id, function() openDialogue(id) end) },
		}
	end
	return btns
end

----------------------------------------------------------------------
-- Skill-runtime debug sections. Lazy-required so an early-load order
-- where ReplicatedModules isn't ready doesn't hang the widget.
----------------------------------------------------------------------
local function tryGetCombatSkills()
	local ok, result = pcall(function()
		return require(game:GetService('ReplicatedStorage'):WaitForChild('Modules')).Data.CombatSkills
	end)
	return ok and result or nil
end

local function recipeButtons(scope)
	local CombatSkills = tryGetCombatSkills()
	local btns = {}
	if not CombatSkills or typeof(CombatSkills.Recipes) ~= 'table' then return btns end
	local ids = {}
	for id in CombatSkills.Recipes do ids[#ids + 1] = id end
	table.sort(ids)
	for i, id in ids do
		btns[#btns + 1] = scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			[Fusion.Children] = { buttonRow(scope, id, function() runRecipe(id) end) },
		}
	end
	return btns
end

local function telegraphButtons(scope)
	local btns = {}
	for i, kind in { 'circle', 'rect', 'cone' } do
		btns[#btns + 1] = scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			[Fusion.Children] = { buttonRow(scope, 'telegraph: ' .. kind,
				function() testTelegraph(kind) end) },
		}
	end
	return btns
end

local function mobSpawnButtons(scope)
	-- Hand-curated list — adding a new mob to Mobs.luau means adding
	-- one entry here. (Could be auto-generated from Mobs.Mobs but
	-- the F4 widget is for tightly-curated test entries, not every
	-- mob in the game.)
	local mobs = { 'Boar', 'BossBoar', 'Generic' }
	local btns = {}
	for i, mobId in mobs do
		btns[#btns + 1] = scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			[Fusion.Children] = { buttonRow(scope, 'spawn: ' .. mobId,
				function() spawnMob(mobId) end) },
		}
	end
	return btns
end

local function bossPhaseButtons(scope)
	local btns = {}
	for i = 1, 3 do
		local phase = i
		btns[#btns + 1] = scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			[Fusion.Children] = { buttonRow(scope, 'force phase ' .. phase,
				function() setBossPhase(phase) end) },
		}
	end
	return btns
end

----------------------------------------------------------------------
-- Boss healthbar test buttons. Cycles a few canned shapes (single bar,
-- two-phase, shielded boss) + a damage tick so the smooth fill tween is
-- visible. Closes via the explicit "close" row.
----------------------------------------------------------------------
local function getBossHealthbar()
	return SystemsContainer.BossHealthbarWidget
		or (SystemsContainer.ParentSystems and SystemsContainer.ParentSystems.Widgets
			and SystemsContainer.ParentSystems.Widgets.BossHealthbarWidget)
end

local TestBossPresets: { { name: string, label: string, run: () -> () } } = {
	{
		name = 'single', label = 'single bar (1000hp)',
		run = function()
			local bh = getBossHealthbar(); if not bh then return end
			bh.SetBoss('Test Boss', { { Id = 'main', MaxHP = 1000, CurrentHP = 1000 } })
		end,
	},
	{
		name = 'two_phase', label = 'two-phase (red/violet)',
		run = function()
			local bh = getBossHealthbar(); if not bh then return end
			bh.SetBoss('Twin-Phase Boss', {
				{ Id = 'p1', Name = 'Phase 1', MaxHP = 1500, CurrentHP = 1500,
					Color = Color3.fromRGB(220, 70, 80) },
				{ Id = 'p2', Name = 'Phase 2', MaxHP = 2400, CurrentHP = 2400,
					Color = Color3.fromRGB(180, 120, 240) },
			})
		end,
	},
	{
		name = 'shielded', label = 'shielded (shield + hp)',
		run = function()
			local bh = getBossHealthbar(); if not bh then return end
			bh.SetBoss('Shielded Boss', {
				{ Id = 'shield', Name = 'Shield', MaxHP = 600, CurrentHP = 600,
					Color = Color3.fromRGB(120, 180, 255) },
				{ Id = 'hp', Name = 'Health', MaxHP = 1800, CurrentHP = 1800,
					Color = Color3.fromRGB(220, 70, 80) },
			})
		end,
	},
	{
		name = 'tick_damage', label = 'tick: -150 hp on bar 1',
		-- Pokes UpdateBar on whichever boss is currently shown. Reads
		-- the live HP via a peek — fine for a debug ticker, even if
		-- it's not the cleanest pattern (production code should drive
		-- HP from authoritative server state).
		run = function()
			local bh = getBossHealthbar(); if not bh then return end
			-- Try common test ids in priority order. Whichever is live
			-- gets the tick; the others silently no-op via UpdateBar's
			-- missing-id guard.
			for _, id in { 'main', 'shield', 'hp', 'p1', 'p2' } do
				bh.UpdateBar(id, math.random(0, 2400))
			end
		end,
	},
	{
		name = 'remove_first', label = 'remove first bar',
		run = function()
			local bh = getBossHealthbar(); if not bh then return end
			-- Same brute-force approach as the tick: try the canonical
			-- first-bar ids; only one will match.
			for _, id in { 'shield', 'p1', 'main' } do
				bh.RemoveBar(id)
			end
		end,
	},
	{
		name = 'close', label = 'close',
		run = function()
			local bh = getBossHealthbar(); if not bh then return end
			bh.CloseWidget()
		end,
	},
}

local function bossHealthbarButtons(scope)
	local btns = {}
	for i, preset in TestBossPresets do
		btns[#btns + 1] = scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			[Fusion.Children] = { buttonRow(scope, preset.label, preset.run) },
		}
	end
	return btns
end

----------------------------------------------------------------------
-- Panel build. Right-side anchored, scrollable so a long preset list
-- doesn't push off the bottom of the screen.
----------------------------------------------------------------------
local function buildPanel(scope)
	local panel = HUDCommon.chiseledPanel(scope, {
		Name = 'CinematicTestPanel',
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(280, 600),
		AccentColor = PALETTE.gold,
		Children = {
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(0, 12),
				PaddingBottom = UDim.new(0, 12),
				PaddingLeft   = UDim.new(0, 10),
				PaddingRight  = UDim.new(0, 10),
			},
			scope:New('ScrollingFrame') {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ScrollBarThickness = 4,
				CanvasSize = UDim2.new(),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollBarImageColor3 = PALETTE.accent,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding       = UDim.new(0, 10),
						SortOrder     = Enum.SortOrder.LayoutOrder,
					},

					HUDCommon.eyebrowLabel(scope, {
						Text = 'CINEMATIC TEST', Color = PALETTE.gold,
						Size = UDim2.new(1, 0, 0, 16), TextSize = 12, LayoutOrder = 0,
					}),

					scope:New('Frame') {
						LayoutOrder = 1,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundTransparency = 1,
						[Fusion.Children] = { sectionFrame(scope, 'cinematics', cinematicButtons(scope)) },
					},
					scope:New('Frame') {
						LayoutOrder = 2,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundTransparency = 1,
						[Fusion.Children] = { sectionFrame(scope, 'shake', shakeButtons(scope)) },
					},
					scope:New('Frame') {
						LayoutOrder = 3,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundTransparency = 1,
						[Fusion.Children] = { sectionFrame(scope, 'vfx', vfxButtons(scope)) },
					},
					scope:New('Frame') {
						LayoutOrder = 4,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundTransparency = 1,
						[Fusion.Children] = { sectionFrame(scope, 'camera shots', shotButtons(scope)) },
					},
					scope:New('Frame') {
						LayoutOrder = 5,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundTransparency = 1,
						[Fusion.Children] = { sectionFrame(scope, 'dialogue', dialogueButtons(scope)) },
					},
					scope:New('Frame') {
						LayoutOrder = 6,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundTransparency = 1,
						[Fusion.Children] = { sectionFrame(scope, 'boss healthbar', bossHealthbarButtons(scope)) },
					},
					-- New: skill-runtime debug surfaces.
					scope:New('Frame') {
						LayoutOrder = 7,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundTransparency = 1,
						[Fusion.Children] = { sectionFrame(scope, 'telegraphs', telegraphButtons(scope)) },
					},
					scope:New('Frame') {
						LayoutOrder = 8,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundTransparency = 1,
						[Fusion.Children] = { sectionFrame(scope, 'recipes', recipeButtons(scope)) },
					},
					scope:New('Frame') {
						LayoutOrder = 9,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundTransparency = 1,
						[Fusion.Children] = { sectionFrame(scope, 'spawn mobs', mobSpawnButtons(scope)) },
					},
					scope:New('Frame') {
						LayoutOrder = 10,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundTransparency = 1,
						[Fusion.Children] = { sectionFrame(scope, 'boss phase', bossPhaseButtons(scope)) },
					},
				},
			},
		},
	})
	panel.Parent = ScreenGui
	return panel
end

----------------------------------------------------------------------
-- Public open / close.
----------------------------------------------------------------------
function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true
	ScreenGui = HUDCommon.ensureScreenGui('HUD_CinematicTest', 90)
	RootScope = scoped(Fusion)
	SnapState = RootScope:Value(false)
	buildPanel(RootScope)
end

function Module.CloseWidget()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
end

function Module.ToggleWidget()
	if Module.IsOpen then Module.CloseWidget() else Module.OpenWidget() end
end

-- Build the persistent purple toggle button. Bottom-center, just above
-- the hotbar (hotbar root sits at scale-Y 0.98; this button at 0.78 so
-- it clears the hotbar's tallest cluster). Click → ToggleWidget.
-- The button auto-hides whenever the inventory/menu TabWidget is open
-- (so it doesn't overlap the modal). Tab open state is polled on
-- Heartbeat — TabWidget exposes a function, not a Fusion Value, so
-- there's no observable to bind.
local function buildToggleButton()
	ToggleScreenGui = HUDCommon.ensureScreenGui('HUD_CinematicTestToggle', 89)
	ToggleScope = scoped(Fusion)
	local btn = ToggleScope:New('TextButton') {
		Name = 'CinematicTestToggle',
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 0.78),
		Size = UDim2.fromOffset(140, 28),
		BackgroundColor3 = PALETTE.violet,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		FontFace = HUDCommon.FONT_UI,
		TextSize = 13,
		TextColor3 = Color3.new(1, 1, 1),
		Text = 'Cinematic Test (F4)',
		Parent = ToggleScreenGui,
		[Fusion.OnEvent('Activated')] = function() Module.ToggleWidget() end,
		[Fusion.Children] = {
			ToggleScope:New('UICorner') { CornerRadius = UDim.new(0, 4) },
			ToggleScope:New('UIStroke') {
				Color = PALETTE.violet, Transparency = 0.2, Thickness = 1,
			},
		},
	}

	-- Hide whenever the TabWidget (inventory/menu) is open. Polled
	-- on a low-frequency loop (every 0.1s) — 10× per second is plenty
	-- for "is the menu open?". HUDCommon.ensureScreenGui returns a
	-- Frame parent (the shared HUD frame), not a real ScreenGui — so
	-- we toggle Visible on the BUTTON itself rather than reaching for
	-- a non-existent ScreenGui.Enabled property.
	task.spawn(function()
		while btn and btn.Parent do
			local TabWidget = SystemsContainer.TabWidget
				or (SystemsContainer.ParentSystems
					and SystemsContainer.ParentSystems.Widgets
					and SystemsContainer.ParentSystems.Widgets.TabWidget)
			local menuOpen = TabWidget and TabWidget.IsWidgetOpen and TabWidget.IsWidgetOpen() or false
			local desired = not menuOpen
			if btn.Visible ~= desired then btn.Visible = desired end
			task.wait(0.1)
		end
	end)

	return btn
end

function Module.Start()
	-- F4 toggles the panel; the on-screen purple button does the same.
	-- Panel starts closed regardless of Studio/live — open it explicitly
	-- via the button or F4.
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == Enum.KeyCode.F4 then Module.ToggleWidget() end
	end)
	buildToggleButton()
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/CombatLogWidget.luau"><![CDATA[-- Combat-log indicator pill (bottom-left corner).
--
-- Visible while CombatLog.IsInCombat() is true — mirrors the MusicWidget
-- pill shape (chiseled panel + UIAspectRatioConstraint + Scale-sized
-- corner anchor) so the HUD vocabulary stays consistent. The progress
-- bar drains the COMBAT_LOG_DURATION countdown; when it hits zero the
-- pill fades out via CanvasGroup transparency.
--
-- Why a separate widget (vs. baking into HotbarWidget):
--   * Independently positioned at a corner, not inside the hotbar cluster.
--   * Subscribes to CombatLog without coupling combat UI to hotbar state.
--   * Lives long enough across deaths/respawns that fade-in/out reads
--     coherently — Hotbar rebuilds its scope on respawn.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local RunService = game:GetService('RunService')
local TweenService = game:GetService('TweenService')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local doCleanup = Fusion.doCleanup

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local CombatLog = LocalModules.Modules.CombatLog
local PALETTE = HUDCommon.PALETTE

local SystemsContainer = {}

local Module = {}
Module.IsOpen = false

local RootScope = nil
local ScreenGui = nil
local InCombat   = nil -- Value<boolean>
local Remaining  = nil -- Value<number>   seconds left in the combat-log window
local DrainAlpha = nil -- Value<number>   1 = full bar, 0 = empty

----------------------------------------------------------------------
-- Design dimensions (pixels on a 1920×1080 reference canvas).
-- Mirrors MusicWidget; see that file for the design rationale (Scale-
-- sized pill + aspect-lock so the inner pixel design is stable).
----------------------------------------------------------------------
local DESIGN_SCREEN_W, DESIGN_SCREEN_H = 1920, 1080

local DESIGN_PILL_W, DESIGN_PILL_H = 280, 70
local DESIGN_PILL_PAD_X            = 14
local DESIGN_PILL_PAD_Y            = 10

local DESIGN_EYEBROW_H = 12
local DESIGN_TITLE_H   = 22
local DESIGN_BAR_H     = 6
local DESIGN_TIMER_W   = 70
local DESIGN_META_H    = 14
local DESIGN_TITLE_GAP = 4
local DESIGN_BAR_GAP   = 4

local DESIGN_CONTENT_W = DESIGN_PILL_W - 2 * DESIGN_PILL_PAD_X
local DESIGN_CONTENT_H = DESIGN_PILL_H - 2 * DESIGN_PILL_PAD_Y

-- Anchor BOTTOM-LEFT (vs MusicWidget's bottom-right) so the two pills
-- live on opposite corners and never overlap.
local ANCHOR_INSET_X = 20 / DESIGN_SCREEN_W
local ANCHOR_INSET_Y = 20 / DESIGN_SCREEN_H

function Module.IsWidgetOpen(): boolean
	return Module.IsOpen and ScreenGui ~= nil
end

local function buildUI(scope)
	-- CanvasGroup wrapper so we can fade the entire pill in/out by
	-- tweening GroupTransparency rather than per-descendant transparency.
	-- The Tween reads use(InCombat) so it animates automatically when
	-- combat state flips.
	local fadeAlpha = scope:Computed(function(use)
		return use(InCombat) and 0 or 1
	end)
	local tweenedAlpha = scope:Tween(
		fadeAlpha,
		TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	)

	local pill = HUDCommon.chiseledPanel(scope, {
		Name = 'CombatLogPill',
		Size = UDim2.fromScale(DESIGN_PILL_W / DESIGN_SCREEN_W, DESIGN_PILL_H / DESIGN_SCREEN_H),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(ANCHOR_INSET_X, 1 - ANCHOR_INSET_Y),
		AccentColor = PALETTE.danger,
		AspectRatio = DESIGN_PILL_W / DESIGN_PILL_H,
		Children = {
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(DESIGN_PILL_PAD_Y / DESIGN_PILL_H, 0),
				PaddingBottom = UDim.new(DESIGN_PILL_PAD_Y / DESIGN_PILL_H, 0),
				PaddingLeft   = UDim.new(DESIGN_PILL_PAD_X / DESIGN_PILL_W, 0),
				PaddingRight  = UDim.new(DESIGN_PILL_PAD_X / DESIGN_PILL_W, 0),
			},

			-- Eyebrow "⚔ IN COMBAT" — danger color so the player's eye
			-- catches the warning quickly. Same eyebrow vocabulary as
			-- the music pill's "♪ NOW PLAYING".
			HUDCommon.eyebrowLabel(scope, {
				Text = '\u{2694} IN COMBAT',
				Color = PALETTE.danger,
				Size = UDim2.fromScale(1, DESIGN_EYEBROW_H / DESIGN_CONTENT_H),
				TextSize = 11,
			}),

			-- Title row — descriptive sub-text. Static for now; this is
			-- a candidate slot for richer messaging later (e.g. "Hit by
			-- Boar", "PvP engagement"). Pulled from a Computed so any
			-- future state-driven text drops in cleanly.
			scope:New('TextLabel') {
				Name = 'Title',
				Position = UDim2.fromScale(0, (DESIGN_EYEBROW_H + DESIGN_TITLE_GAP) / DESIGN_CONTENT_H),
				Size = UDim2.fromScale(1, DESIGN_TITLE_H / DESIGN_CONTENT_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				TextSize = 16,
				TextColor3 = PALETTE.ink,
				Text = 'Cannot fast-travel',
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
				TextTruncate = Enum.TextTruncate.AtEnd,
			},

			-- Countdown readout, anchored bottom-right above the bar.
			-- "5.3s" style — 1-decimal formatting so the bar tick reads
			-- as a smooth number rather than a jumpy integer.
			scope:New('TextLabel') {
				Name = 'Timer',
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.fromScale(1, 1 - (DESIGN_BAR_H + DESIGN_BAR_GAP) / DESIGN_CONTENT_H),
				Size = UDim2.fromScale(DESIGN_TIMER_W / DESIGN_CONTENT_W, DESIGN_META_H / DESIGN_CONTENT_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				TextSize = 12,
				TextColor3 = PALETTE.danger,
				Text = scope:Computed(function(use)
					return string.format('%.1fs', math.max(0, use(Remaining) or 0))
				end),
				TextXAlignment = Enum.TextXAlignment.Right,
				TextYAlignment = Enum.TextYAlignment.Center,
			},

			-- Drain bar pinned to bottom of content area. Width tracks
			-- DrainAlpha (1 = fresh combat, 0 = window expired) so the
			-- bar visually retreats as combat-log expires.
			scope:New('Frame') {
				Name = 'Progress',
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.fromScale(0, 1),
				Size = UDim2.fromScale(1, DESIGN_BAR_H / DESIGN_CONTENT_H),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.3,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					scope:New('Frame') {
						Name = 'Bar',
						Size = scope:Computed(function(use)
							return UDim2.fromScale(math.clamp(use(DrainAlpha) or 0, 0, 1), 1)
						end),
						BackgroundColor3 = PALETTE.danger,
						BorderSizePixel = 0,
					},
				},
			},
		},
	})

	-- Wrap the pill in a CanvasGroup so the fade tween applies uniformly
	-- to every descendant in a single pass. Always Visible — the fade
	-- alone hides the pill (GroupTransparency=1 → fully invisible). The
	-- pill has no interactive children so we don't need to gate input.
	local root = scope:New('CanvasGroup') {
		Name = 'CombatLogRoot',
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(ANCHOR_INSET_X, 1 - ANCHOR_INSET_Y),
		Size = UDim2.fromScale(DESIGN_PILL_W / DESIGN_SCREEN_W, DESIGN_PILL_H / DESIGN_SCREEN_H),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		GroupTransparency = tweenedAlpha,
		[Fusion.Children] = {
			scope:New('UIAspectRatioConstraint') {
				AspectRatio = DESIGN_PILL_W / DESIGN_PILL_H,
				AspectType = Enum.AspectType.FitWithinMaxSize,
				DominantAxis = Enum.DominantAxis.Width,
			},
		},
	}
	-- Reparent the pill INTO the CanvasGroup; the chiseledPanel above
	-- carries its own pixel design so we just override its position to
	-- sit at (0,0) inside the wrapper and let the wrapper handle the
	-- screen-corner anchoring.
	pill.AnchorPoint = Vector2.new(0, 0)
	pill.Position = UDim2.fromScale(0, 0)
	pill.Size = UDim2.fromScale(1, 1)
	pill.Parent = root
	root.Parent = ScreenGui
end

function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true
	ScreenGui = HUDCommon.ensureScreenGui('HUD_CombatLog', 5)
	RootScope = scoped(Fusion)

	InCombat   = RootScope:Value(false)
	Remaining  = RootScope:Value(0)
	DrainAlpha = RootScope:Value(0)

	buildUI(RootScope)
end

function Module.CloseWidget()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
end

function Module.Start()
	-- Single Heartbeat watcher. CombatLog.IsInCombat is process-cheap
	-- (timestamp subtract) so polling at frame-rate is fine — no need
	-- for an event-driven Bump signal here.
	RunService.Heartbeat:Connect(function()
		if not Module.IsWidgetOpen() then return end
		local inCombat = CombatLog.IsInCombat()
		local remaining = CombatLog.SecondsRemaining()
		local total = CombatLog.COMBAT_LOG_DURATION
		InCombat:set(inCombat)
		Remaining:set(remaining)
		DrainAlpha:set(total > 0 and (remaining / total) or 0)
	end)

	HUDCommon.BindLiveTheme(Module)

	task.defer(Module.OpenWidget)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/CompassWidget.luau"><![CDATA[-- CompassWidget — top-of-screen waypoint projection strip.
--
-- For every active waypoint (CollectionService 'Workstation' + each
-- UNLOCKED 'Waystones' from PlayerData.Waystones), projects its world
-- position onto a horizontal strip across the top of the HUD. The
-- strip is camera-relative: a waypoint dead-ahead sits at the center,
-- shifts left/right as the camera turns, and fades out near the edges
-- as it exits the visible angle range.
--
-- A marker centered under the strip's tick (within CENTER_ANGLE_DEG of
-- the camera-forward azimuth) reveals a tooltip pill below the strip
-- naming the waypoint — quick "what am I looking at" feedback without
-- forcing the player to open the map.
--
-- Visibility:
--   SettingsRegistry.CompassEnabled — Open/Close cycle on toggle. Same
--   pattern MinimapWidget uses (see SettingsTab row 'compass').
--
-- Source of truth:
--   * Workstations: CollectionService tag 'Workstation' +
--     `WorkstationKind` attribute → WaypointsData.Workstations[kind]
--     (label + icon + color, with WorkstationDefault as fallback).
--   * Waystones:    CollectionService tag WaystonesData.WaystonesTag
--     gated by PlayerData.Waystones membership +
--     WaystonesData.WaystoneDisplays for the friendly label.

local CollectionService = game:GetService('CollectionService')
local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local RunService = game:GetService('RunService')
local Workspace = game:GetService('Workspace')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local doCleanup = Fusion.doCleanup

local WaypointsData   = ReplicatedModules.Data.Waypoints
local WaystonesData   = ReplicatedModules.Data.Waystones
local SubstationsData = ReplicatedModules.Data.Substations
local ReplicatedData  = ReplicatedModules.Services.ReplicatedData

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local SettingsRegistry = LocalModules.Modules.SettingsRegistry
local PALETTE = HUDCommon.PALETTE

local SystemsContainer = {}

local Module = {}
Module.IsOpen = false

----------------------------------------------------------------------
-- Design dimensions. The compass mirrors the minimap's pattern: a
-- pixel-fixed inner panel positioned via Scale offsets so it sits in
-- the right spot on every screen size. The panel itself is small —
-- a strip — so we keep its inner geometry in pixels.
----------------------------------------------------------------------
local DESIGN_SCREEN_W = 1920
local DESIGN_STRIP_W  = 720    -- visible strip width (pixels at design res)
local DESIGN_STRIP_H  = 28
local DESIGN_TOP_INSET = 16    -- gap from the top of the viewport

-- Half-width of the angular slice rendered onto the strip. A waypoint
-- between -VISIBLE_HALF and +VISIBLE_HALF degrees of camera-forward
-- maps linearly across the strip. Outside that range the marker is
-- clipped (rendering is suppressed). 90° matches a "looking around"
-- field of awareness — what's in the player's general front hemisphere.
local VISIBLE_HALF_DEG = 90

-- Tooltip activates when a marker is within this many degrees of the
-- camera-forward axis (i.e. roughly under the central tick mark).
local CENTER_ANGLE_DEG = 6

-- Edge fade: markers fade in over this many degrees as they enter the
-- visible range, keeping pop-in subtle.
local EDGE_FADE_DEG    = 15

----------------------------------------------------------------------
-- Widget state.
----------------------------------------------------------------------
local ScreenGui: GuiObject?      = nil
local StripFrame: Frame?         = nil
local TooltipFrame: Frame?       = nil
local TooltipLabel: TextLabel?   = nil
local RootScope: any             = nil

-- One marker per waypoint. Each entry holds the rendered Frame plus
-- enough metadata to skip work when the underlying waypoint hasn't
-- moved. Keyed by the waypoint's world Model so tag-removal cleanup
-- can drop entries in O(1).
type MarkerEntry = {
	Frame: Frame,
	IconLabel: TextLabel,
	Name: string,
	Color: Color3,
	-- Attachment under the model's host BasePart, pinned to the
	-- pivot. We project from the attachment's WorldPosition so the
	-- compass marker tracks the model's true center even if the host
	-- part isn't centered on the model (waystone base plates, etc.).
	-- We also OWN this attachment — despawnMarker destroys it.
	Anchor: Attachment,
	Category: 'workstation' | 'waystone' | 'substation',
}
local Markers: { [Instance]: MarkerEntry } = {}

----------------------------------------------------------------------
-- Helpers.
----------------------------------------------------------------------

-- Pick the BasePart that hosts the compass-anchor Attachment. Same
-- fallback rule as WaypointsClient: PrimaryPart first, otherwise the
-- first BasePart descendant. Models with no BasePart anywhere can't
-- host an attachment, so they're rejected.
local function hostPartOf(model: Instance): BasePart?
	if model:IsA('BasePart') then return model end
	if model:IsA('Model') then
		if model.PrimaryPart then return model.PrimaryPart end
		for _, d in model:GetDescendants() do
			if d:IsA('BasePart') then return d end
		end
	end
	return nil
end

-- Anchor the projection at the model's geometric center via an
-- Attachment under the host BasePart. Each compass marker keeps its
-- own Attachment ('CompassAnchor') so it doesn't fight the
-- WaypointsClient's 'WaypointAnchor' attachment over the same name —
-- both can coexist on the same host part.
local function createPivotAttachment(model: Instance, host: BasePart): Attachment
	local existing = host:FindFirstChild('CompassAnchor')
	local att: Attachment
	if existing and existing:IsA('Attachment') then
		att = existing
	else
		att = Instance.new('Attachment')
		att.Name = 'CompassAnchor'
		att.Parent = host
	end
	att.WorldPosition = (model :: any):GetPivot().Position
	return att
end

local function isWaystoneUnlocked(waystoneId: string): boolean
	local data = ReplicatedData.GetData('PlayerData', false)
	if typeof(data) ~= 'table' or typeof(data.Waystones) ~= 'table' then
		return false
	end
	for _, id in data.Waystones do
		if id == waystoneId then return true end
	end
	return false
end

----------------------------------------------------------------------
-- Marker construction. One small TextLabel for the icon glyph, no
-- background (the strip's own bar provides the visual context). The
-- label sits inside an outer Frame so we can scale Position + alpha
-- independently from the icon's intrinsic size.
----------------------------------------------------------------------
local function buildMarker(scope: any, label: string, icon: string, color: Color3): (Frame, TextLabel)
	local frame = scope:New('Frame') {
		Name = 'CompassMarker',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(20, 20),
		BackgroundTransparency = 1,
		ZIndex = 4,
	}
	frame.Parent = StripFrame

	local iconLabel = scope:New('TextLabel') {
		Name = 'Icon',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_DISPLAY,
		Text = icon,
		TextScaled = true,
		TextColor3 = color,
		TextStrokeColor3 = Color3.new(0, 0, 0),
		TextStrokeTransparency = 0.4,
	}
	iconLabel.Parent = frame

	-- Hidden until projection lands in the visible range; refresh()
	-- flips Visible + writes Position each tick.
	frame.Visible = false
	-- Reserved-for-future: per-marker hover label could use this name.
	local _ = label
	return frame, iconLabel
end

----------------------------------------------------------------------
-- Spawn / despawn lifecycle. Mirrors WaypointsClient's signal hookups
-- so the compass appears/disappears in lockstep with the world markers
-- (PlayerData unlock for waystones, instance-added for workstations).
----------------------------------------------------------------------
local function spawnWorkstationMarker(model: Instance)
	if not StripFrame or not RootScope then return end
	if Markers[model] then return end
	local host = hostPartOf(model)
	if not host then return end
	local kind = model:GetAttribute('WorkstationKind')
	local cfg = (typeof(kind) == 'string' and WaypointsData.Workstations[kind])
		or WaypointsData.WorkstationDefault
	local frame, iconLabel = buildMarker(RootScope, cfg.Label, cfg.Icon, cfg.Color)
	local anchor = createPivotAttachment(model, host)
	Markers[model] = {
		Frame = frame, IconLabel = iconLabel,
		Name = cfg.Label, Color = cfg.Color,
		Anchor = anchor, Category = 'workstation',
	}
end

local function spawnSubstationMarker(model: Instance)
	if not StripFrame or not RootScope then return end
	if Markers[model] then return end
	local host = hostPartOf(model)
	if not host then return end
	local kind = model:GetAttribute(SubstationsData.AttributeKind)
	local cfg = (typeof(kind) == 'string' and SubstationsData.Kinds[kind])
		or SubstationsData.Default
	local frame, iconLabel = buildMarker(RootScope, cfg.Label, cfg.Icon, cfg.Color)
	local anchor = createPivotAttachment(model, host)
	Markers[model] = {
		Frame = frame, IconLabel = iconLabel,
		Name = cfg.Label, Color = cfg.Color,
		Anchor = anchor, Category = 'substation',
	}
end

local function spawnWaystoneMarker(model: Instance)
	if not StripFrame or not RootScope then return end
	if Markers[model] then return end
	-- Waystone id resolution mirrors WaypointsClient: attribute first,
	-- model name fallback against WaystoneDisplays. Skip if neither
	-- yields a known id (gameplay never wants to surface unknown data).
	local waystoneId: string? = model:GetAttribute('WaystoneId')
	if typeof(waystoneId) ~= 'string' or waystoneId == '' then
		if WaystonesData.WaystoneDisplays[model.Name] then
			waystoneId = model.Name
		else
			return
		end
	end
	if not isWaystoneUnlocked(waystoneId :: string) then return end
	local host = hostPartOf(model)
	if not host then return end
	local cfg = WaystonesData.WaystoneDisplays[waystoneId]
	local label = (cfg and cfg.Name) or waystoneId
	local style = WaypointsData.WaystoneStyle
	local frame, iconLabel = buildMarker(RootScope, label, style.Icon, style.Color)
	local anchor = createPivotAttachment(model, host)
	Markers[model] = {
		Frame = frame, IconLabel = iconLabel,
		Name = label, Color = style.Color,
		Anchor = anchor, Category = 'waystone',
	}
end

local function despawnMarker(model: Instance)
	local entry = Markers[model]
	if not entry then return end
	if entry.Frame then entry.Frame:Destroy() end
	-- Tear down the attachment we created. WaypointsClient owns its
	-- own 'WaypointAnchor' attachment under a different name, so this
	-- never deletes that one.
	if entry.Anchor then entry.Anchor:Destroy() end
	Markers[model] = nil
end

local function refreshWaystoneMarkers()
	-- Newly-unlocked waystones spawn; already-shown stay. Locked
	-- waystones never had a marker, so there's nothing to remove.
	for _, model in CollectionService:GetTagged(WaystonesData.WaystonesTag) do
		if not Markers[model] then
			spawnWaystoneMarker(model)
		end
	end
end

----------------------------------------------------------------------
-- Per-frame projection. For each marker, computes the signed yaw
-- between the camera-forward direction and the camera→waypoint
-- direction (projected onto the horizontal plane), maps it onto the
-- strip's [-0.5, +0.5] X-fraction, and updates Position + transparency.
--
-- Returns the marker entry whose absolute angle is smallest AND below
-- CENTER_ANGLE_DEG so the tooltip can name it. Nil if nothing is near
-- the center reticle.
----------------------------------------------------------------------
local function refresh(): MarkerEntry?
	if not StripFrame or not StripFrame.Visible then return nil end
	local camera = Workspace.CurrentCamera
	if not camera then return nil end

	local camCF = camera.CFrame
	local camPos = camCF.Position
	-- Camera forward / right on the horizontal plane. Y-flatten the
	-- look vector before normalizing so a steep pitch (looking up at
	-- the sky) doesn't swing the compass wildly — only yaw matters.
	local lookFlat = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
	if lookFlat.Magnitude < 1e-4 then return nil end
	lookFlat = lookFlat.Unit
	-- Right vector derived from a flat up cross with lookFlat. Stays
	-- horizontal regardless of camera roll.
	local rightFlat = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
	if rightFlat.Magnitude < 1e-4 then
		-- Degenerate (camera pointing straight up): fall back to a
		-- world-axis right so we don't divide by zero.
		rightFlat = Vector3.new(1, 0, 0)
	else
		rightFlat = rightFlat.Unit
	end

	local centeredEntry: MarkerEntry? = nil
	local centeredAbs = math.huge

	for model, entry in Markers do
		-- Defensive: tag-removed signals should have cleaned this up
		-- already, but a parent re-parented out of workspace can miss.
		if not entry.Anchor or not entry.Anchor.Parent then
			despawnMarker(model)
			continue
		end

		-- Attachments expose WorldPosition in absolute coordinates,
		-- so we don't have to compose the host part's CFrame ourselves.
		local toWp = entry.Anchor.WorldPosition - camPos
		local flat = Vector3.new(toWp.X, 0, toWp.Z)
		if flat.Magnitude < 1e-4 then
			entry.Frame.Visible = false
			continue
		end
		flat = flat.Unit

		-- Signed yaw via dot(forward) for the cosine and dot(right)
		-- for the sign. atan2(sin, cos) recovers the signed angle in
		-- radians, where positive = right-of-forward, negative = left.
		local cos = math.clamp(flat:Dot(lookFlat), -1, 1)
		local sin = math.clamp(flat:Dot(rightFlat), -1, 1)
		local rad = math.atan2(sin, cos)
		local deg = math.deg(rad)
		local absDeg = math.abs(deg)

		if absDeg > VISIBLE_HALF_DEG then
			entry.Frame.Visible = false
			continue
		end

		-- Strip mapping: -VISIBLE_HALF_DEG → 0.0 (left edge),
		-- 0° → 0.5 (center), +VISIBLE_HALF_DEG → 1.0 (right edge).
		local frac = 0.5 + (deg / (VISIBLE_HALF_DEG * 2))
		entry.Frame.Position = UDim2.new(frac, 0, 0.5, 0)

		-- Edge fade: full opacity through the inner ±(VISIBLE - FADE)
		-- range, then fades over the last EDGE_FADE_DEG before clipping.
		local fadeStart = VISIBLE_HALF_DEG - EDGE_FADE_DEG
		local alpha = 1
		if absDeg > fadeStart then
			alpha = 1 - ((absDeg - fadeStart) / EDGE_FADE_DEG)
			alpha = math.clamp(alpha, 0, 1)
		end
		entry.IconLabel.TextTransparency = 1 - alpha
		entry.IconLabel.TextStrokeTransparency = math.clamp(0.4 + (1 - alpha) * 0.6, 0, 1)
		entry.Frame.Visible = true

		-- Track the closest-to-center marker for tooltip selection.
		if absDeg < CENTER_ANGLE_DEG and absDeg < centeredAbs then
			centeredEntry = entry
			centeredAbs = absDeg
		end
	end

	return centeredEntry
end

----------------------------------------------------------------------
-- Strip + tooltip construction.
----------------------------------------------------------------------
local function buildStrip(scope: any): Frame
	-- Center tick — vertical line at strip middle marking "where the
	-- camera is looking." Helps the player parse the tooltip's
	-- "centered on" semantics at a glance.
	local centerTick = scope:New('Frame') {
		Name = 'CenterTick',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(2, 18),
		BackgroundColor3 = PALETTE.accent,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		ZIndex = 5,
	}

	-- Lateral fade gradient via UIGradient — markers near the edges
	-- visually dissolve into the strip background, reinforcing the
	-- edge-fade alpha applied in refresh().
	local gradient = scope:New('UIGradient') {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0,    Color3.new(0, 0, 0)),
			ColorSequenceKeypoint.new(0.08, PALETTE.bg0),
			ColorSequenceKeypoint.new(0.5,  PALETTE.bg0),
			ColorSequenceKeypoint.new(0.92, PALETTE.bg0),
			ColorSequenceKeypoint.new(1,    Color3.new(0, 0, 0)),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0,    1),
			NumberSequenceKeypoint.new(0.08, 0.5),
			NumberSequenceKeypoint.new(0.5,  0.4),
			NumberSequenceKeypoint.new(0.92, 0.5),
			NumberSequenceKeypoint.new(1,    1),
		}),
	}

	local strip = scope:New('Frame') {
		Name = 'CompassStrip',
		AnchorPoint = Vector2.new(0.5, 0),
		-- Top-center anchored, with the design top-inset converted to a
		-- fraction of the design canvas so the gap scales with screen
		-- height (matches the rest of the HUD's aspect-locked widgets).
		Position = UDim2.fromScale(0.5, DESIGN_TOP_INSET / 1080),
		-- Strip width as a fraction of design canvas width so we follow
		-- the aspect-lock convention used by other HUD widgets.
		Size = UDim2.new(DESIGN_STRIP_W / DESIGN_SCREEN_W, 0, 0, DESIGN_STRIP_H),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.4,
		BorderSizePixel = 0,
		ZIndex = 3,
		[Fusion.Children] = {
			gradient,
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.6, Thickness = 1 },
			centerTick,
		},
	}
	return strip
end

local function buildTooltip(scope: any): (Frame, TextLabel)
	local label
	local frame = scope:New('Frame') {
		Name = 'CompassTooltip',
		AnchorPoint = Vector2.new(0.5, 0),
		-- Sits directly under the strip with a small gap.
		Position = UDim2.fromScale(0.5, (DESIGN_TOP_INSET + DESIGN_STRIP_H + 4) / 1080),
		Size = UDim2.fromOffset(180, 22),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 6,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
			},
		},
	}
	label = scope:New('TextLabel') {
		Name = 'Label',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_UI,
		Text = '',
		TextSize = 12,
		TextColor3 = PALETTE.ink,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}
	label.Parent = frame
	return frame, label
end

----------------------------------------------------------------------
-- Lifecycle.
----------------------------------------------------------------------
function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true
	ScreenGui = HUDCommon.ensureScreenGui('HUD_Compass', 5)
	RootScope = scoped(Fusion)

	StripFrame = buildStrip(RootScope)
	StripFrame.Parent = ScreenGui

	local tipFrame, tipLabel = buildTooltip(RootScope)
	tipFrame.Parent = ScreenGui
	TooltipFrame = tipFrame
	TooltipLabel = tipLabel

	-- Seed every currently-tagged waypoint. Subsequent additions go
	-- through the Start-time CollectionService listeners.
	for _, m in CollectionService:GetTagged('Workstation') do
		spawnWorkstationMarker(m)
	end
	for _, m in CollectionService:GetTagged(WaystonesData.WaystonesTag) do
		spawnWaystoneMarker(m)
	end
	for _, m in CollectionService:GetTagged(SubstationsData.Tag) do
		spawnSubstationMarker(m)
	end
end

function Module.CloseWidget()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	-- Drop every marker frame; they're parented under StripFrame so
	-- the parent destroy below would catch them, but explicit
	-- iteration also clears the Markers map.
	for inst in Markers do
		despawnMarker(inst)
	end
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
	StripFrame = nil
	TooltipFrame = nil
	TooltipLabel = nil
end

function Module.Start()
	-- Tag listeners — kept always-live so reopening the widget after a
	-- toggle reseeds Markers from the up-to-date tag set without
	-- re-walking from Start. Despawn handlers run regardless of
	-- Module.IsOpen so the Markers table stays accurate.
	CollectionService:GetInstanceAddedSignal('Workstation'):Connect(function(m)
		if Module.IsOpen then spawnWorkstationMarker(m) end
	end)
	CollectionService:GetInstanceRemovedSignal('Workstation'):Connect(despawnMarker)

	local WAYSTONE_TAG = WaystonesData.WaystonesTag
	CollectionService:GetInstanceAddedSignal(WAYSTONE_TAG):Connect(function(m)
		if Module.IsOpen then spawnWaystoneMarker(m) end
	end)
	CollectionService:GetInstanceRemovedSignal(WAYSTONE_TAG):Connect(despawnMarker)

	local SUBSTATION_TAG = SubstationsData.Tag
	CollectionService:GetInstanceAddedSignal(SUBSTATION_TAG):Connect(function(m)
		if Module.IsOpen then spawnSubstationMarker(m) end
	end)
	CollectionService:GetInstanceRemovedSignal(SUBSTATION_TAG):Connect(despawnMarker)

	-- Re-seed waystones when PlayerData replicates (newly unlocked).
	ReplicatedData.OnUpdated:Connect(function(category)
		if category == 'PlayerData' and Module.IsOpen then
			refreshWaystoneMarkers()
		end
	end)

	-- Per-frame projection. Heartbeat (post-physics) is appropriate —
	-- the camera's CFrame is settled by the time Heartbeat fires.
	-- Tooltip update cohabits the same step so the label tracks the
	-- centered marker without drift.
	RunService.Heartbeat:Connect(function()
		if not Module.IsOpen then return end
		local centered = refresh()
		if TooltipFrame and TooltipLabel then
			if centered then
				TooltipLabel.Text = centered.Name
				TooltipLabel.TextColor3 = centered.Color
				TooltipFrame.Visible = true
			else
				TooltipFrame.Visible = false
			end
		end
	end)

	-- Settings toggle + initial state.
	SettingsRegistry.Changed:Connect(function(key, value)
		if key ~= 'CompassEnabled' then return end
		if value then
			Module.OpenWidget()
		else
			Module.CloseWidget()
		end
	end)

	task.defer(function()
		if SettingsRegistry.CompassEnabled then
			Module.OpenWidget()
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/DialogueWidget.luau"><![CDATA[-- NPC dialogue widget -- walks a dialogue tree from ReplicatedModules.Data.Dialogue
-- Node types: MultiOption, Action, Conditional, Exit. Tree walk is client-local.
--
-- Layout strategy (see .claude/skills/custom-roblox-ui/SKILL.md):
--   * Top-level DialoguePanel anchors bottom-center (AnchorPoint(0.5, 1)) with a
--     scaled pixel inset from the bottom. Width is pixel-exact (DESIGN_PANEL_W)
--     and height grows with content via AutomaticSize.Y so the panel absorbs
--     long body text and variable-count option lists without squashing.
--   * Inside: a vertical UIListLayout stacks eyebrow + speaker + body + options,
--     with scale/pixel-offset paddings derived from DESIGN_* constants.
--   * The body TextLabel uses TextWrapped + AutomaticSize.Y so wraps expand
--     the panel rather than clipping.
--   * Each option button is pixel-width (matches inner width) + AutomaticSize.Y
--     so multi-line options never squash.
--   * Mirrors the pattern used by OnscreenWidget / TopRightQuestsWidget: all
--     dimensions are named DESIGN_* constants at the top; no magic numbers.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local TweenService = game:GetService('TweenService')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local doCleanup = Fusion.doCleanup

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE = HUDCommon.PALETTE

local DialogueData = ReplicatedModules.Data.Dialogue
local DialogueShared = ReplicatedModules.Services.DialogueShared
local ReplicatedData = ReplicatedModules.Services.ReplicatedData
local MaidClassModule = ReplicatedModules.Modules.Maid

local RemoteService = ReplicatedModules.Services.RemoteService
local DialogueActionRemote = RemoteService.GetRemote('DialogueAction', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}
Module.WidgetMaid = MaidClassModule.New()

local ScreenGui: Frame? = nil
local RootScope = nil

local CurrentDialogueId: string? = nil
local CurrentNode: any = nil

-- Fusion Values (populated per-open)
local SpeakerTitle
local BodyText
local AutoAdvanceLabel  -- string Value: text shown on the continue button (e.g. 'Continue (3.0s)')

-- Imperative option rendering: option buttons are destroyed + rebuilt each
-- step under OptionsFrame, tracked via OptionMaid for cleanup. This avoids
-- a ForPairs reactivity layer that wasn't refreshing between nodes — the
-- dialogue tree walk is inherently imperative (one node at a time), so a
-- direct rebuild is both simpler and easier to reason about.
local OptionsFrame: Frame? = nil
local OptionsCanvas: CanvasGroup? = nil  -- wraps OptionsFrame so options fade in via GroupTransparency
local OptionsMaid = nil  -- holds button Instances + auto-advance task handles for the current node

----------------------------------------------------------------------
-- Design dimensions (pixels). Every Scale value is derived from these.
----------------------------------------------------------------------
local DESIGN_SCREEN_W, DESIGN_SCREEN_H = 1920, 1080

-- Panel: wide bottom-center speech panel. Wider than before since options
-- now live to the RIGHT of the body text — content is split horizontally.
local DESIGN_PANEL_W        = 880
local DESIGN_PANEL_MIN_H    = 180  -- minimum before AutomaticSize.Y grows it

-- Inner padding on the panel.
local DESIGN_PANEL_PAD      = 16

-- Inner usable width (after symmetric horizontal padding).
local DESIGN_PANEL_INNER_W  = DESIGN_PANEL_W - 2 * DESIGN_PANEL_PAD -- 848

-- Two-column horizontal split. Left column = eyebrow + speaker + body
-- (the "story" side); right column = scrollable option list. Body is
-- the larger share so speeches read comfortably; options column is
-- fixed-width so multi-line option labels stay legible.
local DESIGN_CONTENT_GAP    = 14   -- horizontal gap between left + right columns
local DESIGN_OPTIONS_W      = 280  -- fixed pixel width of the options column
local DESIGN_BODY_W         = DESIGN_PANEL_INNER_W - DESIGN_OPTIONS_W - DESIGN_CONTENT_GAP -- 554
-- Fixed scroll viewport height for the options column. ~6 buttons visible
-- before scroll kicks in (36 + 6 padding ≈ 42 per row → 252 / 42 = 6).
-- Long option lists (chapter selectors etc.) scroll within this viewport
-- instead of stretching the panel taller than the body.
local DESIGN_OPTIONS_VIEWPORT_H = 252

-- Internal row heights.
local DESIGN_EYEBROW_H      = 12   -- "◆ DIALOGUE" eyebrow
local DESIGN_SPEAKER_H      = 28   -- speaker name label
local DESIGN_BODY_MIN_H     = 100  -- body text (wraps, AutomaticSize.Y grows)

-- Gap between the stacked rows inside the panel.
local DESIGN_ROW_GAP        = 10

-- Option buttons (stacked inside an options list).
local DESIGN_OPTION_MIN_H   = 36
local DESIGN_OPTION_PAD_X   = 10   -- inner horizontal padding on each button
local DESIGN_OPTION_GAP     = 6    -- vertical gap between option buttons

-- Typewriter speed: characters per second for the body-text reveal.
-- 35 cps ≈ 700 wpm reading speed; quick but not instantaneous.
local TYPEWRITER_CPS        = 35
local OPTIONS_FADE_IN_TIME  = 0.35   -- seconds to fade options from invisible

-- Bottom-center anchor: lift the panel off the bottom edge by a scaled pixel
-- inset (24 px at the 1080 reference height).
local DESIGN_BOTTOM_INSET   = 24
local ANCHOR_Y_SCALE        = 1 - DESIGN_BOTTOM_INSET / DESIGN_SCREEN_H

local function resolveNode(node)
	-- Traverse Conditional nodes until we hit a MultiOption / Action / Exit.
	while node and node.Type == 'Conditional' do
		local playerData = ReplicatedData.GetData('PlayerData', false)
		local ok, result = pcall(node.Condition, LocalPlayer, playerData, CurrentDialogueId)
		if not ok then
			warn('Dialogue condition errored: ', result)
			result = false
		end
		node = result and node.True or node.False
	end
	return node
end

local function runActions(node)
	if typeof(node.Actions) == 'table' then
		for _, action in node.Actions do
			DialogueActionRemote:FireServer(CurrentDialogueId, action)
		end
	end
end

-- Build a single option button under OptionsFrame and track it in OptionsMaid
-- so the next stepToNode() can clear it. `idx` controls its LayoutOrder so
-- options stay in author order regardless of construction order.
local function spawnOptionButton(idx: number, label: string, onClick: () -> ())
	if not OptionsFrame or not RootScope then return end
	local btn = RootScope:New('TextButton') {
		Name = 'Option_' .. tostring(idx),
		LayoutOrder = idx,
		Size = UDim2.new(1, 0, 0, DESIGN_OPTION_MIN_H),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = PALETTE.bg1,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		FontFace = HUDCommon.FONT_UI,
		TextSize = 16,
		TextColor3 = PALETTE.ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextWrapped = true,
		-- `idx` should be an integer (array key), but if a malformed
		-- node smuggles a string key in we don't want the format call
		-- to crash. Coerce to number with a safe fallback.
		Text = string.format('%d. %s', tonumber(idx) or 1, tostring(label)),
		Parent = OptionsFrame,
		[Fusion.OnEvent('Activated')] = onClick,
		[Fusion.Children] = {
			RootScope:New('UIStroke') {
				Color = PALETTE.accent, Transparency = 0.7, Thickness = 1,
			},
			RootScope:New('UIPadding') {
				PaddingTop    = UDim.new(0, DESIGN_OPTION_PAD_X / 2),
				PaddingBottom = UDim.new(0, DESIGN_OPTION_PAD_X / 2),
				PaddingLeft   = UDim.new(0, DESIGN_OPTION_PAD_X),
				PaddingRight  = UDim.new(0, DESIGN_OPTION_PAD_X),
			},
		},
	}
	OptionsMaid:Give(btn)
	return btn
end

local function clearOptions()
	if OptionsMaid then OptionsMaid:Cleanup() end
end

local function stepToNode(node)
	node = resolveNode(node)
	if not node then
		Module.CloseWidget()
		return
	end
	-- Defensive unwrap mirroring DialogueBuilder.DisplayTextContent —
	-- if a Continue points at an option-entry (`{Display, Options}` with
	-- no Type), unwrap once so we step into the *actual* next node.
	-- Catches any author who hand-builds a malformed table or passes
	-- BuildExitButton() through a path the data-side unwrap doesn't
	-- cover.
	if typeof(node) == 'table'
		and node.Type == nil
		and node.Display ~= nil and node.Options ~= nil
		and (typeof(node.Options) ~= 'table' or node.Options.Type ~= nil
			 or (node.Options[1] == nil and next(node.Options) == nil)) then
		node = node.Options
		node = resolveNode(node)
		if not node then Module.CloseWidget(); return end
	end
	if node.Type == 'Exit' then
		Module.CloseWidget()
		return
	end
	if node.Type == 'Action' then
		runActions(node)
		if (node.Delay or 0) > 0 then
			task.delay(node.Delay, function() Module.CloseWidget() end)
		else
			Module.CloseWidget()
		end
		return
	end
	-- MultiOption
	CurrentNode = node
	local display = node.Display
	local titleData = display and display.Text and display.Text.Title or nil
	local descData  = display and display.Text and display.Text.Description or nil
	local fullBody  = (descData and descData.Text) or ''
	SpeakerTitle:set(titleData and titleData.Text or '')
	BodyText:set('')  -- typewriter fills it incrementally below
	AutoAdvanceLabel:set('')

	-- Hide options until the typewriter completes — stops the player from
	-- clicking through before reading. CanvasGroup.GroupTransparency
	-- blanket-fades every descendant in one property write (versus
	-- iterating every TextLabel/UIStroke individually).
	if OptionsCanvas then OptionsCanvas.GroupTransparency = 1 end

	-- Stub: play a per-NPC talking sound for this line. DialogueShared
	-- resolves the registry entry by dialogue id; per-line overrides
	-- can come from display.TalkingSound = { Sfx = ..., Properties = {…} }
	-- when authors want a stinger on a specific line.
	local lineOverride = display and display.TalkingSound
	DialogueShared.PlayTalkingSound(
		CurrentDialogueId,
		lineOverride and lineOverride.Sfx,
		lineOverride and lineOverride.Properties)

	-- Dispatch any cinematic cues attached to this dialogue line. Cues are
	-- the same shape as full cinematics (At + Kind + Args). For lines we
	-- play them at-start with their `At` honored as a relative delay so
	-- a line can pan camera 0.2s in, shake 0.5s in, etc., without leaving
	-- the dialogue flow. Used by Dialogue authors via the optional
	-- `Cues` field added to a node's Display table.
	local cues = display and display.Cues
	if typeof(cues) == 'table' and #cues > 0 then
		local CinematicClient = SystemsContainer.CinematicClient
			or (SystemsContainer.ParentSystems and SystemsContainer.ParentSystems.Effects
			    and SystemsContainer.ParentSystems.Effects.CinematicClient)
		if CinematicClient and CinematicClient.PlayCue then
			for _, cue in cues do
				task.delay(math.max(0, cue.At or 0), function()
					if CurrentNode ~= node then return end  -- node advanced; skip stale cue
					CinematicClient.PlayCue(cue.Kind, cue.Args or {})
				end)
			end
		end
	end

	-- Wipe last node's buttons + any pending auto-advance task before
	-- spawning fresh ones. OptionsMaid.Cleanup destroys child Instances
	-- and runs disconnect callbacks tied to the previous node.
	clearOptions()

	for idx, opt in node.Options do
		local label = opt.Display and opt.Display.Label and opt.Display.Label.Text or 'Continue'
		spawnOptionButton(idx, label, function()
			if opt.Options == nil then
				Module.CloseWidget()
			else
				stepToNode(opt.Options)
			end
		end)
	end

	-- Typewriter reveal of the body text. CurrentNode-guarded so a fast
	-- "Continue" press cancels the in-flight typewriter for the previous
	-- node (the next stepToNode resets BodyText anyway, but this prevents
	-- a stale revealing string flickering past the new body).
	-- When the typewriter completes, fade the options canvas group in.
	local nodeAtStart = node
	task.spawn(function()
		local n = #fullBody
		if n == 0 then
			-- Empty body — show options immediately.
			if CurrentNode == nodeAtStart and OptionsCanvas then
				TweenService:Create(OptionsCanvas,
					TweenInfo.new(OPTIONS_FADE_IN_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ GroupTransparency = 0 }):Play()
			end
			return
		end
		local startedAt = os.clock()
		while CurrentNode == nodeAtStart do
			local elapsed = os.clock() - startedAt
			local revealCount = math.min(n, math.floor(elapsed * TYPEWRITER_CPS))
			BodyText:set(string.sub(fullBody, 1, revealCount))
			if revealCount >= n then break end
			task.wait()
		end
		if CurrentNode == nodeAtStart and OptionsCanvas then
			TweenService:Create(OptionsCanvas,
				TweenInfo.new(OPTIONS_FADE_IN_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ GroupTransparency = 0 }):Play()
		end
	end)

	-- Time-based auto-advance: if the node carries `display.AutoAdvance =
	-- <seconds>`, schedule a tick that advances on the FIRST option after
	-- the timer expires. Cancellable: clearOptions() in the next step
	-- destroys this token before it fires. A live countdown label updates
	-- every 0.1s so the player sees how much time remains.
	local autoAdvance = display and display.AutoAdvance
	local firstOpt = node.Options and node.Options[1]
	if typeof(autoAdvance) == 'number' and autoAdvance > 0 and firstOpt then
		local cancelled = false
		OptionsMaid:Give(function() cancelled = true end)
		local startedAt = os.clock()
		task.spawn(function()
			while not cancelled do
				local remaining = autoAdvance - (os.clock() - startedAt)
				if remaining <= 0 then
					if not cancelled and CurrentNode == node then
						if firstOpt.Options == nil then
							Module.CloseWidget()
						else
							stepToNode(firstOpt.Options)
						end
					end
					return
				end
				AutoAdvanceLabel:set(string.format('Auto-continue in %.1fs', remaining))
				task.wait(0.1)
			end
		end)
	end
end

----------------------------------------------------------------------
-- Two-column content row. Left = eyebrow + speaker + body (the story
-- side, AutoSize.Y so it grows with the typewritten body). Right = a
-- scrollable options column with a fixed viewport height; option lists
-- longer than the viewport scroll instead of stretching the panel.
--
-- Right-column hierarchy:
--   ScrollingFrame (fixed pixel viewport, AutomaticCanvasSize.Y)
--     └─ CanvasGroup (AutoSize.Y, GroupTransparency for fade-in)
--          └─ OptionsFrame (vertical UIListLayout, AutoSize.Y)
--               └─ buttons (imperatively spawned)
-- The CanvasGroup's GroupTransparency cascades over every descendant so
-- one tween fades the entire button stack in after the typewriter
-- completes; AutomaticCanvasSize on the scroll reads the canvas group's
-- live height so scrollbars only appear when content overflows.
----------------------------------------------------------------------
local function buildContentRow(scope)
	-- Left column: eyebrow + speaker + body, stacked vertically.
	local leftColumn = scope:New('Frame') {
		Name = 'LeftColumn',
		LayoutOrder = 1,
		Size = UDim2.fromOffset(DESIGN_BODY_W, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
				HorizontalAlignment = Enum.HorizontalAlignment.Left,
			},
			HUDCommon.eyebrowLabel(scope, {
				Text = '\u{25C6} DIALOGUE',
				Color = PALETTE.accent,
				Size = UDim2.new(1, 0, 0, DESIGN_EYEBROW_H),
				LayoutOrder = 0,
			}),
			scope:New('TextLabel') {
				Name = 'Speaker',
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, DESIGN_SPEAKER_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				TextSize = 22,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
				Text = SpeakerTitle,
			},
			scope:New('TextLabel') {
				Name = 'Body',
				LayoutOrder = 2,
				Size = UDim2.fromOffset(DESIGN_BODY_W, DESIGN_BODY_MIN_H),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				TextSize = 15,
				TextColor3 = PALETTE.inkDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
				Text = BodyText,
			},
		},
	}

	-- Right column: scrollable options. OptionsFrame contains the live
	-- buttons; OptionsCanvas wraps it for the fade; the ScrollingFrame
	-- caps the visible height and surfaces a scrollbar on overflow.
	OptionsFrame = scope:New('Frame') {
		Name = 'Options',
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, DESIGN_OPTION_GAP),
				SortOrder = Enum.SortOrder.LayoutOrder,
				HorizontalAlignment = Enum.HorizontalAlignment.Right,
			},
			scope:New('TextLabel') {
				Name = 'AutoAdvance',
				LayoutOrder = 999,
				Size = UDim2.new(1, 0, 0, 16),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				TextSize = 12,
				TextColor3 = PALETTE.inkDim,
				TextXAlignment = Enum.TextXAlignment.Right,
				Text = AutoAdvanceLabel,
			},
		},
	}

	OptionsCanvas = scope:New('CanvasGroup') {
		Name = 'OptionsCanvas',
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		GroupTransparency = 1,  -- fades 1→0 when typewriter completes
		[Fusion.Children] = { OptionsFrame },
	}

	local optionsScroll = scope:New('ScrollingFrame') {
		Name = 'OptionsScroll',
		LayoutOrder = 2,
		Size = UDim2.fromOffset(DESIGN_OPTIONS_W, DESIGN_OPTIONS_VIEWPORT_H),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = PALETTE.accent,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		CanvasSize = UDim2.new(),  -- ignored once AutomaticCanvasSize is set
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ClipsDescendants = true,
		[Fusion.Children] = { OptionsCanvas },
	}

	-- Outer row holds the two columns side-by-side. AutoSize.Y so the
	-- panel grows with whichever column is taller (typically the left
	-- side once the body wraps to several lines; the right side caps at
	-- DESIGN_OPTIONS_VIEWPORT_H).
	return scope:New('Frame') {
		Name = 'ContentRow',
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, DESIGN_CONTENT_GAP),
				SortOrder = Enum.SortOrder.LayoutOrder,
				VerticalAlignment = Enum.VerticalAlignment.Top,
				HorizontalAlignment = Enum.HorizontalAlignment.Left,
			},
			leftColumn,
			optionsScroll,
		},
	}
end

----------------------------------------------------------------------
-- Build the panel. Pixel-exact width, AutomaticSize.Y so the panel
-- grows with body text + option count. Anchored bottom-center.
----------------------------------------------------------------------
local function buildPanel(scope)
	local panel = HUDCommon.chiseledPanel(scope, {
		Name = 'DialoguePanel',
		-- Bottom-center anchor. Width is Scale-sized (relative to the
		-- design screen) and the height auto-grows from a Scale-converted
		-- minimum. Aspect lock is intentionally omitted because content
		-- height is variable (AutomaticSize.Y); locking width:height
		-- would fight content growth. This is the same pattern as the
		-- TopRightQuestsWidget rail — top-level panel, scale width,
		-- variable height (SKILL §8 decision tree).
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, ANCHOR_Y_SCALE),
		Size = UDim2.fromScale(DESIGN_PANEL_W / DESIGN_SCREEN_W, DESIGN_PANEL_MIN_H / DESIGN_SCREEN_H),
		AutomaticSize = Enum.AutomaticSize.Y,
		AccentColor = PALETTE.accent,
		Children = {
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(0, DESIGN_PANEL_PAD),
				PaddingBottom = UDim.new(0, DESIGN_PANEL_PAD),
				PaddingLeft   = UDim.new(0, DESIGN_PANEL_PAD),
				PaddingRight  = UDim.new(0, DESIGN_PANEL_PAD),
			},
			-- The panel is now a single content row — the row owns its own
			-- internal layout (left = eyebrow + speaker + body, right =
			-- scrollable options). Keeping the panel as a thin shell with
			-- one child means the chiseledPanel's inner Frame doesn't have
			-- to manage cross-column alignment; that happens inside the
			-- row's horizontal UIListLayout.
			buildContentRow(scope),
		},
	})
	panel.Parent = ScreenGui
	return panel
end

function Module.IsWidgetOpen(): boolean
	return CurrentDialogueId ~= nil
end

-- Alias used by CinematicClient's StartDialogue cue. Same shape, just
-- the name the cinematic dispatcher expects.
function Module.RequestStart(dialogueId: string)
	Module.OpenDialogue(dialogueId)
end

function Module.OpenDialogue(dialogueId: string)
	if Module.IsWidgetOpen() then
		Module.CloseWidget()
	end
	local entry = DialogueData.GetDialogueFromId(dialogueId)
	if not entry or not entry.Tree then
		warn(string.format('DialogueWidget: unknown dialogue id %s', tostring(dialogueId)))
		return
	end

	CurrentDialogueId = dialogueId
	ScreenGui = HUDCommon.ensureScreenGui('HUD_Dialogue', 25)
	RootScope = scoped(Fusion)

	SpeakerTitle     = RootScope:Value('')
	BodyText         = RootScope:Value('')
	AutoAdvanceLabel = RootScope:Value('')
	OptionsMaid      = MaidClassModule.New()

	buildPanel(RootScope)
	stepToNode(entry.Tree)
end

function Module.CloseWidget()
	if not Module.IsWidgetOpen() then
		return
	end
	CurrentDialogueId = nil
	CurrentNode = nil
	if OptionsMaid then OptionsMaid:Cleanup(); OptionsMaid = nil end
	OptionsFrame = nil
	OptionsCanvas = nil
	if RootScope then
		doCleanup(RootScope)
		RootScope = nil
	end
	Module.WidgetMaid:Cleanup()
end

function Module.Start()
	-- no-op; opened on demand via Module.OpenDialogue
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/EmptyWidget.luau"><![CDATA[-- Placeholder widget scaffold. Intentionally empty; kept so the framework
-- registration list stays stable while we port features onto it.

local SystemsContainer = {}

local Module = {}

function Module.IsWidgetOpen(): boolean
	return false
end

function Module.UpdateWidget() end
function Module.OpenWidget() end
function Module.CloseWidget() end

function Module.Start() end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/EnchantingWidget.luau"><![CDATA[-- Phase 4 — Arcane Enchanting Table workstation.
-- Apotheosis-style enchant picker with tiers, prereqs, conflicts.
-- Visual reference: tmp/aincrad-ui/workstations.jsx (ArcaneEnchanter).
-- No server integration yet — commits will warn until EnchantServer lands.
--
-- Layout strategy (see .claude/skills/custom-roblox-ui/SKILL.md §2,3,4,8,10):
--   * Root frame fills its TabWidget content parent via fromScale(1, 1); this
--     is a SUB-panel, not a top-level HUD element — no screen-wide aspect
--     constraint, no anchor math.
--   * All atoms declared as DESIGN_* pixel constants and placed via
--     UDim2.fromOffset / UDim2.new(1, offset, 0, offset) so they never depend
--     on nested Scale multiplication.
--   * Left column (arcane visual + chosen + cost bar) uses UIListLayout with
--     AutomaticSize.Y on variable-content sub-sections.
--   * Right column (enchant catalog) is pixel width + internal UIListLayout;
--     the scrolling list auto-sizes its canvas.
--   * School filter: UIGridLayout with pixel CellSize + bounded MaxCells.
--   * Level buttons: UIListLayout horizontal, pixel cells.

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ContextActionService = game:GetService('ContextActionService')
local Players = game:GetService('Players')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local peek = Fusion.peek

-- Catalog import (Stage A) + commit remote (Stage B). The local ENCHANTS
-- / ENCHANT_INDEX / TIER_COLOR variables are rebuilt below as adapters
-- to the lowercase-field shape this widget code uses; the data module
-- itself uses CapsCase.
local EnchantsConfig = ReplicatedModules.Data.Enchants
local LevelGates     = ReplicatedModules.Data.LevelGates
local ReplicatedData = ReplicatedModules.Services.ReplicatedData
local RemoteService  = ReplicatedModules.Services.RemoteService
local EnchantShared  = ReplicatedModules.Services.EnchantShared
local EnchantEvent   = RemoteService.GetRemote('EnchantEvent', 'RemoteEvent', false)

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local LevelLockOverlay = LocalModules.Modules.LevelLockOverlay
local LevelGatesClient = LocalModules.Modules.LevelGatesClient
local PALETTE = HUDCommon.PALETTE

local SystemsContainer = {}

-- // Adapter shapes — re-projection of EnchantsConfig to the
-- lowercase-field shape this widget code uses. Built once at module load.

type Enchant = {
	id: string, name: string, tier: string, school: string,
	maxLv: number, cost: {number}, color: Color3,
	desc: string, descMult: number,
	conflict: {string}?, req: {id: string, lv: number}?,
}

local ENCHANTS: {Enchant} = {}
local ENCHANT_INDEX: {[string]: Enchant} = {}
do
	for _, e in EnchantsConfig.Enchants do
		local req = nil
		if e.Prereq then req = { id = e.Prereq.Id, lv = e.Prereq.Level } end
		local entry = {
			id = e.Id, name = e.Name, tier = e.Tier, school = e.School,
			maxLv = e.MaxLevel, cost = e.Cost, color = e.Color,
			desc = e.DescriptionFormat, descMult = e.DescriptionMultiplier,
			conflict = e.Conflict, req = req,
		}
		table.insert(ENCHANTS, entry)
		ENCHANT_INDEX[e.Id] = entry
	end
	-- Stable ordering: by tier then name. Tier order kept loose (mythic
	-- last) via a tier rank table.
	local TIER_RANK = { common = 1, uncommon = 2, rare = 3, epic = 4, mythic = 5 }
	table.sort(ENCHANTS, function(a, b)
		local ra, rb = TIER_RANK[a.tier] or 99, TIER_RANK[b.tier] or 99
		if ra ~= rb then return ra < rb end
		return a.name < b.name
	end)
end

local TIER_COLOR: {[string]: Color3} = EnchantsConfig.TierColors

local SCHOOLS: {string} = { 'all', 'Edge', 'Faith', 'Ward', 'Pyre', 'Frost', 'Wyrd', 'Bone', 'Astra' }

-- Placeholder equipment shown in the right-panel "Inventory" tab. Real
-- gear will come from PlayerData later, but we surface a short list now
-- so the tab is functional and the arcane-panel title can swap when the
-- player chooses a different item to inscribe.
type InvItem = { id: string, name: string, slot: string, tier: string, equipped: boolean }
local EQUIPMENT: {InvItem} = {
	{ id='elucidator', name='Elucidator',     slot='Greatsword',  tier='rare',     equipped=true  },
	{ id='dark_rep',   name='Dark Repulser',  slot='Longsword',   tier='rare',     equipped=false },
	{ id='blood_oath', name='Blood Oath',     slot='Dagger',      tier='uncommon', equipped=false },
	{ id='starfall',   name='Starfall Bow',   tier='epic',        slot='Bow',      equipped=false },
	{ id='moon_rite',  name='Moon Rite Staff',slot='Staff',       tier='epic',     equipped=false },
	{ id='kite_ward',  name='Kite of Warding',slot='Shield',      tier='common',   equipped=false },
	{ id='bone_plate', name='Bone Plate',     slot='Chest',       tier='uncommon', equipped=true  },
	{ id='shadow_gyre',name='Shadow Gyre',    slot='Ring',        tier='rare',     equipped=false },
}
local EQUIPMENT_INDEX: {[string]: InvItem} = {}
for _, it in EQUIPMENT do EQUIPMENT_INDEX[it.id] = it end

----------------------------------------------------------------------
-- DESIGN DIMENSIONS (pixels, from tmp/aincrad-ui/workstations.jsx)
----------------------------------------------------------------------

-- Column split: right catalog column is pixel-exact; left flex-fills.
local DESIGN_CATALOG_W        = 360        -- jsx: gridTemplateColumns '1fr 360px'

-- Left column padding + stack gap (jsx: padding:'16px 20px', gap:14).
local DESIGN_LEFT_PAD_X       = 20
local DESIGN_LEFT_PAD_Y       = 16
local DESIGN_LEFT_STACK_GAP   = 14

-- Arcane circle visual panel (jsx: flex:1, minHeight:300).
local DESIGN_ARCANE_MIN_H     = 300
local DESIGN_ARCANE_RADIUS    = 150        -- rune ring radius
local DESIGN_RUNE_SIZE        = 22         -- rune disc diameter (jsx r=11 → 22px)
local DESIGN_RUNE_TEXT        = 14
local DESIGN_WEAPON_SIL_W     = 144        -- jsx path ~-60..72 → ~132, rounded
local DESIGN_WEAPON_SIL_H     = 14
local DESIGN_WEAPON_TITLE_H   = 14

-- Chosen inscriptions section. Squashed to 4-col compact rows so many
-- inscriptions stay glanceable without pushing the arcane panel up.
-- Each card is single-line (name + LV) — description moves to tooltip.
local DESIGN_CHOSEN_HEADER_H  = 12
local DESIGN_CHOSEN_HEADER_GAP = 6
local DESIGN_CHOSEN_CARD_H    = 30         -- squashed single-line card
local DESIGN_CHOSEN_GRID_COLS = 4
local DESIGN_CHOSEN_PAD_X     = 8
local DESIGN_CHOSEN_PAD_Y     = 4
local DESIGN_CHOSEN_STRIP_W   = 3
local DESIGN_CHOSEN_NAME_H    = 14
local DESIGN_CHOSEN_LV_W      = 36
local DESIGN_CHOSEN_CLOSE     = 16
local DESIGN_CHOSEN_CARD_GAP_X = 6
local DESIGN_CHOSEN_CARD_GAP_Y = 4
-- ScrollingFrame fixed viewport height (roughly two squashed rows). The
-- AutomaticCanvasSize.Y on the frame lets it grow beyond this and scroll.
local DESIGN_CHOSEN_SCROLL_H  = DESIGN_CHOSEN_CARD_H * 2 + DESIGN_CHOSEN_CARD_GAP_Y

-- Cost bar (jsx: padding:'10px 14px', gap:14, inscribe button inline).
local DESIGN_INSCRIBE_W       = 160
local DESIGN_INSCRIBE_H       = 36

-- Right catalog column padding (jsx: padding:'14px 14px').
local DESIGN_RIGHT_PAD        = 14
local DESIGN_RIGHT_HEADER_H   = 14
local DESIGN_RIGHT_HEADER_GAP = 8

-- Right-panel tabs (INVENTORY | INSCRIPTIONS). Single segmented row
-- above the rest of the right-column stack. Height is intentionally
-- compact — tabs are navigation, not the primary affordance.
local DESIGN_RIGHT_TAB_H      = 26
local DESIGN_RIGHT_TAB_GAP    = 8

-- Inventory tab row (icon swatch + name/slot + equipped tag).
local DESIGN_INV_ROW_H        = 48
local DESIGN_INV_ROW_GAP      = 4
local DESIGN_INV_SWATCH       = 28
local DESIGN_INV_PAD_X        = 10

-- School filter row (jsx: flexWrap, 3×8 padding, gap:3).
local DESIGN_FILTER_BTN_W     = 56
local DESIGN_FILTER_BTN_H     = 20
local DESIGN_FILTER_PAD       = 3
local DESIGN_FILTER_MAX_COLS  = 5           -- wrap into two rows for 9 schools
local DESIGN_FILTER_ROW_H     = DESIGN_FILTER_BTN_H * 2 + DESIGN_FILTER_PAD
local DESIGN_FILTER_GAP       = 10

-- Catalog entry (jsx: padding:'7px 10px', per-card header + level row + warn).
local DESIGN_ENTRY_H          = 60
local DESIGN_ENTRY_PAD_X      = 10
local DESIGN_ENTRY_PAD_Y      = 6
local DESIGN_ENTRY_HEADER_H   = 14
local DESIGN_ENTRY_TIER_W     = 60
local DESIGN_ENTRY_LEVEL_H    = 18
local DESIGN_ENTRY_WARN_H     = 12
local DESIGN_ENTRY_ROW_GAP    = 4
local DESIGN_ENTRY_GAP        = 3          -- between consecutive entries
local DESIGN_LEVEL_BTN_GAP    = 2
local DESIGN_LEVEL_COST_W     = 40

-- // Module // --

local Module = {}

local ScreenGui: Frame? = nil
local RootScope = nil

-- Fusion Values
local IsOpen
local Chosen       -- Value<{[enchantId]: level}>
local SchoolFilter -- Value<string>
local AvailableXP  -- Value<number>  (placeholder; would come from PlayerData)
local AvailableSigils
local RightTab     -- Value<'inscriptions'|'inventory'>
local SelectedItem -- Value<string> — EQUIPMENT_INDEX key currently being inscribed
-- Tooltip: { title, body, color, x, y } or nil. Shared floating frame
-- parented to ScreenGui reads from this; hover targets write to it.
local ActiveTooltip

-- // Helpers // --

local function formatDesc(e: Enchant, lv: number): string
	local val = e.descMult * lv
	return string.format(e.desc, val)
end

local function totalCost(use): number
	local sum = 0
	for id, lv in use(Chosen) do
		local e = ENCHANT_INDEX[id]
		if e and e.cost[lv] then sum += e.cost[lv] end
	end
	return sum
end

local function checkAvail(e: Enchant, chosen): (boolean, string)
	if e.conflict then
		for _, cid in e.conflict do
			if chosen[cid] then
				return false, 'Conflicts with ' .. (ENCHANT_INDEX[cid] and ENCHANT_INDEX[cid].name or cid)
			end
		end
	end
	if e.req then
		local have = chosen[e.req.id] or 0
		if have < e.req.lv then
			local reqName = ENCHANT_INDEX[e.req.id] and ENCHANT_INDEX[e.req.id].name or e.req.id
			return false, string.format('Requires %s %d', reqName, e.req.lv)
		end
	end
	return true, ''
end

-- Tooltip helpers. Level-aware: hover on any level button shows the
-- *level's* effect (descMult * lv through the enchant's desc format),
-- not the base-level effect — matching the design requirement.
local function showTooltip(target: GuiObject, title: string, body: string, color: Color3)
	local abs = target.AbsolutePosition
	local size = target.AbsoluteSize
	ActiveTooltip:set({
		title = title, body = body, color = color,
		x = abs.X + size.X + 10, y = abs.Y,
	})
end
local function hideTooltip()
	ActiveTooltip:set(nil)
end

-- setLevel is the single place level-selection state is mutated, so the
-- "click the active level to deselect" toggle lives here (not duplicated
-- at every call site). If the requested level equals the current one,
-- the enchant is cleared; otherwise the new level is recorded.
local function setLevel(id: string, lv: number)
	local current = table.clone(peek(Chosen))
	local now = current[id] or 0
	if lv <= 0 or lv == now then
		current[id] = nil
	else
		current[id] = lv
	end
	Chosen:set(current)
end

local function removeEnchant(id: string)
	setLevel(id, 0)
end

-- // UI builders // --

----------------------------------------------------------------------
-- Chosen-inscription card. Pixel-exact height; width filled via grid.
----------------------------------------------------------------------
local function buildChosenEntry(scope, id: string, lv: number)
	local e = ENCHANT_INDEX[id]
	if not e then return nil end
	local c = TIER_COLOR[e.tier] or PALETTE.accent
	local card: Frame
	card = scope:New('Frame') {
		BackgroundColor3 = c,
		BackgroundTransparency = 0.9,
		BorderSizePixel = 0,
		-- Hover the whole card to see the effect at its current LV.
		[Fusion.OnEvent('MouseEnter')] = function()
			local body = string.format('LV %d · %d XP\n%s',
				lv, e.cost[lv] or 0, formatDesc(e, lv))
			showTooltip(card, e.name, body, c)
		end,
		[Fusion.OnEvent('MouseLeave')] = hideTooltip,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = c, Transparency = 0.5, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, DESIGN_CHOSEN_PAD_X),
				PaddingRight = UDim.new(0, DESIGN_CHOSEN_PAD_X),
				PaddingTop = UDim.new(0, DESIGN_CHOSEN_PAD_Y),
				PaddingBottom = UDim.new(0, DESIGN_CHOSEN_PAD_Y),
			},
			-- Colored left strip.
			scope:New('Frame') {
				AnchorPoint = Vector2.new(0, 0),
				Position = UDim2.fromOffset(0, 0),
				Size = UDim2.new(0, DESIGN_CHOSEN_STRIP_W, 1, 0),
				BackgroundColor3 = c, BorderSizePixel = 0,
			},
			-- Name (left, vertically centered — single-line squashed card).
			-- Shift past the colored strip + a small gap so text doesn't
			-- render on top of the 3-px strip at the card's left edge.
			scope:New('TextLabel') {
				Position = UDim2.fromOffset(DESIGN_CHOSEN_STRIP_W + 6, 0),
				Size = UDim2.new(1, -(DESIGN_CHOSEN_STRIP_W + 6 + DESIGN_CHOSEN_LV_W + DESIGN_CHOSEN_CLOSE), 1, 0),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = e.name,
				TextSize = 12, TextColor3 = c,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
			-- LV label (right of name, before close button).
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -DESIGN_CHOSEN_CLOSE, 0.5, 0),
				Size = UDim2.fromOffset(DESIGN_CHOSEN_LV_W, DESIGN_CHOSEN_NAME_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = string.format('LV %d', lv),
				TextSize = 10, TextColor3 = c,
				TextXAlignment = Enum.TextXAlignment.Right,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
			-- Close button (right edge, vertically centered).
			scope:New('TextButton') {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.fromOffset(DESIGN_CHOSEN_CLOSE, DESIGN_CHOSEN_CLOSE),
				BackgroundTransparency = 1,
				AutoButtonColor = false,
				FontFace = HUDCommon.FONT_MONO,
				Text = '✕',
				TextSize = 12, TextColor3 = PALETTE.inkDim,
				[Fusion.OnEvent('Activated')] = function() removeEnchant(id) end,
			},
		},
	}
	return card
end

----------------------------------------------------------------------
-- Chosen-inscription grid. Pixel cells, 2 cols, AutomaticSize.Y.
----------------------------------------------------------------------
local function buildChosenList(scope)
	return scope:New('Frame') {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIGridLayout') {
				-- Cell width = (parent/N) − ⌈gap·(N−1)/N⌉ so N cells + (N−1)
				-- gap-pads never overflow the parent width. (Same off-by-one
				-- math we fixed in the forge grids — floor rounds the wrong
				-- way and forces a wrap to a single column.)
				CellSize = UDim2.new(
					1 / DESIGN_CHOSEN_GRID_COLS,
					-math.ceil(DESIGN_CHOSEN_CARD_GAP_X * (DESIGN_CHOSEN_GRID_COLS - 1) / DESIGN_CHOSEN_GRID_COLS),
					0, DESIGN_CHOSEN_CARD_H
				),
				CellPadding = UDim2.fromOffset(DESIGN_CHOSEN_CARD_GAP_X, DESIGN_CHOSEN_CARD_GAP_Y),
				FillDirectionMaxCells = DESIGN_CHOSEN_GRID_COLS,
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:ForPairs(
				scope:Computed(function(use)
					local out = {}
					local i = 0
					for id, lv in use(Chosen) do
						i += 1
						table.insert(out, { order = i, id = id, lv = lv })
					end
					return out
				end),
				function(use, innerScope, idx, entry)
					local frame = buildChosenEntry(innerScope, entry.id, entry.lv)
					if frame then
						frame.LayoutOrder = entry.order
					end
					return entry.id, frame
				end
			),
		},
	}
end

----------------------------------------------------------------------
-- Arcane-circle visual. Fills its slot; rune ring radius is pixel-exact
-- via fromOffset positioning around a fromScale(0.5, 0.5) center.
----------------------------------------------------------------------
local function buildArcanePanel(scope)
	local runes = { '◆', '▲', '●', '◇', '■', '▼', '◐', '◆', '▲', '●', '◇', '■' }
	local children: {any} = {
		scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.75, Thickness = 1 },
	}
	for i, sym in runes do
		local angle = (i - 1) / #runes * math.pi * 2
		local x = math.cos(angle) * DESIGN_ARCANE_RADIUS
		local y = math.sin(angle) * DESIGN_ARCANE_RADIUS
		local litThreshold = i
		table.insert(children, scope:New('TextLabel') {
			Size = UDim2.fromOffset(DESIGN_RUNE_SIZE, DESIGN_RUNE_SIZE),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, x, 0.5, y),
			BackgroundColor3 = PALETTE.bg1,
			BackgroundTransparency = 0.4,
			BorderSizePixel = 0,
			FontFace = HUDCommon.FONT_MONO,
			Text = sym,
			TextSize = DESIGN_RUNE_TEXT,
			TextColor3 = scope:Computed(function(use)
				local total = 0
				for _, lv in use(Chosen) do total += lv end
				return total >= litThreshold and PALETTE.accent or PALETTE.inkFaint
			end),
			[Fusion.Children] = {
				scope:New('UIAspectRatioConstraint') { AspectRatio = 1 },
				scope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
				scope:New('UIStroke') {
					Color = PALETTE.accent,
					Transparency = scope:Computed(function(use)
						local total = 0
						for _, lv in use(Chosen) do total += lv end
						return total >= litThreshold and 0.2 or 0.8
					end),
					Thickness = 1,
				},
			},
		})
	end

	-- Central weapon silhouette (pixel-exact).
	table.insert(children, scope:New('Frame') {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(DESIGN_WEAPON_SIL_W, DESIGN_WEAPON_SIL_H),
		BackgroundColor3 = Color3.fromRGB(74, 72, 96),
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.2, Thickness = 1 },
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0.5, 0, 0, -8),
				Size = UDim2.fromOffset(DESIGN_WEAPON_SIL_W * 2, DESIGN_WEAPON_TITLE_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				-- Title tracks whichever item the player selected in the
				-- inventory tab; falls back to a generic label if the
				-- chosen id somehow isn't in EQUIPMENT_INDEX.
				Text = scope:Computed(function(use)
					local it = EQUIPMENT_INDEX[use(SelectedItem)]
					local name = it and string.upper(it.name) or 'NO ITEM'
					return string.format('◆ ARCANE TABLE · %s ◆', name)
				end),
				TextSize = 10, TextColor3 = PALETTE.accent,
				TextTransparency = 0.4,
			},
		},
	})

	-- Floating cost overlay pinned to the bottom-right of the arcane
	-- viewport. Replaces the dedicated cost bar row; the stats now sit
	-- "inside" the arcane scene as ambient HUD text, matching the
	-- reference layout where cost reads as part of the ritual stage.
	local enoughXP = scope:Computed(function(use)
		return totalCost(use) <= use(AvailableXP)
	end)
	local function floatStat(label: string, valueBind, valueColor)
		return scope:New('Frame') {
			Size = UDim2.fromOffset(0, 30),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				scope:New('TextLabel') {
					Size = UDim2.new(1, 0, 0, 10),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO, Text = label,
					TextSize = 9, TextColor3 = PALETTE.inkFaint,
					TextXAlignment = Enum.TextXAlignment.Right,
				},
				scope:New('TextLabel') {
					AnchorPoint = Vector2.new(0, 1),
					Position = UDim2.fromScale(0, 1),
					Size = UDim2.new(1, 0, 0, 18),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO, Text = valueBind,
					TextSize = 14, TextColor3 = valueColor,
					TextXAlignment = Enum.TextXAlignment.Right,
				},
			},
		}
	end
	-- Stats overlay: pinned to the bottom of the arcane viewport, spanning
	-- a wide horizontal region (55% of panel width on the right) with
	-- SpaceBetween flex so EXPERIENCE, SIGILS and COST fan out across the
	-- bottom band rather than clustering against the right edge.
	table.insert(children, scope:New('Frame') {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -24, 1, -16),
		Size = UDim2.new(0.55, 0, 0, 34),
		BackgroundTransparency = 1,
		ZIndex = 5,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 24),
				VerticalAlignment = Enum.VerticalAlignment.Center,
				HorizontalFlex = Enum.UIFlexAlignment.SpaceBetween,
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			(function() local b = floatStat('EXPERIENCE',
				scope:Computed(function(use)
					local xp = use(AvailableXP); local cost = totalCost(use)
					return string.format('%d ⟶ %d', xp, math.max(0, xp - cost))
				end),
				scope:Computed(function(use)
					return use(enoughXP) and PALETTE.success or PALETTE.danger
				end)); b.LayoutOrder = 1; return b end)(),
			(function() local b = floatStat('SIGILS',
				scope:Computed(function(use)
					return string.format('%d ⟶ %d', use(AvailableSigils), math.max(0, use(AvailableSigils) - 3))
				end),
				PALETTE.accent); b.LayoutOrder = 2; return b end)(),
			(function() local b = floatStat('COST',
				scope:Computed(function(use)
					return string.format('%d XP · 3 SIGILS', totalCost(use))
				end),
				PALETTE.gold); b.LayoutOrder = 3; return b end)(),
		},
	})

	return scope:New('Frame') {
		Name = 'ArcanePanel',
		-- Fills its parent slot (the left column's flex-1 section).
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.5,
		BorderSizePixel = 0,
		[Fusion.Children] = children,
	}
end

----------------------------------------------------------------------
-- Cost bar: XP / SIGILS / COST stat blocks + spacer + inscribe button.
----------------------------------------------------------------------
local function buildCostBar(scope)
	-- Stats (XP / SIGILS / COST) have migrated to the arcane-panel
	-- floating overlay. This bar is now just the right-aligned INSCRIBE
	-- button, kept as its own row so the commit affordance stays the
	-- bottom-most element of the left column — natural F-pattern exit.
	local enoughXP = scope:Computed(function(use)
		return totalCost(use) <= use(AvailableXP)
	end)

	return scope:New('Frame') {
		Name = 'CostBar',
		Size = UDim2.new(1, 0, 0, DESIGN_INSCRIBE_H),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('TextButton') {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.fromOffset(DESIGN_INSCRIBE_W, DESIGN_INSCRIBE_H),
				AutoButtonColor = false,
				BackgroundColor3 = PALETTE.accent,
				BackgroundTransparency = scope:Computed(function(use) return use(enoughXP) and 0.7 or 0.9 end),
				BorderSizePixel = 0,
				FontFace = HUDCommon.FONT_MONO,
				Text = '◆ INSCRIBE ◆',
				TextSize = 12,
				TextColor3 = scope:Computed(function(use) return use(enoughXP) and PALETTE.accent or PALETTE.danger end),
				[Fusion.OnEvent('Activated')] = function()
					if not peek(enoughXP) then return end
					-- Stage C inscribe path. Iterates the Chosen map (enchant
					-- id → level) and fires one TryApply per entry. Server
					-- (EnchantServer.AttemptApplyEnchant) re-validates each
					-- via EnchantShared.CanApplyEnchant; rejects fall through
					-- silently. SelectedItem is the local 'elucidator' id —
					-- the inventory uuid wiring is a Stage E follow-up.
					local chosen = peek(Chosen) or {}
					local targetUuid = peek(SelectedItem)
					if typeof(targetUuid) ~= 'string' or #targetUuid == 0 then
						warn('EnchantingWidget: no target item selected')
						return
					end
					for enchantId, level in chosen do
						EnchantEvent:FireServer(EnchantShared.EnchantActions.TryApply, targetUuid, enchantId, level, nil)
					end
				end,
				[Fusion.Children] = {
					scope:New('UIStroke') {
						Color = scope:Computed(function(use) return use(enoughXP) and PALETTE.accent or PALETTE.danger end),
						Transparency = 0.2, Thickness = 1,
					},
				},
			},
		},
	}
end

----------------------------------------------------------------------
-- School filter row: UIGridLayout with pixel cells; wraps to 2 rows.
----------------------------------------------------------------------
local function buildSchoolFilter(scope)
	local children: {any} = {
		scope:New('UIGridLayout') {
			CellSize = UDim2.fromOffset(DESIGN_FILTER_BTN_W, DESIGN_FILTER_BTN_H),
			CellPadding = UDim2.fromOffset(DESIGN_FILTER_PAD, DESIGN_FILTER_PAD),
			FillDirectionMaxCells = DESIGN_FILTER_MAX_COLS,
			SortOrder = Enum.SortOrder.LayoutOrder,
		},
	}
	for i, s in SCHOOLS do
		local isActive = scope:Computed(function(use) return use(SchoolFilter) == s end)
		table.insert(children, scope:New('TextButton') {
			LayoutOrder = i,
			AutoButtonColor = false,
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = scope:Computed(function(use) return use(isActive) and 0.4 or 0.2 end),
			BorderSizePixel = 0,
			FontFace = HUDCommon.FONT_MONO,
			Text = string.upper(s),
			TextSize = 9,
			TextColor3 = scope:Computed(function(use) return use(isActive) and PALETTE.accent or PALETTE.inkDim end),
			[Fusion.OnEvent('Activated')] = function() SchoolFilter:set(s) end,
			[Fusion.Children] = {
				scope:New('UIStroke') {
					Color = PALETTE.accent,
					Transparency = scope:Computed(function(use) return use(isActive) and 0.2 or 0.75 end),
					Thickness = 1,
				},
			},
		})
	end
	return scope:New('Frame') {
		Name = 'SchoolFilter',
		Size = UDim2.new(1, 0, 0, DESIGN_FILTER_ROW_H),
		BackgroundTransparency = 1,
		[Fusion.Children] = children,
	}
end

----------------------------------------------------------------------
-- Catalog entry: pixel height, header row + level-button row + warning.
----------------------------------------------------------------------
local function buildCatalogEntry(scope, e: Enchant)
	local c = TIER_COLOR[e.tier] or PALETTE.accent
	local lv = scope:Computed(function(use) return use(Chosen)[e.id] or 0 end)
	local availResult = scope:Computed(function(use)
		local ok, why = checkAvail(e, use(Chosen))
		return { ok = ok, why = why }
	end)

	-- Level-button sub-row: horizontal UIListLayout with pixel gaps and
	-- a scale-share width per button so all maxLv buttons + cost fit in
	-- the row without nested-scale math.
	local levelButtons: {any} = {
		scope:New('UIListLayout') {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, DESIGN_LEVEL_BTN_GAP),
			SortOrder = Enum.SortOrder.LayoutOrder,
		},
	}
	-- Each level button shares the row width minus the fixed cost label;
	-- that's the one place we need a derived scale, expressed against
	-- the immediate parent (itself a row of known height).
	local buttonShare = UDim2.new(
		1 / e.maxLv, -(DESIGN_LEVEL_BTN_GAP + math.floor(DESIGN_LEVEL_COST_W / e.maxLv)),
		1, 0
	)
	for i = 1, e.maxLv do
		local isLv = scope:Computed(function(use) return i <= use(lv) end)
		local btn: TextButton
		-- Capture i in a closure so the hover tooltip pulls the correct
		-- level's effect text (formatDesc against this specific level).
		btn = scope:New('TextButton') {
			LayoutOrder = i,
			Size = buttonShare,
			AutoButtonColor = false,
			BackgroundColor3 = scope:Computed(function(use) return use(isLv) and c or PALETTE.bg0 end),
			BackgroundTransparency = scope:Computed(function(use) return use(isLv) and 0.1 or 0.4 end),
			BorderSizePixel = 0,
			FontFace = HUDCommon.FONT_MONO,
			Text = tostring(i),
			TextSize = 10,
			TextColor3 = scope:Computed(function(use)
				return use(isLv) and Color3.fromRGB(20, 18, 30) or c
			end),
			-- Unified click behaviour: always route through setLevel.
			-- The warning row below already explains any conflict/req
			-- violations; gating the click here just makes the button
			-- feel broken when it is really just not-yet-satisfied.
			[Fusion.OnEvent('Activated')] = function()
				setLevel(e.id, i)
			end,
			-- Hover: show the LEVEL i effect, not the base. Includes the
			-- cost for this level so players can eyeball the trade-off.
			[Fusion.OnEvent('MouseEnter')] = function()
				local body = string.format('LV %d · %d XP\n%s',
					i, e.cost[i] or 0, formatDesc(e, i))
				showTooltip(btn, e.name, body, c)
			end,
			[Fusion.OnEvent('MouseLeave')] = hideTooltip,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = c, Transparency = 0.5, Thickness = 1 },
			},
		}
		table.insert(levelButtons, btn)
	end
	-- Trailing cost label (pixel width).
	table.insert(levelButtons, scope:New('TextLabel') {
		LayoutOrder = e.maxLv + 1,
		Size = UDim2.fromOffset(DESIGN_LEVEL_COST_W, DESIGN_ENTRY_LEVEL_H),
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_MONO,
		Text = scope:Computed(function(use)
			return string.format('%dxp', e.cost[math.max(1, use(lv))])
		end),
		TextSize = 10, TextColor3 = PALETTE.gold,
		TextXAlignment = Enum.TextXAlignment.Right,
	})

	return scope:New('Frame') {
		Size = UDim2.new(1, 0, 0, DESIGN_ENTRY_H),
		BackgroundColor3 = c,
		BackgroundTransparency = scope:Computed(function(use) return use(lv) > 0 and 0.88 or 0.95 end),
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = c,
				Transparency = scope:Computed(function(use) return use(lv) > 0 and 0.3 or 0.7 end),
				Thickness = 1,
			},
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, DESIGN_ENTRY_PAD_X),
				PaddingRight = UDim.new(0, DESIGN_ENTRY_PAD_X),
				PaddingTop = UDim.new(0, DESIGN_ENTRY_PAD_Y),
				PaddingBottom = UDim.new(0, DESIGN_ENTRY_PAD_Y),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, DESIGN_ENTRY_ROW_GAP),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- Header row: name + tier badge.
			scope:New('Frame') {
				LayoutOrder = 0,
				Size = UDim2.new(1, 0, 0, DESIGN_ENTRY_HEADER_H),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('TextLabel') {
						Size = UDim2.new(1, -DESIGN_ENTRY_TIER_W, 1, 0),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_UI,
						Text = e.name,
						TextSize = 12, TextColor3 = c,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					scope:New('TextLabel') {
						AnchorPoint = Vector2.new(1, 0),
						Position = UDim2.new(1, 0, 0, 0),
						Size = UDim2.fromOffset(DESIGN_ENTRY_TIER_W, DESIGN_ENTRY_HEADER_H),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = string.upper(e.tier),
						TextSize = 9, TextColor3 = c,
						TextTransparency = 0.3,
						TextXAlignment = Enum.TextXAlignment.Right,
					},
				},
			},
			-- Level buttons row.
			scope:New('Frame') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, DESIGN_ENTRY_LEVEL_H),
				BackgroundTransparency = 1,
				[Fusion.Children] = levelButtons,
			},
			-- Warning row (empty when available).
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, DESIGN_ENTRY_WARN_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					local r = use(availResult)
					return r.ok and '' or ('⚠ ' .. r.why)
				end),
				TextSize = 10, TextColor3 = PALETTE.danger,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
		},
	}
end

----------------------------------------------------------------------
-- Catalog list: a ScrollingFrame with AutomaticCanvasSize.Y and a
-- vertical UIListLayout. Pixel row gap.
----------------------------------------------------------------------
----------------------------------------------------------------------
-- Right-panel tab bar: segmented INVENTORY | INSCRIPTIONS pair. Clicking
-- a tab mutates `RightTab`; the tab-active look is computed from the
-- same value via Computed → BackgroundTransparency + UIStroke transparency.
----------------------------------------------------------------------
local function buildRightTabBar(scope)
	local tabs = {
		{ key = 'inventory',    label = 'INVENTORY'    },
		{ key = 'inscriptions', label = 'INSCRIPTIONS' },
	}
	local children: {any} = {
		scope:New('UIListLayout') {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, DESIGN_RIGHT_TAB_GAP),
			SortOrder = Enum.SortOrder.LayoutOrder,
		},
	}
	for i, t in tabs do
		local isActive = scope:Computed(function(use) return use(RightTab) == t.key end)
		table.insert(children, scope:New('TextButton') {
			LayoutOrder = i,
			-- Half-width minus half the gap keeps both tabs exactly flush
			-- with the column edges regardless of viewport width.
			Size = UDim2.new(0.5, -math.ceil(DESIGN_RIGHT_TAB_GAP / 2), 1, 0),
			AutoButtonColor = false,
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = scope:Computed(function(use) return use(isActive) and 0.1 or 0.5 end),
			BorderSizePixel = 0,
			FontFace = HUDCommon.FONT_MONO,
			Text = t.label,
			TextSize = 11,
			TextColor3 = scope:Computed(function(use) return use(isActive) and PALETTE.accent or PALETTE.inkDim end),
			[Fusion.OnEvent('Activated')] = function() RightTab:set(t.key) end,
			[Fusion.Children] = {
				scope:New('UIStroke') {
					Color = PALETTE.accent,
					Transparency = scope:Computed(function(use) return use(isActive) and 0.2 or 0.8 end),
					Thickness = 1,
				},
			},
		})
	end
	return scope:New('Frame') {
		Size = UDim2.new(1, 0, 0, DESIGN_RIGHT_TAB_H),
		BackgroundTransparency = 1,
		[Fusion.Children] = children,
	}
end

----------------------------------------------------------------------
-- Inventory row: colored swatch + item name + slot label + equipped tag.
-- Clicking sets SelectedItem, which the arcane panel title binds to.
----------------------------------------------------------------------
local function buildInventoryEntry(scope, item: InvItem)
	local c = TIER_COLOR[item.tier] or PALETTE.accent
	local isSelected = scope:Computed(function(use) return use(SelectedItem) == item.id end)
	return scope:New('TextButton') {
		Size = UDim2.new(1, 0, 0, DESIGN_INV_ROW_H),
		AutoButtonColor = false,
		BackgroundColor3 = c,
		BackgroundTransparency = scope:Computed(function(use) return use(isSelected) and 0.8 or 0.92 end),
		BorderSizePixel = 0,
		Text = '',
		[Fusion.OnEvent('Activated')] = function() SelectedItem:set(item.id) end,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = c,
				Transparency = scope:Computed(function(use) return use(isSelected) and 0.2 or 0.7 end),
				Thickness = 1,
			},
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, DESIGN_INV_PAD_X),
				PaddingRight = UDim.new(0, DESIGN_INV_PAD_X),
				PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
			},
			-- Colored swatch (placeholder for item icon).
			scope:New('Frame') {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 0, 0.5, 0),
				Size = UDim2.fromOffset(DESIGN_INV_SWATCH, DESIGN_INV_SWATCH),
				BackgroundColor3 = c,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					scope:New('UIAspectRatioConstraint') { AspectRatio = 1 },
					scope:New('UIStroke') { Color = c, Transparency = 0.3, Thickness = 1 },
				},
			},
			-- Name (top line).
			scope:New('TextLabel') {
				Position = UDim2.fromOffset(DESIGN_INV_SWATCH + 10, 4),
				Size = UDim2.new(1, -(DESIGN_INV_SWATCH + 10 + 60), 0, 16),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = item.name,
				TextSize = 13, TextColor3 = c,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			-- Slot label (below name).
			scope:New('TextLabel') {
				Position = UDim2.fromOffset(DESIGN_INV_SWATCH + 10, 20),
				Size = UDim2.new(1, -(DESIGN_INV_SWATCH + 10 + 60), 0, 12),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = string.upper(item.slot) .. ' · ' .. string.upper(item.tier),
				TextSize = 9, TextColor3 = PALETTE.inkFaint,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			-- Equipped tag + "SELECTED" marker.
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.fromOffset(72, DESIGN_INV_ROW_H - 12),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					if use(isSelected) then return '◆ ACTIVE' end
					return item.equipped and 'EQUIPPED' or ''
				end),
				TextSize = 9, TextColor3 = scope:Computed(function(use)
					return use(isSelected) and PALETTE.accent or PALETTE.inkFaint
				end),
				TextXAlignment = Enum.TextXAlignment.Right,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
		},
	}
end

local function buildInventoryList(scope)
	local children: {any} = {
		scope:New('UIListLayout') {
			FillDirection = Enum.FillDirection.Vertical,
			Padding = UDim.new(0, DESIGN_INV_ROW_GAP),
			SortOrder = Enum.SortOrder.LayoutOrder,
		},
	}
	for i, item in EQUIPMENT do
		local row = buildInventoryEntry(scope, item)
		row.LayoutOrder = i
		table.insert(children, row)
	end
	return scope:New('ScrollingFrame') {
		Name = 'Inventory',
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = PALETTE.accent,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		[Fusion.Children] = children,
	}
end

local function buildCatalog(scope)
	local children: {any} = {
		scope:New('UIListLayout') {
			Padding = UDim.new(0, DESIGN_ENTRY_GAP),
			SortOrder = Enum.SortOrder.LayoutOrder,
		},
	}
	for i, e in ENCHANTS do
		local entry = buildCatalogEntry(scope, e)
		entry.LayoutOrder = i
		entry.Visible = scope:Computed(function(use)
			local f = use(SchoolFilter)
			return f == 'all' or e.school == f
		end)
		table.insert(children, entry)
	end
	return scope:New('ScrollingFrame') {
		Name = 'Catalog',
		-- Fills remaining height of the right column (header + filter stripped).
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = PALETTE.accent,
		[Fusion.Children] = children,
	}
end

----------------------------------------------------------------------
-- Panels: left flex column + right pixel-width catalog column.
-- Root fills its tab content parent via fromScale(1, 1).
----------------------------------------------------------------------
----------------------------------------------------------------------
-- Floating tooltip: absolute-positioned Frame reading ActiveTooltip.
-- Parented to the widget's ScreenGui so it overlays every modal
-- element. Non-interactive (Active = false) so it doesn't swallow
-- hovers from the buttons beneath it.
----------------------------------------------------------------------
local function buildTooltip(scope)
	return scope:New('Frame') {
		Name = 'Tooltip',
		AnchorPoint = Vector2.new(0, 0),
		Position = scope:Computed(function(use)
			local t = use(ActiveTooltip)
			if not t then return UDim2.new() end
			return UDim2.fromOffset(t.x, t.y)
		end),
		Size = UDim2.fromOffset(240, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = PALETTE.bg1,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		Visible = scope:Computed(function(use) return use(ActiveTooltip) ~= nil end),
		ZIndex = 100,
		Active = false,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = scope:Computed(function(use)
					local t = use(ActiveTooltip); return t and t.color or PALETTE.accent
				end),
				Transparency = 0.2, Thickness = 1,
			},
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
				PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 4),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:New('TextLabel') {
				LayoutOrder = 0,
				Size = UDim2.new(1, 0, 0, 14),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = scope:Computed(function(use) local t = use(ActiveTooltip); return t and t.title or '' end),
				TextSize = 12,
				TextColor3 = scope:Computed(function(use)
					local t = use(ActiveTooltip); return t and t.color or PALETTE.accent
				end),
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use) local t = use(ActiveTooltip); return t and t.body or '' end),
				TextSize = 11, TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
			},
		},
	}
end

local function buildPanels(scope)
	-- LEFT: arcane circle + chosen list + cost bar, stacked vertically.
	-- Flex-fills remaining width to the left of the pixel-width catalog.
	local leftCol = scope:New('Frame') {
		Name = 'Left',
		Size = UDim2.new(1, -DESIGN_CATALOG_W, 1, 0),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, DESIGN_LEFT_PAD_Y),
				PaddingBottom = UDim.new(0, DESIGN_LEFT_PAD_Y),
				PaddingLeft = UDim.new(0, DESIGN_LEFT_PAD_X),
				PaddingRight = UDim.new(0, DESIGN_LEFT_PAD_X),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, DESIGN_LEFT_STACK_GAP),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- Arcane visual: flex-fills remaining vertical space above the
			-- chosen-list + cost-bar block. We express this with a Scale-Y
			-- of 1 and pixel subtraction for the fixed rows underneath —
			-- kept shallow so Scale doesn't compound deeper.
			scope:New('Frame') {
				LayoutOrder = 1,
				Size = UDim2.new(
					1, 0,
					1, -(DESIGN_CHOSEN_HEADER_H + DESIGN_CHOSEN_HEADER_GAP
						+ DESIGN_CHOSEN_SCROLL_H
						+ DESIGN_INSCRIBE_H + DESIGN_LEFT_STACK_GAP * 3)
				),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UISizeConstraint') {
						MinSize = Vector2.new(0, DESIGN_ARCANE_MIN_H),
					},
					buildArcanePanel(scope),
				},
			},
			-- Chosen eyebrow + scroll grid. Eyebrow reads the live count.
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, DESIGN_CHOSEN_HEADER_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					local n = 0
					for _ in use(Chosen) do n += 1 end
					return string.format('◆ CHOSEN INSCRIPTIONS · %d', n)
				end),
				TextSize = 10, TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			-- ScrollingFrame so overflow inscriptions scroll vertically
			-- rather than pushing the arcane panel up. AutomaticSize.Y
			-- grows the viewport to fit content up to DESIGN_CHOSEN_SCROLL_H
			-- (via UISizeConstraint), then AutomaticCanvasSize.Y makes the
			-- canvas track content so the scroll bar engages.
			scope:New('ScrollingFrame') {
				LayoutOrder = 3,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				CanvasSize = UDim2.new(),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ScrollBarThickness = 4,
				ScrollBarImageColor3 = PALETTE.accent,
				ScrollingDirection = Enum.ScrollingDirection.Y,
				[Fusion.Children] = {
					scope:New('UISizeConstraint') {
						MaxSize = Vector2.new(math.huge, DESIGN_CHOSEN_SCROLL_H),
					},
					buildChosenList(scope),
				},
			},
			(function()
				local bar = buildCostBar(scope); bar.LayoutOrder = 4; return bar
			end)(),
		},
	}

	-- RIGHT: pixel-width catalog column (header + filter + scrolling list).
	local rightCol = scope:New('Frame') {
		Name = 'Right',
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, DESIGN_CATALOG_W, 1, 0),
		BackgroundColor3 = PALETTE.bg1,
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.85, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, DESIGN_RIGHT_PAD),
				PaddingBottom = UDim.new(0, DESIGN_RIGHT_PAD),
				PaddingLeft = UDim.new(0, DESIGN_RIGHT_PAD),
				PaddingRight = UDim.new(0, DESIGN_RIGHT_PAD),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, DESIGN_RIGHT_HEADER_GAP),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- Tab bar: INVENTORY | INSCRIPTIONS (pinned at top).
			(function() local b = buildRightTabBar(scope); b.LayoutOrder = 1; return b end)(),
			-- Dynamic eyebrow: reflects whichever tab is active.
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, DESIGN_RIGHT_HEADER_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					return use(RightTab) == 'inventory' and '◆ EQUIPMENT' or '◆ ENCHANT CATALOG'
				end),
				TextSize = 10, TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			-- Inscriptions pane: school filter (only while inscriptions
			-- tab is active — the filter has no meaning for inventory).
			-- Visibility is bound via scope:Hydrate so the Computed is
			-- actually observed; assigning .Visible directly on a built
			-- instance would just set a Lua table and never react.
			(function()
				local f = buildSchoolFilter(scope)
				f.LayoutOrder = 3
				scope:Hydrate(f) {
					Visible = scope:Computed(function(use) return use(RightTab) == 'inscriptions' end),
				}
				return f
			end)(),
			-- Content area: fills remaining height. Both panes live here
			-- behind a Visible-gate so their internal state (scroll
			-- position, per-entry computeds) survives tab switches
			-- rather than being rebuilt each time.
			scope:New('Frame') {
				LayoutOrder = 4,
				Size = UDim2.new(
					1, 0,
					1, -(DESIGN_RIGHT_TAB_H + DESIGN_RIGHT_HEADER_H
						+ DESIGN_FILTER_ROW_H + DESIGN_RIGHT_HEADER_GAP * 3 + DESIGN_FILTER_GAP)
				),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					-- Inscriptions (existing catalog) — reactive Visible
					-- via Hydrate so tab clicks actually toggle it.
					(function()
						local c = buildCatalog(scope)
						scope:Hydrate(c) {
							Visible = scope:Computed(function(use) return use(RightTab) == 'inscriptions' end),
						}
						return c
					end)(),
					-- Inventory list — same Hydrate pattern.
					(function()
						local inv = buildInventoryList(scope)
						scope:Hydrate(inv) {
							Visible = scope:Computed(function(use) return use(RightTab) == 'inventory' end),
						}
						return inv
					end)(),
				},
			},
		},
	}

	return scope:New('Frame') {
		Name = 'EnchantingWidget',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = { leftCol, rightCol },
	}
end

-- // Lifecycle // --

function Module.IsWidgetOpen(): boolean
	return IsOpen and peek(IsOpen) or false
end

function Module.OpenWidget()
	if not IsOpen then return end
	-- Level gate (default L20). Per-player flag OR server-wide global.
	local data = ReplicatedData.GetData('PlayerData', false)
	local globalBypass = LevelGatesClient.GetGlobalBypass()
	if data and not LevelGates.CanUseSystem(data, LevelGates.Systems.Enchant, globalBypass) then
		LevelLockOverlay.Show(LevelGates.Systems.Enchant, tonumber(data.Level) or 1)
		return
	end
	IsOpen:set(true)
end

function Module.CloseWidget()
	if not IsOpen then return end
	IsOpen:set(false)
end

function Module.Start()
	ScreenGui = HUDCommon.ensureScreenGui('HUD_Enchanting', 41)

	local scope = scoped(Fusion)
	RootScope = scope

	IsOpen          = scope:Value(false)
	Chosen          = scope:Value({ sharpness = 3, vorpal = 2, lifesteal = 2, bleed = 1 })
	SchoolFilter    = scope:Value('all')
	AvailableXP     = scope:Value(184)
	AvailableSigils = scope:Value(42)
	-- Right panel defaults: open on the inscriptions tab with Elucidator
	-- selected, matching the pre-tab behaviour so nothing shifts visually
	-- on first open — the INVENTORY tab is a discoverable alternative.
	RightTab        = scope:Value('inscriptions')
	SelectedItem    = scope:Value('elucidator')
	ActiveTooltip   = scope:Value(nil)

	local root, content = HUDCommon.workstationShell(scope, {
		Title = 'ENCHANTING TABLE',
		Subtitle = '· Etch words of power into worked metal ·',
		Location = '',
		Visible = IsOpen,
		OnClose = Module.CloseWidget,
		Width = 1240, Height = 720,
	})
	root.Parent = ScreenGui

	local panels = buildPanels(scope)
	panels.Parent = content

	-- Tooltip sits at the ScreenGui root so it overlays the whole modal.
	local tooltip = buildTooltip(scope)
	tooltip.Parent = ScreenGui

	ContextActionService:BindAction('EnchantingEscape', function(_, inputState)
		if inputState == Enum.UserInputState.Begin and Module.IsWidgetOpen() then
			Module.CloseWidget()
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.Escape)

	local ZoneService = ReplicatedModules.Services.ZoneService
	ZoneService.ZoneEnter:Connect(function(character, zoneName)
		if character == LocalPlayer.Character and zoneName == "EnchantCircle" then
			Module.OpenWidget()
		end
	end)
	ZoneService.ZoneLeave:Connect(function(character, zoneName)
		if character == LocalPlayer.Character and zoneName == "EnchantCircle" then
			LevelLockOverlay.HideIfShowing(LevelGates.Systems.Enchant)
			Module.CloseWidget()
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/ForgeWidget.luau"><![CDATA[-- Phase 4 — Blackiron Forge workstation.
-- Tinker-Construct-style weapon assembly: Blueprint + per-slot Materials + Modifiers.
-- Visual reference: tmp/aincrad-ui/forge.jsx.
-- No server integration yet — commits will fire a TODO remote when wired.
--
-- Layout strategy (see .claude/skills/custom-roblox-ui/SKILL.md §2,3,4,8,10):
--   * Root frame fills its TabWidget/workstation content parent via
--     fromScale(1, 1); this is a SUB-panel, not a top-level HUD element —
--     no screen-wide aspect constraint, no anchor math.
--   * All atoms declared as DESIGN_* pixel constants placed via
--     UDim2.fromOffset or UDim2.new(1, -fixed, 0, fixed) so they never
--     depend on nested Scale multiplication.
--   * Three-column layout: left (260px) + center (flex-fills remainder via
--     Scale 1 + negative offset) + right (300px), mirroring forge.jsx's
--     `gridTemplateColumns: '260px 1fr 300px'`.
--   * Left + right columns use pixel widths + full scale height; center
--     uses `UDim2.new(1, -(L+R), 1, 0)` — the canonical "fill remaining"
--     idiom documented in SKILL.md §1.
--   * Blueprint grid + material palette + available-mods grid use
--     UIGridLayout with half-width pixel-adjusted cells and bounded
--     FillDirectionMaxCells so tiles never squash.
--   * Parts list + applied-mods list use UIListLayout vertical + pixel
--     row heights with AutomaticSize.Y on the containing wrapper.
--   * Stats row uses UIGridLayout with scale-share columns + pixel gap.
--   * Commit button + preview button sit in a horizontal UIListLayout;
--     preview is pixel-width, commit flex-fills.

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ContextActionService = game:GetService('ContextActionService')
local Players = game:GetService('Players')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local peek = Fusion.peek

-- Artisan catalog imports (Stage A) + commit remote (Stage B). The local
-- MATERIALS / BLUEPRINTS / MODIFIERS adapter tables built below preserve
-- the lowercase-field shape this widget was written against; the catalog
-- modules use CapsCase so we re-shape at module load.
local MaterialsConfig  = ReplicatedModules.Data.Materials
local BlueprintsConfig = ReplicatedModules.Data.Blueprints
local ModifiersConfig  = ReplicatedModules.Data.Modifiers
local LevelGates       = ReplicatedModules.Data.LevelGates
local ReplicatedData   = ReplicatedModules.Services.ReplicatedData
local RemoteService    = ReplicatedModules.Services.RemoteService
local ForgeShared      = ReplicatedModules.Services.ForgeShared
local ForgeEvent       = RemoteService.GetRemote('ForgeEvent', 'RemoteEvent', false)

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local LevelLockOverlay = LocalModules.Modules.LevelLockOverlay
local LevelGatesClient = LocalModules.Modules.LevelGatesClient
-- Subscribed in Start to the 'Blueprints' / 'Modifiers' replication
-- signals so this widget's convenience caches refresh when the
-- per-player bundle lands. See refreshBlueprintCache + RegistryVersion.
local ConfigReplicationClient = LocalModules.Modules.ConfigReplicationClient
local PALETTE = HUDCommon.PALETTE

local SystemsContainer = {}

-- // Catalogs (ported from forge.jsx) // --

-- // Adapter shapes — re-projection of the catalog modules to the
-- lowercase-field names this widget code was originally written
-- against. Build once at module load; widgets continue to read
-- MATERIALS / MATERIAL_INDEX / BLUEPRINTS / BLUEPRINT_INDEX / MODIFIERS
-- / MODIFIER_INDEX as before. //
type Material = { id: string, name: string, color: Color3, dmg: number, spd: number, wgt: number, dur: number, trait: string }
local MATERIALS: {Material} = {}
local MATERIAL_INDEX: {[string]: Material} = {}
do
	for _, m in MaterialsConfig.Materials do
		local entry = {
			id = m.Id, name = m.Name, color = m.Color,
			dmg = m.Damage, spd = m.Speed, wgt = m.Weight, dur = m.Durability,
			trait = m.Trait,
		}
		table.insert(MATERIALS, entry)
		MATERIAL_INDEX[m.Id] = entry
	end
	-- Stable iteration order in UI by ascending damage.
	table.sort(MATERIALS, function(a, b) return a.dmg < b.dmg end)
end

type Blueprint = { id: string, name: string, slots: {{key: string, label: string, position: {x: number, y: number}?}} }
local BLUEPRINTS: {Blueprint} = {}
local BLUEPRINT_INDEX: {[string]: Blueprint} = {}

-- Post-migration: BlueprintsConfig.Blueprints is an empty client shell
-- at module load, populated by ConfigReplicationClient as the player's
-- bundle arrives. Build the convenience caches via a function we can
-- re-run when replication lands. Initial call covers the
-- already-bootstrapped case (rare — admin or rejoin); the
-- ConfigReplicationClient.GetSignal('Blueprints') wire-up in Start
-- handles the normal late-arrival case.
local function refreshBlueprintCache()
	table.clear(BLUEPRINTS)
	table.clear(BLUEPRINT_INDEX)
	for _, bp in BlueprintsConfig.Blueprints do
		local slots = {}
		for _, s in bp.Slots do
			table.insert(slots, {
				key = s.key, label = s.Label,
				position = s.Position,  -- {x, y} or nil → fallback to staircase
			})
		end
		local entry = { id = bp.Id, name = bp.Name, slots = slots }
		table.insert(BLUEPRINTS, entry)
		BLUEPRINT_INDEX[bp.Id] = entry
	end
	table.sort(BLUEPRINTS, function(a, b) return a.id < b.id end)
end
refreshBlueprintCache()

type Modifier = { id: string, name: string, color: Color3, effect: string, cost: number, stack: number }
local MODIFIERS: {Modifier} = {}
local MODIFIER_INDEX: {[string]: Modifier} = {}

-- Same pattern as refreshBlueprintCache — Modifiers is also a
-- migrated empty-shell at module load, populated late.
local function refreshModifierCache()
	table.clear(MODIFIERS)
	table.clear(MODIFIER_INDEX)
	for _, mo in ModifiersConfig.Modifiers do
		local entry = {
			id = mo.Id, name = mo.Name, color = mo.Color,
			effect = mo.Effect, cost = mo.Cost, stack = mo.MaxStack,
		}
		table.insert(MODIFIERS, entry)
		MODIFIER_INDEX[mo.Id] = entry
	end
	table.sort(MODIFIERS, function(a, b) return a.id < b.id end)
end
refreshModifierCache()

-- MaxModifierSlots is a constant declared in the shell (NOT spoiler
-- content; it's the slot-budget cap the forge enforces) so it's
-- available at module load regardless of replication state.
local MOD_SLOTS_MAX = ModifiersConfig.MaxModifierSlots

----------------------------------------------------------------------
-- DESIGN DIMENSIONS (pixels, from tmp/aincrad-ui/forge.jsx)
----------------------------------------------------------------------

-- Column widths: jsx `gridTemplateColumns: '260px 1fr 300px'`.
local DESIGN_LEFT_W           = 260
local DESIGN_RIGHT_W          = 300
local DESIGN_COL_GAP          = 0          -- jsx uses borderRight/Left, no explicit gap

-- Column padding (jsx: padding:'14px 14px' for left/right, '14px 20px' center).
local DESIGN_LEFT_PAD_X       = 14
local DESIGN_LEFT_PAD_Y       = 14
local DESIGN_RIGHT_PAD_X      = 14
local DESIGN_RIGHT_PAD_Y      = 14
local DESIGN_CENTER_PAD_X     = 20
local DESIGN_CENTER_PAD_Y     = 14

-- Stack gaps.
local DESIGN_LEFT_STACK_GAP   = 8
local DESIGN_CENTER_STACK_GAP = 12
local DESIGN_RIGHT_STACK_GAP  = 8

-- Eyebrow header (jsx: fontSize:9, marginBottom:6).
local DESIGN_EYEBROW_H        = 12
local DESIGN_EYEBROW_GAP      = 6

-- Blueprint grid (jsx: grid 1fr 1fr gap:4, button padding 8px 6px with icon + label).
local DESIGN_BP_CELL_H        = 50
local DESIGN_BP_CELL_PAD      = 4
local DESIGN_BP_COLS          = 2

-- Parts list (jsx: flex row, gap:10, padding 7px 8px, swatch 18x18).
local DESIGN_PART_ROW_H       = 36
local DESIGN_PART_ROW_GAP     = 3
local DESIGN_PART_PAD_X       = 8
local DESIGN_PART_SWATCH      = 18
local DESIGN_PART_SWATCH_GAP  = 10
local DESIGN_PART_LABEL_H     = 10
local DESIGN_PART_NAME_H      = 14

-- Preview area (jsx: flex:1, minHeight:240).
local DESIGN_PREVIEW_MIN_H    = 240

-- Stats row (jsx: grid 5 cols, gap:4, padding 6px 8px per cell).
local DESIGN_STATS_H          = 48
local DESIGN_STATS_CELL_PAD   = 4
local DESIGN_STATS_COLS       = 5
local DESIGN_STATS_LABEL_H    = 12
local DESIGN_STATS_LABEL_TOP  = 4
local DESIGN_STATS_VALUE_H    = 22
local DESIGN_STATS_VALUE_TOP  = DESIGN_STATS_LABEL_TOP + DESIGN_STATS_LABEL_H + 2

-- Commit + preview buttons (jsx: flex row gap:6, commit padding 11px flex:1,
-- preview padding '11px 16px').
local DESIGN_COMMIT_ROW_H     = 44
local DESIGN_COMMIT_ROW_GAP   = 6
local DESIGN_PREVIEW_BTN_W    = 100

-- Material chosen preview card (jsx: padding:8, 30x30 swatch).
local DESIGN_MATPREVIEW_H     = 46
local DESIGN_MATPREVIEW_PAD   = 8
local DESIGN_MATPREVIEW_SW    = 30
local DESIGN_MATPREVIEW_GAP   = 8
local DESIGN_MATPREVIEW_NAME_H = 16
local DESIGN_MATPREVIEW_TRAIT_H = 12

-- Material palette grid (jsx: grid 2col gap:3, button padding 5px 7px, 12x12 swatch).
local DESIGN_MAT_CELL_H       = 28
local DESIGN_MAT_CELL_PAD     = 3
local DESIGN_MAT_COLS         = 2
local DESIGN_MAT_SWATCH       = 12
local DESIGN_MAT_SWATCH_GAP   = 6
local DESIGN_MAT_PAD_X        = 7

-- Applied mods row (jsx: padding 5px 7px, 8px dot + name + effect + ✕).
local DESIGN_APPLIED_ROW_H    = 26
local DESIGN_APPLIED_ROW_GAP  = 3
local DESIGN_APPLIED_DOT      = 8
local DESIGN_APPLIED_PAD_X    = 8
local DESIGN_APPLIED_CLOSE    = 18
local DESIGN_APPLIED_EFFECT_W = 96

-- Available mods grid (jsx: grid 2col gap:3, button padding 4px 6px, 6px dot).
local DESIGN_AVAIL_CELL_H     = 22
local DESIGN_AVAIL_CELL_PAD   = 3
local DESIGN_AVAIL_COLS       = 2
local DESIGN_AVAIL_DOT        = 6
local DESIGN_AVAIL_PAD_X      = 6
local DESIGN_AVAIL_COST_W     = 20

-- Mod cost bar (jsx: 4px bar between header and list).
local DESIGN_MODBAR_H         = 6
local DESIGN_MODBAR_GAP       = 6

-- // Module // --

local Module = {}

local ScreenGui: Frame? = nil
local RootScope = nil

-- Fusion Values (created in Start)
local IsOpen
local BlueprintId
local ActiveSlotKey
local Materials          -- Value<{[slotKey]: materialId}>
local AppliedMods        -- Value<{{id: string, stacks: number}}>
-- Bumped each time ConfigReplicationClient pushes a 'Blueprints' or
-- 'Modifiers' bundle so Computeds that read the convenience caches
-- (BLUEPRINTS / BLUEPRINT_INDEX / MODIFIERS / MODIFIER_INDEX) re-eval
-- once replication lands. Declared at module scope because
-- buildPartsList / buildPanels reference it.
local RegistryVersion    -- Value<number> — assigned in Module.Start

-- // Helpers // --

local function computeStats(use)
	-- Subscribe to RegistryVersion so this Computed re-evaluates when
	-- the Blueprints / Modifiers shells get populated mid-session.
	use(RegistryVersion)
	local bp = BLUEPRINT_INDEX[use(BlueprintId)] or BLUEPRINTS[1]
	local mats = use(Materials)
	local mods = use(AppliedMods)

	-- Pre-replication state: BLUEPRINTS empty → bp nil. Return zeroed
	-- stats so the stats panel renders '0' / empty rather than erroring
	-- on `#bp.slots`. The shape (string for spd/wgt) matches the real
	-- return below — TextLabel.Text consumers downstream expect strings,
	-- so a numeric 0 here would surface as a Fusion invalidPropertyType
	-- warning. Once the bundle lands, RegistryVersion bumps and this
	-- Computed re-runs with the populated registry.
	if not bp or typeof(bp.slots) ~= 'table' or #bp.slots == 0 then
		return { dmg = 0, spd = '0.00', wgt = '0.0', dur = 0, crit = 0 }
	end

	local w = 1 / #bp.slots
	local dmg, spd, wgt, dur = 0, 0, 0, 0
	for _, slot in bp.slots do
		local m = MATERIAL_INDEX[mats[slot.key]] or MATERIAL_INDEX.iron
		dmg += m.dmg * w; spd += m.spd * w; wgt += m.wgt * w; dur += m.dur * w
	end
	local crit = 28
	for _, mod in mods do
		if mod.id == 'sharp'   then dmg += 24 * mod.stacks end
		if mod.id == 'haste'   then spd *= (1 + 0.12 * mod.stacks) end
		if mod.id == 'diamond' then dur *= 2 end
		if mod.id == 'ember'   then dmg += 40 * mod.stacks end
		if mod.id == 'arc'     then crit += 15 * mod.stacks end
	end
	return {
		dmg = math.floor(dmg),
		spd = string.format('%.2f', spd),
		wgt = string.format('%.1f', wgt),
		dur = math.floor(dur * 1000),
		crit = crit,
	}
end

local function totalModCost(use): number
	local sum = 0
	for _, mod in use(AppliedMods) do
		local M = MODIFIER_INDEX[mod.id]
		if M then sum += M.cost * mod.stacks end
	end
	return sum
end

local function setMaterial(slotKey: string, materialId: string)
	local copy = table.clone(peek(Materials))
	copy[slotKey] = materialId
	Materials:set(copy)
end

local function addMod(id: string)
	local M = MODIFIER_INDEX[id]
	if not M then return end
	local current = table.clone(peek(AppliedMods))
	for _, entry in current do
		if entry.id == id then
			if entry.stacks < M.stack then
				entry.stacks += 1
				AppliedMods:set(current)
			end
			return
		end
	end
	if #current < 6 then
		table.insert(current, { id = id, stacks = 1 })
		AppliedMods:set(current)
	end
end

local function removeMod(id: string)
	local current = peek(AppliedMods)
	local filtered = {}
	for _, entry in current do
		if entry.id ~= id then
			table.insert(filtered, entry)
		end
	end
	AppliedMods:set(filtered)
end

-- // UI builders // --

----------------------------------------------------------------------
-- Blueprint picker: UIGridLayout with half-width pixel-adjusted cells
-- and bounded column count so tiles never squash.
----------------------------------------------------------------------
local function buildBlueprintGrid(scope)
	-- Reactive: rebuild tiles when BLUEPRINTS changes (Blueprints
	-- replication landing post-bootstrap). The previous static
	-- `for ... in BLUEPRINTS` loop captured an empty list at construction
	-- time and never re-populated. ForPairs over a Computed that
	-- subscribes to RegistryVersion fixes that — children regenerate
	-- whenever the cache refreshes.
	return scope:New('Frame') {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIGridLayout') {
				CellSize = UDim2.new(
					1 / DESIGN_BP_COLS, -math.ceil(DESIGN_BP_CELL_PAD / 2),
					0, DESIGN_BP_CELL_H
				),
				CellPadding = UDim2.fromOffset(DESIGN_BP_CELL_PAD, DESIGN_BP_CELL_PAD),
				FillDirectionMaxCells = DESIGN_BP_COLS,
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:ForPairs(
				scope:Computed(function(use)
					use(RegistryVersion)
					-- Build a numeric-keyed array Fusion can iterate
					-- via ForPairs. Each entry is a (sort-stable)
					-- record of fields the tile factory below reads.
					local out = {}
					for i, bp in BLUEPRINTS do
						out[i] = bp
					end
					return out
				end),
				function(_use, innerScope, i, bp)
					local isActive = innerScope:Computed(function(u)
						return u(BlueprintId) == bp.id
					end)
					return i, innerScope:New('TextButton') {
						LayoutOrder = i,
						AutoButtonColor = false,
						BackgroundColor3 = PALETTE.bg0,
						BackgroundTransparency = innerScope:Computed(function(u) return u(isActive) and 0.3 or 0.2 end),
						BorderSizePixel = 0,
						FontFace = HUDCommon.FONT_UI,
						Text = bp.name,
						TextSize = 12,
						TextColor3 = innerScope:Computed(function(u) return u(isActive) and PALETTE.accent or PALETTE.ink end),
						[Fusion.OnEvent('Activated')] = function()
							BlueprintId:set(bp.id)
							-- Defensive: bp.slots may be nil only if a
							-- malformed config slipped past the
							-- refreshBlueprintCache build (it shouldn't),
							-- but no point crashing on click if so.
							if bp.slots and bp.slots[1] then
								ActiveSlotKey:set(bp.slots[1].key)
							end
						end,
						[Fusion.Children] = {
							innerScope:New('UIStroke') {
								Color = PALETTE.accent,
								Transparency = innerScope:Computed(function(u) return u(isActive) and 0.1 or 0.7 end),
								Thickness = 1,
							},
						},
					}
				end
			),
		},
	}
end

----------------------------------------------------------------------
-- Parts list: vertical UIListLayout, pixel row height. Each row has
-- a pixel swatch + label stack.
----------------------------------------------------------------------
local function buildPartsList(scope)
	return scope:New('Frame') {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, DESIGN_PART_ROW_GAP),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:ForPairs(
				scope:Computed(function(use)
					-- Subscribe to RegistryVersion so the cache rebuilds
					-- (BLUEPRINTS / BLUEPRINT_INDEX) trigger a re-eval of
					-- this Computed when 'Blueprints' replication lands.
					use(RegistryVersion)
					local bp = BLUEPRINT_INDEX[use(BlueprintId)] or BLUEPRINTS[1]
					-- Defensive: shell may still be empty (replication
					-- hasn't landed yet for this player). Render an
					-- empty parts-list rather than erroring on `bp.slots`.
					if not bp then return {} end
					local mats = use(Materials)
					local out = {}
					for i, slot in bp.slots do
						local matId = mats[slot.key] or 'iron'
						table.insert(out, {
							order = i, slotKey = slot.key, label = slot.label,
							material = MATERIAL_INDEX[matId] or MATERIAL_INDEX.iron,
						})
					end
					return out
				end),
				function(use, innerScope, idx, entry)
					local isActive = innerScope:Computed(function(u) return u(ActiveSlotKey) == entry.slotKey end)
					local textX = DESIGN_PART_SWATCH + DESIGN_PART_SWATCH_GAP
					return entry.slotKey, innerScope:New('TextButton') {
						LayoutOrder = entry.order,
						Size = UDim2.new(1, 0, 0, DESIGN_PART_ROW_H),
						AutoButtonColor = false,
						BackgroundColor3 = PALETTE.bg0,
						BackgroundTransparency = innerScope:Computed(function(u) return u(isActive) and 0.3 or 0.2 end),
						BorderSizePixel = 0,
						Text = '',
						[Fusion.OnEvent('Activated')] = function() ActiveSlotKey:set(entry.slotKey) end,
						[Fusion.Children] = {
							innerScope:New('UIStroke') {
								Color = PALETTE.accent,
								Transparency = innerScope:Computed(function(u) return u(isActive) and 0.15 or 0.75 end),
								Thickness = 1,
							},
							innerScope:New('UIPadding') {
								PaddingLeft = UDim.new(0, DESIGN_PART_PAD_X),
								PaddingRight = UDim.new(0, DESIGN_PART_PAD_X),
							},
							-- Material swatch (pixel square, aspect-locked).
							innerScope:New('Frame') {
								AnchorPoint = Vector2.new(0, 0.5),
								Position = UDim2.new(0, 0, 0.5, 0),
								Size = UDim2.fromOffset(DESIGN_PART_SWATCH, DESIGN_PART_SWATCH),
								BackgroundColor3 = entry.material.color,
								BorderSizePixel = 0,
								[Fusion.Children] = {
									innerScope:New('UIAspectRatioConstraint') { AspectRatio = 1 },
									innerScope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.5, Thickness = 1 },
								},
							},
							-- Part label (eyebrow).
							innerScope:New('TextLabel') {
								Position = UDim2.new(0, textX, 0, 4),
								Size = UDim2.new(1, -textX, 0, DESIGN_PART_LABEL_H),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_MONO,
								Text = string.upper(entry.label),
								TextSize = 9,
								TextColor3 = PALETTE.inkFaint,
								TextXAlignment = Enum.TextXAlignment.Left,
							},
							-- Material name.
							innerScope:New('TextLabel') {
								Position = UDim2.new(0, textX, 0, 4 + DESIGN_PART_LABEL_H),
								Size = UDim2.new(1, -textX, 0, DESIGN_PART_NAME_H),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_UI,
								Text = entry.material.name,
								TextSize = 12,
								TextColor3 = PALETTE.ink,
								TextXAlignment = Enum.TextXAlignment.Left,
							},
						},
					}
				end
			),
		},
	}
end

----------------------------------------------------------------------
-- Selected material preview card (right column).
----------------------------------------------------------------------
local function buildMaterialPreview(scope)
	local matComputed = scope:Computed(function(use)
		local id = use(Materials)[use(ActiveSlotKey)] or 'iron'
		return MATERIAL_INDEX[id] or MATERIAL_INDEX.iron
	end)
	local textX = DESIGN_MATPREVIEW_SW + DESIGN_MATPREVIEW_GAP
	return scope:New('Frame') {
		Name = 'MaterialPreview',
		Size = UDim2.new(1, 0, 0, DESIGN_MATPREVIEW_H),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.6, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, DESIGN_MATPREVIEW_PAD),
				PaddingRight = UDim.new(0, DESIGN_MATPREVIEW_PAD),
				PaddingTop = UDim.new(0, DESIGN_MATPREVIEW_PAD),
				PaddingBottom = UDim.new(0, DESIGN_MATPREVIEW_PAD),
			},
			scope:New('Frame') {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 0, 0.5, 0),
				Size = UDim2.fromOffset(DESIGN_MATPREVIEW_SW, DESIGN_MATPREVIEW_SW),
				BackgroundColor3 = scope:Computed(function(use) return use(matComputed).color end),
				BorderSizePixel = 0,
				[Fusion.Children] = {
					scope:New('UIAspectRatioConstraint') { AspectRatio = 1 },
					scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.3, Thickness = 1 },
				},
			},
			scope:New('TextLabel') {
				Position = UDim2.new(0, textX, 0, 0),
				Size = UDim2.new(1, -textX, 0, DESIGN_MATPREVIEW_NAME_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = scope:Computed(function(use) return use(matComputed).name end),
				TextSize = 13, TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				Position = UDim2.new(0, textX, 0, DESIGN_MATPREVIEW_NAME_H + 2),
				Size = UDim2.new(1, -textX, 0, DESIGN_MATPREVIEW_TRAIT_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use) return use(matComputed).trait end),
				TextSize = 9, TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
		},
	}
end

----------------------------------------------------------------------
-- Material palette: UIGridLayout, 2 cols pixel-adjusted, pixel row height.
----------------------------------------------------------------------
local function buildMaterialPalette(scope)
	local children: {any} = {
		scope:New('UIGridLayout') {
			CellSize = UDim2.new(
				1 / DESIGN_MAT_COLS, -math.ceil(DESIGN_MAT_CELL_PAD / 2),
				0, DESIGN_MAT_CELL_H
			),
			CellPadding = UDim2.fromOffset(DESIGN_MAT_CELL_PAD, DESIGN_MAT_CELL_PAD),
			FillDirectionMaxCells = DESIGN_MAT_COLS,
			SortOrder = Enum.SortOrder.LayoutOrder,
		},
	}
	for i, mat in MATERIALS do
		local isActive = scope:Computed(function(use)
			return use(Materials)[use(ActiveSlotKey)] == mat.id
		end)
		local textX = DESIGN_MAT_SWATCH + DESIGN_MAT_SWATCH_GAP
		table.insert(children, scope:New('TextButton') {
			LayoutOrder = i,
			AutoButtonColor = false,
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = scope:Computed(function(use) return use(isActive) and 0.3 or 0.2 end),
			BorderSizePixel = 0,
			Text = '',
			[Fusion.OnEvent('Activated')] = function()
				setMaterial(peek(ActiveSlotKey), mat.id)
			end,
			[Fusion.Children] = {
				scope:New('UIStroke') {
					Color = PALETTE.accent,
					Transparency = scope:Computed(function(use) return use(isActive) and 0.1 or 0.8 end),
					Thickness = 1,
				},
				scope:New('UIPadding') {
					PaddingLeft = UDim.new(0, DESIGN_MAT_PAD_X),
					PaddingRight = UDim.new(0, DESIGN_MAT_PAD_X),
				},
				scope:New('Frame') {
					AnchorPoint = Vector2.new(0, 0.5),
					Position = UDim2.new(0, 0, 0.5, 0),
					Size = UDim2.fromOffset(DESIGN_MAT_SWATCH, DESIGN_MAT_SWATCH),
					BackgroundColor3 = mat.color,
					BorderSizePixel = 0,
					[Fusion.Children] = {
						scope:New('UIAspectRatioConstraint') { AspectRatio = 1 },
					},
				},
				scope:New('TextLabel') {
					Position = UDim2.new(0, textX, 0, 0),
					Size = UDim2.new(1, -textX, 1, 0),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_UI,
					Text = mat.name,
					TextSize = 11,
					TextColor3 = PALETTE.ink,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
			},
		})
	end
	return scope:New('Frame') {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		[Fusion.Children] = children,
	}
end

----------------------------------------------------------------------
-- Applied mods: vertical list, pixel row height, pixel swatch + ✕ button.
----------------------------------------------------------------------
local function buildAppliedMods(scope)
	return scope:New('Frame') {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, DESIGN_APPLIED_ROW_GAP),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:ForPairs(
				scope:Computed(function(use)
					local out = {}
					for i, m in use(AppliedMods) do
						local M = MODIFIER_INDEX[m.id]
						if M then table.insert(out, { order = i, id = m.id, stacks = m.stacks, mod = M }) end
					end
					return out
				end),
				function(use, innerScope, idx, entry)
					local M = entry.mod
					local textX = DESIGN_APPLIED_DOT + DESIGN_APPLIED_PAD_X
					local rightReserved = DESIGN_APPLIED_CLOSE + DESIGN_APPLIED_EFFECT_W + 4
					return entry.id, innerScope:New('Frame') {
						LayoutOrder = entry.order,
						Size = UDim2.new(1, 0, 0, DESIGN_APPLIED_ROW_H),
						BackgroundColor3 = M.color,
						BackgroundTransparency = 0.85,
						BorderSizePixel = 0,
						[Fusion.Children] = {
							innerScope:New('UIStroke') { Color = M.color, Transparency = 0.4, Thickness = 1 },
							innerScope:New('UIPadding') {
								PaddingLeft = UDim.new(0, DESIGN_APPLIED_PAD_X),
								PaddingRight = UDim.new(0, DESIGN_APPLIED_PAD_X),
							},
							-- Colored dot (pixel circle).
							innerScope:New('Frame') {
								AnchorPoint = Vector2.new(0, 0.5),
								Position = UDim2.new(0, 0, 0.5, 0),
								Size = UDim2.fromOffset(DESIGN_APPLIED_DOT, DESIGN_APPLIED_DOT),
								BackgroundColor3 = M.color,
								BorderSizePixel = 0,
								[Fusion.Children] = {
									innerScope:New('UIAspectRatioConstraint') { AspectRatio = 1 },
									innerScope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
								},
							},
							-- Name ×stacks.
							innerScope:New('TextLabel') {
								Position = UDim2.new(0, textX, 0, 0),
								Size = UDim2.new(1, -(textX + rightReserved), 1, 0),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_UI,
								Text = string.format('%s ×%d', M.name, entry.stacks),
								TextSize = 11, TextColor3 = M.color,
								TextXAlignment = Enum.TextXAlignment.Left,
							},
							-- Effect (pixel width, right-aligned before ✕).
							innerScope:New('TextLabel') {
								AnchorPoint = Vector2.new(1, 0.5),
								Position = UDim2.new(1, -DESIGN_APPLIED_CLOSE, 0.5, 0),
								Size = UDim2.fromOffset(DESIGN_APPLIED_EFFECT_W, DESIGN_APPLIED_ROW_H),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_MONO,
								Text = M.effect,
								TextSize = 10, TextColor3 = PALETTE.inkDim,
								TextXAlignment = Enum.TextXAlignment.Right,
							},
							-- Close button.
							innerScope:New('TextButton') {
								AnchorPoint = Vector2.new(1, 0.5),
								Position = UDim2.new(1, 0, 0.5, 0),
								Size = UDim2.fromOffset(DESIGN_APPLIED_CLOSE, DESIGN_APPLIED_CLOSE),
								BackgroundTransparency = 1,
								AutoButtonColor = false,
								FontFace = HUDCommon.FONT_MONO,
								Text = '✕',
								TextSize = 12, TextColor3 = PALETTE.inkDim,
								[Fusion.OnEvent('Activated')] = function() removeMod(entry.id) end,
							},
						},
					}
				end
			),
		},
	}
end

----------------------------------------------------------------------
-- Available-mods grid: 2-col UIGridLayout, pixel cells.
----------------------------------------------------------------------
local function buildAvailableMods(scope)
	return scope:New('Frame') {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIGridLayout') {
				CellSize = UDim2.new(
					1 / DESIGN_AVAIL_COLS, -math.ceil(DESIGN_AVAIL_CELL_PAD / 2),
					0, DESIGN_AVAIL_CELL_H
				),
				CellPadding = UDim2.fromOffset(DESIGN_AVAIL_CELL_PAD, DESIGN_AVAIL_CELL_PAD),
				FillDirectionMaxCells = DESIGN_AVAIL_COLS,
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:ForPairs(
				scope:Computed(function(use)
					use(RegistryVersion)  -- re-eval when modifiers replicate
					local applied = use(AppliedMods)
					local out = {}
					for i, mod in MODIFIERS do
						local appliedEntry
						for _, e in applied do
							if e.id == mod.id then appliedEntry = e break end
						end
						if appliedEntry and appliedEntry.stacks >= mod.stack then continue end
						table.insert(out, { order = i, mod = mod })
					end
					return out
				end),
				function(use, innerScope, idx, entry)
					local M = entry.mod
					local textX = DESIGN_AVAIL_DOT + DESIGN_AVAIL_PAD_X
					local rightReserved = DESIGN_AVAIL_COST_W + 4
					return M.id, innerScope:New('TextButton') {
						LayoutOrder = entry.order,
						AutoButtonColor = false,
						BackgroundColor3 = PALETTE.bg0,
						BackgroundTransparency = 0.2,
						BorderSizePixel = 0,
						Text = '',
						[Fusion.OnEvent('Activated')] = function() addMod(M.id) end,
						[Fusion.Children] = {
							innerScope:New('UIStroke') { Color = M.color, Transparency = 0.5, Thickness = 1 },
							innerScope:New('UIPadding') {
								PaddingLeft = UDim.new(0, DESIGN_AVAIL_PAD_X),
								PaddingRight = UDim.new(0, DESIGN_AVAIL_PAD_X),
							},
							innerScope:New('Frame') {
								AnchorPoint = Vector2.new(0, 0.5),
								Position = UDim2.new(0, 0, 0.5, 0),
								Size = UDim2.fromOffset(DESIGN_AVAIL_DOT, DESIGN_AVAIL_DOT),
								BackgroundColor3 = M.color,
								BorderSizePixel = 0,
								[Fusion.Children] = {
									innerScope:New('UIAspectRatioConstraint') { AspectRatio = 1 },
									innerScope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
								},
							},
							innerScope:New('TextLabel') {
								Position = UDim2.new(0, textX, 0, 0),
								Size = UDim2.new(1, -(textX + rightReserved), 1, 0),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_UI,
								Text = M.name,
								TextSize = 11,
								TextColor3 = PALETTE.ink,
								TextXAlignment = Enum.TextXAlignment.Left,
							},
							innerScope:New('TextLabel') {
								AnchorPoint = Vector2.new(1, 0),
								Position = UDim2.new(1, 0, 0, 0),
								Size = UDim2.new(0, DESIGN_AVAIL_COST_W, 1, 0),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_MONO,
								Text = tostring(M.cost),
								TextSize = 10,
								TextColor3 = PALETTE.gold,
								TextXAlignment = Enum.TextXAlignment.Right,
							},
						},
					}
				end
			),
		},
	}
end

----------------------------------------------------------------------
-- Stats row (5 equal columns, scale-share widths with pixel pad compensation).
----------------------------------------------------------------------
local function buildStatsRow(scope)
	local statKeys = { 'DMG', 'SPD', 'CRIT', 'WGT', 'DUR' }
	local children: {any} = {
		scope:New('UIGridLayout') {
			CellSize = UDim2.new(
				1 / DESIGN_STATS_COLS,
				-math.ceil(DESIGN_STATS_CELL_PAD * (DESIGN_STATS_COLS - 1) / DESIGN_STATS_COLS),
				1, 0
			),
			CellPadding = UDim2.fromOffset(DESIGN_STATS_CELL_PAD, 0),
			FillDirectionMaxCells = DESIGN_STATS_COLS,
			SortOrder = Enum.SortOrder.LayoutOrder,
		},
	}
	for i, k in statKeys do
		table.insert(children, scope:New('Frame') {
			LayoutOrder = i,
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = 0.2,
			BorderSizePixel = 0,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.8, Thickness = 1 },
				scope:New('TextLabel') {
					Size = UDim2.new(1, 0, 0, DESIGN_STATS_LABEL_H),
					Position = UDim2.fromOffset(0, DESIGN_STATS_LABEL_TOP),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = k,
					TextSize = 9,
					TextColor3 = PALETTE.inkFaint,
				},
				scope:New('TextLabel') {
					Size = UDim2.new(1, 0, 0, DESIGN_STATS_VALUE_H),
					Position = UDim2.fromOffset(0, DESIGN_STATS_VALUE_TOP),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = scope:Computed(function(use)
						local s = computeStats(use)
						if k == 'DMG' then return tostring(s.dmg)
						elseif k == 'SPD' then return s.spd .. 's'
						elseif k == 'CRIT' then return s.crit .. '%'
						elseif k == 'WGT' then return s.wgt
						elseif k == 'DUR' then return tostring(s.dur) end
						return ''
					end),
					TextSize = 16,
					TextColor3 = PALETTE.accent,
				},
			},
		})
	end
	return scope:New('Frame') {
		Size = UDim2.new(1, 0, 0, DESIGN_STATS_H),
		BackgroundTransparency = 1,
		[Fusion.Children] = children,
	}
end

----------------------------------------------------------------------
-- Preview area: fills remaining center-column height above stats + commit.
-- Shows blueprint title as a placeholder for the anvil + weapon silhouette.
----------------------------------------------------------------------
----------------------------------------------------------------------
-- Template view — Tinkers-Construct-style diagonal weapon-shape preview.
-- Each blueprint slot is rendered as a 36x36 box at its `position` grid
-- coordinate, tinted by the currently-chosen material's color. Click a
-- box to set ActiveSlotKey (same affordance as the parts list in the
-- left column). The whole template Frame is centered inside the preview
-- pane and sized to the blueprint's grid bounding box.
--
-- Falls back to a simple staircase when a blueprint slot lacks an
-- explicit Position — slot index i sits at grid (i-1, i-1).
----------------------------------------------------------------------
local DESIGN_TEMPLATE_CELL = 52   -- pixel size of each part box (bumped from 38 for clearer iconography)
local DESIGN_TEMPLATE_GAP  = 10   -- gap between cells (bumped from 4 so the diagonal reads as a sword shape, not a tight staircase)
local DESIGN_TEMPLATE_GLYPH_SIZE = 26  -- centered icon glyph size

-- Per-component-kind glyph. The blueprint slot's `key` is matched
-- against the prefixes below; first match wins. Falls back to the
-- slot key's first letter for unknown kinds. Designers extend this
-- table when new component kinds (cap, butt, fuller, ricasso, etc.)
-- ship — no rendering code change needed.
local COMPONENT_GLYPH = {
	{ prefix = 'blade',  glyph = '\u{2694}' },  -- ⚔ crossed swords
	{ prefix = 'bind',   glyph = '\u{25C7}' },  -- ◇ diamond binding
	{ prefix = 'handle', glyph = '\u{2502}' },  -- │ vertical handle
	{ prefix = 'grip',   glyph = '\u{2502}' },
	{ prefix = 'guard',  glyph = '\u{2500}' },  -- ─ horizontal crossguard
	{ prefix = 'pommel', glyph = '\u{25CF}' },  -- ● solid circle pommel
}
local function glyphForSlotKey(slotKey: string): string
	if typeof(slotKey) ~= 'string' then return '?' end
	for _, entry in COMPONENT_GLYPH do
		if string.sub(slotKey, 1, #entry.prefix):lower() == entry.prefix then
			return entry.glyph
		end
	end
	return string.upper(string.sub(slotKey, 1, 1))
end

local function buildTemplateView(scope)
	return scope:New('Frame') {
		Name = 'TemplateView',
		AnchorPoint = Vector2.new(0.5, 0.5),
		-- Anchored slightly below the title eyebrow at the top of the
		-- preview pane so it doesn't overlap. 0.55 instead of 0.5
		-- nudges the diagonal toward the bottom of the pane.
		Position = UDim2.fromScale(0.5, 0.55),
		BackgroundTransparency = 1,
		Size = scope:Computed(function(use)
			-- Bounding box from the active blueprint's slot positions.
			-- Falls back to staircase math when positions are absent.
			use(RegistryVersion)
			local bp = BLUEPRINT_INDEX[use(BlueprintId)]
			if not bp then return UDim2.fromOffset(0, 0) end
			local maxX, maxY = 0, 0
			for i, slot in bp.slots do
				local pos = slot.position or { x = i - 1, y = i - 1 }
				if pos.x > maxX then maxX = pos.x end
				if pos.y > maxY then maxY = pos.y end
			end
			local step = DESIGN_TEMPLATE_CELL + DESIGN_TEMPLATE_GAP
			local w = (maxX + 1) * DESIGN_TEMPLATE_CELL + maxX * DESIGN_TEMPLATE_GAP
			local h = (maxY + 1) * DESIGN_TEMPLATE_CELL + maxY * DESIGN_TEMPLATE_GAP
			return UDim2.fromOffset(w, h)
		end),
		[Fusion.Children] = {
			scope:ForPairs(
				scope:Computed(function(use)
					use(RegistryVersion)
					local bp = BLUEPRINT_INDEX[use(BlueprintId)]
					local mats = use(Materials)
					if not bp then return {} end
					local out = {}
					for i, slot in bp.slots do
						local pos = slot.position or { x = i - 1, y = i - 1 }
						local matId = mats[slot.key] or 'iron'
						local mat = MATERIAL_INDEX[matId] or MATERIAL_INDEX.iron
						table.insert(out, {
							order = i,
							slotKey = slot.key,
							label = slot.label,
							material = mat,
							x = pos.x, y = pos.y,
						})
					end
					return out
				end),
				function(_use, innerScope, _idx, entry)
					local isActive = innerScope:Computed(function(u)
						return u(ActiveSlotKey) == entry.slotKey
					end)
					local step = DESIGN_TEMPLATE_CELL + DESIGN_TEMPLATE_GAP
					return entry.slotKey, innerScope:New('TextButton') {
						Name = 'TplCell_' .. entry.slotKey,
						LayoutOrder = entry.order,
						AnchorPoint = Vector2.new(0, 0),
						Position = UDim2.fromOffset(entry.x * step, entry.y * step),
						Size = UDim2.fromOffset(DESIGN_TEMPLATE_CELL, DESIGN_TEMPLATE_CELL),
						AutoButtonColor = false,
						BackgroundColor3 = entry.material.color,
						BackgroundTransparency = innerScope:Computed(function(u)
							return u(isActive) and 0 or 0.15
						end),
						BorderSizePixel = 0,
						Text = '',
						[Fusion.OnEvent('Activated')] = function()
							ActiveSlotKey:set(entry.slotKey)
						end,
						[Fusion.Children] = {
							-- Stroke ring brightens on the currently-active
							-- slot so the user can match the parts list
							-- selection visually.
							innerScope:New('UIStroke') {
								Color = innerScope:Computed(function(u)
									return u(isActive) and PALETTE.accentHot or PALETTE.ink
								end),
								Thickness = innerScope:Computed(function(u)
									return u(isActive) and 2 or 1
								end),
								Transparency = innerScope:Computed(function(u)
									return u(isActive) and 0 or 0.4
								end),
							},
							-- Component-kind glyph — ⚔ for blade, ◇ for bind,
							-- │ for handle / grip, ─ for crossguard, ● for
							-- pommel. Designers extend the COMPONENT_GLYPH
							-- table when new kinds ship.
							innerScope:New('TextLabel') {
								Size = UDim2.fromScale(1, 1),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_DISPLAY,
								TextSize = DESIGN_TEMPLATE_GLYPH_SIZE,
								TextColor3 = PALETTE.bg0,
								TextStrokeColor3 = PALETTE.ink,
								TextStrokeTransparency = 0.4,
								Text = glyphForSlotKey(entry.slotKey),
							},
							-- Tiny mono label below the cell when active —
							-- shows the slot's authored Label so the
							-- player knows which slot they're editing
							-- without referencing the right-column list.
							innerScope:New('TextLabel') {
								AnchorPoint = Vector2.new(0.5, 0),
								Position = UDim2.new(0.5, 0, 1, 2),
								Size = UDim2.fromOffset(120, 12),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_MONO,
								TextSize = 9,
								TextColor3 = PALETTE.accent,
								TextTransparency = innerScope:Computed(function(u)
									return u(isActive) and 0 or 1
								end),
								TextXAlignment = Enum.TextXAlignment.Center,
								Text = string.upper(entry.label),
							},
						},
					}
				end
			),
		},
	}
end

local function buildPreviewArea(scope)
	return scope:New('Frame') {
		Name = 'PreviewArea',
		LayoutOrder = 1,
		-- Scale-Y 1 minus the pixel-exact rows underneath and their gaps.
		Size = UDim2.new(
			1, 0,
			1, -(DESIGN_STATS_H + DESIGN_COMMIT_ROW_H + DESIGN_CENTER_STACK_GAP * 2)
		),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UISizeConstraint') {
				MinSize = Vector2.new(0, DESIGN_PREVIEW_MIN_H),
			},
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.7, Thickness = 1 },
			-- Title banner — pinned to the top so it doesn't overlap the
			-- centered template view below it.
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0, 12),
				Size = UDim2.fromOffset(400, 30),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = scope:Computed(function(use)
					use(RegistryVersion)
					local bp = BLUEPRINT_INDEX[use(BlueprintId)]
					return bp and string.format('◆ %s ◆', string.upper(bp.name)) or ''
				end),
				TextSize = 22, TextColor3 = PALETTE.accent,
				TextTransparency = 0.2,
			},
			-- Template visualization — diagonal weapon-shape preview.
			buildTemplateView(scope),
		},
	}
end

----------------------------------------------------------------------
-- Commit button row. PREVIEW has been removed; commit is now a compact
-- button sized to roughly one stat cell, centered horizontally to align
-- visually under the 5-column stats row above.
----------------------------------------------------------------------
local function buildCommitRow(scope)
	-- Width math matches the stats grid cell (1/N − ⌈pad·(N−1)/N⌉), so the
	-- commit button always tracks a single stat column, regardless of
	-- viewport size or center-panel width.
	local statCellTrim = -math.ceil(DESIGN_STATS_CELL_PAD * (DESIGN_STATS_COLS - 1) / DESIGN_STATS_COLS)
	return scope:New('Frame') {
		Name = 'CommitRow',
		LayoutOrder = 3,
		Size = UDim2.new(1, 0, 0, DESIGN_COMMIT_ROW_H),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('TextButton') {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.new(1 / DESIGN_STATS_COLS, statCellTrim, 1, 0),
				AutoButtonColor = false,
				BackgroundColor3 = PALETTE.accent,
				BackgroundTransparency = 0.7,
				BorderSizePixel = 0,
				FontFace = HUDCommon.FONT_MONO,
				Text = '◆ COMMIT ◆',
				TextSize = 12,
				TextColor3 = PALETTE.accent,
				[Fusion.OnEvent('Activated')] = function()
					-- Stage C commit. Server (ForgeServer.AttemptForgeWeapon)
					-- re-validates via ForgeShared.CanForgeWeapon and mints
					-- a new weapon stack of the blueprint's ResultingItemId.
					local appliedMods = peek(AppliedMods) or {}
					local modList = {}
					for _, m in appliedMods do
						-- Server's request shape uses `level`; widget tracks
						-- `stacks`. Same semantic; rename at the boundary.
						table.insert(modList, { id = m.id, level = m.stacks })
					end
					local bpId = peek(BlueprintId)
					local bpCfg = BlueprintsConfig.Blueprints[bpId]
					if not bpCfg then
						warn(string.format('ForgeWidget: unknown blueprint %s', tostring(bpId)))
						return
					end
					ForgeEvent:FireServer(ForgeShared.ForgeActions.TryForge, {
						BlueprintId  = bpId,
						Parts        = peek(Materials),
						Modifiers    = modList,
						TargetItemId = bpCfg.ResultingItemId,
					})
				end,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.15, Thickness = 1 },
				},
			},
		},
	}
end

----------------------------------------------------------------------
-- Mod cost bar (4px progress indicator).
----------------------------------------------------------------------
local function buildModCostBar(scope)
	return scope:New('Frame') {
		Name = 'ModCostBar',
		Size = UDim2.new(1, 0, 0, DESIGN_MODBAR_H),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.8, Thickness = 1 },
			scope:New('Frame') {
				Size = scope:Computed(function(use)
					local frac = math.clamp(totalModCost(use) / MOD_SLOTS_MAX, 0, 1)
					return UDim2.new(frac, 0, 1, 0)
				end),
				BackgroundColor3 = scope:Computed(function(use)
					return totalModCost(use) > MOD_SLOTS_MAX and PALETTE.danger or PALETTE.gold
				end),
				BorderSizePixel = 0,
			},
		},
	}
end

----------------------------------------------------------------------
-- Panels: three-column layout. Left + right pixel widths, center flex.
-- Root fills its tab/workstation content via fromScale(1, 1).
----------------------------------------------------------------------
local function buildPanels(scope)
	-- LEFT column: Blueprint + Parts. Pixel width, full height.
	local leftCol = scope:New('Frame') {
		Name = 'Left',
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.new(0, 0, 0, 0),
		Size = UDim2.new(0, DESIGN_LEFT_W, 1, 0),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, DESIGN_LEFT_PAD_Y),
				PaddingLeft = UDim.new(0, DESIGN_LEFT_PAD_X),
				PaddingRight = UDim.new(0, DESIGN_LEFT_PAD_X),
				PaddingBottom = UDim.new(0, DESIGN_LEFT_PAD_Y),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, DESIGN_LEFT_STACK_GAP),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:New('TextLabel') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, DESIGN_EYEBROW_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO, Text = '◆ BLUEPRINT', TextSize = 10,
				TextColor3 = PALETTE.accent, TextXAlignment = Enum.TextXAlignment.Left,
			},
			(function()
				local g = buildBlueprintGrid(scope); g.LayoutOrder = 2; return g
			end)(),
			scope:New('TextLabel') {
				LayoutOrder = 3,
				Size = UDim2.new(1, 0, 0, DESIGN_EYEBROW_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					use(RegistryVersion)  -- re-eval when blueprints replicate
					local bp = BLUEPRINT_INDEX[use(BlueprintId)] or BLUEPRINTS[1]
					if not bp then return '◆ PARTS · —' end
					return string.format('◆ PARTS · %d', #bp.slots)
				end),
				TextSize = 10,
				TextColor3 = PALETTE.accent, TextXAlignment = Enum.TextXAlignment.Left,
			},
			-- Parts list inside a scrolling wrapper so long blueprints don't
			-- overflow the left column.
			scope:New('ScrollingFrame') {
				LayoutOrder = 4,
				Size = UDim2.new(1, 0, 1, -(
					DESIGN_EYEBROW_H * 2 + DESIGN_LEFT_STACK_GAP * 4
					+ (DESIGN_BP_CELL_H * math.ceil(#BLUEPRINTS / DESIGN_BP_COLS)
						+ DESIGN_BP_CELL_PAD * (math.ceil(#BLUEPRINTS / DESIGN_BP_COLS) - 1))
				)),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				CanvasSize = UDim2.new(),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollBarThickness = 4,
				ScrollBarImageColor3 = PALETTE.accent,
				[Fusion.Children] = { buildPartsList(scope) },
			},
		},
	}

	-- CENTER column: preview + stats + commit. Fill remaining width via
	-- Scale 1 + negative pixel offset for the two pixel-width side columns.
	local centerCol = scope:New('Frame') {
		Name = 'Center',
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.new(0, DESIGN_LEFT_W + DESIGN_COL_GAP, 0, 0),
		Size = UDim2.new(
			1, -(DESIGN_LEFT_W + DESIGN_RIGHT_W + DESIGN_COL_GAP * 2),
			1, 0
		),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, DESIGN_CENTER_PAD_Y),
				PaddingLeft = UDim.new(0, DESIGN_CENTER_PAD_X),
				PaddingRight = UDim.new(0, DESIGN_CENTER_PAD_X),
				PaddingBottom = UDim.new(0, DESIGN_CENTER_PAD_Y),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, DESIGN_CENTER_STACK_GAP),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			buildPreviewArea(scope),
			(function()
				local s = buildStatsRow(scope); s.LayoutOrder = 2; return s
			end)(),
			buildCommitRow(scope),
		},
	}

	-- RIGHT column: Material palette + Modifiers. Pixel width, full height.
	local rightCol = scope:New('Frame') {
		Name = 'Right',
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, DESIGN_RIGHT_W, 1, 0),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, DESIGN_RIGHT_PAD_Y),
				PaddingLeft = UDim.new(0, DESIGN_RIGHT_PAD_X),
				PaddingRight = UDim.new(0, DESIGN_RIGHT_PAD_X),
				PaddingBottom = UDim.new(0, DESIGN_RIGHT_PAD_Y),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, DESIGN_RIGHT_STACK_GAP),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- Material header.
			scope:New('TextLabel') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, DESIGN_EYEBROW_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					use(RegistryVersion)  -- re-eval when blueprints replicate
					local bp = BLUEPRINT_INDEX[use(BlueprintId)] or BLUEPRINTS[1]
					-- Shell still empty (replication pending). Render the
					-- placeholder eyebrow rather than erroring on bp.slots.
					if not bp or typeof(bp.slots) ~= 'table' then return '◆ MATERIAL' end
					local activeKey = use(ActiveSlotKey)
					local slot
					for _, s in bp.slots do if s.key == activeKey then slot = s break end end
					return slot and string.format('◆ MATERIAL · %s', string.upper(slot.label)) or '◆ MATERIAL'
				end),
				TextSize = 10, TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			-- Selected-material preview card.
			(function()
				local p = buildMaterialPreview(scope); p.LayoutOrder = 2; return p
			end)(),
			-- Material palette (2-col grid).
			(function()
				local mp = buildMaterialPalette(scope); mp.LayoutOrder = 3; return mp
			end)(),
			-- Modifiers header row: label + cost count, using horizontal list layout.
			scope:New('Frame') {
				LayoutOrder = 4,
				Size = UDim2.new(1, 0, 0, DESIGN_EYEBROW_H),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('TextLabel') {
						Size = UDim2.new(0.6, 0, 1, 0), BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO, Text = '◆ MODIFIERS', TextSize = 10,
						TextColor3 = PALETTE.accent, TextXAlignment = Enum.TextXAlignment.Left,
					},
					scope:New('TextLabel') {
						AnchorPoint = Vector2.new(1, 0),
						Position = UDim2.new(1, 0, 0, 0),
						Size = UDim2.new(0.4, 0, 1, 0),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = scope:Computed(function(use)
							return string.format('%d / %d', totalModCost(use), MOD_SLOTS_MAX)
						end),
						TextSize = 10, TextColor3 = PALETTE.gold,
						TextXAlignment = Enum.TextXAlignment.Right,
					},
				},
			},
			(function()
				local b = buildModCostBar(scope); b.LayoutOrder = 5; return b
			end)(),
			-- Applied mods.
			(function()
				local a = buildAppliedMods(scope); a.LayoutOrder = 6; return a
			end)(),
			-- "Available" eyebrow.
			scope:New('TextLabel') {
				LayoutOrder = 7,
				Size = UDim2.new(1, 0, 0, DESIGN_EYEBROW_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO, Text = '◆ AVAILABLE', TextSize = 9,
				TextColor3 = PALETTE.inkFaint, TextXAlignment = Enum.TextXAlignment.Left,
			},
			-- Available mods grid.
			(function()
				local av = buildAvailableMods(scope); av.LayoutOrder = 8; return av
			end)(),
		},
	}

	return scope:New('Frame') {
		Name = 'ForgeWidget',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = { leftCol, centerCol, rightCol },
	}
end

-- // Lifecycle // --

function Module.IsWidgetOpen(): boolean
	return IsOpen and peek(IsOpen) or false
end

function Module.OpenWidget()
	if not IsOpen then return end
	-- Level gate. Two bypass paths: per-player flag from PlayerData
	-- (set by Cmdr SetLevelGateBypass) OR server-wide global flag
	-- replicated via the public 'ServerFlags' category (set by Cmdr
	-- SetGlobalLevelGateBypass). Both are ORed inside CanUseSystem.
	local data = ReplicatedData.GetData('PlayerData', false)
	local globalBypass = LevelGatesClient.GetGlobalBypass()
	if data and not LevelGates.CanUseSystem(data, LevelGates.Systems.Forge, globalBypass) then
		LevelLockOverlay.Show(LevelGates.Systems.Forge, tonumber(data.Level) or 1)
		return
	end
	IsOpen:set(true)
end

function Module.CloseWidget()
	if not IsOpen then return end
	IsOpen:set(false)
end

function Module.Start()
	ScreenGui = HUDCommon.ensureScreenGui('HUD_Forge', 40)

	local scope = scoped(Fusion)
	RootScope = scope

	IsOpen        = scope:Value(false)
	BlueprintId   = scope:Value('greatsword')
	ActiveSlotKey = scope:Value('blade1')

	-- Reactive bump for late-arriving config replication. Computeds that
	-- read BLUEPRINTS / BLUEPRINT_INDEX / MODIFIERS / MODIFIER_INDEX
	-- include `use(RegistryVersion)` so they re-evaluate when the
	-- per-player bundle lands and we rebuild the convenience caches.
	-- Initial value is 0; bumped by 1 on each replication push.
	RegistryVersion = scope:Value(0)
	local function onConfigReplicated()
		refreshBlueprintCache()
		refreshModifierCache()
		RegistryVersion:set(peek(RegistryVersion) + 1)
	end
	-- Hook the per-category signals. GetSignal returns nil before
	-- ConfigReplicationClient.Start has run; defer-and-retry handles
	-- the framework-Start ordering race (this module's Start may run
	-- before ConfigReplicationClient's). The fallback heartbeat tick
	-- isn't needed because the framework defers all Starts — by the
	-- time any replication push could fire, all Starts have completed.
	local bpSig = ConfigReplicationClient.GetSignal('Blueprints')
	local modSig = ConfigReplicationClient.GetSignal('Modifiers')
	if bpSig then bpSig:Connect(onConfigReplicated) end
	if modSig then modSig:Connect(onConfigReplicated) end
	-- Default per-slot material assignments. Covers every slot key used
	-- by the surviving (sword-only) blueprints: greatsword + longsword +
	-- dagger. Slot keys for ranged / magic blueprints (limb1, limb2,
	-- string, head) were removed alongside those blueprints — see
	-- Blueprints.luau header comment for the sword-only rationale.
	Materials     = scope:Value({
		blade1='voidglass', blade2='moonsteel',
		bind1='dragonbone', bind2='starsilk', handle='steel',
		guard='steel', pommel='obsidian',
	})
	AppliedMods   = scope:Value({
		{ id='sharp', stacks=3 }, { id='haste', stacks=1 }, { id='ember', stacks=2 },
	})

	local root, content = HUDCommon.workstationShell(scope, {
		Title = 'BLACKIRON FORGE',
		Subtitle = '· The smith\'s anvil · Only here may you assemble weapons ·',
		Location = '',
		Visible = IsOpen,
		OnClose = Module.CloseWidget,
		Width = 1180, Height = 680,
	})
	root.Parent = ScreenGui

	local panels = buildPanels(scope)
	panels.Parent = content

	ContextActionService:BindAction('ForgeEscape', function(_, inputState)
		if inputState == Enum.UserInputState.Begin and Module.IsWidgetOpen() then
			Module.CloseWidget()
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.Escape)

	local ZoneService = ReplicatedModules.Services.ZoneService
	ZoneService.ZoneEnter:Connect(function(character, zoneName)
		if character == LocalPlayer.Character and zoneName == "ForgeCircle" then
			Module.OpenWidget()
		end
	end)
	ZoneService.ZoneLeave:Connect(function(character, zoneName)
		if character == LocalPlayer.Character and zoneName == "ForgeCircle" then
			Module.CloseWidget()
			-- Dismiss the Forge level-lock overlay if it's currently up
			-- (player walked into the zone below the gate, then walked
			-- out without leveling up). Targeted by systemId so an
			-- overlapping zone (e.g. they bumped into a Gems socket
			-- circle while in Forge) doesn't have its lock yanked too.
			LevelLockOverlay.HideIfShowing(LevelGates.Systems.Forge)
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/GemSocketWidget.luau"><![CDATA[-- Phase 4 — Gemsmith's Socketing Anvil workstation.
-- Set gems into socketed equipment; detect 3+ matching-color resonance.
-- Visual reference: tmp/aincrad-ui/workstations.jsx (SocketingAnvil) and
-- tmp/aincrad-ui/character.jsx (gem-card grid and detail panel sizes).
--
-- Layout strategy (see .claude/skills/custom-roblox-ui/SKILL.md §2,3,4,8,10):
--   * Root frame fills its TabWidget content parent via fromScale(1, 1); this is
--     a SUB-panel, not a top-level HUD element — no anchor math, no screen-wide
--     aspect constraint.
--   * All atoms are declared as pixel constants (DESIGN_*) and placed with
--     UDim2.fromOffset so they never depend on nested Scale multiplication.
--   * Gem grid: UIGridLayout with pixel CellSize + pixel CellPadding and a
--     bounded FillDirectionMaxCells so cards tile uniformly regardless of
--     container width.
--   * Detail / resonance panels: pixel width + AutomaticSize.Y — content sizes
--     the panel rather than arbitrary Scale fractions.
--   * Socket frame: pixel-exact square + UIAspectRatioConstraint(1) — never
--     stretches when the left column resizes.
--   * UIListLayout drives all row/column flows; we let AutomaticSize propagate
--     up where possible to flatten nested scale chains.

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ContextActionService = game:GetService('ContextActionService')
local Players = game:GetService('Players')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local peek = Fusion.peek

-- Catalog import (Stage A) + commit remote (Stage B). The local GEMS /
-- GEM_INDEX / CUT_BONUS / RARITY_COLOR variables are rebuilt as
-- adapters to the lowercase-field shape this widget code uses.
local GemsConfig      = ReplicatedModules.Data.Gems
local ItemsConfig     = ReplicatedModules.Data.Items
local LevelGates      = ReplicatedModules.Data.LevelGates
local ReplicatedData  = ReplicatedModules.Services.ReplicatedData
local RemoteService   = ReplicatedModules.Services.RemoteService
local GemSocketShared = ReplicatedModules.Services.GemSocketShared
local GemSocketEvent  = RemoteService.GetRemote('GemSocketEvent', 'RemoteEvent', false)

-- Find the inventory uuid of an owned gem matching the given catalog
-- gem id. Used at commit time to translate the widget's catalog-id
-- Sockets state into the UUID-keyed payload the server expects. Skips
-- gems already in data.SocketedGems (slotted elsewhere). Returns nil
-- when the player doesn't own a free instance.
local function findOwnedGemUuidByGemId(catalogGemId: string): string?
	local data = ReplicatedData.GetData('PlayerData', false)
	if typeof(data) ~= 'table' or typeof(data.Inventory) ~= 'table' then return nil end
	local socketed = data.SocketedGems or {}
	for itemId, uuidcache in data.Inventory do
		local cfg = ItemsConfig.Items[itemId]
		local meta = cfg and ItemsConfig.GetGem(cfg)
		if meta and meta.Id == catalogGemId then
			for uuid, _stack in uuidcache do
				if not socketed[uuid] then return uuid end
			end
		end
	end
	return nil
end

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local LevelLockOverlay = LocalModules.Modules.LevelLockOverlay
local LevelGatesClient = LocalModules.Modules.LevelGatesClient
local PALETTE = HUDCommon.PALETTE

local SystemsContainer = {}

-- // Catalogs // --

type Gem = {
	id: string, name: string, cut: string, rarity: string,
	stat: string, color: Color3, shape: string,
}

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

-- // Adapter shapes — re-projection of GemsConfig to the lowercase-field
-- shape this widget code uses. CUT_BONUS now sources from
-- GemsConfig.CutMultiplier so the catalog stays the single source.
local GEMS: {Gem} = {}
local GEM_INDEX: {[string]: Gem} = {}
do
	for _, g in GemsConfig.Gems do
		local entry = {
			id = g.Id, name = g.Name, cut = g.Cut, rarity = g.Rarity,
			color = g.Color, shape = g.Shape, stat = g.Stat,
		}
		table.insert(GEMS, entry)
		GEM_INDEX[g.Id] = entry
	end
	-- Stable iteration order: rarity rank then name.
	local RARITY_RANK = {
		common=1, uncommon=2, rare=3, epic=4, legendary=5, mythic=6,
	}
	table.sort(GEMS, function(a, b)
		local ra, rb = RARITY_RANK[a.rarity] or 99, RARITY_RANK[b.rarity] or 99
		if ra ~= rb then return ra < rb end
		return a.name < b.name
	end)
end

local CUT_BONUS: {[string]: number} = GemsConfig.CutMultiplier

local RARITY_COLOR: {[string]: Color3} = {
	all       = PALETTE.accent,
	common    = rgb(154,166,184),
	uncommon  = rgb(106,227,168),
	rare      = rgb(126,200,255),
	epic      = rgb(200,157,255),
	legendary = rgb(255,128,64),
	mythic    = rgb(255,198,112),
}

-- Two-row filter set. 7 chips (ALL + 6 rarities) wrap into 4 + 3 at
-- FillDirectionMaxCells = 4; buildRarityFilter's Frame height must
-- accommodate both rows or the grid clips.
local RARITIES: {string} = { 'all', 'common', 'uncommon', 'rare', 'epic', 'legendary', 'mythic' }
local DESIGN_FILTER_MAX_COLS = 4

local SOCKET_COUNT = 4

-- Placeholder inventory for the "Inventory" tab in the right rail.
-- Every entry is something that can carry sockets — weapons, armor,
-- jewelry. Real data will come from PlayerData; this is scaffolding so
-- the tab is functional today and the weapon silhouette's name label
-- can swap when the player picks a different item.
type InvItem = { id: string, name: string, slot: string, tier: string, sockets: number, equipped: boolean }
local EQUIPMENT: {InvItem} = {
	{ id='elucidator',  name='Elucidator',      slot='Greatsword', tier='rare',     sockets=4, equipped=true  },
	{ id='dark_rep',    name='Dark Repulser',   slot='Longsword',  tier='rare',     sockets=3, equipped=false },
	{ id='blood_oath',  name='Blood Oath',      slot='Dagger',     tier='uncommon', sockets=2, equipped=false },
	{ id='starfall',    name='Starfall Bow',    slot='Bow',        tier='epic',     sockets=4, equipped=false },
	{ id='moon_rite',   name='Moon Rite Staff', slot='Staff',      tier='epic',     sockets=3, equipped=false },
	{ id='kite_ward',   name='Kite of Warding', slot='Shield',     tier='common',   sockets=2, equipped=false },
	{ id='bone_plate',  name='Bone Plate',      slot='Chest',      tier='uncommon', sockets=3, equipped=true  },
	{ id='shadow_gyre', name='Shadow Gyre',     slot='Ring',       tier='rare',     sockets=1, equipped=false },
}
local EQUIPMENT_INDEX: {[string]: InvItem} = {}
for _, it in EQUIPMENT do EQUIPMENT_INDEX[it.id] = it end

local TIER_COLOR: {[string]: Color3} = {
	common   = rgb(154,166,184),
	uncommon = rgb(106,227,168),
	rare     = rgb(126,200,255),
	epic     = rgb(200,157,255),
	mythic   = rgb(255,198,112),
}

----------------------------------------------------------------------
-- DESIGN DIMENSIONS (pixels, from tmp/aincrad-ui/character.jsx + workstations.jsx)
----------------------------------------------------------------------

-- Right pouch column (gem grid + filter header).
local DESIGN_POUCH_W          = 280       -- character.jsx right column 280px
local DESIGN_POUCH_PAD        = 14        -- inner padding
local DESIGN_POUCH_HEADER_H   = 14        -- "◆ GEM POUCH" eyebrow
local DESIGN_POUCH_HEADER_GAP = 6         -- gap before filter row
local DESIGN_FILTER_GAP       = 10        -- gap between filter row and grid

-- Right-panel tabs (INVENTORY | GEMS). Compact segmented row above
-- the existing pouch header/filter stack.
local DESIGN_RIGHT_TAB_H      = 26
local DESIGN_RIGHT_TAB_GAP    = 8
-- Inventory row: tier-colored swatch + name/slot + equipped tag.
local DESIGN_INV_ROW_H        = 48
local DESIGN_INV_ROW_GAP      = 4
local DESIGN_INV_SWATCH       = 28
local DESIGN_INV_PAD_X        = 10

-- Rarity filter buttons (character.jsx stat block aesthetic: compact pill).
local DESIGN_FILTER_BTN_W     = 48
local DESIGN_FILTER_BTN_H     = 18
local DESIGN_FILTER_PAD       = 4
-- Two-row wrap height for the rarity filter grid.
local DESIGN_FILTER_ROW_H     = DESIGN_FILTER_BTN_H * 2 + DESIGN_FILTER_PAD

-- Gem cards (character.jsx gear tile: ~120×72 with orb + name + cut).
local DESIGN_CARD_W           = 120
local DESIGN_CARD_H           = 84
local DESIGN_CARD_PAD_X       = 3
local DESIGN_CARD_PAD_Y       = 4
local DESIGN_GEM_ORB          = 18        -- orb diameter inside card
local DESIGN_CARD_NAME_H      = 28        -- wraps 2 lines
local DESIGN_CARD_CUT_H       = 10

-- Grid: inside the pouch's interior width, cards tile 2 wide.
local DESIGN_GRID_COLS        = 2

-- Socket slot (character.jsx sigil frame style, sized for 4-across layout).
local DESIGN_SOCKET_SLOT      = 88        -- full tile width = height
local DESIGN_SOCKET_OUTER     = 64        -- outer ring diameter
local DESIGN_SOCKET_INNER     = 54        -- inner dashed ring
local DESIGN_SOCKET_GEM       = 34        -- gem disc
local DESIGN_SOCKET_LABEL_H   = 11        -- "SOCKET · N"
local DESIGN_SOCKET_NAME_H    = 12        -- gem name under socket
local DESIGN_SOCKET_LABEL_GAP = 3
local DESIGN_SOCKET_ROW_GAP   = 12        -- horizontal gap between sockets

-- Weapon panel (character.jsx model viewer ≈ 320 tall; we use a widescreen frame).
local DESIGN_WEAPON_PANEL_H   = 360       -- total height of weapon+sockets frame
local DESIGN_WEAPON_SIL_W     = 360       -- sword silhouette width
local DESIGN_WEAPON_SIL_H     = 18        -- sword silhouette height
local DESIGN_WEAPON_POMMEL_W  = 14
local DESIGN_WEAPON_POMMEL_H  = 14
local DESIGN_RESONANCE_BANNER_H = 20      -- "◆ RESONANCE · TRIO ◆" banner at top
local DESIGN_RESONANCE_BANNER_PAD = 8

-- Detail + resonance panels sit side by side below the weapon frame.
local DESIGN_DETAIL_PAD_X     = 12
local DESIGN_DETAIL_PAD_Y     = 10
local DESIGN_DETAIL_EYEBROW_H = 12
local DESIGN_DETAIL_GEM_DOT   = 14        -- gem chip in detail row
local DESIGN_DETAIL_NAME_H    = 16
local DESIGN_DETAIL_CUT_H     = 11
local DESIGN_DETAIL_STAT_H    = 30        -- stat text line (may wrap)
local DESIGN_DETAIL_ROW_GAP   = 4
local DESIGN_EXTRACT_W        = 62
local DESIGN_EXTRACT_H        = 16

local DESIGN_RESO_DOT         = 10
local DESIGN_RESO_DOT_GAP     = 4
local DESIGN_RESO_DESC_H      = 34

-- Bind bar (bottom).
local DESIGN_BIND_H           = 48
local DESIGN_BIND_PAD_X       = 14
local DESIGN_BIND_PAD_Y       = 8
local DESIGN_BIND_BLOCK_W     = 100       -- each stat block width
local DESIGN_BIND_LABEL_H     = 10
local DESIGN_BIND_VALUE_H     = 18
local DESIGN_BIND_BLOCK_GAP   = 18
local DESIGN_BIND_BUTTON_W    = 180
local DESIGN_BIND_BUTTON_H    = 32

-- Column / section gaps.
local DESIGN_COL_GAP          = 16
local DESIGN_LEFT_PAD         = 16
local DESIGN_LEFT_STACK_GAP   = 12

-- // Module // --

local Module = {}

local ScreenGui: Frame? = nil
local RootScope = nil

-- Fusion Values
local IsOpen
local Sockets       -- Value<{ [1..4]: gemId | false }>
local ActiveSlot    -- Value<number>
local RarityFilter  -- Value<string>
local RightTab      -- Value<'gems'|'inventory'>
local SelectedItem  -- Value<string> — EQUIPMENT_INDEX key currently receiving gems
-- Tooltip state: { title, body, color, x, y } or nil when hidden.
-- All hoverable targets (gem cards, sockets) write to this; a single
-- floating tooltip frame hydrated at widget-start reads from it.
local ActiveTooltip

-- // Helpers // --

local function resonance(use): boolean
	local sockets = use(Sockets)
	local colors: {Color3} = {}
	for _, id in sockets do
		if id then
			local g = GEM_INDEX[id]
			if g then table.insert(colors, g.color) end
		end
	end
	if #colors < 3 then return false end
	local first = colors[1]
	for i = 2, #colors do
		local c = colors[i]
		if math.abs(c.R - first.R) > 0.15 or math.abs(c.G - first.G) > 0.15 or math.abs(c.B - first.B) > 0.15 then
			return false
		end
	end
	return true
end

local function setSocket(slot: number, gemId: string?)
	local copy = table.clone(peek(Sockets))
	copy[slot] = gemId or false
	Sockets:set(copy)
end

-- Tooltip show/hide wrappers. Keeps every call site one line — avoids
-- having to remember the exact fields the tooltip frame reads.
local function showTooltip(target: GuiObject, title: string, body: string, color: Color3)
	local abs = target.AbsolutePosition
	local size = target.AbsoluteSize
	ActiveTooltip:set({
		title = title, body = body, color = color,
		x = abs.X + size.X + 10, y = abs.Y,
	})
end
local function hideTooltip()
	ActiveTooltip:set(nil)
end

-- Helper: count how many sockets currently hold a given gem id — used
-- by the pouch cards to render a "×N" chip so the player can tell
-- they've socketed the same gem twice.
local function countInSockets(use, gemId: string): number
	local n = 0
	for _, id in use(Sockets) do
		if id == gemId then n += 1 end
	end
	return n
end

-- Find the first empty socket index, or nil if all four are filled.
-- Used when the gem card is clicked and no specific socket is active.
local function firstEmptySocket(use): number?
	local s = use(Sockets)
	for i = 1, SOCKET_COUNT do
		if not s[i] then return i end
	end
	return nil
end

-- // UI builders // --

----------------------------------------------------------------------
-- One socket slot: outer ring + inner dashed ring + gem disc, with
-- label rows beneath. Whole tile is pixel-exact square (88×88 plus
-- label stack below).
----------------------------------------------------------------------
local function buildSocketSlot(scope, i: number)
	local gemComputed = scope:Computed(function(use)
		local id = use(Sockets)[i]
		return id and GEM_INDEX[id] or nil
	end)
	local isActive = scope:Computed(function(use) return use(ActiveSlot) == i end)

	return scope:New('TextButton') {
		Name = 'Socket' .. i,
		-- Pixel-exact tile; width auto-grows with the label stack via
		-- AutomaticSize.X so long gem names don't clip.
		Size = UDim2.fromOffset(DESIGN_SOCKET_SLOT, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Text = '',
		[Fusion.OnEvent('Activated')] = function() ActiveSlot:set(i) end,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, DESIGN_SOCKET_LABEL_GAP),
			},

			-- Outer ring (pixel square, aspect-locked 1:1).
			scope:New('Frame') {
				LayoutOrder = 0,
				Size = UDim2.fromOffset(DESIGN_SOCKET_OUTER, DESIGN_SOCKET_OUTER),
				BackgroundColor3 = PALETTE.bg1,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					scope:New('UIAspectRatioConstraint') { AspectRatio = 1 },
					scope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
					scope:New('UIStroke') {
						Color = PALETTE.accent,
						Transparency = scope:Computed(function(use) return use(isActive) and 0.1 or 0.6 end),
						Thickness = scope:Computed(function(use) return use(isActive) and 2 or 1 end),
					},
					-- Inner dashed ring.
					scope:New('Frame') {
						AnchorPoint = Vector2.new(0.5, 0.5),
						Position = UDim2.fromScale(0.5, 0.5),
						Size = UDim2.fromOffset(DESIGN_SOCKET_INNER, DESIGN_SOCKET_INNER),
						BackgroundColor3 = Color3.new(0, 0, 0),
						BackgroundTransparency = 0.3,
						BorderSizePixel = 0,
						[Fusion.Children] = {
							scope:New('UIAspectRatioConstraint') { AspectRatio = 1 },
							scope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
							scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.75, Thickness = 1 },
						},
					},
					-- Gem disc (or placeholder "+").
					scope:New('Frame') {
						AnchorPoint = Vector2.new(0.5, 0.5),
						Position = UDim2.fromScale(0.5, 0.5),
						Size = UDim2.fromOffset(DESIGN_SOCKET_GEM, DESIGN_SOCKET_GEM),
						BackgroundColor3 = scope:Computed(function(use)
							local g = use(gemComputed)
							return g and g.color or Color3.new(0, 0, 0)
						end),
						BackgroundTransparency = scope:Computed(function(use) return use(gemComputed) and 0 or 1 end),
						BorderSizePixel = 0,
						[Fusion.Children] = {
							scope:New('UIAspectRatioConstraint') { AspectRatio = 1 },
							scope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
							scope:New('UIStroke') {
								Color = Color3.new(1, 1, 1),
								Transparency = scope:Computed(function(use) return use(gemComputed) and 0.3 or 1 end),
								Thickness = 1,
							},
							scope:New('TextLabel') {
								Size = UDim2.fromScale(1, 1),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_MONO,
								Text = scope:Computed(function(use) return use(gemComputed) and '' or '+' end),
								TextSize = 22,
								TextColor3 = PALETTE.accent,
								TextTransparency = 0.3,
							},
						},
					},
				},
			},

			-- Socket label.
			scope:New('TextLabel') {
				LayoutOrder = 1,
				Size = UDim2.fromOffset(DESIGN_SOCKET_SLOT, DESIGN_SOCKET_LABEL_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = string.format('SOCKET · %d', i),
				TextSize = 9,
				TextColor3 = PALETTE.inkDim,
			},
			-- Gem name.
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.fromOffset(DESIGN_SOCKET_SLOT, DESIGN_SOCKET_NAME_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = scope:Computed(function(use)
					local g = use(gemComputed)
					return g and g.name or '—'
				end),
				TextSize = 11,
				TextColor3 = scope:Computed(function(use)
					local g = use(gemComputed)
					return g and g.color or PALETTE.inkFaint
				end),
				TextTruncate = Enum.TextTruncate.AtEnd,
			},
		},
	}
end

----------------------------------------------------------------------
-- Weapon panel: fills available width, fixed pixel height. Contains
-- resonance banner (top), weapon silhouette (center), socket row (bottom).
----------------------------------------------------------------------
local function buildWeaponPanel(scope)
	local socketChildren: {any} = {
		scope:New('UIListLayout') {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Top,
			Padding = UDim.new(0, DESIGN_SOCKET_ROW_GAP),
			SortOrder = Enum.SortOrder.LayoutOrder,
		},
	}
	for i = 1, SOCKET_COUNT do
		local slot = buildSocketSlot(scope, i)
		slot.LayoutOrder = i
		table.insert(socketChildren, slot)
	end

	return scope:New('Frame') {
		Name = 'WeaponPanel',
		LayoutOrder = 1,
		-- Full width of left column; pixel-exact height.
		Size = UDim2.new(1, 0, 0, DESIGN_WEAPON_PANEL_H),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.5,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.75, Thickness = 1 },

			-- Resonance banner (top).
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0, DESIGN_RESONANCE_BANNER_PAD),
				Size = UDim2.new(1, -DESIGN_RESONANCE_BANNER_PAD * 2, 0, DESIGN_RESONANCE_BANNER_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					return resonance(use) and '◆ RESONANCE · TRIO ◆' or ''
				end),
				TextSize = 12, TextColor3 = PALETTE.gold,
			},

			-- Weapon silhouette (dead center of the panel) with a reactive
			-- name label floating just below it. The label binds to
			-- SelectedItem so picking a different item in the INVENTORY
			-- tab updates the "GEMSMITH · <ITEM>" line here in real time.
			scope:New('Frame') {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.45),
				Size = UDim2.fromOffset(DESIGN_WEAPON_SIL_W, DESIGN_WEAPON_SIL_H),
				BackgroundColor3 = Color3.fromRGB(74, 72, 96),
				BorderSizePixel = 0,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.2, Thickness = 1 },
					-- Pommel: pixel square, anchored just outside the silhouette's left edge.
					scope:New('Frame') {
						AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.new(0, -2, 0.5, 0),
						Size = UDim2.fromOffset(DESIGN_WEAPON_POMMEL_W, DESIGN_WEAPON_POMMEL_H),
						BackgroundColor3 = PALETTE.gold,
						BorderSizePixel = 0,
						[Fusion.Children] = {
							scope:New('UIAspectRatioConstraint') { AspectRatio = 1 },
							scope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
						},
					},
					-- Reactive item name below the silhouette.
					scope:New('TextLabel') {
						AnchorPoint = Vector2.new(0.5, 0),
						Position = UDim2.new(0.5, 0, 1, 10),
						Size = UDim2.fromOffset(DESIGN_WEAPON_SIL_W, 14),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = scope:Computed(function(use)
							local it = EQUIPMENT_INDEX[use(SelectedItem)]
							local name = it and string.upper(it.name) or 'NO ITEM'
							return string.format('◆ GEMSMITH · %s ◆', name)
						end),
						TextSize = 10, TextColor3 = PALETTE.accent,
						TextTransparency = 0.4,
					},
				},
			},

			-- Socket row: anchored bottom-center; content-sized height via
			-- AutomaticSize.Y so label stacks decide the row's real height.
			scope:New('Frame') {
				Name = 'SocketRow',
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0.5, 0, 1, -DESIGN_RESONANCE_BANNER_PAD),
				Size = UDim2.fromOffset(0, 0),
				AutomaticSize = Enum.AutomaticSize.XY,
				BackgroundTransparency = 1,
				[Fusion.Children] = socketChildren,
			},

			-- Per-gem floating stats column: anchored to the right edge of
			-- the weapon panel, vertical UIListLayout, one label per
			-- socketed gem. Acts as a "right-hand readout" of every stat
			-- this weapon is gaining, drawn alongside the rune-like socket
			-- row to feel like ambient ritual text.
			scope:New('Frame') {
				Name = 'GemStatsColumn',
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -16, 0.5, 0),
				Size = UDim2.new(0, 180, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						HorizontalAlignment = Enum.HorizontalAlignment.Right,
						Padding = UDim.new(0, 4),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					scope:ForPairs(
						scope:Computed(function(use)
							local out = {}
							for i = 1, SOCKET_COUNT do
								local id = use(Sockets)[i]
								local g = id and GEM_INDEX[id] or nil
								if g then
									table.insert(out, { slot = i, color = g.color, text = g.stat })
								end
							end
							return out
						end),
						function(use, innerScope, idx, entry)
							return entry.slot, innerScope:New('TextLabel') {
								LayoutOrder = entry.slot,
								Size = UDim2.new(1, 0, 0, 16),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_MONO,
								Text = entry.text,
								TextSize = 10,
								TextColor3 = entry.color,
								TextXAlignment = Enum.TextXAlignment.Right,
								TextYAlignment = Enum.TextYAlignment.Center,
								TextWrapped = true,
							}
						end
					),
				},
			},
		},
	}
end

----------------------------------------------------------------------
-- Total Effects panel: the sibling of the Resonance panel. Lists every
-- active gem's applied stat, one line per socketed gem, so the player
-- can see at a glance what the weapon will gain when the gems bind.
-- Replaces the former "◆ SOCKET N" single-slot detail panel.
----------------------------------------------------------------------
local function buildTotalEffects(scope)
	local entriesComputed = scope:Computed(function(use)
		local out = {}
		for i = 1, SOCKET_COUNT do
			local id = use(Sockets)[i]
			local g = id and GEM_INDEX[id] or nil
			if g then
				table.insert(out, { slot = i, id = id, name = g.name, color = g.color, stat = g.stat, cut = g.cut })
			end
		end
		return out
	end)

	return scope:New('Frame') {
		Name = 'TotalEffects',
		Size = UDim2.new(0.5, -math.floor(DESIGN_COL_GAP / 2), 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = PALETTE.bg1,
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.65, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, DESIGN_DETAIL_PAD_Y),
				PaddingBottom = UDim.new(0, DESIGN_DETAIL_PAD_Y),
				PaddingLeft = UDim.new(0, DESIGN_DETAIL_PAD_X),
				PaddingRight = UDim.new(0, DESIGN_DETAIL_PAD_X),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, DESIGN_DETAIL_ROW_GAP),
			},
			scope:New('TextLabel') {
				LayoutOrder = 0,
				Size = UDim2.new(1, 0, 0, DESIGN_DETAIL_EYEBROW_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					local n = #use(entriesComputed)
					return string.format('◆ TOTAL ADDED · %d GEM%s', n, n == 1 and '' or 'S')
				end),
				TextSize = 10, TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			-- Fallback hint when no gems are socketed.
			scope:New('TextLabel') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, DESIGN_DETAIL_STAT_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = 'Pick gems to bind into the sockets above →',
				TextSize = 11, TextColor3 = PALETTE.inkDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
				Visible = scope:Computed(function(use) return #use(entriesComputed) == 0 end),
			},
			-- One row per socketed gem: colored dot + "Name · +stat".
			scope:New('Frame') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding = UDim.new(0, 3),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					scope:ForPairs(entriesComputed, function(use, innerScope, idx, entry)
						return entry.slot, innerScope:New('Frame') {
							LayoutOrder = entry.slot,
							Size = UDim2.new(1, 0, 0, 16),
							BackgroundTransparency = 1,
							[Fusion.Children] = {
								innerScope:New('Frame') {
									AnchorPoint = Vector2.new(0, 0.5),
									Position = UDim2.new(0, 0, 0.5, 0),
									Size = UDim2.fromOffset(8, 8),
									BackgroundColor3 = entry.color,
									BorderSizePixel = 0,
									[Fusion.Children] = {
										innerScope:New('UIAspectRatioConstraint') { AspectRatio = 1 },
										innerScope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
									},
								},
								innerScope:New('TextLabel') {
									Position = UDim2.fromOffset(14, 0),
									Size = UDim2.new(1, -14, 1, 0),
									BackgroundTransparency = 1,
									FontFace = HUDCommon.FONT_MONO,
									Text = string.format('%s · %s', entry.name, entry.stat),
									TextSize = 10, TextColor3 = entry.color,
									TextXAlignment = Enum.TextXAlignment.Left,
									TextYAlignment = Enum.TextYAlignment.Center,
									TextTruncate = Enum.TextTruncate.AtEnd,
								},
							},
						}
					end),
				},
			},
		},
	}
end

----------------------------------------------------------------------
-- Resonance panel: sibling of socket detail. Half-width, content-sized.
----------------------------------------------------------------------
local function buildResonancePanel(scope)
	local isResonant = scope:Computed(function(use) return resonance(use) end)

	-- Build the dot-row inline so it can size with AutomaticSize.
	local dotChildren: {any} = {
		scope:New('UIListLayout') {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, DESIGN_RESO_DOT_GAP),
			SortOrder = Enum.SortOrder.LayoutOrder,
		},
	}
	for i = 1, SOCKET_COUNT do
		table.insert(dotChildren, scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.fromOffset(DESIGN_RESO_DOT, DESIGN_RESO_DOT),
			BackgroundColor3 = scope:Computed(function(use)
				local id = use(Sockets)[i]
				local g = id and GEM_INDEX[id] or nil
				return g and g.color or Color3.new(0, 0, 0)
			end),
			BackgroundTransparency = scope:Computed(function(use)
				local id = use(Sockets)[i]
				return id and 0 or 1
			end),
			BorderSizePixel = 0,
			[Fusion.Children] = {
				scope:New('UIAspectRatioConstraint') { AspectRatio = 1 },
				scope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
				scope:New('UIStroke') {
					Color = PALETTE.accent,
					Transparency = scope:Computed(function(use) return use(Sockets)[i] and 0.2 or 0.6 end),
					Thickness = 1,
				},
			},
		})
	end

	return scope:New('Frame') {
		Name = 'ResonancePanel',
		Size = UDim2.new(0.5, -math.floor(DESIGN_COL_GAP / 2), 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = scope:Computed(function(use) return use(isResonant) and PALETTE.gold or PALETTE.bg1 end),
		BackgroundTransparency = scope:Computed(function(use) return use(isResonant) and 0.85 or 0.3 end),
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = scope:Computed(function(use) return use(isResonant) and PALETTE.gold or PALETTE.accent end),
				Transparency = scope:Computed(function(use) return use(isResonant) and 0.1 or 0.75 end),
				Thickness = 1,
			},
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, DESIGN_DETAIL_PAD_Y),
				PaddingBottom = UDim.new(0, DESIGN_DETAIL_PAD_Y),
				PaddingLeft = UDim.new(0, DESIGN_DETAIL_PAD_X),
				PaddingRight = UDim.new(0, DESIGN_DETAIL_PAD_X),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, DESIGN_DETAIL_ROW_GAP),
			},

			scope:New('TextLabel') {
				LayoutOrder = 0,
				Size = UDim2.new(1, 0, 0, DESIGN_DETAIL_EYEBROW_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = '◆ RESONANCE',
				TextSize = 10,
				TextColor3 = scope:Computed(function(use) return use(isResonant) and PALETTE.gold or PALETTE.accent end),
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, DESIGN_RESO_DESC_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = scope:Computed(function(use)
					return use(isResonant)
						and '✦ Trio bonus active: +10% all damage of matched element.'
						or 'Set 3+ matching-color gems for a set bonus.'
				end),
				TextSize = 11,
				TextColor3 = scope:Computed(function(use) return use(isResonant) and PALETTE.gold or PALETTE.ink end),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
			},
			-- Dot row: pixel-sized, auto-width.
			scope:New('Frame') {
				LayoutOrder = 2,
				Size = UDim2.fromOffset(0, DESIGN_RESO_DOT),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundTransparency = 1,
				[Fusion.Children] = dotChildren,
			},
		},
	}
end

----------------------------------------------------------------------
-- Bottom bind bar: sigils + cost readouts + filler spacer + bind button.
----------------------------------------------------------------------
local function buildBindBar(scope)
	local function statBlock(order: number, label: string, value: string, valueColor: Color3, valueSize: number)
		return scope:New('Frame') {
			LayoutOrder = order,
			Size = UDim2.fromOffset(DESIGN_BIND_BLOCK_W, DESIGN_BIND_LABEL_H + DESIGN_BIND_VALUE_H),
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				scope:New('UIListLayout') {
					FillDirection = Enum.FillDirection.Vertical,
					SortOrder = Enum.SortOrder.LayoutOrder,
				},
				scope:New('TextLabel') {
					LayoutOrder = 0,
					Size = UDim2.fromOffset(DESIGN_BIND_BLOCK_W, DESIGN_BIND_LABEL_H),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO, Text = label,
					TextSize = 9, TextColor3 = PALETTE.inkFaint,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('TextLabel') {
					LayoutOrder = 1,
					Size = UDim2.fromOffset(DESIGN_BIND_BLOCK_W, DESIGN_BIND_VALUE_H),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO, Text = value,
					TextSize = valueSize, TextColor3 = valueColor,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
			},
		}
	end

	return scope:New('Frame') {
		Name = 'BindBar',
		LayoutOrder = 3,
		Size = UDim2.new(1, 0, 0, DESIGN_BIND_H),
		BackgroundColor3 = PALETTE.bg1,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.6, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, DESIGN_BIND_PAD_X),
				PaddingRight = UDim.new(0, DESIGN_BIND_PAD_X),
				PaddingTop = UDim.new(0, DESIGN_BIND_PAD_Y),
				PaddingBottom = UDim.new(0, DESIGN_BIND_PAD_Y),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, DESIGN_BIND_BLOCK_GAP),
				VerticalAlignment = Enum.VerticalAlignment.Center,
				HorizontalFlex = Enum.UIFlexAlignment.SpaceBetween,
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- Left-side stat blocks grouped so flex pushes the button to the right.
			scope:New('Frame') {
				LayoutOrder = 1,
				Size = UDim2.fromOffset(0, DESIGN_BIND_LABEL_H + DESIGN_BIND_VALUE_H),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Horizontal,
						Padding = UDim.new(0, DESIGN_BIND_BLOCK_GAP),
						VerticalAlignment = Enum.VerticalAlignment.Center,
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					statBlock(1, 'SIGILS', '248', PALETTE.accent, 15),
					statBlock(2, 'BIND COST', '1 SIGIL · 200 cor', PALETTE.gold, 14),
				},
			},
			-- Bind button (pixel-exact, aspect-agnostic).
			scope:New('TextButton') {
				LayoutOrder = 2,
				Size = UDim2.fromOffset(DESIGN_BIND_BUTTON_W, DESIGN_BIND_BUTTON_H),
				AutoButtonColor = false,
				BackgroundColor3 = PALETTE.accent,
				BackgroundTransparency = 0.7,
				BorderSizePixel = 0,
				FontFace = HUDCommon.FONT_MONO,
				Text = '◆ BIND GEMS ◆',
				TextSize = 12, TextColor3 = PALETTE.accent,
				[Fusion.OnEvent('Activated')] = function()
					-- Stage C bind, with v1 UUID translation. The widget's
					-- Sockets state still holds catalog gem ids (the
					-- existing visual rendering reads via GEM_INDEX[id]),
					-- but the server's TrySet remote expects an INVENTORY
					-- UUID. We resolve catalog id → owned UUID via
					-- findOwnedGemUuidByGemId at commit time. Skips slots
					-- where the player no longer owns a free gem of that
					-- catalog id (or the inventory is empty).
					local socketsList = peek(Sockets) or {}
					local targetUuid = peek(SelectedItem)
					if typeof(targetUuid) ~= 'string' or #targetUuid == 0 then
						warn('GemSocketWidget: no target item selected')
						return
					end
					-- Track UUIDs we've already emitted this commit so a
					-- single owned gem isn't claimed by two slots.
					local consumedUuids: { [string]: true } = {}
					for slotIndex, gemRef in socketsList do
						if gemRef and typeof(gemRef) == 'string' then
							local uuid = findOwnedGemUuidByGemId(gemRef)
							if uuid and not consumedUuids[uuid] then
								consumedUuids[uuid] = true
								GemSocketEvent:FireServer(GemSocketShared.GemSocketActions.TrySet, targetUuid, slotIndex, uuid)
							else
								warn(string.format(
									'GemSocketWidget: no owned gem of id %s (or all already claimed)',
									tostring(gemRef)))
							end
						end
					end
				end,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.2, Thickness = 1 },
				},
			},
		},
	}
end

----------------------------------------------------------------------
-- Rarity filter row: UIGridLayout with pixel cells so buttons stay uniform.
----------------------------------------------------------------------
local function buildRarityFilter(scope)
	local children: {any} = {
		scope:New('UIGridLayout') {
			CellSize = UDim2.fromOffset(DESIGN_FILTER_BTN_W, DESIGN_FILTER_BTN_H),
			CellPadding = UDim2.fromOffset(DESIGN_FILTER_PAD, DESIGN_FILTER_PAD),
			FillDirectionMaxCells = DESIGN_FILTER_MAX_COLS,
			SortOrder = Enum.SortOrder.LayoutOrder,
		},
	}
	for i, r in RARITIES do
		local rColor = RARITY_COLOR[r] or PALETTE.accent
		local isActive = scope:Computed(function(use) return use(RarityFilter) == r end)
		table.insert(children, scope:New('TextButton') {
			LayoutOrder = i,
			AutoButtonColor = false,
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = scope:Computed(function(use) return use(isActive) and 0.4 or 0.2 end),
			BorderSizePixel = 0,
			FontFace = HUDCommon.FONT_MONO,
			Text = string.upper(r),
			TextSize = 9,
			TextColor3 = scope:Computed(function(use) return use(isActive) and rColor or PALETTE.inkDim end),
			[Fusion.OnEvent('Activated')] = function() RarityFilter:set(r) end,
			[Fusion.Children] = {
				scope:New('UIStroke') {
					Color = rColor,
					Transparency = scope:Computed(function(use) return use(isActive) and 0.2 or 0.75 end),
					Thickness = 1,
				},
			},
		})
	end
	return scope:New('Frame') {
		Name = 'RarityFilter',
		Size = UDim2.new(1, 0, 0, DESIGN_FILTER_ROW_H),
		BackgroundTransparency = 1,
		[Fusion.Children] = children,
	}
end

----------------------------------------------------------------------
-- Gem card (pouch entry). Pixel-sized, 120×84.
----------------------------------------------------------------------
local function buildGemCard(scope, g: Gem)
	-- Instead of gating clicks on "already in use", we now show a ×N
	-- count chip when the gem is socketed one or more times. The click
	-- behavior: always place into the active slot, or into the first
	-- empty socket if the active slot is already holding this exact gem.
	local countUsed = scope:Computed(function(use) return countInSockets(use, g.id) end)
	local card: TextButton
	card = scope:New('TextButton') {
		Name = 'GemCard_' .. g.id,
		AutoButtonColor = false,
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
		Text = '',
		[Fusion.OnEvent('Activated')] = function()
			-- If the active slot already holds THIS gem, drop the next
			-- copy into the first empty socket instead; otherwise place
			-- into the active slot. This lets the player stack copies
			-- without manually clicking through empty slots.
			local slots = peek(Sockets)
			local activeSlot = peek(ActiveSlot)
			local target = activeSlot
			if slots[activeSlot] == g.id then
				target = firstEmptySocket(peek) or activeSlot
			end
			setSocket(target, g.id)
		end,
		[Fusion.OnEvent('MouseEnter')] = function()
			showTooltip(card, g.name, g.stat, g.color)
		end,
		[Fusion.OnEvent('MouseLeave')] = hideTooltip,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = g.color,
				Transparency = scope:Computed(function(use) return use(countUsed) > 0 and 0.35 or 0.6 end),
				Thickness = 1,
			},
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, DESIGN_CARD_PAD_Y),
				PaddingBottom = UDim.new(0, DESIGN_CARD_PAD_Y),
				PaddingLeft = UDim.new(0, DESIGN_CARD_PAD_X),
				PaddingRight = UDim.new(0, DESIGN_CARD_PAD_X),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 2),
			},
			-- Gem orb: pixel circle, aspect-locked square.
			scope:New('Frame') {
				LayoutOrder = 0,
				Size = UDim2.fromOffset(DESIGN_GEM_ORB, DESIGN_GEM_ORB),
				BackgroundColor3 = g.color,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					scope:New('UIAspectRatioConstraint') { AspectRatio = 1 },
					scope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
					scope:New('UIStroke') { Color = Color3.new(1, 1, 1), Transparency = 0.3, Thickness = 1 },
				},
			},
			-- Name (wraps).
			scope:New('TextLabel') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, DESIGN_CARD_NAME_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = g.name,
				TextSize = 11, TextColor3 = g.color,
				TextWrapped = true,
				TextYAlignment = Enum.TextYAlignment.Top,
			},
			-- Cut tag.
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, DESIGN_CARD_CUT_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = string.upper(g.cut),
				TextSize = 8, TextColor3 = PALETTE.inkDim,
			},
			-- Count chip: "×N" if this gem appears in 1+ sockets. Hidden
			-- otherwise. Replaces the old single "SET" indicator — gems
			-- can now stack, so a numeric count is more useful.
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, 0, 0, 0),
				Size = UDim2.fromOffset(28, 12),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					local n = use(countUsed)
					return n > 0 and ('×' .. n) or ''
				end),
				TextSize = 9, TextColor3 = g.color,
				TextXAlignment = Enum.TextXAlignment.Right,
				ZIndex = 2,
			},
		},
	}
	return card
end

----------------------------------------------------------------------
-- Gem grid: UIGridLayout with pixel cells + bounded column count.
-- Wrapped in a ScrollingFrame with AutomaticCanvasSize.Y.
----------------------------------------------------------------------
----------------------------------------------------------------------
-- Right-panel tab bar: segmented INVENTORY | GEMS pair. Same shape as
-- the enchanting widget so the two workstations feel like siblings.
----------------------------------------------------------------------
local function buildRightTabBar(scope)
	local tabs = {
		{ key = 'inventory', label = 'INVENTORY' },
		{ key = 'gems',      label = 'GEMS'      },
	}
	local children: {any} = {
		scope:New('UIListLayout') {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, DESIGN_RIGHT_TAB_GAP),
			SortOrder = Enum.SortOrder.LayoutOrder,
		},
	}
	for i, t in tabs do
		local isActive = scope:Computed(function(use) return use(RightTab) == t.key end)
		table.insert(children, scope:New('TextButton') {
			LayoutOrder = i,
			Size = UDim2.new(0.5, -math.ceil(DESIGN_RIGHT_TAB_GAP / 2), 1, 0),
			AutoButtonColor = false,
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = scope:Computed(function(use) return use(isActive) and 0.1 or 0.5 end),
			BorderSizePixel = 0,
			FontFace = HUDCommon.FONT_MONO,
			Text = t.label,
			TextSize = 11,
			TextColor3 = scope:Computed(function(use) return use(isActive) and PALETTE.accent or PALETTE.inkDim end),
			[Fusion.OnEvent('Activated')] = function() RightTab:set(t.key) end,
			[Fusion.Children] = {
				scope:New('UIStroke') {
					Color = PALETTE.accent,
					Transparency = scope:Computed(function(use) return use(isActive) and 0.2 or 0.8 end),
					Thickness = 1,
				},
			},
		})
	end
	return scope:New('Frame') {
		Size = UDim2.new(1, 0, 0, DESIGN_RIGHT_TAB_H),
		BackgroundTransparency = 1,
		[Fusion.Children] = children,
	}
end

----------------------------------------------------------------------
-- Inventory row: colored swatch + name/slot + socket count + equipped
-- tag. Clicking sets SelectedItem, which the weapon silhouette's name
-- label binds to — same pattern as enchanting's item switcher.
----------------------------------------------------------------------
local function buildInventoryEntry(scope, item: InvItem)
	local c = TIER_COLOR[item.tier] or PALETTE.accent
	local isSelected = scope:Computed(function(use) return use(SelectedItem) == item.id end)
	return scope:New('TextButton') {
		Size = UDim2.new(1, 0, 0, DESIGN_INV_ROW_H),
		AutoButtonColor = false,
		BackgroundColor3 = c,
		BackgroundTransparency = scope:Computed(function(use) return use(isSelected) and 0.8 or 0.92 end),
		BorderSizePixel = 0,
		Text = '',
		[Fusion.OnEvent('Activated')] = function() SelectedItem:set(item.id) end,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = c,
				Transparency = scope:Computed(function(use) return use(isSelected) and 0.2 or 0.7 end),
				Thickness = 1,
			},
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, DESIGN_INV_PAD_X),
				PaddingRight = UDim.new(0, DESIGN_INV_PAD_X),
				PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
			},
			scope:New('Frame') {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 0, 0.5, 0),
				Size = UDim2.fromOffset(DESIGN_INV_SWATCH, DESIGN_INV_SWATCH),
				BackgroundColor3 = c,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					scope:New('UIAspectRatioConstraint') { AspectRatio = 1 },
					scope:New('UIStroke') { Color = c, Transparency = 0.3, Thickness = 1 },
				},
			},
			scope:New('TextLabel') {
				Position = UDim2.fromOffset(DESIGN_INV_SWATCH + 10, 4),
				Size = UDim2.new(1, -(DESIGN_INV_SWATCH + 10 + 62), 0, 16),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = item.name,
				TextSize = 13, TextColor3 = c,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				Position = UDim2.fromOffset(DESIGN_INV_SWATCH + 10, 20),
				Size = UDim2.new(1, -(DESIGN_INV_SWATCH + 10 + 62), 0, 12),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = string.format('%s · %d SLOT%s', string.upper(item.slot), item.sockets, item.sockets == 1 and '' or 'S'),
				TextSize = 9, TextColor3 = PALETTE.inkFaint,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.fromOffset(72, DESIGN_INV_ROW_H - 12),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					if use(isSelected) then return '◆ ACTIVE' end
					return item.equipped and 'EQUIPPED' or ''
				end),
				TextSize = 9, TextColor3 = scope:Computed(function(use)
					return use(isSelected) and PALETTE.accent or PALETTE.inkFaint
				end),
				TextXAlignment = Enum.TextXAlignment.Right,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
		},
	}
end

local function buildInventoryList(scope)
	local children: {any} = {
		scope:New('UIListLayout') {
			FillDirection = Enum.FillDirection.Vertical,
			Padding = UDim.new(0, DESIGN_INV_ROW_GAP),
			SortOrder = Enum.SortOrder.LayoutOrder,
		},
	}
	for i, item in EQUIPMENT do
		local row = buildInventoryEntry(scope, item)
		row.LayoutOrder = i
		table.insert(children, row)
	end
	return scope:New('ScrollingFrame') {
		Name = 'Inventory',
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = PALETTE.accent,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		[Fusion.Children] = children,
	}
end

local function buildGemGrid(scope)
	local children: {any} = {
		scope:New('UIGridLayout') {
			CellSize = UDim2.fromOffset(DESIGN_CARD_W, DESIGN_CARD_H),
			CellPadding = UDim2.fromOffset(DESIGN_CARD_PAD_X * 2, DESIGN_CARD_PAD_Y * 2),
			FillDirectionMaxCells = DESIGN_GRID_COLS,
			SortOrder = Enum.SortOrder.LayoutOrder,
			StartCorner = Enum.StartCorner.TopLeft,
		},
	}
	for i, g in GEMS do
		local card = buildGemCard(scope, g)
		card.LayoutOrder = i
		card.Visible = scope:Computed(function(use)
			local f = use(RarityFilter)
			return f == 'all' or g.rarity == f
		end)
		table.insert(children, card)
	end
	return scope:New('ScrollingFrame') {
		Name = 'GemGrid',
		Size = UDim2.new(1, 0, 1, -(DESIGN_POUCH_HEADER_H + DESIGN_POUCH_HEADER_GAP + DESIGN_FILTER_ROW_H + DESIGN_FILTER_GAP)),
		Position = UDim2.new(0, 0, 0, DESIGN_POUCH_HEADER_H + DESIGN_POUCH_HEADER_GAP + DESIGN_FILTER_ROW_H + DESIGN_FILTER_GAP),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = PALETTE.accent,
		[Fusion.Children] = children,
	}
end

----------------------------------------------------------------------
-- Floating tooltip: absolute-positioned Frame that reads ActiveTooltip.
-- Parented to the widget's ScreenGui container so it sits above every
-- modal element. Non-interactive (Active = false) so it never swallows
-- hover events from the cards beneath it.
----------------------------------------------------------------------
local function buildTooltip(scope)
	return scope:New('Frame') {
		Name = 'Tooltip',
		AnchorPoint = Vector2.new(0, 0),
		Position = scope:Computed(function(use)
			local t = use(ActiveTooltip)
			if not t then return UDim2.new() end
			return UDim2.fromOffset(t.x, t.y)
		end),
		Size = UDim2.fromOffset(220, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = PALETTE.bg1,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		Visible = scope:Computed(function(use) return use(ActiveTooltip) ~= nil end),
		ZIndex = 100,
		Active = false,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = scope:Computed(function(use)
					local t = use(ActiveTooltip); return t and t.color or PALETTE.accent
				end),
				Transparency = 0.2, Thickness = 1,
			},
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
				PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 4),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:New('TextLabel') {
				LayoutOrder = 0,
				Size = UDim2.new(1, 0, 0, 14),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = scope:Computed(function(use) local t = use(ActiveTooltip); return t and t.title or '' end),
				TextSize = 12,
				TextColor3 = scope:Computed(function(use)
					local t = use(ActiveTooltip); return t and t.color or PALETTE.accent
				end),
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use) local t = use(ActiveTooltip); return t and t.body or '' end),
				TextSize = 11, TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
			},
		},
	}
end

----------------------------------------------------------------------
-- Panels: left column (weapon + detail row + bind bar) and right pouch.
-- Root fills the tab content parent via fromScale(1, 1).
----------------------------------------------------------------------
local function buildPanels(scope)
	-- LEFT: weapon + detail row + bind bar. Flex-fills remaining width.
	local leftCol = scope:New('Frame') {
		Name = 'Left',
		-- Width = parent.X minus pouch column and column gap; pixel-exact.
		Size = UDim2.new(1, -(DESIGN_POUCH_W + DESIGN_COL_GAP), 1, 0),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, DESIGN_LEFT_PAD),
				PaddingLeft = UDim.new(0, DESIGN_LEFT_PAD),
				PaddingRight = UDim.new(0, DESIGN_LEFT_PAD),
				PaddingBottom = UDim.new(0, DESIGN_LEFT_PAD),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, DESIGN_LEFT_STACK_GAP),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			buildWeaponPanel(scope),
			-- Detail + resonance row (siblings, content-sized height).
			scope:New('Frame') {
				Name = 'DetailRow',
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Horizontal,
						Padding = UDim.new(0, DESIGN_COL_GAP),
						SortOrder = Enum.SortOrder.LayoutOrder,
						VerticalAlignment = Enum.VerticalAlignment.Top,
					},
					(function()
						local d = buildTotalEffects(scope); d.LayoutOrder = 1; return d
					end)(),
					(function()
						local r = buildResonancePanel(scope); r.LayoutOrder = 2; return r
					end)(),
				},
			},
			buildBindBar(scope),
		},
	}

	-- Build the two panes first so we can Hydrate reactive Visible onto
	-- them. Both live inside a shared content frame under the tab bar,
	-- visibility toggles keep their state alive across tab switches.
	local gemsPane = scope:New('Frame') {
		Name = 'GemsPane',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			-- Header (pouch eyebrow).
			scope:New('TextLabel') {
				Name = 'Header',
				Position = UDim2.new(0, 0, 0, 0),
				Size = UDim2.new(1, 0, 0, DESIGN_POUCH_HEADER_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = '◆ GEM POUCH',
				TextSize = 10, TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			-- Rarity filter row (2-row grid; sized by DESIGN_FILTER_ROW_H
			-- so the ALL/COMMON/... chips don't clip when wrapped).
			scope:New('Frame') {
				Name = 'FilterRow',
				Position = UDim2.new(0, 0, 0, DESIGN_POUCH_HEADER_H + DESIGN_POUCH_HEADER_GAP),
				Size = UDim2.new(1, 0, 0, DESIGN_FILTER_ROW_H),
				BackgroundTransparency = 1,
				[Fusion.Children] = { buildRarityFilter(scope) },
			},
			buildGemGrid(scope),
		},
	}
	local inventoryPane = scope:New('Frame') {
		Name = 'InventoryPane',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('TextLabel') {
				Position = UDim2.new(0, 0, 0, 0),
				Size = UDim2.new(1, 0, 0, DESIGN_POUCH_HEADER_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = '◆ EQUIPMENT',
				TextSize = 10, TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			-- Inventory list takes everything below the eyebrow.
			scope:New('Frame') {
				Position = UDim2.new(0, 0, 0, DESIGN_POUCH_HEADER_H + DESIGN_POUCH_HEADER_GAP),
				Size = UDim2.new(1, 0, 1, -(DESIGN_POUCH_HEADER_H + DESIGN_POUCH_HEADER_GAP)),
				BackgroundTransparency = 1,
				[Fusion.Children] = { buildInventoryList(scope) },
			},
		},
	}
	-- Reactive visibility — scope:Hydrate is required here because we
	-- built the instances above; setting `.Visible = Computed` directly
	-- on a built instance would just assign a Lua table (no observer
	-- registered). Hydrate registers the Computed like a New-time prop.
	scope:Hydrate(gemsPane) {
		Visible = scope:Computed(function(use) return use(RightTab) == 'gems' end),
	}
	scope:Hydrate(inventoryPane) {
		Visible = scope:Computed(function(use) return use(RightTab) == 'inventory' end),
	}

	-- RIGHT: tab bar on top + swappable content area below.
	local rightCol = scope:New('Frame') {
		Name = 'Right',
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, DESIGN_POUCH_W, 1, 0),
		BackgroundColor3 = PALETTE.bg1,
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.85, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, DESIGN_POUCH_PAD),
				PaddingLeft = UDim.new(0, DESIGN_POUCH_PAD),
				PaddingRight = UDim.new(0, DESIGN_POUCH_PAD),
				PaddingBottom = UDim.new(0, DESIGN_POUCH_PAD),
			},
			-- Tab bar (pinned top).
			(function()
				local t = buildRightTabBar(scope)
				t.Position = UDim2.new(0, 0, 0, 0)
				return t
			end)(),
			-- Content area sits below the tab bar and fills remaining height.
			-- Both panes coexist as siblings; one is Visible at a time.
			scope:New('Frame') {
				Name = 'Content',
				Position = UDim2.new(0, 0, 0, DESIGN_RIGHT_TAB_H + DESIGN_POUCH_HEADER_GAP),
				Size = UDim2.new(1, 0, 1, -(DESIGN_RIGHT_TAB_H + DESIGN_POUCH_HEADER_GAP)),
				BackgroundTransparency = 1,
				[Fusion.Children] = { gemsPane, inventoryPane },
			},
		},
	}

	-- Root fills its tab content parent.
	return scope:New('Frame') {
		Name = 'GemSocketWidget',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = { leftCol, rightCol },
	}
end

-- // Lifecycle // --

function Module.IsWidgetOpen(): boolean
	return IsOpen and peek(IsOpen) or false
end

function Module.OpenWidget()
	if not IsOpen then return end
	-- Level gate (default L15). Per-player flag OR server-wide global.
	local data = ReplicatedData.GetData('PlayerData', false)
	local globalBypass = LevelGatesClient.GetGlobalBypass()
	if data and not LevelGates.CanUseSystem(data, LevelGates.Systems.Gems, globalBypass) then
		LevelLockOverlay.Show(LevelGates.Systems.Gems, tonumber(data.Level) or 1)
		return
	end
	IsOpen:set(true)
end

function Module.CloseWidget()
	if not IsOpen then return end
	IsOpen:set(false)
end

function Module.Start()
	ScreenGui = HUDCommon.ensureScreenGui('HUD_GemSocket', 42)

	local scope = scoped(Fusion)
	RootScope = scope

	IsOpen        = scope:Value(false)
	Sockets       = scope:Value({ 'ruby', 'sapphire', 'emerald', false })
	ActiveSlot    = scope:Value(4)
	RarityFilter  = scope:Value('all')
	-- Right-rail default: gems tab open, Elucidator selected. Matches the
	-- previous single-tab behavior so first open looks unchanged, with
	-- INVENTORY as a discoverable switch.
	RightTab      = scope:Value('gems')
	SelectedItem  = scope:Value('elucidator')
	ActiveTooltip = scope:Value(nil)

	local root, content = HUDCommon.workstationShell(scope, {
		Title = "GEMSMITH'S WORKSTATION",
		Subtitle = '· Set jewels into worked metal — bind them with sigils ·',
		Location = '',
		Visible = IsOpen,
		OnClose = Module.CloseWidget,
		Width = 1240, Height = 720,
	})
	root.Parent = ScreenGui

	local panels = buildPanels(scope)
	panels.Parent = content

	-- Tooltip sits at the ScreenGui root so it overlays the whole modal.
	local tooltip = buildTooltip(scope)
	tooltip.Parent = ScreenGui

	ContextActionService:BindAction('GemSocketEscape', function(_, inputState)
		if inputState == Enum.UserInputState.Begin and Module.IsWidgetOpen() then
			Module.CloseWidget()
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.Escape)

	local ZoneService = ReplicatedModules.Services.ZoneService
	ZoneService.ZoneEnter:Connect(function(character, zoneName)
		if character == LocalPlayer.Character and zoneName == "GemSocketCircle" then
			Module.OpenWidget()
		end
	end)
	ZoneService.ZoneLeave:Connect(function(character, zoneName)
		if character == LocalPlayer.Character and zoneName == "GemSocketCircle" then
			LevelLockOverlay.HideIfShowing(LevelGates.Systems.Gems)
			Module.CloseWidget()
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/HotbarWidget.luau"><![CDATA[-- Bottom-center hotbar: two-row WoW slots + Q/W/E/R ability cluster + D/F utility.
-- Visual reference: tmp/aincrad-ui/hud.jsx (WoWHotbar, AbilityBtn, HotSlot).
--
-- Layout strategy (see .claude/skills/custom-roblox-ui/SKILL.md section 8):
--   The WoW hotbar is a textbook dense-pixel-designed widget. Every atom
--   (slot, ability button, keybind chip, quantity label) is pixel-exact via
--   UDim2.fromOffset. Containers use AutomaticSize to wrap their children,
--   so no Scale values compound across nested frames (Pitfall 1, 7).
--   The root is bottom-center anchored with Scale position only — the widget
--   sticks to the screen bottom on any aspect ratio without squashing.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local UserInputService = game:GetService('UserInputService')
local RunService = game:GetService('RunService')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local doCleanup = Fusion.doCleanup
local peek = Fusion.peek

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local SettingsRegistry = LocalModules.Modules.SettingsRegistry
local PALETTE = HUDCommon.PALETTE
local ViewportUtility = LocalModules.Utility.Viewport

local ReplicatedData = ReplicatedModules.Services.ReplicatedData
local RemoteService = ReplicatedModules.Services.RemoteService
local CombatSharedModule = ReplicatedModules.Services.CombatShared
local CombatConfigModule = ReplicatedModules.Data.CombatConfig
local ItemsConfig = ReplicatedModules.Data.Items
local Rarities = ReplicatedModules.Data.Rarities
local SkillsConfig = ReplicatedModules.Data.Skills
local SkillsShared = ReplicatedModules.Services.SkillsShared
local MountsShared = ReplicatedModules.Services.MountsShared
local MountsConfig = ReplicatedModules.Data.Mounts
local MaidClass = ReplicatedModules.Modules.Maid

local HotbarEvent = RemoteService.GetRemote('HotbarEvent', 'RemoteEvent', false)

local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')

local SystemsContainer = {}

----------------------------------------------------------------------
-- Design dimensions (pixels on the 1920x1080 reference canvas).
-- The hotbar is entirely pixel-designed — we never divide these by the
-- screen dimensions. Only the root Position uses Scale for anchoring.
----------------------------------------------------------------------
local DESIGN_SCREEN_W, DESIGN_SCREEN_H = 1920, 1080

local DESIGN_SLOT              = 42   -- hot slot square size
local DESIGN_SLOT_GAP          = 2    -- gap inside a 12-slot row
local DESIGN_ROW_GAP           = 3    -- gap between the two rows
local DESIGN_CENTER_PAD        = 4    -- padding inside the center block
local DESIGN_ABILITY_GAP       = 6    -- gap between ability buttons in a cluster
local DESIGN_CLUSTER_GAP       = 18   -- gap between clusters and the center block
local DESIGN_UTIL              = 48   -- D/F utility button size
local DESIGN_ABILITY           = 56   -- Q/W/E ability button size
local DESIGN_ULT               = 64   -- R ultimate button size
local DESIGN_KEYBIND_LABEL     = 14   -- vertical space reserved for keybind chip below a button
local DESIGN_KEYBIND_CHIP_W    = 22   -- keybind chip width (ability cluster)
local DESIGN_KEYBIND_CHIP_H    = 12   -- keybind chip height (ability cluster)
local DESIGN_SLOT_KEY_W        = 14   -- top-left keybind chip inside a hot slot
local DESIGN_SLOT_KEY_H        = 10
local DESIGN_SLOT_QTY_W        = 20   -- bottom-right quantity label inside a hot slot
local DESIGN_SLOT_QTY_H        = 10

-- Each slot has a stable identifier ('r1_3', 'r2_5', etc.) that's used
-- in PlayerData.Hotbar and PlayerData.Keybinds — this stays constant
-- even when the player rebinds the slot's hotkey.
local ROW1_SLOT_IDS = {}
local ROW2_SLOT_IDS = {}
for i = 1, 12 do
	table.insert(ROW1_SLOT_IDS, 'r1_' .. i)
	table.insert(ROW2_SLOT_IDS, 'r2_' .. i)
end

-- Default keybinds per slot. Row 1 uses the number row + dash/equals;
-- row 2 uses 12 letters on the right side of the keyboard (4×3 grid)
-- so they're reachable while WASD movement keys stay free. F1-F12
-- aren't used because Roblox / browsers commonly intercept them.
local DEFAULT_KEYBINDS: { [string]: string } = {
	r1_1 = '1', r1_2 = '2', r1_3 = '3', r1_4 = '4',
	r1_5 = '5', r1_6 = '6', r1_7 = '7', r1_8 = '8',
	r1_9 = '9', r1_10 = '0', r1_11 = '-', r1_12 = '=',
	-- Right-side letter cluster: U I O P / H J K L / V B N M.
	r2_1 = 'u', r2_2 = 'i', r2_3 = 'o', r2_4 = 'p',
	r2_5 = 'h', r2_6 = 'j', r2_7 = 'k', r2_8 = 'l',
	r2_9 = 'v', r2_10 = 'b', r2_11 = 'n', r2_12 = 'm',
}

-- Resolve the active keybind for a slot — user override from
-- PlayerData.Keybinds wins, otherwise the default. Returns nil only
-- if the slotId isn't recognized.
local function getKeybindForSlot(slotId: string): string?
	local data = ReplicatedData.GetData('PlayerData', false)
	if data and typeof(data.Keybinds) == 'table' then
		local override = data.Keybinds[slotId]
		if typeof(override) == 'string' and #override > 0 then
			return string.lower(override)
		end
	end
	return DEFAULT_KEYBINDS[slotId]
end

-- // Module // --
local Module = {}
Module.IsOpen = false
Module.CharacterMaid = nil

local RootScope = nil
local ScreenGui = nil
local Row1State = nil   -- Value<{[1..12]: {glyph:string, count:number?, rarity:string?, ...}}>
local Row2State = nil
local AbilityCDs = nil  -- Value<{[key:string]: {cd:number, maxCd:number}}>
-- Bindings are persisted in PlayerData.Hotbar (server-side source of
-- truth). UpdateWidget reads off the live PlayerData on every refresh;
-- SetSlot fires the HotbarEvent remote, which the server validates and
-- writes — the resulting ReplicatedData replication triggers an
-- UpdateWidget which renders the new binding.
-- Save shape: data.Hotbar = { [keybind] = { type = 'item'|'skill', uuid?, id? } }
-- Tick that re-evaluates the mount button's reactive Computeds. Bumped
-- on PlayerData updates so the button color/glyph follows the saved
-- Mounts.EquippedMount changes without a full widget rebuild.
local MountTick = nil  -- Value<number>
-- Tick bumped on PlayerData replication so each slot's keybind chip
-- (Computed off `getKeybindForSlot(slotId)`) re-evaluates and the
-- displayed key updates live when the player rebinds in settings.
local KeybindTick = nil  -- Value<number>
-- Reactive character / combat state. These are repopulated whenever
-- LocalPlayer.CharacterAdded fires, via Module.OnCharacterAdded → maid.
local SwordDrawnState = nil   -- Value<boolean>
local BlockCountState = nil   -- Value<number?>
-- Server-authoritative cooldown end time (absolute workspace:GetServerTimeNow()
-- timestamp). Replicated as the `BlockCooldownUntil` character attribute by
-- CombatShared.StartBlockCooldown, so the bar drains in lockstep with the
-- server-side validation window enforced in CanCharacterAttack /
-- CanCharacterStartBlock.
local BlockCooldownTick = nil -- Value<number>  bumped on Heartbeat to drive UI
-- Tick bumped every Heartbeat while *any* skill is on cooldown so each
-- skill-bound slot's overlay (read via SkillsShared.GetSkillCooldownRemaining)
-- redraws smoothly. Same drain pattern as BlockCooldownTick but driven by
-- the per-character `SkillCD_*` attributes that SkillsShared writes.
local SkillCooldownTick = nil -- Value<number>

-- Tooltip state — at most one tooltip visible at a time across the whole
-- hotbar. Hover handlers write {label, sublabel} or nil; the floating
-- frame parented to the root reads these reactively.
local TooltipState = nil      -- Value<{label:string, sublabel:string?}?>
local TooltipPos = nil        -- Value<UDim2>  pixel-anchored frame near hovered button

function Module.IsWidgetOpen(): boolean
	return Module.IsOpen and ScreenGui ~= nil
end

----------------------------------------------------------------------
-- Public binding API.
----------------------------------------------------------------------

-- Returns the canonical list of bindable slot IDs, ordered for the
-- slot picker / keybinds tab UI: row 1 (r1_1..r1_12), then row 2.
function Module.GetAllSlotIds(): { string }
	local out = {}
	for _, id in ROW1_SLOT_IDS do table.insert(out, id) end
	for _, id in ROW2_SLOT_IDS do table.insert(out, id) end
	return out
end

-- Public accessor for the default keybind table. Used by the keybinds
-- settings UI to render the "default" hint when a slot has no override.
function Module.GetDefaultKeybindForSlot(slotId: string): string?
	return DEFAULT_KEYBINDS[slotId]
end

-- Public accessor for the active keybind (override or default).
function Module.GetKeybindForSlot(slotId: string): string?
	return getKeybindForSlot(slotId)
end

-- Bind / unbind a slot. `slotId` is the stable identifier ('r1_3' etc.);
-- `binding` is { type = 'item' | 'skill', uuid? = string, id? = string }
-- or nil to clear. The remote write is server-validated; if validation
-- fails the binding is silently dropped (the client UI returns to the
-- last server-confirmed state on the next replication tick).
function Module.SetSlot(slotId: string, binding: any?)
	HotbarEvent:FireServer(slotId, binding)
end

-- Inspect a slot's binding off live PlayerData. Returns nil if unbound
-- or if PlayerData isn't yet replicated.
function Module.GetSlot(slotId: string): any?
	local data = ReplicatedData.GetData('PlayerData', false)
	if typeof(data) ~= 'table' or typeof(data.Hotbar) ~= 'table' then return nil end
	return data.Hotbar[slotId]
end

-- Set / clear a slot's keybind override. Single lowercase character or
-- nil to revert to default.
function Module.SetKeybind(slotId: string, keychar: string?)
	local KeybindEvent = RemoteService.GetRemote('KeybindEvent', 'RemoteEvent', false)
	if not KeybindEvent then return end
	-- Always lowercase before sending (server rejects uppercase) so the
	-- caller can pass any case without thinking about it.
	local payload = keychar and string.lower(keychar) or nil
	KeybindEvent:FireServer(slotId, payload)
end

-- Open a centered overlay listing every bindable hotbar key. The user
-- clicks one and `onPick(keybind)` is invoked; the overlay closes
-- after pick or when the player clicks the dim backdrop.
--
-- The picker has no scope ownership concerns — each invocation builds a
-- fresh ScreenGui that is destroyed on dismiss. This keeps the picker
-- self-contained so callers in other tabs don't have to manage state.
function Module.OpenSlotPicker(onPick: (slotId: string) -> ())
	local Players = game:GetService('Players')
	local LocalPlayer = Players.LocalPlayer
	local playerGui = LocalPlayer:WaitForChild('PlayerGui')

	-- Tear down any existing picker (defensive — only one at a time).
	local existing = playerGui:FindFirstChild('HUD_HotbarSlotPicker')
	if existing then existing:Destroy() end

	local pickerGui = Instance.new('ScreenGui')
	pickerGui.Name = 'HUD_HotbarSlotPicker'
	pickerGui.IgnoreGuiInset = true
	pickerGui.ResetOnSpawn = false
	pickerGui.DisplayOrder = 100  -- above the master HUD
	pickerGui.Parent = playerGui

	-- Dim backdrop — clicking it dismisses the picker.
	local backdrop = Instance.new('TextButton')
	backdrop.Name = 'Backdrop'
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.BackgroundColor3 = Color3.new(0, 0, 0)
	backdrop.BackgroundTransparency = 0.5
	backdrop.BorderSizePixel = 0
	backdrop.AutoButtonColor = false
	backdrop.Text = ''
	backdrop.Parent = pickerGui
	backdrop.Activated:Connect(function() pickerGui:Destroy() end)

	-- Centered panel.
	local panel = Instance.new('Frame')
	panel.Name = 'Panel'
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromOffset(560, 200)
	panel.BackgroundColor3 = PALETTE.bg0
	panel.BackgroundTransparency = 0.05
	panel.BorderSizePixel = 0
	panel.Parent = pickerGui

	local stroke = Instance.new('UIStroke')
	stroke.Color = PALETTE.accent
	stroke.Thickness = 1
	stroke.Transparency = 0.4
	stroke.Parent = panel

	local pad = Instance.new('UIPadding')
	pad.PaddingTop = UDim.new(0, 16)
	pad.PaddingBottom = UDim.new(0, 16)
	pad.PaddingLeft = UDim.new(0, 16)
	pad.PaddingRight = UDim.new(0, 16)
	pad.Parent = panel

	local title = Instance.new('TextLabel')
	title.Name = 'Title'
	title.Size = UDim2.new(1, 0, 0, 16)
	title.BackgroundTransparency = 1
	title.FontFace = HUDCommon.FONT_MONO
	title.Text = '◆ PICK A HOTBAR SLOT'
	title.TextSize = 12
	title.TextColor3 = PALETTE.accent
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = panel

	local rowsHolder = Instance.new('Frame')
	rowsHolder.Name = 'Rows'
	rowsHolder.Position = UDim2.fromOffset(0, 28)
	rowsHolder.Size = UDim2.new(1, 0, 1, -28)
	rowsHolder.BackgroundTransparency = 1
	rowsHolder.Parent = panel

	local rowsLayout = Instance.new('UIListLayout')
	rowsLayout.FillDirection = Enum.FillDirection.Vertical
	rowsLayout.Padding = UDim.new(0, 6)
	rowsLayout.SortOrder = Enum.SortOrder.LayoutOrder
	rowsLayout.Parent = rowsHolder

	-- Build one horizontal row of slot buttons. Each button shows the
	-- slot's CURRENT keybind so the user can target the slot by the
	-- key they actually press in-game.
	local function buildRowFrame(layoutOrder: number, slotIds: { string }, label: string)
		local row = Instance.new('Frame')
		row.Size = UDim2.new(1, 0, 0, 38)
		row.BackgroundTransparency = 1
		row.LayoutOrder = layoutOrder
		row.Parent = rowsHolder

		local rowLabel = Instance.new('TextLabel')
		rowLabel.Size = UDim2.fromOffset(34, 38)
		rowLabel.BackgroundTransparency = 1
		rowLabel.FontFace = HUDCommon.FONT_MONO
		rowLabel.Text = label
		rowLabel.TextSize = 10
		rowLabel.TextColor3 = PALETTE.inkDim
		rowLabel.TextXAlignment = Enum.TextXAlignment.Left
		rowLabel.Parent = row

		local btnHolder = Instance.new('Frame')
		btnHolder.Position = UDim2.fromOffset(38, 0)
		btnHolder.Size = UDim2.new(1, -38, 1, 0)
		btnHolder.BackgroundTransparency = 1
		btnHolder.Parent = row

		local grid = Instance.new('UIGridLayout')
		grid.CellSize = UDim2.fromOffset(36, 36)
		grid.CellPadding = UDim2.fromOffset(4, 4)
		grid.SortOrder = Enum.SortOrder.LayoutOrder
		grid.Parent = btnHolder

		for i, slotId in slotIds do
			local btn = Instance.new('TextButton')
			btn.Name = 'Slot_' .. slotId
			btn.LayoutOrder = i
			btn.Size = UDim2.fromOffset(36, 36)
			btn.BackgroundColor3 = PALETTE.bg1
			btn.BackgroundTransparency = 0.2
			btn.BorderSizePixel = 0
			btn.AutoButtonColor = true
			btn.FontFace = HUDCommon.FONT_MONO
			btn.Text = string.upper(getKeybindForSlot(slotId) or '?')
			btn.TextSize = 11
			btn.TextColor3 = PALETTE.ink
			btn.Parent = btnHolder

			local btnStroke = Instance.new('UIStroke')
			btnStroke.Color = PALETTE.accent
			btnStroke.Thickness = 1
			btnStroke.Transparency = 0.6
			btnStroke.Parent = btn

			btn.Activated:Connect(function()
				pickerGui:Destroy()
				onPick(slotId)
			end)
		end
	end

	buildRowFrame(1, ROW1_SLOT_IDS, 'R1')
	buildRowFrame(2, ROW2_SLOT_IDS, 'R2')
end

----------------------------------------------------------------------
-- Hover tooltip helpers — every interactive button on the hotbar wires
-- up MouseEnter/Leave to push a {label, sublabel} pair. The frame is
-- rendered once at root level and follows the last-hovered button.
----------------------------------------------------------------------
local function bindTooltip(button: GuiObject, getInfo: (use: any) -> {label:string, sublabel:string?}?)
	-- Capture the last-known anchor point for the tooltip; we use the
	-- button's AbsolutePosition to position above-and-centered.
	button.MouseEnter:Connect(function()
		local info = getInfo(peek)
		if not info then return end
		TooltipState:set(info)
		local abs = button.AbsolutePosition
		local size = button.AbsoluteSize
		-- Place tooltip centered on the button, just above it.
		TooltipPos:set(UDim2.fromOffset(
			math.floor(abs.X + size.X / 2),
			math.floor(abs.Y - 6)
		))
	end)
	button.MouseLeave:Connect(function()
		TooltipState:set(nil)
	end)
end

----------------------------------------------------------------------
-- Hot slot — pixel-exact square. Slot 1/2 in row-1 are special: they
-- render the equipped weapon's viewport instead of a glyph and accept
-- click-to-equip-or-unequip via CombatClient. Other slots fall back to
-- the placeholder glyph rendering kept from the original widget.
----------------------------------------------------------------------
local function buildHotSlot(scope, slotId: string, index: number, rowState)
	local slotData = scope:Computed(function(use)
		local state = use(rowState)
		return state and state[index] or nil
	end)
	-- Per-slot cooldown view. Reads the bound skill's SkillCD_* attribute
	-- via SkillsShared on every SkillCooldownTick pulse, returning a
	-- {remaining, total, alpha} table or nil if no cooldown is active. The
	-- iteration is pulled into the slot Computed (rather than a parent
	-- Computed) so non-skill slots short-circuit to nil before doing any
	-- attribute reads.
	local cooldownView = scope:Computed(function(use)
		use(SkillCooldownTick)
		local s = use(slotData)
		if not s or s.kind ~= 'skill' or not s.skillId then return nil end
		local character = LocalPlayer.Character
		if not character then return nil end
		local remaining = SkillsShared.GetSkillCooldownRemaining(character, s.skillId)
		if remaining <= 0 then return nil end
		local cfg = SkillsConfig.Skills[s.skillId]
		local total = (cfg and cfg.Cooldown) or remaining
		return {
			remaining = remaining,
			total = total,
			alpha = total > 0 and math.clamp(remaining / total, 0, 1) or 0,
		}
	end)
	-- Reactive keybind chip text — re-evaluates when PlayerData (Keybinds)
	-- changes via KeybindTick, so live rebinding updates without a full
	-- widget rebuild.
	local keybindText = scope:Computed(function(use)
		use(KeybindTick)
		return string.upper(getKeybindForSlot(slotId) or '?')
	end)
	local color = scope:Computed(function(use)
		local s = use(slotData)
		if s and s.rarityNum and Rarities.RarityColors[s.rarityNum] then
			return Rarities.RarityColors[s.rarityNum]
		end
		if s and s.rarity and HUDCommon.RARITY[s.rarity] then
			return HUDCommon.RARITY[s.rarity]
		end
		return PALETTE.accent
	end)

	local function getGameplay()
		return SystemsContainer.ParentSystems
			and SystemsContainer.ParentSystems.Gameplay
	end
	local function activateSlot()
		local data = peek(slotData)
		if not data then return end
		-- Bound skill → cast via SkillsClient.
		if data.kind == 'skill' and data.skillId then
			local SkillsClient = SystemsContainer.SkillsClient
				or (getGameplay() and getGameplay().SkillsClient)
			if SkillsClient and SkillsClient.AttemptUseSkill then
				SkillsClient.AttemptUseSkill(data.skillId)
			end
			return
		end
		-- Bound item → simple log for now (consume/equip wiring can layer
		-- onto this dispatch when each item kind has a client API).
		if data.kind == 'item' and data.uuid then
			print(string.format('[Hotbar] Slot %s → use item %s', tostring(slotId), tostring(data.uuid)))
			return
		end
	end
	-- Expose activate so the global InputBegan dispatcher can reach it
	-- without rewalking the slot tree per keypress.
	Module._SlotActivators = Module._SlotActivators or {}
	Module._SlotActivators[slotId] = activateSlot

	-- ViewportFrame rendered when the slot has a weapon model — empty
	-- otherwise so the glyph fallback shows through.
	local viewport: ViewportFrame = scope:New('ViewportFrame') {
		Name = 'WeaponViewport',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = scope:Computed(function(use)
			local s = use(slotData)
			return s ~= nil and s.itemConfig ~= nil
		end),
	}
	-- Re-populate the viewport whenever the slot's item changes. Reuse the
	-- ViewportUtility helper so model framing matches the inventory tab.
	scope:Observer(slotData):onChange(function()
		ViewportUtility.ClearViewport(viewport)
		local data = peek(slotData)
		if not data or not data.itemConfig then return end
		local cfg = data.itemConfig
		local modelName = (cfg.EquipmentData and cfg.EquipmentData.Model) or cfg.Model
		if not modelName then return end
		local sourceFolder = ReplicatedAssets:FindFirstChild('Weapons')
		local model = sourceFolder and sourceFolder:FindFirstChild(modelName) :: Model?
		if not model then return end
		local _, sz = model:GetBoundingBox()
		local distance = math.max(sz.X, sz.Y, sz.Z, 1) * 1.4
		local modelCFrame = CFrame.Angles(0, math.rad(-30), 0) * CFrame.Angles(math.rad(-12), 0, 0)
		local cameraPos = Vector3.new(0, distance * 0.25, distance)
		ViewportUtility.SetupModelViewport(viewport, model, CFrame.lookAt(cameraPos, modelCFrame.Position), modelCFrame)
	end)

	local button = scope:New('TextButton') {
		Name = 'Slot_' .. slotId,
		LayoutOrder = index,
		AutoButtonColor = false,
		Text = '',
		Size = UDim2.fromOffset(DESIGN_SLOT, DESIGN_SLOT),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		[Fusion.OnEvent('Activated')] = activateSlot,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = color,
				Transparency = scope:Computed(function(use)
					return use(slotData) and 0.2 or 0.8
				end),
				Thickness = 1,
			},
			viewport,
			-- Glyph fallback — shown only when the slot has no model viewport.
			scope:New('TextLabel') {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				TextSize = math.floor(DESIGN_SLOT * 0.42),
				TextColor3 = PALETTE.ink,
				Text = scope:Computed(function(use)
					local s = use(slotData)
					return s and (not s.itemConfig) and s.glyph or ''
				end),
			},
			-- Keybind chip (top-left corner of the slot). Reactive — updates
			-- live when the player rebinds via the keybinds settings tab.
			scope:New('TextLabel') {
				Size = UDim2.fromOffset(DESIGN_SLOT_KEY_W, DESIGN_SLOT_KEY_H),
				Position = UDim2.fromOffset(2, 2),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				TextSize = 9,
				TextColor3 = PALETTE.inkDim,
				Text = keybindText,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
			},
			-- Quantity (bottom-right).
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -2, 1, -1),
				Size = UDim2.fromOffset(DESIGN_SLOT_QTY_W, DESIGN_SLOT_QTY_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				TextSize = 10,
				TextColor3 = PALETTE.ink,
				Text = scope:Computed(function(use)
					local s = use(slotData)
					if s and s.count then return tostring(s.count) end
					return ''
				end),
				TextXAlignment = Enum.TextXAlignment.Right,
				TextYAlignment = Enum.TextYAlignment.Bottom,
			},
			-- Cooldown dim — paints a translucent square over the slot art
			-- and a centered seconds-remaining readout. Visibility tracks
			-- cooldownView so non-skill slots and ready skills stay clear.
			scope:New('TextLabel') {
				Name = 'SkillCooldownDim',
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = scope:Computed(function(use)
					return use(cooldownView) and 0.35 or 1
				end),
				BorderSizePixel = 0,
				FontFace = HUDCommon.FONT_MONO,
				TextSize = math.floor(DESIGN_SLOT * 0.4),
				TextColor3 = PALETTE.ink,
				Text = scope:Computed(function(use)
					local cv = use(cooldownView)
					if not cv then return '' end
					return cv.remaining < 10
						and string.format('%.1f', cv.remaining)
						or string.format('%d', math.ceil(cv.remaining))
				end),
				Visible = scope:Computed(function(use)
					return use(cooldownView) ~= nil
				end),
				ZIndex = 2,
			},
			-- Cooldown bar — thin strip along the bottom of the slot,
			-- width-bound to the cooldown alpha so it drains as the
			-- skill becomes ready (full → empty). Mirrors the ability
			-- cluster's cooldown bar style for visual consistency.
			scope:New('Frame') {
				Name = 'SkillCooldownBar',
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.new(0, 0, 1, 0),
				Size = scope:Computed(function(use)
					local cv = use(cooldownView)
					return UDim2.new((cv and cv.alpha) or 0, 0, 0, 2)
				end),
				BackgroundColor3 = color,
				BackgroundTransparency = 0.1,
				BorderSizePixel = 0,
				Visible = scope:Computed(function(use)
					return use(cooldownView) ~= nil
				end),
				ZIndex = 3,
			},
		},
	}

	bindTooltip(button, function(usePeek)
		local s = usePeek(slotData)
		if not s then return nil end
		if s.itemConfig then
			local cfg = s.itemConfig
			local title = (cfg.Display and cfg.Display.Title and cfg.Display.Title.Text) or s.itemId or '—'
			local rarityName = Rarities.RarityValues[cfg.Rarity] or ''
			return { label = title, sublabel = string.upper(rarityName) }
		end
		return { label = s.label or s.glyph or '—', sublabel = nil }
	end)

	return button
end

----------------------------------------------------------------------
-- 12-slot row. Uniform cells → UIGridLayout (skill Section 4).
-- Parent auto-sizes X from its cells, height is exactly one slot.
----------------------------------------------------------------------
local function buildRow(scope, slotIds, rowState)
	local children = {
		scope:New('UIGridLayout') {
			CellSize = UDim2.fromOffset(DESIGN_SLOT, DESIGN_SLOT),
			CellPadding = UDim2.fromOffset(DESIGN_SLOT_GAP, 0),
			FillDirection = Enum.FillDirection.Horizontal,
			FillDirectionMaxCells = #slotIds,
			SortOrder = Enum.SortOrder.LayoutOrder,
			StartCorner = Enum.StartCorner.TopLeft,
		},
	}
	for i, slotId in slotIds do
		table.insert(children, buildHotSlot(scope, slotId, i, rowState))
	end
	return scope:New('Frame') {
		Name = 'HotRow',
		Size = UDim2.fromOffset(0, DESIGN_SLOT),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		[Fusion.Children] = children,
	}
end

----------------------------------------------------------------------
-- Ability button — round, pixel-exact, with optional cooldown overlay,
-- a hover tooltip, and a keybind chip below. The `spec` table can carry
-- reactive Computeds for `glyph` / `color` / `tooltip` so the same
-- builder serves the static R-ability AND the dynamic Q sheathe state.
--   spec = {
--     key, size, color (Color3 or Computed), glyph (string or Computed),
--     onActivate?, tooltip? (function(use) -> {label, sublabel?}?),
--     cdKey? (string in AbilityCDs map; opts in cooldown overlay),
--   }
----------------------------------------------------------------------
local function asComputed(maybe)
	return typeof(maybe) == 'table' and maybe or nil
end

local function buildAbilityBtn(scope, spec)
	local cdState = scope:Computed(function(use)
		if not spec.cdKey then return nil end
		local cds = use(AbilityCDs) or {}
		return cds[spec.cdKey]
	end)

	-- Resolve glyph + color into reactive Computeds (so callers can pass
	-- either a static value or a Fusion Computed; eliminates per-button
	-- dispatch noise in the call site).
	local resolvedGlyph = asComputed(spec.glyph)
		or scope:Computed(function() return spec.glyph end)
	local resolvedColor = asComputed(spec.color)
		or scope:Computed(function() return spec.color end)

	local mainButton: TextButton = scope:New('TextButton') {
		Name = 'Button',
		LayoutOrder = 1,
		AutoButtonColor = false,
		Text = '',
		Size = UDim2.fromOffset(spec.size, spec.size),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		[Fusion.OnEvent('Activated')] = function()
			if spec.onActivate then spec.onActivate() end
		end,
		[Fusion.Children] = {
			scope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
			scope:New('UIStroke') {
				Color = resolvedColor, Transparency = 0.3, Thickness = 2,
			},
			scope:New('TextLabel') {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				TextSize = math.floor(spec.size * 0.52),
				TextColor3 = resolvedColor,
				Text = resolvedGlyph,
			},
			-- Cooldown overlay (only used when spec.cdKey set).
			scope:New('TextLabel') {
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = scope:Computed(function(use)
					local c = use(cdState)
					return c and 0.3 or 1
				end),
				BorderSizePixel = 0,
				FontFace = HUDCommon.FONT_MONO,
				TextSize = 16,
				TextColor3 = PALETTE.ink,
				Text = scope:Computed(function(use)
					local c = use(cdState)
					if not c or not c.cd or c.cd <= 0 then return '' end
					return c.cd < 10
						and string.format('%.1f', c.cd)
						or string.format('%d', math.floor(c.cd))
				end),
				[Fusion.Children] = {
					scope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
				},
			},
			-- Optional radial-style cooldown bar driven by `spec.cooldownAlpha`
			-- (a Computed yielding 0..1 fraction of cooldown remaining).
			-- Implemented as a thin arc-fill at the bottom of the button:
			-- AnchorPoint(0.5, 1) + width Scale-bound to alpha.
			spec.cooldownAlpha and scope:New('Frame') {
				Name = 'CooldownBar',
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0.5, 0, 1, -4),
				Size = scope:Computed(function(use)
					return UDim2.new(0.7 * (use(spec.cooldownAlpha) or 0), 0, 0, 3)
				end),
				BackgroundColor3 = resolvedColor,
				BackgroundTransparency = 0.1,
				BorderSizePixel = 0,
				Visible = scope:Computed(function(use)
					return (use(spec.cooldownAlpha) or 0) > 0
				end),
				[Fusion.Children] = {
					scope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
				},
			} or nil,
		},
	}

	if spec.tooltip then
		bindTooltip(mainButton, spec.tooltip)
	end

	return scope:New('Frame') {
		Name = 'AbilityCol_' .. spec.key,
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 0),
			},
			mainButton,
			-- Keybind chip sits directly below the button. TextButton (not
			-- Frame) so tapping the chip on touchscreens fires the same
			-- onActivate as pressing the keybind — gives mobile players a
			-- second hit-target the same height as the displayed key glyph.
			scope:New('TextButton') {
				Name = 'KeyChip',
				LayoutOrder = 2,
				Size = UDim2.fromOffset(DESIGN_KEYBIND_CHIP_W, DESIGN_KEYBIND_CHIP_H),
				BackgroundColor3 = PALETTE.bg0,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = '',
				[Fusion.OnEvent('Activated')] = function()
					if spec.onActivate then spec.onActivate() end
				end,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = resolvedColor, Transparency = 0.2 },
					scope:New('TextLabel') {
						Size = UDim2.fromScale(1, 1),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						TextSize = 10,
						TextColor3 = resolvedColor,
						Text = spec.key,
					},
				},
			},
		},
	}
end

----------------------------------------------------------------------
-- Reactive ability/utility specs, built per-scope so they can close over
-- the per-scope Fusion state. The static placeholders for W/R/D were
-- preserved so future ability bindings just plug into this list.
----------------------------------------------------------------------
local function buildAbilitySpecs(scope)
	-- Q reflects the SwordDrawn state. The glyph stays constant (a sword)
	-- and the COLOR carries the "drawn vs sheathed" signal — accentHot
	-- (bright) when unsheathed, inkFaint (darkened) when sheathed.
	local sheatheColor = scope:Computed(function(use)
		return use(SwordDrawnState) and PALETTE.accentHot or PALETTE.inkFaint
	end)
	local sheatheTooltip = function(usePeek)
		return {
			label = usePeek(SwordDrawnState) and 'Unsheathed' or 'Sheathed',
			sublabel = 'Q · toggle weapon',
		}
	end
	local triggerSheathe = function()
		local CombatClient = SystemsContainer.CombatClient
			or (SystemsContainer.ParentSystems
				and SystemsContainer.ParentSystems.Gameplay
				and SystemsContainer.ParentSystems.Gameplay.CombatClient)
		if CombatClient and CombatClient.AttemptWeaponDrawnToggle then
			CombatClient.AttemptWeaponDrawnToggle()
		end
	end

	return {
		{
			key = 'Q', size = DESIGN_ABILITY,
			glyph = '⚔', color = sheatheColor,
			tooltip = sheatheTooltip, onActivate = triggerSheathe,
		},
		-- W's prior glyph (U+2726 ✦) lives in the Dingbats block which
		-- our custom font asset doesn't include — rendered as a missing
		-- glyph. Swapped to U+2605 ★ which is in basic BMP and ships
		-- with virtually every typeface.
		{ key = 'W', size = DESIGN_ABILITY, glyph = '★', color = PALETTE.accent },
		{ key = 'R', size = DESIGN_ULT, glyph = '☀', color = PALETTE.gold }, -- ultimate
	}
end

local function buildUtilitySpecs(scope)
	-- F: Block button. Glyph reads the current BlockingCount remaining when
	-- a block is active; otherwise shows ▲. Hover tooltip exposes the same
	-- numeric pair plus the slider's BLOCK_COOLDOWN window.
	local blockGlyph = scope:Computed(function(use)
		local count = use(BlockCountState)
		if typeof(count) == 'number' and count > 0 then
			return tostring(count)
		end
		return '▲'
	end)
	-- Cooldown progress (0 = ready, 1 = full cooldown). Re-evaluated each
	-- BlockCooldownTick (Heartbeat) so the bar drains smoothly. Reads the
	-- server-replicated `BlockCooldownUntil` character attribute against
	-- workspace:GetServerTimeNow() — the same clock the server uses to
	-- validate, so the UI can never tell the player they're ready before
	-- the server agrees.
	local blockCooldownAlpha = scope:Computed(function(use)
		use(BlockCooldownTick)  -- subscribe to heartbeat
		local character = LocalPlayer.Character
		if not character then return 0 end
		local untilTime = character:GetAttribute('BlockCooldownUntil')
		if typeof(untilTime) ~= 'number' then return 0 end
		local remaining = untilTime - workspace:GetServerTimeNow()
		if remaining <= 0 then return 0 end
		local total = CombatConfigModule.CombatConfig.BLOCK_COOLDOWN or 1
		return math.clamp(remaining / total, 0, 1)
	end)
	local blockTooltip = function(usePeek)
		local count = usePeek(BlockCountState)
		local maxBlocks = CombatConfigModule.CombatConfig.BLOCK_MAX_HITS
		if typeof(count) == 'number' then
			return {
				label = string.format('Block · %d / %d', count, maxBlocks),
				sublabel = 'F · hold to block',
			}
		end
		return { label = 'Block', sublabel = string.format('F · %d max blocks', maxBlocks) }
	end

	-- // G — Mount state toggle //
	-- After the equip/mount split:
	--   `EquippedMount` = persistent active slot (your selected mount).
	--   `mounted` (riding state) = character attribute set by MountsServer.
	-- Button reflects whichever's active:
	--   * riding now             → PALETTE.accentHot, equipped mount glyph,
	--                              G dismounts (preserves slot).
	--   * not riding, slot set   → PALETTE.accent, equipped mount glyph,
	--                              G mounts the equipped mount.
	--   * no slot                → PALETTE.inkFaint, '☗', G no-ops.
	local function readRidingState(): boolean
		local char = LocalPlayer.Character
		return char and char:GetAttribute('Mounted') == true or false
	end
	local RidingNow = scope:Value(readRidingState())
	do
		local function refresh() RidingNow:set(readRidingState()) end
		LocalPlayer.CharacterAdded:Connect(function(char)
			refresh()
			char:GetAttributeChangedSignal('Mounted'):Connect(refresh)
		end)
		local cur = LocalPlayer.Character
		if cur then cur:GetAttributeChangedSignal('Mounted'):Connect(refresh) end
	end
	local mountInfo = scope:Computed(function(use)
		use(MountTick)
		local riding = use(RidingNow)
		local data = ReplicatedData.GetData('PlayerData', false)
		local equippedId = MountsShared.GetEquippedMountId(data)
		if not equippedId then return nil end
		local cfg = MountsConfig.Mounts and MountsConfig.Mounts[equippedId]
		return { id = equippedId, cfg = cfg, mounted = riding }
	end)
	local mountColor = scope:Computed(function(use)
		local info = use(mountInfo)
		if not info then return PALETTE.inkFaint end
		return info.mounted and PALETTE.accentHot or PALETTE.accent
	end)
	local mountGlyph = scope:Computed(function(use)
		local info = use(mountInfo)
		if info and info.cfg and info.cfg.Display then
			-- Prefer an explicit Glyph; fall back to first letter of Name.
			return info.cfg.Display.Glyph
				or string.sub(tostring(info.cfg.Display.Name or '☗'), 1, 1)
		end
		return '☗'
	end)
	local mountTooltip = function(usePeek)
		local info = usePeek(mountInfo)
		if info then
			local name = (info.cfg and info.cfg.Display and info.cfg.Display.Name) or info.id
			local action = info.mounted and 'Dismount: ' or 'Mount: '
			return { label = action .. tostring(name), sublabel = 'G · toggle mount' }
		end
		return { label = 'No mount equipped', sublabel = 'Pick one in the Mounts tab' }
	end
	local triggerMount = function()
		local MountsClient = SystemsContainer.MountsClient
			or (SystemsContainer.ParentSystems
				and SystemsContainer.ParentSystems.Gameplay
				and SystemsContainer.ParentSystems.Gameplay.MountsClient)
		if not MountsClient or not MountsClient.AttemptToggleRide then return end
		MountsClient.AttemptToggleRide()
	end

	return {
		{ key = 'D', size = DESIGN_UTIL, glyph = '♥', color = PALETTE.success,
		  tooltip = function() return { label = 'Heal', sublabel = 'D' } end },
		{ key = 'F', size = DESIGN_UTIL,
		  glyph = blockGlyph, color = PALETTE.accent,
		  tooltip = blockTooltip,
		  cooldownAlpha = blockCooldownAlpha,
		},
		{ key = 'G', size = DESIGN_UTIL,
		  glyph = mountGlyph, color = mountColor,
		  tooltip = mountTooltip,
		  onActivate = triggerMount,
		},
	}
end

----------------------------------------------------------------------
-- Cluster of ability columns (Q/W/E/R or D/F), arranged bottom-aligned.
----------------------------------------------------------------------
local function buildCluster(scope, specs)
	local children = {
		scope:New('UIListLayout') {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, DESIGN_ABILITY_GAP),
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
		},
	}
	local maxSize = 0
	for i, spec in specs do
		local col = buildAbilityBtn(scope, spec)
		col.LayoutOrder = i
		table.insert(children, col)
		maxSize = math.max(maxSize, spec.size)
	end
	return scope:New('Frame') {
		Name = 'Cluster',
		-- Height = tallest button + keybind chip row; width auto-sizes to children.
		Size = UDim2.fromOffset(0, maxSize + DESIGN_KEYBIND_LABEL),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		[Fusion.Children] = children,
	}
end

----------------------------------------------------------------------
-- Center block: two rows of 12 slots, translucent backdrop, 4px padding.
----------------------------------------------------------------------
local function buildCenterBlock(scope)
	local row1 = buildRow(scope, ROW1_SLOT_IDS, Row1State)
	row1.LayoutOrder = 1
	local row2 = buildRow(scope, ROW2_SLOT_IDS, Row2State)
	row2.LayoutOrder = 2

	return scope:New('Frame') {
		Name = 'CenterBlock',
		LayoutOrder = 2,
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.8 },
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(0, DESIGN_CENTER_PAD),
				PaddingBottom = UDim.new(0, DESIGN_CENTER_PAD),
				PaddingLeft   = UDim.new(0, DESIGN_CENTER_PAD),
				PaddingRight  = UDim.new(0, DESIGN_CENTER_PAD),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, DESIGN_ROW_GAP),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			row1,
			row2,
		},
	}
end

----------------------------------------------------------------------
-- Root hotbar frame — bottom-center anchored. Scale Position only,
-- AutomaticSize.XY on both axes so the widget pixel-sizes itself from
-- its entirely-pixel-designed descendants (skill Section 8 decision tree).
----------------------------------------------------------------------
local function buildTooltipFrame(scope)
	-- Floating tooltip parented to the master ScreenGui so it can paint
	-- above any hotbar siblings. Uses absolute pixel position from
	-- TooltipPos and bottom-center anchor so it sits above the hovered
	-- button. Visibility tracks TooltipState — nil hides it.
	return scope:New('Frame') {
		Name = 'HotbarTooltip',
		AnchorPoint = Vector2.new(0.5, 1),
		Position = TooltipPos,
		Size = UDim2.fromOffset(180, 38),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
		ZIndex = 50,
		Visible = scope:Computed(function(use) return use(TooltipState) ~= nil end),
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
				PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 2),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:New('TextLabel') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 14),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = scope:Computed(function(use)
					local s = use(TooltipState); return s and s.label or ''
				end),
				TextSize = 13,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
			},
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, 11),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					local s = use(TooltipState); return (s and s.sublabel) or ''
				end),
				TextSize = 10,
				TextColor3 = PALETTE.inkDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				Visible = scope:Computed(function(use)
					local s = use(TooltipState); return s and s.sublabel ~= nil
				end),
			},
		},
	}
end

local function buildUI(scope)
	-- Q/W/R + D/F clusters: gated by SettingsRegistry.OnscreenButtonsEnabled
	-- so the user's "On-screen buttons" setting hides them in tandem with
	-- the OnscreenButtons widget. The 24 slot rows (r1_*/r2_*) stay
	-- visible because they're part of the central inventory affordance.
	local clustersVisible = scope:Value(SettingsRegistry.OnscreenButtonsEnabled ~= false)
	local clustersConn = SettingsRegistry.Changed:Connect(function(key, value)
		if key == 'OnscreenButtonsEnabled' then
			clustersVisible:set(value ~= false)
		end
	end)
	-- Tie the connection's lifetime to this Fusion scope so a theme
	-- rebuild (which doCleanup's the scope) doesn't leak the listener.
	table.insert(scope, function()
		if clustersConn then clustersConn:Disconnect(); clustersConn = nil end
	end)

	local abilityCluster = buildCluster(scope, buildAbilitySpecs(scope))
	abilityCluster.LayoutOrder = 1
	abilityCluster.Visible = clustersVisible

	local utilityCluster = buildCluster(scope, buildUtilitySpecs(scope))
	utilityCluster.LayoutOrder = 3
	utilityCluster.Visible = clustersVisible

	local centerBlock = buildCenterBlock(scope)

	scope:New('Frame') {
		Name = 'Hotbar',
		AnchorPoint = Vector2.new(0.5, 1),
		-- Bottom-center, slight inset from the screen edge. Scale stays in Y
		-- only so the hotbar hugs the bottom on any aspect ratio.
		Position = UDim2.fromScale(0.5, 0.98),
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundTransparency = 1,
		Parent = ScreenGui,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Bottom,
				Padding = UDim.new(0, DESIGN_CLUSTER_GAP),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			abilityCluster,
			centerBlock,
			utilityCluster,
		},
	}

	-- Tooltip is a sibling of the hotbar inside the same container so it
	-- can render anywhere on screen relative to the hovered button.
	local tooltip = buildTooltipFrame(scope)
	tooltip.Parent = ScreenGui
end

-- Translate PlayerData (incl. PlayerData.Hotbar) into slot state tables.
-- Resolution order per slot:
--   1. Explicit binding from PlayerData.Hotbar (item UUID or skill id).
--   2. Auto-populate fallbacks (skills slots 1..3; consumables row 2).
-- Equipped weapons are no longer auto-pinned to slots 1/2 — equipping
-- happens in the inventory tab now.
function Module.UpdateWidget()
	if not Module.IsWidgetOpen() then return end
	local data = ReplicatedData.GetData('PlayerData', false)

	local row1 = {}
	local row2 = {}

	-- Helper: walk inventory for a stack matching `uuid`. Returns
	-- (itemId, cfg, stack) or nil.
	local function findInventoryByUuid(uuid: string): (string?, any?, any?)
		if not data or typeof(data.Inventory) ~= 'table' then return nil end
		for itemId, uuidcache in data.Inventory do
			if typeof(uuidcache) == 'table' and uuidcache[uuid] then
				return itemId, ItemsConfig.Items[itemId], uuidcache[uuid]
			end
		end
		return nil
	end

	-- Helper: resolve a binding entry into the slot-data shape used by
	-- the renderer. Save schema is { type = 'item'|'skill', uuid?, id? }.
	-- Returns nil if the binding can't be resolved (item sold, skill
	-- reset, etc.) — the slot then falls back to its auto-populated
	-- default content rather than rendering broken state.
	local function resolveBinding(b: any): any?
		if typeof(b) ~= 'table' then return nil end
		if b.type == 'item' and b.uuid then
			local itemId, cfg, stack = findInventoryByUuid(b.uuid)
			if not itemId or not cfg then return nil end
			local title = (cfg.Display and cfg.Display.Title and cfg.Display.Title.Text) or itemId
			return {
				kind = 'item',
				itemId = itemId, itemConfig = cfg, uuid = b.uuid,
				rarityNum = cfg.Rarity,
				glyph = '◆',
				label = title,
				count = stack and (stack.Quantity or stack.Count),
			}
		elseif b.type == 'skill' and b.id then
			local cfg = SkillsConfig.Skills[b.id]
			if not cfg then return nil end
			local title = (cfg.Display and cfg.Display.Name) or b.id
			return {
				kind = 'skill',
				skillId = b.id,
				glyph = (cfg.Display and cfg.Display.Glyph) or '⚡',
				label = title,
			}
		end
		return nil
	end

	-- Read bindings off live PlayerData (server is source of truth).
	local bindings = (typeof(data) == 'table' and typeof(data.Hotbar) == 'table')
		and data.Hotbar
		or {}

	-- // Row 1 slots 1..12 // --
	-- Auto-populate slots 1, 2, 3 with the player's first 3 unlocked
	-- skills. Bindings always win — if the user has explicitly bound a
	-- slot, that binding overrides the auto.
	-- Save shape per SkillsShared: data.Skills.UnlockedSkills[skillId].
	local autoSkills: { string } = {}
	for skillId, _entry in SkillsShared.GetUnlockedSkills(data) do
		table.insert(autoSkills, tostring(skillId))
		if #autoSkills >= 3 then break end
	end
	for i = 1, #ROW1_SLOT_IDS do
		local slotId = ROW1_SLOT_IDS[i]
		local binding = bindings[slotId]
		if binding then
			row1[i] = resolveBinding(binding)
		elseif i <= #autoSkills then
			row1[i] = resolveBinding({ type = 'skill', id = autoSkills[i] })
		end
	end

	-- // Row 2 (slots r2_1..r2_12) // --
	-- Bindings override; otherwise fall back to consumable auto-fill.
	-- Consumables auto-fill is the legacy behavior and stays for now.
	for i = 1, #ROW2_SLOT_IDS do
		local slotId = ROW2_SLOT_IDS[i]
		local binding = bindings[slotId]
		if binding then
			row2[i] = resolveBinding(binding)
		end
	end
	if data and data.Consumables then
		local i = 0
		for _, consumable in data.Consumables do
			i += 1
			if i > #ROW2_SLOT_IDS then break end
			if row2[i] then continue end  -- explicit binding wins
			if typeof(consumable) == 'table' then
				row2[i] = {
					glyph = consumable.Glyph or '♦',
					count = consumable.Quantity or consumable.Count,
					rarity = consumable.Rarity,
				}
			end
		end
	end

	Row1State:set(row1)
	Row2State:set(row2)

	-- Bump mount tick so the G utility button's reactive Computeds
	-- re-evaluate (mount color/glyph follow data.Mounts changes).
	if MountTick then
		MountTick:set((peek(MountTick) + 1) % 1e6)
	end
	-- Bump keybind tick so each slot's reactive keybindText re-evaluates
	-- (chip text updates live when the player rebinds in settings).
	if KeybindTick then
		KeybindTick:set((peek(KeybindTick) + 1) % 1e6)
	end
end

function Module.SetAbilityCooldown(key: string, cd: number, maxCd: number)
	if not AbilityCDs then return end
	local current = peek(AbilityCDs)
	local copy = table.clone(current or {})
	copy[key] = { cd = cd, maxCd = maxCd }
	AbilityCDs:set(copy)
end

function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true
	ScreenGui = HUDCommon.ensureScreenGui('HUD_Hotbar', 6)
	RootScope = scoped(Fusion)

	Row1State   = RootScope:Value({})
	Row2State   = RootScope:Value({})
	AbilityCDs  = RootScope:Value({})
	SwordDrawnState = RootScope:Value(false)
	BlockCountState = RootScope:Value(nil)
	BlockCooldownTick = RootScope:Value(0)
	SkillCooldownTick = RootScope:Value(0)
	TooltipState = RootScope:Value(nil)
	TooltipPos = RootScope:Value(UDim2.fromOffset(0, 0))
	MountTick = RootScope:Value(0)
	KeybindTick = RootScope:Value(0)
	-- Reset slot activator registry — buildHotSlot will repopulate it.
	Module._SlotActivators = {}

	buildUI(RootScope)
	Module.UpdateWidget()

	if LocalPlayer.Character then
		task.defer(Module.OnCharacterAdded, LocalPlayer.Character)
	end
end

function Module.CloseWidget()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	if Module.CharacterMaid then Module.CharacterMaid:Cleanup(); Module.CharacterMaid = nil end
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
end

function Module.OnCharacterAdded(character: Model)
	if Module.CharacterMaid then Module.CharacterMaid:Cleanup() end
	Module.CharacterMaid = MaidClass.New()

	-- Sync Q sheathe indicator to the character's SwordDrawn attribute.
	local function syncDrawn()
		if SwordDrawnState then
			SwordDrawnState:set(CombatSharedModule.IsWeaponDrawn(character) == true)
		end
	end
	syncDrawn()
	Module.CharacterMaid:Give(character:GetAttributeChangedSignal('SwordDrawn'):Connect(syncDrawn))

	-- Sync F block-count indicator. The cooldown bar reads
	-- `BlockCooldownUntil` (server-replicated attribute) directly inside
	-- blockCooldownAlpha — no client-side timestamp to maintain.
	local function syncBlock()
		if not BlockCountState then return end
		local count = character:GetAttribute('BlockingCount')
		BlockCountState:set(count)
	end
	syncBlock()
	Module.CharacterMaid:Give(character:GetAttributeChangedSignal('BlockingCount'):Connect(syncBlock))
end

function Module.Start()
	ReplicatedData.OnUpdated:Connect(function(category, _)
		if category == 'PlayerData' then
			Module.UpdateWidget()
		end
	end)

	-- Universal hotbar key dispatcher. For every keypress, walk all 24
	-- slot IDs and find the one whose CURRENT keybind matches the
	-- pressed key (live read from PlayerData.Keybinds via
	-- getKeybindForSlot). When matched, run that slot's activator —
	-- the same code path clicking the slot triggers, so behavior is
	-- identical between mouse + keyboard.
	--
	-- `GetStringForKeyCode` returns the canonical character for the key
	-- regardless of modifier state — no need to special-case shift /
	-- alt. Lowercased to match how keybinds are stored (server rejects
	-- uppercase to enforce a single source of truth).
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		local pressedKey = UserInputService:GetStringForKeyCode(input.KeyCode)
		if not pressedKey or #pressedKey == 0 then return end
		pressedKey = string.lower(pressedKey)
		-- G mount toggle keeps a hardcoded check (it's a utility
		-- button, not a slot — not part of the rebindable hotbar).
		-- Mounted → dismount; not mounted but preferred is set →
		-- re-summon. Mirrors the on-screen G button.
		if pressedKey == 'g' then
			-- G now toggles RIDING (not the equipped slot). If a mount
			-- is equipped, mount it; if already riding, dismount. The
			-- slot itself is set/cleared via the Mounts tab buttons.
			local MountsClient = SystemsContainer.MountsClient
				or (SystemsContainer.ParentSystems
					and SystemsContainer.ParentSystems.Gameplay
					and SystemsContainer.ParentSystems.Gameplay.MountsClient)
			if MountsClient and MountsClient.AttemptToggleRide then
				MountsClient.AttemptToggleRide()
			end
			return
		end
		-- Slot dispatch — first match wins. Stable iteration order
		-- (row 1 left-to-right, then row 2) so duplicate keybinds
		-- favor the earlier slot.
		local activators = Module._SlotActivators or {}
		for _, slotId in ROW1_SLOT_IDS do
			if getKeybindForSlot(slotId) == pressedKey then
				local fn = activators[slotId]
				if fn then fn() end
				return
			end
		end
		for _, slotId in ROW2_SLOT_IDS do
			if getKeybindForSlot(slotId) == pressedKey then
				local fn = activators[slotId]
				if fn then fn() end
				return
			end
		end
	end)

	-- Heartbeat ticks BlockCooldownTick so the block cooldown bar drains
	-- smoothly while the server-replicated cooldown attribute is in the
	-- future, plus one extra tick on the frame the cooldown expires so
	-- the alpha Computed re-evaluates back to 0 and the bar's Visible
	-- flips off. Idle frames skip the Fusion update.
	local cooldownWasActive = false
	local skillCooldownWasActive = false
	RunService.Heartbeat:Connect(function()
		local character = LocalPlayer.Character
		if not character then return end
		local now = workspace:GetServerTimeNow()
		local untilTime = character:GetAttribute('BlockCooldownUntil')
		local cooldownActive = typeof(untilTime) == 'number' and untilTime > now
		if cooldownActive or cooldownWasActive then
			if BlockCooldownTick then
				BlockCooldownTick:set((peek(BlockCooldownTick) + 1) % 1e6)
			end
		end
		cooldownWasActive = cooldownActive

		-- Skill cooldown drain. Walk the character's SkillCD_* attributes
		-- and pulse the tick while any are still in the future. Idle
		-- frames (no skill on cooldown) skip the Fusion update — same
		-- amortization as the block cooldown.
		local anySkillCD = false
		for name, value in character:GetAttributes() do
			if typeof(value) == 'number' and string.sub(name, 1, 8) == 'SkillCD_'
				and value > now then
				anySkillCD = true
				break
			end
		end
		if anySkillCD or skillCooldownWasActive then
			if SkillCooldownTick then
				SkillCooldownTick:set((peek(SkillCooldownTick) + 1) % 1e6)
			end
		end
		skillCooldownWasActive = anySkillCD
	end)

	LocalPlayer.CharacterAdded:Connect(Module.OnCharacterAdded)

	HUDCommon.BindLiveTheme(Module)

	task.defer(Module.OpenWidget)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/JoinGameWelcomeWidget.luau"><![CDATA[-- First-join welcome popup. A centered, backdrop-dimmed multi-page modal
-- shown once per save the first time a player joins. Pages walk through
-- the game premise, the early-game (≤ level 5) loop, and a quick UI tour
-- (page content lives in Data.Onboarding.WelcomePages). The final page's
-- button reads FINISH; clicking it fires 'FinishWelcome' to the server,
-- which sets the ONBOARDING_JOIN_GAME_1 flag so the popup never returns.
--
-- The server (OnboardingServer.TryStartJoinGame1) also auto-grants the
-- starter quest when it sends 'ShowWelcome', so the quest is already in
-- the player's log by the time they read the UI-tour page.
--
-- This is intentionally separate from OnboardingWidget (the step-by-step
-- tutorial tooltip): different lifecycle, different gate. They share only
-- the OnboardingEvent remote.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped    = Fusion.scoped
local doCleanup = Fusion.doCleanup
local peek      = Fusion.peek
local RemoteService = ReplicatedModules.Services.RemoteService

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local OnboardingData = ReplicatedModules.Data.Onboarding
local Actions = OnboardingData.Actions
local PAGES = OnboardingData.WelcomePages
local PAGE_COUNT = #PAGES

local OnboardingEvent = RemoteService.GetRemote('OnboardingEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}
Module.IsOpen = false

-- Design canvas. The panel is pixel-designed (every inner Size/Position is
-- a fixed offset), so per the UI skill §6.2 we stamp the whole panel with a
-- single resolution-driven UIScale rather than converting offsets to scale.
local DESIGN_H = 1080
-- Render the whole panel at ~2× its pixel design so the welcome modal
-- dominates the screen on first join. Applied on top of the resolution scale
-- (so it still adapts to viewport height); scales every inner offset uniformly.
local SIZE_MULT = 2

local RootScope = nil
local ScreenGui = nil
local CurrentPage = nil  -- Fusion Value<number> (1-based page index)
local ResScale = nil     -- Fusion Value<number>; UIScale multiplier vs DESIGN_H
local ResConn = nil      -- AbsoluteSize listener; disconnected in CloseWidget

function Module.IsWidgetOpen(): boolean
	return Module.IsOpen and ScreenGui ~= nil
end

----------------------------------------------------------------------
-- Footer: page progress dots + Back / Next(Finish) buttons.
----------------------------------------------------------------------
local function buildProgressDots(scope)
	local dots = {}
	for i = 1, PAGE_COUNT do
		dots[i] = scope:New('Frame') {
			Name = 'Dot' .. i,
			Size = UDim2.fromOffset(8, 8),
			BackgroundColor3 = scope:Computed(function(use)
				return use(CurrentPage) == i and PALETTE.accent or PALETTE.inkFaint
			end),
			BorderSizePixel = 0,
			[Fusion.Children] = {
				scope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
			},
		}
	end
	return scope:New('Frame') {
		Name = 'ProgressDots',
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(0, 8),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				Padding = UDim.new(0, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			table.unpack(dots),
		},
	}
end

local function buildButton(scope, props: { Text: any, Visible: any?, OnClick: () -> (), Accent: Color3? })
	local accent = props.Accent or PALETTE.accent
	return scope:New('TextButton') {
		Size = UDim2.fromOffset(110, 32),
		BackgroundColor3 = PALETTE.bg1,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Visible = props.Visible,
		FontFace = HUDCommon.FONT_BUTTON,
		Text = props.Text,
		TextSize = 13,
		TextColor3 = PALETTE.ink,
		[Fusion.OnEvent('Activated')] = props.OnClick,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = accent, Transparency = 0.4, Thickness = 1 },
		},
	}
end

----------------------------------------------------------------------
-- Modal.
----------------------------------------------------------------------
local function buildUI(scope)
	local pageData = scope:Computed(function(use)
		return PAGES[use(CurrentPage)]
	end)

	-- Dark fade: a full-screen dim behind the modal so the game darkens while
	-- the welcome popup is open. Scale-sized so it always covers the viewport.
	scope:New('Frame') {
		Name = 'DarkFade',
		Position = UDim2.fromScale(0, 0),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		Parent = ScreenGui,
	}

	-- Backdrop: swallows clicks so the player can't interact with the HUD
	-- behind the modal. A TextButton (not Frame) so it eats input; kept
	-- transparent because DarkFade above does the dimming.
	scope:New('TextButton') {
		Name = 'Backdrop',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Modal = true,
		Text = '',
		Parent = ScreenGui,
	}

	scope:New('Frame') {
		Name = 'WelcomePanel',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(540, 360),
		BackgroundColor3 = PALETTE.panel,
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
		Parent = ScreenGui,
		[Fusion.Children] = {
			-- Resolution stamp: scales the whole pixel-designed panel uniformly.
			scope:New('UIScale') { Scale = ResScale },
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.35, Thickness = 1 },
			HUDCommon.cornerTick(scope, 'tl', PALETTE.accent),
			HUDCommon.cornerTick(scope, 'br', PALETTE.accent),
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, 26), PaddingBottom = UDim.new(0, 20),
				PaddingLeft = UDim.new(0, 28), PaddingRight = UDim.new(0, 28),
			},

			-- Eyebrow kicker.
			scope:New('TextLabel') {
				Size = UDim2.new(1, 0, 0, 14),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					local p = use(pageData); return p and ('◆ ' .. p.Eyebrow) or ''
				end),
				TextSize = 12,
				TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},

			-- Title.
			scope:New('TextLabel') {
				Position = UDim2.new(0, 0, 0, 22),
				Size = UDim2.new(1, 0, 0, 30),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = scope:Computed(function(use)
					local p = use(pageData); return p and p.Title or ''
				end),
				TextSize = 24,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
			},

			-- Body copy.
			scope:New('TextLabel') {
				Position = UDim2.new(0, 0, 0, 64),
				Size = UDim2.new(1, 0, 1, -64 - 44),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = scope:Computed(function(use)
					local p = use(pageData); return p and p.Body or ''
				end),
				TextSize = 16,
				LineHeight = 1.15,
				TextColor3 = PALETTE.inkDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
			},

			-- Footer row: dots (left) + Back/Next (right).
			scope:New('Frame') {
				Name = 'Footer',
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.new(0, 0, 1, 0),
				Size = UDim2.new(1, 0, 0, 32),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					buildProgressDots(scope),
					scope:New('Frame') {
						Name = 'Buttons',
						AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.new(1, 0, 0.5, 0),
						Size = UDim2.fromOffset(0, 32),
						AutomaticSize = Enum.AutomaticSize.X,
						BackgroundTransparency = 1,
						[Fusion.Children] = {
							scope:New('UIListLayout') {
								FillDirection = Enum.FillDirection.Horizontal,
								VerticalAlignment = Enum.VerticalAlignment.Center,
								HorizontalAlignment = Enum.HorizontalAlignment.Right,
								Padding = UDim.new(0, 10),
								SortOrder = Enum.SortOrder.LayoutOrder,
							},
							buildButton(scope, {
								Text = '◀ BACK',
								Visible = scope:Computed(function(use) return use(CurrentPage) > 1 end),
								OnClick = function()
									local p = peek(CurrentPage)
									if p > 1 then CurrentPage:set(p - 1) end
								end,
							}),
							buildButton(scope, {
								Accent = PALETTE.accentHot,
								Text = scope:Computed(function(use)
									return use(CurrentPage) >= PAGE_COUNT and 'FINISH' or 'NEXT ▶'
								end),
								OnClick = function()
									local p = peek(CurrentPage)
									if p >= PAGE_COUNT then
										OnboardingEvent:FireServer(Actions.FinishWelcome)
										Module.CloseWidget()
									else
										CurrentPage:set(p + 1)
									end
								end,
							}),
						},
					},
				},
			},
		},
	}
end

function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true
	-- Display order above the rest of the HUD (OnboardingWidget tooltip = 28).
	ScreenGui = HUDCommon.ensureScreenGui('HUD_JoinGameWelcome', 30)
	RootScope = scoped(Fusion)
	CurrentPage = RootScope:Value(1)
	ResScale = RootScope:Value(1)

	-- Track the (full-screen container's) viewport height so the panel
	-- scales uniformly: clamped so it stays usable on tiny / huge screens.
	local function updateScale()
		if not ScreenGui or not ResScale then return end
		ResScale:set(SIZE_MULT * math.clamp(ScreenGui.AbsoluteSize.Y / DESIGN_H, 0.5, 2))
	end
	ResConn = ScreenGui:GetPropertyChangedSignal('AbsoluteSize'):Connect(updateScale)
	updateScale()

	buildUI(RootScope)
end

function Module.CloseWidget()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	if ResConn then ResConn:Disconnect(); ResConn = nil end
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
	CurrentPage = nil
	ResScale = nil
end

function Module.Start()
	HUDCommon.BindLiveTheme(Module)

	-- Server decides when the popup should appear (first join, flag unset).
	OnboardingEvent.OnClientEvent:Connect(function(action)
		if action == Actions.ShowWelcome then
			Module.OpenWidget()
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/MinimapWidget.luau"><![CDATA[-- Top-right minimap panel. Initial chrome (rings, pulse, zone/clock labels)
-- ported from tmp/aincrad-ui/hud.jsx lines 167-182 (HudPlated minimap).
--
-- Renders live world-space markers (CollectionService-tagged entities like
-- AI / waystones / interactables, plus named workstation circles) projected
-- camera-relative onto the panel — camera-forward always points to the top.
--
-- Layout strategy (see .claude/skills/custom-roblox-ui/SKILL.md):
--   * Top-level Minimap frame: Scale-sized from design px / screen px + a
--     UIAspectRatioConstraint(1, FitWithinMaxSize) so it stays a perfect
--     square on 16:9, 32:9, and portrait screens.
--   * AnchorPoint (1, 0) + Position anchors to the top-right corner with a
--     scaled pixel inset.
--   * All inner atoms (rings, center dot, pulse ring, markers, labels) use
--     UDim2.fromOffset because the panel is aspect-locked and known size --
--     pixel geometry is authoritative inside it and does not compound scale.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local Lighting = game:GetService('Lighting')
local RunService = game:GetService('RunService')
local CollectionService = game:GetService('CollectionService')
local UserInputService = game:GetService('UserInputService')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local doCleanup = Fusion.doCleanup

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local SettingsRegistry = LocalModules.Modules.SettingsRegistry
local UISinkInputs = LocalModules.Utility.UISinkInputs
local PALETTE = HUDCommon.PALETTE

local WaystonesData = ReplicatedModules.Data.Waystones
local InteractableData = ReplicatedModules.Data.Interactable

local SystemsContainer = {}

local Module = {}
Module.IsOpen = false

local RootScope = nil
local ScreenGui = nil
local ZoneValue   = nil -- Value<string>
local ClockValue  = nil -- Value<string>
local PulseScale  = nil -- Value<number>  0..1 ease
local PanelFrame  = nil -- Frame   the minimap container; markers are direct children
-- UISinkInputs processor handle. Registered on OpenWidget, removed on
-- CloseWidget so wheel input only sinks while the panel is up. The
-- processor sinks scroll wheel events whose mouse position lands inside
-- the minimap panel — prevents the wheel from leaking through to camera
-- zoom while the player is interacting with the map.
local SinkProcessorId: string? = nil
-- Map zoom multiplier. 1.0 = standard radius (MAP_WORLD_RADIUS studs);
-- 5.0 = 5× world area visible (more zoomed out). Adjusted by scroll wheel
-- when the cursor is over the minimap. `refreshMarkers` reads it on each
-- 10 Hz tick to recompute marker positions.
local Zoom = nil  -- Value<number>  0.25 .. 5.0
-- Min lowered to 0.25× so players can zoom in tight on the panel for
-- close-quarters navigation (rooftops, dense interiors). 5.0 stays as
-- a wide-survey ceiling.
local ZOOM_MIN  = 0.25
local ZOOM_MAX  = 5.0
local ZOOM_STEP = 0.25
-- Tracked entity tags rendered as live minimap blips. Each entry is an
-- in-flight Frame keyed by the world Instance so we can recycle / move
-- them rather than recreating each frame. Frames are parented under the
-- minimap panel so they paint above the rings and clip to its bounds.
local MarkerInstances: {[Instance]: Frame} = {}
local MARKER_TAGS: {{tag: string, color: Color3, size: number}} = {}
-- Named workspace lookups for fixed workstations. These aren't surfaced
-- via CollectionService; they're individual parts/models named in the
-- world (matched via workspace:FindFirstChild). Populated in OpenWidget
-- so PALETTE references stay live across theme swaps.
local STATION_MARKERS: {{name: string, color: Color3, size: number}} = {}

----------------------------------------------------------------------
-- Design dimensions (pixels on the 1920x1080 reference canvas).
-- All Scale values in this file are derived from these constants.
----------------------------------------------------------------------
local DESIGN_SCREEN_W, DESIGN_SCREEN_H = 1920, 1080

-- Panel itself: bumped from 200 → 240 square so zone/clock labels and
-- the ring cluster have more room to breathe.
local DESIGN_PANEL_W, DESIGN_PANEL_H = 240, 240

-- Top-right anchor insets (JSX: top:56, right:20).
local DESIGN_INSET_RIGHT = 20
local DESIGN_INSET_TOP   = 56

-- Center of the ring cluster, offset a little down from geometric center
-- to leave room for the top eyebrow label. Scaled to the new panel size.
local DESIGN_CENTER_X = DESIGN_PANEL_W / 2
local DESIGN_CENTER_Y = DESIGN_PANEL_H / 2 + 10

-- Ring diameters (JSX radii 30, 50, 70, 90) scaled proportionally with panel.
local DESIGN_RING_SIZES = { 72, 120, 168, 216 }

-- Center player marker (JSX r="3" -> 6px diameter).
local DESIGN_CENTER_DOT = 6

-- Pulse ring (JSX r = 6 + sin(t*3)*2 -> diameter varies 8..16; we map
-- PulseScale 0..1 onto that range via base + amplitude).
local DESIGN_PULSE_BASE      = 10
local DESIGN_PULSE_AMPLITUDE = 8

-- Triangle-ish markers (JSX polygons span ~8x8 pixels).
local DESIGN_MARKER = 6

-- World-radius covered by the outer ring (studs). Anything beyond this
-- distance is either clipped to the outer ring or hidden depending on the
-- entity type (waystones clip; transient mobs hide). Tweak in concert with
-- DESIGN_RING_SIZES — the outermost ring (216 px) maps to this radius.
local MAP_WORLD_RADIUS = 220
local DESIGN_OUTER_RING_PX = 216

-- Zone eyebrow label (top-left inside panel). JSX: top:6, left:8, fontSize:9.
local DESIGN_ZONE_W        = 160
local DESIGN_ZONE_H        = 12
local DESIGN_ZONE_INSET_X  = 8
local DESIGN_ZONE_INSET_Y  = 6

-- Clock readout (bottom-right inside panel). JSX: bottom:6, right:8, fontSize:9.
local DESIGN_CLOCK_W       = 40
local DESIGN_CLOCK_H       = 12
local DESIGN_CLOCK_INSET_X = 8
local DESIGN_CLOCK_INSET_Y = 6

-- Top-right anchor in screen-scale.
local ANCHOR_X_SCALE = 1 - DESIGN_INSET_RIGHT / DESIGN_SCREEN_W
local ANCHOR_Y_SCALE = DESIGN_INSET_TOP / DESIGN_SCREEN_H

function Module.IsWidgetOpen(): boolean
	return Module.IsOpen and ScreenGui ~= nil
end

----------------------------------------------------------------------
-- Concentric ring: a pixel-sized square circle outline, centered inside
-- the panel at the designed SVG center (100, 110) in 200x200 space.
----------------------------------------------------------------------
local function ring(scope, diameter: number, transparency: number)
	return scope:New('Frame') {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(
			DESIGN_CENTER_X / DESIGN_PANEL_W,
			DESIGN_CENTER_Y / DESIGN_PANEL_H
		),
		Size = UDim2.fromOffset(diameter, diameter),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
			scope:New('UIStroke') {
				Color = PALETTE.accent,
				Transparency = transparency,
				Thickness = 1,
			},
		},
	}
end

local function buildMinimap(scope)
	-- Pixel-exact center dot (player position), anchored to SVG center.
	local centerDot = scope:New('Frame') {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(
			DESIGN_CENTER_X / DESIGN_PANEL_W,
			DESIGN_CENTER_Y / DESIGN_PANEL_H
		),
		Size = UDim2.fromOffset(DESIGN_CENTER_DOT, DESIGN_CENTER_DOT),
		BackgroundColor3 = PALETTE.accent,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
		},
	}

	-- Pulsing outer ring around the player marker.
	local pulseRing = scope:New('Frame') {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(
			DESIGN_CENTER_X / DESIGN_PANEL_W,
			DESIGN_CENTER_Y / DESIGN_PANEL_H
		),
		Size = scope:Computed(function(use)
			local s = use(PulseScale) or 0
			local d = DESIGN_PULSE_BASE + s * DESIGN_PULSE_AMPLITUDE
			return UDim2.fromOffset(d, d)
		end),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
			scope:New('UIStroke') {
				Color = PALETTE.accent,
				Transparency = scope:Computed(function(use)
					return 0.1 + (use(PulseScale) or 0) * 0.6
				end),
				Thickness = 1,
			},
		},
	}

	-- Top-level square panel. Scale-sized from design px / screen px, then
	-- locked to 1:1 aspect via UIAspectRatioConstraint(FitWithinMaxSize).
	-- This stays a true square on every aspect ratio.
	local panel = scope:New('Frame') {
		Name = 'Minimap',
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(ANCHOR_X_SCALE, ANCHOR_Y_SCALE),
		Size = UDim2.fromScale(DESIGN_PANEL_W / DESIGN_SCREEN_W, DESIGN_PANEL_H / DESIGN_SCREEN_H),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		ClipsDescendants = true, -- markers projected to the edge of the panel
		Parent = ScreenGui,
		[Fusion.Children] = {
			scope:New('UIAspectRatioConstraint') {
				AspectRatio = DESIGN_PANEL_W / DESIGN_PANEL_H, -- 1:1
				AspectType = Enum.AspectType.FitWithinMaxSize,
				DominantAxis = Enum.DominantAxis.Width,
			},
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.72, Thickness = 1 },

			ring(scope, DESIGN_RING_SIZES[1], 0.85),
			ring(scope, DESIGN_RING_SIZES[2], 0.85),
			ring(scope, DESIGN_RING_SIZES[3], 0.85),
			ring(scope, DESIGN_RING_SIZES[4], 0.85),

			pulseRing,
			centerDot,

			-- Zone eyebrow (top-left inside panel). Pixel offset size + pixel
			-- inset from the top-left corner.
			scope:New('TextLabel') {
				Name = 'ZoneLabel',
				AnchorPoint = Vector2.new(0, 0),
				Position = UDim2.fromOffset(DESIGN_ZONE_INSET_X, DESIGN_ZONE_INSET_Y),
				Size = UDim2.fromOffset(DESIGN_ZONE_W, DESIGN_ZONE_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				TextSize = 10,
				TextColor3 = PALETTE.accent,
				Text = scope:Computed(function(use)
					return string.format('\u{25C6} %s', tostring(use(ZoneValue) or ''))
				end),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
			},

			-- Clock readout (bottom-right inside panel). Pixel offset size +
			-- pixel inset from the bottom-right corner.
			scope:New('TextLabel') {
				Name = 'ClockText',
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -DESIGN_CLOCK_INSET_X, 1, -DESIGN_CLOCK_INSET_Y),
				Size = UDim2.fromOffset(DESIGN_CLOCK_W, DESIGN_CLOCK_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				TextSize = 10,
				TextColor3 = PALETTE.inkDim,
				Text = scope:Computed(function(use) return tostring(use(ClockValue) or '') end),
				TextXAlignment = Enum.TextXAlignment.Right,
				TextYAlignment = Enum.TextYAlignment.Bottom,
			},

			-- Zoom readout (bottom-LEFT inside panel). Bound reactively to
			-- Zoom so scrolling updates the displayed multiplier instantly,
			-- ahead of the next 10 Hz marker refresh tick.
			scope:New('TextLabel') {
				Name = 'ZoomText',
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.new(0, DESIGN_CLOCK_INSET_X, 1, -DESIGN_CLOCK_INSET_Y),
				Size = UDim2.fromOffset(DESIGN_CLOCK_W, DESIGN_CLOCK_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				TextSize = 10,
				TextColor3 = PALETTE.inkDim,
				Text = scope:Computed(function(use)
					return string.format('x%.1f', use(Zoom) or 1)
				end),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Bottom,
			},
		},
	}

	-- Mouse-wheel zoom. Frame-bound `panel.InputChanged` (NOT
	-- UserInputService.InputChanged) so the handler fires from the
	-- hit-test pipeline — independent of UIS's `gameProcessedEvent`,
	-- which gets set when UISinkInputs sinks the wheel via CAS. The
	-- frame-bound path is also self-gating: the input only delivers
	-- when the cursor is actually over the panel, so we don't need a
	-- separate hovered flag.
	panel.InputChanged:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseWheel then return end
		if not Zoom then return end
		local current = Fusion.peek(Zoom) or 1
		local delta = input.Position.Z
		-- Scroll FORWARD = zoom IN (lower value, smaller radius, more
		-- detail); scroll BACKWARD = zoom OUT (higher value, wider area).
		local next_ = current - delta * ZOOM_STEP
		next_ = math.clamp(next_, ZOOM_MIN, ZOOM_MAX)
		if next_ ~= current then
			Zoom:set(next_)
		end
	end)

	return panel
end

function Module.UpdateWidget()
	if not Module.IsWidgetOpen() then return end
	local floor = LocalPlayer:GetAttribute('CurrentFloor')
	ZoneValue:set(floor and string.format('FL %s', tostring(floor)) or 'LABYRINTH')
	ClockValue:set(string.sub(Lighting.TimeOfDay or '00:00:00', 1, 5))
end

-- Project a world position to minimap-pixel coords (relative to the panel
-- top-left). Returns x, y, isInside. The minimap is *camera-up* — entries
-- in front of the camera appear toward the top, regardless of where the
-- player is facing in world space. `cameraYaw` is `atan2(LookVector.X,
-- -LookVector.Z)` so 0 means default camera (looking -Z) and the rotation
-- formula below resolves to the previous north-up behavior.
local function projectWorldToMinimap(
	worldPos: Vector3, playerPos: Vector3, cameraYaw: number, zoom: number
): (number, number, boolean)
	local dx = worldPos.X - playerPos.X
	local dz = worldPos.Z - playerPos.Z

	-- 2D rotation by -cameraYaw so camera-forward maps to minimap "up"
	-- (i.e. -Y in screen pixels). Verified against the four cardinal
	-- camera orientations: at yaw=0 the formula reduces to (mx, mz) =
	-- (dx, dz), preserving the north-up baseline.
	local cosT, sinT = math.cos(cameraYaw), math.sin(cameraYaw)
	local mx =  dx * cosT + dz * sinT
	local mz = -dx * sinT + dz * cosT

	-- Effective world radius scales with zoom — at zoom=1.0 the outer
	-- ring covers MAP_WORLD_RADIUS studs (the design baseline); at
	-- zoom=5.0 it covers 5× that, giving a wider survey at the cost
	-- of marker resolution.
	local effectiveRadius = MAP_WORLD_RADIUS * zoom
	local dist = math.sqrt(mx * mx + mz * mz)
	-- Clamp to the outer ring; entities past the effective radius sit
	-- on the ring edge so the player still sees a heading indicator.
	local clampedDist = math.min(dist, effectiveRadius)
	local scale = (DESIGN_OUTER_RING_PX / 2) / effectiveRadius
	local px = DESIGN_CENTER_X + mx * (clampedDist / math.max(dist, 0.0001)) * scale
	local py = DESIGN_CENTER_Y + mz * (clampedDist / math.max(dist, 0.0001)) * scale
	return px, py, dist <= effectiveRadius
end

-- Resolve an instance's world position. Models -> primary part / pivot;
-- BaseParts -> Position. Returns nil if the entity has no usable position.
local function getInstancePosition(inst: Instance): Vector3?
	if inst:IsA('Model') then
		local pp = inst.PrimaryPart
		if pp then return pp.Position end
		local hrp = inst:FindFirstChild('HumanoidRootPart')
		if hrp and hrp:IsA('BasePart') then return hrp.Position end
		local ok, cf = pcall(inst.GetPivot, inst)
		if ok and cf then return cf.Position end
	elseif inst:IsA('BasePart') then
		return inst.Position
	end
	return nil
end

local function ensureMarker(inst: Instance, color: Color3, size: number): Frame?
	if not PanelFrame then return nil end
	local existing = MarkerInstances[inst]
	if existing and existing.Parent then return existing end
	local marker = Instance.new('Frame')
	marker.Name = 'Marker_' .. inst.Name
	marker.AnchorPoint = Vector2.new(0.5, 0.5)
	marker.Size = UDim2.fromOffset(size, size)
	marker.BackgroundColor3 = color
	marker.BorderSizePixel = 0
	marker.BackgroundTransparency = 0.1
	-- Square markers; UICorner makes them appear as soft dots.
	local corner = Instance.new('UICorner')
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = marker
	local stroke = Instance.new('UIStroke')
	stroke.Color = color
	stroke.Transparency = 0.3
	stroke.Thickness = 1
	stroke.Parent = marker
	marker.Parent = PanelFrame
	MarkerInstances[inst] = marker
	return marker
end

local function clearMarker(inst: Instance)
	local m = MarkerInstances[inst]
	if m then m:Destroy(); MarkerInstances[inst] = nil end
end

local function refreshMarkers()
	if not Module.IsWidgetOpen() then return end
	local character = LocalPlayer.Character
	local hrp = character and character:FindFirstChild('HumanoidRootPart') :: BasePart?
	if not hrp then return end
	local playerPos = hrp.Position

	-- Camera yaw: angle of the camera's forward direction relative to
	-- world -Z (Roblox's "default camera looks -Z" convention). The
	-- projection rotates marker offsets by -yaw so camera-forward always
	-- maps to the top of the minimap.
	local camera = workspace.CurrentCamera
	local cameraYaw = 0
	if camera then
		local lookVec = camera.CFrame.LookVector
		cameraYaw = math.atan2(lookVec.X, -lookVec.Z)
	end

	-- Build the union of currently-tracked instances; remove any markers
	-- whose source disappeared (untagged, destroyed, or workstation
	-- removed from workspace).
	local seen: {[Instance]: true} = {}

	-- Snapshot zoom once per refresh so all markers in this tick use the
	-- same effective radius (avoids visual desync if the player scrolls
	-- mid-iteration).
	local currentZoom = (Zoom and Fusion.peek(Zoom)) or 1.0

	local function placeMarker(inst: Instance, color: Color3, size: number, maxDistance: number?)
		if inst == character then return end -- skip the local player; centerDot covers them
		local pos = getInstancePosition(inst)
		if not pos then return end
		-- Per-tag distance cap. Compares 2D (XZ) so a mob on a different
		-- floor at the same horizontal distance still flicks off when the
		-- player walks away — matches the projection's XZ-only flatten.
		if maxDistance then
			local dx = pos.X - playerPos.X
			local dz = pos.Z - playerPos.Z
			if (dx * dx + dz * dz) > (maxDistance * maxDistance) then
				-- Out of range — don't mark and don't claim a `seen` slot,
				-- so the cleanup loop at the end of refreshMarkers tears
				-- down any existing marker for this instance.
				return
			end
		end
		seen[inst] = true
		local m = ensureMarker(inst, color, size)
		if not m then return end
		local px, py, _inside = projectWorldToMinimap(pos, playerPos, cameraYaw, currentZoom)
		-- Position uses scale (px / panel_w) so the marker positions
		-- correctly even if the panel scales on different aspect ratios.
		m.Position = UDim2.fromScale(px / DESIGN_PANEL_W, py / DESIGN_PANEL_H)
	end

	for _, entry in MARKER_TAGS do
		for _, inst in CollectionService:GetTagged(entry.tag) do
			-- Filter to live workspace descendants only — tagged instances
			-- can also live in ServerStorage / ReplicatedStorage templates,
			-- and we don't want phantom markers for those off-screen copies.
			if inst:IsDescendantOf(workspace) then
				placeMarker(inst, entry.color, entry.size, entry.maxDistance)
			end
		end
	end

	-- Named workstation circles (workspace direct children). FindFirstChild
	-- is a hash lookup, cheap to call at the 10 Hz refresh cadence.
	for _, entry in STATION_MARKERS do
		local inst = workspace:FindFirstChild(entry.name)
		if inst then
			placeMarker(inst, entry.color, entry.size)
		end
	end

	for inst, _ in MarkerInstances do
		if not seen[inst] or not inst.Parent then
			clearMarker(inst)
		end
	end
end

function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true
	ScreenGui = HUDCommon.ensureScreenGui('HUD_Minimap', 4)
	RootScope = scoped(Fusion)

	ZoneValue  = RootScope:Value('LABYRINTH')
	ClockValue = RootScope:Value('00:00')
	PulseScale = RootScope:Value(0)
	-- Zoom persists across widget close/reopen by being module-scoped, but
	-- bound to RootScope so the reactive bindings clean up on widget tear-
	-- down. Re-init at default 1.0 each open is intentional — keeps the
	-- map predictable when the player toggles it via settings.
	Zoom = RootScope:Value(1.0)

	-- Marker spec — populated here (not at module scope) so PALETTE
	-- references stay live across theme swaps. Sizes are pixel-on-design;
	-- the panel is aspect-locked so they don't compound scale.
	-- `maxDistance` clips the marker when the source is further than N
	-- studs from the player (in 3D, ignores Y). nil → render whenever
	-- inside the zoom-derived viewport. Enemies get a 500-stud cap so a
	-- distant mob that's just out of engagement range stops cluttering
	-- the map; navigation markers (waystones, interactables, players)
	-- stay visible at any distance the zoom permits.
	MARKER_TAGS = {
		{ tag = 'PLAYER_CHARACTER', color = PALETTE.success, size = 6 },
		{ tag = 'AICharacter',      color = PALETTE.danger,  size = 6, maxDistance = 500 },
		{ tag = InteractableData.InteractableTag, color = PALETTE.gold, size = 5 },
		{ tag = WaystonesData.WaystonesTag,       color = PALETTE.violet, size = 7 },
	}

	-- Workstation circles — looked up by name in workspace. ZoneService
	-- already keys on these names (see EnchantingWidget / ForgeWidget /
	-- GemSocketWidget), so the minimap sources them from the same world
	-- instances the zone-enter logic uses.
	STATION_MARKERS = {
		{ name = 'EnchantCircle',   color = PALETTE.violet, size = 7 },
		{ name = 'ForgeCircle',     color = PALETTE.gold,   size = 7 },
		{ name = 'GemSocketCircle', color = PALETTE.accent, size = 7 },
	}

	PanelFrame = buildMinimap(RootScope)
	Module.UpdateWidget()

	-- Sink scroll wheel while mouse is over the minimap panel. The
	-- frame-bound `panel.InputChanged` handler above still applies the
	-- zoom delta (hit-test pipeline, independent of CAS sink). This
	-- registration just stops the wheel from leaking past the minimap
	-- to camera zoom / other CAS consumers.
	SinkProcessorId = UISinkInputs.AddProcessorCallback({
		Name = 'minimap-wheel',
		-- Only the wheel — UISinkInputs refcounts inputs and only binds
		-- what at least one processor declares interest in. Mouse1 /
		-- Mouse2 stay completely unbound at the CAS level when no
		-- processor needs them, so they pass through untouched to other
		-- consumers (Tab keybind chrome, weapon swap, etc.).
		Inputs = { Enum.UserInputType.MouseWheel },
		Filter = function(_state, obj)
			if not PanelFrame or not PanelFrame.Parent then return false end
			-- Hit-test against the panel's screen rect.
			local mouse = UserInputService:GetMouseLocation()
			local pos, size = PanelFrame.AbsolutePosition, PanelFrame.AbsoluteSize
			return mouse.X >= pos.X and mouse.X <= pos.X + size.X
				and mouse.Y >= pos.Y and mouse.Y <= pos.Y + size.Y
		end,
		Sink = function() return true end,
	})
end

function Module.CloseWidget()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	for inst in MarkerInstances do clearMarker(inst) end
	PanelFrame = nil
	if SinkProcessorId then
		UISinkInputs.RemoveProcessor(SinkProcessorId)
		SinkProcessorId = nil
	end
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
end

function Module.Start()
	task.spawn(function()
		local start = os.clock()
		while true do
			RunService.Heartbeat:Wait()
			if PulseScale then
				local t = (os.clock() - start) * 2
				local v = (math.sin(t) + 1) * 0.5
				PulseScale:set(v)
			end
		end
	end)

	task.spawn(function()
		while true do
			Module.UpdateWidget()
			task.wait(1)
		end
	end)

	-- Marker projection at ~10 Hz — much cheaper than 60 Hz, and mob/
	-- player positions don't need every frame to read correctly on a
	-- minimap. Waystones and workstations are static so they're only
	-- repositioned when the player moves.
	task.spawn(function()
		while true do
			task.wait(0.1)
			refreshMarkers()
		end
	end)

	LocalPlayer:GetAttributeChangedSignal('CurrentFloor'):Connect(Module.UpdateWidget)

	HUDCommon.BindLiveTheme(Module)

	-- Visibility toggle wired to SettingsRegistry.MinimapEnabled.
	SettingsRegistry.Changed:Connect(function(key, value)
		if key ~= 'MinimapEnabled' then return end
		if value then
			Module.OpenWidget()
		else
			Module.CloseWidget()
		end
	end)

	task.defer(function()
		if SettingsRegistry.MinimapEnabled then
			Module.OpenWidget()
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/MusicWidget.luau"><![CDATA[-- Music player pill (bottom-right).
-- Ported to Fusion 0.3. Zone-based playlist logic preserved from original.
--
-- Layout strategy (see .claude/skills/custom-roblox-ui/SKILL.md):
--   * Top-level pill: Scale-sized + UIAspectRatioConstraint(FitWithinMaxSize,
--     width-dominant) so the 260:54 pill keeps its shape on any screen aspect.
--   * Inside the pill: pixel offsets (UIPadding, row heights, bar height, ball
--     size). The pill's aspect is locked, so the inner pixel design is safe;
--     converting these to Scale would compound to invisibility (skill Pitfall 1).
--   * Progress bar: 4 px pixel-exact height, pinned to bottom of content area
--     via AnchorPoint(0, 1) + Position.fromScale(0, 1).
--   * Progress ball: 6x6 pixel, AnchorPoint(0.5, 0.5), Position.fromScale(alpha, 0.5).

local Players = game:GetService('Players')
local TweenService = game:GetService('TweenService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local doCleanup = Fusion.doCleanup
local peek = Fusion.peek

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local MusicData = LocalModules.Data.MusicData
local SettingsRegistry = LocalModules.Modules.SettingsRegistry
local PALETTE = HUDCommon.PALETTE

local ZoneService = ReplicatedModules.Services.ZoneService

local MUSIC_FADE_TI = TweenInfo.new(2, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)

local MusicSoundInstance = Instance.new('Sound')
MusicSoundInstance.Name = 'MusicBackground'
MusicSoundInstance.Looped = true
MusicSoundInstance.Parent = workspace

local CurrentSoundId = false
local CurrentSoundData = false
local ActiveRegionId = false

local SystemsContainer = {}

local function setProperties(target, props)
	for k, v in props do target[k] = v end
end

-- CamelCase → spaced. Splits at every capital that follows a lowercase
-- letter or digit (`forestBattle` → `forest Battle`, `boss1Theme` →
-- `boss1 Theme`), then handles acronym→Word transitions on a second pass
-- (`ABCBoss` → `ABC Boss`). The previous implementation prepended a space
-- before every capital and stripped position 1, which dropped the first
-- character of any string that didn't already start with a capital and
-- double-spaced strings that already contained spaces.
local function spaceTextByCapitals(text: string): string
	if not text or text == '' then return text or '' end
	local result = string.gsub(text, '([%l%d])(%u)', '%1 %2')
	result = string.gsub(result, '(%u)(%u%l)', '%1 %2')
	return result
end

local function formatTime(sec: number): string
	if sec ~= sec or sec < 0 then sec = 0 end
	return string.format('%02d:%02d', math.floor(sec / 60), math.floor(sec % 60))
end

-- // Module // --
local Module = { MusicSoundInstance = MusicSoundInstance }
Module.IsOpen = false

local RootScope = nil
local ScreenGui = nil
local SongTitle  = nil -- Value<string>
local SongIdTxt  = nil -- Value<string>
local Duration   = nil -- Value<string>   e.g. "01:23 / 03:45"
local BarAlpha   = nil -- Value<number>   0..1
-- Pill alpha — 0 = fully visible, 1 = max-faded. Driven by the toast
-- count: while toasts are on screen, the pill fades back so the
-- toast stack reads cleanly. Tweened in Start via TweenService on a
-- backing NumberValue so the fade is smooth, not a hard pop.
local PillAlpha  = nil -- Value<number>   0..1

function Module.IsWidgetOpen(): boolean
	return Module.IsOpen and ScreenGui ~= nil
end

function Module.GetRegionMusicList()
	local active = ZoneService.GetZonesPlayerIsWithin(LocalPlayer)
	if table.find(active, ActiveRegionId) then
		return MusicData.RegionSongs[ActiveRegionId]
	end
	local regionPlaylist = false
	for _, id in active do
		regionPlaylist = MusicData.RegionSongs[id]
		if regionPlaylist then ActiveRegionId = id; break end
	end
	if not regionPlaylist then
		ActiveRegionId = 'Default'
		regionPlaylist = MusicData.RegionSongs.Default
	end
	return regionPlaylist
end

-- Effective playback volume for the currently-loaded song. Combines the
-- per-track config volume with the user's master * music sliders so a
-- mid-song settings change can be reflected without a fade-out.
local function targetSongVolume(): number
	if not CurrentSoundData or not CurrentSoundData.Properties then return 0 end
	local base = CurrentSoundData.Properties.Volume or 0
	return base * SettingsRegistry.GetMusicMultiplier()
end

function Module.FadeSoundOut()
	local t = TweenService:Create(MusicSoundInstance, MUSIC_FADE_TI, { Volume = 0 })
	t:Play(); t.Completed:Wait()
	MusicSoundInstance:Stop()
	MusicSoundInstance.Volume = 0
end

function Module.FadeSoundIn()
	MusicSoundInstance:Play()
	TweenService:Create(MusicSoundInstance, MUSIC_FADE_TI, {
		Volume = targetSongVolume(),
	}):Play()
end

function Module.UpdateSongPlaylist()
	local songIds = Module.GetRegionMusicList()
	if table.find(songIds, CurrentSoundId) then return end

	if MusicSoundInstance.Volume > 0 then
		Module.FadeSoundOut()
	end

	if #songIds == 0 then return end

	local rng = Random.new()
	local chosen = songIds[rng:NextInteger(1, #songIds)]
	while CurrentSoundId == chosen and #songIds > 1 do
		chosen = songIds[rng:NextInteger(1, #songIds)]
		task.wait()
	end
	CurrentSoundId = chosen
	CurrentSoundData = MusicData.SongData[chosen]

	if SongTitle then
		SongTitle:set(spaceTextByCapitals(chosen))
		Duration:set('00:00 / 00:00')
		local id = CurrentSoundData.Properties.SoundId or ''
		local parts = string.split(id, 'rbxassetid://')
		SongIdTxt:set(parts[2] or id)
		BarAlpha:set(0)
	end

	setProperties(MusicSoundInstance, CurrentSoundData.Properties)
	Module.FadeSoundIn()
end

function Module.UpdateWidget() end

----------------------------------------------------------------------
-- Design dimensions (pixels on the 1920x1080 reference canvas).
-- Every Scale value in the file is derived from these constants.
----------------------------------------------------------------------
local DESIGN_SCREEN_W, DESIGN_SCREEN_H = 1920, 1080

-- Pill outer shell. Enlarged + spaced so the title + progress bar + meta
-- row all get breathing room instead of stacking on top of each other.
-- Pill bumped from 360×84 → 360×104 so the title + bar + meta rows
-- aren't crammed; the song title sits visibly above the bar instead of
-- overlapping the duration row.
local DESIGN_PILL_W, DESIGN_PILL_H = 360, 104
local DESIGN_PILL_PAD_X            = 16
local DESIGN_PILL_PAD_Y            = 10

-- Inside-pill atoms. Values are still expressed as PIXELS at the design
-- resolution (360×84 pill, 328×60 content area after padding), but every
-- UDim2 consuming them below divides by the content-area dimension to
-- produce a pure SCALE value — so nothing in the tree is raw offset.
local DESIGN_EYEBROW_H  = 12
local DESIGN_TITLE_H    = 22
local DESIGN_BAR_H      = 6
local DESIGN_BALL       = 10
local DESIGN_SONGID_W   = 90
local DESIGN_DURATION_W = 100
local DESIGN_META_H     = 14   -- height of song-id/duration meta rows
local DESIGN_TITLE_GAP  = 2    -- gap between eyebrow row and title row (smaller → title sits closer to eyebrow)
local DESIGN_BAR_GAP    = 4    -- gap between duration text and progress bar

-- Content area (after symmetric padding is applied by UIPadding). Every
-- inner Scale value is a pixel dimension divided by one of these.
local DESIGN_CONTENT_W = DESIGN_PILL_W - 2 * DESIGN_PILL_PAD_X  -- 328
local DESIGN_CONTENT_H = DESIGN_PILL_H - 2 * DESIGN_PILL_PAD_Y  -- 60

-- Screen-anchor insets for the pill's bottom-right corner.
local ANCHOR_INSET_X = 20 / DESIGN_SCREEN_W   -- 20 px from right edge at 1920
local ANCHOR_INSET_Y = 20 / DESIGN_SCREEN_H   -- 20 px from bottom edge at 1080

local function buildUI(scope)
	-- Wrap the pill in a CanvasGroup so a single GroupTransparency
	-- can fade the *whole* widget (pill background + stroke + every
	-- text label + the progress bar) in one binding. The toast
	-- subscriber in Start drives PillAlpha; with the CanvasGroup
	-- wrapping, all visible elements fade in lockstep — no per-child
	-- transparency wiring across the children tree.
	local canvas = scope:New('CanvasGroup') {
		Name = 'MusicCanvas',
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, 0, 1, 0),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		GroupTransparency = scope:Computed(function(use)
			return math.clamp(use(PillAlpha), 0, 1)
		end),
	}
	canvas.Parent = ScreenGui
	-- Top-level pill. Scale-sized from design px / screen px, then locked to
	-- its 260:54 aspect via UIAspectRatioConstraint(FitWithinMaxSize). The
	-- pill keeps its designed shape on 16:9, 32:9, or portrait.
	local root = HUDCommon.chiseledPanel(scope, {
		Name = 'MusicPill',
		Size = UDim2.fromScale(DESIGN_PILL_W / DESIGN_SCREEN_W, DESIGN_PILL_H / DESIGN_SCREEN_H),
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, 0, 1, 0) - UDim2.fromScale(ANCHOR_INSET_X, ANCHOR_INSET_Y),
		AccentColor = PALETTE.violet,
		-- Shape lock on the panel ROOT (not inside Children) so the pill
		-- itself stays 360:84 — previously the constraint was on the inner
		-- children wrapper, leaving the pill root free to stretch on wide
		-- screens which is what created the gap to the right of the content.
		AspectRatio = DESIGN_PILL_W / DESIGN_PILL_H,
		Children = {
			-- Padding in SCALE of the pill. The pill is aspect-locked so this
			-- gives a constant-proportion inset regardless of screen size.
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(DESIGN_PILL_PAD_Y / DESIGN_PILL_H, 0),
				PaddingBottom = UDim.new(DESIGN_PILL_PAD_Y / DESIGN_PILL_H, 0),
				PaddingLeft   = UDim.new(DESIGN_PILL_PAD_X / DESIGN_PILL_W, 0),
				PaddingRight  = UDim.new(DESIGN_PILL_PAD_X / DESIGN_PILL_W, 0),
			},

			-- Row 1: eyebrow "NOW PLAYING". Scale height = eyebrow_h / content_h.
			HUDCommon.eyebrowLabel(scope, {
				Text = '\u{266A} NOW PLAYING',
				Color = PALETTE.violet,
				Size = UDim2.fromScale(1, DESIGN_EYEBROW_H / DESIGN_CONTENT_H),
				TextSize = 11,
			}),

			-- Row 1-right: song id, anchored to eyebrow row (y=0).
			scope:New('TextLabel') {
				Name = 'SongId',
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.fromScale(1, 0),
				Size = UDim2.fromScale(
					DESIGN_SONGID_W / DESIGN_CONTENT_W,
					DESIGN_EYEBROW_H / DESIGN_CONTENT_H
				),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				TextSize = 10,
				TextColor3 = PALETTE.inkDim,
				Text = scope:Computed(function(use) return use(SongIdTxt) end),
				TextXAlignment = Enum.TextXAlignment.Right,
				TextYAlignment = Enum.TextYAlignment.Center,
			},

			-- Row 2: song title. Position Y = (eyebrow + gap) / content_h.
			-- TextSize dropped from 18 → 14 so the title doesn't dominate
			-- the pill; the larger pill height + smaller text + tighter
			-- title-gap shifts the eyebrow + id + title visually upward
			-- and gives the bar/meta row room to breathe at the bottom.
			scope:New('TextLabel') {
				Name = 'SongTitle',
				Position = UDim2.fromScale(
					0,
					(DESIGN_EYEBROW_H + DESIGN_TITLE_GAP) / DESIGN_CONTENT_H
				),
				Size = UDim2.fromScale(1, DESIGN_TITLE_H / DESIGN_CONTENT_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				TextSize = 14,
				TextColor3 = PALETTE.ink,
				Text = scope:Computed(function(use) return use(SongTitle) end),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
				TextTruncate = Enum.TextTruncate.AtEnd,
			},

			-- Row 3: duration, anchored bottom-right above the bar. Inset Y
			-- (bar_h + gap) / content_h — all scale, no offset pixels.
			scope:New('TextLabel') {
				Name = 'Duration',
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.fromScale(
					1,
					1 - (DESIGN_BAR_H + DESIGN_BAR_GAP) / DESIGN_CONTENT_H
				),
				Size = UDim2.fromScale(
					DESIGN_DURATION_W / DESIGN_CONTENT_W,
					DESIGN_META_H / DESIGN_CONTENT_H
				),
				AutomaticSize = Enum.AutomaticSize.None,
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				TextSize = 12,
				TextColor3 = PALETTE.violet,
				Text = scope:Computed(function(use) return use(Duration) end),
				TextXAlignment = Enum.TextXAlignment.Right,
				TextYAlignment = Enum.TextYAlignment.Center,
			},

			-- Progress bar track: scale both axes. Pinned to bottom of content.
			scope:New('Frame') {
				Name = 'Progress',
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.fromScale(0, 1),
				Size = UDim2.fromScale(1, DESIGN_BAR_H / DESIGN_CONTENT_H),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.3,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					-- Filled portion: width scales with alpha, full bar height.
					scope:New('Frame') {
						Name = 'Bar',
						Size = scope:Computed(function(use)
							return UDim2.fromScale(math.clamp(use(BarAlpha), 0, 1), 1)
						end),
						BackgroundColor3 = PALETTE.violet,
						BorderSizePixel = 0,
					},
					-- Progress ball: scale width, aspect-constrained to square.
					-- ScaleWithParentSize + Width dominant → width derived from
					-- parent's X (content width) and height forced to match.
					scope:New('Frame') {
						Name = 'Ball',
						AnchorPoint = Vector2.new(0.5, 0.5),
						Size = UDim2.fromScale(DESIGN_BALL / DESIGN_CONTENT_W, 0),
						Position = scope:Computed(function(use)
							return UDim2.fromScale(math.clamp(use(BarAlpha), 0, 1), 0.5)
						end),
						BackgroundColor3 = PALETTE.accentHot,
						BorderSizePixel = 0,
						[Fusion.Children] = {
							scope:New('UIAspectRatioConstraint') {
								AspectRatio = 1,
								AspectType = Enum.AspectType.ScaleWithParentSize,
								DominantAxis = Enum.DominantAxis.Width,
							},
							scope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
						},
					},
				},
			},
		},
	})
	root.Parent = canvas
end

function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true
	ScreenGui = HUDCommon.ensureScreenGui('HUD_Music', 4)
	RootScope = scoped(Fusion)

	SongTitle = RootScope:Value('')
	SongIdTxt = RootScope:Value('')
	Duration  = RootScope:Value('00:00 / 00:00')
	BarAlpha  = RootScope:Value(0)
	PillAlpha = RootScope:Value(0)

	buildUI(RootScope)

	-- Sync the freshly-built Fusion Values to whatever audio state
	-- already exists. The audio side (CurrentSoundId / MusicSoundInstance)
	-- is module-level and survives close/open cycles, but the UI Values
	-- live in RootScope and reset every open. Without this catch-up the
	-- pill renders empty whenever the widget is reopened (theme rebuild,
	-- visibility toggle, deferred-Start order) — UpdateSongPlaylist won't
	-- re-sync because its early-out skips when CurrentSoundId is already
	-- in the current zone's playlist.
	if typeof(CurrentSoundId) == 'string' and CurrentSoundData
		and CurrentSoundData.Properties then
		SongTitle:set(spaceTextByCapitals(CurrentSoundId))
		local id = CurrentSoundData.Properties.SoundId or ''
		local parts = string.split(id, 'rbxassetid://')
		SongIdTxt:set(parts[2] or id)
	end
end

function Module.CloseWidget()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
end

-- Target alpha when toasts are present. Tunable: 0.55 = pill fades
-- to 45% visible, soft enough to read toasts on top without fully
-- losing the music context. Lerp time tuned so the fade reads as a
-- responsive UI cue, not a sluggish animation.
local PILL_FADE_ALPHA = 0.55
local PILL_FADE_TIME  = 0.35

-- Drive PillAlpha toward `target` over PILL_FADE_TIME seconds. Cancels
-- any in-flight fade by tracking a generation counter on the local
-- module — a fresh fade bumps the counter; older fades early-exit on
-- mismatch. Without this, rapid toast-add → toast-clear sequences
-- would race two task.spawn loops driving the same Value.
local PillFadeGen = 0
local function fadePillTo(target: number)
	if not PillAlpha then return end
	PillFadeGen += 1
	local gen = PillFadeGen
	local from = peek(PillAlpha)
	local t0 = os.clock()
	task.spawn(function()
		while gen == PillFadeGen do
			local elapsed = os.clock() - t0
			local a = math.clamp(elapsed / PILL_FADE_TIME, 0, 1)
			-- Smoothstep so the fade eases in/out instead of a linear ramp.
			a = a * a * (3 - 2 * a)
			PillAlpha:set(from + (target - from) * a)
			if elapsed >= PILL_FADE_TIME then
				PillAlpha:set(target)
				return
			end
			task.wait()
		end
	end)
end

function Module.Start()
	task.spawn(function()
		while true do
			task.wait(1)
			if CurrentSoundData and Duration then
				local pos = MusicSoundInstance.TimePosition
				local len = MusicSoundInstance.TimeLength
				Duration:set(string.format('%s / %s', formatTime(pos), formatTime(len)))
				if len > 0 then
					BarAlpha:set(pos / len)
				end
			end
		end
	end)

	-- Toast-presence fade. ToastWidget exposes OnCountChanged via its
	-- module surface; we pull the live module from SystemsContainer
	-- (or its widget-namespace parent) so the connection survives a
	-- reload of either widget independently.
	local function getToastWidget()
		return SystemsContainer.ToastWidget
			or (SystemsContainer.ParentSystems and SystemsContainer.ParentSystems.Widgets
				and SystemsContainer.ParentSystems.Widgets.ToastWidget)
	end
	local function applyToastFade(count: number)
		fadePillTo(count > 0 and PILL_FADE_ALPHA or 0)
	end
	local toastWidget = getToastWidget()
	if toastWidget and toastWidget.OnCountChanged then
		toastWidget.OnCountChanged:Connect(applyToastFade)
		-- Catch-up: a toast may already be on screen at the moment
		-- this widget loads (race between Start orderings).
		applyToastFade(toastWidget.GetActiveCount and toastWidget.GetActiveCount() or 0)
	end

	ZoneService.ZoneEnter:Connect(Module.UpdateSongPlaylist)
	ZoneService.ZoneLeave:Connect(Module.UpdateSongPlaylist)
	MusicSoundInstance.Ended:Connect(function()
		MusicSoundInstance:Stop()
		Module.UpdateSongPlaylist()
	end)

	-- Re-multiply the live song's volume whenever the master/music sliders
	-- move. Skipped while the sound isn't playing (FadeSoundIn will pick up
	-- the latest multiplier on its own).
	SettingsRegistry.Changed:Connect(function(key)
		if key ~= 'MasterVolume' and key ~= 'MusicVolume' then return end
		if MusicSoundInstance.IsPlaying then
			MusicSoundInstance.Volume = targetSongVolume()
		end
	end)

	HUDCommon.BindLiveTheme(Module)

	-- Visibility toggle wired to SettingsRegistry.MusicWidgetEnabled.
	-- Open/close on flip; on initial load we honor the registry value.
	SettingsRegistry.Changed:Connect(function(key, value)
		if key ~= 'MusicWidgetEnabled' then return end
		if value then
			Module.OpenWidget()
		else
			Module.CloseWidget()
		end
	end)

	task.defer(Module.UpdateSongPlaylist)
	task.delay(3, function()
		if SettingsRegistry.MusicWidgetEnabled then
			Module.OpenWidget()
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/OnboardingWidget.luau"><![CDATA[-- Onboarding overlay tooltip. Bottom-center pill that shows the current
-- step's title + body text, with a "Got it" button that fires a
-- MarkComplete event. Hidden when CurrentStep is nil (player completed
-- onboarding or hasn't started).

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped    = Fusion.scoped
local doCleanup = Fusion.doCleanup
local peek      = Fusion.peek
local RemoteService = ReplicatedModules.Services.RemoteService

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local OnboardingData = ReplicatedModules.Data.Onboarding
local Actions = OnboardingData.Actions

local OnboardingEvent = RemoteService.GetRemote('OnboardingEvent', 'RemoteEvent', false)

local SystemsContainer = {}

local Module = {}
Module.IsOpen = false

local RootScope = nil
local ScreenGui = nil
local CurrentStep = nil  -- Fusion Value<stepId | nil>

function Module.IsWidgetOpen(): boolean
	return Module.IsOpen and ScreenGui ~= nil
end

----------------------------------------------------------------------
-- Spotlight overlay. Four frames form an inverse cutout around the
-- highlight rect — together they darken the rest of the screen while
-- leaving the highlighted area visible. UDim2 fromScale so a 1080p +
-- 4K screen both render the right hole. Anchor selectors:
--
--   'screen_rect' — Position/Size from cfg directly.
--   'tab_chip'    — TODO: resolve via TabWidget. For now, falls back to
--                   no-highlight (skips the cutout) so the system stays
--                   non-blocking until that integration lands.
--   'world_part'  — projects InstancePath's world position to viewport
--                   each frame. Implemented inline below.
----------------------------------------------------------------------
local function buildSpotlightOverlay(scope, holeRect)
	-- holeRect is a Computed<UDim2 (pos), UDim2 (size), boolean (visible)>.
	-- Four darkening frames: top / bottom / left / right of the hole.
	-- BackgroundTransparency 0.4 reads as soft dim, not black-out.
	local DARK = 0.4
	local function panel(name, pos, size)
		return scope:New('Frame') {
			Name = name,
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = scope:Computed(function(use)
				return use(holeRect).visible and DARK or 1
			end),
			BorderSizePixel = 0,
			Position = pos, Size = size,
		}
	end
	-- Each side runs from screen edge to the corresponding edge of the
	-- hole rect. Positions / sizes derived from the hole's Pos+Size.
	return {
		-- TOP: from screen top to hole top.
		scope:New('Frame') {
			Name = 'SpotlightTop',
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = scope:Computed(function(use)
				return use(holeRect).visible and DARK or 1
			end),
			BorderSizePixel = 0,
			Position = UDim2.fromScale(0, 0),
			Size = scope:Computed(function(use)
				local r = use(holeRect)
				return UDim2.fromScale(1, math.max(0, r.pos.Y))
			end),
		},
		-- BOTTOM: from hole bottom to screen bottom.
		scope:New('Frame') {
			Name = 'SpotlightBottom',
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = scope:Computed(function(use)
				return use(holeRect).visible and DARK or 1
			end),
			BorderSizePixel = 0,
			Position = scope:Computed(function(use)
				local r = use(holeRect)
				return UDim2.fromScale(0, math.min(1, r.pos.Y + r.size.Y))
			end),
			Size = scope:Computed(function(use)
				local r = use(holeRect)
				return UDim2.fromScale(1, math.max(0, 1 - (r.pos.Y + r.size.Y)))
			end),
		},
		-- LEFT: between top + bottom panels, from screen left to hole left.
		scope:New('Frame') {
			Name = 'SpotlightLeft',
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = scope:Computed(function(use)
				return use(holeRect).visible and DARK or 1
			end),
			BorderSizePixel = 0,
			Position = scope:Computed(function(use)
				local r = use(holeRect)
				return UDim2.fromScale(0, r.pos.Y)
			end),
			Size = scope:Computed(function(use)
				local r = use(holeRect)
				return UDim2.fromScale(math.max(0, r.pos.X), r.size.Y)
			end),
		},
		-- RIGHT: between top + bottom panels, from hole right to screen right.
		scope:New('Frame') {
			Name = 'SpotlightRight',
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = scope:Computed(function(use)
				return use(holeRect).visible and DARK or 1
			end),
			BorderSizePixel = 0,
			Position = scope:Computed(function(use)
				local r = use(holeRect)
				return UDim2.fromScale(math.min(1, r.pos.X + r.size.X), r.pos.Y)
			end),
			Size = scope:Computed(function(use)
				local r = use(holeRect)
				return UDim2.fromScale(math.max(0, 1 - (r.pos.X + r.size.X)), r.size.Y)
			end),
		},
		-- Caption beneath the cutout (small mono label, accent-colored).
		scope:New('TextLabel') {
			Name = 'SpotlightCaption',
			AnchorPoint = Vector2.new(0.5, 0),
			Position = scope:Computed(function(use)
				local r = use(holeRect)
				return UDim2.fromScale(r.pos.X + r.size.X * 0.5, math.min(0.98, r.pos.Y + r.size.Y + 0.01))
			end),
			Size = UDim2.fromScale(0.4, 0.025),
			BackgroundTransparency = 1,
			FontFace = HUDCommon.FONT_MONO,
			TextSize = 12,
			TextColor3 = PALETTE.accent,
			TextTransparency = scope:Computed(function(use)
				return use(holeRect).visible and 0.1 or 1
			end),
			Text = scope:Computed(function(use) return use(holeRect).caption or '' end),
		},
	}
end

local function buildUI(scope)
	local stepData = scope:Computed(function(use)
		local id = use(CurrentStep); if not id then return nil end
		return OnboardingData.Steps[id]
	end)
	-- Compute the spotlight hole rect from the step's Highlight cfg.
	-- Returns { pos: Vector2, size: Vector2, visible: bool, caption: string? }
	-- in fromScale (0..1) units. Each render path resolves to that
	-- shape so the SpotlightOverlay branches are uniform.
	local holeRect = scope:Computed(function(use)
		local s = use(stepData)
		if not s or not s.Highlight then
			return { pos = Vector2.new(0, 0), size = Vector2.new(0, 0), visible = false }
		end
		local hl = s.Highlight
		if hl.Anchor == 'screen_rect' and hl.Position and hl.Size then
			return {
				pos = hl.Position, size = hl.Size,
				visible = true, caption = hl.Caption or s.Title,
			}
		elseif hl.Anchor == 'world_part' and hl.InstancePath then
			-- Resolve the part by path; project to viewport scale.
			-- Server-authored InstancePath strings travel through to
			-- here via the OnboardingData config; CinematicShared has
			-- the resolver but we inline a minimal one to avoid the
			-- import.
			local node: any = workspace
			for _, segment in string.split(hl.InstancePath, '.') do
				if segment == 'workspace' then continue end
				if not node then break end
				node = node:FindFirstChild(segment)
			end
			local part = (node and node:IsA('BasePart')) and node or nil
			local camera = workspace.CurrentCamera
			if not part or not camera then
				return { pos = Vector2.new(), size = Vector2.new(), visible = false }
			end
			local screen, onScreen = camera:WorldToViewportPoint(part.Position)
			if not onScreen or screen.Z <= 0 then
				return { pos = Vector2.new(), size = Vector2.new(), visible = false }
			end
			local viewport = camera.ViewportSize
			-- 80×80 px hole centered on the projected point — designers
			-- can tune by pulling these numbers off cfg if needed.
			local W, H = viewport.X, viewport.Y
			local boxW, boxH = 120 / W, 120 / H
			return {
				pos = Vector2.new(screen.X / W - boxW * 0.5, screen.Y / H - boxH * 0.5),
				size = Vector2.new(boxW, boxH),
				visible = true,
				caption = hl.Caption or s.Title,
			}
		end
		-- 'tab_chip' or unknown anchor: TODO when TabWidget integration lands.
		return { pos = Vector2.new(), size = Vector2.new(), visible = false }
	end)

	-- Spotlight cutout panels — rendered first so the panel below
	-- draws on top.
	for _, panel in buildSpotlightOverlay(scope, holeRect) do
		(panel :: any).Parent = ScreenGui
	end

	scope:New('Frame') {
		Name = 'OnboardingPanel',
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 0.85),
		Size = UDim2.fromScale(420 / 1920, 96 / 1080),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		Visible = scope:Computed(function(use) return use(stepData) ~= nil end),
		Parent = ScreenGui,
		[Fusion.Children] = {
			scope:New('UIAspectRatioConstraint') {
				AspectRatio = 420 / 96,
				AspectType = Enum.AspectType.FitWithinMaxSize,
				DominantAxis = Enum.DominantAxis.Width,
			},
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
				PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14),
			},
			scope:New('TextLabel') {
				Size = UDim2.new(1, 0, 0, 14),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = '◆ TUTORIAL',
				TextSize = 11,
				TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				Position = UDim2.new(0, 0, 0, 16),
				Size = UDim2.new(1, 0, 0, 22),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = scope:Computed(function(use) local s = use(stepData); return s and s.Title or '' end),
				TextSize = 18,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
			},
			scope:New('TextLabel') {
				Position = UDim2.new(0, 0, 0, 38),
				Size = UDim2.new(1, -100, 1, -38),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = scope:Computed(function(use) local s = use(stepData); return s and s.Body or '' end),
				TextSize = 13,
				TextColor3 = PALETTE.inkDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
			},
			scope:New('TextButton') {
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, 0, 1, 0),
				Size = UDim2.fromOffset(90, 28),
				BackgroundColor3 = PALETTE.bg1,
				BackgroundTransparency = 0.25,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				FontFace = HUDCommon.FONT_BUTTON,
				Text = 'GOT IT',
				TextSize = 12,
				TextColor3 = PALETTE.ink,
				[Fusion.OnEvent('Activated')] = function()
					local id = peek(CurrentStep); if not id then return end
					OnboardingEvent:FireServer(Actions.MarkComplete, id)
				end,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
				},
			},
		},
	}
end

function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true
	ScreenGui = HUDCommon.ensureScreenGui('HUD_Onboarding', 28)
	RootScope = scoped(Fusion)
	CurrentStep = RootScope:Value(nil)
	buildUI(RootScope)
end

function Module.CloseWidget()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
end

function Module.Start()
	HUDCommon.BindLiveTheme(Module)

	OnboardingEvent.OnClientEvent:Connect(function(action, ...)
		if action == Actions.StepChanged then
			local stepId = ...
			if CurrentStep then CurrentStep:set(stepId) end
		end
	end)

	task.defer(Module.OpenWidget)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/OnscreenButtons.luau"><![CDATA[-- Left-side hex button cluster (opens Tab sub-tabs).
-- Fusion-driven replacement for the GameInterface.LeftHexButtons template.

local Debris = game:GetService('Debris')
local Players = game:GetService('Players')
local TweenService = game:GetService('TweenService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local doCleanup = Fusion.doCleanup

local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')
local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local SettingsRegistry = LocalModules.Modules.SettingsRegistry
local PALETTE = HUDCommon.PALETTE

local SystemsContainer = {}

-- Button spec: tab name keys the TabWidget topbar button by Name.
local BUTTONS = {
	{ id = 'Character', glyph = 'C', tab = 'Character', label = 'STATS' },
	{ id = 'Inventory', glyph = 'I', tab = 'Inventory', label = 'BAG'   },
	{ id = 'Skills',    glyph = 'K', tab = 'Skills',    label = 'SKILL' },
	{ id = 'Social',    glyph = 'S', tab = 'Social',    label = 'PARTY' },
}

local TI = TweenInfo.new(0.08, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)

-- Design reference sizes (px on a 1920x1080 canvas). Aspect constraints use
-- these to preserve hex button proportions + stack geometry on any screen.
local DESIGN_SCREEN_W       = 1920
local DESIGN_SCREEN_H       = 1080
local DESIGN_BTN            = 80         -- hex button is square 80x80 (bigger)
local DESIGN_BTN_GAP        = 32         -- gap between buttons (more breathing room)
local DESIGN_LABEL_H        = 12         -- "STATS"/"BAG" chip under each button
local DESIGN_BTN_CORNER_PX  = 6          -- button corner radius
local DESIGN_STACK_W        = DESIGN_BTN -- column width
local DESIGN_STACK_H        = #BUTTONS * DESIGN_BTN + (#BUTTONS - 1) * DESIGN_BTN_GAP
local DESIGN_LEFT_PAD_PX    = 24         -- inset from screen's left edge
local ANCHOR_X_SCALE        = DESIGN_LEFT_PAD_PX / DESIGN_SCREEN_W

-- // Module // --
local Module = {}
Module.IsOpen = false

local RootScope = nil
local ScreenGui = nil

function Module.IsWidgetOpen(): boolean
	return Module.IsOpen and ScreenGui ~= nil
end

function Module.OpenTargetTabByName(tabName: string)
	local tabWidget = SystemsContainer.TabWidget
	if not tabWidget then return end
	tabWidget.OpenWidget()
	if tabWidget.SelectTopbarTabByName then
		tabWidget.SelectTopbarTabByName(tabName)
	end
end

local function playUIPop()
	local sfx = ReplicatedAssets.Sounds.Local.UIPop:Clone()
	sfx.Volume = 0.1
	sfx.Parent = workspace
	sfx:Play()
	Debris:AddItem(sfx, 1)
end

local function buildHex(scope, spec)
	local uiScale = Instance.new('UIScale')

	local button = scope:New('TextButton') {
		Name = spec.id,
		-- Width = 100% of stack column; aspect ratio forces height = width (square).
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.None,
		BackgroundColor3 = PALETTE.panel,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = '',
		[Fusion.Children] = {
			-- Lock button to 1:1 square regardless of stack column proportions.
			scope:New('UIAspectRatioConstraint') {
				AspectRatio = 1,
				AspectType = Enum.AspectType.ScaleWithParentSize,
				DominantAxis = Enum.DominantAxis.Width,
			},
			scope:New('UICorner') { CornerRadius = UDim.new(0, DESIGN_BTN_CORNER_PX) },
			scope:New('UIStroke') {
				Color = PALETTE.accent, Transparency = 0.4, Thickness = 1,
			},
			-- Glyph fills the full button interior.
			scope:New('TextLabel') {
				Name = 'Glyph',
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY, TextSize = 22,
				TextColor3 = PALETTE.accent, Text = spec.glyph,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
			-- "STATS"/"BAG" chip below the button: anchored to top-center of
			-- its rect which sits below the button (Position Y = 1). Height is
			-- a fraction of the button height so it scales in lockstep.
			scope:New('TextLabel') {
				Name = 'KeybindLabel',
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.fromScale(0.5, 1),
				Size = UDim2.fromScale(1, DESIGN_LABEL_H / DESIGN_BTN),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO, TextSize = 9,
				TextColor3 = PALETTE.inkDim, Text = spec.label,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
		},

		[Fusion.OnEvent 'MouseEnter'] = function()
			local tabWidget = SystemsContainer.TabWidget
			if tabWidget and tabWidget.IsWidgetOpen() then return end
			playUIPop()
			TweenService:Create(uiScale, TI, { Scale = 1.125 }):Play()
		end,
		[Fusion.OnEvent 'MouseLeave'] = function()
			TweenService:Create(uiScale, TI, { Scale = 1 }):Play()
		end,
		[Fusion.OnEvent 'Activated'] = function()
			local tabWidget = SystemsContainer.TabWidget
			if tabWidget and tabWidget.IsWidgetOpen() then return end
			Module.OpenTargetTabByName(spec.tab)
		end,
	}
	uiScale.Parent = button
	return button
end

local function buildUI(scope)
	-- Root stack: Scale-sized on both axes + UIAspectRatioConstraint keeps the
	-- tall, narrow column proportioned correctly. AnchorPoint (0, 0.5) +
	-- Position Y 0.5 vertically centers it without offset math.
	local root = scope:New('Frame') {
		Name = 'LeftHexButtons',
		AnchorPoint = Vector2.new(0, 0.5),
		-- Anchored (0, 0.5) + Y=0.6 shifts the cluster below the screen's
		-- vertical midline so it sits clear of the vitals block + minimap row.
		Position = UDim2.fromScale(ANCHOR_X_SCALE, 0.6),
		Size = UDim2.fromScale(DESIGN_STACK_W / DESIGN_SCREEN_W, DESIGN_STACK_H / DESIGN_SCREEN_H),
		BackgroundTransparency = 1,
		Parent = ScreenGui,
		[Fusion.Children] = {
			scope:New('UIAspectRatioConstraint') {
				AspectRatio = DESIGN_STACK_W / DESIGN_STACK_H, -- ~0.186
				AspectType = Enum.AspectType.FitWithinMaxSize,
				DominantAxis = Enum.DominantAxis.Height,
			},
			-- UIGridLayout as a vertical single-column stack. Quirk: to get ONE
			-- column you need FillDirection=Horizontal + FillDirectionMaxCells=1
			-- ("max 1 cell per row, wrap to next row") — the intuitive
			-- FillDirection=Vertical/MaxCells=1 actually means "max 1 cell per
			-- column", which produces a horizontal row instead.
			scope:New('UIGridLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				FillDirectionMaxCells = 1,
				CellSize = UDim2.fromScale(1, DESIGN_BTN / DESIGN_STACK_H),
				CellPadding = UDim2.fromScale(0, DESIGN_BTN_GAP / DESIGN_STACK_H),
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				VerticalAlignment = Enum.VerticalAlignment.Top,
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
		},
	}

	for index, spec in BUTTONS do
		local btn = buildHex(scope, spec)
		btn.LayoutOrder = index
		btn.Parent = root
	end
end

function Module.UpdateWidget() end

function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true
	ScreenGui = HUDCommon.ensureScreenGui('HUD_LeftHex', 5)
	RootScope = scoped(Fusion)
	buildUI(RootScope)
end

function Module.CloseWidget()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
end

function Module.Start()
	HUDCommon.BindLiveTheme(Module)

	-- Visibility toggle wired to SettingsRegistry.OnscreenButtonsEnabled.
	-- Per the user's parenthetical, this same setting also controls the
	-- Hotbar's Q/W/R/D/F clusters; HotbarWidget consults the registry
	-- directly so we don't reach across modules from here.
	SettingsRegistry.Changed:Connect(function(key, value)
		if key ~= 'OnscreenButtonsEnabled' then return end
		if value then
			Module.OpenWidget()
		else
			Module.CloseWidget()
		end
	end)

	task.defer(function()
		if SettingsRegistry.OnscreenButtonsEnabled then
			Module.OpenWidget()
		end
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/OnscreenWidget.luau"><![CDATA[-- Top-left vitals block. Faithful port of tmp/aincrad-ui/hud.jsx HudPlated top-left cluster:
-- sigil square with level badge + info column (name/eyebrow/HP/MP/XP rows with mono readouts).
--
-- Layout strategy (see .claude/skills/custom-roblox-ui/SKILL.md):
--   * Top-level OnscreenVitals frame: Scale-sized + UIAspectRatioConstraint(FitWithinMaxSize,
--     width-dominant) so the cluster keeps its designed 304:52 shape on 16:9, 32:9, 9:16.
--   * Sigil: child Scale-sized on height axis (fromScale(0,1)) + aspect 1:1 driven by
--     height (ScaleWithParentSize) — always a square the height of the block.
--   * Info column: Scale-sized as a fraction of root width + 100% height; children inside
--     size themselves as fractions of the info column (never raw screen fractions).
--   * Bar heights (4/7/10 px) stay as pixel offsets — too small to scale safely.
--   * UIListLayout paddings use Scale = pixel / designDimension so gaps scale with cluster.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local doCleanup = Fusion.doCleanup

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local LevelingConfig = ReplicatedModules.Data.Leveling
local DifficultyConfig = ReplicatedModules.Data.Difficulty
local MaidClass = ReplicatedModules.Modules.Maid
local ReplicatedData = ReplicatedModules.Services.ReplicatedData

local PALETTE = HUDCommon.PALETTE

local SystemsContainer = {}

-- // Module // --
local Module = {}
Module.IsOpen = false
Module.CharacterMaid = nil

local RootScope = nil
local ScreenGui = nil
local PlayerName    = nil
local PlayerInitial = nil   -- fallback if the thumbnail fetch fails
local PortraitImage = nil   -- Value<string>  rbxthumb:// asset url
local LevelValue    = nil
local ZoneValue     = nil
local HPValue       = nil
local HPMax         = nil
local XPValue       = nil
local XPMax         = nil
local CurrencyValue = nil
-- Difficulty: id string ('normal' | 'hard' | 'death'). Drives the bold
-- colored badge to the right of the name label. 'normal' hides the
-- badge. Synced from PlayerData.Difficulty in Module.UpdateWidget;
-- the canonical config (text + accent color + multipliers) lives in
-- ReplicatedStorage/Modules/Data/Difficulty.luau so the menu and the
-- in-game widget share one source of truth.
local Difficulty    = nil

-- Resolve a difficulty id → { Text, Color } badge spec. 'normal' (and
-- any unknown id) returns nil so the badge stays hidden. Routes through
-- the shared registry so adding a tier is a single-file edit.
local function badgeSpecFor(id: string?): { Text: string, Color: Color3 }?
	if not DifficultyConfig.IsValidId(id) then return nil end
	if id == 'normal' then return nil end
	local cfg = DifficultyConfig.GetConfigById(id :: string)
	if not cfg then return nil end
	return { Text = string.upper(cfg.name), Color = cfg.accent }
end

function Module.IsWidgetOpen(): boolean
	return Module.IsOpen and ScreenGui ~= nil
end

function Module.UpdateWidget()
	if not Module.IsWidgetOpen() then return end
	local data = ReplicatedData.GetData('PlayerData', false)
	if not data then return end

	local level = data.Level or 1
	LevelValue:set(level)

	local xp = data.Experience or 0
	if level + 1 < LevelingConfig.MaxLevel then
		XPValue:set(xp)
		XPMax:set(LevelingConfig.GetExperienceToLevel(level))
	else
		XPValue:set(1)
		XPMax:set(1)
	end

	CurrencyValue:set(data.Currency or 0)

	local floor = LocalPlayer:GetAttribute('CurrentFloor')
	ZoneValue:set(floor and string.upper(tostring(floor)) or 'LABYRINTH')

	-- Difficulty: drives the red DEATH badge next to the name label.
	-- Empty/missing → 'NORMAL' so legacy saves don't surface the badge.
	if Difficulty then
		local raw = data.Difficulty
		Difficulty:set((typeof(raw) == 'string' and raw ~= '' and raw) or 'NORMAL')
	end
end

----------------------------------------------------------------------
-- Design dimensions (pixels on the 1920x1080 reference canvas).
-- Every Scale value in the file is derived from these constants.
----------------------------------------------------------------------
local DESIGN_SCREEN_W, DESIGN_SCREEN_H = 1920, 1080

-- Vitals block: sigil(78) + gap(18) + info column(816) = 912 wide, 156 tall.
-- Scaled 1.5× from original for improved readability. With the MP row gone
-- the info column has fewer rows; the block height is unchanged so the
-- portrait still gets a generous square area on the left.
local DESIGN_VITALS_W, DESIGN_VITALS_H = 912, 156
local DESIGN_SIGIL                     = 78     -- square
local DESIGN_GAP                       = 18     -- space between sigil and info column
local DESIGN_INFO_W                    = DESIGN_VITALS_W - DESIGN_SIGIL - DESIGN_GAP -- 816

-- Info column internal stack (sums to DESIGN_VITALS_H):
local DESIGN_NAME_H        = 28
local DESIGN_EYEBROW_H     = 16
local DESIGN_ROW_H         = 18    -- vital row box height (bar is smaller, centered)
local DESIGN_INFO_PAD      = 6     -- vertical gap between info rows

-- Within each vital row:
local DESIGN_TAG_W         = 24
local DESIGN_READOUT_W     = 100
local DESIGN_ROW_GAP       = 10    -- gap between tag, bar, readout
local DESIGN_HP_BAR_PX     = 12
local DESIGN_XP_BAR_PX     = 5

-- Level badge: pill on bottom-right of sigil.
local DESIGN_BADGE_W, DESIGN_BADGE_H = 42, 21

-- Currency row (sibling below vitals block):
local DESIGN_CURRENCY_W, DESIGN_CURRENCY_H = DESIGN_VITALS_W, 18
local DESIGN_CURRENCY_GAP = 9      -- gap between vitals block and currency row

-- Anchor position (top-left corner of vitals block, in screen-scale).
local ANCHOR_X_SCALE = 20 / DESIGN_SCREEN_W   -- 20 px from left edge at 1920
-- Shift the top-left cluster down 10% so it sits below the Roblox topbar
-- icons (chat / leaderboard / menu) instead of colliding with them.
local ANCHOR_Y_SCALE = 0.1 + 20 / DESIGN_SCREEN_H

----------------------------------------------------------------------
-- Build one HP/MP/XP vitals row: [tag] · [bar] · [readout].
-- Row width = DESIGN_INFO_W, height = DESIGN_ROW_H. Bar height stays pixel-exact.
----------------------------------------------------------------------
local function buildVitalRow(scope, props: {
	Tag: string, Color: Color3, BarHeight: number,
	Value: any, Max: any, Readout: (use: any) -> string,
	LayoutOrder: number,
})
	return scope:New('Frame') {
		Name = props.Tag .. 'Row',
		-- 100% of info-column width; height is row-fraction of info column.
		Size = UDim2.fromScale(1, DESIGN_ROW_H / DESIGN_VITALS_H),
		BackgroundTransparency = 1,
		LayoutOrder = props.LayoutOrder,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				SortOrder = Enum.SortOrder.LayoutOrder,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				Padding = UDim.new(DESIGN_ROW_GAP / DESIGN_INFO_W, 0),
			},
			-- Mono tag (HP / MP / XP).
			scope:New('TextLabel') {
				LayoutOrder = 0,
				Size = UDim2.fromScale(DESIGN_TAG_W / DESIGN_INFO_W, 1),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = props.Tag,
				TextSize = 14,
				TextColor3 = props.Color,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
			-- Bar container: fills the remaining middle space, centers the pixel-exact bar.
			-- Width is derived as (info_w - tag - readout - 2*gap) / info_w.
			scope:New('Frame') {
				Name = 'BarSlot',
				LayoutOrder = 1,
				Size = UDim2.fromScale(
					(DESIGN_INFO_W - DESIGN_TAG_W - DESIGN_READOUT_W - 2 * DESIGN_ROW_GAP) / DESIGN_INFO_W,
					1
				),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					-- Bar wrapper: scale-sized on both axes so the bar scales with
					-- the vitals block instead of staying pixel-fixed. Height is
					-- a fraction of the row (not the whole block) — rows are
					-- DESIGN_ROW_H tall in the design space.
					scope:New('Frame') {
						AnchorPoint = Vector2.new(0, 0.5),
						Position = UDim2.fromScale(0, 0.5),
						Size = UDim2.fromScale(1, props.BarHeight / DESIGN_ROW_H),
						BackgroundTransparency = 1,
						[Fusion.Children] = {
							HUDCommon.smoothBar(scope, {
								Value = props.Value, Max = props.Max,
								Color = props.Color, Height = props.BarHeight,
								FillParent = true,
							}),
						},
					},
				},
			},
			-- Right-aligned numeric readout.
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.fromScale(DESIGN_READOUT_W / DESIGN_INFO_W, 1),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				TextSize = 15,
				TextColor3 = PALETTE.ink,
				Text = scope:Computed(props.Readout),
				TextXAlignment = Enum.TextXAlignment.Right,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
		},
	}
end

----------------------------------------------------------------------
-- Square sigil with level-badge pill. Size derives from parent height.
----------------------------------------------------------------------
local function buildSigil(scope): Frame
	return scope:New('Frame') {
		Name = 'Sigil',
		LayoutOrder = 0,
		-- Height = 100% of vitals block. Aspect 1:1 drives width from that height.
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIAspectRatioConstraint') {
				AspectRatio = 1,
				AspectType = Enum.AspectType.ScaleWithParentSize,
				DominantAxis = Enum.DominantAxis.Height,
			},
			scope:New('UIStroke') {
				Color = PALETTE.accent, Transparency = 0.5, Thickness = 1,
			},
			-- Player thumbnail (rbxthumb://) sits on top; the initial label
			-- only shows when the image hasn't loaded yet (Players service
			-- can take a beat to resolve the URL on first join).
			scope:New('TextLabel') {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = scope:Computed(function(use) return use(PlayerInitial) end),
				TextSize = 32,
				TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextYAlignment = Enum.TextYAlignment.Center,
				Visible = scope:Computed(function(use)
					return use(PortraitImage) == ''
				end),
			},
			scope:New('ImageLabel') {
				Name = 'Portrait',
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ScaleType = Enum.ScaleType.Crop,
				Image = scope:Computed(function(use) return use(PortraitImage) end),
			},
			-- Level badge: 2:1 pill, bottom-right, protruding outside the sigil square.
			-- Size is % of the SIGIL (which is already aspect-locked square), aspect
			-- constraint locks the pill's 2:1 shape regardless of any parent distortion.
			scope:New('Frame') {
				Name = 'LevelBadge',
				AnchorPoint = Vector2.new(1, 1),
				-- Protrude a few pixels past the sigil's bottom-right corner.
				Position = UDim2.new(1, 4, 1, 4),
				Size = UDim2.fromScale(DESIGN_BADGE_W / DESIGN_SIGIL, DESIGN_BADGE_H / DESIGN_SIGIL),
				BackgroundColor3 = PALETTE.bg0,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					scope:New('UIAspectRatioConstraint') {
						AspectRatio = DESIGN_BADGE_W / DESIGN_BADGE_H,
						AspectType = Enum.AspectType.ScaleWithParentSize,
						DominantAxis = Enum.DominantAxis.Width,
					},
					scope:New('UIStroke') {
						Color = PALETTE.accent, Transparency = 0, Thickness = 1,
					},
					scope:New('TextLabel') {
						Size = UDim2.fromScale(1, 1),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = scope:Computed(function(use)
							return string.format('Lvl %d', use(LevelValue) or 1)
						end),
						TextSize = 15,
						TextColor3 = PALETTE.accent,
						TextXAlignment = Enum.TextXAlignment.Center,
						TextYAlignment = Enum.TextYAlignment.Center,
					},
				},
			},
		},
	}
end

----------------------------------------------------------------------
-- Info column: name + eyebrow + HP/MP/XP rows, stacked vertically.
----------------------------------------------------------------------
local function buildInfoColumn(scope): Frame
	return scope:New('Frame') {
		Name = 'Info',
		LayoutOrder = 1,
		-- Width = info fraction of vitals block; height = 100% of block.
		Size = UDim2.fromScale(DESIGN_INFO_W / DESIGN_VITALS_W, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				SortOrder = Enum.SortOrder.LayoutOrder,
				HorizontalAlignment = Enum.HorizontalAlignment.Left,
				-- Scale-padding: gap scales with the info column's height.
				Padding = UDim.new(DESIGN_INFO_PAD / DESIGN_VITALS_H, 0),
			},
			-- Display name.
			scope:New('TextLabel') {
				Name = 'PlayerName',
				LayoutOrder = 0,
				Size = UDim2.fromScale(1, DESIGN_NAME_H / DESIGN_VITALS_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = scope:Computed(function(use)
					return string.upper(use(PlayerName))
				end),
				TextSize = 24,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
				TextStrokeTransparency = 0.7,
				TextStrokeColor3 = PALETTE.bg0,
				-- Difficulty badge — a child of PlayerName so it shares
				-- the row height. AnchorPoint(1, 0.5) + Position(1, 0,
				-- 0.5, 0) parks it at the right edge of the name band,
				-- sitting visually "to the right of the name". Text +
				-- color are looked up in DIFFICULTY_BADGES on every
				-- Difficulty change; NORMAL (or any unmapped value)
				-- leaves the badge Visible=false. Bold weight via a
				-- one-off Font.new at FontWeight.Bold (FONT_DISPLAY is
				-- Regular; we don't mutate the shared font object).
				[Fusion.Children] = {
					scope:New('TextLabel') {
						Name = 'DifficultyBadge',
						AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.fromScale(1, 0.5),
						-- AutomaticSize lets the badge hug the glyph
						-- width so it doesn't collide with long names.
						AutomaticSize = Enum.AutomaticSize.X,
						Size = UDim2.fromScale(0, 1),
						BackgroundTransparency = 1,
						FontFace = Font.new(
							'rbxassetid://12187360881',
							Enum.FontWeight.Bold,
							Enum.FontStyle.Normal
						),
						Text = scope:Computed(function(use)
							local spec = badgeSpecFor(use(Difficulty))
							return spec and spec.Text or ''
						end),
						TextSize = 24,
						TextColor3 = scope:Computed(function(use)
							local spec = badgeSpecFor(use(Difficulty))
							return spec and spec.Color or Color3.new(1, 1, 1)
						end),
						TextXAlignment = Enum.TextXAlignment.Right,
						TextYAlignment = Enum.TextYAlignment.Center,
						TextStrokeTransparency = 0.4,
						TextStrokeColor3 = Color3.new(0, 0, 0),
						Visible = scope:Computed(function(use)
							return badgeSpecFor(use(Difficulty)) ~= nil
						end),
					},
				},
			},
			-- Eyebrow: "FL 74 · LABYRINTH".
			scope:New('TextLabel') {
				Name = 'Eyebrow',
				LayoutOrder = 1,
				Size = UDim2.fromScale(1, DESIGN_EYEBROW_H / DESIGN_VITALS_H),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					return string.format('FL %d · %s', use(LevelValue), use(ZoneValue))
				end),
				TextSize = 14,
				TextColor3 = PALETTE.inkFaint,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
			buildVitalRow(scope, {
				Tag = 'HP', Color = PALETTE.danger, BarHeight = DESIGN_HP_BAR_PX,
				Value = HPValue, Max = HPMax, LayoutOrder = 2,
				Readout = function(use)
					return string.format('%d/%d',
						math.floor((use(HPValue) or 0) + 0.5),
						math.floor((use(HPMax) or 0) + 0.5))
				end,
			}),
			buildVitalRow(scope, {
				Tag = 'XP', Color = PALETTE.gold, BarHeight = DESIGN_XP_BAR_PX,
				Value = XPValue, Max = XPMax, LayoutOrder = 4,
				Readout = function(use)
					local v, m = use(XPValue) or 0, use(XPMax) or 1
					if m <= 1 then return 'MAX' end
					return string.format('%.1f%%', math.clamp(v / m, 0, 1) * 100)
				end,
			}),
		},
	}
end

----------------------------------------------------------------------
-- Root: OnscreenVitals block + Currency row underneath.
----------------------------------------------------------------------
local function buildUI(scope)
	-- Top-level vitals block. Scale-sized from design px / screen px, then
	-- locked to its 304:52 aspect via UIAspectRatioConstraint(FitWithinMaxSize).
	-- On ultrawide the block stays the same shape; on portrait it shrinks
	-- uniformly rather than squashing.
	local vitals = scope:New('Frame') {
		Name = 'OnscreenVitals',
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.fromScale(ANCHOR_X_SCALE, ANCHOR_Y_SCALE),
		Size = UDim2.fromScale(DESIGN_VITALS_W / DESIGN_SCREEN_W, DESIGN_VITALS_H / DESIGN_SCREEN_H),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIAspectRatioConstraint') {
				AspectRatio = DESIGN_VITALS_W / DESIGN_VITALS_H, -- 304 / 52 ≈ 5.846
				AspectType = Enum.AspectType.FitWithinMaxSize,
				DominantAxis = Enum.DominantAxis.Width,
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				SortOrder = Enum.SortOrder.LayoutOrder,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				Padding = UDim.new(DESIGN_GAP / DESIGN_VITALS_W, 0),
			},
			buildSigil(scope),
			buildInfoColumn(scope),
		},
	}
	vitals.Parent = ScreenGui

	-- Currency row sibling, positioned immediately below the vitals block.
	-- Same width/left anchor; aspect-locked so the label keeps its designed
	-- width:height ratio. Y position anchors the vitals block's bottom edge
	-- plus a scaled gap.
	local currencyYScale = ANCHOR_Y_SCALE
		+ (DESIGN_VITALS_H + DESIGN_CURRENCY_GAP) / DESIGN_SCREEN_H
	local currencyRow = scope:New('TextLabel') {
		Name = 'OnscreenCurrency',
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.fromScale(ANCHOR_X_SCALE, currencyYScale),
		Size = UDim2.fromScale(DESIGN_CURRENCY_W / DESIGN_SCREEN_W, DESIGN_CURRENCY_H / DESIGN_SCREEN_H),
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_MONO,
		TextSize = 15,
		TextColor3 = PALETTE.gold,
		Text = scope:Computed(function(use)
			return string.format('\u{25C6} COL  %d', use(CurrencyValue) or 0)
		end),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		[Fusion.Children] = {
			scope:New('UIAspectRatioConstraint') {
				AspectRatio = DESIGN_CURRENCY_W / DESIGN_CURRENCY_H,
				AspectType = Enum.AspectType.FitWithinMaxSize,
				DominantAxis = Enum.DominantAxis.Width,
			},
		},
	}
	currencyRow.Parent = ScreenGui
end

function Module.OpenWidget()
	if Module.IsOpen then return end
	Module.IsOpen = true

	ScreenGui = HUDCommon.ensureScreenGui('HUD_Onscreen', 5)
	RootScope = scoped(Fusion)

	local displayName = LocalPlayer.DisplayName ~= '' and LocalPlayer.DisplayName or LocalPlayer.Name
	PlayerName    = RootScope:Value(displayName)
	PlayerInitial = RootScope:Value(string.upper(string.sub(displayName, 1, 1)))
	-- Roblox `rbxthumb://` URLs render the player's avatar headshot directly
	-- in an ImageLabel; resolution 150x150 is plenty at the sigil's pixel
	-- size (78x78 design). The string is set immediately so Roblox starts
	-- the async fetch right away — the ImageLabel will simply render blank
	-- until the first chunk lands, at which point the initial-label
	-- fallback toggles off via the Visible Computed.
	PortraitImage = RootScope:Value(string.format(
		'rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150', LocalPlayer.UserId
	))
	LevelValue    = RootScope:Value(1)
	ZoneValue     = RootScope:Value('LABYRINTH')
	HPValue       = RootScope:Value(100)
	HPMax         = RootScope:Value(100)
	XPValue       = RootScope:Value(0)
	XPMax         = RootScope:Value(100)
	CurrencyValue = RootScope:Value(0)
	Difficulty    = RootScope:Value('NORMAL')

	buildUI(RootScope)
	Module.UpdateWidget()

	if LocalPlayer.Character then
		task.defer(Module.OnCharacterAdded, LocalPlayer.Character)
	end
end

function Module.CloseWidget()
	if not Module.IsOpen then return end
	Module.IsOpen = false
	if RootScope then doCleanup(RootScope); RootScope = nil end
	if ScreenGui then ScreenGui:Destroy(); ScreenGui = nil end
	if Module.CharacterMaid then Module.CharacterMaid:Cleanup(); Module.CharacterMaid = nil end
end

function Module.OnCharacterAdded(character)
	if not character then return end
	local humanoid = character:WaitForChild('Humanoid', 5) :: Humanoid
	if not humanoid then return end

	if Module.CharacterMaid then Module.CharacterMaid:Cleanup() end
	local maid = MaidClass.New()
	Module.CharacterMaid = maid

	local function syncHealth()
		if not HPValue then return end
		HPValue:set(humanoid.Health)
		HPMax:set(humanoid.MaxHealth)
	end

	maid:Give(humanoid:GetPropertyChangedSignal('Health'):Connect(syncHealth))
	maid:Give(humanoid:GetPropertyChangedSignal('MaxHealth'):Connect(syncHealth))
	maid:Give(humanoid.Died:Connect(syncHealth))
	syncHealth()
end

function Module.Start()
	ReplicatedData.OnUpdated:Connect(function(category, _)
		if category == 'PlayerData' then Module.UpdateWidget() end
	end)

	LocalPlayer:GetAttributeChangedSignal('CurrentFloor'):Connect(Module.UpdateWidget)

	if LocalPlayer.Character then
		task.defer(Module.OnCharacterAdded, LocalPlayer.Character)
	end
	LocalPlayer.CharacterAdded:Connect(Module.OnCharacterAdded)

	HUDCommon.BindLiveTheme(Module)

	task.defer(function()
		Module.OpenWidget()
		Module.UpdateWidget()
	end)
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/TabWidget/init.luau"><![CDATA[-- TabWidget — full-screen menu with aincrad-ui tab set.
-- Tabs: Character / Skills / Inventory / Forge / Social / Quests /
-- Achievements / Boosters / Settings.
-- Visual reference: tmp/aincrad-ui/design-canvas.jsx (tab inventory),
-- tmp/aincrad-ui/tabs.jsx + character.jsx (per-tab layouts).

local ContextActionService = game:GetService('ContextActionService')
local GuiService = game:GetService('GuiService')
local Lighting = game:GetService('Lighting')
local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local scoped = Fusion.scoped
local doCleanup = Fusion.doCleanup
local peek = Fusion.peek

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local LevelGatesClient = LocalModules.Modules.LevelGatesClient
local PALETTE = HUDCommon.PALETTE
local LevelGates = ReplicatedModules.Data.LevelGates

local ReplicatedData = ReplicatedModules.Services.ReplicatedData
local MaidClassModule = ReplicatedModules.Modules.Maid

-- Shared components + state factory.
local Components = require(script:WaitForChild('components'))
local States     = require(script:WaitForChild('states'))

-- // Tab modules //
-- Each tab is a sibling module that exposes `Build(ctx) -> Frame`. The
-- manager hands over a TabContext table carrying cross-tab state (see
-- `Start()` below). All per-tab state is owned inside the tab module.
local CharacterTab  = require(script:WaitForChild('CharacterTab'))
local AttributesTab = require(script:WaitForChild('AttributesTab'))
local SkillsTab     = require(script:WaitForChild('SkillsTab'))
local InventoryTab  = require(script:WaitForChild('InventoryTab'))
-- ToolbarTab module file (kept name to minimize file churn) hosts the
-- "Equip" tab — sub-tabbed hotbar + inventory management surface.
local EquipTab      = require(script:WaitForChild('ToolbarTab'))
local ForgeTab      = require(script:WaitForChild('ForgeTab'))
local SocialTab     = require(script:WaitForChild('SocialTab'))
local QuestsTab     = require(script:WaitForChild('QuestsTab'))
local SettingsTab    = require(script:WaitForChild('SettingsTab'))
local CraftingTab    = require(script:WaitForChild('CraftingTab'))
local AchievementsTab = require(script:WaitForChild('AchievementsTab'))
local BoostersTab    = require(script:WaitForChild('BoostersTab'))
local LeaderboardTab = require(script:WaitForChild('LeaderboardTab'))
-- MountsTab / CompanionsTab / AurasTab are merged into InventoryTab
-- as categories on the rail. Required by InventoryTab.luau directly;
-- not registered as top-level tabs here.

local SystemsContainer = {}

-- // Tabs // --
-- Inventory above Quests above Skills (per request). Other tabs keep
-- their relative position from the original aincrad-ui layout.
local TAB_ORDER = { 'Character', 'Equip', 'Attributes', 'Inventory', 'Quests', 'Skills', 'Crafting', 'Forge', 'Achievements', 'Boosters', 'Leaderboard', 'Social', 'Settings' }

-- Every tab uses the same BLACK DIAMOND glyph now — the character-tab
-- icon is the canonical mark, repeated across the rail for consistency.
-- Keyed by tab name so per-tab overrides remain a one-line change if we
-- want to re-diversify the icons later.
local TAB_GLYPHS = {
	Character  = '◆',
	Equip      = '◆',
	Attributes = '◆',
	Skills     = '◆',
	Inventory  = '◆',
	Crafting   = '◆',
	Forge        = '◆',
	Achievements = '◆',
	Boosters     = '◆',
	Leaderboard  = '◆',
	Social       = '◆',
	Quests       = '◆',
	Settings     = '◆',
}

-- // Module // --
local Module = {}
Module.WidgetMaid = MaidClassModule.New()

local ScreenGui: Frame? = nil
local RootScope = nil
local RootFrame: Frame = nil

-- Fusion Values
local IsOpen            -- bool
local CurrentTab        -- string
local DataVersion       -- int bumped on ReplicatedData update
local PingValue         -- string
local ClockValue        -- string
-- (SelectedInventoryUUID / SelectedInventoryCategory / SelectedInventoryDetailTab
--  / InventoryFilterText moved into TabWidget/InventoryTab.luau — phase 6 split.
--  They were module-wide before because buildInventoryTab + buildInventoryDetail
--  both closed over them; now both live in the same tab module so the state
--  has a proper home.)

local function getPlayerData()
	return ReplicatedData.GetData('PlayerData', false)
end

local function bumpDataVersion()
	if DataVersion then
		DataVersion:set(peek(DataVersion) + 1)
	end
end

-- Presentation primitives (eyebrow / displayTitle / statCard) moved to
-- TabWidget/utils.luau — they were dead in this file after every tab
-- extraction consumed them from the shared module instead.

-- // Shell (top strip + left rail) — menu-shell.jsx port // --
--
-- Layout strategy (see .claude/skills/custom-roblox-ui/SKILL.md §2, §3, §6, §8):
--   * Panel is designed at 1920×1080 and shape-locked via UIAspectRatioConstraint
--     (FitWithinMaxSize) so it stays 16:9 on ultrawide / portrait screens rather
--     than stretching.
--   * Top strip (the "topbar") is Scale-sized as a fraction of panel height;
--     buttons inside stay pixel-exact via Offset so the text never squashes.
--   * Left rail (vertical sub-tab column) is Scale-sized as a fraction of panel
--     width; each rail button is pixel-height + Scale-width.
--   * Close button is pixel-exact, anchored top-right of the topbar with a small
--     inset.
--   * Content area fills below the topbar and to the right of the rail.
--   * Fade in/out via a CanvasGroup wrapper tweening GroupTransparency.

-- Design reference canvas (aincrad-ui mockup is full 1920x1080).
local DESIGN_SCREEN_W, DESIGN_SCREEN_H = 1920, 1080
local DESIGN_PANEL_W, DESIGN_PANEL_H   = DESIGN_SCREEN_W, DESIGN_SCREEN_H

-- Topbar (top strip) and left rail (vertical sub-tab column).
local DESIGN_TOPBAR_H      = 108      -- top strip height (0.1 of 1080)
local DESIGN_TOPBAR_BTN_W  = 120      -- currency / clock / close button column width
local DESIGN_SUBTAB_H      = 38       -- height of each rail (sub-tab) button
local DESIGN_RAIL_W        = 180      -- left rail (vertical sub-tab column) width

-- Padding around content area and close-button.
local DESIGN_CONTENT_PAD   = 16
local DESIGN_CLOSE_BTN_W   = 100
local DESIGN_CLOSE_BTN_H   = 26
local DESIGN_CLOSE_INSET   = 16       -- pixel inset from panel top-right edge

-- Back-compat aliases for existing references further down in this file.
local RAIL_WIDTH = DESIGN_RAIL_W
local TOP_STRIP_HEIGHT = DESIGN_TOPBAR_H

-- Thin top strip: clock/ping left, currency + ESC·CLOSE right.
-- Mockup: menu-shell.jsx lines 22-41 (title omitted per user request).
local function buildTopStrip(scope)
	-- Topbar button column widths stay pixel-exact so text never squashes,
	-- regardless of the panel's aspect-locked scale on this screen.
	local currencyLabel = scope:New('TextLabel') {
		LayoutOrder = 1,
		Size = UDim2.fromOffset(DESIGN_TOPBAR_BTN_W, 24),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		FontFace = HUDCommon.FONT_MONO,
		TextSize = 11,
		TextColor3 = PALETTE.accent,
		Text = scope:Computed(function(use)
			use(DataVersion)
			local data = getPlayerData()
			return string.format('◆ %d COR', (data and data.Currency) or 0)
		end),
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.7, Thickness = 1 },
			scope:New('UIPadding') { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) },
		},
	}

	-- Clock + floor readout. The clock line reads "HH:MM:SS · FL n" so the
	-- floor indicator is part of the same row (matches aincrad reference).
	local clockLabel = scope:New('TextLabel') {
		LayoutOrder = 2,
		Size = UDim2.fromOffset(180, 24),
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_MONO,
		Text = scope:Computed(function(use)
			use(DataVersion)
			local floor = LocalPlayer:GetAttribute('CurrentFloor') or 1
			return string.format(
				'%s · FL %s',
				tostring(use(ClockValue) or '00:00'),
				tostring(floor)
			)
		end),
		TextSize = 11,
		TextColor3 = PALETTE.inkDim,
		TextXAlignment = Enum.TextXAlignment.Right,
	}

	-- Mini inventory slot row — 7 tiny squares + 2 round gem dots.
	-- Pure decoration for now (no backing data); visualizes hotbar filled state.
	local MINI_SLOT_COUNT = 7
	local MINI_FILLED     = 1    -- how many slots are "lit"
	local miniSlots = {}
	for i = 1, MINI_SLOT_COUNT do
		table.insert(miniSlots, scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.fromOffset(16, 16),
			BackgroundColor3 = i <= MINI_FILLED and PALETTE.accent or PALETTE.bg0,
			BackgroundTransparency = i <= MINI_FILLED and 0.35 or 0.55,
			BorderSizePixel = 0,
			[Fusion.Children] = {
				scope:New('UIStroke') {
					Color = PALETTE.accent,
					Transparency = i <= MINI_FILLED and 0.2 or 0.7,
					Thickness = 1,
				},
			},
		})
	end
	-- Two round "gem" indicators at the right end of the strip.
	for i = 1, 2 do
		table.insert(miniSlots, scope:New('Frame') {
			LayoutOrder = MINI_SLOT_COUNT + i,
			Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = PALETTE.accent,
			BackgroundTransparency = 0.55,
			BorderSizePixel = 0,
			[Fusion.Children] = {
				scope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
				scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.2, Thickness = 1 },
			},
		})
	end
	local miniInventoryRow = scope:New('Frame') {
		Name = 'MiniInventory',
		LayoutOrder = 3,
		Size = UDim2.fromOffset(
			(MINI_SLOT_COUNT * 16) + (2 * 14) + ((MINI_SLOT_COUNT + 2 - 1) * 3) + 10,
			24
		),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				Padding = UDim.new(0, 3),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			table.unpack(miniSlots),
		},
	}

	-- Close button — pixel-exact, anchored top-right of the panel with a small
	-- inset. AnchorPoint(1, 0) + Position=(1, -inset, 0, inset) per SKILL §1
	-- "Scale+Offset pairing idiom".
	local closeButton = scope:New('TextButton') {
		Name = 'CloseButton',
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -DESIGN_CLOSE_INSET, 0, (DESIGN_TOPBAR_H - DESIGN_CLOSE_BTN_H) / 2),
		Size = UDim2.fromOffset(DESIGN_CLOSE_BTN_W, DESIGN_CLOSE_BTN_H),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		FontFace = HUDCommon.FONT_BUTTON,
		Text = 'ESC · CLOSE',
		TextSize = 11,
		TextColor3 = PALETTE.ink,
		[Fusion.OnEvent('Activated')] = function() Module.CloseWidget() end,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.5, Thickness = 1 },
		},
	}

	-- Right cluster holds just currency + clock; close button sits outside it
	-- anchored to the panel edge.
	local rightCluster = scope:New('Frame') {
		Name = 'RightCluster',
		AnchorPoint = Vector2.new(1, 0.5),
		-- Inset from right = close-button width + close-inset + gap.
		Position = UDim2.new(1, -(DESIGN_CLOSE_INSET + DESIGN_CLOSE_BTN_W + 12), 0.5, 0),
		Size = UDim2.new(0, 0, 1, -16),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				Padding = UDim.new(0, 12),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- LayoutOrder: currency(1) → clock+FL(2) → mini inv(3). Reading
			-- right-to-left in the rendered strip since the cluster itself is
			-- right-anchored.
			currencyLabel, clockLabel, miniInventoryRow,
		},
	}

	-- Topbar: Scale width of panel, Scale height as fraction of panel height.
	-- Sits pinned to the top of the panel (AnchorPoint 0,0).
	return scope:New('Frame') {
		Name = 'TopStrip',
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.fromScale(0, 0),
		Size = UDim2.new(1, 0, 0.1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			-- bottom border stripe (accent20 per menu-shell.jsx:22)
			scope:New('Frame') {
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.new(0, 0, 1, 0),
				Size = UDim2.new(1, 0, 0, 1),
				BackgroundColor3 = PALETTE.accent,
				BackgroundTransparency = 0.8,
				BorderSizePixel = 0,
			},
			rightCluster,
			closeButton,
		},
	}
end

-- Left rail per menu-shell.jsx lines 46-70: vertical tab buttons. The
-- stripe + glyph + label shape is encapsulated in `components.RailButton`;
-- this loop just hands it each tab's name + active-state Computed.
local function buildLeftRail(scope)
	local buttons = {}
	for i, tabName in TAB_ORDER do
		local isActive = scope:Computed(function(use)
			return use(CurrentTab) == tabName
		end)
		local button = Components.RailButton(scope, {
			isActive = isActive,
			glyph    = TAB_GLYPHS[tabName] or '◆',
			label    = tabName,
			height   = DESIGN_SUBTAB_H,
			-- Shape-lock + scale: rail width DESIGN_RAIL_W, button height
			-- DESIGN_SUBTAB_H → the button + its scaled internals track the
			-- panel instead of staying fixed-pixel.
			aspectRatio = DESIGN_RAIL_W / DESIGN_SUBTAB_H,
			-- Default stripe (5% scale wide) matches the pre-migration behavior.
			onActivate = function() CurrentTab:set(tabName) end,
		})
		button.LayoutOrder = i
		table.insert(buttons, button)
	end

	-- Build-version footer at the bottom of the rail (menu-shell.jsx:67-69).
	local versionFooter = scope:New('TextLabel') {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -16),
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_MONO,
		Text = 'v·0.1.0\nBUILD·BLADEBORNE',
		TextSize = 9,
		TextColor3 = PALETTE.inkFaint,
		TextTransparency = 0.5,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Bottom,
		[Fusion.Children] = {
			scope:New('UIPadding') { PaddingLeft = UDim.new(0, 24) },
		},
	}

	local buttonStack = scope:New('Frame') {
		Size = UDim2.new(1, 0, 1, -36),
		Position = UDim2.fromOffset(0, 18),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 2),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			table.unpack(buttons),
		},
	}

	-- Left rail: Scale-positioned below the topbar, Scale-width as fraction of
	-- panel width, Scale-height as remainder after topbar. Keeps its column
	-- proportion on any screen without squashing rail buttons.
	return scope:New('Frame') {
		Name = 'LeftRail',
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.fromScale(0, DESIGN_TOPBAR_H / DESIGN_PANEL_H),
		Size = UDim2.fromScale(DESIGN_RAIL_W / DESIGN_PANEL_W, 1 - DESIGN_TOPBAR_H / DESIGN_PANEL_H),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			-- Right border separator (accent20).
			scope:New('Frame') {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, 0, 0, 0),
				Size = UDim2.new(0, 1, 1, 0),
				BackgroundColor3 = PALETTE.accent,
				BackgroundTransparency = 0.8,
				BorderSizePixel = 0,
			},
			buttonStack,
			versionFooter,
		},
	}
end



-- // Content switcher // --

local function buildContent(scope)
	-- Content area fills the panel below the topbar and to the right of the
	-- left rail. Scale-sized so it tracks the panel's aspect-locked bounds.
	-- UIPadding gives the content column breathing room regardless of screen.
	local content = scope:New('Frame') {
		Name = 'Content',
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.fromScale(DESIGN_RAIL_W / DESIGN_PANEL_W, DESIGN_TOPBAR_H / DESIGN_PANEL_H),
		Size = UDim2.fromScale(
			1 - DESIGN_RAIL_W / DESIGN_PANEL_W,
			1 - DESIGN_TOPBAR_H / DESIGN_PANEL_H
		),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(0, DESIGN_CONTENT_PAD),
				PaddingBottom = UDim.new(0, DESIGN_CONTENT_PAD),
				PaddingLeft   = UDim.new(0, DESIGN_CONTENT_PAD),
				PaddingRight  = UDim.new(0, DESIGN_CONTENT_PAD),
			},
		},
	}

	-- TabContext handed to each split-out tab module. Expanded gradually as
	-- more tabs are extracted — today only SettingsTab + ForgeTab read it,
	-- and both only need `ctx.scope`. Remaining tabs (still inline below)
	-- continue to close over the module-level upvalues directly.
	local tabContext = {
		scope       = scope,
		IsOpen      = IsOpen,
		CurrentTab  = CurrentTab,
		DataVersion = DataVersion,
	}

	local children = {
		Character  = CharacterTab.Build(tabContext),
		Equip      = EquipTab.Build(tabContext),
		Attributes = AttributesTab.Build(tabContext),
		Skills     = SkillsTab.Build(tabContext),
		Inventory  = InventoryTab.Build(tabContext),
		Crafting   = CraftingTab.Build(tabContext),
		Forge        = ForgeTab.Build(tabContext),
		Achievements = AchievementsTab.Build(tabContext),
		Boosters     = BoostersTab.Build(tabContext),
		Leaderboard  = LeaderboardTab.Build(tabContext),
		Social       = SocialTab.Build(tabContext),
		Quests       = QuestsTab.Build(tabContext),
		Settings     = SettingsTab.Build(tabContext),
	}

	-- Tab → LevelGate system mapping. Each named tab corresponds to a
	-- gated system from LevelGates.Systems; tabs not in this map
	-- render unconditionally. Adding a new gated tab is one line here
	-- plus the registry entry in Data/LevelGates.luau.
	local TAB_TO_GATED_SYSTEM: {[string]: string} = {
		Skills   = LevelGates.Systems.Skills,
		Crafting = LevelGates.Systems.Crafting,
		Forge    = LevelGates.Systems.Forge,
	}

	-- Build a lock overlay for the tab and parent it inside the tab's
	-- frame at high ZIndex. The overlay is a TextButton (full-size +
	-- AutoButtonColor=false) so it transparently swallows clicks to
	-- everything beneath — child buttons stop reacting while the
	-- overlay is up. Visibility is bound to a Computed that re-reads
	-- LevelGates.CanUseSystem on every DataVersion bump (player
	-- levels up → overlay disappears) and global-bypass change.
	local function attachLockOverlay(tabFrame: Instance, systemId: string)
		-- Centered chiseled "LOCKED" panel inside the tab. Smaller than
		-- the standalone LevelLockOverlay since the parent tab already
		-- has the panel chrome — this is just an in-tab badge.
		local label = LevelGates.GetDisplayLabel(systemId)
		local required = LevelGates.GetRequiredLevel(systemId)

		-- Computed: true when this tab is currently locked.
		local isLocked = scope:Computed(function(use)
			use(DataVersion)
			local saveData = ReplicatedData.GetData('PlayerData', false)
			local globalBypass = LevelGatesClient.GetGlobalBypass()
			return not LevelGates.CanUseSystem(saveData, systemId, globalBypass)
		end)

		-- Live "current level" text (re-evaluates on each DataVersion bump).
		local currentLevelText = scope:Computed(function(use)
			use(DataVersion)
			local saveData = ReplicatedData.GetData('PlayerData', false)
			local lvl = (saveData and tonumber(saveData.Level)) or 1
			return string.format('Requires character level %d. You are level %d.', required, lvl)
		end)

		scope:New('TextButton') {
			Name = 'TabLockOverlay',
			Size = UDim2.fromScale(1, 1),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.45,
			BorderSizePixel = 0,
			Text = '',  -- click-eater button; visible content is the panel below
			AutoButtonColor = false,
			ZIndex = 50,  -- above any tab content
			Visible = isLocked,
			Active = true,
			Parent = tabFrame,
			[Fusion.Children] = {
				-- Centered "LOCKED · System · level info" badge.
				HUDCommon.chiseledPanel(scope, {
					Name = 'LockBadge',
					Size = UDim2.fromScale(0.45, 0.30),
					Position = UDim2.fromScale(0.5, 0.5),
					AnchorPoint = Vector2.new(0.5, 0.5),
					AccentColor = PALETTE.gold,
					BackgroundTransparency = 0.05,
					Children = {
						scope:New('UIPadding') {
							PaddingTop    = UDim.new(0.08, 0),
							PaddingBottom = UDim.new(0.08, 0),
							PaddingLeft   = UDim.new(0.08, 0),
							PaddingRight  = UDim.new(0.08, 0),
						},
						scope:New('TextLabel') {
							Position = UDim2.fromScale(0, 0),
							Size = UDim2.fromScale(1, 0.18),
							BackgroundTransparency = 1,
							FontFace = HUDCommon.FONT_MONO,
							Text = '◆ LOCKED',
							TextScaled = true,
							TextColor3 = PALETTE.gold,
							TextXAlignment = Enum.TextXAlignment.Left,
						},
						scope:New('TextLabel') {
							Position = UDim2.fromScale(0, 0.22),
							Size = UDim2.fromScale(1, 0.36),
							BackgroundTransparency = 1,
							FontFace = HUDCommon.FONT_DISPLAY,
							Text = string.upper(label),
							TextScaled = true,
							TextColor3 = PALETTE.gold,
							TextXAlignment = Enum.TextXAlignment.Left,
							-- Shrink TextScaled glyph height via inner
							-- padding (TextScaled fills the rect; padding
							-- the rect down is the standard scale-down
							-- without disabling TextScaled).
							[Fusion.Children] = {
								scope:New('UIPadding') {
									PaddingTop    = UDim.new(0.05, 0),
									PaddingBottom = UDim.new(0.05, 0),
								},
							},
						},
						scope:New('TextLabel') {
							Position = UDim2.fromScale(0, 0.62),
							Size = UDim2.fromScale(1, 0.30),
							BackgroundTransparency = 1,
							FontFace = HUDCommon.FONT_UI,
							Text = currentLevelText,
							TextScaled = true,
							TextColor3 = PALETTE.inkDim,
							TextXAlignment = Enum.TextXAlignment.Left,
							TextWrapped = true,
						},
					},
				}),
			},
		}
	end

	-- Tab design canvas — 1394 × 648 (≈ 2.15:1). Every tab is rendered
	-- inside a UIAspectRatioConstraint locked to this ratio, so each
	-- tab's descendants (which MUST be in scale, not offset) preserve
	-- their proportions on every screen aspect. Without this, mixed
	-- offset/scale sizing like `UDim2.new(1, -768, 1, 0)` desyncs from
	-- the real screen size at any non-design resolution.
	local TAB_DESIGN_W   = 1394
	local TAB_DESIGN_H   = 648
	local TAB_ASPECT     = TAB_DESIGN_W / TAB_DESIGN_H
	for tabName, frame in children do
		-- Center each tab's content column in the fullscreen panel with a max width.
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.Position = UDim2.fromScale(0.5, 0.5)
		frame.Size = UDim2.fromScale(1, 1)
		local sizeConstraint = Instance.new('UISizeConstraint')
		sizeConstraint.MaxSize = Vector2.new(TAB_DESIGN_W, math.huge)
		sizeConstraint.Parent = frame
		-- Aspect-lock the tab to the design canvas. FitWithinMaxSize keeps
		-- the tab fitted to its parent's bounds while preserving 2.15:1 —
		-- so the layout shape is the same on 16:9, 16:10, 21:9, 4:3, etc.
		local aspect = Instance.new('UIAspectRatioConstraint')
		aspect.AspectRatio = TAB_ASPECT
		aspect.AspectType = Enum.AspectType.FitWithinMaxSize
		aspect.DominantAxis = Enum.DominantAxis.Width
		aspect.Parent = frame
		frame.Parent = content
		frame.Visible = false
		-- Bind visibility to CurrentTab
		local capturedName = tabName
		local capturedFrame = frame
		scope:Observer(CurrentTab):onChange(function()
			capturedFrame.Visible = (peek(CurrentTab) == capturedName)
		end)

		-- Level-gate overlay (Skills/Crafting/Forge tabs). Parented
		-- inside the tab's frame; high ZIndex + click-eating TextButton
		-- so the underlying tab content can't be interacted with while
		-- locked. Visibility re-evaluates on DataVersion bumps so the
		-- overlay clears the moment the player crosses the gate.
		local gateSystem = TAB_TO_GATED_SYSTEM[tabName]
		if gateSystem then
			attachLockOverlay(frame, gateSystem)
		end
	end

	-- Initial visibility
	task.defer(function()
		for tabName, frame in children do
			frame.Visible = (peek(CurrentTab) == tabName)
		end
	end)

	return content
end

-- // Lifecycle // --

function Module.IsWidgetOpen(): boolean
	return IsOpen and peek(IsOpen) or false
end

function Module.SelectTopbarTabByName(tabName: string)
	if not table.find(TAB_ORDER, tabName) then
		warn(string.format('TabWidget: unknown tab %s', tostring(tabName)))
		return
	end
	CurrentTab:set(tabName)
	if not Module.IsWidgetOpen() then
		Module.OpenWidget()
	end
end

-- Back-compat shim for any legacy callers that passed in an Instance.
function Module.SelectTopbarTab(tabButton: any)
	if typeof(tabButton) == 'Instance' and tabButton.Name then
		Module.SelectTopbarTabByName(tabButton.Name)
	elseif typeof(tabButton) == 'string' then
		Module.SelectTopbarTabByName(tabButton)
	end
end

function Module.OpenWidget()
	if Module.IsWidgetOpen() then return end
	IsOpen:set(true)
	-- Catch-up bump: data may have changed during the close window
	-- (replication ticks were ignored for performance). One bump on
	-- open so every Computed re-runs against the latest snapshot.
	bumpDataVersion()
end

function Module.CloseWidget()
	if not Module.IsWidgetOpen() then return end
	IsOpen:set(false)
end

-- Build (or rebuild) the shell — Fusion scope, cross-tab state, and the
-- root frame tree. Extracted so `OnPaletteChanged` can tear the shell down
-- and reconstruct it against the new palette without re-binding the
-- one-time keybind / heartbeat / data-listener wiring in `Module.Start`.
local function buildShell()
	local scope = scoped(Fusion)
	RootScope = scope

	-- Cross-tab Fusion Values. Per-tab state (SelectedInventoryUUID etc.)
	-- lives inside its tab module's Build() — anything exported here is
	-- genuinely read by the shell or by two or more tabs.
	local stateValues = States.create(scope)
	IsOpen      = stateValues.IsOpen
	CurrentTab  = stateValues.CurrentTab
	DataVersion = stateValues.DataVersion
	PingValue   = stateValues.PingValue
	ClockValue  = stateValues.ClockValue

	-- Panel fills the screen (Size = fromScale(1,1)) — the chiseled
	-- backdrop already scales with the screen via Scale-based sizing.
	-- No aspect lock and no panel-scoped UIScale.
	-- (Historical context: there used to be a master HUDScale UIScale on
	-- the shared ScreenGui that handled resolution scaling globally.
	-- That system was parked due to bugs; the panel now renders at
	-- engine-natural size and individual descendants are responsible
	-- for their own pixel/scale balance.)
	--
	-- Wrapped in a CanvasGroup (RootFrame below) so we can fade the
	-- whole panel in/out via GroupTransparency rather than per-descendant
	-- transparency (SKILL §7).
	local inner = HUDCommon.chiseledPanel(scope, {
		Name = 'TabInner',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		AccentColor = PALETTE.accent,
		BackgroundTransparency = 0.1,
		Children = {
			buildTopStrip(scope),
			buildLeftRail(scope),
			buildContent(scope),
		},
	})

	-- TabRoot fills the entire screen (no aspect constraint) so the dim
	-- backdrop + inner panel stretch corner-to-corner on every aspect ratio.
	-- Individual inner columns retain their own scale-based sizing.
	RootFrame = scope:New('CanvasGroup') {
		Name = 'TabRoot',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = IsOpen,
		GroupTransparency = scope:Tween(
			scope:Computed(function(use) return use(IsOpen) and 0 or 1 end),
			TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		),
	}
	inner.Parent = RootFrame
	RootFrame.Parent = ScreenGui
end

-- Tear down the shell and rebuild against the current palette, preserving
-- whether the tab is open and which tab is selected. Per-tab Fusion state
-- (filter text, selected inventory uuid, etc.) is owned by each tab's
-- scope and resets on rebuild — acceptable since theme switching is rare.
--
-- The `Rebuilding` guard is defense-in-depth against re-entrant rebuilds:
-- if a tab module's Build() synchronously fires a SettingsRegistry change
-- (or any other path back into ApplyTheme), we'd otherwise call doCleanup
-- on the half-built scope mid-construction and produce poisoned-scope
-- errors. The intentional fix lives at each trigger site; this just stops
-- a future regression from cascading into a hard crash.
local Rebuilding = false
local function rebuildShell()
	if Rebuilding or not RootScope then return end
	Rebuilding = true

	local prevOpen = IsOpen and peek(IsOpen) or false
	local prevTab  = CurrentTab and peek(CurrentTab) or 'Character'

	doCleanup(RootScope); RootScope = nil
	if RootFrame then RootFrame:Destroy(); RootFrame = nil end

	buildShell()

	if CurrentTab then CurrentTab:set(prevTab) end
	if IsOpen then IsOpen:set(prevOpen) end

	Rebuilding = false
end

function Module.Start()
	ScreenGui = HUDCommon.ensureScreenGui('HUD_Tab', 50)

	buildShell()

	-- Ping / clock ticker
	task.spawn(function()
		while true do
			if Module.IsWidgetOpen() and PingValue and ClockValue then
				local ping = math.floor(LocalPlayer:GetNetworkPing() * 1000)
				PingValue:set(string.format('%dms', ping))
				ClockValue:set(string.sub(Lighting.TimeOfDay, 1, 5))
			end
			task.wait(1)
		end
	end)

	-- Data change → bump version so Computed re-evaluates.
	--
	-- Gated on Module.IsWidgetOpen(): when the tab menu is closed, we
	-- skip the bump entirely. Every tab's Computed binds to DataVersion,
	-- so an ungated bump fires N tabs × M Computeds 4×/s on the
	-- ReplicatedData replication cadence — the visible "lag on resize"
	-- scaled with this. When the menu opens, OpenWidget() does one
	-- explicit bump so any tab the user lands on reads the latest snapshot
	-- (covers the case where data changed while closed).
	Module.WidgetMaid:Give(ReplicatedData.OnUpdated:Connect(function(category, _)
		if not Module.IsWidgetOpen() then return end
		-- PlayerData drives every per-tab dataset (inventory, mounts,
		-- companions, currency, equipped, …).
		-- ServerFlags drives the global level-gate bypass map; without
		-- this branch the lock overlays on Skills / Crafting / Forge /
		-- Gems / Enchant tabs don't react to a live bypass toggle —
		-- the `isLocked` Computed inside attachLockOverlay reads
		-- `LevelGatesClient.GetGlobalBypass()` only on DataVersion
		-- changes, so without the bump the overlay stays visible
		-- until the next PlayerData update happens to land.
		if category == 'PlayerData' or category == 'ServerFlags' then
			bumpDataVersion()
		end
	end))

	-- Tab keybind
	ContextActionService:BindAction('TabKeybind', function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			if Module.IsWidgetOpen() then
				Module.CloseWidget()
			else
				Module.OpenWidget()
			end
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.Tab)

	-- Theme switching is now handled in-place by HUDCommon.ApplyTheme,
	-- which walks the master ScreenGui and tweens matching color
	-- properties to the new palette. We no longer rebuild the entire
	-- tab shell on theme change (that path was the source of the
	-- visible lag when picking a theme from the dropdown). `rebuildShell`
	-- is still useful as a defense-in-depth path; if a future palette
	-- change ever requires a structural rebuild, hook it back up here.
end

function Module.Init(otherSystems)
	SystemsContainer = otherSystems
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/TabWidget/AchievementsTab.luau"><![CDATA[-- // TabWidget/AchievementsTab.luau //
-- Two-column achievements screen:
--   left  — category rail (PVE / PVP / Progression / Exploration / Crafting /
--           Social / Misc) with completion-count chips.
--   right — scrolling tile list for the selected category. Each tile shows
--           name, description, progress bar (or unlocked-state for
--           predicate achievements), reward chips, and a Claim button when
--           Completed && !Claimed.
--
-- Data sources:
--   * AchievementsConfig.Achievements — registry; drives display + goals +
--     rewards. Hidden achievements only appear once Completed.
--   * PlayerData.Achievements — server-owned per-id state:
--       { Progress, Completed, CompletedAt, Claimed, BadgeAwarded }.
--
-- Claim flow: tile's Claim button fires AchievementClaimEvent with
-- {Action='Claim', Id=<id>}; AchievementsServer validates state +
-- grants rewards. Server replies via AchievementEvent ('Claimed') which
-- ReplicatedData replication picks up — no local optimistic mutation.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local peek   = Fusion.peek
local AchievementsConfig = ReplicatedModules.Data.Achievements
local RemoteService = ReplicatedModules.Services.RemoteService

local AchievementClaimEvent = RemoteService.GetRemote('AchievementClaimEvent', 'RemoteEvent', false)

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local Utils = require(script.Parent.utils)
local Components = require(script.Parent.components)

local Module = {}

-- Category list — display order on the rail. Mirrors AchievementCategory
-- values; if the config grows new categories, add them here too (the
-- rail won't render them otherwise).
local CATEGORIES: {string} = {
	'PVE', 'PVP', 'Progression', 'Exploration', 'Crafting', 'Social', 'Misc',
}

-- Tier glow colors. Fed into the tile's left stripe so high-tier
-- achievements stand out at a glance.
local TIER_COLORS: {[string]: Color3} = {
	Bronze   = Color3.fromRGB(196, 134, 86),
	Silver   = Color3.fromRGB(196, 204, 220),
	Gold     = Color3.fromRGB(255, 215, 138),
	Platinum = Color3.fromRGB(180, 240, 255),
}

-- Tile design canvas. The tile is shape-locked to TILE_ASPECT (≈9:1) via a
-- UIAspectRatioConstraint, so every interior Position/Size is a pure-scale
-- fraction of these design dimensions instead of pixels — the layout then
-- holds at any resolution (custom-roblox-ui §8 / Pitfall 9). Edit the pixel
-- numbers here; the fractions downstream are all `<px> / TILE_CONTENT_*`.
local TILE_DESIGN_W  = 864
local TILE_DESIGN_H  = 96
local TILE_ASPECT    = TILE_DESIGN_W / TILE_DESIGN_H  -- = 9
-- Inset padding (pixels). Child scale Position/Size resolve against the
-- CONTENT box (tile minus this padding), not the full tile.
local TILE_PAD_L, TILE_PAD_R = 16, 12
local TILE_PAD_T, TILE_PAD_B = 10, 10
local TILE_CONTENT_W = TILE_DESIGN_W - TILE_PAD_L - TILE_PAD_R  -- 836
local TILE_CONTENT_H = TILE_DESIGN_H - TILE_PAD_T - TILE_PAD_B  -- 76

----------------------------------------------------------------------
-- Pure helpers — config + save → render data.
----------------------------------------------------------------------

-- Project the live save entry onto a render struct. Defaults handle
-- the "never seen" case where no entry yet exists.
local function readEntry(saveData, id: string)
	local entries = (saveData and saveData.Achievements) or {}
	local e = entries[id]
	if not e then
		return { Progress = 0, Completed = false, Claimed = false }
	end
	return {
		Progress = e.Progress or 0,
		Completed = e.Completed == true,
		Claimed = e.Claimed == true,
	}
end

-- Reward-chip projection. Matches the QuestsTab shape so we can share
-- the chip-row helper later if we factor it out.
local function rewardChipsFromConfig(rewards): { { name: string, color: Color3 } }
	local out = {}
	if not rewards then return out end
	if rewards.Currency and rewards.Currency > 0 then
		table.insert(out, { name = string.format('%d Cor', rewards.Currency), color = PALETTE.gold })
	end
	if rewards.Experience and rewards.Experience > 0 then
		table.insert(out, { name = string.format('%d XP', rewards.Experience), color = Color3.fromRGB(255, 198, 112) })
	end
	if typeof(rewards.Items) == 'table' then
		for itemId, qty in rewards.Items do
			table.insert(out, { name = string.format('%s × %d', tostring(itemId), tonumber(qty) or 1), color = PALETTE.accent })
		end
	end
	if typeof(rewards.Titles) == 'table' then
		for _, titleId in rewards.Titles do
			table.insert(out, { name = 'Title: ' .. tostring(titleId), color = Color3.fromRGB(200, 157, 255) })
		end
	end
	if typeof(rewards.Boosters) == 'table' then
		for _, b in rewards.Boosters do
			table.insert(out, { name = 'Booster: ' .. tostring(b.Id), color = Color3.fromRGB(140, 240, 200) })
		end
	end
	return out
end

----------------------------------------------------------------------
-- Atom: a single chip (label + outline). Reused for reward chips and
-- the Claim button (which is a chip with an Activated handler).
----------------------------------------------------------------------
local function chip(scope, props: { Text: string, Color: Color3, OnClick: (() -> ())? })
	-- AutoButtonColor only exists on TextButton/ImageButton — Fusion
	-- 0.3 errors with `cannotAssignProperty` if we set it on a TextLabel.
	-- Build the prop table conditionally so labels stay clean.
	local isButton = props.OnClick ~= nil
	local className = isButton and 'TextButton' or 'TextLabel'
	local instProps: {[any]: any} = {
		-- Y fills the (scale-sized) Rewards row so the chip scales with the
		-- tile; X auto-sizes to the text. TextScaled + vertical inner padding
		-- render ≈11 px in the row at design res while tracking resolution.
		-- Horizontal padding stays a fixed 8 px inset — AutomaticSize.X +
		-- scale padding would be circular (custom-roblox-ui Pitfall 1 territory).
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		FontFace = HUDCommon.FONT_MONO,
		Text = props.Text,
		TextScaled = true,
		TextColor3 = props.Color,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = props.Color, Transparency = 0.55, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
				PaddingTop = UDim.new(0.27, 0), PaddingBottom = UDim.new(0.27, 0),
			},
		},
	}
	if isButton then
		instProps.AutoButtonColor = false
	end
	local node = scope:New(className)(instProps)
	if props.OnClick then
		node.Activated:Connect(props.OnClick)
	end
	return node
end

----------------------------------------------------------------------
-- Tile builder. One per achievement. Reads progress/completed/claimed
-- through the cfg + save argument. The right-side action area shows
-- either the progress bar (in-flight), the "UNLOCKED" badge (Completed
-- but config has no rewards or already Claimed), or the Claim button.
----------------------------------------------------------------------
-- `selectedCategory` is the StateObject<string> for the active rail
-- selection. Tiles for non-matching categories render Visible=false so
-- the layout doesn't measure them. Combined with the hidden gate
-- inside this function in a single Computed (mutating Visible after
-- construction breaks Fusion's reactive binding).
local function buildTile(scope, ctx, cfg, selectedCategory)
	-- Per-tile reactive state. Recomputed via the Computed below when
	-- ctx.DataVersion bumps — no manual refresh wiring.
	local stripeColor = (cfg.Tier and TIER_COLORS[cfg.Tier]) or PALETTE.accent

	local stateComp = scope:Computed(function(use)
		use(ctx.DataVersion)  -- subscribe
		local saveData = Utils.getPlayerData()
		return readEntry(saveData, cfg.Id)
	end)

	-- Combined visibility gate: in active category AND (not hidden OR
	-- completed). Mutating Visible after construction breaks the Fusion
	-- binding, so the final boolean is computed in one pass.
	--
	-- Perf: non-hidden tiles' Visible only depends on `selectedCategory`
	-- — they DON'T need to subscribe to DataVersion. Subscribing all 18
	-- tiles to DataVersion produces 18 Computed re-runs every 0.25s
	-- (replication tick), which compounded with the resize layout pass
	-- visibly chugged. Branch by `cfg.Hidden` so only the secret tiles
	-- pay the per-tick cost.
	local visibilityComp
	if cfg.Hidden then
		visibilityComp = scope:Computed(function(use)
			if cfg.Category ~= use(selectedCategory) then return false end
			return use(stateComp).Completed
		end)
	else
		visibilityComp = scope:Computed(function(use)
			return cfg.Category == use(selectedCategory)
		end)
	end

	local progressFraction = scope:Computed(function(use)
		local s = use(stateComp)
		if s.Completed then return 1 end
		if not cfg.Goal or cfg.Goal <= 0 then return 0 end
		return math.clamp(s.Progress / cfg.Goal, 0, 1)
	end)

	local progressText = scope:Computed(function(use)
		local s = use(stateComp)
		if cfg.Goal and cfg.Goal > 0 then
			return string.format('%d / %d', math.min(s.Progress, cfg.Goal), cfg.Goal)
		end
		return s.Completed and 'UNLOCKED' or 'LOCKED'
	end)

	-- Claim button visibility. True only when achievement is Completed,
	-- not yet Claimed, AND there's something to claim.
	local hasRewards = cfg.Rewards ~= nil and (
		   (cfg.Rewards.Currency or 0) > 0
		or (cfg.Rewards.Experience or 0) > 0
		or (cfg.Rewards.Items and next(cfg.Rewards.Items) ~= nil)
		or (cfg.Rewards.Titles and #cfg.Rewards.Titles > 0)
		or (cfg.Rewards.Boosters and #cfg.Rewards.Boosters > 0)
	)
	local showClaim = scope:Computed(function(use)
		local s = use(stateComp)
		return s.Completed and (not s.Claimed) and hasRewards
	end)

	local statusText = scope:Computed(function(use)
		local s = use(stateComp)
		if s.Completed and s.Claimed then return 'CLAIMED' end
		if s.Completed then return hasRewards and 'READY TO CLAIM' or 'UNLOCKED' end
		return 'IN PROGRESS'
	end)

	local statusColor = scope:Computed(function(use)
		local s = use(stateComp)
		if s.Completed and s.Claimed then return PALETTE.inkFaint end
		if s.Completed then return PALETTE.success end
		return PALETTE.inkDim
	end)

	local rewardChildren: {any} = {
		scope:New('UIListLayout') {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 6),
		},
	}
	for _, c in rewardChipsFromConfig(cfg.Rewards) do
		table.insert(rewardChildren, chip(scope, { Text = c.name, Color = c.color }))
	end

	-- Tile is shape-locked to TILE_ASPECT (≈9:1) by the
	-- UIAspectRatioConstraint below, so it keeps its designed proportions at
	-- every resolution instead of going wide-and-thin on ultrawide / tall on
	-- narrow. Size carries the width-fill + a TILE_DESIGN_H height cap; with
	-- FitWithinMaxSize the constraint fits the largest 9:1 box inside those
	-- bounds. All interior Position/Size are pure-scale fractions of the
	-- design canvas (see TILE_* constants) — no fixed-pixel children.
	return scope:New('Frame') {
		Name = 'Tile_' .. cfg.Id,
		Size = UDim2.new(1, 0, 0, TILE_DESIGN_H),
		BackgroundColor3 = PALETTE.bg1,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		LayoutOrder = (cfg.Tier == 'Platinum' and 1) or (cfg.Tier == 'Gold' and 2)
		           or (cfg.Tier == 'Silver' and 3) or (cfg.Tier == 'Bronze' and 4) or 5,
		Visible = visibilityComp,
		[Fusion.Children] = {
			scope:New('UIAspectRatioConstraint') {
				AspectRatio = TILE_ASPECT,
				AspectType = Enum.AspectType.FitWithinMaxSize,
				DominantAxis = Enum.DominantAxis.Width,
			},
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.78, Thickness = 1 },
			-- Tier stripe down the tile's TRUE left edge. It's a direct child
			-- of the unpadded tile, so a pure-scale Position/Size reaches the
			-- real edge and spans full height — UIPadding can't pull it inward
			-- because the padding now lives on the inner 'Content' frame below.
			-- Width stays a 3px offset on purpose: a 3px bar expressed as scale
			-- rounds toward ~0 on a wide tile and disappears (custom-roblox-ui
			-- Pitfall 1).
			scope:New('Frame') {
				Name = 'TierStripe',
				Position = UDim2.fromScale(0, 0),
				Size = UDim2.new(0, 3, 1, 0),
				BackgroundColor3 = stripeColor,
				BorderSizePixel = 0,
			},

			-- Padded content layer. Pure-scale (1, 1) fill that carries the
			-- inset padding so the text / progress bar / rewards sit clear of
			-- the stripe. Everything except the border + stripe lives here.
			scope:New('Frame') {
				Name = 'Content',
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					scope:New('UIPadding') {
						PaddingTop = UDim.new(TILE_PAD_T / TILE_DESIGN_H, 0), PaddingBottom = UDim.new(TILE_PAD_B / TILE_DESIGN_H, 0),
						PaddingLeft = UDim.new(TILE_PAD_L / TILE_DESIGN_W, 0), PaddingRight = UDim.new(TILE_PAD_R / TILE_DESIGN_W, 0),
					},

					-- Header row: name (left 75%) + status pill (right 25%).
					-- Y positions/heights are scale fractions of TILE_CONTENT_H.
					scope:New('TextLabel') {
						Position = UDim2.fromScale(0, 0),
						Size = UDim2.new(0.75, 0, 20 / TILE_CONTENT_H, 0),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_DISPLAY,
						Text = cfg.Display.Name,
						-- TextScaled so the glyph tracks its (scale-sized) rect at
						-- every resolution instead of staying a fixed pixel size.
						-- The inner UIPadding trims TextScaled back to the design
						-- proportion (≈18 px in the 20 px rect) — the same
						-- TextScaled+padding idiom used in TabWidget/init.luau.
						TextScaled = true,
						TextColor3 = PALETTE.ink,
						TextXAlignment = Enum.TextXAlignment.Left,
						[Fusion.Children] = {
							scope:New('UIPadding') {
								PaddingTop = UDim.new(0.05, 0), PaddingBottom = UDim.new(0.05, 0),
							},
						},
					},
					scope:New('TextLabel') {
						Name = 'StatusPill',
						AnchorPoint = Vector2.new(1, 0),
						Position = UDim2.new(1, 0, 2 / TILE_CONTENT_H, 0),
						Size = UDim2.new(0.25, 0, 16 / TILE_CONTENT_H, 0),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = statusText,
						TextScaled = true,  -- ≈11 px in the 16 px rect
						TextColor3 = statusColor,
						TextXAlignment = Enum.TextXAlignment.Right,
						[Fusion.Children] = {
							scope:New('UIPadding') {
								PaddingTop = UDim.new(0.16, 0), PaddingBottom = UDim.new(0.16, 0),
							},
						},
					},

					-- Description (full width).
					scope:New('TextLabel') {
						Position = UDim2.fromScale(0, 24 / TILE_CONTENT_H),
						Size = UDim2.new(1, 0, 14 / TILE_CONTENT_H, 0),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_UI,
						Text = cfg.Display.Description,
						TextScaled = true,  -- ≈12 px in the 14 px rect
						TextColor3 = PALETTE.inkDim,
						TextXAlignment = Enum.TextXAlignment.Left,
						[Fusion.Children] = {
							scope:New('UIPadding') {
								PaddingTop = UDim.new(0.07, 0), PaddingBottom = UDim.new(0.07, 0),
							},
						},
					},

					-- Progress bar — left 78% (leaves a scale gutter for the
					-- progress text on the right).
					scope:New('Frame') {
						Name = 'ProgressTrack',
						Position = UDim2.fromScale(0, 46 / TILE_CONTENT_H),
						Size = UDim2.new(0.78, 0, 6 / TILE_CONTENT_H, 0),
						BackgroundColor3 = PALETTE.bg0,
						BorderSizePixel = 0,
						[Fusion.Children] = {
							scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.85, Thickness = 1 },
							scope:New('Frame') {
								Name = 'Fill',
								Size = scope:Computed(function(use)
									return UDim2.fromScale(use(progressFraction), 1)
								end),
								BackgroundColor3 = stripeColor,
								BorderSizePixel = 0,
							},
						},
					},
					scope:New('TextLabel') {
						AnchorPoint = Vector2.new(1, 0),
						Position = UDim2.new(1, 0, 44 / TILE_CONTENT_H, 0),
						Size = UDim2.new(0.20, 0, 12 / TILE_CONTENT_H, 0),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = progressText,
						TextScaled = true,  -- ≈10 px in the 12 px rect
						TextColor3 = PALETTE.inkDim,
						TextXAlignment = Enum.TextXAlignment.Right,
						[Fusion.Children] = {
							scope:New('UIPadding') {
								PaddingTop = UDim.new(0.083, 0), PaddingBottom = UDim.new(0.083, 0),
							},
						},
					},

					-- Reward chip row — left 78% (claim button takes the right gutter).
					scope:New('Frame') {
						Name = 'Rewards',
						Position = UDim2.fromScale(0, 60 / TILE_CONTENT_H),
						Size = UDim2.new(0.78, 0, 24 / TILE_CONTENT_H, 0),
						BackgroundTransparency = 1,
						[Fusion.Children] = rewardChildren,
					},

					-- Claim button — only mounted when Completed && !Claimed && hasRewards.
					scope:New('TextButton') {
						Name = 'ClaimButton',
						AnchorPoint = Vector2.new(1, 1),
						Position = UDim2.fromScale(1, 1),
						Size = UDim2.new(0.20, 0, 24 / TILE_CONTENT_H, 0),
						BackgroundColor3 = PALETTE.success,
						BackgroundTransparency = 0.15,
						BorderSizePixel = 0,
						FontFace = HUDCommon.FONT_BUTTON,
						Text = 'CLAIM',
						TextScaled = true,  -- ≈12 px in the 24 px button rect
						TextColor3 = PALETTE.bg0,
						AutoButtonColor = true,
						Visible = showClaim,
						[Fusion.Children] = {
							scope:New('UIStroke') { Color = PALETTE.success, Transparency = 0.4, Thickness = 1 },
							scope:New('UIPadding') {
								PaddingTop = UDim.new(0.25, 0), PaddingBottom = UDim.new(0.25, 0),
							},
						},
						[Fusion.OnEvent('Activated')] = function()
							AchievementClaimEvent:FireServer(AchievementsConfig.Actions.Claim, { Id = cfg.Id })
						end,
					},
				},
			},
		},
	}
end

----------------------------------------------------------------------
-- Tab build entry. Returns a Frame ready for the TabWidget shell.
----------------------------------------------------------------------
function Module.Build(ctx)
	-- TabWidget hands every tab a context with `.scope` + `.DataVersion`
	-- (see TabWidget/init.luau:tabContext). The scope is owned by the
	-- shell — instances we create here cascade-clean when the shell scope
	-- tears down on CloseWidget.
	local s = ctx.scope
	assert(s, 'AchievementsTab.Build expects ctx.scope (set by TabWidget).')

	-- Selected category — drives which tiles list is mounted on the right.
	local SelectedCategory = s:Value('PVE')

	-- Per-category accounting in one Computed pass — returns { count,
	-- hasClaimable }. Cheaper than two separate Computeds (single
	-- traversal of the registry) and the pair always changes together
	-- on the same DataVersion bump.
	local function categoryStats(category: string)
		return s:Computed(function(use)
			use(ctx.DataVersion)
			local saveData = Utils.getPlayerData()
			local total = 0
			local completed = 0
			local hasClaimable = false
			for _, cfg in AchievementsConfig.Achievements do
				if cfg.Category ~= category then continue end
				if cfg.Hidden then
					-- Hidden achievements don't contribute to the
					-- denominator until completed (would otherwise leak
					-- the existence of the secret).
					local e = readEntry(saveData, cfg.Id)
					if not e.Completed then continue end
				end
				total += 1
				local entry = readEntry(saveData, cfg.Id)
				if entry.Completed then
					completed += 1
					-- "Claimable" = completed but not yet claimed AND
					-- has at least one reward to grant. Hides the
					-- yellow flag for achievements with no rewards
					-- (their Claim button never appears either).
					if not entry.Claimed and cfg.Rewards ~= nil and (
						   (cfg.Rewards.Currency or 0) > 0
						or (cfg.Rewards.Experience or 0) > 0
						or (cfg.Rewards.Items and next(cfg.Rewards.Items) ~= nil)
						or (cfg.Rewards.Titles and #cfg.Rewards.Titles > 0)
						or (cfg.Rewards.Boosters and #cfg.Rewards.Boosters > 0)
					) then
						hasClaimable = true
					end
				end
			end
			return { count = string.format('%d / %d', completed, total), hasClaimable = hasClaimable }
		end)
	end

	-- Build the rail buttons. Bigger height + wider rail + a yellow-
	-- when-claimable label color so the player can see at a glance
	-- which categories have rewards waiting.
	local railChildren: {any} = {
		s:New('UIListLayout') {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
		},
	}
	for i, category in CATEGORIES do
		local isActive = s:Computed(function(use)
			return use(SelectedCategory) == category
		end)
		local stats = categoryStats(category)
		-- Per-category derivations: count text and the claimable flag
		-- both come from `stats` in a single pass. Two cheap Computeds
		-- below project the named field — no extra DataVersion subs.
		local countText = s:Computed(function(use) return use(stats).count end)
		local claimable = s:Computed(function(use) return use(stats).hasClaimable end)
		-- Label color: gold when claimable; otherwise active=accent or
		-- ink baseline. The default label-color logic in RailButton
		-- only fires when labelColor is nil, so we replicate the
		-- isActive-baseline branch here.
		local labelColor = s:Computed(function(use)
			if use(claimable) then return PALETTE.gold end
			return use(isActive) and PALETTE.accent or PALETTE.ink
		end)
		-- Same for the chip's count color so the X/Y readout matches
		-- the label state.
		local chipColor = s:Computed(function(use)
			if use(claimable) then return PALETTE.gold end
			return PALETTE.inkFaint
		end)
		table.insert(railChildren, Components.RailButton(s, {
			isActive = isActive,
			label = category,
			glyph = '◆',
			chip = { text = countText, color = chipColor, width = 64 },
			onActivate = function() SelectedCategory:set(category) end,
			height = 48,
			-- Shape-lock + scale: rail content width ≈ 0.22·1394 − 12 px padding
			-- ≈ 294 px, height 48 → aspect ≈ 6.14. Button + its scaled internals
			-- now grow with the panel instead of staying fixed-pixel.
			aspectRatio = 294 / 48,
			labelColor = labelColor,
			glyphColor = labelColor,
		}))
	end

	-- Build all tiles for all categories up-front; gate visibility by
	-- comparing each tile's category against SelectedCategory. Cheaper
	-- than rebuilding the children list on every category switch and
	-- the tile count is small (<200 even at long-term scale).
	local tileChildren: {any} = {
		s:New('UIListLayout') {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
		},
		s:New('UIPadding') {
			PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
			PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
		},
	}
	for _, cfg in AchievementsConfig.Achievements do
		table.insert(tileChildren, buildTile(s, ctx, cfg, SelectedCategory))
	end

	-- Outer shell. Both columns are scale-sized so the split survives
	-- the tab's aspect-locked design canvas at any screen resolution.
	-- Rail = 22% (wider; bigger buttons fit comfortably with chip),
	-- list = 76% with a 2% scale gutter via positioning. Rail sits
	-- flush against the left edge per design ask.
	return s:New('Frame') {
		Name = 'AchievementsTab',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			-- Left rail — wider + flush-left.
			s:New('Frame') {
				Name = 'CategoryRail',
				AnchorPoint = Vector2.new(0, 0),
				Position = UDim2.fromScale(0, 0),
				Size = UDim2.fromScale(0.22, 1),
				BackgroundColor3 = PALETTE.bg1,
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					s:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.82, Thickness = 1 },
					s:New('UIPadding') {
						PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 14),
						-- Smaller left pad so labels sit closer to the
						-- left edge ("move to the left").
						PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 8),
					},
					table.unpack(railChildren),
				},
			},
			-- Right scroll list.
			s:New('ScrollingFrame') {
				Name = 'AchievementList',
				Position = UDim2.fromScale(0.24, 0),
				Size = UDim2.fromScale(0.76, 1),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ScrollBarThickness = 4,
				ScrollBarImageColor3 = PALETTE.accent,
				ScrollBarImageTransparency = 0.5,
				CanvasSize = UDim2.fromScale(0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollingDirection = Enum.ScrollingDirection.Y,
				ElasticBehavior = Enum.ElasticBehavior.Never,
				[Fusion.Children] = tileChildren,
			},
		},
	}
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/TabWidget/AttributesTab.luau"><![CDATA[-- // TabWidget/AttributesTab.luau //
-- Grid of every attribute defined in `ReplicatedModules.Data.Attributes`.
-- Each card shows the attribute name, the player's current level / max,
-- the bonus that level grants (via `cfg.GetBonus`), and the XP required
-- for the NEXT level (via `cfg.GetExpForLevel`).
--
-- Data sources:
--   * AttributesConfig.Attributes — `{[id] = AttributeData}`. Drives the
--     full set of cards (the config is the canonical roster — players
--     just have *progress* on this set; they don't gain or lose entries).
--   * PlayerData.Attributes — `{[id] = level}` (per AttributeServer.luau
--     write path). Drives the level / progress readouts. Missing entries
--     are treated as level 0.
--
-- Layout: ScrollingFrame with AutomaticCanvasSize.Y, UIGridLayout cells.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local GuiService = game:GetService('GuiService')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local AttributesConfig = ReplicatedModules.Data.Attributes

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local Utils = require(script.Parent.utils)

local Module = {}

----------------------------------------------------------------------
-- Cell renderer — one card per attribute id.
-- Each cell is reactive: the level / bonus / next-level XP rows are
-- Computeds keyed off `ctx.DataVersion`, so server-driven attribute
-- changes propagate without a tab rebuild.
----------------------------------------------------------------------
local function buildAttributeCard(scope, ctx, attrId: string, attrCfg, hover)
	local DataVersion = ctx.DataVersion
	local HoveredAttributeId = hover.HoveredAttributeId
	local HoverMousePos      = hover.HoverMousePos

	-- Read this attribute's level out of PlayerData on every DataVersion
	-- bump. AttributeServer writes `saveData.Attributes[id] = {Level, Experience}`,
	-- but the old point-spend path could store a bare number — handle both
	-- shapes so a schema in flight doesn't crash the renderer.
	local levelComputed = scope:Computed(function(use)
		use(DataVersion)
		local data = Utils.getPlayerData()
		local entry = data and data.Attributes and data.Attributes[attrId]
		if typeof(entry) == 'number' then return entry end
		if typeof(entry) == 'table' and tonumber(entry.Level) then return entry.Level end
		return 0
	end)

	-- Per-level XP and progress toward the *next* level. The XP-only path
	-- is now the canonical one — read entry.Experience for the bar fill.
	local xpComputed = scope:Computed(function(use)
		use(DataVersion)
		local data = Utils.getPlayerData()
		local entry = data and data.Attributes and data.Attributes[attrId]
		if typeof(entry) == 'table' and tonumber(entry.Experience) then
			return entry.Experience
		end
		return 0
	end)

	local levelText = scope:Computed(function(use)
		return string.format('LV %d / %d', use(levelComputed), attrCfg.MaxLevel or 0)
	end)

	local bonusText = scope:Computed(function(use)
		local lvl = use(levelComputed)
		if typeof(attrCfg.GetBonus) ~= 'function' then return '—' end
		local ok, bonus = pcall(attrCfg.GetBonus, lvl)
		if not ok or bonus == nil then return '—' end
		return string.format('+%s', tostring(bonus))
	end)

	-- Progress fraction for the bar = XP toward the *next* level, since
	-- attributes now grow purely by XP (no point-spend). At max level the
	-- bar is full.
	local progressFrac = scope:Computed(function(use)
		local lvl = use(levelComputed)
		local xp  = use(xpComputed)
		local maxLvl = attrCfg.MaxLevel or 0
		if lvl >= maxLvl then return 1 end
		if typeof(attrCfg.GetExpForLevel) ~= 'function' then return 0 end
		local ok, required = pcall(attrCfg.GetExpForLevel, lvl + 1)
		if not ok or typeof(required) ~= 'number' or required <= 0 then return 0 end
		return math.clamp(xp / required, 0, 1)
	end)

	return scope:New('Frame') {
		Name = 'Attribute_' .. attrId,
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		-- Hover wiring — populates the panel-level HoveredAttributeId so
		-- the shared floating tooltip resolves which description to show.
		-- MouseLeave guards against stale state by only clearing when the
		-- current hover is still us (otherwise a fast diagonal swipe over
		-- another card could leave the tooltip stuck on this one).
		[Fusion.OnEvent('MouseEnter')] = function()
			HoveredAttributeId:set(attrId)
		end,
		[Fusion.OnEvent('MouseMoved')] = function(x: number, y: number)
			HoverMousePos:set(Vector2.new(x, y))
		end,
		[Fusion.OnEvent('MouseLeave')] = function()
			if Fusion.peek(HoveredAttributeId) == attrId then
				HoveredAttributeId:set(nil)
			end
		end,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.6, Thickness = 1 },
			-- Padding in scale so the card breathes proportionally inside
			-- whatever cell the UIGridLayout hands it. The horizontal pad is
			-- a touch larger than the vertical pad — matches the visual
			-- feel of the InventoryTab card baseline. Y total budget:
			-- 0.06 + 0.24 + 0.03 + 0.14 + 0.03 + 0.05 + 0.03 + 0.14 + 0.03
			-- + 0.14 + 0.06 = 0.95 — leaves 5% headroom inside the cell.
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(0.06, 0), PaddingBottom = UDim.new(0.06, 0),
				PaddingLeft   = UDim.new(0.05, 0), PaddingRight  = UDim.new(0.05, 0),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0.03, 0),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- Display name (display font). Promoted to LayoutOrder 1 — the
			-- "◆ ATTRIBUTE" eyebrow is gone (the Attributes tab title above
			-- the grid already says what these are), so the name leads each
			-- card. TextScaled so the name fills the row at any scale.
			scope:New('TextLabel') {
				LayoutOrder = 1,
				Size = UDim2.fromScale(1, 0.24),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_BUTTON,
				Text = attrId,
				TextScaled = true,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
			},
			-- Level row (mono).
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.fromScale(1, 0.14),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = levelText,
				TextScaled = true,
				TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			-- Progress bar.
			scope:New('Frame') {
				LayoutOrder = 3,
				Size = UDim2.fromScale(1, 0.05),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.35,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.7, Thickness = 1 },
					scope:New('Frame') {
						Name = 'Fill',
						Size = scope:Computed(function(use)
							return UDim2.fromScale(use(progressFrac), 1)
						end),
						BackgroundColor3 = PALETTE.accent,
						BorderSizePixel = 0,
					},
				},
			},
			-- Bonus row.
			scope:New('Frame') {
				LayoutOrder = 4,
				Size = UDim2.fromScale(1, 0.14),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0),
						Position = UDim2.fromScale(0, 0),
						Size = UDim2.fromScale(0.5, 1),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = '◆ BONUS',
						TextScaled = true,
						TextColor3 = PALETTE.inkFaint,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					scope:New('TextLabel') {
						AnchorPoint = Vector2.new(1, 0),
						Position = UDim2.fromScale(1, 0),
						Size = UDim2.fromScale(0.5, 1),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = bonusText,
						TextScaled = true,
						TextColor3 = PALETTE.ink,
						TextXAlignment = Enum.TextXAlignment.Right,
					},
				},
			},
			-- Progress row — promoted directly under Bonus now that the
			-- "NEXT LEVEL · NN XP" row is gone. The threshold it conveyed
			-- was already encoded in this row's "current / required XP"
			-- readout, so the row was redundant.
			scope:New('Frame') {
				LayoutOrder = 5,
				Size = UDim2.fromScale(1, 0.14),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0),
						Position = UDim2.fromScale(0, 0),
						Size = UDim2.fromScale(0.5, 1),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = '◆ PROGRESS',
						TextScaled = true,
						TextColor3 = PALETTE.inkFaint,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					scope:New('TextLabel') {
						AnchorPoint = Vector2.new(1, 0),
						Position = UDim2.fromScale(1, 0),
						Size = UDim2.fromScale(0.5, 1),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = scope:Computed(function(use)
							local lvl = use(levelComputed)
							if lvl >= (attrCfg.MaxLevel or 0) then return 'MAX' end
							local xp = use(xpComputed)
							if typeof(attrCfg.GetExpForLevel) ~= 'function' then
								return tostring(xp)
							end
							local ok, required = pcall(attrCfg.GetExpForLevel, lvl + 1)
							if not ok or typeof(required) ~= 'number' then
								return tostring(xp)
							end
							return string.format('%d / %d XP', xp, required)
						end),
						TextScaled = true,
						TextColor3 = PALETTE.ink,
						TextXAlignment = Enum.TextXAlignment.Right,
					},
				},
			},
		},
	}
end

----------------------------------------------------------------------
-- Build(ctx)
----------------------------------------------------------------------
function Module.Build(ctx)
	local scope = ctx.scope
	local DataVersion = ctx.DataVersion

	-- // Tooltip state //
	-- Single shared tooltip — every card writes to these values on hover.
	-- HoveredAttributeId resolves which description the tooltip displays;
	-- HoverMousePos drives its cursor-tracking position. Same pattern as
	-- the InventoryTab forge tooltip (see TabWidget/InventoryTab.luau).
	local HoveredAttributeId = scope:Value(nil :: string?)
	local HoverMousePos      = scope:Value(Vector2.zero)
	local hoverCtx = { HoveredAttributeId = HoveredAttributeId, HoverMousePos = HoverMousePos }

	-- Sort attribute ids alphabetically — `pairs()` order over the config
	-- dict isn't stable, and the user wants a predictable list.
	local sortedIds: {string} = {}
	for id in AttributesConfig.Attributes do
		table.insert(sortedIds, id)
	end
	table.sort(sortedIds)

	-- Build cards once at construction time. The roster is fixed for the
	-- session (config is static), so we don't need a Computed here — just
	-- a vanilla array of children. The reactive bits are inside each card.
	local cards = {}
	for i, attrId in sortedIds do
		local card = buildAttributeCard(scope, ctx, attrId, AttributesConfig.Attributes[attrId], hoverCtx)
		card.LayoutOrder = i
		table.insert(cards, card)
	end

	-- Eyebrow + count line, mirrors the convention used by InventoryTab.
	local headerLine = scope:New('TextLabel') {
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 14),
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_MONO,
		Text = scope:Computed(function(use)
			use(DataVersion)
			local data = Utils.getPlayerData()
			local owned = 0
			if data and typeof(data.Attributes) == 'table' then
				for _ in data.Attributes do owned += 1 end
			end
			return string.format(
				'◆ ATTRIBUTES · %d / %d UNLOCKED',
				owned, #sortedIds
			)
		end),
		TextSize = 11,
		TextColor3 = PALETTE.accent,
		TextXAlignment = Enum.TextXAlignment.Left,
	}

	-- Grid scroll. Fills remaining vertical space below the eyebrow +
	-- title (~64 px combined, mirrors SettingsTab's pattern) so the
	-- ScrollingFrame's frame is FIXED height — necessary for scrolling
	-- to engage when the canvas grows past the visible area. The
	-- previous AutomaticSize.Y on the frame let it grow with its
	-- content, which kept canvas == frame and meant scrolling never
	-- triggered no matter how many cards appeared.
	-- AutomaticCanvasSize.Y = the canvas auto-grows from the
	-- UIGridLayout's natural row count; UIGridLayout drives the wrap +
	-- cell footprint.
	local gridScroll = scope:New('ScrollingFrame') {
		LayoutOrder = 3,
		Size = UDim2.new(1, 0, 1, -64),   -- width fills, height fills below header + title
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.fromScale(0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = PALETTE.accent,
		ScrollBarImageTransparency = 0.4,
		ElasticBehavior = Enum.ElasticBehavior.Never,
		[Fusion.Children] = {
			scope:New('UIPadding') { PaddingRight = UDim.new(0, 6) },
			scope:New('UIGridLayout') {
				CellSize = UDim2.fromOffset(280, 150),
				CellPadding = UDim2.fromOffset(10, 10),
				HorizontalAlignment = Enum.HorizontalAlignment.Left,
				StartCorner = Enum.StartCorner.TopLeft,
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			table.unpack(cards),
		},
	}

	-- // Floating tooltip //
	-- Parented to the master ScreenGui (deferred until after Build returns
	-- — see below). Lives outside the tab's UIListLayout so the explicit
	-- AnchorPoint + Position drive freely. The master ScreenGui has
	-- IgnoreGuiInset = true and the parent container is full-screen at
	-- AbsolutePosition (0, 0), so the position math is just
	-- `mouse - GuiInset + offset` (no parentAbs subtraction).
	--
	-- Size is fixed-pixel so it stays consistent across every screen
	-- resolution; the UIAspectRatioConstraint locks the shape defensively
	-- in case the size is ever switched to Scale-based for HiDPI work.
	-- ZIndex 50 wins paint order under Sibling ZIndexBehavior.
	--
	-- Visibility is also gated on `tooltipFrame.Parent ~= nil`: until the
	-- deferred re-parenting completes the tooltip is detached, and we
	-- don't want to flash the prior parent's content. Once parented to
	-- the ScreenGui this never flips back to nil during the tab's life.
	-- Tooltip bumped from 280×92 → 320×112 so the larger title and body
	-- text don't get cramped or wrap awkwardly. Aspect ratio still locks
	-- the shape on every screen.
	local TOOLTIP_W, TOOLTIP_H = 320, 112
	local tooltipFrame
	tooltipFrame = scope:New('Frame') {
		Name = 'AttributeTooltip',
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		ZIndex = 50,
		AnchorPoint = Vector2.new(0, 0),
		Position = scope:Computed(function(use)
			local mouse = use(HoverMousePos)
			local topbarInset = GuiService:GetGuiInset()
			-- Cursor + small offset so the tooltip floats below-right of
			-- the pointer. Subtract topbar inset because MouseMoved
			-- delivers inset-included coords while the master ScreenGui
			-- (IgnoreGuiInset = true) is inset-excluded.
			local x = mouse.X - topbarInset.X + 14
			local y = mouse.Y - topbarInset.Y + 18
			return UDim2.fromOffset(math.floor(x), math.floor(y))
		end),
		Size = UDim2.fromOffset(TOOLTIP_W, TOOLTIP_H),
		Visible = scope:Computed(function(use)
			return use(HoveredAttributeId) ~= nil
		end),
		[Fusion.Children] = {
			scope:New('UIAspectRatioConstraint') {
				AspectRatio = TOOLTIP_W / TOOLTIP_H,
				AspectType = Enum.AspectType.FitWithinMaxSize,
				DominantAxis = Enum.DominantAxis.Width,
			},
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
				PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 4),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- Title row — the attribute id, in the display font, accent-tinted.
			scope:New('TextLabel') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 22),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_BUTTON,
				Text = scope:Computed(function(use)
					return tostring(use(HoveredAttributeId) or '')
				end),
				TextSize = 17,
				TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			-- Description body — wrapped to the fixed tooltip width.
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 1, -26),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = scope:Computed(function(use)
					local id = use(HoveredAttributeId)
					if not id then return '' end
					local cfg = AttributesConfig.Attributes[id]
					local desc = cfg and cfg.Description
					if typeof(desc) == 'string' and desc ~= '' then
						return desc
					end
					return 'No description available.'
				end),
				TextSize = 14,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
			},
		},
	}

	local root = scope:New('Frame') {
		Name = 'AttributesTab',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, 24), PaddingBottom = UDim.new(0, 24),
				PaddingLeft = UDim.new(0, 32), PaddingRight = UDim.new(0, 32),
			},
			scope:New('UIListLayout') {
				Padding = UDim.new(0, 10),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			headerLine,
			Utils.displayTitle(scope, { Text = 'Attributes', LayoutOrder = 2 }),
			gridScroll,
		},
	}

	-- Parent the tooltip to the master ScreenGui — NOT to the tab root —
	-- so it can move freely with the cursor across the entire screen
	-- regardless of the tab's content layout. Parenting under the tab
	-- root would also drag the tooltip into the root's UIListLayout flow
	-- (UIListLayout positions every child Frame regardless of explicit
	-- AnchorPoint/Position), pinning the tooltip to a single row slot.
	--
	-- Deferred because at this point in Build() the tab Frame has no
	-- parent yet — `init.luau` parents it to the panel content area only
	-- after this function returns. We poll briefly for the ScreenGui
	-- ancestor; once attached, the tooltip lives there for the tab's
	-- lifetime. Cleanup happens automatically when the Fusion scope is
	-- torn down (RootScope:doCleanup destroys every instance it owns).
	task.defer(function()
		local screenGui: Instance? = nil
		for _ = 1, 30 do  -- ~0.5s of frame waits, ample for init.luau parenting
			screenGui = root:FindFirstAncestorOfClass('ScreenGui')
			if screenGui then break end
			task.wait()
		end
		if screenGui then
			tooltipFrame.Parent = screenGui
		elseif root.Parent then
			-- Fall back to the tab root rather than leaving the tooltip
			-- orphaned — at least the description still surfaces, even
			-- if the position will be constrained by UIListLayout.
			tooltipFrame.Parent = root
		end
		-- Otherwise root has been destroyed (e.g. theme rebuild tore down the
		-- old TabWidget scope mid-poll) and Parent is locked at nil; bail
		-- silently. The tooltipFrame was already destroyed with the scope.
	end)

	return root
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/TabWidget/AurasTab.luau"><![CDATA[-- // TabWidget/AurasTab.luau //
-- Aura browser. Two columns: left = anchor filter + owned auras grid,
-- right = selected aura detail + equip/unequip on its anchor.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local peek   = Fusion.peek

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local AurasShared = ReplicatedModules.Services.AurasShared
local AurasConfig = ReplicatedModules.Data.Auras
local Utils = require(script.Parent.utils)

local Module = {}

-- 1394×648 outer canvas, 1330×600 inner after 32/24 UIPadding.
local OUTER_W, OUTER_H   = 1394, 648
local DESIGN_W, DESIGN_H = 1330, 600
local LEFT_COL_PX        = 320
local COL_GAP_PX         = 36

local ANCHORS = { 'all', 'character', 'sword', 'mount' }
local ANCHOR_LABELS = { all = 'All', character = 'Character', sword = 'Sword', mount = 'Mount' }

local function listOwnedAuras(saveData)
	local out = {}
	if typeof(saveData) ~= 'table' then return out end
	local owned = (saveData.Auras and saveData.Auras.Owned) or {}
	for id, _ in owned do
		local cfg = AurasConfig.Auras[id]
		if cfg then table.insert(out, { id = id, cfg = cfg }) end
	end
	table.sort(out, function(a, b)
		return (a.cfg.Display.Name or a.id) < (b.cfg.Display.Name or b.id)
	end)
	return out
end

function Module.Build(ctx)
	local scope = ctx.scope
	local DataVersion = ctx.DataVersion

	local SelectedId = scope:Value(nil :: string?)
	local AnchorFilter = scope:Value('all')

	local chips = {}
	for i, anchor in ANCHORS do
		local isActive = scope:Computed(function(use)
			return use(AnchorFilter) == anchor
		end)
		table.insert(chips, scope:New('TextButton') {
			LayoutOrder = i,
			Size = UDim2.fromOffset(80, 26),
			BackgroundColor3 = scope:Computed(function(use)
				return use(isActive) and PALETTE.accent or PALETTE.bg0
			end),
			BackgroundTransparency = scope:Computed(function(use)
				return use(isActive) and 0.6 or 0.35
			end),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			FontFace = HUDCommon.FONT_MONO,
			Text = ANCHOR_LABELS[anchor],
			TextSize = 11,
			TextColor3 = PALETTE.ink,
			[Fusion.OnEvent('Activated')] = function() AnchorFilter:set(anchor) end,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.5, Thickness = 1 },
			},
		})
	end

	local listChildren = scope:ForPairs(
		scope:Computed(function(use)
			use(DataVersion)
			local list = listOwnedAuras(Utils.getPlayerData())
			local f = use(AnchorFilter)
			local out = {}
			for _, e in list do
				if f == 'all' or e.cfg.Anchor == f then table.insert(out, e) end
			end
			return out
		end),
		function(use, innerScope, idx, entry)
			local isSelected = innerScope:Computed(function(use2)
				return use2(SelectedId) == entry.id
			end)
			return idx, innerScope:New('TextButton') {
				LayoutOrder = idx,
				Size = UDim2.new(1, 0, 0, 50),
				BackgroundColor3 = innerScope:Computed(function(use2)
					return use2(isSelected) and PALETTE.accent or PALETTE.bg0
				end),
				BackgroundTransparency = innerScope:Computed(function(use2)
					return use2(isSelected) and 0.6 or 0.4
				end),
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = '',
				[Fusion.OnEvent('Activated')] = function() SelectedId:set(entry.id) end,
				[Fusion.Children] = {
					innerScope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.55, Thickness = 1 },
					innerScope:New('UIPadding') { PaddingLeft = UDim.new(0, 12) },
					innerScope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0.5),
						Position = UDim2.fromScale(0, 0.32),
						Size = UDim2.new(1, 0, 0, 18),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_DISPLAY,
						Text = entry.cfg.Display.Name or entry.id,
						TextSize = 16, TextColor3 = PALETTE.ink,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					innerScope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0.5),
						Position = UDim2.fromScale(0, 0.74),
						Size = UDim2.new(1, 0, 0, 14),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = string.upper(entry.cfg.Anchor),
						TextSize = 11,
						TextColor3 = PALETTE.violet,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
				},
			}
		end
	)

	local equippedForAnchor = scope:Computed(function(use)
		use(DataVersion)
		local sel = use(SelectedId); if not sel then return nil end
		local cfg = AurasConfig.Auras[sel]; if not cfg then return nil end
		local data = Utils.getPlayerData()
		return AurasShared.GetEquippedForAnchor(data, cfg.Anchor)
	end)

	-- ctx.embedded suppresses outer padding when this tab is embedded
	-- inside InventoryTab (already padded by the host).
	local outerPadding = (not ctx.embedded) and scope:New('UIPadding') {
		PaddingTop    = UDim.new(24 / OUTER_H, 0),
		PaddingBottom = UDim.new(24 / OUTER_H, 0),
		PaddingLeft   = UDim.new(32 / OUTER_W, 0),
		PaddingRight  = UDim.new(32 / OUTER_W, 0),
	} or nil
	return scope:New('Frame') {
		Name = 'AurasTab',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			outerPadding,
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				-- Bumped 16 → 36 so the detail column sits noticeably
				-- inset from the left rail, giving the title + stats
				-- room to breathe instead of crowding the chip strip.
				Padding = UDim.new(COL_GAP_PX / DESIGN_W, 0),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:New('Frame') {
				LayoutOrder = 1,
				Size = UDim2.fromScale(LEFT_COL_PX / DESIGN_W, 1),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding = UDim.new(0, 8),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					Utils.eyebrow(scope, '◆ AURAS', { LayoutOrder = 1 }),
					scope:New('Frame') {
						LayoutOrder = 2,
						Size = UDim2.new(1, 0, 0, 28),
						BackgroundTransparency = 1,
						[Fusion.Children] = {
							scope:New('UIListLayout') {
								FillDirection = Enum.FillDirection.Horizontal,
								Padding = UDim.new(0, 6),
								SortOrder = Enum.SortOrder.LayoutOrder,
							},
							table.unpack(chips),
						},
					},
					scope:New('ScrollingFrame') {
						LayoutOrder = 3,
						Size = UDim2.new(1, 0, 1, -76),
						BackgroundTransparency = 1,
						BorderSizePixel = 0,
						Active = true,
						ScrollBarThickness = 4,
						ScrollBarImageColor3 = PALETTE.accent,
						AutomaticCanvasSize = Enum.AutomaticSize.Y,
						CanvasSize = UDim2.fromOffset(0, 0),
						ElasticBehavior = Enum.ElasticBehavior.Never,
						[Fusion.Children] = {
							scope:New('UIListLayout') {
								FillDirection = Enum.FillDirection.Vertical,
								Padding = UDim.new(0, 6),
								SortOrder = Enum.SortOrder.LayoutOrder,
							},
							listChildren,
						},
					},
				},
			},
			scope:New('Frame') {
				LayoutOrder = 2,
				Size = UDim2.fromScale((DESIGN_W - LEFT_COL_PX - COL_GAP_PX) / DESIGN_W, 1),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding = UDim.new(0, 10),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					Utils.eyebrow(scope, '◆ DETAIL', { LayoutOrder = 1 }),
					scope:New('TextLabel') {
						LayoutOrder = 2,
						Size = UDim2.new(1, 0, 0, 28),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_DISPLAY,
						Text = scope:Computed(function(use)
							local id = use(SelectedId); if not id then return 'No aura selected' end
							local cfg = AurasConfig.Auras[id]
							return cfg and (cfg.Display.Name or id) or '—'
						end),
						TextSize = 22,
						TextColor3 = PALETTE.ink,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					scope:New('TextLabel') {
						LayoutOrder = 3,
						Size = UDim2.new(1, 0, 0, 32),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_UI,
						Text = scope:Computed(function(use)
							local id = use(SelectedId); if not id then return '' end
							local cfg = AurasConfig.Auras[id]
							return cfg and cfg.Display.Description or ''
						end),
						TextSize = 13,
						TextColor3 = PALETTE.inkDim,
						TextXAlignment = Enum.TextXAlignment.Left,
						TextYAlignment = Enum.TextYAlignment.Top,
						TextWrapped = true,
					},
					scope:New('TextButton') {
						LayoutOrder = 4,
						Size = UDim2.fromOffset(200, 36),
						BackgroundColor3 = PALETTE.bg0,
						BackgroundTransparency = 0.25,
						BorderSizePixel = 0,
						AutoButtonColor = false,
						FontFace = HUDCommon.FONT_BUTTON,
						Text = scope:Computed(function(use)
							local id = use(SelectedId); if not id then return 'SELECT AN AURA' end
							return use(equippedForAnchor) == id and 'UNEQUIP' or 'EQUIP'
						end),
						TextSize = 14, TextColor3 = PALETTE.ink,
						[Fusion.OnEvent('Activated')] = function()
							local id = peek(SelectedId); if not id then return end
							local cfg = AurasConfig.Auras[id]; if not cfg then return end
							local Gameplay = require(LocalPlayer:WaitForChild('PlayerScripts')
								:WaitForChild('Core'):WaitForChild('Gameplay'))
							local AurasClient = Gameplay.AurasClient
							if not AurasClient then return end
							-- Server expects an aura ID, not the anchor string.
							-- (Multi-equip allows several auras per anchor, so
							-- the anchor alone wouldn't disambiguate which one
							-- to remove.) Pass the selected id directly.
							if peek(equippedForAnchor) == id then
								AurasClient.AttemptUnequip(id)
							else
								AurasClient.AttemptEquip(id)
							end
						end,
						[Fusion.Children] = {
							scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
						},
					},
				},
			},
		},
	}
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/TabWidget/BoostersTab.luau"><![CDATA[-- // TabWidget/BoostersTab.luau //
-- Two-section booster screen:
--   top    — "Active" list. One row per active stack with a live MM:SS
--             countdown, ticked every second from a shared `now` Value.
--   bottom — "History" list. Aggregate row per booster id ever applied:
--             total active seconds + last-ended timestamp.
--
-- Layout note: all sizes use Scale so descendants proportionally fit
-- the TabWidget shell's aspect-locked 1394×648 design canvas. Mixing
-- `UDim2.new(1, -<px>, 1, 0)` with offset widths breaks at non-design
-- resolutions and forces UIListLayout reflows on every resize — both
-- visible as lag and "scale bugs".
--
-- Update strategy: instead of rebuilding the full child list on every
-- ReplicatedData tick (4×/s), we use `Fusion.ForPairs` keyed by uuid /
-- booster id. ForPairs caches per-key sub-scopes and only recreates
-- instances when a key is added/removed — saving 90%+ of the rebuild
-- cost while the same boosters stay active.

local Players = game:GetService('Players')
local RunService = game:GetService('RunService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local BoostersConfig = ReplicatedModules.Data.Boosters

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local Utils = require(script.Parent.utils)

local Module = {}

-- Pixel chrome heights (inside the aspect-locked tab — these stay
-- roughly stable since the design canvas itself is fixed). Widths use
-- Scale so the columns reflow with the tab.
local ACTIVE_ROW_H  = 64
local HISTORY_ROW_H = 36

----------------------------------------------------------------------
-- Pure helpers.
----------------------------------------------------------------------

local function formatRemaining(secondsRemaining: number, isPermanent: boolean): string
	if isPermanent then return '∞' end
	if secondsRemaining <= 0 then return '00:00' end
	local h = math.floor(secondsRemaining / 3600)
	local m = math.floor((secondsRemaining % 3600) / 60)
	local s = math.floor(secondsRemaining % 60)
	if h >= 99 then return '99:00:00+' end
	if h > 0 then return string.format('%02d:%02d:%02d', h, m, s) end
	return string.format('%02d:%02d', m, s)
end

local KIND_LABEL: {[string]: string} = {
	[BoostersConfig.Kinds.ExperienceMul]    = 'XP',
	[BoostersConfig.Kinds.CurrencyMul]      = 'Cor',
	[BoostersConfig.Kinds.LootQuantityMul]  = 'Loot',
	[BoostersConfig.Kinds.LootRarityBias]   = 'Rare',
	[BoostersConfig.Kinds.DamageOutMul]     = 'Dmg',
	[BoostersConfig.Kinds.DamageInMul]      = 'DR',
	[BoostersConfig.Kinds.WalkSpeedAdd]     = 'WS',
	[BoostersConfig.Kinds.SkillCdrMul]      = 'CDR',
	[BoostersConfig.Kinds.CritChanceAdd]    = 'Crit%',
	[BoostersConfig.Kinds.CritDamageMul]    = 'CritDmg',
	[BoostersConfig.Kinds.AttributeXpMul]   = 'Attr',
	[BoostersConfig.Kinds.CompanionXpMul]   = 'Pet',
	[BoostersConfig.Kinds.ReputationMul]    = 'Rep',
	[BoostersConfig.Kinds.BountyDecayMul]   = 'Bounty',
}

local function formatEffect(eff): string
	local label = KIND_LABEL[eff.Kind] or eff.Kind
	if BoostersConfig.IsAddKind(eff.Kind) then
		local sign = eff.Value >= 0 and '+' or ''
		return string.format('%s%s %s', sign, tostring(eff.Value), label)
	end
	local pct = math.floor((eff.Value - 1) * 100 + 0.5)
	if pct == 0 then return string.format('×%s %s', tostring(eff.Value), label) end
	local sign = pct > 0 and '+' or ''
	return string.format('%s%d%% %s', sign, pct, label)
end

----------------------------------------------------------------------
-- Live read of Active map keyed by uuid → { Id, EndsAt, Source }.
-- Returning the raw save table reference (when valid) is fine because
-- ForPairs only diffs the keys/values it sees — and the per-row scope
-- reads any sub-fields it needs reactively via `now`. We DON'T want
-- to clone here: a fresh table per Computed run would invalidate every
-- ForPairs sub-scope, defeating the cache.
----------------------------------------------------------------------
local function activeMap(saveData): {[string]: any}
	if not saveData or typeof(saveData.Boosters) ~= 'table' then return {} end
	local active = saveData.Boosters.Active
	if typeof(active) ~= 'table' then return {} end
	return active
end

local function historyMap(saveData): {[string]: any}
	if not saveData or typeof(saveData.Boosters) ~= 'table' then return {} end
	local h = saveData.Boosters.History
	if typeof(h) ~= 'table' then return {} end
	return h
end

----------------------------------------------------------------------
-- Atom: effect chip.
----------------------------------------------------------------------
local function chip(scope, props: { Text: string, Color: Color3 })
	return scope:New('TextLabel') {
		Size = UDim2.fromOffset(0, 20),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		FontFace = HUDCommon.FONT_MONO,
		Text = props.Text,
		TextSize = 11,
		TextColor3 = props.Color,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = props.Color, Transparency = 0.55, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
			},
		},
	}
end

----------------------------------------------------------------------
-- Active row builder. Called once per uuid via ForPairs — instances
-- persist across DataVersion bumps. The countdown re-reads `now` and
-- `entry.EndsAt` each second.
----------------------------------------------------------------------
local function buildActiveRow(rowScope, now, ctx, uuid: string)
	-- Read latest cfg + entry fresh inside Computeds so that:
	--   * if the active entry is removed, the row's parent ForPairs
	--     destroys this scope (we never see post-removal state)
	--   * if EndsAt changes (admin extension), the timer follows
	local liveData = rowScope:Computed(function(use)
		use(ctx.DataVersion)
		local saveData = Utils.getPlayerData()
		local map = activeMap(saveData)
		local entry = map[uuid]
		if not entry then return nil end
		local cfg = BoostersConfig.GetBoosterConfig(entry.Id)
		return cfg and { entry = entry, cfg = cfg } or nil
	end)

	local displayColorComp = rowScope:Computed(function(use)
		local d = use(liveData)
		if not d then return PALETTE.accent end
		return (d.cfg.Display and d.cfg.Display.Color) or PALETTE.accent
	end)

	local nameText = rowScope:Computed(function(use)
		local d = use(liveData); if not d then return '' end
		return d.cfg.Display.Name or ''
	end)

	local remainingText = rowScope:Computed(function(use)
		use(now)
		local d = use(liveData); if not d then return '' end
		local isPermanent = d.entry.EndsAt == 0
		local rem = isPermanent and 0 or (d.entry.EndsAt - os.time())
		return formatRemaining(rem, isPermanent)
	end)

	local progressFraction = rowScope:Computed(function(use)
		use(now)
		local d = use(liveData); if not d then return 0 end
		if d.entry.EndsAt == 0 or d.cfg.Duration == 0 then return 1 end
		local rem = d.entry.EndsAt - os.time()
		return math.clamp(rem / d.cfg.Duration, 0, 1)
	end)

	-- Effect chips render by walking cfg.Effects once at row build —
	-- the cfg doesn't mutate, so the chip set is fixed for this uuid's
	-- lifetime. Resolve cfg via the latest liveData snapshot. (If
	-- cfg disappears mid-build, the row is about to be destroyed by
	-- ForPairs anyway.)
	local saveDataNow = Utils.getPlayerData()
	local entryNow = activeMap(saveDataNow)[uuid]
	local cfgNow = entryNow and BoostersConfig.GetBoosterConfig(entryNow.Id)
	local effectChildren: {any} = {
		rowScope:New('UIListLayout') {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 6),
		},
	}
	if cfgNow then
		for _, eff in cfgNow.Effects do
			-- Each chip's color is bound to displayColorComp so a config
			-- swap (rare; e.g. dev edits) updates without rebuild.
			table.insert(effectChildren, rowScope:New('TextLabel') {
				Size = UDim2.fromOffset(0, 20),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
				FontFace = HUDCommon.FONT_MONO,
				Text = formatEffect(eff),
				TextSize = 11,
				TextColor3 = displayColorComp,
				[Fusion.Children] = {
					rowScope:New('UIStroke') {
						Color = displayColorComp,
						Transparency = 0.55, Thickness = 1,
					},
					rowScope:New('UIPadding') {
						PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
					},
				},
			})
		end
	end

	return rowScope:New('Frame') {
		Name = 'Active_' .. uuid,
		-- Width fills parent; height pixel-locked to the design canvas's
		-- chrome height. Tab's UIAspectRatioConstraint scales the canvas.
		Size = UDim2.new(1, 0, 0, ACTIVE_ROW_H),
		BackgroundColor3 = PALETTE.bg1,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			rowScope:New('UIStroke') {
				Color = displayColorComp, Transparency = 0.65, Thickness = 1,
			},
			-- Accent stripe (pixel-thin so it doesn't dominate at small sizes).
			rowScope:New('Frame') {
				Name = 'AccentStripe',
				Size = UDim2.new(0, 3, 1, 0),
				BackgroundColor3 = displayColorComp,
				BorderSizePixel = 0,
			},
			rowScope:New('UIPadding') {
				PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
				PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 12),
			},

			-- Top row: name (scale-width left side) + countdown (scale-width right).
			rowScope:New('TextLabel') {
				Size = UDim2.fromScale(0.7, 0.27),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = nameText,
				TextSize = 14,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextScaled = false,
			},
			rowScope:New('TextLabel') {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.fromScale(1, 0),
				Size = UDim2.fromScale(0.3, 0.27),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = remainingText,
				TextSize = 14,
				TextColor3 = displayColorComp,
				TextXAlignment = Enum.TextXAlignment.Right,
			},

			-- Effect chips — under the name row.
			rowScope:New('Frame') {
				AnchorPoint = Vector2.new(0, 0),
				Position = UDim2.fromScale(0, 0.32),
				Size = UDim2.fromScale(1, 0.4),
				BackgroundTransparency = 1,
				[Fusion.Children] = effectChildren,
			},

			-- Time bar pinned to the bottom edge.
			rowScope:New('Frame') {
				Name = 'TimeTrack',
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.fromScale(0, 1),
				Size = UDim2.new(1, 0, 0, 4),
				BackgroundColor3 = PALETTE.bg0,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					rowScope:New('UIStroke') {
						Color = displayColorComp, Transparency = 0.85, Thickness = 1,
					},
					rowScope:New('Frame') {
						Name = 'Fill',
						Size = rowScope:Computed(function(use)
							return UDim2.fromScale(use(progressFraction), 1)
						end),
						BackgroundColor3 = displayColorComp,
						BorderSizePixel = 0,
					},
				},
			},
		},
	}
end

----------------------------------------------------------------------
-- History row. Static; only its content text re-binds when the per-id
-- aggregate changes via the parent's DataVersion subscription.
----------------------------------------------------------------------
local function buildHistoryRow(rowScope, ctx, boosterId: string)
	local liveAgg = rowScope:Computed(function(use)
		use(ctx.DataVersion)
		local saveData = Utils.getPlayerData()
		local h = historyMap(saveData)[boosterId]
		local cfg = BoostersConfig.GetBoosterConfig(boosterId)
		return { cfg = cfg, hist = h or { TotalSeconds = 0, LastEndedAt = 0 } }
	end)

	local nameText = rowScope:Computed(function(use)
		local a = use(liveAgg)
		return (a.cfg and a.cfg.Display and a.cfg.Display.Name) or boosterId
	end)
	local timeText = rowScope:Computed(function(use)
		local total = use(liveAgg).hist.TotalSeconds or 0
		local hours = total / 3600
		if hours >= 1 then return string.format('%.1f h total', hours) end
		return string.format('%d min total', math.floor(total / 60))
	end)
	local lastText = rowScope:Computed(function(use)
		local last = use(liveAgg).hist.LastEndedAt or 0
		if last <= 0 then return 'Last: —' end
		return 'Last: ' .. os.date('%Y-%m-%d %H:%M', last)
	end)

	return rowScope:New('Frame') {
		Name = 'Hist_' .. boosterId,
		Size = UDim2.new(1, 0, 0, HISTORY_ROW_H),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.4,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			rowScope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.86, Thickness = 1 },
			rowScope:New('UIPadding') {
				PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
				PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
			},
			rowScope:New('TextLabel') {
				Size = UDim2.fromScale(0.5, 1),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = nameText,
				TextSize = 13,
				TextColor3 = PALETTE.inkDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
			rowScope:New('TextLabel') {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.fromScale(1, 0),
				Size = UDim2.fromScale(0.5, 0.5),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = timeText,
				TextSize = 11,
				TextColor3 = PALETTE.inkDim,
				TextXAlignment = Enum.TextXAlignment.Right,
			},
			rowScope:New('TextLabel') {
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.fromScale(1, 1),
				Size = UDim2.fromScale(0.5, 0.5),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = lastText,
				TextSize = 10,
				TextColor3 = PALETTE.inkFaint,
				TextXAlignment = Enum.TextXAlignment.Right,
			},
		},
	}
end

----------------------------------------------------------------------
-- Section header.
----------------------------------------------------------------------
local function sectionHeader(scope, label: string, countComp)
	return scope:New('Frame') {
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('TextLabel') {
				Size = UDim2.fromScale(0.7, 1),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = '◆ ' .. string.upper(label),
				TextSize = 11,
				TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.fromScale(1, 0),
				Size = UDim2.fromScale(0.3, 1),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = countComp,
				TextSize = 11,
				TextColor3 = PALETTE.inkFaint,
				TextXAlignment = Enum.TextXAlignment.Right,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
		},
	}
end

----------------------------------------------------------------------
-- Build entry.
----------------------------------------------------------------------
function Module.Build(ctx)
	local s = ctx.scope
	assert(s, 'BoostersTab.Build expects ctx.scope (set by TabWidget).')

	-- Local 1Hz countdown ticker. RunService.Heartbeat is 60Hz; we cap
	-- to 1Hz so the countdown's per-row Computed only re-runs once per
	-- visible second (clock format is second-resolution anyway).
	local now = s:Value(os.clock())
	local lastTick = os.clock()
	local conn = RunService.Heartbeat:Connect(function()
		local t = os.clock()
		if t - lastTick < 1 then return end
		lastTick = t
		now:set(t)
	end)
	-- Scope cleanup queue takes plain functions; they fire on doCleanup.
	table.insert(s :: any, function() conn:Disconnect() end)

	-- Active "key map" — the map ForPairs reads. We materialize this
	-- as { [uuid] = endsAt } so ForPairs's value-comparison is on a
	-- primitive (number) — the sub-scope only invalidates when EndsAt
	-- actually changes, not on every DataVersion bump that returns the
	-- same booster.
	local activeKeysMap = s:Computed(function(use)
		use(ctx.DataVersion)
		local saveData = Utils.getPlayerData()
		local out = {}
		for uuid, entry in activeMap(saveData) do
			out[uuid] = entry.EndsAt or 0
		end
		return out
	end)

	-- History "key map" — { [boosterId] = LastEndedAt }. Same primitive-
	-- value rationale as above.
	local historyKeysMap = s:Computed(function(use)
		use(ctx.DataVersion)
		local saveData = Utils.getPlayerData()
		local out = {}
		for boosterId, hist in historyMap(saveData) do
			out[boosterId] = hist.LastEndedAt or 0
		end
		return out
	end)

	local activeCount = s:Computed(function(use)
		local m = use(activeKeysMap)
		local n = 0
		for _ in m do n += 1 end
		return string.format('%d active', n)
	end)
	local historyCount = s:Computed(function(use)
		local m = use(historyKeysMap)
		local n = 0
		for _ in m do n += 1 end
		return string.format('%d ever', n)
	end)

	-- Empty-state labels (Visible-bound — no rebuild churn).
	local activeEmpty = s:Computed(function(use)
		for _ in use(activeKeysMap) do return false end
		return true
	end)
	local historyEmpty = s:Computed(function(use)
		for _ in use(historyKeysMap) do return false end
		return true
	end)

	return s:New('Frame') {
		Name = 'BoostersTab',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			s:New('UIPadding') {
				PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
				PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
			},
			s:New('UIListLayout') {
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 8),
			},

			-- ACTIVE.
			s:New('Frame') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 22),
				BackgroundTransparency = 1,
				[Fusion.Children] = { sectionHeader(s, 'Active boosters', activeCount) },
			},
			-- The active section auto-grows on Y. Empty state TextLabel is
			-- a sibling that's only Visible when no rows; the row container
			-- itself is also a sibling, hidden when empty.
			s:New('Frame') {
				LayoutOrder = 2,
				Name = 'ActiveSection',
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					s:New('UIListLayout') {
						SortOrder = Enum.SortOrder.LayoutOrder,
						Padding = UDim.new(0, 6),
					},
					s:New('TextLabel') {
						LayoutOrder = 0,
						Size = UDim2.new(1, 0, 0, 28),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_UI,
						Text = 'No active boosters.',
						TextSize = 13,
						TextColor3 = PALETTE.inkFaint,
						TextXAlignment = Enum.TextXAlignment.Left,
						Visible = activeEmpty,
					},
					s:ForPairs(activeKeysMap, function(use, innerScope, uuid, _endsAt)
						return uuid, buildActiveRow(innerScope, now, ctx, uuid)
					end),
				},
			},

			-- HISTORY.
			s:New('Frame') {
				LayoutOrder = 3,
				Size = UDim2.new(1, 0, 0, 22),
				BackgroundTransparency = 1,
				[Fusion.Children] = { sectionHeader(s, 'Booster inventory', historyCount) },
			},
			s:New('ScrollingFrame') {
				LayoutOrder = 4,
				Name = 'HistorySection',
				-- Width 100% of tab; height fills the remaining tab space
				-- via a flex remainder. Switching from
				-- `UDim2.new(1, 0, 1, -150)` to a scaled remainder removes
				-- the resolution-dependent layout break.
				Size = UDim2.fromScale(1, 0.55),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ScrollBarThickness = 4,
				ScrollBarImageColor3 = PALETTE.accent,
				ScrollBarImageTransparency = 0.5,
				CanvasSize = UDim2.fromScale(0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollingDirection = Enum.ScrollingDirection.Y,
				ElasticBehavior = Enum.ElasticBehavior.Never,
				[Fusion.Children] = {
					s:New('UIListLayout') {
						SortOrder = Enum.SortOrder.LayoutOrder,
						Padding = UDim.new(0, 4),
					},
					s:New('TextLabel') {
						LayoutOrder = 0,
						Size = UDim2.new(1, 0, 0, 24),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_UI,
						Text = 'Booster inventory is empty.',
						TextSize = 12,
						TextColor3 = PALETTE.inkFaint,
						TextXAlignment = Enum.TextXAlignment.Left,
						Visible = historyEmpty,
					},
					s:ForPairs(historyKeysMap, function(use, innerScope, boosterId, _lastEndedAt)
						return boosterId, buildHistoryRow(innerScope, ctx, boosterId)
					end),
				},
			},
		},
	}
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/TabWidget/CharacterTab.luau"><![CDATA[-- // TabWidget/CharacterTab.luau //
-- Three-column character screen: avatar + identity card on the left, attribute
-- grid + equipment grid in the center, resist/titles/record in the right.
--
-- Reference: tmp/aincrad-ui/character.jsx.
-- Data sources:
--   * LocalPlayer.DisplayName — name
--   * PlayerData.Level / .Attributes / .Equipped / .Titles / .Analytics
--   * AttributesConfig.Attributes (Strength / Agility today; others placeholder)
--   * ItemsConfig.Items + Rarities.RarityColors for equipped-gear rendering
--
-- Cross-module deps: passes `ctx.DataVersion` into every Computed so updates
-- from the manager's ReplicatedData listener reach every reactive binding.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local AttributesConfig = ReplicatedModules.Data.Attributes
local ItemsConfig      = ReplicatedModules.Data.Items
local Rarities         = ReplicatedModules.Data.Rarities
local TitlesConfig     = ReplicatedModules.Data.Titles
local CombatUtility    = ReplicatedModules.Utility.CombatUtility
local RemoteService    = ReplicatedModules.Services.RemoteService

local TitleEvent = RemoteService.GetRemote('TitleEvent', 'RemoteEvent', false)

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local ViewportUtility = LocalModules.Utility.Viewport
local PALETTE = HUDCommon.PALETTE

local Utils = require(script.Parent.utils)

local Module = {}

-- Hardcoded resist placeholders — resists aren't in the save template yet.
-- Kept module-level so the colors/names are visible at a glance without
-- unfolding Build(). Reference: tmp/aincrad-ui/character.jsx resist column.
local CHARACTER_RESISTS = {
	{ name = 'Fire',    value = 0, color = Color3.fromRGB(255, 198, 112) },
	{ name = 'Frost',   value = 0, color = Color3.fromRGB(126, 200, 255) },
	{ name = 'Shock',   value = 0, color = Color3.fromRGB(180, 157, 255) },
	{ name = 'Poison',  value = 0, color = Color3.fromRGB(106, 227, 168) },
	{ name = 'Arcane',  value = 0, color = Color3.fromRGB(255, 143, 160) },
}

function Module.Build(ctx)
	local scope = ctx.scope
	local DataVersion = ctx.DataVersion

	local nameLabel = scope:Computed(function(use)
		use(DataVersion)
		return LocalPlayer.DisplayName
	end)
	local classLineLabel = scope:Computed(function(use)
		use(DataVersion)
		local data = Utils.getPlayerData()
		local level = (data and data.Level) or 1
		-- Aincrad-style class line. The weapon-class slug ("DUAL WIELD")
		-- is omitted until weapon-class detection is wired up; a stale
		-- hardcoded slug would mislead players whose loadout differs.
		return string.format('BEATER · LV %d', level)
	end)
	-- Class mastery placeholder — no backing system yet. Shows "Rank S · 94%".
	local masteryFrac = scope:Value(0.94)
	local masteryReadout = scope:Computed(function(use)
		local frac = math.clamp(use(masteryFrac), 0, 1)
		local rank
		if frac >= 0.90 then rank = 'S'
		elseif frac >= 0.75 then rank = 'A'
		elseif frac >= 0.55 then rank = 'B'
		elseif frac >= 0.35 then rank = 'C'
		else rank = 'D' end
		return string.format('Rank %s · %d%%', rank, math.floor(frac * 100))
	end)

	-- Per-stat accent color for the card's underline bar.
	local ATTR_COLORS: { [string]: Color3 } = {
		STR = Color3.fromRGB(255, 169,  98),
		DEX = Color3.fromRGB(106, 227, 168),
		AGI = Color3.fromRGB(126, 200, 255),
		VIT = Color3.fromRGB(255, 109, 144),
		INT = Color3.fromRGB(180, 157, 255),
		LUK = Color3.fromRGB(255, 215, 138),
	}

	-- Canonical 6-stat layout (matches the aincrad reference). `configKey`
	-- resolves to AttributesConfig.Attributes when one exists; missing stats
	-- render as placeholders at level 0.
	local CANONICAL_STATS: { { tag: string, configKey: string?, order: number } } = {
		{ tag = 'STR', configKey = 'Strength', order = 1 },
		{ tag = 'DEX', configKey = nil,        order = 2 },
		{ tag = 'AGI', configKey = 'Agility',  order = 3 },
		{ tag = 'VIT', configKey = nil,        order = 4 },
		{ tag = 'INT', configKey = nil,        order = 5 },
		{ tag = 'LUK', configKey = nil,        order = 6 },
	}

	-- // Attribute grid // — 3-column card layout.
	local attributeList = scope:New('Frame') {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		[Fusion.Children] = {
			scope:New('UIGridLayout') {
				CellSize = UDim2.new(1/3, -6, 0, 86),
				CellPadding = UDim2.fromOffset(8, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
				HorizontalAlignment = Enum.HorizontalAlignment.Left,
			},
			scope:ForPairs(
				scope:Computed(function(use)
					use(DataVersion)
					local data = Utils.getPlayerData()
					local attrs = (AttributesConfig and AttributesConfig.Attributes) or {}
					local out = {}
					for _, spec in CANONICAL_STATS do
						local cfg = spec.configKey and attrs[spec.configKey] or nil
						-- Save entry can be either a bare number (point-spend
						-- shape) or `{Level, Experience}` (XP-grant shape, set
						-- by AttributeServer.IncrementAttributeExperience on
						-- first damage tick). Read both — passing the table
						-- through to `entry.level / entry.max` would crash.
						local entry = (cfg and data and data.Attributes
							and data.Attributes[spec.configKey]) or nil
						local level: number = 0
						if typeof(entry) == 'number' then
							level = entry
						elseif typeof(entry) == 'table' and tonumber(entry.Level) then
							level = entry.Level
						end
						local max = (cfg and cfg.MaxLevel) or 5
						local bonus = 0
						if cfg and cfg.GetBonus then
							local okB, b = pcall(cfg.GetBonus, level)
							if okB and typeof(b) == 'number' then bonus = b end
						end
						table.insert(out, {
							order = spec.order, tag = spec.tag,
							level = level, max = max, bonus = bonus,
						})
					end
					return out
				end),
				function(use, innerScope, _idx, entry)
					local statColor = ATTR_COLORS[entry.tag] or PALETTE.accent
					return entry.tag, innerScope:New('Frame') {
						LayoutOrder = entry.order,
						BackgroundColor3 = Color3.new(0, 0, 0),
						BackgroundTransparency = 0.35,
						BorderSizePixel = 0,
						[Fusion.Children] = {
							innerScope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.78, Thickness = 1 },
							innerScope:New('UIPadding') {
								PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
								PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14),
							},
							innerScope:New('TextLabel') {
								Size = UDim2.fromOffset(60, 16),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_MONO,
								Text = entry.tag, TextSize = 15,
								TextColor3 = PALETTE.inkDim,
								TextXAlignment = Enum.TextXAlignment.Left,
							},
							-- Bonus delta top-right, GREEN (additive bonus).
							innerScope:New('TextLabel') {
								AnchorPoint = Vector2.new(1, 0),
								Position = UDim2.new(1, 0, 0, 0),
								Size = UDim2.fromOffset(80, 16),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_MONO,
								Text = string.format('+%d', entry.bonus),
								TextSize = 15,
								TextColor3 = Color3.fromRGB(106, 227, 168),
								TextXAlignment = Enum.TextXAlignment.Right,
							},
							-- Big level number — display font. Shifted further down
							-- (22 → 26) so it doesn't crowd the upsized tag/bonus
							-- labels above; value sits in the lower half of the
							-- card with the underline bar below.
							innerScope:New('TextLabel') {
								Position = UDim2.fromOffset(0, 26),
								Size = UDim2.new(1, 0, 0, 42),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_DISPLAY,
								Text = tostring(entry.level),
								TextSize = 38,
								TextColor3 = PALETTE.ink,
								TextXAlignment = Enum.TextXAlignment.Left,
								TextYAlignment = Enum.TextYAlignment.Center,
							},
							-- Per-stat colored underline bar.
							innerScope:New('Frame') {
								AnchorPoint = Vector2.new(0, 1),
								Position = UDim2.new(0, 0, 1, -4),
								Size = UDim2.new(1, 0, 0, 2),
								BackgroundColor3 = PALETTE.bg0,
								BackgroundTransparency = 0.5,
								BorderSizePixel = 0,
								[Fusion.Children] = {
									innerScope:New('Frame') {
										Size = UDim2.fromScale(math.clamp(entry.level / entry.max, 0, 1), 1),
										BackgroundColor3 = statColor,
										BorderSizePixel = 0,
									},
								},
							},
						},
					}
				end
			),
		},
	}

	-- Tab design canvas (matches TAB_DESIGN_W/H in TabWidget/init.luau):
	--   1394 × 648, with 32 px L+R + 24 px T+B UIPadding → inner = 1330 × 600.
	-- All sizes/positions in this tab are expressed as scale fractions of
	-- 1330 (X) or 600 (Y), so the tab scales correctly under the root
	-- AspectRatio constraint applied by init.luau's tab mount loop.
	local DESIGN_W      = 1330  -- inner content width (after UIPadding)
	local DESIGN_H      = 600   -- inner content height (after UIPadding)
	local COL_GAP_PX    = 24    -- UIListLayout padding between columns
	local LEFT_COL_PX   = 440
	local RIGHT_COL_PX  = 280

	-- // Left column // — avatar placeholder + identity card.
	local leftColumn = scope:New('Frame') {
		Name = 'LeftColumn',
		LayoutOrder = 1,
		Size = UDim2.fromScale(LEFT_COL_PX / DESIGN_W, 1),  -- = 0.331
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder },
			-- Avatar viewport — clones LocalPlayer.Character into a framed viewport.
			-- ViewportUtility.ClearViewport() destroys every non-Camera child before
			-- inserting the model, so stroke/cornerTicks live in the wrapper Frame
			-- SIBLINGS of the viewport (not as viewport children).
			(function()
				local viewport = scope:New('ViewportFrame') {
					Name = 'AvatarViewport',
					Size = UDim2.fromScale(1, 1),
					BackgroundColor3 = PALETTE.bg0,
					BackgroundTransparency = 0.3,
					BorderSizePixel = 0,
					Ambient = Color3.fromRGB(140, 160, 200),
					LightColor = Color3.fromRGB(255, 255, 255),
					LightDirection = Vector3.new(-0.4, -0.6, -0.8),
				}
				task.defer(function()
					local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
					if not character or not viewport.Parent then return end
					character.Archivable = true
					local clone = character:Clone()
					character.Archivable = false
					local _, size = clone:GetBoundingBox()
					-- Tighter framing (1.55× the longest axis) so the model
					-- fills the larger viewport. Camera sits slightly off
					-- center for a 3/4 view, lower vertical so the face is
					-- in the upper third rather than dead center.
					local distance = math.max(size.X, size.Y, size.Z) * 1.55
					local focus = Vector3.new(0, size.Y * 0.55, 0)
					local cameraPos = Vector3.new(distance * 0.45, focus.Y + 1.4, distance * 0.95)
					ViewportUtility.ClearViewport(viewport)
					ViewportUtility.SetupModelViewport(viewport, clone, CFrame.lookAt(cameraPos, focus), CFrame.new(Vector3.zero, cameraPos))
				end)
				return scope:New('Frame') {
					Name = 'AvatarWrap',
					LayoutOrder = 2,
					-- Fill the leftColumn's remaining vertical space after the
					-- identity card (84 px) + UIListLayout padding (8 px). Was
					-- previously fixed at 440×500, which overflowed the column
					-- on screens where the panel content area was < 592 px tall.
					-- The viewport's camera re-frames the character based on the
					-- runtime size (distance = max(size) * 1.55), so flexing the
					-- wrap height changes the framing distance, not the model size.
					Size = UDim2.new(1, 0, 1, -92),
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					[Fusion.Children] = {
						viewport,
						scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.7, Thickness = 1 },
						HUDCommon.cornerTick(scope, 'tl', PALETTE.accent),
						HUDCommon.cornerTick(scope, 'br', PALETTE.accent),
					},
				}
			end)(),
			-- Identity card: name + class/level + mastery row. LayoutOrder = 1
			-- pins it ABOVE the avatar viewport (LayoutOrder = 2).
			scope:New('Frame') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 84),
				BackgroundColor3 = Color3.new(0, 0, 0),
				BackgroundTransparency = 0.35,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.75, Thickness = 1 },
					scope:New('UIPadding') {
						PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
						PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
					},
					scope:New('UIListLayout') { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder },
					scope:New('TextLabel') {
						LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 24),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_DISPLAY,
						Text = nameLabel,
						TextSize = 22,
						TextColor3 = PALETTE.ink,
						TextXAlignment = Enum.TextXAlignment.Left,
						TextTruncate = Enum.TextTruncate.AtEnd,
					},
					scope:New('TextLabel') {
						LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 12),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = classLineLabel,
						TextSize = 10,
						TextColor3 = PALETTE.inkDim,
						TextTransparency = 0.3,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					-- "Class mastery" row: left label + right rank/percent readout.
					scope:New('Frame') {
						LayoutOrder = 3,
						Size = UDim2.new(1, 0, 0, 14),
						BackgroundTransparency = 1,
						[Fusion.Children] = {
							scope:New('TextLabel') {
								Size = UDim2.new(0.5, 0, 1, 0),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_UI,
								Text = 'Class mastery',
								TextSize = 12,
								TextColor3 = PALETTE.inkDim,
								TextXAlignment = Enum.TextXAlignment.Left,
							},
							scope:New('TextLabel') {
								AnchorPoint = Vector2.new(1, 0),
								Position = UDim2.new(1, 0, 0, 0),
								Size = UDim2.new(0.5, 0, 1, 0),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_MONO,
								Text = masteryReadout,
								TextSize = 11,
								TextColor3 = PALETTE.gold,
								TextXAlignment = Enum.TextXAlignment.Right,
							},
						},
					},
					HUDCommon.smoothBar(scope, {
						LayoutOrder = 4,
						Height = 3,
						Value = masteryFrac,
						Max = 1,
						Color = PALETTE.accent,
					}),
				},
			},
		},
	}

	-- // Center column // — attributes + equipment grids.
	-- EQUIP_SLOT_META drives slot order + display tag + glyph. Slot keys
	-- match the save shape produced by PlayerInventoryServer:
	-- `<index>_<token>` where token is from SLOT_KEY_TOKEN
	-- (Hand→Weapon, Head→Head, Chest→Chest, Legs→Legs, Boots→Boots,
	--  Bracelet, Neck, Ear, Finger, Curio).
	local EQUIP_SLOT_META: { [string]: { tag: string, order: number, glyph: string } } = {
		['1_Weapon']  = { tag = 'L. HAND', order = 1, glyph = '⚔' },
		['2_Weapon']  = { tag = 'R. HAND', order = 2, glyph = '⚔' },
		['1_Head']    = { tag = 'HEAD',    order = 3, glyph = '◎' },
		['1_Chest']   = { tag = 'CHEST',   order = 4, glyph = '⛨' },
		['1_Legs']    = { tag = 'LEGS',    order = 5, glyph = '⛨' },
		['1_Boots']   = { tag = 'BOOTS',   order = 6, glyph = '◢' },
		['1_Bracelet']= { tag = 'BRACELET',order = 7, glyph = '◈' },
		['1_Neck']    = { tag = 'NECK',    order = 8, glyph = '◈' },
		['1_Ear']     = { tag = 'EAR',     order = 9, glyph = '◈' },
		['1_Finger']  = { tag = 'RING',    order = 10, glyph = '◈' },
		['1_Curio']   = { tag = 'CURIO',   order = 11, glyph = '◈' },
	}

	local equipmentGrid = scope:New('Frame') {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 4,
		[Fusion.Children] = {
			scope:New('UIGridLayout') {
				CellSize = UDim2.new(0.5, -3, 0, 72),
				CellPadding = UDim2.fromOffset(6, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
				HorizontalAlignment = Enum.HorizontalAlignment.Left,
			},
			scope:ForPairs(
				scope:Computed(function(use)
					use(DataVersion)
					local data = Utils.getPlayerData()
					local equipped = (data and data.Equipped) or {}
					local out = {}
					for slotKey, meta in EQUIP_SLOT_META do
						local slotData = equipped[slotKey]
						local itemId, rarity, label, statText
						-- PlayerInventoryServer writes lowercase `itemId`
						-- / `uuid`. The legacy uppercase reads still match
						-- some older paths so keep both as fallbacks.
						if typeof(slotData) == 'table' and (slotData.itemId or slotData.ItemId) then
							itemId = slotData.itemId or slotData.ItemId
							local cfg = ItemsConfig.Items[itemId]
							rarity = (cfg and cfg.Rarity) or 1
							label = (cfg and cfg.Display and cfg.Display.Title and cfg.Display.Title.Text) or itemId
							-- Stat readout: SummarizeWeaponStats returns a
							-- {key=string} table. Concatenate the rows that
							-- are most relevant per slot kind: weapons show
							-- Damage/Speed, armor would show Defense once
							-- ArmorData ships. For now only weapon stats
							-- are emitted; non-weapons leave statText nil.
							if cfg then
								local stats = CombatUtility.SummarizeWeaponStats(cfg)
								local parts = {}
								if stats.Damage then table.insert(parts, 'DMG ' .. stats.Damage) end
								if stats.Speed then table.insert(parts, stats.Speed) end
								if stats['Tool Damage'] then table.insert(parts, 'TOOL ' .. stats['Tool Damage']) end
								if stats.Enchants then table.insert(parts, stats.Enchants) end
								if stats.Resonance then table.insert(parts, stats.Resonance) end
								if #parts > 0 then statText = table.concat(parts, ' · ') end
							end
						else
							rarity = 1
							label = '—'
						end
						table.insert(out, {
							order = meta.order, slotKey = slotKey, tag = meta.tag,
							glyph = meta.glyph,
							label = label, rarity = rarity, statText = statText,
						})
					end
					table.sort(out, function(a, b) return a.order < b.order end)
					return out
				end),
				function(use, innerScope, idx, entry)
					local rColor = Rarities.RarityColors[entry.rarity] or PALETTE.ink
					local bonusText = entry.statText or '—'
					return entry.slotKey, innerScope:New('Frame') {
						LayoutOrder = entry.order,
						BackgroundColor3 = Color3.new(0, 0, 0),
						BackgroundTransparency = 0.35,
						BorderSizePixel = 0,
						[Fusion.Children] = {
							innerScope:New('UIStroke') { Color = rColor, Transparency = 0.55, Thickness = 1 },
							innerScope:New('UIPadding') {
								PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
								PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 12),
							},
							innerScope:New('UIListLayout') {
								FillDirection = Enum.FillDirection.Horizontal,
								Padding = UDim.new(0, 12),
								VerticalAlignment = Enum.VerticalAlignment.Center,
								SortOrder = Enum.SortOrder.LayoutOrder,
							},
							-- Rarity-framed icon square.
							innerScope:New('Frame') {
								LayoutOrder = 1,
								Size = UDim2.fromOffset(48, 48),
								BackgroundColor3 = rColor,
								BackgroundTransparency = 0.85,
								BorderSizePixel = 0,
								[Fusion.Children] = {
									innerScope:New('UIStroke') { Color = rColor, Transparency = 0.1, Thickness = 1 },
									innerScope:New('TextLabel') {
										Size = UDim2.fromScale(1, 1),
										BackgroundTransparency = 1,
										FontFace = HUDCommon.FONT_DISPLAY,
										Text = entry.glyph, TextSize = 24,
										TextColor3 = rColor,
									},
								},
							},
							-- Text column: tag · name · bonus.
							innerScope:New('Frame') {
								LayoutOrder = 2,
								Size = UDim2.new(1, -60, 1, 0),
								BackgroundTransparency = 1,
								[Fusion.Children] = {
									innerScope:New('TextLabel') {
										Size = UDim2.new(1, 0, 0, 10),
										BackgroundTransparency = 1,
										FontFace = HUDCommon.FONT_MONO,
										Text = entry.tag,
										TextSize = 9,
										TextColor3 = PALETTE.inkFaint,
										TextXAlignment = Enum.TextXAlignment.Left,
									},
									innerScope:New('TextLabel') {
										Position = UDim2.fromOffset(0, 12),
										Size = UDim2.new(1, 0, 0, 18),
										BackgroundTransparency = 1,
										FontFace = HUDCommon.FONT_DISPLAY,
										Text = entry.label,
										TextSize = 14,
										TextColor3 = rColor,
										TextXAlignment = Enum.TextXAlignment.Left,
										TextTruncate = Enum.TextTruncate.AtEnd,
									},
									innerScope:New('TextLabel') {
										Position = UDim2.fromOffset(0, 32),
										Size = UDim2.new(1, 0, 0, 12),
										BackgroundTransparency = 1,
										FontFace = HUDCommon.FONT_MONO,
										Text = bonusText,
										TextSize = 11,
										TextColor3 = PALETTE.inkDim,
										TextXAlignment = Enum.TextXAlignment.Left,
									},
								},
							},
						},
					}
				end
			),
		},
	}

	local centerColumn = scope:New('Frame') {
		Name = 'CenterColumn',
		LayoutOrder = 2,
		-- Remaining width after left + right + 2 column gaps. Pure scale
		-- so it tracks the parent's runtime size proportionally.
		--   (1330 - 440 - 280 - 2×24) / 1330 = 562 / 1330 = 0.4226
		Size = UDim2.fromScale(
			(DESIGN_W - LEFT_COL_PX - RIGHT_COL_PX - 2 * COL_GAP_PX) / DESIGN_W,
			1
		),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder },
			Utils.eyebrow(scope, '◆ ATTRIBUTES', { LayoutOrder = 1 }),
			attributeList,
			Utils.eyebrow(scope, '◆ EQUIPMENT', { LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 14) }),
			equipmentGrid,
		},
	}

	-- // Right column // — resists + titles + record.
	local resistList = scope:New('Frame') {
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder },
		},
	}
	for i, resist in CHARACTER_RESISTS do
		local _row = scope:New('Frame') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 22),
			BackgroundTransparency = 1,
			Parent = resistList,
			[Fusion.Children] = {
				scope:New('UIListLayout') { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder },
				scope:New('Frame') {
					LayoutOrder = 1,
					Size = UDim2.new(1, 0, 0, 14),
					BackgroundTransparency = 1,
					[Fusion.Children] = {
						scope:New('TextLabel') {
							Size = UDim2.new(0.5, 0, 1, 0),
							BackgroundTransparency = 1,
							FontFace = HUDCommon.FONT_UI,
							Text = string.format('◆ %s', resist.name),
							TextSize = 11,
							TextColor3 = resist.color,
							TextXAlignment = Enum.TextXAlignment.Left,
						},
						scope:New('TextLabel') {
							AnchorPoint = Vector2.new(1, 0),
							Position = UDim2.new(1, 0, 0, 0),
							Size = UDim2.new(0.5, 0, 1, 0),
							BackgroundTransparency = 1,
							FontFace = HUDCommon.FONT_MONO,
							Text = string.format('%d%%', resist.value),
							TextSize = 11,
							TextColor3 = PALETTE.inkDim,
							TextXAlignment = Enum.TextXAlignment.Right,
						},
					},
				},
				HUDCommon.smoothBar(scope, {
					LayoutOrder = 2,
					Height = 2,
					Value = resist.value,
					Max = 100,
					Color = resist.color,
				}),
			},
		}
	end

	-- Title selector — "Selected: <name>" with a click-to-expand dropdown
	-- listing examples. Hardcoded for now ("we'll hook it up later to
	-- player data" per request); the click handler writes a Fusion Value
	-- that's reflected in the header.
	--
	-- Layout strategy (see .claude/skills/custom-roblox-ui/SKILL.md §3):
	-- The selector lives inside the rightColumn (designed at DESIGN_RIGHT_W
	-- pixels wide). Children of the header are scale-1 width inside that,
	-- so per the "scale-sized with percentage padding" idiom we express
	-- horizontal insets as fractions of the column width. Vertical heights
	-- on the header / option / chevron stay pixel — they're pixel-designed
	-- atoms (skill §8 decision tree, "pixel-designed atom" leaf) and would
	-- otherwise need a fixed parent height to scale correctly under the
	-- wrapper's AutomaticSize.Y.
	local DESIGN_RIGHT_W   = 280  -- matches rightColumn pixel width below
	local DESIGN_HEADER_H  = 28
	local DESIGN_OPTION_H  = 22
	local DESIGN_CHEV_W    = 12
	local DESIGN_CHEV_H    = 14
	local DESIGN_PAD_X     = 10   -- horizontal inset inside the header
	local DESIGN_OPT_PAD_X = 10   -- horizontal inset inside option buttons

	-- Active title id from the save struct (or nil for "None"). Sourced
	-- from data.Titles[*].Active so that activation persists across
	-- joins/respawns. Updated reactively by DataVersion.
	local ActiveTitleId = scope:Computed(function(use)
		use(DataVersion)
		local data = Utils.getPlayerData()
		if typeof(data) ~= 'table' or typeof(data.Titles) ~= 'table' then return nil end
		for titleId, entry in data.Titles do
			if typeof(entry) == 'table' and entry.Active == true then
				return tostring(titleId)
			end
		end
		return nil
	end)

	-- Display label for the dropdown header. 'None' when no title active.
	local SelectedTitle = scope:Computed(function(use)
		local id = use(ActiveTitleId)
		if not id then return 'None' end
		local cfg = TitlesConfig.Titles[id]
		return (cfg and cfg.Display and cfg.Display.Name) or id
	end)

	local SelectorOpen = scope:Value(false)

	-- Owned-titles list, computed from save data. Always includes a
	-- synthetic 'None' option at the top so the player can clear their
	-- active title via the dropdown.
	local OwnedTitleOptions = scope:Computed(function(use)
		use(DataVersion)
		local out = { { id = nil :: string?, name = 'None', color = nil :: Color3? } }
		local data = Utils.getPlayerData()
		if typeof(data) == 'table' and typeof(data.Titles) == 'table' then
			for titleId, _entry in data.Titles do
				local cfg = TitlesConfig.Titles[titleId]
				if cfg then
					table.insert(out, {
						id = tostring(titleId),
						name = (cfg.Display and cfg.Display.Name) or tostring(titleId),
						color = cfg.Display and cfg.Display.Color,
					})
				end
			end
		end
		return out
	end)

	local function activateTitle(titleId: string?)
		-- Server validates: must be unlocked + still pass UnlockCheck.
		-- Optimistic UI not needed since SetActive flips the save's
		-- Active flag → ReplicatedData fires DataVersion → both the
		-- header and the preview frame update next frame.
		TitleEvent:FireServer(TitlesConfig.TitleActions.SetActive, titleId)
		SelectorOpen:set(false)
	end
	local titleSelector = scope:New('Frame') {
		LayoutOrder = 4,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder },
			-- Header: "Selected: <name>" + chevron. Clicking toggles dropdown.
			scope:New('TextButton') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, DESIGN_HEADER_H),
				BackgroundColor3 = Color3.new(0, 0, 0),
				BackgroundTransparency = 0.35,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = '',
				[Fusion.OnEvent('Activated')] = function()
					SelectorOpen:set(not Fusion.peek(SelectorOpen))
				end,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.7, Thickness = 1 },
					-- Scale-based horizontal padding (skill §3 idiom #2):
					-- inset is proportional to the column width so it
					-- holds visual weight at any UIScale.
					scope:New('UIPadding') {
						PaddingLeft  = UDim.new(DESIGN_PAD_X / DESIGN_RIGHT_W, 0),
						PaddingRight = UDim.new(DESIGN_PAD_X / DESIGN_RIGHT_W, 0),
					},
					scope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0.5),
						Position = UDim2.fromScale(0, 0.5),
						-- Scale-based reservation for the chevron column at
						-- the right (chevron width + gap as a fraction of
						-- the column). Avoids the previous mixed-mode
						-- `(1, -16, 1, 0)` pixel inset.
						Size = UDim2.fromScale(1 - (DESIGN_CHEV_W + 4) / DESIGN_RIGHT_W, 1),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_UI,
						Text = scope:Computed(function(use)
							return string.format('Selected: %s', tostring(use(SelectedTitle)))
						end),
						TextSize = 12,
						TextColor3 = PALETTE.ink,
						TextXAlignment = Enum.TextXAlignment.Left,
						TextTruncate = Enum.TextTruncate.AtEnd,
					},
					scope:New('TextLabel') {
						AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.fromScale(1, 0.5),
						-- Chevron is a pixel-designed glyph (skill §8
						-- decision tree leaf). Pixel size keeps the arrow
						-- crisp at typical UIScale.
						Size = UDim2.fromOffset(DESIGN_CHEV_W, DESIGN_CHEV_H),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = scope:Computed(function(use)
							return use(SelectorOpen) and '\u{25B2}' or '\u{25BC}'
						end),
						TextSize = 9,
						TextColor3 = PALETTE.accent,
						TextXAlignment = Enum.TextXAlignment.Right,
					},
				},
			},
			-- Options list — ScrollingFrame with AutomaticCanvasSize.Y so
			-- the canvas tracks the dynamic owned-titles list without
			-- a manual canvasH calculation. Visible height is capped to
			-- 6 rows; longer lists scroll. The visible-height clamp is
			-- a bound from SELECTOR_MAX_VISIBLE because we DON'T want
			-- the picker to grow indefinitely on a player with 30+
			-- titles unlocked.
			(function()
				local SELECTOR_MAX_VISIBLE = 6
				return scope:New('ScrollingFrame') {
					Name = 'TitleOptions',
					LayoutOrder = 2,
					-- Visible height is dynamic too: clamp(#options, 1, max) rows.
					Size = scope:Computed(function(use)
						local count = #use(OwnedTitleOptions)
						local rows = math.clamp(count, 1, SELECTOR_MAX_VISIBLE)
						local h = rows * DESIGN_OPTION_H + math.max(0, rows - 1) * 2
						return UDim2.new(1, 0, 0, h)
					end),
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Visible = SelectorOpen,
					Active = true,
					ScrollingEnabled = true,
					ScrollingDirection = Enum.ScrollingDirection.Y,
					ScrollBarThickness = 4,
					ScrollBarImageColor3 = PALETTE.accent,
					ScrollBarImageTransparency = 0.4,
					AutomaticCanvasSize = Enum.AutomaticSize.Y,
					CanvasSize = UDim2.fromOffset(0, 0),
					ElasticBehavior = Enum.ElasticBehavior.Never,
					[Fusion.Children] = {
						scope:New('UIListLayout') { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder },
						scope:ForPairs(OwnedTitleOptions, function(_use, innerScope, idx, opt)
							local isCurrent = innerScope:Computed(function(use2)
								return use2(ActiveTitleId) == opt.id
							end)
							return idx, innerScope:New('TextButton') {
								LayoutOrder = idx,
								Size = UDim2.new(1, 0, 0, DESIGN_OPTION_H),
								BackgroundColor3 = innerScope:Computed(function(use2)
									return use2(isCurrent) and PALETTE.accent or PALETTE.bg0
								end),
								BackgroundTransparency = innerScope:Computed(function(use2)
									return use2(isCurrent) and 0.6 or 0.45
								end),
								BorderSizePixel = 0,
								AutoButtonColor = false,
								FontFace = HUDCommon.FONT_UI,
								Text = opt.name,
								TextSize = 12,
								TextColor3 = opt.color or PALETTE.ink,
								TextXAlignment = Enum.TextXAlignment.Left,
								[Fusion.OnEvent('Activated')] = function()
									activateTitle(opt.id)
								end,
								[Fusion.Children] = {
									innerScope:New('UIPadding') {
										PaddingLeft = UDim.new(DESIGN_OPT_PAD_X / DESIGN_RIGHT_W, 0),
									},
								},
							}
						end),
					},
				}
			end)(),
		},
	}

	-- The titles dropdown above is the single source of truth: it lists
	-- every owned title (plus a 'None' option to clear) and selecting one
	-- equips it via the SetActive remote. Previous "current" preview frame
	-- + per-title list were removed — both duplicated dropdown information.

	local recordPanel = scope:New('Frame') {
		LayoutOrder = 6,
		Size = UDim2.new(1, 0, 0, 90),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.75, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
				PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
			},
			scope:New('UIListLayout') { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder },
		},
	}
	local function makeRecordRow(order, label, value, color)
		return scope:New('Frame') {
			LayoutOrder = order,
			Size = UDim2.new(1, 0, 0, 14),
			BackgroundTransparency = 1,
			Parent = recordPanel,
			[Fusion.Children] = {
				scope:New('TextLabel') {
					Size = UDim2.new(0.55, 0, 1, 0),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_UI,
					Text = label, TextSize = 11,
					TextColor3 = PALETTE.inkDim,
					TextTransparency = 0.3,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('TextLabel') {
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, 0, 0, 0),
					Size = UDim2.new(0.45, 0, 1, 0),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = value, TextSize = 11,
					TextColor3 = color or PALETTE.ink,
					TextXAlignment = Enum.TextXAlignment.Right,
				},
			},
		}
	end
	local function sumCountsTable(tbl)
		if typeof(tbl) ~= 'table' then return 0 end
		local n = 0
		for _, v in tbl do
			n += (typeof(v) == 'number') and v or 1
		end
		return n
	end
	makeRecordRow(1, 'Playtime Logged', scope:Computed(function(use)
		use(DataVersion)
		local data = Utils.getPlayerData()
		local seconds = (data and data.Analytics and data.Analytics.TimePlayed) or 0
		local hours = math.floor(seconds / 3600)
		local minutes = math.floor((seconds % 3600) / 60)
		return string.format('%dhrs %dminutes', hours, minutes)
	end))
	makeRecordRow(2, 'Bosses felled', scope:Computed(function(use)
		use(DataVersion)
		local data = Utils.getPlayerData()
		return tostring(sumCountsTable(data and data.Analytics and data.Analytics.PvEKills))
	end))
	makeRecordRow(3, 'PvP record', scope:Computed(function(use)
		use(DataVersion)
		local data = Utils.getPlayerData()
		local w = sumCountsTable(data and data.Analytics and data.Analytics.PvPKills)
		return string.format('%d·%d·%d', w, 0, 0)
	end))
	makeRecordRow(4, 'Total PKs', scope:Computed(function(use)
		use(DataVersion)
		local data = Utils.getPlayerData()
		return tostring(sumCountsTable(data and data.Analytics and data.Analytics.PvPKills))
	end), PALETTE.danger)

	-- // Right column // — resists / title selector / record block.
	-- Equipping happens in the Equip tab now; this column is the
	-- read-only "character status" surface (resists, active title,
	-- combat record). The title selector dropdown is the only
	-- interactive piece here.
	local rightColumn = scope:New('Frame') {
		Name = 'RightColumn',
		LayoutOrder = 3,
		Size = UDim2.fromScale(RIGHT_COL_PX / DESIGN_W, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder },
			Utils.eyebrow(scope, '\u{25C6} RESIST', { LayoutOrder = 1 }),
			resistList,
			Utils.eyebrow(scope, '\u{25C6} TITLES', { LayoutOrder = 3 }),
			titleSelector,
			Utils.eyebrow(scope, '\u{25C6} RECORD', { LayoutOrder = 5 }),
			recordPanel,
		},
	}

	-- Root Frame: pure scale + transparent. The aspect-ratio constraint
	-- is applied by init.luau's tab mount loop (TAB_ASPECT = 1394/648),
	-- so this frame preserves its design shape on every screen aspect.
	return scope:New('Frame') {
		Name = 'CharacterTab',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			-- 32 px L+R, 24 px T+B → scale fractions of full tab (1394 × 648).
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(24 / 648, 0),
				PaddingBottom = UDim.new(24 / 648, 0),
				PaddingLeft   = UDim.new(32 / 1394, 0),
				PaddingRight  = UDim.new(32 / 1394, 0),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				-- 24 px column gap as a fraction of the inner content width.
				Padding = UDim.new(COL_GAP_PX / DESIGN_W, 0),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			leftColumn, centerColumn, rightColumn,
		},
	}
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/TabWidget/CompanionsTab.luau"><![CDATA[-- // TabWidget/CompanionsTab.luau //
-- Two-column companion panel:
--   left  — owned companions list (name, level, XP bar)
--   right — selected detail (name, element chip, XP bar with `XP / nextXP`,
--           benefits list, Equip/Unequip + Feed Candy buttons)

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local peek   = Fusion.peek

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local CompanionsShared = ReplicatedModules.Services.CompanionsShared
local CompanionsConfig = ReplicatedModules.Data.Companions
local Utils = require(script.Parent.utils)

local Module = {}

-- 1394×648 outer canvas, 1330×600 inner after 32/24 UIPadding.
local OUTER_W, OUTER_H   = 1394, 648
local DESIGN_W, DESIGN_H = 1330, 600
local LEFT_COL_PX        = 320
local COL_GAP_PX         = 16

local ELEMENT_COLORS = {
	fire    = Color3.fromRGB(255, 130, 90),
	water   = Color3.fromRGB(120, 200, 255),
	earth   = Color3.fromRGB(180, 230, 130),
	air     = Color3.fromRGB(220, 220, 240),
	arcane  = Color3.fromRGB(200, 140, 255),
}

local function listOwnedCompanions(saveData)
	local out = {}
	if typeof(saveData) ~= 'table' then return out end
	local owned = (saveData.Companions and saveData.Companions.Owned) or {}
	local i = 0
	for cid, entry in owned do
		local cfg = CompanionsConfig.Companions[cid]
		if cfg then
			i += 1
			table.insert(out, { order = i, id = cid, cfg = cfg, entry = entry })
		end
	end
	table.sort(out, function(a, b)
		return (a.cfg.Display.Name or a.id) < (b.cfg.Display.Name or b.id)
	end)
	return out
end

-- (Candy listing was a previous Companions-tab affordance — moved to the
-- Inventory tab's Use action. CompanionCandy items now flow through
-- ConsumptionServer.UseItem → CompanionsServer.UseCompanionCandy.)

function Module.Build(ctx)
	local scope = ctx.scope
	local DataVersion = ctx.DataVersion

	local SelectedId = scope:Value(nil :: string?)

	-- Left column: owned list.
	local listChildren = scope:ForPairs(
		scope:Computed(function(use)
			use(DataVersion)
			return listOwnedCompanions(Utils.getPlayerData())
		end),
		function(use, innerScope, _idx, entry)
			local isSelected = innerScope:Computed(function(use2)
				return use2(SelectedId) == entry.id
			end)
			-- Live "is this companion in an equipped slot?" lookup. Drives
			-- the gold ★ badge in the top-right of the row, mirroring the
			-- InventoryTab equipped-indicator pattern. Re-runs on every
			-- DataVersion bump so equip/unequip toggles the badge instantly.
			local isEquipped = innerScope:Computed(function(use2)
				use2(DataVersion)
				return CompanionsShared.IsCompanionEquipped(Utils.getPlayerData(), entry.id)
			end)
			local elementColor = ELEMENT_COLORS[entry.cfg.Element] or PALETTE.accent
			local lvl = (entry.entry and entry.entry.Level) or 1
			return entry.id, innerScope:New('TextButton') {
				LayoutOrder = entry.order,
				Size = UDim2.new(1, 0, 0, 56),
				BackgroundColor3 = innerScope:Computed(function(use2)
					return use2(isSelected) and elementColor or PALETTE.bg0
				end),
				BackgroundTransparency = innerScope:Computed(function(use2)
					return use2(isSelected) and 0.55 or 0.4
				end),
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = '',
				[Fusion.OnEvent('Activated')] = function() SelectedId:set(entry.id) end,
				[Fusion.Children] = {
					innerScope:New('UIStroke') {
						Color = innerScope:Computed(function(use2)
							return use2(isSelected) and PALETTE.accentHot or elementColor
						end),
						Transparency = 0.55, Thickness = 1,
					},
					innerScope:New('UIPadding') {
						PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
					},
					innerScope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0.5),
						Position = UDim2.fromScale(0, 0.32),
						Size = UDim2.new(1, 0, 0, 18),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_DISPLAY,
						Text = entry.cfg.Display.Name or entry.id,
						TextSize = 16,
						TextColor3 = PALETTE.ink,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					innerScope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0.5),
						Position = UDim2.fromScale(0, 0.74),
						Size = UDim2.new(1, 0, 0, 14),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = string.format('LVL %d · %s', lvl, string.upper(entry.cfg.Element)),
						TextSize = 11,
						TextColor3 = elementColor,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					-- Equipped indicator (gold ★) — same chrome as the
					-- InventoryTab slot badge. Visible only while this
					-- companion sits in an equipped slot; flips live on
					-- equip/unequip via the DataVersion-bumped Computed.
					innerScope:New('TextLabel') {
						Name = 'Equipped',
						AnchorPoint = Vector2.new(1, 0),
						Position = UDim2.new(1, -4, 0, 4),
						Size = UDim2.fromOffset(16, 16),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_DISPLAY,
						Text = innerScope:Computed(function(use2)
							return use2(isEquipped) and '\u{2605}' or ''
						end),
						TextScaled = true,
						TextColor3 = PALETTE.gold,
						TextStrokeColor3 = PALETTE.bg0,
						TextStrokeTransparency = 0.4,
						TextXAlignment = Enum.TextXAlignment.Right,
					},
				},
			}
		end
	)

	local leftColumn = scope:New('Frame') {
		LayoutOrder = 1,
		Size = UDim2.fromScale(LEFT_COL_PX / DESIGN_W, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- Eyebrow shows live "X/Y Equipped" so the player can read
			-- their slot count without diving into the detail pane.
			-- Bumps on DataVersion (PlayerData replication) so the
			-- count updates on equip/unequip and on cmdr changes to
			-- MaxEquipped.
			Utils.eyebrow(scope, scope:Computed(function(use)
				use(DataVersion)
				local data = Utils.getPlayerData()
				local count = CompanionsShared.GetEquippedCount(data)
				local maxEq = CompanionsShared.GetMaxEquipped(data)
				return string.format('\u{25C6} COMPANIONS — %d/%d EQUIPPED', count, maxEq)
			end), { LayoutOrder = 1 }),
			scope:New('ScrollingFrame') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 1, -36),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Active = true,
				ScrollBarThickness = 4,
				ScrollBarImageColor3 = PALETTE.accent,
				CanvasSize = UDim2.fromOffset(0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ElasticBehavior = Enum.ElasticBehavior.Never,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding = UDim.new(0, 6),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					listChildren,
				},
			},
		},
	}

	-- Right column derived state.
	local selectedEntry = scope:Computed(function(use)
		use(DataVersion)
		local id = use(SelectedId); if not id then return nil end
		local data = Utils.getPlayerData()
		local owned = (data and data.Companions and data.Companions.Owned) or {}
		local cfg = CompanionsConfig.Companions[id]
		if not cfg then return nil end
		return { id = id, cfg = cfg, entry = owned[id] }
	end)

	-- Single-id legacy lookup (kept for back-compat callers below) +
	-- a per-companion "is this equipped?" Computed driving the
	-- EQUIP/UNEQUIP toggle text on the right pane.
	local equippedId = scope:Computed(function(use)
		use(DataVersion)
		return CompanionsShared.GetEquippedId(Utils.getPlayerData())
	end)
	local selectedIsEquipped = scope:Computed(function(use)
		use(DataVersion)
		local sel = use(selectedEntry); if not sel then return false end
		return CompanionsShared.IsCompanionEquipped(Utils.getPlayerData(), sel.id)
	end)
	-- "Slots full" disables the EQUIP button — better UX than firing the
	-- TryEquip remote and watching it silently fail. UNEQUIP still works.
	local slotsFull = scope:Computed(function(use)
		use(DataVersion)
		local data = Utils.getPlayerData()
		return CompanionsShared.GetEquippedCount(data) >= CompanionsShared.GetMaxEquipped(data)
	end)

	-- Benefits list rendered as a Computed-driven Frame block.
	local benefitsBlock = scope:New('Frame') {
		LayoutOrder = 5,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 4),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:ForPairs(
				scope:Computed(function(use)
					local sel = use(selectedEntry)
					if not sel then return {} end
					local out = {}
					local lvl = (sel.entry and sel.entry.Level) or 1
					for i, b in sel.cfg.Benefits do
						table.insert(out, {
							order = i,
							atLevel = b.AtLevel,
							stat = b.Stat,
							bonus = b.Bonus,
							unlocked = lvl >= b.AtLevel,
						})
					end
					return out
				end),
				function(use, innerScope, _i, b)
					local color = b.unlocked and PALETTE.accent or PALETTE.inkFaint
					local label
					if typeof(b.bonus) == 'number' then
						label = string.format('Lv %d · %s +%.0f%%', b.atLevel, b.stat, b.bonus * 100)
					else
						label = string.format('Lv %d · %s · %s', b.atLevel, b.stat, tostring(b.bonus))
					end
					return b.order, innerScope:New('TextLabel') {
						LayoutOrder = b.order,
						Size = UDim2.new(1, 0, 0, 16),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = label,
						TextSize = 12,
						TextColor3 = color,
						TextXAlignment = Enum.TextXAlignment.Left,
					}
				end
			),
		},
	}

	-- Red "no companion equipped" warning. Visible only when nothing is
	-- equipped — points the player at the Equip flow + reminds them
	-- candy goes through Inventory → Use, not this tab any more.
	local noCompanionWarning = scope:New('TextLabel') {
		LayoutOrder = 7,
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_MONO,
		Text = 'No companion equipped — equip one to receive their benefits and to use Companion Candy from Inventory.',
		TextSize = 11,
		TextColor3 = Color3.fromRGB(220, 90, 100),
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Visible = scope:Computed(function(use)
			return use(equippedId) == nil
		end),
	}

	local rightColumn = scope:New('Frame') {
		LayoutOrder = 2,
		Size = UDim2.fromScale((DESIGN_W - LEFT_COL_PX - COL_GAP_PX) / DESIGN_W, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			Utils.eyebrow(scope, '◆ DETAIL', { LayoutOrder = 1 }),
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, 26),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = scope:Computed(function(use)
					local sel = use(selectedEntry)
					return sel and (sel.cfg.Display.Name or sel.id) or 'No companion selected'
				end),
				TextSize = 22,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				LayoutOrder = 3,
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = scope:Computed(function(use)
					local sel = use(selectedEntry)
					return sel and (sel.cfg.Display.Description or '') or ''
				end),
				TextSize = 13,
				TextColor3 = PALETTE.inkDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
			},
			scope:New('TextLabel') {
				LayoutOrder = 4,
				Size = UDim2.new(1, 0, 0, 16),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					local sel = use(selectedEntry)
					if not sel then return '' end
					local lvl = (sel.entry and sel.entry.Level) or 1
					local xp  = (sel.entry and sel.entry.XP) or 0
					local need = CompanionsShared.XPToNextLevel(sel.id, lvl)
					if need == 0 then
						return string.format('LVL %d · MAX', lvl)
					end
					return string.format('LVL %d · XP %d / %d', lvl, xp, need)
				end),
				TextSize = 12,
				TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			benefitsBlock,
			-- Buttons row.
			scope:New('Frame') {
				LayoutOrder = 6,
				Size = UDim2.new(1, 0, 0, 36),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Horizontal,
						Padding = UDim.new(0, 8),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					scope:New('TextButton') {
						LayoutOrder = 1,
						Size = UDim2.fromOffset(160, 36),
						BackgroundColor3 = PALETTE.bg0,
						-- Dim the button when slots are full AND the selected
						-- companion isn't already equipped — there's nothing
						-- it can do. Live UNEQUIP path stays opaque.
						BackgroundTransparency = scope:Computed(function(use)
							if use(selectedIsEquipped) then return 0.25 end
							return use(slotsFull) and 0.55 or 0.25
						end),
						BorderSizePixel = 0,
						AutoButtonColor = false,
						FontFace = HUDCommon.FONT_BUTTON,
						Text = scope:Computed(function(use)
							local sel = use(selectedEntry); if not sel then return 'EQUIP' end
							if use(selectedIsEquipped) then return 'UNEQUIP' end
							return use(slotsFull) and 'SLOTS FULL' or 'EQUIP'
						end),
						TextSize = 13,
						TextColor3 = PALETTE.ink,
						[Fusion.OnEvent('Activated')] = function()
							local sel = peek(selectedEntry); if not sel then return end
							local Gameplay = require(LocalPlayer:WaitForChild('PlayerScripts')
								:WaitForChild('Core'):WaitForChild('Gameplay'))
							local CompanionsClient = Gameplay.CompanionsClient
							if not CompanionsClient then return end
							-- Multi-equip: route by the live "is this equipped"
							-- check, not the legacy "first slot match". Pass
							-- the specific id to AttemptUnequip so multi-slot
							-- loadouts only drop THIS companion.
							if peek(selectedIsEquipped) then
								CompanionsClient.AttemptUnequip(sel.id)
							elseif not peek(slotsFull) then
								CompanionsClient.AttemptEquip(sel.id)
							end
						end,
						[Fusion.Children] = {
							scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
						},
					},
					-- DEBUG: Float / Walk toggle. Visible only when the
					-- selected companion's cfg has AllowWalkAndFloatBypass
					-- set (the four wisps + any future debug companions).
					-- Toggles the per-(player, companionId) preference;
					-- server validates the same flag before flipping.
					scope:New('TextButton') {
						LayoutOrder = 3,
						Size = UDim2.fromOffset(120, 36),
						BackgroundColor3 = PALETTE.bg0,
						BackgroundTransparency = 0.25,
						BorderSizePixel = 0,
						AutoButtonColor = false,
						Visible = scope:Computed(function(use)
							local sel = use(selectedEntry); if not sel then return false end
							return CompanionsShared.CanToggleMovementMode(sel.id)
						end),
						FontFace = HUDCommon.FONT_BUTTON,
						Text = scope:Computed(function(use)
							local sel = use(selectedEntry); if not sel then return '' end
							local data = Utils.getPlayerData()
							local mode = CompanionsShared.GetMovementMode(data, sel.id)
							return string.format('MODE · %s', string.upper(mode))
						end),
						TextSize = 11,
						TextColor3 = PALETTE.accent,
						[Fusion.OnEvent('Activated')] = function()
							local sel = peek(selectedEntry); if not sel then return end
							local Gameplay = require(LocalPlayer:WaitForChild('PlayerScripts')
								:WaitForChild('Core'):WaitForChild('Gameplay'))
							local CompanionsClient = Gameplay.CompanionsClient
							if not CompanionsClient then return end
							-- Two-state toggle on click. A "real" dropdown
							-- with multiple modes can replace this when a
							-- third mode (sit / hide) ships.
							local data = Utils.getPlayerData()
							local cur = CompanionsShared.GetMovementMode(data, sel.id)
							local next_ = (cur == 'walk') and 'float' or 'walk'
							CompanionsClient.SetMovementMode(sel.id, next_)
						end,
						[Fusion.Children] = {
							scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.55, Thickness = 1 },
						},
					},
				},
			},
			noCompanionWarning,
		},
	}

	-- ctx.embedded suppresses outer padding when this tab is embedded
	-- inside InventoryTab (already padded by the host).
	local children = {
		scope:New('UIListLayout') {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(COL_GAP_PX / DESIGN_W, 0),
			SortOrder = Enum.SortOrder.LayoutOrder,
		},
		leftColumn, rightColumn,
	}
	if not ctx.embedded then
		table.insert(children, 1, scope:New('UIPadding') {
			PaddingTop    = UDim.new(24 / OUTER_H, 0),
			PaddingBottom = UDim.new(24 / OUTER_H, 0),
			PaddingLeft   = UDim.new(32 / OUTER_W, 0),
			PaddingRight  = UDim.new(32 / OUTER_W, 0),
		})
	end
	return scope:New('Frame') {
		Name = 'CompanionsTab',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = children,
	}
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/TabWidget/CraftingTab.luau"><![CDATA[-- // TabWidget/CraftingTab.luau //
-- Wizard101-style crafting panel.
--   left   — schools rail (Smithing/Tailoring/Alchemy/Cooking/Enchanting),
--            each row shows artisan rank + level + XP bar.
--   center — recipes for the active school, with locked rows greyed.
--   right  — selected recipe detail: output preview, reagent rows
--            ([icon] Iron Ore · 3 / 5 with red/green color), Craft button.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local peek   = Fusion.peek

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local CraftingShared = ReplicatedModules.Services.CraftingShared
local CraftingConfig = ReplicatedModules.Data.Crafting
local ItemsConfig    = ReplicatedModules.Data.Items
local RemoteService  = ReplicatedModules.Services.RemoteService

local Utils = require(script.Parent.utils)

local CraftingEvent = RemoteService.GetRemote('CraftingEvent', 'RemoteEvent', false)

local Module = {}

-- 1394×648 outer canvas, 1330×600 inner after 32/24 UIPadding. 3-col layout.
local OUTER_W, OUTER_H   = 1394, 648
local DESIGN_W, DESIGN_H = 1330, 600
local LEFT_COL_PX        = 260
local RIGHT_COL_PX       = 280
local COL_GAP_PX         = 16

local SCHOOL_ORDER = { 'Smithing', 'Tailoring', 'Alchemy', 'Cooking', 'Enchanting' }

local function listRecipesForSchool(schoolId: string)
	local out = {}
	for id, recipe in CraftingConfig.Recipes do
		if recipe.School == schoolId then
			table.insert(out, { id = id, recipe = recipe })
		end
	end
	table.sort(out, function(a, b)
		if a.recipe.RequiredLevel ~= b.recipe.RequiredLevel then
			return a.recipe.RequiredLevel < b.recipe.RequiredLevel
		end
		return a.id < b.id
	end)
	return out
end

local function itemDisplayName(itemId: string): string
	local cfg = ItemsConfig.Items[itemId]
	if cfg and cfg.Display and cfg.Display.Title and cfg.Display.Title.Text then
		return cfg.Display.Title.Text
	end
	return itemId
end

function Module.Build(ctx)
	local scope = ctx.scope
	local DataVersion = ctx.DataVersion

	local SelectedSchool = scope:Value('Smithing')
	local SelectedRecipe = scope:Value(nil :: string?)

	-- // LEFT — schools rail with rank + xp bar // --
	local schoolRows = {}
	for i, schoolId in SCHOOL_ORDER do
		local school = CraftingConfig.Schools[schoolId]
		if not school then continue end
		local isActive = scope:Computed(function(use)
			return use(SelectedSchool) == schoolId
		end)
		local rowText = scope:Computed(function(use)
			use(DataVersion)
			local data = Utils.getPlayerData()
			local lvl = CraftingShared.GetArtisanLevel(data, schoolId)
			local rank = CraftingShared.GetArtisanRank(lvl)
			return string.format('%s · %s · Lv %d', school.Display.Name, rank.Name, lvl)
		end)
		local xpFill = scope:Computed(function(use)
			use(DataVersion)
			local data = Utils.getPlayerData()
			local lvl = CraftingShared.GetArtisanLevel(data, schoolId)
			local xp  = CraftingShared.GetArtisanXP(data, schoolId)
			local need = CraftingShared.GetXPToNextLevel(schoolId, lvl)
			if need <= 0 then return 1 end
			return math.clamp(xp / need, 0, 1)
		end)
		local row = scope:New('TextButton') {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 56),
			BackgroundColor3 = scope:Computed(function(use)
				return use(isActive) and school.Display.Color or PALETTE.bg0
			end),
			BackgroundTransparency = scope:Computed(function(use)
				return use(isActive) and 0.55 or 0.4
			end),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = '',
			[Fusion.OnEvent('Activated')] = function()
				SelectedSchool:set(schoolId)
				SelectedRecipe:set(nil)
			end,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = school.Display.Color, Transparency = 0.5, Thickness = 1 },
				scope:New('UIPadding') { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) },
				scope:New('TextLabel') {
					Size = UDim2.new(1, 0, 0, 18),
					Position = UDim2.fromOffset(0, 6),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_DISPLAY,
					Text = school.Display.Name,
					TextSize = 16,
					TextColor3 = PALETTE.ink,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				scope:New('TextLabel') {
					Size = UDim2.new(1, 0, 0, 14),
					Position = UDim2.fromOffset(0, 26),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = rowText,
					TextSize = 11,
					TextColor3 = school.Display.Color,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				-- XP bar.
				scope:New('Frame') {
					AnchorPoint = Vector2.new(0, 1),
					Position = UDim2.new(0, 0, 1, -8),
					Size = UDim2.new(1, 0, 0, 4),
					BackgroundColor3 = PALETTE.bg0,
					BackgroundTransparency = 0.35,
					BorderSizePixel = 0,
					[Fusion.Children] = {
						scope:New('Frame') {
							Size = scope:Computed(function(use)
								return UDim2.fromScale(use(xpFill), 1)
							end),
							BackgroundColor3 = school.Display.Color,
							BorderSizePixel = 0,
						},
					},
				},
			},
		}
		table.insert(schoolRows, row)
	end

	local leftColumn = scope:New('Frame') {
		LayoutOrder = 1,
		Size = UDim2.fromScale(LEFT_COL_PX / DESIGN_W, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			Utils.eyebrow(scope, '◆ ARTISAN', { LayoutOrder = 1 }),
			table.unpack(schoolRows),
		},
	}

	-- // CENTER — recipes for active school // --
	-- Filtered through `IsRecipeUnlocked` so the player only sees
	-- recipes they've explicitly unlocked (via AutoUnlock seed,
	-- quest reward, drop, or the cmdr /unlockrecipe command). Recipes
	-- they don't own simply don't appear in the list at all.
	local recipeListChildren = scope:ForPairs(
		scope:Computed(function(use)
			use(DataVersion)
			local data = Utils.getPlayerData()
			local schoolId = use(SelectedSchool)
			local out = {}
			for _, entry in listRecipesForSchool(schoolId) do
				if not CraftingShared.IsRecipeUnlocked(data, entry.id) then continue end
				local lvl = CraftingShared.GetArtisanLevel(data, schoolId)
				entry.unlocked = lvl >= entry.recipe.RequiredLevel
				entry.canCraft, entry.reason = CraftingShared.CanCraft(data, entry.id, 1)
				table.insert(out, entry)
			end
			return out
		end),
		function(use, innerScope, idx, entry)
			local school = CraftingConfig.Schools[entry.recipe.School]
			local color = entry.unlocked and (school and school.Display.Color or PALETTE.accent) or PALETTE.inkFaint
			local isSelected = innerScope:Computed(function(use2)
				return use2(SelectedRecipe) == entry.id
			end)
			return entry.id, innerScope:New('TextButton') {
				LayoutOrder = idx,
				Size = UDim2.new(1, 0, 0, 40),
				BackgroundColor3 = innerScope:Computed(function(use2)
					if use2(isSelected) then return color end
					return PALETTE.bg0
				end),
				BackgroundTransparency = innerScope:Computed(function(use2)
					return use2(isSelected) and 0.55 or 0.4
				end),
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = '',
				[Fusion.OnEvent('Activated')] = function()
					SelectedRecipe:set(entry.id)
				end,
				[Fusion.Children] = {
					innerScope:New('UIStroke') { Color = color, Transparency = 0.55, Thickness = 1 },
					innerScope:New('UIPadding') { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) },
					innerScope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0.5),
						Position = UDim2.fromScale(0, 0.4),
						Size = UDim2.new(1, -60, 0, 16),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_UI,
						Text = entry.recipe.Display.Name,
						TextSize = 13,
						TextColor3 = entry.unlocked and PALETTE.ink or PALETTE.inkDim,
						TextXAlignment = Enum.TextXAlignment.Left,
						TextTruncate = Enum.TextTruncate.AtEnd,
					},
					innerScope:New('TextLabel') {
						AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.new(1, 0, 0.5, 0),
						Size = UDim2.fromOffset(60, 16),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = string.format('Lv %d', entry.recipe.RequiredLevel),
						TextSize = 11,
						TextColor3 = entry.unlocked and color or PALETTE.inkFaint,
						TextXAlignment = Enum.TextXAlignment.Right,
					},
				},
			}
		end
	)

	local centerColumn = scope:New('Frame') {
		LayoutOrder = 2,
		Size = UDim2.fromScale(RIGHT_COL_PX / DESIGN_W, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			Utils.eyebrow(scope, '◆ RECIPES', { LayoutOrder = 1 }),
			scope:New('ScrollingFrame') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 1, -28),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Active = true,
				ScrollBarThickness = 4,
				ScrollBarImageColor3 = PALETTE.accent,
				CanvasSize = UDim2.fromOffset(0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ElasticBehavior = Enum.ElasticBehavior.Never,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding = UDim.new(0, 4),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					recipeListChildren,
				},
			},
		},
	}

	-- // RIGHT — selected recipe detail // --
	local selectedRecipeData = scope:Computed(function(use)
		local id = use(SelectedRecipe); if not id then return nil end
		return CraftingConfig.Recipes[id]
	end)

	local reagentsBlock = scope:New('Frame') {
		LayoutOrder = 4,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 4),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:ForPairs(
				scope:Computed(function(use)
					use(DataVersion)
					local id = use(SelectedRecipe); if not id then return {} end
					local data = Utils.getPlayerData()
					local sat = CraftingShared.GetReagentSatisfaction(data, id)
					local recipe = CraftingConfig.Recipes[id]
					if not recipe then return {} end
					local out = {}
					for i, reagent in recipe.Reagents do
						local pair = sat[reagent.ItemId] or { have = 0, need = reagent.Quantity }
						table.insert(out, {
							order = i,
							itemId = reagent.ItemId,
							have = pair.have,
							need = pair.need,
							satisfied = pair.have >= pair.need,
						})
					end
					return out
				end),
				function(use, innerScope, _i, r)
					local color = r.satisfied and PALETTE.success or PALETTE.danger
					return r.itemId, innerScope:New('Frame') {
						LayoutOrder = r.order,
						Size = UDim2.new(1, 0, 0, 22),
						BackgroundTransparency = 1,
						[Fusion.Children] = {
							innerScope:New('TextLabel') {
								AnchorPoint = Vector2.new(0, 0.5),
								Position = UDim2.fromScale(0, 0.5),
								Size = UDim2.new(1, -80, 1, 0),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_UI,
								Text = string.format('\u{25C6} %s', itemDisplayName(r.itemId)),
								TextSize = 13,
								TextColor3 = PALETTE.ink,
								TextXAlignment = Enum.TextXAlignment.Left,
								TextTruncate = Enum.TextTruncate.AtEnd,
							},
							innerScope:New('TextLabel') {
								AnchorPoint = Vector2.new(1, 0.5),
								Position = UDim2.new(1, 0, 0.5, 0),
								Size = UDim2.fromOffset(80, 18),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_MONO,
								Text = string.format('%d / %d', r.have, r.need),
								TextSize = 12,
								TextColor3 = color,
								TextXAlignment = Enum.TextXAlignment.Right,
							},
						},
					}
				end
			),
		},
	}

	local craftability = scope:Computed(function(use)
		use(DataVersion)
		local id = use(SelectedRecipe); if not id then return false, '' end
		local data = Utils.getPlayerData()
		return CraftingShared.CanCraft(data, id, 1)
	end)

	local craftButton = scope:New('TextButton') {
		LayoutOrder = 5,
		Size = UDim2.new(0, 200, 0, 36),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		FontFace = HUDCommon.FONT_BUTTON,
		Text = scope:Computed(function(use)
			local ok = use(craftability)
			return ok and 'CRAFT' or 'UNAVAILABLE'
		end),
		TextSize = 14,
		TextColor3 = scope:Computed(function(use)
			local ok = use(craftability)
			return ok and PALETTE.success or PALETTE.inkFaint
		end),
		[Fusion.OnEvent('Activated')] = function()
			local id = peek(SelectedRecipe); if not id then return end
			local ok = peek(craftability); if not ok then return end
			CraftingEvent:FireServer(CraftingShared.CraftingActions.Craft, id, 1)
		end,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = scope:Computed(function(use)
					return use(craftability) and PALETTE.success or PALETTE.inkFaint
				end),
				Transparency = 0.4, Thickness = 1,
			},
		},
	}

	local rightColumn = scope:New('Frame') {
		LayoutOrder = 3,
		Size = UDim2.fromScale(
			(DESIGN_W - LEFT_COL_PX - RIGHT_COL_PX - 2 * COL_GAP_PX) / DESIGN_W,
			1
		),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			Utils.eyebrow(scope, '◆ DETAIL', { LayoutOrder = 1 }),
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, 26),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = scope:Computed(function(use)
					local r = use(selectedRecipeData)
					return r and r.Display.Name or 'No recipe selected'
				end),
				TextSize = 22,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				LayoutOrder = 3,
				Size = UDim2.new(1, 0, 0, 32),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = scope:Computed(function(use)
					local r = use(selectedRecipeData)
					if not r then return '' end
					return string.format('%s\n→ %s × %d (+%d %s XP)',
						r.Display.Description or '',
						itemDisplayName(r.Output.ItemId),
						r.Output.Quantity,
						r.XPGain,
						r.School)
				end),
				TextSize = 12,
				TextColor3 = PALETTE.inkDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
			},
			reagentsBlock,
			craftButton,
		},
	}

	return scope:New('Frame') {
		Name = 'CraftingTab',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(24 / OUTER_H, 0),
				PaddingBottom = UDim.new(24 / OUTER_H, 0),
				PaddingLeft   = UDim.new(32 / OUTER_W, 0),
				PaddingRight  = UDim.new(32 / OUTER_W, 0),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(COL_GAP_PX / DESIGN_W, 0),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			leftColumn, centerColumn, rightColumn,
		},
	}
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/TabWidget/ForgeTab.luau"><![CDATA[-- // TabWidget/ForgeTab.luau //
-- "Workstation Required" info splash: eyebrow + display title + wrapped
-- description + horizontal row of three station buttons. Crafting itself
-- is zone-triggered via NPC interaction (ForgeWidget / EnchantingWidget /
-- GemSocketWidget opening when the player steps onto the matching zone),
-- so this tab exists purely to point players at the three workstations
-- available in the world.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local Module = {}

local FORGE_STATIONS = { 'FORGE', 'ENCHANTER', 'GEMSMITH' }

-- Local helper — station button. Kept local to this module because it's the
-- only caller. If a future tab wants "bordered info button" it can be
-- promoted to utils.luau.
local function buildStationButton(scope, label: string)
	return scope:New('TextButton') {
		AutoButtonColor = false,
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(160, 40),
		FontFace = HUDCommon.FONT_MONO,
		Text = '◆  ' .. label,
		TextSize = 12,
		TextColor3 = PALETTE.accent,
		LayoutOrder = 1,
		[Fusion.OnEvent('Activated')] = function()
			-- Stations are opened by walking into their NPC zones — nothing
			-- to wire here. warn() proves hit-testing works and gives a
			-- breadcrumb when the player clicks hopefully.
			warn(string.format('TabWidget: %s station opens via in-world NPC interaction.', label))
		end,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.2, Thickness = 1 },
		},
	}
end

function Module.Build(ctx)
	local scope = ctx.scope

	-- Pre-build the three station buttons so table.unpack flows cleanly.
	local stationButtons = {}
	for i, label in FORGE_STATIONS do
		local btn = buildStationButton(scope, label)
		btn.LayoutOrder = i
		table.insert(stationButtons, btn)
	end

	-- Button row — horizontal list, center-aligned.
	local buttonRow = scope:New('Frame') {
		LayoutOrder = 4,
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				Padding = UDim.new(0, 12),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			table.unpack(stationButtons),
		},
	}

	return scope:New('Frame') {
		Name = 'ForgeTab',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			-- Top padding pushes content down from the topbar border; side
			-- padding keeps the description from kissing the edges.
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(0, 96),
				PaddingLeft   = UDim.new(0, 64),
				PaddingRight  = UDim.new(0, 64),
				PaddingBottom = UDim.new(0, 24),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				VerticalAlignment = Enum.VerticalAlignment.Top,
				Padding = UDim.new(0, 14),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- Centered eyebrow.
			scope:New('TextLabel') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 14),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = '◆ WORKSTATION REQUIRED',
				TextSize = 11,
				TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Center,
			},
			-- Centered display title.
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, 40),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = 'Visit the Forge',
				TextSize = 32,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Center,
			},
			-- Wrapped description. Pixel-width cap keeps the line length
			-- readable on ultrawide screens where a scale-width would bloat.
			scope:New('TextLabel') {
				LayoutOrder = 3,
				Size = UDim2.new(0, 640, 0, 44),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = "Crafting takes place at the Blackiron Anvil, the Arcane Enchanting Table, and the Gemsmith's Socketing Anvil. Walk to each NPC in-world to open their station.",
				TextSize = 14,
				TextColor3 = PALETTE.inkDim,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
			},
			buttonRow,
		},
	}
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/TabWidget/InventoryTab.luau"><![CDATA[-- // TabWidget/InventoryTab.luau //
-- Two-column inventory browser.
--   left  — category-filter row + live search TextBox, grid of weapon/item
--           slots rendered as viewport previews, slot-header count line.
--   right — detail pane: hero card (rarity glow + item viewport), title,
--           type line, sub-tabs (OVERVIEW / FORGE / GEMS / ENCHANTS),
--           per-page content, action bar (EQUIP/UNEQUIP), and a floating
--           cursor-tracking tooltip for the FORGE page.
--
-- Reference: tmp/aincrad-ui/tabs.jsx InventoryDetail.
-- Data sources:
--   * PlayerData.Inventory — map of itemId → { uuid → stack } entries
--   * PlayerData.Equipped  — slot map used to badge equipped stacks
--   * ItemsConfig.Items / .FindInventoryItemOfUUID
--   * Rarities.RarityColors / .RarityValues
--
-- Cross-module deps: `ctx.DataVersion` drives every Computed so updates from
-- the manager's ReplicatedData listener propagate to every reactive binding.
--
-- Per-tab state (lives inside Build() — NOT module scope):
--   * SelectedInventoryUUID        — UUID of the item the user clicked
--   * SelectedInventoryCategory    — 'weapons' | 'equipment' | 'accessories'
--                                    + secondary embedded tabs (mounts /
--                                    companions / auras)
--   * SelectedInventoryDetailTab   — 'overview' | 'forge' | 'gems' | 'enchants'
--   * InventoryFilterText          — live search box value
-- Keeping these as locals inside Build() means the inventory tab can be
-- rebuilt/torn down without leaking state globally.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local GuiService = game:GetService('GuiService')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local peek   = Fusion.peek
local ItemsConfig = ReplicatedModules.Data.Items
local Rarities = ReplicatedModules.Data.Rarities
local CombatUtility = ReplicatedModules.Utility.CombatUtility
local RemoteService = ReplicatedModules.Services.RemoteService

-- Shared remote that drives ConsumptionServer.UseItem. Wired here so the
-- USE button in the action bar can fire-and-forget; the server resolves
-- the uuid → itemId, type-dispatches (CompanionCandy, Potion, etc.),
-- decrements stack, and runs the side-effect.
local ItemUseEvent = RemoteService.GetRemote('ItemUseEvent', 'RemoteEvent', false)
-- PlayerInventoryServer's equip/unequip toggle. Fire with (uuid, slotIndex)
-- where slotIndex is 1 (left) or 2 (right) for hand-slot weapons; the
-- server walks the slot config and routes to AttemptPlayerEquipItemOfUUID
-- or AttemptPlayerUnequipItemOfUUID depending on whether the uuid is
-- already equipped. Validation lives entirely server-side.
local InventoryEvent = RemoteService.GetRemote('InventoryEvent', 'RemoteEvent', false)

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local ViewportUtility = LocalModules.Utility.Viewport
local PALETTE = HUDCommon.PALETTE

local Utils = require(script.Parent.utils)

-- Mount/Companion/Aura sibling tabs are embedded into this tab as
-- categories on the rail. They expose a ctx.embedded flag we set when
-- calling Build so they skip their own outer 24/32 padding (would
-- otherwise compound with InventoryTab's own padding).
local MountsTab     = require(script.Parent:WaitForChild('MountsTab'))
local CompanionsTab = require(script.Parent:WaitForChild('CompanionsTab'))
local AurasTab      = require(script.Parent:WaitForChild('AurasTab'))

local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')

local Module = {}

-- 1394×648 outer canvas, 1330×600 inner after 32/24 UIPadding. Right detail
-- pane is anchored to the right edge; the left column leaves IMPLICIT_GAP_PX
-- between them (no UIListLayout at the root).
local OUTER_W, OUTER_H   = 1394, 648
local DESIGN_W, DESIGN_H = 1330, 600
local RIGHT_COL_PX       = 340
local IMPLICIT_GAP_PX    = 20

----------------------------------------------------------------------
-- Module-scope constants + pure helpers
-- (Nothing here reads Fusion state; safe to live outside Build())
----------------------------------------------------------------------

-- Primary categories: focused on equippables only — weapons / armor
-- (Equipment slot tag) / accessories (jewelry/curio tag). Consumables
-- are managed via the Equip tab's hotbar surface; materials via the
-- Crafting / Forge surfaces. The inventory tab is the equipment-
-- inspection lens, not a catch-all bag.
local INVENTORY_PRIMARY_CATEGORIES = {
	{ id = 'weapons',     label = 'WEAPONS',     glyph = '⚔' },
	{ id = 'equipment',   label = 'EQUIPMENT',   glyph = '⛨' },
	{ id = 'accessories', label = 'ACCESSORIES', glyph = '◈' },
}

-- Secondary categories: embedded sibling tabs surfaced as their own row.
-- Selecting one swaps the items grid + detail pane for the embedded tab's
-- content (see EMBEDDED_CATEGORIES + the embed block in Module.Build).
local INVENTORY_SECONDARY_CATEGORIES = {
	{ id = 'mounts',     label = 'MOUNTS',       glyph = '☗' },
	{ id = 'companions', label = 'COMPANIONS',   glyph = '✦' },
	{ id = 'auras',      label = 'AURAS',        glyph = '✺' },
}

-- Set lookup for the categories that aren't normal inventory items —
-- they swap out the right pane with an embedded tab.
local EMBEDDED_CATEGORIES = {
	mounts = true, companions = true, auras = true,
}

-- Detail-pane sub-tabs (the in-pane navigation row). Data-driven so the
-- visibility Computeds for each sub-page can key off string ids.
local DETAIL_SUBTABS = { 'overview', 'forge', 'gems', 'enchants' }
local DETAIL_SUBTAB_LABELS = {
	overview = 'OVERVIEW',
	forge    = 'FORGE',
	gems     = 'GEMS',
	enchants = 'ENCHANTS',
}

-- Placeholder tables — replaced by real item.cfg reads once those schemas exist.
-- (MOCK_MODIFIERS removed in Stage E; modifier chips now read live from
-- Composition.Forged.Modifiers + StatSnapshot.BonusTraits.)

local FORGE_COMPONENTS = {
	{ key = 'blade1',  label = 'PRIMARY BLADE',   material = 'Voidglass',  tint = Color3.fromRGB(200, 157, 255), bonus = '+120 DMG', tooltip = 'Phase · +10% crit · edge phases through light armor.' },
	{ key = 'blade2',  label = 'SECONDARY BLADE', material = 'Moonsteel',  tint = Color3.fromRGB(180, 200, 255), bonus = '+84 DMG',  tooltip = 'Lunar · regen 2/s while sheathed during Night cycle.' },
	{ key = 'bind1',   label = 'PRIMARY BINDING', material = 'Dragonbone', tint = Color3.fromRGB(255, 198, 112), bonus = '+8% vs Boss', tooltip = 'Dense inlay — increases damage against bosses by 8%.' },
	{ key = 'bind2',   label = 'SECONDARY BIND',  material = 'Starsilk',   tint = Color3.fromRGB(224, 234, 255), bonus = '+AGI',    tooltip = 'Swift · reduces weapon weight; every swing is quicker.' },
	{ key = 'handle',  label = 'HANDLE',          material = 'Iron',       tint = Color3.fromRGB(176, 180, 188), bonus = '— DUR',   tooltip = 'Standard-issue iron grip. Durable, unremarkable.' },
}

-- Map an ItemsConfig entry → inventory tab buckets. Tag-driven first
-- (the new explicit Tags array on item configs); falls back to the
-- data-shape derived ItemCategory for items not yet tagged. Items that
-- don't classify as Weapon / Equipment / Accessory don't surface in
-- the inventory tab at all (consumables / materials live elsewhere).
local function bucketsForItem(itemConfig): {[string]: true}
	local buckets: {[string]: true} = {}
	if ItemsConfig.HasTag(itemConfig, ItemsConfig.ItemTags.Weapon) then
		buckets.weapons = true
	end
	if ItemsConfig.HasTag(itemConfig, ItemsConfig.ItemTags.Equipment) then
		buckets.equipment = true
	end
	if ItemsConfig.HasTag(itemConfig, ItemsConfig.ItemTags.Accessory) then
		buckets.accessories = true
	end
	-- Fallback: derive from data shape for untagged items so legacy
	-- entries don't disappear silently. Tools fold into none of the
	-- three (the user excluded tools per the design ask).
	if next(buckets) == nil then
		for _, cat in ItemsConfig.GetItemCategories(itemConfig) do
			if cat == ItemsConfig.ItemCategory.Weapon then
				buckets.weapons = true
			elseif cat == ItemsConfig.ItemCategory.Equipment then
				buckets.equipment = true
			elseif cat == ItemsConfig.ItemCategory.Accessory then
				buckets.accessories = true
			end
		end
	end
	return buckets
end

-- Spin up a model inside a ViewportFrame using ViewportUtility. No Fusion
-- reactivity here — caller is responsible for invoking it at the right time
-- (on selection-change, via an Observer).
local function setupViewportModel(viewport: ViewportFrame, itemConfig)
	if not itemConfig or not itemConfig.Display or not itemConfig.Display.Viewport then return end
	-- New schema: model name lives under EquipmentData (or could be
	-- absent for non-equippable items). Fall back to bare itemConfig
	-- in case future composition shapes carry a top-level model.
	local modelName = (itemConfig.EquipmentData and itemConfig.EquipmentData.Model) or itemConfig.Model
	if not modelName then return end
	-- Today every item with a viewport uses a weapon model; widen this
	-- once gear/consumable folders land alongside `AssetsShared.Weapons`.
	local sourceFolder = ReplicatedAssets:FindFirstChild('Weapons')
	local model = sourceFolder and sourceFolder:FindFirstChild(modelName) :: Model?
	if not model then return end

	local _, size = model:GetBoundingBox()
	-- 1.4× the longest bounding-box axis keeps the model away from the
	-- frame edges; the 3/4 angle below trades a tiny bit of edge clearance
	-- for a more readable silhouette than the previous straight-on shot.
	local distance = math.max(size.X, size.Y, size.Z, 1) * 1.4

	-- Default viewport CFrame: identity rotates the model 30° around Y for
	-- a 3/4 view so swords/tools read as 3D objects rather than thin lines.
	-- Per-item Display.Viewport.CFrame still wins if the config sets one
	-- explicitly — we only substitute when the caller hasn't picked an angle.
	local configCF = itemConfig.Display.Viewport.CFrame
	local modelCFrame = (configCF and configCF ~= CFrame.identity)
		and configCF
		or CFrame.Angles(0, math.rad(-30), 0) * CFrame.Angles(math.rad(-12), 0, 0)

	-- Slightly elevated camera (Y = distance * 0.25) so we look down at the
	-- model rather than horizontally — gives the asset more presence inside
	-- the small inventory slot.
	local cameraPos = Vector3.new(0, distance * 0.25, distance)
	local cameraCFrame = CFrame.lookAt(cameraPos, modelCFrame.Position)

	ViewportUtility.SetupModelViewport(viewport, model, cameraCFrame, modelCFrame)
end

----------------------------------------------------------------------
-- Build(ctx)
----------------------------------------------------------------------

function Module.Build(ctx)
	local scope = ctx.scope
	local DataVersion = ctx.DataVersion

	-- // Per-tab state // — local to this Build() invocation.
	local SelectedInventoryUUID       = scope:Value(nil)
	local SelectedInventoryCategory   = scope:Value('weapons')
	local SelectedInventoryDetailTab  = scope:Value('overview')
	local InventoryFilterText         = scope:Value('')

	-- // Inventory queries //
	--
	-- `computeInventoryEntries(use, opts)` and `countEntriesByCategory(use)`
	-- are closed over DataVersion so callers only need to hand `use`. Both
	-- assume they're being called INSIDE a Computed that owns `use`.
	local function computeInventoryEntries(use, opts): {any}
		use(DataVersion)
		local data = Utils.getPlayerData()
		if not data or not data.Inventory then return {} end
		local filterCat  = opts and opts.filterCat  or nil
		local filterText = opts and opts.filterText or ''
		filterText = string.lower(filterText or '')
		local hasTextFilter = filterText ~= ''

		-- Set of UUIDs equipped anywhere — lets the slot render an "E" badge.
		-- Reads BOTH `uuid` (canonical, written by PlayerInventoryServer)
		-- and `UUID` (legacy capitalization). The previous code checked
		-- only the legacy form, so the badge never appeared on saves
		-- written by the new flow — same bug masked the equip-toggle UI.
		local equippedSet = {}
		if data.Equipped then
			for _, slotEntry in data.Equipped do
				if typeof(slotEntry) == 'table' then
					local uuid = slotEntry.uuid or slotEntry.UUID
					if uuid then equippedSet[uuid] = true end
				end
			end
		end

		local entries = {}
		local counter = 0
		for itemId, uuidcache in data.Inventory do
			local itemConfig = ItemsConfig.Items[itemId]
			if not itemConfig then continue end
			if filterCat and not bucketsForItem(itemConfig)[filterCat] then continue end
			-- Text filter — case-insensitive substring on display-title OR item-id.
			if hasTextFilter then
				local title = (itemConfig.Display and itemConfig.Display.Title and itemConfig.Display.Title.Text) or itemId
				local haystack = string.lower(tostring(title)) .. ' ' .. string.lower(itemId)
				if string.find(haystack, filterText, 1, true) == nil then continue end
			end
			for uuid, stack in uuidcache do
				counter += 1
				table.insert(entries, {
					uuid = uuid, itemId = itemId, itemConfig = itemConfig,
					stack = stack,
					qtyText = (stack.Quantity and stack.Quantity > 1) and string.format('x%d', stack.Quantity) or '',
					equipped = equippedSet[uuid] == true,
					order = counter,
				})
			end
		end
		return entries
	end

	local function countEntriesByCategory(use): {[string]: number}
		use(DataVersion)
		local data = Utils.getPlayerData()
		local counts = {
			weapons = 0, gear = 0, consum = 0, mats = 0,
			mounts = 0, companions = 0, auras = 0,
		}
		if not data then return counts end
		if typeof(data.Inventory) == 'table' then
			for itemId, uuidcache in data.Inventory do
				local cfg = ItemsConfig.Items[itemId]
				if not cfg then continue end
				-- Multi-bucket: each stack is counted once per bucket it
				-- belongs to. Sum of counts can exceed total stacks — that's
				-- intentional, since the slot-header count tracks "items
				-- reachable from this tab," not a partition of the inventory.
				local buckets = bucketsForItem(cfg)
				for _ in uuidcache do
					for bucket in buckets do
						counts[bucket] = (counts[bucket] or 0) + 1
					end
				end
			end
		end
		-- Embedded categories — count owned entries off the per-system
		-- Owned tables. Same shape across mounts/companions/auras so the
		-- counter is one helper.
		local function countOwned(tbl: any): number
			if typeof(tbl) ~= 'table' then return 0 end
			local n = 0
			for _ in tbl do n += 1 end
			return n
		end
		if typeof(data.Mounts)     == 'table' then counts.mounts     = countOwned(data.Mounts.Owned) end
		if typeof(data.Companions) == 'table' then counts.companions = countOwned(data.Companions.Owned) end
		if typeof(data.Auras)      == 'table' then counts.auras      = countOwned(data.Auras.Owned) end
		return counts
	end

	----------------------------------------------------------------------
	-- Slot renderer — one ViewportFrame per inventory entry.
	----------------------------------------------------------------------
	local function buildInventorySlot(slotScope, entry)
		local uuid = entry.uuid
		local itemConfig = entry.itemConfig
		-- Effective rarity respects forge-level overrides — a high-tier
		-- moonsteel sword forged by a master smith renders with the
		-- legendary palette even though CraftedLongsword's cfg.Rarity is
		-- still Uncommon.
		local effRarity = ItemsConfig.GetEffectiveRarity(itemConfig, entry.stack)
		local rarityColor = Rarities.RarityColors[effRarity] or PALETTE.ink

		local isSelected = slotScope:Computed(function(use)
			return use(SelectedInventoryUUID) == uuid
		end)

		local slot = slotScope:New('TextButton') {
			Name = uuid,
			Size = UDim2.fromScale(1, 0),
			AutoButtonColor = false,
			Text = '',
			BackgroundColor3 = slotScope:Computed(function(use)
				return use(isSelected) and PALETTE.accent or PALETTE.bg0
			end),
			BackgroundTransparency = slotScope:Computed(function(use)
				return use(isSelected) and 0.6 or 0.2
			end),
			BorderSizePixel = 0,
			LayoutOrder = entry.order,
			[Fusion.OnEvent('Activated')] = function()
				-- Clicking the currently-selected slot deselects (toggle).
				if peek(SelectedInventoryUUID) == uuid then
					SelectedInventoryUUID:set(nil)
				else
					SelectedInventoryUUID:set(uuid)
				end
			end,
			[Fusion.Children] = {
				slotScope:New('UIAspectRatioConstraint') { AspectRatio = 1 },
				slotScope:New('UIStroke') {
					Color = slotScope:Computed(function(use)
						return use(isSelected) and PALETTE.accent or rarityColor
					end),
					Transparency = slotScope:Computed(function(use)
						return use(isSelected) and 0 or 0.5
					end),
					Thickness = 1,
				},
				slotScope:New('ViewportFrame') {
					Name = 'Viewport',
					Size = UDim2.fromScale(1, 1),
					BackgroundTransparency = 1,
					Visible = itemConfig.Display and itemConfig.Display.Viewport ~= nil,
				},
				slotScope:New('TextLabel') {
					Name = 'Quantity',
					AnchorPoint = Vector2.new(1, 1),
					Position = UDim2.new(1, -4, 1, -2),
					Size = UDim2.fromOffset(40, 12),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = entry.qtyText,
					TextSize = 11,
					TextColor3 = PALETTE.ink,
					TextXAlignment = Enum.TextXAlignment.Right,
				},
				-- Equipped indicator — gold ★ in the top-left corner so
				-- equipped items are scannable at a glance across a
				-- crowded grid. Replaces the prior small 'E' badge.
				slotScope:New('TextLabel') {
					Name = 'Equipped',
					Position = UDim2.fromOffset(4, 2),
					Size = UDim2.fromOffset(14, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_DISPLAY,
					Text = entry.equipped and '\u{2605}' or '',  -- ★
					TextScaled = true,
					TextColor3 = PALETTE.gold,
					TextStrokeTransparency = 0.4,
					TextStrokeColor3 = PALETTE.bg0,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				-- Tier tag top-right.
				slotScope:New('TextLabel') {
					Name = 'Tier',
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, -4, 0, 2),
					Size = UDim2.fromOffset(28, 10),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = string.format('T%d', effRarity),
					TextSize = 9,
					TextColor3 = rarityColor,
					TextTransparency = 0.4,
					TextXAlignment = Enum.TextXAlignment.Right,
				},
			},
		}

		-- Populate viewport after parent/renderer resolves the ViewportFrame child
		task.defer(function()
			local vp = slot:FindFirstChild('Viewport')
			if vp and vp:IsA('ViewportFrame') then
				setupViewportModel(vp, itemConfig)
			end
		end)

		return slot
	end

	----------------------------------------------------------------------
	-- Category button (WEAPONS / ARMOR & GEAR / CONSUMABLE / MATERIALS)
	----------------------------------------------------------------------
	local function buildCategoryButton(btnScope, cat)
		local isActive = btnScope:Computed(function(use)
			return use(SelectedInventoryCategory) == cat.id
		end)
		local count = btnScope:Computed(function(use)
			local counts = countEntriesByCategory(use)
			return counts[cat.id] or 0
		end)
		return btnScope:New('TextButton') {
			Name = cat.id,
			AutoButtonColor = false,
			Text = '',
			Size = UDim2.fromOffset(0, 32),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = btnScope:Computed(function(use)
				return use(isActive) and PALETTE.accent or Color3.new(0, 0, 0)
			end),
			BackgroundTransparency = btnScope:Computed(function(use)
				return use(isActive) and 0.85 or 0.35
			end),
			BorderSizePixel = 0,
			[Fusion.OnEvent('Activated')] = function()
				SelectedInventoryCategory:set(cat.id)
				SelectedInventoryUUID:set(nil)
			end,
			[Fusion.Children] = {
				btnScope:New('UIStroke') {
					Color = PALETTE.accent,
					Transparency = btnScope:Computed(function(use) return use(isActive) and 0 or 0.7 end),
					Thickness = 1,
				},
				btnScope:New('UIPadding') {
					PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
					PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
				},
				btnScope:New('UIListLayout') {
					FillDirection = Enum.FillDirection.Horizontal,
					Padding = UDim.new(0, 8),
					VerticalAlignment = Enum.VerticalAlignment.Center,
					SortOrder = Enum.SortOrder.LayoutOrder,
				},
				btnScope:New('TextLabel') {
					LayoutOrder = 1,
					Size = UDim2.fromOffset(14, 20),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_DISPLAY, Text = cat.glyph, TextSize = 14,
					TextColor3 = btnScope:Computed(function(use)
						return use(isActive) and PALETTE.accent or PALETTE.ink
					end),
				},
				btnScope:New('TextLabel') {
					LayoutOrder = 2,
					Size = UDim2.fromOffset(0, 20),
					AutomaticSize = Enum.AutomaticSize.X,
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_UI, Text = cat.label, TextSize = 12,
					TextColor3 = btnScope:Computed(function(use)
						return use(isActive) and PALETTE.accent or PALETTE.ink
					end),
				},
				btnScope:New('TextLabel') {
					LayoutOrder = 3,
					Size = UDim2.fromOffset(24, 20),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = btnScope:Computed(function(use) return tostring(use(count)) end),
					TextSize = 10,
					TextColor3 = PALETTE.inkFaint,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
			},
		}
	end

	----------------------------------------------------------------------
	-- Detail pane — huge (hero card, sub-tabs, 4 sub-pages, floating tooltip,
	-- action bar). Kept as a single function because every part references
	-- the same `detailNode` Computed.
	----------------------------------------------------------------------
	local function buildInventoryDetail(detScope)
		local detailNode = detScope:Computed(function(use)
			use(DataVersion)
			local uuid = use(SelectedInventoryUUID)
			if not uuid then return nil end
			local data = Utils.getPlayerData()
			if not data then return nil end
			local stack, itemId = ItemsConfig.FindInventoryItemOfUUID(data.Inventory, uuid)
			if not stack or not itemId then return nil end
			local cfg = ItemsConfig.Items[itemId]
			if not cfg then return nil end
			-- Effective rarity — picks up forge override when set so the
			-- detail pane title block reads 'LEGENDARY' on a high-skill
			-- moonsteel craft instead of the base item's static tier.
			local effRarity = ItemsConfig.GetEffectiveRarity(cfg, stack)
			local rarityName = Rarities.RarityValues[effRarity] or 'Common'
			local rarityColor = Rarities.RarityColors[effRarity] or PALETTE.ink
			return {
				cfg = cfg, stack = stack, itemId = itemId,
				rarityName = rarityName, rarityColor = rarityColor,
			}
		end)

		local titleText = detScope:Computed(function(use)
			local n = use(detailNode)
			if not n then return 'No item selected' end
			return (n.cfg.Display and n.cfg.Display.Title and n.cfg.Display.Title.Text) or n.itemId
		end)
		local rarityText = detScope:Computed(function(use)
			local n = use(detailNode)
			return n and string.upper(n.rarityName) or ''
		end)
		local rarityColorV = detScope:Computed(function(use)
			local n = use(detailNode)
			return n and n.rarityColor or PALETTE.ink
		end)
		-- For CompanionCandy items, append a runtime-resolved line that
		-- names the player's currently-equipped companion. Falls back to
		-- "Equip a companion to feed candy." when no companion is set.
		-- The static config description ("...applies to your equipped
		-- companion.") still shows for context.
		local CompanionsShared = ReplicatedModules.Services.CompanionsShared
		local CompanionsConfig = ReplicatedModules.Data.Companions
		local descText = detScope:Computed(function(use)
			local n = use(detailNode)
			if not n then return '' end
			local base = (n.cfg.Display and n.cfg.Display.Description and n.cfg.Display.Description.Text) or ''
			if n.cfg.Type == 'CompanionCandy' then
				use(DataVersion)
				local data = Utils.getPlayerData()
				local equipped = CompanionsShared and CompanionsShared.GetEquippedId(data) or nil
				local cfg = equipped and CompanionsConfig and CompanionsConfig.Companions[equipped] or nil
				local companionName = cfg and cfg.Display.Name or equipped
				if companionName then
					base = base .. string.format(
						'\n\n→ Will be fed to: %s', tostring(companionName))
				else
					base = base .. '\n\n→ Equip a companion to feed candy.'
				end
			end
			return base
		end)

		-- Stats as 2-col cards. Reference: tabs.jsx InventoryDetail stat grid.
		local statList = detScope:New('Frame') {
			LayoutOrder = 20,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				detScope:New('UIGridLayout') {
					CellSize = UDim2.new(0.5, -3, 0, 36),
					CellPadding = UDim2.fromOffset(6, 6),
					SortOrder = Enum.SortOrder.LayoutOrder,
					HorizontalAlignment = Enum.HorizontalAlignment.Left,
				},
				detScope:ForPairs(
					detScope:Computed(function(use)
						local n = use(detailNode)
						-- Schema migration: derive a Stats-shaped table
						-- from the new EquipmentData/WeaponUsage fields
						-- so this loop stays unchanged.
						-- Pass the stack through so SummarizeWeaponStats can
						-- substitute Composition.Forged.StatSnapshot.Damage
						-- (Stage D) and add Enchants/Resonance rows when set.
						local stats = n and CombatUtility.SummarizeWeaponStats(n.cfg, n.stack) or {}
						local out = {}
						local idx = 0
						for statName, statValue in stats do
							idx += 1
							table.insert(out, { order = idx, name = statName, value = tostring(statValue) })
						end
						return out
					end),
					function(use, innerScope, idx, entry)
						return idx, innerScope:New('Frame') {
							LayoutOrder = entry.order,
							BackgroundColor3 = Color3.new(0, 0, 0),
							BackgroundTransparency = 0.35,
							BorderSizePixel = 0,
							[Fusion.Children] = {
								innerScope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.8, Thickness = 1 },
								innerScope:New('UIPadding') {
									PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
									PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
								},
								innerScope:New('TextLabel') {
									Size = UDim2.new(1, 0, 0, 10),
									BackgroundTransparency = 1,
									FontFace = HUDCommon.FONT_MONO,
									Text = string.upper(entry.name), TextSize = 9,
									TextColor3 = PALETTE.inkFaint,
									TextXAlignment = Enum.TextXAlignment.Left,
								},
								innerScope:New('TextLabel') {
									Position = UDim2.fromOffset(0, 12),
									Size = UDim2.new(1, 0, 0, 16),
									BackgroundTransparency = 1,
									FontFace = HUDCommon.FONT_MONO,
									Text = entry.value, TextSize = 14,
									TextColor3 = PALETTE.accent,
									TextXAlignment = Enum.TextXAlignment.Left,
								},
							},
						}
					end
				),
			},
		}

		-- Derived: which sub-slot index (1=left, 2=right, ...) the
		-- selected item is currently in, or nil if not equipped.
		-- Reads BOTH `uuid` and `UUID` for legacy save compatibility.
		local equippedSlotIndex = detScope:Computed(function(use)
			use(DataVersion)
			local uuid = use(SelectedInventoryUUID)
			if not uuid then return nil end
			local data = Utils.getPlayerData()
			if not data or not data.Equipped then return nil end
			for _, slotEntry in data.Equipped do
				if typeof(slotEntry) == 'table' then
					local entryUuid = slotEntry.uuid or slotEntry.UUID
					if entryUuid == uuid then
						return slotEntry.slot or 1
					end
				end
			end
			return nil
		end)
		local isEquipped = detScope:Computed(function(use)
			return use(equippedSlotIndex) ~= nil
		end)

		-- Weapon-shape predicates. Used to gate the L/R two-button row
		-- (only shown for hand-slot weapons) and the dual-wield label.
		local isHandWeapon = detScope:Computed(function(use)
			local n = use(detailNode); if not n then return false end
			local equip = n.cfg.EquipmentData
			local first = equip and equip.EquipSlots and equip.EquipSlots[1]
			return (first and first.IndexMax and first.IndexMax > 1) and true or false
		end)
		local supportsDualWield = detScope:Computed(function(use)
			local n = use(detailNode); if not n then return false end
			local equip = n.cfg.EquipmentData
			local first = equip and equip.EquipSlots and equip.EquipSlots[1]
			return (first and first.AllowMultiEquip == true and (first.MaxMultiEquip or 0) > 1) and true or false
		end)
		-- Whether ANY currently-equipped weapon is non-dual-wield. The
		-- label warns the player that equipping a new weapon will
		-- auto-unequip the existing one(s) — matches the server-side
		-- eviction rule in PlayerInventoryServer.
		local hasNonDualEquipped = detScope:Computed(function(use)
			use(DataVersion)
			local data = Utils.getPlayerData()
			local eq = (data and data.Equipped) or {}
			for _, slotKey in { '1_Weapon', '2_Weapon' } do
				local entry = eq[slotKey]
				if typeof(entry) == 'table' then
					local cfgId = entry.itemId or entry.ItemId
					local cfg = cfgId and ItemsConfig.Items[cfgId]
					local first = cfg and cfg.EquipmentData and cfg.EquipmentData.EquipSlots
						and cfg.EquipmentData.EquipSlots[1]
					local isDual = first and first.AllowMultiEquip == true and (first.MaxMultiEquip or 0) > 1
					if not isDual then return true end
				end
			end
			return false
		end)

		-- Hotbar accepts only Food / Potion items (per design: skills +
		-- potions + food). The server-side gate in
		-- ClientPersistenceServer.SetHotbarSlot enforces the same rule;
		-- this is the matching client-side predicate so the SET HOTBAR
		-- SLOT button only shows where it'd actually succeed.
		local canBindToHotbar = detScope:Computed(function(use)
			local n = use(detailNode); if not n then return false end
			local cfg = n.cfg
			return ItemsConfig.HasTag(cfg, ItemsConfig.ItemTags.Food)
				or ItemsConfig.HasTag(cfg, ItemsConfig.ItemTags.Potion)
		end)

		-- Whether the selected item is consumable (USE button visible).
		-- The new schema marks consumables via ConsumptionData; ActivationData
		-- (companion candies, return stones, future activatables) routes
		-- through the same UseItem path.
		local canUse = detScope:Computed(function(use)
			local n = use(detailNode); if not n then return false end
			if n.cfg.ConsumptionData then return true end
			if n.cfg.ActivationData  then return true end
			return false
		end)

		-- Whether the selected item can be equipped — only items with
		-- EquipmentData show the EQUIP button. Pure materials, pure
		-- consumables, candies, etc. all hide it. Resolves the
		-- "materials are non-equippable" requirement at the UI layer
		-- (the server would reject the remote anyway, but hiding the
		-- button is the right UX).
		local canEquip = detScope:Computed(function(use)
			local n = use(detailNode); if not n then return false end
			return n.cfg.EquipmentData ~= nil
		end)

		-- Action bar — vertical stack:
		--   Row 1 (button row): EQUIP/UNEQUIP variants, USE, SET HOTBAR SLOT.
		--     For hand-slot weapons: EQUIP LEFT + EQUIP RIGHT (two buttons,
		--     each flips to UNEQUIP X when this uuid sits in that slot,
		--     and HIDES the opposite button when this uuid is equipped on
		--     one side — clicking the visible one unequips, freeing the
		--     opposite to re-appear).
		--     For non-weapon equippables: a single EQUIP/UNEQUIP button.
		--   Row 2 (label): "Supports dual-wield" / "Single-wield only" +
		--     a warning when an existing equipped weapon would be evicted.
		--     Visible only for hand-slot weapons (no value for armor).
		local function makeEquipButton(layoutOrder, slotIndex: number, sideLabel: string)
			-- Per-side button. `slotIndex` is 1 (left) or 2 (right). The
			-- button is visible when the item is a hand-slot weapon AND
			-- the OPPOSITE side doesn't currently hold this uuid.
			return detScope:New('TextButton') {
				LayoutOrder = layoutOrder,
				AutoButtonColor = false,
				BackgroundColor3 = PALETTE.accent,
				BackgroundTransparency = 0.78,
				BorderSizePixel = 0,
				Size = detScope:Computed(function(use)
					return use(canBindToHotbar)
						and UDim2.new(0.325, -3, 1, 0)  -- (0.65 - hotbarBtn)/2
						or UDim2.new(0.5, -3, 1, 0)
				end),
				Visible = detScope:Computed(function(use)
					if not use(isHandWeapon) then return false end
					-- Hide this side when the OTHER side holds this uuid.
					local cur = use(equippedSlotIndex)
					return cur ~= (slotIndex == 1 and 2 or 1)
				end),
				Text = '',
				[Fusion.OnEvent('Activated')] = function()
					local uuid = peek(SelectedInventoryUUID); if not uuid then return end
					-- Always fire with this side's slotIndex. Server's
					-- IsPlayerItemEquipped check routes to unequip when
					-- the uuid is already in any slot — same toggle
					-- semantics as before.
					InventoryEvent:FireServer(uuid, slotIndex)
				end,
				[Fusion.Children] = {
					detScope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0, Thickness = 1 },
					detScope:New('TextLabel') {
						Size = UDim2.fromScale(1, 1),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_UI,
						Text = detScope:Computed(function(use)
							local cur = use(equippedSlotIndex)
							if cur == slotIndex then
								return 'UNEQUIP ' .. sideLabel
							end
							return 'EQUIP ' .. sideLabel
						end),
						TextSize = 12,
						TextColor3 = PALETTE.accent,
					},
				},
			}
		end

		-- Single EQUIP/UNEQUIP for non-hand-weapon equippables. Same
		-- shape as the prior single-button version, just gated on
		-- `not isHandWeapon` so it doesn't double up with the L/R row.
		local singleEquipButton = detScope:New('TextButton') {
			LayoutOrder = 0,
			AutoButtonColor = false,
			BackgroundColor3 = PALETTE.accent,
			BackgroundTransparency = 0.78,
			BorderSizePixel = 0,
			Visible = detScope:Computed(function(use)
				return use(canEquip) and not use(isHandWeapon)
			end),
			Size = detScope:Computed(function(use)
				return use(canBindToHotbar)
					and UDim2.new(0.65, -3, 1, 0)
					or UDim2.fromScale(1, 1)
			end),
			Text = '',
			[Fusion.OnEvent('Activated')] = function()
				local uuid = peek(SelectedInventoryUUID); if not uuid then return end
				InventoryEvent:FireServer(uuid, 1)
			end,
			[Fusion.Children] = {
				detScope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0, Thickness = 1 },
				detScope:New('TextLabel') {
					Size = UDim2.fromScale(1, 1),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_UI,
					Text = detScope:Computed(function(use)
						return use(isEquipped) and 'UNEQUIP' or 'EQUIP'
					end),
					TextSize = 12,
					TextColor3 = PALETTE.accent,
				},
			},
		}

		-- Dual-wield support label. Reads the selected item's spec +
		-- whether anything currently equipped will block multi-equip.
		local dualLabelText = detScope:Computed(function(use)
			if not use(isHandWeapon) then return '' end
			if not use(supportsDualWield) then
				return 'This weapon does NOT support dual-wield · equipping it will unequip your current weapon(s)'
			end
			if use(hasNonDualEquipped) then
				return 'Supports dual-wield · existing non-dual weapon(s) will be unequipped on equip'
			end
			return 'Supports dual-wield · can be held in either or both hands'
		end)
		local dualLabelColor = detScope:Computed(function(use)
			if use(supportsDualWield) and not use(hasNonDualEquipped) then
				return PALETTE.accent
			end
			return PALETTE.gold
		end)

		local actionBar = detScope:New('Frame') {
			LayoutOrder = 90,
			Size = UDim2.new(1, 0, 0, 56),
			BackgroundTransparency = 1,
			Visible = detScope:Computed(function(use) return use(detailNode) ~= nil end),
			[Fusion.Children] = {
				detScope:New('UIListLayout') {
					FillDirection = Enum.FillDirection.Vertical,
					Padding = UDim.new(0, 4),
					SortOrder = Enum.SortOrder.LayoutOrder,
				},
				-- // Row 1: button row. //
				detScope:New('Frame') {
					LayoutOrder = 1,
					Size = UDim2.new(1, 0, 0, 36),
					BackgroundTransparency = 1,
					[Fusion.Children] = {
						detScope:New('UIListLayout') {
							FillDirection = Enum.FillDirection.Horizontal,
							Padding = UDim.new(0, 6),
							SortOrder = Enum.SortOrder.LayoutOrder,
						},
						singleEquipButton,
						makeEquipButton(1, 1, 'LEFT'),
						makeEquipButton(2, 2, 'RIGHT'),
						-- USE — fires ItemUseEvent for consumable items.
						detScope:New('TextButton') {
							LayoutOrder = 3,
							AutoButtonColor = false,
							BackgroundColor3 = PALETTE.gold,
							BackgroundTransparency = 0.78,
							BorderSizePixel = 0,
							Size = UDim2.new(0.35, -3, 1, 0),
							Text = '',
							Visible = canUse,
							[Fusion.OnEvent('Activated')] = function()
								local uuid = peek(SelectedInventoryUUID); if not uuid then return end
								ItemUseEvent:FireServer(uuid)
							end,
							[Fusion.Children] = {
								detScope:New('UIStroke') { Color = PALETTE.gold, Transparency = 0, Thickness = 1 },
								detScope:New('TextLabel') {
									Size = UDim2.fromScale(1, 1),
									BackgroundTransparency = 1,
									FontFace = HUDCommon.FONT_UI,
									Text = 'USE',
									TextSize = 12,
									TextColor3 = PALETTE.gold,
								},
							},
						},
						-- SET HOTBAR SLOT.
						detScope:New('TextButton') {
							LayoutOrder = 4,
							AutoButtonColor = false,
							BackgroundColor3 = PALETTE.bg0,
							BackgroundTransparency = 0.4,
							BorderSizePixel = 0,
							Size = UDim2.new(0.35, -3, 1, 0),
							Text = '',
							Visible = canBindToHotbar,
							[Fusion.OnEvent('Activated')] = function()
								local n = peek(detailNode); if not n then return end
								local uuid = peek(SelectedInventoryUUID); if not uuid then return end
								local HotbarWidget = require(LocalPlayer:WaitForChild('PlayerScripts')
									:WaitForChild('Core'):WaitForChild('Widgets'):WaitForChild('HotbarWidget'))
								HotbarWidget.OpenSlotPicker(function(slotId)
									HotbarWidget.SetSlot(slotId, { type = 'item', uuid = uuid })
								end)
							end,
							[Fusion.Children] = {
								detScope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
								detScope:New('TextLabel') {
									Size = UDim2.fromScale(1, 1),
									BackgroundTransparency = 1,
									FontFace = HUDCommon.FONT_MONO,
									Text = 'SET HOTBAR SLOT',
									TextSize = 11,
									TextColor3 = PALETTE.accent,
								},
							},
						},
					},
				},
				-- // Row 2: dual-wield support label. //
				detScope:New('TextLabel') {
					LayoutOrder = 2,
					Size = UDim2.new(1, 0, 0, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = dualLabelText,
					TextSize = 10,
					TextColor3 = dualLabelColor,
					TextXAlignment = Enum.TextXAlignment.Left,
					Visible = isHandWeapon,
					TextWrapped = true,
				},
			},
		}

		-- Hero card — 140px region with rarity radial glow + ViewportFrame.
		-- LayoutOrder = 1 sits below the sub-tab row (0).
		local heroCard = detScope:New('Frame') {
			LayoutOrder = 1,
			Size = UDim2.new(1, 0, 0, 140),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
			[Fusion.Children] = {
				detScope:New('UIStroke') {
					Color = rarityColorV, Transparency = 0.5, Thickness = 1,
				},
				detScope:New('UIGradient') {
					Color = ColorSequence.new({
						ColorSequenceKeypoint.new(0, Color3.new(0, 0, 0)),
						ColorSequenceKeypoint.new(0.5, Color3.new(0.08, 0.08, 0.12)),
						ColorSequenceKeypoint.new(1, Color3.new(0, 0, 0)),
					}),
					Transparency = NumberSequence.new(0.4),
					Rotation = 90,
				},
				detScope:New('ViewportFrame') {
					Name = 'HeroViewport',
					Size = UDim2.fromScale(1, 1),
					BackgroundTransparency = 1,
					Visible = detScope:Computed(function(use) return use(detailNode) ~= nil end),
				},
				-- Eyebrow top-left: ◆ RARITY
				detScope:New('TextLabel') {
					Position = UDim2.fromOffset(10, 8),
					Size = UDim2.fromOffset(140, 10),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = detScope:Computed(function(use)
						local r = use(rarityText)
						return r ~= '' and ('◆ ' .. r) or ''
					end),
					TextSize = 9,
					TextColor3 = rarityColorV,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				-- Tier mono top-right
				detScope:New('TextLabel') {
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, -10, 0, 8),
					Size = UDim2.fromOffset(80, 10),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = detScope:Computed(function(use)
						local n = use(detailNode)
						if not n then return '' end
						return string.format('T%d', ItemsConfig.GetEffectiveRarity(n.cfg, n.stack))
					end),
					TextSize = 9,
					TextColor3 = rarityColorV,
					TextXAlignment = Enum.TextXAlignment.Right,
				},
				HUDCommon.cornerTick(detScope, 'tl', PALETTE.accent),
				HUDCommon.cornerTick(detScope, 'br', PALETTE.accent),
			},
		}

		-- Re-render the hero viewport whenever the selection changes.
		-- ClearViewport (vs ClearAllChildren) keeps the Camera around — we
		-- still reset the cached "Current" attribute so SetupModelViewport
		-- doesn't short-circuit on a stale match after the model is gone.
		detScope:Observer(detailNode):onChange(function()
			local vp = heroCard:FindFirstChild('HeroViewport') :: ViewportFrame?
			if not vp then return end
			ViewportUtility.ClearViewport(vp)
			vp:SetAttribute('Current', nil)
			local node = Fusion.peek(detailNode)
			if not node then return end
			setupViewportModel(vp, node.cfg)
		end)

		-- // Sub-tab row //
		local subTabButtons = {}
		for i, tabId in DETAIL_SUBTABS do
			local isActive = detScope:Computed(function(use)
				return use(SelectedInventoryDetailTab) == tabId
			end)
			table.insert(subTabButtons, detScope:New('TextButton') {
				Name = 'SubTab_' .. tabId,
				LayoutOrder = i,
				AutoButtonColor = false,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.new(0.25, 0, 1, 0),
				Text = '',
				[Fusion.OnEvent('Activated')] = function()
					SelectedInventoryDetailTab:set(tabId)
				end,
				[Fusion.Children] = {
					detScope:New('TextLabel') {
						Size = UDim2.fromScale(1, 1),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = DETAIL_SUBTAB_LABELS[tabId],
						TextSize = 11,
						TextColor3 = detScope:Computed(function(use)
							return use(isActive) and PALETTE.accent or PALETTE.inkDim
						end),
					},
					-- Underline stripe (visible when active).
					detScope:New('Frame') {
						AnchorPoint = Vector2.new(0.5, 1),
						Position = UDim2.fromScale(0.5, 1),
						Size = UDim2.new(0.7, 0, 0, 2),
						BackgroundColor3 = PALETTE.accent,
						BorderSizePixel = 0,
						Visible = isActive,
					},
				},
			})
		end

		-- Nested-frame split so the bottom accent border doesn't get swept
		-- into the UIListLayout's horizontal flow (a 100%-wide border would
		-- push every tab off-screen to the right — see phase-1 bug fix).
		local tabButtonStrip = detScope:New('Frame') {
			Name = 'TabButtonStrip',
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				detScope:New('UIListLayout') {
					FillDirection = Enum.FillDirection.Horizontal,
					SortOrder = Enum.SortOrder.LayoutOrder,
					HorizontalAlignment = Enum.HorizontalAlignment.Left,
					VerticalAlignment = Enum.VerticalAlignment.Center,
				},
				table.unpack(subTabButtons),
			},
		}
		local subTabRow = detScope:New('Frame') {
			LayoutOrder = 0,
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				tabButtonStrip,
				detScope:New('Frame') {
					Name = 'BottomBorder',
					AnchorPoint = Vector2.new(0, 1),
					Position = UDim2.fromScale(0, 1),
					Size = UDim2.new(1, 0, 0, 1),
					BackgroundColor3 = PALETTE.accent,
					BackgroundTransparency = 0.78,
					BorderSizePixel = 0,
					ZIndex = 0,
				},
			},
		}

		-- // Modifiers chip row (OVERVIEW page) //
		-- Reads live from Composition.Forged.Modifiers when present;
		-- otherwise falls back to BonusTraits from the StatSnapshot
		-- (material trait flags). Empty when neither is set.
		local ModifiersConfig = ReplicatedModules.Data.Modifiers
		local modifierChipsRow = detScope:ForPairs(
			detScope:Computed(function(use)
				local n = use(detailNode)
				if not n or not n.stack or not n.stack.Composition then return {} end
				local forged = n.stack.Composition.Forged
				if not forged then return {} end
				local out = {}
				if typeof(forged.Modifiers) == 'table' then
					for i, m in forged.Modifiers do
						local cfg = ModifiersConfig.Modifiers[m.id]
						if cfg then
							table.insert(out, {
								order = i,
								label = string.format('%s ×%d', cfg.Name, m.level or 1),
								color = cfg.Color,
							})
						end
					end
				end
				if typeof(forged.StatSnapshot) == 'table'
					and typeof(forged.StatSnapshot.BonusTraits) == 'table' then
					for j, trait in forged.StatSnapshot.BonusTraits do
						table.insert(out, {
							order = 100 + j,  -- traits sort after modifiers
							label = trait,
							color = PALETTE.violet,
						})
					end
				end
				return out
			end),
			function(_use, innerScope, idx, chip)
				return idx, innerScope:New('Frame') {
					LayoutOrder = chip.order,
					Size = UDim2.fromOffset(0, 22),
					AutomaticSize = Enum.AutomaticSize.X,
					BackgroundColor3 = PALETTE.bg0,
					BackgroundTransparency = 0.2,
					BorderSizePixel = 0,
					[Fusion.Children] = {
						innerScope:New('UIStroke') { Color = chip.color, Transparency = 0.6, Thickness = 1 },
						innerScope:New('UIPadding') {
							PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
						},
						innerScope:New('TextLabel') {
							Size = UDim2.fromScale(0, 1),
							AutomaticSize = Enum.AutomaticSize.X,
							BackgroundTransparency = 1,
							FontFace = HUDCommon.FONT_UI,
							Text = chip.label,
							TextSize = 11,
							TextColor3 = PALETTE.ink,
						},
					},
				}
			end
		)
		local modifierRow = detScope:New('Frame') {
			Name = 'Modifiers',
			LayoutOrder = 30,
			Size = UDim2.new(1, 0, 0, 44),
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				detScope:New('UIListLayout') {
					FillDirection = Enum.FillDirection.Vertical,
					Padding = UDim.new(0, 4),
					SortOrder = Enum.SortOrder.LayoutOrder,
				},
				detScope:New('TextLabel') {
					LayoutOrder = 1,
					Size = UDim2.new(1, 0, 0, 12),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = '◆ MODIFIERS',
					TextSize = 10,
					TextColor3 = PALETTE.accent,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				detScope:New('Frame') {
					LayoutOrder = 2,
					Size = UDim2.new(1, 0, 0, 24),
					BackgroundTransparency = 1,
					[Fusion.Children] = {
						detScope:New('UIListLayout') {
							FillDirection = Enum.FillDirection.Horizontal,
							Padding = UDim.new(0, 6),
							SortOrder = Enum.SortOrder.LayoutOrder,
						},
						modifierChipsRow,
					},
				},
			},
		}

		-- // OVERVIEW page //
		local overviewPage = detScope:New('Frame') {
			Name = 'OverviewPage',
			LayoutOrder = 10,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Visible = detScope:Computed(function(use)
				return use(SelectedInventoryDetailTab) == 'overview'
					and use(detailNode) ~= nil
			end),
			[Fusion.Children] = {
				detScope:New('UIListLayout') {
					Padding = UDim.new(0, 8),
					SortOrder = Enum.SortOrder.LayoutOrder,
				},
				-- Flavor description (italicized-ish via the display font).
				detScope:New('TextLabel') {
					LayoutOrder = 10,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_DISPLAY,
					Text = descText,
					TextSize = 13,
					TextColor3 = PALETTE.inkDim,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextYAlignment = Enum.TextYAlignment.Top,
					TextWrapped = true,
				},
				(function() statList.LayoutOrder = 20; return statList end)(),
				modifierRow,
				-- "CAN BE OBTAINED FROM" row. Hidden when the cfg has no
				-- Sources tagged so non-authored items don't show an
				-- empty section. Reads `cfg.Sources` (array of
				-- ItemSources enum values), maps each to its display
				-- label, and joins with a middle-dot separator.
				detScope:New('Frame') {
					LayoutOrder = 30,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					BackgroundTransparency = 1,
					Visible = detScope:Computed(function(use)
						local n = use(detailNode); if not n then return false end
						local sources = n.cfg.Sources
						return typeof(sources) == 'table' and #sources > 0
					end),
					[Fusion.Children] = {
						detScope:New('UIListLayout') {
							FillDirection = Enum.FillDirection.Vertical,
							Padding = UDim.new(0, 2),
							SortOrder = Enum.SortOrder.LayoutOrder,
						},
						detScope:New('TextLabel') {
							LayoutOrder = 1,
							Size = UDim2.new(1, 0, 0, 12),
							BackgroundTransparency = 1,
							FontFace = HUDCommon.FONT_MONO,
							Text = '\u{25C6} CAN BE OBTAINED FROM',
							TextSize = 10,
							TextColor3 = PALETTE.accent,
							TextXAlignment = Enum.TextXAlignment.Left,
						},
						detScope:New('TextLabel') {
							LayoutOrder = 2,
							Size = UDim2.new(1, 0, 0, 0),
							AutomaticSize = Enum.AutomaticSize.Y,
							BackgroundTransparency = 1,
							FontFace = HUDCommon.FONT_UI,
							TextSize = 12,
							TextColor3 = PALETTE.inkDim,
							TextXAlignment = Enum.TextXAlignment.Left,
							TextYAlignment = Enum.TextYAlignment.Top,
							TextWrapped = true,
							Text = detScope:Computed(function(use)
								local n = use(detailNode); if not n then return '' end
								local sources = n.cfg.Sources
								if typeof(sources) ~= 'table' then return '' end
								local labels = {}
								for _, srcId in sources do
									local label = ItemsConfig.ItemSourceLabels[srcId]
									if label then labels[#labels + 1] = label end
								end
								return table.concat(labels, ' \u{B7} ')  -- · separator
							end),
						},
					},
				},
			},
		}

		-- // FORGE page — components list + floating cursor-tracking tooltip //
		local HoveredComponent = detScope:Value(nil)
		local hoveredLabelText = detScope:Computed(function(use)
			local k = use(HoveredComponent)
			if not k then return 'Hover a part to see its effect.' end
			for _, c in FORGE_COMPONENTS do
				if c.key == k then return c.tooltip end
			end
			return ''
		end)
		local HoverMousePos = detScope:Value(Vector2.zero)

		local componentRows = {}
		for i, comp in FORGE_COMPONENTS do
			table.insert(componentRows, detScope:New('TextButton') {
				Name = 'Comp_' .. comp.key,
				LayoutOrder = i,
				Size = UDim2.new(1, 0, 0, 44),
				AutoButtonColor = false,
				Text = '',
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.25,
				BorderSizePixel = 0,
				[Fusion.OnEvent('MouseEnter')] = function()
					HoveredComponent:set(comp.key)
				end,
				[Fusion.OnEvent('MouseMoved')] = function(x: number, y: number)
					HoverMousePos:set(Vector2.new(x, y))
				end,
				[Fusion.OnEvent('MouseLeave')] = function()
					if Fusion.peek(HoveredComponent) == comp.key then
						HoveredComponent:set(nil)
					end
				end,
				[Fusion.Children] = {
					detScope:New('UIStroke') { Color = comp.tint, Transparency = 0.55, Thickness = 1 },
					detScope:New('UIPadding') {
						PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
						PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
					},
					-- Material swatch (pixel square, tinted by material).
					detScope:New('Frame') {
						AnchorPoint = Vector2.new(0, 0.5),
						Position = UDim2.fromScale(0, 0.5),
						Size = UDim2.fromOffset(22, 22),
						BackgroundColor3 = comp.tint,
						BorderSizePixel = 0,
						[Fusion.Children] = {
							detScope:New('UIStroke') { Color = comp.tint, Transparency = 0.1, Thickness = 1 },
						},
					},
					detScope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0),
						Position = UDim2.fromOffset(32, 2),
						Size = UDim2.new(1, -112, 0, 10),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = comp.label, TextSize = 9,
						TextColor3 = PALETTE.inkFaint,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					detScope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0),
						Position = UDim2.fromOffset(32, 14),
						Size = UDim2.new(1, -112, 0, 14),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_UI,
						Text = comp.material, TextSize = 13,
						TextColor3 = comp.tint,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					-- Bonus stat, right-aligned.
					detScope:New('TextLabel') {
						AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.new(1, 0, 0.5, 0),
						Size = UDim2.fromOffset(96, 16),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = comp.bonus, TextSize = 11,
						TextColor3 = PALETTE.accent,
						TextXAlignment = Enum.TextXAlignment.Right,
					},
				},
			})
		end

		local forgeBackBtn = detScope:New('TextButton') {
			LayoutOrder = 1,
			Size = UDim2.new(1, 0, 0, 28),
			AutoButtonColor = false,
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = 0.4,
			BorderSizePixel = 0,
			FontFace = HUDCommon.FONT_MONO,
			Text = '◂  BACK TO OVERVIEW',
			TextSize = 11,
			TextColor3 = PALETTE.inkDim,
			TextXAlignment = Enum.TextXAlignment.Left,
			[Fusion.OnEvent('Activated')] = function()
				SelectedInventoryDetailTab:set('overview')
			end,
			[Fusion.Children] = {
				detScope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.78, Thickness = 1 },
				detScope:New('UIPadding') {
					PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
				},
			},
		}
		local forgeEyebrow = detScope:New('TextLabel') {
			LayoutOrder = 2,
			Size = UDim2.new(1, 0, 0, 14),
			BackgroundTransparency = 1,
			FontFace = HUDCommon.FONT_MONO,
			Text = '◆ FORGE COMPONENTS',
			TextSize = 10,
			TextColor3 = PALETTE.accent,
			TextXAlignment = Enum.TextXAlignment.Left,
		}
		local forgeComponentsScroll = detScope:New('ScrollingFrame') {
			Name = 'ForgeComponentsScroll',
			LayoutOrder = 3,
			Size = UDim2.new(1, 0, 1, -54),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			CanvasSize = UDim2.fromScale(0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = PALETTE.accent,
			ElasticBehavior = Enum.ElasticBehavior.Never,
			[Fusion.Children] = {
				detScope:New('UIListLayout') {
					Padding = UDim.new(0, 4),
					SortOrder = Enum.SortOrder.LayoutOrder,
				},
				detScope:New('UIPadding') { PaddingRight = UDim.new(0, 6) },
				table.unpack(componentRows),
			},
		}

		local forgePage = detScope:New('Frame') {
			Name = 'ForgePage',
			LayoutOrder = 10,
			Size = UDim2.new(1, 0, 1, -240),
			BackgroundTransparency = 1,
			Visible = detScope:Computed(function(use)
				return use(SelectedInventoryDetailTab) == 'forge'
					and use(detailNode) ~= nil
			end),
			[Fusion.Children] = {
				detScope:New('UIListLayout') {
					Padding = UDim.new(0, 6),
					SortOrder = Enum.SortOrder.LayoutOrder,
				},
				forgeBackBtn,
				forgeEyebrow,
				forgeComponentsScroll,
			},
		}

		-- GEMS / ENCHANTS — live Composition views (Stage E of ARTISAN.md).
		-- Read-only: editing happens at the workstation widgets. Falls
		-- back to a "no <system> applied yet" hint when the selected
		-- item has no Composition.<sub-table>.

		-- Lazy catalog requires (placed inline so they're scoped to this
		-- builder rather than module-load time — keeps the upper file
		-- imports clean).
		local EnchantsConfig = ReplicatedModules.Data.Enchants
		local GemsConfig     = ReplicatedModules.Data.Gems
		local EnchantShared  = ReplicatedModules.Services.EnchantShared

		-- Builds a list of {label, valueText} rows for a Composition
		-- sub-system. Returns nil when the sub-table is missing —
		-- caller renders an empty-state hint.
		local function getEnchantRows(node)
			if not node or not node.stack or not node.stack.Composition then return nil end
			local entries = (node.stack.Composition.Enchants and node.stack.Composition.Enchants.Entries) or {}
			if #entries == 0 then return {} end
			local rows = {}
			for _, e in entries do
				local cfg = EnchantsConfig.Enchants[e.Id]
				local name = (cfg and cfg.Name) or e.Id
				local desc = EnchantShared.FormatDescription(e.Id, e.Level or 1)
				table.insert(rows, {
					label = string.format('%s · LV %d', name, e.Level or 1),
					value = desc,
					color = (cfg and cfg.Color) or PALETTE.accent,
				})
			end
			return rows
		end

		local function getSocketRows(node)
			if not node or not node.stack or not node.stack.Composition then return nil end
			local socketing = node.stack.Composition.Socketing
			if not socketing or typeof(socketing.Slots) ~= 'table' then return {} end
			local rows = {}
			for i, slot in socketing.Slots do
				local label = string.format('Socket %d (%s)', i, tostring(slot.Color or 'any'))
				local valueText = '— empty —'
				local valueColor = PALETTE.inkFaint
				if slot.GemUuid then
					-- Resolve gem name via inventory + catalog. Mirrors
					-- the GemSocketServer.makeGemLookup path on the client.
					local data = Utils.getPlayerData()
					local gemStack, gemItemId = data and ItemsConfig.FindInventoryItemOfUUID(data.Inventory or {}, slot.GemUuid)
					if gemItemId then
						local cfg = ItemsConfig.Items[gemItemId]
						local meta = ItemsConfig.GetGem(cfg)
						local gemCfg = meta and GemsConfig.Gems[meta.Id]
						if gemCfg then
							valueText = gemCfg.Name
							valueColor = gemCfg.Color
						end
					end
				end
				table.insert(rows, { label = label, value = valueText, color = valueColor })
			end
			-- Resonance row at the end.
			if socketing.ResonanceBonus and socketing.ResonanceBonus.Active then
				local rb = socketing.ResonanceBonus
				table.insert(rows, {
					label = 'RESONANCE',
					value = string.format('%s ×%.2f', tostring(rb.Active), rb.Multiplier or 1),
					color = PALETTE.gold,
				})
			end
			return rows
		end

		-- Generic "list of label/value rows OR empty-state hint" page.
		-- Both gems and enchants share this shape — passing a different
		-- row provider + empty-state hint per page.
		local function buildCompositionPage(pageId, emptyHint, rowsProvider)
			return detScope:New('Frame') {
				Name = pageId .. 'Page',
				LayoutOrder = 10,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				Visible = detScope:Computed(function(use)
					return use(SelectedInventoryDetailTab) == pageId
						and use(detailNode) ~= nil
				end),
				[Fusion.Children] = {
					detScope:New('UIListLayout') {
						Padding = UDim.new(0, 4),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					detScope:ForPairs(
						detScope:Computed(function(use)
							local n = use(detailNode)
							local rows = rowsProvider(n)
							if rows == nil then return {} end
							if #rows == 0 then
								return { { order = 1, label = '', value = emptyHint, color = PALETTE.inkFaint } }
							end
							for i, r in rows do r.order = i end
							return rows
						end),
						function(_use, innerScope, idx, row)
							return idx, innerScope:New('Frame') {
								LayoutOrder = row.order,
								Size = UDim2.new(1, 0, 0, 32),
								BackgroundColor3 = Color3.new(0, 0, 0),
								BackgroundTransparency = 0.4,
								BorderSizePixel = 0,
								[Fusion.Children] = {
									innerScope:New('UIStroke') { Color = row.color, Transparency = 0.55, Thickness = 1 },
									innerScope:New('UIPadding') {
										PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
									},
									innerScope:New('TextLabel') {
										Size = UDim2.new(0.45, 0, 1, 0),
										BackgroundTransparency = 1,
										FontFace = HUDCommon.FONT_MONO,
										Text = row.label, TextSize = 11,
										TextColor3 = PALETTE.inkFaint,
										TextXAlignment = Enum.TextXAlignment.Left,
									},
									innerScope:New('TextLabel') {
										AnchorPoint = Vector2.new(1, 0),
										Position = UDim2.new(1, 0, 0, 0),
										Size = UDim2.new(0.55, 0, 1, 0),
										BackgroundTransparency = 1,
										FontFace = HUDCommon.FONT_UI,
										Text = row.value, TextSize = 12,
										TextColor3 = row.color,
										TextXAlignment = Enum.TextXAlignment.Right,
										TextTruncate = Enum.TextTruncate.AtEnd,
									},
								},
							}
						end
					),
				},
			}
		end

		local gemsPage     = buildCompositionPage('gems',     '◆ No gems socketed.',  getSocketRows)
		local enchantsPage = buildCompositionPage('enchants', '◆ No enchants applied.', getEnchantRows)

		-- Action bar hides when on the FORGE sub-tab (which has its own back
		-- button). `Hydrate` layers this visibility on top of the existing
		-- "hide when no selection" binding inside `actionBar`.
		local actionBarVisible = detScope:Computed(function(use)
			if use(detailNode) == nil then return false end
			if use(SelectedInventoryDetailTab) == 'forge' then return false end
			-- Hide the strip entirely when no action button is visible
			-- (pure material, no use/equip/hotbar affordance) — otherwise
			-- a 36 px empty bar shows.
			return use(canEquip) or use(canUse) or use(canBindToHotbar)
		end)
		detScope:Hydrate(actionBar) { Visible = actionBarVisible }

		-- // Floating tooltip //
		-- Parented to the panel ROOT (outside the children UIListLayout), so
		-- its explicit Position is honored. Subtracts GuiInset from mouse Y
		-- because MouseMoved delivers inset-INCLUDED coords while
		-- AbsolutePosition (with IgnoreGuiInset=true) is inset-EXCLUDED —
		-- without the subtraction the tooltip would float ~36 px below the
		-- cursor on desktop.
		local tooltipFrame
		tooltipFrame = detScope:New('Frame') {
			Name = 'ForgeTooltip',
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = 0.1,
			BorderSizePixel = 0,
			ZIndex = 50,
			AnchorPoint = Vector2.new(0, 0),
			Position = detScope:Computed(function(use)
				local mouse = use(HoverMousePos)
				local parentAbs = tooltipFrame
					and tooltipFrame.Parent
					and (tooltipFrame.Parent :: GuiObject).AbsolutePosition
					or Vector2.zero
				local topbarInset = GuiService:GetGuiInset()
				local x = mouse.X - parentAbs.X - topbarInset.X + 4
				local y = mouse.Y - parentAbs.Y - topbarInset.Y + 30
				return UDim2.fromOffset(math.floor(x), math.floor(y))
			end),
			Size = UDim2.fromOffset(220, 60),
			AutomaticSize = Enum.AutomaticSize.Y,
			Visible = detScope:Computed(function(use)
				return use(HoveredComponent) ~= nil
			end),
			[Fusion.Children] = {
				detScope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
				detScope:New('UIPadding') {
					PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
					PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
				},
				detScope:New('TextLabel') {
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_UI,
					Text = hoveredLabelText,
					TextSize = 12,
					TextColor3 = PALETTE.ink,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextYAlignment = Enum.TextYAlignment.Top,
					TextWrapped = true,
				},
			},
		}

		local panel = HUDCommon.chiseledPanel(detScope, {
			Name = 'Detail',
			Size = UDim2.fromScale(1, 1),
			AccentColor = PALETTE.accent,
			Children = {
				detScope:New('UIPadding') {
					PaddingTop    = UDim.new(0, 16),
					PaddingBottom = UDim.new(0, 16),
					PaddingLeft   = UDim.new(0, 16),
					PaddingRight  = UDim.new(0, 16),
				},
				detScope:New('UIListLayout') {
					Padding = UDim.new(0, 8),
					SortOrder = Enum.SortOrder.LayoutOrder,
				},
				heroCard,
				detScope:New('TextLabel') {
					Name = 'Title',
					LayoutOrder = 1,
					Size = UDim2.new(1, 0, 0, 28),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_DISPLAY,
					Text = titleText,
					TextSize = 22,
					TextColor3 = rarityColorV,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
				},
				detScope:New('TextLabel') {
					Name = 'TypeLine',
					LayoutOrder = 2,
					Size = UDim2.new(1, 0, 0, 12),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = detScope:Computed(function(use)
						local n = use(detailNode)
						if not n then return '' end
						-- Schema migration: derive type label from the
						-- presence of EquipmentData / ConsumptionData /
						-- ActivationData (the flat `Type` field is gone).
						local t = CombatUtility.GetItemTypeLabel(n.cfg)
						return string.upper(tostring(t)) .. ' · ' .. string.upper(n.rarityName or '')
					end),
					TextSize = 10,
					TextColor3 = PALETTE.inkFaint,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				-- Sub-tabs only render when an item is selected.
				(function()
					detScope:Hydrate(subTabRow) {
						Visible = detScope:Computed(function(use)
							return use(detailNode) ~= nil
						end),
					}
					return subTabRow
				end)(),
				overviewPage,
				forgePage,
				gemsPage,
				enchantsPage,
				(function() actionBar.LayoutOrder = 90; return actionBar end)(),
			},
		})

		-- Parent the floating tooltip to the panel ROOT (outside the inner
		-- children wrapper where UIListLayout would override its Position).
		tooltipFrame.Parent = panel

		return panel
	end

	----------------------------------------------------------------------
	-- Tab shell
	----------------------------------------------------------------------

	-- Two category rows: primary (item buckets) and secondary (embedded
	-- mount/companion/aura tabs). Both flow horizontally inside their own
	-- UIListLayout-driven frame so each fills the leftColumn's width.
	local function buildCategoryRowFrame(categories)
		return scope:New('Frame') {
			Size = UDim2.new(1, 0, 0, 32),
			BackgroundTransparency = 1,
			[Fusion.Children] = (function()
				local kids = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Horizontal,
						Padding = UDim.new(0, 4),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
				}
				for i, cat in categories do
					local btn = buildCategoryButton(scope, cat)
					btn.LayoutOrder = i
					table.insert(kids, btn)
				end
				return kids
			end)(),
		}
	end
	local primaryCategoryRow   = buildCategoryRowFrame(INVENTORY_PRIMARY_CATEGORIES)
	local secondaryCategoryRow = buildCategoryRowFrame(INVENTORY_SECONDARY_CATEGORIES)

	-- Filter row — full-width TextBox that fills the leftColumn (same
	-- width as gridScroll below). Sits between the category rows and
	-- the slot-header count line. Hidden when an embedded category is
	-- active since each embedded tab has its own filter chips.
	local filterRow = scope:New('TextBox') {
		Name = 'FilterBox',
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.4,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		FontFace = HUDCommon.FONT_MONO,
		PlaceholderText = '⌕  filter inventory...',
		PlaceholderColor3 = PALETTE.inkFaint,
		Text = '',
		TextSize = 12,
		TextColor3 = PALETTE.ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		[Fusion.OnChange('Text')] = function(newText: string)
			InventoryFilterText:set(newText or '')
		end,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.6, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 10),
			},
		},
	}

	local slotHeader = scope:New('TextLabel') {
		Size = UDim2.new(1, 0, 0, 14),
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_MONO,
		Text = scope:Computed(function(use)
			local cat = use(SelectedInventoryCategory)
			local counts = countEntriesByCategory(use)
			local catLabel = 'INVENTORY'
			-- Scan both rows (primary item buckets + secondary embedded
			-- categories) so the header still shows the right label when
			-- the user is on a mounts/companions/auras tab.
			for _, c in INVENTORY_PRIMARY_CATEGORIES do
				if c.id == cat then catLabel = c.label; break end
			end
			for _, c in INVENTORY_SECONDARY_CATEGORIES do
				if c.id == cat then catLabel = c.label; break end
			end
			-- Inventory is unlimited — show a "SLOTS USED" count.
			local n = counts[cat] or 0
			return string.format('◆ %s · %d SLOT%s USED', catLabel, n, n == 1 and '' or 'S')
		end),
		TextSize = 10,
		TextColor3 = PALETTE.accent,
		TextXAlignment = Enum.TextXAlignment.Left,
	}

	-- gridScroll height accounting (everything in leftColumn above it):
	--   primary cat row (32) + gap (10)
	--   secondary cat row (32) + gap (10)
	--   filter row (32) + gap (10)
	--   slot header (14) + gap (10)
	--   = 150 px. Express as a constant so adding/removing a row above
	--   only requires updating one line.
	local GRID_TOP_INSET = 32 + 10 + 32 + 10 + 32 + 10 + 14 + 10  -- = 150
	local gridScroll = scope:New('ScrollingFrame') {
		Name = 'Grid',
		Size = UDim2.new(1, 0, 1, -GRID_TOP_INSET),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.fromScale(0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = PALETTE.accent,
		LayoutOrder = 5,
		[Fusion.Children] = {
			scope:New('UIGridLayout') {
				CellSize = UDim2.fromOffset(64, 64),
				CellPadding = UDim2.fromOffset(4, 4),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:ForPairs(
				scope:Computed(function(use)
					return computeInventoryEntries(use, {
						filterCat  = use(SelectedInventoryCategory),
						filterText = use(InventoryFilterText),
					})
				end),
				function(use, innerScope, idx, entry)
					return entry.uuid, buildInventorySlot(innerScope, entry)
				end
			),
		},
	}

	-- Visible-gate the items-grid + detail pane on whether the
	-- selected category is a normal inventory bucket. When the player
	-- selects MOUNTS / COMPANIONS / AURAS, the items grid + detail
	-- pane hide and the embedded tab takes over the area below the
	-- category row.
	local isItemCategory = scope:Computed(function(use)
		return not EMBEDDED_CATEGORIES[use(SelectedInventoryCategory)]
	end)
	local isMountsCategory = scope:Computed(function(use)
		return use(SelectedInventoryCategory) == 'mounts'
	end)
	local isCompanionsCategory = scope:Computed(function(use)
		return use(SelectedInventoryCategory) == 'companions'
	end)
	local isAurasCategory = scope:Computed(function(use)
		return use(SelectedInventoryCategory) == 'auras'
	end)

	-- Both category rows always render (the user always has access to
	-- switch). The filter row, slotHeader, and gridScroll all hide when
	-- an embedded category is active — embedded tabs own their own
	-- filter chips + content area.
	scope:Hydrate(filterRow)  { Visible = isItemCategory }
	scope:Hydrate(slotHeader) { Visible = isItemCategory }
	scope:Hydrate(gridScroll) { Visible = isItemCategory }

	local leftColumn = scope:New('Frame') {
		Name = 'Left',
		Size = UDim2.fromScale((DESIGN_W - RIGHT_COL_PX - IMPLICIT_GAP_PX) / DESIGN_W, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder },
			(function() primaryCategoryRow.LayoutOrder   = 1; return primaryCategoryRow   end)(),
			(function() secondaryCategoryRow.LayoutOrder = 2; return secondaryCategoryRow end)(),
			(function() filterRow.LayoutOrder            = 3; return filterRow            end)(),
			(function() slotHeader.LayoutOrder           = 4; return slotHeader           end)(),
			gridScroll,
		},
	}

	-- ctx.embedded = true suppresses each tab's outer padding so it doesn't
	-- compound with InventoryTab's.
	local embedCtx = setmetatable({ embedded = true }, { __index = ctx })
	local mountsContent     = MountsTab.Build(embedCtx)
	local companionsContent = CompanionsTab.Build(embedCtx)
	local aurasContent      = AurasTab.Build(embedCtx)

	-- Embed sits below both category rows: 32 + 10 + 32 + 10 = 84 px inset.
	local EMBED_TOP_INSET  = 32 + 10 + 32 + 10
	local embedTopScale    = EMBED_TOP_INSET / DESIGN_H
	local embedHeightScale = 1 - embedTopScale
	local embedCenterY     = embedTopScale + embedHeightScale / 2
	local function wrapEmbed(frame, visibleBinding)
		frame.Name = 'EmbeddedTab'
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.Position = UDim2.fromScale(0.5, embedCenterY)
		frame.Size = UDim2.fromScale(1, embedHeightScale)
		scope:Hydrate(frame) { Visible = visibleBinding }
		return frame
	end

	return scope:New('Frame') {
		Name = 'InventoryTab',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(24 / OUTER_H, 0),
				PaddingBottom = UDim.new(24 / OUTER_H, 0),
				PaddingLeft   = UDim.new(32 / OUTER_W, 0),
				PaddingRight  = UDim.new(32 / OUTER_W, 0),
			},
			leftColumn,
			-- Right detail pane only visible when on an item category.
			scope:New('Frame') {
				Name = 'Right',
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, 0, 0, 0),
				Size = UDim2.fromScale(RIGHT_COL_PX / DESIGN_W, 1),
				BackgroundTransparency = 1,
				Visible = isItemCategory,
				[Fusion.Children] = { buildInventoryDetail(scope) },
			},
			-- Embedded mount/companion/aura overlay panes.
			wrapEmbed(mountsContent,     isMountsCategory),
			wrapEmbed(companionsContent, isCompanionsCategory),
			wrapEmbed(aurasContent,      isAurasCategory),
		},
	}
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/TabWidget/LeaderboardTab.luau"><![CDATA[-- // TabWidget/LeaderboardTab.luau //
-- Two-column leaderboard screen:
--   left  — category rail (Total Damage / PvP / Highest Level / …)
--   right — top-N rank list for the selected category
--
-- Data source: the public 'Leaderboard' ReplicatedData category,
-- written by LeaderboardServer once per CycleSec. The tab re-renders
-- whenever ReplicatedData.OnUpdated fires for that category (server
-- publish). DataVersion bumps on the TabWidget shell don't drive the
-- list — the leaderboard cycle is independent of per-player save
-- replication.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local LeaderboardConfig = ReplicatedModules.Data.LeaderboardConfig
local ReplicatedData = ReplicatedModules.Services.ReplicatedData

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local LeaderboardClient = LocalModules.Modules.LeaderboardClient
local PALETTE   = HUDCommon.PALETTE

local Components = require(script.Parent:WaitForChild('components'))

local Module = {}

----------------------------------------------------------------------
-- Helpers — value formatting per category. Most are integer counters;
-- PlayTime is rendered as Hh Mm rather than raw seconds for legibility.
----------------------------------------------------------------------
local function formatHMS(secs: number): string
	local h = math.floor(secs / 3600)
	local m = math.floor((secs % 3600) / 60)
	if h > 0 then return string.format('%dh %dm', h, m) end
	if m > 0 then return string.format('%dm', m) end
	return string.format('%ds', math.floor(secs))
end

local function formatNumber(n: number): string
	-- Compact for big numbers (12.3K, 4.5M) so the row chrome doesn't
	-- get pushed by a 9-digit gold count.
	if n >= 1e6 then return string.format('%.1fM', n / 1e6) end
	if n >= 1e4 then return string.format('%.1fK', n / 1e3) end
	return tostring(math.floor(n))
end

local function formatValue(categoryId: string, n: number): string
	if categoryId == 'PlayTime' then return formatHMS(n) end
	return formatNumber(n)
end

----------------------------------------------------------------------
-- Atom: a single leaderboard row. Rank pip + name + value. Highlights
-- the LocalPlayer's row in gold.
----------------------------------------------------------------------
local function buildRow(scope, rank: number, entry: any, categoryId: string)
	local isYou = entry.userId == LocalPlayer.UserId
	local nameText = entry.name and string.upper(entry.name) or string.format('#%d', entry.userId)
	-- Top-3 chrome: gold/silver/bronze rank pip; everyone else uses the
	-- plain rank number. Visual hierarchy without a separate atom.
	local rankColor = (rank == 1 and Color3.fromRGB(255, 215, 138))
		or (rank == 2 and Color3.fromRGB(196, 204, 220))
		or (rank == 3 and Color3.fromRGB(196, 134, 86))
		or PALETTE.inkFaint
	return scope:New('Frame') {
		Name = 'Row_' .. rank,
		Size = UDim2.new(1, 0, 0, 28),
		BackgroundColor3 = isYou and PALETTE.gold or PALETTE.bg1,
		BackgroundTransparency = isYou and 0.78 or 0.2,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') {
				Color = isYou and PALETTE.gold or PALETTE.accent,
				Transparency = isYou and 0.4 or 0.82, Thickness = 1,
			},
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
			},
			scope:New('TextLabel') {
				Size = UDim2.fromScale(0.10, 1),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = string.format('%02d', rank),
				TextSize = 13,
				TextColor3 = rankColor,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
			scope:New('TextLabel') {
				Position = UDim2.fromScale(0.12, 0),
				Size = UDim2.fromScale(0.58, 1),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = nameText,
				TextSize = 13,
				TextColor3 = isYou and PALETTE.gold or PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
				TextTruncate = Enum.TextTruncate.AtEnd,
			},
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.fromScale(1, 0),
				Size = UDim2.fromScale(0.30, 1),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = formatValue(categoryId, entry.value),
				TextSize = 13,
				TextColor3 = isYou and PALETTE.gold or PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Right,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
		},
	}
end

----------------------------------------------------------------------
-- Build entry. Returns the tab Frame for the TabWidget shell.
----------------------------------------------------------------------
function Module.Build(ctx)
	local s = ctx.scope
	assert(s, 'LeaderboardTab.Build expects ctx.scope')

	-- SnapshotVersion bumps every time ReplicatedData reports a
	-- 'Leaderboard' update — drives the right-side row list rebuild.
	-- Decoupled from ctx.DataVersion (which tracks PlayerData) so
	-- per-player saves don't trigger a leaderboard re-fetch.
	local SnapshotVersion = s:Value(0)
	local SelectedCategory = s:Value(LeaderboardConfig.Categories[1] and LeaderboardConfig.Categories[1].Id or '')

	-- Subscribe ReplicatedData updates. Cleanup registered with the
	-- scope so the connection drops on TabWidget tear-down (theme
	-- rebuild, widget close).
	local conn = ReplicatedData.OnUpdated:Connect(function(category)
		if category == LeaderboardConfig.PublicCategory then
			SnapshotVersion:set((Fusion.peek(SnapshotVersion) or 0) + 1)
		end
	end)
	table.insert(s :: any, function() conn:Disconnect() end)

	-- Rail buttons — one per category. Each button switches
	-- SelectedCategory. Active state styled by the shared RailButton
	-- component (active stripe + accent label).
	local railChildren: {any} = {
		s:New('UIListLayout') {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
		},
	}
	for _, def in LeaderboardConfig.Categories do
		local capturedDef = def
		local isActive = s:Computed(function(use)
			return use(SelectedCategory) == capturedDef.Id
		end)
		table.insert(railChildren, Components.RailButton(s, {
			isActive = isActive,
			label = capturedDef.Label,
			glyph = '◆',
			onActivate = function() SelectedCategory:set(capturedDef.Id) end,
			height = 38,
			-- Shape-lock + scale: rail content width ≈ 0.22·1394 − 12 px padding
			-- ≈ 294 px, height 38 → aspect ≈ 7.74. Button + scaled internals
			-- track the panel instead of staying fixed-pixel.
			aspectRatio = 294 / 38,
		}))
	end

	-- "Last updated" eyebrow — shows how stale the snapshot is so
	-- players know when to expect the next refresh.
	local updatedText = s:Computed(function(use)
		use(SnapshotVersion)
		local snap = LeaderboardClient.GetSnapshot()
		local t = (typeof(snap) == 'table' and tonumber(snap.Updated)) or 0
		if t == 0 then return '◆ AWAITING FIRST PUBLISH' end
		local delta = math.max(0, os.time() - t)
		if delta < 60 then return string.format('◆ UPDATED %ds AGO', delta) end
		return string.format('◆ UPDATED %dm AGO', math.floor(delta / 60))
	end)

	-- Right column entry rows. Rebuilds when either the snapshot
	-- changes or the selected category changes.
	local rowsChildren = s:Computed(function(use)
		local _ = use(SnapshotVersion)
		local catId = use(SelectedCategory)
		local entries = LeaderboardClient.GetCategoryEntries(catId)
		local children: {any} = {
			s:New('UIListLayout') {
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 4),
			},
		}
		if #entries == 0 then
			table.insert(children, s:New('TextLabel') {
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = 'Awaiting first publish — board fills on the next cycle.',
				TextSize = 13,
				TextColor3 = PALETTE.inkFaint,
				TextXAlignment = Enum.TextXAlignment.Left,
			})
		else
			for rank, entry in entries do
				table.insert(children, buildRow(s, rank, entry, catId))
			end
		end
		return children
	end)

	return s:New('Frame') {
		Name = 'LeaderboardTab',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			-- Left rail.
			s:New('Frame') {
				Name = 'CategoryRail',
				AnchorPoint = Vector2.new(0, 0),
				Position = UDim2.fromScale(0, 0),
				Size = UDim2.fromScale(0.22, 1),
				BackgroundColor3 = PALETTE.bg1,
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					s:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.82, Thickness = 1 },
					s:New('UIPadding') {
						PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 14),
						PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 8),
					},
					table.unpack(railChildren),
				},
			},
			-- Right list — header + rows.
			s:New('Frame') {
				Name = 'List',
				Position = UDim2.fromScale(0.24, 0),
				Size = UDim2.fromScale(0.76, 1),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					s:New('UIPadding') {
						PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
						PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
					},
					s:New('UIListLayout') {
						SortOrder = Enum.SortOrder.LayoutOrder,
						Padding = UDim.new(0, 6),
					},
					-- Eyebrow row: category label + updated-ago.
					s:New('Frame') {
						LayoutOrder = 1,
						Size = UDim2.new(1, 0, 0, 20),
						BackgroundTransparency = 1,
						[Fusion.Children] = {
							s:New('TextLabel') {
								Size = UDim2.fromScale(0.6, 1),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_DISPLAY,
								Text = s:Computed(function(use)
									local id = use(SelectedCategory)
									local def = LeaderboardConfig.GetCategory(id)
									return string.upper(def and def.Label or '')
								end),
								TextSize = 18,
								TextColor3 = PALETTE.ink,
								TextXAlignment = Enum.TextXAlignment.Left,
							},
							s:New('TextLabel') {
								AnchorPoint = Vector2.new(1, 0),
								Position = UDim2.fromScale(1, 0),
								Size = UDim2.fromScale(0.4, 1),
								BackgroundTransparency = 1,
								FontFace = HUDCommon.FONT_MONO,
								Text = updatedText,
								TextSize = 11,
								TextColor3 = PALETTE.inkFaint,
								TextXAlignment = Enum.TextXAlignment.Right,
								TextYAlignment = Enum.TextYAlignment.Center,
							},
						},
					},
					-- Scrolling row list. Auto canvas Y grows with rows;
					-- each row is fixed-height so 25 entries fit without
					-- compression at the design canvas.
					s:New('ScrollingFrame') {
						LayoutOrder = 2,
						Size = UDim2.new(1, 0, 1, -28),
						BackgroundTransparency = 1,
						BorderSizePixel = 0,
						ScrollBarThickness = 4,
						ScrollBarImageColor3 = PALETTE.accent,
						ScrollBarImageTransparency = 0.5,
						CanvasSize = UDim2.fromScale(0, 0),
						AutomaticCanvasSize = Enum.AutomaticSize.Y,
						ScrollingDirection = Enum.ScrollingDirection.Y,
						ElasticBehavior = Enum.ElasticBehavior.Never,
						[Fusion.Children] = rowsChildren,
					},
				},
			},
		},
	}
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/TabWidget/MountsTab.luau"><![CDATA[-- // TabWidget/MountsTab.luau //
-- Mount browser. Two-column layout: left = grid of owned mounts (filterable
-- by Land/Flight), right = selected mount's stat readout + Equip/Dismount
-- button. Reads from PlayerData.Mounts via ReplicatedData.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local peek   = Fusion.peek

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local MountsShared = ReplicatedModules.Services.MountsShared
local MountsConfig = ReplicatedModules.Data.Mounts
local Utils = require(script.Parent.utils)

local Module = {}

-- 1394×648 outer canvas, 1330×600 inner after 32/24 UIPadding.
local OUTER_W, OUTER_H   = 1394, 648
local DESIGN_W, DESIGN_H = 1330, 600
local LEFT_COL_PX        = 320
local COL_GAP_PX         = 16

local KIND_LABELS = { all = 'All', land = 'Land', flight = 'Flight' }
local KINDS = { 'all', 'land', 'flight' }

local function getOwnedMountsList(saveData)
	local out = {}
	if typeof(saveData) ~= 'table' then return out end
	local owned = (saveData.Mounts and saveData.Mounts.OwnedMounts) or {}
	for mountId, _ in owned do
		local cfg = MountsConfig.Mounts[mountId]
		if cfg then
			table.insert(out, { id = mountId, cfg = cfg })
		end
	end
	table.sort(out, function(a, b)
		return (a.cfg.Display.Name or a.id) < (b.cfg.Display.Name or b.id)
	end)
	return out
end

function Module.Build(ctx)
	local scope = ctx.scope
	local DataVersion = ctx.DataVersion

	local SelectedMountId = scope:Value(nil :: string?)
	local KindFilter      = scope:Value('all')

	-- Left column: kind filter chips + owned grid.
	local kindChips = {}
	for i, kind in KINDS do
		local isActive = scope:Computed(function(use)
			return use(KindFilter) == kind
		end)
		table.insert(kindChips, scope:New('TextButton') {
			LayoutOrder = i,
			Size = UDim2.fromOffset(72, 26),
			BackgroundColor3 = scope:Computed(function(use)
				return use(isActive) and PALETTE.accent or PALETTE.bg0
			end),
			BackgroundTransparency = scope:Computed(function(use)
				return use(isActive) and 0.6 or 0.35
			end),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			FontFace = HUDCommon.FONT_MONO,
			Text = KIND_LABELS[kind],
			TextSize = 11,
			TextColor3 = scope:Computed(function(use)
				return use(isActive) and PALETTE.accentHot or PALETTE.ink
			end),
			[Fusion.OnEvent('Activated')] = function() KindFilter:set(kind) end,
			[Fusion.Children] = {
				scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.5, Thickness = 1 },
			},
		})
	end

	local mountsList = scope:ForPairs(
		scope:Computed(function(use)
			use(DataVersion)
			local data = Utils.getPlayerData()
			local list = getOwnedMountsList(data)
			local filter = use(KindFilter)
			local out = {}
			for _, entry in list do
				if filter == 'all' or entry.cfg.Kind == filter then
					table.insert(out, entry)
				end
			end
			return out
		end),
		function(use, innerScope, idx, entry)
			local isSelected = innerScope:Computed(function(use2)
				return use2(SelectedMountId) == entry.id
			end)
			return idx, innerScope:New('TextButton') {
				LayoutOrder = idx,
				Size = UDim2.new(1, 0, 0, 56),
				BackgroundColor3 = innerScope:Computed(function(use2)
					return use2(isSelected) and PALETTE.accent or PALETTE.bg0
				end),
				BackgroundTransparency = innerScope:Computed(function(use2)
					return use2(isSelected) and 0.6 or 0.4
				end),
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = '',
				[Fusion.OnEvent('Activated')] = function()
					SelectedMountId:set(entry.id)
				end,
				[Fusion.Children] = {
					innerScope:New('UIStroke') {
						Color = innerScope:Computed(function(use2)
							return use2(isSelected) and PALETTE.accentHot or PALETTE.accent
						end),
						Transparency = 0.55, Thickness = 1,
					},
					innerScope:New('UIPadding') {
						PaddingLeft  = UDim.new(0, 12),
						PaddingRight = UDim.new(0, 12),
					},
					innerScope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0.5),
						Position = UDim2.fromScale(0, 0.35),
						Size = UDim2.new(1, 0, 0, 18),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_DISPLAY,
						Text = entry.cfg.Display.Name or entry.id,
						TextSize = 16,
						TextColor3 = PALETTE.ink,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					innerScope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0.5),
						Position = UDim2.fromScale(0, 0.72),
						Size = UDim2.new(1, 0, 0, 14),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = string.upper(entry.cfg.Kind or '—'),
						TextSize = 11,
						TextColor3 = entry.cfg.Kind == 'flight' and PALETTE.violet or PALETTE.gold,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
				},
			}
		end
	)

	local leftColumn = scope:New('Frame') {
		Name = 'MountsLeft',
		LayoutOrder = 1,
		Size = UDim2.fromScale(LEFT_COL_PX / DESIGN_W, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			Utils.eyebrow(scope, '◆ MOUNTS', { LayoutOrder = 1 }),
			scope:New('Frame') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Horizontal,
						Padding = UDim.new(0, 6),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					table.unpack(kindChips),
				},
			},
			scope:New('ScrollingFrame') {
				LayoutOrder = 3,
				Size = UDim2.new(1, 0, 1, -76),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Active = true,
				ScrollingDirection = Enum.ScrollingDirection.Y,
				ScrollBarThickness = 4,
				ScrollBarImageColor3 = PALETTE.accent,
				CanvasSize = UDim2.fromOffset(0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ElasticBehavior = Enum.ElasticBehavior.Never,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Vertical,
						Padding = UDim.new(0, 6),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					mountsList,
				},
			},
		},
	}

	-- Right column: selected mount detail + equip/dismount.
	local selectedCfg = scope:Computed(function(use)
		local id = use(SelectedMountId); if not id then return nil end
		return MountsConfig.Mounts[id]
	end)

	local equippedId = scope:Computed(function(use)
		use(DataVersion)
		local data = Utils.getPlayerData()
		return MountsShared.GetEquippedMountId(data)
	end)

	-- Equip/Unequip toggle text. Equip sets the active mount slot;
	-- Unequip clears it (server auto-dismounts if currently riding).
	-- Mount/Dismount is a separate button below.
	local equipButtonText = scope:Computed(function(use)
		local id = use(SelectedMountId); local eq = use(equippedId)
		if not id then return 'SELECT A MOUNT' end
		if eq == id then return 'UNEQUIP' end
		return 'EQUIP'
	end)

	-- Mount/Dismount lives on the hotbar (G key + on-screen button), not
	-- in this tab — the tab is for slot management. See HotbarWidget's
	-- mount utility button + MountsClient.AttemptToggleRide.

	local rightColumn = scope:New('Frame') {
		Name = 'MountsRight',
		LayoutOrder = 2,
		Size = UDim2.fromScale((DESIGN_W - LEFT_COL_PX - COL_GAP_PX) / DESIGN_W, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 10),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			Utils.eyebrow(scope, '◆ DETAIL', { LayoutOrder = 1 }),
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = scope:Computed(function(use)
					local cfg = use(selectedCfg)
					return cfg and (cfg.Display.Name or '—') or 'No mount selected'
				end),
				TextSize = 22,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				LayoutOrder = 3,
				Size = UDim2.new(1, 0, 0, 32),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = scope:Computed(function(use)
					local cfg = use(selectedCfg)
					return cfg and (cfg.Display.Description or '') or ''
				end),
				TextSize = 13,
				TextColor3 = PALETTE.inkDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
			},
			scope:New('TextLabel') {
				LayoutOrder = 4,
				Size = UDim2.new(1, 0, 0, 16),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					local cfg = use(selectedCfg); if not cfg then return '' end
					return string.format('SPEED %d · TURN %.1f · KIND %s',
						cfg.Stats.Speed, cfg.Stats.TurnRate, string.upper(cfg.Kind))
				end),
				TextSize = 11,
				TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextButton') {
				LayoutOrder = 5,
				Size = UDim2.new(0, 200, 0, 36),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.25,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				FontFace = HUDCommon.FONT_BUTTON,
				Text = equipButtonText,
				TextSize = 14,
				TextColor3 = PALETTE.ink,
				[Fusion.OnEvent('Activated')] = function()
					local Gameplay = require(LocalPlayer:WaitForChild('PlayerScripts')
						:WaitForChild('Core'):WaitForChild('Gameplay'))
					local MountsClient = Gameplay.MountsClient
					if not MountsClient then return end
					local id = peek(SelectedMountId); if not id then return end
					local eq = peek(equippedId)
					if eq == id then
						MountsClient.AttemptUnequip()
					else
						MountsClient.AttemptEquip(id)
					end
				end,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
				},
			},
		},
	}

	-- ctx.embedded suppresses the outer padding so this tab can be
	-- embedded inside another tab (InventoryTab) without compounding
	-- 24/32 padding on top of the host's existing 24/32.
	local children = {
		scope:New('UIListLayout') {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(COL_GAP_PX / DESIGN_W, 0),
			SortOrder = Enum.SortOrder.LayoutOrder,
		},
		leftColumn, rightColumn,
	}
	if not ctx.embedded then
		table.insert(children, 1, scope:New('UIPadding') {
			PaddingTop    = UDim.new(24 / OUTER_H, 0),
			PaddingBottom = UDim.new(24 / OUTER_H, 0),
			PaddingLeft   = UDim.new(32 / OUTER_W, 0),
			PaddingRight  = UDim.new(32 / OUTER_W, 0),
		})
	end
	return scope:New('Frame') {
		Name = 'MountsTab',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = children,
	}
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/TabWidget/QuestsTab.luau"><![CDATA[-- // TabWidget/QuestsTab.luau //
-- Two-column quest log:
--   left  — scrollable stack of rich quest cards (category eyebrow, title,
--           description, progress bar + %, rewards chip row). Each card is
--           clickable and drives the right-hand detail pane selection.
--   right — detail pane — title + description + TRACK / UNTRACK action.
--
-- Data sources:
--   * PlayerData.ActiveQuests / CompletedQuests — `{[questId]: {[uuid]:
--     BaseQuestData}}` — drives which cards exist. Populated server-side
--     by SavesManagerServer + the `TEST_QUESTS` seeding in
--     GameControllerServer.OnPlayerAdded; replicated through the standard
--     ReplicatedData path.
--   * QuestsConfig.Quests[id] — drives every visible string and structural
--     field: Display.Title / Description, SubQuests[], Rewards. The
--     `rewardsFromConfig` / `objectivesFromConfig` / `progressFromConfig`
--     helpers below project the config + the in-flight `SubQuestIndex`
--     into the shape the card + detail-pane render path consumes.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local peek   = Fusion.peek
local QuestsConfig = ReplicatedModules.Data.Quests
local RemoteService = ReplicatedModules.Services.RemoteService

-- Mirror of QuestServer.RemoteJobs. Keep these integers in sync — the
-- server's dispatcher (see QuestServer.Start) keys on the same value.
local QuestEvent = RemoteService.GetRemote('QuestEvent', 'RemoteEvent', false)
local QUEST_REMOTE_JOBS = { ToggleTracked = 1 }

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE   = HUDCommon.PALETTE

local Utils = require(script.Parent.utils)

local Module = {}

----------------------------------------------------------------------
-- Reward-chip color table — one entry per `kind` emitted by
-- `rewardsFromConfig`. Add new entries here when QuestsConfig grows new
-- reward categories (e.g. cosmetics, factions).
----------------------------------------------------------------------
local REWARD_COLORS: { [string]: Color3 } = {
	ITEM   = Color3.fromRGB(126, 200, 255),  -- accent cyan — generic item
	COR    = Color3.fromRGB(255, 215, 138),  -- gold currency
	RECIPE = Color3.fromRGB(200, 157, 255),  -- violet — blueprints / schematics
	SKILL  = Color3.fromRGB(255, 198, 112),  -- amber — skill points / XP
}

-- Per-category eyebrow glyph. MAIN / SIDE / CRAFT all use the same diamond
-- in the aincrad reference (consistent with the rest of the HUD).
local CATEGORY_GLYPH = '◆'

----------------------------------------------------------------------
-- Config → render-data helpers. All pure: take a quest config (and the
-- in-flight subquest index where relevant) and return strings/tables the
-- card + detail-pane render path consumes.
----------------------------------------------------------------------

-- Build a flat reward-chip list from `QuestConfigTable.Rewards`. The chip
-- `kind` keys into REWARD_COLORS above — keep in sync if new categories
-- (Currency / Items / Skills / Experience) are added to the schema.
local function rewardsFromConfig(rewardsCfg): { { name: string, kind: string } }
	local out = {}
	if not rewardsCfg then return out end
	if rewardsCfg.Currency and rewardsCfg.Currency > 0 then
		table.insert(out, { name = string.format('%d Cor', rewardsCfg.Currency), kind = 'COR' })
	end
	if rewardsCfg.Experience and rewardsCfg.Experience > 0 then
		table.insert(out, { name = string.format('%d XP', rewardsCfg.Experience), kind = 'SKILL' })
	end
	if typeof(rewardsCfg.Items) == 'table' then
		for itemId, qty in rewardsCfg.Items do
			table.insert(out, { name = string.format('%s × %d', tostring(itemId), tonumber(qty) or 1), kind = 'ITEM' })
		end
	end
	if typeof(rewardsCfg.Skills) == 'table' then
		for _, skillName in rewardsCfg.Skills do
			table.insert(out, { name = string.format('Skill: %s', tostring(skillName)), kind = 'SKILL' })
		end
	end
	return out
end

-- Convert SubQuests[] → `{[label] = done}` dict the TRACKING page expects.
-- Step labels carry a numeric prefix so the renderer's alphabetical sort
-- of dict keys yields narrative order ("1 · …", "2 · …").
-- Done-state: a step is complete when its index is strictly less than the
-- in-flight `SubQuestIndex` — equal means "current", greater means "next".
local function objectivesFromConfig(questCfg, subQuestIndex: number): { [string]: boolean }
	local objectives = {}
	if not questCfg or not questCfg.SubQuests then return objectives end
	for i, sq in questCfg.SubQuests do
		local title = sq.Display and sq.Display.Title and sq.Display.Title.Text
		local label = string.format('%d · %s', i, title and title ~= '' and title or string.format('Step %d', i))
		objectives[label] = i < subQuestIndex
	end
	return objectives
end

-- Progress = completed-step-count / total-step-count, clamped to [0, 1].
-- `SubQuestIndex` is the *next* step to do, so completed = SubQuestIndex - 1.
local function progressFromConfig(questCfg, subQuestIndex: number): number
	if not questCfg or not questCfg.SubQuests then return 0 end
	local total = #questCfg.SubQuests
	if total <= 0 then return 0 end
	return math.clamp((subQuestIndex - 1) / total, 0, 1)
end

----------------------------------------------------------------------
-- Build(ctx)
----------------------------------------------------------------------

function Module.Build(ctx)
	local scope = ctx.scope
	local DataVersion = ctx.DataVersion

	-- Selection starts unset — the detail pane shows its "Select a quest"
	-- empty state until the user clicks a card. We don't auto-select the
	-- first ActiveQuest because PlayerData may not have replicated yet at
	-- the moment Build() runs, and a Computed-based default would drift
	-- the selection unpredictably as data arrives.
	local SelectedQuest = scope:Value(nil :: string?)

	-- Unpack (title, description) from QuestsConfig. The config is the
	-- single source of truth; if a quest entry exists in PlayerData but
	-- not in QuestsConfig, fall back to the raw questId so the card still
	-- renders something readable instead of vanishing silently.
	local function getQuestDisplay(questId: string): (string, string)
		local cfg = QuestsConfig and QuestsConfig.Quests and QuestsConfig.Quests[questId]
		if cfg and cfg.Display then
			local title = cfg.Display.Title and cfg.Display.Title.Text or questId
			local desc  = cfg.Display.Description and cfg.Display.Description.Text or ''
			return title, desc
		end
		return questId, ''
	end

	-- Build the entry list directly from PlayerData.ActiveQuests +
	-- CompletedQuests, deriving progress / objectives / rewards from the
	-- matching QuestsConfig.Quests entry. ActiveQuests is keyed
	-- questId → uuid → BaseQuestData, so we flatten the nested dict —
	-- one card per in-flight uuid (repeatable quests can have several).
	local questEntries = scope:Computed(function(use)
		use(DataVersion)
		local data = Utils.getPlayerData()
		local out = {}
		local idx = 0
		if not data then return out end

		if typeof(data.ActiveQuests) == 'table' then
			for questId, uuidDict in data.ActiveQuests do
				local cfg = QuestsConfig.Quests[questId]
				if not cfg then continue end
				if typeof(uuidDict) ~= 'table' then continue end
				for uuid, qData in uuidDict do
					idx += 1
					local subIdx = (typeof(qData) == 'table' and tonumber(qData.SubQuestIndex)) or 1
					local totalSteps = (cfg.SubQuests and #cfg.SubQuests) or 0
					local isComplete = totalSteps > 0 and subIdx > totalSteps
					table.insert(out, {
						order      = idx,
						questId    = questId,
						uuid       = uuid,
						status     = isComplete and 'complete' or 'active',
						tracked    = typeof(qData) == 'table' and qData.is_tracked == true,
						-- QuestConfigTable doesn't carry a category yet; default
						-- to MAIN so the eyebrow renders. Swap to `cfg.Category`
						-- once that field lands in Quests.luau.
						category   = 'MAIN',
						progress   = progressFromConfig(cfg, subIdx),
						rewards    = rewardsFromConfig(cfg.Rewards),
						objectives = objectivesFromConfig(cfg, subIdx),
					})
				end
			end
		end

		if typeof(data.CompletedQuests) == 'table' then
			for questId, _ in data.CompletedQuests do
				local cfg = QuestsConfig.Quests[questId]
				if not cfg then continue end
				idx += 1
				local totalSteps = (cfg.SubQuests and #cfg.SubQuests) or 0
				table.insert(out, {
					order      = idx,
					questId    = questId,
					status     = 'complete',
					tracked    = false,
					category   = 'MAIN',
					progress   = 1,
					rewards    = rewardsFromConfig(cfg.Rewards),
					-- Pass `total + 1` so every step renders as done.
					objectives = objectivesFromConfig(cfg, totalSteps + 1),
				})
			end
		end

		return out
	end)

	----------------------------------------------------------------------
	-- Reward chip — one bordered pill per drop. Structure: stroke + padding
	-- + UIListLayout horizontal + name label + kind-tag label.
	----------------------------------------------------------------------
	local function buildRewardChip(parentScope, reward)
		local tint = REWARD_COLORS[reward.kind] or PALETTE.accent
		return parentScope:New('Frame') {
			Size = UDim2.fromOffset(0, 24),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
			[Fusion.Children] = {
				parentScope:New('UIStroke') { Color = tint, Transparency = 0.55, Thickness = 1 },
				parentScope:New('UIPadding') {
					PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
				},
				parentScope:New('UIListLayout') {
					FillDirection = Enum.FillDirection.Horizontal,
					VerticalAlignment = Enum.VerticalAlignment.Center,
					Padding = UDim.new(0, 6),
					SortOrder = Enum.SortOrder.LayoutOrder,
				},
				-- Name label — auto-widens to fit the reward name.
				parentScope:New('TextLabel') {
					LayoutOrder = 1,
					Size = UDim2.fromOffset(0, 16),
					AutomaticSize = Enum.AutomaticSize.X,
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_UI,
					Text = reward.name,
					TextSize = 11,
					TextColor3 = tint,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				-- Kind tag (ITEM / COR / RECIPE / SKILL) in dim mono.
				parentScope:New('TextLabel') {
					LayoutOrder = 2,
					Size = UDim2.fromOffset(0, 14),
					AutomaticSize = Enum.AutomaticSize.X,
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = reward.kind,
					TextSize = 9,
					TextColor3 = PALETTE.inkFaint,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
			},
		}
	end

	----------------------------------------------------------------------
	-- Quest card — clickable, renders one entry's full overview.
	-- Height is fixed at ~180 px; a taller card would accommodate multi-row
	-- reward chip wrapping but two-row rewards are rare in the mockup.
	----------------------------------------------------------------------
	local function buildQuestCard(cardScope, entry)
		local title, desc = getQuestDisplay(entry.questId)
		local isSelected = cardScope:Computed(function(use)
			return use(SelectedQuest) == entry.questId
		end)
		local accent = entry.tracked and PALETTE.gold
			or (entry.status == 'complete' and PALETTE.success or PALETTE.accent)

		-- Reward chips.
		local chips = {}
		for i, reward in entry.rewards do
			local chip = buildRewardChip(cardScope, reward)
			chip.LayoutOrder = i
			table.insert(chips, chip)
		end
		local rewardsRow = cardScope:New('Frame') {
			LayoutOrder = 6,
			-- Auto-grow Y so wrapped chip rows don't clip. Horizontal
			-- UIListLayout with Wraps = true flows chips onto a second row
			-- when the first overflows; this frame grows to accommodate.
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				cardScope:New('UIListLayout') {
					FillDirection = Enum.FillDirection.Horizontal,
					VerticalAlignment = Enum.VerticalAlignment.Top,
					Padding = UDim.new(0, 6),
					SortOrder = Enum.SortOrder.LayoutOrder,
					Wraps = true,
				},
				table.unpack(chips),
			},
		}

		return cardScope:New('TextButton') {
			Name = 'Quest_' .. tostring(entry.questId),
			LayoutOrder = entry.order,
			-- Height grows with content (rewards row can wrap onto a second
			-- line on narrow columns). The parent scroll's UIListLayout
			-- sees each card's AbsoluteSize.Y and spaces rows accordingly.
			Size = UDim2.new(1, -4, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			AutoButtonColor = false,
			Text = '',
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = cardScope:Computed(function(use)
				return use(isSelected) and 0.1 or 0.3
			end),
			BorderSizePixel = 0,
			[Fusion.OnEvent('Activated')] = function()
				SelectedQuest:set(entry.questId)
			end,
			[Fusion.Children] = {
				cardScope:New('UIStroke') {
					Color = accent,
					Transparency = cardScope:Computed(function(use)
						return use(isSelected) and 0.2 or 0.55
					end),
					Thickness = 1,
				},
				cardScope:New('UIPadding') {
					PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12),
					PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14),
				},
				cardScope:New('UIListLayout') {
					FillDirection = Enum.FillDirection.Vertical,
					Padding = UDim.new(0, 6),
					SortOrder = Enum.SortOrder.LayoutOrder,
				},
				-- Header row: category eyebrow (left) + percentage (right).
				cardScope:New('Frame') {
					LayoutOrder = 1,
					Size = UDim2.new(1, 0, 0, 14),
					BackgroundTransparency = 1,
					[Fusion.Children] = {
						cardScope:New('TextLabel') {
							AnchorPoint = Vector2.new(0, 0),
							Position = UDim2.fromScale(0, 0),
							Size = UDim2.new(0.7, 0, 1, 0),
							BackgroundTransparency = 1,
							FontFace = HUDCommon.FONT_MONO,
							Text = CATEGORY_GLYPH .. ' ' .. entry.category,
							TextSize = 10,
							TextColor3 = accent,
							TextXAlignment = Enum.TextXAlignment.Left,
						},
						cardScope:New('TextLabel') {
							AnchorPoint = Vector2.new(1, 0),
							Position = UDim2.fromScale(1, 0),
							Size = UDim2.new(0.3, 0, 1, 0),
							BackgroundTransparency = 1,
							FontFace = HUDCommon.FONT_MONO,
							Text = string.format('%d%%', math.floor(entry.progress * 100 + 0.5)),
							TextSize = 11,
							TextColor3 = accent,
							TextXAlignment = Enum.TextXAlignment.Right,
						},
					},
				},
				-- Title (display font).
				cardScope:New('TextLabel') {
					LayoutOrder = 2,
					Size = UDim2.new(1, 0, 0, 26),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_BUTTON,
					Text = title,
					TextSize = 20,
					TextColor3 = PALETTE.ink,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
				},
				-- Description (wrapped).
				cardScope:New('TextLabel') {
					LayoutOrder = 3,
					Size = UDim2.new(1, 0, 0, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_UI,
					Text = desc ~= '' and desc or 'No description available.',
					TextSize = 12,
					TextColor3 = PALETTE.inkDim,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextWrapped = true,
				},
				-- Progress bar — HUDCommon.smoothBar tweens on value change.
				cardScope:New('Frame') {
					LayoutOrder = 4,
					Size = UDim2.new(1, 0, 0, 3),
					BackgroundTransparency = 1,
					[Fusion.Children] = {
						HUDCommon.smoothBar(cardScope, {
							Value = entry.progress, Max = 1,
							Color = accent, Height = 3,
							FillParent = true,
						}),
					},
				},
				-- Rewards eyebrow.
				cardScope:New('TextLabel') {
					LayoutOrder = 5,
					Size = UDim2.new(1, 0, 0, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = string.format('◆ REWARDS · %d DROPS', #entry.rewards),
					TextSize = 9,
					TextColor3 = PALETTE.accent,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
				rewardsRow,
			},
		}
	end

	----------------------------------------------------------------------
	-- Left column — scrollable stack of quest cards.
	----------------------------------------------------------------------
	local questList = scope:New('ScrollingFrame') {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.fromScale(0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = PALETTE.accent,
		ScrollBarImageTransparency = 0.4,
		ElasticBehavior = Enum.ElasticBehavior.Never,
		[Fusion.Children] = {
			scope:New('UIListLayout') { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder },
			scope:New('UIPadding') { PaddingRight = UDim.new(0, 6) },
			scope:ForPairs(questEntries, function(use, innerScope, idx, entry)
				return idx, buildQuestCard(innerScope, entry)
			end),
		},
	}

	----------------------------------------------------------------------
	-- Right column — detail pane with three sub-tabs (OVERVIEW / TRACKING /
	-- REWARDS). Same pattern used in TabWidget/InventoryTab.luau's detail
	-- pane: sub-tab row pinned near the top; each page Visible-bound to
	-- whichever sub-tab is active.
	----------------------------------------------------------------------
	local SelectedDetailTab = scope:Value('overview')

	-- Helper — resolve the currently-selected quest's entry from the rendered
	-- `questEntries` list. Returns nil if nothing is selected or the selected
	-- questId no longer exists in the live data (e.g. completed + filtered).
	local function getSelectedQuestEntry(use)
		local qid = use(SelectedQuest)
		if not qid then return nil end
		for _, entry in use(questEntries) do
			if entry.questId == qid then return entry end
		end
		return nil
	end

	local DETAIL_SUBTABS = { 'overview', 'tracking', 'rewards' }
	local DETAIL_SUBTAB_LABELS = {
		overview = 'OVERVIEW',
		tracking = 'TRACKING',
		rewards  = 'REWARDS',
	}

	-- Sub-tab buttons. Identical pattern to InventoryTab — active underline
	-- stripe on a transparent button; selection drives a Value<string>.
	local subTabButtons = {}
	for i, subId in DETAIL_SUBTABS do
		local isActive = scope:Computed(function(use)
			return use(SelectedDetailTab) == subId
		end)
		table.insert(subTabButtons, scope:New('TextButton') {
			Name = 'SubTab_' .. subId,
			LayoutOrder = i,
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			-- Each sub-tab takes 1/N of the row width (3 tabs → 1/3 each).
			Size = UDim2.new(1 / #DETAIL_SUBTABS, 0, 1, 0),
			Text = '',
			[Fusion.OnEvent('Activated')] = function()
				SelectedDetailTab:set(subId)
			end,
			[Fusion.Children] = {
				scope:New('TextLabel') {
					Size = UDim2.fromScale(1, 1),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = DETAIL_SUBTAB_LABELS[subId],
					TextSize = 11,
					TextColor3 = scope:Computed(function(use)
						return use(isActive) and PALETTE.accent or PALETTE.inkDim
					end),
				},
				-- Active-underline stripe (visible only when isActive).
				scope:New('Frame') {
					AnchorPoint = Vector2.new(0.5, 1),
					Position = UDim2.fromScale(0.5, 1),
					Size = UDim2.new(0.7, 0, 0, 2),
					BackgroundColor3 = PALETTE.accent,
					BorderSizePixel = 0,
					Visible = isActive,
				},
			},
		})
	end

	-- Nested two-frame split so the bottom accent border doesn't get swept
	-- into the tab-button strip's horizontal flow. (Same trap the inventory
	-- detail tabs hit — a 100 %-wide border child would push every tab one
	-- row's-worth to the right.)
	local tabButtonStrip = scope:New('Frame') {
		Name = 'TabButtonStrip',
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				SortOrder = Enum.SortOrder.LayoutOrder,
				HorizontalAlignment = Enum.HorizontalAlignment.Left,
				VerticalAlignment = Enum.VerticalAlignment.Center,
			},
			table.unpack(subTabButtons),
		},
	}
	local subTabRow = scope:New('Frame') {
		LayoutOrder = 3,
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			tabButtonStrip,
			scope:New('Frame') {
				Name = 'BottomBorder',
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.fromScale(0, 1),
				Size = UDim2.new(1, 0, 0, 1),
				BackgroundColor3 = PALETTE.accent,
				BackgroundTransparency = 0.78,
				BorderSizePixel = 0,
				ZIndex = 0,
			},
		},
	}

	----------------------------------------------------------------------
	-- OVERVIEW page — title + description + category eyebrow.
	----------------------------------------------------------------------
	local overviewPage = scope:New('Frame') {
		Name = 'OverviewPage',
		LayoutOrder = 10,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Visible = scope:Computed(function(use)
			return use(SelectedDetailTab) == 'overview'
		end),
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				Padding = UDim.new(0, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- Category eyebrow — MAIN / SIDE / CRAFT.
			scope:New('TextLabel') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 12),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					local entry = getSelectedQuestEntry(use)
					if not entry then return '' end
					return CATEGORY_GLYPH .. ' ' .. (entry.category or 'QUEST')
				end),
				TextSize = 10,
				TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			-- Description (wrapped, grows vertically).
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = scope:Computed(function(use)
					local qid = use(SelectedQuest)
					if not qid then return 'Quests you accept or complete will appear here.' end
					local _, desc = getQuestDisplay(qid)
					return desc ~= '' and desc or 'No description available.'
				end),
				TextSize = 14,
				TextColor3 = PALETTE.inkDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
			},
		},
	}

	----------------------------------------------------------------------
	-- TRACKING page — progress bar + percentage + objective checklist.
	----------------------------------------------------------------------
	-- Objectives are rendered via a ForPairs over the selected entry's
	-- `.objectives` list. Each entry gets a ●/○ glyph based on `done`.
	local trackingPage = scope:New('Frame') {
		Name = 'TrackingPage',
		LayoutOrder = 10,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Visible = scope:Computed(function(use)
			return use(SelectedDetailTab) == 'tracking'
		end),
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- Progress row: "Progress" label left + "NN%" right.
			scope:New('Frame') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 16),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('TextLabel') {
						AnchorPoint = Vector2.new(0, 0),
						Position = UDim2.fromScale(0, 0),
						Size = UDim2.new(0.6, 0, 1, 0),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = '◆ PROGRESS',
						TextSize = 10,
						TextColor3 = PALETTE.accent,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					scope:New('TextLabel') {
						AnchorPoint = Vector2.new(1, 0),
						Position = UDim2.fromScale(1, 0),
						Size = UDim2.new(0.4, 0, 1, 0),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = scope:Computed(function(use)
							local entry = getSelectedQuestEntry(use)
							if not entry then return '—' end
							return string.format('%d%%', math.floor((entry.progress or 0) * 100 + 0.5))
						end),
						TextSize = 13,
						TextColor3 = PALETTE.accent,
						TextXAlignment = Enum.TextXAlignment.Right,
					},
				},
			},
			-- Thick progress bar (6 px) — re-runs whenever the selected
			-- entry's progress fraction changes.
			scope:New('Frame') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, 6),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.35,
				BorderSizePixel = 0,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.7, Thickness = 1 },
					scope:New('Frame') {
						Name = 'Fill',
						Size = scope:Computed(function(use)
							local entry = getSelectedQuestEntry(use)
							local frac = entry and math.clamp(entry.progress or 0, 0, 1) or 0
							return UDim2.fromScale(frac, 1)
						end),
						BackgroundColor3 = PALETTE.accent,
						BorderSizePixel = 0,
					},
				},
			},
			-- Objectives eyebrow.
			scope:New('TextLabel') {
				LayoutOrder = 3,
				Size = UDim2.new(1, 0, 0, 12),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					local entry = getSelectedQuestEntry(use)
					local total, doneCount = 0, 0
					if entry and entry.objectives then
						-- `objectives` is a dict { [label] = done }, so counts
						-- come from pairs() — order doesn't matter here.
						for _, done in entry.objectives do
							total += 1
							if done then doneCount += 1 end
						end
					end
					return string.format('◆ OBJECTIVES · %d / %d', doneCount, total)
				end),
				TextSize = 10,
				TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			-- Objectives list — bounded ScrollingFrame so a long quest with
			-- many steps doesn't push the rest of the TRACKING page (or the
			-- TRACK/UNTRACK button) off-screen. Fixed height; the inner
			-- UIListLayout drives CanvasSize via AutomaticCanvasSize.Y, so
			-- the scrollbar only appears when objectives exceed the
			-- visible region.
			scope:New('ScrollingFrame') {
				Name = 'ObjectivesScroll',
				LayoutOrder = 4,
				Size = UDim2.new(1, 0, 0, 180),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				CanvasSize = UDim2.fromScale(0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollBarThickness = 3,
				ScrollBarImageColor3 = PALETTE.accent,
				ScrollBarImageTransparency = 0.4,
				ElasticBehavior = Enum.ElasticBehavior.Never,
				ScrollingDirection = Enum.ScrollingDirection.Y,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						Padding = UDim.new(0, 4),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					-- Keep rows off the scrollbar.
					scope:New('UIPadding') { PaddingRight = UDim.new(0, 6) },
					scope:ForPairs(
						scope:Computed(function(use)
							local entry = getSelectedQuestEntry(use)
							if not entry or not entry.objectives then return {} end
							-- Collect dict keys into an array so we can sort
							-- them. The numeric prefix ("1 · …", "2 · …")
							-- makes alphabetical == narrative order.
							local labels = {}
							for label in entry.objectives do
								table.insert(labels, label)
							end
							table.sort(labels)
							-- Rebuild as an ordered list the renderer can
							-- walk deterministically.
							local out = {}
							for i, label in labels do
								table.insert(out, {
									order = i,
									label = label,
									done  = entry.objectives[label] == true,
								})
							end
							return out
						end),
						function(use, innerScope, idx, obj)
							local glyph = obj.done and '●' or '○'
							local color = obj.done and PALETTE.success or PALETTE.inkDim
							-- Use the objective label as the ForPairs key so
							-- Fusion re-uses the same row Frame when only
							-- done-state flips (no flicker on toggle).
							return obj.label, innerScope:New('Frame') {
								LayoutOrder = obj.order,
								Size = UDim2.new(1, 0, 0, 18),
								BackgroundTransparency = 1,
								[Fusion.Children] = {
									innerScope:New('UIListLayout') {
										FillDirection = Enum.FillDirection.Horizontal,
										VerticalAlignment = Enum.VerticalAlignment.Center,
										Padding = UDim.new(0, 8),
										SortOrder = Enum.SortOrder.LayoutOrder,
									},
									innerScope:New('TextLabel') {
										LayoutOrder = 1,
										Size = UDim2.fromOffset(12, 16),
										BackgroundTransparency = 1,
										FontFace = HUDCommon.FONT_MONO,
										Text = glyph,
										TextSize = 14,
										TextColor3 = color,
									},
									innerScope:New('TextLabel') {
										LayoutOrder = 2,
										Size = UDim2.new(1, -20, 1, 0),
										BackgroundTransparency = 1,
										FontFace = HUDCommon.FONT_UI,
										Text = obj.label,
										TextSize = 12,
										TextColor3 = obj.done and PALETTE.ink or PALETTE.inkDim,
										TextXAlignment = Enum.TextXAlignment.Left,
										TextYAlignment = Enum.TextYAlignment.Center,
									},
								},
							}
						end
					),
				},
			},
		},
	}

	----------------------------------------------------------------------
	-- REWARDS page — full list of reward chips (wrapping).
	----------------------------------------------------------------------
	local rewardsPage = scope:New('Frame') {
		Name = 'RewardsPage',
		LayoutOrder = 10,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Visible = scope:Computed(function(use)
			return use(SelectedDetailTab) == 'rewards'
		end),
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- Eyebrow — drop count.
			scope:New('TextLabel') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 12),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					local entry = getSelectedQuestEntry(use)
					local n = entry and entry.rewards and #entry.rewards or 0
					return string.format('◆ REWARDS · %d DROPS', n)
				end),
				TextSize = 10,
				TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			-- Wrapping chip grid driven by ForPairs.
			scope:New('Frame') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Horizontal,
						VerticalAlignment = Enum.VerticalAlignment.Top,
						Padding = UDim.new(0, 6),
						SortOrder = Enum.SortOrder.LayoutOrder,
						Wraps = true,
					},
					scope:ForPairs(
						scope:Computed(function(use)
							local entry = getSelectedQuestEntry(use)
							if not entry or not entry.rewards then return {} end
							local out = {}
							for i, reward in entry.rewards do
								table.insert(out, {
									order = i, name = reward.name, kind = reward.kind,
								})
							end
							return out
						end),
						function(use, innerScope, idx, reward)
							local chip = buildRewardChip(innerScope, reward)
							chip.LayoutOrder = reward.order
							return idx, chip
						end
					),
				},
			},
		},
	}

	----------------------------------------------------------------------
	-- Detail pane — header (eyebrow + title) + sub-tab row + page swap +
	-- TRACK/UNTRACK footer.
	----------------------------------------------------------------------
	local detailPane = scope:New('Frame') {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.7, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16),
				PaddingTop = UDim.new(0, 16), PaddingBottom = UDim.new(0, 16),
			},
			scope:New('UIListLayout') { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder },
			-- Eyebrow always visible.
			scope:New('TextLabel') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 12),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = '◆ QUEST DETAIL',
				TextSize = 10,
				TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			-- Quest title always visible (the sub-tabs swap BELOW it).
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_BUTTON,
				Text = scope:Computed(function(use)
					local qid = use(SelectedQuest)
					if not qid then return 'Select a quest' end
					local title, _ = getQuestDisplay(qid)
					return title
				end),
				TextSize = 20,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
			},
			subTabRow,
			overviewPage,
			trackingPage,
			rewardsPage,
		},
	}

	local twoColumn = scope:New('Frame') {
		LayoutOrder = 10,
		Size = UDim2.new(1, 0, 1, -60),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 16),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:New('Frame') {
				LayoutOrder = 1,
				Size = UDim2.new(0.62, -8, 1, 0),
				BackgroundTransparency = 1,
				[Fusion.Children] = { questList },
			},
			scope:New('Frame') {
				LayoutOrder = 2,
				Size = UDim2.new(0.38, -8, 1, 0),
				BackgroundTransparency = 1,
				[Fusion.Children] = { detailPane },
			},
		},
	}

	local splitCountLabel = scope:New('TextLabel') {
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 14),
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_MONO,
		Text = scope:Computed(function(use)
			use(DataVersion)
			local data = Utils.getPlayerData()
			-- Active count is the number of in-flight uuids across every
			-- active questId — matches "one card per uuid" in `questEntries`.
			local active = 0
			if data and typeof(data.ActiveQuests) == 'table' then
				for _, uuidDict in data.ActiveQuests do
					if typeof(uuidDict) == 'table' then
						for _ in uuidDict do active += 1 end
					end
				end
			end
			return string.format('◆ QUEST LOG · %d ACTIVE', active)
		end),
		TextSize = 11,
		TextColor3 = PALETTE.accent,
		TextXAlignment = Enum.TextXAlignment.Left,
	}

	-- Action row at the bottom of the detail pane — TRACK / UNTRACK toggle.
	local trackButton = scope:New('TextButton') {
		LayoutOrder = 99,
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundColor3 = PALETTE.accent,
		BackgroundTransparency = 0.82,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		FontFace = HUDCommon.FONT_UI,
		Text = scope:Computed(function(use)
			use(DataVersion)
			local qid = use(SelectedQuest)
			if not qid then return 'SELECT A QUEST' end
			local data = Utils.getPlayerData()
			local uuidDict = data and data.ActiveQuests and data.ActiveQuests[qid]
			if typeof(uuidDict) ~= 'table' then
				-- Not in ActiveQuests — could be completed, or just unknown.
				if data and data.CompletedQuests and data.CompletedQuests[qid] then
					return 'COMPLETED'
				end
				return 'TRACK'
			end
			-- ActiveQuests is keyed by uuid; report UNTRACK if any in-flight
			-- copy of this questId is currently tracked.
			for _, qData in uuidDict do
				if typeof(qData) == 'table' and qData.is_tracked then
					return 'UNTRACK'
				end
			end
			return 'TRACK'
		end),
		TextSize = 12,
		TextColor3 = PALETTE.accent,
		[Fusion.OnEvent('Activated')] = function()
			local qid = peek(SelectedQuest)
			if not qid then return end
			local data = Utils.getPlayerData()
			local uuidDict = data and data.ActiveQuests and data.ActiveQuests[qid]
			if typeof(uuidDict) ~= 'table' then return end
			-- One uuid per questId in our manual test data, but real data
			-- may have several. Pick the first — the server's job toggles
			-- whichever uuid the client passes.
			local targetUuid: string? = nil
			for uuid in uuidDict do
				targetUuid = uuid
				break
			end
			if not targetUuid then return end
			QuestEvent:FireServer(QUEST_REMOTE_JOBS.ToggleTracked, targetUuid)
			-- Optimistic local flip so the UI updates without waiting for the
			-- next ReplicatedData push. When real server data flows back, the
			-- replication tick either confirms this value or corrects it; for
			-- the manual test data the server has no record of, the local
			-- flip is the only thing that takes effect.
			local qData = uuidDict[targetUuid]
			if typeof(qData) == 'table' then
				qData.is_tracked = not (qData.is_tracked == true)
				Utils.bumpDataVersion(DataVersion)
			end
		end,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.2, Thickness = 1 },
		},
	}
	trackButton.Parent = detailPane

	-- Top-of-tab display title — "The Ledger" in the reference mockup.
	-- Uses the display font so it reads as a chapter heading over the list.
	return scope:New('Frame') {
		Name = 'QuestsTab',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, 24), PaddingBottom = UDim.new(0, 24),
				PaddingLeft = UDim.new(0, 32), PaddingRight = UDim.new(0, 32),
			},
			scope:New('UIListLayout') { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder },
			splitCountLabel,
			Utils.displayTitle(scope, { Text = 'The Ledger', LayoutOrder = 2 }),
			twoColumn,
		},
	}
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/TabWidget/SettingsTab.luau"><![CDATA[-- // TabWidget/SettingsTab.luau //
-- A list of settings rows, each of which is one of three control kinds:
--
--   * slider   — drag/click a horizontal bar to pick an int 0..max
--   * toggle   — flip a boolean (renders ON/OFF pill)
--   * dropdown — pick one of a fixed list of strings (renders inline popup)
--
-- Every row shares the same outer chrome (glyph + label on the left, control
-- on the right, numeric/symbolic readout at the far right). The row builder
-- dispatches on `SETTINGS_ROWS[i].kind` to produce the appropriate control
-- Frame + readout behavior.
--
-- No persistence — every row owns a per-row Fusion `Value` inside Build().
-- When real wiring lands, swap each row's `Value` for a two-way binding to
-- UserGameSettings / Lighting / the in-game HUD scale, etc.
--
-- Dropdown overflow note: a dropdown's options list is rendered as an
-- absolutely-positioned sibling inside the row Frame with `ZIndex = 10` so
-- it paints ABOVE neighboring rows when opened. The outer tab container
-- must NOT set `ClipsDescendants = true` (it doesn't), or the popup would
-- be clipped to the row's bounds.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local UserInputService = game:GetService('UserInputService')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local peek   = Fusion.peek

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local SettingsRegistry = LocalModules.Modules.SettingsRegistry
local PALETTE   = HUDCommon.PALETTE

local Utils = require(script.Parent.utils)

-- Map a settings row's `key` to a SettingsRegistry field name so changes
-- propagate to MusicWidget/SoundService/theme consumers. Volumes write a
-- 0..1 fraction; theme writes the dropdown string verbatim.
local REGISTRY_KEY: {[string]: string} = {
	master       = 'MasterVolume',
	sfx          = 'SFXVolume',
	music        = 'MusicVolume',
	theme        = 'UITheme',
	music_widget = 'MusicWidgetEnabled',
	minimap      = 'MinimapEnabled',
	hud_buttons  = 'OnscreenButtonsEnabled',
	dash_mode    = 'DashMode',
	-- Nier-style combat toggles. PvPLockOnConsent gates other-player
	-- lock-on; AllowPvP is the server-side damage gate; CompanionAutoAttack
	-- gates pod ranged pulses.
	pvp_consent  = 'PvPLockOnConsent',
	pvp_allow    = 'AllowPvP',
	pod_attack   = 'CompanionAutoAttack',
	-- World-waypoint category toggles. Each gates a class of 3D
	-- markers WaypointsClient renders in the world.
	wp_workstations = 'WaypointsWorkstationsEnabled',
	wp_waystones    = 'WaypointsWaystonesEnabled',
	wp_substations  = 'WaypointsSubstationsEnabled',
	-- Compass strip toggle (top-of-screen waypoint projection).
	compass         = 'CompassEnabled',
	-- Overhead-nameplate hide toggles. Three independent gates so the
	-- player can toggle their own / others' / enemies' billboards
	-- separately. OverheadInfo subscribes to SettingsRegistry.Changed
	-- and flips each plate's `.Enabled` per-class.
	overhead_self    = 'OverheadOwnEnabled',
	overhead_others  = 'OverheadOthersEnabled',
	overhead_enemies = 'OverheadEnemiesEnabled',
}

-- Player-friendly labels for DashMode enum values. Dropdown shows
-- these; the publish path below maps back to the canonical enum string.
local DASH_MODE_LABELS = {
	{ value = 'CameraDirection',         label = 'Camera direction' },
	{ value = 'CharacterDirection',      label = 'Character direction' },
	{ value = 'CharacterDirectionalKey', label = 'Direction key (character)' },
	{ value = 'CameraDirectionalKey',    label = 'Direction key (camera)' },
}
local DASH_MODE_LABEL_TO_VALUE: { [string]: string } = {}
local DASH_MODE_VALUE_TO_LABEL: { [string]: string } = {}
for _, e in DASH_MODE_LABELS do
	DASH_MODE_LABEL_TO_VALUE[e.label] = e.value
	DASH_MODE_VALUE_TO_LABEL[e.value] = e.label
end

local function publishSetting(rowKey: string, value: any)
	local target = REGISTRY_KEY[rowKey]
	if not target then return end
	if target == 'DashMode' then
		-- Dropdown surfaces the player-friendly label; map back to the
		-- canonical enum string before writing to the registry.
		SettingsRegistry.Set(target, DASH_MODE_LABEL_TO_VALUE[value] or value)
	elseif target == 'UITheme' or typeof(value) == 'boolean' then
		-- Themes (string) and visibility toggles (boolean) pass through
		-- verbatim; only the numeric-slider rows are int-to-fraction.
		SettingsRegistry.Set(target, value)
	else
		-- Sliders surface ints; SettingsRegistry stores a fraction.
		-- buildSlider already clamps to its row's max, so dividing by 100
		-- gives us the right fraction without re-clamping (volumes 0..1).
		SettingsRegistry.Set(target, value / 100)
	end
end

local Module = {}

----------------------------------------------------------------------
-- Row definitions
----------------------------------------------------------------------
-- Returns one row spec per settings entry. `kind` drives the dispatch in Build().
--   kind='slider':   .max defaults to 100 if omitted.
--   kind='toggle':   .value is a boolean.
--   kind='dropdown': .options is a list of strings; .value is one of them.
--
-- IMPORTANT: This is a function (not a module-level table) so registry-backed
-- `.value` fields read CURRENT SettingsRegistry state at every Build call.
-- A captured-at-require-time table would re-seed stale defaults on rebuild,
-- which (when the rebuild was triggered by a registry change) would write
-- the old value back to the registry and recursively re-trigger the rebuild.
local function getSettingsRows()
	return {
		{ kind = 'slider',   key = 'master',    label = 'Master volume',   value = math.floor(SettingsRegistry.MasterVolume * 100), max = 100 },
		{ kind = 'slider',   key = 'sfx',       label = 'SFX volume',      value = math.floor(SettingsRegistry.SFXVolume    * 100), max = 100 },
		{ kind = 'slider',   key = 'music',     label = 'Music volume',    value = math.floor(SettingsRegistry.MusicVolume  * 100), max = 100 },
		{ kind = 'toggle',   key = 'shake',        label = 'Camera shake',    value = true },
		{ kind = 'toggle',   key = 'bloom',        label = 'Bloom',           value = true },
		{ kind = 'toggle',   key = 'particles',    label = 'Particle effects',value = true },
		-- Visibility toggles for individual HUD elements. Wired to
		-- SettingsRegistry; widgets subscribe to .Changed and open/close
		-- (or flip a Visible binding for the hotbar clusters).
		{ kind = 'toggle',   key = 'music_widget', label = 'Music player',    value = SettingsRegistry.MusicWidgetEnabled },
		{ kind = 'toggle',   key = 'minimap',      label = 'Minimap',         value = SettingsRegistry.MinimapEnabled },
		{ kind = 'toggle',   key = 'hud_buttons',  label = 'On-screen buttons', value = SettingsRegistry.OnscreenButtonsEnabled },
		{ kind = 'dropdown', key = 'theme',     label = 'UI theme',        value = SettingsRegistry.UITheme,
		  options = { 'Crystal dark', 'Aincrad day', 'Labyrinth red', 'Royal purple', 'Obsidian' } },
		{ kind = 'dropdown', key = 'quality',   label = 'Graphics preset', value = 'High',
		  options = { 'Low', 'Medium', 'High', 'Ultra' } },
		-- (UI scale row removed — feature parked while implementation is
		-- redesigned. SettingsRegistry no longer carries a UIScale field.)
		{ kind = 'slider',   key = 'fov',       label = 'Field of view',   value = 78,  max = 120 },
		-- Dash directional mode. See SettingsRegistry.DashMode +
		-- CombatInputClient.AttemptDodge. Dropdown shows player-friendly
		-- labels; publishSetting maps back to the canonical enum string.
		{ kind = 'dropdown', key = 'dash_mode', label = 'Dash direction',
		  value = DASH_MODE_VALUE_TO_LABEL[SettingsRegistry.DashMode] or 'Camera direction',
		  options = (function()
			local names = {}
			for _, e in DASH_MODE_LABELS do table.insert(names, e.label) end
			return names
		  end)(),
		},
		-- Nier-style combat toggles.
		{ kind = 'toggle', key = 'pvp_consent', label = 'PvP lock-on consent',
		  value = SettingsRegistry.PvPLockOnConsent },
		-- Server-side damage gate. When OFF, no other player can damage
		-- this character. Distinct from the lock-on consent above —
		-- a player can allow lock-on for tagging while keeping damage
		-- disabled, or vice versa.
		{ kind = 'toggle', key = 'pvp_allow',   label = 'Allow PvP damage',
		  value = SettingsRegistry.AllowPvP },
		{ kind = 'toggle', key = 'pod_attack',  label = 'Companion auto-attack',
		  value = SettingsRegistry.CompanionAutoAttack },
		-- Waypoint category toggles. WaypointsClient subscribes to the
		-- registry and re-evaluates marker visibility per category on flip.
		{ kind = 'toggle', key = 'wp_workstations', label = 'Workstation waypoints',
		  value = SettingsRegistry.WaypointsWorkstationsEnabled },
		{ kind = 'toggle', key = 'wp_waystones',    label = 'Unlocked waystone waypoints',
		  value = SettingsRegistry.WaypointsWaystonesEnabled },
		{ kind = 'toggle', key = 'wp_substations', label = 'Substation waypoints',
		  value = SettingsRegistry.WaypointsSubstationsEnabled },
		-- Compass strip — top-of-screen projection of the same waypoint set.
		{ kind = 'toggle', key = 'compass', label = 'Compass strip',
		  value = SettingsRegistry.CompassEnabled },
		-- Overhead nameplate visibility — per-class. OverheadInfo flips
		-- each BillboardGui's .Enabled when the relevant flag changes.
		{ kind = 'toggle', key = 'overhead_self',    label = 'My nameplate',
		  value = SettingsRegistry.OverheadOwnEnabled },
		{ kind = 'toggle', key = 'overhead_others',  label = 'Other player nameplates',
		  value = SettingsRegistry.OverheadOthersEnabled },
		{ kind = 'toggle', key = 'overhead_enemies', label = 'Enemy nameplates',
		  value = SettingsRegistry.OverheadEnemiesEnabled },
	}
end

-- Row chrome dimensions (pixel-exact at design res — each row is aspect-
-- locked to a fixed height, so offsets inside are safe).
local ROW_H        = 38
local CONTROL_W    = 220   -- width of the control region (slider / pill / dropdown header)
local READOUT_W    = 44
local GLYPH        = '◆'

----------------------------------------------------------------------
-- Slider control — click/drag a horizontal bar to set a 0..max int.
--
-- Two values, kept separate so we can defer the heavy commit:
--   DisplayValue — drives the thumb + fill + readout (the visual). Always
--                  written continuously during a drag.
--   CommitValue  — flows out to SettingsRegistry via the dispatch's
--                  Observer. Written only on InputEnded when the
--                  dispatch passed `commitOnRelease`; otherwise written
--                  every pixel (live-commit, the volume-slider behavior).
--
-- For live-commit sliders the dispatch passes the SAME Value as both
-- DisplayValue and CommitValue, so writing one writes both — no extra
-- bookkeeping. For deferred-commit sliders the dispatch passes two
-- different Values; this builder writes DisplayValue continuously and
-- CommitValue only on release.
----------------------------------------------------------------------
local function buildSlider(scope, DisplayValue, CommitValue, maxValue: number, minValue: number?)
	local slider: TextButton
	local dragging = false
	local lo = minValue or 0
	local hi = maxValue
	local range = hi - lo
	if range <= 0 then range = 1 end  -- defensive: degenerate min == max

	-- Convert an absolute-X pixel coord (from Input.Position.X) into a
	-- clamped 0..1 fraction of the slider's width, then snap to an int
	-- in [lo, hi]. Frac maps the slider's pixel travel onto the value
	-- range — at minValue=50 / maxValue=150, frac=0 → 50, frac=1 → 150.
	local function setFromX(inputX: number)
		if not slider or not slider.Parent then return end
		local abs = slider.AbsolutePosition
		local size = slider.AbsoluteSize
		if size.X <= 0 then return end
		local frac = math.clamp((inputX - abs.X) / size.X, 0, 1)
		local snapped = math.floor(lo + frac * range + 0.5)
		DisplayValue:set(snapped)
	end

	-- Reverse: convert a current value into the [0, 1] fraction used by
	-- the thumb + fill so they show position relative to lo..hi (not
	-- 0..hi). With min=50/max=150, value=100 → frac=0.5 (centered).
	local function valueToFrac(v: number): number
		return math.clamp((v - lo) / range, 0, 1)
	end

	slider = scope:New('TextButton') {
		-- TextButton not Frame so we get reliable InputBegan/InputEnded
		-- semantics for both mouse and touch. Text = '' keeps it invisible.
		Name = 'Slider',
		Size = UDim2.fromOffset(CONTROL_W, 14),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = '',
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.7, Thickness = 1 },
			-- Filled portion — bound to DisplayValue so the visual moves
			-- responsively while dragging, regardless of whether commit
			-- is live or deferred. Uses valueToFrac so a slider with
			-- min=50/max=150 shows half-fill at value=100.
			scope:New('Frame') {
				Name = 'Fill',
				Size = scope:Computed(function(use)
					return UDim2.fromScale(valueToFrac(use(DisplayValue)), 1)
				end),
				BackgroundColor3 = PALETTE.accent,
				BackgroundTransparency = 0.25,
				BorderSizePixel = 0,
			},
			-- Thumb — small square at the current position; purely visual.
			scope:New('Frame') {
				Name = 'Thumb',
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = scope:Computed(function(use)
					return UDim2.fromScale(valueToFrac(use(DisplayValue)), 0.5)
				end),
				Size = UDim2.fromOffset(6, 14),
				BackgroundColor3 = PALETTE.accentHot,
				BorderSizePixel = 0,
				ZIndex = 2,
			},
		},
	}

	-- Drag state machine. We use UIS.InputChanged for MouseMovement while
	-- `dragging` is true so the slider keeps tracking even if the cursor
	-- leaves the slider's rect mid-drag — without it, the slider would
	-- "stick" the moment you dragged past the bar edge.
	slider.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	slider.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
			-- Deferred-commit case: DisplayValue and CommitValue are
			-- different Values, so we publish the final drag position
			-- to CommitValue once on release (rather than every pixel).
			-- For live-commit they're the same Value — the conditional
			-- write is then a no-op since CommitValue already equals
			-- DisplayValue, but Fusion observers still fire harmlessly.
			if CommitValue ~= DisplayValue then
				CommitValue:set(peek(DisplayValue))
			end
		end
	end)
	local uisConn = UserInputService.InputChanged:Connect(function(input: InputObject)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			setFromX(input.Position.X)
		end
	end)
	-- For live-commit sliders only: every DisplayValue change forwards to
	-- CommitValue (which IS DisplayValue, so writes are direct). For
	-- deferred-commit sliders, this is skipped — CommitValue updates only
	-- on InputEnded above.
	-- (No code needed; the dispatch's Observer is on CommitValue, and
	-- when DisplayValue == CommitValue, every DisplayValue:set() above
	-- already fires that Observer.)
	-- Disconnect when the slider is destroyed (scope cleanup reparents it to nil).
	slider.AncestryChanged:Connect(function(_, parent)
		if parent == nil then uisConn:Disconnect() end
	end)

	return slider
end

----------------------------------------------------------------------
-- Toggle control — segmented ON / OFF control bound to a Value<boolean>.
----------------------------------------------------------------------
-- Two adjacent TextButtons form a single segmented pair. The side matching
-- the current value lights up (accent fill + accent text); the opposite
-- side dims (transparent fill + inkDim text). Clicking either side writes
-- the value directly (ON button sets true, OFF sets false) rather than
-- toggling — this makes the affordance obvious: you click the state you
-- want, you don't "flip" a single button.
local function buildToggle(scope, SettingValue)
	-- Factory for one segment. `targetState` is what clicking writes;
	-- `label` is the text shown.
	local function segment(targetState: boolean, label: string, layoutOrder: number)
		-- isOn = does this segment represent the CURRENT value?
		local isOn = scope:Computed(function(use)
			return use(SettingValue) == targetState
		end)
		return scope:New('TextButton') {
			Name = label,
			LayoutOrder = layoutOrder,
			Size = UDim2.new(0.5, 0, 1, 0),   -- half the container, full height
			AutoButtonColor = false,
			BorderSizePixel = 0,
			BackgroundColor3 = PALETTE.accent,
			BackgroundTransparency = scope:Computed(function(use)
				return use(isOn) and 0.7 or 1    -- accent fill when active; fully transparent when off
			end),
			FontFace = HUDCommon.FONT_MONO,
			Text = label,
			TextSize = 11,
			TextColor3 = scope:Computed(function(use)
				return use(isOn) and PALETTE.accent or PALETTE.inkDim
			end),
			[Fusion.OnEvent('Activated')] = function()
				SettingValue:set(targetState)
			end,
		}
	end

	-- Container owns the single outer stroke so the two halves read as one
	-- segmented control, not two separate buttons. Each segment's own
	-- background transparency + text color flips reactively; the stroke
	-- stays steady accent. A visual divider between the halves would be
	-- nice but would fight the UIListLayout's horizontal flow (the same
	-- trap the sub-tabs hit — a 1-px wide child gets swept into the flow
	-- and offsets the segments). The always-lit active side is enough
	-- visual signal to distinguish which half is which.
	return scope:New('Frame') {
		Name = 'Toggle',
		Size = UDim2.fromOffset(100, 24),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.45, Thickness = 1 },
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 0),
			},
			segment(true,  'ON',  1),
			segment(false, 'OFF', 2),
		},
	}
end

----------------------------------------------------------------------
-- Dropdown control — header button + absolutely-positioned options list.
----------------------------------------------------------------------
-- Opening the dropdown flips an `IsOpen` Value local to this control.
-- The options list is a sibling of the header (inside the same dropdown
-- Frame), and the chain Row → Dropdown → Options all reacts to `IsOpen`:
-- when the dropdown is ACTIVE every level jumps to ZIndex=50 so its
-- popup paints above every other row's subtree; when CLOSED every level
-- drops back to 1 so two adjacent dropdowns don't fight each other for
-- paint order at rest. (Sibling ZIndexBehavior — descendants stack by
-- their parent's ZIndex among siblings, so the whole chain needs to
-- toggle together.) Clicking an option sets the value and closes the list.
--
-- Returns (frame, isOpen) so the row constructor in `Build` can bind
-- the ROW's ZIndex to the same `IsOpen` Value the dropdown owns.
local function buildDropdown(scope, SettingValue, options: {string})
	local IsOpen = scope:Value(false)

	-- Computed reused by the Dropdown frame + the Options popup, so they
	-- jump in lockstep with the row outside.
	local activeZIndex = scope:Computed(function(use)
		return use(IsOpen) and 50 or 1
	end)

	local chevron = scope:Computed(function(use)
		return use(IsOpen) and '▲' or '▼'
	end)

	local header = scope:New('TextButton') {
		Name = 'Header',
		Size = UDim2.fromOffset(CONTROL_W, 24),
		AutoButtonColor = false,
		BorderSizePixel = 0,
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.3,
		FontFace = HUDCommon.FONT_UI,
		Text = '',   -- label rendered via child so we can place the chevron separately
		[Fusion.OnEvent('Activated')] = function()
			IsOpen:set(not peek(IsOpen))
		end,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.5, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 8),
			},
			-- Current selection label.
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.fromScale(0, 0.5),
				Size = UDim2.new(1, -14, 1, 0),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_UI,
				Text = scope:Computed(function(use) return tostring(use(SettingValue)) end),
				TextSize = 12,
				TextColor3 = PALETTE.ink,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
				TextTruncate = Enum.TextTruncate.AtEnd,
			},
			-- Chevron flips when open.
			scope:New('TextLabel') {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.fromScale(1, 0.5),
				Size = UDim2.fromOffset(10, 14),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = chevron,
				TextSize = 9,
				TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Right,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
		},
	}

	-- Options list — one TextButton per option, stacked in a UIListLayout.
	-- Anchored just below the header (AnchorPoint 0,0 + Position Y = header
	-- height + 4 px gap). Hidden until IsOpen flips.
	local optionButtons = {}
	for i, opt in options do
		local isCurrent = scope:Computed(function(use) return use(SettingValue) == opt end)
		table.insert(optionButtons, scope:New('TextButton') {
			Name = 'Option_' .. opt,
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 24),
			AutoButtonColor = false,
			BorderSizePixel = 0,
			BackgroundColor3 = scope:Computed(function(use)
				return use(isCurrent) and PALETTE.accent or PALETTE.bg0
			end),
			BackgroundTransparency = scope:Computed(function(use)
				return use(isCurrent) and 0.78 or 0.15
			end),
			FontFace = HUDCommon.FONT_UI,
			Text = opt,
			TextSize = 11,
			TextColor3 = scope:Computed(function(use)
				return use(isCurrent) and PALETTE.accent or PALETTE.ink
			end),
			TextXAlignment = Enum.TextXAlignment.Left,
			[Fusion.OnEvent('Activated')] = function()
				SettingValue:set(opt)
				IsOpen:set(false)
			end,
			[Fusion.Children] = {
				scope:New('UIPadding') {
					PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
				},
			},
		})
	end

	-- ScrollingFrame so dropdowns with more options than fit in
	-- DROPDOWN_MAX_VISIBLE rows scroll instead of overflowing past the
	-- next row. Active=true so the scrollwheel is captured even though
	-- the inner background is mostly translucent (Roblox routes wheel
	-- events through the topmost Active GuiObject under the cursor).
	local DROPDOWN_OPTION_H = 24
	local DROPDOWN_OPTION_GAP = 2
	local DROPDOWN_MAX_VISIBLE = 6
	local optionsListH = math.min(
		#options * DROPDOWN_OPTION_H + math.max(0, #options - 1) * DROPDOWN_OPTION_GAP,
		DROPDOWN_MAX_VISIBLE * DROPDOWN_OPTION_H + (DROPDOWN_MAX_VISIBLE - 1) * DROPDOWN_OPTION_GAP
	)
	local optionsCanvasH = #options * DROPDOWN_OPTION_H + math.max(0, #options - 1) * DROPDOWN_OPTION_GAP
	local optionsList = scope:New('ScrollingFrame') {
		Name = 'Options',
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.fromOffset(0, 24 + 2),   -- just below the header
		Size = UDim2.fromOffset(CONTROL_W, optionsListH),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		Visible = IsOpen,
		ZIndex = activeZIndex,   -- 50 while open, 1 when closed (popup is also Hidden then)
		Active = true,
		ScrollingEnabled = true,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = PALETTE.accent,
		ScrollBarImageTransparency = 0.4,
		CanvasSize = UDim2.fromOffset(0, optionsCanvasH),
		ElasticBehavior = Enum.ElasticBehavior.Never,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, DROPDOWN_OPTION_GAP),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			table.unpack(optionButtons),
		},
	}

	-- Container Frame — holds header + options list. Same pixel footprint as
	-- the header; the options list overflows downward outside its bounds.
	-- ZIndex tracks `IsOpen` so closed dropdowns sit at the row default and
	-- only the active one elevates.
	local frame = scope:New('Frame') {
		Name = 'Dropdown',
		Size = UDim2.fromOffset(CONTROL_W, 24),
		BackgroundTransparency = 1,
		ZIndex = activeZIndex,
		[Fusion.Children] = { header, optionsList },
	}
	return frame, IsOpen
end

----------------------------------------------------------------------
-- Readout label — the number/text on the far right of the row.
-- Slider: current integer. Toggle: ON/OFF (mirrors pill). Dropdown: empty.
----------------------------------------------------------------------
local function buildReadout(scope, kind: string, SettingValue)
	-- Dropdowns and toggles self-display (dropdown header shows the current
	-- value; segmented toggle pair shows which side is lit). An empty
	-- spacer keeps row alignment consistent with slider rows.
	if kind == 'dropdown' or kind == 'toggle' then
		return scope:New('Frame') {
			LayoutOrder = 4,
			Size = UDim2.fromOffset(READOUT_W, 16),
			BackgroundTransparency = 1,
		}
	end
	-- Slider: numeric readout.
	return scope:New('TextLabel') {
		LayoutOrder = 4,
		Size = UDim2.fromOffset(READOUT_W, 16),
		BackgroundTransparency = 1,
		FontFace = HUDCommon.FONT_MONO,
		Text = scope:Computed(function(use) return tostring(use(SettingValue)) end),
		TextSize = 11,
		TextColor3 = PALETTE.accent,
		TextXAlignment = Enum.TextXAlignment.Right,
	}
end

----------------------------------------------------------------------
-- Build(ctx)
----------------------------------------------------------------------

function Module.Build(ctx)
	local scope = ctx.scope

	-- Interleaved rows + dividers, with even LayoutOrder for rows and odd
	-- for dividers between them (no leading or trailing divider).
	local scrollChildren = {}
	for i, s in getSettingsRows() do
		-- Each row owns up to TWO Fusion Values:
		--   DisplayValue — drives the visual (slider thumb, readout text).
		--   CommitValue  — what flows out to SettingsRegistry. Triggers
		--                  the publishSetting observer, which can be heavy
		--                  (UI scale rebuilds, theme rebuilds, etc.).
		-- For most rows DisplayValue == CommitValue (one Value, written
		-- directly). For sliders flagged with `s.commitOnRelease` (UI
		-- scale), they're two distinct Values so the slider can defer
		-- the heavy commit to mouse-up / touch-end while still moving
		-- the thumb + readout responsively during the drag.
		local DisplayValue = scope:Value(s.value)
		local CommitValue = (s.kind == 'slider' and s.commitOnRelease)
			and scope:Value(s.value)
			or DisplayValue

		-- Publish to SettingsRegistry whenever the COMMIT value changes
		-- (rows whose `key` isn't in REGISTRY_KEY no-op inside publishSetting).
		-- We DO NOT push an initial value here: the registry already owns
		-- the source of truth (its module-level defaults), and we read from
		-- it inside getSettingsRows above. Re-publishing on every Build
		-- would clobber user-set values on rebuild AND can recursively
		-- retrigger rebuilds when fired in response to a registry change.
		if REGISTRY_KEY[s.key] then
			scope:Observer(CommitValue):onChange(function()
				publishSetting(s.key, peek(CommitValue))
			end)
		end

		-- Dispatch by kind. Each branch returns the control Frame used in
		-- LayoutOrder = 3 (between label and readout). For dropdowns we
		-- also capture the `IsOpen` Value so the row's ZIndex can react
		-- to its child dropdown's open state — only the active row pops
		-- forward; idle rows sit at the default so they don't fight one
		-- another for paint order.
		local control
		local controlIsOpen   -- non-nil only for dropdown rows
		if s.kind == 'slider' then
			control = buildSlider(scope, DisplayValue, CommitValue, s.max or 100, s.min)
		elseif s.kind == 'toggle' then
			control = buildToggle(scope, DisplayValue)
		elseif s.kind == 'dropdown' then
			control, controlIsOpen = buildDropdown(scope, DisplayValue, s.options or {})
		else
			error('Unknown settings row kind: ' .. tostring(s.kind))
		end
		control.LayoutOrder = 3

		-- Insert a divider BEFORE this row if it's not the first. Each divider
		-- gets its own LayoutOrder so UIListLayout keeps it between the rows
		-- in the right place (rows are at i*2, dividers at i*2-1).
		if i > 1 then
			table.insert(scrollChildren, scope:New('Frame') {
				Name = 'Divider_' .. tostring(i),
				LayoutOrder = i * 2 - 1,
				Size = UDim2.new(1, 0, 0, 1),
				BackgroundColor3 = PALETTE.accent,
				BackgroundTransparency = 0.85,
				BorderSizePixel = 0,
			})
		end

		table.insert(scrollChildren, scope:New('Frame') {
			Name = 'Row_' .. s.key,
			LayoutOrder = i * 2,
			Size = UDim2.new(1, 0, 0, ROW_H),
			BackgroundTransparency = 1,   -- flat row; dividers provide visual separation
			BorderSizePixel = 0,
			-- Dropdown rows pop their ZIndex to 50 *only while open* so the
			-- popup paints over later rows; idle dropdown rows stay at the
			-- default (1) and don't compete with each other for paint
			-- order. Bound directly to the dropdown's own `IsOpen` value
			-- (returned from `buildDropdown`). Non-dropdown rows skip the
			-- Computed entirely — they're always at 1.
			--
			-- Inside a ScrollingFrame with ClipsDescendants = true (Roblox
			-- default), a popup extending below the scroll viewport will
			-- still clip — ZIndex doesn't bypass clipping; the user has to
			-- scroll if a dropdown is near the bottom.
			ZIndex = controlIsOpen
				and scope:Computed(function(use) return use(controlIsOpen) and 50 or 1 end)
				or 1,
			[Fusion.Children] = {
				scope:New('UIPadding') {
					PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14),
				},
				scope:New('UIListLayout') {
					FillDirection = Enum.FillDirection.Horizontal,
					Padding = UDim.new(0, 14),
					VerticalAlignment = Enum.VerticalAlignment.Center,
					SortOrder = Enum.SortOrder.LayoutOrder,
				},
				-- Glyph.
				scope:New('TextLabel') {
					LayoutOrder = 1,
					Size = UDim2.fromOffset(18, 18),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_UI, Text = GLYPH, TextSize = 14,
					TextColor3 = PALETTE.accent,
				},
				-- Label (flex width between glyph and control).
				scope:New('TextLabel') {
					LayoutOrder = 2,
					Size = UDim2.new(1, -(CONTROL_W + READOUT_W + 60), 0, 16),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_UI, Text = s.label, TextSize = 13,
					TextColor3 = PALETTE.ink, TextXAlignment = Enum.TextXAlignment.Left,
				},
				control,
				-- Readout reads DisplayValue so the number ticks live during a
				-- deferred-commit drag — user sees what they're dragging to,
				-- the heavy registry write only fires on release.
				buildReadout(scope, s.kind, DisplayValue),
			},
		})
	end

	-- // Keybinds section — fake hotbar grid + click-to-rebind //
	-- Appended at the bottom of the settings scroll so it's discoverable
	-- alongside the rest of the system-level toggles. The 24 slots
	-- mirror the live hotbar's slotIds so changes here propagate
	-- immediately to the in-game hotbar's keybind chips.
	do
		local HotbarWidget = require(LocalPlayer:WaitForChild('PlayerScripts')
			:WaitForChild('Core'):WaitForChild('Widgets'):WaitForChild('HotbarWidget'))
		local ReplicatedData = ReplicatedModules.Services.ReplicatedData

		local KEYBIND_LAYOUT_BASE = #scrollChildren + 10

		-- Capture state — slotId of the slot currently waiting for a
		-- keypress, or nil if no rebind is in progress.
		local CapturingSlot = scope:Value(nil :: string?)
		-- Tick bumped when PlayerData replicates so each slot's displayed
		-- keybind text re-evaluates (live update when one slot is
		-- rebound, the chip on that slot reflects the new key).
		local KeybindReadTick = scope:Value(0)
		local kbDataConn
		if ReplicatedData and ReplicatedData.OnUpdated then
			kbDataConn = ReplicatedData.OnUpdated:Connect(function(category)
				-- Skip when the tab menu is closed — the slot chips aren't
				-- visible, and the parent TabWidget already gates its own
				-- DataVersion bump. On reopen, OpenWidget bumps DataVersion
				-- which causes the slot Computeds to re-evaluate against
				-- the latest snapshot regardless of this tick.
				if category ~= 'PlayerData' then return end
				if ctx.IsOpen and not peek(ctx.IsOpen) then return end
				KeybindReadTick:set((peek(KeybindReadTick) + 1) % 1e6)
			end)
			-- Cleanup on tab rebuild — Fusion calls each function in scope.
			table.insert(scope, function()
				if kbDataConn then kbDataConn:Disconnect(); kbDataConn = nil end
			end)
		end

		-- One-shot keypress capture. Started when the user clicks a
		-- keybind slot; the next keypress (other than Escape) becomes
		-- the new keybind and the connection self-disconnects. Esc
		-- cancels without writing.
		local captureConn: RBXScriptConnection? = nil
		local function endCapture()
			if captureConn then captureConn:Disconnect(); captureConn = nil end
			CapturingSlot:set(nil)
		end
		-- Cleanup on scope teardown.
		table.insert(scope, function() endCapture() end)
		local function startCapture(slotId: string)
			-- If already capturing a different slot, cancel that first.
			endCapture()
			CapturingSlot:set(slotId)
			captureConn = UserInputService.InputBegan:Connect(function(input)
				if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
				local kc = input.KeyCode
				if kc == Enum.KeyCode.Escape then
					endCapture()
					return
				end
				local raw = UserInputService:GetStringForKeyCode(kc)
				if not raw or #raw == 0 then return end
				-- Lowercase to match the storage convention. Server
				-- rejects uppercase so this is the single source of
				-- truth on case.
				HotbarWidget.SetKeybind(slotId, string.lower(raw))
				endCapture()
			end)
		end

		-- Build a single 46x46 keybind slot button. `label` is shown
		-- below the key char as a small slot identifier (e.g. "R1·3").
		local function buildKeybindSlot(slotId: string, label: string, layoutOrder: number)
			local capturing = scope:Computed(function(use)
				return use(CapturingSlot) == slotId
			end)
			local keyText = scope:Computed(function(use)
				use(KeybindReadTick)
				if use(capturing) then return '...' end
				return string.upper(HotbarWidget.GetKeybindForSlot(slotId) or '?')
			end)
			return scope:New('TextButton') {
				Name = 'Keybind_' .. slotId,
				LayoutOrder = layoutOrder,
				Size = UDim2.fromOffset(46, 46),
				BackgroundColor3 = scope:Computed(function(use)
					return use(capturing) and PALETTE.accent or PALETTE.bg0
				end),
				BackgroundTransparency = scope:Computed(function(use)
					return use(capturing) and 0.55 or 0.25
				end),
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = '',
				[Fusion.OnEvent('Activated')] = function() startCapture(slotId) end,
				[Fusion.Children] = {
					scope:New('UIStroke') {
						Color = PALETTE.accent,
						Transparency = scope:Computed(function(use)
							return use(capturing) and 0 or 0.5
						end),
						Thickness = 1,
					},
					-- Big keybind char (top half).
					scope:New('TextLabel') {
						AnchorPoint = Vector2.new(0.5, 0),
						Position = UDim2.new(0.5, 0, 0, 4),
						Size = UDim2.new(1, 0, 0, 22),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_DISPLAY,
						Text = keyText,
						TextSize = 18,
						TextColor3 = PALETTE.ink,
					},
					-- Slot label (bottom half, smaller).
					scope:New('TextLabel') {
						AnchorPoint = Vector2.new(0.5, 1),
						Position = UDim2.new(0.5, 0, 1, -4),
						Size = UDim2.new(1, 0, 0, 10),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = label,
						TextSize = 9,
						TextColor3 = PALETTE.inkDim,
					},
				},
			}
		end

		-- Section header.
		table.insert(scrollChildren, scope:New('Frame') {
			LayoutOrder = KEYBIND_LAYOUT_BASE,
			Size = UDim2.new(1, 0, 0, 28),
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				scope:New('UIPadding') { PaddingLeft = UDim.new(0, 14), PaddingTop = UDim.new(0, 12) },
				scope:New('TextLabel') {
					Size = UDim2.new(1, 0, 0, 14),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = '◆ KEYBINDS',
					TextSize = 11,
					TextColor3 = PALETTE.accent,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
			},
		})

		-- Hint line.
		table.insert(scrollChildren, scope:New('TextLabel') {
			LayoutOrder = KEYBIND_LAYOUT_BASE + 1,
			Size = UDim2.new(1, 0, 0, 14),
			BackgroundTransparency = 1,
			FontFace = HUDCommon.FONT_UI,
			Text = scope:Computed(function(use)
				return use(CapturingSlot)
					and 'Press a key to bind  (Esc to cancel)'
					or 'Click a slot, then press a key to rebind it.'
			end),
			TextSize = 11,
			TextColor3 = scope:Computed(function(use)
				return use(CapturingSlot) and PALETTE.accent or PALETTE.inkDim
			end),
			TextXAlignment = Enum.TextXAlignment.Left,
			[Fusion.Children] = {
				scope:New('UIPadding') { PaddingLeft = UDim.new(0, 14) },
			},
		})

		-- Build one row frame with a row label + 12 keybind slots.
		local function buildRow(slotIds: { string }, rowLabel: string, layoutOrder: number, slotPrefix: string)
			local children = {
				scope:New('UIListLayout') {
					FillDirection = Enum.FillDirection.Horizontal,
					Padding = UDim.new(0, 4),
					VerticalAlignment = Enum.VerticalAlignment.Center,
					SortOrder = Enum.SortOrder.LayoutOrder,
				},
				scope:New('TextLabel') {
					LayoutOrder = 0,
					Size = UDim2.fromOffset(28, 46),
					BackgroundTransparency = 1,
					FontFace = HUDCommon.FONT_MONO,
					Text = rowLabel,
					TextSize = 10,
					TextColor3 = PALETTE.inkDim,
					TextXAlignment = Enum.TextXAlignment.Left,
				},
			}
			for i, slotId in slotIds do
				table.insert(children, buildKeybindSlot(slotId, slotPrefix .. tostring(i), i))
			end
			return scope:New('Frame') {
				LayoutOrder = layoutOrder,
				Size = UDim2.new(1, 0, 0, 52),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIPadding') { PaddingLeft = UDim.new(0, 14), PaddingTop = UDim.new(0, 4) },
					scope:New('Frame') {
						Size = UDim2.fromScale(1, 1),
						BackgroundTransparency = 1,
						[Fusion.Children] = children,
					},
				},
			}
		end

		-- Pull slot IDs by introspecting HotbarWidget so they stay in
		-- sync if HotbarWidget ever extends to more slots.
		local allSlotIds = HotbarWidget.GetAllSlotIds()
		local row1Ids, row2Ids = {}, {}
		for _, id in allSlotIds do
			if string.sub(id, 1, 3) == 'r1_' then table.insert(row1Ids, id)
			elseif string.sub(id, 1, 3) == 'r2_' then table.insert(row2Ids, id)
			end
		end
		table.insert(scrollChildren, buildRow(row1Ids, 'R1', KEYBIND_LAYOUT_BASE + 2, 'R1·'))
		table.insert(scrollChildren, buildRow(row2Ids, 'R2', KEYBIND_LAYOUT_BASE + 3, 'R2·'))

		-- // Combat action keybinds //
		-- Block / Sheathe / Mount / Heal / Dash. Stored in
		-- PlayerData.ActionKeybinds (separate from PlayerData.Keybinds
		-- because action keybinds use Roblox KeyCode names — supports
		-- modifiers like LeftControl that aren't single printable chars).
		-- Defaults baked into CombatInputClient.DEFAULT_ACTION_KEYBINDS.
		local RemoteService = ReplicatedModules.Services.RemoteService
		local ActionKeybindEvent = RemoteService.GetRemote('ActionKeybindEvent', 'RemoteEvent', false)
		local DEFAULT_ACTION_KEYBIND_DEFAULTS = {
			Block         = 'F',         SheatheToggle = 'Q',
			Mount         = 'G',         Heal          = 'H',
			Dash          = 'LeftControl', HeavyAttack = 'T',
		}
		local COMBAT_ACTIONS = {
			{ id = 'Block',         label = 'BLOCK' },
			{ id = 'SheatheToggle', label = 'SHEATHE' },
			{ id = 'Mount',         label = 'MOUNT' },
			{ id = 'Heal',          label = 'HEAL' },
			{ id = 'Dash',          label = 'DASH' },
			{ id = 'HeavyAttack',   label = 'HEAVY ATTACK' },
		}

		-- Capture state mirrors the hotbar slot capture above. One at
		-- a time across the whole tab — capturing an action cancels any
		-- prior capture (hotbar slot OR another action).
		local CapturingActionId = scope:Value(nil :: string?)
		local actionCaptureConn: RBXScriptConnection? = nil
		local function endActionCapture()
			if actionCaptureConn then actionCaptureConn:Disconnect(); actionCaptureConn = nil end
			CapturingActionId:set(nil)
		end
		table.insert(scope, function() endActionCapture() end)

		local function startActionCapture(actionId: string)
			endActionCapture()
			endCapture()  -- hotbar slot capture defined above; mutually exclusive
			CapturingActionId:set(actionId)
			actionCaptureConn = UserInputService.InputBegan:Connect(function(input)
				if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
				local kc = input.KeyCode
				if kc == Enum.KeyCode.Escape then
					endActionCapture()
					return
				end
				-- Action keybinds store the KeyCode.Name string ('F',
				-- 'LeftControl', etc.) — full name, NOT lowercased,
				-- because the server resolves via Enum.KeyCode[name]
				-- which is case-sensitive.
				ActionKeybindEvent:FireServer(actionId, kc.Name)
				endActionCapture()
			end)
		end

		-- Resolve display string for an action's current keybind. Reads
		-- override from PlayerData.ActionKeybinds; falls back to the
		-- baked default. Reactive on KeybindReadTick so a rebind
		-- updates immediately.
		local function actionKeyText(actionId: string)
			return scope:Computed(function(use)
				use(KeybindReadTick)
				if use(CapturingActionId) == actionId then return '...' end
				local data = ReplicatedData.GetData('PlayerData', false)
				local override = data and typeof(data.ActionKeybinds) == 'table'
					and data.ActionKeybinds[actionId]
				local name = (typeof(override) == 'string' and #override > 0)
					and override
					or DEFAULT_ACTION_KEYBIND_DEFAULTS[actionId]
				if not name then return '?' end
				-- Compact display for common modifier names.
				if name == 'LeftControl' then return 'LCTRL' end
				if name == 'RightControl' then return 'RCTRL' end
				if name == 'LeftAlt' then return 'LALT' end
				if name == 'RightAlt' then return 'RALT' end
				if name == 'LeftShift' then return 'LSHFT' end
				if name == 'RightShift' then return 'RSHFT' end
				return string.upper(name)
			end)
		end

		-- Section header.
		table.insert(scrollChildren, scope:New('TextLabel') {
			LayoutOrder = KEYBIND_LAYOUT_BASE + 4,
			Size = UDim2.new(1, 0, 0, 22),
			BackgroundTransparency = 1,
			FontFace = HUDCommon.FONT_MONO,
			Text = '◆ COMBAT ACTIONS',
			TextSize = 11,
			TextColor3 = PALETTE.accent,
			TextXAlignment = Enum.TextXAlignment.Left,
			[Fusion.Children] = {
				scope:New('UIPadding') { PaddingLeft = UDim.new(0, 14), PaddingTop = UDim.new(0, 12) },
			},
		})

		-- Build one row holding all five action chips (62×46 each so
		-- the longer "SHEATHE" / "LCTRL" labels fit).
		local actionChildren = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 6),
				VerticalAlignment = Enum.VerticalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
		}
		for i, action in COMBAT_ACTIONS do
			local capturing = scope:Computed(function(use)
				return use(CapturingActionId) == action.id
			end)
			table.insert(actionChildren, scope:New('TextButton') {
				Name = 'ActionKeybind_' .. action.id,
				LayoutOrder = i,
				Size = UDim2.fromOffset(82, 46),
				BackgroundColor3 = scope:Computed(function(use)
					return use(capturing) and PALETTE.accent or PALETTE.bg0
				end),
				BackgroundTransparency = scope:Computed(function(use)
					return use(capturing) and 0.55 or 0.25
				end),
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = '',
				[Fusion.OnEvent('Activated')] = function() startActionCapture(action.id) end,
				[Fusion.Children] = {
					scope:New('UIStroke') {
						Color = PALETTE.accent,
						Transparency = scope:Computed(function(use)
							return use(capturing) and 0 or 0.5
						end),
						Thickness = 1,
					},
					-- Top: keybind char (large).
					scope:New('TextLabel') {
						AnchorPoint = Vector2.new(0.5, 0),
						Position = UDim2.new(0.5, 0, 0, 4),
						Size = UDim2.new(1, 0, 0, 20),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_DISPLAY,
						Text = actionKeyText(action.id),
						TextSize = 16,
						TextColor3 = PALETTE.ink,
					},
					-- Bottom: action label.
					scope:New('TextLabel') {
						AnchorPoint = Vector2.new(0.5, 1),
						Position = UDim2.new(0.5, 0, 1, -4),
						Size = UDim2.new(1, 0, 0, 12),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = action.label,
						TextSize = 9,
						TextColor3 = PALETTE.inkDim,
					},
				},
			})
		end
		table.insert(scrollChildren, scope:New('Frame') {
			LayoutOrder = KEYBIND_LAYOUT_BASE + 5,
			Size = UDim2.new(1, 0, 0, 52),
			BackgroundTransparency = 1,
			[Fusion.Children] = {
				scope:New('UIPadding') { PaddingLeft = UDim.new(0, 14), PaddingTop = UDim.new(0, 4) },
				scope:New('Frame') {
					Size = UDim2.fromScale(1, 1),
					BackgroundTransparency = 1,
					[Fusion.Children] = actionChildren,
				},
			},
		})
	end

	-- // ScrollingFrame // — holds the row list. Eyebrow + title stay pinned
	-- above via the outer Tab root's UIListLayout, so only the settings
	-- rows scroll. `AutomaticCanvasSize.Y` lets the canvas auto-size from
	-- the inner UIListLayout's content height, so the scrollbar shows up
	-- exactly when rows overflow the viewport.
	local scrollFrame = scope:New('ScrollingFrame') {
		Name = 'SettingsScroll',
		LayoutOrder = 4,
		-- Scale height = 100% of the tab minus the pixel budget consumed
		-- above it: eyebrow (14) + title (30) + spacer (8) + three 4-px
		-- UIListLayout gaps = 64 px. Tab's own 24-px vertical padding is
		-- already outside this math (it's applied to the tab root's
		-- contentbox, not to each child's Size).
		Size = UDim2.new(1, 0, 1, -64),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.fromScale(0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = PALETTE.accent,
		ScrollBarImageTransparency = 0.4,
		ElasticBehavior = Enum.ElasticBehavior.Never,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		[Fusion.Children] = {
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 0),    -- dividers already provide spacing
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			-- 2 px right-padding so the last row doesn't kiss the scrollbar.
			scope:New('UIPadding') { PaddingRight = UDim.new(0, 2) },
			table.unpack(scrollChildren),
		},
	}

	return scope:New('Frame') {
		Name = 'SettingsTab',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, 24), PaddingBottom = UDim.new(0, 24),
				PaddingLeft = UDim.new(0, 32), PaddingRight = UDim.new(0, 32),
			},
			scope:New('UIListLayout') {
				Padding = UDim.new(0, 4),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			Utils.eyebrow(scope, '◆ SETTINGS', { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 14) }),
			Utils.displayTitle(scope, { Text = 'System', LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 30) }),
			scope:New('Frame') {
				LayoutOrder = 3,
				Size = UDim2.fromOffset(0, 8),
				BackgroundTransparency = 1,
			},
			scrollFrame,
		},
	}
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/TabWidget/SkillsTab.luau"><![CDATA[-- // TabWidget/SkillsTab.luau //
-- Three-column skill screen:
--   left   — schools rail (Active / One-Hand / Katana / Martial / Searching
--            / Hiding / Passives) with per-school rank chip, plus an UNSPENT
--            PTS box.
--   center — SWORD-ART-STYLE SKILL GRAPH. A PanZoomCanvas holds hex tiles
--            arranged on a radial hex grid (positions resolved by
--            SkillTreeLayout.resolve from Skills.Trees) with connection
--            lines tracing each `depends` edge; right/middle-click drag
--            pans, wheel zooms (anchored to cursor).
--   right  — node detail pane (title / ULT tag / stat grid / equip button).
--
-- Reference: tmp/aincrad-ui/character.jsx SkillTree (SVG hex tree).
-- Roblox has no polygon primitive — each hex tile is rendered as 6 rotated
-- edge frames forming the perimeter (no font dependency, unlike a glyph
-- stack). All sit under the canvas's UIScale so zoom affects the whole
-- graph uniformly.
--
-- Note on RailButton: components.RailButton fits most rail-style nav buttons
-- but the schools rows carry a STRING rank ("S" / "A" / etc.) instead of a
-- numeric count, and have no glyph. Rather than bend the component's API to
-- fit, the school row is built manually here. If RailButton gains a
-- string-chip slot later, this is a candidate migration target.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local UserInputService = game:GetService('UserInputService')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion
local peek   = Fusion.peek

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PanZoomCanvas = LocalModules.Modules.PanZoomCanvas
local UISinkInputs = LocalModules.Utility.UISinkInputs
local PALETTE = HUDCommon.PALETTE

local Utils      = require(script.Parent.utils)
local Components = require(script.Parent.components)

local Module = {}

-- 1394×648 outer canvas; asymmetric 0/20/20/20 padding (skill canvas hugs
-- the left edge) leaves 1374×608 inner. 3-col layout.
local OUTER_W, OUTER_H   = 1394, 648
local DESIGN_W, DESIGN_H = 1374, 608
local LEFT_COL_PX        = 220
local RIGHT_COL_PX       = 280
local COL_GAP_PX         = 12

----------------------------------------------------------------------
-- Schools roster + skill-graph node data (per-school nodes hardcoded
-- for now — no SkillsConfig backing store exists yet).
----------------------------------------------------------------------
local SKILL_SCHOOLS = {
	-- 'dual' id is historical (originally Dual Wield); display name is
	-- now the catch-all "Active" tree until per-weapon trees ship.
	{ id = 'dual',     name = 'Active',     rank = 'S' },
	{ id = 'one',      name = 'One-Hand',   rank = 'A' },
	{ id = 'katana',   name = 'Katana',     rank = 'B' },
	{ id = 'martial',  name = 'Martial',    rank = 'C' },
	{ id = 'search',   name = 'Searching',  rank = 'B' },
	{ id = 'hide',     name = 'Hiding',     rank = 'A' },
	-- Passives live on their own rail entry — they don't gate behind any
	-- combat school's prereqs and the per-level SP cost is higher than the
	-- active skill default, so segregating them keeps the active trees
	-- visually clean and reads "permanent stat bonuses" as a category.
	{ id = 'passives', name = 'Passives',   rank = 'P' },
}

-- // Skill graph data + layout //
-- The radial hex layout is computed once at module load by
-- SkillTreeLayout.resolve, which consumes Skills.Trees[<schoolName>] (a
-- {Nodes = {[id] = {depends = {...}}}} graph auto-built from each
-- SkillConfig's Prereqs). The resolver returns each node's pixel center
-- (x, y), axial hex coords (q, r), depth, and angle, plus the canvas
-- bounding box — we feed CanvasW/H straight into PanZoomCanvas.
--
-- Per-node visual metadata (display name, passive flag, ULT marker, …)
-- still comes from SkillsConfig and is merged into the SKILL_NODES array
-- below. `unlocked` and `level` are refreshed per render in Module.Build
-- against live PlayerData.Skills.
local SkillsConfig    = ReplicatedModules.Data.Skills
local SkillTreeLayout = ReplicatedModules.Services.SkillTreeLayout

-- Hex tile sizing. HEX_RADIUS is the pointy-top center-to-corner radius;
-- ULT tiles use a slightly larger radius so the finisher stands out at
-- typical zoom. Label sits below the tile, outside the hex bbox.
local HEX_RADIUS      = 44
local HEX_ULT_RADIUS  = 56
local HEX_LABEL_H     = 30
local HEX_LABEL_GAP   = 6
local SKILL_CANVAS_PAD = 80    -- mirror of resolver default; kept here for label-bbox math

-- ULT tag — the larger hex tile. Detected from a skill's HexagonColor:
-- the gold "finisher" color is treated as ULT, everything else regular.
-- Avoids carrying a parallel ULT_SKILL_IDS table; the color choice on
-- the skill cfg is the single source of truth.
local ULT_HEX_RGB = Color3.fromRGB(245, 200, 80)
local function isUltColor(c: Color3?): boolean
	if not c then return false end
	-- Tolerate small Color3 round-trip drift; exact-equality comparison
	-- on Color3 is generally safe, but allow ±0.005 channel slop.
	return math.abs(c.R - ULT_HEX_RGB.R) < 0.01
		and math.abs(c.G - ULT_HEX_RGB.G) < 0.01
		and math.abs(c.B - ULT_HEX_RGB.B) < 0.01
end

-- Build the per-tab { nodes = { merged-node-array }, index = … } bundle
-- once at module load. Switching tabs at runtime just toggles which
-- bundle's frames are visible — no re-resolve.
--
-- `tabCategory` here is a SKILL_SCHOOLS.id ('dual', 'one', …). Schools
-- without a Skills.Trees entry get an empty `{ Nodes = {} }` tree so the
-- resolver still returns a valid Layout (zero nodes, minimum canvas).
-- The empty bundle drives the "no skills authored yet" placeholder in
-- the center column without falling through any nil-handling path.
local function buildSchoolBundle(tabCategory: string)
	local tree = SkillsConfig.Trees[tabCategory] or { Nodes = {} }
	local layout = SkillTreeLayout.resolve(tree, {
		HexSize = HEX_RADIUS,
		Spread  = 1.85,                 -- tile centers ~1.85× radius apart so hexes don't touch
		Padding = SKILL_CANVAS_PAD,
	})
	-- Merge layout positions with display metadata from SkillsConfig.
	-- Order is sorted by depth then id so connection lines parent before
	-- their dependents (visual layering is identical, but iteration is
	-- deterministic across reloads).
	local nodes: { any } = {}
	local index: { [string]: any } = {}
	for id, pos in layout.Positions do
		local cfg = SkillsConfig.Skills[id]
		local hexColor = cfg and cfg.HexagonColor
		local n = {
			id        = id,
			name      = cfg and cfg.Display.Name or id,
			-- Read UnlockCost off the cfg so the UI label matches what
			-- SkillsServer.AttemptUnlockSkill charges. Falls back to 1
			-- (matches the server's SKILL_UNLOCK_COST default) when the
			-- skill omits the field.
			cost      = (cfg and cfg.UnlockCost) or 1,
			ult       = isUltColor(hexColor),
			prereqs   = cfg and cfg.Depends or (tree.Nodes[id] and tree.Nodes[id].depends) or {},
			passive   = cfg and cfg.Passive == true or false,
			maxLevel  = cfg and cfg.MaxLevel,
			hexColor  = hexColor,             -- forwarded to buildHexTile for stroke / icon tint
			x         = pos.x,
			y         = pos.y,
			depth     = pos.depth,
		}
		-- Bump ULT tiles outward so they always sit visually outside their
		-- immediate prereq — the resolver places by depth alone, but ULT
		-- tiles read better with extra breathing room. Translate outward
		-- along the resolved angle, NOT to a new ring slot, so we don't
		-- have to re-resolve.
		if n.ult then
			local off = (HEX_ULT_RADIUS - HEX_RADIUS) * 1.4
			n.x = n.x + math.cos(pos.angle) * off
			n.y = n.y + math.sin(pos.angle) * off
		end
		nodes[#nodes + 1] = n
		index[id] = n
	end
	table.sort(nodes, function(a, b)
		if a.depth ~= b.depth then return a.depth < b.depth end
		return a.id < b.id
	end)
	-- Account for label height + ULT tile bump in the canvas extent so
	-- nothing overhangs after the resolver's bbox-fit pass.
	local extraY = HEX_LABEL_GAP + HEX_LABEL_H
	local extraR = (HEX_ULT_RADIUS - HEX_RADIUS) * 1.4
	return {
		nodes    = nodes,
		index    = index,
		canvasW  = layout.CanvasW + 2 * extraR,
		canvasH  = layout.CanvasH + extraY + extraR,
	}
end

-- Pre-resolve a bundle for EVERY rail entry, even ones with no skills
-- authored yet. Indexed by SKILL_SCHOOLS.id (== TabCategory) so
-- SelectedSchool can look up the bundle directly. Empty schools produce
-- bundles with an empty `nodes` array; the rendering loop creates an
-- empty container for them and the placeholder text in the center
-- column reads from the active bundle's emptiness.
local SCHOOL_BUNDLES: { [string]: any } = {}
for _, school in SKILL_SCHOOLS do
	SCHOOL_BUNDLES[school.id] = buildSchoolBundle(school.id)
end

function Module.Build(ctx)
	local scope = ctx.scope
	local DataVersion = ctx.DataVersion

	-- Refresh node.unlocked + node.level from the live PlayerData.Skills
	-- map. Module.Build runs ONCE when the SkillsTab is mounted; subsequent
	-- replication ticks (DataVersion bumps) re-run only the Computeds that
	-- depend on DataVersion. The bundle nodes live in a module-level
	-- SCHOOL_BUNDLES table — plain Lua tables, not reactive — so without
	-- this side-effect Computed any node-state read after the initial
	-- mount (button label, hex tile visuals on a future tab open) would
	-- be stale.
	--
	-- NodesRefreshKey is a Computed that returns a monotonic value any
	-- time DataVersion bumps. Downstream Computeds (detailUnlockText,
	-- etc.) `use(NodesRefreshKey)` to take a dependency on the freshness
	-- without each one having to know about Utils.getPlayerData(). The
	-- side effect — mutating n.unlocked + n.level on each bundle node —
	-- runs before the key is returned, so anyone using the key reads
	-- post-refresh data.
	--
	-- Walks every pre-resolved school bundle so passive level + unlock
	-- state stay in sync regardless of which school the player is on.
	local SkillsShared = ReplicatedModules.Services.SkillsShared
	local NodesRefreshKey = scope:Computed(function(use)
		use(DataVersion)
		local data = Utils.getPlayerData()
		for _, bundle in SCHOOL_BUNDLES do
			for _, n in bundle.nodes do
				n.unlocked = SkillsShared.IsSkillUnlocked(data, n.id)
				-- Level matters only for passives; active skills always
				-- read level=1-or-0 here and the UI ignores it.
				n.level = SkillsShared.GetSkillLevel(data, n.id)
				-- Eligible = every unlock requirement (prereqs / level /
				-- attributes) is met, so only a SkillPoint stands in the way.
				-- Drives the third hex-tile visual state: a node that is
				-- neither owned nor eligible renders heavily faded ("locked").
				n.eligible = SkillsShared.IsEligibleToUnlock(data, n.id)
			end
		end
		return data
	end)

	local SelectedSchool = scope:Value('dual')

	-- Resolve the bundle for the currently-selected rail tab. SCHOOL_BUNDLES
	-- is keyed by TabCategory, which matches SKILL_SCHOOLS.id — so a direct
	-- lookup works. Returns nil when the rail tab has no tree authored;
	-- center column then shows the empty-state placeholder.
	local function bundleForRail(railId: string)
		return SCHOOL_BUNDLES[railId]
	end

	-- Initial selection prefers the first node of the initial bundle so
	-- the right-pane detail isn't blank on first open.
	local initialBundle = bundleForRail(peek(SelectedSchool))
	local SelectedNode = scope:Value(
		initialBundle and initialBundle.nodes[1] and initialBundle.nodes[1].id or nil
	)

	local selectedNodeData = scope:Computed(function(use)
		local id = use(SelectedNode)
		local bundle = bundleForRail(use(SelectedSchool))
		if not bundle then return nil end
		return bundle.index[id] or bundle.nodes[1]
	end)

	-- // Left column // — schools list + unspent-points box.
	-- Schools rows reuse `components.RailButton` with three customizations
	-- over the default rail shape:
	--   * no glyph                          (schools are label-only)
	--   * chip is a STATIC string rank      ('S', 'A', 'B', …)
	--   * chip color reacts to active state (gold inactive, accent active)
	--   * pixel stripe                      (2 px wide instead of scale 5%)
	local schoolRows = {}
	for i, school in SKILL_SCHOOLS do
		local isActive = scope:Computed(function(use)
			return use(SelectedSchool) == school.id
		end)
		local button = Components.RailButton(scope, {
			isActive = isActive,
			label    = school.name,
			chip     = {
				text  = school.rank,
				-- Rank color: accent when active, gold otherwise. Fusion
				-- treats the Computed as a reactive TextColor3 binding.
				color = scope:Computed(function(use)
					return use(isActive) and PALETTE.accent or PALETTE.gold
				end),
				width = 24,
			},
			height   = 36,
			stripe   = UDim.new(0, 2),       -- pixel-exact 2-px stripe
			-- Shape-lock + scale: column content width LEFT_COL_PX − 32 px
			-- padding = 188 px, height 36 → button + scaled internals track
			-- the panel.
			aspectRatio = (LEFT_COL_PX - 32) / 36,
			onActivate = function() SelectedSchool:set(school.id) end,
		})
		button.LayoutOrder = i
		table.insert(schoolRows, button)
	end

	local unspentPointsLabel = scope:Computed(function(use)
		use(DataVersion)
		local data = Utils.getPlayerData()
		return tostring((data and data.SkillPoints) or 0)
	end)

	local unspentBox = scope:New('Frame') {
		Name = 'UnspentBox',
		LayoutOrder = 100,
		Size = UDim2.new(1, 0, 0, 72),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.7, Thickness = 1 },
			scope:New('UIPadding') {
				PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
				PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 2),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			scope:New('TextLabel') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 12),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = 'UNSPENT PTS',
				TextSize = 10,
				TextColor3 = PALETTE.inkDim,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, 32),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = unspentPointsLabel,
				TextSize = 28,
				TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
		},
	}

	local leftColumn = scope:New('Frame') {
		Name = 'SchoolsColumn',
		LayoutOrder = 1,
		Size = UDim2.fromScale(LEFT_COL_PX / DESIGN_W, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingLeft  = UDim.new(0, 16),
				PaddingRight = UDim.new(0, 16),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Vertical,
				Padding = UDim.new(0, 4),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			Utils.eyebrow(scope, '◆ SCHOOLS', {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 16),
			}),
			table.unpack(schoolRows),
			scope:New('Frame') {
				LayoutOrder = 99,
				Size = UDim2.new(1, 0, 0, 10),
				BackgroundTransparency = 1,
			},
			unspentBox,
		},
	}

	-- // Center column // SWORD-ART-STYLE SKILL GRAPH.
	-- Canvas size = max(canvasW), max(canvasH) across all pre-resolved
	-- bundles so the ScrollingFrame fits the largest tree. Each bundle
	-- renders into its own school container (Visible bound to selection),
	-- so switching schools just swaps which container is shown — no
	-- canvas rebuild, no resolver re-run.
	local maxCanvasW, maxCanvasH = 320, 320
	for _, b in SCHOOL_BUNDLES do
		if b.canvasW > maxCanvasW then maxCanvasW = b.canvasW end
		if b.canvasH > maxCanvasH then maxCanvasH = b.canvasH end
	end

	-- Canvas shows when the active school's bundle has at least one node.
	-- Empty bundles (school exists in SKILL_SCHOOLS but no skills authored
	-- yet) hide the canvas and reveal the placeholder text below.
	local gridVisible = scope:Computed(function(use)
		local b = bundleForRail(use(SelectedSchool))
		return b ~= nil and b.nodes and #b.nodes > 0
	end)

	local canvas = PanZoomCanvas.create(scope, {
		ContentWidth  = maxCanvasW,
		ContentHeight = maxCanvasH,
		MinZoom       = 0.45,
		MaxZoom       = 1.8,
		InitialZoom   = 0.7,
	})
	scope:Hydrate(canvas.Frame) { Visible = gridVisible }

	-- Sink mouse left/right/wheel while the cursor is over the skill
	-- canvas AND this tab is currently active. The canvas's own
	-- `scrollFrame.InputChanged` (frame-bound, hit-test pipeline) keeps
	-- firing for pan/zoom regardless of CAS sink — this registration
	-- only stops the inputs from leaking past the tab to other CAS
	-- consumers (camera, weapon swap, etc.).
	--
	-- Gates on ctx.IsOpen + ctx.CurrentTab so the sink is inert when the
	-- player is on Inventory / Settings / etc. — those tabs share the
	-- same RootScope so the canvas frame instance stays alive across
	-- tab switches; without the gate, scrolling on top of where the
	-- skill canvas lives would silently sink even with the tab hidden.
	local sinkProcessorId = UISinkInputs.AddProcessorCallback({
		Name = 'skills-canvas',
		-- Declared up front so the CAS bind only includes Mouse1 /
		-- Mouse2 / Wheel while at least one processor (this one) cares.
		-- When the SkillsTab tears down (theme rebuild, etc.) and the
		-- processor is removed, the refcount drops to 0 and these
		-- inputs are unbound entirely — no lingering high-priority
		-- sink that could interfere with other CAS consumers.
		Inputs = {
			Enum.UserInputType.MouseButton1,
			Enum.UserInputType.MouseButton2,
			Enum.UserInputType.MouseWheel,
		},
		Filter = function(_state, _obj)
			if ctx.IsOpen and not peek(ctx.IsOpen) then return false end
			if ctx.CurrentTab and peek(ctx.CurrentTab) ~= 'Skills' then return false end
			local frame = canvas.Frame
			if not frame or not frame.Parent then return false end
			-- Only fire when the school grid is visible (matches the
			-- gridVisible Hydrate above) so the sink doesn't fire while
			-- a "no graph for this school yet" placeholder is on screen.
			if frame.Visible == false then return false end
			local mouse = UserInputService:GetMouseLocation()
			local pos, size = frame.AbsolutePosition, frame.AbsoluteSize
			return mouse.X >= pos.X and mouse.X <= pos.X + size.X
				and mouse.Y >= pos.Y and mouse.Y <= pos.Y + size.Y
		end,
		Sink = function() return true end,
	})
	-- Register cleanup with the tab's scope so RemoveProcessor fires
	-- when the TabWidget shell tears down (e.g. theme rebuild). Same
	-- pattern as SettingsTab's keybind connection cleanup.
	table.insert(scope :: any, function()
		UISinkInputs.RemoveProcessor(sinkProcessorId)
	end)

	-- Build a hex tile's children: 6 perimeter edge frames forming the
	-- pointy-top hexagon outline, an inscribed-circle background fill, the
	-- center icon, and the unlock pip. Returns the children array for a
	-- HexBox Frame of size (hexW, hexH).
	--
	-- Edges: for each k in 0..5 we connect vertex k to vertex k+1. Pointy-
	-- top vertices sit at math angles 90° - k*60° (Roblox Y inverted via
	-- `-sin`). Each edge frame is a rotated thin rectangle whose AnchorPoint
	-- is its CENTER so Position = midpoint and Rotation = vertex-to-vertex
	-- bearing. Length is bumped by `edgeStrokeThickness` so adjacent edges
	-- overlap at the corners — covers the gap from rectangle square-cuts.
	local function buildHexTile(parentScope, node, isSel)
		local hexR = node.ult and HEX_ULT_RADIUS or HEX_RADIUS
		local hexW = math.sqrt(3) * hexR
		local hexH = 2 * hexR
		local apothem = hexR * (math.sqrt(3) / 2)            -- center → edge midpoint
		local inscribedDiam = apothem * 2                    -- biggest circle that fits inside

		-- Hex stroke + icon color: the per-skill HexagonColor (set on
		-- SkillConfig) when present, falling back to the palette accent.
		-- Locked tiles still desaturate to inkFaint; selection still
		-- brightens to accentHot — the per-skill color is the "owned"
		-- state's tint.
		--
		-- Edge color / transparency / icon / pip / label all depend on
		-- `node.unlocked`, which the NodesRefreshKey Computed updates on
		-- save replication. Each visual Computed below `use(NodesRefreshKey)`
		-- so the tile flips
		-- from locked → unlocked mid-tab the moment the server confirms
		-- the unlock — no tab-reopen required for visual feedback.
		local accentColor = node.hexColor or PALETTE.accent
		-- Three visual states (selection always wins):
		--   owned     → per-skill accent, bright
		--   available → eligible but unpurchased: dim (the standard "unowned" look)
		--   locked    → a requirement (prereq/level/attribute) is unmet: faded out
		-- `node.eligible` is refreshed by NodesRefreshKey on every replication,
		-- so a tile flips from locked → available the instant its prereq is
		-- unlocked or its attribute hits the required level, without a re-open.
		local function isLocked(): boolean
			return (not node.unlocked) and (node.eligible == false)
		end
		local edgeColor = parentScope:Computed(function(use)
			use(NodesRefreshKey)
			if use(isSel) then return PALETTE.accentHot end
			return node.unlocked and accentColor or PALETTE.inkFaint
		end)
		local edgeTrans = parentScope:Computed(function(use)
			use(NodesRefreshKey)
			if use(isSel) then return 0 end
			if node.unlocked then return 0.1 end
			return isLocked() and 0.72 or 0.45
		end)
		local iconColor = parentScope:Computed(function(use)
			use(NodesRefreshKey)
			return node.unlocked and accentColor or PALETTE.inkFaint
		end)
		local iconTrans = parentScope:Computed(function(use)
			use(NodesRefreshKey)
			if node.unlocked then return 0 end
			return isLocked() and 0.82 or 0.55
		end)
		local pipVisible = parentScope:Computed(function(use)
			use(NodesRefreshKey)
			return node.unlocked == true
		end)
		local labelColor = parentScope:Computed(function(use)
			use(NodesRefreshKey)
			if node.unlocked then return PALETTE.ink end
			return isLocked() and PALETTE.inkFaint or PALETTE.inkDim
		end)
		local edgeStrokeThickness = node.ult and 3 or 2

		local hexKids = {}

		-- Inscribed-circle "fill" — fits inside the hex, reads as the
		-- tile background without needing a polygon primitive.
		hexKids[#hexKids + 1] = parentScope:New('Frame') {
			Name = 'Fill',
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(inscribedDiam, inscribedDiam),
			BackgroundColor3 = PALETTE.bg0,
			BackgroundTransparency = node.ult and 0.35 or 0.15,
			BorderSizePixel = 0,
			ZIndex = 1,
			[Fusion.Children] = {
				parentScope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
			},
		}

		-- 6 perimeter edges.
		for k = 0, 5 do
			local v1Rad = math.rad(90 - k * 60)
			local v2Rad = math.rad(90 - (k + 1) * 60)
			local x1, y1 = math.cos(v1Rad) * hexR, -math.sin(v1Rad) * hexR
			local x2, y2 = math.cos(v2Rad) * hexR, -math.sin(v2Rad) * hexR
			local dx, dy = x2 - x1, y2 - y1
			local len = math.sqrt(dx * dx + dy * dy)
			local rotDeg = math.deg(math.atan2(dy, dx))
			local cx, cy = (x1 + x2) / 2, (y1 + y2) / 2

			hexKids[#hexKids + 1] = parentScope:New('Frame') {
				Name = 'Edge' .. k,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, cx, 0.5, cy),
				Size = UDim2.fromOffset(len + edgeStrokeThickness, edgeStrokeThickness),
				Rotation = rotDeg,
				BackgroundColor3 = edgeColor,
				BackgroundTransparency = edgeTrans,
				BorderSizePixel = 0,
				ZIndex = 2,
			}
		end

		-- Center icon glyph (★ — BMP, font-safe). Color + transparency
		-- ride the iconColor / iconTrans Computeds so an unlock landing
		-- mid-tab lights the icon without a re-open.
		hexKids[#hexKids + 1] = parentScope:New('TextLabel') {
			Name = 'NodeIcon',
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(apothem, apothem),
			BackgroundTransparency = 1,
			FontFace = HUDCommon.FONT_DISPLAY,
			Text = '\u{2605}',
			TextScaled = true,
			TextColor3 = iconColor,
			TextTransparency = iconTrans,
			ZIndex = 3,
		}

		-- Unlock pip — small gold star at the top-right vertex of the hex.
		-- Anchored to the v[1] vertex (top-right of pointy-top hex) so the
		-- pip rides the corner regardless of tile size.
		local pipR = hexR * 0.28
		local v1Rad = math.rad(90 - 1 * 60)   -- vertex k=1 = top-right
		local pipX = math.cos(v1Rad) * hexR
		local pipY = -math.sin(v1Rad) * hexR
		hexKids[#hexKids + 1] = parentScope:New('TextLabel') {
			Name = 'UnlockPip',
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, pipX, 0.5, pipY),
			Size = UDim2.fromOffset(pipR * 2, pipR * 2),
			BackgroundColor3 = PALETTE.gold,
			BackgroundTransparency = 0.15,
			BorderSizePixel = 0,
			Visible = pipVisible,
			FontFace = HUDCommon.FONT_DISPLAY,
			Text = '\u{2605}',
			TextScaled = true,
			TextColor3 = PALETTE.bg0,
			TextStrokeColor3 = PALETTE.gold,
			TextStrokeTransparency = 0,
			ZIndex = 4,
			[Fusion.Children] = {
				parentScope:New('UICorner') { CornerRadius = UDim.new(1, 0) },
				parentScope:New('UIStroke') { Color = PALETTE.bg0, Thickness = 1 },
			},
		}

		return {
			-- Hex visual sits at the top of the TextButton container; the
			-- label below lives in the extra container height (hexH +
			-- LABEL_GAP + LABEL_H).
			parentScope:New('Frame') {
				Name = 'HexBox',
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0, 0),
				Size = UDim2.fromOffset(hexW, hexH),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ZIndex = 1,
				[Fusion.Children] = hexKids,
			},
			parentScope:New('TextLabel') {
				Name = 'NameLabel',
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0, hexH + HEX_LABEL_GAP),
				Size = UDim2.fromOffset(hexW * 2, HEX_LABEL_H),
				BackgroundTransparency = 1,
				FontFace = node.ult and HUDCommon.FONT_DISPLAY or HUDCommon.FONT_UI,
				Text = node.name,
				TextSize = node.ult and 16 or 14,
				TextColor3 = labelColor,
				TextStrokeColor3 = PALETTE.bg0,
				TextStrokeTransparency = 0.5,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextYAlignment = Enum.TextYAlignment.Top,
				ZIndex = 3,
			},
		}
	end

	-- Per-school containers. One Frame per resolved bundle, each Visible
	-- only when the active rail school maps to that bundle's school.
	-- Lines + tiles for that bundle parent into its container so toggling
	-- the container hides everything at once.
	local LINE_SEGMENTS = 18
	for school, bundle in SCHOOL_BUNDLES do
		local schoolContainer = scope:New('Frame') {
			Name = 'School_' .. school,
			Parent = canvas.Content,
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 1,
			Visible = scope:Computed(function(use)
				return use(SelectedSchool) == school
			end),
		}

		-- Connection lines — split into many rotated-frame segments instead
		-- of one long rotated rectangle. Roblox's ClipsDescendants culls
		-- each child by its axis-aligned bounding box; a single long line
		-- has a giant bounding box (worst case: full canvas diagonal) so
		-- it's all-or-nothing visible at the canvas edge. Many small
		-- segments → many small bounding boxes → per-segment culling, so
		-- a line crossing the canvas border gets cleanly chopped at the
		-- boundary.
		--
		-- Lines parent into the school container, NOT directly into
		-- canvas.Content, so the container's Visible toggle hides them.
		for _, node in bundle.nodes do
			for _, prereqId in node.prereqs do
				local prereq = bundle.index[prereqId]
				if not prereq then continue end
				local bothUnlocked = prereq.unlocked and node.unlocked
				PanZoomCanvas.lineSegmented(scope, {
					FromX = prereq.x, FromY = prereq.y,
					ToX = node.x,     ToY = node.y,
					Segments = LINE_SEGMENTS,
					Thickness = bothUnlocked and 2 or 1,
					Color = bothUnlocked and PALETTE.accent or PALETTE.inkFaint,
					Transparency = bothUnlocked and 0.35 or 0.78,
					ZIndex = 1,
					Parent = schoolContainer,
				})
			end
		end

		for _, node in bundle.nodes do
			local isSel = scope:Computed(function(use) return use(SelectedNode) == node.id end)
			local hexR = node.ult and HEX_ULT_RADIUS or HEX_RADIUS
			local hexW = math.sqrt(3) * hexR
			local containerH = 2 * hexR + HEX_LABEL_GAP + HEX_LABEL_H

			-- Container's TOP-CENTER lands at (node.x, node.y - hexR), so
			-- the HEX CENTER (top + hexR) lands exactly at (node.x, node.y).
			-- Position uses fromScale against maxCanvasW/H since the
			-- school container is full-canvas-sized.
			scope:New('TextButton') {
				Name = 'SkillNode_' .. node.id,
				Parent = schoolContainer,
				ZIndex = 2,
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.fromScale(
					node.x / maxCanvasW,
					(node.y - hexR) / maxCanvasH
				),
				Size = UDim2.fromOffset(hexW, containerH),
				BackgroundTransparency = 1,
				AutoButtonColor = false,
				BorderSizePixel = 0,
				Text = '',
				[Fusion.OnEvent('Activated')] = function() SelectedNode:set(node.id) end,
				[Fusion.Children] = buildHexTile(scope, node, isSel),
			}
		end
	end

	-- Center column container — bordered wrapper around the canvas + footer
	-- hint + empty-state overlay. The hint footer sits OUTSIDE the canvas's
	-- UIScale so it stays crisp regardless of zoom level.
	local centerColumn = scope:New('Frame') {
		Name = 'SkillCanvasWrap',
		LayoutOrder = 2,
		Size = UDim2.fromScale(
			(DESIGN_W - LEFT_COL_PX - RIGHT_COL_PX - 2 * COL_GAP_PX) / DESIGN_W,
			1
		),
		BackgroundColor3 = PALETTE.bg0,
		BackgroundTransparency = 0.5,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		[Fusion.Children] = {
			scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.78, Thickness = 1 },
			canvas.Frame,
			scope:New('Frame') {
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.new(0, 0, 1, 0),
				Size = UDim2.new(1, 0, 0, 22),
				BackgroundColor3 = PALETTE.bg0,
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
				ZIndex = 10,
				[Fusion.Children] = {
					scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.85, Thickness = 1 },
					scope:New('TextLabel') {
						Size = UDim2.fromScale(1, 1),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = scope:Computed(function(use)
							return string.format(
								'◆ DRAG: right/middle-click    ◆ ZOOM: scroll wheel    ◆ ×%.2f',
								use(canvas.Zoom)
							)
						end),
						TextSize = 10,
						TextColor3 = PALETTE.inkFaint,
						TextXAlignment = Enum.TextXAlignment.Center,
					},
				},
			},
			-- Empty-state placeholder — names the active school so the
			-- player sees which one has no skills yet, instead of a generic
			-- "NO NODES DEFINED" that could read as a bug.
			scope:New('TextLabel') {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = scope:Computed(function(use)
					local id = use(SelectedSchool)
					local name = id
					for _, s in SKILL_SCHOOLS do
						if s.id == id then name = s.name; break end
					end
					return string.format('◆ %s · NO SKILLS AUTHORED YET', string.upper(name))
				end),
				TextSize = 11,
				TextColor3 = PALETTE.inkFaint,
				ZIndex = 20,
				Visible = scope:Computed(function(use) return not use(gridVisible) end),
			},
		},
	}

	-- // Right column // node detail.
	-- Each Computed gates on `selectedNodeData` being non-nil. Schools
	-- without a tree show the empty-state placeholder in the center column;
	-- the right-column readouts here fall back to neutral defaults so they
	-- don't crash on n.name / n.ult / etc.
	local detailTitleText = scope:Computed(function(use)
		local n = use(selectedNodeData)
		return n and n.name or '—'
	end)
	-- Tier was removed with the hex-lattice rewrite; eyebrow reads "◆ NODE"
	-- and gains "· ULTIMATE" when the selection is an ultimate skill.
	local detailTierText = scope:Computed(function(use)
		local n = use(selectedNodeData)
		if not n then return '◆ NODE' end
		return n.ult and '◆ NODE · ULTIMATE' or '◆ NODE'
	end)
	local detailUltVisible = scope:Computed(function(use)
		local n = use(selectedNodeData)
		return n ~= nil and n.ult == true
	end)
	local detailUnlockText = scope:Computed(function(use)
		-- use(NodesRefreshKey) — refreshes n.unlocked / n.level inside the
		-- shared bundle table whenever the save replicates. Without this
		-- dependency the label would freeze on whatever state the node
		-- had at first tab open: e.g. after a successful unlock the
		-- button would still read "UNLOCK · 1 PT" instead of flipping
		-- to "EQUIP TO HOTBAR", and the user would think the click did
		-- nothing.
		use(NodesRefreshKey)
		local n = use(selectedNodeData)
		if not n then return '—' end
		-- Passive: button text walks the level ladder.
		if n.passive then
			if not n.unlocked then
				if n.eligible == false then return 'LOCKED' end
				return string.format('UNLOCK · %d PT', n.cost)
			end
			local level = n.level or 1
			local maxLevel = n.maxLevel or level
			if level >= maxLevel then
				return string.format('MAX LEVEL · %d/%d', level, maxLevel)
			end
			return string.format('LEVEL UP · %d PT (%d/%d)', n.cost, level, maxLevel)
		end
		-- Active: existing flow.
		if (not n.unlocked) and n.eligible == false then return 'LOCKED' end
		return n.unlocked and 'EQUIP TO HOTBAR' or string.format('UNLOCK · %d PT', n.cost)
	end)

	-- Requirements readout for the detail panel. RichText lines, one per
	-- unlock requirement (prereq / level / attribute), green ✓ when met and
	-- red ✗ when not. Empty string once the skill is owned (reqs are moot) or
	-- when the skill has no gates — the label hides itself in that case.
	local detailReqText = scope:Computed(function(use)
		use(DataVersion)
		use(NodesRefreshKey)
		local n = use(selectedNodeData)
		if not n then return '' end
		local data = Utils.getPlayerData()
		if SkillsShared.IsSkillUnlocked(data, n.id) then return '' end
		local reqs = SkillsShared.GetUnlockRequirements(data, n.id)
		if #reqs == 0 then return '' end
		local lines = {}
		for _, r in reqs do
			local mark = r.Met and '\u{2713}' or '\u{2717}'        -- ✓ / ✗
			local col  = r.Met and '120,210,140' or '230,120,120'
			lines[#lines + 1] = string.format(
				'<font color="rgb(%s)">%s %s</font>', col, mark, r.Label)
		end
		return table.concat(lines, '\n')
	end)
	local detailReqVisible = scope:Computed(function(use)
		return use(detailReqText) ~= ''
	end)
	local detailTitleColor = scope:Computed(function(use)
		local n = use(selectedNodeData)
		if not n then return PALETTE.inkDim end
		return n.ult and PALETTE.accent or PALETTE.ink
	end)

	local rightColumn = scope:New('Frame') {
		Name = 'DetailColumn',
		LayoutOrder = 3,
		Size = UDim2.fromScale(RIGHT_COL_PX / DESIGN_W, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIListLayout') { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder },
			scope:New('TextLabel') {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 14),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = detailTierText, TextSize = 10,
				TextColor3 = PALETTE.accent,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_DISPLAY,
				Text = detailTitleText, TextSize = 22,
				TextColor3 = detailTitleColor,
				TextXAlignment = Enum.TextXAlignment.Left,
			},
			scope:New('TextLabel') {
				LayoutOrder = 3,
				Size = UDim2.new(1, 0, 0, 14),
				BackgroundTransparency = 1,
				FontFace = HUDCommon.FONT_MONO,
				Text = '◆ ULTIMATE SWORD ART',
				TextSize = 10,
				TextColor3 = PALETTE.gold,
				TextXAlignment = Enum.TextXAlignment.Left,
				Visible = detailUltVisible,
			},
			-- Unlock requirements (prereqs / character level / attributes).
			-- One ✓/✗ line each; hidden once the skill is owned or ungated.
			scope:New('Frame') {
				LayoutOrder = 4,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				Visible = detailReqVisible,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						Padding = UDim.new(0, 2),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					scope:New('TextLabel') {
						LayoutOrder = 1,
						Size = UDim2.new(1, 0, 0, 12),
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						Text = '◆ REQUIREMENTS',
						TextSize = 10,
						TextColor3 = PALETTE.inkDim,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					scope:New('TextLabel') {
						LayoutOrder = 2,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundTransparency = 1,
						FontFace = HUDCommon.FONT_MONO,
						RichText = true,
						Text = detailReqText,
						TextSize = 12,
						TextColor3 = PALETTE.ink,
						TextXAlignment = Enum.TextXAlignment.Left,
						TextYAlignment = Enum.TextYAlignment.Top,
						TextWrapped = true,
					},
				},
			},
			-- Stat grid. 2×2 cells; each cell uses a UIListLayout to stack
			-- the label atop the value instead of manual y-offsets.
			scope:New('Frame') {
				LayoutOrder = 5,
				Size = UDim2.new(1, 0, 0, 92),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIGridLayout') {
						CellSize = UDim2.new(0.5, -4, 0, 42),
						CellPadding = UDim2.fromOffset(8, 8),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					(function()
						local items = {
							{ label = 'CAST',     value = '1.2s' },
							{ label = 'COOLDOWN', value = '18s'  },
							{ label = 'MP COST',  value = '120'  },
							{ label = 'HITS',     value = '16'   },
						}
						local frames = {}
						for i, entry in items do
							table.insert(frames, scope:New('Frame') {
								LayoutOrder = i,
								BackgroundColor3 = PALETTE.bg0,
								BackgroundTransparency = 0.25,
								BorderSizePixel = 0,
								[Fusion.Children] = {
									scope:New('UIStroke') {
										Color = PALETTE.accent, Transparency = 0.7, Thickness = 1,
									},
									scope:New('UIPadding') {
										PaddingLeft = UDim.new(0, 10),
										PaddingRight = UDim.new(0, 10),
										PaddingTop = UDim.new(0, 6),
										PaddingBottom = UDim.new(0, 6),
									},
									scope:New('UIListLayout') {
										FillDirection = Enum.FillDirection.Vertical,
										VerticalAlignment = Enum.VerticalAlignment.Center,
										Padding = UDim.new(0, 2),
										SortOrder = Enum.SortOrder.LayoutOrder,
									},
									scope:New('TextLabel') {
										LayoutOrder = 1,
										Size = UDim2.new(1, 0, 0, 10),
										BackgroundTransparency = 1,
										FontFace = HUDCommon.FONT_MONO,
										Text = entry.label,
										TextSize = 10,
										TextColor3 = PALETTE.inkDim,
										TextXAlignment = Enum.TextXAlignment.Left,
									},
									scope:New('TextLabel') {
										LayoutOrder = 2,
										Size = UDim2.new(1, 0, 0, 16),
										BackgroundTransparency = 1,
										FontFace = HUDCommon.FONT_MONO,
										Text = entry.value,
										TextSize = 15,
										TextColor3 = PALETTE.accent,
										TextXAlignment = Enum.TextXAlignment.Left,
									},
								},
							})
						end
						return table.unpack(frames)
					end)(),
				},
			},
			-- Action row — UNLOCK on the left, SET HOTBAR SLOT on the right.
			-- Hotbar button is gated on `node.unlocked` (you can only bind
			-- skills you actually own).
			scope:New('Frame') {
				LayoutOrder = 10,
				Size = UDim2.new(1, 0, 0, 36),
				BackgroundTransparency = 1,
				[Fusion.Children] = {
					scope:New('UIListLayout') {
						FillDirection = Enum.FillDirection.Horizontal,
						Padding = UDim.new(0, 6),
						SortOrder = Enum.SortOrder.LayoutOrder,
					},
					scope:New('TextButton') {
						LayoutOrder = 1,
						-- Width: full when no second button shows (passive
						-- skills always hide hotbar-bind), 65% when paired
						-- with the SET HOTBAR SLOT button on the right.
						Size = scope:Computed(function(use)
							local n = use(selectedNodeData)
							local pairWithHotbar = n and n.unlocked and not n.passive
							return pairWithHotbar
								and UDim2.new(0.65, -3, 1, 0)
								or UDim2.fromScale(1, 1)
						end),
						BackgroundColor3 = PALETTE.bg0,
						BackgroundTransparency = 0.35,
						AutoButtonColor = false,
						BorderSizePixel = 0,
						FontFace = HUDCommon.FONT_UI,
						Text = detailUnlockText,
						TextSize = 12,
						TextColor3 = PALETTE.accent,
						[Fusion.OnEvent('Activated')] = function()
							local n = peek(selectedNodeData)
							if not n then return end
							-- Re-read unlock state from the live save at click
							-- time. `n.unlocked` is the cached value on the
							-- shared bundle table and gets refreshed by the
							-- NodesRefreshKey Computed, but using it directly
							-- here would still race against a click that fires
							-- before the replication tick lands. Reading via
							-- SkillsShared with the freshest save struct
							-- collapses the race.
							local data = Utils.getPlayerData()
							local unlocked = SkillsShared.IsSkillUnlocked(data, n.id)
							local level    = SkillsShared.GetSkillLevel(data, n.id)
							local RemoteService = ReplicatedModules.Services.RemoteService
							local SkillEvent = RemoteService.GetRemote('SkillEvent', 'RemoteEvent', false)
							if n.passive then
								-- Passive: fire when not unlocked OR when below
								-- MaxLevel (server's AttemptUnlockSkill routes
								-- the second case to the level-up branch).
								local maxLevel = n.maxLevel or level
								if (not unlocked) or level < maxLevel then
									SkillEvent:FireServer(SkillsShared.SkillActions.TryUnlockSkill, n.id)
								end
							elseif not unlocked then
								SkillEvent:FireServer(SkillsShared.SkillActions.TryUnlockSkill, n.id)
							end
						end,
						[Fusion.Children] = {
							scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.2, Thickness = 1 },
						},
					},
					-- SET HOTBAR SLOT — only visible for unlocked ACTIVE
					-- skills (passive skills can't be cast, so no hotbar
					-- binding makes sense).
					scope:New('TextButton') {
						LayoutOrder = 2,
						Size = UDim2.new(0.35, -3, 1, 0),
						BackgroundColor3 = PALETTE.bg0,
						BackgroundTransparency = 0.4,
						AutoButtonColor = false,
						BorderSizePixel = 0,
						FontFace = HUDCommon.FONT_MONO,
						Text = 'SET HOTBAR SLOT',
						TextSize = 11,
						TextColor3 = PALETTE.accent,
						Visible = scope:Computed(function(use)
							local n = use(selectedNodeData)
							return n ~= nil and n.unlocked == true and n.passive ~= true
						end),
						[Fusion.OnEvent('Activated')] = function()
							local n = peek(selectedNodeData)
							if not n or not n.unlocked then return end
							local HotbarWidget = require(LocalPlayer:WaitForChild('PlayerScripts')
								:WaitForChild('Core'):WaitForChild('Widgets'):WaitForChild('HotbarWidget'))
							HotbarWidget.OpenSlotPicker(function(slotId)
								-- Binding stored under stable slotId, not keybind.
								HotbarWidget.SetSlot(slotId, { type = 'skill', id = n.id })
							end)
						end,
						[Fusion.Children] = {
							scope:New('UIStroke') { Color = PALETTE.accent, Transparency = 0.4, Thickness = 1 },
						},
					},
				},
			},
		},
	}

	return scope:New('Frame') {
		Name = 'SkillsTab',
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		[Fusion.Children] = {
			scope:New('UIPadding') {
				PaddingTop    = UDim.new(20 / OUTER_H, 0),
				PaddingBottom = UDim.new(20 / OUTER_H, 0),
				PaddingLeft   = UDim.new(0, 0),
				PaddingRight  = UDim.new(20 / OUTER_W, 0),
			},
			scope:New('UIListLayout') {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(COL_GAP_PX / DESIGN_W, 0),
				SortOrder = Enum.SortOrder.LayoutOrder,
			},
			leftColumn, centerColumn, rightColumn,
		},
	}
end

return Module
]]></Source>
		<Source path="src/StarterPlayerScripts/Core/Widgets/TabWidget/SocialTab.luau"><![CDATA[-- // TabWidget/SocialTab.luau //
-- Two-column social screen: left rail of submenus (Friends / Guild · KoB /
-- Nearby / Recent / Floor Roster), right panel area showing whichever
-- sub-panel is currently selected.
--
-- Reference: tmp/aincrad-ui/tabs.jsx SocialTab.
-- Port note: no social remotes exist yet — every sub-panel renders from a
-- local `PLACEHOLDER_*` table so the screen LOOKS fully populated for design
-- review. When party/guild/proximity remotes land, swap the placeholder
-- reads for Computed wrappers around ctx.DataVersion + getPlayerData().
--
-- Structure:
--   TabWidget/SocialTab.luau
--     └── Build(ctx) — assembles the shell
--         ├── Friends panel (buildFriendsPanel)
--         ├── Guild panel  (buildGuildPanel)
--         ├── Nearby panel (buildNearbyPanel)
--         ├── Recent panel (buildRecentPanel)
--         └── Roster panel (buildRosterPanel)
--
-- The sub-panels are defined at file scope (not inside Build()) because they
-- don't close over per-Build state — they only consume `scope` for instance
-- creation and the local PLACEHOLDER_* constants. That shape makes the file
-- easy to navigate by sub-panel: jump to `buildXPanel` and you have the
-- whole Friend/Guild/etc. tree inline.
--
-- If any sub-panel grows past ~300 lines or starts reading cross-tab state,
-- that's the signal to split it out into TabWidget/Social/<Panel>.luau.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer

local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local Fusion = ReplicatedModules.Libraries.Fusion

local LocalModules = require(LocalPlayer:WaitForChild('PlayerScripts'):WaitForChild('Modules'))
local HUDCommon = LocalModules.Modules.HUDCommon
local PALETTE = HUDCommon.PALETTE

local Utils      = require(script.Parent.utils)
local Components = require(script.Parent.components)

local Module = {}

-- 1394×648 outer canvas; asymmetric 0/20/20/20 padding leaves 1374×608 inner.
-- RIGHT_INSET_PX = LEFT_COL_PX + 20: the extra 4px past the gap is a visual
-- right-edge buffer the original mixed-mode form baked in.
local OUTER_W, OUTER_H   = 1394, 648
local DESIGN_W, DESIGN_H = 1374, 608
local LEFT_COL_PX        = 200
local COL_GAP_PX         = 16
local RIGHT_INSET_PX     = 220

----------------------------------------------------------------------
-- Submenu roster + placeholder data
----------------------------------------------------------------------

local SOCIAL_SUBS = {
	{ id = 'friends', name = 'Friends',      glyph = '◆', count = 28  },
