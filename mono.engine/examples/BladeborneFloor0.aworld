		<Source path="src/ServerScriptService/CmdrSetup/Commands/debug/SpawnMobServer.luau"><![CDATA[local CollectionService = game:GetService('CollectionService')
local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

local AI_CHARACTER_TAG = 'AICharacter'

-- Find a template Model for the given mobId. Three sources, in order:
--   1. ServerStorage/EnemyTemplates/<mobId> — set up by EnemyServer
--      when a mob of that id has been initialized at least once.
--   2. Any currently-tagged AICharacter with a matching AIClass
--      attribute — clone that.
--   3. nil — caller reports failure.
local function findTemplate(mobId: string): Model?
	local templates = ServerStorage:FindFirstChild('EnemyTemplates')
	if templates then
		-- EnemyServer stores templates by their original Name, not by
		-- AIClass. Walk and match on either.
		for _, child in templates:GetChildren() do
			if child:IsA('Model') and (child.Name == mobId or child:GetAttribute('AIClass') == mobId) then
				return child
			end
		end
	end
	for _, model in CollectionService:GetTagged(AI_CHARACTER_TAG) do
		if model:IsA('Model') and model:GetAttribute('AIClass') == mobId then
			return model
		end
	end
	return nil
end

return function(context, mobId: string, count: number)
	local executor = context.Executor
	local character = executor and executor.Character
	if not character then return 'Executor has no character.' end
	local hrp = character:FindFirstChild('HumanoidRootPart')
	if not hrp then return 'Executor has no HumanoidRootPart.' end

	local template = findTemplate(mobId)
	if not template then
		return string.format(
			"No template for '%s'. Spawn one of this mob in studio first " ..
			"so EnemyServer registers a template, or place a tagged " ..
			"AICharacter with AIClass=%s in workspace.", mobId, mobId)
	end

	local n = math.max(1, math.min(count or 1, 16))
	local spawnCF = hrp.CFrame * CFrame.new(0, 0, -10)
	local spread = math.min(2 + n, 12)
	for i = 1, n do
		template.Archivable = true
		local clone = template:Clone()
		template.Archivable = false
		-- Spread copies along a small arc so they don't pile up.
		local angle = (i - 1) / math.max(1, n - 1) * math.pi
		local off = Vector3.new(math.cos(angle) * spread, 0, math.sin(angle) * 0.5)
		clone:PivotTo(spawnCF + off)
		-- Re-tag (templates are stored untagged in EnemyTemplates so
		-- their existence doesn't trigger another InitializeMob).
		if not clone:HasTag(AI_CHARACTER_TAG) then
			clone:AddTag(AI_CHARACTER_TAG)
		end
		clone.Parent = workspace
	end
	return string.format("Spawned %d × %s.", n, mobId)
end
]]></Source>
