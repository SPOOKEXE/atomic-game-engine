		<Source path="ServerScriptService/CmdrSetup/Commands/artisan/EnchantForceServer"><![CDATA[local ServerStorage = game:GetService("ServerStorage")
local ServerCore = require(ServerStorage:WaitForChild('Core'))

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local CompositionalConfig = ReplicatedModules.Data.Compositional
local EnchantsConfig = ReplicatedModules.Data.Enchants
local EnchantShared = ReplicatedModules.Services.EnchantShared

return function(_context, target: Player, uuid: string, enchantId: string, level: number)
	local enchantCfg = EnchantsConfig.Enchants[enchantId]
	if not enchantCfg then
		return string.format("No enchant with id '%s'.", enchantId)
	end
	level = math.clamp(math.floor(level or 1), 1, enchantCfg.MaxLevel)
	-- Bypass mode: skip scroll consumption + currency + conflict +
	-- prereq checks. We DO still validate that the target item exists
	-- and is enchantable (has EquipmentData), so we don't write
	-- Composition onto a CraftingMaterial by accident.
	local data = ServerCore.SavesManagerServer.GetPlayerSelectedSaveData(target)
	if not data then return "No save data loaded for target." end
	local stack = ServerCore.PlayerInventoryServer.GetItemStackFromUUID(target, uuid)
	if not stack then return string.format("UUID %s not found in %s's inventory.", uuid, target.Name) end
	-- Append OR replace by id.
	stack.Composition = stack.Composition or {}
	if not stack.Composition.Enchants then
		stack.Composition.Enchants = CompositionalConfig.MakeEmptyEnchants()
	end
	local _, idx = EnchantShared.FindEntryOnItem(stack, enchantId)
	local entry = { Id = enchantId, Level = level, AppliedAt = os.time() }
	if idx then
		stack.Composition.Enchants.Entries[idx] = entry
	else
		table.insert(stack.Composition.Enchants.Entries, entry)
	end
	return string.format("Force-applied %s Lv %d to %s.", enchantId, level, uuid)
end
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/artisan/SocketForce"><![CDATA[--!strict
return {
	Name = "SocketForce",
	Aliases = { "socketforce", "forcesocket" },
	Description = "Force-set a gem (by gem catalog id) into a slot on a player's item — bypasses ownership / color / SocketedGems checks.",
	Group = "Admin",
	Args = {
		{ Type = "player",  Name = "target",     Description = "Target player." },
		{ Type = "string",  Name = "itemUuid",   Description = "Inventory uuid of the target item." },
		{ Type = "integer", Name = "slotIndex",  Description = "1-based socket index." },
		{ Type = "string",  Name = "gemId",      Description = "Gem catalog id (e.g. ruby_pristine)." },
	},
}
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/artisan/SocketForceServer"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore    = require(ServerStorage:WaitForChild('Core'))
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local CompositionalConfig = ReplicatedModules.Data.Compositional
local GemsConfig = ReplicatedModules.Data.Gems
local ItemsConfig = ServerModules.Data.Items
local GemSocketShared = ReplicatedModules.Services.GemSocketShared

return function(_context, target: Player, itemUuid: string, slotIndex: number, gemId: string)
	if not GemsConfig.Gems[gemId] then
		return string.format("No gem with id '%s'.", gemId)
	end
	local data = ServerCore.SavesManagerServer.GetPlayerSelectedSaveData(target)
	if not data then return "No save data loaded for target." end
	if typeof(data.SocketedGems) ~= 'table' then data.SocketedGems = {} end
	local stack, itemId = ServerCore.PlayerInventoryServer.GetItemStackFromUUID(target, itemUuid)
	if not stack or not itemId then
		return string.format("UUID %s not found in %s's inventory.", itemUuid, target.Name)
	end
	local itemConfig = ItemsConfig.Items[itemId]
	-- Lazy-init the Socketing struct using the item's declared socket
	-- colors. Without this, force-socketing into an item that's never
	-- been to the workstation has nowhere to write.
	if not stack.Composition or not stack.Composition.Socketing then
		stack.Composition = stack.Composition or {}
		local colors = GemSocketShared.GetSocketColors(itemConfig)
		if #colors == 0 then
			return string.format("Item %s has no Sockets declared in EquipmentData.", itemId)
		end
		stack.Composition.Socketing = CompositionalConfig.MakeEmptySocketing(colors)
	end
	if slotIndex < 1 or slotIndex > #stack.Composition.Socketing.Slots then
		return string.format("Slot %d out of range (item has %d sockets).", slotIndex, #stack.Composition.Socketing.Slots)
	end
	-- Mint a phantom UUID for the gem since we're bypassing ownership.
	-- Note: this UUID won't exist in inventory — the resonance lookup
	-- will gracefully no-op, but the slot will display the gem.
	local HttpService = game:GetService('HttpService')
	local phantomUuid = HttpService:GenerateGUID(false)
	-- Free the previous slot occupant if any.
	local prev = stack.Composition.Socketing.Slots[slotIndex].GemUuid
	if prev then data.SocketedGems[prev] = nil end
	stack.Composition.Socketing.Slots[slotIndex].GemUuid = phantomUuid
	-- Stash the catalog id in a side-channel so resonance lookups can
	-- still find the ColorClass. Maps gemUuid → catalog gem id.
	stack.Composition.Socketing.PhantomGems = stack.Composition.Socketing.PhantomGems or {}
	stack.Composition.Socketing.PhantomGems[phantomUuid] = gemId
	-- Refresh resonance with a phantom-aware lookup.
	GemSocketShared.RefreshResonance(stack, function(uuid)
		local pid = stack.Composition.Socketing.PhantomGems[uuid]
		return pid and GemsConfig.Gems[pid] or nil
	end)
	return string.format("Force-set %s into slot %d of %s.", gemId, slotIndex, itemUuid)
end
]]></Source>
