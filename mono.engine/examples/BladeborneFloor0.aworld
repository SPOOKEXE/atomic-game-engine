		<Source path="src/ServerScriptService/CmdrSetup/Commands/crafting/CraftServer.luau"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local CraftingConfig = require(ReplicatedStorage:WaitForChild('Modules')).Data.Crafting

return function(_context, target: Player, recipeId: string, quantity: number?)
	local recipe = CraftingConfig.Recipes[recipeId]
	if not recipe then
		local known: { string } = {}
		for id in CraftingConfig.Recipes do known[#known + 1] = id end
		table.sort(known)
		return string.format('Unknown recipe %q. Known: %s', recipeId, table.concat(known, ', '))
	end
	local Crafting = ServerCore.CraftingServer
	if not Crafting or not Crafting.AttemptCraft then return 'CraftingServer unavailable.' end
	-- Bypass the proximity sweep so testing doesn't require standing
	-- next to a tagged workstation. Reagent + cooldown gates still
	-- fire — clear them via /clear_recipe_cooldowns + /giveitem if
	-- needed.
	local ok, reason = Crafting.AttemptCraft(target, recipeId, quantity or 1, {
		BypassWorkstationGate = true,
		NearWorkstation = recipe.Workstation,  -- satisfies the recipe gate
	})
	if not ok then
		return string.format('Craft refused: %s', tostring(reason))
	end
	return string.format('Crafted %s x%d for %s.', recipeId, quantity or 1, target.Name)
end
]]></Source>
