			         PoiseMult = 1.5,
			         Windup = 0.05, Active = 0.18, Recovery = 0.24 },
			H    = { Anim = 'H1',    DamageMult = 1.20, IsFinisher = false,
			         PoiseMult = 1.4,
			         Windup = 0.07, Active = 0.13, Recovery = 0.22 },
			LH   = { Anim = 'H2',    DamageMult = 1.34, IsFinisher = false,
			         PoiseMult = 1.5,
			         Windup = 0.06, Active = 0.14, Recovery = 0.24 },
			LLH  = { Anim = 'H_LAUNCH', DamageMult = 1.30, IsFinisher = true,
			         IsLauncher = true, LaunchScale = 1.2, PoiseMult = 1.7,
			         Windup = 0.08, Active = 0.15, Recovery = 0.28 },
		},
	},

	Spear = {
		Ground = {
			L    = { Anim = 'L1',    DamageMult = 1.10, IsFinisher = false,
			         Windup = 0.06, Active = 0.18, Recovery = 0.22 },
			LL   = { Anim = 'L2',    DamageMult = 1.15, IsFinisher = false,
			         Windup = 0.06, Active = 0.18, Recovery = 0.20 },
			LLL  = { Anim = 'L3',    DamageMult = 1.25, IsFinisher = false,
			         Windup = 0.06, Active = 0.18, Recovery = 0.20 },
			LLLL = { Anim = 'L_FIN', DamageMult = 1.55, IsFinisher = true,
			         PoiseMult = 1.6,
			         Windup = 0.12, Active = 0.25, Recovery = 0.36 },
			H    = { Anim = 'H1',    DamageMult = 1.45, IsFinisher = false,
			         PoiseMult = 1.4,
			         Windup = 0.15, Active = 0.20, Recovery = 0.34 },
			LH   = { Anim = 'H2',    DamageMult = 1.62, IsFinisher = false,
			         PoiseMult = 1.5,
			         Windup = 0.13, Active = 0.22, Recovery = 0.36 },
			LLH  = { Anim = 'H_LAUNCH', DamageMult = 1.55, IsFinisher = true,
			         IsLauncher = true, LaunchScale = 1.25, PoiseMult = 1.9,
			         -- The classic polearm lift: bigger pop, less reach-in.
			         Windup = 0.18, Active = 0.22, Recovery = 0.46 },
		},
	},

	Mace = {
		Ground = {
			L    = { Anim = 'L1',    DamageMult = 1.15, IsFinisher = false,
			         Windup = 0.08, Active = 0.18, Recovery = 0.28 },
			LL   = { Anim = 'L2',    DamageMult = 1.25, IsFinisher = false,
			         Windup = 0.08, Active = 0.18, Recovery = 0.26 },
			LLL  = { Anim = 'L3',    DamageMult = 1.35, IsFinisher = false,
			         Windup = 0.08, Active = 0.18, Recovery = 0.26 },
			LLLL = { Anim = 'L_FIN', DamageMult = 1.75, IsFinisher = true,
			         PoiseMult = 1.6,
			         Windup = 0.14, Active = 0.22, Recovery = 0.38 },
			H    = { Anim = 'H1',    DamageMult = 1.55, IsFinisher = false,
			         PoiseMult = 1.5,
			         Windup = 0.19, Active = 0.21, Recovery = 0.40 },
			LH   = { Anim = 'H2',    DamageMult = 1.72, IsFinisher = false,
			         PoiseMult = 1.6,
			         Windup = 0.17, Active = 0.23, Recovery = 0.42 },
			LLH  = { Anim = 'H_LAUNCH', DamageMult = 1.65, IsFinisher = true,
			         IsLauncher = true, LaunchScale = 0.9, PoiseMult = 2.0,
			         Windup = 0.22, Active = 0.22, Recovery = 0.48 },
		},
	},

	Hammer = {
		Ground = {
			L    = { Anim = 'L1',    DamageMult = 1.30, IsFinisher = false,
			         Windup = 0.12, Active = 0.22, Recovery = 0.36 },
			LL   = { Anim = 'L2',    DamageMult = 1.40, IsFinisher = false,
			         Windup = 0.12, Active = 0.22, Recovery = 0.34 },
			LLL  = { Anim = 'L3',    DamageMult = 1.50, IsFinisher = false,
			         Windup = 0.12, Active = 0.22, Recovery = 0.34 },
			LLLL = { Anim = 'L_FIN', DamageMult = 2.00, IsFinisher = true,
			         PoiseMult = 1.6,
			         Windup = 0.20, Active = 0.30, Recovery = 0.46 },
			H    = { Anim = 'H1',    DamageMult = 1.75, IsFinisher = false,
			         PoiseMult = 1.5,
			         Windup = 0.26, Active = 0.26, Recovery = 0.50 },
			LH   = { Anim = 'H2',    DamageMult = 1.95, IsFinisher = false,
			         PoiseMult = 1.6,
			         Windup = 0.24, Active = 0.28, Recovery = 0.52 },
			LLH  = { Anim = 'H_LAUNCH', DamageMult = 1.85, IsFinisher = true,
			         IsLauncher = true, LaunchScale = 0.8, PoiseMult = 2.2,
			         Windup = 0.30, Active = 0.26, Recovery = 0.58 },
		},
	},
}

----------------------------------------------------------------------
-- Generic fallbacks. Used when the active class has no entry for a
-- resolved key, so an unauthored chain still swings instead of failing
-- closed. Combat must never break because content lags behind code.
----------------------------------------------------------------------
Module.Generic = {
	L = { Anim = 'L1', DamageMult = 1.00, IsFinisher = false,
	      Windup = 0.05, Active = 0.15, Recovery = 0.20 },
	H = { Anim = 'H1', DamageMult = 1.35, IsFinisher = false,
	      PoiseMult = 1.4,
	      Windup = 0.12, Active = 0.20, Recovery = 0.34 },
}

----------------------------------------------------------------------
-- Derived Air / DodgeCounter entries.
--
-- Air chains are shorter and snappier than their ground counterparts
-- (the victim is falling, so the window to connect is small), and the
-- heavy air input is always the SLAM that ends the juggle.
--
-- DodgeCounter is the perfect-evade reward: one elevated-damage hit
-- with extra poise pressure, available for COUNTER_WINDOW seconds.
--
-- Both are generated from the class's ground L / H entries so a new
-- class inherits a complete moveset from its ground chain alone.
-- A class may still author `Air` / `DodgeCounter` tables explicitly to
-- override any generated key.
----------------------------------------------------------------------
local AIR_TIME_SCALE = 0.8
local AIR_DAMAGE_SCALE = 0.95
local COUNTER_TIME_SCALE = 0.9

local function scaleTimings(entry: any, timeScale: number): (number, number, number)
	return (entry.Windup or 0.05) * timeScale,
		(entry.Active or 0.15) * timeScale,
		(entry.Recovery or 0.20) * timeScale
end

local function buildAirEntries(ground: { [string]: any }): { [string]: any }
	local baseLight = ground.L or Module.Generic.L
	local baseHeavy = ground.H or Module.Generic.H
	local lw, la, lr = scaleTimings(baseLight, AIR_TIME_SCALE)
	local hw, ha, hr = scaleTimings(baseHeavy, AIR_TIME_SCALE)

	-- Air light keeps the victim afloat; each connect re-lifts a little
	-- less than the last (CombatConfig.AIR_JUGGLE_DECAY), which is what
	-- keeps juggles finite without a hard "you may not hit" rule.
	local airLight = {
		Anim = 'A_L1',
		DamageMult = (baseLight.DamageMult or 1.0) * AIR_DAMAGE_SCALE,
		IsFinisher = false,
		PoiseMult = baseLight.PoiseMult,
		Windup = lw, Active = la, Recovery = lr,
		Motion = { Mode = Module.MotionModes.Hover },
		AirSustain = true,
	}

	-- Air heavy is the spike. It ends the juggle and drives the victim
	-- into the ground, which is the readable "combo over" beat.
	local airHeavy = {
		Anim = 'A_SLAM',
		DamageMult = (baseHeavy.DamageMult or 1.35) * 1.1,
		IsFinisher = true,
		PoiseMult = (baseHeavy.PoiseMult or 1.4) * 1.3,
		Windup = hw, Active = ha, Recovery = hr,
		Motion = { Mode = Module.MotionModes.Hover },
		IsSlam = true,
	}

	return {
		L = airLight,
		LL = airLight,
		LLL = airLight,
		LLLL = airLight,
		H = airHeavy,
		LH = airHeavy,
		LLH = airHeavy,
	}
end

local function buildDodgeCounterEntries(ground: { [string]: any }): { [string]: any }
	local baseLight = ground.L or Module.Generic.L
	local baseHeavy = ground.H or Module.Generic.H
	local lw, la, lr = scaleTimings(baseLight, COUNTER_TIME_SCALE)
	local hw, ha, hr = scaleTimings(baseHeavy, COUNTER_TIME_SCALE)

	local counterLight = {
		Anim = 'C_L1',
		DamageMult = (baseLight.DamageMult or 1.0) * 1.6,
		IsFinisher = true,
		PoiseMult = (baseLight.PoiseMult or 1.0) * 1.8,
		Windup = lw, Active = la, Recovery = lr,
		IsCounter = true,
	}

	local counterHeavy = {
		Anim = 'C_H1',
		DamageMult = (baseHeavy.DamageMult or 1.35) * 1.5,
		IsFinisher = true,
		IsLauncher = true,
		LaunchScale = 1.1,
		PoiseMult = (baseHeavy.PoiseMult or 1.4) * 1.9,
		Windup = hw, Active = ha, Recovery = hr,
		IsCounter = true,
	}

	return {
		L = counterLight, LL = counterLight, LLL = counterLight, LLLL = counterLight,
		H = counterHeavy, LH = counterHeavy, LLH = counterHeavy,
	}
end

----------------------------------------------------------------------
-- Resolution + composition.
--
-- ResolveMove composes the final CombatMove from three layers:
--   class profile  (reach, volume, weight, approach behaviour)
-- + context        (cancel windows, default motion mode)
-- + entry          (per-step timings, damage, on-hit effects)
--
-- Results are memoised per (class, context, key). The tables handed
-- back are treated as immutable by every caller; the runtime copies
-- anything it needs to mutate.
----------------------------------------------------------------------
local MoveCache: { [string]: any } = {}
local ContextCache: { [string]: { [string]: any } } = {}

function Module.GetClassProfile(weaponClass: string?)
	if typeof(weaponClass) ~= 'string' then
		return Module.FallbackProfile
	end
	return Module.ClassProfiles[weaponClass] or Module.FallbackProfile
end

function Module.HasClass(weaponClass: string?): boolean
	return typeof(weaponClass) == 'string' and Module.Classes[weaponClass] ~= nil
end

-- Returns the entry table for one (class, context) pair, generating and
-- caching the derived Air / DodgeCounter tables on first use.
local function getContextEntries(weaponClass: string, context: string): { [string]: any }
	local cacheKey = weaponClass .. '|' .. context
	local cached = ContextCache[cacheKey]
	if cached then return cached end

	local classEntry = Module.Classes[weaponClass] or Module.Classes[Module.DefaultClass]
	local ground = (classEntry and classEntry.Ground) or {}

	local entries
	if context == Module.Contexts.Air then
		entries = buildAirEntries(ground)
		-- Authored overrides win over the generated table.
		for key, value in (classEntry and classEntry.Air) or {} do
			entries[key] = value
		end
	elseif context == Module.Contexts.DodgeCounter then
		entries = buildDodgeCounterEntries(ground)
		for key, value in (classEntry and classEntry.DodgeCounter) or {} do
			entries[key] = value
		end
	else
		entries = ground
	end

	ContextCache[cacheKey] = entries
	return entries
end

-- Pick the fallback entry for an unauthored key. Heavy-terminated keys
-- get the heavy generic so an unauthored `LLH` still hits like a heavy.
local function fallbackEntryForKey(key: string?): any
	if typeof(key) == 'string' and string.sub(key, -1, -1) == 'H' then
		return Module.Generic.H
	end
	return Module.Generic.L
end

-- Compose the fully-resolved move. Never returns nil.
function Module.ResolveMove(weaponClass: string?, context: string?, comboKey: string?)
	local class = (typeof(weaponClass) == 'string' and Module.Classes[weaponClass])
		and weaponClass
		or Module.DefaultClass
	local ctx = context
	if ctx ~= Module.Contexts.Air and ctx ~= Module.Contexts.DodgeCounter then
		ctx = Module.Contexts.Ground
	end
	local key = typeof(comboKey) == 'string' and #comboKey > 0 and comboKey or 'L'

	local cacheKey = class .. '|' .. ctx .. '|' .. key
	local cached = MoveCache[cacheKey]
	if cached then return cached end

	local entry = getContextEntries(class, ctx)[key] or fallbackEntryForKey(key)
	local profile = Module.GetClassProfile(class)

	local windup = math.max(entry.Windup or 0.05, 0.01)
	local active = math.max(entry.Active or 0.15, 0.01)
	local recovery = math.max(entry.Recovery or 0.20, 0.01)
	local total = windup + active + recovery

	-- Ground attacks move the caster not at all. Only the air chain
	-- authors a motion, and the only thing it can ask for is to hold
	-- altitude for the swing.
	local motion = entry.Motion or { Mode = Module.MotionModes.None }

	local move = {
		Id = cacheKey,
		WeaponClass = class,
		Context = ctx,
		ComboKey = key,
		-- Cosmetic only. Nothing below reads this.
		AnimationSlot = entry.Anim,

		Windup = windup,
		Active = active,
		Recovery = recovery,
		Total = total,

		CancelFrom = entry.CancelFrom or DEFAULT_CANCEL_FROM[ctx] or DEFAULT_CANCEL_FROM.Ground,

		-- One box for standard attacks. The scheduler accepts a list so
		-- multi-hit moves are a data change, not a code change.
		Hitboxes = {
			{
				Id = 'primary',
				Offset = profile.Reach,
				Size = profile.HitboxSize,
				-- Relative to the START of the active window.
				ActiveAt = 0,
				Duration = active,
				MaxTargets = profile.MaxTargets,
				HitOnce = true,
			},
		},

		DamageMult = entry.DamageMult or 1.0,
		PoiseDamage = profile.PoiseDamage * (entry.PoiseMult or 1.0),

		IsFinisher = entry.IsFinisher == true,
		IsLauncher = entry.IsLauncher == true,
		IsSlam = entry.IsSlam == true,
		IsCounter = entry.IsCounter == true,
		AirSustain = entry.AirSustain == true,
		LaunchScale = entry.LaunchScale or 1.0,

		Motion = motion,
	}

	MoveCache[cacheKey] = move
	return move
end

-- True when the (class, context) pair actually authors this key, as
-- opposed to falling through to the generic entry. The server uses this
-- to decide whether a client's claimed combo key was real.
function Module.HasAuthoredMove(weaponClass: string?, context: string?, comboKey: string?): boolean
	if typeof(comboKey) ~= 'string' or #comboKey == 0 then return false end
	local class = (typeof(weaponClass) == 'string' and Module.Classes[weaponClass])
		and weaponClass
		or Module.DefaultClass
	local ctx = context
	if ctx ~= Module.Contexts.Air and ctx ~= Module.Contexts.DodgeCounter then
		ctx = Module.Contexts.Ground
	end
	return getContextEntries(class, ctx)[comboKey] ~= nil
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Modules"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="ReplicatedStorage/Modules/Modules/FiniteStateMachine"><![CDATA[-- https://github.com/unindented/lua-fsm
-- https://github.com/unindented/lua-fsm/blob/master/src/fsm.lua

export type finite_state_machine = {
	can : (any) -> (any),
	cannot : (any) -> (any),
	current : (string),
	init : (any) -> (any),
	is : (any) -> (any),
	is_finished : (any) -> (any),
	is_pending : (any) -> (any),
	transitions : (any) -> (any),
}

local M = {}
M.WILDCARD      = "*"
M.DEFERRED      = 0
M.SUCCEEDED     = 1
M.NO_TRANSITION = 2
M.PENDING       = 3
M.CANCELLED     = 4

local function do_callback(handler, args)
	if handler then
		return handler(unpack(args))
	end
end

local function before_event(self, event, _, _, args)
	local specific = do_callback(self["on_before_" .. event], args)
	local general = do_callback(self["on_before_event"], args)

	if specific == false or general == false then
		return false
	end
end

local function leave_state(self, _, from, _, args)
	local specific = do_callback(self["on_leave_" .. from], args)
	local general = do_callback(self["on_leave_state"], args)

	if specific == false or general == false then
		return false
	end
	if specific == M.DEFERRED or general == M.DEFERRED then
		return M.DEFERRED
	end
end

local function enter_state(self, _, _, to, args)
	do_callback(self["on_enter_" .. to] or self["on_" .. to], args)
	do_callback(self["on_enter_state"] or self["on_state"], args)
end

local function after_event(self, event, _, _, args)
	do_callback(self["on_after_" .. event] or self["on_" .. event], args)
	do_callback(self["on_after_event"] or self["on_event"], args)
end

local function build_transition(self, event, states)
	return function (...)
		local from = self.current
		local to = states[from] or states[M.WILDCARD] or from
		local args = {self, event, from, to, ...}

		assert(not self.is_pending(),
			"previous transition still pending")

		assert(self.can(event),
			"invalid transition from state '" .. from .. "' with event '" .. event .. "'")

		local before = before_event(self, event, from, to, args)
		if before == false then
			return M.CANCELLED
		end

		if from == to then
			after_event(self, event, from, to, args)
			return M.NO_TRANSITION
		end

		self.confirm = function ()
			self.confirm = nil
			self.cancel = nil

			self.current = to

			enter_state(self, event, from, to, args)
			after_event(self, event, from, to, args)

			return M.SUCCEEDED
		end

		self.cancel = function ()
			self.confirm = nil
			self.cancel = nil

			after_event(self, event, from, to, args)

			return M.CANCELLED
		end

		local leave = leave_state(self, event, from, to, args)
		if leave == false then
			return M.CANCELLED
		end
		if leave == M.DEFERRED then
			return M.PENDING
		end

		if self.confirm then
			return self.confirm()
		end
	end
end

function M.create(cfg, target)
	local self = target or {}

	-- Initial state.
	local initial = cfg.initial
	-- Allow for a string, or a map like `{state = "foo", event = "setup"}`.
	initial = type(initial) == "string" and {state = initial} or initial

	-- Initial event.
	local initial_event = initial and initial.event or "startup"

	-- Terminal state.
	local terminal = cfg.terminal

	-- Events.
	local events = cfg.events or {}

	-- Callbacks.
	local callbacks = cfg.callbacks or {}

	-- Track state transitions allowed for an event.
	local states_for_event = {}

	-- Track events allowed from a state.
	local events_for_state = {}

	local function add(e)
		-- Allow wildcard transition if `from` is not specified.
		local from = type(e.from) == "table" and e.from or (e.from and {e.from} or {M.WILDCARD})
		local to = e.to
		local event = e.name

		states_for_event[event] = states_for_event[event] or {}
		for _, fr in from do
			events_for_state[fr] = events_for_state[fr] or {}
			table.insert(events_for_state[fr], event)

			-- Allow no-op transition if `to` is not specified.
			states_for_event[event][fr] = to or fr
		end
	end

	if initial then
		add({name = initial_event, from = "none", to = initial.state})
	end

	for _, event in events do
		add(event)
	end

	for event, states in states_for_event do
		self[event] = build_transition(self, event, states)
	end

	for name, callback in callbacks do
		self[name] = callback
	end

	self.current = "none"

	function self.is(state)
		if type(state) == "table" then
			for _, s in state do
				if self.current == s then
					return true
				end
			end

			return false
		end

		return self.current == state
	end

	function self.can(event)
		local states = states_for_event[event]
		local to = states and (states[self.current] or states[M.WILDCARD])
		return to ~= nil
	end

	function self.cannot(event)
		return not self.can(event)
	end

	function self.transitions()
		return events_for_state[self.current]
	end

	function self.is_pending()
		return self.confirm ~= nil
	end

	function self.is_finished()
		return self.is(terminal)
	end

	if initial and not initial.defer then
		self[initial_event]()
	end

	return self
end

return M]]></Source>
		<Source path="ReplicatedStorage/Modules/Modules/Signal"><![CDATA[
export type CallbackFunction = (...any) -> nil

export type Callback = {
	Active : boolean,
	Destroyed : boolean,
	Callback : CallbackFunction,

	Disconnect : (Callback) -> nil,
}

export type Signal = {
	ID : string,
	Destroyed : boolean,
	_callbacks : {any},

	Fire : (Signal, ...any?) -> nil,
	Connect : (Signal, CallbackFunction) -> Callback,
	Once : (Signal, CallbackFunction) -> nil,
}

local Callback = {}
Callback.__index = Callback

function Callback.New(callback : CallbackFunction) : Callback
	return setmetatable({Destroyed = false, Callback = callback,}, Callback)
end

function Callback:Disconnect()
	if self.Destroyed then
		error('Callback has been destroyed.')
	end
	self.Destroyed = true
	setmetatable(self, nil)
end

local Signal = {}
Signal.__index = Signal

function Signal.New(customId : string?)
	return setmetatable({ID = customId or tostring(os.clock()), Destroyed = false, _callbacks = {},}, Signal)
end

function Signal:Fire(... : any?)
	if self.Destroyed then
		error('Signal has been destroyed.')
	end

	for _, callback : Callback in self._callbacks do
		if callback.Destroyed then
			table.remove(self._callbacks, table.find(self._callbacks, callback))
		else
			callback.Callback(...)
		end
	end
end

function Signal:Connect(func : CallbackFunction) : Callback
	if self.Destroyed then
		error('Signal has been destroyed.')
	end
	local callback = Callback.New(func)
	table.insert(self._callbacks, callback)
	return callback
end

function Signal:Once(func : CallbackFunction) : Callback
	if self.Destroyed then
		error('Signal has been destroyed.')
	end
	local callback; callback = self:Connect(function()
		callback:Disconnect()
		callback = nil
		func()
	end)
end

function Signal:Wait(delay : number?)
	if self.Destroyed then
		error('Signal has been destroyed.')
	end
	local bindable = Instance.new('BindableEvent')
	local hasTriggered = false

	self:Once(function()
		hasTriggered = true
		bindable:Fire()
	end)

	if not hasTriggered then
		bindable.Event:Wait()
	end

	bindable:Destroy()

	if delay and delay > 0 then
		task.wait(delay)
	end
end

function Signal:Destroy()
	if self.Destroyed then
		error('Signal has been destroyed.')
	end
	self.Destroyed = true
	self.ID = nil
	self._callbacks = nil
	setmetatable(self, nil)
end

return Signal

-- SPOOK_EXE
]]></Source>
		<Source path="ReplicatedStorage/Modules/Modules/QuadTree"><![CDATA[
export type Point = { x : number, y : number, data : any? }
export type Rectangle = { x : number, y : number, width : number, height : number, data : any? }
export type QuadTree = {
	boundary : Rectangle, capacity : number, divide : boolean?,
	northeast : QuadTree?, northwest : QuadTree?, southeast : QuadTree?, southwest : QuadTree?,
	points : { Point | Rectangle },
}

local function SetProperties(Parent, Properties)
	if typeof(Properties) == "table" then
		for propName, propValue in Properties do
			Parent[propName] = propValue
		end
	end
	return Parent
end

-- // Point // --
local Point = { ClassName = 'Point' }
Point.__index = Point

function Point.New(Properties)
	return setmetatable(SetProperties({
		x = 0,
		y = 0,
		data = nil,
	}, Properties), Point)
end

function Point:Show(yLevel)
	local A = Instance.new('Attachment')
	A.WorldPosition = Vector3.new(self.x, yLevel, self.y)
	A.Visible = true
	A.Parent = workspace.Terrain
	return A
end

-- // Rectangle // --
local Rectangle = { ClassName = 'Rectangle' }
Rectangle.__index = Rectangle
function Rectangle.New(Properties)
	return setmetatable(SetProperties({
		x = 0,
		y = 0,
		width = 0,
		height = 0,
		data = nil,
	}, Properties), Rectangle)
end

function Rectangle:Intersects(_rectangle)
	return not (
		(_rectangle.x - _rectangle.width > self.x + self.width) or 
			(_rectangle.x + _rectangle.width < self.x - self.width)  or
			(_rectangle.y - _rectangle.height > self.y + self.height) or
			(_rectangle.y + _rectangle.height < self.y - self.height)
	)
end

function Rectangle:Contains(_point)
	return
		(_point.x <= self.x + self.width) and
		(_point.x >= self.x - self.width) and
		(_point.y <= self.y + self.height) and
		(_point.y >= self.y - self.height)
end

function Rectangle:Show(yLevel)

	local locations = {
		Vector3.new(self.x + self.width, yLevel, self.y + self.height),
		Vector3.new(self.x - self.width, yLevel, self.y + self.height),
		Vector3.new(self.x - self.width, yLevel, self.y - self.height),
		Vector3.new(self.x + self.width, yLevel, self.y - self.height),
	}

	local instances = {}
	for i, v in locations do
		local A = Instance.new('Attachment')
		A.Name = i
		A.WorldPosition = v
		A.Visible = true
		A.Parent = workspace.Terrain
		table.insert(instances, A)
	end

	local col = ColorSequence.new(Color3.new(1,1,1))

	local beams = {}
	local lastAttachment = instances[#instances]
	for _, attachment in instances do
		if lastAttachment then
			local b = Instance.new('Beam')
			b.Color = self.customColor or col
			b.Segments = 1
			b.FaceCamera = true
			b.Attachment0 = attachment
			b.Attachment1 = lastAttachment
			b.LightEmission = 1
			b.LightInfluence = 0
			b.Width0 = 0.5
			b.Width1 = 0.5
			b.Parent = workspace
			table.insert(beams, b)
		end
		lastAttachment = attachment
	end

	table.move(beams, 1, #beams, #instances + 1, instances)

	return instances

end

-- // QuadTree // --
local quadTreeCapacity = 8

local QuadTree = { ClassName = 'QuadTree' }
QuadTree.__index = QuadTree

function QuadTree.New(Properties)
	return setmetatable(SetProperties({
		boundary = Rectangle.New(),

		capacity = quadTreeCapacity,
		points = {},

		divide = false,
		northeast = nil,
		northwest = nil,
		southeast = nil,
		southwest = nil,

		data = nil,
	}, Properties), QuadTree)
end

function QuadTree:Subdivide()

	local x = self.boundary.x
	local y = self.boundary.y
	local w = self.boundary.width
	local h = self.boundary.height

	self.northeast = QuadTree.New({
		boundary = Rectangle.New({
			x = x + w/2,
			y = y - h/2,
			width = w/2,
			height = h/2,
		}),
		capacity = self.capacity,
		root = self,
	})

	self.northwest = QuadTree.New({
		boundary = Rectangle.New({
			x = x - w/2,
			y = y - h/2,
			width = w/2,
			height = h/2,
		}),
		capacity = self.capacity,
		root = self,
	})

	self.southeast = QuadTree.New({
		boundary = Rectangle.New({
			x = x + w/2,
			y = y + h/2,
			width = w/2,
			height = h/2,
		}),
		capacity = self.capacity,
		root = self,
	})

	self.southwest = QuadTree.New({
		boundary = Rectangle.New({
			x = x - w/2,
			y = y + h/2,
			width = w/2,
			height = h/2,
		}),
		capacity = self.capacity,
		root = self,
	})

	self.divide = true

end

function QuadTree:Update(_point : Point)
	if _point.Parent and (not _point.Parent.boundary:Contains(_point)) then
		_point.Parent:Remove(_point)
		local c = 0
		local parent = _point.Parent
		while parent.root and c < 50 do
			parent = parent.root
			c += 1
		end
		parent:Insert(_point)
	end
end

function QuadTree:Insert(_point : Point)
	local isPointContained = _point.ClassName == Point.ClassName and self.boundary:Contains(_point)
	local isRectContained = _point.ClassName == Rectangle.ClassName and self.boundary:Intersects(_point)
	if not isPointContained and not isRectContained then
		return false
	end

	if #self.points < self.capacity then
		table.insert(self.points, _point)
		_point.Parent = self
		return true
	end

	if not self.divide then
		self:Subdivide()
	end

	if self.northeast:Insert(_point) then
		return true
	elseif self.southwest:Insert(_point) then
		return true
	elseif self.northwest:Insert(_point) then
		return true
	elseif self.southeast:Insert(_point) then
		return true
	end
	return false
end

function QuadTree:Query(_range, found_points)
	if _range:Intersects(self.boundary) then
		for _, p in self.points do
			local isPointContained = p.ClassName == 'Point' and _range:Contains(p)
			local isRectContained = p.ClassName == 'Rectangle' and _range:Intersects(p)
			if isPointContained or isRectContained then
				table.insert(found_points, p)
			end
		end
		if self.divide then
			self.northwest:Query(_range, found_points)
			self.northeast:Query(_range, found_points)
			self.southwest:Query(_range, found_points)
			self.southeast:Query(_range, found_points)
		end
	end
	return found_points
end

function QuadTree:Remove(point_or_range)
	local index = table.find(self.points, point_or_range)
	if index then
		table.remove(self.points, index)
	end
	if self.divide then
		self.northwest:Remove(point_or_range)
		self.northeast:Remove(point_or_range)
		self.southwest:Remove(point_or_range)
		self.southeast:Remove(point_or_range)
		if #self.northwest.points == 0 and #self.northeast.points == 0 and #self.southwest.points == 0 and #self.southeast.points == 0 then
			self.divide = false
			self.northwest = nil
			self.northeast = nil
			self.southwest = nil
			self.southeast = nil
		end
	end
end

function QuadTree:Show(yLevel, instances)
	yLevel = (yLevel or 20)

	instances = instances or { }
	
	for _, obj in self.boundary:Show(yLevel) do
		table.insert(instances, obj)
	end
	
	for _, point in self.points do
		if point.ClassName == Rectangle.ClassName then
			for _, obj in point:Show(yLevel) do
				table.insert(instances, obj)
			end
		else
			local att = point:Show(yLevel)
			table.insert(instances, att)
		end
	end

	if self.divide then
		self.northeast:Show(yLevel, instances)
		self.northwest:Show(yLevel, instances)
		self.southeast:Show(yLevel, instances)
		self.southwest:Show(yLevel, instances)
	end

	return instances
end

-- // Module // --
local Module = {}

Module.Point = Point
Module.Rectangle = Rectangle
Module.QuadTree = QuadTree

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Modules/Maid"><![CDATA[
local Maid = {}
Maid.__index = Maid
Maid.ClassName = "Maid"

function Maid.New(...)
	return setmetatable({_tasks = {...}, _instances = {}}, Maid)
end

function Maid:AttachInstance( TargetInstance )
	if table.find(self._instances, TargetInstance) then
		return
	end
	table.insert(self._instances, TargetInstance)

	self:Give(TargetInstance.Destroying:Connect(function()
		self:Cleanup()
	end))
end

function Maid:Cleanup()
	self._instances = { }
	for _, _task in ipairs( self._tasks ) do
		if typeof(_task) == 'RBXScriptConnection' then
			_task:Disconnect()
		elseif typeof(_task) == 'function' then
			task.defer(_task)
		elseif typeof(_task) == 'Instance' then
			_task:Destroy()
		elseif typeof(_task) == 'table' then
			if _task.ClassName == Maid.ClassName then
				_task:Cleanup()
			elseif _task.Disconnect then
				_task:Disconnect()
			elseif _task.ClassName == 'AnimationObject' or _task.ClassName == 'AnimatorBackend' or _task.Destroy then
				_task:Destroy()
			else
				warn('Invalid task type; ', typeof(_task), _task)
			end
		else
			warn('Invalid task type; ', typeof(_task), _task)
		end
	end
	self._tasks = {}
end

function Maid:Give( ... )
	local tasks = {...}
	for _, _task in ipairs( tasks ) do
		if table.find(self._tasks, _task) then
			warn('Task already exists in the Maid : '..tostring(_task))
		else
			table.insert(self._tasks, _task)
		end
	end
end

return Maid
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/ReplicatedData"><![CDATA[local Players = game:GetService('Players')
local RunService = game:GetService('RunService')
local HttpService = game:GetService('HttpService')

local SignalClass = require(script:WaitForChild('Signal'))
local TableUtility = require(script:WaitForChild('Table'))

local RemoteService = require(script.Parent:WaitForChild('RemoteService'))
local ReplicatedEvent = RemoteService.GetRemote('ReplicatedEvent', 'RemoteEvent', false)

local RemoteEnums = { Set = 1, Remove = 2, }

-- Sentinel path for the implicit "main" scope (everything outside tracked sub-paths).
local MAIN_PATH = ""
local OBSERVER_INTERVAL = 1

local Module = {}

Module.OnAdded = SignalClass.New()
Module.OnUpdated = SignalClass.New()
Module.OnRemoved = SignalClass.New()

if RunService:IsServer() then

	-- Last-known JSON snapshots per scope. Strings only — `data` is never
	-- copied or mutated by the observer.
	--   Public[category] = { [MAIN_PATH] = json, [path1] = json, ... }
	--   Private[uuid]    = { [MAIN_PATH] = json, [path1] = json, ... }
	Module.Comparison = { Public = {}, Private = {} }
	Module.Replications = { Public = {}, Private = {}, }
	Module._PublicSubPaths = {}
	Module.ReplicationKeyBlacklist = { "Tags" }

	local function getStore(scope, key)
		scope[key] = scope[key] or {}
		return scope[key]
	end

	local function buildMainView(data, subTablePaths)
		if type(data) ~= "table" then
			return data
		end
		local excluded = {}
		if subTablePaths then
			for _, path in subTablePaths do
				excluded[path] = true
			end
		end
		for _, key in Module.ReplicationKeyBlacklist do
			excluded[key] = true
		end
		local main = {}
		for k, v in data do
			if not excluded[k] then
				main[k] = v
			end
		end
		return main
	end

	local function sendDelta(category, value, path, subTablePaths, players)
		local payload = type(value) == "table" and TableUtility.DeepCopy(value) or value
		-- subTablePaths only travels with main deltas — the client uses it
		-- to know which top-level keys to preserve when clearing absent keys.
		local pathsForWire = (path == MAIN_PATH) and subTablePaths or nil
		if players then
			for _, p in players do
				ReplicatedEvent:FireClient(p, RemoteEnums.Set, category, payload, path, pathsForWire)
			end
		else
			ReplicatedEvent:FireAllClients(RemoteEnums.Set, category, payload, path, pathsForWire)
		end
	end

	-- force=true sends every scope regardless of snapshot — initial sync.
	local function diffAndDispatch(category, data, subTablePaths, players, store, force)
		if type(data) ~= "table" then
			return
		end

		if subTablePaths then
			for _, path in subTablePaths do
				local value = data[path]
				local newJson = HttpService:JSONEncode(value)
				if force or store[path] ~= newJson then
					store[path] = newJson
					sendDelta(category, value, path, subTablePaths, players)
				end
			end
		end

		local mainView = buildMainView(data, subTablePaths)
		local newMainJson = HttpService:JSONEncode(mainView)
		if force or store[MAIN_PATH] ~= newMainJson then
			store[MAIN_PATH] = newMainJson
			sendDelta(category, mainView, MAIN_PATH, subTablePaths, players)
		end
	end

	function Module.GetData( category : string, whitelistPlayer : Player? ) : any?
		if not whitelistPlayer then
			return Module.Replications.Public[ category ]
		end
		for i, DataTable in Module.Replications.Private do
			local _, Cat, Dat, PlayerTable = unpack(DataTable)
			if Cat == category and table.find(PlayerTable, whitelistPlayer ) then
				return Dat, i
			end
		end
		return nil
	end

	-- Set-equal on two player lists (order/duplicates ignored). Used by
	-- SetData's dedupe pass to find the matching private entry.
	local function arePlayerListsEqual( a : { Player }, b : { Player } ) : boolean
		if a == b then return true end
		if #a ~= #b then return false end
		for _, p in a do
			if not table.find(b, p) then return false end
		end
		return true
	end

	function Module.SetData(
		category : string,
		data : any,
		whitelist : { Player }?,
		subTablePaths : { string }?
	)
		if whitelist then
			-- Mutate the existing private entry for the same (category, whitelist)
			-- instead of appending. Without dedupe, every SetData call leaks an
			-- entry and the observer re-encodes all of them every tick.
			for _, entry in Module.Replications.Private do
				if entry[2] == category and arePlayerListsEqual(entry[4], whitelist) then
					entry[3] = data
					entry[5] = subTablePaths
					-- Path layout may have changed; clear so removed paths don't
					-- keep stale snapshots that block re-sends if re-added later.
					local store = getStore(Module.Comparison.Private, entry[1])
					table.clear(store)
					diffAndDispatch(category, data, subTablePaths, whitelist, store, true)
					return
				end
			end
			local uuid = HttpService:GenerateGUID(false)
			table.insert(Module.Replications.Private, { uuid, category, data, whitelist, subTablePaths })
			diffAndDispatch(category, data, subTablePaths, whitelist, getStore(Module.Comparison.Private, uuid), true)
		else
			Module.Replications.Public[ category ] = data
			Module._PublicSubPaths[ category ] = subTablePaths
			local store = getStore(Module.Comparison.Public, category)
			table.clear(store)
			diffAndDispatch(category, data, subTablePaths, nil, store, true)
		end
	end

	function Module.RemoveAll( category : string )
		if Module.Replications.Public[ category ] then
			ReplicatedEvent:FireAllClients( RemoteEnums.Remove, category )
			Module.Replications.Public[ category ] = nil
			Module._PublicSubPaths[ category ] = nil
			Module.Comparison.Public[ category ] = nil
		end
		local index = 1
		while index <= #Module.Replications.Private do
			local replicationInfo = Module.Replications.Private[index]
			if replicationInfo[2] == category then
				Module.Comparison.Private[ replicationInfo[1] ] = nil
				table.remove(Module.Replications.Private, index)
				for _, LocalPlayer in replicationInfo[4] do
					ReplicatedEvent:FireClient( LocalPlayer, RemoteEnums.Remove, category )
				end
			else
				index += 1
			end
		end
	end

	function Module.RemoveDataForPlayer( category : string, LocalPlayer : Player )
		local index = 1
		while index <= #Module.Replications.Private do
			local replicationInfo = Module.Replications.Private[index]
			local playerIndex = table.find( replicationInfo[4], LocalPlayer )
			if replicationInfo[2] == category and playerIndex then
				ReplicatedEvent:FireClient( LocalPlayer, RemoteEnums.Remove, category )
				table.remove( replicationInfo[4], playerIndex)
				if #replicationInfo[4] == 0 then
					Module.Comparison.Private[ replicationInfo[1] ] = nil
					table.remove( Module.Replications.Private, index)
				else
					index += 1
				end
			else
				index += 1
			end
		end
	end

	-- Detects external mutations of `data` (mutations made without going through
	-- SetData) by JSON-encoding each scope and comparing against the snapshot.
	-- Never mutates `data`.
	local function observe()
		for category, data in Module.Replications.Public do
			diffAndDispatch(
				category, data,
				Module._PublicSubPaths[category], nil,
				getStore(Module.Comparison.Public, category), false
			)
		end

		local index = 1
		while index <= #Module.Replications.Private do
			local replicationInfo = Module.Replications.Private[index]
			local uuid, category, data, players, subPaths = unpack(replicationInfo)
			if #players == 0 then
				Module.Comparison.Private[uuid] = nil
				table.remove(Module.Replications.Private, index)
			else
				diffAndDispatch(category, data, subPaths, players, getStore(Module.Comparison.Private, uuid), false)
				index += 1
			end
		end
	end

	-- Throwaway store with force=true so per-player full sends never
	-- poison the observer's broadcast snapshot.
	local function sendFullStateToPlayer(player : Player)
		for category, data in Module.Replications.Public do
			diffAndDispatch(category, data, Module._PublicSubPaths[category], { player }, {}, true)
		end
		for _, replicationInfo in Module.Replications.Private do
			local _, category, data, players, subPaths = unpack(replicationInfo)
			if table.find(players, player) then
				diffAndDispatch(category, data, subPaths, { player }, {}, true)
			end
		end
	end

	function Module.Init(_ : table)

		local Debounce = {}
		ReplicatedEvent.OnServerEvent:Connect(function(LocalPlayer)
			if Debounce[LocalPlayer.Name] and time() < Debounce[LocalPlayer.Name] then
				return
			end
			Debounce[LocalPlayer.Name] = time() + 2
			sendFullStateToPlayer( LocalPlayer )
		end)

		local function OnPlayerAdded( LocalPlayer )
			task.defer(sendFullStateToPlayer, LocalPlayer )
			LocalPlayer.CharacterAdded:Connect(function()
				task.defer(sendFullStateToPlayer, LocalPlayer )
			end)
		end

		for _ , LocalPlayer in Players:GetPlayers() do
			task.defer(OnPlayerAdded, LocalPlayer)
		end
		Players.PlayerAdded:Connect(OnPlayerAdded)

		task.defer(function()
			while true do
				task.wait(OBSERVER_INTERVAL)
				observe()
			end
		end)

	end

	function Module.Start()

	end

else

	Module.Replicated = { }
	-- Mirrors the server's sub-path list per category so a main-delta
	-- knows which top-level keys to preserve when clearing absent keys.
	Module._SubPaths = {}

	function Module.GetData( category : string, yield : boolean? ) : any?
		while yield and not Module.Replicated[category] do
			task.wait(0.15)
		end
		return Module.Replicated[category]
	end

	local function applyDelta(category, data, path, subTablePaths)
		local exists = Module.Replicated[category] ~= nil
		Module.Replicated[category] = Module.Replicated[category] or {}
		local target = Module.Replicated[category]

		if path == nil or path == MAIN_PATH then
			-- Replace every non-sub-path top-level key — keys absent in the
			-- new main are cleared (sub-path keys are updated separately).
			if subTablePaths then
				Module._SubPaths[category] = subTablePaths
			end
			local subSet = {}
			local pathsToTrack = Module._SubPaths[category]
			if pathsToTrack then
				for _, p in pathsToTrack do
					subSet[p] = true
				end
			end
			for k in target do
				if not subSet[k] then
					target[k] = nil
				end
			end
			if type(data) == "table" then
				for k, v in data do
					target[k] = v
				end
			end
		else
			target[path] = data
		end

		if not exists then
			Module.OnAdded:Fire(category, target)
		end
		Module.OnUpdated:Fire(category, target)
	end

	function Module.Init(_)

		ReplicatedEvent.OnClientEvent:Connect(function(Job, category, data, path, subTablePaths)
			if Job == RemoteEnums.Set then
				applyDelta(category, data, path, subTablePaths)
			elseif Job == RemoteEnums.Remove then
				Module.Replicated[category] = nil
				Module._SubPaths[category] = nil
				Module.OnRemoved:Fire(category)
			end
		end)

	end

	function Module.Start()
		while not Module.GetData('PlayerData') do
			print('requesting data from server')
			ReplicatedEvent:FireServer()
			task.wait(2)
		end
	end

end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/ReplicatedData/Table"><![CDATA[local HttpService = game:GetService("HttpService")

export type deltaTable = {
	["Edits"] : { [any] : any },
	["Removals"] : { any }
}

-- // Module // --
local Module = {}

function Module.DictKeys( dict )
	local Keys = {}
	for key, _ in dict do
		table.insert(Keys, key)
	end
	return Keys
end

function Module.readDeltaTable( old, new ) : deltaTable
	local edits = {}
	for propName, propValue in new do
		-- if value does not exist in the old table, was added
		local oldValue = old[propName]
		if oldValue == nil then
			-- print("New index addition: ", propName)
			edits[propName] = propValue
			continue
		end

		if typeof(propValue) == 'Instance' or typeof(oldValue) == "Instance" then
			if propValue ~= oldValue then
				-- print("Instance at index changed: ", propName)
				edits[propName] = propValue
			end
		elseif typeof(propValue) == "table" and typeof(oldValue) == "table" then
			-- table has not changed
			if HttpService:JSONEncode(propValue) == HttpService:JSONEncode(oldValue) then
				continue
			end
			-- has changed (deepDeltaTable?)
			edits[propName] = propValue
		elseif HttpService:JSONEncode(propValue) ~= HttpService:JSONEncode(oldValue) then
			-- print("Value(s) at index changed: ", propName)
			edits[propName] = propValue
		end
	end

	-- find any deleted items
	local removals = {}
	for propName, _ in old do
		if new[propName] == nil then
			table.insert(removals, propName)
		end
	end

	return {Edits = edits, Removals = removals}
end

function Module.applyDeltaTable( target, delta : deltaTable )
	for propName, propValue in delta.Edits do
		target[propName] = propValue
	end
	for _, propName in delta.Removals do
		target[propName] = nil
	end
end

function Module.DeepCopy(passed_table)
	local clonedTable = {}
	if typeof(passed_table) == "table" then
		for k,v in passed_table do
			clonedTable[Module.DeepCopy(k)] = Module.DeepCopy(v)
		end
	else
		clonedTable = passed_table
	end
	return clonedTable
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/ReplicatedData/Signal"><![CDATA[
export type CallbackFunction = (...any) -> nil

export type Callback = {
	Active : boolean,
	Destroyed : boolean,
	Callback : CallbackFunction,

	Disconnect : (Callback) -> nil,
}

export type Signal = {
	ID : string,
	Destroyed : boolean,
	_callbacks : {any},

	Fire : (Signal, ...any?) -> nil,
	Connect : (Signal, CallbackFunction) -> Callback,
	Once : (Signal, CallbackFunction) -> nil,
}

local Callback = {}
Callback.__index = Callback

function Callback.New(callback : CallbackFunction) : Callback
	return setmetatable({Destroyed = false, Callback = callback,}, Callback)
end

function Callback:Disconnect()
	if self.Destroyed then
		error('Callback has been destroyed.')
	end
	self.Destroyed = true
	setmetatable(self, nil)
end

local Signal = {}
Signal.__index = Signal

function Signal.New(customId : string?)
	return setmetatable({ID = customId or tostring(os.clock()), Destroyed = false, _callbacks = {},}, Signal)
end

function Signal:Fire(... : any?)
	if self.Destroyed then
		error('Signal has been destroyed.')
	end

	for _, callback : Callback in self._callbacks do
		if callback.Destroyed then
			table.remove(self._callbacks, table.find(self._callbacks, callback))
		else
			callback.Callback(...)
		end
	end
end

function Signal:Connect(func : CallbackFunction) : Callback
	if self.Destroyed then
		error('Signal has been destroyed.')
	end
	local callback = Callback.New(func)
	table.insert(self._callbacks, callback)
	return callback
end

function Signal:Once(func : CallbackFunction) : Callback
	if self.Destroyed then
		error('Signal has been destroyed.')
	end
	local callback; callback = self:Connect(function()
		callback:Disconnect()
		callback = nil
		func()
	end)
end

function Signal:Wait(delay : number?)
	if self.Destroyed then
		error('Signal has been destroyed.')
	end
	local bindable = Instance.new('BindableEvent')
	local hasTriggered = false

	self:Once(function()
		hasTriggered = true
		bindable:Fire()
	end)

	if not hasTriggered then
		bindable.Event:Wait()
	end

	bindable:Destroy()

	if delay and delay > 0 then
		task.wait(delay)
	end
end

function Signal:Destroy()
	if self.Destroyed then
		error('Signal has been destroyed.')
	end
	self.Destroyed = true
	self.ID = nil
	self._callbacks = nil
	setmetatable(self, nil)
end

return Signal

-- SPOOK_EXE
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/SoundService"><![CDATA[
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundsFolder = ReplicatedStorage:WaitForChild('AssetsShared'):WaitForChild('Sounds')

-- Client-only SFX volume multiplier (driven by SettingsRegistry on the
-- client; server callers see 1.0 since the registry isn't available there).
-- Initialized lazily because SoundService is required on both sides and
-- StarterPlayerScripts can't be reached from the server.
local SFXVolumeMultiplier = 1
if RunService:IsClient() then
	task.defer(function()
		local LocalPlayer = game:GetService('Players').LocalPlayer
		if not LocalPlayer then return end
		local PlayerScripts = LocalPlayer:WaitForChild('PlayerScripts', 5)
		local LocalModulesFolder = PlayerScripts and PlayerScripts:WaitForChild('Modules', 5)
		if not LocalModulesFolder then return end
		local LocalModules = require(LocalModulesFolder)
		local SettingsRegistry = LocalModules.Modules.SettingsRegistry
		if not SettingsRegistry then return end
		SFXVolumeMultiplier = SettingsRegistry.GetSFXMultiplier()
		SettingsRegistry.Changed:Connect(function(key)
			if key == 'MasterVolume' or key == 'SFXVolume' then
				SFXVolumeMultiplier = SettingsRegistry.GetSFXMultiplier()
			end
		end)
	end)
end

local function CreateAssetSound(soundId : string) : Sound
	local rbxassetSound = Instance.new('Sound')
	rbxassetSound.Name = soundId
	rbxassetSound.Looped = false
	rbxassetSound.Playing = false
	rbxassetSound.PlayOnRemove = false
	rbxassetSound.SoundId = soundId
	rbxassetSound.Parent = SoundsFolder
	return rbxassetSound
end

-- // Module // --
local Module = {}

function Module.ResolveSoundToInstance(sound : number | string | Sound) : Sound?
	if typeof(sound) == 'number' then
		sound = 'rbxassetid://'..tostring(sound)
	end
	if typeof(sound) == 'string' then
		-- Direct child match (or a Sound instance literally named after an
		-- rbxassetid) wins first.
		local direct = SoundsFolder:FindFirstChild(sound)
		if direct then return direct end

		-- rbxassetid blobs come next so the path-traversal branch below
		-- doesn't try to split an asset URI on '/' (which would produce
		-- malformed segments).
		if string.find(sound, 'rbxassetid://') then
			return CreateAssetSound(sound)
		end

		-- Slash-separated nested path, e.g. 'Game/sheathe' →
		-- AssetsShared/Sounds/Game/sheathe. Lets callers reference Sound
		-- instances that live in a sub-folder of the Sounds tree without
		-- coupling to FindFirstChild's flat-children-only semantics.
		if string.find(sound, '/') then
			local node: Instance? = SoundsFolder
			for segment in string.gmatch(sound, '[^/]+') do
				if not node then break end
				node = node:FindFirstChild(segment)
			end
			if node and node:IsA('Sound') then
				return node
			end
		end
		return nil
	end
	if typeof(sound) == 'Instance' then
		return sound
	end
	return nil
end

function Module.CreateSoundAtPosition(sound : number | string | Sound, position : Vector3) : (Sound?, Attachment?)
	local targetSound = Module.ResolveSoundToInstance(sound)
	if not targetSound then
		warn('Failed to create sound at position because the sound could not be resolved. ' .. tostring(sound))
		return nil, nil
	end

	local attachment = Instance.new('Attachment')
	attachment.Name = 'sound_'..tostring(sound)
	attachment.WorldCFrame = CFrame.new(position)
	attachment.Parent = workspace.Terrain

	targetSound = targetSound:Clone()
	-- Apply the user's SFX multiplier on the clone so the source asset's
	-- volume is preserved (server callers, where the registry never wires
	-- up, see multiplier = 1 and behave as before).
	targetSound.Volume = (targetSound.Volume or 0) * SFXVolumeMultiplier
	targetSound.Parent = attachment
	return targetSound, attachment
end

function Module.PlaySoundAtPosition(sound : number | string | Sound, position : Vector3, pitch : number?)
	local soundInstance, attachment = Module.CreateSoundAtPosition(sound, position)
	if not soundInstance then
		return
	end
	if pitch then
		soundInstance.PlaybackSpeed = pitch
	end
	soundInstance:Play()
	Debris:AddItem(attachment, soundInstance.TimeLength)
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/ZoneService"><![CDATA[-- ZoneService — overlap-tracked region membership.
--
-- TWO PARALLEL SYSTEMS, identical mechanics:
--   * Location zones (tag='RegionPart')   → wide-area outdoor regions.
--                                           Used by music playlists,
--                                           quest triggers, AreaLock,
--                                           cinematic-on-enter, etc.
--                                           API:  RegisterZone, GetZonesCharacterIsWithin,
--                                                 IsCharacterInZone, ZoneEnter/Leave
--   * Structure zones (tag='StructurePart')→ tight indoor / proximity
--                                           shells (workstations, shops,
--                                           dungeon rooms). Independent
--                                           membership so a character
--                                           can be in BOTH a Location
--                                           AND a Structure at once
--                                           (e.g. "in F0_World" + "at
--                                           Forge"), and consumers can
--                                           pick the granularity that
--                                           fits their use.
--                                           API:  RegisterStructure, GetStructuresCharacterIsWithin,
--                                                 IsCharacterInStructure, StructureEnter/Leave
--
-- Both systems share one update loop and one bounding-box query per
-- character so the second system is essentially free at runtime.

local CollectionService = game:GetService('CollectionService')
local RunService = game:GetService('RunService')
local Players = game:GetService('Players')

local Signal = require(script.Parent.Parent.Modules.Signal)

local DEFAULT_OVERLAP_PARAMS = OverlapParams.new()
DEFAULT_OVERLAP_PARAMS.FilterType = Enum.RaycastFilterType.Include
DEFAULT_OVERLAP_PARAMS.RespectCanCollide = false

local LOCATION_TAG  = 'RegionPart'      -- legacy name retained for back-compat
local STRUCTURE_TAG = 'StructurePart'

-- Module --
local Module = {}

----------------------------------------------------------------------
-- Location zone state (legacy "Zone" naming preserved — many call
-- sites read these tables and the ZoneEnter/Leave signals directly).
----------------------------------------------------------------------
Module.ZoneParts = {} :: { [string] : {BasePart} }
Module.ActiveZones = {} :: {[Instance] : {string}}
Module.RegisteredCharacters = {} :: {Model}

Module.ZoneEnter = Signal.New()
Module.ZoneLeave = Signal.New()

----------------------------------------------------------------------
-- Structure zone state (parallel maps, fired/checked under their own
-- StructureEnter/Leave signals so a Location subscriber doesn't see
-- structure events bleed through and vice-versa).
----------------------------------------------------------------------
Module.StructureParts = {} :: { [string]: {BasePart} }
Module.ActiveStructures = {} :: { [Instance]: {string} }

Module.StructureEnter = Signal.New()
Module.StructureLeave = Signal.New()

function Module.RegisterCharacter(character : Instance)
	if not table.find(Module.RegisteredCharacters, character) then
		table.insert(Module.RegisteredCharacters, character)
	end
end

function Module.UnRegisterCharacter(character : Instance)
	local index = table.find(Module.RegisteredCharacters, character)
	if index then
		table.remove(Module.RegisteredCharacters, index)
	end
end

----------------------------------------------------------------------
-- Generic register / unregister. The public Zone* / Structure*
-- wrappers below pin the right `partsTable` so callers don't have to
-- pass the system identifier.
----------------------------------------------------------------------
local function registerInto(partsTable: { [string]: {BasePart} }, name: string, parts: {BasePart})
	local active = partsTable[name]
	if not active then
		partsTable[name] = {}
		active = partsTable[name]
	end
	for _, object in parts do
		if not table.find(active, object) then
			table.insert(active, object)
		end
	end
end

local function unregisterPartsFrom(partsTable: { [string]: {BasePart} }, parts: {BasePart})
	for _, active in partsTable do
		for _, obj in active do
			local idx = table.find(parts, obj)
			if idx then
				local activeIdx = table.find(active, obj)
				if activeIdx then table.remove(active, activeIdx) end
			end
		end
	end
end

function Module.RegisterZone(name : string, zoneParts : {BasePart})
	registerInto(Module.ZoneParts, name, zoneParts)
end

function Module.UnRegisterZone(name : string)
	Module.ZoneParts[name] = nil
end

function Module.UnRegisterZoneParts(zoneParts : {BasePart})
	unregisterPartsFrom(Module.ZoneParts, zoneParts)
end

function Module.RegisterStructure(name: string, structureParts: {BasePart})
	registerInto(Module.StructureParts, name, structureParts)
end

function Module.UnRegisterStructure(name: string)
	Module.StructureParts[name] = nil
end

function Module.UnRegisterStructureParts(structureParts: {BasePart})
	unregisterPartsFrom(Module.StructureParts, structureParts)
end

----------------------------------------------------------------------
-- Bounding-box overlap query. Walks `partsTable`, tests the
-- character's bbox against each named region, returns the names the
-- character intersects. Re-used by both Zone and Structure paths.
----------------------------------------------------------------------
local function getMembershipFor(partsTable: { [string]: {BasePart} }, character: Model): {string}
	local found = {}
	local cframe, size = character:GetBoundingBox()
	for name, parts in partsTable do
		DEFAULT_OVERLAP_PARAMS.FilterDescendantsInstances = parts
		local hits = workspace:GetPartBoundsInBox(cframe, size, DEFAULT_OVERLAP_PARAMS)
		if #hits > 0 then
			table.insert(found, name)
		end
	end
	return found
end

function Module.GetZonesCharacterIsWithin(character : Model) : {string}
	return getMembershipFor(Module.ZoneParts, character)
end

function Module.GetZonesPlayerIsWithin(player : Player) : {string}
	if not player.Character then
		return {}
	end
	return Module.GetZonesCharacterIsWithin(player.Character)
end

function Module.GetStructuresCharacterIsWithin(character: Model): {string}
	return getMembershipFor(Module.StructureParts, character)
end

function Module.GetStructuresPlayerIsWithin(player: Player): {string}
	if not player.Character then return {} end
	return Module.GetStructuresCharacterIsWithin(player.Character)
end

function Module.IsCharacterInZone(character : Model, zoneName : string) : boolean
	if not Module.ActiveZones[character] then
		Module.ActiveZones[character] = {}
	end
	return table.find(Module.ActiveZones[character], zoneName) ~= nil
end

function Module.IsPlayerInZone(player : Player, zoneName : string) : boolean
	if not player.Character then
		return false
	end
	if not Module.ActiveZones[player.Character] then
		Module.ActiveZones[player.Character] = {}
	end
	return table.find(Module.ActiveZones[player.Character], zoneName) ~= nil
end

function Module.IsCharacterInStructure(character: Model, structureName: string): boolean
	if not Module.ActiveStructures[character] then
		Module.ActiveStructures[character] = {}
	end
	return table.find(Module.ActiveStructures[character], structureName) ~= nil
end

function Module.IsPlayerInStructure(player: Player, structureName: string): boolean
	if not player.Character then return false end
	if not Module.ActiveStructures[player.Character] then
		Module.ActiveStructures[player.Character] = {}
	end
	return table.find(Module.ActiveStructures[player.Character], structureName) ~= nil
end

function Module.GetActiveZones(character : Model) : {string}
	if not Module.ActiveZones[character] then
		Module.ActiveZones[character] = {}
	end
	return Module.ActiveZones[character] or {}
end

function Module.GetActiveStructures(character: Model): {string}
	if not Module.ActiveStructures[character] then
		Module.ActiveStructures[character] = {}
	end
	return Module.ActiveStructures[character] or {}
end

----------------------------------------------------------------------
-- Diff one character's "is currently in" set against the freshly
-- queried "should be in" set. Fires enter/leave on transition. Pulled
-- out so we can run it twice per character (once per system) with the
-- right active map + signal pair.
----------------------------------------------------------------------
local function reconcileMembership(
	character: Model,
	standing: {string},
	active: {string},
	enter: any,
	leave: any
)
	-- Remove stale entries first to keep the tail walk cheap.
	local idx = 1
	while idx <= #active do
		local current = active[idx]
		if table.find(standing, current) then
			idx += 1
		else
			table.remove(active, idx)
			leave:Fire(character, current)
		end
	end
	-- Add freshly entered ones.
	for _, name in standing do
		if not table.find(active, name) then
			table.insert(active, name)
			enter:Fire(character, name)
		end
	end
end

function Module.UpdateZones()
	for _, character in Module.RegisteredCharacters do
		Module.ActiveZones[character] = Module.ActiveZones[character] or {}
		Module.ActiveStructures[character] = Module.ActiveStructures[character] or {}

		-- Dead / ungone characters: leave every active region in BOTH
		-- systems and unregister.
		local humanoid = character:FindFirstChildWhichIsA('Humanoid')
		if (not humanoid) or (humanoid.Health <= 0) then
			local activeZones = Module.ActiveZones[character]
			while #activeZones > 0 do
				local zoneName: string = table.remove(activeZones, 1)
				Module.ZoneLeave:Fire(character, zoneName)
			end
			local activeStructures = Module.ActiveStructures[character]
			while #activeStructures > 0 do
				local structureName: string = table.remove(activeStructures, 1)
				Module.StructureLeave:Fire(character, structureName)
			end
			Module.UnRegisterCharacter(character)
			continue
		end

		-- Reconcile each system independently. One bbox query per
		-- system (the helper already pulls the bbox internally).
		reconcileMembership(
			character,
			Module.GetZonesCharacterIsWithin(character),
			Module.ActiveZones[character],
			Module.ZoneEnter, Module.ZoneLeave
		)
		reconcileMembership(
			character,
			Module.GetStructuresCharacterIsWithin(character),
			Module.ActiveStructures[character],
			Module.StructureEnter, Module.StructureLeave
		)
	end

	-- Cleanup any old characters from BOTH active maps.
	for character, _ in Module.ActiveZones do
		if character and not character:IsDescendantOf(workspace) then
			Module.ActiveZones[character] = nil
		end
	end
	for character, _ in Module.ActiveStructures do
		if character and not character:IsDescendantOf(workspace) then
			Module.ActiveStructures[character] = nil
		end
	end
end

----------------------------------------------------------------------
-- Tag-driven auto-registration. Walks the existing tag set and
-- subscribes to additions. Each system uses Name-bucketing — every
-- BasePart tagged with the same Name is grouped under that name, so
-- a designer can paint multi-part regions just by sharing the part
-- name.
----------------------------------------------------------------------
local function bulkSetup(target: { [string]: {BasePart} }, registerOne: (string, {BasePart}) -> ())
	return function(byName: { [string]: {BasePart} })
		for name, parts in byName do
			registerOne(name, parts)
		end
		-- target retained for completeness — registerOne writes to it.
		local _ = target
	end
end

local function collectByName(tag: string): { [string]: {BasePart} }
	local dict: { [string]: {BasePart} } = {}
	for _, object in CollectionService:GetTagged(tag) do
		if object:IsA('BasePart') then
			dict[object.Name] = dict[object.Name] or {}
			table.insert(dict[object.Name], object)
		end
	end
	return dict
end

local function OnCharacterSpawnedRegister(character)
	local Humanoid = character:WaitForChild("Humanoid", 5)
	if not Humanoid then
		return
	end
	Module.RegisterCharacter(character)
end

task.spawn(function()
	-- Locations.
	bulkSetup(Module.ZoneParts, Module.RegisterZone)(collectByName(LOCATION_TAG))
	CollectionService:GetInstanceAddedSignal(LOCATION_TAG):Connect(function(object: Instance)
		if object:IsA('BasePart') then
			Module.RegisterZone(object.Name, { object })
		end
	end)
	CollectionService:GetInstanceRemovedSignal(LOCATION_TAG):Connect(function(object: Instance)
		if object:IsA('BasePart') then
			Module.UnRegisterZoneParts({ object })
		end
	end)

	-- Structures.
	bulkSetup(Module.StructureParts, Module.RegisterStructure)(collectByName(STRUCTURE_TAG))
	CollectionService:GetInstanceAddedSignal(STRUCTURE_TAG):Connect(function(object: Instance)
		if object:IsA('BasePart') then
			Module.RegisterStructure(object.Name, { object })
		end
	end)
	CollectionService:GetInstanceRemovedSignal(STRUCTURE_TAG):Connect(function(object: Instance)
		if object:IsA('BasePart') then
			Module.UnRegisterStructureParts({ object })
		end
	end)

	-- setup player handlers
	if RunService:IsServer() then
		local function PlayerAdded(player: Player)
			if player.Character then
				task.spawn(OnCharacterSpawnedRegister, player.Character)
			end
			player.CharacterAdded:Connect(OnCharacterSpawnedRegister)
		end

		for _, player in Players:GetPlayers() do
			task.spawn(PlayerAdded, player)
		end
		Players.PlayerAdded:Connect(PlayerAdded)
	else
		local LocalPlayer = Players.LocalPlayer
		if LocalPlayer.Character then
			task.spawn(OnCharacterSpawnedRegister, LocalPlayer.Character)
		end
		LocalPlayer.CharacterAdded:Connect(OnCharacterSpawnedRegister)
	end

	-- update active zones
	while true do
		task.wait(0.1)
		Module.UpdateZones()
	end
end)

Players.PlayerRemoving:Connect(function(LocalPlayer)
	if LocalPlayer.Character then
		Module.UnRegisterCharacter(LocalPlayer.Character)
	end
end)

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/InteractableService"><![CDATA[
local InteractableData = require(script.Parent.Parent:WaitForChild('Data'):WaitForChild('Interactable'))

local QuadTreeModule = require(script.Parent.Parent:WaitForChild('Modules'):WaitForChild('QuadTree'))
local SignalModule = require(script.Parent.Parent:WaitForChild('Modules'):WaitForChild('Signal'))

export type InteractableProperties = {
	-- interactable-specific id
	IID : string,

	-- the interactable object
	Object : Instance,
	-- adornee
	Adornee : BasePart,
	-- where the distance is calculated from
	Center : BasePart,

	-- object text
	ObjectText : string?,
	-- action text
	ActionText : string?,

	-- keyboard keycode
	KeyboardCode : Enum.KeyCode?,
	-- gamepad keycode
	GamepadCode : Enum.KeyCode?,
	-- is touch enabled for this interactable
	TouchEnabled : boolean,

	-- is single-use interaction
	SingleUse : boolean,
	-- cooldown for interaction if not single use
	Cooldown : number,
	-- holding duration, 0 for instant
	HoldDuration : number,
	-- max distance it can be interacted at (<32 studs)
	MaxInteractDistance : number,
	-- whether or not to include height in the distance calculation
	MaxDistanceIncludesHeight : boolean,
	-- requires line of sight
	RequiresLineOfSight : boolean,
	-- show beam line
	ShowBeamLine : boolean,
	-- show highlight
	ShowHighlight : boolean,

	-- custom whitelist function
	IsInteractable : ((InteractableBase, (Player | Model)?) -> boolean)?,
}

export type InteractableBase = {
	-- unique identifier for this interactable
	UID : string | number,
	-- interactable-specific id
	IID : string,

	-- the interactable object
	Object : Instance,
	-- adornee
	Adornee : BasePart,
	-- where the distance is calculated from
	Center : BasePart,

	-- object text
	ObjectText : string?,
	-- action text
	ActionText : string?,

	-- is single-use interaction
	SingleUse : boolean,
	-- cooldown for interaction if not single use
	Cooldown : number,
	-- holding duration, 0 for instant
	HoldDuration : number,
	-- max distance it can be interacted at (<32 studs)
	MaxInteractDistance : number,
	-- whether or not to include height in the distance calculation
	MaxDistanceIncludesHeight : boolean,
	-- requires line of sight
	RequiresLineOfSight : boolean,
	-- show beam line
	ShowBeamLine : boolean,
	-- show highlight
	ShowHighlight : boolean,

	-- custom whitelist function
	IsInteractable : ((InteractableBase, (Player | Model)?) -> boolean)?,

	-- events
	InteractHoldBegin : RBXScriptSignal,
	InteractHoldEnd : RBXScriptSignal,
	InteractTriggered : RBXScriptSignal,
	InteractShown : RBXScriptSignal,
	InteractHidden : RBXScriptSignal,
}

-- TODO: move to QuadTree Service
local InteractionQuadTree = QuadTreeModule.QuadTree.New({
	capacity = 4,
	boundary = QuadTreeModule.Rectangle.New({
		x=0, y=0,
		width=InteractableData.MaxQuadTreeBounds, height=InteractableData.MaxQuadTreeBounds,
	}),
})

local InteractionNearBounds = QuadTreeModule.Rectangle.New({
	x=0, y=0, width=InteractableData.MaxInteractionDistance, height=InteractableData.MaxInteractionDistance
})

local RegisteredInteractables  : {InteractableBase} = {}
local RegisteredIPoints : {any} = {}

local function SetProperties(parent : any, properties : {[string] : any}) : any
	if typeof(properties) == "table" then
		for propName, propValue in properties do
			parent[propName] = propValue
		end
	end
	return parent
end

local Module = {}

function Module.CreateInteractableBase(properties : InteractableProperties) : InteractableBase
	return SetProperties({
		-- unique identifier for this interactable
		UID = tostring(time()),
		-- interactable-specific id
		IID = nil,

		-- the interactable object
		Object = nil,
		-- adornee
		Adornee = nil,
		-- where the distance is calculated from
		Center = nil,

		-- keyboard keycode
		KeyboardCode = Enum.KeyCode.E,
		-- gamepad keycode
		GamepadCode = Enum.KeyCode.X,
		-- is touch enabled for this interactable
		TouchEnabled = true,

		-- object text
		ObjectText = 'Unknown Interactable',
		-- action text
		ActionText = nil,

		-- is single-use interaction
		SingleUse = false,
		-- cooldown for interaction if not single use
		Cooldown = 3,
		-- holding duration, 0 for instant
		HoldDuration = 0.5,
		-- max distance it can be interacted at (<32 studs)
		MaxInteractDistance = 8,
		-- whether or not to include height in the distance calculation
		MaxDistanceIncludesHeight = false,
		-- requires line of sight
		RequiresLineOfSight = true,
		-- show beam line
		ShowBeamLine = true,
		-- show highlight
		ShowHighlight = true,

		-- custom whitelist function
		IsInteractable = nil,
		-- custom whitelist function to check if the player can interact with it
		IsInteractablePlayer = nil,
		-- custom whitelist function to check if the NPC can interact with it
		IsInteractableNPC = nil,

		-- events
		InteractHoldBegin = SignalModule.New(),
		InteractHoldEnd = SignalModule.New(),
		InteractTriggered = SignalModule.New(),
		InteractShown = SignalModule.New(),
		InteractHidden = SignalModule.New(),
	}, properties)
end

function Module.HasAbilityToInteractWith(interactable : InteractableBase, interactee : (Player | Model)?) : boolean
	if interactable.Cooldown and interactable.LastAction and time() < interactable.LastAction + interactable.Cooldown then
		return false
	end
	return (not interactable.IsInteractable) or interactable.IsInteractable(interactable)
end

function Module.HadInteractedWith(interactable : InteractableBase, interactee : (Player | Model)?)
	interactable.LastAction = time()
end

function Module.FindClosestInteractables(position : Vector3, interactee : (Model | Player)?) : {InteractableBase}
	InteractionNearBounds.x = position.X
	InteractionNearBounds.y = position.Z
	local nearby = {}
	local distance_mapping = {}
	local query = InteractionQuadTree:Query(InteractionNearBounds, {})
	for _, point in query do
		-- distance check (use the center's position instead of the quad_tree point)
		local center_position : Vector3 = point.data.Center.Position
		local distance : number? = nil
		if point.data.MaxDistanceIncludesHeight then
			distance = (center_position - position).Magnitude
		else
			local point_position : Vector3 = Vector3.new(position.X, center_position.Y, position.Z)
			distance = (center_position - point_position).Magnitude
		end
		-- check if its too far away
		if distance > point.data.MaxInteractDistance then
			continue
		end
		-- check ability to interact with
		if not Module.HasAbilityToInteractWith(point.data, interactee) then
			continue
		end
		-- add to nearby points
		table.insert(nearby, point.data)
		distance_mapping[point.data] = distance
	end

	-- ascending order (lowest to highest distance)
	table.sort(nearby, function(a, b)
		return distance_mapping[a] < distance_mapping[b]
	end)

	return nearby
end

local LastInteractablePosition = {}

function Module.UpdateDynamicPoints()
	local function hasInteractableMoved(interactable : InteractableBase) : boolean
		if not LastInteractablePosition[interactable.Object] then
			return true
		end
		local center_position : Vector3? = nil
		if interactable.MaxDistanceIncludesHeight then
			center_position = interactable.Center.Position
		else
			center_position = Vector3.new(interactable.Center.Position.X, 0, interactable.Center.Position.Z)
		end
		local last_position : Vector3 = LastInteractablePosition[interactable.Object]
		if (center_position - last_position).Magnitude > InteractableData.MinDeltaDistanceForQuadTreeUpdate then
			return true
		end
		return false
	end

	for _, point in RegisteredIPoints do
		local interactable : InteractableBase = point.data
		-- ignore any static interactables
		if interactable.IsStaticObject then
			continue
		end
		-- check if object has been destroyed, and if so, unregister itself
		if (not interactable.Object) or (not interactable.Object.Parent) then
			Module.UnRegisterInteractable(interactable)
			continue
		end
		-- check if the interactable has moved
		if not hasInteractableMoved(interactable) then
			continue
		end
		-- update last position
		LastInteractablePosition[interactable.Object] = interactable.Center.Position
		-- update the point
		InteractionQuadTree:Update(point)
	end
end

function Module.UnRegisterObject(object : Instance)
	print('Unregister: ', object:GetFullName())

	-- remove registered instance
	local index = table.find(RegisteredInteractables, object)
	if not index then
		return
	end
	table.remove(RegisteredInteractables, index)

	-- loop through all registered points and find this interactable
	for i, point in RegisteredIPoints do
		if point.data.Object == object then
			table.remove(RegisteredIPoints, i)
			break
		end
	end
end

function Module.UnRegisterInteractable(interactable : InteractableBase)
	Module.UnRegisterObject(interactable.Object)
end

function Module.RegisterInteractable(properties : InteractableProperties) : InteractableBase?
	-- check if its already registered
	if table.find(RegisteredInteractables, properties.Object) then
		Module.UnRegisterInteractable(properties)
	end
	-- validate the interactable
	local interactable = Module.CreateInteractableBase(properties)
	-- register it
	table.insert(RegisteredInteractables, properties.Object)
	-- create a quad-tree point
	local center_position = interactable.Center.Position
	local point = QuadTreeModule.Point.New({x = center_position.X, y = center_position.Z, data = interactable})
	table.insert(RegisteredIPoints, point)
	InteractionQuadTree:Insert(point)
	-- has been registered
	return interactable
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/AnimationService"><![CDATA[
-- // Module // --
local Module = {}

function Module.ResolveAnimationValue(animationValue : number | string | Instance) : Animation?
	if typeof(animationValue) ~= "Instance" and typeof(animationValue) ~= "number" and typeof(animationValue) ~= "string" then
		return nil
	end

	if typeof(animationValue) == "number" or (typeof(animationValue) == "string" and tonumber(animationValue)) then
		animationValue = "rbxassetid://" .. tostring(animationValue)
	end

	if animationValue == 'rbxassetid://-1' then
		warn([[No animation id is set for animation value (rbxassetid://-1).
]].. tostring(debug.traceback()))
		return nil
	end

	if typeof(animationValue) == "string" then
		local AnimObj = script:FindFirstChild(animationValue)
		if not AnimObj then
			AnimObj = Instance.new('Animation')
			AnimObj.Name = animationValue
			AnimObj.AnimationId = animationValue
			AnimObj.Parent = script
		end
		animationValue = AnimObj
	end

	local isAnimInstance = typeof(animationValue) == "Instance" and animationValue:IsA("Animation")
	return isAnimInstance and animationValue or nil
end

function Module.LoadAnimationsArray(Animator, animations) : { AnimationTrack }
	local LoadedAnimations = {}
	for _, animationValue in animations do
		local animationId = Module.ResolveAnimationValue(animationValue)
		if not animationId then
			warn('Could not resolve animationId from: ', tostring(animationId))
			continue
		end
		table.insert(LoadedAnimations, Animator:LoadAnimation(animationId))
	end
	return LoadedAnimations
end

function Module.LoadAnimationsDictionary(Animator, animations) : { [string] : AnimationTrack }
	local LoadedAnimations = {}
	for animName, animationValue in animations do
		local animationId = Module.ResolveAnimationValue(animationValue)
		if not animationId then
			warn('Could not resolve animationId from: ', tostring(animationId))
			continue
		end
		LoadedAnimations[animName] = Animator:LoadAnimation(animationId)
	end
	return LoadedAnimations
end

function Module.LoadAnimationsShallow(Animator, animationTable) : { AnimationTrack } | { [string] : AnimationTrack }
	if #animationTable > 0 then
		return Module.LoadAnimationsArray(Animator, animationTable)
	end
	return Module.LoadAnimationsDictionary(Animator, animationTable)
end

function Module.LoadAnimationsDeep(Animator, array_or_dict) : table

	local cachedParent = { }

	local function DeepSearch(animTable, parentTable)
		parentTable = parentTable or { }

		-- prevent cyclic loop
		if cachedParent[parentTable] then
			return
		end
		cachedParent[parentTable] = true

		parentTable = parentTable or { }

		-- load an array of animations (assumes no nested table and only values)
		if #animTable > 0 then
			local animTracks = Module.LoadAnimationsArray(Animator, animTable)
			table.move(animTracks, 1, #animTracks, #animTable + 1, animTable)
			return parentTable
		end

		-- load a dictionary (assumes there may be nested tables at a given index)
		for animName, animValue in animTable do
			-- nested table of animations
			if typeof(animValue) == "table" then
				local tracks = {}
				DeepSearch(animValue, tracks)
				animTable[animName] = tracks
				continue
			end

			-- animation value, attempt to load
			local animationId = Module.ResolveAnimationValue(animValue)
			if not animationId then
				warn('Could not resolve animationId from: ', tostring(animationId))
				continue
			end
			parentTable[animName] = Animator:LoadAnimation(animationId)
		end

		return parentTable
	end

	return DeepSearch(array_or_dict)
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/QuadTreeService"><![CDATA[
local QuadTreeModule = require(script.Parent.Parent.Modules.QuadTree)

local DEFAULT_BOUNDS_RANGE = 131_072

local Module = {}

Module.CachedQuadTrees = {}
Module.ObjectToPoint = {}

function Module.CreateQuadTree(quadTreeName : string)
	assert(Module.CachedQuadTrees[quadTreeName], string.format("QuadTree of name %s already exists!", quadTreeName))
	Module.CachedQuadTrees[quadTreeName] = QuadTreeModule.QuadTree.New({
		boundary = QuadTreeModule.Rectangle.New({x = 0, y = 0, width = DEFAULT_BOUNDS_RANGE, height = DEFAULT_BOUNDS_RANGE}),
	})
end

function Module.Register(quadTreeName : string, object : PVInstance, is_static : boolean)
	assert(object:IsA('PVInstance'), 'Object must be a PVInstance (Model, BasePart, etc).')

	local quadTree = Module.CachedQuadTrees[quadTreeName]
	assert(quadTree, string.format("QuadTree of name %s does not exist!", quadTreeName))

	if not Module.ObjectToPoint[quadTreeName] then
		Module.ObjectToPoint[quadTreeName] = {}
	end

	-- already exists
	if Module.ObjectToPoint[quadTreeName][object] then
		return
	end

	-- does not exist, create it
	local ObjCF, ObjSize = nil, nil
	if object:IsA('Model') then
		ObjCF, ObjSize = object:GetBoundingBox()
		-- create a rectangle boundary for models
		Module.ObjectToPoint[quadTreeName][object] = QuadTreeModule.Rectangle.New({
			x = ObjCF.Position.X,
			y = ObjCF.Position.Z,
			width = ObjSize.X,
			height = ObjSize.Z,
			data = {Object = object, IsStatic = is_static},
		})
	else
		ObjCF, ObjSize = object.CFrame, false
		-- create a point for PVInstances that aren't models
		Module.ObjectToPoint[quadTreeName][object] = QuadTreeModule.Point.New({
			x = ObjCF.Position.X,
			y = ObjCF.Position.Z,
			data = {Object = object, IsStatic = is_static},
		})
	end

	-- insert it into the quad-tree
	quadTree:Insert(Module.ObjectToPoint[quadTreeName][object])
end

function Module.UnRegister(quadTreeName : string, object : Instance)
	if not Module.CachedQuadTrees[quadTreeName] then
		return
	end

	if not Module.ObjectToPoint[quadTreeName] then
		return
	end

	if not Module.ObjectToPoint[quadTreeName][object] then
		return
	end

	Module.CachedQuadTrees[quadTreeName]:Remove(Module.ObjectToPoint[quadTreeName][object])
	Module.ObjectToPoint[quadTreeName][object] = nil
end

function Module.Update(quadTreeName : string)
	if not Module.CachedQuadTrees[quadTreeName] then
		return
	end

	if not Module.ObjectToPoint[quadTreeName] then
		return
	end

	for _, point in Module.ObjectToPoint[quadTreeName] do
		if point.data.IsStatic then
			continue
		end
		Module.CachedQuadTrees[quadTreeName]:Update(point)
	end
end

function Module.UpdateObject(quadTreeName : string, object : PVInstance)
	if not Module.CachedQuadTrees[quadTreeName] then
		return
	end

	if not Module.ObjectToPoint[quadTreeName] then
		return
	end

	local point = Module.ObjectToPoint[quadTreeName][object]
	if not point then
		return
	end

	if not point.data.IsStatic then
		return
	end

	Module.CachedQuadTrees[quadTreeName]:Update(point)
end

function Module.Query(quadTreeName : string, position : Vector3, max_range : number) : {Instance}?
	if not Module.CachedQuadTrees[quadTreeName] then
		return nil
	end
	local bounds = QuadTreeModule.Rectangle.New({x = position.X, y = position.Z, width = (max_range / 2), height = (max_range / 2)})
	local points : QuadTreeModule.Point = Module.CachedQuadTrees[quadTreeName]:Query(bounds, {})
	return points
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/CombatShared"><![CDATA[
local Debris = game:GetService('Debris')
local TweenService = game:GetService('TweenService')
local RunService = game:GetService('RunService')

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedAssets = ReplicatedStorage:WaitForChild('AssetsShared')

local CombatActionsData = require(script.Parent.Parent:WaitForChild('Data'):WaitForChild('CombatActions'))
local CombatStatesData = require(script.Parent.Parent:WaitForChild('Data'):WaitForChild('CombatStates'))
local CombatConfigModule = require(script.Parent.Parent:WaitForChild('Data'):WaitForChild('CombatConfig'))
local MaidClassModule = require(script.Parent.Parent:WaitForChild('Modules'):WaitForChild('Maid'))
local CharacterStatesModule = require(script.Parent:WaitForChild('CharacterStates'))
local SoundServiceModule = require(script.Parent.Parent:WaitForChild('Services'):WaitForChild('SoundService'))
local CombatUtility = require(script.Parent.Parent:WaitForChild('Utility'):WaitForChild('CombatUtility'))

local RemoteService = require(script.Parent:WaitForChild('RemoteService'))
local CombatEvent = RemoteService.GetRemote('CombatEvent', 'RemoteEvent', false)

-- // Module // --
local Module = {}

-- Re-exports so combat code can reach the wire contract and the state
-- vocabulary through the module it already requires. There is exactly
-- one definition of each; these are aliases, not copies.
Module.CombatActions = CombatActionsData.Actions
Module.CombatInputKinds = CombatActionsData.InputKinds
Module.CombatContexts = CombatActionsData.Contexts
Module.CombatStates = CombatStatesData.States
Module.CombatStateAttributes = CombatStatesData.Attributes
Module.BLOCKING_STATE = { None = 0, NotBlocking = 1, Decrement = 2, Broken = 3 }

function Module.GetCharacterEquippedWeaponsByAttribute(character: Instance) : {string}
	local weaponIds = {}
	for attribName, attribValue in character:GetAttributes() do
		if string.find(attribName, "Weapon") then
			table.insert(weaponIds, attribValue)
		end
	end
	return weaponIds
end

function Module.DoesCharacterHaveLeftWeapon(character : Instance): any?
	return character:GetAttribute("1_Weapon")
end

function Module.DoesCharacterHaveRightWeapon(character : Instance): any?
	return character:GetAttribute("2_Weapon")
end

export type HandWeaponData = {ItemId: string?, Type: string, UUID: string}
export type WeaponSetData = {Light: HandWeaponData?, Heavy: HandWeaponData?}
function Module.GetCharacterEquippedWeaponsLR(character: Instance): (HandWeaponData?, HandWeaponData?)
	local LeftHand = nil
	local RightHand = nil
	local LeftHandAttr = Module.DoesCharacterHaveLeftWeapon(character)
	if LeftHandAttr then
		-- For NPCs the attribute IS the itemId; for players it's a UUID. Resolver disambiguates.
		LeftHand = {
			Type = "Weapon",
			UUID = LeftHandAttr,
			ItemId = CombatUtility.ResolveItemIdFromAttribute(character, LeftHandAttr),
		}
	end
	local RightHandAttr = Module.DoesCharacterHaveRightWeapon(character)
	if RightHandAttr then
		RightHand = {
			Type = "Weapon",
			UUID = RightHandAttr,
			ItemId = CombatUtility.ResolveItemIdFromAttribute(character, RightHandAttr),
		}
	end
	return LeftHand, RightHand
end

-- NieR-inspired migration naming: Bladeborne's existing attributes stay
-- `1_Weapon` / `2_Weapon`, but new combat code should read through these
-- helpers so the slot meaning is one-site: slot 1 drives light attacks,
-- slot 2 drives heavy attacks.
function Module.GetLightWeapon(character: Instance): HandWeaponData?
	local lightWeapon, _heavyWeapon = Module.GetCharacterEquippedWeaponsLR(character)
	return lightWeapon
end

function Module.GetHeavyWeapon(character: Instance): HandWeaponData?
	local _lightWeapon, heavyWeapon = Module.GetCharacterEquippedWeaponsLR(character)
	return heavyWeapon
end

function Module.GetWeaponSet(character: Instance): WeaponSetData
	local lightWeapon, heavyWeapon = Module.GetCharacterEquippedWeaponsLR(character)
	return {
		Light = lightWeapon,
		Heavy = heavyWeapon,
	}
end

----------------------------------------------------------------------
-- Weapon class resolution. Returns the WeaponClass declared in
-- `EquipmentData.WeaponClass` (Items.luau) for the given hand, or nil
-- when no weapon is equipped / the item isn't in the catalog.
--
-- Per-hand resolution lets CombosShared.ResolveActiveClass pick a
-- DualWield variant when both hands carry the same class. Defensive
-- against unknown attribute values: items missing WeaponClass return
-- nil, and the caller (ResolveActiveClass) falls back to DefaultClass.
----------------------------------------------------------------------
function Module.GetWeaponClass(character: Instance, handIndex: number): string?
	if not character then return nil end
	local cfg, _itemId = CombatUtility.ResolveWeaponConfig(character, handIndex)
	if not cfg then return nil end
	local equip = cfg.EquipmentData
	local class = equip and equip.WeaponClass
	if typeof(class) == 'string' and #class > 0 then return class end
	return nil
end

-- Convenience: resolve both hand classes in one call. Returns
-- (leftClass, rightClass), each may be nil.
function Module.GetActiveWeaponClasses(character: Instance): (string?, string?)
	if not character then return nil, nil end
	return Module.GetWeaponClass(character, 1), Module.GetWeaponClass(character, 2)
end

Module.WEAPON_WIELD_TYPES = {NONE = 0, DUAL = 1, LEFT = 2, RIGHT = 3}
function Module.GetWeaponWieldType(character: Instance): number
	local LeftHand, RightHand = Module.GetCharacterEquippedWeaponsLR(character)
	if LeftHand and LeftHand.Type == "Weapon" and RightHand and RightHand.Type == "Weapon" then
		return Module.WEAPON_WIELD_TYPES.DUAL
	elseif LeftHand and LeftHand.Type == "Weapon" then
		return Module.WEAPON_WIELD_TYPES.LEFT
	elseif RightHand and RightHand.Type == "Weapon" then
		return Module.WEAPON_WIELD_TYPES.RIGHT
	end
	return Module.WEAPON_WIELD_TYPES.NONE
end

function Module.IsCharacterAlive(character: Instance): boolean
	local Humanoid = character and character:FindFirstChildWhichIsA('Humanoid')
	return Humanoid and Humanoid.Health > 0
end

function Module.FilterDeadHumanoids(humanoids : {Humanoid}): {Humanoid}
	local index = 1
	while index <= #humanoids do
		if typeof(humanoids[index]) == 'Instance' and humanoids[index]:IsA('Humanoid') and humanoids[index].Health > 0 then
			index += 1
		else
			table.remove(humanoids, index)
		end
	end
	return humanoids
end

function Module.IsCharacterKnocked(character: Instance): any?
	return CharacterStatesModule.GetState(character, 'KnockedDown')
end

function Module.IsCharacterBlocking(character: Instance): any?
	return CharacterStatesModule.GetState(character, 'Blocking')
end

function Module.IsCharacterAttacking(character: Instance): any?
	return CharacterStatesModule.GetStateTemporary(character, 'Attacking')
end

function Module.IsCharacterStunned(character: Instance): any?
	return CharacterStatesModule.GetStateTemporary(character, 'Stunned')
end

function Module.IsCharacterDashing(character: Instance): any?
	return CharacterStatesModule.GetStateTemporary(character, 'Dashing')
end

function Module.IsWeaponDrawn(character: Instance): any?
	return CharacterStatesModule.GetState(character, 'SwordDrawn')
end

function Module.IsWeaponDrawing(character: Instance): any?
	return CharacterStatesModule.GetState(character, 'SwordDrawing')
end

-- // Block cooldown // --
-- Stored as an absolute `workspace:GetServerTimeNow()` timestamp on the
-- character. Server → client replication of attributes lets the hotbar UI
-- read the same value the server validates against. Roblox time is clock-
-- synced across the boundary within a few ms, so the same comparison works
-- on either side without skew.

function Module.GetBlockCooldownRemaining(character: Instance): number
	local untilTime = character:GetAttribute('BlockCooldownUntil')
	if typeof(untilTime) ~= 'number' then return 0 end
	local remaining = untilTime - workspace:GetServerTimeNow()
	return remaining > 0 and remaining or 0
end

function Module.IsBlockOnCooldown(character: Instance): boolean
	return Module.GetBlockCooldownRemaining(character) > 0
end

function Module.StartBlockCooldown(character: Instance)
	local cd = CombatConfigModule.CombatConfig.BLOCK_COOLDOWN or 0
	if cd <= 0 then return end
	character:SetAttribute('BlockCooldownUntil', workspace:GetServerTimeNow() + cd)
end

-- Post-block attack cooldown — separate from the re-block cooldown.
-- Set on block-end alongside `BlockCooldownUntil`. CanCharacterAttack
-- consults THIS one instead of the full block cooldown so a player
-- can swing 0.1s after letting block go, even though they can't
-- re-block for another 1.4s.
function Module.GetPostBlockAttackCooldownRemaining(character: Instance): number
	local untilTime = character:GetAttribute('PostBlockAttackUntil')
	if typeof(untilTime) ~= 'number' then return 0 end
	local remaining = untilTime - workspace:GetServerTimeNow()
	return remaining > 0 and remaining or 0
end

function Module.IsAttackOnPostBlockCooldown(character: Instance): boolean
	return Module.GetPostBlockAttackCooldownRemaining(character) > 0
end

function Module.StartPostBlockAttackCooldown(character: Instance)
	local cd = CombatConfigModule.CombatConfig.BLOCK_TO_ATTACK_DELAY or 0
	if cd <= 0 then return end
	character:SetAttribute('PostBlockAttackUntil', workspace:GetServerTimeNow() + cd)
end

-- Canonical block-end: clears `Blocking` + `BlockingCount` and arms BOTH
-- the re-block cooldown AND the shorter post-block attack cooldown.
-- Used by both the player and NPC block-end paths and by the broken-
-- block branch in DecrementBlockCount, so every block end uniformly
-- produces the two cooldowns the UI + combat gates read.
function Module.EndCharacterBlock(character: Instance)
	if not character then return end
	CharacterStatesModule.SetState(character, 'Blocking', false)
	CharacterStatesModule.SetState(character, 'BlockingCount', nil)
	Module.StartBlockCooldown(character)
	Module.StartPostBlockAttackCooldown(character)
end

function Module.IsCharacterAvailable(character: Instance): (boolean, string)
	if not Module.IsCharacterAlive(character) then
		return false, 'Character is not alive.'
	end

	if Module.IsWeaponDrawing(character) then
		return false, 'Character is currently drawing their weapon.'
	end

	-- is the character stunned?
	if Module.IsCharacterStunned(character) then
		return false, 'Character is currently stunned.'
	end

	-- is the character dashing?
	if Module.IsCharacterDashing(character) then
		return false, 'Character is currently dashing.'
	end

	-- is the character dodging? (i-frame window)
	if CharacterStatesModule.GetStateTemporary(character, 'Dodging') then
		return false, 'Character is currently dodging.'
	end

	-- is the character using a skill? Skill window covers windup +
	-- active + recovery; SkillsServer sets this temp state for the
	-- whole duration so combat actions don't overlap a cast.
	if CharacterStatesModule.GetStateTemporary(character, 'UsingSkill') then
		return false, 'Character is currently using a skill.'
	end

	-- is the character blocking?
	if Module.IsCharacterBlocking(character) then
		return false, 'Character is currently blocking.'
	end

	-- is character attacking
	if Module.IsCharacterAttacking(character) then
		return false, 'Character is currently attacking.'
	end

	return true, 'Character is available.'
end

function Module.CanCharacterDash(character: Instance): (boolean, string)
	local success, err = Module.IsCharacterAvailable(character)
	if not success then
		return false, err
	end

	-- is the character on attack cooldown?
	if CharacterStatesModule.GetStateTemporary(character, 'DashCooldown') then
		return false, 'Character is currently on dash cooldown.'
	end

	-- character is available
	return true, 'Character is available.'
end

function Module.SetupCharacterAnimations(character : Model, humanoid : Humanoid)
	local stateEvent = CharacterStatesModule.StateChanged(character)
	stateEvent:Connect(function(stateName : string, newState : any, oldState : any)
		if stateName ~= 'SwordDrawing' then
			return
		end
		if not newState then
			return
		end
		-- TODO: hook draw / withdraw weapon animation here. Earlier
		-- a print() ran on every state flip; removed because a draw
		-- + first attack burst each turn was producing observable
		-- Output flushes.
	end)
end

function Module.CanCharacterWithdrawWeapon(character: Instance): (boolean, string)
	local success, err = Module.IsCharacterAvailable(character)
	if not success then
		return false, err
	end

	if not Module.IsWeaponDrawn(character) then
		return false, "Character does not have their weapon drawn."
	end

	return true, ""
end

----------------------------------------------------------------------
-- Attack gate.
--
-- This predicate deliberately does NOT reject while an attack is in
-- flight. That was the old behaviour and it is what made chains feel
-- stiff: `IsCharacterAvailable` returns false while `Attacking`, and
-- the previous implementation additionally armed an `AttackCooldown`
-- for the move's entire windup+active+recovery. Between the two, the
-- next input in a combo could not be accepted until the previous swing
-- had completely finished, so there was no cancel window and no way to
-- chain at the rhythm the animation implied.
--
-- Whether an in-flight move may be cancelled into the next input is a
-- question about THAT MOVE's authored cancel window, answered by
-- CombosShared.CanCancelInto. The server enforces it in CombatServer;
-- the client runs the same check against its predicted move. This
-- function only answers the situational half: alive, in control, armed.
----------------------------------------------------------------------
function Module.CanCharacterAttack(character: Instance): (boolean, string)
	if not Module.IsCharacterAlive(character) then
		return false, 'Character is not alive.'
	end
	if Module.IsWeaponDrawing(character) then
		return false, 'Character is currently drawing their weapon.'
	end
	if Module.IsCharacterStunned(character) then
		return false, 'Character is currently stunned.'
	end
	for _, attribute in CombatStatesData.HardCrowdControlAttributes do
		if CharacterStatesModule.GetStateTemporary(character, attribute) == true then
			return false, 'Character is crowd controlled.'
		end
	end
	if CharacterStatesModule.GetStateTemporary(character, 'Dodging') then
		return false, 'Character is currently dodging.'
	end
	if CharacterStatesModule.GetStateTemporary(character, 'UsingSkill') then
		return false, 'Character is currently using a skill.'
	end
	if not Module.IsWeaponDrawn(character) then
		return false, 'Character does not have their weapon drawn.'
	end

	-- Post-block attack window — a short delay only
	-- (BLOCK_TO_ATTACK_DELAY, 0.1 s by default). The longer
	-- BlockCooldownUntil still gates RE-BLOCKING via
	-- CanCharacterStartBlock, so a player who block-cancels into a swing
	-- can attack but cannot immediately re-raise their guard.
	if Module.IsAttackOnPostBlockCooldown(character) then
		return false, 'Character is recovering from blocking.'
	end

	return true, ""
end

-- NOTE: there is deliberately no StartAttackCooldown here any more.
--
-- It used to arm an `AttackCooldown` temp state for a swing's whole
-- duration, and CanCharacterAttack refused while it was set. That is
-- precisely the mechanism that made combos unchainable, so both the
-- setter and the check are gone. Attack pacing is now the move's own
-- timeline plus its authored cancel windows, enforced by CombatServer
-- against CombosShared.CanCancelInto.
--
-- The `AttackCooldown` name is kept in CombatStates.Attributes as
-- vocabulary for anything that still wants a private lockout, but
-- nothing in combat reads it.

-- // Dodge // --
-- Same absolute-timestamp pattern as the block cooldown so client UI
-- and server validation share one clock.

function Module.IsCharacterDodging(character: Instance): boolean
	if not character then return false end
	return CharacterStatesModule.GetStateTemporary(character, 'Dodging') ~= nil
end

function Module.GetDodgeCooldownRemaining(character: Instance): number
	local untilTime = character:GetAttribute('DodgeCooldownUntil')
	if typeof(untilTime) ~= 'number' then return 0 end
	local remaining = untilTime - workspace:GetServerTimeNow()
	return remaining > 0 and remaining or 0
end

function Module.IsDodgeOnCooldown(character: Instance): boolean
	return Module.GetDodgeCooldownRemaining(character) > 0
end

function Module.StartDodgeCooldown(character: Instance)
	local cd = CombatConfigModule.CombatConfig.DODGE_COOLDOWN or 0
	if cd <= 0 then return end
	character:SetAttribute('DodgeCooldownUntil', workspace:GetServerTimeNow() + cd)
end

-- Dodge is intentionally PERMISSIVE — Nier's design lets you cancel
-- almost anything into a dodge. The only hard blocks are dead /
-- already-dodging / stunned / cooldown. Skills CAN be cancelled by
-- dodge (the SkillsServer's UsingSkill state is cleared by the
-- dodge — see CombatServer.AttemptDodge).
function Module.CanCharacterDodge(character: Instance): (boolean, string)
	if not Module.IsCharacterAlive(character) then return false, 'Not alive.' end
	if Module.IsCharacterStunned(character) then return false, 'Stunned.' end
	if Module.IsCharacterDodging(character) then return false, 'Already dodging.' end
	if Module.IsDodgeOnCooldown(character) then return false, 'Dodge on cooldown.' end
	return true, ''
end

function Module.CanCharacterStartBlock(character: Instance): (boolean, string)
	local success, err = Module.IsCharacterAvailable(character)
	if not success then
		return false, err
	end
	if Module.IsBlockOnCooldown(character) then
		return false, 'Character is recovering from blocking.'
	end
	return true, ""
end

function Module.StunCharacter(character: Instance, customDuration: number?)
	customDuration = customDuration or 1.5
	-- TODO: animation for npcs & players
	CharacterStatesModule.SetStateTemporary(character, 'Stunned', customDuration, true)
end

local baseFadeEffect = Instance.new('SelectionBox')
baseFadeEffect.Color3 = Color3.new(1,1,1)
baseFadeEffect.LineThickness = 0.01
baseFadeEffect.SurfaceColor3 = Color3.fromHSV(172, 127, 128)
baseFadeEffect.SurfaceTransparency = 0.8
baseFadeEffect.Transparency = 0.6
function Module.AttackFadeEffect(character: Model, duration: number?)
	duration = duration or 0.25
	for _, basePart in character:GetDescendants() do
		if basePart:IsA('BasePart') then
			local effect = baseFadeEffect:Clone()
			effect.Adornee = basePart
			effect.Parent = basePart
			TweenService:Create(effect, TweenInfo.new(duration), {SurfaceTransparency = 1, Transparency = 1}):Play()
			Debris:AddItem(effect, duration)
		end
	end
end

function Module.RunCharacterHitEffect(character: Model)
	Module.AttackFadeEffect(character)
	local SFX = ReplicatedAssets.Sounds.PunchHit
	SoundServiceModule.PlaySoundAtPosition(SFX, character:GetPivot().Position, math.random(90, 110)/100 )
end

function Module.RunBlockCounterEffect(character : Model, blockHealth: number)
	local blockBroken = (blockHealth <= 0)
	local BoundsCF, BoundsSize = character:GetBoundingBox()

	local attachment = Instance.new('Attachment')
	attachment.WorldCFrame = BoundsCF + Vector3.new( 0, BoundsSize.Y, 0 )
	attachment.Parent = workspace.Terrain

	local templateBillboard = ReplicatedAssets.UI.BlockCounter:Clone()
	templateBillboard.Adornee = attachment
	if blockBroken then
		templateBillboard.Label.Text = 'BLOCK BROKEN'
	else
		local text = string.format('%d / %d', blockHealth, CombatConfigModule.BLOCK_MAX_HITS)
		templateBillboard.Label.Text = text
	end
	templateBillboard.Parent = attachment

	task.delay(0.5, function()
		TweenService:Create(templateBillboard.Label, TweenInfo.new(0.3), {TextTransparency = 1, TextStrokeTransparency = 1}):Play()
		Debris:AddItem(attachment, 0.3)
	end)
end

function Module.UpdateBlockBillboard(character: Instance, billboard: BillboardGui)
	local current = character:GetAttribute("BlockingCount") or 0
	local maxBlocks = CombatConfigModule.CombatConfig.BLOCK_MAX_HITS
	local delta = math.clamp(current / maxBlocks, 0.001, 0.998)
	billboard.Frame.Counter.Label.Text = current
	billboard.Frame.BarBack.Bar.UIGradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(delta, 0),
		NumberSequenceKeypoint.new(delta + 0.001, 1),
		NumberSequenceKeypoint.new(1, 1),
	})
end

local BlockMaids = {}
function Module.SetupBlockingEffect(character : Instance)
	if BlockMaids[character] then
		return
	end
	-- block billboard
	local root = character:FindFirstChild('HumanoidRootPart')
	if not root then
		return
	end
	local Maid = MaidClassModule.New()
	BlockMaids[character] = Maid
	local blockBillboard = ReplicatedStorage.AssetsShared.UI.BlockBillboard:Clone()
	blockBillboard.Adornee = root
	blockBillboard.Parent = root
	Maid:Give(blockBillboard)
	Maid:Give(character:GetAttributeChangedSignal("BlockingCount"):Connect(function()
		Module.UpdateBlockBillboard(character, blockBillboard)
	end))
	Maid:Give(character.Destroying:Connect(function()
		Maid:Cleanup()
		if BlockMaids[character] then
			BlockMaids[character]:Cleanup()
		end
		BlockMaids[character] = nil
	end))
	task.defer(Module.UpdateBlockBillboard, character, blockBillboard)
	-- block particles
	local attachment = Instance.new("Attachment")
	attachment.Parent = root
	local blockParticles = ReplicatedStorage.AssetsShared.Particles.BlockShieldParticle:Clone()
	blockParticles.Parent = attachment
	Maid:Give(blockParticles)
	Maid:Give(attachment)
end

function Module.ClearBlockingEffect(character: Instance)
	local Maid = BlockMaids[character]
	if Maid then
		Maid:Cleanup()
	end
	BlockMaids[character] = nil
end

function Module.BlockedEffect(_character: Instance)
	-- Reserved for VFX/SFX wiring. Intentionally a no-op — earlier
	-- a print() lived here, but it ran on every blocked hit and
	-- flushed Studio Output (lag spike on each hit).
end

function Module.BlockBreakEffect(_character: Instance)
	-- See BlockedEffect — same rationale; populate with VFX/SFX, not prints.
end

-- Canonical block-decrement step. Used by both player and NPC combat
-- servers; callers handle their own owner-side cleanup (e.g.
-- AttemptPlayerBlockEnd / OnPlayerBlockBroken) by inspecting the
-- returned BLOCKING_STATE.
function Module.DecrementBlockCount(character: Instance, forceBlockBreak: boolean): number
	if not character then
		return Module.BLOCKING_STATE.None
	end
	if not Module.IsCharacterBlocking(character) then
		return Module.BLOCKING_STATE.NotBlocking
	end

	local currentCounter = character:GetAttribute("BlockingCount")
	if (not currentCounter) or currentCounter == 0 then
		return Module.BLOCKING_STATE.NotBlocking
	end

	currentCounter = currentCounter - 1
	if (not forceBlockBreak) and currentCounter > 0 then
		character:SetAttribute("BlockingCount", currentCounter)
		if RunService:IsServer() then
			CombatEvent:FireAllClients(Module.CombatActions.GuardBlocked, { Caster = character })
		end
		return Module.BLOCKING_STATE.Decrement
	end

	character:SetAttribute("BlockingCount", nil)
	if RunService:IsServer() then
		CombatEvent:FireAllClients(Module.CombatActions.GuardBroken, { Caster = character })
	end
	return Module.BLOCKING_STATE.Broken
end

----------------------------------------------------------------------
-- PvP detection. Returns true when both `victim` and `attacker` are
-- player characters (and not the same one). Lives here so every damage
-- / launch / multiplier site has a single hook to consult before
-- applying the PvP scalars in CombatConfig.PvP_*.
--
-- Future extension: same-party check via a guild/party registry. For
-- now any two distinct players counts as PvP.
----------------------------------------------------------------------
function Module.IsPvPHit(victim: Instance?, attacker: Instance?): boolean
	if not victim or not attacker then return false end
	local Players = game:GetService('Players')
	local vPlayer = Players:GetPlayerFromCharacter(victim)
	local aPlayer = Players:GetPlayerFromCharacter(attacker)
	if not vPlayer or not aPlayer then return false end
	if vPlayer == aPlayer then return false end
	return true
end

----------------------------------------------------------------------
-- Perfect dodge counter state. Stored as a temporary character state
-- so it auto-clears at COUNTER_WINDOW. Damage call sites consult
-- IsPerfectCounterActive to multiply the next swing.
----------------------------------------------------------------------
function Module.IsPerfectCounterActive(character: Instance?): boolean
	if not character then return false end
	return CharacterStatesModule.GetStateTemporary(character, 'PerfectDodgeCounter') ~= nil
end

function Module.SetPerfectCounterState(character: Instance, durationSeconds: number)
	if not character then return end
	CharacterStatesModule.SetStateTemporary(character, 'PerfectDodgeCounter',
		durationSeconds, true)
end

function Module.ConsumePerfectCounterState(character: Instance)
	if not character then return end
	CharacterStatesModule.SetState(character, 'PerfectDodgeCounter', nil)
end

----------------------------------------------------------------------
-- Airborne read.
--
-- Kept here because BOTH sides need it: the client resolves its combo
-- context (Ground vs Air) for prediction, and shared predicates gate on
-- it. It is a pure attribute read with no physics attached.
--
-- The forced-motion implementations that used to live below this point
-- -- launch, juggle hover, slam, air-follow, and the network
-- ownership bookkeeping they needed -- have moved to
-- ServerStorage/Core/CombatMotionServer.luau. They were server-only
-- behaviour sitting in a ReplicatedStorage module, which meant every
-- client received and could inspect several hundred lines of
-- authoritative movement code, and meant two different modules could
-- each attach a mover to the same HumanoidRootPart with no arbitration.
----------------------------------------------------------------------
function Module.IsCharacterAirborne(character: Instance?): boolean
	if not character then return false end
	return CharacterStatesModule.GetStateTemporary(character, Module.CombatStateAttributes.Airborne) == true
		or CharacterStatesModule.GetStateTemporary(character, Module.CombatStateAttributes.Lifted) == true
end

-- True while the server owns this character's movement: stunned,
-- knocked down, lifted or dragged. Client-side systems that write
-- position or orientation every frame (lock-on facing, camera rigs)
-- must stand down while this is true, or they fight the server's motion
-- constraint and produce visible stutter.
function Module.IsCharacterHardCrowdControlled(character: Instance?): boolean
	if not character then return false end
	for _, attribute in CombatStatesData.HardCrowdControlAttributes do
		if CharacterStatesModule.GetStateTemporary(character, attribute) == true then
			return true
		end
	end
	return false
end

function Module.RunDashEffect(character: Model)
	local PivotCFrame = character:GetPivot()

	-- vfx behind the character
	local DashMesh = ReplicatedAssets.VFX.Dash.DashEffect:Clone()
	DashMesh:PivotTo( PivotCFrame * CFrame.new(0, -1, 3.5) * CFrame.Angles(0, math.rad(90), math.rad(90)) * CFrame.Angles( 0, 0, math.rad(15) ) )
	DashMesh.Parent = workspace.Terrain

	local c; c = RunService.Heartbeat:Connect(function(_)
		local cf = DashMesh:GetPivot() * CFrame.new(0, 0.05, 0) * CFrame.Angles(0, math.rad(2), 0)
		DashMesh:PivotTo(cf)
	end)

	task.delay(0.5, function()
		local Tween = TweenService:Create(DashMesh, TweenInfo.new(0.8), {Transparency = 1})
		Tween:Play()
		Tween.Completed:Wait()
		c:Disconnect()
		DashMesh:Destroy()
	end)

	-- hand trails
	local HandInstances = {character.LeftHand, character.RightHand}
	for _, hand in HandInstances do
		local vfx = ReplicatedAssets.VFX.Dash.DashTrail:GetChildren()
		for _, item in vfx do
			item = item:Clone()
			item.Parent = hand
			Debris:AddItem(item, CombatConfigModule.DASH_DURATION)
		end
		-- backup sets
		hand.Trail.Attachment0 = hand.Attachment0
		hand.Trail.Attachment1 = hand.Attachment1
	end

	-- sound sfx
	local sfx = ReplicatedAssets.VFX.Dash.DashSFX
	SoundServiceModule.PlaySoundAtPosition(sfx, PivotCFrame.Position, math.random(90, 110)/100)
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/CharacterStates"><![CDATA[
local SignalModule = require(script.Parent.Parent.Modules.Signal)
local MaidClassModule = require(script.Parent.Parent.Modules.Maid)

local TEMPORARY_UUIDS = { }
local PossibleStateCache = { }
local StateEventCache = { }

-- Monotonic id generator for SetStateTemporary's "is the latest set
-- still us" check. We previously called HttpService:GenerateGUID(false)
-- per call, but SetStateTemporary fires per-hit (StunCharacter on each
-- victim) and per-swing (Attacking on the attacker), and GenerateGUID
-- allocates a 36-char string + cryptographic random per call —
-- avoidable per-hit overhead. An incrementing integer is identity-
-- equality-safe (ids never collide within a single server run because
-- they only ever go up) and trivially cheap.
local NEXT_TEMP_ID = 0

-- // Module // --
local Module = {}

function Module.StateChanged(Character)
	if not StateEventCache[Character] then
		StateEventCache[Character] = SignalModule.New()

		local Maid = MaidClassModule.New()
		local oldValueCache = {}

		Maid:Give(Character.Destroying:Connect(function()
			Maid:Cleanup()
			if StateEventCache[Character] then
				StateEventCache[Character]:Disconnect()
			end
			StateEventCache[Character] = nil
			oldValueCache = nil
		end))

		Maid:Give(Character.AttributeChanged:Connect(function(stateName)
			if StateEventCache[Character] then
				local newState = Module.GetState(Character, stateName)
				StateEventCache[Character]:Fire(stateName, newState, oldValueCache[stateName])
				oldValueCache[stateName] = newState
			end
		end))

		StateEventCache[Character]._stateMaid = Maid
	end
	return StateEventCache[Character]
end

function Module.GetCharacterStates(Character : Instance)
	local Attribs = Character:GetAttributes()
	for stateName, _ in Attribs do
		if not table.find(PossibleStateCache, stateName) then
			Attribs[stateName] = nil
		end
	end
	return Attribs
end

function Module.GetState(Character : Instance, stateName : string) : any?
	if not table.find(PossibleStateCache, stateName) then
		table.insert(PossibleStateCache, stateName)
	end
	return Character and Character:GetAttribute(stateName)
end

function Module.SetState(Character : Instance, stateName : string, stateValue : any?)
	if not table.find(PossibleStateCache, stateName) then
		table.insert(PossibleStateCache, stateName)
	end
	local oldValue = Module.GetState(Character, stateName)
	Character:SetAttribute(stateName, stateValue)
	if StateEventCache[Character] then
		StateEventCache[Character]:Fire(stateName, stateValue, oldValue)
	end
end

function Module.GetStateTemporary(Character : Instance, stateName : string) : any?
	-- stateName ..= '_TEMP'
	if not table.find(PossibleStateCache, stateName) then
		table.insert(PossibleStateCache, stateName)
	end
	return Character:GetAttribute(stateName)
end

function Module.SetStateTemporary(Character : Instance, stateName : string, duration : number, stateValue : any?)
	-- stateName ..= '_TEMP'
	if not table.find(PossibleStateCache, stateName) then
		table.insert(PossibleStateCache, stateName)
	end
	Module.SetState(Character, stateName, stateValue)

	NEXT_TEMP_ID += 1
	local id = NEXT_TEMP_ID
	if not TEMPORARY_UUIDS[Character] then
		TEMPORARY_UUIDS[Character] = {}
	end
	TEMPORARY_UUIDS[Character][stateName] = id

	task.delay(duration, function()
		-- Re-check the slot — if a newer SetStateTemporary call
		-- overwrote this state, it'll have a higher id and we
		-- bail without clearing.
		local store = TEMPORARY_UUIDS[Character]
		if store and store[stateName] == id then
			store[stateName] = nil
			Module.SetState(Character, stateName, nil)
		end
	end)
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/RemoteService"><![CDATA[
local RunService = game:GetService('RunService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local remoteContainerName = '_remotes'

local function GetOrCreateFolder(Parent)
	local Folder = Parent and Parent:FindFirstChild(remoteContainerName)
	if not Folder then
		Folder = Instance.new('Folder')
		Folder.Name = remoteContainerName
		Folder.Parent = Parent
	end
	return Folder
end

local function SearchForNameAndClass(Name, Class, Parent)
	for _, item in Parent:GetChildren() do
		if (item.Name == Name) and (item.ClassName == Class) then
			return item
		end
	end
	return nil
end

-- // Module // --
local Module = {}

if RunService:IsServer() then
	local clientRemoteFolder = GetOrCreateFolder(ReplicatedStorage)
	local serverRemoteFolder = GetOrCreateFolder(game:GetService('ServerStorage'))

	function Module.GetRemote(remoteName : string, remoteType : string, isClientBased : boolean?)
		local targetParent = (isClientBased and serverRemoteFolder or clientRemoteFolder)
		local remoteObject = SearchForNameAndClass(remoteName, remoteType, targetParent)
		if not remoteObject then
			remoteObject = Instance.new(remoteType)
			remoteObject.Name = remoteName
			remoteObject.Parent = targetParent
		end
		return remoteObject
	end
else
	local ClientRemotes = ReplicatedStorage:WaitForChild(remoteContainerName)

	function Module.GetRemote(remoteName : string, remoteType : string, isClientBased : boolean?)
		if isClientBased then
			local Remote = SearchForNameAndClass(remoteName, remoteType, ReplicatedStorage)
			if not Remote then
				Remote = Instance.new(remoteType)
				Remote.Name = remoteName
				Remote.Parent = ClientRemotes
			end
			return Remote
		else
			local Remote = nil
			local startTick = tick()
			while not Remote do
				if (tick() - startTick) > 6 then
					warn("Infinite Yield Waiting for Remote: ", remoteName, remoteType, RunService:IsClient() and "Client" or "Server")
				end
				Remote = SearchForNameAndClass(remoteName, remoteType, ClientRemotes)
				task.wait(0.1)
			end
			return Remote
		end
	end
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/CinematicShared"><![CDATA[-- Shared cinematic primitives: cue type definitions, action enum, and a few
-- pure helpers. Server walks a cinematic config and fires per-cue remotes;
-- client interprets each cue (camera move, shake, SFX, VFX, label) on the
-- local machine. Camera + visuals are inherently per-client, so the server
-- never spawns particles or moves cameras directly — it only schedules.

local Module = {}

----------------------------------------------------------------------
-- Action enum sent across the CinematicEvent RemoteEvent.
----------------------------------------------------------------------
Module.CinematicActions = {
	Begin    = 1,    -- (cinematicId, configBlob?) — locks input + HUD per config
	Cue      = 2,    -- (cueIndex, kind, args)
	End      = 3,    -- (cinematicId)              — unlocks input + restores HUD
	Skip     = 4,    -- client → server: request to skip
}

----------------------------------------------------------------------
-- Cue kinds — one shared enum so the client dispatcher and server
-- author both reference the same set of strings.
----------------------------------------------------------------------
Module.CueKind = {
	CameraTo      = 'CameraTo',      -- args = { Anchor='world'|'instance', Position?: CFrame, InstancePath?: string, Offset?: CFrame, Lerp: number }
	CameraTrack   = 'CameraTrack',   -- args = { InstancePath: string, OrbitRadius: number, OrbitSpeed: number, Pitch: number }
	CameraShake   = 'CameraShake',   -- args = { Magnitude: number, Roughness: number, Duration: number, FadeIn: number?, FadeOut: number? }
	CameraReset   = 'CameraReset',   -- args = {} — return to default Roblox-controlled camera
	PlaySFX       = 'PlaySFX',       -- args = { Sound: string|number, Position: Vector3?, Pitch: number? }
	PlayVFX       = 'PlayVFX',       -- args = { TemplateName: string, Anchor='world'|'instance', Position?: Vector3, InstancePath?: string, Duration: number? }
	ShowLabel     = 'ShowLabel',     -- args = { Title: string, Subtitle: string?, Anchor='top'|'bottom' }
	HideLabel     = 'HideLabel',     -- args = { Anchor='top'|'bottom'|'both' }
	StartDialogue = 'StartDialogue', -- args = { DialogueId: string, NPCInstancePath: string? }
	WaitFor       = 'WaitFor',       -- args = { Seconds: number } — pure timing marker, no visual effect
}

----------------------------------------------------------------------
-- Type exports.
----------------------------------------------------------------------
export type CueKindName = string

export type Cue = {
	At: number,        -- seconds from cinematic start
	Kind: CueKindName,
	Args: { [string]: any },
}

export type CinematicConfig = {
	Id: string,
	Duration: number,
	Cues: { Cue },
	LockMovement: boolean,
	LockHUD: boolean,
	-- A KeyCode constant value (e.g. Enum.KeyCode.Escape.Value) — passing the
	-- enum object across the remote boundary is not portable, so configs use
	-- the integer value and clients reconstruct the enum.
	SkipKeyCode: number?,
}

----------------------------------------------------------------------
-- Helpers used by both sides.
----------------------------------------------------------------------

-- Resolve a string instance path like "workspace.NPCs.Sigurd.HumanoidRootPart"
-- to the actual instance. Returns nil if any segment fails. Both server and
-- client need this — server validates references at config-load, client
-- looks up live world instances per cue.
function Module.ResolveInstancePath(path: string): Instance?
	if typeof(path) ~= 'string' or path == '' then return nil end
	local segments = string.split(path, '.')
	local node: Instance? = game
	for _, segment in segments do
		if not node then return nil end
		if segment == 'workspace' then
			node = workspace
		elseif segment == 'game' then
			node = game
		else
			node = node:FindFirstChild(segment)
		end
	end
	return node
end

-- Sort a cue list by `At` ascending. Configs are usually authored in order,
-- but a sort here lets authors mix sequences without ordering by hand.
function Module.SortCues(cues: { Cue }): { Cue }
	local copy = {}
	for i, c in cues do copy[i] = c end
	table.sort(copy, function(a, b) return a.At < b.At end)
	return copy
end

-- Reverse-lookup an EnumItem by its `.Value`. Roblox enums are
-- name-indexable only (`Enum.KeyCode.Escape` works, `Enum.KeyCode[27]`
-- errors), so any code that round-trips an enum across the wire as a
-- number has to scan the enum to reconstruct the EnumItem. Used by
-- CinematicClient to rebuild SkipKeyCode from the network-side number.
-- Returns nil when no item in the enum matches.
function Module.EnumItemFromValue(enum: Enum, value: number): EnumItem?
	for _, item in enum:GetEnumItems() do
		if item.Value == value then return item end
	end
	return nil
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/MountsShared"><![CDATA[-- Shared predicates and helpers for mounts. Used by both client (responsive
-- UI) and server (authoritative validation). Same pattern as CombatShared.

local ReplicatedStorage = game:GetService('ReplicatedStorage')

-- Dual-mode require: post config-replication migration, the
-- ReplicatedStorage Mounts module is an empty shell on the server
-- (it's the per-player CLIENT projection slot). Server-side callers
-- of MountsShared.CanEquipMount / GetMountConfig need the full
-- registry to validate equip / look up cfg.Stats — so the server
-- requires the canonical ServerStorage copy. Client keeps reading
-- the populated shell (which holds whatever the player has earned).
-- See ROADMAP.md §"Server reads the canonical copy."
local MountsConfig do
	local RunService = game:GetService('RunService')
	if RunService:IsServer() then
		local ServerStorage = game:GetService('ServerStorage')
		MountsConfig = require(ServerStorage:WaitForChild('Modules'):WaitForChild('Data'):WaitForChild('Mounts'))
	else
		MountsConfig = require(script.Parent.Parent:WaitForChild('Data'):WaitForChild('Mounts'))
	end
end
local CharacterStates = require(script.Parent:WaitForChild('CharacterStates'))

local Module = {}

----------------------------------------------------------------------
-- Action enum sent across MountEvent.
--
-- Equip vs mount semantics (split as of the multi-mount UX):
--   TryEquip / TryUnequip  -> set/clear data.Mounts.EquippedMount
--                             (the *active* mount slot — your "current pick").
--                             If currently riding, server hot-swaps the
--                             visual: dismount old, mount new (or fully
--                             dismount on Unequip).
--   TryMount / TryDismount -> start/stop *riding* the equipped mount.
--                             Riding state lives on the character via
--                             CharacterStates.Mounted; cleared on respawn.
----------------------------------------------------------------------
Module.MountActions = {
	-- Client → Server intents.
	TryEquip    = 1,    -- (mountId) — set active mount slot
	TryUnequip  = 4,    -- ()        — clear active mount slot (auto-dismounts)
	TryMount    = 3,    -- ()        — start riding the equipped mount
	TryDismount = 2,    -- ()        — stop riding (preserves equipped slot)
	-- Server → Client cues.
	Spawn      = 10,   -- (mountId)
	Despawn    = 11,   -- (reason: 'manual'|'damage'|'death'|'zone'|'replace')
	Mounted    = 12,   -- (mountId) — visual confirmation; client may switch camera
	Unmounted  = 13,   -- ()
}

----------------------------------------------------------------------
-- Save struct shape (read-only on client via ReplicatedData).
-- {
--   Mounts = {
--     OwnedMounts = { [mountId] = { UnlockedAt = number } },
--     EquippedMount = mountId | nil,
--   }
-- }
----------------------------------------------------------------------

function Module.GetMountConfig(mountId: string): MountsConfig.MountConfig?
	return MountsConfig.Mounts[mountId]
end

function Module.GetOwnedMounts(saveData: any): { [string]: any }
	if typeof(saveData) ~= 'table' then return {} end
	local m = saveData.Mounts
	if typeof(m) ~= 'table' then return {} end
	return m.OwnedMounts or {}
end

function Module.IsMountOwned(saveData: any, mountId: string): boolean
	local owned = Module.GetOwnedMounts(saveData)
	return owned[mountId] ~= nil
end

function Module.GetEquippedMountId(saveData: any): string?
	if typeof(saveData) ~= 'table' then return nil end
	local m = saveData.Mounts
	if typeof(m) ~= 'table' then return nil end
	return m.EquippedMount
end

-- Last-equipped mount that survived the most recent respawn. Used by the
-- G keybind to re-summon "your mount" without opening the Mounts tab. Nil
-- until the player has equipped one at least once.
function Module.GetPreferredMountId(saveData: any): string?
	if typeof(saveData) ~= 'table' then return nil end
	local m = saveData.Mounts
	if typeof(m) ~= 'table' then return nil end
	return m.PreferredMount
end

----------------------------------------------------------------------
-- Predicates. Both sides call CanEquipMount before issuing the remote
-- so a malformed/illegal request never reaches the server.
----------------------------------------------------------------------
function Module.CanEquipMount(character: Instance, saveData: any, mountId: string): (boolean, string)
	if not character or not character.Parent then
		return false, 'Character is not in the world.'
	end
	if not Module.IsMountOwned(saveData, mountId) then
		return false, 'Mount is not owned.'
	end
	local cfg = Module.GetMountConfig(mountId)
	if not cfg then return false, 'Unknown mount id.' end
	-- Block equip while in critical character states.
	if CharacterStates.GetState(character, 'Stunned') then
		return false, 'Cannot mount while stunned.'
	end
	if CharacterStates.GetState(character, 'Blocking') then
		return false, 'Cannot mount while blocking.'
	end
	if CharacterStates.GetStateTemporary(character, 'Attacking') then
		return false, 'Cannot mount while attacking.'
	end
	return true, ''
end

function Module.IsMounted(character: Instance): boolean
	if not character then return false end
	return character:GetAttribute('Mounted') == true
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/CompanionsShared"><![CDATA[-- Shared companion helpers + action enum. Used by client (UI + renderer)
-- and server (auth + bonuses). Same idiomatic shape as MountsShared /
-- CombatShared.

-- Dual-mode require: post config-replication migration, the
-- ReplicatedStorage Companions module is an empty shell on the server
-- (it's the per-player CLIENT projection slot). Server-side callers
-- of CompanionsShared.GetActiveBonuses / GetConfig need the full
-- registry to walk Benefits / look up cfg.MaxLevel — so the server
-- requires the canonical ServerStorage copy. Client keeps reading
-- the populated shell (which holds whatever the player has earned).
-- See ROADMAP.md §"Server reads the canonical copy."
local CompanionsConfig do
	local RunService = game:GetService('RunService')
	if RunService:IsServer() then
		local ServerStorage = game:GetService('ServerStorage')
		CompanionsConfig = require(ServerStorage:WaitForChild('Modules'):WaitForChild('Data'):WaitForChild('Companions'))
	else
		CompanionsConfig = require(script.Parent.Parent:WaitForChild('Data'):WaitForChild('Companions'))
	end
end
local PremiumConfig    = require(script.Parent.Parent:WaitForChild('Data'):WaitForChild('PremiumConfig'))

local Module = {}

Module.CompanionActions = {
	-- Client → Server intents.
	TryEquip        = 1,    -- (companionId)
	TryUnequip      = 2,    -- ()
	UseCandy        = 3,    -- (candyItemId)  — applies to currently equipped companion
	SetMovementMode = 4,    -- (companionId, mode: 'float' | 'walk')
	-- Server → Client cues.
	Spawn           = 10,   -- (player, companionId)
	Despawn         = 11,   -- (player)
	LevelUp         = 12,   -- (companionId, newLevel)
	-- Pod-style auto-attack pulse — see NIER_COMBAT.md.
	-- Args: (player, targetModel, damage). The CompanionsClient renders
	-- a small hitscan beam from the floating companion to the target.
	PodShot         = 13,
	-- Movement-mode change cue. Args: (player, companionId, mode).
	-- Drives the client renderer to swap between hover-orbit and
	-- ground-walk without a full despawn/respawn.
	MovementChanged = 14,
}

----------------------------------------------------------------------
-- Save struct shape (NEW — slot-based, mirrors AurasShared):
--   data.Companions = {
--     Owned = {
--       [companionId] = { Level = n, XP = n, Bond = n, UnlockedAt = n },
--     },
--     Equipped = { companionId, companionId, ... },   -- ARRAY of slots
--   }
--
-- Legacy shape (single string id):
--   Equipped = companionId | nil
--   ↑ migrated to the array form by MigrateEquippedShape on first read.
----------------------------------------------------------------------

----------------------------------------------------------------------
-- Migration. Called by both server and client on first read so a
-- save with the legacy single-id Equipped gets normalized to an array.
-- Idempotent — re-running on an already-array equipped value no-ops.
----------------------------------------------------------------------
function Module.MigrateEquippedShape(saveData: any)
	if typeof(saveData) ~= 'table' then return end
	if typeof(saveData.Companions) ~= 'table' then
		saveData.Companions = { Owned = {}, Equipped = {} }
		return
	end
	if typeof(saveData.Companions.Owned) ~= 'table' then
		saveData.Companions.Owned = {}
	end
	local eq = saveData.Companions.Equipped
	if eq == nil then
		saveData.Companions.Equipped = {}
		return
	end
	if typeof(eq) == 'string' and eq ~= '' then
		-- Legacy single-id form — wrap in an array.
		saveData.Companions.Equipped = { eq }
		return
	end
	if typeof(eq) ~= 'table' then
		-- Anything else (bool / number from a corrupt save) — reset.
		saveData.Companions.Equipped = {}
		return
	end
	-- Already an array? Sniff the first key. Empty {} is acceptable as is.
	local sniff = next(eq)
	if sniff == nil or typeof(sniff) == 'number' then return end
	-- Dict-shaped (unknown legacy variant) — flatten into an array.
	local migrated: { string } = {}
	for _, v in eq do
		if typeof(v) == 'string' and v ~= '' then
			migrated[#migrated + 1] = v
		end
	end
	saveData.Companions.Equipped = migrated
end

function Module.GetConfig(companionId: string)
	return CompanionsConfig.Companions[companionId]
end

function Module.GetOwned(saveData: any): { [string]: any }
	if typeof(saveData) ~= 'table' then return {} end
	if typeof(saveData.Companions) ~= 'table' then return {} end
	return saveData.Companions.Owned or {}
end

-- Return the slot array (post-migration). Mutators must call this
-- through, NOT touch any legacy shape directly.
function Module.GetEquippedSlots(saveData: any): { string }
	if typeof(saveData) ~= 'table' then return {} end
	if typeof(saveData.Companions) ~= 'table' then return {} end
	-- Defensive: idempotent migration in case the caller hasn't run it.
	Module.MigrateEquippedShape(saveData)
	if typeof(saveData.Companions.Equipped) ~= 'table' then return {} end
	return saveData.Companions.Equipped
end

-- Back-compat: returns the FIRST equipped companion (or nil). Existing
-- single-equip call sites (XP feed, candy fallback, pod auto-attack
-- single-pulse) keep working without per-call refactors. New code
-- should iterate GetEquippedSlots.
function Module.GetEquippedId(saveData: any): string?
	local slots = Module.GetEquippedSlots(saveData)
	return slots[1]
end

function Module.IsCompanionEquipped(saveData: any, companionId: string): boolean
	for _, id in Module.GetEquippedSlots(saveData) do
		if id == companionId then return true end
	end
	return false
end

function Module.IsOwned(saveData: any, companionId: string): boolean
	return Module.GetOwned(saveData)[companionId] ~= nil
end

----------------------------------------------------------------------
-- Slot accounting. Cap is gamepass-gated (CompanionSlotsPass) and
-- mirrors the AurasShared.GetMaxSlotsFromSave pattern — server
-- callers prefer SystemsContainer.PremiumServer.GetMaxCompanionSlots
-- directly; client widgets read from PlayerData.Premium via the
-- helper below. The legacy `data.Companions.MaxEquipped` field is
-- still honored as a hard override (set by Cmdr commands for testing
-- or by a future shop benefit) — when present and numeric, it wins
-- over the gamepass-derived cap.
----------------------------------------------------------------------
function Module.GetMaxSlotsFromSave(saveData: any): number
	-- Cmdr override path #1: hard-set absolute cap. Wins over everything,
	-- including the +bonus and the gamepass cap.
	if typeof(saveData) == 'table' and typeof(saveData.Companions) == 'table' then
		local n = saveData.Companions.MaxEquipped
		if typeof(n) == 'number' and n > 0 then return n end
	end
	local hasPass = false
	local bonus = 0
	if typeof(saveData) == 'table' then
		if typeof(saveData.Premium) == 'table' then
			hasPass = saveData.Premium.CompanionSlotsPass == true
		end
		-- Cmdr override path #2: per-player additive bonus. Stacks on
		-- the gamepass-derived base cap so a 3-slot default + bonus 2
		-- yields 5 slots. Stored under Companions.BonusEquipped via
		-- the SetExtraMaxCompanionEquips Cmdr command.
		if typeof(saveData.Companions) == 'table' then
			local b = saveData.Companions.BonusEquipped
			if typeof(b) == 'number' and b > 0 then bonus = b end
		end
	end
	return PremiumConfig.GetMaxCompanionSlots(hasPass) + bonus
end

-- Legacy alias — kept for the existing CompanionsTab eyebrow which
-- already calls Module.GetMaxEquipped(data). Routes through the new
-- gamepass-aware resolver.
function Module.GetMaxEquipped(saveData: any): number
	return Module.GetMaxSlotsFromSave(saveData)
end

function Module.GetEquippedCount(saveData: any): number
	return #Module.GetEquippedSlots(saveData)
end

----------------------------------------------------------------------
-- Movement mode lookup. Save shape:
--   data.Companions.MovementModes = { [companionId] = 'float' | 'walk' }
-- Per-companion override; falls through to cfg.MovementMode default
-- when unset. Renders + UI both call this.
----------------------------------------------------------------------
function Module.GetMovementMode(saveData: any, companionId: string): string
	local cfg = CompanionsConfig.Companions[companionId]
	local default = (cfg and cfg.MovementMode) or 'float'
	if typeof(saveData) ~= 'table' then return default end
	if typeof(saveData.Companions) ~= 'table' then return default end
	local modes = saveData.Companions.MovementModes
	if typeof(modes) ~= 'table' then return default end
	local override = modes[companionId]
	if override == 'float' or override == 'walk' then return override end
	return default
end

-- Whether the player is allowed to flip the movement mode on this
-- companion. Drives the dropdown's visibility in CompanionsTab.
function Module.CanToggleMovementMode(companionId: string): boolean
	local cfg = CompanionsConfig.Companions[companionId]
	return cfg ~= nil and cfg.AllowWalkAndFloatBypass == true
end

----------------------------------------------------------------------
-- Compute the active bonus list across EVERY equipped companion.
-- Numeric bonuses sum across slots so dual-companion loadouts are
-- additive (two +5% XP companions stack to +10%); string bonuses
-- last-write-wins, matching the prior single-slot semantics for any
-- non-stacking benefit that uses string values (mostly status flags).
----------------------------------------------------------------------
function Module.GetActiveBonuses(saveData: any): { [string]: number | string }
	local bonuses = {}
	local owned = Module.GetOwned(saveData)
	for _, id in Module.GetEquippedSlots(saveData) do
		local cfg = CompanionsConfig.Companions[id]
		local entry = owned[id]
		if cfg and entry then
			local level = (typeof(entry.Level) == 'number') and entry.Level or 1
			for _, benefit in cfg.Benefits do
				if level >= benefit.AtLevel then
					if typeof(benefit.Bonus) == 'number' then
						bonuses[benefit.Stat] = (bonuses[benefit.Stat] or 0) + benefit.Bonus
					else
						bonuses[benefit.Stat] = benefit.Bonus
					end
				end
			end
		end
	end
	return bonuses
end

----------------------------------------------------------------------
-- XP curve helper.
----------------------------------------------------------------------
function Module.XPToNextLevel(companionId: string, currentLevel: number): number
	local cfg = CompanionsConfig.Companions[companionId]
	if not cfg or not cfg.XPCurve then return 0 end
	if currentLevel >= cfg.MaxLevel then return 0 end
	return cfg.XPCurve(currentLevel)
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/CraftingShared"><![CDATA[-- Shared crafting predicates. Both client (UI enable/disable, reagent
-- have/need rendering) and server (auth + mutation) call these so the
-- "looks craftable" and "is craftable" decisions never drift.

local CraftingConfig = require(script.Parent.Parent:WaitForChild('Data'):WaitForChild('Crafting'))

local Module = {}

Module.CraftingActions = {
	Craft = 1,           -- (recipeId, quantity)
}

----------------------------------------------------------------------
-- Save struct shape:
--   data.Crafting = {
--     ArtisanLevels = { [school] = { Level = n, XP = n } },
--     UnlockedRecipes = { [recipeId] = true },
--     InProgressCrafts = { [uuid] = { recipeId, startedAt, finishesAt, quantity } },
--   }
----------------------------------------------------------------------

local function getCrafting(saveData: any): any
	if typeof(saveData) ~= 'table' then return nil end
	return saveData.Crafting
end

----------------------------------------------------------------------
-- Read accessors.
----------------------------------------------------------------------
function Module.GetSchool(schoolId: string)
	return CraftingConfig.Schools[schoolId]
end

function Module.GetRecipe(recipeId: string)
	return CraftingConfig.Recipes[recipeId]
end

function Module.GetArtisanLevel(saveData: any, schoolId: string): number
	local crafting = getCrafting(saveData); if not crafting then return 1 end
	local entry = crafting.ArtisanLevels and crafting.ArtisanLevels[schoolId]
	return (entry and entry.Level) or 1
end

function Module.GetArtisanXP(saveData: any, schoolId: string): number
	local crafting = getCrafting(saveData); if not crafting then return 0 end
	local entry = crafting.ArtisanLevels and crafting.ArtisanLevels[schoolId]
	return (entry and entry.XP) or 0
end

function Module.GetArtisanRank(level: number)
	return CraftingConfig.GetArtisanRank(level)
end

function Module.GetXPToNextLevel(schoolId: string, level: number): number
	local school = CraftingConfig.Schools[schoolId]
	if not school then return 0 end
	if level >= school.MaxLevel then return 0 end
	return school.XPCurve(level)
end

-- Strict whitelist: recipes are HIDDEN by default and only appear after
-- the player explicitly unlocks them (via quest, discovery, drop, or
-- the AutoUnlock seeding done on join for starter recipes). The
-- CraftingTab filters its list through this predicate so a player
-- only ever sees recipes they actually own.
function Module.IsRecipeUnlocked(saveData: any, recipeId: string): boolean
	local crafting = getCrafting(saveData); if not crafting then return false end
	local list = crafting.UnlockedRecipes
	if typeof(list) ~= 'table' then return false end
	return list[recipeId] == true
end

-- Returns the player's full unlocked-recipe map (keyed by recipeId →
-- true). Empty table when nothing is unlocked yet. Read-only; mutate
-- via the server-side UnlockRecipe path so the save struct gets
-- replicated correctly.
function Module.GetUnlockedRecipes(saveData: any): { [string]: true }
	local crafting = getCrafting(saveData); if not crafting then return {} end
	local list = crafting.UnlockedRecipes
	if typeof(list) ~= 'table' then return {} end
	return list
end

----------------------------------------------------------------------
-- Inventory introspection — reads quantities directly off the player's
-- save struct without going through a server-only inventory module.
----------------------------------------------------------------------
function Module.GetItemQuantityInInventory(saveData: any, itemId: string): number
	if typeof(saveData) ~= 'table' then return 0 end
	local inv = saveData.Inventory
	if typeof(inv) ~= 'table' then return 0 end
	local bucket = inv[itemId]
	if typeof(bucket) ~= 'table' then return 0 end
	local total = 0
	for _, slot in bucket do
		total += (typeof(slot) == 'table' and (slot.Quantity or 1)) or 1
	end
	return total
end

----------------------------------------------------------------------
-- The two predicates the UI + server share.
----------------------------------------------------------------------
function Module.GetReagentSatisfaction(saveData: any, recipeId: string)
	local recipe = CraftingConfig.Recipes[recipeId]
	if not recipe then return {} end
	local out = {}
	for _, reagent in recipe.Reagents do
		out[reagent.ItemId] = {
			have = Module.GetItemQuantityInInventory(saveData, reagent.ItemId),
			need = reagent.Quantity,
		}
	end
	return out
end

----------------------------------------------------------------------
-- Recipe cooldown lookup. The ledger lives on the save under
-- `data.Crafting.RecipeCooldowns[recipeId] = nextAllowedAt` (seconds
-- since epoch via workspace:GetServerTimeNow() — same clock the
-- in-progress crafts use). Reading from the save means cooldowns
-- survive disconnects without a separate persistence layer.
----------------------------------------------------------------------
function Module.GetRecipeCooldownRemaining(saveData: any, recipeId: string): number
	local crafting = getCrafting(saveData); if not crafting then return 0 end
	local ledger = crafting.RecipeCooldowns
	if typeof(ledger) ~= 'table' then return 0 end
	local nextAt = ledger[recipeId]
	if typeof(nextAt) ~= 'number' then return 0 end
	local now = workspace:GetServerTimeNow()
	return math.max(0, nextAt - now)
end

function Module.IsRecipeOnCooldown(saveData: any, recipeId: string): boolean
	return Module.GetRecipeCooldownRemaining(saveData, recipeId) > 0
end

function Module.CanCraft(saveData: any, recipeId: string, quantity: number?, options: any?): (boolean, string)
	local recipe = CraftingConfig.Recipes[recipeId]
	if not recipe then return false, 'Unknown recipe.' end
	if not Module.IsRecipeUnlocked(saveData, recipeId) then
		return false, 'Recipe not unlocked.'
	end
	local school = CraftingConfig.Schools[recipe.School]
	if not school then return false, 'Unknown school.' end
	local level = Module.GetArtisanLevel(saveData, recipe.School)
	if level < recipe.RequiredLevel then
		return false, string.format('Requires %s level %d.',
			school.Display.Name, recipe.RequiredLevel)
	end
	-- Cooldown gate.
	local remaining = Module.GetRecipeCooldownRemaining(saveData, recipeId)
	if remaining > 0 then
		return false, string.format('Cooldown: %ds.', math.ceil(remaining))
	end
	-- Workstation gate. Caller passes the player's currently-near
	-- workstation kind via `options.NearWorkstation`. Server resolves
	-- this from a tag-radius check; client UI passes its
	-- last-opened-workstation pin so the bar greys out for off-station
	-- recipes. Recipes with `Workstation = nil` craft anywhere.
	if recipe.Workstation then
		local near = options and options.NearWorkstation
		if near ~= recipe.Workstation then
			return false, string.format('Requires %s workstation.', recipe.Workstation)
		end
	end
	-- Substation gate. Secondary ambient zone (Kiln / BrewingBarrel /
	-- MortarPestle / etc.) the player must additionally be standing
	-- inside. `options.NearSubstations` is a string-keyed set populated
	-- by CraftingServer from SubstationServer.GetActiveSubstationKinds.
	-- Recipes with `RequiredSubstation = nil` skip this check.
	if recipe.RequiredSubstation then
		local near = options and options.NearSubstations
		if typeof(near) ~= 'table' or not near[recipe.RequiredSubstation] then
			return false, string.format('Requires %s nearby.', recipe.RequiredSubstation)
		end
	end
	local q = quantity or 1
	for _, reagent in recipe.Reagents do
		local have = Module.GetItemQuantityInInventory(saveData, reagent.ItemId)
		if have < reagent.Quantity * q then
			return false, string.format('Not enough %s.', reagent.ItemId)
		end
	end
	return true, ''
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/AurasShared"><![CDATA[-- Shared aura helpers + action enum.
--
-- Save-struct shape (NEW — slot-based):
--   data.Auras = {
--     Owned    = { [auraId] = { UnlockedAt } },
--     Equipped = { auraId, auraId, ... },          -- ARRAY of slots
--   }
--
-- Legacy shape (anchor-keyed):
--   Equipped = { character = ?, sword = ?, mount = ? }
--   ↑ migrated to the array form by MigrateEquippedShape on first read.
--
-- Slot count is gamepass-gated. Server resolves via PremiumServer +
-- PremiumConfig; client reads through the replicated PlayerData.Premium
-- struct so the UI doesn't round-trip per render.

local AurasConfig    = require(script.Parent.Parent:WaitForChild('Data'):WaitForChild('Auras'))
local PremiumConfig  = require(script.Parent.Parent:WaitForChild('Data'):WaitForChild('PremiumConfig'))

local Module = {}

Module.AuraActions = {
	-- Client → Server
	TryEquip   = 1,    -- (auraId)
	TryUnequip = 2,    -- (auraId)
	-- Server → Client
	Spawn      = 10,   -- (player, auraId)
	Despawn    = 11,   -- (player, auraId)
	-- Server → Client when slot configuration changes (gamepass purchase
	-- flips MaxSlots; client-side count badges re-read from PlayerData).
	SlotsChanged = 12, -- (player, currentCount, maxCount)
}

----------------------------------------------------------------------
-- Migration. Called by both server and client on first read so a
-- save with the legacy { character = ?, sword = ?, mount = ? } shape
-- gets normalized to an array. Idempotent — re-running on an
-- already-array equipped value is a no-op.
----------------------------------------------------------------------
function Module.MigrateEquippedShape(saveData: any)
	if typeof(saveData) ~= 'table' then return end
	if typeof(saveData.Auras) ~= 'table' then
		saveData.Auras = { Owned = {}, Equipped = {} }
		return
	end
	if typeof(saveData.Auras.Owned) ~= 'table' then saveData.Auras.Owned = {} end
	local eq = saveData.Auras.Equipped
	-- Already an array? Sequence integers 1..N. Tolerate empty {}.
	if typeof(eq) ~= 'table' then
		saveData.Auras.Equipped = {}
		return
	end
	-- Detect array vs dict by sniffing keys. Arrays have integer keys
	-- starting at 1; the legacy shape uses 'character' / 'sword' /
	-- 'mount' string keys.
	local sniff = next(eq)
	if sniff == nil then
		-- Empty table — already valid as either shape.
		return
	end
	if typeof(sniff) == 'number' then
		-- Already array-shaped.
		return
	end
	-- Legacy dict shape — migrate. Walk in a stable order (character →
	-- sword → mount) so the resulting slot order matches what the
	-- player likely expected from the legacy UI.
	local migrated: { string } = {}
	for _, anchor in { 'character', 'sword', 'mount' } do
		local v = eq[anchor]
		if typeof(v) == 'string' and v ~= '' then
			migrated[#migrated + 1] = v
		end
	end
	saveData.Auras.Equipped = migrated
end

----------------------------------------------------------------------
-- Pure accessors.
----------------------------------------------------------------------
function Module.GetConfig(auraId: string)
	return AurasConfig.Auras[auraId]
end

function Module.GetOwned(saveData: any): { [string]: any }
	if typeof(saveData) ~= 'table' then return {} end
	if typeof(saveData.Auras) ~= 'table' then return {} end
	return saveData.Auras.Owned or {}
end

-- Returns the slot array (post-migration). Mutators must call this
-- through, NOT touch the dict shape directly.
function Module.GetEquippedSlots(saveData: any): { string }
	if typeof(saveData) ~= 'table' then return {} end
	if typeof(saveData.Auras) ~= 'table' then return {} end
	if typeof(saveData.Auras.Equipped) ~= 'table' then return {} end
	-- Defensive: if the legacy shape is still present, migrate
	-- on-read so callers always see the array form.
	Module.MigrateEquippedShape(saveData)
	return saveData.Auras.Equipped
end

function Module.GetEquippedCount(saveData: any): number
	return #Module.GetEquippedSlots(saveData)
end

function Module.IsAuraEquipped(saveData: any, auraId: string): boolean
	for _, id in Module.GetEquippedSlots(saveData) do
		if id == auraId then return true end
	end
	return false
end

-- Back-compat for the existing AurasTab (which is single-aura-per-anchor
-- aware). Returns the FIRST equipped aura whose cfg.Anchor matches —
-- with multi-equip the answer isn't unique any more, but the picker
-- only needs "something is equipped on this anchor" to render its
-- highlight state. Future multi-anchor UI should iterate
-- GetEquippedSlots directly and stop calling this.
function Module.GetEquippedForAnchor(saveData: any, anchor: string): string?
	for _, id in Module.GetEquippedSlots(saveData) do
		local cfg = AurasConfig.Auras[id]
		if cfg and cfg.Anchor == anchor then return id end
	end
	return nil
end

function Module.IsOwned(saveData: any, auraId: string): boolean
	return Module.GetOwned(saveData)[auraId] ~= nil
end

----------------------------------------------------------------------
-- Slot cap helpers. The SERVER resolves via PremiumServer (network);
-- the CLIENT reads from PlayerData.Premium (replicated). Both end up
-- calling PremiumConfig.GetMaxAuraSlots with a boolean.
----------------------------------------------------------------------
function Module.GetMaxSlotsFromSave(saveData: any): number
	local hasPass = false
	if typeof(saveData) == 'table' and typeof(saveData.Premium) == 'table' then
		hasPass = saveData.Premium.AuraSlotsPass == true
	end
	return PremiumConfig.GetMaxAuraSlots(hasPass)
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/SkillsShared"><![CDATA[-- Shared skill predicates + action enum. Mirrors CombatShared. Both
-- sides use these so the client's "predict-then-fire" path and the
-- server's "validate-then-mutate" path agree on what's legal.

local SkillsConfig = require(script.Parent.Parent:WaitForChild('Data'):WaitForChild('Skills'))
local CharacterStates = require(script.Parent:WaitForChild('CharacterStates'))

local Module = {}

----------------------------------------------------------------------
-- Action enum sent across SkillEvent.
----------------------------------------------------------------------
Module.SkillActions = {
	-- Client → Server.
	TryUnlockSkill = 0, -- (skillId) — used by SkillsTab unlock button
	TryUseSkill    = 1, -- (skillId)
	-- Server → Client.
	CastBegin   = 10,   -- (player, skillId, totalDuration)
	CastHit     = 11,   -- (player, skillId, hitIndex, hitPositions: {Vector3})
	CastEnd     = 12,   -- (player, skillId)
}

----------------------------------------------------------------------
-- Save struct shape:
--   data.Skills = {
--     UnlockedSkills = { [skillId] = { UnlockedAt = number } },
--     SkillCooldowns = { [skillId] = endsAt: number (workspace:GetServerTimeNow()) },
--   }
----------------------------------------------------------------------

function Module.GetConfig(skillId: string)
	return SkillsConfig.Skills[skillId]
end

function Module.GetUnlockedSkills(saveData: any): { [string]: any }
	if typeof(saveData) ~= 'table' then return {} end
	if typeof(saveData.Skills) ~= 'table' then return {} end
	return saveData.Skills.UnlockedSkills or {}
end

function Module.IsSkillUnlocked(saveData: any, skillId: string): boolean
	return Module.GetUnlockedSkills(saveData)[skillId] ~= nil
end

----------------------------------------------------------------------
-- Passive skill helpers. A passive skill carries `Passive = true` +
-- `MaxLevel` + `PerLevelEffect` on the cfg. Saves the level inside the
-- UnlockedSkills entry as `{Level = N, UnlockedAt = time}`; legacy
-- entries (no Level field) are treated as Level 1 — first unlock sets
-- Level=1 explicitly going forward.
----------------------------------------------------------------------
function Module.IsPassiveSkill(skillId: string): boolean
	local cfg = SkillsConfig.Skills[skillId]
	return cfg ~= nil and cfg.Passive == true
end

-- Current level of a (passive) skill in the player's save. Returns 0
-- when the skill isn't unlocked, 1 when unlocked but the entry has no
-- Level field (legacy), or the stored Level value.
function Module.GetSkillLevel(saveData: any, skillId: string): number
	local entry = Module.GetUnlockedSkills(saveData)[skillId]
	if not entry then return 0 end
	if typeof(entry) == 'table' and typeof(entry.Level) == 'number' then
		return entry.Level
	end
	return 1
end

----------------------------------------------------------------------
-- Unlock requirements (for the Skill Tree UI lock state + detail panel).
-- Mirrors the gate order SkillsServer.AttemptUnlockSkill enforces
-- (prereqs → character level → attributes) so the client's fade / "locked"
-- visuals and the listed requirements always agree with what the server
-- will actually allow. SkillPoints are intentionally NOT a requirement
-- here — being out of points means "can't afford yet", not "locked".
----------------------------------------------------------------------
export type SkillRequirement = {
	Kind  : 'prereq' | 'level' | 'attribute',
	Label : string,    -- player-facing ('Great Slash', 'Level 3', 'Strength 3')
	Met   : boolean,
}

function Module.GetUnlockRequirements(saveData: any, skillId: string): { SkillRequirement }
	local cfg = SkillsConfig.Skills[skillId]
	if not cfg then return {} end
	local reqs: { SkillRequirement } = {}

	-- Prerequisite skills.
	for _, prereqId in cfg.Prereqs or {} do
		local pcfg = SkillsConfig.Skills[prereqId]
		reqs[#reqs + 1] = {
			Kind  = 'prereq',
			Label = (pcfg and pcfg.Display and pcfg.Display.Name) or prereqId,
			Met   = Module.IsSkillUnlocked(saveData, prereqId),
		}
	end

	-- Character level (only surfaced when the gate is above 1).
	local needLevel = tonumber(cfg.RequiredLevel) or 1
	if needLevel > 1 then
		local have = (typeof(saveData) == 'table' and tonumber(saveData.Level)) or 1
		reqs[#reqs + 1] = {
			Kind = 'level', Label = string.format('Level %d', needLevel), Met = have >= needLevel,
		}
	end

	-- Attribute investment (used to gate ULTs / finishers).
	if typeof(cfg.RequiredAttributes) == 'table' then
		for attrName, minLevel in cfg.RequiredAttributes do
			local entry = (typeof(saveData) == 'table' and typeof(saveData.Attributes) == 'table')
				and saveData.Attributes[attrName] or nil
			local have = (typeof(entry) == 'table' and tonumber(entry.Level)) or 0
			reqs[#reqs + 1] = {
				Kind  = 'attribute',
				Label = string.format('%s %d', tostring(attrName), minLevel),
				Met   = have >= (tonumber(minLevel) or 0),
			}
		end
	end

	return reqs
end

-- True when every unlock requirement (prereqs, level, attributes) is met —
-- i.e. the only thing between the player and the skill is a SkillPoint/click.
-- The Skill Tree fades nodes that are NOT eligible (a real gate is unmet)
-- distinctly from eligible-but-unpurchased ones.
function Module.IsEligibleToUnlock(saveData: any, skillId: string): boolean
	for _, r in Module.GetUnlockRequirements(saveData, skillId) do
		if not r.Met then return false end
	end
	return true
end

-- Sum of all passive bonuses for a stat. `statId` is a value from
-- SkillsConfig.StatNameEnum (e.g. SkillsConfig.StatNameEnum.Attack).
-- Returns separate totals for the two principal Kinds so consumers
-- can apply each correctly:
--   percent → multiplicative (e.g. damage * (1 + percent))
--   value   → flat additive   (e.g. damage + value)
-- Compute-kind effects evaluate their custom function (level→
-- (percent, value)) and fold both contributions into the totals.
-- A passive with multiple PerLevelEffects contributes to ALL stat
-- ids it lists; iterating the array stays cheap because each skill's
-- effect list is short (typically 1-2 entries).
export type PassiveBonus = { percent: number, value: number }

function Module.GetPassiveBonus(saveData: any, statId: number): PassiveBonus
	local out: PassiveBonus = { percent = 0, value = 0 }
	local KindEnum = SkillsConfig.StatEffectKindEnum
	for skillId, _entry in Module.GetUnlockedSkills(saveData) do
		local cfg = SkillsConfig.Skills[skillId]
		if not cfg or not cfg.Passive or not cfg.PerLevelEffects then continue end
		local level = Module.GetSkillLevel(saveData, skillId)
		if level <= 0 then continue end
		for _, effect in cfg.PerLevelEffects do
			if effect.Stat ~= statId then continue end
			if effect.Kind == KindEnum.Value then
				out.value = out.value + (effect.Bonus or 0) * level
			elseif effect.Kind == KindEnum.Compute then
				if typeof(effect.Compute) == 'function' then
					local ok, p, v = pcall(effect.Compute, level)
					if ok then
						out.percent = out.percent + (p or 0)
						out.value   = out.value   + (v or 0)
					end
				end
			else
				-- Default + Percent both fold into percent total.
				-- Catches missing/unknown Kind values rather than
				-- silently dropping the bonus.
				out.percent = out.percent + (effect.Bonus or 0) * level
			end
		end
	end
	return out
end

-- Convenience wrapper: total damage scalar. Combines percent + value
-- in one call so the common `damage = damage * (1 + percent) + value`
-- pattern doesn't repeat at every consumer.
function Module.ApplyPassiveBonusToDamage(saveData: any, statId: number, damage: number): number
	local b = Module.GetPassiveBonus(saveData, statId)
	return damage * (1 + b.percent) + b.value
end

----------------------------------------------------------------------
-- Cooldowns. Stored as absolute workspace:GetServerTimeNow() timestamps
-- on a character attribute (per-skill) so client UI and server auth use
-- the same clock, just like the block cooldown does.
----------------------------------------------------------------------
local function attrName(skillId: string): string
	return 'SkillCD_' .. skillId
end

function Module.StartSkillCooldown(character: Instance, skillId: string)
	local cfg = SkillsConfig.Skills[skillId]
	if not cfg or cfg.Cooldown <= 0 then return end
	character:SetAttribute(attrName(skillId), workspace:GetServerTimeNow() + cfg.Cooldown)
end

function Module.GetSkillCooldownRemaining(character: Instance, skillId: string): number
	local untilTime = character:GetAttribute(attrName(skillId))
	if typeof(untilTime) ~= 'number' then return 0 end
	local remaining = untilTime - workspace:GetServerTimeNow()
	return remaining > 0 and remaining or 0
end

function Module.IsSkillOnCooldown(character: Instance, skillId: string): boolean
	return Module.GetSkillCooldownRemaining(character, skillId) > 0
end

----------------------------------------------------------------------
-- IsCharacterUsingSkill: a temporary CharacterState set by SkillsServer
-- around the entire windup→active→recovery window. Other systems
-- (CombatShared, MountsShared) consult this to gate concurrent attacks
-- / blocks / weapon toggles / mount equip.
----------------------------------------------------------------------
function Module.IsCharacterUsingSkill(character: Instance): boolean
	if not character then return false end
	return CharacterStates.GetStateTemporary(character, 'UsingSkill') ~= nil
end

----------------------------------------------------------------------
-- State-only predicate. Splits the unlock/save check out of CanUseSkill
-- so NPCs (which don't have a save struct) can use the same gates.
-- Players + NPCs share this — only the unlock/save-data layer differs.
----------------------------------------------------------------------
function Module.CanCharacterCastSkill(character: Instance, skillId: string): (boolean, string)
	local cfg = SkillsConfig.Skills[skillId]
	if not cfg then return false, 'Unknown skill.' end
	-- Passive skills aren't castable — bonus-only. Refuse loudly so
	-- a stale hotbar binding or cheat attempt can't trigger an empty cast.
	if cfg.Passive then return false, 'Passive skills cannot be cast.' end
	if not character or not character.Parent then return false, 'Character missing.' end
	-- Cooldown is per-character (attribute-based) so it applies to NPCs too.
	if Module.IsSkillOnCooldown(character, skillId) then
		return false, 'Skill on cooldown.'
	end
	-- State gates.
	if CharacterStates.GetState(character, 'KnockedDown') then return false, 'Knocked down.' end
	if CharacterStates.GetStateTemporary(character, 'Stunned') then return false, 'Stunned.' end
	if CharacterStates.GetStateTemporary(character, 'Dashing') then return false, 'Dashing.' end
	if CharacterStates.GetStateTemporary(character, 'Dodging') then return false, 'Dodging.' end
	if Module.IsCharacterUsingSkill(character) then return false, 'Already using a skill.' end
	if CharacterStates.GetState(character, 'Blocking') then return false, 'Cannot use skills while blocking.' end
	if CharacterStates.GetState(character, 'SwordDrawing') then return false, 'Drawing weapon.' end
	if not CharacterStates.GetState(character, 'SwordDrawn') then return false, 'Weapon must be drawn.' end
	return true, ''
end

----------------------------------------------------------------------
-- Player predicate: state-gates AND the save-data unlock + ownership
-- check. NPCs use CanCharacterCastSkill directly; players use this.
----------------------------------------------------------------------
function Module.CanUseSkill(character: Instance, saveData: any, skillId: string): (boolean, string)
	if not Module.IsSkillUnlocked(saveData, skillId) then
		return false, 'Skill not unlocked.'
	end
	return Module.CanCharacterCastSkill(character, skillId)
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/ForgeShared"><![CDATA[-- ForgeShared — pure predicates + stat math for the forge system.
-- See ARTISAN.md §7. No state, no Roblox services beyond what's needed
-- for type definitions. Both client (preflight UI gating) and server
-- (mutation auth) require this module — single source of truth.

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local RunService = game:GetService('RunService')
local Players = game:GetService('Players')

local MaterialsConfig = require(script.Parent.Parent:WaitForChild('Data'):WaitForChild('Materials'))
-- Dual-mode: Blueprints migrated to per-player config replication —
-- the client shell is empty at boot, so the server must read the
-- canonical ServerStorage copy to validate AttemptUnlockBlueprint
-- and forge commits. Client keeps reading the populated shell. See
-- ROADMAP.md §"Server reads the canonical copy."
local BlueprintsConfig do
	local RunService = game:GetService('RunService')
	if RunService:IsServer() then
		local ServerStorage = game:GetService('ServerStorage')
		BlueprintsConfig = require(ServerStorage:WaitForChild('Modules'):WaitForChild('Data'):WaitForChild('Blueprints'))
	else
		BlueprintsConfig = require(script.Parent.Parent:WaitForChild('Data'):WaitForChild('Blueprints'))
	end
end
-- Dual-mode: Modifiers migrated to per-player config replication
-- (piggy-back from Items). The client shell is empty at boot — server
-- code (ForgeShared.ComputeStats / ApplyModifiers / etc.) needs the
-- canonical registry to compute forge math. See ROADMAP.md.
local ModifiersConfig do
	local RunService = game:GetService('RunService')
	if RunService:IsServer() then
		local ServerStorage = game:GetService('ServerStorage')
		ModifiersConfig = require(ServerStorage:WaitForChild('Modules'):WaitForChild('Data'):WaitForChild('Modifiers'))
	else
		ModifiersConfig = require(script.Parent.Parent:WaitForChild('Data'):WaitForChild('Modifiers'))
	end
end
-- Dual-mode: Items migrated to per-player config replication. Server
-- reads the canonical ServerStorage copy (full registry); client reads
-- the populated shell. Without this branch, server-side ForgeShared
-- functions that look up items would silently hit the empty shell.
-- See ROADMAP.md.
local ItemsConfig do
	local RunService = game:GetService('RunService')
	if RunService:IsServer() then
		local ServerStorage = game:GetService('ServerStorage')
		ItemsConfig = require(ServerStorage:WaitForChild('Modules'):WaitForChild('Data'):WaitForChild('Items'))
	else
		ItemsConfig = require(script.Parent.Parent:WaitForChild('Data'):WaitForChild('Items'))
	end
end
local CompositionalConfig = require(script.Parent.Parent:WaitForChild('Data'):WaitForChild('Compositional'))
-- CraftingShared exposes the canonical Smithing-level read path. We
-- could re-walk save.Crafting.ArtisanLevels here, but routing through
-- the shared accessor keeps the read tolerant to any future schema
-- change (table vs scalar, nil-vs-zero conventions, etc.).
local CraftingShared = require(script.Parent:WaitForChild('CraftingShared'))

export type ForgeRequest = {
	BlueprintId: string,
	Parts: { [string]: string },        -- { [slotKey] = materialId }
	Modifiers: { { id: string, level: number? } }?,
	TargetItemId: string?,              -- nil = mint new; otherwise re-forge
}

local Module = {}

----------------------------------------------------------------------
-- ForgeEvent remote protocol. The first arg of every fire is one of
-- these action discriminators. Both the client widget (FireServer) and
-- ForgeServer (OnServerEvent) reference these constants rather than the
-- raw strings, so a rename is a single-site change and a typo is a
-- nil-index — not a silently dead branch.
----------------------------------------------------------------------
export type ForgeAction =
	  'TryForge'
	| 'TryUnlockBlueprint'

Module.ForgeActions = {
	TryForge          = 'TryForge',           -- C→S: commit a forge (re-forge in place or mint)
	TryUnlockBlueprint = 'TryUnlockBlueprint', -- C→S: spend to unlock a blueprint template
} :: { [string]: ForgeAction }

----------------------------------------------------------------------
-- Catalog accessors. Pure delegations; provided here so call sites
-- only require ForgeShared (not the catalog modules directly).
----------------------------------------------------------------------
function Module.GetMaterialConfig(materialId: string)
	return MaterialsConfig.Materials[materialId]
end

function Module.GetBlueprintConfig(blueprintId: string)
	return BlueprintsConfig.Blueprints[blueprintId]
end

function Module.GetModifierConfig(modifierId: string)
	return ModifiersConfig.Modifiers[modifierId]
end

----------------------------------------------------------------------
-- Smithing-level lookup. Wraps CraftingShared so callers don't
-- re-derive the read path (handles legacy `Level` vs current
-- `{Level, XP}` shape uniformly).
----------------------------------------------------------------------
function Module.GetSmithingLevel(saveData: any): number
	return CraftingShared.GetArtisanLevel(saveData, 'Smithing')
end

-- Two-layer cache for modifier resolution.
--   GranularCache: global memo keyed `id:clampedN` → resolved entry. Bounded
--     by (#modifier ids) × (max MaxStack); never evicted.
--   PlayerCache:   per-player, keyed by stack table → { Signature, lazy
--     ActiveModifiers, lazy StatDeltaSum }. Cleared on PlayerRemoving.
local GranularCache: { [string]: any } = {}

type GroupedEntry = {
	Signature: string,
	ActiveModifiers: { any }?,
	StatDeltaSum: any?,
}
local PlayerCache: { [Player]: { [any]: GroupedEntry } } = {}

local function resolveSingleModifier(id: string, rawN: number): any?
	local cfg = ModifiersConfig.Modifiers[id]
	if not cfg then return nil end
	local n = math.max(1, math.min(cfg.MaxStack, rawN))
	local key = id .. ':' .. n
	local cached = GranularCache[key]
	if cached ~= nil then return cached end

	local resolved: any = {
		Id = id,
		Cfg = cfg,
		StackCount = n,
	}
	if cfg.StatDelta then
		local sd = cfg.StatDelta
		resolved.EffectiveStatDelta = {
			Damage        = sd.Damage and sd.Damage * n or nil,
			SpeedPct      = sd.SpeedPct and sd.SpeedPct * n or nil,
			CritPct       = sd.CritPct and sd.CritPct * n or nil,
			DurabilityPct = sd.DurabilityPct and sd.DurabilityPct * n or nil,
			TraitTag      = sd.TraitTag,
		}
	end
	if cfg.OnHit then
		local oh = cfg.OnHit
		-- Complement-of-product: 25%×3 → 1 - 0.75^3 ≈ 0.578, not 75%.
		local chance = 1 - (1 - math.clamp(oh.Chance, 0, 1)) ^ n
		local basePotency = oh.Potency or 0
		local perStack    = oh.PerStackPotency or 0
		resolved.EffectiveOnHit = {
			EffectId = oh.EffectId,
			Chance = chance,
			Duration = oh.Duration,
			Potency = basePotency + perStack * n,
		}
	end
	GranularCache[key] = resolved
	return resolved
end

-- Sorted "id:sum|id:sum" so reordered lists collapse to the same signature.
local function buildModifierSignature(modifiers: { any }): (string, { [string]: number })
	local seen: { [string]: number } = {}
	for _, entry in modifiers do
		if typeof(entry) ~= 'table' or typeof(entry.id) ~= 'string' then continue end
		if not ModifiersConfig.Modifiers[entry.id] then continue end
		seen[entry.id] = (seen[entry.id] or 0) + (entry.level or 1)
	end
	local keys: { string } = {}
	for k in seen do keys[#keys + 1] = k end
	table.sort(keys)
	local parts: { string } = {}
	for _, k in keys do
		parts[#parts + 1] = k .. ':' .. seen[k]
	end
	return table.concat(parts, '|'), seen
end

local function getOrUpdateGroupedEntry(player: Player, stack: any): (GroupedEntry?, { [string]: number }?)
	if typeof(stack) ~= 'table' or typeof(stack.Composition) ~= 'table' then
		return nil, nil
	end
	local forged = stack.Composition.Forged
	if not forged or typeof(forged.Modifiers) ~= 'table' then
		return nil, nil
	end
	local bucket = PlayerCache[player]
	if not bucket then
		bucket = {}
		PlayerCache[player] = bucket
	end
	local signature, seen = buildModifierSignature(forged.Modifiers)
	local cached = bucket[stack]
	if cached and cached.Signature == signature then
		return cached, seen
	end
	local entry: GroupedEntry = {
		Signature = signature,
		ActiveModifiers = nil,
		StatDeltaSum = nil,
	}
	bucket[stack] = entry
	return entry, seen
end

function Module.ComputeActiveModifiers(stack: any): { any }
	local out: { any } = {}
	if typeof(stack) ~= 'table' or typeof(stack.Composition) ~= 'table' then
		return out
	end
	local forged = stack.Composition.Forged
	if not forged or typeof(forged.Modifiers) ~= 'table' then return out end

	local _signature, seen = buildModifierSignature(forged.Modifiers)
	for id, sum in seen do
		local resolved = resolveSingleModifier(id, sum)
		if resolved then out[#out + 1] = resolved end
	end
	return out
end

-- Cached variants for the combat hot path. nil player → uncached fallthrough.
function Module.GetCachedActiveModifiers(player: Player?, stack: any): { any }
	if not player then
		return Module.ComputeActiveModifiers(stack)
	end
	local entry, seen = getOrUpdateGroupedEntry(player, stack)
	if not entry or not seen then return {} end
	if not entry.ActiveModifiers then
		local out: { any } = {}
		for id, sum in seen do
			local resolved = resolveSingleModifier(id, sum)
			if resolved then out[#out + 1] = resolved end
		end
		entry.ActiveModifiers = out
	end
	return entry.ActiveModifiers :: { any }
end

export type StatDeltaSum = {
	Damage: number,
	SpeedPct: number,
	CritPct: number,
	DurabilityPct: number,
}

function Module.ComputeStatDeltaSum(stack: any): StatDeltaSum
	local sum: StatDeltaSum = { Damage = 0, SpeedPct = 0, CritPct = 0, DurabilityPct = 0 }
	for _, entry in Module.ComputeActiveModifiers(stack) do
		local sd = entry.EffectiveStatDelta
		if sd then
			sum.Damage        += sd.Damage or 0
			sum.SpeedPct      += sd.SpeedPct or 0
			sum.CritPct       += sd.CritPct or 0
			sum.DurabilityPct += sd.DurabilityPct or 0
		end
	end
	return sum
end

function Module.GetCachedStatDeltaSum(player: Player?, stack: any): StatDeltaSum
	if not player then
		return Module.ComputeStatDeltaSum(stack)
	end
	local entry = getOrUpdateGroupedEntry(player, stack)
	if not entry then
		return { Damage = 0, SpeedPct = 0, CritPct = 0, DurabilityPct = 0 }
	end
	if not entry.StatDeltaSum then
		local sum: StatDeltaSum = { Damage = 0, SpeedPct = 0, CritPct = 0, DurabilityPct = 0 }
		for _, e in Module.GetCachedActiveModifiers(player, stack) do
			local sd = e.EffectiveStatDelta
			if sd then
				sum.Damage        += sd.Damage or 0
				sum.SpeedPct      += sd.SpeedPct or 0
				sum.CritPct       += sd.CritPct or 0
				sum.DurabilityPct += sd.DurabilityPct or 0
			end
		end
		entry.StatDeltaSum = sum
	end
	return entry.StatDeltaSum :: StatDeltaSum
end

function Module.OnPlayerRemoving(player: Player)
	PlayerCache[player] = nil
end

-- Cache only populates on the server; gate to avoid a no-op client connection.
if RunService:IsServer() then
	Players.PlayerRemoving:Connect(function(player: Player)
		PlayerCache[player] = nil
	end)
end

----------------------------------------------------------------------
-- ComputeStats — bake StatSnapshot from a forge composition.
-- Walks blueprint slots, sums each slot's material contribution, then
-- layers modifier stat deltas on top. Pure function — usable from both
-- the client preview pane and the server commit path.
----------------------------------------------------------------------
function Module.ComputeStats(blueprintId: string, parts, modifiers): CompositionalConfig.ForgeStatSnapshot
	local snapshot = {
		Damage = 0, Speed = 0, Weight = 0, Durability = 0,
		BonusTraits = {},
	}
	local bp = BlueprintsConfig.Blueprints[blueprintId]
	if not bp then return snapshot end

	local slotCount = #bp.Slots
	if slotCount == 0 then return snapshot end

	-- Material contributions. Each material's stats are weighted by the
	-- number of slots that use it / total slot count, so a 5-slot
	-- weapon's per-slot material has 1/5 the impact of a single-slot
	-- placement. Damage / Speed / Weight / Durability average across
	-- slots; traits accumulate.
	local damageSum, speedSum, weightSum, durSum = 0, 0, 0, 0
	local filledSlots = 0
	local seenTraits = {}
	for _, slot in bp.Slots do
		local matId = parts and parts[slot.key]
		if not matId then continue end
		local mat = MaterialsConfig.Materials[matId]
		if not mat then continue end
		damageSum  += mat.Damage
		speedSum   += mat.Speed
		weightSum  += mat.Weight
		durSum     += mat.Durability
		filledSlots += 1
		if mat.Trait and mat.Trait ~= '—' and not seenTraits[mat.Trait] then
			seenTraits[mat.Trait] = true
			table.insert(snapshot.BonusTraits, mat.Trait)
		end
	end
	if filledSlots > 0 then
		snapshot.Damage     = math.floor(damageSum / filledSlots)
		-- Speed / Weight / Durability stay as fractional multipliers —
		-- average preserves the design's 1.0-baseline semantics.
		snapshot.Speed      = speedSum / filledSlots
		snapshot.Weight     = weightSum / filledSlots
		snapshot.Durability = durSum / filledSlots
	end

	-- Modifier deltas. Modifier effects are encoded in their `Effect`
	-- string for player display; v1 doesn't parse the string into
	-- numerical deltas — combat integration in Stage D will read the
	-- modifier list directly. Keeping the modifier list in the snapshot
	-- means damage path doesn't need to walk the registry every swing.
	-- Modifiers also don't get a count column here — Stage D adds it.

	return snapshot
end

----------------------------------------------------------------------
-- ComputeForgedRarity — derive a final rarity (1..6, aligned with
-- Rarities.RarityEnums Common..Mythic) from:
--   1. The MAX Tier of any material used (sets the floor)
--   2. The player's Smithing artisan level (provides bonuses every
--      20 levels — the same band size that AttributeServer uses
--      for level-based bonuses)
--
-- Result is `clamp(maxTier + bandBonus, 1, 6)`. So a Lv 60 smith
-- using starsilk (Tier 6) caps at Mythic; a Lv 1 smith using iron
-- (Tier 1) lands at Common; a Lv 40 smith using moonsteel (Tier 3)
-- gets a +2-band bonus → Tier 5 (Legendary).
--
-- Modifiers don't bump rarity; that ladder is purely material × skill.
----------------------------------------------------------------------
function Module.ComputeForgedRarity(saveData: any, parts: any): number
	local maxTier = 1
	if typeof(parts) == 'table' then
		for _, matId in parts do
			local mat = MaterialsConfig.Materials[matId]
			if mat and (mat.Tier or 1) > maxTier then
				maxTier = mat.Tier or 1
			end
		end
	end
	local level = Module.GetSmithingLevel(saveData)
	-- Every 20 levels of Smithing nudges the rarity up one band.
	local bandBonus = math.floor(level / 20)
	local final = math.clamp(maxTier + bandBonus, 1, 6)
	return final
end

----------------------------------------------------------------------
-- ComputeForgeXP — Smithing XP grant for a single forge commit.
-- XP scales with: number of filled blueprint slots × average material
-- tier × modifier-slot consumption. A 5-slot greatsword of obsidian
-- (Tier 2) with one Sharp×3 modifier yields ~5 × 2 × 1.3 ≈ 13 XP.
----------------------------------------------------------------------
function Module.ComputeForgeXP(blueprintId: string, parts: any, modifiers: any?): number
	local bp = BlueprintsConfig.Blueprints[blueprintId]
	if not bp then return 0 end
	local filled = 0
	local tierSum = 0
	for _, slot in bp.Slots do
		local matId = parts and parts[slot.key]
		local mat = matId and MaterialsConfig.Materials[matId]
		if mat then
			filled += 1
			tierSum += (mat.Tier or 1)
		end
	end
	if filled == 0 then return 0 end
	local avgTier = tierSum / filled
	local modScalar = 1.0
	if modifiers then
		local modSlots = 0
		for _, mod in modifiers do
			local cfg = ModifiersConfig.Modifiers[mod.id]
			if cfg then
				modSlots += cfg.Cost * (mod.level or 1)
			end
		end
		-- Up to +30% XP for a fully-modifier-budgeted commit.
		modScalar = 1 + math.min(0.3, modSlots / 40)
	end
	return math.floor(filled * avgTier * 2 * modScalar + 0.5)
end

----------------------------------------------------------------------
-- ComputeForgeCost — return required currency + materials.
-- Materials cost is 1 unit per filled slot (the slot's chosen material
-- contributes one unit). Currency cost scales with modifier complexity.
-- Pure function — same on client preview + server commit.
----------------------------------------------------------------------
function Module.ComputeForgeCost(blueprintId: string, parts, modifiers): { Currency: number, Materials: { [string]: number } }
	local bp = BlueprintsConfig.Blueprints[blueprintId]
	local cost = { Currency = 0, Materials = {} }
	if not bp then return cost end
	for _, slot in bp.Slots do
		local matId = parts and parts[slot.key]
		if matId then
			cost.Materials[matId] = (cost.Materials[matId] or 0) + 1
		end
	end
	-- Modifier slot accounting: Currency cost rises with the cumulative
	-- modifier-slot consumption. Each modifier has Cost (slots used per
	-- stack) and we multiply by stacks-applied. Default rate is 25
	-- currency per modifier slot.
	if modifiers then
		for _, mod in modifiers do
			local cfg = ModifiersConfig.Modifiers[mod.id]
			if cfg then
				cost.Currency += cfg.Cost * (mod.level or 1) * 25
			end
		end
	end
	return cost
end

----------------------------------------------------------------------
-- CanForgeWeapon — full server-side validation. Returns (ok, reason).
-- The reason string is surfaced in toasts on rejection so the player
-- knows why their commit failed.
--
-- saveData is the caller's PlayerData copy. PlayerInventoryServer's
-- GetForgeMaterialUnits is delegated through SystemsContainer instead
-- of being required here — keeps Shared free of server-only deps.
----------------------------------------------------------------------
function Module.CanForgeWeapon(saveData, request: ForgeRequest, materialUnitsLookup): (boolean, string)
	if typeof(saveData) ~= 'table' then return false, 'No save data.' end
	if typeof(request) ~= 'table' then return false, 'Bad request.' end
	local bp = BlueprintsConfig.Blueprints[request.BlueprintId]
	if not bp then return false, 'Unknown blueprint.' end

	-- Blueprint-level artisan gate. Each Blueprint authors a
	-- RequiredArtisanLevel (the minimum Smithing level needed to forge
	-- THIS template, regardless of materials chosen). Predates the
	-- material-level gate below — this check is "do you know how to
	-- shape this kind of weapon at all?", the material gate is "can
	-- you handle this specific alloy?". Both must pass.
	local smithingLevel = Module.GetSmithingLevel(saveData)
	local bpReq = bp.RequiredArtisanLevel or 1
	if bpReq > smithingLevel then
		return false, string.format(
			'%s requires Smithing %d (you are %d).',
			bp.Name, bpReq, smithingLevel
		)
	end

	-- Every blueprint slot must have a chosen material.
	for _, slot in bp.Slots do
		local matId = request.Parts and request.Parts[slot.key]
		if not matId then
			return false, string.format('Slot %s is empty.', slot.Label)
		end
		if not MaterialsConfig.Materials[matId] then
			return false, string.format('Unknown material in slot %s.', slot.Label)
		end
	end

	-- Material-level gate. Refuse the commit if any chosen material's
	-- RequiredLevel exceeds the player's Smithing level.
	for _, slot in bp.Slots do
		local matId = request.Parts and request.Parts[slot.key]
		local mat = MaterialsConfig.Materials[matId]
		if mat and (mat.RequiredLevel or 1) > smithingLevel then
			return false, string.format(
				'%s requires Smithing %d (you are %d).',
				mat.Name, mat.RequiredLevel, smithingLevel
			)
		end
	end

	-- Modifier validation — check id + level cap.
	if request.Modifiers then
		local slotsBudget = ModifiersConfig.MaxModifierSlots
		local slotsUsed = 0
		for _, mod in request.Modifiers do
			local cfg = ModifiersConfig.Modifiers[mod.id]
			if not cfg then return false, string.format('Unknown modifier %s.', tostring(mod.id)) end
			local lvl = mod.level or 1
			if lvl < 1 or lvl > cfg.MaxStack then
				return false, string.format('Modifier %s level out of range.', cfg.Name)
			end
			slotsUsed += cfg.Cost * lvl
		end
		if slotsUsed > slotsBudget then
			return false, 'Modifier budget exceeded.'
		end
	end

	-- Material units check — delegate to the inventory lookup the caller
	-- provided. Must return number of available units for a materialId.
	if typeof(materialUnitsLookup) == 'function' then
		local needs = Module.ComputeForgeCost(request.BlueprintId, request.Parts, request.Modifiers).Materials
		for matId, need in needs do
			local have = materialUnitsLookup(matId) or 0
			if have < need then
				local cfg = MaterialsConfig.Materials[matId]
				return false, string.format('Need %d × %s; have %d.', need, cfg and cfg.Name or matId, have)
			end
		end
	end

	-- Currency check.
	local cost = Module.ComputeForgeCost(request.BlueprintId, request.Parts, request.Modifiers)
	if (saveData.Currency or 0) < cost.Currency then
		return false, string.format('Need %d currency; have %d.', cost.Currency, saveData.Currency or 0)
	end

	return true, ''
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/EnchantShared"><![CDATA[-- EnchantShared — pure predicates for enchant application.
-- See ARTISAN.md §7. Both client (UI gating) and server (mutation auth)
-- require this module; same validation logic on both sides.

local EnchantsConfig = require(script.Parent.Parent:WaitForChild('Data'):WaitForChild('Enchants'))
-- Dual-mode: Items migrated to per-player config replication. Server
-- reads canonical (full registry) from ServerStorage; client reads
-- the populated shell. See ROADMAP.md §"Server reads the canonical copy."
local ItemsConfig do
	local RunService = game:GetService('RunService')
	if RunService:IsServer() then
		local ServerStorage = game:GetService('ServerStorage')
		ItemsConfig = require(ServerStorage:WaitForChild('Modules'):WaitForChild('Data'):WaitForChild('Items'))
	else
		ItemsConfig = require(script.Parent.Parent:WaitForChild('Data'):WaitForChild('Items'))
	end
end
local CompositionalConfig = require(script.Parent.Parent:WaitForChild('Data'):WaitForChild('Compositional'))
local CraftingShared = require(script.Parent:WaitForChild('CraftingShared'))

local Module = {}

----------------------------------------------------------------------
-- EnchantEvent remote protocol. The first arg of every fire is one of
-- these action discriminators. Both the client widget (FireServer) and
-- EnchantServer (OnServerEvent) reference these constants rather than
-- the raw strings, so a rename is a single-site change and a typo is a
-- nil-index — not a silently dead branch.
----------------------------------------------------------------------
export type EnchantAction =
	  'TryApply'
	| 'TrySalvage'
	| 'TryRemove'

Module.EnchantActions = {
	TryApply   = 'TryApply',   -- C→S: inscribe (uuid, enchantId, level, scrollUuid?)
	TrySalvage = 'TrySalvage', -- C→S: salvage all enchants off (uuid)
	TryRemove  = 'TryRemove',  -- C→S: remove a single enchant (uuid, enchantId)
} :: { [string]: EnchantAction }

----------------------------------------------------------------------
-- Essence cost. Inscribing an enchant burns:
--   * 1 EnchantEssence (always)
--   * N RarityEssence keyed by the TARGET WEAPON's effective rarity
--     (Common → CommonRarityEssence, Rare → RareRarityEssence, etc.)
-- Higher-tier weapons cost more rarity essences.
--
-- The mapping below resolves a 1..6 rarity number into the inventory
-- itemId of the matching essence + the count to consume. Return both
-- so callers can pre-check OR consume without re-deriving.
----------------------------------------------------------------------
export type EssenceCost = {
	EnchantEssenceQty: number,
	RarityEssenceItemId: string,
	RarityEssenceQty: number,
}

local RARITY_ESSENCE_MAP: { [number]: { itemId: string, qty: number } } = {
	-- Rarity enum: 1=Common, 2=Uncommon, 3=Rare, 4=Epic, 5=Legendary, 6=Mythic.
	-- Uncommon folds into Common essence; Mythic into Legendary essence so
	-- the four published essence items cover the six rarity bands.
	[1] = { itemId = 'CommonRarityEssence',    qty = 1 },
	[2] = { itemId = 'CommonRarityEssence',    qty = 2 },
	[3] = { itemId = 'RareRarityEssence',      qty = 1 },
	[4] = { itemId = 'EpicRarityEssence',      qty = 1 },
	[5] = { itemId = 'LegendaryRarityEssence', qty = 1 },
	[6] = { itemId = 'LegendaryRarityEssence', qty = 2 },
}

function Module.GetEssenceCost(targetRarity: number): EssenceCost
	local entry = RARITY_ESSENCE_MAP[math.clamp(targetRarity, 1, 6)]
		or RARITY_ESSENCE_MAP[1]
	return {
		EnchantEssenceQty = 1,
		RarityEssenceItemId = entry.itemId,
		RarityEssenceQty = entry.qty,
	}
end

----------------------------------------------------------------------
-- Catalog accessors.
----------------------------------------------------------------------
function Module.GetEnchantConfig(enchantId: string)
	return EnchantsConfig.Enchants[enchantId]
end

function Module.GetEnchantCostAtLevel(enchantId: string, level: number): number
	local cfg = EnchantsConfig.Enchants[enchantId]
	if not cfg or not cfg.Cost then return 0 end
	return cfg.Cost[level] or 0
end

----------------------------------------------------------------------
-- GetEnchantsOnItem — safely read the EnchantEntry list off a stack.
-- Returns an empty array when the stack has no Composition.Enchants.
----------------------------------------------------------------------
function Module.GetEnchantsOnItem(stack): { CompositionalConfig.EnchantEntry }
	if typeof(stack) ~= 'table' then return {} end
	local comp = stack.Composition
	if typeof(comp) ~= 'table' or typeof(comp.Enchants) ~= 'table' then return {} end
	return comp.Enchants.Entries or {}
end

----------------------------------------------------------------------
-- FindEntryOnItem — return (entry, index) for an enchantId on a stack,
-- or nil when not present. Used by both apply (replace existing) and
-- remove paths.
----------------------------------------------------------------------
function Module.FindEntryOnItem(stack, enchantId: string)
	local entries = Module.GetEnchantsOnItem(stack)
	for i, e in entries do
		if e.Id == enchantId then return e, i end
	end
	return nil, nil
end

----------------------------------------------------------------------
-- CanApplyEnchant — full validation. Returns (ok, reason).
--
-- saveData → caller's PlayerData copy.
-- uuid     → target item uuid (must exist in saveData.Inventory).
-- enchantId/level → what the player wants to apply.
--
-- Rules:
--   1. Enchant exists in the catalog.
--   2. level is in [1, MaxLevel].
--   3. Target item exists, has EquipmentData (only equipment is
--      enchantable), and isn't a stack-only item.
--   4. No CONFLICTING enchant on the same item (Enchant.Conflict ids).
--   5. Prereq enchant (if any) is on the item at >= required level.
--   6. Currency / scroll cost is payable — caller provides cost-check
--      delegate so this module stays Shared (no inventory dep).
----------------------------------------------------------------------
function Module.CanApplyEnchant(saveData, uuid: string, enchantId: string, level: number, costPaidPredicate): (boolean, string)
	if typeof(saveData) ~= 'table' then return false, 'No save data.' end
	if typeof(uuid) ~= 'string' or #uuid == 0 then return false, 'Bad uuid.' end
	local cfg = EnchantsConfig.Enchants[enchantId]
	if not cfg then return false, 'Unknown enchant.' end
	if typeof(level) ~= 'number' or level < 1 or level > cfg.MaxLevel then
		return false, 'Invalid level.'
	end

	-- Enchanting artisan-level gate. Higher-tier enchants need
	-- progression — same model Smithing uses for materials.
	local enchantingLevel = CraftingShared.GetArtisanLevel(saveData, 'Enchanting')
	local required = EnchantsConfig.GetRequiredLevel(enchantId)
	if enchantingLevel < required then
		return false, string.format(
			'%s requires Enchanting %d (you are %d).',
			cfg.Name, required, enchantingLevel)
	end

	-- Resolve the target stack via Items.FindInventoryItemOfUUID.
	local stack, itemId = ItemsConfig.FindInventoryItemOfUUID(saveData.Inventory or {}, uuid)
	if not stack or not itemId then return false, 'Target item not found.' end
	local itemConfig = ItemsConfig.Items[itemId]
	if not itemConfig then return false, 'Unknown item config.' end
	if not itemConfig.EquipmentData then
		return false, 'This item cannot be enchanted.'
	end

	-- Already-enchanted block. Per design: a weapon carries AT MOST ONE
	-- enchant. The salvage flow lets the player strip (and possibly
	-- recover essences) before applying a different enchant.
	local existing = Module.GetEnchantsOnItem(stack)
	if #existing > 0 then
		local first = existing[1]
		local firstCfg = EnchantsConfig.Enchants[first.Id]
		return false, string.format(
			'Already enchanted with %s. Salvage to re-enchant.',
			firstCfg and firstCfg.Name or first.Id)
	end

	-- Conflict check: kept for future-proofing (multi-enchant tier),
	-- though the already-enchanted block above covers the v1 case.
	if cfg.Conflict then
		for _, conflictId in cfg.Conflict do
			for _, e in existing do
				if e.Id == conflictId then
					return false, string.format(
						'Conflicts with existing %s.',
						EnchantsConfig.Enchants[conflictId] and EnchantsConfig.Enchants[conflictId].Name or conflictId)
				end
			end
		end
	end
	-- Prereq check: required enchant must already be on the item at
	-- the required level.
	if cfg.Prereq then
		local prereq, _ = Module.FindEntryOnItem(stack, cfg.Prereq.Id)
		if not prereq or prereq.Level < cfg.Prereq.Level then
			local pcfg = EnchantsConfig.Enchants[cfg.Prereq.Id]
			return false, string.format(
				'Requires %s lv %d.',
				pcfg and pcfg.Name or cfg.Prereq.Id, cfg.Prereq.Level)
		end
	end
	-- Cost: caller-supplied predicate covers either scroll-consume or
	-- currency-spend. Returns (ok, reason).
	if typeof(costPaidPredicate) == 'function' then
		local ok, reason = costPaidPredicate(cfg, level)
		if not ok then return false, reason or 'Cannot afford enchant.' end
	end
	return true, ''
end

----------------------------------------------------------------------
-- FormatDescription — substitute the descMult into the format string
-- for a given level. Used by tooltips on both client preview and
-- inventory detail panes.
----------------------------------------------------------------------
function Module.FormatDescription(enchantId: string, level: number): string
	local cfg = EnchantsConfig.Enchants[enchantId]
	if not cfg then return '' end
	local val = cfg.DescriptionMultiplier * level
	local ok, formatted = pcall(string.format, cfg.DescriptionFormat, val)
	if not ok then return cfg.DescriptionFormat end
	return formatted
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/GemSocketShared"><![CDATA[-- GemSocketShared — pure predicates + resonance math for socketing.
-- See ARTISAN.md §7. Both client (UI gating) and server (mutation auth)
-- require this module.

local GemsConfig = require(script.Parent.Parent:WaitForChild('Data'):WaitForChild('Gems'))
-- Dual-mode: Items migrated to per-player config replication. Server
-- reads canonical (full registry) from ServerStorage; client reads
-- the populated shell. See ROADMAP.md §"Server reads the canonical copy."
local ItemsConfig do
	local RunService = game:GetService('RunService')
	if RunService:IsServer() then
		local ServerStorage = game:GetService('ServerStorage')
		ItemsConfig = require(ServerStorage:WaitForChild('Modules'):WaitForChild('Data'):WaitForChild('Items'))
	else
		ItemsConfig = require(script.Parent.Parent:WaitForChild('Data'):WaitForChild('Items'))
	end
end
local CompositionalConfig = require(script.Parent.Parent:WaitForChild('Data'):WaitForChild('Compositional'))
local CraftingShared = require(script.Parent:WaitForChild('CraftingShared'))

local Module = {}

----------------------------------------------------------------------
-- GemSocketEvent remote protocol. The first arg of every fire is one of
-- these action discriminators. Both the client widget (FireServer) and
-- GemSocketServer (OnServerEvent) reference these constants rather than
-- the raw strings, so a rename is a single-site change and a typo is a
-- nil-index — not a silently dead branch.
----------------------------------------------------------------------
export type GemSocketAction =
	  'TrySet'
	| 'TrySmash'
	| 'TryUnsocket'
	| 'TryRemove'
	| 'TryUnsocketAll'

Module.GemSocketActions = {
	TrySet        = 'TrySet',        -- C→S: socket a gem into (itemUuid, slotIndex)
	TrySmash      = 'TrySmash',      -- C→S: destroy the socketed gem (free)
	TryUnsocket   = 'TryUnsocket',   -- C→S: refund the gem (1 Gem Essence)
	TryRemove     = 'TryRemove',     -- C→S: back-compat alias of TrySmash
	TryUnsocketAll = 'TryUnsocketAll', -- C→S: refund every gem on the item
} :: { [string]: GemSocketAction }

----------------------------------------------------------------------
-- Catalog accessors.
----------------------------------------------------------------------
function Module.GetGemConfig(gemId: string)
	return GemsConfig.Gems[gemId]
end

----------------------------------------------------------------------
-- GetSocketCount — read socket count off an item's EquipmentData.
-- Items without an EquipmentData.Sockets list are non-socketable.
----------------------------------------------------------------------
function Module.GetSocketColors(itemConfig): { string }
	if not itemConfig or not itemConfig.EquipmentData then return {} end
	local sockets = itemConfig.EquipmentData.Sockets
	if typeof(sockets) ~= 'table' then return {} end
	local colors = {}
	for _, s in sockets do
		table.insert(colors, (typeof(s) == 'table' and s.Color) or 'any')
	end
	return colors
end

function Module.GetSocketCount(itemConfig): number
	return #Module.GetSocketColors(itemConfig)
end

----------------------------------------------------------------------
-- ColorMatches — does a gem's ColorClass fit a socket's required color?
-- 'any' sockets accept all colors. Otherwise exact match required.
----------------------------------------------------------------------
function Module.ColorMatches(socketColor: string, gemColorClass: string): boolean
	if socketColor == 'any' then return true end
	return socketColor == gemColorClass
end

----------------------------------------------------------------------
-- ComputeResonance — count equipped gems by ColorClass.
-- Returns (activeColor, multiplier). When 3+ slots share a color, that
-- color is "Active" with a multiplier > 1; otherwise multiplier = 1.
-- Walks slots via the inventory lookup (delegate so this module stays
-- free of server-only deps).
----------------------------------------------------------------------
function Module.ComputeResonance(slots, gemLookup): (string?, number)
	if typeof(slots) ~= 'table' then return nil, 1 end
	local counts = {}
	for _, slot in slots do
		if slot.GemUuid then
			local gemCfg = typeof(gemLookup) == 'function' and gemLookup(slot.GemUuid) or nil
			if gemCfg and gemCfg.ColorClass then
				counts[gemCfg.ColorClass] = (counts[gemCfg.ColorClass] or 0) + 1
			end
		end
	end
	-- Find the dominant color (≥3 to qualify).
	local bestColor, bestCount = nil, 0
	for color, count in counts do
		if count > bestCount then
			bestCount = count
			bestColor = color
		end
	end
	if bestCount < 3 then return nil, 1 end
	-- Multiplier scales with count: 3 = 1.10, 4 = 1.18, 5+ = 1.25.
	local mult = bestCount >= 5 and 1.25
		or bestCount == 4 and 1.18
		or 1.10
	return bestColor, mult
end

----------------------------------------------------------------------
-- RefreshResonance — re-derive ResonanceBonus and write it back to the
-- stack's Composition.Socketing struct. Called after every set / remove.
----------------------------------------------------------------------
function Module.RefreshResonance(stack, gemLookup)
	if typeof(stack) ~= 'table' then return end
	local socketing = stack.Composition and stack.Composition.Socketing
	if not socketing then return end
	local color, mult = Module.ComputeResonance(socketing.Slots, gemLookup)
	socketing.ResonanceBonus = { Active = color, Multiplier = mult }
end

----------------------------------------------------------------------
-- CanSetGem — full validation. Returns (ok, reason).
--
-- saveData    → caller's PlayerData copy.
-- itemUuid    → target weapon / accessory.
-- slotIndex   → 1-based socket index.
-- gemUuid     → player-inventory uuid of the gem to set.
-- isSocketed  → caller-provided fn(gemUuid) → (boolean, string?) that
--               consults data.SocketedGems for the inverse-index check.
----------------------------------------------------------------------
function Module.CanSetGem(saveData, itemUuid: string, slotIndex: number, gemUuid: string, isSocketed): (boolean, string)
	if typeof(saveData) ~= 'table' then return false, 'No save data.' end
	if typeof(itemUuid) ~= 'string' or #itemUuid == 0 then return false, 'Bad item uuid.' end
	if typeof(gemUuid) ~= 'string' or #gemUuid == 0 then return false, 'Bad gem uuid.' end
	if typeof(slotIndex) ~= 'number' or slotIndex < 1 then return false, 'Bad slot index.' end

	local stack, itemId = ItemsConfig.FindInventoryItemOfUUID(saveData.Inventory or {}, itemUuid)
	if not stack or not itemId then return false, 'Target item not found.' end
	local itemConfig = ItemsConfig.Items[itemId]
	if not itemConfig then return false, 'Unknown item config.' end

	local socketColors = Module.GetSocketColors(itemConfig)
	if slotIndex > #socketColors then return false, 'Slot does not exist on this item.' end

	-- Gem ownership + catalog resolution.
	local gemStack, gemItemId = ItemsConfig.FindInventoryItemOfUUID(saveData.Inventory or {}, gemUuid)
	if not gemStack or not gemItemId then return false, 'Gem not in inventory.' end
	local gemItemCfg = ItemsConfig.Items[gemItemId]
	local gemMeta = ItemsConfig.GetGem(gemItemCfg)
	if not gemMeta then return false, 'Item is not a gem.' end
	local gemCfg = GemsConfig.Gems[gemMeta.Id]
	if not gemCfg then return false, 'Unknown gem.' end

	-- Inverse-index check: gem must not be socketed elsewhere.
	if typeof(isSocketed) == 'function' then
		local already, where = isSocketed(gemUuid)
		if already and where ~= itemUuid then
			return false, 'Gem is already set in another item.'
		end
	end

	-- Color match.
	if not Module.ColorMatches(socketColors[slotIndex], gemCfg.ColorClass) then
		return false, string.format(
			'This socket needs a %s gem.',
			tostring(socketColors[slotIndex]))
	end

	-- Gemcutting artisan-level gate. Higher-rarity gems require
	-- progression — a Lv 1 gemcutter can socket commons + uncommons,
	-- but mythic gems are locked behind Lv 60 Gemcutting.
	local gemcuttingLevel = CraftingShared.GetArtisanLevel(saveData, 'Gemcutting')
	local required = GemsConfig.GetRequiredLevel(gemMeta.Id)
	if gemcuttingLevel < required then
		return false, string.format(
			'%s requires Gemcutting %d (you are %d).',
			gemCfg.Name or gemMeta.Id, required, gemcuttingLevel)
	end

	return true, ''
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/CinematicBuilder"><![CDATA[-- CinematicBuilder — fluent factory for composing cinematic configs
-- by preset name. Returns a CinematicShared.CinematicConfig at
-- :Build() so the result drops straight into Data/Cinematics.luau
-- alongside hand-authored entries.
--
-- Usage:
--   local cfg = CinematicBuilder.New('boss_intro', 5.0)
--       :LockMovement(true)
--       :LockHUD(true)
--       :SkipKey(Enum.KeyCode.Escape)
--       :ShotAt(0.0, 'wide_establishing', 'workspace.Bosses.Frostmourne.HumanoidRootPart')
--       :ShakeAt(0.6, 'medium')
--       :LabelAt(0.4, 'BOSS', 'Frostmourne the Cold')
--       :SFXAt(0.5, 'rbxassetid://9114015882', 0.7)
--       :ShotAt(2.6, 'low_hero', 'workspace.Bosses.Frostmourne.HumanoidRootPart')
--       :ShakeAt(2.6, 'finisher')
--       :HideLabelAt(4.5)
--       :CameraResetAt(4.8)
--       :Build()
--
-- The builder *does not* run the cinematic — it just produces the
-- config table. Use SystemsContainer.CinematicServer.PlayForPlayer
-- to fire it.

local CinematicShared  = require(script.Parent.CinematicShared)
local CinematicPresets = require(script.Parent.Parent.Data.CinematicPresets)

export type Cue = CinematicShared.Cue
export type CinematicConfig = CinematicShared.CinematicConfig

local Module = {}

-- Internal type — what we build up across chained calls. We don't
-- export this; callers see the public methods only.
type Builder = {
	_id: string,
	_duration: number,
	_lockMovement: boolean,
	_lockHUD: boolean,
	_skipKeyCode: number?,
	_cues: { Cue },
}

local Methods = {}

----------------------------------------------------------------------
-- Cue authoring helpers (shared by every Method that appends).
-- Keeps the per-method bodies terse + ensures every cue in the list
-- has the same shape regardless of which builder method created it.
----------------------------------------------------------------------
local function appendCue(self: Builder, at: number, kind: string, args: { [string]: any })
	self._cues[#self._cues + 1] = { At = at, Kind = kind, Args = args }
end

----------------------------------------------------------------------
-- Configuration setters. Chainable — each returns the builder.
----------------------------------------------------------------------
function Methods.LockMovement(self: Builder, locked: boolean)
	self._lockMovement = locked
	return self
end

function Methods.LockHUD(self: Builder, locked: boolean)
	self._lockHUD = locked
	return self
end

function Methods.SkipKey(self: Builder, key: Enum.KeyCode?)
	self._skipKeyCode = key and key.Value or nil
	return self
end

-- Override the running duration. Normally the duration is the value
-- passed to :New(); this is for cases where you want to author cues
-- past the initial estimate.
function Methods.Duration(self: Builder, duration: number)
	self._duration = duration
	return self
end

----------------------------------------------------------------------
-- Camera cues.
--   ShotAt(at, presetName, instancePath)
--     Resolve the named camera shot preset against the target
--     instance — emits a CameraTo cue with Anchor='instance' and
--     the preset's Offset / Lerp.
--
--   ShotAtWorld(at, presetName, basePosition)
--     Same preset resolution but anchored to a world position.
--     basePosition is a CFrame; the preset's Offset is applied
--     by the renderer at the given basePosition.
--
--   OrbitAt(at, instancePath, opts)
--     Emit a CameraTrack cue (orbit). opts: {Radius?, Speed?, Pitch?}.
--
--   CameraResetAt(at)
--     Return camera to default Roblox-controlled mode.
----------------------------------------------------------------------
function Methods.ShotAt(self: Builder, at: number, presetName: string, instancePath: string)
	local shot = CinematicPresets.ResolveShot(presetName)
	appendCue(self, at, CinematicShared.CueKind.CameraTo, {
		Anchor       = 'instance',
		InstancePath = instancePath,
		Offset       = shot.Offset,
		Lerp         = shot.Lerp,
	})
	return self
end

function Methods.ShotAtWorld(self: Builder, at: number, presetName: string, basePosition: CFrame)
	local shot = CinematicPresets.ResolveShot(presetName)
	appendCue(self, at, CinematicShared.CueKind.CameraTo, {
		Anchor   = 'world',
		Position = basePosition * shot.Offset,
		Lerp     = shot.Lerp,
	})
	return self
end

function Methods.OrbitAt(self: Builder, at: number, instancePath: string,
	opts: { Radius: number?, Speed: number?, Pitch: number? }?)
	opts = opts or {}
	appendCue(self, at, CinematicShared.CueKind.CameraTrack, {
		InstancePath = instancePath,
		OrbitRadius  = opts.Radius or 16,
		OrbitSpeed   = opts.Speed or 0.6,
		Pitch        = opts.Pitch or -0.3,
	})
	return self
end

function Methods.CameraResetAt(self: Builder, at: number)
	appendCue(self, at, CinematicShared.CueKind.CameraReset, {})
	return self
end

----------------------------------------------------------------------
-- Shake cues — preset-resolved.
----------------------------------------------------------------------
function Methods.ShakeAt(self: Builder, at: number, presetName: string)
	local s = CinematicPresets.ResolveShake(presetName)
	appendCue(self, at, CinematicShared.CueKind.CameraShake, {
		Magnitude = s.Magnitude,
		Roughness = s.Roughness,
		Duration  = s.Duration,
		FadeIn    = s.FadeIn,
		FadeOut   = s.FadeOut,
	})
	return self
end

----------------------------------------------------------------------
-- VFX cues — preset-resolved.
--   VFXAt(at, presetName, instancePath?)        — instance-anchored
--   VFXAtPosition(at, presetName, position)     — world-anchored
----------------------------------------------------------------------
function Methods.VFXAt(self: Builder, at: number, presetName: string, instancePath: string?)
	local v = CinematicPresets.ResolveVFX(presetName)
	appendCue(self, at, CinematicShared.CueKind.PlayVFX, {
		TemplateName = v.Template,
		Duration     = v.Duration,
		Anchor       = 'instance',
		InstancePath = instancePath,
	})
	return self
end

function Methods.VFXAtPosition(self: Builder, at: number, presetName: string, position: Vector3)
	local v = CinematicPresets.ResolveVFX(presetName)
	appendCue(self, at, CinematicShared.CueKind.PlayVFX, {
		TemplateName = v.Template,
		Duration     = v.Duration,
		Anchor       = 'world',
		Position     = position,
	})
	return self
end

----------------------------------------------------------------------
-- Audio + label + dialogue + raw timing cues.
----------------------------------------------------------------------
function Methods.SFXAt(self: Builder, at: number, sound: string | number, pitch: number?, position: Vector3?)
	appendCue(self, at, CinematicShared.CueKind.PlaySFX, {
		Sound = sound, Pitch = pitch, Position = position,
	})
	return self
end

function Methods.LabelAt(self: Builder, at: number, title: string, subtitle: string?, anchor: ('top' | 'bottom')?)
	appendCue(self, at, CinematicShared.CueKind.ShowLabel, {
		Title    = title,
		Subtitle = subtitle,
		Anchor   = anchor or 'top',
	})
	return self
end

function Methods.HideLabelAt(self: Builder, at: number, anchor: ('top' | 'bottom' | 'both')?)
	appendCue(self, at, CinematicShared.CueKind.HideLabel, { Anchor = anchor or 'top' })
	return self
end

function Methods.DialogueAt(self: Builder, at: number, dialogueId: string, npcInstancePath: string?)
	appendCue(self, at, CinematicShared.CueKind.StartDialogue, {
		DialogueId      = dialogueId,
		NPCInstancePath = npcInstancePath,
	})
	return self
end

function Methods.WaitFor(self: Builder, at: number, seconds: number)
	-- Pure timing marker. Useful for self-documenting "nothing
	-- visible happens until X" beats; the renderer no-ops on it.
	appendCue(self, at, CinematicShared.CueKind.WaitFor, { Seconds = seconds })
	return self
end

-- Append a raw cue table — escape hatch for kinds the builder doesn't
-- (yet) wrap in a method.
function Methods.RawCue(self: Builder, at: number, kind: string, args: { [string]: any })
	appendCue(self, at, kind, args)
	return self
end

----------------------------------------------------------------------
-- Build → CinematicConfig. Sorts cues by `At` so authors can append
-- in any order (presets often emit a Shake immediately after a Shot
-- at the same At — same time, dispatch order is implementation-
-- defined for the renderer; sort keeps the structure predictable).
----------------------------------------------------------------------
function Methods.Build(self: Builder): CinematicConfig
	return {
		Id           = self._id,
		Duration     = self._duration,
		LockMovement = self._lockMovement,
		LockHUD      = self._lockHUD,
		SkipKeyCode  = self._skipKeyCode,
		Cues         = CinematicShared.SortCues(self._cues),
	}
end

----------------------------------------------------------------------
-- Constructor.
----------------------------------------------------------------------
function Module.New(id: string, duration: number)
	-- Plain-table dispatch (no metatables, per framework conventions:
	-- "no OOP, no classes"). Methods live alongside the data fields on
	-- the same table; `:Method()` passes the table as `self` and the
	-- methods mutate the underscore-prefixed data fields directly.
	-- Build() returns a pure data table — no methods attached — so the
	-- final CinematicConfig stored in Data/Cinematics is method-free.
	local self = {
		_id           = id,
		_duration     = duration,
		_lockMovement = false,
		_lockHUD      = false,
		_skipKeyCode  = nil :: number?,
		_cues         = {} :: { Cue },
	}
	for name, fn in Methods do
		self[name] = fn
	end
	return self
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/CombosShared"><![CDATA[-- // CombosShared.luau //
-- Pure resolver / validator over the move registry in
-- ReplicatedStorage/Modules/Data/CombatMovesets.luau. Client and server
-- both require this module so combo lookup logic is shared and forged
-- client claims are caught server-side against identical rules.
--
-- See NIER_COMBAT.md for the design.
--
-- ANIMATION INDEPENDENCE: this module deliberately exposes no
-- animation-aware timing API. The previous `GetTimings(entry, animLength)`
-- let a loaded animation's length rescale the gameplay window, which meant
-- the same swing had different active frames depending on whether an asset
-- had finished replicating. Timings now come from CombatMovesets alone.
-- `move.AnimationSlot` is a cosmetic hint the client may ignore entirely.
--
-- Key API:
--   IsValidInput(kind)
--       Whitelists the raw input letters ('L', 'H').
--
--   ResolveActiveClass(lightClass, heavyClass)
--       Picks which class registry to use given the player's two slots.
--
--   ResolveContext(isAirborne, hasCounter)
--       Maps authoritative caster state to a move context. Callers pass
--       flags rather than a character so this stays side-effect free.
--
--   AppendInput(comboString, kind, maxLength, weaponClass, context)
--       Pure: returns a new array with the chain-reset rules applied.
--
--   ResolveComboKey(comboString, weaponClass, context)
--       Returns (key, move, finalLetter) for the current chain.
--
--   ValidateClaim(serverComboString, claimedKey, weaponClass, context)
--       Server check that the client's claim matches the server's chain.
--       Returns (move, isAuthoritative).
--
--   CanCancelInto(move, elapsed, inputKind, bufferWindow)
--       The cancel-window predicate that makes chains feel continuous.

local CombatMovesets = require(script.Parent.Parent:WaitForChild('Data'):WaitForChild('CombatMovesets'))

local Module = {}

local VALID_INPUTS = { L = true, H = true }

function Module.IsValidInput(kind: any): boolean
	return VALID_INPUTS[kind] == true
end

Module.Contexts = CombatMovesets.Contexts

----------------------------------------------------------------------
-- Class resolution. Rules, in order:
--   1. Both slots carry the same class AND a `Dual<X>` registry entry
--      exists -> use that. (Two daggers -> DualDagger.)
--   2. Both slots filled, no Dual variant -> heavy-slot class.
--   3. One slot -> that slot's class.
--   4. Neither -> DefaultClass.
--
-- Every input may be nil; lookups are defensive so combat never fails
-- closed on missing content.
----------------------------------------------------------------------
function Module.ResolveActiveClass(lightClass: string?, heavyClass: string?): string
	local fallback = CombatMovesets.DefaultClass or 'Sword'

	if typeof(lightClass) == 'string' and typeof(heavyClass) == 'string' then
		if lightClass == heavyClass then
			local dualKey = 'Dual' .. lightClass
			if CombatMovesets.HasClass(dualKey) then
				return dualKey
			end
			if CombatMovesets.HasClass(heavyClass) then return heavyClass end
			return fallback
		end
		-- Different classes in each slot: the heavy slot wins, matching
		-- the primary-weapon precedence the damage resolver uses.
		if CombatMovesets.HasClass(heavyClass) then return heavyClass end
		if CombatMovesets.HasClass(lightClass) then return lightClass end
		return fallback
	end

	if typeof(heavyClass) == 'string' and CombatMovesets.HasClass(heavyClass) then
		return heavyClass
	end
	if typeof(lightClass) == 'string' and CombatMovesets.HasClass(lightClass) then
		return lightClass
	end
	return fallback
end

----------------------------------------------------------------------
-- Context resolution.
--
-- Precedence is deliberate: a perfect-evade counter outranks being
-- airborne, because the counter is a one-shot reward the player earned
-- and it should never be silently swallowed by an air state that a
-- launcher happened to leave set.
----------------------------------------------------------------------
function Module.ResolveContext(isAirborne: boolean?, hasCounter: boolean?): string
	if hasCounter then
		return CombatMovesets.Contexts.DodgeCounter
	end
	if isAirborne then
		return CombatMovesets.Contexts.Air
	end
	return CombatMovesets.Contexts.Ground
end

----------------------------------------------------------------------
-- Move lookup.
----------------------------------------------------------------------
function Module.GetMove(weaponClass: string?, context: string?, comboKey: string?)
	return CombatMovesets.ResolveMove(weaponClass, context, comboKey)
end

-- Resolve the move a ComboString should land. Returns
-- (key, move, finalLetter). Never returns nil in any slot.
function Module.ResolveComboKey(comboString: { string }?, weaponClass: string?, context: string?)
	if typeof(comboString) ~= 'table' or #comboString == 0 then
		return 'L', CombatMovesets.ResolveMove(weaponClass, context, 'L'), 'L'
	end
	local key = table.concat(comboString)
	return key,
		CombatMovesets.ResolveMove(weaponClass, context, key),
		comboString[#comboString]
end

----------------------------------------------------------------------
-- Chain bookkeeping.
--
-- Append a letter and canonicalise. The chain resets to a single letter
-- when the cap is exceeded; a finisher does NOT reset here because the
-- swing that FIRES the finisher needs the full key. Callers clear their
-- stored chain after dispatching a finisher move.
--
-- Pure: the input array is never mutated.
----------------------------------------------------------------------
function Module.AppendInput(comboString: { string }?, kind: string, maxLength: number?, weaponClass: string?, context: string?): { string }
	if not VALID_INPUTS[kind] then
		return comboString or {}
	end
	maxLength = maxLength or 4

	local candidate = {}
	for _, letter in comboString or {} do
		candidate[#candidate + 1] = letter
	end
	candidate[#candidate + 1] = kind

	if #candidate > maxLength then
		return { kind }
	end

	-- Air chains are short by design: the victim is falling and the
	-- window to reconnect is small, so an air string that runs past the
	-- authored keys restarts rather than degrading to a generic hit.
	if context == CombatMovesets.Contexts.Air
		and not CombatMovesets.HasAuthoredMove(weaponClass, context, table.concat(candidate)) then
		return { kind }
	end

	return candidate
end

function Module.IsFinisherKey(key: string, weaponClass: string?, context: string?): boolean
	local move = CombatMovesets.ResolveMove(weaponClass, context, key)
	return move.IsFinisher == true
end

----------------------------------------------------------------------
-- Cancel windows.
--
-- `CancelFrom` is a fraction of the move's total duration. An input is
-- allowed once `elapsed >= Total * CancelFrom[kind]`. `bufferWindow`
-- (CombatConfig.COMBO_BUFFER) lets an input that lands slightly early
-- still count, which is what turns a mashed chain into a fluid one
-- instead of dropping presses on the floor.
--
-- Returns (allowed, secondsUntilAllowed). A caller that gets
-- allowed=false with a small remainder should BUFFER the input rather
-- than reject it.
----------------------------------------------------------------------
function Module.GetCancelPoint(move: any, inputKind: string): number
	if typeof(move) ~= 'table' then return math.huge end
	local fractions = move.CancelFrom
	if typeof(fractions) ~= 'table' then return math.huge end
	local fraction = fractions[inputKind]
	if typeof(fraction) ~= 'number' then return math.huge end
	return (move.Total or 0) * fraction
end

function Module.CanCancelInto(move: any, elapsed: number, inputKind: string, bufferWindow: number?): (boolean, number)
	local point = Module.GetCancelPoint(move, inputKind)
	if point == math.huge then
		return false, math.huge
	end
	local threshold = point - (bufferWindow or 0)
	if elapsed >= threshold then
		return true, 0
	end
	return false, threshold - elapsed
end

----------------------------------------------------------------------
-- Server validation.
--
-- Compares the client's claimed combo key against the server's tracked
-- chain in the same class and context. The server's chain is always
-- what actually executes; the claim only decides whether this swing is
-- allowed to produce finisher-only effects.
--
-- Returns (move, isAuthoritative). isAuthoritative=false means the
-- claim drifted or was forged, so callers must suppress finisher VFX,
-- launcher lift and finisher payloads while still letting the swing
-- resolve as a normal hit.
----------------------------------------------------------------------
function Module.ValidateClaim(serverComboString: { string }, claimedKey: any, weaponClass: string?, context: string?)
	local serverKey = table.concat(serverComboString)
	local move = CombatMovesets.ResolveMove(weaponClass, context, serverKey)
	if typeof(claimedKey) == 'string' and serverKey == claimedKey then
		return move, true
	end
	return move, false
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/DialogueShared"><![CDATA[-- DialogueShared — runtime helpers for the dialogue system.
--
-- Currently scoped to the talking-sounds stub: when a dialogue line
-- displays, the widget calls PlayTalkingSound(npcId, ...) so the
-- character's voice / mouth-blip plays alongside the text reveal.
-- The stub plays a single SFX via SoundService; future work hooks
-- per-syllable cadence + lip-flap when art lands.
--
-- Registry contract:
--   Module.TalkingSounds[npcId] = {
--     Sfx: string,                    -- rbxassetid
--     Properties: { … },              -- optional defaults (Volume,
--                                       PlaybackSpeed, RollOffMode, etc.)
--   }
--
-- `PlayTalkingSound(npcId, sfxOverride?, propsOverride?)`:
--   * Resolves Sfx from override → registry default → fallback id.
--   * Merges Properties: registry defaults + propsOverride (override
--     wins). Same keys map directly onto the Sound instance.
--   * Plays positional at the NPC's HRP if it can be resolved via
--     CollectionService('DialogueNPC') with the matching DialogueId
--     attribute; otherwise plays at the camera (fallback).
--
-- Authoring a per-NPC voice:
--   DialogueShared.TalkingSounds.tutor_onboarding = {
--     Sfx = 'rbxassetid://9114015882',
--     Properties = { Volume = 0.4, PlaybackSpeed = 1.05 },
--   }
-- The widget passes the dialogue-id as the npcId, so this looks up
-- under the same id the dialogue tree is keyed by.

local Players = game:GetService('Players')
local CollectionService = game:GetService('CollectionService')
local Debris = game:GetService('Debris')

local Module = {}

----------------------------------------------------------------------
-- Registry. Each entry maps a dialogue / npc id to its talking sound
-- defaults. Authors append entries here; runtime reads via
-- ResolveTalkingSound. Empty registry → every line uses
-- DEFAULT_TALKING_SOUND_ID at default props.
----------------------------------------------------------------------
export type TalkingSoundConfig = {
	Sfx: string,
	Properties: { [string]: any }?,
}

local DEFAULT_TALKING_SOUND_ID = 'rbxassetid://9114015882'

Module.TalkingSounds = {
	-- Tutor — calm, mid-pitch tone. Tunable per-line via the
	-- BuildDialogueDisplay TalkingSound override field.
	Tutor_Onboarding = {
		Sfx = 'rbxassetid://9114015882',
		Properties = { Volume = 0.4, PlaybackSpeed = 0.95 },
	},
} :: { [string]: TalkingSoundConfig }

-- Default props applied before per-NPC + per-call overrides. Tuned
-- to "voice-blip" rather than "music sting" — short, soft, positional.
local DEFAULT_PROPERTIES = {
	Volume = 0.35,
	PlaybackSpeed = 1.0,
	RollOffMode = Enum.RollOffMode.InverseTapered,
	RollOffMaxDistance = 60,
}

----------------------------------------------------------------------
-- Resolve + apply property merge order:
--   DEFAULT_PROPERTIES → registry.Properties → propsOverride
-- Each layer's keys win over the previous. Returns a flat table the
-- caller can iterate to set on a Sound instance.
----------------------------------------------------------------------
function Module.ResolveTalkingSound(npcId: string?, sfxOverride: string?, propsOverride: any?): (string, { [string]: any })
	local entry = (typeof(npcId) == 'string' and Module.TalkingSounds[npcId]) or nil
	local sfx = sfxOverride or (entry and entry.Sfx) or DEFAULT_TALKING_SOUND_ID
	local props: { [string]: any } = {}
	for k, v in DEFAULT_PROPERTIES do props[k] = v end
	if entry and typeof(entry.Properties) == 'table' then
		for k, v in entry.Properties do props[k] = v end
	end
	if typeof(propsOverride) == 'table' then
		for k, v in propsOverride do props[k] = v end
	end
	return sfx, props
end

----------------------------------------------------------------------
-- Locate a tagged DialogueNPC by its DialogueId attribute. Returns
-- the model's HRP-or-equivalent BasePart (positional play target),
-- or nil when no matching NPC is in scene.
----------------------------------------------------------------------
local function findNPCPart(npcId: string): BasePart?
	if typeof(npcId) ~= 'string' then return nil end
	for _, model in CollectionService:GetTagged('DialogueNPC') do
		if model:GetAttribute('DialogueId') == npcId then
			if model:IsA('Model') then
				local hrp = model:FindFirstChild('HumanoidRootPart')
				if hrp and hrp:IsA('BasePart') then return hrp :: BasePart end
				return model.PrimaryPart
			elseif model:IsA('BasePart') then
				return model :: BasePart
			end
		end
	end
	return nil
end

----------------------------------------------------------------------
-- Public entry point. Stub-tier: spawns a one-shot Sound, applies the
-- merged properties, plays it positional at the NPC (or camera as
-- fallback), debris-cleans on finish.
--
-- Future work:
--   * Per-syllable cadence — fire on a timer matched to TextLabel reveal
--   * Lip-flap on rigged NPC heads (animator + viseme map)
--   * Pitch jitter per-line so repeated lines don't sound mechanical
----------------------------------------------------------------------
function Module.PlayTalkingSound(npcId: string?, sfxOverride: string?, propsOverride: any?)
	local sfx, props = Module.ResolveTalkingSound(npcId, sfxOverride, propsOverride)
	local sound = Instance.new('Sound')
	sound.SoundId = sfx
	for k, v in props do
		-- Best-effort property write; pcall protects against typos
		-- (e.g. an override with `Volumee = …`).
		pcall(function() (sound :: any)[k] = v end)
	end
	local target = findNPCPart(npcId or '')
	if target then
		sound.Parent = target
	else
		-- Fall back to a camera-attached parent so the player still
		-- hears something even when the NPC isn't tagged in scene
		-- (cmdr-driven dialogue, debug widget).
		local camera = workspace.CurrentCamera
		sound.Parent = camera or workspace
	end
	sound:Play()
	-- 4s upper bound on lifetime — a typical voice blip is sub-second;
	-- the upper bound prevents leaks on a sound id that loops.
	Debris:AddItem(sound, math.max(2, sound.TimeLength + 0.5))
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/EnemyTelegraph"><![CDATA[-- EnemyTelegraph — shared types + remote action enum for the
-- "red outline on the ground that shows where an enemy is about to
-- attack" system. World-Zero / Dungeon-Heroes style: every committed
-- attack publishes a telegraph that draws the FULL hit volume, then
-- a progress bar fills as the windup ticks; when the bar fills the
-- damage actually applies. Players can read the timing visually and
-- dodge / interrupt the attack.
--
-- Three primitive shapes cover the common cases:
--   * Circle  — point-blank AOE. Origin + Radius.
--   * Rect    — line/box (charge attack, sword sweep). Origin's
--               LookVector defines the long axis; size = (width, _, length).
--   * Cone    — directional fan (cleave, breath). Origin's LookVector
--               defines the cone axis; (Radius, Angle).
--
-- Authoring:
--   local id = EnemyTelegraphServer.Show({
--       Kind = 'Rect',
--       Origin = boarCFrame,
--       Size = Vector3.new(6, 0, 24),  -- 6-wide × 24-deep
--       Duration = 0.6,                -- match the windup
--   })
--   task.wait(0.6)
--   EnemyTelegraphServer.Hide(id)      -- (auto-hides at Duration too)
--
-- Server doesn't render anything itself — it just announces the
-- telegraph parameters to all clients via the EnemyTelegraphEvent
-- remote, and clients render the local visual. That keeps the network
-- payload small (one event with a handful of fields) and lets each
-- client tune its own visual fidelity (e.g. high-perf devices could
-- render a particle decal too).

local Module = {}

----------------------------------------------------------------------
-- Action enum carried on the EnemyTelegraphEvent remote.
----------------------------------------------------------------------
Module.Actions = {
	Show = 1,  -- payload: { Id, Kind, Origin, Size, Radius?, Angle?, Duration, Color? }
	Hide = 2,  -- payload: { Id }
}

----------------------------------------------------------------------
-- Telegraph shapes.
----------------------------------------------------------------------
Module.Kinds = {
	Circle = 'Circle',
	Rect   = 'Rect',
	Cone   = 'Cone',
}

----------------------------------------------------------------------
-- Default visual tokens. Clients import these so a centralized palette
-- shift (e.g. switching from red to amber for "telegraphed but
-- non-damaging") is one edit. Per-call Color override on the Show
-- payload always wins.
----------------------------------------------------------------------
Module.Defaults = {
	-- Red-orange: high contrast against the world, distinguishes from
	-- ally outlines (cyan/green) and from environment hazards (purple).
	-- Slightly bright so the translucent fill is still readable through
	-- foliage and over light terrain.
	Color = Color3.fromRGB(232, 60, 78),
	-- The progress bar fills over the windup duration; when it reaches
	-- 1.0 the damage hit lands. Capped at 0..1.
	BarColor = Color3.fromRGB(255, 220, 130),
}

----------------------------------------------------------------------
-- Geometry helpers — shared between the renderer (client visual
-- placement) and the runtime hit predicate (server damage zone) so
-- both sides apply the SAME forward offset and the player's contract
-- ("the red zone IS the hit zone") stays intact.
--
-- HorizontalForward — flattens a CFrame's LookVector to the horizontal
-- plane and re-normalizes. Falls back to world +Z if the projection
-- is degenerate (vertical-up pivot). Used to project an attacker's
-- pivot into a stable yaw direction regardless of model tilt.
function Module.HorizontalForward(cf: CFrame): Vector3
	local lv = cf.LookVector
	local horiz = Vector3.new(lv.X, 0, lv.Z)
	if horiz.Magnitude < 1e-3 then return Vector3.zAxis end
	return horiz.Unit
end

-- ForwardOffset — translate a CFrame's position forward by `distance`
-- along its horizontal LookVector. Rotation preserved. The Rect/Cone
-- visual + hit zone are pushed forward by `Size.Z` (or `Radius`) via
-- this helper so neither overlaps the attacker's body.
function Module.ForwardOffset(cf: CFrame, distance: number): CFrame
	return cf + Module.HorizontalForward(cf) * distance
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/SkillRuntime"><![CDATA[-- SkillRuntime — shared types + helpers for the unified skill /
-- ability runtime. ONE engine drives every combat skill in the game:
-- player skills (skill tree → triggerable), mob attacks (Generic
-- AttackNearbyTarget, Boar dash), and boss patterns (per-phase
-- attack rotations). Each is described as a `Recipe` — an ordered
-- list of `Step`s — and dispatched server-side by SkillRuntimeServer.
--
-- Vocabulary:
--   * Recipe : ordered list of Steps + metadata (cooldown, target
--              acquisition mode, optional cinematic hooks).
--   * Step   : one atomic action. Step.Kind selects the executor
--              branch on the server.
--   * Caster : runtime "who's doing this" — a player or AI mob.
--              Carries the Model + Humanoid + LookCFrame so each
--              Step can resolve absolute positions.
--
-- Why one runtime for everyone:
--   * Telegraph + status-effect + VFX systems are general — there's
--     no good reason a player skill telegraph differs from a boss
--     telegraph. Forcing both through the same engine keeps the
--     tuning surface (damage numbers, windups, hit volumes) entirely
--     in data files, not code.
--   * Authoring becomes "open Data/CombatSkills.luau, add an entry."
--     New skills require zero new server code unless they use a Step
--     kind that doesn't yet exist.
--
-- Skill tree vs runtime catalog:
--   * Data/Skills.luau   — UNLOCK metadata only: id, prereqs, cost,
--                          UI display, cooldown, hotbar bindability.
--                          Each entry references a RecipeId.
--   * Data/CombatSkills.luau — RUNTIME catalog (this module's
--                          consumer). Bosses / mobs reference these
--                          by id too — no parallel registry.

local Module = {}

----------------------------------------------------------------------
-- Step kinds. Each is the discriminator on the Step's `Kind` field.
-- See SkillRuntimeServer for the executor per-branch.
----------------------------------------------------------------------
Module.StepKinds = {
	-- A single telegraphed hit zone. Shows the attack telegraph for
	-- `Windup` seconds, then resolves damage + status effects on every
	-- humanoid inside the zone at impact.
	-- Args: { Telegraph = {Kind, Size?, Radius?, Angle?, Origin?='self'},
	--          Windup, Damage, Status?, Recovery? }
	TelegraphHit = 'telegraph_hit',

	-- Multiple simultaneous telegraphed hit zones at known offsets
	-- from the caster. Useful for ground-pound rings ("attack around"),
	-- multi-pillar spawns, etc. All zones share the same windup so they
	-- impact together.
	-- Args: { Telegraph (template), Offsets = {Vector3, ...},
	--          Windup, Damage, Status?, Recovery? }
	PositionalHits = 'positional_hits',

	-- A wave that travels along the caster's facing. Conceptually a
	-- moving Rect telegraph; we sample it as N successive sub-hits to
	-- approximate the sweep without a real moving collider.
	-- Args: { Width, Length, TravelDistance, TravelTime,
	--          Damage, Status?, Recovery? }
	Wave = 'wave',

	-- Apply a status effect to every humanoid inside a zone. NO direct
	-- damage — distinct from TelegraphHit because zero-damage
	-- "infliction-only" zones (slow trap, chill aura) need to skip the
	-- damage indicator broadcast and route through StatusEffectsRuntime
	-- only.
	-- Args: { Telegraph, Windup?, Status = {Id, Duration?, Potency?}, Recovery? }
	StatusZone = 'status_zone',

	-- Pure visual cue — particles, light flash, screen shake. NEVER
	-- applies damage or status. Server fires a remote; client renders.
	-- Args: { Cue = string id, Origin?='self', Duration?, Args? }
	Vfx = 'vfx',

	-- Explicit pause between steps. Useful for spacing telegraphs in a
	-- pattern (e.g. ground-slam → 0.4s breath → cleave).
	-- Args: { Seconds }
	Wait = 'wait',

	-- Play an animation on the caster's Humanoid. Animation id is
	-- looked up in the caster's loaded-animations dictionary
	-- (mob: AnimationService.LoadAnimationsDictionary; player: existing
	-- animation pipeline). Non-blocking by default; pass `WaitForFinish`
	-- to block.
	-- Args: { AnimationId, FadeTime?, Speed?, WaitForFinish? }
	Animation = 'animation',

	-- Fire an existing CinematicClient cue. Hooks the runtime into the
	-- cinematic system without bespoke surface (slow-mo, label,
	-- camera-to). Used for boss phase transitions / signature attacks.
	-- Args: { CueKind, Args = table }
	CinematicCue = 'cinematic_cue',

	-- Move the caster. Used by dash-style attacks (Boar). Arc is
	-- straight-line at WalkSpeed override, ending at offset relative
	-- to the windup pose's facing.
	-- Args: { Offset = Vector3, Speed, HitDuringMove? }
	Move = 'move',
}

----------------------------------------------------------------------
-- Telegraph origin enum. When a step references a telegraph (TelegraphHit,
-- PositionalHits, StatusZone) it can specify how the world position
-- is derived. Default 'caster' means "use the caster's pivot."
----------------------------------------------------------------------
Module.OriginModes = {
	Caster = 'caster',   -- caster:GetPivot() at step-start
	Target = 'target',   -- target's pivot (boss pinning a player)
	Fixed  = 'fixed',    -- explicit world CFrame baked into args
}

----------------------------------------------------------------------
-- Recipe targeting mode. Controls how SkillRuntimeServer.RunRecipe
-- resolves what counts as a "hit target" inside a zone.
----------------------------------------------------------------------
Module.TargetModes = {
	Hostiles = 'hostiles',  -- mobs hit players; players hit mobs.
	All      = 'all',       -- everything in zone (PvP-on, AOE).
	Self     = 'self',      -- the caster only (buffs).
	Players  = 'players',   -- player characters only.
	NPCs     = 'npcs',      -- AICharacter models only.
}

----------------------------------------------------------------------
-- Recipe schema (export typedef for IDE / reviewers).
----------------------------------------------------------------------
export type SkillStep = {
	Kind: string,            -- one of Module.StepKinds
	[any]: any,              -- step-kind-specific args (see comments above)
}

export type SkillRecipe = {
	Id: string,
	Name: string?,            -- display label (player skills surface this)
	TargetMode: string?,      -- default 'hostiles'
	Steps: { SkillStep },
	Cooldown: number?,        -- caller-side hint; runtime doesn't enforce
	Animation: string?,       -- caster animation played at recipe start
}

----------------------------------------------------------------------
-- Helpers.
----------------------------------------------------------------------
function Module.IsValidStepKind(kind: string): boolean
	for _, v in Module.StepKinds do
		if v == kind then return true end
	end
	return false
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/SkillTreeLayout"><![CDATA[-- // SkillTreeLayout.luau //
-- Auto-resolver for radial hex-grid skill trees.
--
-- Input  : a Tree { Nodes = { [id] = { depends = {string} } } } where each
--          node's `depends` lists the ids it requires to unlock. Empty
--          depends ⇒ root node.
-- Output : a Layout {
--            Positions = { [id] = { x, y, q, r, depth, angle } },
--            CanvasW, CanvasH,                 -- pixel extent (tight bbox + padding)
--            HexSize,                          -- center-to-corner radius
--          }
--
-- Layout pass (top-down, BFS frontier expansion):
--   1. Classify nodes by `depends`. Empty depends → root. First entry of
--      depends → primary parent (drives ring depth + angular placement).
--      Non-primary depends are still rendered as edges by the caller; here
--      they only affect placement if their primary chain doesn't reach a
--      root (cycle / orphan recovery).
--   2. BFS-style depth: depth(root) = 0, depth(child) = depth(parent) + 1.
--      Cycle guard caps depth at MAX_DEPTH so a malformed graph can't
--      stall the resolver.
--   3. Place every root in a circle around the center (ring 1 — the
--      center hex stays empty). N roots split 2π evenly starting from
--      12 o'clock, so a single root sits at the top and N roots fan
--      around clockwise at 360°/N intervals.
--   4+5. Per-depth INTERLEAVED allocate-then-snap pass. For each depth
--      layer (BFS frontier expansion):
--        a. Allocate target angles for this layer's nodes from their
--           parents' SNAPPED angles. For each parent at angle θ on
--           ring R, lay its children on ring R+1 alternating LEFT then
--           RIGHT of θ:
--              child[1] → θ - 0.5·step,    child[2] → θ + 0.5·step,
--              child[3] → θ - 1.5·step,    child[4] → θ + 1.5·step, …
--           A single child inherits the parent's angle exactly,
--           continuing the chain straight outward.
--        b. SLOT PLACEMENT — branch on depth:
--             * d == 0 (ROOT layer) → pick K/N evenly-spaced slot
--               indices on ring 1 and assign each root to its closest
--               pick. The orbit reads as N points spaced 360°/N apart,
--               which avoids the asymmetric snap drift that otherwise
--               turns evenly-distributed targets {-90°, 30°, 150°}
--               into a lopsided actual {-60°, 0°, 120°} (all 30°
--               in the same direction).
--             * d >= 1 (DESCENDANT layers) → nearest-free-slot snap
--               per node. Single-child chains stay perfectly radial
--               because each child inherits the parent's snapped
--               angle and outer rings have hex slots at finer
--               intervals (30°/20°/15° on rings 2/3/4) that include
--               the root angles as exact multiples — zero further
--               drift. Branching layers get the same snap; the L/R
--               fan from step 4a places sibling clusters at
--               contiguous angles which then snap to contiguous slots.
--           Why descendant layers DON'T also even-distribute: forcing
--           N nodes 360°/N apart at a deep ring breaks chain
--           straightness when a chain doesn't fit the layer's
--           preferred angles (e.g. with 2 nodes at depth 3, even-
--           distribution puts them 180° apart, which means one chain
--           gets dragged across the canvas to its antipode).
--           Collisions in the snap path spill to the next ring if a
--           ring is fully claimed (>6R nodes at one depth).
--        c. Overwrite each placed node's `angle` with the post-snap
--           ACTUAL angle (atan2 of the unit-axial pixel position) so
--           the next depth's children inherit the true radial direction
--           — without this, single-child chains visibly kink because
--           parent snaps off the target angle while children still aim
--           at the original target.
--   6. Translate so the bbox top-left lands at (Padding, Padding); report
--      the canvas extent so the caller can size its scrolling frame.
--
-- Hex coordinate convention: pointy-top, axial (q, r). Conversion:
--   x = size * sqrt(3) * (q + r/2)
--   y = size * 1.5 * r
-- This matches Red Blob Games' standard pointy-top axial system.

local Module = {}

export type Node = {
	depends: { string },
}

export type Tree = {
	Nodes: { [string]: Node },
}

export type Resolved = {
	x: number,        -- pixel center after bbox translation
	y: number,
	q: number,        -- axial column
	r: number,        -- axial row
	depth: number,    -- 0 = roots
	angle: number,    -- radians from +X (informational; useful for label rotation, etc.)
}

export type Layout = {
	Positions: { [string]: Resolved },
	CanvasW: number,
	CanvasH: number,
	HexSize: number,
}

export type Options = {
	HexSize: number?,         -- center-to-corner radius (pointy-top). Default 48.
	Spread: number?,          -- placement-radius multiplier on HexSize. >1 → tiles
	                          -- have gaps between them; =1 → tiles touch. Default 1.5.
	Padding: number?,         -- pixel pad on each side of the bbox. Default 80.
}

----------------------------------------------------------------------
-- Hex math.
----------------------------------------------------------------------
local SQRT3 = math.sqrt(3)
local MAX_DEPTH = 12              -- cycle / pathological-graph guard

-- Pointy-top axial → pixel. Returns CENTER pixel of the hex tile.
local function axialToPixel(q: number, r: number, size: number): (number, number)
	return size * SQRT3 * (q + r / 2), size * 1.5 * r
end
Module.axialToPixel = axialToPixel

-- The 6 unit-step axial directions for pointy-top hexes (Red Blob Games
-- convention). Indexed 0..5 → [1..6] with Lua 1-based tables.
local HEX_DIRS = {
	{ 1, 0 }, { 1, -1 }, { 0, -1 }, { -1, 0 }, { -1, 1 }, { 0, 1 },
}

-- The 6R hex axial coordinates that lie on ring `radius` (radius >= 1),
-- walked CLOCKWISE in Roblox screen space starting from the slot one step
-- "below-left" of the +x axis corner. The resulting sequence is angularly
-- monotonic, which the snap step below relies on (well, the snap reads
-- per-slot atan2 directly, so this only matters for deterministic order).
local function ringSlots(radius: number): { { number } }
	if radius <= 0 then return { { 0, 0 } } end
	local slots = {}
	-- Standard: start at HEX_DIRS[5] scaled by radius, then walk dirs 1..6
	-- for `radius` steps each.
	local q = HEX_DIRS[5][1] * radius
	local r = HEX_DIRS[5][2] * radius
	for side = 1, 6 do
		local d = HEX_DIRS[side]
		for _ = 1, radius do
			table.insert(slots, { q, r })
			q = q + d[1]
			r = r + d[2]
		end
	end
	return slots
end
Module.ringSlots = ringSlots

-- Unsigned angular distance on the unit circle, in [0, π].
local function angDist(a: number, b: number): number
	local d = (a - b + math.pi) % (2 * math.pi) - math.pi
	return math.abs(d)
end

----------------------------------------------------------------------
-- Resolver.
----------------------------------------------------------------------
function Module.resolve(tree: Tree, options: Options?): Layout
	local opts = options or {}
	local hexSize = opts.HexSize or 48
	local spread = opts.Spread or 1.5
	local padding = opts.Padding or 80

	local nodes = (tree and tree.Nodes) or {}

	-- Stable id list — Lua hash-table iteration order isn't deterministic,
	-- so we sort once and use the sorted list for every later pass that
	-- iterates "all nodes". Without this, root assignment to the
	-- "12-o'clock" slot and the L/R alternation order would shift on
	-- every reload, even with identical input data.
	local allIds: { string } = {}
	for id in nodes do table.insert(allIds, id) end
	table.sort(allIds)

	-- Step 1: classify. primaryParent = depends[1]; fall back to nil for
	-- roots and for ids whose first dep doesn't exist in the tree (treat
	-- the latter as a root too — better than crashing on a typo).
	local primaryParent: { [string]: string? } = {}
	local children: { [string]: { string } } = {}
	local roots: { string } = {}
	for _, id in allIds do
		local deps = nodes[id].depends
		local parent: string? = nil
		if deps and #deps > 0 then
			local first = deps[1]
			if nodes[first] then parent = first end
		end
		primaryParent[id] = parent
		if not parent then
			table.insert(roots, id)
		else
			children[parent] = children[parent] or {}
			table.insert(children[parent], id)
		end
	end
	-- Deterministic ordering of children so sibling angular slots are stable.
	for _, kids in children do table.sort(kids) end

	-- Step 2: depth via memoized recursion. Cycle guard via `seen` set.
	local depth: { [string]: number } = {}
	local function depthOf(id: string, seen: { [string]: boolean }?): number
		if depth[id] then return depth[id] end
		local p = primaryParent[id]
		if not p then depth[id] = 0; return 0 end
		seen = seen or {}
		if seen[id] then depth[id] = 0; return 0 end  -- cycle: treat as root
		seen[id] = true
		local d = depthOf(p, seen) + 1
		if d > MAX_DEPTH then d = MAX_DEPTH end
		depth[id] = d
		return d
	end
	for _, id in allIds do depthOf(id) end

	-- Step 3: BFS frontier angular allocation, INTERLEAVED with snap.
	--
	-- Roots first: target angles distributed evenly around the center on
	-- RING 1 (the center hex stays empty by design). Single root → -π/2
	-- (top); N roots → 360°/N intervals starting at -π/2 and progressing
	-- clockwise. Stable-sorted root order means the alphabetically-first
	-- root always lands at 12 o'clock, regardless of nodes-table iteration.
	local angle: { [string]: number } = {}
	local rootRing = 1                       -- ALL roots sit on ring 1; center stays empty

	do
		local nRoots = #roots
		if nRoots == 1 then
			angle[roots[1]] = -math.pi / 2
		elseif nRoots > 1 then
			local step = 2 * math.pi / nRoots
			for i, id in roots do
				angle[id] = -math.pi / 2 + (i - 1) * step
			end
		end
	end

	-- Children: walk depth layers in ascending order so each parent's
	-- SNAPPED angle is known before its children are placed. For each
	-- parent at angle θ on ring R, lay its children on ring R+1
	-- alternating LEFT then RIGHT of θ.
	--
	--   1 child  → child[1] at θ              (continuation; chain stays radial)
	--   2 kids   → child[1] θ - 0.5·step, child[2] θ + 0.5·step
	--   3 kids   → θ - 0.5·step, θ + 0.5·step, θ - 1.5·step
	--   4 kids   → … θ - 1.5·step, θ + 1.5·step
	--   N kids   → child[i] = θ + side · ((i+1)/2 - 0.5)·step,
	--                where side = -1 for odd i, +1 for even i.
	--
	-- step = π / (3·childRing) is the angular WIDTH of one hex slot at
	-- the child ring (since ring R has 6R slots over 2π). Children aim
	-- at adjacent slots; the snap step picks the actual hex coordinates
	-- and spills outward if a slot is taken (>6R nodes near the same θ).
	--
	-- CRITICAL: after a parent is snapped to its real hex slot, we
	-- OVERWRITE angle[parent] with the snapped position's actual angle
	-- (atan2 of the axial-pixel position). Children then inherit the
	-- TRUE radial direction, not the original target angle — without
	-- this, single-child chains visibly kink because parent snaps to a
	-- slot off the target angle (e.g. target 150° but ring 1 only has
	-- slots at 120° and 180°) while children still aim at the original
	-- target. With the overwrite, chains stay perfectly radial after
	-- snap and parent→child connection lines read as straight outward.
	local byDepth: { [number]: { string } } = {}
	for _, id in allIds do
		local d = depth[id] or 0
		byDepth[d] = byDepth[d] or {}
		table.insert(byDepth[d], id)
	end

	-- Snap helpers — used inside the per-depth interleaved pass below.
	-- takenByRing tracks slot keys already claimed on each ring;
	-- nearestFreeSlot walks the candidate list (sorted by angular
	-- distance to the target) until it finds an unclaimed one, then
	-- spills to ring R+1 if the entire ring is full.
	local takenByRing: { [number]: { [string]: boolean } } = {}
	local function slotKey(q: number, r: number): string
		return q .. ',' .. r
	end

	local function nearestFreeSlot(ringR: number, targetAngle: number): (number, number)
		if ringR == 0 then
			takenByRing[0] = takenByRing[0] or {}
			local k = slotKey(0, 0)
			if not takenByRing[0][k] then
				takenByRing[0][k] = true
				return 0, 0
			end
			return nearestFreeSlot(1, targetAngle)
		end
		local slots = ringSlots(ringR)
		-- Score each slot by angular distance to targetAngle.
		local scored = table.create(#slots)
		for i, s in slots do
			local sx, sy = axialToPixel(s[1], s[2], 1)
			local a = math.atan2(sy, sx)
			scored[i] = { idx = i, diff = angDist(a, targetAngle) }
		end
		table.sort(scored, function(a, b) return a.diff < b.diff end)
		takenByRing[ringR] = takenByRing[ringR] or {}
		for _, entry in scored do
			local s = slots[entry.idx]
			local k = slotKey(s[1], s[2])
			if not takenByRing[ringR][k] then
				takenByRing[ringR][k] = true
				return s[1], s[2]
			end
		end
		-- Ring full (>6R nodes at this depth): spill to next ring at the
		-- same target angle. MAX_DEPTH cap above plus this spill keep the
		-- recursion bounded.
		return nearestFreeSlot(ringR + 1, targetAngle)
	end

	local axialPos: { [string]: { number } } = {}

	-- Helper: place `sortedLayer` on `ring` with EVENLY-DISTRIBUTED slot
	-- picks. Used for sparse layers (no parent has 2+ children) so the
	-- ring reads as a clean orbit of N points spaced 360°/N apart, not
	-- a lopsided cluster from snap drift.
	--
	-- Algorithm:
	--   1. Find startIdx = ring slot whose angle is closest to the first
	--      sorted node's target. This anchors the even-pick rotation so
	--      the distribution lines up with the (already-evenly-distributed)
	--      parent layer when chains are radial.
	--   2. Pick N slot indices step = K/N apart (where K = 6·ring is the
	--      total ring slot count). With K = m·N this lands on exactly
	--      evenly-spaced slots; with non-integer K/N, math.floor + 0.5
	--      gives the best-rounded approximation.
	--   3. Assign each node (in sorted-target-angle order) to its closest
	--      unassigned picked slot. With evenly-spaced picks and
	--      monotonic-angle nodes, this is 1:1 in order in the common case.
	--   4. Overwrite angle with snapped position so children inherit the
	--      true radial direction (same invariant as the branching path).
	--
	-- Falls back to nearestFreeSlot if N > K (more nodes than slots);
	-- the caller still wraps spill via the snap helper.
	local function placeEvenlyOnRing(sortedLayer: { string }, ring: number)
		local slots = ringSlots(ring)
		local K = #slots
		local N = #sortedLayer
		if N == 0 then return end
		if N > K then
			-- Overflow: fall back to one-by-one nearest-free-slot snap.
			for _, id in sortedLayer do
				local q, r = nearestFreeSlot(ring, angle[id] or 0)
				axialPos[id] = { q, r }
				local px, py = axialToPixel(q, r, 1)
				angle[id] = math.atan2(py, px)
			end
			return
		end

		local firstAngle = angle[sortedLayer[1]] or -math.pi / 2
		local startIdx, startDiff = 1, math.huge
		for i, s in slots do
			local sx, sy = axialToPixel(s[1], s[2], 1)
			local a = math.atan2(sy, sx)
			local diff = angDist(a, firstAngle)
			if diff < startDiff then
				startDiff = diff
				startIdx = i
			end
		end

		local stepSlots = K / N
		local pickedSlots = table.create(N)
		for i = 0, N - 1 do
			local idx = (math.floor((startIdx - 1) + i * stepSlots + 0.5)) % K + 1
			pickedSlots[i + 1] = slots[idx]
		end

		local pickAssigned: { [number]: boolean } = {}
		takenByRing[ring] = takenByRing[ring] or {}
		for _, id in sortedLayer do
			local target = angle[id] or 0
			local bestI, bestDiff = nil, math.huge
			for i, s in pickedSlots do
				if not pickAssigned[i] then
					local sx, sy = axialToPixel(s[1], s[2], 1)
					local a = math.atan2(sy, sx)
					local diff = angDist(a, target)
					if diff < bestDiff then
						bestDiff = diff
						bestI = i
					end
				end
			end
			if bestI then
				pickAssigned[bestI] = true
				local s = pickedSlots[bestI]
				takenByRing[ring][slotKey(s[1], s[2])] = true
				axialPos[id] = { s[1], s[2] }
				local px, py = axialToPixel(s[1], s[2], 1)
				angle[id] = math.atan2(py, px)
			end
		end
	end

	-- Step 4 + 5 interleaved: for each depth layer, (1) compute target
	-- angles for non-root nodes from their parents' SNAPPED angles, then
	-- (2) place this layer.
	--
	-- Placement strategy:
	--   * d == 0 (roots) → EVEN-DISTRIBUTE around ring 1. Picks K/N
	--     evenly-spaced slot indices so the root layer reads as a
	--     clean orbit of N points spaced 360°/N apart, free of the
	--     asymmetric snap drift that otherwise turns evenly-distributed
	--     targets {-90°, 30°, 150°} into a lopsided actual {-60°, 0°,
	--     120°} (all drift 30° in the same direction).
	--   * d >= 1 → nearest-free-slot snap per node. Single-child chains
	--     stay perfectly radial because each child inherits the parent's
	--     SNAPPED angle and rings 2-4 have hex slots at finer intervals
	--     (30°/20°/15°) that include the root angles as exact multiples.
	--     Branching layers get the same snap; the L/R fan from step 1
	--     places sibling clusters at contiguous angles which then snap
	--     to contiguous slots.
	--
	-- Why descendant layers DON'T also even-distribute: forcing N nodes
	-- 360°/N apart at a deep ring breaks chain straightness when a chain
	-- doesn't fit the layer's preferred angles. With 2 nodes at depth 3,
	-- even-distribution puts them 180° apart, which means one chain
	-- (e.g. lightning_strike on the 180° radial) gets dragged to -120°,
	-- bending the visual chain at the very last tier. Letting descendants
	-- inherit parent angles preserves chain straightness; ring symmetry
	-- emerges naturally because the ROOT layer is already symmetric.
	for d = 0, MAX_DEPTH do
		local layer = byDepth[d]
		if not layer then continue end

		-- (1) Allocate target angles for this layer's children (skipped
		-- for d=0 since root targets are already set above).
		if d > 0 then
			local parentLayer = byDepth[d - 1] or {}
			for _, parentId in parentLayer do
				local kids = children[parentId]
				if not kids or #kids == 0 then continue end
				local parentAngle = angle[parentId] or 0  -- already SNAPPED last iteration
				local childRing = rootRing + d
				local step = math.pi / (3 * childRing)
				if #kids == 1 then
					-- Single child continues the chain straight outward
					-- from the parent's actual snapped position.
					angle[kids[1]] = parentAngle
				else
					for i, kidId in kids do
						local pairIdx = math.floor((i - 1) / 2) + 1   -- 1,1,2,2,3,3,…
						local side = (i % 2 == 1) and -1 or 1          -- L,R,L,R,…
						angle[kidId] = parentAngle + side * (pairIdx - 0.5) * step
					end
				end
			end
		end

		-- (2) Sort by target angle so adjacent positions claim adjacent
		-- slots in either placement strategy.
		local sortedLayer = table.clone(layer)
		table.sort(sortedLayer, function(a, b)
			local aa, ba = angle[a] or 0, angle[b] or 0
			if aa ~= ba then return aa < ba end
			return a < b
		end)

		local ring = (d == 0) and rootRing or (rootRing + d)
		if d == 0 then
			-- Root layer: even-distribute so the root orbit is symmetric.
			placeEvenlyOnRing(sortedLayer, ring)
		else
			-- Descendant layer: nearest-free-slot snap, one node at a
			-- time. Preserves chain straightness — each child lands at
			-- (or very close to) its parent's snapped angle since the
			-- inner-ring snap drift doesn't propagate through the finer
			-- outer rings.
			for _, id in sortedLayer do
				local q, r = nearestFreeSlot(ring, angle[id] or 0)
				axialPos[id] = { q, r }
				local px, py = axialToPixel(q, r, 1)
				angle[id] = math.atan2(py, px)
			end
		end
	end

	-- Step 6: axial → pixel + bbox translation. Use `spread * hexSize` for
	-- placement so tile centers can be further apart than the rendered
	-- tile radius (gaps between hexes look cleaner than touching tiles).
	local placeSize = hexSize * spread
	local hexW = SQRT3 * hexSize        -- pointy-top tile width
	local hexH = 2 * hexSize            -- pointy-top tile height
	local minX, maxX = math.huge, -math.huge
	local minY, maxY = math.huge, -math.huge

	local resolved: { [string]: Resolved } = {}
	for _, id in allIds do
		local pos = axialPos[id]
		local px, py = axialToPixel(pos[1], pos[2], placeSize)
		resolved[id] = {
			x = px,
			y = py,
			q = pos[1],
			r = pos[2],
			depth = depth[id] or 0,
			angle = angle[id] or 0,
		}
		if px - hexW / 2 < minX then minX = px - hexW / 2 end
		if px + hexW / 2 > maxX then maxX = px + hexW / 2 end
		if py - hexH / 2 < minY then minY = py - hexH / 2 end
		if py + hexH / 2 > maxY then maxY = py + hexH / 2 end
	end

	if minX == math.huge then
		minX, maxX, minY, maxY = 0, 0, 0, 0
	end

	for _, r in resolved do
		r.x = r.x - minX + padding
		r.y = r.y - minY + padding
	end

	return {
		Positions = resolved,
		CanvasW = math.ceil((maxX - minX) + 2 * padding),
		CanvasH = math.ceil((maxY - minY) + 2 * padding),
		HexSize = hexSize,
	}
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/BossHealthbarShared"><![CDATA[-- BossHealthbarShared — the BossHealthbarEvent remote protocol.
--
-- BossServer (and any future boss-controller module) fires
-- BossHealthbarEvent with (action, payload) to drive the
-- BossHealthbarWidget without holding a direct reference. Both the
-- server (FireAllClients) and the widget (OnClientEvent) reference these
-- constants rather than the raw strings, so a rename is a single-site
-- change and a typo is a nil-index — not a silently dead branch.

local Module = {}

----------------------------------------------------------------------
-- Action discriminators carried as the first arg of every fire.
----------------------------------------------------------------------
export type BossHealthbarAction =
	  'SetBoss'
	| 'UpdateBar'
	| 'RemoveBar'
	| 'Close'

Module.Actions = {
	SetBoss   = 'SetBoss',   -- S→C: payload { Name, Bars = { {Id, Label?, CurrentHP, MaxHP}, ... } }
	UpdateBar = 'UpdateBar', -- S→C: payload { Id, CurrentHP }
	RemoveBar = 'RemoveBar', -- S→C: payload { Id }
	Close     = 'Close',     -- S→C: payload nil — tear the widget down
} :: { [string]: BossHealthbarAction }

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/ConfigReplicationShared"><![CDATA[-- ConfigReplicationShared — the ConfigReplicationEvent remote protocol.
--
-- The shared remote carries (category, action, ...) tuples. Every
-- per-system *ConfigReplicationServer fires one of these action
-- discriminators; the single ConfigReplicationClient dispatcher branches
-- on them. Both sides reference these constants rather than the raw
-- strings, so a rename is a single-site change and a typo is a nil-index
-- — not a silently dead branch.

local Module = {}

----------------------------------------------------------------------
-- Job discriminators carried as the SECOND arg of every fire (the first
-- is the category string). All are server → client.
----------------------------------------------------------------------
export type ConfigReplicationJob =
	  'Bundle'
	| 'Add'
	| 'Remove'

Module.Jobs = {
	Bundle = 'Bundle', -- S→C: full replace — bundle is the authoritative view ({ [id] = cfg })
	Add    = 'Add',    -- S→C: incremental append (id, cfg)
	Remove = 'Remove', -- S→C: drop a row (id)
} :: { [string]: ConfigReplicationJob }

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Services/CinematicTestShared"><![CDATA[-- CinematicTestShared — the CinematicTestEvent remote protocol (admin/Studio
-- debug tool driven by the F4 CinematicTestWidget).
--
-- The widget fires (action, id); CinematicTestServer dispatches on the action.
-- Previously each side kept its own hand-mirrored numeric enum with a "keep
-- aligned with the other" comment — this module is the single source of truth
-- so the two copies can't silently drift. The widget (client) can't require the
-- ServerStorage handler directly, hence a ReplicatedStorage Shared module.
--
-- Values are small integers — the existing wire format, preserved as-is. Luau
-- has no numeric-singleton types (you can't write `1 | 2` as a type), so the
-- exported type is `number`; the Actions dictionary below is the closed set of
-- valid values and the thing every site references.

local Module = {}

export type CinematicTestAction = number

----------------------------------------------------------------------
-- Action discriminators carried as the first arg of every fire (C→S).
-- The second arg is always a single string `id`; its meaning per action
-- is noted below.
----------------------------------------------------------------------
Module.Actions = {
	PlayCinematic = 1,  -- id = cinematic id (Data/Cinematics)
	OpenDialogue  = 2,  -- id = dialogue id (Data/Dialogue)
	RunRecipe     = 3,  -- id = recipe id from Data/CombatSkills
	TestTelegraph = 4,  -- id = 'circle' | 'rect' | 'cone'
	SpawnMob      = 5,  -- id = mob class id ('Boar' | 'BossBoar' | …)
	SetBossPhase  = 6,  -- id = phase index as string ('1' | '2' | '3')
} :: { [string]: CinematicTestAction }

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Utility"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="ReplicatedStorage/Modules/Utility/Hitbox"><![CDATA[-- Hitbox — `workspace:GetPartsInPart` wrapper for melee swings.
--
-- The shared `hitboxBlock` is reused across swings as the QUERY SHAPE.
-- `GetPartsInPart` automatically excludes the shape part from its
-- result set, so we don't need to filter it ourselves.
--
-- Critical: the shape part is persistent (parented to Terrain) so we
-- don't allocate a new BasePart per swing. Two flags MUST stay false:
--   * CanQuery = false → other raycasts / spatial queries in the
--     world must NOT see this part. With CanQuery=true, every
--     AI line-of-sight raycast, every other GetPartsInPart, every
--     ProximityPrompt, etc. has to consider this part — even when
--     it's parked between swings — adding a constant-per-frame
--     physics broadphase cost across the whole game.
--   * CanTouch = false → with CanTouch=true any other part
--     overlapping the part fires Touched events forever after the
--     last swing's CFrame. We do not use Touched semantics here;
--     `GetPartsInPart` is a one-shot query.
-- Setting both to false here was a real lag spike fix — combat hit
-- frames were stalling because the hitbox part was permanently
-- occupying the world's spatial index at its last-swing position.

local hitboxBlock = Instance.new('Part')
hitboxBlock.Name = 'HitboxQueryShape'
hitboxBlock.Color = Color3.new(1, 0, 0)
hitboxBlock.Transparency = 1            -- invisible — shape only
hitboxBlock.CanCollide = false
hitboxBlock.CanTouch   = false
hitboxBlock.CanQuery   = false
hitboxBlock.Anchored   = true
hitboxBlock.CastShadow = false
hitboxBlock.Massless   = true
hitboxBlock.Parent = workspace:WaitForChild('Terrain')

-- // Module // --
local Module = {}

function Module.GetHitboxResult(CF : CFrame, size : Vector3, overlap : OverlapParams?)
	-- Resize + reposition the shared shape, then run the spatial
	-- query. GetPartsInPart auto-excludes the shape itself, so the
	-- caller's OverlapParams.FilterDescendantsInstances doesn't have
	-- to list it.
	hitboxBlock.Size = size
	hitboxBlock.CFrame = CF
	return workspace:GetPartsInPart(hitboxBlock, overlap)
end

function Module.GetHitsInBox(partInstance, overlapParams)
	return workspace:GetPartsInPart(partInstance, overlapParams)
end

function Module.GetHitsInBounds(boundCFrame, boundSize, overlapParams)
	return workspace:GetPartBoundsInBox(boundCFrame, boundSize, overlapParams)
end

function Module.FindHumanoidsFromHits(hitParts)
	local Humanoids = {}
	for _, basePart in hitParts do
		local Humanoid = basePart.Parent:FindFirstChildWhichIsA("Humanoid")
		if not Humanoid then
			continue
		end
		if not table.find(Humanoids, Humanoid) then
			table.insert(Humanoids, Humanoid)
		end
	end
	return Humanoids
end

function Module.FindHumanoidsFromHitsWithFilter(hitParts, filterFunction)
	local Humanoids = {}
	for _, basePart in hitParts do
		local Humanoid = basePart.Parent:FindFirstChildWhichIsA("Humanoid")
		if not Humanoid then
			continue
		end
		if filterFunction and filterFunction(basePart) then
			continue
		end
		if not table.find(Humanoids, Humanoid) then
			table.insert(Humanoids, Humanoid)
		end
	end
	return Humanoids
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Utility/Table"><![CDATA[
-- // Module // --
local Module = {}

function Module.ArrayPopFirstOf( Array, Value )
	local index = table.find(Array, Value)
	if index then
		table.remove(Array, index)
	end
end

function Module.DictPopFirstOf( Dict, Value )
	for dictIndex, dictValue in Dict do
		if dictValue == Value then
			Dict[dictIndex] = nil
		end
	end
end

function Module.ShallowDeltaTable(old, new)
	local changed = { }
	for _, newValue in new do
		if not table.find(old, newValue) then
			changed[newValue] = true
		end
	end
	for _, oldValue in old do
		if not table.find(new, oldValue) then
			changed[oldValue] = false
		end
	end
	return changed
end

function Module.SetProperties(Parent, propertyTable)
	if typeof(propertyTable) == 'table' then
		for propertyName, propertyValue in propertyTable do
			Parent[propertyName] = propertyValue
		end
	end
	return Parent -- allows chaining of expressions and such
end

function Module.DeepCopy(value)
	if typeof(value) == "table" then
		local clone = {}
		for k,v in value do
			clone[Module.DeepCopy(k)] = Module.DeepCopy(v)
		end
		return clone
	end
	return value
end

-- DICTIONARY
function Module.CountDictionary( Dict )
	local count = 0
	for _, _ in Dict do
		count += 1
	end
	return count
end

function Module.GetDictionaryIndexes( Dict )
	local indexes = {}
	for i, _ in Dict do
		table.insert(indexes, i)
	end
	return indexes
end

function Module.GetRandomDictionaryIndex(Dict)
	local indexes = Module.GetDictionaryIndexes( Dict )
	return indexes[Random.new():NextInteger(1, #indexes)]
end

function Module.GetRandDictionaryValue(Dict)
	return Dict[ Module.GetRandDictionaryIndex(Dict) ]
end

function Module.RandomizeArray( arrayTable )
	local item = nil
	local rng = Random.new(os.time())
	for i = #arrayTable, 1, -1 do
		item = table.remove(arrayTable, rng:NextInteger(1, i))
		table.insert(arrayTable, item)
	end
end

-- Combine all arrays passed into this function into one singular table.
function Module.CombineArrays(...)
	local combined = {}
	local arrays = {...}
	for index = 1, #arrays do
		if typeof(arrays[index]) == 'table' and #arrays[index] > 0 then
			table.move(arrays[index], 1, #arrays[index], #combined + 1, combined)
		end
	end
	return combined
end

-- Combine all dictionaries passed into this function into one singular dictionary
-- Overlapping indexes outputs warnings
function Module.CombineDictionaries(...)
	local combined = {}
	for _, dictTbl in {...} do
		for index, val in dictTbl do
			if combined[index] then
				warn('Overlapping Index Found ; ', index)
				continue
			end
			combined[index] = val
		end
	end
	return combined
end

-- Returns integer/string, boolean
-- boolean determines if its an array (false) or dictionary (true)
function Module.FindValueInTable(SearchTable, Value)
	if #SearchTable > 0 then
		-- array
		return table.find(SearchTable, Value), false
	else
		-- dictionary
		for index, Val in SearchTable do
			if Val == Value then
				return index, true
			end
		end
	end
	return nil
end

-- OBJECTS -> TABLE // TABLE -> OBJECTS
local OT_Types = {
	['boolean'] = 'BoolValue',
	['string'] = 'StringValue',
	['number'] = 'NumberValue',
}

function Module.TableToObject(Tbl, Prnt, Ignores, Nst)
	Nst = Nst or 0
	if Nst > 30 then
		return
	end
	for k, v in Tbl do
		if Ignores and table.find(Ignores, tostring(k)) then
			continue
		end
		local valType = typeof(v)
		if valType == 'table' then
			local Fold = Instance.new('Folder')
			Fold.Name = tostring(k)
			Module.TableToObject(v, Fold, Ignores, Nst + 1)
			Fold.Parent = Prnt
		elseif typeof(k) == 'number' and valType == 'string' then
			local Fold = Instance.new('Folder')
			Fold.Name = v
			Fold.Parent = Prnt
		else
			local c = OT_Types[valType] or OT_Types['string']
			local val = Instance.new(c)
			val.Name = tostring(k)

			local success, _ = pcall(function()
				val.Value = v
			end)

			if not success then
				val.Value = tostring(v)
			end

			val.Parent = Prnt
		end
	end
	return Prnt
end

function Module.ObjectToTable(Prnt, Tbl)
	Tbl = Tbl or {}
	for _, child in Prnt:GetChildren() do
		if child:IsA('Folder') then
			Tbl[child.Name] = Module.ObjectToTable({}, child)
		else
			Tbl[child.Name] = child.Value
		end
	end
	return Tbl
end

function Module.TableToObjectSmart(data: {}, parent: Instance, ignore_index: {string}?, depth: number?)
	depth = depth or 0
	if depth > 30 then
		return
	end

	for k, v in data do
		if ignore_index and table.find(ignore_index, tostring(k)) then
			continue
		end
		if typeof(v) == 'table' then
			-- table (dictionary and array)
			local TargetFolder = parent:FindFirstChild(tostring(k))
			if not TargetFolder then
				TargetFolder = Instance.new('Folder')
				TargetFolder.Name = tostring(k)
				TargetFolder.Parent = parent
			end
			Module.TableToObjectSmart(v, TargetFolder, ignore_index, depth + 1)
		elseif typeof(k) == 'number' and typeof(v) == 'string' then
			-- array of strings
			if parent:FindFirstChild(tostring(k)) then
				continue
			end
			local Fold = Instance.new('Folder')
			Fold.Name = tostring(k)
			Fold.Parent = parent
		else
			-- create value
			local c = OT_Types[typeof(v)] or OT_Types['string']
			local valueObject = parent:FindFirstChild(tostring(k))
			if valueObject and valueObject.ClassName ~= c then
				valueObject:Destroy()
			end
			if not valueObject then
				valueObject = Instance.new(c)
				valueObject.Name = tostring(k)
				valueObject.Parent = parent
			end
			local success, _ = pcall(function()
				valueObject.Value = v
			end)
			if not success then
				valueObject.Value = tostring(v)
			end
		end
	end

	return parent
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Utility/UTC"><![CDATA[
local Module = {}

function Module.GetUTCTimestamp(): number
	return DateTime.fromUnixTimestamp(workspace:GetServerTimeNow()).UnixTimestamp
end

function Module.GetUTCTimestampText(): string
	local utcTime = Module.GetUTCTimestamp()
	return DateTime.fromUnixTimestamp(utcTime):ToIsoDate()
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Utility/Visualizers"><![CDATA[local Debris = game:GetService('Debris')

local function SetProperties(BaseInstance, Properties)
	if typeof(Properties) == 'table' then
		for propName : string, propValue : any in Properties do
			BaseInstance[propName] = propValue
		end
	end
end

local function SetDuration(BaseInstance, Duration)
	if typeof(Duration) == 'number' then
		Debris:AddItem(BaseInstance, Duration)
	end
end

-- //Module // --
local Module = {}

-- Set an Instance's properties through passing a table
function Module.SetProperties(BaseInstance, Properties)
	SetProperties(BaseInstance, Properties)
end

-- Create an Attachment at the position.
function Module.Attachment(Position, Duration)
	local Attachment = Instance.new('Attachment')
	Attachment.Name = 'VisualNode'
	Attachment.Visible = true
	Attachment.WorldPosition = Position
	Attachment.Parent = workspace.Terrain
	SetDuration(Attachment, Duration)
	return Attachment
end

-- Create a Beam at the position to the target position
local baseBeam = Instance.new('Beam')
baseBeam.Enabled = true
baseBeam.Width0 = 0.1
baseBeam.Width1 = 0.1
baseBeam.FaceCamera = true
baseBeam.LightInfluence = 0
baseBeam.Color = ColorSequence.new(Color3.new(1, 1, 1))
baseBeam.Brightness = 1
baseBeam.LightInfluence = 0
baseBeam.LightEmission = 0
baseBeam.Segments = 2
function Module.Beam(StartPosition, EndPosition, Duration, Properties)
	local NodeA = Module.Attachment(StartPosition, Duration)
	NodeA.Visible = false
	local NodeB = Module.Attachment(EndPosition, Duration)
	NodeB.Visible = false
	local newBeam = baseBeam:Clone()
	newBeam.Attachment0 = NodeA
	newBeam.Attachment1 = NodeB
	newBeam.Parent = NodeA
	SetProperties(newBeam, Properties)
	return newBeam
end

-- Create a Part at the position
local basePart = Instance.new('Part')
basePart.Transparency = 0.7
basePart.Anchored = true
basePart.CanCollide = false
basePart.CanQuery = false
basePart.CanTouch = false
basePart.CastShadow = false
basePart.Color = Color3.new(1,1,1)
basePart.Massless = true
function Module.BasePart(CF, Duration, Properties)
	local newPart = basePart:Clone()
	newPart.CFrame = CF
	newPart.Parent = workspace.Terrain
	SetProperties(newPart, Properties)
	SetDuration(newPart, Duration)
	return newPart
end

-- Create a SphereHandleAdornment at the position.
function Module.CircleNode(CF, Properties, Duration)
	local Node = Module.BasePart(CF, Duration)
	Node.Transparency = 1
	local Adornment : SphereHandleAdornment = Instance.new('SphereHandleAdornment')
	Adornment.Visible = true
	Adornment.Radius = 0.1
	Adornment.AlwaysOnTop = true
	Adornment.Transparency = 0.7
	Adornment.Adornee = Node
	Adornment.Parent = Node
	SetProperties(Adornment, Properties)
	return Adornment, Node
end

function Module.VisualizeUDim2(Position, Properties, Duration)

	local LocalPlayer : Player = game:GetService('Players').LocalPlayer
	local ScreenGui : ScreenGui = LocalPlayer.PlayerGui:FindFirstChild('Visuals')
	if not ScreenGui then
		ScreenGui = Instance.new('ScreenGui')
		ScreenGui.Name = 'Visuals'
		ScreenGui.ResetOnSpawn = false
		ScreenGui.IgnoreGuiInset = true
		ScreenGui.Parent = LocalPlayer.PlayerGui
	end

	local Frame : Frame = Instance.new('Frame')
	Frame.Name = 'Visualize'
	Frame.AnchorPoint = Vector2.new(0.5, 0.5)
	Frame.Size = UDim2.fromScale(0.05, 0.05)
	Frame.BorderSizePixel = 0
	Frame.Position = Position
	Instance.new('UIAspectRatioConstraint', Frame).AspectType = Enum.AspectType.ScaleWithParentSize

	SetProperties(Frame, Properties)
	SetDuration(Frame, Duration)
	Frame.Parent = ScreenGui

end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Utility/Character"><![CDATA[
local CharacterDataModule = require(script.Parent.Parent.Data.Character)

local ATTRIBUTE_NAME = "BASE_CUSTOMIZATION"

local function SetupCharacterAccessory(accessory: Instance)
	accessory.Name = ''
	for _, BasePart in accessory:GetDescendants() do
		if BasePart:IsA("BasePart") then
			BasePart.Anchored = false
			BasePart.CanCollide = false
			BasePart.CanTouch = false
			BasePart.CanQuery = false
			BasePart.Massless = true
		end
	end
end

local Module = {}

function Module.ClearBaseCustomizations(character: Instance)
	for _, item in character:GetChildren() do
		if item:GetAttribute(ATTRIBUTE_NAME) then
			item:Destroy()
		end
	end
	local head = character:FindFirstChild('Head')
	local face = head and head:FindFirstChildWhichIsA("Decal")
	if face and face:GetAttribute(ATTRIBUTE_NAME) then
		face:Destroy()
	end
end

function Module.ApplyBaseCustomizations(character: Instance, customization: {[string]: string})
	character:WaitForChild("Head", 1)

	for category, value in customization do
		-- update changed items
		local reference = CharacterDataModule.Customizations[ category ]
		local item = reference and reference:FindFirstChild( value )
		if not item then
			local msg = "Cannot find accessory %s for category %s"
			warn(string.format(msg, tostring(value), category))
			continue -- unable to equip it
		end
		if category == "Hair1" or category == "Hair2" then
			-- update accessories
			item = item:Clone()
			SetupCharacterAccessory(item)
			local constraint = Instance.new('RigidConstraint')
			constraint.Attachment0 = item.Handle.HairAttachment
			constraint.Attachment1 = character.Head.HairAttachment
			constraint.Parent = item.Handle
			item.Parent = character
			-- CharacterAccessoryMaidInstance:Give(Item)
		elseif category == "Face" then
			-- update face
			local old_face = character.Head:FindFirstChildWhichIsA("Decal")
			if old_face then
				old_face.Texture = item.Texture
			else
				old_face = item:Clone()
				old_face.Parent = character.Head
			end
		elseif category == "Clothes" then
			-- update shirt
			local shirt_source = item:FindFirstChildWhichIsA("Shirt")
			local shirt_destination = character:FindFirstChildWhichIsA("Shirt")
			if shirt_source and shirt_destination then
				shirt_destination.ShirtTemplate = shirt_source.ShirtTemplate
			elseif shirt_source and not shirt_destination then
				shirt_source:Clone().Parent = character
			end
			-- update pants
			local pants_source = item:FindFirstChildWhichIsA("Pants")
			local pants_destination = character:FindFirstChildWhichIsA("Pants")
			if pants_source and pants_destination then
				pants_destination.PantsTemplate = pants_source.PantsTemplate
			elseif pants_source and not pants_destination then
				pants_source:Clone().Parent = character
			end
		end
		item:SetAttribute(ATTRIBUTE_NAME, true)
	end
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Utility/Models"><![CDATA[
local Module = {}

function Module.WeldConstraint(p0 : BasePart, p1 : BasePart): WeldConstraint
	local weld = Instance.new('WeldConstraint')
	weld.Part0 = p0
	weld.Part1 = p1
	weld.Parent = p0
	return weld
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Utility/MoveTo"><![CDATA[
local RunService = game:GetService('RunService')

local SignalClass = require(script.Parent.Parent.Modules.Signal)

local DEFAULT_MOVE_TO_TIMEOUT = 4
local GOAL_DISTANCE_THREASHOLD = 3

local ACTIVE_MOVE_DATA = { }

local function IsDataCompleted(Data)
	-- timeout, success = false
	if time() > Data.Time then
		Data.Success = false
		Data.Reason = 1
		return true
	end

	-- humanoid died, success = false
	if Data.Humanoid.Health <= 0 then
		Data.Success = false
		Data.Reason = 2
		return true
	end

	-- is close enough (on the horziontal plane, excluding Y value), success = true
	local Delta = (Data.HumanoidRootPart:GetPivot().Position - Data.Position)
	if Vector2.new(Delta.X, Delta.Z).Magnitude < GOAL_DISTANCE_THREASHOLD then
		Data.Success = true
		Data.Reason = 3
		return true
	end

	-- active callback returned false, success = false
	if Data.ActiveCallback and Data.ActiveCallback(Data) == false then
		Data.Success = false
		Data.Reason = 4
		return true
	end

	-- is not completed yet
	return false
end

-- // Module // --
local Module = {}

function Module.MoveToLoop(Humanoid, HumanoidRootPart, Position, ActiveCallback)
	-- create a bindable to yield
	local Bindable = SignalClass.New()

	-- setup the MoveTo data for the RunService loop
	local Data = {
		Bindable = Bindable,

		HumanoidRootPart = HumanoidRootPart,
		Humanoid = Humanoid,
		Position = Position,
		ActiveCallback = ActiveCallback,

		Success = nil,
		Reason = -1,

		Time = time() + DEFAULT_MOVE_TO_TIMEOUT,
	}

	-- append it to the active moveto cache
	table.insert(ACTIVE_MOVE_DATA, Data)

	-- if it has not been completed yet
	if typeof(Data.Success) == 'nil' then
		-- yield until the moveto is completed
		Bindable:Wait()
	end

	-- destroy the bindable (prevent memory leak)
	Bindable:Destroy()

	-- return whether the MoveTo succeeded or timed out and for what reason
	-- REASON: 1 = timeout, 2 = humanoid died, 3 = goal reached, 4 = callback return false
	return Data.Success, Data.Reason
end

RunService.Heartbeat:Connect(function()
	local Terrain = workspace.Terrain
	if not Terrain then
		return
	end

	debug.profilebegin('MoveToHeartbeat')

	local index = 1
	while index <= #ACTIVE_MOVE_DATA do
		-- get the data at the index
		local Data = ACTIVE_MOVE_DATA[index]
		-- if its completed
		if IsDataCompleted(Data) then
			-- remove it from the active cache
			table.remove(ACTIVE_MOVE_DATA, index)
			-- complete the MoveTo yield
			Data.Bindable:Fire()
		else -- otherwise if not completed
			-- move the humanoid towards the point again
			Data.Humanoid:MoveTo(Data.Position, Terrain)
			-- increment the index for the next data
			index += 1
		end
	end

	debug.profileend()

end)

return Module

]]></Source>
		<Source path="ReplicatedStorage/Modules/Utility/CombatUtility"><![CDATA[-- // CombatUtility.luau //
-- Stateless math + config readers that bridge the new Items.luau schema
-- (post commit `redo-items-table`) to combat code paths. Lives in
-- ReplicatedStorage so both client and server can require it; server-only
-- helpers (UUID -> itemId resolution) self-degrade when the inventory
-- reference has not been registered.
--
-- Pure helpers (client + server safe):
--   * RollNumberRange / RollWeaponDamage / CalculateAttackDamage
--   * GetSlotAttachName       -- replaces removed `EquipData.BodyPart`
--   * SummarizeWeaponStats    -- builds a `Stats`-shaped table for tooltips
--   * GetItemTypeLabel        -- replaces removed `cfg.Type`
--
-- Server-augmented helpers:
--   * RegisterPlayerInventoryServer(playerInventoryServer)
--       Combat servers call this from their Init(otherSystems) so this
--       module can chase player UUID -> itemId via the existing cache.
--   * ResolveItemIdFromAttribute / ResolveWeaponConfig / ResolvePrimaryWeapon
--
-- Effect application:
--   * TryInflictEffects        -- iterates WeaponUsage.Inflicts and prints
--                                 a hand-off line per applied effect. The
--                                 real effect-runtime is TBD; this scaffold
--                                 makes the call site canonical so combat
--                                 doesn't need to know.

local Players = game:GetService('Players')
local RunService = game:GetService('RunService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

-- Dual-mode: Items migrated to per-player config replication — the
-- ReplicatedStorage shell is empty at boot. Server-side combat code
-- (damage calc, modifier application) reads cfg lookups via this
-- helper at high frequency, so a missed-id read against the shell
-- would silently zero-out damage. Server reads the canonical
-- ServerStorage copy; client reads the populated shell. See
-- ROADMAP.md §"Server reads the canonical copy."
local ItemsConfig do
	if RunService:IsServer() then
		local ServerStorage = game:GetService('ServerStorage')
		ItemsConfig = require(ServerStorage:WaitForChild('Modules'):WaitForChild('Data'):WaitForChild('Items'))
	else
		ItemsConfig = require(script.Parent.Parent.Data.Items)
	end
end
-- Hoisted to module scope: ApplyCompositionMultipliers runs in the
-- damage hot path. The previous in-function `require(...)` re-walked
-- WaitForChild on every swing — same footgun the combat-fixes commit
-- (61190c3) hoisted out of DamageModule.DamageHumanoid for the same
-- reason. Module is loaded once at first hit instead.
local EnchantsConfig = require(script.Parent.Parent.Data.Enchants)
-- Combo damage path also runs in the hot path. CombatShared can't be
-- required here (CombatShared requires us — would be a cycle), so the
-- caller passes the per-swing flags (comboEntry, perfectCounter, isPvP)
-- as arguments and CombatUtility just reads CombatConfig for scalars.
local CombatConfigModule = require(script.Parent.Parent.Data.CombatConfig)
-- ForgeShared exports ComputeActiveModifiers / ComputeStatDeltaSum.
-- Hoisted to module-load (same hot-path rationale as EnchantsConfig).
local ForgeShared = require(script.Parent.Parent.Services.ForgeShared)

-- // Module // --
local Module = {}

export type PrimaryWeaponResolution = {
	Config: any?,
	ItemId: string?,
	RawAttribute: any?,
	HandIndex: number?,
}

----------------------------------------------------------------------
-- Server-only registry for the inventory cache (lazy injection so this
-- module stays a leaf in the require graph).
----------------------------------------------------------------------

local PlayerInventoryServerRef = nil

function Module.RegisterPlayerInventoryServer(playerInventoryServer)
	PlayerInventoryServerRef = playerInventoryServer
end

-- Server-only injection — same pattern. StatusEffectsRuntime lives in
-- ServerStorage so this Replicated utility can't require it; the
-- server-side caller (any *Server.luau) calls this in Init to wire
-- the inflict pipeline. Client paths leave it nil and TryInflictEffects
-- gracefully degrades to its print-only behaviour.
local StatusEffectsRuntimeRef = nil

function Module.RegisterStatusEffectsRuntime(statusEffectsRuntime)
	StatusEffectsRuntimeRef = statusEffectsRuntime
end

----------------------------------------------------------------------
-- Resolver: translate a `<n>_Weapon` attribute value -> itemId.
-- Players store a UUID; NPCs store the raw itemId. Disambiguate by
-- probing `Items.GetConfigFromId` first (NPC fast-path), then falling
-- back to the server-only UUID cache.
----------------------------------------------------------------------

function Module.ResolveItemIdFromAttribute(character: Instance, attributeValue: any): string?
	if typeof(attributeValue) ~= 'string' then
		return nil
	end
	-- NPC path: attribute IS the itemId.
	if ItemsConfig.GetConfigFromId(attributeValue) then
		return attributeValue
	end
	-- Player path: server-only UUID -> itemId via cache.
	if PlayerInventoryServerRef and RunService:IsServer() then
		local player = Players:GetPlayerFromCharacter(character)
		if player then
			local id = PlayerInventoryServerRef.FindItemIdGivenUUID(player, attributeValue)
			if id then
				return id
			end
		end
	end
	return nil
end

-- (cfg, itemId, rawAttribute) — any may be nil if resolution fails.
function Module.ResolveWeaponConfig(character: Instance, handIndex: number)
	if not character then
		return nil, nil, nil
	end
	local attribName = tostring(handIndex) .. '_Weapon'
	local attrVal = character:GetAttribute(attribName)
	if not attrVal then
		return nil, nil, nil
	end
	local itemId = Module.ResolveItemIdFromAttribute(character, attrVal)
	if not itemId then
		return nil, nil, attrVal
	end
	local cfg = ItemsConfig.GetConfigFromId(itemId)
	return cfg, itemId, attrVal
end

-- Purpose: resolve the weapon config used by one melee swing.
-- Inputs: character with `<n>_Weapon` attributes; right hand wins, then left.
-- Outputs: a stable result shape containing config, item id, raw attr, and hand.
-- Failure: returns nil fields when neither hand resolves to a valid config.
function Module.ResolvePrimaryWeapon(character: Instance?): PrimaryWeaponResolution
	if not character then
		return {
			Config = nil,
			ItemId = nil,
			RawAttribute = nil,
			HandIndex = nil,
		}
	end

	local rightCfg, rightItemId, rightRaw = Module.ResolveWeaponConfig(character, 2)
	if rightCfg then
		return {
			Config = rightCfg,
			ItemId = rightItemId,
			RawAttribute = rightRaw,
			HandIndex = 2,
		}
	end

	local leftCfg, leftItemId, leftRaw = Module.ResolveWeaponConfig(character, 1)
	if leftCfg then
		return {
			Config = leftCfg,
			ItemId = leftItemId,
			RawAttribute = leftRaw,
			HandIndex = 1,
		}
	end

	return {
		Config = nil,
		ItemId = nil,
		RawAttribute = nil,
		HandIndex = nil,
	}
end

----------------------------------------------------------------------
-- Damage math.
----------------------------------------------------------------------

-- One decimal place is the display contract for every combat-facing
-- number: damage, poise, health readouts.
--
-- This is not cosmetic tidying, it is a correctness fix. Humanoid.Health
-- is a float32 while Luau numbers are float64, so TakeDamage narrows
-- whatever it is given and DamageModule then reconstructs the applied
-- amount as `healthBefore - Humanoid.Health` — a subtraction of two
-- lossy values. A clean 13.7 comes back as 13.699999809265137 and used
-- to land verbatim in a damage indicator via tostring(). The error is
-- produced BY the subtraction, so it has to be rounded off after the
-- delta, not just on the way in.
local COMBAT_ROUND_SCALE = 10 -- 1 decimal place

function Module.RoundCombatNumber(value: any): number
	if typeof(value) ~= 'number' then
		return 0
	end
	-- NaN / infinities would survive the arithmetic below and poison a
	-- health bar or a stat total, so they collapse to zero here.
	if value ~= value or value == math.huge or value == -math.huge then
		return 0
	end
	return math.floor(value * COMBAT_ROUND_SCALE + 0.5) / COMBAT_ROUND_SCALE
end

-- Display helper: same rounding, rendered without a trailing '.0' so a
-- whole number reads as '12' rather than '12.0'.
function Module.FormatCombatNumber(value: any): string
	local rounded = Module.RoundCombatNumber(value)
	if rounded % 1 == 0 then
		return string.format('%d', rounded)
	end
	return string.format('%.1f', rounded)
end

function Module.RollNumberRange(range): number
	if not range then
		return 0
	end
	local mn = range.Min or 0
	local mx = range.Max or mn
	if mn == mx then
		return mn
	end
	if mn % 1 == 0 and mx % 1 == 0 then
		return math.random(mn, mx)
	end
	return mn + math.random() * (mx - mn)
end

function Module.RollWeaponDamage(damageValues, baseDamage: number): number
	baseDamage = baseDamage or 0
	if not damageValues then
		return baseDamage
	end
	if damageValues.Value then
		return Module.RollNumberRange(damageValues.Value)
	end
	if damageValues.Percent then
		return Module.RollNumberRange(damageValues.Percent) * baseDamage
	end
	return baseDamage
end

----------------------------------------------------------------------
-- Composition-aware damage helpers — Stage D of ARTISAN.md.
-- These compose on top of the base RollWeaponDamage path so existing
-- call sites that don't pass a `stack` get the legacy behavior. New
-- call sites that thread the stack through receive forged-stat overrides
-- + enchant multipliers + gem resonance for free.
----------------------------------------------------------------------

-- Resolve the player's inventory stack for the weapon currently equipped
-- in the given hand. Server-only — relies on PlayerInventoryServerRef.
-- NPCs (which store itemId directly in the attribute) return nil since
-- they have no per-instance Composition.
function Module.ResolveWeaponStack(character: Instance?, handIndex: number)
	if not character or not RunService:IsServer() then return nil end
	if not PlayerInventoryServerRef then return nil end
	local player = Players:GetPlayerFromCharacter(character)
	if not player then return nil end
	local attribName = tostring(handIndex) .. '_Weapon'
	local uuid = character:GetAttribute(attribName)
	if typeof(uuid) ~= 'string' then return nil end
	local stack, _itemId = PlayerInventoryServerRef.GetItemStackFromUUID(player, uuid)
	return stack
end

local function resolveAttackerPlayer(attackerCharacter: Instance?): Player?
	if typeof(attackerCharacter) ~= 'Instance' then return nil end
	if attackerCharacter:IsA('Player') then
		return attackerCharacter :: Player
	end
	return Players:GetPlayerFromCharacter(attackerCharacter)
end

-- Layers Composition multipliers (enchants → forge stat delta → gem resonance)
-- onto baseDamage. attackerPlayer keys ForgeShared's per-player cache; nil OK.
function Module.ApplyCompositionMultipliers(baseDamage: number, stack, isPvP: boolean?, attackerPlayer: Player?): number
	if typeof(stack) ~= 'table' or typeof(stack.Composition) ~= 'table' then
		return baseDamage
	end
	local damage = baseDamage

	-- Enchant multipliers. Each entry's effect resolves via
	-- enchant_id → handler. Designers tweak per-level scalars in the
	-- Enchants.luau catalog (DescriptionMultiplier).
	local enchants = stack.Composition.Enchants
	if enchants and typeof(enchants.Entries) == 'table' then
		for _, entry in enchants.Entries do
			local cfg = EnchantsConfig.Enchants[entry.Id]
			if not cfg then continue end
			local lvl = entry.Level or 1
			local mult = (cfg.DescriptionMultiplier or 0) * lvl / 100
			-- Damage-class enchants get a +mult% multiplier; non-damage
			-- enchants (Looting, Unbreaking, Frost, etc.) are no-ops here
			-- and handled by their respective subsystems.
			if entry.Id == 'sharpness' or entry.Id == 'smite'
				or entry.Id == 'executioner' then
				damage = damage * (1 + mult)
			elseif entry.Id == 'vorpal' then
				-- Armor-pierce: model as +mult% damage when target has
				-- armor (no armor system yet, so apply unconditionally
				-- at half-effect — Stage D-2 will refine).
				damage = damage * (1 + mult * 0.5)
			elseif entry.Id == 'bleed' then
				-- Bleed is a DoT — base hit gets a small flat bump for
				-- the immediate strike; the over-time tick is a future
				-- Effects-system hook.
				damage = damage + (cfg.DescriptionMultiplier or 0) * lvl * 0.25
			end
		end
	end

	-- Forge modifier damage sum. Walks the per-stack modifier list via
	-- ForgeShared.ComputeStatDeltaSum so the same numbers the Forge UI
	-- previews are the numbers combat applies. Damage is additive
	-- BEFORE enchant / resonance multipliers — Sharp x3 (+72) + 20%
	-- Sharpness should read as (base+72) × 1.20, not base × 1.92.
	local modSum = ForgeShared.GetCachedStatDeltaSum(attackerPlayer, stack)
	if modSum.Damage > 0 then
		damage += modSum.Damage
	end

	-- Gem resonance multiplier. Set by GemSocketShared.RefreshResonance
	-- on every gem set/remove — read directly here without re-deriving.
	-- PvP scales resonance by PvP_RESONANCE_MULT so a fully-socketed
	-- weapon's massive resonance doesn't trivialize player-vs-player.
	local socketing = stack.Composition.Socketing
	if socketing and socketing.ResonanceBonus then
		local mult = socketing.ResonanceBonus.Multiplier
		if typeof(mult) == 'number' and mult > 1 then
			if isPvP then
				local pvpScalar = CombatConfigModule.CombatConfig.PvP_RESONANCE_MULT or 0.5
				-- Compress mult toward 1.0 by pvpScalar — at 0.5, a 1.40x
				-- resonance becomes 1.20x in PvP.
				mult = 1 + (mult - 1) * pvpScalar
			end
			damage = damage * mult
		end
	end

	return damage
end

-- One-stop damage formula. Falls back to `fallback` (default 10) when
-- there is no weapon or the weapon does not declare `WeaponUsage.Damage`.
-- The optional `stack` is the player's inventory stack for the weapon
-- — when provided, Composition multipliers (forged StatSnapshot.Damage
-- override + enchant scalars + gem resonance) layer on top of the base
-- roll. Pass nil for NPC casts where there is no Composition.
--
-- New options table (back-compat: legacy 4-arg call signature stays):
--   options.ComboEntry    — resolved CombatMovesets move whose DamageMult applies.
--   options.PerfectCounter — bool: multiply by COUNTER_DAMAGE_MULT (or
--                          PvP_COUNTER_MULT in PvP).
--   options.IsPvP         — bool: apply PvP_RESONANCE_MULT compression
--                          to gem-resonance and counter scalars.
function Module.CalculateAttackDamage(attackerCharacter: Instance?, weaponConfig, fallback: number?, stack, options): number
	fallback = fallback or 10
	if not weaponConfig then
		return fallback
	end
	local equip = weaponConfig.EquipmentData
	if not equip then
		return fallback
	end
	local usage = equip.WeaponUsage
	if not usage or not usage.Damage then
		return fallback
	end

	options = options or {}
	local isPvP: boolean = options.IsPvP == true
	local attackerPlayer = resolveAttackerPlayer(attackerCharacter)

	-- Forge StatSnapshot.Damage overrides the base damage if present.
	-- Otherwise use the WeaponUsage roll. The override path skips
	-- RollWeaponDamage's range / percent semantics — forged weapons
	-- have a deterministic per-craft damage value.
	local baseDamage
	local forged = stack and stack.Composition and stack.Composition.Forged
	if forged and forged.StatSnapshot and forged.StatSnapshot.Damage then
		baseDamage = forged.StatSnapshot.Damage
	else
		baseDamage = Module.RollWeaponDamage(usage.Damage, fallback)
	end

	-- Combo DamageMult — applied BEFORE Composition multipliers so a
	-- finisher's 1.5x stacks multiplicatively with enchants/resonance
	-- rather than additively (Nier's design intent: finishers feel
	-- decisively bigger on a tinkered weapon).
	local comboEntry = options.ComboEntry
	if comboEntry and typeof(comboEntry.DamageMult) == 'number' then
		baseDamage = baseDamage * comboEntry.DamageMult
	end

	-- Layer enchant + resonance multipliers on top.
	local final = Module.ApplyCompositionMultipliers(baseDamage, stack, isPvP, attackerPlayer)

	-- Perfect-dodge counter bonus. Multiplier comes from CombatConfig
	-- with a PvP-compressed alternate when both parties are players.
	if options.PerfectCounter then
		local cfg = CombatConfigModule.CombatConfig
		local counterMult = isPvP
			and (cfg.PvP_COUNTER_MULT or 1.25)
			or (cfg.COUNTER_DAMAGE_MULT or 1.5)
		final = final * counterMult
	end

	-- One decimal, matching every other combat number. This used to floor
	-- to a whole number, which threw away precision BEFORE the defender's
	-- mitigation layers ran in DamageModule — so the rounding error was
	-- then scaled by armor and passives rather than applied last.
	return math.max(0, Module.RoundCombatNumber(final))
end

----------------------------------------------------------------------
-- Effect infliction (post-hit). Real application pipeline is TBD; this
-- scaffold gives combat one canonical call site so the inflict table on
-- weapons stops being orphaned.
----------------------------------------------------------------------

-- Walk a forged stack's active modifiers and inflict their OnHit
-- effects on the target. Called by PlayerCombatServer / NPCCombatServer
-- after a hit lands. Same chance + potency math as ForgeShared
-- ComputeActiveModifiers — every modifier already has its stack count
-- folded in, so this loop just rolls + applies.
--
-- Lunar's regen-on-hit modifier targets the ATTACKER, not the victim.
-- We special-case 'regen' here (and any other future SelfTarget effect)
-- by routing the apply call to the attacker's character. This keeps
-- the modifier-config side compact — no per-modifier SelfTarget flag
-- needed because regen-style effects are uniformly self-targeted.
local SELF_TARGET_EFFECTS = { regen = true }

function Module.TryInflictModifierEffects(targetCharacter: Instance?, stack: any, attacker: Instance?)
	if not targetCharacter or not stack then return end
	if not StatusEffectsRuntimeRef or not StatusEffectsRuntimeRef.ApplyEffect then return end
	local sourcePlayer: Player? = nil
	if typeof(attacker) == 'Instance' then
		if attacker:IsA('Player') then
			sourcePlayer = attacker
		else
			sourcePlayer = Players:GetPlayerFromCharacter(attacker)
		end
	end
	for _, entry in ForgeShared.GetCachedActiveModifiers(sourcePlayer, stack) do
		local oh = entry.EffectiveOnHit
		if not oh then continue end
		if math.random() > oh.Chance then continue end
		local recipient: Instance = targetCharacter
		if SELF_TARGET_EFFECTS[oh.EffectId] and typeof(attacker) == 'Instance' then
			recipient = attacker
		end
		StatusEffectsRuntimeRef.ApplyEffect(recipient, {
			Id = oh.EffectId,
			Duration = oh.Duration,
			Potency = oh.Potency,
		}, sourcePlayer)
	end
end

function Module.TryInflictEffects(targetCharacter: Instance?, inflicts, attacker: Instance?)
	if not targetCharacter or not inflicts then
		return
	end
	-- Resolve attacker → Player (for kill credit / DoT source). Nil is
	-- valid (NPC source); StatusEffectsRuntime tolerates it.
	local sourcePlayer: Player? = nil
	if typeof(attacker) == 'Instance' then
		if attacker:IsA('Player') then
			sourcePlayer = attacker
		else
			sourcePlayer = Players:GetPlayerFromCharacter(attacker)
		end
	end
	for _, inflict in inflicts do
		if not inflict or not inflict.Effects then
			continue
		end
		local chance = Module.RollNumberRange(inflict.Chance)
		if chance < math.random() then
			continue
		end
		for _, effect in inflict.Effects do
			if not effect or typeof(effect.Id) ~= 'string' then continue end
			if StatusEffectsRuntimeRef and StatusEffectsRuntimeRef.ApplyEffect then
				StatusEffectsRuntimeRef.ApplyEffect(targetCharacter, effect, sourcePlayer)
			else
				-- Pre-runtime fallback (client-side or a server boot
				-- that hasn't registered yet) — keep the trace so
				-- nothing silently no-ops.
				print(string.format(
					'[CombatUtility] (no runtime) inflicting %s on %s',
					tostring(effect.Id), tostring(targetCharacter.Name)
				))
			end
		end
	end
end

----------------------------------------------------------------------
-- Slot -> character attachment name. Replaces the removed
-- `EquipData.BodyPart` field with a deterministic mapping over the new
-- `EquipmentSlotEnums`. handIndex disambiguates Hand / Bracelet /
-- Finger / Boots into Left vs Right (1 = Left, 2 = Right).
----------------------------------------------------------------------

local Slots = ItemsConfig.EquipmentSlotEnums

local SLOT_ATTACH_DEFAULT = {
	[Slots.Head]  = 'Head',
	[Slots.Chest] = 'UpperTorso',
	[Slots.Legs]  = 'LowerTorso',
	[Slots.Neck]  = 'UpperTorso',
	[Slots.Ear]   = 'Head',
	[Slots.Curio] = 'UpperTorso',
}

function Module.GetSlotAttachName(slotEnum: number, handIndex: number?): string
	if slotEnum == Slots.Hand
		or slotEnum == Slots.Bracelet
		or slotEnum == Slots.Finger then
		return (handIndex == 1) and 'LeftHand' or 'RightHand'
	end
	if slotEnum == Slots.Boots then
		return (handIndex == 1) and 'LeftFoot' or 'RightFoot'
	end
	return SLOT_ATTACH_DEFAULT[slotEnum] or 'UpperTorso'
end

----------------------------------------------------------------------
-- UI helpers. SummarizeWeaponStats keeps the existing tab-widget
-- "iterate cfg.Stats" loop alive without touching the schema. The
-- output is intentionally a flat string-keyed table so the UI can still
-- iterate via `for k, v in stats do`.
----------------------------------------------------------------------

local function damageRangeText(dmg): string?
	if not dmg then return nil end
	if dmg.Value then
		return string.format('%s-%s', tostring(dmg.Value.Min), tostring(dmg.Value.Max))
	end
	if dmg.Percent then
		return string.format('%s-%s%%', tostring(dmg.Percent.Min), tostring(dmg.Percent.Max))
	end
	return nil
end

-- Optional `stack` arg surfaces the player's per-instance Composition
-- stats in tooltips. Forged StatSnapshot overrides the base damage
-- range; gem resonance and enchant counts get their own rows so the
-- UI can render them without re-walking the Composition itself.
function Module.SummarizeWeaponStats(itemConfig, stack): {[string]: string}
	local stats = {}
	if not itemConfig then
		return stats
	end
	local equip = itemConfig.EquipmentData
	-- Forged StatSnapshot wins for the Damage row when present.
	local forged = stack and stack.Composition and stack.Composition.Forged
	if forged and forged.StatSnapshot then
		stats.Damage = string.format('%d', forged.StatSnapshot.Damage or 0)
		if forged.StatSnapshot.Speed then
			stats.Speed = string.format('%.2fx', forged.StatSnapshot.Speed)
		end
		if forged.StatSnapshot.Durability then
			stats.Durability = string.format('%.2fx', forged.StatSnapshot.Durability)
		end
		-- Blacksmith Identity row. Surfaces who forged the weapon — the
		-- "Forged by Aelric" line in the OVERVIEW tooltip. Optional;
		-- legacy / loot-table-seeded forged stacks omit this.
		if forged.BlacksmithIdentity and forged.BlacksmithIdentity.Name then
			stats['Forged By'] = forged.BlacksmithIdentity.Name
		end
	elseif equip and equip.WeaponUsage then
		local txt = damageRangeText(equip.WeaponUsage.Damage)
		if txt then stats.Damage = txt end
	end
	if equip and equip.ToolUsage then
		local txt = damageRangeText(equip.ToolUsage.Damage)
		if txt then stats['Tool Damage'] = txt end
	end
	-- Composition-side stat rows. Each is opt-in based on Composition
	-- presence so non-tinkered weapons render unchanged.
	if stack and stack.Composition then
		local enchants = stack.Composition.Enchants
		if enchants and typeof(enchants.Entries) == 'table' and #enchants.Entries > 0 then
			stats.Enchants = string.format('%d applied', #enchants.Entries)
		end
		local socketing = stack.Composition.Socketing
		if socketing and socketing.ResonanceBonus then
			local rb = socketing.ResonanceBonus
			if rb.Active then
				stats.Resonance = string.format(
					'%s ×%.2f', tostring(rb.Active), rb.Multiplier or 1)
			end
		end
	end
	if itemConfig.ConsumptionData and itemConfig.ConsumptionData.Cooldown then
		stats.Cooldown = string.format('%ss', tostring(itemConfig.ConsumptionData.Cooldown))
	end
	if itemConfig.ActivationData and itemConfig.ActivationData.Cooldown then
		stats.Cooldown = string.format('%ss', tostring(itemConfig.ActivationData.Cooldown))
	end
	return stats
end

function Module.GetItemTypeLabel(itemConfig): string
	if not itemConfig then
		return 'ITEM'
	end
	if itemConfig.EquipmentData then
		local equip = itemConfig.EquipmentData
		if equip.WeaponUsage then return 'WEAPON' end
		if equip.ToolUsage then return 'TOOL' end
		return 'EQUIPMENT'
	end
	if itemConfig.ConsumptionData then return 'CONSUMABLE' end
	if itemConfig.ActivationData then return 'ACTIVATABLE' end
	return 'ITEM'
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Utility/TitleRenderer"><![CDATA[-- TitleRenderer — applies a title's Display + Gradient + Effect to
-- a TextLabel and returns a cleanup function. Centralizes all
-- rendering rules so OverheadInfo and the CharacterTab dropdown
-- preview can both pick up gradient + effect support without
-- duplicating logic.
--
-- Usage:
--   local cleanup = TitleRenderer.Apply(label, titleCfg, {
--       FormatName = function(name) return string.format('[%s]', name:upper()) end,
--   })
--   ...later, when title clears or label respawns:
--   cleanup()
--
-- The cleanup function:
--   * Destroys the UIGradient if Apply created one
--   * Calls the effect's Cleanup hook (if defined)
--   * Disconnects the Heartbeat driver

local RunService = game:GetService('RunService')

local TitleEffectsModule = require(script.Parent.Parent.Data.TitleEffects)

export type ApplyOptions = {
	-- Optional name formatter — defaults to `[NAME]`-style upper-case
	-- bracketing (matches existing OverheadInfo convention).
	FormatName: ((displayName: string) -> string)?,
	-- Override the default tag color when no gradient + no effect-set
	-- color is present. Falls back to the title's Display.Color, then
	-- to white.
	DefaultColor: Color3?,
}

local Module = {}

local function defaultFormatName(name: string): string
	return string.format('[%s]', string.upper(name))
end

----------------------------------------------------------------------
-- Build a UIGradient from a config table. Tolerates partial configs:
-- a Color (ColorSequence) is required; rotation/offset/transparency
-- default to neutral values.
----------------------------------------------------------------------
local function buildGradient(label: TextLabel, gradientCfg: any): UIGradient?
	if not gradientCfg or not gradientCfg.Color then return nil end
	local g = Instance.new('UIGradient')
	g.Name = 'TitleGradient'
	g.Color = gradientCfg.Color
	g.Rotation = gradientCfg.Rotation or 0
	if gradientCfg.Offset then g.Offset = gradientCfg.Offset end
	if gradientCfg.Transparency then g.Transparency = gradientCfg.Transparency end
	g.Parent = label
	return g
end

----------------------------------------------------------------------
-- Apply — main entry point.
----------------------------------------------------------------------
function Module.Apply(label: TextLabel, titleCfg: any, opts: ApplyOptions?): () -> ()
	opts = opts or {}
	if not label or not titleCfg then return function() end end

	local display = titleCfg.Display or {}
	local formatName = opts.FormatName or defaultFormatName
	-- Display name. Fallback to the title id when no Name authored.
	local rawName = display.Name or titleCfg.Id or '?'
	label.Visible = true
	label.Text = formatName(rawName)
	label.TextColor3 = display.Color or opts.DefaultColor or Color3.new(1, 1, 1)

	-- Gradient: optional. Created here, destroyed by the cleanup fn
	-- so a title swap doesn't leak orphaned UIGradient instances.
	local gradient = buildGradient(label, titleCfg.Gradient)

	-- Effect: optional. Init returns opaque state; OnHeartbeat is
	-- driven by RunService.Heartbeat with the elapsed-since-apply
	-- value. Disconnected + Cleanup'd by the returned function.
	local effect = TitleEffectsModule.Resolve(titleCfg.Effect)
	local effectState: any = nil
	local heartbeatConn: RBXScriptConnection? = nil

	if effect then
		if effect.Init then
			local ok, state = pcall(effect.Init, label, gradient)
			if ok then effectState = state end
		end
		if effect.OnHeartbeat then
			local startedAt = os.clock()
			heartbeatConn = RunService.Heartbeat:Connect(function(dt)
				-- Defensive: if the label was destroyed externally, bail.
				if not label.Parent then
					if heartbeatConn then heartbeatConn:Disconnect(); heartbeatConn = nil end
					return
				end
				local elapsed = os.clock() - startedAt
				local ok, err = pcall(effect.OnHeartbeat, effectState, label, gradient, elapsed, dt)
				if not ok then
					-- One bad effect shouldn't permanently spam — disconnect
					-- after the first error and surface the issue.
					warn(string.format('TitleRenderer: effect OnHeartbeat error: %s', tostring(err)))
					if heartbeatConn then heartbeatConn:Disconnect(); heartbeatConn = nil end
				end
			end)
		end
	end

	-- Cleanup closure — captured locals are sufficient; no module-level
	-- state needed. Called by the consumer when the title is cleared
	-- or the underlying label is recycled (respawn).
	local cleaned = false
	return function()
		if cleaned then return end
		cleaned = true
		if heartbeatConn then heartbeatConn:Disconnect(); heartbeatConn = nil end
		if effect and effect.Cleanup then
			pcall(effect.Cleanup, effectState, label, gradient)
		end
		if gradient and gradient.Parent then
			gradient:Destroy()
		end
	end
end

----------------------------------------------------------------------
-- Clear — convenience: hide a label and run a stashed cleanup.
-- Pass the cleanup function returned by Apply. The label is left in
-- a "no-title" state (Text empty, Visible false).
----------------------------------------------------------------------
function Module.Clear(label: TextLabel, cleanup: (() -> ())?)
	if cleanup then cleanup() end
	if label then
		label.Visible = false
		label.Text = ''
	end
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Utility/HitCache"><![CDATA[-- HitCache. Per-attack / per-cast humanoid de-dup. Boar.luau's
-- BoarDashAttack invented this pattern locally — promoted here so
-- player swings, NPC swings, and skills can all opt in without
-- reinventing it.
--
-- Why this matters: a hitbox swing's active window may overlap the
-- same humanoid across multiple frames or pulses. Without a cache
-- we re-fire DamageHumanoid (and its DamageIndicatorEvent
-- FireAllClients broadcast) for every overlap — that broadcast
-- burst is the on-hit "lag" the design surfaced.
--
-- Usage:
--   local cache = HitCache.New()
--   for _, humanoid in foundHumanoids do
--     if HitCache.ShouldHit(cache, humanoid) then
--       -- run damage / remote / VFX once per humanoid
--     end
--   end
--
-- Optional per-entry TTL: HitCache.New(0.18) lets a humanoid be
-- re-hit after 0.18s. Default (nil TTL) is "once per cache lifetime".

-- // Module // --
local Module = {}

export type HitCache = {
	Entries: { [Humanoid]: number },
	TTL: number?,
}

-- Build a fresh cache. `ttl` is the per-entry expiry in seconds
-- when set; nil means entries live for the cache's full lifetime
-- (the typical per-swing / per-cast usage).
function Module.New(ttl: number?): HitCache
	return {
		Entries = {},
		TTL = ttl,
	}
end

-- Returns true the FIRST time `humanoid` is observed (within TTL),
-- false thereafter. On a true return the humanoid is recorded.
-- Auto-rejects nil / unparented / dead humanoids so callers don't
-- need to repeat the Health > 0 check at every site.
function Module.ShouldHit(cache: HitCache, humanoid: Humanoid?): boolean
	if not humanoid or not humanoid.Parent then return false end
	if humanoid.Health <= 0 then return false end
	local now = os.clock()
	local existing = cache.Entries[humanoid]
	if existing and now < existing then
		return false
	end
	local ttl = cache.TTL
	cache.Entries[humanoid] = ttl and (now + ttl) or math.huge
	return true
end

-- Manual reset. Drops every entry — the cache is reusable after.
-- Most callers throw the cache away per swing; this is here for
-- long-lived caches (per-character status-tick loops, etc.).
function Module.Clear(cache: HitCache)
	table.clear(cache.Entries)
end

-- Drop expired entries + dead/unparented humanoids. Optional —
-- per-swing caches don't need it (GC'd whole). Long-lived caches
-- should call this periodically so they don't pin dead humanoids.
function Module.Prune(cache: HitCache)
	local now = os.clock()
	for humanoid, expiry in cache.Entries do
		if not humanoid.Parent or humanoid.Health <= 0 or now >= expiry then
			cache.Entries[humanoid] = nil
		end
	end
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Utility/CombatValidation"><![CDATA[-- // CombatValidation.luau //
-- Pure validators for combat intent payloads. No Roblox service calls,
-- no state reads, no side effects — every function is a predicate over
-- values, so the same rules can run client-side as a cheap pre-flight
-- and server-side as the authoritative gate.
--
-- See NIER_COMBAT.md for the threat model. The short version: the
-- client is a hostile source of latency hints. It may say WHAT it wants
-- and roughly WHERE it was; it may never say what it hit, how much
-- damage it dealt, how long its active window lasted, or where anyone
-- else ended up.

local CombosShared = require(script.Parent.Parent:WaitForChild('Services'):WaitForChild('CombosShared'))
local CombatActions = require(script.Parent.Parent:WaitForChild('Data'):WaitForChild('CombatActions'))

local Module = {}

Module.Version = 1

-- Coordinates beyond this are not reachable play space; anything larger
-- is either a corrupted float or a deliberate overflow probe.
local MAX_COORDINATE = 100000
-- Combo keys are at most COMBO_MAX_LENGTH letters. The bound here is
-- deliberately loose so config can raise the cap without editing this
-- file, but tight enough that a megabyte string is rejected outright.
local MAX_COMBO_KEY_LENGTH = 8
-- 2^53; beyond this integers stop being exactly representable and the
-- monotonic command-id comparison would break.
local MAX_COMMAND_ID = 9007199254740991

function Module.IsFiniteNumber(value: any): boolean
	return typeof(value) == 'number'
		and value == value              -- NaN check
		and value > -math.huge
		and value < math.huge
end

function Module.IsFiniteCoordinate(value: any): boolean
	return Module.IsFiniteNumber(value) and math.abs(value) <= MAX_COORDINATE
end

-- A Vector3 is acceptable as an origin/aim point when every component is
-- finite and inside play space. Rejects the NaN/inf vectors that crash
-- CFrame math downstream.
function Module.IsValidVector(value: any): boolean
	if typeof(value) ~= 'Vector3' then return false end
	return Module.IsFiniteCoordinate(value.X)
		and Module.IsFiniteCoordinate(value.Y)
		and Module.IsFiniteCoordinate(value.Z)
end

-- Direction vectors additionally need enough magnitude to normalise.
-- A near-zero look vector would produce a NaN unit vector.
function Module.IsValidDirection(value: any): boolean
	if not Module.IsValidVector(value) then return false end
	return value.Magnitude > 0.01
end

function Module.IsValidCommandId(value: any): boolean
	return Module.IsFiniteNumber(value)
		and value % 1 == 0
		and value >= 1
		and value <= MAX_COMMAND_ID
end

function Module.IsValidComboKey(value: any): boolean
	if typeof(value) ~= 'string' then return false end
	if #value < 1 or #value > MAX_COMBO_KEY_LENGTH then return false end
	for index = 1, #value do
		if not CombosShared.IsValidInput(string.sub(value, index, index)) then
			return false
		end
	end
	return true
end

function Module.IsValidInputKind(value: any): boolean
	return value == CombatActions.InputKinds.Light
		or value == CombatActions.InputKinds.Heavy
end

-- Target hints are Models only. Anything else (a Part the client picked
-- out of workspace, a Folder, a Player object) is dropped rather than
-- rejected — a bad hint should degrade to "no hint", not kill the swing.
function Module.IsPlausibleTargetHint(value: any): boolean
	return typeof(value) == 'Instance' and value:IsA('Model')
end

----------------------------------------------------------------------
-- Whole-payload validation.
--
-- Returns (ok, reason). The reason string is for server-side denial
-- logging only — NIER_COMBAT.md is explicit that raw anti-exploit
-- reasons are never surfaced to normal players.
----------------------------------------------------------------------

export type AttackIntent = {
	CommandId: number,
	InputKind: string,
	ComboKey: string?,
	Origin: Vector3?,
	Look: Vector3?,
	TargetInstance: Instance?,
}

function Module.ValidateAttackIntent(intent: any): (boolean, string)
	if typeof(intent) ~= 'table' then
		return false, 'PayloadNotTable'
	end
	if not Module.IsValidCommandId(intent.CommandId) then
		return false, 'BadCommandId'
	end
	if not Module.IsValidInputKind(intent.InputKind) then
		return false, 'BadInputKind'
	end
	-- ComboKey is a claim, not an instruction: the server re-derives the
	-- real chain. It still has to be well-formed so the comparison and
	-- any logging of it are bounded.
	if intent.ComboKey ~= nil and not Module.IsValidComboKey(intent.ComboKey) then
		return false, 'BadComboKey'
	end
	-- The claim's final letter must agree with the requested input kind,
	-- otherwise the client is describing a different swing than the one
	-- it asked for.
	if typeof(intent.ComboKey) == 'string' and #intent.ComboKey > 0 then
		if string.sub(intent.ComboKey, -1, -1) ~= intent.InputKind then
			return false, 'ComboKeyKindMismatch'
		end
	end
	if intent.Origin ~= nil and not Module.IsValidVector(intent.Origin) then
		return false, 'BadOrigin'
	end
	if intent.Look ~= nil and not Module.IsValidDirection(intent.Look) then
		return false, 'BadLook'
	end
	return true, ''
end

function Module.ValidateDodgeIntent(intent: any): (boolean, string)
	if typeof(intent) ~= 'table' then
		return false, 'PayloadNotTable'
	end
	if not Module.IsValidCommandId(intent.CommandId) then
		return false, 'BadCommandId'
	end
	-- A directionless dodge is legal: the server falls back to the
	-- character's facing, which is what an idle backstep should do.
	if intent.Direction ~= nil and not Module.IsValidDirection(intent.Direction) then
		return false, 'BadDirection'
	end
	return true, ''
end

----------------------------------------------------------------------
-- Origin plausibility.
--
-- The client's reported position is a latency hint. When it is close to
-- the server's own view of the character we may use it, which makes
-- swings land where the player saw themselves standing. When it drifts
-- past the cutoff we discard it silently and use the server position —
-- rejecting the whole swing would punish honest players on bad
-- connections far more than it would inconvenience a cheater.
----------------------------------------------------------------------
function Module.IsOriginPlausible(clientOrigin: any, serverPosition: Vector3, maxDrift: number): boolean
	if not Module.IsValidVector(clientOrigin) then return false end
	return (clientOrigin - serverPosition).Magnitude <= maxDrift
end

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Libraries"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="ReplicatedStorage/Modules/Libraries/Fusion"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler
--[[
	The entry point for the Fusion library.
]]

local Types = require(script.Types)
local External = require(script.External)

type Fusion = Types.Fusion

export type Animatable = Types.Animatable
export type UsedAs<T> = Types.UsedAs<T>
export type Child = Types.Child
export type Computed<T> = Types.Computed<T>
export type Contextual<T> = Types.Contextual<T>
export type GraphObject = Types.GraphObject
export type For<KO, VO> = Types.For<KO, VO>
export type Observer = Types.Observer
export type PropertyTable = Types.PropertyTable
export type Scope<Constructors = Fusion> = Types.Scope<Constructors>
export type ScopedObject = Types.ScopedObject
export type SpecialKey = Types.SpecialKey
export type Spring<T> = Types.Spring<T>
export type StateObject<T> = Types.StateObject<T>
export type Task = Types.Task
export type Tween<T> = Types.Tween<T>
export type Use = Types.Use
export type Value<T, S = T> = Types.Value<T, S>
export type Version = Types.Version

-- Down the line, this will be conditional based on whether Fusion is being
-- compiled for Roblox.
do
	local RobloxExternal = require(script.RobloxExternal)
	External.setExternalProvider(RobloxExternal)
end

local Fusion: Fusion = table.freeze {
	-- General
	version = {major = 0, minor = 3, isRelease = true},
	Contextual = require(script.Utility.Contextual),
	Safe = require(script.Utility.Safe),

	-- Memory
	cleanup = require(script.Memory.legacyCleanup),
	deriveScope = require(script.Memory.deriveScope),
	doCleanup = require(script.Memory.doCleanup),
	innerScope = require(script.Memory.innerScope),
	scoped = require(script.Memory.scoped),
	
	-- Graph
	Observer = require(script.Graph.Observer),

	-- State
	Computed = require(script.State.Computed),
	ForKeys = require(script.State.ForKeys) :: Types.ForKeysConstructor,
	ForPairs = require(script.State.ForPairs) :: Types.ForPairsConstructor,
	ForValues = require(script.State.ForValues) :: Types.ForValuesConstructor,
	peek = require(script.State.peek),
	Value = require(script.State.Value),

	-- Roblox API
	Attribute = require(script.Instances.Attribute),
	AttributeChange = require(script.Instances.AttributeChange),
	AttributeOut = require(script.Instances.AttributeOut),
	Child = require(script.Instances.Child),
	Children = require(script.Instances.Children),
	Hydrate = require(script.Instances.Hydrate),
	New = require(script.Instances.New),
	OnChange = require(script.Instances.OnChange),
	OnEvent = require(script.Instances.OnEvent),
	Out = require(script.Instances.Out),

	-- Animation
	Tween = require(script.Animation.Tween),
	Spring = require(script.Animation.Spring),
}

return Fusion
]]></Source>
		<Source path="ReplicatedStorage/Modules/Libraries/Fusion/Animation/ExternalTime"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Outputs the current external time as a state object.
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)
local External = require(Package.External)
-- Graph
local change = require(Package.Graph.change)
-- Utility
local nicknames = require(Package.Utility.nicknames)

type ExternalTime = Types.StateObject<number>

type Self = ExternalTime

local class = {}
class.type = "State"
class.kind = "ExternalTime"
class.timeliness = "lazy"
class.dependencySet = table.freeze {}
class._EXTREMELY_DANGEROUS_usedAsValue = External.lastUpdateStep()

local METATABLE = table.freeze {__index = class}

local allTimers: {Self} = {}

local function ExternalTime(
	scope: Types.Scope<unknown>
): ExternalTime
	local createdAt = os.clock()
	local self: Self = setmetatable(
		{
			createdAt = createdAt,
			dependentSet = {},
			lastChange = nil,
			scope = scope,
			validity = "invalid"
		}, 
		METATABLE
	) :: any
	local destroy = function()
		self.scope = nil
		local index = table.find(allTimers, self)
		if index ~= nil then
			table.remove(allTimers, index)
		end
	end
	self.oldestTask = destroy
	nicknames[self.oldestTask] = "ExternalTime"
	table.insert(scope, destroy)
	table.insert(allTimers, self)
	return self
end

function class._evaluate(
	self: Self
): boolean
	-- While someone else could call `change()` on this object, it wouldn't be
	-- idiomatic. So, since the only idiomatic time this function runs is when
	-- the external update step runs, it's safe enough to assume that the result
	-- has always meaningfully changed. The worst that can happen is unexpected
	-- refreshing for people doing unorthodox shenanigans, which is an OK trade.
	return true
end

External.bindToUpdateStep(function(
	externalNow: number
): ()
	class._EXTREMELY_DANGEROUS_usedAsValue = External.lastUpdateStep()
	for _, timer in allTimers do
		change(timer)
	end
end)

-- Do *not* freeze the class table, because it stores the shared value of all
-- external time objects, and is updated every frame because of that.
-- table.freeze(class)
return ExternalTime]]></Source>
		<Source path="ReplicatedStorage/Modules/Libraries/Fusion/Animation/Spring"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	A specialised state object for following a goal state smoothly over time,
	using physics to shape the motion.

	https://elttob.uk/Fusion/0.3/api-reference/animation/types/spring/
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)
local External = require(Package.External)
-- Memory
local checkLifetime = require(Package.Memory.checkLifetime)
-- Graph
local depend = require(Package.Graph.depend)
local change = require(Package.Graph.change)
local evaluate = require(Package.Graph.evaluate)
-- State
local castToState = require(Package.State.castToState)
local peek = require(Package.State.peek)
-- Animation
local ExternalTime = require(Package.Animation.ExternalTime)
local Stopwatch = require(Package.Animation.Stopwatch)
local packType = require(Package.Animation.packType)
local unpackType = require(Package.Animation.unpackType)
local springCoefficients = require(Package.Animation.springCoefficients)
-- Utility
local nicknames = require(Package.Utility.nicknames)

local EPSILON = 0.00001

type Self<T> = Types.Spring<T> & {
	_activeDamping: number,
	_activeGoal: T,
	_activeLatestP: {number},
	_activeLatestV: {number},
	_activeNumSprings: number,
	_activeSpeed: number,
	_activeStartP: {number},
	_activeStartV: {number},
	_activeTargetP: {number},
	_activeType: string,
	_speed: Types.UsedAs<number>,
	_damping: Types.UsedAs<number>,
	_goal: Types.UsedAs<T>,
	_stopwatch: Stopwatch.Stopwatch
}

local class = {}
class.type = "State"
class.kind = "Spring"
class.timeliness = "eager"

local METATABLE = table.freeze {__index = class}

local function Spring<T>(
	scope: Types.Scope<unknown>,
	goal: Types.UsedAs<T>,
	speed: Types.UsedAs<number>?,
	damping: Types.UsedAs<number>?
): Types.Spring<T>
	local createdAt = os.clock()
	if typeof(scope) ~= "table" or castToState(scope) ~= nil then
		External.logError("scopeMissing", nil, "Springs", "myScope:Spring(goalState, speed, damping)")
	end

	local goalState = castToState(goal)
	local stopwatch = nil
	if goalState ~= nil then
		stopwatch = Stopwatch(scope, ExternalTime(scope))
		stopwatch:unpause()
	end

	local speed = speed or 10
	local damping = damping or 1

	local self: Self<T> = setmetatable(
		{
			createdAt = createdAt,
			dependencySet = {},
			dependentSet = {},
			lastChange = nil,
			scope = scope,
			validity = "invalid",
			_activeDamping = -1,
			_activeGoal = nil,
			_activeLatestP = {},
			_activeLatestV = {},
			_activeNumSprings = 0,
			_activeSpeed = -1,
			_activeStartP = {},
			_activeStartV = {},
			_activeTargetP = {},
			_activeType = "",
			_damping = damping,
			_EXTREMELY_DANGEROUS_usedAsValue = peek(goal),
			_goal = goal,
			_speed = speed,
			_stopwatch = stopwatch
		},
		METATABLE
	) :: any
	local destroy = function()
		self.scope = nil
		for dependency in pairs(self.dependencySet) do
			dependency.dependentSet[self] = nil
		end
	end
	self.oldestTask = destroy
	nicknames[self.oldestTask] = "Spring"
	table.insert(scope, destroy)
	
	if goalState ~= nil then
		checkLifetime.bOutlivesA(
			scope, self.oldestTask,
			goalState.scope, goalState.oldestTask,
			checkLifetime.formatters.animationGoal
		)
	end
	local speedState = castToState(speed)
	if speedState ~= nil then
		checkLifetime.bOutlivesA(
			scope, self.oldestTask,
			speedState.scope, speedState.oldestTask,
			checkLifetime.formatters.parameter, "speed"
		)
	end
	local dampingState = castToState(damping)
	if dampingState ~= nil then
		checkLifetime.bOutlivesA(
			scope, self.oldestTask,
			dampingState.scope, dampingState.oldestTask,
			checkLifetime.formatters.parameter, "damping"
		)
	end

	-- Eagerly evaluated objects need to evaluate themselves so that they're
	-- valid at all times.
	evaluate(self, true)

	return self
end

function class.addVelocity<T>(
	self: Self<T>,
	deltaValue: T
): ()
	evaluate(self, false) -- ensure the _active params are up to date
	local deltaType = typeof(deltaValue)
	if deltaType ~= self._activeType then
		External.logError("springTypeMismatch", nil, deltaType, self._activeType)
	end
	local newStartV = unpackType(deltaValue, deltaType)
	for index, velocity in self._activeLatestV do
		newStartV[index] += velocity
	end
	self._activeStartP = table.clone(self._activeLatestP)
	self._activeStartV = newStartV
	self._stopwatch:zero()
	self._stopwatch:unpause()
	change(self)
end

function class.get<T>(
	self: Self<T>
): never
	return External.logError("stateGetWasRemoved")
end

function class.setPosition<T>(
	self: Self<T>,
	newValue: T
): ()
	evaluate(self, false) -- ensure the _active params are up to date
	local newType = typeof(newValue)
	if newType ~= self._activeType then
		External.logError("springTypeMismatch", nil, newType, self._activeType)
	end
	self._activeStartP = unpackType(newValue, newType)
	self._activeStartV = table.clone(self._activeLatestV)
	self._stopwatch:zero()
	self._stopwatch:unpause()
	change(self)
end

function class.setVelocity<T>(
	self: Self<T>,
	newValue: T
): ()
	evaluate(self, false) -- ensure the _active params are up to date
	local newType = typeof(newValue)
	if newType ~= self._activeType then
		External.logError("springTypeMismatch", nil, newType, self._activeType)
	end
	self._activeStartP = table.clone(self._activeLatestP)
	self._activeStartV = unpackType(newValue, newType)
	self._stopwatch:zero()
	self._stopwatch:unpause()
	change(self)
end

function class._evaluate<T>(
	self: Self<T>
): boolean
	local goal = castToState(self._goal)
	-- Allow non-state goals to pass through transparently.
	if goal == nil then
		self._EXTREMELY_DANGEROUS_usedAsValue = self._goal :: T
		return false
	end
	-- depend(self, goal)
	local nextFrameGoal = peek(goal)
	-- Protect against NaN goals.
	if nextFrameGoal ~= nextFrameGoal then
		External.logWarn("springNanGoal")
		return false
	end
	local nextFrameGoalType = typeof(nextFrameGoal)
	local discontinuous = nextFrameGoalType ~= self._activeType

	local stopwatch = self._stopwatch :: Stopwatch.Stopwatch
	local elapsed = peek(stopwatch)
	depend(self, stopwatch)

	local oldValue = self._EXTREMELY_DANGEROUS_usedAsValue
	local newValue: T

	if discontinuous then
		-- Propagate changes in type instantly throughout the whole reactive
		-- graph, even if simulation is logically one frame behind, because it
		-- makes the whole graph behave more consistently.
		newValue = nextFrameGoal
	elseif elapsed <= 0 then
		newValue = oldValue
	else
		-- Calculate spring motion.
		-- IMPORTANT: use the parameters from last frame, not this frame. We're
		-- integrating the motion that happened over the last frame, after all.
		-- The stopwatch will have captured the length of time needed correctly.
		local posPos, posVel, velPos, velVel = springCoefficients(
			elapsed, 
			self._activeDamping, 
			self._activeSpeed
		)
		local isMoving = false
		for index = 1, self._activeNumSprings do
			local startP = self._activeStartP[index]
			local targetP = self._activeTargetP[index]
			local startV = self._activeStartV[index]
			local startD = startP - targetP
			local latestD = startD * posPos + startV * posVel
			local latestV = startD * velPos + startV * velVel
			if latestD ~= latestD or latestV ~= latestV then
				External.logWarn("springNanMotion")
				latestD, latestV = 0, 0
			end
			if math.abs(latestD) > EPSILON or math.abs(latestV) > EPSILON then
				isMoving = true
			end
			local latestP = latestD + targetP
			self._activeLatestP[index] = latestP
			self._activeLatestV[index] = latestV
		end
		-- Sleep and snap to goal if the motion has decayed to a negligible amount.
		if not isMoving then
			for index = 1, self._activeNumSprings do
				self._activeLatestP[index] = self._activeTargetP[index]
			end
			-- TODO: figure out how to do sleeping correctly for single frame
			-- changes
			-- stopwatch:pause()
			-- stopwatch:zero()
		end
		-- Pack springs into final value.
		newValue = packType(self._activeLatestP, self._activeType) :: any
	end

	-- Reconfigure spring when any of its parameters are changed.
	-- This should happen after integrating the last frame's motion.
	-- NOTE: don't need to add a dependency on these objects! they do not cause
	-- a spring to wake from sleep, so the stopwatch dependency is sufficient.
	local nextFrameSpeed = peek(self._speed) :: number
	local nextFrameDamping = peek(self._damping) :: number
	if
		discontinuous or
		nextFrameGoal ~= self._activeGoal or
		nextFrameSpeed ~= self._activeSpeed or
		nextFrameDamping ~= self._activeDamping
	then
		self._activeTargetP = unpackType(nextFrameGoal, nextFrameGoalType)
		self._activeNumSprings = #self._activeTargetP
		if discontinuous then
			self._activeStartP = table.clone(self._activeTargetP)
			self._activeLatestP = table.clone(self._activeTargetP)
			self._activeStartV = table.create(self._activeNumSprings, 0)
			self._activeLatestV = table.create(self._activeNumSprings, 0)
		else
			self._activeStartP = table.clone(self._activeLatestP)
			self._activeStartV = table.clone(self._activeLatestV)
		end
		self._activeType = nextFrameGoalType
		self._activeGoal = nextFrameGoal
		self._activeDamping = nextFrameDamping
		self._activeSpeed = nextFrameSpeed
		stopwatch:zero()
		stopwatch:unpause()
	end

	-- Push update and check for similarity.
	-- Don't need to use the similarity test here because this code doesn't
	-- deal with tables, and NaN is already guarded against, so the similarity
	-- test doesn't actually add any new safety here.
	self._EXTREMELY_DANGEROUS_usedAsValue = newValue
	return oldValue ~= newValue
end

table.freeze(class)
return Spring :: Types.SpringConstructor]]></Source>
		<Source path="ReplicatedStorage/Modules/Libraries/Fusion/Animation/Stopwatch"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	State object for measuring time since an event using a reference timer.

	TODO: this should not be exposed to users until it has a proper reactive API
	surface
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)
-- Memory
local checkLifetime = require(Package.Memory.checkLifetime)
-- Graph
local depend = require(Package.Graph.depend)
local change = require(Package.Graph.change)
-- State
local peek = require(Package.State.peek)
-- Utility
local nicknames = require(Package.Utility.nicknames)

export type Stopwatch = Types.StateObject<number> & {
	zero: (Stopwatch) -> (),
	pause: (Stopwatch) -> (),
	unpause: (Stopwatch) -> ()
}

type Self = Stopwatch & {
	_measureTimeSince: number,
	_playing: boolean,
	_timer: Types.StateObject<number>
}

local class = {}
class.type = "State"
class.kind = "Stopwatch"
class.timeliness = "lazy"

local METATABLE = table.freeze {__index = class}

local function Stopwatch(
	scope: Types.Scope<unknown>,
	timer: Types.StateObject<number>
): Stopwatch
	local createdAt = os.clock()
	local self: Self = setmetatable(
		{
			awake = true,
			createdAt = createdAt,
			dependencySet = {},
			dependentSet = {},
			lastChange = nil,
			scope = scope,
			validity = "invalid",
			_EXTREMELY_DANGEROUS_usedAsValue = 0,
			_measureTimeSince = 0, -- this should be set on unpause
			_playing = false,
			_timer = timer
		}, 
		METATABLE
	) :: any
	local destroy = function()
		self.scope = nil
	end
	self.oldestTask = destroy
	nicknames[self.oldestTask] = "Stopwatch"
	table.insert(scope, destroy)

	checkLifetime.bOutlivesA(
		scope, self.oldestTask,
		timer.scope, timer.oldestTask,
		checkLifetime.formatters.parameter, "timer"
	)
	depend(self, timer)
	return self
end

function class.zero(
	self: Self
): ()
	local newTimepoint = peek(self._timer)
	if newTimepoint ~= self._measureTimeSince then
		self._measureTimeSince = newTimepoint
		self._EXTREMELY_DANGEROUS_usedAsValue = 0
		change(self)
	end
end

function class.pause(
	self: Self
): ()
	if self._playing == true then
		self._playing = false
		change(self)
	end
end

function class.unpause(
	self: Self
): ()
	if self._playing == false then
		self._playing = true
		self._measureTimeSince = peek(self._timer) - self._EXTREMELY_DANGEROUS_usedAsValue
		change(self)
	end
end

function class._evaluate(
	self: Self
): boolean
	if self._playing then
		depend(self, self._timer)
		local currentTime = peek(self._timer)
		local oldValue = self._EXTREMELY_DANGEROUS_usedAsValue
		local newValue = currentTime - self._measureTimeSince
		self._EXTREMELY_DANGEROUS_usedAsValue = newValue
		return oldValue ~= newValue
	else
		return false
	end
	
end

table.freeze(class)
return Stopwatch]]></Source>
		<Source path="ReplicatedStorage/Modules/Libraries/Fusion/Animation/Tween"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	A specialised state object for following a goal state smoothly over time,
	using a TweenInfo to shape the motion.

	https://elttob.uk/Fusion/0.3/api-reference/animation/types/tween/
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)
local External = require(Package.External)
-- Memory
local checkLifetime = require(Package.Memory.checkLifetime)
-- Graph
local depend = require(Package.Graph.depend)
local evaluate = require(Package.Graph.evaluate)
-- State
local castToState = require(Package.State.castToState)
local peek = require(Package.State.peek)
-- Animation
local ExternalTime = require(Package.Animation.ExternalTime)
local Stopwatch = require(Package.Animation.Stopwatch)
local lerpType = require(Package.Animation.lerpType)
local getTweenRatio = require(Package.Animation.getTweenRatio)
local getTweenDuration = require(Package.Animation.getTweenDuration)
-- Utility
local nicknames = require(Package.Utility.nicknames)

export type Self<T> = Types.Tween<T> & {
	_activeDuration: number,
	_activeElapsed: number,
	_activeFrom: T,
	_activeTo: T,
	_activeTweenInfo: TweenInfo,
	_goal: Types.UsedAs<T>,
	_stopwatch: Stopwatch.Stopwatch?,
	_tweenInfo: Types.UsedAs<TweenInfo>,
}

local class = {}
class.type = "State"
class.kind = "Tween"
class.timeliness = "eager"

local METATABLE = table.freeze {__index = class}

local function Tween<T>(
	scope: Types.Scope<unknown>,
	goal: Types.UsedAs<T>,
	tweenInfo: Types.UsedAs<TweenInfo>?
): Types.Tween<T>
	local createdAt = os.clock()
	if castToState(scope) then
		External.logError("scopeMissing", nil, "Tweens", "myScope:Tween(goalState, tweenInfo)")
	end

	local goalState = castToState(goal)
	local stopwatch = nil
	if goalState ~= nil then
		stopwatch = Stopwatch(scope, ExternalTime(scope))
	end

	local self: Self<T> = setmetatable(
		{
			createdAt = createdAt,
			dependencySet = {},
			dependentSet = {},
			lastChange = nil,
			scope = scope,
			validity = "invalid",
			_activeDuration = nil,
			_activeElapsed = nil,
			_activeFrom = nil,
			_activeTo = nil,
			_activeTweenInfo = nil,
			_EXTREMELY_DANGEROUS_usedAsValue = peek(goal),
			_goal = goal,
			_stopwatch = stopwatch,
			_tweenInfo = tweenInfo or TweenInfo.new()
		},
		METATABLE
	) :: any
	local destroy = function()
		self.scope = nil
		for dependency in pairs(self.dependencySet) do
			dependency.dependentSet[self] = nil
		end
	end
	self.oldestTask = destroy
	nicknames[self.oldestTask] = "Tween"
	table.insert(scope, destroy)

	if goalState ~= nil then
		checkLifetime.bOutlivesA(
			scope, self.oldestTask,
			goalState.scope, goalState.oldestTask,
			checkLifetime.formatters.animationGoal
		)
	end

	local tweenInfoState = castToState(tweenInfo)
	if tweenInfoState ~= nil then
		checkLifetime.bOutlivesA(
			scope, self.oldestTask,
			tweenInfoState.scope, tweenInfoState.oldestTask,
			checkLifetime.formatters.parameter, "tween info"
		)
	end

	-- Eagerly evaluated objects need to evaluate themselves so that they're
	-- valid at all times.
	evaluate(self, true)

	return self
end

function class.get<T>(
	self: Self<T>
): never
	return External.logError("stateGetWasRemoved")
end

function class._evaluate<T>(
	self: Self<T>
): boolean
	local goal = castToState(self._goal)
	-- Allow non-state goals to pass through transparently.
	if goal == nil then
		self._EXTREMELY_DANGEROUS_usedAsValue = self._goal :: T
		return false
	end
	depend(self, goal)
	local newTweenTo = peek(goal)
	-- Protect against NaN goals.
	if newTweenTo ~= newTweenTo then
		External.logWarn("tweenNanGoal")
		return false
	end
	local stopwatch = self._stopwatch :: Stopwatch.Stopwatch
	local tweenInfo = peek(self._tweenInfo) :: TweenInfo
	-- Restart animation when the goal changes, or if the tween info changes
	-- partway through another animation.
	if 
		self._activeTo ~= newTweenTo or
		(self._activeElapsed < self._activeDuration and self._activeTweenInfo ~= tweenInfo)
	then
		self._activeDuration = getTweenDuration(tweenInfo)
		self._activeFrom = self._EXTREMELY_DANGEROUS_usedAsValue
		self._activeTo = newTweenTo
		self._activeTweenInfo = tweenInfo
		stopwatch:zero()
		stopwatch:unpause()
	end
	depend(self, stopwatch)
	self._activeElapsed = peek(stopwatch)
	if
		self._activeFrom == self._activeTo or -- endpoints match
		self._activeElapsed >= self._activeDuration or -- animation is done
		typeof(self._activeTo) ~= typeof(self._activeFrom) -- type difference
	then
		self._activeFrom = self._activeTo
		self._activeElapsed = self._activeDuration
		stopwatch:pause()
	end
	-- Compute actual tweened value.
	local ratio = getTweenRatio(tweenInfo, self._activeElapsed)
	local oldValue = self._EXTREMELY_DANGEROUS_usedAsValue
	local newValue = lerpType(self._activeFrom, self._activeTo, ratio) :: T
	-- Protect against NaN after motion.
	if newValue ~= newValue then
		External.logWarn("tweenNanMotion")
		newValue = self._activeTo
	end
	-- Push update and check for similarity.
	-- Don't need to use the similarity test here because this code doesn't
	-- deal with tables, and NaN is already guarded against, so the similarity
	-- test doesn't actually add any new safety here.
	self._EXTREMELY_DANGEROUS_usedAsValue = newValue
	return oldValue ~= newValue
end

table.freeze(class)
return Tween :: Types.TweenConstructor
]]></Source>
		<Source path="ReplicatedStorage/Modules/Libraries/Fusion/Animation/getTweenDuration"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Given a `tweenInfo`, returns how many seconds it will take before the tween
	finishes moving. The result may be infinite if the tween repeats forever.
]]

local TweenService = game:GetService("TweenService")

local function getTweenDuration(
	tweenInfo: TweenInfo
): number
	if tweenInfo.RepeatCount <= -1 then
		return math.huge
	end
	local tweenDuration = tweenInfo.DelayTime + tweenInfo.Time
	if tweenInfo.Reverses then
		tweenDuration += tweenInfo.Time
	end
	tweenDuration *= tweenInfo.RepeatCount + 1
	return tweenDuration
end

return getTweenDuration
]]></Source>
		<Source path="ReplicatedStorage/Modules/Libraries/Fusion/Animation/getTweenRatio"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Given a `tweenInfo` and `currentTime`, returns a ratio which can be used to
	tween between two values over time.
]]

local TweenService = game:GetService("TweenService")

local function getTweenRatio(
	tweenInfo: TweenInfo,
	currentTime: number
): number
	local delay = tweenInfo.DelayTime
	local duration = tweenInfo.Time
	local reverses = tweenInfo.Reverses
	local numCycles = 1 + tweenInfo.RepeatCount
	local easeStyle = tweenInfo.EasingStyle
	local easeDirection = tweenInfo.EasingDirection
	local cycleDuration = delay + duration
	if reverses then
		cycleDuration += duration
	end
	-- If currentTime is infinity, then presumably the tween should be over.
	-- This avoids NaN when the duration of an infinitely repeating tween is given.
	if currentTime == math.huge then
		return 1
	end
	if currentTime >= cycleDuration * numCycles and tweenInfo.RepeatCount > -1 then
		return 1
	end
	local cycleTime = currentTime % cycleDuration
	if cycleTime <= delay then
		return 0
	end
	local tweenProgress = (cycleTime - delay) / duration
	if tweenProgress > 1 then
		tweenProgress = 2 - tweenProgress
	end
	local ratio = TweenService:GetValue(tweenProgress, easeStyle, easeDirection)
	return ratio
end

return getTweenRatio
]]></Source>
		<Source path="ReplicatedStorage/Modules/Libraries/Fusion/Animation/lerpType"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Linearly interpolates the given animatable types by a ratio.
	If the types are different or not animatable, then the first value will be
	returned for ratios below 0.5, and the second value for 0.5 and above.
]]

local Package = script.Parent.Parent
local Oklab = require(Package.Colour.Oklab)

local function lerpType(
	from: unknown, 
	to: unknown, 
	ratio: number
): unknown
	local typeString = typeof(from)

	if typeof(to) == typeString then
		-- both types must match for interpolation to make sense
		if typeString == "number" then
			local to, from = to :: number, from :: number
			return (to - from) * ratio + from

		elseif typeString == "CFrame" then
			local to, from = to :: CFrame, from :: CFrame
			return from:Lerp(to, ratio)

		elseif typeString == "Color3" then
			local to, from = to :: Color3, from :: Color3
			local fromLab = Oklab.fromSRGB(from)
			local toLab = Oklab.fromSRGB(to)
			return Oklab.toSRGB(
				fromLab:Lerp(toLab, ratio),
				false
			)

		elseif typeString == "ColorSequenceKeypoint" then
			local to, from = to :: ColorSequenceKeypoint, from :: ColorSequenceKeypoint
			local fromLab = Oklab.fromSRGB(from.Value)
			local toLab = Oklab.fromSRGB(to.Value)
			return ColorSequenceKeypoint.new(
				(to.Time - from.Time) * ratio + from.Time,
				Oklab.toSRGB(
					fromLab:Lerp(toLab, ratio),
					false
				)
			)

		elseif typeString == "DateTime" then
			local to, from = to :: DateTime, from :: DateTime
			return DateTime.fromUnixTimestampMillis(
				(to.UnixTimestampMillis - from.UnixTimestampMillis) * ratio + from.UnixTimestampMillis
			)

		elseif typeString == "NumberRange" then
			local to, from = to :: NumberRange, from :: NumberRange
			return NumberRange.new(
				(to.Min - from.Min) * ratio + from.Min,
				(to.Max - from.Max) * ratio + from.Max
			)

		elseif typeString == "NumberSequenceKeypoint" then
			local to, from = to :: NumberSequenceKeypoint, from :: NumberSequenceKeypoint
			return NumberSequenceKeypoint.new(
				(to.Time - from.Time) * ratio + from.Time,
				(to.Value - from.Value) * ratio + from.Value,
				(to.Envelope - from.Envelope) * ratio + from.Envelope
			)

		elseif typeString == "PhysicalProperties" then
			local to, from = to :: PhysicalProperties, from :: PhysicalProperties
			return PhysicalProperties.new(
				(to.Density - from.Density) * ratio + from.Density,
				(to.Friction - from.Friction) * ratio + from.Friction,
				(to.Elasticity - from.Elasticity) * ratio + from.Elasticity,
				(to.FrictionWeight - from.FrictionWeight) * ratio + from.FrictionWeight,
				(to.ElasticityWeight - from.ElasticityWeight) * ratio + from.ElasticityWeight
			)

		elseif typeString == "Ray" then
			local to, from = to :: Ray, from :: Ray
			return Ray.new(
				from.Origin:Lerp(to.Origin, ratio),
				from.Direction:Lerp(to.Direction, ratio)
			)

		elseif typeString == "Rect" then
			local to, from = to :: Rect, from :: Rect
			return Rect.new(
				from.Min:Lerp(to.Min, ratio),
				from.Max:Lerp(to.Max, ratio)
			)

		elseif typeString == "Region3" then
			local to, from = to :: Region3, from :: Region3
			-- FUTURE: support rotated Region3s if/when they become constructable
			local position = from.CFrame.Position:Lerp(to.CFrame.Position, ratio)
			local halfSize = from.Size:Lerp(to.Size, ratio) / 2
			return Region3.new(position - halfSize, position + halfSize)

		elseif typeString == "Region3int16" then
			local to, from = to :: Region3int16, from :: Region3int16
			return Region3int16.new(
				Vector3int16.new(
					(to.Min.X - from.Min.X) * ratio + from.Min.X,
					(to.Min.Y - from.Min.Y) * ratio + from.Min.Y,
					(to.Min.Z - from.Min.Z) * ratio + from.Min.Z
				),
				Vector3int16.new(
					(to.Max.X - from.Max.X) * ratio + from.Max.X,
					(to.Max.Y - from.Max.Y) * ratio + from.Max.Y,
					(to.Max.Z - from.Max.Z) * ratio + from.Max.Z
				)
			)

		elseif typeString == "UDim" then
			local to, from = to :: UDim, from :: UDim
			return UDim.new(
				(to.Scale - from.Scale) * ratio + from.Scale,
				(to.Offset - from.Offset) * ratio + from.Offset
			)

		elseif typeString == "UDim2" then
			local to, from = to :: UDim2, from :: UDim2
			return from:Lerp(to, ratio)

		elseif typeString == "Vector2" then
			local to, from = to :: Vector2, from :: Vector2
			return from:Lerp(to, ratio)

		elseif typeString == "Vector2int16" then
			local to, from = to :: Vector2int16, from :: Vector2int16
			return Vector2int16.new(
				(to.X - from.X) * ratio + from.X,
				(to.Y - from.Y) * ratio + from.Y
			)

		elseif typeString == "Vector3" then
			local to, from = to :: Vector3, from :: Vector3
			return from:Lerp(to, ratio)

		elseif typeString == "Vector3int16" then
			local to, from = to :: Vector3int16, from :: Vector3int16
			return Vector3int16.new(
				(to.X - from.X) * ratio + from.X,
				(to.Y - from.Y) * ratio + from.Y,
				(to.Z - from.Z) * ratio + from.Z
			)
		end
	end

	-- fallback case: the types are different or not animatable
	if ratio < 0.5 then
		return from
	else
		return to
	end
end

return lerpType]]></Source>
		<Source path="ReplicatedStorage/Modules/Libraries/Fusion/Animation/packType"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Packs an array of numbers into a given animatable data type.
	If the type is not animatable, nil will be returned.
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)
local Oklab = require(Package.Colour.Oklab)

local function packType(
	numbers: {number},
	typeString: string
): Types.Animatable?
	if typeString == "number" then
		return numbers[1]

	elseif typeString == "CFrame" then
		return
			CFrame.new(numbers[1], numbers[2], numbers[3]) *
			CFrame.fromAxisAngle(
				Vector3.new(numbers[4], numbers[5], numbers[6]).Unit,
				numbers[7]
			)

	elseif typeString == "Color3" then
		return Oklab.toSRGB(
			Vector3.new(numbers[1], numbers[2], numbers[3]),
			false
		)

	elseif typeString == "ColorSequenceKeypoint" then
		return ColorSequenceKeypoint.new(
			numbers[4],
			Oklab.toSRGB(
				Vector3.new(numbers[1], numbers[2], numbers[3]),
				false
			)
		)

	elseif typeString == "DateTime" then
		return DateTime.fromUnixTimestampMillis(numbers[1])

	elseif typeString == "NumberRange" then
		return NumberRange.new(numbers[1], numbers[2])

	elseif typeString == "NumberSequenceKeypoint" then
		return NumberSequenceKeypoint.new(numbers[2], numbers[1], numbers[3])

	elseif typeString == "PhysicalProperties" then
		return PhysicalProperties.new(numbers[1], numbers[2], numbers[3], numbers[4], numbers[5])

	elseif typeString == "Ray" then
		return Ray.new(
			Vector3.new(numbers[1], numbers[2], numbers[3]),
			Vector3.new(numbers[4], numbers[5], numbers[6])
		)

	elseif typeString == "Rect" then
		return Rect.new(numbers[1], numbers[2], numbers[3], numbers[4])

	elseif typeString == "Region3" then
		-- FUTURE: support rotated Region3s if/when they become constructable
		local position = Vector3.new(numbers[1], numbers[2], numbers[3])
		local halfSize = Vector3.new(numbers[4] / 2, numbers[5] / 2, numbers[6] / 2)
		return Region3.new(position - halfSize, position + halfSize)

	elseif typeString == "Region3int16" then
		return Region3int16.new(
			Vector3int16.new(numbers[1], numbers[2], numbers[3]),
			Vector3int16.new(numbers[4], numbers[5], numbers[6])
		)

	elseif typeString == "UDim" then
		return UDim.new(numbers[1], numbers[2])

	elseif typeString == "UDim2" then
		return UDim2.new(numbers[1], numbers[2], numbers[3], numbers[4])

	elseif typeString == "Vector2" then
		return Vector2.new(numbers[1], numbers[2])

	elseif typeString == "Vector2int16" then
		return Vector2int16.new(numbers[1], numbers[2])

	elseif typeString == "Vector3" then
		return Vector3.new(numbers[1], numbers[2], numbers[3])

	elseif typeString == "Vector3int16" then
		return Vector3int16.new(numbers[1], numbers[2], numbers[3])
	else
		return nil
	end
end

return packType]]></Source>
		<Source path="ReplicatedStorage/Modules/Libraries/Fusion/Animation/springCoefficients"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Returns a 2x2 matrix of coefficients for a given time, damping and angular
	frequency (aka 'speed').
	
	Specifically, this returns four coefficients - posPos, posVel, velPos, and
	velVel - which can be multiplied with position and velocity like so:

	local newPosition = oldPosition * posPos + oldVelocity * posVel
	local newVelocity = oldPosition * velPos + oldVelocity * velVel

	For speed = 1 and damping = 0, the result is a simple harmonic oscillator
	with a period of tau.

	Special thanks to AxisAngle for helping to improve numerical precision.
]]

local function springCoefficients(
	time: number,
	damping: number,
	speed: number
): (number, number, number, number)
	-- if time or speed is 0, then the spring won't move
	if time == 0 or speed == 0 then
		return 1, 0, 0, 1
	end
	local posPos, posVel, velPos, velVel

	if damping > 1 then
		-- overdamped spring

		local alpha = math.sqrt(damping^2 - 1)
		local negHalf_over_alpha_speed = -0.5 / (alpha * speed)
		local z1 = speed * (alpha + damping) * -1
		local z2 = speed * (alpha - damping)
		local exp1 = math.exp(time * z1)
		local exp2 = math.exp(time * z2)

		posPos = (exp2 * z1 - exp1 * z2) * negHalf_over_alpha_speed
		posVel = (exp1 - exp2) * negHalf_over_alpha_speed / speed
		velPos = (exp2 - exp1) * negHalf_over_alpha_speed * speed
		velVel = (exp1 * z1 - exp2 * z2) * negHalf_over_alpha_speed

	elseif damping == 1 then
		-- critically damped spring

		local time_speed = time * speed
		local time_speed_neg1 = time_speed * -1
		local exp = math.exp(time_speed_neg1)

		posPos = exp * (time_speed + 1)
		posVel = exp * time
		velPos = exp * (time_speed_neg1 * speed)
		velVel = exp * (time_speed_neg1 + 1)
	else
		-- underdamped spring

		local alpha = speed * math.sqrt(1 - damping^2)
		local overAlpha = 1 / alpha
		local exp = math.exp(-1 * time * speed * damping)
		local sin = math.sin(alpha * time)
		local cos = math.cos(alpha * time)
		local exp_sin = exp * sin
		local exp_cos = exp * cos
		local exp_sin_speed_damping_overAlpha = exp_sin * speed * damping * overAlpha

		posPos = exp_sin_speed_damping_overAlpha + exp_cos
		posVel = exp_sin * overAlpha
		velPos = -1 * ( exp_sin * alpha + speed * damping * exp_sin_speed_damping_overAlpha )
		velVel = exp_cos - exp_sin_speed_damping_overAlpha
	end

	return posPos, posVel, velPos, velVel
end

return springCoefficients
]]></Source>
		<Source path="ReplicatedStorage/Modules/Libraries/Fusion/Animation/unpackType"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Unpacks an animatable type into an array of numbers.
	If the type is not animatable, an empty array will be returned.
]]

local Package = script.Parent.Parent
local Oklab = require(Package.Colour.Oklab)

local function unpackType(
	value: unknown,
	typeString: string
): {number}
	if typeString == "number" then
		local value = value :: number
		return {value}

	elseif typeString == "CFrame" then
		local value = value :: CFrame
		-- FUTURE: is there a better way of doing this? doing distance
		-- calculations on `angle` may be incorrect
		local axis, angle = value:ToAxisAngle()
		return {value.X, value.Y, value.Z, axis.X, axis.Y, axis.Z, angle}

	elseif typeString == "Color3" then
		local value = value :: Color3
		local lab = Oklab.fromSRGB(value)
		return {lab.X, lab.Y, lab.Z}

	elseif typeString == "ColorSequenceKeypoint" then
		local value = value :: ColorSequenceKeypoint
		local lab = Oklab.fromSRGB(value.Value)
		return {lab.X, lab.Y, lab.Z, value.Time}

	elseif typeString == "DateTime" then
		local value = value :: DateTime
		return {value.UnixTimestampMillis}

	elseif typeString == "NumberRange" then
		local value = value :: NumberRange
		return {value.Min, value.Max}

	elseif typeString == "NumberSequenceKeypoint" then
		local value = value :: NumberSequenceKeypoint
		return {value.Value, value.Time, value.Envelope}

	elseif typeString == "PhysicalProperties" then
		local value = value :: PhysicalProperties
		return {value.Density, value.Friction, value.Elasticity, value.FrictionWeight, value.ElasticityWeight}

	elseif typeString == "Ray" then
		local value = value :: Ray
		return {value.Origin.X, value.Origin.Y, value.Origin.Z, value.Direction.X, value.Direction.Y, value.Direction.Z}

	elseif typeString == "Rect" then
		local value = value :: Rect
		return {value.Min.X, value.Min.Y, value.Max.X, value.Max.Y}

	elseif typeString == "Region3" then
		local value = value :: Region3
		-- FUTURE: support rotated Region3s if/when they become constructable
		return {
			value.CFrame.X, value.CFrame.Y, value.CFrame.Z,
			value.Size.X, value.Size.Y, value.Size.Z
		}

	elseif typeString == "Region3int16" then
		local value = value :: Region3int16
		return {value.Min.X, value.Min.Y, value.Min.Z, value.Max.X, value.Max.Y, value.Max.Z}

	elseif typeString == "UDim" then
		local value = value :: UDim
		return {value.Scale, value.Offset}

	elseif typeString == "UDim2" then
		local value = value :: UDim2
		return {value.X.Scale, value.X.Offset, value.Y.Scale, value.Y.Offset}

	elseif typeString == "Vector2" then
		local value = value :: Vector2
		return {value.X, value.Y}

	elseif typeString == "Vector2int16" then
		local value = value :: Vector2int16
		return {value.X, value.Y}

	elseif typeString == "Vector3" then
		local value = value :: Vector3
		return {value.X, value.Y, value.Z}

	elseif typeString == "Vector3int16" then
		local value = value :: Vector3int16
		return {value.X, value.Y, value.Z}
	else
		return {}
	end
end

return unpackType]]></Source>
		<Source path="ReplicatedStorage/Modules/Libraries/Fusion/Colour/Oklab"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Provides functions for converting Color3s into Oklab space, for more
	perceptually uniform colour blending.

	See: https://bottosson.github.io/posts/oklab/
]]

local sRGB = require(script.Parent.sRGB)

local Oklab = {}

-- Converts a Color3 in linear RGB space to a Vector3 in Oklab space.
function Oklab.fromLinear(rgb: Color3): Vector3

	local l = rgb.R * 0.4122214708 + rgb.G * 0.5363325363 + rgb.B * 0.0514459929
	local m = rgb.R * 0.2119034982 + rgb.G * 0.6806995451 + rgb.B * 0.1073969566
	local s = rgb.R * 0.0883024619 + rgb.G * 0.2817188376 + rgb.B * 0.6299787005

	local lRoot = l ^ (1/3)
	local mRoot = m ^ (1/3)
	local sRoot = s ^ (1/3)

	return Vector3.new(
		lRoot * 0.2104542553 + mRoot * 0.7936177850 - sRoot * 0.0040720468,
		lRoot * 1.9779984951 - mRoot * 2.4285922050 + sRoot * 0.4505937099,
		lRoot * 0.0259040371 + mRoot * 0.7827717662 - sRoot * 0.8086757660
	)
end

-- Converts a Color3 in sRGB space to a Vector3 in Oklab space.
function Oklab.fromSRGB(srgb: Color3): Vector3
	return Oklab.fromLinear(sRGB.toLinear(srgb))
end

-- Converts a Vector3 in Oklab space to a Color3 in linear RGB space.
-- The Color3 will be clamped by default unless specified otherwise.
function Oklab.toLinear(lab: Vector3, unclamped: boolean?): Color3
	local lRoot = lab.X + lab.Y * 0.3963377774 + lab.Z * 0.2158037573
	local mRoot = lab.X - lab.Y * 0.1055613458 - lab.Z * 0.0638541728
	local sRoot = lab.X - lab.Y * 0.0894841775 - lab.Z * 1.2914855480

	local l = lRoot ^ 3
	local m = mRoot ^ 3
	local s = sRoot ^ 3

	local red = l * 4.0767416621 - m * 3.3077115913 + s * 0.2309699292
	local green = l * -1.2684380046 + m * 2.6097574011 - s * 0.3413193965
	local blue = l * -0.0041960863 - m * 0.7034186147 + s * 1.7076147010

	if not unclamped then
		red = math.clamp(red, 0, 1)
		green = math.clamp(green, 0, 1)
		blue = math.clamp(blue, 0, 1)
	end

	return Color3.new(red, green, blue)
end

-- Converts a Vector3 in Oklab space to a Color3 in sRGB space.
-- The Color3 will be clamped by default unless specified otherwise.
function Oklab.toSRGB(lab: Vector3, unclamped: boolean?): Color3
	return sRGB.fromLinear(Oklab.toLinear(lab, unclamped))
end

return Oklab
]]></Source>
		<Source path="ReplicatedStorage/Modules/Libraries/Fusion/Colour/sRGB"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
    Provides transformation functions for converting linear RGB values
    into sRGB values.

    RGB color channel transformations are outlined here:
    https://bottosson.github.io/posts/colorwrong/#what-can-we-do%3F
]]

local sRGB = {}

-- Equivalent to f_inv. Takes a linear sRGB channel and returns
-- the sRGB channel
local function transform(channel: number): number
    if channel >= 0.04045 then
        return ((channel + 0.055)/(1 + 0.055))^2.4
    else
        return channel / 12.92
    end
end

-- Equivalent to f. Takes an sRGB channel and returns
-- the linear sRGB channel
local function inverse(channel: number): number
    if channel >= 0.0031308 then
        return (1.055) * channel^(1.0/2.4) - 0.055
    else
        return 12.92 * channel
    end
end

-- Uses a tranformation to convert linear RGB into sRGB.
function sRGB.fromLinear(rgb: Color3): Color3
    return Color3.new(
        transform(rgb.R),
        transform(rgb.G),
        transform(rgb.B)
    )
end

-- Converts an sRGB into linear RGB using a
-- (The inverse of sRGB.fromLinear).
function sRGB.toLinear(srgb: Color3): Color3
    return Color3.new(
        inverse(srgb.R),
        inverse(srgb.G),
        inverse(srgb.B)
    )
end

return sRGB]]></Source>
		<Source path="ReplicatedStorage/Modules/Libraries/Fusion/External"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Abstraction layer between Fusion internals and external environments,
	allowing for flexible integration with schedulers and test mocks.
]]

local Package = script.Parent
local formatError = require(Package.Logging.formatError)
local Types = require(Package.Types)

local ERROR_INFO_URL = "https://elttob.uk/Fusion/0.3/api-reference/general/errors/#"

local External = {}

-- Indicates that a highly time-critical passage of code is running. During
-- critical periods of a program, Fusion might decide to change some of its
-- internal behaviour to be more performance friendly.
local timeCritical = false

-- Multiplier for running-time safety checks across the Fusion codebase. Used to
-- stricten tests on infinite loop detection during unit testing.
External.safetyTimerMultiplier = 1

local updateStepCallbacks = {}
local currentProvider: Types.ExternalProvider? = nil
local lastUpdateStep = 0

--[[
	Swaps to a new provider for external operations.
	Returns the old provider, so it can be used again later.
]]
function External.setExternalProvider(
	newProvider: Types.ExternalProvider?
): Types.ExternalProvider?
	local oldProvider = currentProvider
	if oldProvider ~= nil then
		oldProvider.stopScheduler()
	end
	currentProvider = newProvider
	if newProvider ~= nil then
		newProvider.startScheduler()
	end
	return oldProvider
end

--[[
	Returns true if a highly time-critical passage of code is running.
]]
function External.isTimeCritical(): boolean
	return timeCritical
end

--[[
   Sends an immediate task to the external provider. Throws if none is set.
]]
function External.doTaskImmediate(
	resume: () -> ()
)
	if currentProvider == nil then
		External.logError("noTaskScheduler")
	else
		currentProvider.doTaskImmediate(resume)
	end
end

--[[
	Sends a deferred task to the external provider. Throws if none is set.
]]
function External.doTaskDeferred(
	resume: () -> ()
)
	if currentProvider == nil then
		External.logError("noTaskScheduler")
	else
		currentProvider.doTaskDeferred(resume)
	end
end

--[[
	Errors in the current thread and halts execution.
]]
function External.logError(
	messageID: string,
	errObj: Types.Error?,
	...: unknown
): never
	error(formatError(currentProvider, messageID, errObj, ...), 0)
end

--[[
	Errors in a different thread to preserve the flow of execution.
]]
function External.logErrorNonFatal(
	messageID: string,
	errObj: Types.Error?,
	...: unknown
): ()
	local errorString = formatError(currentProvider, messageID, errObj, ...)
	if currentProvider ~= nil then
		currentProvider.logErrorNonFatal(errorString)
	else
		print(errorString)
	end
end

--[[
	Shows a warning message in the output.
]]
function External.logWarn(
	messageID: string,
	...: unknown
): ()
	local errorString = formatError(currentProvider, messageID, debug.traceback(nil, 2), ...)
	if currentProvider ~= nil then
		currentProvider.logWarn(errorString)
	else
		print(errorString)
	end
end

--[[
	Registers a callback to the update step of the external provider.
	Returns a function that can be used to disconnect later.

	Callbacks are given the current number of seconds since an arbitrary epoch.
	
	TODO: This epoch may change between providers. We could investigate ways
	of allowing providers to co-operate to keep the epoch the same, so that
	monotonicity can be better preserved.
]]
function External.bindToUpdateStep(
	callback: (
		now: number
	) -> ()
): () -> ()
	local uniqueIdentifier = {}
	updateStepCallbacks[uniqueIdentifier] = callback
	return function()
		updateStepCallbacks[uniqueIdentifier] = nil
	end
end

--[[
	Steps time-dependent systems with the current number of seconds since an
	arbitrary epoch. This should be called as early as possible in the external
	provider's update cycle.
]]
function External.performUpdateStep(
	now: number
)
	lastUpdateStep = now
	for _, callback in updateStepCallbacks do
		callback(now)
	end
end

--[[
	Returns the timestamp of the last update step.
]]
function External.lastUpdateStep()
	return lastUpdateStep
end

return External]]></Source>
		<Source path="ReplicatedStorage/Modules/Libraries/Fusion/ExternalDebug"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Abstraction layer between Fusion internals and external debuggers, allowing
	for deep introspection using function hooks.

	Unlike `External`, attaching a debugger is optional, and all debugger
	functions are expected to be infallible and non-blocking.
]]

local Package = script.Parent
local Types = require(Package.Types)

local currentProvider: Types.ExternalDebugger? = nil
local lastUpdateStep = 0

local Debugger = {}

--[[
	Swaps to a new debugger.
	Returns the old debugger, so it can be used again later.
]]
function Debugger.setDebugger(
	newProvider: Types.ExternalDebugger?
): Types.ExternalDebugger?
	local oldProvider = currentProvider
	if oldProvider ~= nil then
		oldProvider.stopDebugging()
	end
	currentProvider = newProvider
	if newProvider ~= nil then
		newProvider.startDebugging()
	end
	return oldProvider
end

--[[
	Called at the earliest moment after a scope is created or removed from the
	scope pool, but not before the scope has finished being prepared by the
	library, so that debuggers can register its existence and track changes
	to the scope over time.
]]
function Debugger.trackScope(
	scope: Types.Scope<unknown>
): ()
	if currentProvider == nil then
		return
	end
	currentProvider.trackScope(scope)
end

--[[
	Called at the final moment before a scope is poisoned or added to the scope
	pool, after all cleanup tasks have completed, so that debuggers can erase 
	the scope from internal trackers. Note that, due to scope pooling and user
	code, never assume that this correlates with garbage collection events.
]]
function Debugger.untrackScope(
	scope: Types.Scope<unknown>
): ()
	if currentProvider == nil then
		return
	end
	currentProvider.trackScope(scope)
end

return Debugger]]></Source>
		<Source path="ReplicatedStorage/Modules/Libraries/Fusion/Graph/Observer"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	A graph object that runs user code when it's updated by the reactive graph.

	http://elttob.uk/Fusion/0.3/api-reference/state/types/observer/
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)
local External = require(Package.External)
-- Memory
local checkLifetime = require(Package.Memory.checkLifetime)
-- Graph
local castToGraph = require(Package.Graph.castToGraph)
local depend = require(Package.Graph.depend)
local evaluate = require(Package.Graph.evaluate)
-- Utility
local nicknames = require(Package.Utility.nicknames)

type Self = Types.Observer & {
	_watchingGraph: Types.GraphObject?,
	_changeListeners: {[unknown]: () -> ()}
}

local class = {}
class.type = "Observer"
class.timeliness = "eager"
class.dependentSet = table.freeze {}

local METATABLE = table.freeze {__index = class}

local function Observer(
	scope: Types.Scope<unknown>,
	watching: unknown
): Types.Observer
	local createdAt = os.clock()
	if watching == nil then
		External.logError("scopeMissing", nil, "Observers", "myScope:Observer(watching)")
	end

	local self: Self = setmetatable(
		{
			scope = scope,
			createdAt = createdAt,
			dependencySet = {},
			lastChange = nil,
			validity = "invalid",
			_watchingGraph = castToGraph(watching),
			_changeListeners = {}
		},
		METATABLE
	) :: any
	local destroy = function()
		self.scope = nil
		for dependency in pairs(self.dependencySet) do
			dependency.dependentSet[self] = nil
		end
	end
	self.oldestTask = destroy
	nicknames[self.oldestTask] = "Observer"
	table.insert(scope, destroy)

	if self._watchingGraph ~= nil then
		checkLifetime.bOutlivesA(
			scope, self.oldestTask,
			self._watchingGraph.scope, self._watchingGraph.oldestTask,
			checkLifetime.formatters.observer
		)
	end

	-- Eagerly evaluated objects need to evaluate themselves so that they're
	-- valid at all times.
	evaluate(self, true)

	return self
end

function class.onBind(
	self: Self,
	callback: () -> ()
): () -> ()
	External.doTaskImmediate(callback)
	return self:onChange(callback)
end

function class.onChange(
	self: Self,
	callback: () -> ()
): () -> ()
	local uniqueIdentifier = table.freeze {}
	self._changeListeners[uniqueIdentifier] = callback
	return function()
		self._changeListeners[uniqueIdentifier] = nil
	end
end

function class._evaluate(
	self: Self
): ()
	if self._watchingGraph ~= nil then
		depend(self, self._watchingGraph)
	end
	for _, callback in self._changeListeners do
		External.doTaskImmediate(callback)
	end
	return true
end

table.freeze(class)
return Observer :: Types.ObserverConstructor]]></Source>
		<Source path="ReplicatedStorage/Modules/Libraries/Fusion/Graph/castToGraph"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Returns the input *only* if it is a graph object.
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)

local function castToGraph(
	target: any
): Types.GraphObject?
	if 
		typeof(target) == "table" and
		typeof(target.validity) == "string" and
		typeof(target.timeliness) == "string" and
		typeof(target.dependencySet) == "table" and
		typeof(target.dependentSet) == "table"
	then
		return target
	else
		return nil
	end
end

return castToGraph]]></Source>
		<Source path="ReplicatedStorage/Modules/Libraries/Fusion/Graph/change"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Prompts a graph object to re-evaluate its own value. If it meaningfully
	changes, then dependents will have to re-evaluate their own values in the
	future.

	https://fluff.blog/2024/04/16/monotonic-painting.html
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)
local External = require(Package.External)
local evaluate = require(Package.Graph.evaluate)

-- How long should this function run before it's considered to be in an infinite
-- cycle and error out?
local TERMINATION_TIME = 1

local function change(
	target: Types.GraphObject
): ()
	if target.validity == "busy" then
		return External.logError("infiniteLoop")
	end

	local meaningfullyChanged = evaluate(target, true)
	if not meaningfullyChanged then
		return
	end

	local searchInNow: {Types.GraphObject} = {}
	local searchInNext: {Types.GraphObject} = {}
	local invalidateList: {Types.GraphObject} = {}

	searchInNow[1] = target
	local terminateBy = os.clock() + TERMINATION_TIME * External.safetyTimerMultiplier
	repeat
		if os.clock() > terminateBy then
			return External.logError("infiniteLoop")
		end
		local done = true
		for _, searchTarget in searchInNow do
			for dependent in searchTarget.dependentSet do
				if dependent.validity == "valid" then
					done = false
					table.insert(invalidateList, dependent)
					table.insert(searchInNext, dependent)
				elseif dependent.validity == "busy" then
					return External.logError("infiniteLoop")
				end
			end
		end
		searchInNow, searchInNext = searchInNext, searchInNow
		table.clear(searchInNext)
	until done

	local eagerList: {Types.GraphObject} = {}

	for _, invalidateTarget in invalidateList do
		invalidateTarget.validity = "invalid"
		if invalidateTarget.timeliness == "eager" then
			table.insert(eagerList, invalidateTarget)
		end
	end
	-- If objects are not executed in order of creations, then dynamic graphs
	-- may experience 'glitches' where nested graph objects see intermediate
	-- values before being destroyed.
	-- https://fluff.blog/2024/07/14/glitches-in-dynamic-reactive-graphs.html
	table.sort(eagerList, function(a, b)
		return a.createdAt < b.createdAt
	end)
	for _, eagerTarget in eagerList do
		evaluate(eagerTarget, false)
	end
end

return change]]></Source>
		<Source path="ReplicatedStorage/Modules/Libraries/Fusion/Graph/depend"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Forms a dependency on a graph object.
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)
local External = require(Package.External)
local evaluate = require(Package.Graph.evaluate)
local nameOf = require(Package.Utility.nameOf)

local function depend<T>(
	dependent: Types.GraphObject,
	dependency: Types.GraphObject
): ()
	-- Ensure dependencies are evaluated and up-to-date
	-- when they are depended on. Also, newly created objects
	-- might not have any transitive dependencies captured yet,
	-- so ensure that they're present.
	evaluate(dependency, false)

	if table.isfrozen(dependent.dependencySet) or table.isfrozen(dependency.dependentSet) then
		External.logError("cannotDepend", nil, nameOf(dependent, "Dependent"), nameOf(dependency, "dependency"))
	end
	dependency.dependentSet[dependent] = true
	dependent.dependencySet[dependency] = true
end

return depend]]></Source>
		<Source path="ReplicatedStorage/Modules/Libraries/Fusion/Graph/evaluate"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Evaluates the graph object if necessary, so that it is up to date.
	Returns true if it meaningfully changed.

	https://fluff.blog/2024/04/16/monotonic-painting.html
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)
local External = require(Package.External)

local function evaluate(
	target: Types.GraphObject,
	forceComputation: boolean
): boolean
	if target.validity == "busy" then
		return External.logError("infiniteLoop")
	end
	local firstEvaluation = target.lastChange == nil
	local isInvalid = target.validity == "invalid"
	if firstEvaluation or isInvalid or forceComputation then
		local needsComputation = firstEvaluation or forceComputation
		if not needsComputation then
			for dependency in target.dependencySet do
				evaluate(dependency, false)
				if dependency.lastChange > target.lastChange then
					needsComputation = true
					break
				end
			end
		end
		local targetMeaningfullyChanged = false
		if needsComputation then
			for dependency in target.dependencySet do
				dependency.dependentSet[target] = nil
				target.dependencySet[dependency] = nil
			end
			target.validity = "busy"
			targetMeaningfullyChanged = target:_evaluate() or firstEvaluation
		end
		if targetMeaningfullyChanged then
			target.lastChange = os.clock()
		end
		target.validity = "valid"
		return targetMeaningfullyChanged
	else
		return false
	end
end

return evaluate]]></Source>
		<Source path="ReplicatedStorage/Modules/Libraries/Fusion/Instances/Attribute"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	A special key for property tables, which allows users to apply custom
	attributes to instances
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)
-- Memory
local checkLifetime = require(Package.Memory.checkLifetime)
-- Graph
local Observer = require(Package.Graph.Observer)
-- State
local castToState = require(Package.State.castToState)
local peek = require(Package.State.peek)

local keyCache: {[string]: Types.SpecialKey} = {}

local function Attribute(
	attributeName: string
): Types.SpecialKey
	local key = keyCache[attributeName]
	if key == nil then
		key = {
			type = "SpecialKey",
			kind = "Attribute",
			stage = "self",
			apply = function(
				self: Types.SpecialKey,
				scope: Types.Scope<unknown>,
				value: unknown,
				applyTo: Instance
			)
				if castToState(value) then
					local value = value :: Types.StateObject<unknown>
					checkLifetime.bOutlivesA(
						scope, applyTo,
						value.scope, value.oldestTask,
						checkLifetime.formatters.boundAttribute, attributeName
					)
					Observer(scope, value :: any):onBind(function()
						applyTo:SetAttribute(attributeName, peek(value))
					end)
				else
					applyTo:SetAttribute(attributeName, value)
				end
			end
		}
		keyCache[attributeName] = key
	end
	return key
end

return Attribute]]></Source>
		<Source path="ReplicatedStorage/Modules/Libraries/Fusion/Instances/AttributeChange"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	A special key for property tables, which allows users to connect to
	an attribute change on an instance.
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)
local External = require(Package.External)

local keyCache: {[string]: Types.SpecialKey} = {}

local function AttributeChange(
	attributeName: string
): Types.SpecialKey
	local key = keyCache[attributeName]
	if key == nil then
		key = {
			type = "SpecialKey",
			kind = "AttributeChange",
			stage = "observer",
			apply = function(
				self: Types.SpecialKey,
				scope: Types.Scope<unknown>,
				value: unknown,
				applyTo: Instance
			)
				if typeof(value) ~= "function" then
					External.logError("invalidAttributeChangeHandler", nil, attributeName)
				end
				local value = value :: (...unknown) -> (...unknown)
				local event = applyTo:GetAttributeChangedSignal(attributeName)
				table.insert(scope, event:Connect(function()
					value((applyTo :: any):GetAttribute(attributeName))
				end))
			end
		}
		keyCache[attributeName] = key
	end
	return key
end

return AttributeChange]]></Source>
		<Source path="ReplicatedStorage/Modules/Libraries/Fusion/Instances/AttributeOut"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	A special key for property tables, which allows users to save instance attributes
	into state objects
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)
local External = require(Package.External)
-- Memory
local checkLifetime = require(Package.Memory.checkLifetime)
-- State
local castToState = require(Package.State.castToState)

local keyCache: {[string]: Types.SpecialKey} = {}

local function AttributeOut(
	attributeName: string
): Types.SpecialKey
	local key = keyCache[attributeName]
	if key == nil then
		key = {
			type = "SpecialKey",
			kind = "AttributeOut",
			stage = "observer",
			apply = function(
				self: Types.SpecialKey,
				scope: Types.Scope<unknown>,
				value: unknown,
				applyTo: Instance
			)
				local event = applyTo:GetAttributeChangedSignal(attributeName)
	
				if not castToState(value) then
					External.logError("invalidAttributeOutType")
				end
				local value = value :: Types.StateObject<unknown>
				if value.kind ~= "Value" then
					External.logError("invalidAttributeOutType")
				end
				local value = value :: Types.Value<unknown>
				checkLifetime.bOutlivesA(
					scope, applyTo,
					value.scope, value.oldestTask,
					checkLifetime.formatters.attributeOutputsTo, attributeName
				)

				value:set((applyTo :: any):GetAttribute(attributeName))
				table.insert(scope, event:Connect(function()	
					value:set((applyTo :: any):GetAttribute(attributeName))
				end))
			end
		}
		keyCache[attributeName] = key
	end
	return key
end

return AttributeOut
]]></Source>
