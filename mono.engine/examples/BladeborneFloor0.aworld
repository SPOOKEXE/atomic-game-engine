return {
	Name = 'SetWeather',
	Aliases = { 'weather', 'set_weather' },
	Description = 'Force the global weather state. ' ..
		'`clear` / `thunderstorm` lock the state; `auto` resumes the ambient randomizer.',
	Group = 'Admin',
