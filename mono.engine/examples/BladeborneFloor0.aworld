	Aliases = { "tpws", "teleportws" },
	Description = "Teleport a player to a specific waystone (admin: bypasses combat-log " ..
		"and source-tier gates so cross-floor travel works without standing on a major waystone).",
	Group = "Admin",
	Args = {
		{ Type = "player", Name = "target",     Description = "Target player." },
