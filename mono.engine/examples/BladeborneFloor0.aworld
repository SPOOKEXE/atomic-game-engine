		AttributeXPData = { AttributeId = 'Agility', Amount = 25 },
		ConsumptionData = { Effects = {}, Inflicts = {}, Consumes = true, ConsumeQuantity = 1, MinimumQuantity = 1, Cooldown = 0.5 },
		Display = BasicColorDisplay('Agility Scroll', '+25 Agility XP. Lighter on your feet.', Color3.fromRGB(140, 220, 150)),
	}),
	VitalityScroll = FastDefineItem({
