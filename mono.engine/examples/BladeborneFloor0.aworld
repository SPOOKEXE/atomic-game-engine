	Aliases = { 'vfx', 'cinvfx' },
	Description = 'Fire a named VFX preset (see Data/CinematicPresets.luau) at your character.',
	Group = 'Admin',
	Args = {
		{
			Type = 'string',
			Name = 'presetName',
