	-- 	Category = 'Floor1',
	-- 	LayoutOrder = 2,
	-- 	Floor = 1,
	-- 	LargeWaystone = false,
	-- },
	F1_TowerEntrance = {
		Name = 'Floor 1 Tower Entrance',
		Category = 'Floor1',
		LayoutOrder = 3,
		Floor = 1,
		LargeWaystone = false,
	},
	F1_Wilderness1 = {
		Name = 'Floor 1 Wilderness 1',
		Category = 'Floor1',
		LayoutOrder = 4,
		Floor = 1,
		LargeWaystone = false,
	},
	F1_Wilderness2 = {
		Name = 'Floor 1 Wilderness 2',
		Category = 'Floor1',
		LayoutOrder = 5,
		Floor = 1,
		LargeWaystone = false,
	},
	F1_Wilderness3 = {
		Name = 'Floor 1 Wilderness 3',
		Category = 'Floor1',
		LayoutOrder = 6,
		Floor = 1,
		LargeWaystone = false,
	},
	F1_Wilderness4 = {
