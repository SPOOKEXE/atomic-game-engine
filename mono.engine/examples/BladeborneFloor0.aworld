		<Source path="src/ServerScriptService/CmdrSetup/Commands/attributes/GiveAttributeServer.luau"><![CDATA[local ServerStorage = game:GetService("ServerStorage")
local ServerCore = require(ServerStorage:WaitForChild('Core'))

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local AttributesConfig = require(ReplicatedStorage:WaitForChild('Modules')).Data.Attributes

return function(_context, target: Player, attributeId: string)
	if not AttributesConfig.GetConfigFromId(attributeId) then
		return string.format("No attribute config registered for '%s'.", attributeId)
	end
	local data = ServerCore.AttributeServer.GiveAttributeToPlayer(target, attributeId)
	if not data then
		return string.format("GiveAttributeToPlayer returned nil for %s on %s — save not loaded?", attributeId, target.Name)
	end
	return string.format("Unlocked attribute '%s' for %s (Lv %d, Xp %d).", attributeId, target.Name, data.Level, data.Experience)
end
]]></Source>
