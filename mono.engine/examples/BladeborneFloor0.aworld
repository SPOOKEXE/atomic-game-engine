		<Source path="src/ServerScriptService/CmdrSetup/Commands/crafting/UnlockRecipeServer.luau"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local CraftingConfig = require(ReplicatedStorage:WaitForChild('Modules')).Data.Crafting

return function(_context, target: Player, recipeId: string)
	if not CraftingConfig.Recipes[recipeId] then
		local known: { string } = {}
		for id in CraftingConfig.Recipes do known[#known + 1] = id end
		table.sort(known)
		return string.format('Unknown recipe id %q. Known: %s', recipeId, table.concat(known, ', '))
	end
	local CraftingServer = ServerCore.CraftingServer
	if not CraftingServer or not CraftingServer.UnlockRecipe then
		return 'CraftingServer.UnlockRecipe unavailable.'
	end
	local ok = CraftingServer.UnlockRecipe(target, recipeId)
	if not ok then return string.format('Failed to unlock %q for %s.', recipeId, target.Name) end
	return string.format('Unlocked %q for %s.', recipeId, target.Name)
end
]]></Source>
		<Source path="src/ServerScriptService/CmdrSetup/Commands/debug/PrintData.luau"><![CDATA[--!strict
-- Dump a target player's persistent session data to the server console as
-- a JSON string. Admin-only because it exposes the full record (pets,
-- currency, quests, etc.). The server script calls HttpService:JSONEncode
-- so the output is copy-pastable into any JSON viewer for inspection.
return {
	Name = "PrintData",
	Aliases = { "printdata", "pdata", "dumpdata" },
	Description = "JSON-dump a player's session data to the SERVER console.",
	Group = "Admin",
	Args = {
		{
			Type = "player",
			Name = "target",
			Description = "Player whose session Data to print",
		},
	},
}
]]></Source>
		<Source path="src/ServerScriptService/CmdrSetup/Commands/debug/PrintDataServer.luau"><![CDATA[
local HttpService = game:GetService("HttpService")

local ServerStorage = game:GetService("ServerStorage")
local ServerCore = require(ServerStorage:WaitForChild('Core'))
local ServerModules = require(ServerStorage:WaitForChild("Modules"))

return function(_context, target)
	if typeof(target) ~= "Instance" or not target:IsA("Player") then
		return "Invalid target."
	end

	local DataManagerServer = ServerCore.DataManagerServer
	local profile = DataManagerServer.GetProfileFromPlayer(target)

	if not profile then
		return string.format("%s(%d) does not have their profile loaded.", target.Name, target.UserId)
	end

	local ok, message = pcall(function()
		return HttpService:JSONEncode(profile.Data)
	end)
	if not ok then
		return string.format("JSONEncode failed for %s(%d): %s", target.Name, target.UserId, tostring(message))
	end

	print(string.format("[PrintData] %s(%d) Data = %s", target.Name, target.UserId, message))
	return ("Printed %s(%d)'s data (%d chars) to server console."):format(target.Name, target.UserId, #message)
end
]]></Source>
