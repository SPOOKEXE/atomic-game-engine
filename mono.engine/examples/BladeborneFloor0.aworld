		Cooldown = 0,
		Workstation = 'CookingPot',
	},

} :: { [string]: RecipeConfig }

return Module
]]></Source>
		<Source path="ReplicatedStorage/Modules/Data/Auras"><![CDATA[-- Aura configs. An aura is a visual flair attached to a specific anchor
-- (character / sword / mount). Players can equip ONE aura per anchor at
-- a time; the equipped trio is stored in the save struct and rendered
-- by AurasClient via FireAllClients spawn cues so other players see
-- them too.
--
-- ════════════════════════════════════════════════════════════════════
-- AUTHORING GUIDE — adding a new aura
-- ════════════════════════════════════════════════════════════════════
--
-- 1. Pick an Anchor: 'character' | 'sword' | 'mount'.
--    The anchor determines which body part the aura tracks. Each
--    player can equip ONE aura per anchor (3 simultaneous max).
--
-- 2. Pick a visual layer:
--    a. PROCEDURAL — built at runtime by AurasClient from the
--       Procedural{Particle,Beam,Light} fields below. Works without
--       any art assets; safe default for prototyping.
--    b. TEMPLATE — a pre-built ParticleEmitter/Beam/Attachment tree
--       under ReplicatedStorage.AssetsShared.VFX.Auras.<Particle>.
--       AurasClient clones every ParticleEmitter / Beam descendant
--       onto the anchor's attachment when this is set.
--
--    Both can coexist on the same aura — the template is preferred
--    when present, but the procedural layer ALWAYS runs as a fallback
--    so the aura is never invisible just because art hasn't shipped.
--
-- 3. Optional polish:
--    SFX.Loop      — continuous hum (positional)
--    SFX.Equip     — one-shot stinger on equip
--    Light         — point light at the anchor (works regardless of
--                    template / procedural state)
--
-- 4. Add a give command: /giveaura <player> <auraId>
--    Cmdr command lives under CmdrSetup/Commands/auras/.
--
-- ════════════════════════════════════════════════════════════════════
-- ASSET PIPELINE — when art is ready
-- ════════════════════════════════════════════════════════════════════
--
-- The procedural layer is intentionally blocky-but-functional so
-- gameplay works during alpha. Once an artist hands off an aura asset:
--
-- 1. Drop the Model under ReplicatedStorage.AssetsShared.VFX.Auras
--    with the SAME name as the aura's `Procedural.TemplateName` (or
--    the legacy `VFX.Particle` field — both point at the same lookup).
-- 2. The model can be any tree of attachments / particles / beams;
--    AurasClient deep-clones every ParticleEmitter + Beam descendant
--    onto the anchor's runtime attachment.
-- 3. The Procedural fallback STAYS in the config — when a future
--    aura ships without art, the procedural definition keeps it
--    looking right immediately.
--
-- See `AurasClient.luau` for the runtime spawn/despawn pipeline.

export type AuraAnchor = 'character' | 'sword' | 'mount'

-- Procedural particle params. Authors set the fields they want; the
-- client merges with sensible defaults. None of these are required —
-- omit Particle to skip the procedural emitter entirely.
export type AuraProceduralParticle = {
	Color: ColorSequence?,
	Size: NumberSequence?,
	Transparency: NumberSequence?,
	Rate: number?,                  -- emit/sec
	Lifetime: NumberRange?,
	Speed: NumberRange?,
	SpreadAngle: Vector2?,
	Acceleration: Vector3?,
	Drag: number?,
	LightEmission: number?,
	-- Texture override; defaults to a built-in sparkles texture.
	Texture: string?,
}

-- Procedural beam params (lattice between two attachments). Useful
-- for trail-style auras on swords / mount wings. Authors set the
-- offsets; the client builds the second attachment and drives both
-- ends from the anchor.
export type AuraProceduralBeam = {
	Color: ColorSequence?,
	Width0: number?,                -- studs at start
	Width1: number?,                -- studs at end
	Transparency: NumberSequence?,
	-- Distance between the two attachments along the anchor's local
	-- direction. Positive Y for sword tip, negative Y for trailing
	-- behind a mount, etc.
	EndOffset: Vector3?,
	Texture: string?,
	TextureLength: number?,
	TextureSpeed: number?,
	-- FaceCamera = true makes the beam billboard the camera; useful
	-- for thin trail-effects.
	FaceCamera: boolean?,
}

export type AuraProceduralLight = {
	Color: Color3?,
	Brightness: number?,
	Range: number?,
}

export type AuraProcedural = {
	-- Optional name — when both Procedural and a Template asset under
	-- AssetsShared.VFX.Auras.<TemplateName> exist, the template wins
	-- and procedural is layered behind. When the template is missing,
	-- procedural alone renders.
	TemplateName: string?,
	Particle: AuraProceduralParticle?,
	Beam: AuraProceduralBeam?,
	Light: AuraProceduralLight?,
}

export type AuraVFX = {
	Particle: string?,        -- legacy: AssetsShared.VFX.Auras.<name>
	Light: { Color: Color3?, Brightness: number?, Range: number? }?,
}

export type AuraSFX = {
	Loop: { Sound: string, Volume: number? }?,    -- continuous hum
	Equip: { Sound: string, Volume: number? }?,   -- played once on equip
}

-- Runtime hooks: optional dynamic-aura API. When the aura spawns,
-- AurasClient calls Setup(ctx) where ctx exposes the resolved anchor
-- parts + their attachments + the Roblox player. Setup returns a
-- per-render state table; if a Step function is also provided, it's
-- called every Heartbeat with (state, dt) so the aura can drive
-- attachment positions, color cycles, beam offsets, etc. dynamically.
-- Cleanup runs on despawn so listeners/connections are torn down.
export type AuraRuntimeContext = {
	Player: Player,
	-- All resolved anchor parts. 'character' returns every body part of
	-- the rig, 'sword' returns every equipped weapon Tool's handle,
	-- 'mount' returns the active mount's primary part. Lists may be
	-- empty when no anchor exists yet (e.g. mount aura when not riding).
	AnchorParts: { BasePart },
	-- One Attachment per AnchorPart, in matching order — created by the
	-- AurasClient before Setup runs. Particle/Beam/Light children are
	-- already parented onto these by the default render pipeline; the
	-- Setup hook can append more or repurpose them.
	Attachments: { Attachment },
}

export type AuraRuntime = {
	Setup: ((ctx: AuraRuntimeContext) -> any)?,
	Step:  ((state: any, dt: number) -> ())?,
	Cleanup: ((state: any) -> ())?,
}

export type AuraConfig = {
	Display: {
		Name: string,
		Description: string,
		Icon: string?,
	},
	Anchor: AuraAnchor,                 -- which body part / equipped weapon / mount it lives on
	VFX: AuraVFX,
	SFX: AuraSFX,
	Procedural: AuraProcedural?,        -- in-code fallback; works without art
	Runtime: AuraRuntime?,              -- optional dynamic Setup/Step hooks
	Rarity: number,                     -- aligns with RaritiesConfig enums
}

local Module = {}

local function aura(props: any): AuraConfig
	local base = {
		Anchor = 'character',
		Rarity = 1,
		VFX = { Particle = nil, Light = { Color = Color3.fromRGB(255, 220, 120), Brightness = 1, Range = 6 } },
		SFX = {},
		Display = { Name = 'Aura', Description = '', Icon = nil },
	} :: any
	for k, v in props do base[k] = v end
	return base :: AuraConfig
end

----------------------------------------------------------------------
-- Registry. Add new auras here.
----------------------------------------------------------------------
Module.Auras = {

	-- // CHARACTER — amber halo, particle-driven //
	character_glow_amber = aura({
		Anchor = 'character',
		Display = { Name = 'Amber Halo', Description = 'A warm amber glow trailing the wearer.' },
		Rarity = 2,
		VFX = {
			Particle = 'AmberHalo',
			Light = { Color = Color3.fromRGB(255, 180, 90), Brightness = 1.4, Range = 8 },
		},
		Procedural = {
			TemplateName = 'AmberHalo',
			Particle = {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0,    Color3.fromRGB(255, 200, 110)),
					ColorSequenceKeypoint.new(0.5,  Color3.fromRGB(255, 230, 170)),
					ColorSequenceKeypoint.new(1,    Color3.fromRGB(180, 110, 40)),
				}),
				Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.5),
					NumberSequenceKeypoint.new(1, 0.05),
				}),
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.1),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Rate = 14,
				Lifetime = NumberRange.new(0.7, 1.0),
				Speed = NumberRange.new(0.5, 1.5),
				SpreadAngle = Vector2.new(180, 180),
				Acceleration = Vector3.new(0, 1.4, 0),
				LightEmission = 0.7,
			},
			Light = { Color = Color3.fromRGB(255, 180, 90), Brightness = 1.4, Range = 8 },
		},
	}),

	-- // CHARACTER — blue runes, denser particle ring //
	character_runic = aura({
		Anchor = 'character',
		Display = { Name = 'Runic Ward', Description = 'Spectral runes orbit the body in a slow ring.' },
		Rarity = 3,
		Procedural = {
			Particle = {
				Color = ColorSequence.new(Color3.fromRGB(120, 200, 255), Color3.fromRGB(220, 240, 255)),
				Size = NumberSequence.new(0.3, 0.6),
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.2),
					NumberSequenceKeypoint.new(0.7, 0.4),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Rate = 22,
				Lifetime = NumberRange.new(1.4, 2.0),
				Speed = NumberRange.new(2, 3),
				SpreadAngle = Vector2.new(15, 360),
				Acceleration = Vector3.new(0, 0, 0),
				Drag = 1,
				LightEmission = 0.6,
			},
			Light = { Color = Color3.fromRGB(120, 200, 255), Brightness = 1.2, Range = 7 },
		},
	}),

	-- // SWORD — voidsteel, beam trail along the blade //
	sword_glow_void = aura({
		Anchor = 'sword',
		Display = { Name = 'Voidsteel Edge', Description = 'A purple-black aura clings to the blade.' },
		Rarity = 4,
		VFX = {
			Particle = 'VoidEdge',
			Light = { Color = Color3.fromRGB(180, 120, 255), Brightness = 1.0, Range = 4 },
		},
		Procedural = {
			TemplateName = 'VoidEdge',
			Beam = {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0,   Color3.fromRGB(60, 0, 90)),
					ColorSequenceKeypoint.new(0.5, Color3.fromRGB(180, 120, 255)),
					ColorSequenceKeypoint.new(1,   Color3.fromRGB(40, 0, 70)),
				}),
				Width0 = 0.4, Width1 = 0.05,
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.1),
					NumberSequenceKeypoint.new(1, 0.7),
				}),
				EndOffset = Vector3.new(0, 4, 0),  -- Up the blade Y axis
				TextureLength = 1.5, TextureSpeed = 1.5,
				FaceCamera = true,
			},
			Particle = {
				Color = ColorSequence.new(Color3.fromRGB(200, 150, 255), Color3.fromRGB(80, 30, 130)),
				Size = NumberSequence.new(0.2, 0.05),
				Rate = 30,
				Lifetime = NumberRange.new(0.5, 0.8),
				Speed = NumberRange.new(0.3, 0.7),
				SpreadAngle = Vector2.new(20, 180),
			},
			Light = { Color = Color3.fromRGB(180, 120, 255), Brightness = 1.0, Range = 4 },
		},
	}),

	-- // SWORD — flame trail, beam-driven //
	sword_flame = aura({
		Anchor = 'sword',
		Display = { Name = 'Flame Edge', Description = 'A fire-blade trail.' },
		Rarity = 3,
		Procedural = {
			Beam = {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0,   Color3.fromRGB(255, 220, 120)),
					ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 130, 40)),
					ColorSequenceKeypoint.new(1,   Color3.fromRGB(160, 30, 20)),
				}),
				Width0 = 0.6, Width1 = 0.08,
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.15),
					NumberSequenceKeypoint.new(1, 0.85),
