		Tags = { Module.ItemTags.Candy },
		Rarity = RaritiesConfig.RarityEnums.Rare,
		MaxQuantity = 99,
		CandyData = { XPAmount = 250 },
		ActivationData = { Effects = {}, Inflicts = {}, Consumes = true, ConsumeQuantity = 1, MinimumQuantity = 1, Cooldown = 0.5 },
