return {
	Name = 'Craft',
	Aliases = { 'craft', 'crafttest' },
	Description = 'Run a recipe through CraftingServer (bypasses workstation gate by passing the recipe-required workstation as the hint).',
	Group = 'Admin',
	Args = {
		{ Type = 'player',  Name = 'target',   Description = 'Target player.' },
		{ Type = 'string',  Name = 'recipeId', Description = "Recipe id from Data/Crafting.luau." },
