Module.MaxSaveSlots = 3

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Skills.luau"><![CDATA[-- Skill configs. Three starter sword skills hooked to the skill tree.
-- Mirrors the Combat data/server/client structure: this file is pure
-- config, SkillsShared owns predicates + the action enum, SkillsServer
-- owns auth + damage application, SkillsClient owns input + VFX.
--
-- Each skill carries:
--   * metadata (display, school, prereqs)
--   * timing (windup → active → recovery)
--   * hitbox (size + forward offset, applied during the active window)
--   * damage (base + scale-with-weapon multiplier; values are pre-mult)
--   * animation + VFX + SFX (rbxassetid stubs; art layer drops in later)
--   * cooldown
-- Skills are ground-only by design — no skill applies upward velocity or
-- expects an airborne target (matches the Nier-style ground-combat goal).

export type Hitbox = {
	Size: Vector3,
	ForwardOffset: number,
	Hits: number,                  -- how many distinct hit pulses fire
	HitInterval: number,           -- seconds between pulses
	-- True (default) → each pulse can damage the same humanoid again
	-- (the existing N-hit slash design). False → the cast keeps a
	-- per-cast HitCache so each humanoid is damaged at most once
	-- across all pulses; useful for cleave-style skills where the
	-- pulses exist to widen the active window, not to multi-hit.
	-- Defaulted in the skill() factory so existing skills keep their
	-- current behavior without touching every config entry.
	MultiHit: boolean?,
}

export type SkillAnimations = {
	Cast: string?,                 -- main animation while skill is active
	Loop: string?,                 -- optional loop during long active windows
}

export type SkillVFX = {
	Slash: string?,                -- AssetsShared.VFX.Skills.<name>
	Impact: string?,
	Trail: string?,
}

export type SkillSFX = {
	Cast: { Sound: string, Volume: number? }?,
	Hit: { Sound: string, Volume: number? }?,
}

-- Passive skill effect — per-level bonus on a named stat. Stat + Kind
-- are enum NUMBERS (Module.StatNameEnum / Module.StatEffectKindEnum,
-- defined below) — every consumer reads the same enum table so a typo
-- in a stat name fails at lookup-time instead of silently producing a
-- 0 bonus. A single passive can carry MULTIPLE effects (e.g. "+2%
-- attack AND +10 max HP per level") by listing them as an array of
-- PassiveEffect on the cfg's `PerLevelEffects` field.
--
-- Kind dispatch:
--   StatEffectKindEnum.Percent  → multiplicative; Bonus is per-level
--                                 multiplier (0.02 = +2%).
--   StatEffectKindEnum.Value    → flat additive; Bonus is per-level
--                                 raw magnitude.
--   StatEffectKindEnum.Compute  → custom evaluator. Effect must supply
--                                 a `Compute(level)` function returning
--                                 (percent, value). Use sparingly — for
--                                 conditional / non-linear bonuses.
export type PassiveEffect = {
	Stat: number,                  -- StatNameEnum value
	Kind: number,                  -- StatEffectKindEnum value
	Bonus: number?,                -- per-level magnitude (Percent / Value)
	Compute: ((level: number) -> (number, number))?,  -- (percent, value); Compute kind only
}

-- // Skill-tree graph //
-- Tree-layout fields live ON each SkillConfig (Depends / TabCategory /
-- HexagonColor below). The radial hex SkillsTab UI groups skills by
-- TabCategory into one tree per tab; SkillTreeLayout.resolve consumes
-- the synthesized {Nodes = {[id] = {depends = …}}} structure that
-- Module.Trees builds at the bottom of this file. Keeping tree metadata
-- on the skill itself (instead of in a parallel Trees table) means a
-- new skill is fully self-describing — set TabCategory and the rail tab
-- picks it up; set Depends and the tree's edges resolve automatically.
--
-- Depends vs Prereqs:
--   * Prereqs is the UNLOCK CHAIN — what the server checks before
--     allowing AttemptUnlockSkill to grant the skill. Read by
--     SkillsServer / SkillsShared.
--   * Depends is the DISPLAY GRAPH for the radial tree — defaults to
--     Prereqs (auto-filled in the skill() factory), but can be overridden
--     when the visual graph should diverge (e.g. extra grouping edges).
export type SkillConfig = {
	Id: string,
	Display: { Name: string, Description: string, Icon: string? },
	-- School + tree links so the SkillsTab can group skills under their
	-- discipline and gate by prereqs.
	School: string,                -- 'Sword' | 'Martial' | etc.
	Prereqs: { string },           -- skill ids that must be unlocked first
	-- // Skill-tree layout fields (consumed by SkillsTab + SkillTreeLayout) //
	-- Defaults to a copy of Prereqs (filled by the skill() factory). Override
	-- when the visual tree should diverge from the unlock chain.
	Depends: { string },
	-- Which rail tab this skill renders under in the SkillsTab UI. Matches
	-- a SKILL_SCHOOLS.id ('dual', 'one', 'katana', 'martial', 'search',
	-- 'hide'). Skills without a TabCategory don't render in any tree
	-- (still functionally usable, just hidden from the tree UI).
	TabCategory: string?,
	-- Optional override for the hex tile's stroke + icon accent. When nil
	-- the tile uses the palette accent color.
	HexagonColor: Color3?,
	-- SkillPoint cost charged by SkillsServer.AttemptUnlockSkill on first
	-- unlock AND on each passive level-up. Defaults to 1 (set in the
	-- skill() factory). Bump for high-impact / passive nodes whose flat
	-- per-level bonus accumulates value beyond a single active skill.
	UnlockCost: number?,
	RequiredLevel: number,
	-- Attribute investment gate: attribute-id → minimum Level. Checked by
	-- SkillsServer.AttemptUnlockSkill on first unlock (alongside Prereqs +
	-- RequiredLevel) and surfaced in the Skill Tree detail panel. Used to
	-- gate finishers / ULTs behind attribute investment rather than raw
	-- character level. nil = no attribute gate.
	RequiredAttributes: { [string]: number }?,
	-- Timing windows. WindupTime → ActiveTime → RecoveryTime; total skill
	-- duration is the sum. UsingSkill state is set for the whole window.
	WindupTime: number,
	ActiveTime: number,
	RecoveryTime: number,
	Cooldown: number,
	Hitbox: Hitbox,
	Damage: { Base: number, WeaponScale: number },
	Animations: SkillAnimations,
	VFX: SkillVFX,
	SFX: SkillSFX,
	-- If true, the player is locked to the ground for the whole window.
	-- Default true. Skills authored as airborne would set this false.
	GroundLock: boolean,
	-- // Passive skill fields //
	-- Passive skills are not "cast" — they apply permanent bonuses while
	-- unlocked. Each level above 1 is a separate SkillPoint purchase
	-- (handled by SkillsServer.AttemptUnlockSkill which doubles as a
	-- level-up path for passives). Active skills omit all three fields.
	Passive: boolean?,                -- true → not castable; bonus-only
	MaxLevel: number?,                -- cap for passive level-up purchases
	-- Array so a single passive can grant multiple bonuses per level
	-- (e.g. +2% attack AND +5 flat damage). Each entry's Kind chooses
	-- percent vs value math; Stat is the consumer-side lookup key.
	PerLevelEffects: { PassiveEffect }?,
}

local Module = {}

----------------------------------------------------------------------
-- Stat-name enum. Every passive effect's `Stat` is one of these
-- numeric ids; consumers compare against `SkillsConfig.StatNameEnum.X`
-- rather than string-typing the stat name. Adding a stat means:
--   1. Pick an unused number in this table.
--   2. Wire the consumer (DamageModule for combat stats, AttributeServer
--      for attribute layers, etc.) to read passive bonuses for that id.
--   3. Reference it from new PassiveEffect entries.
-- Numbering grouped by domain so adding a new attribute / resist
-- doesn't shift existing ids.
----------------------------------------------------------------------
Module.StatNameEnum = {
	-- // Combat-pipeline stats (DamageModule reads these).
	Attack  = 1,
	Defense = 2,
	Health  = 3,
	-- // Attributes — mirror Data/Attributes.luau ids.
	Strength  = 10,
	Agility   = 11,
	Vitality  = 12,
	Endurance = 13,
	Toughness = 14,
	Focus     = 15,
	Resolve   = 16,
	Luck      = 17,
	Insight   = 18,
	Charisma  = 19,
	-- // Elemental resists (placeholder; CHARACTER_RESISTS in CharacterTab).
	FireResist   = 30,
	FrostResist  = 31,
	ShockResist  = 32,
	PoisonResist = 33,
	ArcaneResist = 34,
}

----------------------------------------------------------------------
-- Effect-kind enum. Drives the math in SkillsShared.GetPassiveBonus.
-- Compute is an escape hatch for non-linear bonuses (e.g. "scale with
-- HP percent") — the effect carries a Compute function that returns
-- (percent, value) given the current passive level.
----------------------------------------------------------------------
Module.StatEffectKindEnum = {
	Percent = 1,
	Value   = 2,
	Compute = 3,
}

local function skill(props: any): SkillConfig
	local base = {
		School = 'Sword',
		Prereqs = {},
		-- TabCategory defaults to 'dual' since every starter skill is a
		-- sword art shown under the Active rail. Override per-skill when
		-- authoring martial / hiding / etc. trees.
		TabCategory = 'dual',
		HexagonColor = nil,
		UnlockCost = 1,
		RequiredLevel = 1,
		WindupTime = 0.15,
		ActiveTime = 0.45,
		RecoveryTime = 0.25,
		Cooldown = 4.0,
		Hitbox = { Size = Vector3.new(6, 5, 6), ForwardOffset = 4, Hits = 1, HitInterval = 0, MultiHit = true },
		Damage = { Base = 18, WeaponScale = 1.2 },
		Animations = { Cast = 'rbxassetid://0' },
		VFX = {},
		SFX = { Cast = { Sound = 'rbxassetid://0', Volume = 0.5 } },
		GroundLock = true,
		Display = { Name = 'Skill', Description = '', Icon = nil },
	} :: any
	for k, v in props do base[k] = v end
	-- Depends defaults to a copy of Prereqs so authors only have to set
	-- one list. Pass an explicit Depends to decouple the visual graph
	-- from the unlock chain.
	if base.Depends == nil then
		base.Depends = table.clone(base.Prereqs or {})
	end
	return base :: SkillConfig
end

----------------------------------------------------------------------
-- Starter skills. Tier-progression via prereqs:
--   great_slash  → double_cross_slash → quad_cross_slash
----------------------------------------------------------------------
Module.Skills = {

	great_slash = skill({
		Id = 'great_slash',
		Display = {
			Name = 'Great Slash',
			Description = 'A heavy single arc that cleaves the air in front of you.',
		},
		School = 'Sword',
		TabCategory = 'dual',
		HexagonColor = Color3.fromRGB(126, 200, 255),    -- ice-blue accent (default)
		Prereqs = {},
		RequiredLevel = 1,
		WindupTime = 0.20,
		ActiveTime = 0.35,
		RecoveryTime = 0.30,
		Cooldown = 4.0,
		Hitbox = { Size = Vector3.new(7, 5, 7), ForwardOffset = 4.5, Hits = 1, HitInterval = 0 },
		Damage = { Base = 28, WeaponScale = 1.3 },
	}),

	double_cross_slash = skill({
		Id = 'double_cross_slash',
		Display = {
			Name = 'Double Cross Slash',
			Description = 'Two diagonal cuts that form a cross. Hits twice.',
		},
		School = 'Sword',
		TabCategory = 'dual',
		HexagonColor = Color3.fromRGB(180, 220, 255),    -- brighter blue (mid-tier)
		Prereqs = { 'great_slash' },
		RequiredLevel = 1,
		WindupTime = 0.12,
		ActiveTime = 0.50,
		RecoveryTime = 0.30,
		Cooldown = 6.0,
		-- Two pulses, ~0.18s apart so the two slashes feel distinct.
		Hitbox = { Size = Vector3.new(6, 5, 6), ForwardOffset = 4, Hits = 2, HitInterval = 0.18 },
		Damage = { Base = 18, WeaponScale = 1.1 },
	}),

	quad_cross_slash = skill({
		Id = 'quad_cross_slash',
		Display = {
			Name = 'Quad Cross Slash',
			Description = 'A flurry of four cross-cuts. High commitment, high reward.',
		},
		School = 'Sword',
		TabCategory = 'dual',
		HexagonColor = Color3.fromRGB(245, 200, 80),     -- gold — ULT/finisher tile
		Prereqs = { 'double_cross_slash' },
		RequiredLevel = 1,
		-- ULT finisher — gated behind Strength investment, not char level.
		RequiredAttributes = { Strength = 3 },
		WindupTime = 0.10,
		ActiveTime = 0.85,
		RecoveryTime = 0.45,
		Cooldown = 12.0,
		-- Four pulses, ~0.18s apart. Total skill duration ~1.4s — long
		-- recovery means you're committed; can be cancelled by dodge.
		Hitbox = { Size = Vector3.new(6, 5, 6), ForwardOffset = 4, Hits = 4, HitInterval = 0.18 },
		Damage = { Base = 14, WeaponScale = 1.0 },
	}),

	-- // Passive skills //
	-- Defender / Attacker — flat percentage bonuses on Defense / Attack.
	-- 5 levels each, 2% per level. Each level above 1 is a separate
	-- SkillPoint purchase (handled by SkillsServer.AttemptUnlockSkill
	-- which routes to a level-up branch when the skill is already owned
	-- and Passive=true). Hitbox/Damage/timing fields are ignored at
	-- runtime but kept on the cfg so SkillConfig stays a single shape.
	passive_defender = skill({
		Id = 'passive_defender',
		Display = {
			Name = 'Defender',
			Description = 'Reduce incoming damage by 2% per level (max 5).',
		},
		School = 'Sword',
		TabCategory = 'passives',
		HexagonColor = Color3.fromRGB(150, 220, 170),    -- green — defensive passive
		-- Passives charge 2 SP per purchase (initial unlock + each level-up)
		-- since each rank is a permanent stat bonus. Maxing this passive
		-- costs 2 × 5 = 10 SP total, weighed against ~3-4 active skills.
		UnlockCost = 2,
		Prereqs = {},
		RequiredLevel = 1,
		Cooldown = 0,
		Passive = true,
		MaxLevel = 5,
		PerLevelEffects = {
			{ Stat = Module.StatNameEnum.Defense, Kind = Module.StatEffectKindEnum.Percent, Bonus = 0.02 },
		},
	}),

	passive_attacker = skill({
		Id = 'passive_attacker',
		Display = {
			Name = 'Attacker',
			Description = 'Increase outgoing damage by 2% per level (max 5).',
		},
		TabCategory = 'passives',
		HexagonColor = Color3.fromRGB(240, 130, 130),    -- red — offensive passive
		-- 3 SP per purchase: outgoing damage compounds with weapon stats,
		-- so each rank is worth marginally more than the defensive passive.
		-- Maxing costs 3 × 5 = 15 SP — a meaningful long-term investment.
		UnlockCost = 3,
		School = 'Sword',
		Prereqs = {},
		RequiredLevel = 1,
		Cooldown = 0,
		Passive = true,
		MaxLevel = 5,
		PerLevelEffects = {
			{ Stat = Module.StatNameEnum.Attack, Kind = Module.StatEffectKindEnum.Percent, Bonus = 0.02 },
		},
	}),

	----------------------------------------------------------------------
	-- // Flash branch — stab-based, precision/speed style //
	-- quick_slash → flash_slash → flash_strike → lightning_strike (ULT)
	-- Hitbox is intentionally THIN and LONG (Vector3 X≈3, Z≈8-10) so
	-- thrusts only catch enemies directly in front of the player —
	-- contrast with the wide arcs of the heavy branch. HitInterval
	-- shrinks as the chain progresses so the high-tier finishers FEEL
	-- faster despite landing more pulses.
	----------------------------------------------------------------------
	quick_slash = skill({
		Id = 'quick_slash',
		Display = {
			Name = 'Quick Slash',
			Description = 'A single fast stab. Low damage but lightning recovery.',
		},
		School = 'Sword',
		TabCategory = 'dual',
		HexagonColor = Color3.fromRGB(140, 230, 240),    -- cyan (flash style)
		Prereqs = {},
		RequiredLevel = 1,
		WindupTime = 0.08,
		ActiveTime = 0.20,
		RecoveryTime = 0.18,
		Cooldown = 2.5,
		Hitbox = { Size = Vector3.new(3, 5, 8), ForwardOffset = 5, Hits = 1, HitInterval = 0 },
		Damage = { Base = 10, WeaponScale = 0.9 },
	}),

	flash_slash = skill({
		Id = 'flash_slash',
		Display = {
			Name = 'Flash Slash',
			Description = 'A harder, deeper thrust. Significantly more damage than Quick Slash.',
		},
		School = 'Sword',
		TabCategory = 'dual',
		HexagonColor = Color3.fromRGB(100, 220, 240),    -- brighter cyan
		Prereqs = { 'quick_slash' },
		RequiredLevel = 1,
		WindupTime = 0.10,
		ActiveTime = 0.25,
		RecoveryTime = 0.22,
		Cooldown = 4.0,
		Hitbox = { Size = Vector3.new(3, 5, 9), ForwardOffset = 5, Hits = 1, HitInterval = 0 },
		Damage = { Base = 22, WeaponScale = 1.15 },
	}),

	flash_strike = skill({
		Id = 'flash_strike',
		Display = {
			Name = 'Flash Strike',
			Description = 'Two consecutive thrusts in a flash. Moderate per-hit damage.',
		},
		School = 'Sword',
		TabCategory = 'dual',
		HexagonColor = Color3.fromRGB(180, 240, 255),    -- pale cyan
		Prereqs = { 'flash_slash' },
		RequiredLevel = 1,
		WindupTime = 0.10,
		ActiveTime = 0.40,
		RecoveryTime = 0.28,
		Cooldown = 6.0,
		Hitbox = { Size = Vector3.new(3, 5, 9), ForwardOffset = 5, Hits = 2, HitInterval = 0.18 },
		Damage = { Base = 16, WeaponScale = 1.0 },
	}),

	lightning_strike = skill({
		Id = 'lightning_strike',
		Display = {
			Name = 'Lightning Strike',
			Description = 'Three blistering thrusts in rapid succession. The flash-branch finisher.',
		},
		School = 'Sword',
		TabCategory = 'dual',
		HexagonColor = Color3.fromRGB(245, 200, 80),     -- gold — ULT/finisher tile
		Prereqs = { 'flash_strike' },
		RequiredLevel = 1,
		-- ULT finisher — gated behind Agility investment.
		RequiredAttributes = { Agility = 3 },
		WindupTime = 0.08,
		ActiveTime = 0.55,
		RecoveryTime = 0.40,
		Cooldown = 12.0,
		Hitbox = { Size = Vector3.new(3, 5, 10), ForwardOffset = 5.5, Hits = 3, HitInterval = 0.14 },
		Damage = { Base = 20, WeaponScale = 1.2 },
	}),

	----------------------------------------------------------------------
	-- // Heavy branch — large-swing / cleave style //
	-- heavy_chop → wide_cleave → whirlwind_slash → earthshatter (ULT)
	-- Hitboxes are WIDE (Vector3 X≈9-14, Z≈5-14) and damage-per-pulse
	-- is high. wide_cleave + earthshatter set MultiHit = false so a
	-- single enemy eats one big hit per cast (the wide hitbox is for
	-- group coverage, not stacked single-target damage).
	----------------------------------------------------------------------
	heavy_chop = skill({
		Id = 'heavy_chop',
		Display = {
			Name = 'Heavy Chop',
			Description = 'A vertical overhead chop. Slow windup, punishing damage.',
		},
		School = 'Sword',
		TabCategory = 'dual',
		HexagonColor = Color3.fromRGB(255, 175, 90),     -- amber/orange (heavy style)
		Prereqs = {},
		RequiredLevel = 1,
		WindupTime = 0.30,
		ActiveTime = 0.30,
		RecoveryTime = 0.40,
		Cooldown = 5.0,
		Hitbox = { Size = Vector3.new(5, 5, 6), ForwardOffset = 4, Hits = 1, HitInterval = 0 },
		Damage = { Base = 32, WeaponScale = 1.4 },
	}),

	wide_cleave = skill({
		Id = 'wide_cleave',
		Display = {
			Name = 'Wide Cleave',
			Description = 'A sweeping horizontal cut. Hits everything in a broad frontal arc.',
		},
		School = 'Sword',
		TabCategory = 'dual',
		HexagonColor = Color3.fromRGB(255, 155, 70),
		Prereqs = { 'heavy_chop' },
		RequiredLevel = 1,
		WindupTime = 0.25,
		ActiveTime = 0.40,
		RecoveryTime = 0.45,
		Cooldown = 7.0,
		-- One pulse, MultiHit = false so each humanoid eats it exactly once
		-- across the wide hitbox — the width is for group coverage, not
		-- multi-tap damage.
		Hitbox = { Size = Vector3.new(11, 5, 5), ForwardOffset = 4, Hits = 1, HitInterval = 0, MultiHit = false },
		Damage = { Base = 26, WeaponScale = 1.25 },
	}),

	whirlwind_slash = skill({
		Id = 'whirlwind_slash',
		Display = {
			Name = 'Whirlwind Slash',
			Description = 'Spin in place, hitting enemies all around you in a 360° sweep.',
		},
		School = 'Sword',
		TabCategory = 'dual',
		HexagonColor = Color3.fromRGB(255, 130, 60),
		Prereqs = { 'wide_cleave' },
		RequiredLevel = 1,
		RequiredAttributes = { Strength = 2 },
		WindupTime = 0.20,
		ActiveTime = 0.70,
		RecoveryTime = 0.45,
		Cooldown = 10.0,
		-- Player-centered hitbox (ForwardOffset = 0) approximates the
		-- 360° spin — three pulses spaced 0.20s apart simulate the
		-- rotational sweep catching enemies as they enter the radius.
		Hitbox = { Size = Vector3.new(10, 5, 10), ForwardOffset = 0, Hits = 3, HitInterval = 0.20 },
		Damage = { Base = 18, WeaponScale = 1.05 },
	}),

	earthshatter = skill({
		Id = 'earthshatter',
		Display = {
			Name = 'Earthshatter',
			Description = 'Slam the ground; a shockwave erupts in a wide ring. The heavy-branch finisher.',
		},
		School = 'Sword',
		TabCategory = 'dual',
		HexagonColor = Color3.fromRGB(245, 200, 80),     -- gold — ULT/finisher tile
		Prereqs = { 'whirlwind_slash' },
		RequiredLevel = 1,
		-- ULT finisher — gated behind Strength + Vitality investment.
		RequiredAttributes = { Strength = 3, Vitality = 2 },
		WindupTime = 0.45,
		ActiveTime = 0.60,
		RecoveryTime = 0.55,
		Cooldown = 18.0,
		-- Massive AOE; MultiHit = false so each enemy in the ring takes
		-- one heavy hit (rather than getting clipped repeatedly by the
		-- single long active window).
		Hitbox = { Size = Vector3.new(14, 5, 14), ForwardOffset = 2, Hits = 1, HitInterval = 0, MultiHit = false },
		Damage = { Base = 55, WeaponScale = 1.5 },
	}),

} :: { [string]: SkillConfig }

----------------------------------------------------------------------
-- Skill-tree graphs, keyed by TabCategory (i.e. SKILL_SCHOOLS rail id
-- in SkillsTab). Auto-built from each skill's TabCategory + Depends so
-- there's no parallel hand-maintained tree table. Skills with no
-- TabCategory are skipped (functional but hidden from the tree UI).
-- Read by SkillTreeLayout.resolve in SkillsTab to compute hex-grid
-- positions. To inject grouping-only edges without changing unlock
-- logic, set Depends = {…extra…} on the skill cfg directly.
--
-- The `depends` field on the synthesized TreeNode is a snapshot of the
-- skill's Depends list — Module.Trees is rebuilt only at module load,
-- so live edits to Skills.X.Depends won't propagate without a re-require.
----------------------------------------------------------------------
Module.Trees = {} :: { [string]: { Nodes: { [string]: { depends: { string } } } } }
do
	for id, cfg in Module.Skills do
		local cat = cfg.TabCategory
		if cat == nil then continue end
		local tree = Module.Trees[cat]
		if not tree then
			tree = { Nodes = {} }
			Module.Trees[cat] = tree
		end
		tree.Nodes[id] = { depends = table.clone(cfg.Depends or cfg.Prereqs or {}) }
	end
end

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/StatisticsConfig.luau"><![CDATA[-- StatisticsConfig — single source of truth for the per-player game-
-- statistics catalog. Numeric ids are stable across versions; the
-- Info table maps each id to display metadata + storage kind.
--
-- Save shape: data.Statistics is a sparse map keyed by the STRINGIFIED
-- id (so JSON serialization is deterministic). Each value is one of:
--   * number  — Counter / Record / Timestamp.
--   * { [string] = number } — Map (per-key counter; e.g. per-boss kills,
--     per-item crafted, per-zone visit count).
-- Stats with no observations stay absent — the StatisticsServer's
-- read path treats missing as 0 / empty map.

local Module = {}

----------------------------------------------------------------------
-- Storage kinds. Drives the Increment / IncrementMap / SetMax / Set
-- branches in StatisticsServer.
----------------------------------------------------------------------
Module.Kinds = {
	-- A monotonically-increasing counter. Increment by `amount`.
	Counter   = 'counter',
	-- A record-style counter that only ever moves UP. SetMax(value)
	-- replaces the stored value if `value` is greater. Used for
	-- highest-single-hit, longest-life, kill-streak record, etc.
	Record    = 'record',
	-- A nested per-key counter. IncrementMap(key, amount) bumps
	-- map[key]. Used for per-boss / per-item / per-zone tallies.
	Map       = 'map',
	-- A single timestamp (epoch seconds). Set(value) overwrites.
	-- Combined with Set-if-empty for first-join semantics.
	Timestamp = 'timestamp',
}

----------------------------------------------------------------------
-- Statistic ids. NEVER renumber existing entries — new stats get the
-- next free id; deleted stats leave their id reserved (commented).
-- Server / save struct read by id, not name; renumbering would silently
-- corrupt every existing player's history.
----------------------------------------------------------------------
Module.StatisticIds = {
	-- // Damage dealt //
	DamageDealtTotal  = 0,
	DamageDealtPvE    = 1,
	DamageDealtPvP    = 2,
	DamageDealtMelee  = 3,
	DamageDealtRanged = 4,
	DamageDealtMagic  = 5,

	-- // Damage taken / mitigated //
	DamageTaken    = 6,
	DamageBlocked  = 7,
	DamageParried  = 8,
	DamageDodged   = 9,
	-- Records.
	HighestSingleHit = 10,
	HighestCrit      = 11,

	-- // Deaths / kill streak //
	DeathsTotal       = 12,
	DeathsPvE         = 13,
	DeathsPvP         = 14,
	LongestLifeSeconds = 15,  -- Record
	KillStreakRecord   = 16,  -- Record
	CurrentKillStreak  = 17,  -- Counter (live; resets on death)

	-- // Bosses (Map: bossId → defeats) //
	BossesDefeated = 18,

	-- // Items (Maps: itemId → count) //
	ItemsCrafted   = 19,
	ItemsConsumed  = 20,
	ItemsBought    = 21,
	ItemsSold      = 22,
	ItemsDropped   = 23,

	-- // Currency //
	GoldEarned = 24,
	GoldSpent  = 25,

	-- // Forge / enchant / upgrade events //
	EnchantmentsApplied = 26,
	UpgradesApplied     = 27,

	-- // XP //
	LevelExperienceTotal = 28,
	-- Map: attributeId → total XP earned.
	AttributeExperience  = 29,

	-- // Quests //
	QuestsCompleted = 30,
	QuestsAbandoned = 31,

	-- // Movement //
	DistanceTraveledFoot  = 32,  -- studs walked / run on foot
	DistanceTraveledMount = 33,  -- studs while mounted
	JumpsTotal            = 34,
	DashesTotal           = 35,
	RollsTotal            = 36,

	-- // Zones (Maps: zoneId → count / seconds) //
	ZonesVisitedCount = 37,
	ZoneTimeSeconds   = 38,

	-- // Gathering (Maps: type → count) //
	ChestsOpened     = 39,
	ResourcesGathered = 40,

	-- // Sessions / time //
	PlayTimeTotal     = 41,  -- accumulated seconds across all sessions
	LongestSession    = 42,  -- Record
	SessionsPlayed    = 43,
	FirstJoinDate     = 44,  -- Timestamp (epoch)
	LastJoinDate      = 45,  -- Timestamp (epoch)

	-- // Social //
	TradesCompleted   = 46,
	PartiesJoined     = 47,
	ChatMessagesSent  = 48,
}

----------------------------------------------------------------------
-- Display metadata + storage kind, keyed by id. Add new entries when
-- you add new ids above. Missing entries are tolerated by the server
-- (defaults to Counter) but the stats menu won't surface them with a
-- nice label.
----------------------------------------------------------------------
local function info(label: string, kind: string, group: string)
	return { Label = label, Kind = kind, Group = group }
end

local IDS = Module.StatisticIds
local K = Module.Kinds

Module.Info = {
	[IDS.DamageDealtTotal]  = info('Damage Dealt (Total)',  K.Counter, 'Combat'),
	[IDS.DamageDealtPvE]    = info('Damage Dealt vs Enemies', K.Counter, 'Combat'),
	[IDS.DamageDealtPvP]    = info('Damage Dealt vs Players', K.Counter, 'Combat'),
	[IDS.DamageDealtMelee]  = info('Damage Dealt — Melee',  K.Counter, 'Combat'),
	[IDS.DamageDealtRanged] = info('Damage Dealt — Ranged', K.Counter, 'Combat'),
	[IDS.DamageDealtMagic]  = info('Damage Dealt — Magic',  K.Counter, 'Combat'),

	[IDS.DamageTaken]    = info('Damage Taken',    K.Counter, 'Combat'),
	[IDS.DamageBlocked]  = info('Damage Blocked',  K.Counter, 'Combat'),
	[IDS.DamageParried]  = info('Damage Parried',  K.Counter, 'Combat'),
	[IDS.DamageDodged]   = info('Damage Dodged',   K.Counter, 'Combat'),
	[IDS.HighestSingleHit] = info('Highest Single Hit', K.Record, 'Combat'),
	[IDS.HighestCrit]      = info('Highest Crit',       K.Record, 'Combat'),

	[IDS.DeathsTotal]        = info('Deaths',                K.Counter, 'Combat'),
	[IDS.DeathsPvE]          = info('Deaths vs Enemies',     K.Counter, 'Combat'),
	[IDS.DeathsPvP]          = info('Deaths vs Players',     K.Counter, 'Combat'),
	[IDS.LongestLifeSeconds] = info('Longest Life (Seconds)',K.Record,  'Combat'),
	[IDS.KillStreakRecord]   = info('Best Kill Streak',      K.Record,  'Combat'),
	[IDS.CurrentKillStreak]  = info('Current Kill Streak',   K.Counter, 'Combat'),

	[IDS.BossesDefeated] = info('Bosses Defeated', K.Map, 'Combat'),

	[IDS.ItemsCrafted]  = info('Items Crafted',  K.Map, 'Items'),
	[IDS.ItemsConsumed] = info('Items Consumed', K.Map, 'Items'),
	[IDS.ItemsBought]   = info('Items Bought',   K.Map, 'Items'),
	[IDS.ItemsSold]     = info('Items Sold',     K.Map, 'Items'),
	[IDS.ItemsDropped]  = info('Items Dropped',  K.Map, 'Items'),

	[IDS.GoldEarned] = info('Gold Earned', K.Counter, 'Economy'),
	[IDS.GoldSpent]  = info('Gold Spent',  K.Counter, 'Economy'),

	[IDS.EnchantmentsApplied] = info('Enchantments Applied', K.Counter, 'Crafting'),
	[IDS.UpgradesApplied]     = info('Upgrades Applied',     K.Counter, 'Crafting'),

	[IDS.LevelExperienceTotal] = info('Level XP Earned',     K.Counter, 'Progression'),
	[IDS.AttributeExperience]  = info('Attribute XP Earned', K.Map,     'Progression'),

	[IDS.QuestsCompleted] = info('Quests Completed', K.Counter, 'Quests'),
	[IDS.QuestsAbandoned] = info('Quests Abandoned', K.Counter, 'Quests'),

	[IDS.DistanceTraveledFoot]  = info('Distance — On Foot', K.Counter, 'Movement'),
	[IDS.DistanceTraveledMount] = info('Distance — Mounted', K.Counter, 'Movement'),
	[IDS.JumpsTotal]  = info('Jumps',  K.Counter, 'Movement'),
	[IDS.DashesTotal] = info('Dashes', K.Counter, 'Movement'),
	[IDS.RollsTotal]  = info('Rolls',  K.Counter, 'Movement'),

	[IDS.ZonesVisitedCount] = info('Zones Visited',     K.Map, 'World'),
	[IDS.ZoneTimeSeconds]   = info('Zone Time (Seconds)', K.Map, 'World'),

	[IDS.ChestsOpened]      = info('Chests Opened',      K.Map, 'Gathering'),
	[IDS.ResourcesGathered] = info('Resources Gathered', K.Map, 'Gathering'),

	[IDS.PlayTimeTotal]  = info('Total Play Time (Seconds)', K.Counter,   'Sessions'),
	[IDS.LongestSession] = info('Longest Session (Seconds)', K.Record,    'Sessions'),
	[IDS.SessionsPlayed] = info('Sessions Played',           K.Counter,   'Sessions'),
	[IDS.FirstJoinDate]  = info('First Joined',              K.Timestamp, 'Sessions'),
	[IDS.LastJoinDate]   = info('Last Joined',               K.Timestamp, 'Sessions'),

	[IDS.TradesCompleted]  = info('Trades Completed', K.Counter, 'Social'),
	[IDS.PartiesJoined]    = info('Parties Joined',   K.Counter, 'Social'),
	[IDS.ChatMessagesSent] = info('Chat Messages Sent', K.Counter, 'Social'),
}

----------------------------------------------------------------------
-- Helpers.
----------------------------------------------------------------------
function Module.GetKind(statId: number): string
	local i = Module.Info[statId]
	return (i and i.Kind) or Module.Kinds.Counter
end

function Module.GetLabel(statId: number): string
	local i = Module.Info[statId]
	return (i and i.Label) or string.format('Stat #%d', statId)
end

function Module.GetGroup(statId: number): string
	local i = Module.Info[statId]
	return (i and i.Group) or 'Other'
end

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/StatusEffects.luau"><![CDATA[-- StatusEffects registry. Status / DoT / armor-debuff / movement
-- debuff definitions, all in one place. Authors reference effects by
-- id from weapons (`WeaponUsage.Inflicts`), forge modifiers
-- (`Modifier.OnHit`), skills, and consumables.
--
-- Design split:
--   * THIS FILE — pure config (id, display, category, defaults,
--                 stacking semantics).
--   * StatusEffectsRuntime — server module that owns timers,
--                            attribute mutations, DoT ticks. Reads
--                            cfg here at apply time; one handler per
--                            Category.
--
-- Stacking semantics (`Stacking` enum):
--   * 'replace' — newer apply replaces an active stack of the same id
--                 (refreshes Duration, may overwrite Potency).
--   * 'refresh' — newer apply only refreshes Duration; keeps the
--                 highest-Potency stack.
--   * 'stack'   — additive Potency up to MaxStack; new Duration is the
--                 max of incoming + remaining.
-- Defaults to 'refresh'.

export type EffectDisplay = {
	Title: { Text: string, TextColor3: Color3? },
	Description: { Text: string, TextColor3: Color3? },
	Icon: { Image: string, ImageColor3: Color3? }?,
	Viewport: { ImageColor3: Color3?, CFrame: CFrame? }?,
}

-- Reference shape — used by `WeaponUsage.Inflicts[*].Effects`,
-- `Modifier.OnHit`, and skill / consumable cfgs. Carries an optional
-- per-application Duration / Potency override; nil falls back to the
-- registry default for the named effect.
export type Effect = {
	Id: string,
	Duration: number?,
	Potency: number?,
}

export type EffectCategory =
	'dot'           -- Damage-over-time (burn / poison / bleed)
	| 'armor_flat'  -- Reduce armor by N units (crumbling)
	| 'armor_pct'   -- Reduce armor by N% (pierced)
	| 'cc'          -- Crowd control (paralysis / stun)
	| 'movement'    -- Movement debuff (slow)
	| 'damage_amp'  -- Outgoing/incoming damage multiplier
	| 'buff'        -- Generic positive effect
	| 'misc'

export type EffectStacking = 'replace' | 'refresh' | 'stack'

export type BaseEffectConfig = {
	Id: string,
	Display: EffectDisplay,
	Category: EffectCategory,
	-- Default per-apply duration (seconds). Override by passing
	-- Duration on the Effect reference at apply time.
	DefaultDuration: number,
	-- Default potency (interpretation depends on Category):
	--   dot         → damage per tick
	--   armor_flat  → flat armor reduction in points
	--   armor_pct   → fractional armor reduction (0.20 = -20%)
	--   cc          → unused (binary state)
	--   movement    → fractional walk-speed multiplier (0.40 = 60% slow)
	--   damage_amp  → fractional outgoing/incoming multiplier
	DefaultPotency: number,
	-- DoT-only: seconds between ticks. Ignored for non-DoT categories.
	TickInterval: number?,
	Stacking: EffectStacking,
	MaxStack: number,
	-- Color used by status-icon UI tinting.
	Color: Color3,
}

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

local function display(title: string, desc: string, color: Color3): EffectDisplay
	return {
		Title = { Text = title, TextColor3 = color },
		Description = { Text = desc, TextColor3 = color },
		Icon = { Image = 'rbxassetid://-1', ImageColor3 = color },
	}
end

local Module = {}

----------------------------------------------------------------------
-- Registry. Designers append entries here; runtime reads via
-- GetEffectFromId. Keep the table flat — categories are queries on
-- the Category field, not separate sub-tables.
----------------------------------------------------------------------
Module.StatusEffects = {

	-- // Damage-over-time //
	burn = {
		Id = 'burn',
		Display = display('Burn', 'Burning. Takes fire damage every second.', rgb(255, 130, 60)),
		Category = 'dot',
		DefaultDuration = 4.0,
		DefaultPotency = 4,
		TickInterval = 1.0,
		Stacking = 'refresh',
		MaxStack = 3,
		Color = rgb(255, 130, 60),
	},
	poison = {
		Id = 'poison',
		Display = display('Poisoned', 'Poison eats away at your health.', rgb(120, 220, 90)),
		Category = 'dot',
		DefaultDuration = 6.0,
		DefaultPotency = 3,
		TickInterval = 1.0,
		Stacking = 'stack',
		MaxStack = 5,
		Color = rgb(120, 220, 90),
	},
	bleed = {
		Id = 'bleed',
		Display = display('Bleeding', 'Bleeding. Each tick scales with movement.', rgb(220, 60, 80)),
		Category = 'dot',
		DefaultDuration = 5.0,
		DefaultPotency = 5,
		TickInterval = 0.8,
		Stacking = 'stack',
		MaxStack = 5,
		Color = rgb(220, 60, 80),
	},

	-- // Armor debuffs //
	-- Two complementary patterns: flat reduction ("crumbling" — chips
	-- off armor by the unit) vs percent reduction ("pierced" — strike
	-- went through). Both stack but cap at the target's full armor.
	crumbling = {
		Id = 'crumbling',
		Display = display('Crumbling', 'Armor breaking apart. Reduced by a flat amount.', rgb(180, 150, 100)),
		Category = 'armor_flat',
		DefaultDuration = 8.0,
		DefaultPotency = 4,
		Stacking = 'stack',
		MaxStack = 5,
		Color = rgb(180, 150, 100),
	},
	pierced = {
		Id = 'pierced',
		Display = display('Pierced', 'Armor punctured. Reduced by a percentage.', rgb(200, 80, 80)),
		Category = 'armor_pct',
		DefaultDuration = 6.0,
		DefaultPotency = 0.20,    -- -20% armor per stack
		Stacking = 'stack',
		MaxStack = 3,
		Color = rgb(200, 80, 80),
	},

	-- // Crowd control //
	paralysed = {
		Id = 'paralysed',
		Display = display('Paralysed', "Can't move. Watch the next swing land.", rgb(255, 230, 100)),
		Category = 'cc',
		DefaultDuration = 1.5,
		DefaultPotency = 1,
		Stacking = 'replace',
		MaxStack = 1,
		Color = rgb(255, 230, 100),
	},
	stunned_fx = {
		-- Visually-distinct stun fx; CombatShared.SetCharacterStunned
		-- already drives the gameplay-state attribute. This entry exists
		-- so non-combat sources (e.g. boss skill) can request a stun
		-- via the Effects pipeline without reaching into CombatShared.
		Id = 'stunned_fx',
		Display = display('Stunned', 'Briefly stunned.', rgb(220, 180, 140)),
		Category = 'cc',
		DefaultDuration = 1.0,
		DefaultPotency = 1,
		Stacking = 'replace',
		MaxStack = 1,
		Color = rgb(220, 180, 140),
	},

	-- // Movement debuffs //
	slow = {
		Id = 'slow',
		Display = display('Slowed', 'Movement reduced.', rgb(120, 180, 220)),
		Category = 'movement',
		DefaultDuration = 4.0,
		DefaultPotency = 0.40,    -- 1 - 0.40 = 60% walk speed
		Stacking = 'refresh',
		MaxStack = 1,
		Color = rgb(120, 180, 220),
	},
	chilled = {
		Id = 'chilled',
		Display = display('Chilled', 'Cold-stiffened. Lighter slow than direct ice.', rgb(180, 220, 255)),
		Category = 'movement',
		DefaultDuration = 3.0,
		DefaultPotency = 0.20,
		Stacking = 'refresh',
		MaxStack = 1,
		Color = rgb(180, 220, 255),
	},

	-- // Damage amplification //
	exposed = {
		Id = 'exposed',
		Display = display('Exposed', 'Takes 15% more damage from all sources.', rgb(255, 180, 80)),
		Category = 'damage_amp',
		DefaultDuration = 5.0,
		DefaultPotency = 0.15,
		Stacking = 'refresh',
		MaxStack = 1,
		Color = rgb(255, 180, 80),
	},

	-- // Buffs //
	regen = {
		Id = 'regen',
		Display = display('Regenerating', 'HP recovers over time.', rgb(120, 220, 140)),
		Category = 'dot',          -- positive DoT — handler routes by Potency sign
		DefaultDuration = 6.0,
		DefaultPotency = -3,        -- negative damage = healing
		TickInterval = 1.0,
		Stacking = 'refresh',
		MaxStack = 1,
		Color = rgb(120, 220, 140),
	},

} :: { [string]: BaseEffectConfig }

----------------------------------------------------------------------
-- Legacy id aliases.
--
-- These used to be full duplicate ENTRIES in the registry above, each
-- carrying its own copy of the tuning numbers. The comment on the
-- duplicate claimed it resolved "via the alias map below", but no such
-- map existed — so the two configs were independent, and tuning `burn`
-- would silently leave `Burn` on the old values.
--
-- Real indirection instead: one set of numbers, and the old id keeps
-- resolving for any Studio-authored content that still references it.
----------------------------------------------------------------------
local ID_ALIASES: { [string]: string } = {
	Burn = 'burn',
}

----------------------------------------------------------------------
-- Lookup helpers.
----------------------------------------------------------------------
function Module.ResolveEffectId(id: string): string
	return ID_ALIASES[id] or id
end

function Module.GetEffectFromId(id: string): BaseEffectConfig?
	if typeof(id) ~= 'string' then return nil end
	return Module.StatusEffects[Module.ResolveEffectId(id)]
end

-- Returns the cfg with per-call overrides applied. Caller passes an
-- Effect reference (id + optional Duration / Potency). Useful when
-- the consumer wants the resolved final values without doing the
-- merge themselves.
function Module.ResolveEffect(effectRef: Effect): (BaseEffectConfig?, number, number)
	if not effectRef or typeof(effectRef.Id) ~= 'string' then return nil, 0, 0 end
	-- Routed through GetEffectFromId so legacy ids resolve here too;
	-- indexing the registry directly would bypass the alias map.
	local cfg = Module.GetEffectFromId(effectRef.Id)
	if not cfg then return nil, 0, 0 end
	local duration = effectRef.Duration or cfg.DefaultDuration
	local potency  = effectRef.Potency or cfg.DefaultPotency
	return cfg, duration, potency
end

-- Filter helper for status-bar UI / boss-mod logic that wants only
-- effects in a given category.
function Module.GetEffectsByCategory(category: EffectCategory): { BaseEffectConfig }
	local out: { BaseEffectConfig } = {}
	for _, cfg in Module.StatusEffects do
		if cfg.Category == category then out[#out + 1] = cfg end
	end
	return out
end

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Substations.luau"><![CDATA[-- Substations — secondary proximity gates for crafting recipes.
--
-- Substations are PARALLEL to Workstations:
--   * Workstation = primary node (Forge / CookingPot / AlchemyBench).
--                   Triggers a ProximityPrompt that opens the crafting
--                   widget; the player's "school" is the workstation
--                   they're at. Recipe `Workstation` field gates which
--                   primary node a recipe can be crafted from.
--   * Substation  = secondary AMBIENT node (Kiln / BrewingBarrel /
--                   MortarPestle / SmokingRack / etc.). No prompt; the
--                   player just stands near one and any recipe whose
--                   `RequiredSubstation` matches its kind unlocks for
--                   craft. A recipe can require BOTH a Workstation
--                   and a Substation (e.g. AlchemyBench + MortarPestle
--                   for refined potions).
--
-- Membership uses the ZoneService Structure system (tag StructurePart),
-- so a substation registers a Structure zone keyed by its kind name.
-- The SubstationServer owns the per-player "active substation kinds"
-- set, populated from ZoneService.StructureEnter/Leave.
--
-- Authoring (Studio):
--   1. Tag the substation Model with CollectionService 'Substation'.
--   2. Set Attribute 'SubstationKind' to one of the keys below.
--   3. (Optional) Attribute 'ProximityRadius' (number, studs) — radius
--      of the substation zone. Default 8 studs.
--
-- Add new kinds by appending an entry below; the SubstationDefault
-- fallback keeps unmapped kinds still rendering a waypoint and still
-- gating a recipe (the kind STRING is what matches at runtime).

export type SubstationKindConfig = {
	Label: string,                 -- player-friendly name (waypoint + UI)
	Icon:  string,                 -- single-char glyph
	Color: Color3,                 -- accent color for waypoint stroke / icon
	-- Optional one-liner used by future tooltip / detail UI to explain
	-- what the substation is for. UI may strip it; runtime ignores.
	Hint:  string?,
}

local Module = {}

----------------------------------------------------------------------
-- Substation kinds. Each entry's KEY is the string written to the
-- Substation model's `SubstationKind` attribute — which is also what
-- a Recipe lists in its `RequiredSubstation` field.
----------------------------------------------------------------------
Module.Kinds = {
	Kiln = {
		Label = 'Kiln',
		Icon  = '\u{2615}',  -- ☕ approximation; swap once we ship a glyph font
		Color = Color3.fromRGB(255, 132, 78),
		Hint  = 'Bakes clay & seals smithy hardening recipes.',
	},
	BrewingBarrel = {
		Label = 'Brewing Barrel',
		Icon  = '\u{1F375}',  -- 🍵 (BMP fallback below if needed)
		Color = Color3.fromRGB(186, 142, 96),
		Hint  = 'Aged ferments — required for spirits & long-cure tonics.',
	},
	MortarPestle = {
		Label = 'Mortar & Pestle',
		Icon  = '\u{2697}',   -- ⚗
		Color = Color3.fromRGB(190, 230, 200),
		Hint  = 'Grinds reagents fine enough for refined alchemy.',
	},
	SmokingRack = {
		Label = 'Smoking Rack',
		Icon  = '\u{2638}',   -- ☸ wheel-of-dharma stands in for smoke
		Color = Color3.fromRGB(165, 145, 130),
		Hint  = 'Cures meats and fish past raw cooking.',
	},
	GrindingWheel = {
		Label = 'Grinding Wheel',
		Icon  = '\u{2699}',   -- ⚙
		Color = Color3.fromRGB(180, 195, 215),
		Hint  = 'Sharpens & polishes. Smithy edge recipes need one nearby.',
	},
} :: { [string]: SubstationKindConfig }

-- Generic fallback for substation models whose `SubstationKind`
-- isn't registered above. Surface as "Workbench" with a neutral
-- glyph so the world still teaches the player a node exists, even
-- if the data hasn't been wired yet.
Module.Default = {
	Label = 'Substation',
	Icon  = '\u{25C6}',     -- ◆
	Color = Color3.fromRGB(200, 200, 220),
	Hint  = nil,
} :: SubstationKindConfig

-- Tag + attribute conventions, exported so server / client / waypoint
-- code reads the same constants. Edit here, not at the call sites.
Module.Tag = 'Substation'
Module.AttributeKind = 'SubstationKind'
Module.AttributeRadius = 'ProximityRadius'
Module.DefaultRadius = 8

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/TitleEffects.luau"><![CDATA[-- TitleEffects — named registry of runtime title effects. A title
-- author references one by name (or assigns an inline table) on the
-- title's Effect field. The renderer's apply step calls Init once,
-- then drives OnHeartbeat each frame with the elapsed time and the
-- author's state, and Cleanup once when the title is cleared.
--
-- Each effect entry has the shape:
--   {
--     Init: ((label: TextLabel, gradient: UIGradient?) -> any)?,
--     OnHeartbeat: ((state, label, gradient, elapsed: number, dt: number) -> ())?,
--     Cleanup: ((state, label, gradient) -> ())?,
--   }
--
-- The state returned by Init is opaque to the renderer — authors
-- store whatever per-instance bookkeeping they need (initial color,
-- offset accumulators, etc.). Init may return nil; OnHeartbeat is
-- called regardless.
--
-- Effects are CLIENT-ONLY visual flair. Author authoritative state
-- (unlock, equip) on the server; render flair here.

local Module = {}

----------------------------------------------------------------------
-- Effect type alias.
----------------------------------------------------------------------
export type TitleEffect = {
	Init: ((label: TextLabel, gradient: UIGradient?) -> any)?,
	OnHeartbeat: ((state: any, label: TextLabel, gradient: UIGradient?, elapsed: number, dt: number) -> ())?,
	Cleanup: ((state: any, label: TextLabel, gradient: UIGradient?) -> ())?,
}

----------------------------------------------------------------------
-- Built-in effects.
----------------------------------------------------------------------

-- Rotates a UIGradient slowly so a multi-stop gradient sweeps across
-- the title text. Requires the title's Gradient field to be set;
-- without a UIGradient, this no-ops.
Module.RainbowSweep = {
	Init = function(_label, gradient)
		-- State holds the rotation offset and a per-effect speed override
		-- so the same effect can be reused with different feels.
		return { rotation = (gradient and gradient.Rotation) or 0, speed = 90 }
	end,
	OnHeartbeat = function(state, _label, gradient, _elapsed, dt)
		if not gradient then return end
		state.rotation = (state.rotation + state.speed * dt) % 360
		gradient.Rotation = state.rotation
	end,
} :: TitleEffect

-- Slow scale-pulse on the label's UIScale. Adds one if missing so
-- inline use against a vanilla TextLabel works without setup.
Module.BreathingPulse = {
	Init = function(label, _gradient)
		local scale = label:FindFirstChildOfClass('UIScale')
		if not scale then
			scale = Instance.new('UIScale')
			scale.Name = 'BreathingPulseScale'
			scale.Parent = label
		end
		return { scale = scale, base = scale.Scale, amp = 0.06, freq = 1.2, owned = true }
	end,
	OnHeartbeat = function(state, _label, _gradient, elapsed, _dt)
		if not state or not state.scale then return end
		state.scale.Scale = state.base + math.sin(elapsed * state.freq * math.pi * 2) * state.amp
	end,
	Cleanup = function(state, _label, _gradient)
		-- Only destroy the UIScale if WE created it. A label that
		-- already had a UIScale shouldn't lose it on title clear.
		if state and state.owned and state.scale and state.scale.Parent then
			state.scale:Destroy()
		end
	end,
} :: TitleEffect

-- Subtle hue shift via TextColor3 lerp through a 3-color palette.
-- Useful for gold-tier titles that want a "shimmer" without a full
-- gradient — gradients require a UIGradient instance, this works on
-- a vanilla label.
Module.ShimmerColors = {
	Init = function(label, _gradient)
		return {
			baseColor = label.TextColor3,
			palette = {
				Color3.fromRGB(255, 220, 130),
				Color3.fromRGB(255, 245, 200),
				Color3.fromRGB(220, 180, 90),
			},
		}
	end,
	OnHeartbeat = function(state, label, _gradient, elapsed, _dt)
		if not state then return end
		-- Lerp through the palette over a 3-second period.
		local n = #state.palette
		local t = (elapsed % 3) / 3 * n
		local i = math.floor(t)
		local frac = t - i
		local a = state.palette[(i % n) + 1]
		local b = state.palette[((i + 1) % n) + 1]
		label.TextColor3 = a:Lerp(b, frac)
	end,
	Cleanup = function(state, label, _gradient)
		if state and state.baseColor then
			label.TextColor3 = state.baseColor
		end
	end,
} :: TitleEffect

-- Wobble — gentle horizontal jitter via Position offset. Useful for
-- "haunted" / "cursed" tier titles. Requires the label to be inside
-- a parent that allows the absolute Position write (i.e. not under
-- a UIListLayout that snaps it back). The effect saves/restores the
-- original Position on cleanup.
Module.GhostWobble = {
	Init = function(label, _gradient)
		return { basePos = label.Position }
	end,
	OnHeartbeat = function(state, label, _gradient, elapsed, _dt)
		if not state then return end
		local dx = math.sin(elapsed * 6) * 1.5  -- pixels
		label.Position = state.basePos + UDim2.fromOffset(dx, 0)
	end,
	Cleanup = function(state, label, _gradient)
		if state and state.basePos then
			label.Position = state.basePos
		end
	end,
} :: TitleEffect

----------------------------------------------------------------------
-- Resolve helper. Accepts either a string id (registry lookup) or an
-- inline TitleEffect table — returns the effect or nil. Authors use
-- the string form for built-ins, the inline form for one-off custom
-- effects authored alongside the title in Data/Titles.luau.
----------------------------------------------------------------------
function Module.Resolve(effectOrId: any): TitleEffect?
	if effectOrId == nil then return nil end
	if typeof(effectOrId) == 'string' then
		return Module[effectOrId]
	end
	if typeof(effectOrId) == 'table' then
		return effectOrId :: TitleEffect
	end
	return nil
end

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Titles.luau"><![CDATA[-- Title configs. Each title has a Display + an optional UnlockCheck
-- function that returns true when the player qualifies. Server runs the
-- pass periodically (and on join) to grant qualifying titles.
--
-- Developer / Owner UserIds: hardcoded here for now. Move to a private
-- ServerStorage data file later if you want to keep them out of the
-- shared module.

-- Gradient spec — any field optional except Color.
export type TitleGradient = {
	Color: ColorSequence,
	Rotation: number?,
	Offset: Vector2?,
	Transparency: NumberSequence?,
}

-- Effect spec — either a string id resolved against the
-- TitleEffects registry (RainbowSweep / BreathingPulse / ShimmerColors
-- / GhostWobble) or an inline TitleEffect table for a one-off effect.
-- See ReplicatedStorage/Modules/Data/TitleEffects.luau for the contract.
export type TitleEffectSpec = string | { [string]: any }

export type TitleConfig = {
	Id: string,
	Display: { Name: string, Description: string, Color: Color3? },
	-- Optional UIGradient applied to the title text — for tier titles
	-- that want a multi-stop sweep (rainbow, gold-to-amber, etc.).
	-- Renderer creates the UIGradient instance on Apply, destroys on
	-- Clear, so swapping titles doesn't leak gradients.
	Gradient: TitleGradient?,
	-- Optional runtime effect — driven by RunService.Heartbeat each
	-- frame. Use string ids for built-ins (e.g. 'RainbowSweep') or
	-- pass an inline { Init, OnHeartbeat, Cleanup } table for
	-- bespoke effects.
	Effect: TitleEffectSpec?,
	-- Returns true if the player should unlock this title now. Called
	-- from TitlesServer; receives the live save struct so quest /
	-- analytics conditions can be authored cleanly.
	UnlockCheck: ((player: Player, saveData: any) -> boolean)?,
	-- Whether the title is publicly visible to others when equipped.
	-- Reserved for a future selectedTitle replication path.
	Public: boolean?,
}

local Module = {}

----------------------------------------------------------------------
-- TitleEvent remote protocol. The first arg of every fire is one of
-- these action discriminators. Both the client (CharacterTab FireServer)
-- and TitlesServer (OnServerEvent / FireClient) reference these constants
-- rather than the raw strings, so a rename is a single-site change and a
-- typo is a nil-index — not a silently dead branch.
----------------------------------------------------------------------
export type TitleAction =
	  'SetActive'
	| 'Unlocked'

Module.TitleActions = {
	SetActive = 'SetActive', -- C→S: equip a title (titleId) or nil to clear
	Unlocked  = 'Unlocked',  -- S→C: a title was just unlocked (titleId)
} :: { [string]: TitleAction }

----------------------------------------------------------------------
-- Owner / developer UserId allowlists. Plain arrays so call sites can
-- `table.find(Module.OwnerIds, player.UserId)` without re-implementing
-- the lookup. Keep stable so saves stay valid across alpha → live.
----------------------------------------------------------------------
Module.OwnerIds = {
	1041213550,
}
Module.DeveloperIds = {
	1041213550,
}

local function isOwner(player: Player): boolean
	return table.find(Module.OwnerIds, player.UserId) ~= nil
end

local function isDeveloper(player: Player): boolean
	return table.find(Module.DeveloperIds, player.UserId) ~= nil
end

----------------------------------------------------------------------
-- Helper exports — TitlesServer (and other systems) can read these
-- to gate dev-only features without re-implementing the check.
----------------------------------------------------------------------
Module.IsOwner = isOwner
Module.IsDeveloper = isDeveloper

----------------------------------------------------------------------
-- Registry.
----------------------------------------------------------------------
Module.Titles = {

	alpha_tester = {
		Id = 'alpha_tester',
		Display = {
			Name = 'Alpha Tester',
			Description = 'Played the game during the alpha test phase.',
			Color = Color3.fromRGB(180, 157, 255),
		},
		Public = true,
		-- Auto-grant during the alpha window. Once the alpha ends, set
		-- a hard cutoff timestamp here so latecomers can't claim it.
		-- For now, every player who joins the game during alpha gets
		-- the title.
		UnlockCheck = function(_player, _saveData)
			return true
		end,
	},

	developer = {
		Id = 'developer',
		Display = {
			Name = 'Developer',
			Description = 'A member of the Bladeborne development team.',
			Color = Color3.fromRGB(126, 200, 255),
		},
		Public = true,
		UnlockCheck = function(player, _saveData)
			return isDeveloper(player) or isOwner(player)
		end,
	},

	owner = {
		Id = 'owner',
		Display = {
			Name = 'Owner',
			Description = 'The game owner.',
			Color = Color3.fromRGB(255, 215, 138),
		},
		-- Owner gets a gold shimmer sweep — gradient from amber to
		-- pale-gold to amber, rotated continuously by the
		-- RainbowSweep effect for a flag-flapping look. Authors who
		-- want a static gradient drop the Effect field; the renderer
		-- builds the UIGradient regardless.
		Gradient = {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0,    Color3.fromRGB(220, 170, 80)),
				ColorSequenceKeypoint.new(0.5,  Color3.fromRGB(255, 240, 180)),
				ColorSequenceKeypoint.new(1,    Color3.fromRGB(220, 170, 80)),
			}),
			Rotation = 30,
		},
		Effect = 'RainbowSweep',
		Public = true,
		UnlockCheck = function(player, _saveData)
			return isOwner(player)
		end,
	},

	-- Demo titles — show off the gradient + effect surface end-to-end.
	-- Granted by no UnlockCheck (i.e. never unlocked through normal
	-- play); use the cmdr GiveTitle command (or the dev save tab) to
	-- award them in-test.
	rainbow_demo = {
		Id = 'rainbow_demo',
		Display = {
			Name = 'Spectrum',
			Description = 'A demo title with a rotating rainbow gradient.',
			Color = Color3.fromRGB(255, 255, 255),
		},
		Gradient = {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0,    Color3.fromRGB(255, 90, 90)),
				ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 200, 80)),
				ColorSequenceKeypoint.new(0.5,  Color3.fromRGB(120, 240, 140)),
				ColorSequenceKeypoint.new(0.75, Color3.fromRGB(120, 180, 255)),
				ColorSequenceKeypoint.new(1,    Color3.fromRGB(220, 130, 255)),
			}),
			Rotation = 0,
		},
		Effect = 'RainbowSweep',
	},

	cursed_demo = {
		Id = 'cursed_demo',
		Display = {
			Name = 'Cursed',
			Description = 'Demo title with a wobble + breathing pulse.',
			Color = Color3.fromRGB(170, 80, 200),
		},
		-- Inline effect — composes built-ins by hand-crafting the
		-- table. Authors reach for this when they need bespoke state
		-- not covered by the registry.
		Effect = {
			Init = function(label, _gradient)
				return { base = label.TextColor3, t = 0 }
			end,
			OnHeartbeat = function(state, label, _gradient, elapsed, _dt)
				if not state then return end
				-- Pulse the brightness of the base color ±25% over a
				-- 1.5s sine cycle. Multiplies channel-wise.
				local pulse = 0.75 + 0.25 * math.sin(elapsed * math.pi * 2 / 1.5)
				label.TextColor3 = Color3.new(
					math.clamp(state.base.R * pulse, 0, 1),
					math.clamp(state.base.G * pulse, 0, 1),
					math.clamp(state.base.B * pulse, 0, 1)
				)
			end,
			Cleanup = function(state, label, _gradient)
				if state and state.base then label.TextColor3 = state.base end
			end,
		},
	},

	shimmer_demo = {
		Id = 'shimmer_demo',
		Display = {
			Name = 'Shimmer',
			Description = 'Demo title with the built-in shimmer effect.',
			Color = Color3.fromRGB(255, 220, 130),
		},
		Effect = 'ShimmerColors',
	},

} :: { [string]: TitleConfig }

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Types.luau"><![CDATA[
export type BanData = {
	Moderator: string,
	Reason: string,
	Timestamp: number,
	Duration: number,
}

export type ProfileBans = {
	Active: BanData?,
	History: {BanData},
}

export type RaceIndexes = number

export type EquippedSlotIndexes = string
export type EquippedSlotData = string
export type BaubleSlotIndexes = string
export type BaubleSlotData = string

export type StorageIndexes = string

export type InventoryItemMetaData = {
	gems: any?,
	enchants: any?,
	modifiers: any?,
	transmog: any?,
	cosmetics: any?,
	tags: any?,
}
export type InventoryIndexes = string
export type InventoryData = {}

export type MountIndexes = string
export type MountData = {}

export type CompanionIndexes = string
export type CompanionData = {}

export type BoosterIndexes = string
export type BoosterData = {}

export type TitleIndexes = string
export type TitleData = {}

export type AttributeIndexes = string
export type AttributeData = {}

export type SkillIndexes = string
export type SkillData = {}

export type QuestIndexes = string
export type ActiveQuestData = {}
export type CompletedQuestData = {}

export type DiscoveriesIndexes = string

export type AchievementIndexes = string
export type AchievementData = {
	Timestamp: number,
}

export type PurchaseData = {
	Id: number,
	Timestamp: number,
	Price: number,
	Currency: string
}
export type PurchasesData = {
	TotalSpent: number,
	Purchases: {PurchaseData},
}

export type AnalyticEvent = {
	Timestamp: number,
	Id: string,
	Values: {any},
}
export type AnalyticsData = {
	TimePlayed: number,
	PvEKills: {[string]: number},
	PvEDeaths: {[string]: number},
	PvPKills: {[string]: number},
	PvPDeaths: {[string]: number},
	Events: {AnalyticEvent},
}

export type ProgressionSuperIndex = string
export type ProgressionSubIndex = string
export type ProgressionData = {Timestamp: number,}

export type ProfileSaveData = {
	-- data
	Version: number,
	CurrentFloor: number,

	-- stats
	Race: RaceIndexes,
	Level: number,
	Experience: number,
	Currency: number,
	Reputation: number,
	Bounty: number,

	-- resource = { [itemId]: {[uuid]: data} }
	Inventory: {[InventoryIndexes]: {[string]: InventoryData}},
	Mounts: {[MountIndexes]: {[string]: MountData}},
	Companions: {[CompanionIndexes]: {[string]: CompanionData}},
	Consumables: {[BoosterIndexes]: {[string]: BoosterData}},
	Storages: {[StorageIndexes]: {[InventoryIndexes]: {[string]: InventoryData}}},

	Discoveries: {[DiscoveriesIndexes]: boolean},

	Equipped: {[EquippedSlotIndexes]: EquippedSlotData},
	EquippedLoadouts: {[string]: {[EquippedSlotIndexes]: EquippedSlotData}},
	BaseCustomizations: {[string]: string},

	Titles: {[TitleIndexes]: TitleData},
	Attributes: {[AttributeIndexes]: AttributeData},
	Skills: {[SkillIndexes]: SkillData},

	ActiveQuests: {[QuestIndexes]: ActiveQuestData},
	CompletedQuests: {[QuestIndexes]: CompletedQuestData},

	Achievements: {[AchievementIndexes]: AchievementData},
	Progression: {[ProgressionSuperIndex]: {[ProgressionSubIndex]: ProgressionData}},

	Guild: {Id: string?,},

	-- misc
	Analytics: AnalyticsData,
	Purchases: PurchasesData,
}

export type ProfileData = {
	Banned: ProfileBans,

	Saves: {ProfileSaveData},
	DeletedSaves: {ProfileSaveData},
}

export type ReplicatedData = {}

return true
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Waypoints.luau"><![CDATA[-- Waypoint configs. Drives the world-space 3D markers spawned by
-- WaypointsClient. Two categories:
--   * 'workstation' — auto-spawned at every CollectionService 'Workstation'
--     tag, keyed by the model's `WorkstationKind` attribute (Forge,
--     Enchanting, GemSocketing, CookingPot, AlchemyBench, ...).
--   * 'waystone'    — auto-spawned at every UNLOCKED waystone, keyed by
--     the waystone's `WaystoneId` attribute against PlayerData.Waystones.
--
-- Authoring: append a new kind below to add per-kind icon/color metadata.
-- The client lookups fall back to the generic Workstation default when
-- a kind isn't registered, so unknown kinds still render a marker.

export type WaypointKind = 'workstation' | 'waystone' | 'substation'

export type WaypointKindConfig = {
	Label: string,                 -- shown under the icon
	Icon:  string,                 -- single-char glyph
	Color: Color3,                 -- accent color for stroke + icon tint
}

local Module = {}

----------------------------------------------------------------------
-- Workstation kinds. Keyed by the WorkstationKind attribute. Each gets
-- a distinct glyph from the basic BMP (extensively tested in this
-- codebase to render in the custom font). Add new entries here when
-- new workstations ship; the client falls back to `WorkstationDefault`
-- for any unmapped kind.
----------------------------------------------------------------------
Module.Workstations = {
	Forge = {
		Label = 'Forge',
		Icon  = '\u{2692}',  -- ⚒ hammer-and-pick
		Color = Color3.fromRGB(255, 169, 98),
	},
	Enchanting = {
		Label = 'Enchanting',
		Icon  = '\u{2726}',  -- ✦ four-pointed star
		Color = Color3.fromRGB(180, 157, 255),
	},
	GemSocketing = {
		Label = 'Gem Socketing',
		Icon  = '\u{25C8}',  -- ◈ white diamond w/ dot (distinct from waystone)
		Color = Color3.fromRGB(126, 200, 255),
	},
	CookingPot = {
		Label = 'Cooking Pot',
		Icon  = '\u{272D}',  -- ✭ outlined star
		Color = Color3.fromRGB(220, 200, 160),
	},
	AlchemyBench = {
		Label = 'Alchemy Bench',
		Icon  = '\u{2697}',  -- ⚗ alembic
		Color = Color3.fromRGB(106, 227, 168),
	},
} :: { [string]: WaypointKindConfig }

-- Generic fallback when a workstation has a WorkstationKind attribute
-- the registry doesn't recognize. Better than dropping the marker —
-- the player still sees "something is here", just without a custom icon.
Module.WorkstationDefault = {
	Label = 'Workstation',
	Icon  = '\u{25C6}',  -- ◆
	Color = Color3.fromRGB(200, 200, 220),
} :: WaypointKindConfig

----------------------------------------------------------------------
-- Waystone visual style. Single shared config — per-waystone
-- customization happens via the Waystones data module's display
-- (Floor, Name); the client reads the cfg there for the LABEL string
-- so unlocked waystones show their proper "Floor 1 Wilderness 3"
-- title rather than a generic "Waystone" stub.
----------------------------------------------------------------------
-- Waystones get a distinct "teleport pad" silhouette (◉ bullseye)
-- so they don't visually collide with the gem-socketing diamond.
-- Different glyph + a teal color keeps the two categories
-- distinguishable at a glance from across a room.
Module.WaystoneStyle = {
	Label = 'Waystone',          -- overridden per-waystone at render time
	Icon  = '\u{25C9}',          -- ◉ fisheye / bullseye
	Color = Color3.fromRGB(120, 220, 200),
} :: WaypointKindConfig

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Waystones.luau"><![CDATA[
export type DisplayCategoryConfig = {
	[string]: {Name: string, LayoutOrder: number},
}

export type WaystoneRequirement = {
	-- Item-cost requirements: must consume N of the listed item to unlock.
	-- Used for hardcore-tier waystones gated behind Waystone Pieces.
	RequiredItems: { { ItemId: string, Quantity: number } }?,
	-- Minimum player level (or other future numeric gates).
	MinLevel: number?,
}

export type WaystoneDisplayConfig = {
	Name: string,
	Category: string,
	LayoutOrder: number,
	AutoUnlock: boolean,
	Floor: number,
	LargeWaystone: boolean,
	-- Optional unlock gates. If absent (or AutoUnlock = true), the
	-- waystone unlocks freely on first contact. When present, the
	-- WaystonesServer requires the listed items + level before
	-- granting the unlock; items are consumed on unlock.
	Requirements: WaystoneRequirement?,
}

local Module = {}

Module.WaystonesTag = 'Waystones'

Module.DisplayCategories = {
	Floor0 = {
		Name = 'Floor 0',
		LayoutOrder = 1,
	},
	Floor1 = {
		Name = 'Floor 1',
		LayoutOrder = 2,
	},
} :: {[string]: DisplayCategoryConfig}

Module.WaystoneDisplays = {
	-- floor 0
	F0_World = {
		Name = 'World Start',
		Category = 'Floor0',
		LayoutOrder = 1,
		AutoUnlock = true,
		Floor = 0,
		LargeWaystone = true,
	},
	F0_Wild1 = {
		Name = 'Wild',
		Category = 'Floor0',
		LayoutOrder = 2,
		AutoUnlock = false,
		Floor = 0,
		LargeWaystone = false,
	},
	-- floor 1
	F1_ToB = {
		Name = 'Town of Beginnings',
		Category = 'Floor1',
		LayoutOrder = 1,
		AutoUnlock = true,
		Floor = 1,
		LargeWaystone = true,
	},
	-- F1_MainPath1 = {
	-- 	Name = 'Floor 1 Main Path',
	-- 	Category = 'Floor1',
	-- 	LayoutOrder = 2,
	-- 	Floor = 1,
	-- 	LargeWaystone = false,
	-- },
	F1_TowerEntrance = {
		Name = 'Floor 1 Tower Entrance',
		Category = 'Floor1',
		LayoutOrder = 3,
		Floor = 1,
		LargeWaystone = false,
	},
	F1_Wilderness1 = {
		Name = 'Floor 1 Wilderness 1',
		Category = 'Floor1',
		LayoutOrder = 4,
		Floor = 1,
		LargeWaystone = false,
	},
	F1_Wilderness2 = {
		Name = 'Floor 1 Wilderness 2',
		Category = 'Floor1',
		LayoutOrder = 5,
		Floor = 1,
		LargeWaystone = false,
	},
	F1_Wilderness3 = {
		Name = 'Floor 1 Wilderness 3',
		Category = 'Floor1',
		LayoutOrder = 6,
		Floor = 1,
		LargeWaystone = false,
	},
	F1_Wilderness4 = {
		Name = 'Floor 1 Wilderness 4',
		Category = 'Floor1',
		LayoutOrder = 7,
		Floor = 1,
		LargeWaystone = false,
		-- Hardcore tier: requires 1 Rare Waystone Piece to unlock. Items
		-- are consumed by WaystonesServer.AttemptUnlockWaystone.
		Requirements = {
			RequiredItems = {
				{ ItemId = 'WaystonePieceRare', Quantity = 1 },
			},
		},
	},
	F1_Wilderness5 = {
		Name = 'Floor 1 Wilderness 5',
		Category = 'Floor1',
		LayoutOrder = 8,
		Floor = 1,
		LargeWaystone = false,
		Requirements = {
			RequiredItems = {
				{ ItemId = 'WaystonePieceRare', Quantity = 2 },
			},
		},
	},
} :: {[string]: WaystoneDisplayConfig}

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Libraries/init.luau"><![CDATA[return require(game:GetService('ReplicatedStorage'):WaitForChild('Framework')).Register(script)]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Libraries/Fusion/init.luau"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler
--[[
	The entry point for the Fusion library.
]]

local Types = require(script.Types)
local External = require(script.External)

type Fusion = Types.Fusion

export type Animatable = Types.Animatable
export type UsedAs<T> = Types.UsedAs<T>
export type Child = Types.Child
export type Computed<T> = Types.Computed<T>
export type Contextual<T> = Types.Contextual<T>
export type GraphObject = Types.GraphObject
export type For<KO, VO> = Types.For<KO, VO>
export type Observer = Types.Observer
export type PropertyTable = Types.PropertyTable
export type Scope<Constructors = Fusion> = Types.Scope<Constructors>
export type ScopedObject = Types.ScopedObject
export type SpecialKey = Types.SpecialKey
export type Spring<T> = Types.Spring<T>
export type StateObject<T> = Types.StateObject<T>
export type Task = Types.Task
export type Tween<T> = Types.Tween<T>
export type Use = Types.Use
export type Value<T, S = T> = Types.Value<T, S>
export type Version = Types.Version

-- Down the line, this will be conditional based on whether Fusion is being
-- compiled for Roblox.
do
	local RobloxExternal = require(script.RobloxExternal)
	External.setExternalProvider(RobloxExternal)
end

local Fusion: Fusion = table.freeze {
	-- General
	version = {major = 0, minor = 3, isRelease = true},
	Contextual = require(script.Utility.Contextual),
	Safe = require(script.Utility.Safe),

	-- Memory
	cleanup = require(script.Memory.legacyCleanup),
	deriveScope = require(script.Memory.deriveScope),
	doCleanup = require(script.Memory.doCleanup),
	innerScope = require(script.Memory.innerScope),
	scoped = require(script.Memory.scoped),
	
	-- Graph
	Observer = require(script.Graph.Observer),

	-- State
	Computed = require(script.State.Computed),
	ForKeys = require(script.State.ForKeys) :: Types.ForKeysConstructor,
	ForPairs = require(script.State.ForPairs) :: Types.ForPairsConstructor,
	ForValues = require(script.State.ForValues) :: Types.ForValuesConstructor,
	peek = require(script.State.peek),
	Value = require(script.State.Value),

	-- Roblox API
	Attribute = require(script.Instances.Attribute),
	AttributeChange = require(script.Instances.AttributeChange),
	AttributeOut = require(script.Instances.AttributeOut),
	Child = require(script.Instances.Child),
	Children = require(script.Instances.Children),
	Hydrate = require(script.Instances.Hydrate),
	New = require(script.Instances.New),
	OnChange = require(script.Instances.OnChange),
	OnEvent = require(script.Instances.OnEvent),
	Out = require(script.Instances.Out),

	-- Animation
	Tween = require(script.Animation.Tween),
	Spring = require(script.Animation.Spring),
}

return Fusion
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Libraries/Fusion/Animation/ExternalTime.luau"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Outputs the current external time as a state object.
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)
local External = require(Package.External)
-- Graph
local change = require(Package.Graph.change)
-- Utility
local nicknames = require(Package.Utility.nicknames)

type ExternalTime = Types.StateObject<number>

type Self = ExternalTime

local class = {}
class.type = "State"
class.kind = "ExternalTime"
class.timeliness = "lazy"
class.dependencySet = table.freeze {}
class._EXTREMELY_DANGEROUS_usedAsValue = External.lastUpdateStep()

local METATABLE = table.freeze {__index = class}

local allTimers: {Self} = {}

local function ExternalTime(
	scope: Types.Scope<unknown>
): ExternalTime
	local createdAt = os.clock()
	local self: Self = setmetatable(
		{
			createdAt = createdAt,
			dependentSet = {},
			lastChange = nil,
			scope = scope,
			validity = "invalid"
		}, 
		METATABLE
	) :: any
	local destroy = function()
		self.scope = nil
		local index = table.find(allTimers, self)
		if index ~= nil then
			table.remove(allTimers, index)
		end
	end
	self.oldestTask = destroy
	nicknames[self.oldestTask] = "ExternalTime"
	table.insert(scope, destroy)
	table.insert(allTimers, self)
	return self
end

function class._evaluate(
	self: Self
): boolean
	-- While someone else could call `change()` on this object, it wouldn't be
	-- idiomatic. So, since the only idiomatic time this function runs is when
	-- the external update step runs, it's safe enough to assume that the result
	-- has always meaningfully changed. The worst that can happen is unexpected
	-- refreshing for people doing unorthodox shenanigans, which is an OK trade.
	return true
end

External.bindToUpdateStep(function(
	externalNow: number
): ()
	class._EXTREMELY_DANGEROUS_usedAsValue = External.lastUpdateStep()
	for _, timer in allTimers do
		change(timer)
	end
end)

-- Do *not* freeze the class table, because it stores the shared value of all
-- external time objects, and is updated every frame because of that.
-- table.freeze(class)
return ExternalTime]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Libraries/Fusion/Animation/Spring.luau"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	A specialised state object for following a goal state smoothly over time,
	using physics to shape the motion.

	https://elttob.uk/Fusion/0.3/api-reference/animation/types/spring/
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)
local External = require(Package.External)
-- Memory
local checkLifetime = require(Package.Memory.checkLifetime)
-- Graph
local depend = require(Package.Graph.depend)
local change = require(Package.Graph.change)
local evaluate = require(Package.Graph.evaluate)
-- State
local castToState = require(Package.State.castToState)
local peek = require(Package.State.peek)
-- Animation
local ExternalTime = require(Package.Animation.ExternalTime)
local Stopwatch = require(Package.Animation.Stopwatch)
local packType = require(Package.Animation.packType)
local unpackType = require(Package.Animation.unpackType)
local springCoefficients = require(Package.Animation.springCoefficients)
-- Utility
local nicknames = require(Package.Utility.nicknames)

local EPSILON = 0.00001

type Self<T> = Types.Spring<T> & {
	_activeDamping: number,
	_activeGoal: T,
	_activeLatestP: {number},
	_activeLatestV: {number},
	_activeNumSprings: number,
	_activeSpeed: number,
	_activeStartP: {number},
	_activeStartV: {number},
	_activeTargetP: {number},
	_activeType: string,
	_speed: Types.UsedAs<number>,
	_damping: Types.UsedAs<number>,
	_goal: Types.UsedAs<T>,
	_stopwatch: Stopwatch.Stopwatch
}

local class = {}
class.type = "State"
class.kind = "Spring"
class.timeliness = "eager"

local METATABLE = table.freeze {__index = class}

local function Spring<T>(
	scope: Types.Scope<unknown>,
	goal: Types.UsedAs<T>,
	speed: Types.UsedAs<number>?,
	damping: Types.UsedAs<number>?
): Types.Spring<T>
	local createdAt = os.clock()
	if typeof(scope) ~= "table" or castToState(scope) ~= nil then
		External.logError("scopeMissing", nil, "Springs", "myScope:Spring(goalState, speed, damping)")
	end

	local goalState = castToState(goal)
	local stopwatch = nil
	if goalState ~= nil then
		stopwatch = Stopwatch(scope, ExternalTime(scope))
		stopwatch:unpause()
	end

	local speed = speed or 10
	local damping = damping or 1

	local self: Self<T> = setmetatable(
		{
			createdAt = createdAt,
			dependencySet = {},
			dependentSet = {},
			lastChange = nil,
			scope = scope,
			validity = "invalid",
			_activeDamping = -1,
			_activeGoal = nil,
			_activeLatestP = {},
			_activeLatestV = {},
			_activeNumSprings = 0,
			_activeSpeed = -1,
			_activeStartP = {},
			_activeStartV = {},
			_activeTargetP = {},
			_activeType = "",
			_damping = damping,
			_EXTREMELY_DANGEROUS_usedAsValue = peek(goal),
			_goal = goal,
			_speed = speed,
			_stopwatch = stopwatch
		},
		METATABLE
	) :: any
	local destroy = function()
		self.scope = nil
		for dependency in pairs(self.dependencySet) do
			dependency.dependentSet[self] = nil
		end
	end
	self.oldestTask = destroy
	nicknames[self.oldestTask] = "Spring"
	table.insert(scope, destroy)
	
	if goalState ~= nil then
		checkLifetime.bOutlivesA(
			scope, self.oldestTask,
			goalState.scope, goalState.oldestTask,
			checkLifetime.formatters.animationGoal
		)
	end
	local speedState = castToState(speed)
	if speedState ~= nil then
		checkLifetime.bOutlivesA(
			scope, self.oldestTask,
			speedState.scope, speedState.oldestTask,
			checkLifetime.formatters.parameter, "speed"
		)
	end
	local dampingState = castToState(damping)
	if dampingState ~= nil then
		checkLifetime.bOutlivesA(
			scope, self.oldestTask,
			dampingState.scope, dampingState.oldestTask,
			checkLifetime.formatters.parameter, "damping"
		)
	end

	-- Eagerly evaluated objects need to evaluate themselves so that they're
	-- valid at all times.
	evaluate(self, true)

	return self
end

function class.addVelocity<T>(
	self: Self<T>,
	deltaValue: T
): ()
	evaluate(self, false) -- ensure the _active params are up to date
	local deltaType = typeof(deltaValue)
	if deltaType ~= self._activeType then
		External.logError("springTypeMismatch", nil, deltaType, self._activeType)
	end
	local newStartV = unpackType(deltaValue, deltaType)
	for index, velocity in self._activeLatestV do
		newStartV[index] += velocity
	end
	self._activeStartP = table.clone(self._activeLatestP)
	self._activeStartV = newStartV
	self._stopwatch:zero()
	self._stopwatch:unpause()
	change(self)
end

function class.get<T>(
	self: Self<T>
): never
	return External.logError("stateGetWasRemoved")
end

function class.setPosition<T>(
	self: Self<T>,
	newValue: T
): ()
	evaluate(self, false) -- ensure the _active params are up to date
	local newType = typeof(newValue)
	if newType ~= self._activeType then
		External.logError("springTypeMismatch", nil, newType, self._activeType)
	end
	self._activeStartP = unpackType(newValue, newType)
	self._activeStartV = table.clone(self._activeLatestV)
	self._stopwatch:zero()
	self._stopwatch:unpause()
	change(self)
end

function class.setVelocity<T>(
	self: Self<T>,
	newValue: T
): ()
	evaluate(self, false) -- ensure the _active params are up to date
	local newType = typeof(newValue)
	if newType ~= self._activeType then
		External.logError("springTypeMismatch", nil, newType, self._activeType)
	end
	self._activeStartP = table.clone(self._activeLatestP)
	self._activeStartV = unpackType(newValue, newType)
	self._stopwatch:zero()
	self._stopwatch:unpause()
	change(self)
end

function class._evaluate<T>(
	self: Self<T>
): boolean
	local goal = castToState(self._goal)
	-- Allow non-state goals to pass through transparently.
	if goal == nil then
		self._EXTREMELY_DANGEROUS_usedAsValue = self._goal :: T
		return false
	end
	-- depend(self, goal)
	local nextFrameGoal = peek(goal)
	-- Protect against NaN goals.
	if nextFrameGoal ~= nextFrameGoal then
		External.logWarn("springNanGoal")
		return false
	end
	local nextFrameGoalType = typeof(nextFrameGoal)
	local discontinuous = nextFrameGoalType ~= self._activeType

	local stopwatch = self._stopwatch :: Stopwatch.Stopwatch
	local elapsed = peek(stopwatch)
	depend(self, stopwatch)

	local oldValue = self._EXTREMELY_DANGEROUS_usedAsValue
	local newValue: T

	if discontinuous then
		-- Propagate changes in type instantly throughout the whole reactive
		-- graph, even if simulation is logically one frame behind, because it
		-- makes the whole graph behave more consistently.
		newValue = nextFrameGoal
	elseif elapsed <= 0 then
		newValue = oldValue
	else
		-- Calculate spring motion.
		-- IMPORTANT: use the parameters from last frame, not this frame. We're
		-- integrating the motion that happened over the last frame, after all.
		-- The stopwatch will have captured the length of time needed correctly.
		local posPos, posVel, velPos, velVel = springCoefficients(
			elapsed, 
			self._activeDamping, 
			self._activeSpeed
		)
		local isMoving = false
		for index = 1, self._activeNumSprings do
			local startP = self._activeStartP[index]
			local targetP = self._activeTargetP[index]
			local startV = self._activeStartV[index]
			local startD = startP - targetP
			local latestD = startD * posPos + startV * posVel
			local latestV = startD * velPos + startV * velVel
			if latestD ~= latestD or latestV ~= latestV then
				External.logWarn("springNanMotion")
				latestD, latestV = 0, 0
			end
			if math.abs(latestD) > EPSILON or math.abs(latestV) > EPSILON then
				isMoving = true
			end
			local latestP = latestD + targetP
			self._activeLatestP[index] = latestP
			self._activeLatestV[index] = latestV
		end
		-- Sleep and snap to goal if the motion has decayed to a negligible amount.
		if not isMoving then
			for index = 1, self._activeNumSprings do
				self._activeLatestP[index] = self._activeTargetP[index]
			end
			-- TODO: figure out how to do sleeping correctly for single frame
			-- changes
			-- stopwatch:pause()
			-- stopwatch:zero()
		end
		-- Pack springs into final value.
		newValue = packType(self._activeLatestP, self._activeType) :: any
	end

	-- Reconfigure spring when any of its parameters are changed.
	-- This should happen after integrating the last frame's motion.
	-- NOTE: don't need to add a dependency on these objects! they do not cause
	-- a spring to wake from sleep, so the stopwatch dependency is sufficient.
	local nextFrameSpeed = peek(self._speed) :: number
	local nextFrameDamping = peek(self._damping) :: number
	if
		discontinuous or
		nextFrameGoal ~= self._activeGoal or
		nextFrameSpeed ~= self._activeSpeed or
		nextFrameDamping ~= self._activeDamping
	then
		self._activeTargetP = unpackType(nextFrameGoal, nextFrameGoalType)
		self._activeNumSprings = #self._activeTargetP
		if discontinuous then
			self._activeStartP = table.clone(self._activeTargetP)
			self._activeLatestP = table.clone(self._activeTargetP)
			self._activeStartV = table.create(self._activeNumSprings, 0)
			self._activeLatestV = table.create(self._activeNumSprings, 0)
		else
			self._activeStartP = table.clone(self._activeLatestP)
			self._activeStartV = table.clone(self._activeLatestV)
		end
		self._activeType = nextFrameGoalType
		self._activeGoal = nextFrameGoal
		self._activeDamping = nextFrameDamping
		self._activeSpeed = nextFrameSpeed
		stopwatch:zero()
		stopwatch:unpause()
	end

	-- Push update and check for similarity.
	-- Don't need to use the similarity test here because this code doesn't
	-- deal with tables, and NaN is already guarded against, so the similarity
	-- test doesn't actually add any new safety here.
	self._EXTREMELY_DANGEROUS_usedAsValue = newValue
	return oldValue ~= newValue
end

table.freeze(class)
return Spring :: Types.SpringConstructor]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Libraries/Fusion/Animation/Stopwatch.luau"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	State object for measuring time since an event using a reference timer.

	TODO: this should not be exposed to users until it has a proper reactive API
	surface
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)
-- Memory
local checkLifetime = require(Package.Memory.checkLifetime)
-- Graph
local depend = require(Package.Graph.depend)
local change = require(Package.Graph.change)
-- State
local peek = require(Package.State.peek)
-- Utility
local nicknames = require(Package.Utility.nicknames)

export type Stopwatch = Types.StateObject<number> & {
	zero: (Stopwatch) -> (),
	pause: (Stopwatch) -> (),
	unpause: (Stopwatch) -> ()
}

type Self = Stopwatch & {
	_measureTimeSince: number,
	_playing: boolean,
	_timer: Types.StateObject<number>
}

local class = {}
class.type = "State"
class.kind = "Stopwatch"
class.timeliness = "lazy"

local METATABLE = table.freeze {__index = class}

local function Stopwatch(
	scope: Types.Scope<unknown>,
	timer: Types.StateObject<number>
): Stopwatch
	local createdAt = os.clock()
	local self: Self = setmetatable(
		{
			awake = true,
			createdAt = createdAt,
			dependencySet = {},
			dependentSet = {},
			lastChange = nil,
			scope = scope,
			validity = "invalid",
			_EXTREMELY_DANGEROUS_usedAsValue = 0,
			_measureTimeSince = 0, -- this should be set on unpause
			_playing = false,
			_timer = timer
		}, 
		METATABLE
	) :: any
	local destroy = function()
		self.scope = nil
	end
	self.oldestTask = destroy
	nicknames[self.oldestTask] = "Stopwatch"
	table.insert(scope, destroy)

	checkLifetime.bOutlivesA(
		scope, self.oldestTask,
		timer.scope, timer.oldestTask,
		checkLifetime.formatters.parameter, "timer"
	)
	depend(self, timer)
	return self
end

function class.zero(
	self: Self
): ()
	local newTimepoint = peek(self._timer)
	if newTimepoint ~= self._measureTimeSince then
		self._measureTimeSince = newTimepoint
		self._EXTREMELY_DANGEROUS_usedAsValue = 0
		change(self)
	end
end

function class.pause(
	self: Self
): ()
	if self._playing == true then
		self._playing = false
		change(self)
	end
end

function class.unpause(
	self: Self
): ()
	if self._playing == false then
		self._playing = true
		self._measureTimeSince = peek(self._timer) - self._EXTREMELY_DANGEROUS_usedAsValue
		change(self)
	end
end

function class._evaluate(
	self: Self
): boolean
	if self._playing then
		depend(self, self._timer)
		local currentTime = peek(self._timer)
		local oldValue = self._EXTREMELY_DANGEROUS_usedAsValue
		local newValue = currentTime - self._measureTimeSince
		self._EXTREMELY_DANGEROUS_usedAsValue = newValue
		return oldValue ~= newValue
	else
		return false
	end
	
end

table.freeze(class)
return Stopwatch]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Libraries/Fusion/Animation/Tween.luau"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	A specialised state object for following a goal state smoothly over time,
	using a TweenInfo to shape the motion.

	https://elttob.uk/Fusion/0.3/api-reference/animation/types/tween/
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)
local External = require(Package.External)
-- Memory
local checkLifetime = require(Package.Memory.checkLifetime)
-- Graph
local depend = require(Package.Graph.depend)
local evaluate = require(Package.Graph.evaluate)
-- State
local castToState = require(Package.State.castToState)
local peek = require(Package.State.peek)
-- Animation
local ExternalTime = require(Package.Animation.ExternalTime)
local Stopwatch = require(Package.Animation.Stopwatch)
local lerpType = require(Package.Animation.lerpType)
local getTweenRatio = require(Package.Animation.getTweenRatio)
local getTweenDuration = require(Package.Animation.getTweenDuration)
-- Utility
local nicknames = require(Package.Utility.nicknames)

export type Self<T> = Types.Tween<T> & {
	_activeDuration: number,
	_activeElapsed: number,
	_activeFrom: T,
	_activeTo: T,
	_activeTweenInfo: TweenInfo,
	_goal: Types.UsedAs<T>,
	_stopwatch: Stopwatch.Stopwatch?,
	_tweenInfo: Types.UsedAs<TweenInfo>,
}

local class = {}
class.type = "State"
class.kind = "Tween"
class.timeliness = "eager"

local METATABLE = table.freeze {__index = class}

local function Tween<T>(
	scope: Types.Scope<unknown>,
	goal: Types.UsedAs<T>,
	tweenInfo: Types.UsedAs<TweenInfo>?
): Types.Tween<T>
	local createdAt = os.clock()
	if castToState(scope) then
		External.logError("scopeMissing", nil, "Tweens", "myScope:Tween(goalState, tweenInfo)")
	end

	local goalState = castToState(goal)
	local stopwatch = nil
	if goalState ~= nil then
		stopwatch = Stopwatch(scope, ExternalTime(scope))
	end

	local self: Self<T> = setmetatable(
		{
			createdAt = createdAt,
			dependencySet = {},
			dependentSet = {},
			lastChange = nil,
			scope = scope,
			validity = "invalid",
			_activeDuration = nil,
			_activeElapsed = nil,
			_activeFrom = nil,
			_activeTo = nil,
			_activeTweenInfo = nil,
			_EXTREMELY_DANGEROUS_usedAsValue = peek(goal),
			_goal = goal,
			_stopwatch = stopwatch,
			_tweenInfo = tweenInfo or TweenInfo.new()
		},
		METATABLE
	) :: any
	local destroy = function()
		self.scope = nil
		for dependency in pairs(self.dependencySet) do
			dependency.dependentSet[self] = nil
		end
	end
	self.oldestTask = destroy
	nicknames[self.oldestTask] = "Tween"
	table.insert(scope, destroy)

	if goalState ~= nil then
		checkLifetime.bOutlivesA(
			scope, self.oldestTask,
			goalState.scope, goalState.oldestTask,
			checkLifetime.formatters.animationGoal
		)
	end

	local tweenInfoState = castToState(tweenInfo)
	if tweenInfoState ~= nil then
		checkLifetime.bOutlivesA(
			scope, self.oldestTask,
			tweenInfoState.scope, tweenInfoState.oldestTask,
			checkLifetime.formatters.parameter, "tween info"
		)
	end

	-- Eagerly evaluated objects need to evaluate themselves so that they're
	-- valid at all times.
	evaluate(self, true)

	return self
end

function class.get<T>(
	self: Self<T>
): never
	return External.logError("stateGetWasRemoved")
end

function class._evaluate<T>(
	self: Self<T>
): boolean
	local goal = castToState(self._goal)
	-- Allow non-state goals to pass through transparently.
	if goal == nil then
		self._EXTREMELY_DANGEROUS_usedAsValue = self._goal :: T
		return false
	end
	depend(self, goal)
	local newTweenTo = peek(goal)
	-- Protect against NaN goals.
	if newTweenTo ~= newTweenTo then
		External.logWarn("tweenNanGoal")
		return false
	end
	local stopwatch = self._stopwatch :: Stopwatch.Stopwatch
	local tweenInfo = peek(self._tweenInfo) :: TweenInfo
	-- Restart animation when the goal changes, or if the tween info changes
	-- partway through another animation.
	if 
		self._activeTo ~= newTweenTo or
		(self._activeElapsed < self._activeDuration and self._activeTweenInfo ~= tweenInfo)
	then
		self._activeDuration = getTweenDuration(tweenInfo)
		self._activeFrom = self._EXTREMELY_DANGEROUS_usedAsValue
		self._activeTo = newTweenTo
		self._activeTweenInfo = tweenInfo
		stopwatch:zero()
		stopwatch:unpause()
	end
	depend(self, stopwatch)
	self._activeElapsed = peek(stopwatch)
	if
		self._activeFrom == self._activeTo or -- endpoints match
		self._activeElapsed >= self._activeDuration or -- animation is done
		typeof(self._activeTo) ~= typeof(self._activeFrom) -- type difference
	then
		self._activeFrom = self._activeTo
		self._activeElapsed = self._activeDuration
		stopwatch:pause()
	end
	-- Compute actual tweened value.
	local ratio = getTweenRatio(tweenInfo, self._activeElapsed)
	local oldValue = self._EXTREMELY_DANGEROUS_usedAsValue
	local newValue = lerpType(self._activeFrom, self._activeTo, ratio) :: T
	-- Protect against NaN after motion.
	if newValue ~= newValue then
		External.logWarn("tweenNanMotion")
		newValue = self._activeTo
	end
	-- Push update and check for similarity.
	-- Don't need to use the similarity test here because this code doesn't
	-- deal with tables, and NaN is already guarded against, so the similarity
	-- test doesn't actually add any new safety here.
	self._EXTREMELY_DANGEROUS_usedAsValue = newValue
	return oldValue ~= newValue
end

table.freeze(class)
return Tween :: Types.TweenConstructor
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Libraries/Fusion/Animation/getTweenDuration.luau"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Given a `tweenInfo`, returns how many seconds it will take before the tween
	finishes moving. The result may be infinite if the tween repeats forever.
]]

local TweenService = game:GetService("TweenService")

local function getTweenDuration(
	tweenInfo: TweenInfo
): number
	if tweenInfo.RepeatCount <= -1 then
		return math.huge
	end
	local tweenDuration = tweenInfo.DelayTime + tweenInfo.Time
	if tweenInfo.Reverses then
		tweenDuration += tweenInfo.Time
	end
	tweenDuration *= tweenInfo.RepeatCount + 1
	return tweenDuration
end

return getTweenDuration
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Libraries/Fusion/Animation/getTweenRatio.luau"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Given a `tweenInfo` and `currentTime`, returns a ratio which can be used to
	tween between two values over time.
]]

local TweenService = game:GetService("TweenService")

local function getTweenRatio(
	tweenInfo: TweenInfo,
	currentTime: number
): number
	local delay = tweenInfo.DelayTime
	local duration = tweenInfo.Time
	local reverses = tweenInfo.Reverses
	local numCycles = 1 + tweenInfo.RepeatCount
	local easeStyle = tweenInfo.EasingStyle
	local easeDirection = tweenInfo.EasingDirection
	local cycleDuration = delay + duration
	if reverses then
		cycleDuration += duration
	end
	-- If currentTime is infinity, then presumably the tween should be over.
	-- This avoids NaN when the duration of an infinitely repeating tween is given.
	if currentTime == math.huge then
		return 1
	end
	if currentTime >= cycleDuration * numCycles and tweenInfo.RepeatCount > -1 then
		return 1
	end
	local cycleTime = currentTime % cycleDuration
	if cycleTime <= delay then
		return 0
	end
	local tweenProgress = (cycleTime - delay) / duration
	if tweenProgress > 1 then
		tweenProgress = 2 - tweenProgress
	end
	local ratio = TweenService:GetValue(tweenProgress, easeStyle, easeDirection)
	return ratio
end

return getTweenRatio
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Libraries/Fusion/Animation/lerpType.luau"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Linearly interpolates the given animatable types by a ratio.
	If the types are different or not animatable, then the first value will be
	returned for ratios below 0.5, and the second value for 0.5 and above.
]]

local Package = script.Parent.Parent
local Oklab = require(Package.Colour.Oklab)

local function lerpType(
	from: unknown, 
	to: unknown, 
	ratio: number
): unknown
	local typeString = typeof(from)

	if typeof(to) == typeString then
		-- both types must match for interpolation to make sense
		if typeString == "number" then
			local to, from = to :: number, from :: number
			return (to - from) * ratio + from

		elseif typeString == "CFrame" then
			local to, from = to :: CFrame, from :: CFrame
			return from:Lerp(to, ratio)

		elseif typeString == "Color3" then
			local to, from = to :: Color3, from :: Color3
			local fromLab = Oklab.fromSRGB(from)
			local toLab = Oklab.fromSRGB(to)
			return Oklab.toSRGB(
				fromLab:Lerp(toLab, ratio),
				false
			)

		elseif typeString == "ColorSequenceKeypoint" then
			local to, from = to :: ColorSequenceKeypoint, from :: ColorSequenceKeypoint
			local fromLab = Oklab.fromSRGB(from.Value)
			local toLab = Oklab.fromSRGB(to.Value)
			return ColorSequenceKeypoint.new(
				(to.Time - from.Time) * ratio + from.Time,
				Oklab.toSRGB(
					fromLab:Lerp(toLab, ratio),
					false
				)
			)

		elseif typeString == "DateTime" then
			local to, from = to :: DateTime, from :: DateTime
			return DateTime.fromUnixTimestampMillis(
				(to.UnixTimestampMillis - from.UnixTimestampMillis) * ratio + from.UnixTimestampMillis
			)

		elseif typeString == "NumberRange" then
			local to, from = to :: NumberRange, from :: NumberRange
			return NumberRange.new(
				(to.Min - from.Min) * ratio + from.Min,
				(to.Max - from.Max) * ratio + from.Max
			)

		elseif typeString == "NumberSequenceKeypoint" then
			local to, from = to :: NumberSequenceKeypoint, from :: NumberSequenceKeypoint
			return NumberSequenceKeypoint.new(
				(to.Time - from.Time) * ratio + from.Time,
				(to.Value - from.Value) * ratio + from.Value,
				(to.Envelope - from.Envelope) * ratio + from.Envelope
			)

		elseif typeString == "PhysicalProperties" then
			local to, from = to :: PhysicalProperties, from :: PhysicalProperties
			return PhysicalProperties.new(
				(to.Density - from.Density) * ratio + from.Density,
				(to.Friction - from.Friction) * ratio + from.Friction,
				(to.Elasticity - from.Elasticity) * ratio + from.Elasticity,
				(to.FrictionWeight - from.FrictionWeight) * ratio + from.FrictionWeight,
				(to.ElasticityWeight - from.ElasticityWeight) * ratio + from.ElasticityWeight
			)

		elseif typeString == "Ray" then
			local to, from = to :: Ray, from :: Ray
			return Ray.new(
				from.Origin:Lerp(to.Origin, ratio),
				from.Direction:Lerp(to.Direction, ratio)
			)

		elseif typeString == "Rect" then
			local to, from = to :: Rect, from :: Rect
			return Rect.new(
				from.Min:Lerp(to.Min, ratio),
				from.Max:Lerp(to.Max, ratio)
			)

		elseif typeString == "Region3" then
			local to, from = to :: Region3, from :: Region3
			-- FUTURE: support rotated Region3s if/when they become constructable
			local position = from.CFrame.Position:Lerp(to.CFrame.Position, ratio)
			local halfSize = from.Size:Lerp(to.Size, ratio) / 2
			return Region3.new(position - halfSize, position + halfSize)

		elseif typeString == "Region3int16" then
			local to, from = to :: Region3int16, from :: Region3int16
			return Region3int16.new(
				Vector3int16.new(
					(to.Min.X - from.Min.X) * ratio + from.Min.X,
					(to.Min.Y - from.Min.Y) * ratio + from.Min.Y,
					(to.Min.Z - from.Min.Z) * ratio + from.Min.Z
				),
				Vector3int16.new(
					(to.Max.X - from.Max.X) * ratio + from.Max.X,
					(to.Max.Y - from.Max.Y) * ratio + from.Max.Y,
					(to.Max.Z - from.Max.Z) * ratio + from.Max.Z
				)
			)

		elseif typeString == "UDim" then
			local to, from = to :: UDim, from :: UDim
			return UDim.new(
				(to.Scale - from.Scale) * ratio + from.Scale,
				(to.Offset - from.Offset) * ratio + from.Offset
			)

		elseif typeString == "UDim2" then
			local to, from = to :: UDim2, from :: UDim2
			return from:Lerp(to, ratio)

		elseif typeString == "Vector2" then
			local to, from = to :: Vector2, from :: Vector2
			return from:Lerp(to, ratio)

		elseif typeString == "Vector2int16" then
			local to, from = to :: Vector2int16, from :: Vector2int16
			return Vector2int16.new(
				(to.X - from.X) * ratio + from.X,
				(to.Y - from.Y) * ratio + from.Y
			)

		elseif typeString == "Vector3" then
			local to, from = to :: Vector3, from :: Vector3
			return from:Lerp(to, ratio)

		elseif typeString == "Vector3int16" then
			local to, from = to :: Vector3int16, from :: Vector3int16
			return Vector3int16.new(
				(to.X - from.X) * ratio + from.X,
				(to.Y - from.Y) * ratio + from.Y,
				(to.Z - from.Z) * ratio + from.Z
			)
		end
	end

	-- fallback case: the types are different or not animatable
	if ratio < 0.5 then
		return from
	else
		return to
	end
end

return lerpType]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Libraries/Fusion/Animation/packType.luau"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Packs an array of numbers into a given animatable data type.
	If the type is not animatable, nil will be returned.
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)
local Oklab = require(Package.Colour.Oklab)

local function packType(
	numbers: {number},
	typeString: string
): Types.Animatable?
	if typeString == "number" then
		return numbers[1]

	elseif typeString == "CFrame" then
		return
			CFrame.new(numbers[1], numbers[2], numbers[3]) *
			CFrame.fromAxisAngle(
				Vector3.new(numbers[4], numbers[5], numbers[6]).Unit,
				numbers[7]
			)

	elseif typeString == "Color3" then
		return Oklab.toSRGB(
			Vector3.new(numbers[1], numbers[2], numbers[3]),
			false
		)

	elseif typeString == "ColorSequenceKeypoint" then
		return ColorSequenceKeypoint.new(
			numbers[4],
			Oklab.toSRGB(
				Vector3.new(numbers[1], numbers[2], numbers[3]),
				false
			)
		)

	elseif typeString == "DateTime" then
		return DateTime.fromUnixTimestampMillis(numbers[1])

	elseif typeString == "NumberRange" then
		return NumberRange.new(numbers[1], numbers[2])

	elseif typeString == "NumberSequenceKeypoint" then
		return NumberSequenceKeypoint.new(numbers[2], numbers[1], numbers[3])

	elseif typeString == "PhysicalProperties" then
		return PhysicalProperties.new(numbers[1], numbers[2], numbers[3], numbers[4], numbers[5])

	elseif typeString == "Ray" then
		return Ray.new(
			Vector3.new(numbers[1], numbers[2], numbers[3]),
			Vector3.new(numbers[4], numbers[5], numbers[6])
		)

	elseif typeString == "Rect" then
		return Rect.new(numbers[1], numbers[2], numbers[3], numbers[4])

	elseif typeString == "Region3" then
		-- FUTURE: support rotated Region3s if/when they become constructable
		local position = Vector3.new(numbers[1], numbers[2], numbers[3])
		local halfSize = Vector3.new(numbers[4] / 2, numbers[5] / 2, numbers[6] / 2)
		return Region3.new(position - halfSize, position + halfSize)

	elseif typeString == "Region3int16" then
		return Region3int16.new(
			Vector3int16.new(numbers[1], numbers[2], numbers[3]),
			Vector3int16.new(numbers[4], numbers[5], numbers[6])
		)

	elseif typeString == "UDim" then
		return UDim.new(numbers[1], numbers[2])

	elseif typeString == "UDim2" then
		return UDim2.new(numbers[1], numbers[2], numbers[3], numbers[4])

	elseif typeString == "Vector2" then
		return Vector2.new(numbers[1], numbers[2])

	elseif typeString == "Vector2int16" then
		return Vector2int16.new(numbers[1], numbers[2])

	elseif typeString == "Vector3" then
		return Vector3.new(numbers[1], numbers[2], numbers[3])

	elseif typeString == "Vector3int16" then
		return Vector3int16.new(numbers[1], numbers[2], numbers[3])
	else
		return nil
	end
end

return packType]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Libraries/Fusion/Animation/springCoefficients.luau"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Returns a 2x2 matrix of coefficients for a given time, damping and angular
	frequency (aka 'speed').
	
	Specifically, this returns four coefficients - posPos, posVel, velPos, and
	velVel - which can be multiplied with position and velocity like so:

	local newPosition = oldPosition * posPos + oldVelocity * posVel
	local newVelocity = oldPosition * velPos + oldVelocity * velVel

	For speed = 1 and damping = 0, the result is a simple harmonic oscillator
	with a period of tau.

	Special thanks to AxisAngle for helping to improve numerical precision.
]]

local function springCoefficients(
	time: number,
	damping: number,
	speed: number
): (number, number, number, number)
	-- if time or speed is 0, then the spring won't move
	if time == 0 or speed == 0 then
		return 1, 0, 0, 1
	end
	local posPos, posVel, velPos, velVel

	if damping > 1 then
		-- overdamped spring

		local alpha = math.sqrt(damping^2 - 1)
		local negHalf_over_alpha_speed = -0.5 / (alpha * speed)
		local z1 = speed * (alpha + damping) * -1
		local z2 = speed * (alpha - damping)
		local exp1 = math.exp(time * z1)
		local exp2 = math.exp(time * z2)

		posPos = (exp2 * z1 - exp1 * z2) * negHalf_over_alpha_speed
		posVel = (exp1 - exp2) * negHalf_over_alpha_speed / speed
		velPos = (exp2 - exp1) * negHalf_over_alpha_speed * speed
		velVel = (exp1 * z1 - exp2 * z2) * negHalf_over_alpha_speed

	elseif damping == 1 then
		-- critically damped spring

		local time_speed = time * speed
		local time_speed_neg1 = time_speed * -1
		local exp = math.exp(time_speed_neg1)

		posPos = exp * (time_speed + 1)
		posVel = exp * time
		velPos = exp * (time_speed_neg1 * speed)
		velVel = exp * (time_speed_neg1 + 1)
	else
		-- underdamped spring

		local alpha = speed * math.sqrt(1 - damping^2)
		local overAlpha = 1 / alpha
		local exp = math.exp(-1 * time * speed * damping)
		local sin = math.sin(alpha * time)
		local cos = math.cos(alpha * time)
		local exp_sin = exp * sin
		local exp_cos = exp * cos
		local exp_sin_speed_damping_overAlpha = exp_sin * speed * damping * overAlpha

		posPos = exp_sin_speed_damping_overAlpha + exp_cos
		posVel = exp_sin * overAlpha
		velPos = -1 * ( exp_sin * alpha + speed * damping * exp_sin_speed_damping_overAlpha )
		velVel = exp_cos - exp_sin_speed_damping_overAlpha
	end

	return posPos, posVel, velPos, velVel
end

return springCoefficients
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Libraries/Fusion/Animation/unpackType.luau"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Unpacks an animatable type into an array of numbers.
	If the type is not animatable, an empty array will be returned.
]]

local Package = script.Parent.Parent
local Oklab = require(Package.Colour.Oklab)

local function unpackType(
	value: unknown,
	typeString: string
): {number}
	if typeString == "number" then
		local value = value :: number
		return {value}

	elseif typeString == "CFrame" then
		local value = value :: CFrame
		-- FUTURE: is there a better way of doing this? doing distance
		-- calculations on `angle` may be incorrect
		local axis, angle = value:ToAxisAngle()
		return {value.X, value.Y, value.Z, axis.X, axis.Y, axis.Z, angle}

	elseif typeString == "Color3" then
		local value = value :: Color3
		local lab = Oklab.fromSRGB(value)
		return {lab.X, lab.Y, lab.Z}

	elseif typeString == "ColorSequenceKeypoint" then
		local value = value :: ColorSequenceKeypoint
		local lab = Oklab.fromSRGB(value.Value)
		return {lab.X, lab.Y, lab.Z, value.Time}

	elseif typeString == "DateTime" then
		local value = value :: DateTime
		return {value.UnixTimestampMillis}

	elseif typeString == "NumberRange" then
		local value = value :: NumberRange
		return {value.Min, value.Max}

	elseif typeString == "NumberSequenceKeypoint" then
		local value = value :: NumberSequenceKeypoint
		return {value.Value, value.Time, value.Envelope}

	elseif typeString == "PhysicalProperties" then
		local value = value :: PhysicalProperties
		return {value.Density, value.Friction, value.Elasticity, value.FrictionWeight, value.ElasticityWeight}

	elseif typeString == "Ray" then
		local value = value :: Ray
		return {value.Origin.X, value.Origin.Y, value.Origin.Z, value.Direction.X, value.Direction.Y, value.Direction.Z}

	elseif typeString == "Rect" then
		local value = value :: Rect
		return {value.Min.X, value.Min.Y, value.Max.X, value.Max.Y}

	elseif typeString == "Region3" then
		local value = value :: Region3
		-- FUTURE: support rotated Region3s if/when they become constructable
		return {
			value.CFrame.X, value.CFrame.Y, value.CFrame.Z,
			value.Size.X, value.Size.Y, value.Size.Z
		}

	elseif typeString == "Region3int16" then
		local value = value :: Region3int16
		return {value.Min.X, value.Min.Y, value.Min.Z, value.Max.X, value.Max.Y, value.Max.Z}

	elseif typeString == "UDim" then
		local value = value :: UDim
		return {value.Scale, value.Offset}

	elseif typeString == "UDim2" then
		local value = value :: UDim2
		return {value.X.Scale, value.X.Offset, value.Y.Scale, value.Y.Offset}

	elseif typeString == "Vector2" then
		local value = value :: Vector2
		return {value.X, value.Y}

	elseif typeString == "Vector2int16" then
		local value = value :: Vector2int16
		return {value.X, value.Y}

	elseif typeString == "Vector3" then
		local value = value :: Vector3
		return {value.X, value.Y, value.Z}

	elseif typeString == "Vector3int16" then
		local value = value :: Vector3int16
		return {value.X, value.Y, value.Z}
	else
		return {}
	end
end

return unpackType]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Libraries/Fusion/Colour/Oklab.luau"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Provides functions for converting Color3s into Oklab space, for more
	perceptually uniform colour blending.

	See: https://bottosson.github.io/posts/oklab/
]]

local sRGB = require(script.Parent.sRGB)

local Oklab = {}

-- Converts a Color3 in linear RGB space to a Vector3 in Oklab space.
function Oklab.fromLinear(rgb: Color3): Vector3

	local l = rgb.R * 0.4122214708 + rgb.G * 0.5363325363 + rgb.B * 0.0514459929
	local m = rgb.R * 0.2119034982 + rgb.G * 0.6806995451 + rgb.B * 0.1073969566
	local s = rgb.R * 0.0883024619 + rgb.G * 0.2817188376 + rgb.B * 0.6299787005

	local lRoot = l ^ (1/3)
	local mRoot = m ^ (1/3)
	local sRoot = s ^ (1/3)

	return Vector3.new(
		lRoot * 0.2104542553 + mRoot * 0.7936177850 - sRoot * 0.0040720468,
		lRoot * 1.9779984951 - mRoot * 2.4285922050 + sRoot * 0.4505937099,
		lRoot * 0.0259040371 + mRoot * 0.7827717662 - sRoot * 0.8086757660
	)
end

-- Converts a Color3 in sRGB space to a Vector3 in Oklab space.
function Oklab.fromSRGB(srgb: Color3): Vector3
	return Oklab.fromLinear(sRGB.toLinear(srgb))
end

-- Converts a Vector3 in Oklab space to a Color3 in linear RGB space.
-- The Color3 will be clamped by default unless specified otherwise.
function Oklab.toLinear(lab: Vector3, unclamped: boolean?): Color3
	local lRoot = lab.X + lab.Y * 0.3963377774 + lab.Z * 0.2158037573
	local mRoot = lab.X - lab.Y * 0.1055613458 - lab.Z * 0.0638541728
	local sRoot = lab.X - lab.Y * 0.0894841775 - lab.Z * 1.2914855480

	local l = lRoot ^ 3
	local m = mRoot ^ 3
	local s = sRoot ^ 3

	local red = l * 4.0767416621 - m * 3.3077115913 + s * 0.2309699292
	local green = l * -1.2684380046 + m * 2.6097574011 - s * 0.3413193965
	local blue = l * -0.0041960863 - m * 0.7034186147 + s * 1.7076147010

	if not unclamped then
		red = math.clamp(red, 0, 1)
		green = math.clamp(green, 0, 1)
		blue = math.clamp(blue, 0, 1)
	end

	return Color3.new(red, green, blue)
end

-- Converts a Vector3 in Oklab space to a Color3 in sRGB space.
-- The Color3 will be clamped by default unless specified otherwise.
function Oklab.toSRGB(lab: Vector3, unclamped: boolean?): Color3
	return sRGB.fromLinear(Oklab.toLinear(lab, unclamped))
end

return Oklab
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Libraries/Fusion/Colour/sRGB.luau"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
    Provides transformation functions for converting linear RGB values
    into sRGB values.

    RGB color channel transformations are outlined here:
    https://bottosson.github.io/posts/colorwrong/#what-can-we-do%3F
]]

local sRGB = {}

-- Equivalent to f_inv. Takes a linear sRGB channel and returns
-- the sRGB channel
local function transform(channel: number): number
    if channel >= 0.04045 then
        return ((channel + 0.055)/(1 + 0.055))^2.4
    else
        return channel / 12.92
    end
end

-- Equivalent to f. Takes an sRGB channel and returns
-- the linear sRGB channel
local function inverse(channel: number): number
    if channel >= 0.0031308 then
        return (1.055) * channel^(1.0/2.4) - 0.055
    else
        return 12.92 * channel
    end
end

-- Uses a tranformation to convert linear RGB into sRGB.
function sRGB.fromLinear(rgb: Color3): Color3
    return Color3.new(
        transform(rgb.R),
        transform(rgb.G),
        transform(rgb.B)
    )
end

-- Converts an sRGB into linear RGB using a
-- (The inverse of sRGB.fromLinear).
function sRGB.toLinear(srgb: Color3): Color3
    return Color3.new(
        inverse(srgb.R),
        inverse(srgb.G),
        inverse(srgb.B)
    )
end

return sRGB]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Libraries/Fusion/External.luau"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Abstraction layer between Fusion internals and external environments,
	allowing for flexible integration with schedulers and test mocks.
]]

local Package = script.Parent
local formatError = require(Package.Logging.formatError)
local Types = require(Package.Types)

local ERROR_INFO_URL = "https://elttob.uk/Fusion/0.3/api-reference/general/errors/#"

local External = {}

-- Indicates that a highly time-critical passage of code is running. During
-- critical periods of a program, Fusion might decide to change some of its
-- internal behaviour to be more performance friendly.
local timeCritical = false

-- Multiplier for running-time safety checks across the Fusion codebase. Used to
-- stricten tests on infinite loop detection during unit testing.
External.safetyTimerMultiplier = 1

local updateStepCallbacks = {}
local currentProvider: Types.ExternalProvider? = nil
local lastUpdateStep = 0

--[[
	Swaps to a new provider for external operations.
	Returns the old provider, so it can be used again later.
]]
function External.setExternalProvider(
	newProvider: Types.ExternalProvider?
): Types.ExternalProvider?
	local oldProvider = currentProvider
	if oldProvider ~= nil then
		oldProvider.stopScheduler()
	end
	currentProvider = newProvider
	if newProvider ~= nil then
		newProvider.startScheduler()
	end
	return oldProvider
end

--[[
	Returns true if a highly time-critical passage of code is running.
]]
function External.isTimeCritical(): boolean
	return timeCritical
end

--[[
   Sends an immediate task to the external provider. Throws if none is set.
]]
function External.doTaskImmediate(
	resume: () -> ()
)
	if currentProvider == nil then
		External.logError("noTaskScheduler")
	else
		currentProvider.doTaskImmediate(resume)
	end
end

--[[
	Sends a deferred task to the external provider. Throws if none is set.
]]
function External.doTaskDeferred(
	resume: () -> ()
)
	if currentProvider == nil then
		External.logError("noTaskScheduler")
	else
		currentProvider.doTaskDeferred(resume)
	end
end

--[[
	Errors in the current thread and halts execution.
]]
function External.logError(
	messageID: string,
	errObj: Types.Error?,
	...: unknown
): never
	error(formatError(currentProvider, messageID, errObj, ...), 0)
end

--[[
	Errors in a different thread to preserve the flow of execution.
]]
function External.logErrorNonFatal(
	messageID: string,
	errObj: Types.Error?,
	...: unknown
): ()
	local errorString = formatError(currentProvider, messageID, errObj, ...)
	if currentProvider ~= nil then
		currentProvider.logErrorNonFatal(errorString)
	else
		print(errorString)
	end
end

--[[
	Shows a warning message in the output.
]]
function External.logWarn(
	messageID: string,
	...: unknown
): ()
	local errorString = formatError(currentProvider, messageID, debug.traceback(nil, 2), ...)
	if currentProvider ~= nil then
		currentProvider.logWarn(errorString)
	else
		print(errorString)
	end
end

--[[
	Registers a callback to the update step of the external provider.
	Returns a function that can be used to disconnect later.

	Callbacks are given the current number of seconds since an arbitrary epoch.
	
	TODO: This epoch may change between providers. We could investigate ways
	of allowing providers to co-operate to keep the epoch the same, so that
	monotonicity can be better preserved.
]]
function External.bindToUpdateStep(
	callback: (
		now: number
	) -> ()
): () -> ()
	local uniqueIdentifier = {}
	updateStepCallbacks[uniqueIdentifier] = callback
	return function()
		updateStepCallbacks[uniqueIdentifier] = nil
	end
end

--[[
	Steps time-dependent systems with the current number of seconds since an
	arbitrary epoch. This should be called as early as possible in the external
	provider's update cycle.
]]
function External.performUpdateStep(
	now: number
)
	lastUpdateStep = now
	for _, callback in updateStepCallbacks do
		callback(now)
	end
end

--[[
	Returns the timestamp of the last update step.
]]
function External.lastUpdateStep()
	return lastUpdateStep
end

return External]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Libraries/Fusion/ExternalDebug.luau"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Abstraction layer between Fusion internals and external debuggers, allowing
	for deep introspection using function hooks.

	Unlike `External`, attaching a debugger is optional, and all debugger
	functions are expected to be infallible and non-blocking.
]]

local Package = script.Parent
local Types = require(Package.Types)

local currentProvider: Types.ExternalDebugger? = nil
local lastUpdateStep = 0

local Debugger = {}

--[[
	Swaps to a new debugger.
	Returns the old debugger, so it can be used again later.
]]
function Debugger.setDebugger(
	newProvider: Types.ExternalDebugger?
): Types.ExternalDebugger?
	local oldProvider = currentProvider
	if oldProvider ~= nil then
		oldProvider.stopDebugging()
	end
	currentProvider = newProvider
	if newProvider ~= nil then
		newProvider.startDebugging()
	end
	return oldProvider
end

--[[
	Called at the earliest moment after a scope is created or removed from the
	scope pool, but not before the scope has finished being prepared by the
	library, so that debuggers can register its existence and track changes
	to the scope over time.
]]
function Debugger.trackScope(
	scope: Types.Scope<unknown>
): ()
	if currentProvider == nil then
		return
	end
	currentProvider.trackScope(scope)
end

--[[
	Called at the final moment before a scope is poisoned or added to the scope
	pool, after all cleanup tasks have completed, so that debuggers can erase 
	the scope from internal trackers. Note that, due to scope pooling and user
	code, never assume that this correlates with garbage collection events.
]]
function Debugger.untrackScope(
	scope: Types.Scope<unknown>
): ()
	if currentProvider == nil then
		return
	end
	currentProvider.trackScope(scope)
end

return Debugger]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Libraries/Fusion/Graph/Observer.luau"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	A graph object that runs user code when it's updated by the reactive graph.

	http://elttob.uk/Fusion/0.3/api-reference/state/types/observer/
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)
local External = require(Package.External)
-- Memory
local checkLifetime = require(Package.Memory.checkLifetime)
-- Graph
local castToGraph = require(Package.Graph.castToGraph)
local depend = require(Package.Graph.depend)
local evaluate = require(Package.Graph.evaluate)
-- Utility
local nicknames = require(Package.Utility.nicknames)

type Self = Types.Observer & {
	_watchingGraph: Types.GraphObject?,
	_changeListeners: {[unknown]: () -> ()}
}

local class = {}
class.type = "Observer"
class.timeliness = "eager"
class.dependentSet = table.freeze {}

local METATABLE = table.freeze {__index = class}

local function Observer(
	scope: Types.Scope<unknown>,
	watching: unknown
): Types.Observer
	local createdAt = os.clock()
	if watching == nil then
		External.logError("scopeMissing", nil, "Observers", "myScope:Observer(watching)")
	end

	local self: Self = setmetatable(
		{
			scope = scope,
			createdAt = createdAt,
			dependencySet = {},
			lastChange = nil,
			validity = "invalid",
			_watchingGraph = castToGraph(watching),
			_changeListeners = {}
		},
		METATABLE
	) :: any
	local destroy = function()
		self.scope = nil
		for dependency in pairs(self.dependencySet) do
			dependency.dependentSet[self] = nil
		end
	end
	self.oldestTask = destroy
	nicknames[self.oldestTask] = "Observer"
	table.insert(scope, destroy)

	if self._watchingGraph ~= nil then
		checkLifetime.bOutlivesA(
			scope, self.oldestTask,
			self._watchingGraph.scope, self._watchingGraph.oldestTask,
			checkLifetime.formatters.observer
		)
	end

	-- Eagerly evaluated objects need to evaluate themselves so that they're
	-- valid at all times.
	evaluate(self, true)

	return self
end

function class.onBind(
	self: Self,
	callback: () -> ()
): () -> ()
	External.doTaskImmediate(callback)
	return self:onChange(callback)
end

function class.onChange(
	self: Self,
	callback: () -> ()
): () -> ()
	local uniqueIdentifier = table.freeze {}
	self._changeListeners[uniqueIdentifier] = callback
	return function()
		self._changeListeners[uniqueIdentifier] = nil
	end
end

function class._evaluate(
	self: Self
): ()
	if self._watchingGraph ~= nil then
		depend(self, self._watchingGraph)
	end
	for _, callback in self._changeListeners do
		External.doTaskImmediate(callback)
	end
	return true
end

table.freeze(class)
return Observer :: Types.ObserverConstructor]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Libraries/Fusion/Graph/castToGraph.luau"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Returns the input *only* if it is a graph object.
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)

local function castToGraph(
	target: any
): Types.GraphObject?
	if 
		typeof(target) == "table" and
		typeof(target.validity) == "string" and
		typeof(target.timeliness) == "string" and
		typeof(target.dependencySet) == "table" and
		typeof(target.dependentSet) == "table"
	then
		return target
	else
		return nil
	end
end

return castToGraph]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Libraries/Fusion/Graph/change.luau"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Prompts a graph object to re-evaluate its own value. If it meaningfully
	changes, then dependents will have to re-evaluate their own values in the
	future.

	https://fluff.blog/2024/04/16/monotonic-painting.html
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)
local External = require(Package.External)
local evaluate = require(Package.Graph.evaluate)

-- How long should this function run before it's considered to be in an infinite
-- cycle and error out?
local TERMINATION_TIME = 1

local function change(
	target: Types.GraphObject
): ()
	if target.validity == "busy" then
		return External.logError("infiniteLoop")
	end

	local meaningfullyChanged = evaluate(target, true)
	if not meaningfullyChanged then
		return
	end

	local searchInNow: {Types.GraphObject} = {}
	local searchInNext: {Types.GraphObject} = {}
	local invalidateList: {Types.GraphObject} = {}

	searchInNow[1] = target
	local terminateBy = os.clock() + TERMINATION_TIME * External.safetyTimerMultiplier
	repeat
		if os.clock() > terminateBy then
			return External.logError("infiniteLoop")
		end
		local done = true
		for _, searchTarget in searchInNow do
			for dependent in searchTarget.dependentSet do
				if dependent.validity == "valid" then
					done = false
					table.insert(invalidateList, dependent)
					table.insert(searchInNext, dependent)
				elseif dependent.validity == "busy" then
					return External.logError("infiniteLoop")
				end
			end
		end
		searchInNow, searchInNext = searchInNext, searchInNow
		table.clear(searchInNext)
	until done

	local eagerList: {Types.GraphObject} = {}

	for _, invalidateTarget in invalidateList do
		invalidateTarget.validity = "invalid"
		if invalidateTarget.timeliness == "eager" then
			table.insert(eagerList, invalidateTarget)
		end
	end
	-- If objects are not executed in order of creations, then dynamic graphs
	-- may experience 'glitches' where nested graph objects see intermediate
	-- values before being destroyed.
	-- https://fluff.blog/2024/07/14/glitches-in-dynamic-reactive-graphs.html
	table.sort(eagerList, function(a, b)
		return a.createdAt < b.createdAt
	end)
	for _, eagerTarget in eagerList do
		evaluate(eagerTarget, false)
	end
end

return change]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Libraries/Fusion/Graph/depend.luau"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Forms a dependency on a graph object.
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)
local External = require(Package.External)
local evaluate = require(Package.Graph.evaluate)
local nameOf = require(Package.Utility.nameOf)

local function depend<T>(
	dependent: Types.GraphObject,
	dependency: Types.GraphObject
): ()
	-- Ensure dependencies are evaluated and up-to-date
	-- when they are depended on. Also, newly created objects
	-- might not have any transitive dependencies captured yet,
	-- so ensure that they're present.
	evaluate(dependency, false)

	if table.isfrozen(dependent.dependencySet) or table.isfrozen(dependency.dependentSet) then
		External.logError("cannotDepend", nil, nameOf(dependent, "Dependent"), nameOf(dependency, "dependency"))
	end
	dependency.dependentSet[dependent] = true
	dependent.dependencySet[dependency] = true
end

return depend]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Libraries/Fusion/Graph/evaluate.luau"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	Evaluates the graph object if necessary, so that it is up to date.
	Returns true if it meaningfully changed.

	https://fluff.blog/2024/04/16/monotonic-painting.html
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)
local External = require(Package.External)

local function evaluate(
	target: Types.GraphObject,
	forceComputation: boolean
): boolean
	if target.validity == "busy" then
		return External.logError("infiniteLoop")
	end
	local firstEvaluation = target.lastChange == nil
	local isInvalid = target.validity == "invalid"
	if firstEvaluation or isInvalid or forceComputation then
		local needsComputation = firstEvaluation or forceComputation
		if not needsComputation then
			for dependency in target.dependencySet do
				evaluate(dependency, false)
				if dependency.lastChange > target.lastChange then
					needsComputation = true
					break
				end
			end
		end
		local targetMeaningfullyChanged = false
		if needsComputation then
			for dependency in target.dependencySet do
				dependency.dependentSet[target] = nil
				target.dependencySet[dependency] = nil
			end
			target.validity = "busy"
			targetMeaningfullyChanged = target:_evaluate() or firstEvaluation
		end
		if targetMeaningfullyChanged then
			target.lastChange = os.clock()
		end
		target.validity = "valid"
		return targetMeaningfullyChanged
	else
		return false
	end
end

return evaluate]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Libraries/Fusion/Instances/Attribute.luau"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	A special key for property tables, which allows users to apply custom
	attributes to instances
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)
-- Memory
local checkLifetime = require(Package.Memory.checkLifetime)
-- Graph
local Observer = require(Package.Graph.Observer)
-- State
local castToState = require(Package.State.castToState)
local peek = require(Package.State.peek)

local keyCache: {[string]: Types.SpecialKey} = {}

local function Attribute(
	attributeName: string
): Types.SpecialKey
	local key = keyCache[attributeName]
	if key == nil then
		key = {
			type = "SpecialKey",
			kind = "Attribute",
			stage = "self",
			apply = function(
				self: Types.SpecialKey,
				scope: Types.Scope<unknown>,
				value: unknown,
				applyTo: Instance
			)
				if castToState(value) then
					local value = value :: Types.StateObject<unknown>
					checkLifetime.bOutlivesA(
						scope, applyTo,
						value.scope, value.oldestTask,
						checkLifetime.formatters.boundAttribute, attributeName
					)
					Observer(scope, value :: any):onBind(function()
						applyTo:SetAttribute(attributeName, peek(value))
					end)
				else
					applyTo:SetAttribute(attributeName, value)
				end
			end
		}
		keyCache[attributeName] = key
	end
	return key
end

return Attribute]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Libraries/Fusion/Instances/AttributeChange.luau"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	A special key for property tables, which allows users to connect to
	an attribute change on an instance.
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)
local External = require(Package.External)

local keyCache: {[string]: Types.SpecialKey} = {}

local function AttributeChange(
	attributeName: string
): Types.SpecialKey
	local key = keyCache[attributeName]
	if key == nil then
		key = {
			type = "SpecialKey",
			kind = "AttributeChange",
			stage = "observer",
			apply = function(
				self: Types.SpecialKey,
				scope: Types.Scope<unknown>,
				value: unknown,
				applyTo: Instance
			)
				if typeof(value) ~= "function" then
					External.logError("invalidAttributeChangeHandler", nil, attributeName)
				end
				local value = value :: (...unknown) -> (...unknown)
				local event = applyTo:GetAttributeChangedSignal(attributeName)
				table.insert(scope, event:Connect(function()
					value((applyTo :: any):GetAttribute(attributeName))
				end))
			end
		}
		keyCache[attributeName] = key
	end
	return key
end

return AttributeChange]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Libraries/Fusion/Instances/AttributeOut.luau"><![CDATA[--!strict
--!nolint LocalUnused
--!nolint LocalShadow
local task = nil -- Disable usage of Roblox's task scheduler

--[[
	A special key for property tables, which allows users to save instance attributes
	into state objects
]]

local Package = script.Parent.Parent
local Types = require(Package.Types)
local External = require(Package.External)
-- Memory
local checkLifetime = require(Package.Memory.checkLifetime)
-- State
local castToState = require(Package.State.castToState)

local keyCache: {[string]: Types.SpecialKey} = {}

local function AttributeOut(
	attributeName: string
): Types.SpecialKey
	local key = keyCache[attributeName]
	if key == nil then
		key = {
			type = "SpecialKey",
			kind = "AttributeOut",
			stage = "observer",
			apply = function(
				self: Types.SpecialKey,
				scope: Types.Scope<unknown>,
				value: unknown,
				applyTo: Instance
			)
				local event = applyTo:GetAttributeChangedSignal(attributeName)
	
				if not castToState(value) then
					External.logError("invalidAttributeOutType")
				end
				local value = value :: Types.StateObject<unknown>
				if value.kind ~= "Value" then
					External.logError("invalidAttributeOutType")
				end
				local value = value :: Types.Value<unknown>
				checkLifetime.bOutlivesA(
					scope, applyTo,
					value.scope, value.oldestTask,
					checkLifetime.formatters.attributeOutputsTo, attributeName
				)

				value:set((applyTo :: any):GetAttribute(attributeName))
				table.insert(scope, event:Connect(function()	
					value:set((applyTo :: any):GetAttribute(attributeName))
				end))
			end
		}
		keyCache[attributeName] = key
	end
	return key
end

return AttributeOut
]]></Source>
