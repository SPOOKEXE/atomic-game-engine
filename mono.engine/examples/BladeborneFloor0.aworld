		<Source path="ServerScriptService/CmdrSetup/Commands/cinematic/VfxServer"><![CDATA[local ReplicatedStorage = game:GetService('ReplicatedStorage')
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local CinematicShared  = ReplicatedModules.Services.CinematicShared
local CinematicPresets = ReplicatedModules.Data.CinematicPresets

local ServerStorage = game:GetService('ServerStorage')
local ServerCore    = require(ServerStorage:WaitForChild('Core'))

return function(context, presetName)
	local p = CinematicPresets.VFX[presetName]
	if not p then
		return string.format('Unknown VFX preset %q. Try: %s', tostring(presetName),
			table.concat(CinematicPresets.ListVFX(), ', '))
	end
	local CinematicServer = ServerCore.CinematicServer
	if not CinematicServer or not CinematicServer.FireCueForPlayer then
		return 'CinematicServer module unavailable.'
	end
	local player = context.Executor
	-- Server can't resolve the local character's instance path the
	-- way the client widget can — instead we anchor 'world' at the
	-- character's HRP position. Cinematic VFX cue handles either
	-- anchor mode at runtime.
	local args: { [string]: any } = {
		TemplateName = p.Template, Duration = p.Duration, Anchor = 'world',
	}
	local char = player.Character
	local hrp = char and char:FindFirstChild('HumanoidRootPart')
	if hrp then
		args.Position = (hrp :: BasePart).Position
	else
		args.Position = Vector3.new(0, 5, 0)
	end
	CinematicServer.FireCueForPlayer(player, CinematicShared.CueKind.PlayVFX, args)
	return string.format('Fired VFX %q.', presetName)
end
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/mounts/GiveMount"><![CDATA[--!strict
-- /givemount <player> <mountId> [autoEquip] — unlock a mount; optionally
-- auto-equip the player onto it.
return {
	Name = 'GiveMount',
	Aliases = { 'givemount', 'unlockmount' },
	Description = 'Unlock a mount on a player; optionally auto-equip it.',
	Group = 'Admin',
	Args = {
		{ Type = 'player',  Name = 'target',    Description = 'Target player.' },
		{ Type = 'string',  Name = 'mountId',   Description = "Mount id from Data/Mounts.luau (e.g. 'shadow_steed', 'storm_wyvern')." },
		{ Type = 'boolean', Name = 'autoEquip', Description = 'Auto-equip after unlock. Default false.', Optional = true },
	},
}
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/mounts/GiveMountServer"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore    = require(ServerStorage:WaitForChild('Core'))
local ServerModules = require(ServerStorage:WaitForChild('Modules'))

-- Cmdr is server-side; reads the full registry from the canonical copy.
local MountsConfig = ServerModules.Data.Mounts

return function(_context, target: Player, mountId: string, autoEquip: boolean?)
	if not MountsConfig.Mounts[mountId] then
		local known: { string } = {}
		for id in MountsConfig.Mounts do known[#known + 1] = id end
		table.sort(known)
		return string.format("Unknown mount id %q. Known: %s", mountId, table.concat(known, ', '))
	end
	local MountsServer = ServerCore.MountsServer
	if not MountsServer or not MountsServer.AttemptUnlockMount then
		return 'MountsServer module unavailable.'
	end
	local unlocked = MountsServer.AttemptUnlockMount(target, mountId)
	if not unlocked then
		return string.format('Failed to unlock %q for %s.', mountId, target.Name)
	end
	-- autoEquip default = false. When true, this command:
	--   1. Sets the active mount slot (AttemptEquipMount)
	--   2. Starts the player riding it (AttemptMount)
	-- These are now separate operations after the equip/mount split, so
	-- the cmdr explicitly calls both to preserve the prior "give + ride
	-- in one shot" feel.
	if autoEquip == true then
		local equipped = MountsServer.AttemptEquipMount(target, mountId)
		if not equipped then
			return string.format('Unlocked %q for %s. (Equip skipped: gating refused.)', mountId, target.Name)
		end
		if MountsServer.AttemptMount then MountsServer.AttemptMount(target) end
		return string.format('Unlocked + mounted %q for %s.', mountId, target.Name)
	end
	return string.format('Unlocked %q for %s.', mountId, target.Name)
end
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/mounts/DeleteMount"><![CDATA[--!strict
