		<Source path="src/ServerScriptService/CmdrSetup/Commands/travel/TeleportToWaystoneServer.luau"><![CDATA[local ServerStorage = game:GetService("ServerStorage")
local ServerCore = require(ServerStorage:WaitForChild('Core'))

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local WaystonesData = require(ReplicatedStorage:WaitForChild('Modules')).Data.Waystones

return function(_context, target: Player, waystoneId: string)
	if not WaystonesData.WaystoneDisplays[waystoneId] then
		return string.format("No waystone config registered for '%s'.", waystoneId)
	end
	local Waystones = ServerCore.WaystonesServer
	if not Waystones or not Waystones.TeleportPlayerToWaystone then
		return "WaystonesServer.TeleportPlayerToWaystone unavailable."
	end
	-- Auto-unlock the destination so an admin tp doesn't fail on a
	-- locked waystone (the regular AttemptPlayerTeleportToWaystone path
	-- gates on unlock; we bypass that by going through the inner
	-- TeleportPlayerToWaystone directly).
	if Waystones.UnlockWaystoneForPlayer then
		Waystones.UnlockWaystoneForPlayer(target, waystoneId)
	end
	-- Pass `nil` for sourceWaystoneType so the cross-floor "source must
	-- be major" gate is bypassed — admin teleport should work from
	-- anywhere, including the open world.
	local ok, msg = Waystones.TeleportPlayerToWaystone(target, waystoneId, nil)
	if not ok then
		return string.format("Teleport failed: %s", tostring(msg))
	end
	return string.format("Teleported %s to '%s'.", target.Name, waystoneId)
end
]]></Source>
