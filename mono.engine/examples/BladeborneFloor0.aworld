		<Source path="ServerScriptService/CmdrSetup/Commands/artisan/GiveArtisanXPServer"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local CraftingConfig = require(ReplicatedStorage:WaitForChild('Modules')).Data.Crafting

return function(_context, target: Player, school: string, amount: number)
	if not CraftingConfig.Schools[school] then
		local known: { string } = {}
		for id in CraftingConfig.Schools do known[#known + 1] = id end
		table.sort(known)
		return string.format('Unknown school %q. Known: %s', school, table.concat(known, ', '))
	end
	local Crafting = ServerCore.CraftingServer
	if not Crafting or not Crafting.AddArtisanXP then
		return 'CraftingServer unavailable.'
	end
	Crafting.AddArtisanXP(target, school, math.max(1, math.floor(amount)))
	return string.format('Added %d %s XP to %s.', amount, school, target.Name)
end
]]></Source>
