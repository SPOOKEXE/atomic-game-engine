		<Source path="ServerScriptService/CmdrSetup/Commands/artisan/GiveGemServer"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerModules = require(ServerStorage:WaitForChild('Modules'))
local ServerCore = require(ServerStorage:WaitForChild('Core'))

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ItemsConfig = ServerModules.Data.Items  -- migrated to per-player config replication; server reads canonical.
local GemsConfig = require(ReplicatedStorage:WaitForChild('Modules')).Data.Gems

return function(_context, target: Player, gemId: string, quantity: number)
	if not GemsConfig.Gems[gemId] then
		return string.format("No gem with id '%s'.", gemId)
	end
	-- Walk Items.Items to find the canonical item that points at this
	-- catalog gem id. First match wins (deterministic via Lua iteration
	-- order). If multiple items share the same GemId you'd want a
	-- per-item disambiguator — for v1 there's exactly one item per gem.
	local pickItemId = nil
	for itemId, cfg in ItemsConfig.Items do
		local meta = ItemsConfig.GetGem(cfg)
		if meta and meta.Id == gemId then
			pickItemId = itemId
			break
		end
	end
	if not pickItemId then
		return string.format("No inventory item is wired to GemId='%s'.", gemId)
	end
	quantity = math.max(1, math.floor(quantity or 1))
	ServerCore.PlayerInventoryServer.GiveQuantityOfItemIdToPlayer(target, pickItemId, quantity)
	return string.format("Gave %s x%d (gem '%s') to %s.", pickItemId, quantity, gemId, target.Name)
end
]]></Source>
