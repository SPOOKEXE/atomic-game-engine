local ServerCore = require(ServerStorage:WaitForChild('Core'))

return function(_context, target: Player)
	local StatusEffects = ServerCore.StatusEffectsRuntime
	if not StatusEffects or not StatusEffects.ClearAll then
		return 'StatusEffectsRuntime unavailable.'
	end
	local char = target.Character
	if not char then return string.format('%s has no character.', target.Name) end
	StatusEffects.ClearAll(char)
	return string.format('Cleared all effects on %s.', target.Name)
end
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/onboarding/ResetOnboardingStatus"><![CDATA[--!strict
-- /reset_onboarding_status [player] — wipes Onboarding.IntroPlayed +
-- CompletedSteps + CurrentStep so the player's next character spawn
-- replays the intro cinematic + tutorial flow.
return {
	Name = 'ResetOnboardingStatus',
	Aliases = { 'reset_onboarding_status', 'resetonboarding', 'reonboard' },
	Description = "Wipe a player's onboarding flags so the intro + tutorial replay on next spawn.",
	Group = 'Admin',
	Args = {
		{ Type = 'player', Name = 'target', Description = 'Player whose onboarding to reset.' },
	},
}
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/onboarding/ResetOnboardingStatusServer"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

return function(_context, target: Player)
	local Saves = ServerCore.SavesManagerServer
	if not Saves or not Saves.GetPlayerSelectedSaveData then
		return 'SavesManagerServer unavailable.'
	end
	local data = Saves.GetPlayerSelectedSaveData(target)
	if not data then
		return string.format('%s has no save selected.', target.Name)
	end

	-- Reset to a fresh shape the OnboardingServer.ensureOnboarding will
	-- fill in on next read. Wiping rather than replacing because other
	-- systems may have stashed sibling fields under data.Onboarding.
	if typeof(data.Onboarding) == 'table' then
		data.Onboarding.CompletedSteps = {}
		data.Onboarding.CurrentStep = nil
		data.Onboarding.IntroPlayed = false
	else
		data.Onboarding = { CompletedSteps = {}, CurrentStep = nil, IntroPlayed = false }
	end

	-- Lift any active area lock so the reset doesn't leave the player
	-- pinned in the spawn-town region from a prior onboarding pass.
	local AreaLock = ServerCore.AreaLockServer
	if AreaLock and AreaLock.DisableLock then
		AreaLock.DisableLock(target, 'onboarding_spawn')
	end

	-- Loadbearing trigger: re-call the first-spawn hook so the intro
	-- cinematic kicks off NOW (without waiting for a respawn). If the
	-- player wants the cleanest reset, they can /killplayer to also
	-- restart the character.
	local Onboarding = ServerCore.OnboardingServer
	if Onboarding then
		-- Clear the in-session de-dupe so the first-join welcome popup is
		-- offered again (the flag was wiped above, but the session guard
		-- would otherwise suppress the re-offer until rejoin).
		if Onboarding.ResetJoinGame1 then
			Onboarding.ResetJoinGame1(target)
		end
		if Onboarding.OnFirstCharacterSpawn then
			Onboarding.OnFirstCharacterSpawn(target)
		end
	end

	return string.format('Reset onboarding for %s. Intro will replay.', target.Name)
end
]]></Source>
