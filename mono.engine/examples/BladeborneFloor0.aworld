		<Source path="ServerScriptService/CmdrSetup/Commands/player/StunPlayerServer"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedModules = require(ReplicatedStorage:WaitForChild('Modules'))
local CombatShared = ReplicatedModules.Services.CombatShared

return function(_context, target: Player, duration: number)
	local character = target.Character
	if not character then
		return string.format("%s has no character.", target.Name)
	end
	duration = math.max(0.05, duration or 2)
	CombatShared.StunCharacter(character, duration)
	return string.format("Stunned %s for %.2fs.", target.Name, duration)
end
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/player/WipePlayerData"><![CDATA[--!strict
-- Hard-resets a player's persistent profile to the SavesManager template.
-- Operates by UserId so a player who has already left can still be wiped.
return {
	Name = "WipePlayerData",
	Aliases = { "wipedata", "wipe" },
	Description = "Wipe a UserId's persistent data back to template defaults.",
	Group = "Admin",
	Args = {
		{ Type = "integer", Name = "userId", Description = "Roblox UserId to wipe." },
	},
}
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/player/WipePlayerDataServer"><![CDATA[local ServerStorage = game:GetService("ServerStorage")
local ServerCore = require(ServerStorage:WaitForChild('Core'))

return function(_context, userId: number)
	-- WipeUserId returns (true) on success and (false, errString) when the
	-- profile can't be loaded. We capture both and surface whichever case
	-- applies; pcall wraps any unexpected runtime error as `(false, msg)`.
	local pcallOk, success, errMsg = pcall(ServerCore.DataEditServer.WipeUserId, userId)
	if not pcallOk then
		return string.format("WipeUserId(%d) errored: %s", userId, tostring(success))
	end
	if not success then
		return string.format("WipeUserId(%d) failed: %s", userId, tostring(errMsg or 'profile load failed'))
	end
	return string.format("Wiped persistent data for UserId %d.", userId)
end
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/player/SetDifficulty"><![CDATA[--!strict
return {
	Name = 'SetDifficulty',
	Aliases = { 'difficulty', 'set_difficulty' },
	Description = "Set a player's save difficulty. " ..
		"'hard' surfaces a gold HARD badge next to the HUD name + applies " ..
		"its multiplier set; 'death' surfaces a red DEATH badge + harsher " ..
		"multipliers; 'normal' clears both.",
	Group = 'Admin',
	Args = {
		{ Type = 'player', Name = 'target', Description = 'Target player.' },
		{ Type = 'string', Name = 'kind',   Description = "'normal' | 'hard' | 'death'" },
	},
}
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/player/SetDifficultyServer"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local DifficultyConfig = require(ReplicatedStorage:WaitForChild('Modules')).Data.Difficulty

return function(_context, target: Player, kind: string)
	local lower = string.lower(tostring(kind or ''))
	if not DifficultyConfig.IsValidId(lower) then
		return string.format(
			"Unknown difficulty '%s'. Use 'normal' | 'hard' | 'death'.", tostring(kind))
	end
	local Saves = ServerCore.SavesManagerServer
	if not Saves or not Saves.GetPlayerSelectedSaveData then
		return 'SavesManagerServer unavailable.'
	end
	local data = Saves.GetPlayerSelectedSaveData(target)
	if not data then
		return string.format("No save data for %s.", target.Name)
	end
	-- Persist on the save struct. ReplicatedData replicates the field on
	-- the next flush; OnscreenWidget.UpdateWidget reads it on the next
	-- OnUpdated tick and the badge swaps. Existing wired multipliers
	-- (HP cap, incoming damage, XP) re-resolve at their next call site —
	-- HP scales on the NEXT respawn (no in-place re-scale to avoid an HP
	-- discontinuity on the player's bar), damage + XP take effect
	-- immediately because they re-read on every event.
	data.Difficulty = lower
	local cfg = DifficultyConfig.GetConfigById(lower)
	return string.format('Set difficulty to %s for %s.',
		cfg and cfg.name or lower, target.Name)
end
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/player/SetLevelGateBypass"><![CDATA[--!strict
return {
	Name = 'SetLevelGateBypass',
	Aliases = { 'gatebypass', 'setgatebypass' },
	Description = "Toggle a per-player level-gate bypass for one system, " ..
		"or 'all' to bypass every gate at once. Persists on the save (set " ..
		"once, sticky across rejoins). System values: " ..
		"all | skills | crafting | forge | gems | enchant. Distinct from " ..
		"the server-wide global toggle in SetGlobalLevelGateBypass.",
	Group = 'Admin',
	Args = {
		{ Type = 'player',  Name = 'target',  Description = 'Target player.' },
		{ Type = 'string',  Name = 'system',  Description = "all | skills | crafting | forge | gems | enchant" },
		{ Type = 'boolean', Name = 'enabled', Description = "true → bypass on; false → bypass off." },
	},
}
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/player/SetLevelGateBypassServer"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

return function(_context, target: Player, system: string, enabled: boolean)
	local LevelGatesServer = ServerCore.LevelGatesServer
	if not LevelGatesServer or not LevelGatesServer.IsValidSystemKey then
		return 'LevelGatesServer unavailable.'
	end
	local key = string.lower(tostring(system or ''))
	if not LevelGatesServer.IsValidSystemKey(key) then
		return string.format(
			"Unknown system '%s'. Use one of: %s",
			tostring(system), LevelGatesServer.GetValidKeysList())
	end

	local Saves = ServerCore.SavesManagerServer
	if not Saves or not Saves.GetPlayerSelectedSaveData then
		return 'SavesManagerServer unavailable.'
	end
	local data = Saves.GetPlayerSelectedSaveData(target)
	if not data then
		return string.format("No save data for %s.", target.Name)
	end
	-- Defensive: shape the save Flags + LevelGateBypass into the
	-- canonical table form. Old saves with `LevelGateBypass = bool`
	-- (legacy "all" master) get coerced; reconciler eventually
	-- migrates these on next save load, but this in-memory write
	-- needs to land in the right shape immediately.
	if typeof(data.Flags) ~= 'table' then data.Flags = {} end
	if typeof(data.Flags.LevelGateBypass) ~= 'table' then
		local prev = data.Flags.LevelGateBypass
		data.Flags.LevelGateBypass = {
			all = prev == true,
			skills = false, crafting = false, forge = false,
			gems = false, enchant = false,
		}
	end
	data.Flags.LevelGateBypass[key] = enabled == true

	return string.format(
		"Per-player level-gate bypass[%s] %s for %s.",
		key,
		data.Flags.LevelGateBypass[key] and 'ENABLED' or 'DISABLED',
		target.Name)
end
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/player/SetGlobalLevelGateBypass"><![CDATA[--!strict
return {
	Name = 'SetGlobalLevelGateBypass',
	Aliases = { 'globalgatebypass', 'setglobalgatebypass' },
	Description = "Toggle the SERVER-WIDE level-gate bypass for one system, " ..
		"or 'all' to bypass every gate for every player. While the chosen " ..
		"key is ON, every player on this server skips that system's level " ..
		"gate regardless of their per-player flag. State is in-memory; " ..
		"resets to OFF on next server start. Replicated to clients via the " ..
		"public 'ServerFlags' category, so widget gates honor it within " ..
		"one replication tick. System values: " ..
		"all | skills | crafting | forge | gems | enchant.",
	Group = 'Admin',
	Args = {
		{ Type = 'string',  Name = 'system',  Description = "all | skills | crafting | forge | gems | enchant" },
		{ Type = 'boolean', Name = 'enabled', Description = "true → bypass on for everyone; false → off." },
	},
}
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/player/SetGlobalLevelGateBypassServer"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

return function(_context, system: string, enabled: boolean)
	local LevelGatesServer = ServerCore.LevelGatesServer
	if not LevelGatesServer or not LevelGatesServer.SetGlobalBypass then
		return 'LevelGatesServer unavailable.'
	end
	local key = string.lower(tostring(system or ''))
	if not LevelGatesServer.IsValidSystemKey(key) then
		return string.format(
			"Unknown system '%s'. Use one of: %s",
			tostring(system), LevelGatesServer.GetValidKeysList())
	end

	-- SetGlobalBypass returns true on actual change, false on no-op.
	-- Either way report the resulting state so the operator sees the
	-- live value (covers "I thought I'd already toggled it" cases).
	LevelGatesServer.SetGlobalBypass(key, enabled == true)

	local label = (key == 'all')
		and (enabled and 'ALL gates' or 'gates (master OFF)')
		or string.format('%s gate', key)
	return string.format(
		'Server-wide level-gate bypass[%s] %s.',
		key,
		(enabled == true) and string.format('ENABLED for %s', label)
			or string.format('DISABLED for %s', label))
end
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/player/SetLevelServer"><![CDATA[local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

local ReplicatedStorage = game:GetService('ReplicatedStorage')
local LevelingConfig = require(ReplicatedStorage:WaitForChild('Modules')).Data.Leveling

return function(_context, target: Player, level: number)
	local data = ServerCore.SavesManagerServer.GetPlayerSelectedSaveData(target)
	if not data then
		return string.format('No save data loaded for %s.', target.Name)
	end
	local clamped = math.clamp(math.floor(level), 1, LevelingConfig.MaxLevel)
	data.Level = clamped
	-- Reset XP so the next level threshold reads sensibly on the HUD; an
	-- admin set-level isn't paired with a known XP value.
	data.Experience = 0
	return string.format('Set %s to Lv %d.', target.Name, clamped)
end
]]></Source>
