local ReplicatedStorage = game:GetService('ReplicatedStorage')
require(ReplicatedStorage:WaitForChild('Modules'))
local ServerStorage = game:GetService('ServerStorage')
require(ServerStorage:WaitForChild('Modules'))
require(ServerStorage:WaitForChild('Core'))

local Framework = require(ReplicatedStorage:WaitForChild('Framework'))
Framework.Init()
Framework.Start()
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/debug/PrintData"><![CDATA[--!strict
-- Dump a target player's persistent session data to the server console as
-- a JSON string. Admin-only because it exposes the full record (pets,
-- currency, quests, etc.). The server script calls HttpService:JSONEncode
-- so the output is copy-pastable into any JSON viewer for inspection.
return {
	Name = "PrintData",
	Aliases = { "printdata", "pdata", "dumpdata" },
	Description = "JSON-dump a player's session data to the SERVER console.",
	Group = "Admin",
	Args = {
		{
			Type = "player",
			Name = "target",
			Description = "Player whose session Data to print",
		},
	},
}
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/debug/PrintDataServer"><![CDATA[
local HttpService = game:GetService("HttpService")

local ServerStorage = game:GetService("ServerStorage")
local ServerCore = require(ServerStorage:WaitForChild('Core'))
local ServerModules = require(ServerStorage:WaitForChild("Modules"))

return function(_context, target)
	if typeof(target) ~= "Instance" or not target:IsA("Player") then
		return "Invalid target."
	end

	local DataManagerServer = ServerCore.DataManagerServer
	local profile = DataManagerServer.GetProfileFromPlayer(target)

	if not profile then
		return string.format("%s(%d) does not have their profile loaded.", target.Name, target.UserId)
	end

	local ok, message = pcall(function()
		return HttpService:JSONEncode(profile.Data)
	end)
	if not ok then
		return string.format("JSONEncode failed for %s(%d): %s", target.Name, target.UserId, tostring(message))
	end

	print(string.format("[PrintData] %s(%d) Data = %s", target.Name, target.UserId, message))
	return ("Printed %s(%d)'s data (%d chars) to server console."):format(target.Name, target.UserId, #message)
end
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/debug/SpawnMob"><![CDATA[--!strict
return {
	Name = 'SpawnMob',
	Aliases = { 'spawnmob' },
	Description = "Spawn a mob in front of the executor. Looks up the mob " ..
		"id in Mobs.Mobs; the spawn template is sourced from " ..
		"ServerStorage/EnemyTemplates if the mob has been spawned at " ..
		"least once during this server session, otherwise from any " ..
		"existing tagged AICharacter with a matching AIClass attribute.",
	Group = 'Admin',
	Args = {
		{ Type = 'string',  Name = 'mobId',
		  Description = "Mob class id (e.g. 'Boar', 'BossBoar', 'Generic')." },
		{ Type = 'integer', Name = 'count',
		  Description = "How many to spawn (default 1).",
		  Default = 1 },
	},
}
]]></Source>
		<Source path="ServerScriptService/CmdrSetup/Commands/debug/SpawnMobServer"><![CDATA[local CollectionService = game:GetService('CollectionService')
local ServerStorage = game:GetService('ServerStorage')
local ServerCore = require(ServerStorage:WaitForChild('Core'))

local AI_CHARACTER_TAG = 'AICharacter'

-- Find a template Model for the given mobId. Three sources, in order:
--   1. ServerStorage/EnemyTemplates/<mobId> — set up by EnemyServer
--      when a mob of that id has been initialized at least once.
--   2. Any currently-tagged AICharacter with a matching AIClass
--      attribute — clone that.
--   3. nil — caller reports failure.
local function findTemplate(mobId: string): Model?
	local templates = ServerStorage:FindFirstChild('EnemyTemplates')
	if templates then
		-- EnemyServer stores templates by their original Name, not by
		-- AIClass. Walk and match on either.
		for _, child in templates:GetChildren() do
			if child:IsA('Model') and (child.Name == mobId or child:GetAttribute('AIClass') == mobId) then
				return child
			end
		end
	end
	for _, model in CollectionService:GetTagged(AI_CHARACTER_TAG) do
		if model:IsA('Model') and model:GetAttribute('AIClass') == mobId then
			return model
		end
	end
	return nil
end

return function(context, mobId: string, count: number)
	local executor = context.Executor
	local character = executor and executor.Character
	if not character then return 'Executor has no character.' end
	local hrp = character:FindFirstChild('HumanoidRootPart')
	if not hrp then return 'Executor has no HumanoidRootPart.' end

	local template = findTemplate(mobId)
	if not template then
		return string.format(
			"No template for '%s'. Spawn one of this mob in studio first " ..
			"so EnemyServer registers a template, or place a tagged " ..
			"AICharacter with AIClass=%s in workspace.", mobId, mobId)
	end

	local n = math.max(1, math.min(count or 1, 16))
	local spawnCF = hrp.CFrame * CFrame.new(0, 0, -10)
	local spread = math.min(2 + n, 12)
	for i = 1, n do
		template.Archivable = true
		local clone = template:Clone()
		template.Archivable = false
		-- Spread copies along a small arc so they don't pile up.
		local angle = (i - 1) / math.max(1, n - 1) * math.pi
		local off = Vector3.new(math.cos(angle) * spread, 0, math.sin(angle) * 0.5)
		clone:PivotTo(spawnCF + off)
		-- Re-tag (templates are stored untagged in EnemyTemplates so
		-- their existence doesn't trigger another InitializeMob).
		if not clone:HasTag(AI_CHARACTER_TAG) then
			clone:AddTag(AI_CHARACTER_TAG)
		end
		clone.Parent = workspace
	end
	return string.format("Spawned %d × %s.", n, mobId)
end
]]></Source>
