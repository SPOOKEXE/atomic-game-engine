		Workstation = 'CookingPot',
	},

} :: { [string]: RecipeConfig }

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Dialogue.luau"><![CDATA[--[[
	ability to:
	- cutscene
	- audio/visual/camera effect
	- run quest event (Talk/Interact)
	- viewport & icon image
	- rich text
	- dialogue actions (DelaySeconds, MultiOption, StartNewDialogueId)
	- cinematic cues per line (camera pan, shake, sfx, vfx, label) —
	  authored via the optional `cues` arg on BuildDialogueDisplay
	  (5th positional). Cues share the same shape as Cinematics.luau
	  (CinematicShared.CueKind + Args). DialogueWidget walks them at
	  line-show time and dispatches via CinematicClient.PlayCue, so
	  inline dramatic beats don't need to be authored as standalone
	  cinematics. See DialogueCues.* helpers below.
]]

-- // Internal // --
local function BuildDialogueDisplay( textData, iconData, cutsceneId, visualEffectsArray, cues, autoAdvance )
	return {
		Text = textData,
		Icon = iconData,
		cutsceneId = cutsceneId,
		visualEffectsArray = visualEffectsArray,
		Cues = cues,
		-- Optional seconds-to-auto-advance. When set, DialogueWidget
		-- schedules a timer that advances on the FIRST option after
		-- this many seconds. Cancelled if the user clicks an option
		-- or the dialogue closes early.
		AutoAdvance = autoAdvance,
	}
end

-- Convenience constructors for common cinematic cue shapes used inside
-- dialogue. Each returns a single cue table; compose into a `cues` array
-- on a node's Display via BuildDialogueDisplay's 5th argument.
local DialogueCues = {}

function DialogueCues.CameraTo(at: number, instancePath: string?, position: CFrame?, lerp: number?)
	if instancePath then
		return { At = at, Kind = 'CameraTo', Args = {
			Anchor = 'instance', InstancePath = instancePath, Lerp = lerp or 0.6,
		}}
	end
	return { At = at, Kind = 'CameraTo', Args = {
		Anchor = 'world', Position = position, Lerp = lerp or 0.6,
	}}
end

function DialogueCues.Shake(at: number, magnitude: number, duration: number)
	return { At = at, Kind = 'CameraShake', Args = {
		Magnitude = magnitude, Duration = duration, FadeIn = 0.05, FadeOut = duration * 0.5,
	}}
end

function DialogueCues.SFX(at: number, sound: string | number, pitch: number?)
	return { At = at, Kind = 'PlaySFX', Args = { Sound = sound, Pitch = pitch }}
end

function DialogueCues.Reset(at: number)
	return { At = at, Kind = 'CameraReset', Args = {} }
end

local function BuildDialogueTextData( TitleText, TitleCol, DescText, DescCol )
	TitleCol = TitleCol or Color3.new(1,1,1)
	DescCol = DescCol or Color3.new(1,1,1)
	return { Title = { Text = TitleText, TextColor3 = TitleCol }, Description = { Text = DescText, TextColor3 = DescCol } }
end

local function BuildOptionDisplayData( Text, TextColor3 )
	TextColor3 = TextColor3 or Color3.new(1,1,1)
	return { Label = { Text = Text, TextColor3 = TextColor3 } }
end

-- // Dialogue Builder // --
local DialogueBuilder = {}

function DialogueBuilder.MultiOption( optionDisplayData, ... )
	return { Type = 'MultiOption', Display = optionDisplayData, Options = { ... }, }
end

function DialogueBuilder.YesNoOption( displayData, yesDialogue, noDialogue )
	return DialogueBuilder.MultiOption( displayData, {
		Display = BuildOptionDisplayData('Yes'),
		Options = yesDialogue,
	}, {
		Display = BuildOptionDisplayData('No'),
		Options = noDialogue,
	})
end

function DialogueBuilder.MultipleActions( actionsArray, delayPeriod )
	return { Type = "Action", Actions = actionsArray, Delay = delayPeriod }
end

function DialogueBuilder.SingleAction( action, delayPeriod )
	return DialogueBuilder.MultipleActions( {action}, delayPeriod )
end

function DialogueBuilder.ConditionalCheck( conditionFunction, ifTrue, ifFalse )
	return { Type = "Conditional", Condition = conditionFunction, True = ifTrue, False = ifFalse }
end

function DialogueBuilder.ExitDialogue()
	return { Type = "Exit" }
end

function DialogueBuilder.BuildExitButton()
	return {
		Display = BuildOptionDisplayData('Exit'),
		Options = DialogueBuilder.ExitDialogue(),
	}
end

-- Two calling conventions, picked by the type of the first arg:
--   (titleStr, descriptionStr, afterNode) -- builds a default Display
--      from raw strings (no cues / no icon overrides).
--   (displayTable, afterNode)             -- uses the caller's prebuilt
--      Display (output of BuildDialogueDisplay) so authors can attach
--      per-line cues / icon / cutscene without re-wrapping.
-- Both produce a MultiOption with a single '...' continue button that
-- advances to `afterNode`.
function DialogueBuilder.DisplayTextContent( titleOrDisplay, descriptionOrAfter, after )
	local display, nextNode
	if typeof(titleOrDisplay) == 'table' then
		display, nextNode = titleOrDisplay, descriptionOrAfter
	else
		display = BuildDialogueDisplay(
			BuildDialogueTextData(titleOrDisplay, false, descriptionOrAfter, false),
			"rbxassetid://-1", false, false
		)
		nextNode = after
	end
	-- Defensive unwrap: when authors mistakenly pass `BuildExitButton()`
	-- (an option-entry: `{Display, Options=ExitDialogue()}`) instead of
	-- `ExitDialogue()` itself, fold the entry's Options up into the
	-- nextNode slot. Without this, the Continue button advances into a
	-- "node" that's actually shape `{Display, Options}` — DialogueWidget
	-- then iterates that pseudo-node's Options (which is the Exit
	-- table `{Type='Exit'}`) as if it were an option array, and the
	-- string key `'Type'` crashes the option-button's `%d` format.
	if typeof(nextNode) == 'table'
		and nextNode.Display ~= nil and nextNode.Options ~= nil
		and nextNode.Type == nil then
		nextNode = nextNode.Options
	end
	return DialogueBuilder.MultiOption(display, {
		Display = BuildOptionDisplayData('Continue'),
		Options = nextNode,
	})
end

-- // Module // --
local Module = {}

Module.DialogueBuilder = DialogueBuilder
Module.DialogueCues = DialogueCues

Module.DialogueEnums = {
	OpenDialogue = 1,
	CloseDialogue = 2,

	StartedDialogue = 3,
	SteppedDialogue = 4,
	EndedDialogue = 5,
}

Module.Dialogue = {

	TestDialogue1 = {
		Tree = DialogueBuilder.YesNoOption(
			BuildDialogueDisplay(
				BuildDialogueTextData("Yes-No", false, "Yes for action, no to close", false),
				"rbxassetid://-1",
				false,
				false
			),
			DialogueBuilder.SingleAction( "START_QUEST:TestQuestLine2", 0 ),
			DialogueBuilder.ExitDialogue()
		),
	},

	-- // Onboarding Tutor //
	-- The starter NPC at spawn. Conversation explains the trapped-in-
	-- game premise + the Floor-100 quest, then on exit fires the
	-- 'tutor_intro_complete' DialogueAction that OnboardingServer
	-- consumes to advance the player past the meet_tutor step.
	-- Per-line cinematic cues lean on subtle shake + soft sfx so the
	-- conversation reads as story-weighted.
	Tutor_Onboarding = {
		Tree = DialogueBuilder.DisplayTextContent(
			BuildDialogueDisplay(
				BuildDialogueTextData(
					'The Tutor',
					Color3.fromRGB(126, 200, 255),
					"You're awake. Good. Listen — you're inside Bladeborne now. The way out runs through Floor 100.",
					Color3.fromRGB(220, 220, 230)
				),
				'rbxassetid://-1',
				false,
				false,
				{
					DialogueCues.Shake(0.0, 0.10, 0.40),
					DialogueCues.SFX(0.05, 'rbxassetid://9114015882', 0.85),
				}
			),
			DialogueBuilder.DisplayTextContent(
				BuildDialogueDisplay(
					BuildDialogueTextData(
						'The Tutor',
						false,
						"A hundred floors. A hundred bosses. The last one keeps the gate. Beat it and the gate opens. That's the contract.",
						false
					),
					'rbxassetid://-1', false, false,
					{ DialogueCues.Shake(0.0, 0.08, 0.30) }
				),
				DialogueBuilder.DisplayTextContent(
					BuildDialogueDisplay(
						BuildDialogueTextData(
							'The Tutor',
							false,
							"Practice with what you have. Forge real weapons. Take a companion. The first floor's the easiest — don't waste it.",
							false
						),
						'rbxassetid://-1', false, false,
						{ DialogueCues.Shake(0.0, 0.06, 0.25) }
					),
					DialogueBuilder.MultiOption(
						BuildDialogueDisplay(
							BuildDialogueTextData(
								'The Tutor',
								false,
								"Go on. Door's that way.",
								false
							),
							'rbxassetid://-1', false, false
						),
						{
							Display = BuildOptionDisplayData("I'll be back."),
							-- Single-action: tells OnboardingServer to advance
							-- past the 'meet_tutor' step.
							Options = DialogueBuilder.SingleAction('tutor_intro_complete', 0),
						}
					)
				)
			)
		),
	},

	-- Tag-driven test NPC. Spawns when a model in workspace is
	-- tagged 'DialogueNPC' with attribute DialogueId='TestNPC_Greeting'
	-- (see ServerStorage/Core/DialogueNPCServer). Tree exercises every
	-- node type:
	--   * MultiOption with three branches
	--   * Conditional gate on player level (Level >= 3 unlocks an option)
	--   * Action node (DialogueAction → server)
	--   * Per-line cinematic cues (camera shot + shake + sfx)
	-- Designed for the F4 test widget's "TestNPC_Greeting" button so
	-- you can step through every branch without touching server code.
	TestNPC_Greeting = {
		Tree = DialogueBuilder.MultiOption(
			BuildDialogueDisplay(
				BuildDialogueTextData(
					'Cinematic Tester',
					Color3.fromRGB(220, 220, 230),
					'Pick a beat to test. Each path exercises a different cinematic feature.',
					Color3.fromRGB(180, 180, 195)
				),
				'rbxassetid://-1',
				false,
				false,
				{
					-- On line-show: subtle shake + soft over-shoulder lock.
					-- Cues fire at-most-once per node visit (see DialogueWidget).
					DialogueCues.Shake(0.0, 0.10, 0.45),
					DialogueCues.SFX(0.0, 'rbxassetid://9114015882', 0.85),
				}
			),
			-- Branch 1 — chained scene with shake + camera moves.
			{
				Display = BuildOptionDisplayData('Show me the heavy shake'),
				Options = DialogueBuilder.DisplayTextContent(
					BuildDialogueDisplay(
						BuildDialogueTextData(
							'Cinematic Tester',
							false,
							'Hold on to your head — heavy shake incoming.',
							false
						),
						'rbxassetid://-1',
						false,
						false,
						{
							DialogueCues.Shake(0.0, 0.55, 0.50),
							DialogueCues.SFX(0.05, 'rbxassetid://9114015882', 0.6),
						}
					),
					DialogueBuilder.BuildExitButton()
				),
			},
			-- Branch 2 — conditional gate. Players under level 3 hit a
			-- block-message; level-3+ players get an action that fires
			-- the 'cinematic_test_action' string to the server.
			{
				Display = BuildOptionDisplayData('Run the test action (Level 3+)'),
				Options = DialogueBuilder.ConditionalCheck(
					function(_LocalPlayer, PlayerData)
						return PlayerData and (PlayerData.Level or 1) >= 3
					end,
					DialogueBuilder.SingleAction('cinematic_test_action', 0),
					DialogueBuilder.DisplayTextContent(
						BuildDialogueDisplay(
							BuildDialogueTextData(
								'Cinematic Tester',
								false,
								'Need to be at least Level 3 to fire that action.',
								false
							),
							'rbxassetid://-1', false, false,
							{ DialogueCues.Shake(0.0, 0.20, 0.30) }
						),
						DialogueBuilder.BuildExitButton()
					)
				),
			},
			-- Branch 3 — straight exit, no fanfare.
			{
				Display = BuildOptionDisplayData('Goodbye'),
				Options = DialogueBuilder.ExitDialogue(),
			}
		),
	},

	TestDialogue2 = {
		Tree = DialogueBuilder.ConditionalCheck(
			function(LocalPlayer, PlayerData, dialogueId)
				return table.find( PlayerData.CompletedQuests, dialogueId)
			end,
			DialogueBuilder.DisplayTextContent(
				'Billy',
				'You have already completed my tasks!',
				DialogueBuilder.ExitDialogue()
			),
			DialogueBuilder.ConditionalCheck(
				function(LocalPlayer, PlayerData, dialogueId)
					return PlayerData.ActiveQuests[ dialogueId ]
				end,
				DialogueBuilder.DisplayTextContent(
					BuildDialogueDisplay(
						BuildDialogueTextData( "Billy", false, "Ya haven't completed the tasks yet.", false ),
						"rbxassetid://-1",
						false,
						false
					),
					DialogueBuilder.BuildExitButton()
				), -- they are currently busy with the quest
				DialogueBuilder.YesNoOption(
					BuildDialogueDisplay(
						BuildDialogueTextData( "Billy", false, "Start the level 3 quest?", false ),
						"rbxassetid://-1",
						false,
						false
					),
					DialogueBuilder.ConditionalCheck(
						function(LocalPlayer, PlayerData)
							return PlayerData and PlayerData.Level >= 3
						end,
						DialogueBuilder.SingleAction( "start_billy_quest", 0 ),
						DialogueBuilder.MultiOption(
							BuildDialogueDisplay(
								BuildDialogueTextData( "Billy", false, "You must be level 3 at minimum.", false ),
								"rbxassetid://-1",
								false,
								false
							),
							DialogueBuilder.BuildExitButton()
						)
					),
					DialogueBuilder.ExitDialogue()
				) -- they have not started the quest
			)
		),
	},

}

function Module.GetDialogueFromId( dialogueId )
	return Module.Dialogue[ dialogueId ]
end

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Difficulty.luau"><![CDATA[-- Difficulty registry. Mirrors menu/src/.../Difficulty.luau with the same
-- ids, names, accent colors, blurbs, and human-readable effect lists so
-- the menu's selection screen and the in-game systems agree on the
-- canonical set. Server stores a per-save `Difficulty = 'normal' | 'hard'
-- | 'death'` (lowercase id) on PlayerData; runtime consumers look up
-- numeric multipliers via `Module.GetMultipliers(id)`.
--
-- Numeric multipliers (added here on top of the menu shape) are the
-- runtime hooks. Wired sites:
--   * HealthMul        → GameControllerServer.OnCharacterAdded
--   * IncomingDamageMul → DamageModule.DamageHumanoid (player victims)
--   * ExperienceMul    → DataEditServer.GiveExperienceToPlayer
-- Permadeath + auction / trading / party gates listed in `effects` are
-- intentionally NOT wired — those features aren't implemented yet, and
-- the field is kept for menu copy-and-paste so the eventual hook reads
-- the same config the menu surfaced.

local Module = {}

Module.Indexes = {
	Normal = 1,
	Hard   = 2,
	Death  = 3,
}

export type DifficultyMultipliers = {
	-- 1.0 = unchanged. Multiplied into Humanoid.MaxHealth at character spawn.
	HealthMul: number,
	-- 1.0 = unchanged. Multiplied into incoming damage AFTER passive
	-- mitigations so a player on HARD takes 10% more damage than NORMAL.
	IncomingDamageMul: number,
	-- 1.0 = unchanged. Multiplied into amount in
	-- DataEditServer.GiveExperienceToPlayer (after Insight bonus).
	ExperienceMul: number,
	-- Reserved — Luck system not yet implemented; field kept for the eventual
	-- LootTableServer hook so the config doesn't need a second pass later.
	LuckMul: number,
}

export type DifficultyConfig = {
	id: string,
	name: string,
	index: number,
	accent: Color3,
	blurb: string,
	effects: {string},
	Multipliers: DifficultyMultipliers,
}

Module.Configs = {
	[1] = {
		id = 'normal',
		name = 'Normal',
		index = 1,
		accent = Color3.fromRGB(126, 200, 255),
		blurb = 'Standard balance',
		effects = {
			'Standard',
		},
		Multipliers = {
			HealthMul = 1.0, IncomingDamageMul = 1.0,
			ExperienceMul = 1.0, LuckMul = 1.0,
		},
	},
	[2] = {
		id = 'hard',
		name = 'Hard',
		index = 2,
		accent = Color3.fromRGB(255, 183, 90),
		blurb = '+10% EXP · -10% Def / HP',
		effects = {
			'+10% Experience',
			'+10% Luck',
			'-10% Defense',
			'-10% Health',
			'No auction house',
			'No trading',
			'No partying with Normal players',
		},
		Multipliers = {
			HealthMul = 0.90, IncomingDamageMul = 1.10,
			ExperienceMul = 1.10, LuckMul = 1.10,
		},
	},
	[3] = {
		id = 'death',
		name = 'Death',
		index = 3,
		accent = Color3.fromRGB(255, 93, 109),
		blurb = 'Permadeath · +25% EXP · -25% All',
		effects = {
			'Permadeath',
			'+25% Experience',
			'+25% Luck',
			'-25% Defense',
			'-25% Health',
			'No auction house',
			'No trading',
			'No partying at all',
			'Solo dungeons',
		},
		Multipliers = {
			HealthMul = 0.75, IncomingDamageMul = 1.25,
			ExperienceMul = 1.25, LuckMul = 1.25,
		},
	},
} :: {[number]: DifficultyConfig}

----------------------------------------------------------------------
-- Lookups. By-id is the runtime workhorse — `data.Difficulty` is the
-- string id; consumers grab the config + multipliers off it.
----------------------------------------------------------------------
local IdToConfig: { [string]: DifficultyConfig } = {}
for _, cfg in Module.Configs do
	IdToConfig[cfg.id] = cfg
end

function Module.IsValidIndex(index: number?): boolean
	return typeof(index) == 'number' and Module.Configs[index] ~= nil
end

function Module.IsValidId(id: any): boolean
	return typeof(id) == 'string' and IdToConfig[id] ~= nil
end

function Module.GetConfigByIndex(index: number): DifficultyConfig?
	return Module.Configs[index]
end

function Module.GetConfigById(id: string): DifficultyConfig?
	return IdToConfig[id]
end

function Module.GetOrderedConfigs(): {DifficultyConfig}
	return { Module.Configs[1], Module.Configs[2], Module.Configs[3] }
end

-- Resolve multipliers for an id with a defensive fallback. Unknown /
-- missing ids resolve to NORMAL so a corrupt save can't accidentally
-- buff or nerf the player into oblivion.
local NORMAL_MULTIPLIERS: DifficultyMultipliers = Module.Configs[1].Multipliers
function Module.GetMultipliers(id: string?): DifficultyMultipliers
	if typeof(id) ~= 'string' then return NORMAL_MULTIPLIERS end
	local cfg = IdToConfig[id]
	if not cfg then return NORMAL_MULTIPLIERS end
	return cfg.Multipliers
end

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/DifficultyScaling.luau"><![CDATA[-- Per-floor mob difficulty scaling. Single source of truth for how mob
-- HP and outbound damage scale as the player progresses through floors.
-- EnemyServer.InitializeMob reads this registry on every spawn and
-- applies the multipliers to the live Humanoid + a `DamageMul` model
-- attribute that the NPC swing path multiplies into outgoing damage.
--
-- Authoring conventions:
--   * Floors are integers (0-indexed). 0 is the starter floor; higher
--     floors crank up tougher mobs.
--   * HealthMul scales Humanoid.MaxHealth (and the new Health on spawn).
--   * DamageMul scales every NPCCombatServer / Boar-style outbound
--     damage hit. Player-side incoming-damage mitigation (Toughness,
--     defender passives) still applies after the scale, so a 2× damage
--     mob doesn't bypass the player's defenses.
--   * Multipliers default to 1.0 (no scaling) when a floor isn't listed.
--   * To opt a specific mob OUT of scaling, set
--     `Mobs.<mobId>.IgnoreDifficulty = true` on the mob config — useful
--     for invulnerable cinematic NPCs and dummy targets that shouldn't
--     change with floor.
--
-- Resolving the floor for a spawned mob:
--   1. Model attribute `Floor` on the mob model (set by mob spawners /
--      Studio placement) — explicit, wins over everything.
--   2. Floor inferred from the model's ancestor (any ancestor with a
--      `Floor` attribute is treated as the mob's floor).
--   3. Default floor 0 → Multiplier 1.0 baseline.

local Module = {}

----------------------------------------------------------------------
-- Per-floor curves. Health scales faster than damage so mobs feel
-- spongier the deeper a player descends, but a single Floor-1 hit
-- isn't an instant death from a Floor-50 mob (which would be
-- frustrating in the cross-floor lobby cases).
--
-- These are starting numbers — tune live by tweaking this table; no
-- runtime restart needed (registry is required once but the call site
-- reads it on each spawn).
----------------------------------------------------------------------
Module.PerFloor = {
	[0]   = { HealthMul = 1.00, DamageMul = 1.00 },
	[1]   = { HealthMul = 1.10, DamageMul = 1.05 },
	[2]   = { HealthMul = 1.25, DamageMul = 1.10 },
	[3]   = { HealthMul = 1.45, DamageMul = 1.18 },
	[4]   = { HealthMul = 1.70, DamageMul = 1.28 },
	[5]   = { HealthMul = 2.00, DamageMul = 1.40 },
	[10]  = { HealthMul = 3.50, DamageMul = 1.90 },
	[20]  = { HealthMul = 6.00, DamageMul = 2.60 },
	[50]  = { HealthMul = 14.0, DamageMul = 4.50 },
	[100] = { HealthMul = 30.0, DamageMul = 8.00 },
} :: { [number]: { HealthMul: number, DamageMul: number } }

----------------------------------------------------------------------
-- Resolver. Walks the configured floors in descending order and picks
-- the highest one ≤ floor — i.e. floor 7 with rows at 5 and 10 picks
-- 5's multipliers. This avoids the per-floor authoring grind: only
-- tune the breakpoints you care about.
----------------------------------------------------------------------
function Module.GetFloorMultipliers(floor: number): { HealthMul: number, DamageMul: number }
	if typeof(floor) ~= 'number' then
		return { HealthMul = 1.0, DamageMul = 1.0 }
	end
	-- Exact match first — cheaper than the descending walk for the
	-- common case of a configured floor.
	local exact = Module.PerFloor[floor]
	if exact then return exact end
	-- Find highest configured floor ≤ floor.
	local bestFloor: number? = nil
	for f in Module.PerFloor do
		if f <= floor and (bestFloor == nil or f > bestFloor) then
			bestFloor = f
		end
	end
	if bestFloor == nil then
		return { HealthMul = 1.0, DamageMul = 1.0 }
	end
	return Module.PerFloor[bestFloor]
end

----------------------------------------------------------------------
-- Floor lookup helper. Reads the mob model's `Floor` attribute, then
-- walks ancestors looking for the same attribute. Returns 0 (the
-- baseline / no-scaling floor) when no attribute is found anywhere
-- in the lineage. Server-only callers can pass any Instance.
----------------------------------------------------------------------
function Module.ResolveFloorForInstance(instance: Instance): number
	if not instance then return 0 end
	local cur: Instance? = instance
	while cur do
		local v = cur:GetAttribute('Floor')
		if typeof(v) == 'number' then return v end
		cur = cur.Parent
	end
	return 0
end

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Discovery.luau"><![CDATA[
export type DiscoveryDisplayConfig = {
	Name: string,
}

local Module = {}

Module.DiscoveryDisplayInfo = {
	F1_TowerEntry = {
		Name = 'Floor 1 Tower Entrance'
	},
} :: {[string]: DiscoveryDisplayConfig}

Module.DiscoverableRegions = {'F1_ToB', 'F1_TowerEntry'}

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Enchants.luau"><![CDATA[-- Enchant catalog — see ARTISAN.md §4.
-- Each enchant has a tier (rarity-equivalent for the UI), a school
-- (filter group), a per-level cost array, and optional Conflict /
-- Prereq lists for cross-enchant rules.
--
-- Conflict semantics: if any enchant in `Conflict` is applied to the
-- same item, this enchant cannot be applied (and vice versa).
-- Prereq semantics: this enchant requires `Prereq.Id` to already be
-- on the item at level ≥ `Prereq.Level`.

export type EnchantPrereq = { Id: string, Level: number }

export type Enchant = {
	Id: string,
	Name: string,
	Tier: string,                   -- 'common' | 'uncommon' | 'rare' | 'epic' | 'mythic'
	School: string,                 -- 'Edge' | 'Faith' | 'Ward' | 'Pyre' | ...
	MaxLevel: number,
	Cost: { number },               -- Cost[level] = cost in enchant currency at that level
	Color: Color3,
	-- Format string for the player-facing effect line; descMult is the
	-- per-level scalar substituted into the format. e.g. '+%d%% melee
	-- DMG.' with descMult = 8 → '+24% melee DMG.' at level 3.
	DescriptionFormat: string,
	DescriptionMultiplier: number,
	Conflict: { string }?,          -- enchant ids that exclude this one
	Prereq: EnchantPrereq?,         -- required enchant + level on the same item
	-- Required Enchanting artisan level. Gates higher-tier enchants
	-- behind Enchanting progression — without this, a Lv 1 player
	-- could mythic-enchant a starter sword. Defaults via the
	-- Tier→RequiredLevel ladder when unset (TIER_LEVEL_GATE below).
	RequiredLevel: number?,
}

-- Default Enchanting-school level requirements per tier. Used as
-- fallback when an enchant cfg doesn't carry an explicit
-- RequiredLevel — keeps the catalog terse while still gating.
local TIER_LEVEL_GATE = {
	common   = 1,
	uncommon = 10,
	rare     = 20,
	epic     = 40,
	mythic   = 70,
}

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

local Module = {}

Module.Enchants = {
	-- // Common //
	sharpness = {
		Id='sharpness', Name='Sharpness', Tier='common', School='Edge',
		MaxLevel=5, Cost={5,12,22,36,54}, Color=rgb(126,200,255),
		DescriptionFormat='+%d%% melee DMG.', DescriptionMultiplier=8,
		Conflict={'smite'},
	},
	smite = {
		Id='smite', Name='Smite', Tier='common', School='Faith',
		MaxLevel=5, Cost={5,12,22,36,54}, Color=rgb(255,216,112),
		DescriptionFormat='+%d%% DMG vs Undead.', DescriptionMultiplier=12,
		Conflict={'sharpness'},
	},
	unbreaking = {
		Id='unbreaking', Name='Unbreaking', Tier='common', School='Ward',
		MaxLevel=3, Cost={8,16,28}, Color=rgb(180,228,255),
		DescriptionFormat='+%d%% effective DUR.', DescriptionMultiplier=30,
	},
	-- // Uncommon //
	fire_aspect = {
		Id='fire_aspect', Name='Fire Aspect', Tier='uncommon', School='Pyre',
		MaxLevel=3, Cost={14,26,40}, Color=rgb(255,128,64),
		DescriptionFormat='Ignite on hit (%ds).', DescriptionMultiplier=2,
	},
	frost = {
		Id='frost', Name='Frost Aspect', Tier='uncommon', School='Frost',
		MaxLevel=3, Cost={14,26,40}, Color=rgb(80,128,255),
		DescriptionFormat='On hit: slow %d%% (3s).', DescriptionMultiplier=15,
	},
	looting = {
		Id='looting', Name='Looting', Tier='uncommon', School='Wyrd',
		MaxLevel=3, Cost={18,32,48}, Color=rgb(106,227,168),
		DescriptionFormat='+%d%% rare drop chance.', DescriptionMultiplier=15,
	},
	-- // Rare //
	keen_edge = {
		Id='keen_edge', Name='Keen Edge', Tier='rare', School='Edge',
		MaxLevel=5, Cost={22,38,58,82,110}, Color=rgb(200,157,255),
		DescriptionFormat='+%d%% CRIT chance.', DescriptionMultiplier=5,
	},
	vorpal = {
		Id='vorpal', Name='Vorpal', Tier='rare', School='Edge',
		MaxLevel=3, Cost={40,72,108}, Color=rgb(200,157,255),
		DescriptionFormat='Ignore %d%% armor.', DescriptionMultiplier=8,
		Prereq={Id='sharpness', Level=3},
	},
	lifesteal = {
		Id='lifesteal', Name='Siphon', Tier='rare', School='Bone',
		MaxLevel=4, Cost={34,60,90,128}, Color=rgb(255,109,144),
		DescriptionFormat='Heal %d%% of DMG dealt.', DescriptionMultiplier=2,
	},
	-- // Epic //
	bleed = {
		Id='bleed', Name='Bleed', Tier='epic', School='Bone',
		MaxLevel=5, Cost={60,90,130,180,240}, Color=rgb(200,157,255),
		DescriptionFormat='Bleed: %d DMG/s (4s).', DescriptionMultiplier=60,
		Prereq={Id='lifesteal', Level=2},
	},
	executioner = {
		Id='executioner', Name='Executioner', Tier='epic', School='Bone',
		MaxLevel=3, Cost={80,140,220}, Color=rgb(255,93,109),
		DescriptionFormat='+%d%% DMG below 30%% HP.', DescriptionMultiplier=20,
	},
	-- // Mythic //
	starforge = {
		Id='starforge', Name='Starforge', Tier='mythic', School='Astra',
		MaxLevel=1, Cost={400}, Color=rgb(255,208,96),
		DescriptionFormat='Every 16th strike: meteor (%d dmg).',
		DescriptionMultiplier=4000,
		Prereq={Id='keen_edge', Level=5},
	},
} :: { [string]: Enchant }

-- Tier color palette (for UI badge tints). Kept here so the catalog +
-- tier visuals stay co-located.
Module.TierColors = {
	common   = rgb(154,166,184),
	uncommon = rgb(106,227,168),
	rare     = rgb(126,200,255),
	epic     = rgb(200,157,255),
	mythic   = rgb(255,198,112),
}

-- Re-export the Tier→RequiredLevel ladder so EnchantShared can read
-- it without re-deriving the table. Authors override per-enchant via
-- the explicit RequiredLevel field on a cfg entry.
Module.TierLevelGate = TIER_LEVEL_GATE

-- Map Tier name → numeric (1..6) so essence-cost / rarity-essence
-- routing can match against the same enum the rest of the project
-- uses. mythic intentionally maps to 6 so it aligns with the Rarities
-- enum's mythic = 6 entry.
Module.TierEnum = {
	common = 1, uncommon = 2, rare = 3, epic = 4, mythic = 6,
}

function Module.GetRequiredLevel(enchantId: string): number
	local cfg = Module.Enchants[enchantId]
	if not cfg then return 1 end
	if cfg.RequiredLevel then return cfg.RequiredLevel end
	return TIER_LEVEL_GATE[cfg.Tier] or 1
end

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/FFlags.luau"><![CDATA[-- Feature-flag (FFlag) definitions. FFlags are one-shot, per-save named
-- switches tracking "this milestone happened once" state — persisted under
-- data.FFlags and read/written through FFlagsServer (GetFFlags / SetFFlag).
--
-- This is intentionally separate from the step-by-step onboarding tutorial
-- (Data.Onboarding): that config drives an ordered, resumable flow; these
-- are independent booleans (or small values) that any system can gate on.
--
-- Reference the Flags constants below rather than the raw id strings so a
-- rename is a single-site change.

local Module = {}

----------------------------------------------------------------------
-- Canonical flag ids.
----------------------------------------------------------------------
Module.Flags = {
	-- First-time welcome modal. Set when the player clicks FINISH on the
	-- JoinGameWelcomeWidget; while unset the popup is (re)offered on join.
	JoinGame1 = 'ONBOARDING_JOIN_GAME_1',
}

----------------------------------------------------------------------
-- Flag-adjacent config.
----------------------------------------------------------------------
-- Quest auto-granted alongside the JoinGame1 welcome popup. Designers can
-- repoint this at the real starter quest line once it lands; today it
-- grants the existing intro-tier quest. Granting is idempotent server-side
-- (skipped if the player already holds the quest).
Module.JoinGame1QuestId = 'TestQuestLine1'

return Module
]]></Source>
		<Source path="src/ReplicatedStorage/Modules/Data/Gems.luau"><![CDATA[-- Gem catalog — see ARTISAN.md §4.
-- Each entry is a fully-specified (gem, cut) combination — the cut is
-- baked into the Id rather than a separate field on the inventory item.
-- This keeps stat math flat (no runtime composition of gem × cut), and
-- makes the catalog browser show every available gem variant at a
-- glance.
--
-- ItemConfig.GemId points to entries here.

export type Gem = {
	Id: string,                     -- e.g. 'ruby_pristine'
	Name: string,                   -- player-facing
	Cut: string,                    -- 'chipped' / 'flawed' / 'standard' / 'flawless' / 'pristine'
	Rarity: string,                 -- 'common' / 'uncommon' / 'rare' / 'epic' / 'mythic'
	Color: Color3,
	-- Color taxonomy for socket-color matching + resonance detection.
	-- Distinct from Color3 (which is the visual tint).
	ColorClass: string,             -- 'red' / 'blue' / 'green' / 'gold' / 'purple' / 'white' / 'black'
	Shape: string,                  -- catalog flavor; not gameplay-effective in v1
	-- Player-facing stat description. Numerical effects are encoded in
	-- the gem's StatBonus formula (added in Stage D combat integration).
	Stat: string,
	-- Required Gemcutting artisan level to socket this gem. Falls
	-- through to the Rarity→Level ladder below when unset.
	RequiredLevel: number?,
}

-- Default Gemcutting level requirements per gem rarity. Same ladder
-- shape Enchants uses; tuned slightly later (gems are post-forge,
-- so the average player engages with them after hitting moderate
-- artisan levels).
local RARITY_LEVEL_GATE = {
	common   = 1,
	uncommon = 8,
	rare     = 18,
	epic     = 35,
	mythic   = 60,
}

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

local Module = {}

Module.Gems = {
	ruby_pristine = {
		Id='ruby_pristine', Name='Ruby of Ruin', Cut='pristine', Rarity='epic',
		Color=rgb(255,80,104), ColorClass='red', Shape='octagon',
		Stat='+12% Fire DMG · ignite stacks x2',
	},
	sapphire_flawless = {
		Id='sapphire_flawless', Name='Sapphire Tear', Cut='flawless', Rarity='rare',
		Color=rgb(80,128,255), ColorClass='blue', Shape='pear',
		Stat='+80 Mana on crit',
	},
	emerald_flawless = {
		Id='emerald_flawless', Name='Emerald Shard', Cut='flawless', Rarity='rare',
		Color=rgb(80,224,128), ColorClass='green', Shape='marquise',
		Stat='+3% lifesteal',
	},
	topaz_standard = {
		Id='topaz_standard', Name='Topaz Spark', Cut='standard', Rarity='uncommon',
		Color=rgb(255,192,64), ColorClass='gold', Shape='square',
		Stat='+8% rare drop',
	},
	amethyst_standard = {
		Id='amethyst_standard', Name='Amethyst Whisper', Cut='standard', Rarity='uncommon',
		Color=rgb(176,112,224), ColorClass='purple', Shape='oval',
		Stat='+12% MP regen',
	},
	onyx_pristine = {
		Id='onyx_pristine', Name='Onyx of Night', Cut='pristine', Rarity='epic',
		Color=rgb(96,64,112), ColorClass='black', Shape='octagon',
		Stat='+6% lifesteal at night',
	},
	diamond_flawless = {
		Id='diamond_flawless', Name='Diamond, Flawless', Cut='flawless', Rarity='mythic',
		Color=rgb(224,234,255), ColorClass='white', Shape='octagon',
		Stat='+14% all stats',
	},
	pearl_standard = {
		Id='pearl_standard', Name='Tide Pearl', Cut='standard', Rarity='rare',
		Color=rgb(240,232,208), ColorClass='white', Shape='oval',
		Stat='+30 max HP per socket',
	},
	jet_flawed = {
		Id='jet_flawed', Name='Jet of the Abyss', Cut='flawed', Rarity='rare',
		Color=rgb(48,48,160), ColorClass='blue', Shape='square',
		Stat='+5% void DMG',
	},
	opal_pristine = {
		Id='opal_pristine', Name='Wandering Opal', Cut='pristine', Rarity='epic',
		Color=rgb(128,224,192), ColorClass='green', Shape='pear',
		Stat='random elemental +20% DMG',
	},
} :: { [string]: Gem }

-- Cut multipliers — applied to gem stat formulas in Stage D integration.
-- chipped < flawed < standard < flawless < pristine.
Module.CutMultiplier = {
	chipped  = 0.4,
	flawed   = 0.7,
	standard = 1.0,
	flawless = 1.3,
	pristine = 1.6,
}

-- Color classes — used by socket matching. Sockets declare a Color
-- requirement; gems whose ColorClass matches (or socket = 'any') fit.
Module.ColorClasses = {
	red    = rgb(255,80,104),
	blue   = rgb(80,128,255),
	green  = rgb(80,224,128),
	gold   = rgb(255,192,64),
	purple = rgb(176,112,224),
	white  = rgb(224,234,255),
	black  = rgb(96,64,112),
}

Module.RarityLevelGate = RARITY_LEVEL_GATE

function Module.GetRequiredLevel(gemId: string): number
	local cfg = Module.Gems[gemId]
	if not cfg then return 1 end
	if cfg.RequiredLevel then return cfg.RequiredLevel end
	return RARITY_LEVEL_GATE[cfg.Rarity] or 1
end

return Module
]]></Source>
